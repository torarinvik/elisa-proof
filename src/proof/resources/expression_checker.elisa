extend ElisaProof:
    private:
        const PROOF_RESOURCE_EXPRESSION_DEPTH_LIMIT: usize = 64

        def proof_resource_callee_shadowed_by_local_with_work(callee: Ast::Expr, state: ProofResourceState&, report: mutable ProofReport&, depth: usize) -> bool:
            return true if depth >= PROOF_RESOURCE_EXPRESSION_DEPTH_LIMIT
            match callee:
                Ast::Expr.Ident(name, _):
                    binding: (complete: bool, slot: usize) = proof_resource_lookup_with_source_work(state, name, report)
                    return not binding.complete or binding.slot < state.bindings.binding_names.count
                Ast::Expr.Paren(inner, _):
                    return proof_resource_callee_shadowed_by_local_with_work(inner, state, report, depth + 1)
                _:
                    return false

        def proof_resource_check_expression[@s, @r](expression: Ast::Expr, state: mutable ProofResourceState& @s, report: mutable ProofReport& @r, function_name: sview, functions: mutable ProofFunctionTable&) -> void can[Global{Read,Write}]:
            state.context.expression_depth <- state.context.expression_depth + 1
            if state.context.expression_depth > PROOF_RESOURCE_EXPRESSION_DEPTH_LIMIT:
                rejected_depth: usize = state.context.expression_depth
                state.context.expression_depth <- state.context.expression_depth - 1
                position: Ast::Pos = Ast::expr_pos(expression)
                proof_add_budget_finding(report, "resource-expression-depth", position.line, function_name, "resource expression exceeds the bounded AST recursion depth", "depth", rejected_depth, PROOF_RESOURCE_EXPRESSION_DEPTH_LIMIT)
                return
            transition: (known: bool, operand: Ast::Expr) = proof_admitted_protocol_transition_operand(expression, report)
            if transition.known:
                # A compiler-admitted typestate transition is a consuming retag, not a
                # user call or a runtime index. Reuse the ordinary move rule so borrow
                # conflicts and use-after-move are replayed by the kernel.
                (proof_resource_check_expression(transition.operand, state, report, function_name, functions) can Global{Read,Write})
                state.context.expression_depth <- state.context.expression_depth - 1
                return
            match expression:
                Ast::Expr.Ident(name, position):
                    binding: (complete: bool, slot: usize) = proof_resource_lookup_with_source_work(state, name, report)
                    slot: usize = binding.slot
                    if slot < state.bindings.binding_names.count:
                        region: sview = proof_resource_binding_region(state, slot)
                        stale_region: bool = region != "" and (not proof_resource_binding_region_is_live(state, slot) or not proof_resource_region_is_active(state, region))
                        proof_resource_report_unavailable_region(state, slot, report, position, function_name) if stale_region
                        proof_resource_add_failing_obligation(report, "resource-use-after-move", position, function_name, "a moved resource is used again") if proof_resource_binding_is_moved(state, slot)
                        access_root: usize = proof_resource_encode_access_place(expression, report)
                        use_events_before: usize = state.evidence.trace_events.count
                        proof_resource_record_event_at_position(state, report, "resource-use", "", access_root, name, "", 0, position) if not stale_region
                        if not stale_region and state.evidence.trace_events.count == use_events_before + 1 and slot < state.bindings.binding_event_roots.count:
                            use_event: usize = state.evidence.trace_events[use_events_before]
                            if use_event < report.analysis_1.kernel.nodes.count:
                                bind_root: usize = state.bindings.binding_event_roots[slot]
                                report.analysis_1.kernel.nodes[use_event].auxiliary <- bind_root + 1 if bind_root < ElisaProofKernelCore::PROOF_KERNEL_NODE_BUDGET
                Ast::Expr.Call(callee, arguments, argument_names, position):
                    (proof_resource_check_expression(callee, state, report, function_name, functions) can Global{Read,Write})
                    resource_expression_argument: mutable bool = false
                    resource_argument: mutable bool = false
                    region_argument: mutable bool = false
                    normalized_arguments: mutable darray[Ast::Expr] = []
                    allocation_roots: mutable darray[usize] = []
                    for argument in arguments |argument, state, report, function_name, functions, position, resource_argument, region_argument, normalized_arguments, allocation_roots|:
                        new_parts: (known: bool, operand: Ast::Expr, region: sview) = proof_resource_region_new_parts(argument, report)
                        if new_parts.known:
                            (proof_resource_check_expression(new_parts.operand, state, report, function_name, functions) can Global{Read,Write})
                            allocation_root: usize = proof_resource_add_region_call_allocation(state, report, new_parts.operand, new_parts.region, position, function_name)
                            normalized_arguments.push(Ast::Expr.RegionNew(new_parts.operand, new_parts.region, Ast::expr_pos(argument)))
                            allocation_roots.push(allocation_root)
                            region_argument <- true
                        else:
                            (proof_resource_check_expression(argument, state, report, function_name, functions) can Global{Read,Write})
                            normalized_arguments.push(argument)
                            allocation_roots.push(0)
                            resource_expression_argument <- true if proof_resource_expr_carries_resource(argument, state, report)
                            region_argument <- true if proof_resource_expr_contains_region_value(argument, state, report)
                    callee_name: sview = proof_callable_name(callee)
                    local_callee: bool = proof_resource_callee_shadowed_by_local_with_work(callee, state, report, 0)
                    callee_index: mutable usize = functions.lookup.names.count
                    callee_index <- proof_function_index_for_callee(functions, callee) if not local_callee
                    resource_argument <- resource_expression_argument
                    resource_argument <- false if resource_expression_argument and not local_callee and proof_resource_extern_scalar_value_call(functions, callee_name, normalized_arguments, argument_names, state, report)
                    resource_lend_summary_safe: mutable bool = true
                    resource_summary_for_safety: mutable (known: bool, root: usize) = (false, report.analysis_1.kernel.nodes.count)
                    if callee_index < functions.lookup.names.count and resource_expression_argument:
                        resource_summary_for_safety <- proof_resource_summary_is_ready(functions, report, functions.call_graph.current_caller, callee_index, functions.call_graph.current_caller_is_lemma)
                        resource_mapped: mutable darray[Ast::Expr] = []
                        if proof_resource_map_call_arguments(functions, callee_index, normalized_arguments, argument_names, &resource_mapped, report):
                            resource_argument <- false
                            resource_parameter_count: mutable usize = 0
                            first_resource_parameter: mutable usize = resource_mapped.count
                            for parameter_index in 0..<resource_mapped.count |parameter_index, resource_mapped, functions, callee_index, state, report, resource_argument, resource_parameter_count, first_resource_parameter|:
                                carries_resource: bool = proof_resource_call_argument_requires_resource(functions, callee_index, parameter_index, resource_mapped[parameter_index], state, report)
                                resource_argument <- true if carries_resource
                                if carries_resource:
                                    first_resource_parameter <- parameter_index if resource_parameter_count == 0
                                    resource_parameter_count <- resource_parameter_count + 1
                            # A summary records writes to formal places, but not references nested
                            # inside an aggregate stored in one of those places. Check this once
                            # for the complete call. With multiple resource-carrying arguments,
                            # another argument's scan would check each formal's target, so no
                            # self exemption remains. Only a sole shared-reference actual gets it.
                            if resource_parameter_count > 0:
                                resource_lend_summary_safe <- false if not resource_summary_for_safety.known or not proof_resource_call_summary_storage_is_confined(functions, callee_index, first_resource_parameter, resource_parameter_count > 1, resource_summary_for_safety.root, report)
                    region_polymorphic_call: bool = callee_index < functions.parameters.regions.region_param_counts.count and functions.parameters.regions.region_param_counts[callee_index] > 0
                    # A collection builtin is not a declared function and has no summary, so every
                    # such call on a reference-rooted place was reported opaque. Its effect is
                    # exactly a write to the receiver and a read of each argument: it mutates the
                    # receiver's storage, it reads what it is given, and it moves nothing, because
                    # Elisa spells a transfer `move` and an argument without one is not consumed.
                    # The arguments have already been checked above, which is where their reads are
                    # recorded, so only the receiver write is added here -- through the ordinary
                    # write path, so an immutable reference, an overlapping live borrow and a
                    # read-only binding are all refused exactly as they are for `place <- value`.
                    #
                    # The receiver of a method-shaped call is not among the callee's arguments, so
                    # no argument mapping describes what the call does to it. Either the effect is
                    # modelled above by name, or the call may write a place nothing in this state
                    # saw -- which is what every builtin call did before the model existed. A width
                    # conversion is the one method with no storage to write. Everything else is
                    # refused rather than passed over in silence.
                    method_call: (known: bool, receiver: Ast::Expr, method: sview) = proof_resource_method_receiver(callee, report)
                    # Method-shaped AST nodes do not have a callable leaf for
                    # `proof_callable_name` to return. Check the method member itself so a declared
                    # `push`, `clear`, or similar UFCS function cannot be mistaken for a compiler
                    # collection builtin and receive an incomplete effect model.
                    builtin: (known: bool, receiver: Ast::Expr) = proof_resource_collection_builtin(callee, functions, report)
                    builtin_admitted: bool = builtin.known and method_call.known and proof_resource_function_name_count(functions, method_call.method) == 0 and not region_argument and not region_polymorphic_call and not proof_resource_argument_moves(arguments)
                    # Numeric selector spellings may dispatch to a source or imported
                    # `__cast__` hook. Keep the receiver opaque whenever that resolution is
                    # possible; purity of the builtin conversion list alone is not a witness.
                    is_builtin_conversion: bool = method_call.known and proof_resource_function_name_count(functions, method_call.method) == 0 and proof_resource_pure_conversion(method_call.method) and not functions.externs.custom_cast_hook_present
                    unmodelled_receiver: bool = method_call.known and not builtin_admitted and not is_builtin_conversion
                    if builtin_admitted:
                        (proof_resource_check_write(builtin.receiver, state, report, function_name, position, functions) can Global{Read,Write})
                    elif unmodelled_receiver:
                        proof_resource_add_failing_obligation(report, "borrow-call-opaque", position, function_name, "a method-shaped call may write its receiver, and no summary maps a receiver")
                    elif resource_argument or region_argument or region_polymorphic_call:
                        summary: (known: bool, root: usize) = proof_resource_summary_is_ready(functions, report, functions.call_graph.current_caller, callee_index, functions.call_graph.current_caller_is_lemma)
                        mapped: mutable darray[Ast::Expr] = []
                        mapped_allocation_roots: mutable darray[usize] = []
                        mapped_ok: bool = summary.known and callee_index < functions.lookup.names.count and proof_resource_map_call_arguments(functions, callee_index, normalized_arguments, argument_names, &mapped, report) and proof_resource_map_call_allocation_roots(functions, callee_index, normalized_arguments, argument_names, allocation_roots, &mapped_allocation_roots, report)
                        resource_lend_summary_safe <- false if summary.known and mapped_ok and not proof_resource_call_summary_views_are_confined(functions, callee_index)
                        # A call that only lends shared references leaves the caller's state
                        # alone, so it is admitted from the callee's declared modes without a body
                        # summary. This is the only path open to a recursive component, which by
                        # construction cannot consume one of its own summaries.
                        lend_mapped: mutable darray[Ast::Expr] = []
                        confined_lend: mutable bool = false
                        if not (summary.known and mapped_ok) and callee_index < functions.lookup.names.count and proof_resource_map_call_arguments(functions, callee_index, normalized_arguments, argument_names, &lend_mapped, report):
                            confined_lend <- (proof_resource_call_is_confined_lend(functions, callee_index, lend_mapped, state, report) can Global{Read,Write}) and proof_resource_record_lend_call(state, report, callee_name, callee_index, lend_mapped, position, functions)
                        if confined_lend:
                            pass
                        elif summary.known and mapped_ok:
                            pairwise_alias: bool = (proof_resource_call_source_has_pairwise_alias(state, report, summary.root, mapped, functions) can Global{Read,Write})
                            recorded: mutable bool = false
                            recorded <- (proof_resource_record_call(state, report, callee_name, summary.root, callee_index, mapped, mapped_allocation_roots, position, functions) can Global{Read,Write}) if not pairwise_alias and resource_lend_summary_safe
                            # A summary that maps its arguments can still fail to be *encoded* for
                            # this call -- most often because a region-owned actual reaches a
                            # formal that declares no lifetime, which the summary path places from
                            # the callee's own trace and therefore refuses. That call may still be
                            # a confined lend, which is admitted from the callee's declared modes
                            # and needs no body summary at all, and the lend rule already tolerates
                            # exactly this actual. The path was only ever tried when the summary
                            # did not map, so the two admissions never composed. `record_call`
                            # returns before it mutates anything when it refuses, so falling
                            # through to the lend leaves no half-written call behind.
                            if not recorded and not pairwise_alias and callee_index < functions.lookup.names.count:
                                fallback_mapped: mutable darray[Ast::Expr] = []
                                if proof_resource_map_call_arguments(functions, callee_index, normalized_arguments, argument_names, &fallback_mapped, report):
                                    recorded <- (proof_resource_call_is_confined_lend(functions, callee_index, fallback_mapped, state, report) can Global{Read,Write}) and proof_resource_record_lend_call(state, report, callee_name, callee_index, fallback_mapped, position, functions)
                            proof_resource_add_failing_obligation(report, "borrow-call-alias", position, function_name, "mutable call arguments overlap while the callee is running") if pairwise_alias
                            proof_resource_add_failing_obligation(report, "region-call-opaque", position, function_name, "a region-polymorphic call is not mapped to a verified caller region") if (region_argument or region_polymorphic_call) and not recorded
                            proof_resource_add_failing_obligation(report, "borrow-call-summary-unsupported", position, function_name, "the checked callee resource summary could not be encoded for this call") if resource_argument and not recorded and not pairwise_alias
                        elif summary.known:
                            proof_resource_add_failing_obligation(report, "region-call-opaque", position, function_name, "a region-polymorphic call requires an exact verified region summary") if region_argument or region_polymorphic_call
                            proof_resource_add_failing_obligation(report, "borrow-call-summary-unsupported", position, function_name, "borrow-carrying call requires an exact argument mapping with no unresolved defaults") if resource_argument
                        else:
                            proof_resource_add_failing_obligation(report, "region-call-opaque", position, function_name, "a region-polymorphic call has no converged lifetime summary") if region_argument or region_polymorphic_call
                            proof_resource_add_failing_obligation(report, "borrow-call-opaque", position, function_name, "a call argument carries a resource, but no converged callee resource summary is available") if resource_argument
                Ast::Expr.StaticEffectCall(_, _, _, _, _, position):
                    lowered: (known: bool, call: Ast::Expr) = proof_lower_static_effect_call(expression)
                    (proof_resource_check_expression(lowered.call, state, report, function_name, functions) can Global{Read,Write}) if lowered.known
                    proof_resource_add_failing_obligation(report, "borrow-call-opaque", position, function_name, "a static effect call has no unique compiler-selected resource transition") if not lowered.known
                Ast::Expr.Move(operand, position):
                    root: sview = proof_resource_place_root(operand, report)
                    binding: (complete: bool, slot: usize) = proof_resource_lookup_with_source_work(state, root, report)
                    slot: usize = binding.slot
                    access: (known: bool, place: ProofResourcePlace) = proof_resource_access_place(operand, report)
                    (proof_resource_check_expression(operand, state, report, function_name, functions) can Global{Read,Write})
                    moved: bool = slot < state.bindings.binding_names.count and proof_resource_binding_is_moved(state, slot)
                    conflict: bool = moved or (slot < state.bindings.binding_names.count and ((slot < state.borrows.borrow_present.count and state.borrows.borrow_present[slot]) or (proof_resource_has_borrow_overlap(state, report, access.place, state.bindings.binding_names.count) can Global{Read,Write})))
                    if conflict:
                        if not moved:
                            if slot < state.borrows.borrow_present.count and state.borrows.borrow_present[slot]:
                                proof_resource_add_failing_obligation(report, "borrow-move-conflict", position, function_name, "a live borrow prevents moving its borrow handle")
                            else:
                                proof_resource_report_borrow_conflict(state, report, access.place, state.bindings.binding_names.count, false, "borrow-move-conflict", position, function_name, "a live borrow prevents moving the borrowed place")
                    elif root != "" and slot < state.bindings.binding_names.count:
                        access_root: usize = proof_resource_encode_access_place(operand, report)
                        move_events_before: usize = state.evidence.trace_events.count
                        proof_resource_record_event_at_position(state, report, "resource-move", "", access_root, root, "", 0, position)
                        if state.evidence.trace_events.count == move_events_before + 1 and slot < state.bindings.binding_event_roots.count:
                            move_event: usize = state.evidence.trace_events[move_events_before]
                            if move_event < report.analysis_1.kernel.nodes.count:
                                bind_root: usize = state.bindings.binding_event_roots[slot]
                                report.analysis_1.kernel.nodes[move_event].auxiliary <- bind_root + 1 if bind_root < ElisaProofKernelCore::PROOF_KERNEL_NODE_BUDGET
                        proof_resource_mark_binding_moved(state, slot)
                Ast::Expr.Unary(_, operand, _):
                    (proof_resource_check_expression(operand, state, report, function_name, functions) can Global{Read,Write})
                Ast::Expr.Paren(inner, _):
                    (proof_resource_check_expression(inner, state, report, function_name, functions) can Global{Read,Write})
                Ast::Expr.Binary(left, _, right, _):
                    (proof_resource_check_expression(left, state, report, function_name, functions) can Global{Read,Write})
                    (proof_resource_check_expression(right, state, report, function_name, functions) can Global{Read,Write})
                Ast::Expr.Field(object, _, _):
                    (proof_resource_check_expression(object, state, report, function_name, functions) can Global{Read,Write})
                Ast::Expr.Scope(base, _, _):
                    (proof_resource_check_expression(base, state, report, function_name, functions) can Global{Read,Write})
                Ast::Expr.Index(object, index, _):
                    (proof_resource_check_expression(object, state, report, function_name, functions) can Global{Read,Write})
                    (proof_resource_check_expression(index, state, report, function_name, functions) can Global{Read,Write})
                Ast::Expr.IndexN(object, arguments, _):
                    (proof_resource_check_expression(object, state, report, function_name, functions) can Global{Read,Write})
                    for argument in arguments |argument, state, report, function_name, functions|:
                        (proof_resource_check_expression(argument, state, report, function_name, functions) can Global{Read,Write})
                Ast::Expr.Slice(object, low, high, _):
                    (proof_resource_check_expression(object, state, report, function_name, functions) can Global{Read,Write})
                    (proof_resource_check_expression(low, state, report, function_name, functions) can Global{Read,Write})
                    (proof_resource_check_expression(high, state, report, function_name, functions) can Global{Read,Write})
                Ast::Expr.RegionNew(operand, _, _):
                    (proof_resource_check_expression(operand, state, report, function_name, functions) can Global{Read,Write})
                Ast::Expr.Array(elements, _):
                    for element in elements |element, state, report, function_name, functions|:
                        (proof_resource_check_expression(element, state, report, function_name, functions) can Global{Read,Write})
                Ast::Expr.Tuple(elements, _):
                    for element in elements |element, state, report, function_name, functions|:
                        (proof_resource_check_expression(element, state, report, function_name, functions) can Global{Read,Write})
                Ast::Expr.SetLit(elements, _):
                    for element in elements |element, state, report, function_name, functions|:
                        (proof_resource_check_expression(element, state, report, function_name, functions) can Global{Read,Write})
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |entry, state, report, function_name, functions|:
                        (proof_resource_check_expression(entry.key, state, report, function_name, functions) can Global{Read,Write})
                        (proof_resource_check_expression(entry.value, state, report, function_name, functions) can Global{Read,Write})
                Ast::Expr.Construct(_, fields, _):
                    for field in fields |field, state, report, function_name, functions|:
                        (proof_resource_check_expression(field.value, state, report, function_name, functions) can Global{Read,Write})
                Ast::Expr.RecordUpdate(base, fields, _):
                    (proof_resource_check_expression(base, state, report, function_name, functions) can Global{Read,Write})
                    for field in fields |field, state, report, function_name, functions|:
                        (proof_resource_check_expression(field.value, state, report, function_name, functions) can Global{Read,Write})
                Ast::Expr.If(condition, then_expr, else_expr, _):
                    (proof_resource_check_expression(condition, state, report, function_name, functions) can Global{Read,Write})
                    then_state: mutable ProofResourceState = proof_resource_empty()
                    else_state: mutable ProofResourceState = proof_resource_empty()
                    proof_resource_copy_into(state, &then_state, report)
                    proof_resource_copy_into(state, &else_state, report)
                    proof_resource_mark_scope_inherited(state, &then_state)
                    proof_resource_mark_scope_inherited(state, &else_state)
                    (proof_resource_check_expression(then_expr, &then_state, report, function_name, functions) can Global{Read,Write})
                    (proof_resource_check_expression(else_expr, &else_state, report, function_name, functions) can Global{Read,Write})
                    proof_resource_close_if_children(state, &then_state, &else_state, report)
                Ast::Expr.Comprehension(variable, iterable, condition, body, _):
                    (proof_resource_check_expression(iterable, state, report, function_name, functions) can Global{Read,Write})
                    # The bound variable is a fresh value binding scoped like a `for` variable;
                    # without it a call argument naming the variable has no binding to replay.
                    comprehension_state: mutable ProofResourceState = proof_resource_empty()
                    proof_resource_copy_into(state, &comprehension_state, report)
                    proof_resource_mark_scope_inherited(state, &comprehension_state)
                    proof_resource_add_binding_traced(&comprehension_state, report, variable, false, false, false, comprehension_state.bindings.binding_names.count, false, "", proof_resource_empty_place(), 0) if variable != ""
                    (proof_resource_check_expression(condition, &comprehension_state, report, function_name, functions) can Global{Read,Write})
                    (proof_resource_check_expression(body, &comprehension_state, report, function_name, functions) can Global{Read,Write})
                    proof_resource_close_child(state, comprehension_state, report, true)
                Ast::Expr.Refinement(base, predicate, _):
                    (proof_resource_check_expression(base, state, report, function_name, functions) can Global{Read,Write})
                    (proof_resource_check_expression(predicate, state, report, function_name, functions) can Global{Read,Write})
                Ast::Expr.Match(scrutinee, arms, position):
                    (proof_resource_check_expression(scrutinee, state, report, function_name, functions) can Global{Read,Write})
                    pattern_source_classified: mutable bool = false
                    pattern_source_supported: mutable bool = false
                    pattern_source_carries_resource: mutable bool = false
                    moved_any: mutable ProofResourceAlternativeMoves = proof_resource_alternative_move_mask(state, report)
                    for arm in arms |arm, state, report, function_name, functions, pattern_source_classified, pattern_source_supported, pattern_source_carries_resource, moved_any|:
                        arm_state: mutable ProofResourceState = proof_resource_empty()
                        proof_resource_copy_into(state, &arm_state, report)
                        proof_resource_mark_scope_inherited(state, &arm_state)
                        proof_resource_check_pattern_names_with_source(arm.pattern, scrutinee, &pattern_source_classified, &pattern_source_supported, &pattern_source_carries_resource, &arm_state, report, functions, position, function_name)
                        (proof_resource_check_expression(arm.guard, &arm_state, report, function_name, functions) can Global{Read,Write})
                        (proof_resource_check_statements(arm.body, &arm_state, report, function_name, functions) can Global{Read,Write})
                        proof_resource_close_alternative_child(state, &arm_state, report, &moved_any)
                    proof_resource_merge_alternative_moves(state, &moved_any, report)
                Ast::Expr.Catch(guarded, arms, position):
                    (proof_resource_check_expression(guarded, state, report, function_name, functions) can Global{Read,Write})
                    pattern_source_classified: mutable bool = false
                    pattern_source_supported: mutable bool = false
                    pattern_source_carries_resource: mutable bool = false
                    moved_any: mutable ProofResourceAlternativeMoves = proof_resource_alternative_move_mask(state, report)
                    for arm in arms |arm, state, report, function_name, functions, pattern_source_classified, pattern_source_supported, pattern_source_carries_resource, moved_any|:
                        arm_state: mutable ProofResourceState = proof_resource_empty()
                        proof_resource_copy_into(state, &arm_state, report)
                        proof_resource_mark_scope_inherited(state, &arm_state)
                        proof_resource_check_pattern_names_with_source(arm.pattern, guarded, &pattern_source_classified, &pattern_source_supported, &pattern_source_carries_resource, &arm_state, report, functions, position, function_name)
                        (proof_resource_check_expression(arm.guard, &arm_state, report, function_name, functions) can Global{Read,Write})
                        (proof_resource_check_statements(arm.body, &arm_state, report, function_name, functions) can Global{Read,Write})
                        proof_resource_close_alternative_child(state, &arm_state, report, &moved_any)
                    proof_resource_merge_alternative_moves(state, &moved_any, report)
                Ast::Expr.GetElse(guarded, recovery, _):
                    (proof_resource_check_expression(guarded, state, report, function_name, functions) can Global{Read,Write})
                    recovery_state: mutable ProofResourceState = proof_resource_empty()
                    proof_resource_copy_into(state, &recovery_state, report)
                    proof_resource_mark_scope_inherited(state, &recovery_state)
                    (proof_resource_check_statements(recovery, &recovery_state, report, function_name, functions) can Global{Read,Write})
                    proof_resource_close_child(state, recovery_state, report, false)
                Ast::Expr.Lambda(parameters, body, _):
                    lambda_state: mutable ProofResourceState = proof_resource_empty()
                    proof_resource_copy_into(state, &lambda_state, report)
                    proof_resource_mark_scope_inherited(state, &lambda_state)
                    for parameter in parameters |parameter, lambda_state|:
                        proof_resource_add_binding_traced(&lambda_state, report, parameter, false, false, false, lambda_state.bindings.binding_names.count, false, "", proof_resource_empty_place(), 0)
                    (proof_resource_check_statements(body, &lambda_state, report, function_name, functions) can Global{Read,Write})
                    proof_resource_close_child(state, lambda_state, report, false)
                Ast::Expr.Block(statements, value, _, _):
                    child: mutable ProofResourceState = proof_resource_empty()
                    proof_resource_copy_into(state, &child, report)
                    proof_resource_mark_scope_inherited(state, &child)
                    (proof_resource_check_statements(statements, &child, report, function_name, functions) can Global{Read,Write})
                    (proof_resource_check_expression(value, &child, report, function_name, functions) can Global{Read,Write})
                    proof_resource_close_child(state, child, report, true)
                _:
                    pass
            state.context.expression_depth <- state.context.expression_depth - 1

        # In contracts, `old(place)` is the compiler's pre-state operator, not an
        # executable callee receiving a borrow. Still walk the operand normally:
        # address-taking, moves, nested calls and unavailable resources remain checked.
        # Other source shapes use the ordinary walker rather than erasing unknown syntax.
        def proof_resource_check_contract_expression(expression: Ast::Expr, state: mutable ProofResourceState&, report: mutable ProofReport&, function_name: sview, functions: mutable ProofFunctionTable&, depth: usize) -> void can[Global{Read,Write}]:
            if depth >= PROOF_RESOURCE_EXPRESSION_DEPTH_LIMIT:
                position: Ast::Pos = Ast::expr_pos(expression)
                proof_add_budget_finding(report, "resource-expression-depth", position.line, function_name, "contract resource expression exceeds the bounded AST recursion depth", "depth", depth, PROOF_RESOURCE_EXPRESSION_DEPTH_LIMIT)
                return
            match expression:
                Ast::Expr.Binary(left, _, right, _):
                    (proof_resource_check_contract_expression(left, state, report, function_name, functions, depth + 1) can Global{Read,Write})
                    (proof_resource_check_contract_expression(right, state, report, function_name, functions, depth + 1) can Global{Read,Write})
                Ast::Expr.Paren(inner, _):
                    (proof_resource_check_contract_expression(inner, state, report, function_name, functions, depth + 1) can Global{Read,Write})
                Ast::Expr.Unary(TokenKind.Not, inner, _):
                    (proof_resource_check_contract_expression(inner, state, report, function_name, functions, depth + 1) can Global{Read,Write})
                Ast::Expr.Call(callee, arguments, argument_names, _):
                    positional: bool = argument_names.count == 0 or (argument_names.count == 1 and argument_names[0] == "")
                    if proof_ident_name(callee) == "old" and arguments.count == 1 and positional:
                        (proof_resource_check_expression(arguments[0], state, report, function_name, functions) can Global{Read,Write})
                    else:
                        (proof_resource_check_expression(expression, state, report, function_name, functions) can Global{Read,Write})
                _:
                    (proof_resource_check_expression(expression, state, report, function_name, functions) can Global{Read,Write})
