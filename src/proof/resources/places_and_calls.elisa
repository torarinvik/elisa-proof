extend ElisaProof:
    private:
        def proof_resource_symbolic_index_supported(expression: Ast::Expr, report: mutable ProofReport&, depth: usize) -> bool:
            return false if depth >= PROOF_RESOURCE_EXPRESSION_DEPTH_LIMIT or not proof_source_index_work_charge(report, 1)
            match expression:
                Ast::Expr.Ident(name, _):
                    return name != ""
                Ast::Expr.IntLit(_, _):
                    return true
                Ast::Expr.Paren(inner, _):
                    return proof_resource_symbolic_index_supported(inner, report, depth + 1)
                Ast::Expr.Unary(operator, operand, _):
                    return (operator == TokenKind.Plus or operator == TokenKind.Minus) and proof_resource_symbolic_index_supported(operand, report, depth + 1)
                Ast::Expr.Binary(left, operator, right, _):
                    return (operator == TokenKind.Plus or operator == TokenKind.Minus or operator == TokenKind.Star) and proof_resource_symbolic_index_supported(left, report, depth + 1) and proof_resource_symbolic_index_supported(right, report, depth + 1)
                _:
                    return false

        def proof_resource_default_position() -> Ast::Pos:
            return Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}

        # Decode only the symbolic-index sublanguage back into source AST terms. This is used by
        # the producer to ask the same arithmetic prover that checks contracts; replay consumes
        # the corresponding canonical arena roots independently.
        def proof_resource_decode_index_expression(report: ProofReport&, root: usize, depth: usize) -> (known: bool, expression: Ast::Expr):
            invalid: Ast::Expr = Ast::Expr.Invalid
            return (false, invalid) if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or root >= report.analysis_1.kernel.nodes.count
            node: ElisaProofKernelCore::ProofKernelNode = report.analysis_1.kernel.nodes[root]
            position: Ast::Pos = proof_resource_default_position()
            return (true, Ast::Expr.IntLit(node.value, Ast::pos_at_line(0))) if node.kind == "int" and node.operator == "" and node.left == 0 and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.name == "" and node.secondary_name == ""
            return (true, Ast::Expr.Ident(node.name, position)) if node.kind == "ident" and node.name != "" and node.operator == "" and node.left == 0 and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.secondary_name == ""
            if node.kind == "unary" and (node.operator in {"+", "-"}):
                operand: (known: bool, expression: Ast::Expr) = proof_resource_decode_index_expression(report, node.left, depth + 1)
                return (true, Ast::Expr.Unary(TokenKind.Plus if node.operator == "+" else TokenKind.Minus, operand.expression, position)) if operand.known and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.name == "" and node.secondary_name == ""
            if node.kind == "binary" and (node.operator in {"+", "-", "*"}):
                left: (known: bool, expression: Ast::Expr) = proof_resource_decode_index_expression(report, node.left, depth + 1)
                right: (known: bool, expression: Ast::Expr) = proof_resource_decode_index_expression(report, node.right, depth + 1)
                return (true, Ast::Expr.Binary(left.expression, TokenKind.Plus if node.operator == "+" else (TokenKind.Star if node.operator == "*" else TokenKind.Minus), right.expression, position)) if left.known and right.known and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.name == "" and node.secondary_name == ""
            return (false, invalid)

        def proof_resource_index_is_closed(report: ProofReport&, root: usize) -> bool:
            return false if root >= report.analysis_1.kernel.nodes.count
            node: ElisaProofKernelCore::ProofKernelNode = report.analysis_1.kernel.nodes[root]
            return node.kind == "int" and node.operator == "" and node.left == 0 and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.name == "" and node.secondary_name == ""

        def proof_resource_symbolic_index_supported_kernel(report: ProofReport&, root: usize, depth: usize) -> bool:
            decoded: (known: bool, expression: Ast::Expr) = proof_resource_decode_index_expression(report, root, depth)
            return decoded.known

        # A successful symbolic separation always emits a replayable resource-disjoint event.
        # The event carries the exact index roots and a closed logical context, so replay does
        # not need to trust this source-side call into the arithmetic prover.
        def proof_resource_record_disjoint[@s, @r](state: mutable ProofResourceState& @s, report: mutable ProofReport& @r, left_root: usize, right_root: usize) -> void:
            return if left_root >= report.analysis_1.kernel.nodes.count or right_root >= report.analysis_1.kernel.nodes.count
            node_start: usize = report.analysis_1.kernel.nodes.count
            child_start: usize = report.analysis_1.kernel.children.count
            fact_roots: mutable darray[usize] = []
            for fact in state.evidence.facts |fact, report, fact_roots|:
                if proof_kernel_expression_supported(fact):
                    encoded: (known: bool, root: usize) = proof_resource_encode_expression(fact, report)
                    if not encoded.known:
                        report.analysis_1.kernel.nodes <- report.analysis_1.kernel.nodes.truncate(node_start)
                        report.analysis_1.kernel.children <- report.analysis_1.kernel.children.truncate(child_start)
                        return
                    fact_roots.push(encoded.root)
            needed_nodes: usize = fact_roots.count + 2
            if not proof_resource_kernel_capacity(report, needed_nodes, fact_roots.count, ""):
                report.analysis_1.kernel.nodes <- report.analysis_1.kernel.nodes.truncate(node_start)
                report.analysis_1.kernel.children <- report.analysis_1.kernel.children.truncate(child_start)
                proof_kernel_budget_note(report, "")
                return
            goal_root: usize = proof_kernel_add_node(&report.analysis_1.kernel.nodes, "binary", "!=", left_root, right_root, 0, 0, 0, 0, "", "")
            start: usize = report.analysis_1.kernel.children.count
            report.analysis_1.kernel.children.extend(fact_roots)
            event: usize = proof_kernel_add_node(&report.analysis_1.kernel.nodes, "resource-disjoint", "!=", left_root, right_root, goal_root, start, fact_roots.count, 0, "", "")
            state.evidence.trace_events.push(event)

        def proof_resource_symbolic_indices_disjoint[@s, @r](state: mutable ProofResourceState& @s, report: mutable ProofReport& @r, left_root: usize, right_root: usize) -> bool can[Global{Read,Write}]:
            return false if proof_resource_index_is_closed(report, left_root) and proof_resource_index_is_closed(report, right_root)
            left: (known: bool, expression: Ast::Expr) = proof_resource_decode_index_expression(report, left_root, 0)
            right: (known: bool, expression: Ast::Expr) = proof_resource_decode_index_expression(report, right_root, 0)
            return false if not left.known or not right.known
            goal: Ast::Expr = Ast::Expr.Binary(left.expression, TokenKind.BangEq, right.expression, proof_resource_default_position())
            annotations: darray[Ast::EnumAnnotation] = []
            proven: bool = (proof_goal(state.evidence.facts, goal, annotations) can Global{Read,Write})
            if proven:
                proof_resource_record_disjoint(state, report, left_root, right_root)
                return true
            # Inequality is symmetric, but the certificate kernel checks the serialized goal in
            # its exact orientation. Try the reverse proposition and emit that orientation when
            # it is the one established by the caller's facts (for example, `left != right`).
            reverse_goal: Ast::Expr = Ast::Expr.Binary(right.expression, TokenKind.BangEq, left.expression, proof_resource_default_position())
            reverse_proven: bool = (proof_goal(state.evidence.facts, reverse_goal, annotations) can Global{Read,Write})
            proof_resource_record_disjoint(state, report, right_root, left_root) if reverse_proven
            return reverse_proven

        # Resource identities cover a root and an exact named-field/literal-index path up to the
        # same bounded expression depth as the independent kernel. Dynamic selectors are lowered
        # to a conservative whole-root place below.
        def proof_resource_place[@r](expression: Ast::Expr, report: mutable ProofReport& @r) -> (known: bool, place: ProofResourcePlace):
            proof_resource_place_with_depth(expression, report, 0)

        def proof_resource_place_with_depth[@r](expression: Ast::Expr, report: mutable ProofReport& @r, depth: usize) -> (known: bool, place: ProofResourcePlace):
            empty: ProofResourcePlace = proof_resource_empty_place()
            if depth >= PROOF_RESOURCE_EXPRESSION_DEPTH_LIMIT:
                proof_source_index_work_charge(report, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1)
                return (false, empty)
            return (false, empty) if not proof_source_index_work_charge(report, 1)
            match expression:
                Ast::Expr.Ident(root, _):
                    encoded: (known: bool, root: usize) = proof_resource_encode_expression(expression, report)
                    return (false, empty) if root == "" or not encoded.known
                    return (true, ProofResourcePlace{root: root, path_root: encoded.root, depth: 0, whole: true, exact: true})
                Ast::Expr.Field(object, field, _):
                    parent: (known: bool, place: ProofResourcePlace) = proof_resource_place_with_depth(object, report, depth + 1)
                    return proof_resource_place_add_field(report, parent.place, field) if parent.known
                    return (false, empty)
                Ast::Expr.Index(object, index, _):
                    parent: (known: bool, place: ProofResourcePlace) = proof_resource_place_with_depth(object, report, depth + 1)
                    return (false, empty) if not parent.known
                    match index:
                        Ast::Expr.IntLit(_, _):
                            encoded: (known: bool, root: usize) = proof_resource_encode_expression(index, report)
                            return (false, empty) if not encoded.known
                            return proof_resource_place_add_index(report, parent.place, encoded.root)
                        _:
                            if proof_resource_symbolic_index_supported(index, report, 0):
                                encoded: (known: bool, root: usize) = proof_resource_encode_expression(index, report)
                                return (false, empty) if not encoded.known
                                return proof_resource_place_add_index(report, parent.place, encoded.root)
                            return (false, empty)
                Ast::Expr.IndexN(object, arguments, _):
                    decoded: (known: bool, place: ProofResourcePlace) = proof_resource_place_with_depth(object, report, depth + 1)
                    return (false, empty) if not decoded.known or arguments.count == 0
                    parent: mutable ProofResourcePlace = decoded.place
                    for argument in arguments |argument, report, parent|:
                        match argument:
                            Ast::Expr.IntLit(_, _):
                                encoded: (known: bool, root: usize) = proof_resource_encode_expression(argument, report)
                                return (false, empty) if not encoded.known
                                next: (known: bool, place: ProofResourcePlace) = proof_resource_place_add_index(report, parent, encoded.root)
                                return (false, empty) if not next.known
                                parent <- next.place
                            _:
                                if proof_resource_symbolic_index_supported(argument, report, 0):
                                    encoded: (known: bool, root: usize) = proof_resource_encode_expression(argument, report)
                                    return (false, empty) if not encoded.known
                                    next: (known: bool, place: ProofResourcePlace) = proof_resource_place_add_index(report, parent, encoded.root)
                                    return (false, empty) if not next.known
                                    parent <- next.place
                                    continue
                                return (false, empty)
                    return (true, parent)
                Ast::Expr.Paren(inner, _):
                    return proof_resource_place_with_depth(inner, report, depth + 1)
                _:
                    return (false, empty)

        def proof_resource_borrow_place[@r](expression: Ast::Expr, report: mutable ProofReport& @r) -> (known: bool, place: ProofResourcePlace):
            proof_resource_borrow_place_with_depth(expression, report, 0)

        def proof_resource_borrow_place_with_depth[@r](expression: Ast::Expr, report: mutable ProofReport& @r, depth: usize) -> (known: bool, place: ProofResourcePlace):
            empty: ProofResourcePlace = proof_resource_empty_place()
            if depth >= PROOF_RESOURCE_EXPRESSION_DEPTH_LIMIT:
                proof_source_index_work_charge(report, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1)
                return (false, empty)
            return (false, empty) if not proof_source_index_work_charge(report, 1)
            match expression:
                Ast::Expr.Unary(operator, operand, _):
                    if operator == TokenKind.Ampersand:
                        exact: (known: bool, place: ProofResourcePlace) = proof_resource_place_with_depth(operand, report, depth + 1)
                        return exact if exact.known
                        # An unsupported dynamic selector cannot identify an element in the v1
                        # resource language, but its receiver root is still a sound capability identity.
                        # Widening to that whole root lets shared dynamic borrows participate in
                        # ordinary read reasoning while ensuring every write or mutable borrow
                        # of the root conflicts conservatively.
                        root: sview = proof_resource_place_root(operand, report)
                        return (false, empty) if root == ""
                        encoded: (known: bool, root: usize) = proof_resource_encode_expression(Ast::Expr.Ident(root, proof_resource_default_position()), report)
                        return (false, empty) if not encoded.known
                        return (true, ProofResourcePlace{root: root, path_root: encoded.root, depth: 0, whole: true, exact: false})
                    return (false, empty)
                Ast::Expr.Paren(inner, _):
                    return proof_resource_borrow_place_with_depth(inner, report, depth + 1)
                _:
                    return (false, empty)

        # Recover one exact path component in root-to-leaf order. Index components carry their
        # closed integer value; an explicit kind keeps fields and indexes disjoint even when their
        # spellings happen to match.
        def proof_resource_path_component(report: ProofReport&, path_root: usize, position: usize, depth: usize) -> (known: bool, kind: sview, field: sview, value: i64, expression_root: usize):
            requires depth <= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases depth
            return (false, "", "", 0, 0) if depth == 0 or path_root >= report.analysis_1.kernel.nodes.count
            node: ElisaProofKernelCore::ProofKernelNode = report.analysis_1.kernel.nodes[path_root]
            if position + 1 == depth:
                return (true, "field", node.name, 0, 0) if node.kind == "field" and node.name != ""
                if node.kind == "index" and node.operator == "" and node.name == "" and node.secondary_name == "" and node.right < report.analysis_1.kernel.nodes.count:
                    index_node: ElisaProofKernelCore::ProofKernelNode = report.analysis_1.kernel.nodes[node.right]
                    return (true, "index", "", index_node.value, node.right) if proof_resource_index_is_closed(report, node.right)
                    return (true, "index", "", 0, node.right) if proof_resource_symbolic_index_supported_kernel(report, node.right, 0)
                return (false, "", "", 0, 0)
            return (false, "", "", 0, 0) if position >= depth - 1
            return proof_resource_path_component(report, node.left, position, depth - 1) if node.kind in {"field", "index"}
            return (false, "", "", 0, 0)

        def proof_resource_place_is_prefix[@s, @r](state: mutable ProofResourceState& @s, report: mutable ProofReport& @r, prefix: ProofResourcePlace, target: ProofResourcePlace) -> bool can[Global{Read,Write}]:
            return false if prefix.root == "" or target.root == "" or prefix.root != target.root
            return true if prefix.whole
            return false if target.whole or prefix.depth > target.depth or prefix.depth > ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or target.depth > ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            for index in 0..<prefix.depth:
                prefix_component: (known: bool, kind: sview, field: sview, value: i64, expression_root: usize) = proof_resource_path_component(report, prefix.path_root, index, prefix.depth)
                target_component: (known: bool, kind: sview, field: sview, value: i64, expression_root: usize) = proof_resource_path_component(report, target.path_root, index, target.depth)
                return false if:
                    not prefix_component.known or not target_component.known or prefix_component.kind != target_component.kind
                    prefix_component.kind == "field" and prefix_component.field != target_component.field
                if prefix_component.kind == "index":
                    if proof_resource_index_is_closed(report, prefix_component.expression_root) and proof_resource_index_is_closed(report, target_component.expression_root):
                        return false if prefix_component.value != target_component.value
                    else:
                        return false if (proof_resource_symbolic_indices_disjoint(state, report, prefix_component.expression_root, target_component.expression_root) can Global{Read,Write})
            return true

        def proof_resource_places_overlap[@s, @r](state: mutable ProofResourceState& @s, report: mutable ProofReport& @r, left: ProofResourcePlace, right: ProofResourcePlace) -> bool:
            return (proof_resource_place_is_prefix(state, report, left, right) can Global{Read,Write}) or (proof_resource_place_is_prefix(state, report, right, left) can Global{Read,Write})

        # Field/index roots and calls now have a stable root identity. Unsupported dynamic
        # selectors are intentionally widened to the whole root, retaining soundness without
        # pretending that two runtime indexes are disjoint.
        def proof_resource_direct_borrow_root(expression: Ast::Expr, report: mutable ProofReport&) -> sview:
            proof_resource_direct_borrow_root_with_depth(expression, report, 0)

        def proof_resource_direct_borrow_root_with_depth(expression: Ast::Expr, report: mutable ProofReport&, depth: usize) -> sview:
            if depth >= PROOF_RESOURCE_EXPRESSION_DEPTH_LIMIT:
                proof_source_index_work_charge(report, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1)
                return ""
            return "" if not proof_source_index_work_charge(report, 1)
            match expression:
                Ast::Expr.Unary(operator, operand, _):
                    if operator == TokenKind.Ampersand:
                        match operand:
                            Ast::Expr.Ident(name, _):
                                return name
                            Ast::Expr.Paren(inner, _):
                                match inner:
                                    Ast::Expr.Ident(name, _):
                                        return name
                                    _:
                                        pass
                            _:
                                pass
                Ast::Expr.Paren(inner, _):
                    return proof_resource_direct_borrow_root_with_depth(inner, report, depth + 1)
                _:
                    pass
            return ""

        def proof_resource_place_root(expression: Ast::Expr, report: mutable ProofReport&) -> sview:
            proof_resource_place_root_with_depth(expression, report, 0)

        def proof_resource_place_root_with_depth(expression: Ast::Expr, report: mutable ProofReport&, depth: usize) -> sview:
            if depth >= PROOF_RESOURCE_EXPRESSION_DEPTH_LIMIT:
                proof_source_index_work_charge(report, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1)
                return ""
            return "" if not proof_source_index_work_charge(report, 1)
            match expression:
                Ast::Expr.Ident(name, _):
                    return name
                Ast::Expr.Field(object, _, _):
                    return proof_resource_place_root_with_depth(object, report, depth + 1)
                Ast::Expr.Index(object, _, _):
                    return proof_resource_place_root_with_depth(object, report, depth + 1)
                Ast::Expr.IndexN(object, _, _):
                    return proof_resource_place_root_with_depth(object, report, depth + 1)
                Ast::Expr.Slice(object, _, _, _):
                    return proof_resource_place_root_with_depth(object, report, depth + 1)
                Ast::Expr.Scope(base, _, _):
                    return proof_resource_place_root_with_depth(base, report, depth + 1)
                Ast::Expr.Paren(inner, _):
                    return proof_resource_place_root_with_depth(inner, report, depth + 1)
                _:
                    return ""

        def proof_resource_access_place[@r](expression: Ast::Expr, report: mutable ProofReport& @r) -> (known: bool, place: ProofResourcePlace):
            decoded: (known: bool, place: ProofResourcePlace) = proof_resource_place(expression, report)
            return decoded if decoded.known
            root: sview = proof_resource_place_root(expression, report)
            if root != "":
                encoded: (known: bool, root: usize) = proof_resource_encode_expression(Ast::Expr.Ident(root, proof_resource_default_position()), report)
                return (false, proof_resource_empty_place()) if not encoded.known
                return (false, ProofResourcePlace{root: root, path_root: encoded.root, depth: 0, whole: true, exact: false})
            return decoded

        def proof_resource_encode_access_place[@r](expression: Ast::Expr, report: mutable ProofReport& @r) -> usize:
            decoded: (known: bool, place: ProofResourcePlace) = proof_resource_place(expression, report)
            return decoded.place.path_root if decoded.known
            root: sview = proof_resource_place_root(expression, report)
            if root != "":
                encoded: (known: bool, root: usize) = proof_resource_encode_expression(Ast::Expr.Ident(root, proof_resource_default_position()), report)
                return encoded.root if encoded.known
            return 0
        def proof_resource_encode_borrow_place[@r](expression: Ast::Expr, report: mutable ProofReport& @r, depth: usize = 0) -> (known: bool, root: usize):
            empty: (known: bool, root: usize) = (false, 0)
            return empty if depth >= PROOF_RESOURCE_EXPRESSION_DEPTH_LIMIT
            match expression:
                Ast::Expr.Unary(operator, operand, _):
                    if operator == TokenKind.Ampersand:
                        decoded: (known: bool, place: ProofResourcePlace) = proof_resource_place(operand, report)
                        return (true, decoded.place.path_root) if decoded.known
                        root_name: sview = proof_resource_place_root(operand, report)
                        return empty if root_name == ""
                        return proof_resource_encode_expression(Ast::Expr.Ident(root_name, proof_resource_default_position()), report)
                Ast::Expr.Paren(inner, _):
                    return proof_resource_encode_borrow_place(inner, report, depth + 1)
                _:
                    pass
            return empty

        def proof_resource_function_index(functions: ProofFunctionTable&, name: sview) -> usize:
            # Resource summaries use the same leaf-name view as the current callable importer.
            # A qualified module call with a duplicated leaf cannot safely select the first
            # summary, so compare exact names and fail closed on duplicate leaves.
            index: mutable usize = 0
            found: mutable usize = functions.lookup.names.count
            while index < functions.lookup.names.count |index, functions, name, found|:
                if functions.lookup.names[index] == name:
                    return functions.lookup.names.count if found < functions.lookup.names.count
                    found <- index
                index <- index + 1
            return found

        def proof_resource_function_owner[@r](functions: ProofFunctionTable& @r, function_index: usize) -> sview @r:
            return functions.lookup.owner_modules[function_index] if function_index < functions.lookup.owner_modules.count
            return ""

        # Return zero only for a complete indexed miss. One means the name exists; two is the
        # fail-closed sentinel for a malformed or incomplete index. Callers only need the
        # zero/nonzero distinction when deciding whether a spelling is a builtin.
        def proof_resource_function_name_count(functions: ProofFunctionTable&, name: sview) -> usize:
            work: mutable usize = 0
            lookup: (complete: bool, row: usize, repeated: bool) = proof_function_name_lookup_with_work(functions, name, &work)
            return 2 if not lookup.complete or work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or lookup.row > functions.lookup.names.count
            return 1 if lookup.row < functions.lookup.names.count
            return 0

        # `as_sview` is a borrowing builtin only when the complete source index has no function
        # or extern with that selector and no import can add a competing dispatch target. Keep
        # this check shared by region inference and event construction.
        def proof_resource_builtin_sview_conversion(expression: Ast::Expr, functions: ProofFunctionTable&, report: mutable ProofReport&, depth: usize) -> (known: bool, receiver: Ast::Expr) can[Memory.Allocate, Abort.Panic]:
            if depth >= PROOF_RESOURCE_EXPRESSION_DEPTH_LIMIT:
                proof_source_index_work_charge(report, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1)
                return (false, Ast::Expr.Invalid)
            match expression:
                Ast::Expr.Call(callee, arguments, _, _):
                    return (false, Ast::Expr.Invalid) if arguments.count != 0
                    method: (known: bool, receiver: Ast::Expr, method: sview) = proof_resource_method_receiver(callee, report)
                    declared: (complete: bool, count: usize, row: usize) = proof_source_effect_field_conversion_lookup(report, method.method) if method.known and method.method == "as_sview" else (false, 0, 0)
                    valid: bool = method.known and method.method == "as_sview" and declared.complete and declared.count == 0 and not report.source_types.source_effect_index.conversions.field_conversion_custom_cast_present and not report.source_types.source_effect_index.conversions.field_dispatch_imports_present
                    return (valid, method.receiver if valid else Ast::Expr.Invalid)
                Ast::Expr.Paren(inner, _):
                    return proof_resource_builtin_sview_conversion(inner, functions, report, depth + 1)
                _:
                    return (false, Ast::Expr.Invalid)

        # A collection builtin invoked as a method on a place: `values.push(x)`, `a.extend(b)`,
        # `a.clear()`, `a.resize(n)`, `a.pop()`. The receiver is returned so the call can be
        # recorded as what it is -- a write to that place.
        # Alias analysis has no resource binding/type environment. Keep its coarse candidate
        # classification separate; only the resource producer admits a write after the typed
        # `_with_state` check above.
        def proof_resource_collection_builtin(callee: Ast::Expr, functions: ProofFunctionTable&) -> (known: bool, receiver: Ast::Expr) can[Memory.Allocate, Abort.Panic]:
            stripped: Ast::Expr = proof_strip_parens(callee)
            match stripped:
                Ast::Expr.Field(receiver, method, _):
                    return (false, Ast::Expr.Invalid) if:
                        method not in {"push", "extend", "clear", "resize", "pop", "truncate"}
                        proof_resource_function_name_count(functions, method) != 0
                        proof_place_root_name(receiver, 0) == ""
                    return (true, receiver)
                _:
                    return (false, Ast::Expr.Invalid)

        # Any call written as a method on a place. The receiver of one is not among the callee's
        # arguments, so no argument mapping can ever describe what the call does to it: either the
        # receiver's effect is modelled here by name, or it is not modelled at all.
        def proof_resource_method_receiver(callee: Ast::Expr, report: mutable ProofReport&) -> (known: bool, receiver: Ast::Expr, method: sview) can[Memory.Allocate, Abort.Panic]:
            stripped: Ast::Expr = proof_resource_strip_parens_with_work(callee, report, 0)
            match stripped:
                Ast::Expr.Field(receiver, method, _):
                    return (false, Ast::Expr.Invalid, "") if method == "" or proof_resource_place_root(receiver, report) == ""
                    return (true, receiver, method)
                _:
                    return (false, Ast::Expr.Invalid, "")

        # A compiler conversion reads its receiver without mutating it. `as_sview` is special in
        # that its result borrows the receiver; region provenance is tracked separately.
        def proof_resource_pure_conversion(method: sview) -> bool:
            return true if:
                method in {"i8", "i16", "i32", "i64", "isize"}
                method in {"u8", "u16", "u32", "u64", "usize"}
                method in {"f32", "f64", "bool", "sview", "as_sview"}
            return false

        # An argument that transfers ownership. The collection model reads its arguments; it does
        # not model a value moved into the collection, so a `move` argument is refused.
        def proof_resource_argument_moves(arguments: darray[Ast::Expr]&) -> bool can[Memory.Allocate, Abort.Panic]:
            for argument in arguments:
                match proof_strip_parens(argument):
                    Ast::Expr.Move(_, _):
                        return true
                    _:
                        pass
            return false

        # Resource summaries are recorded at the exact function-table slot when the body pass
        # emits them. Recheck that binding here so a stale or misaligned root can only refuse a
        # call; it can never redirect a call to another function's summary.
        def proof_resource_summary_root_for_function(functions: ProofFunctionTable&, report: mutable ProofReport&, function_index: usize) -> usize:
            empty_root: usize = report.analysis_1.kernel.nodes.count
            return empty_root if function_index >= functions.lookup.names.count
            return empty_root if function_index >= functions.lookup.owner_modules.count
            return empty_root if function_index >= functions.summaries.verified.count
            return empty_root if not functions.summaries.verified[function_index]
            return empty_root if function_index >= functions.summaries.resource_summary_roots.count
            return empty_root if function_index >= functions.summaries.resource_summary_root_valid.count
            return empty_root if not functions.summaries.resource_summary_root_valid[function_index]
            root: usize = functions.summaries.resource_summary_roots[function_index]
            return empty_root if root >= report.analysis_1.kernel.nodes.count
            node: ElisaProofKernelCore::ProofKernelNode = report.analysis_1.kernel.nodes[root]
            name: sview = functions.lookup.names[function_index]
            owner: sview = functions.lookup.owner_modules[function_index]
            return empty_root if:
                not proof_source_index_work_charge(report, 1)
                not proof_source_index_work_charge(report, sview_len(node.kind))
                not proof_source_index_work_charge(report, sview_len(node.name))
                not proof_source_index_work_charge(report, sview_len(name))
                not proof_source_index_work_charge(report, sview_len(node.operator))
                not proof_source_index_work_charge(report, sview_len(node.secondary_name))
                not proof_source_index_work_charge(report, sview_len(owner))
                node.kind != "resource-safety" or node.name != name or node.operator != "resource-v2" or node.secondary_name != owner
            root

        # A resource summary is usable only after the callee's complete executable summary has
        # converged. In particular, a provisional recursive SCC must not consume one of its own
        # members' traces: doing so would turn a cyclic assumption into a certificate.
        def proof_resource_summary_is_ready(functions: ProofFunctionTable&, report: mutable ProofReport&, caller_index: usize, callee_index: usize, caller_is_lemma: bool) -> (known: bool, root: usize):
            empty_root: usize = report.analysis_1.kernel.nodes.count
            return (false, empty_root) if callee_index >= functions.lookup.names.count or callee_index >= functions.summaries.verified.count or not functions.summaries.verified[callee_index]
            return (false, empty_root) if caller_is_lemma and caller_index != functions.lookup.names.count
            return (false, empty_root) if not caller_is_lemma and caller_index >= functions.lookup.names.count
            # Keep every later array access behind its own explicit bound. The source checker and
            # the independent replay kernel must see the same alignment facts; a compound `and`
            # guard is not a substitute for proving each indexed table has the requested slot.
            return (false, empty_root) if:
                callee_index >= functions.summaries.recursive.count
                callee_index >= functions.summaries.recursive_component_ids.count
                (not caller_is_lemma) and (caller_index >= functions.summaries.recursive.count or caller_index >= functions.summaries.recursive_component_ids.count)
            if not caller_is_lemma and functions.summaries.recursive[caller_index] and functions.summaries.recursive[callee_index]:
                return (false, empty_root) if functions.summaries.recursive_component_ids[caller_index] == functions.summaries.recursive_component_ids[callee_index]
            root: usize = proof_resource_summary_root_for_function(functions, report, callee_index)
            return (false, empty_root) if root >= report.analysis_1.kernel.nodes.count
            (true, root)

        # Calls are resource-bearing when they pass either a borrow expression or a reference
        # binding. A field borrow is included even when it does not overlap an already-live local
        # borrow: the callee still receives a capability whose effects must be summarized.
        def proof_resource_expr_carries_resource(expression: Ast::Expr, state: ProofResourceState&, report: mutable ProofReport&) -> bool:
            proof_resource_expr_carries_resource_with_depth(expression, state, report, 0)

        def proof_resource_expr_carries_resource_with_depth(expression: Ast::Expr, state: ProofResourceState&, report: mutable ProofReport&, depth: usize) -> bool:
            if depth >= PROOF_RESOURCE_EXPRESSION_DEPTH_LIMIT:
                proof_source_index_work_charge(report, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1)
                return true
            # The element count of a collection is a scalar copy. Passing one hands the callee no
            # capability over the collection, so a call is not resource-carrying on account of it
            # -- the region-value predicate already reads `x.count` this way. Treating it as a
            # resource made the call record a transition naming the collection as an actual, and
            # the kernel refuses that transition because the callee's formal is a by-value scalar.
            return true if not proof_source_index_work_charge(report, 1)
            return false if:
                proof_resource_expr_is_collection_extent(expression, state, report)
                proof_resource_is_scalar_reference_index_value(expression, state, report)
            borrowed: (known: bool, place: ProofResourcePlace) = proof_resource_borrow_place(expression, report)
            return true if borrowed.known
            match expression:
                Ast::Expr.Ident(name, _):
                    binding: (complete: bool, slot: usize) = proof_resource_lookup_with_source_work(state, name, report)
                    return true if not binding.complete
                    slot: usize = binding.slot
                    return true if:
                        slot < state.bindings.binding_names.count and (slot >= state.bindings.binding_type_marker_complete.count or not state.bindings.binding_type_marker_complete[slot])
                        slot < state.bindings.binding_reference.count and state.bindings.binding_reference[slot]
                    return proof_resource_binding_is_borrowable(state, slot)
                Ast::Expr.Paren(inner, _):
                    return proof_resource_expr_carries_resource_with_depth(inner, state, report, depth + 1)
                Ast::Expr.Field(object, _, _):
                    return proof_resource_expr_carries_resource_with_depth(object, state, report, depth + 1)
                Ast::Expr.Scope(base, _, _):
                    return proof_resource_expr_carries_resource_with_depth(base, state, report, depth + 1)
                Ast::Expr.Index(object, index, _):
                    return proof_resource_expr_carries_resource_with_depth(object, state, report, depth + 1) or proof_resource_expr_carries_resource_with_depth(index, state, report, depth + 1)
                Ast::Expr.IndexN(object, arguments, _):
                    return true if proof_resource_expr_carries_resource_with_depth(object, state, report, depth + 1)
                    for argument in arguments |argument, state, report, depth|:
                        return true if proof_resource_expr_carries_resource_with_depth(argument, state, report, depth + 1)
                    return false
                Ast::Expr.Slice(object, low, high, _):
                    return proof_resource_expr_carries_resource_with_depth(object, state, report, depth + 1) or proof_resource_expr_carries_resource_with_depth(low, state, report, depth + 1) or proof_resource_expr_carries_resource_with_depth(high, state, report, depth + 1)
                Ast::Expr.Unary(operator, operand, _):
                    return true if operator == TokenKind.Ampersand
                    return proof_resource_expr_carries_resource_with_depth(operand, state, report, depth + 1)
                Ast::Expr.Binary(left, _, right, _):
                    return proof_resource_expr_carries_resource_with_depth(left, state, report, depth + 1) or proof_resource_expr_carries_resource_with_depth(right, state, report, depth + 1)
                Ast::Expr.Call(callee, arguments, _, _):
                    return true if proof_resource_expr_carries_resource_with_depth(callee, state, report, depth + 1)
                    for argument in arguments |argument, state, report, depth|:
                        return true if proof_resource_expr_carries_resource_with_depth(argument, state, report, depth + 1)
                    return false
                Ast::Expr.StaticEffectCall(_, _, _, _, _, _):
                    lowered: (known: bool, call: Ast::Expr) = proof_lower_static_effect_call(expression)
                    return proof_resource_expr_carries_resource_with_depth(lowered.call, state, report, depth + 1) if lowered.known
                    # Ambiguous dispatch has no unique resource transition. Keep it resource-
                    # bearing so the caller cannot erase it as an ordinary value.
                    return true
                _:
                    return false

        # `new[r] value` is a fresh resource-producing argument. It has no caller binding or
        # borrow place, but its concrete region is still part of the call's lifetime contract.
        # Parentheses are transparent here so the source spelling does not change the resource
        # transition that gets serialized for replay.
