extend ElisaProof:
    private:
        def proof_resource_region_new_parts(expression: Ast::Expr) -> (known: bool, operand: Ast::Expr, region: sview):
            match expression:
                Ast::Expr.RegionNew(operand, region, _):
                    return (true, operand, region)
                Ast::Expr.Paren(inner, _):
                    return proof_resource_region_new_parts(inner)
                _:
                    pass
            return (false, Ast::Expr.Invalid, "")

        def proof_resource_call_argument_kind(expression: Ast::Expr, state: ProofResourceState&, report: mutable ProofReport&) -> sview:
            match expression:
                Ast::Expr.RegionNew(_, _, _):
                    return "region-new"
                Ast::Expr.Unary(operator, operand, _):
                    if operator == TokenKind.Ampersand:
                        borrowed: (known: bool, place: ProofResourcePlace) = proof_resource_borrow_place(expression, report)
                        return "borrow" if borrowed.known
                        return "borrow-opaque"
                Ast::Expr.Paren(inner, _):
                    return proof_resource_call_argument_kind(inner, state, report)
                Ast::Expr.Ident(name, _):
                    slot: usize = proof_resource_lookup(state, name)
                    return "reference" if slot < state.binding_reference.count and state.binding_reference[slot]
                _:
                    pass
            return "value"

        def proof_resource_map_call_arguments(functions: ProofFunctionTable&, function_index: usize, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, mapped: mutable darray[Ast::Expr]&) -> bool:
            return false if function_index >= functions.param_counts.count or function_index >= functions.param_starts.count
            parameter_count: usize = functions.param_counts[function_index]
            return false if arguments.count != parameter_count or (argument_names.count != 0 and argument_names.count != arguments.count)
            mapped.clear()
            for _ in 0..<parameter_count |mapped|:
                mapped.push(Ast::Expr.Absent)
            used: mutable darray[bool] = []
            for _ in 0..<parameter_count |used|:
                used.push(false)
            param_start: usize = functions.param_starts[function_index]
            for argument_index in 0..<arguments.count |argument_index, arguments, argument_names, mapped, used, functions, param_start, parameter_count|:
                parameter_index: mutable usize = argument_index
                if argument_names.count == arguments.count and argument_names[argument_index] != "":
                    label: sview = argument_names[argument_index]
                    parameter_index <- parameter_count
                    for candidate in 0..<parameter_count |candidate, functions, param_start, label, parameter_index|:
                        parameter_index <- candidate if functions.all_params[param_start + candidate] == label
                    return false if parameter_index >= parameter_count
                return false if used[parameter_index]
                mapped[parameter_index] <- arguments[argument_index]
                used[parameter_index] <- true
            for parameter_index in 0..<parameter_count |parameter_index, used|:
                return false if not used[parameter_index]
            return true

        # Keep allocation roots aligned with the formal parameter order. This is separate from
        # AST argument mapping because a root is a certificate index, not a source expression.
        # In particular, named calls must not accidentally attach one temporary's allocation to
        # another formal.
        def proof_resource_map_call_allocation_roots(functions: ProofFunctionTable&, function_index: usize, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, source_roots: darray[usize]&, mapped_roots: mutable darray[usize]&) -> bool:
            return false if function_index >= functions.param_counts.count or function_index >= functions.param_starts.count
            parameter_count: usize = functions.param_counts[function_index]
            return false if arguments.count != parameter_count or source_roots.count != arguments.count or (argument_names.count != 0 and argument_names.count != arguments.count)
            mapped_roots.clear()
            for _ in 0..<parameter_count |mapped_roots|:
                mapped_roots.push(0)
            used: mutable darray[bool] = []
            for _ in 0..<parameter_count |used|:
                used.push(false)
            param_start: usize = functions.param_starts[function_index]
            for argument_index in 0..<arguments.count |argument_index, arguments, argument_names, source_roots, mapped_roots, used, functions, param_start, parameter_count|:
                parameter_index: mutable usize = argument_index
                if argument_names.count == arguments.count and argument_names[argument_index] != "":
                    label: sview = argument_names[argument_index]
                    parameter_index <- parameter_count
                    for candidate in 0..<parameter_count |candidate, functions, param_start, label, parameter_index|:
                        parameter_index <- candidate if functions.all_params[param_start + candidate] == label
                    return false if parameter_index >= parameter_count
                return false if used[parameter_index]
                mapped_roots[parameter_index] <- source_roots[argument_index]
                used[parameter_index] <- true
            for parameter_index in 0..<parameter_count |parameter_index, used|:
                return false if not used[parameter_index]
            return true

        def proof_resource_call_source_actual(expression: Ast::Expr, state: ProofResourceState&, report: mutable ProofReport&) -> (known: bool, place: ProofResourcePlace, slot: usize, is_reference: bool, mutable_reference: bool, writable: bool):
            empty: ProofResourcePlace = proof_resource_empty_place()
            kind: sview = proof_resource_call_argument_kind(expression, state, report)
            if kind == "region-new":
                # The allocation is fresh, so it cannot overlap an existing caller borrow. Treat
                # it as writable for a mutable reference formal; replay separately validates the
                # allocation root and discards effects that cannot escape the temporary.
                return (true, empty, state.binding_names.count, false, true, true)
            if kind == "value":
                return (true, empty, state.binding_names.count, false, false, false)
            if kind == "borrow":
                borrowed: (known: bool, place: ProofResourcePlace) = proof_resource_borrow_place(expression, report)
                return (false, empty, state.binding_names.count, false, false, false) if not borrowed.known
                slot: usize = proof_resource_lookup(state, borrowed.place.root)
                return (false, empty, state.binding_names.count, false, false, false) if slot >= state.binding_names.count or proof_resource_binding_is_moved(state, slot)
                writable: mutable bool = slot < state.binding_writable.count and state.binding_writable[slot]
                writable <- true if slot < state.binding_mutable_reference.count and state.binding_mutable_reference[slot]
                return (true, borrowed.place, slot, false, slot < state.binding_mutable_reference.count and state.binding_mutable_reference[slot], writable)
            place: (known: bool, place: ProofResourcePlace) = proof_resource_place(expression, report)
            slot: usize = proof_resource_lookup(state, place.place.root)
            return (false, empty, state.binding_names.count, false, false, false) if not place.known or slot >= state.binding_names.count or slot >= state.binding_reference.count or not state.binding_reference[slot] or proof_resource_binding_is_moved(state, slot)
            target: mutable ProofResourcePlace = place.place
            target <- state.borrow_target_places[slot] if slot < state.borrow_present.count and state.borrow_present[slot] and slot < state.borrow_target_places.count and state.borrow_target_places[slot].root != ""
            target <- ProofResourcePlace{root: place.place.root, path_root: place.place.path_root, depth: 0, whole: true} if target.root == ""
            writable: mutable bool = slot < state.binding_writable.count and state.binding_writable[slot]
            writable <- true if slot < state.binding_mutable_reference.count and state.binding_mutable_reference[slot]
            return (true, target, slot, true, slot < state.binding_mutable_reference.count and state.binding_mutable_reference[slot], writable)

        # This mirrors only the call-site permission preconditions. The kernel repeats the same
        # checks from the serialized nodes; keeping the producer-side diagnostic here avoids
        # turning an obvious alias conflict into a bare replay gap.
        def proof_resource_callee_parameter_node(report: ProofReport&, callee: ElisaProofKernelCore::ProofKernelNode, parameter_index: usize) -> (known: bool, node: ElisaProofKernelCore::ProofKernelNode):
            empty: ElisaProofKernelCore::ProofKernelNode = ElisaProofKernelCore::ProofKernelNode{kind: "", operator: "", left: 0, right: 0, auxiliary: 0, children_start: 0, children_count: 0, value: 0, name: "", secondary_name: ""}
            return (false, empty) if callee.children_start > report.kernel_children.count or callee.children_count > report.kernel_children.count - callee.children_start
            bind_index: mutable usize = 0
            for offset in 0..<callee.children_count |offset, callee, report, parameter_index, bind_index|:
                child: usize = report.kernel_children[callee.children_start + offset]
                continue if child >= report.kernel_nodes.count
                candidate: ElisaProofKernelCore::ProofKernelNode = report.kernel_nodes[child]
                continue if candidate.kind != "resource-bind"
                if bind_index == parameter_index:
                    return (true, candidate)
                bind_index <- bind_index + 1
            return (false, empty)

        def proof_resource_call_source_compatible(state: mutable ProofResourceState&, report: mutable ProofReport&, callee_root: usize, function_index: usize, mapped: darray[Ast::Expr]&, functions: ProofFunctionTable&) -> bool:
            return false if callee_root >= report.kernel_nodes.count
            callee: ElisaProofKernelCore::ProofKernelNode = report.kernel_nodes[callee_root]
            return false if callee.kind != "resource-safety" or callee.auxiliary != mapped.count
            return false if callee.children_start > report.kernel_children.count or callee.children_count > report.kernel_children.count - callee.children_start
            for parameter_index in 0..<mapped.count |parameter_index, mapped, report, callee, state|:
                formal_node: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_resource_callee_parameter_node(report, callee, parameter_index)
                return false if not formal_node.known
                formal: ElisaProofKernelCore::ProofKernelNode = formal_node.node
                formal_reference: bool = formal.operator == "external-shared" or formal.operator == "external-mutable"
                actual_kind: sview = proof_resource_call_argument_kind(mapped[parameter_index], state, report)
                actual: (known: bool, place: ProofResourcePlace, slot: usize, is_reference: bool, mutable_reference: bool, writable: bool) = proof_resource_call_source_actual(mapped[parameter_index], state, report)
                formal_region: sview = proof_resource_function_parameter_region(functions, function_index, parameter_index)
                actual_region: sview = proof_resource_expr_region(mapped[parameter_index], state)
                # A lifetime pinned to the caller's frame is satisfied by a place the caller holds
                # outright, which has no region of its own; that case is checked by the frame
                # pinning rule rather than by matching an active region here.
                frame_lifetime: bool = formal_region != "" and actual_region == "" and proof_resource_frame_lifetime_pinnable(state, functions, function_index, mapped, formal_region, report)
                return false if formal_region != "" and not frame_lifetime and (actual_region == "" or not proof_resource_region_is_active(state, actual_region))
                return false if formal_region == "" and actual_region != "" and actual_kind != "region-new"
                if formal_reference:
                    return false if actual_kind != "borrow" and actual_kind != "reference" and actual_kind != "region-new" or not actual.known
                    return false if actual_kind != "region-new" and actual.place.root == ""
                    if formal.operator == "external-mutable":
                        if actual_kind != "region-new":
                            return false if actual_kind == "reference" and not actual.mutable_reference
                            if actual_kind == "borrow":
                                if actual.slot < state.binding_reference.count and state.binding_reference[actual.slot]:
                                    return false if not actual.mutable_reference
                                else:
                                    return false if not actual.writable
                            return false if proof_resource_has_borrow_overlap(state, report, actual.place, actual.slot if actual.is_reference else state.binding_names.count)
                    else:
                        if actual_kind != "region-new":
                            return false if proof_resource_has_mutable_borrow_overlap(state, report, actual.place, actual.slot if actual.is_reference else state.binding_names.count)
                else:
                    return false if actual_kind != "value"
            return false if proof_resource_call_source_has_pairwise_alias(state, report, callee_root, mapped)
            return true

        # A call creates all of its argument borrows at one boundary. Checking each actual only
        # against borrows that existed before the call misses `f(&x, &x)` (and the equivalent
        # reference-slot form): the two temporaries do not enter the caller state, but they still
        # alias each other while the callee is running. Shared formals may alias shared actuals;
        # any pair involving a mutable formal must be disjoint. Fresh `new[r]` arguments have no
        # caller place and are intentionally excluded.
        def proof_resource_call_source_has_pairwise_alias(state: mutable ProofResourceState&, report: mutable ProofReport&, callee_root: usize, mapped: darray[Ast::Expr]&) -> bool:
            return false if callee_root >= report.kernel_nodes.count
            callee: ElisaProofKernelCore::ProofKernelNode = report.kernel_nodes[callee_root]
            return false if callee.kind != "resource-safety" or callee.auxiliary != mapped.count
            places: mutable darray[ProofResourcePlace] = []
            has_place: mutable darray[bool] = []
            mutable_formal: mutable darray[bool] = []
            for parameter_index in 0..<mapped.count |parameter_index, mapped, report, callee, state, places, has_place, mutable_formal|:
                formal_node: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_resource_callee_parameter_node(report, callee, parameter_index)
                return false if not formal_node.known
                formal: ElisaProofKernelCore::ProofKernelNode = formal_node.node
                actual_kind: sview = proof_resource_call_argument_kind(mapped[parameter_index], state, report)
                actual: (known: bool, place: ProofResourcePlace, slot: usize, is_reference: bool, mutable_reference: bool, writable: bool) = proof_resource_call_source_actual(mapped[parameter_index], state, report)
                places.push(actual.place)
                is_reference_formal: bool = formal.operator == "external-shared" or formal.operator == "external-mutable"
                has_place.push(is_reference_formal and actual_kind != "region-new" and actual.known and actual.place.root != "")
                mutable_formal.push(formal.operator == "external-mutable")
            for left_index in 0..<places.count |left_index, places, has_place, mutable_formal, state, report|:
                continue if not has_place[left_index]
                for right_index in 0..<places.count |right_index, left_index, places, has_place, mutable_formal, state, report|:
                    continue if right_index <= left_index or not has_place[right_index]
                    continue if not mutable_formal[left_index] and not mutable_formal[right_index]
                    return true if proof_resource_places_overlap(state, report, places[left_index], places[right_index])
            return false

        # Infer a symbolic callee region only from an explicitly region-pinned formal and a
        # directly tracked caller value carrying that same region. A scalar argument cannot infer
        # `@r`; accepting the ambient region in that case would make a generic allocation summary
        # depend on an unstated call-site fact. Every region parameter must have a witness, and
        # every region-owned actual must be consumed by a matching pinned formal.
        # The distinguished mapping for a lifetime pinned to the caller's own frame. It is not a
        # region with an extent to open and close: the caller's frame outlives any call it makes,
        # which is the whole content of the claim. A hyphen keeps the name outside the identifier
        # grammar, so it can never collide with a region a source file declared.
        def proof_resource_frame_region_name() -> sview:
            return "@call-frame"

        # A formal lifetime with no region-carrying actual can still be pinned, when every actual
        # that receives it is a place the caller holds outright: a caller local outlives the call
        # that borrows it, so instantiating the lifetime to a region whose extent is exactly the
        # call is sound. The region is opened before the call and closed after, which is also what
        # bounds it — nothing the callee allocates into that lifetime may outlive the call, and the
        # existing region machinery enforces that without a new concept.
        def proof_resource_frame_lifetime_pinnable(state: ProofResourceState&, functions: ProofFunctionTable&, function_index: usize, mapped: darray[Ast::Expr]&, formal_region: sview, report: mutable ProofReport&) -> bool:
            received: mutable bool = false
            for parameter_index in 0..<mapped.count |parameter_index, mapped, functions, function_index, formal_region, state, report, received|:
                parameter_region: sview = proof_resource_function_parameter_region(functions, function_index, parameter_index)
                continue if parameter_region != formal_region
                received <- true
                argument: Ast::Expr = mapped[parameter_index]
                # A region-carrying actual is handled by the ordinary pinning above; reaching here
                # with one would mean the two rules disagree about the same lifetime.
                return false if proof_resource_expr_region(argument, state) != ""
                kind: sview = proof_resource_call_argument_kind(argument, state, report)
                return false if kind != "reference" and kind != "borrow"
                actual: (known: bool, place: ProofResourcePlace, slot: usize, is_reference: bool, mutable_reference: bool, writable: bool) = proof_resource_call_source_actual(argument, state, report)
                return false if not actual.known or actual.place.root == ""
                # The place must be one the caller still holds for the whole call.
                return false if actual.slot >= state.binding_names.count
                return false if actual.slot < state.binding_moved.count and state.binding_moved[actual.slot]
                return false if proof_resource_binding_region(state, actual.slot) != ""
            return received

        def proof_resource_collect_call_regions(state: ProofResourceState&, functions: ProofFunctionTable&, function_index: usize, mapped: darray[Ast::Expr]&, formal_regions: mutable darray[sview]&, actual_regions: mutable darray[sview]&) -> bool:
            formal_regions.clear()
            actual_regions.clear()
            region_count: usize = proof_resource_function_region_param_count(functions, function_index)
            for region_index in 0..<region_count |region_index, functions, function_index, mapped, formal_regions, actual_regions, state|:
                formal_region: sview = proof_resource_function_region_param_at(functions, function_index, region_index)
                return false if formal_region == ""
                actual_region: mutable sview = ""
                for parameter_index in 0..<mapped.count |parameter_index, mapped, functions, function_index, formal_region, actual_region, state|:
                    parameter_region: sview = proof_resource_function_parameter_region(functions, function_index, parameter_index)
                    continue if parameter_region != formal_region
                    candidate: sview = proof_resource_expr_region(mapped[parameter_index], state)
                    return false if candidate == "" or not proof_resource_region_is_active(state, candidate)
                    actual_region <- candidate if actual_region == ""
                    return false if actual_region != candidate
                return false if actual_region == ""
                formal_regions.push(formal_region)
                actual_regions.push(actual_region)
            for parameter_index in 0..<mapped.count |parameter_index, mapped, functions, function_index, formal_regions, state|:
                candidate: sview = proof_resource_expr_region(mapped[parameter_index], state)
                parameter_region: sview = proof_resource_function_parameter_region(functions, function_index, parameter_index)
                new_parts: (known: bool, operand: Ast::Expr, region: sview) = proof_resource_region_new_parts(mapped[parameter_index])
                return false if candidate != "" and parameter_region == "" and not new_parts.known
                return false if candidate != "" and not new_parts.known and not any formal_region in formal_regions where formal_region == parameter_region
            return true

        # The same mapping, with the frame-lifetime fallback. It is tried only after the ordinary
        # pinning has already failed, so no call that maps today changes behavior: this widens the
        # rule strictly, and only for a lifetime nothing else could pin.
        def proof_resource_collect_call_regions_framed(state: ProofResourceState&, functions: ProofFunctionTable&, function_index: usize, mapped: darray[Ast::Expr]&, formal_regions: mutable darray[sview]&, actual_regions: mutable darray[sview]&, frame_pinned: mutable bool&, report: mutable ProofReport&, lending: bool) -> bool:
            frame_pinned <- false
            return true if proof_resource_collect_call_regions(state, functions, function_index, mapped, formal_regions, actual_regions)
            formal_regions.clear()
            actual_regions.clear()
            region_count: usize = proof_resource_function_region_param_count(functions, function_index)
            for region_index in 0..<region_count |region_index, functions, function_index, mapped, formal_regions, actual_regions, state, frame_pinned, report|:
                formal_region: sview = proof_resource_function_region_param_at(functions, function_index, region_index)
                return false if formal_region == ""
                actual_region: mutable sview = ""
                carries: mutable bool = false
                for parameter_index in 0..<mapped.count |parameter_index, mapped, functions, function_index, formal_region, actual_region, state, carries|:
                    parameter_region: sview = proof_resource_function_parameter_region(functions, function_index, parameter_index)
                    continue if parameter_region != formal_region
                    candidate: sview = proof_resource_expr_region(mapped[parameter_index], state)
                    continue if candidate == ""
                    carries <- true
                    return false if not proof_resource_region_is_active(state, candidate)
                    actual_region <- candidate if actual_region == ""
                    return false if actual_region != candidate
                if not carries:
                    return false if not proof_resource_frame_lifetime_pinnable(state, functions, function_index, mapped, formal_region, report)
                    frame_pinned <- true
                    actual_region <- proof_resource_frame_region_name()
                return false if actual_region == ""
                formal_regions.push(formal_region)
                actual_regions.push(actual_region)
            for parameter_index in 0..<mapped.count |parameter_index, mapped, functions, function_index, formal_regions, state, lending|:
                candidate: sview = proof_resource_expr_region(mapped[parameter_index], state)
                parameter_region: sview = proof_resource_function_parameter_region(functions, function_index, parameter_index)
                new_parts: (known: bool, operand: Ast::Expr, region: sview) = proof_resource_region_new_parts(mapped[parameter_index])
                # A region-owned actual reaching a formal that declares *no* lifetime is a
                # capability the callee cannot name: with no lifetime parameter to bind it to, it
                # can neither allocate into that region nor return anything from it, and a lend
                # already requires the callee to return no reference and no region. The reference
                # is still liveness-checked as an ordinary borrow on both sides. On the summary
                # path the callee's own trace is what places such an actual, so the refusal stands.
                lifetime_free_callee: bool = proof_resource_function_region_param_count(functions, function_index) == 0
                return false if candidate != "" and parameter_region == "" and not new_parts.known and not lending
                return false if candidate != "" and parameter_region == "" and not new_parts.known and not lifetime_free_callee
                return false if candidate != "" and not new_parts.known and parameter_region != "" and not any formal_region in formal_regions where formal_region == parameter_region
            return true if lending
            return frame_pinned

        def proof_resource_add_region_call_allocation[@s, @r](state: mutable ProofResourceState& @s, report: mutable ProofReport& @r, operand: Ast::Expr, region: sview, position: Ast::Pos, function_name: sview) -> usize:
            encoded_value: (known: bool, root: usize) = proof_resource_encode_expression(operand, report)
            encoded: usize = encoded_value.root
            valid: mutable bool = encoded_value.known
            valid <- proof_resource_region_is_active(state, region) if valid
            valid <- report.kernel_nodes[encoded].kind != "unsupported" if valid
            proof_resource_add_failing_obligation(report, "region-allocation-unsupported", position, function_name, "a region-call allocation requires an active lexical region and a kernel-replayable operand") if not valid
            event: mutable usize = report.kernel_nodes.count
            proof_resource_record_event(state, report, "resource-region-call-alloc", "", encoded, "", region, 0) if valid
            event <- state.trace_events[state.trace_events.count - 1] if valid and state.trace_events.count > 0
            return event

        def proof_resource_record_call[@s, @r](state: mutable ProofResourceState& @s, report: mutable ProofReport& @r, callee_name: sview, callee_root: usize, function_index: usize, mapped: darray[Ast::Expr]&, allocation_roots: darray[usize]&, functions: ProofFunctionTable&) -> bool:
            return false if function_index >= functions.param_counts.count or function_index >= functions.param_starts.count
            return false if mapped.count != functions.param_counts[function_index]
            return false if allocation_roots.count != mapped.count
            formal_regions: mutable darray[sview] = []
            actual_regions: mutable darray[sview] = []
            frame_pinned: mutable bool = false
            return false if not proof_resource_collect_call_regions_framed(state, functions, function_index, mapped, &formal_regions, &actual_regions, &frame_pinned, report, false)
            return false if not proof_resource_call_source_compatible(state, report, callee_root, function_index, mapped, functions)
            param_start: usize = functions.param_starts[function_index]
            encoded_arguments: mutable darray[usize] = []
            argument_kinds: mutable darray[sview] = []
            for parameter_index in 0..<mapped.count |parameter_index, mapped, allocation_roots, functions, param_start, report, state, encoded_arguments, argument_kinds|:
                actual: Ast::Expr = mapped[parameter_index]
                actual_kind: sview = proof_resource_call_argument_kind(actual, state, report)
                return false if actual_kind == "borrow-opaque"
                encoded_value: mutable (known: bool, root: usize) = (true, allocation_roots[parameter_index])
                encoded_value <- proof_resource_encode_expression(actual, report) if actual_kind != "region-new"
                return false if not encoded_value.known
                encoded: mutable usize = encoded_value.root
                match actual:
                    Ast::Expr.Unary(operator, operand, _):
                        encoded <- proof_resource_encode_access_place(operand, report) if operator == TokenKind.Ampersand
                    Ast::Expr.Paren(inner, _):
                        match inner:
                            Ast::Expr.Unary(operator, operand, _):
                                encoded <- proof_resource_encode_access_place(operand, report) if operator == TokenKind.Ampersand
                            _:
                                pass
                    _:
                        pass
                return false if encoded >= report.kernel_nodes.count
                encoded_arguments.push(encoded)
                argument_kinds.push(actual_kind)
            needed_nodes: usize = mapped.count + formal_regions.count + 1
            needed_children: usize = mapped.count + formal_regions.count
            if not proof_resource_kernel_capacity(report, needed_nodes, needed_children, callee_name):
                proof_kernel_budget_note(report, callee_name)
                return false
            start: usize = report.kernel_children.count
            for parameter_index in 0..<mapped.count |parameter_index, encoded_arguments, argument_kinds, mapped, functions, param_start, report, state|:
                argument_region: sview = proof_resource_expr_region(mapped[parameter_index], state) if argument_kinds[parameter_index] == "region-new" else ""
                child: usize = proof_kernel_add_node(&report.kernel_nodes, "resource-call-arg", argument_kinds[parameter_index], encoded_arguments[parameter_index], 0, 0, 0, 0, 0, functions.all_params[param_start + parameter_index], argument_region)
                report.kernel_children.push(child)
            for region_index in 0..<formal_regions.count |region_index, formal_regions, actual_regions, report|:
                region_child: usize = proof_kernel_add_node(&report.kernel_nodes, "resource-call-region", "param", 0, 0, 0, 0, 0, 0, formal_regions[region_index], actual_regions[region_index])
                report.kernel_children.push(region_child)
            event: usize = proof_kernel_add_node(&report.kernel_nodes, "resource-call", "", callee_root, formal_regions.count, mapped.count, start, mapped.count + formal_regions.count, 0, callee_name, "")
            state.trace_events.push(event)
            return true

        # A call that hands every resource-carrying argument to a *shared* reference parameter
        # cannot change the caller's resource state. Elisa's type system forbids writing through a
        # non-mutable reference and forbids moving out of one, and the capability the callee holds
        # ends with the call, so the caller's bindings, borrows and regions are exactly as they
        # were. Such a call therefore needs no callee body summary — which is what makes a
        # recursive walk over a shared `darray[T]&` checkable at all, since a recursive component
        # can never consume one of its own summaries.
        #
        # The premise is the callee's declared parameter and return modes. That is compiler-typing
        # metadata, imported the same way the resource header already imports the current
        # function's own parameter modes; it is recorded in the trace so replay checks the claim's
        # shape rather than having the call disappear from the certificate.
        def proof_resource_call_is_confined_lend(functions: ProofFunctionTable&, callee_index: usize, mapped: darray[Ast::Expr]&, state: mutable ProofResourceState&, report: mutable ProofReport&) -> bool:
            return false if callee_index >= functions.param_counts.count or callee_index >= functions.param_starts.count
            return false if mapped.count != functions.param_counts[callee_index]
            # A region-polymorphic callee may allocate into a caller region, which the caller
            # cannot observe, and it cannot close one: a lifetime parameter is external in the
            # callee's own frame and no trace may close an external region. What it stores into a
            # lent place is bounded exactly as on the summary path, which also composes a callee
            # write without inspecting the written value.
            return false if callee_index >= functions.region_param_counts.count
            # A returned reference is a capability that outlives the call and would need the
            # callee's own summary to place.
            return false if callee_index >= functions.return_references.count or functions.return_references[callee_index]
            return false if callee_index >= functions.return_regions.count or functions.return_regions[callee_index] != ""
            # Each formal lifetime must be pinned to an active caller region by a region-annotated
            # actual, and an actual that carries a region must land on a formal declared with that
            # same lifetime. The collector enforces both directions, including for a callee with
            # no lifetime parameters, where any region-carrying actual is refused outright.
            formal_regions: mutable darray[sview] = []
            actual_regions: mutable darray[sview] = []
            lend_frame_pinned: mutable bool = false
            return false if not proof_resource_collect_call_regions_framed(state, functions, callee_index, mapped, &formal_regions, &actual_regions, &lend_frame_pinned, report, true)
            return false if formal_regions.count != functions.region_param_counts[callee_index]
            for region_index in 0..<actual_regions.count |region_index, actual_regions, state|:
                return false if actual_regions[region_index] == "" or not proof_resource_region_is_active(state, actual_regions[region_index])
            param_start: usize = functions.param_starts[callee_index]
            lent_places: mutable darray[ProofResourcePlace] = []
            lent_known: mutable darray[bool] = []
            lent_exclusive: mutable darray[bool] = []
            for parameter_index in 0..<mapped.count |parameter_index, mapped, functions, param_start, state, report, lent_places, lent_known, lent_exclusive|:
                slot: usize = param_start + parameter_index
                return false if slot >= functions.all_parameter_references.count or slot >= functions.all_parameter_mutable_references.count
                reference_formal: bool = functions.all_parameter_references[slot]
                exclusive_formal: bool = functions.all_parameter_mutable_references[slot]
                argument: Ast::Expr = mapped[parameter_index]
                kind: sview = proof_resource_call_argument_kind(argument, state, report)
                return false if kind != "value" and kind != "reference" and kind != "borrow"
                # A fresh `new[r]` actual has a lifetime the callee controls; it is already ruled
                # out by the argument kind. A region value reaching a formal that declares no
                # lifetime is a capability the callee cannot name: with no lifetime parameter to
                # bind it to it can neither allocate into that region nor return anything from it,
                # and a lend already requires the callee to return no reference and no region. That
                # holds for a *lent* place, whose region liveness both sides still check as an
                # ordinary borrow; a by-value formal receives a copy whose nested region values the
                # callee could keep, so the refusal stands there.
                formal_region: sview = proof_resource_function_parameter_region(functions, callee_index, parameter_index)
                return false if formal_region == "" and not reference_formal and proof_resource_expr_contains_region_value(argument, state)
                # ...and only when the callee declares no lifetime at all. A callee that has one
                # can name regions, so an unannotated formal carrying a *different* region could be
                # mixed with them; `examples/rejected_region_lend_calls.elisa` pins that refusal.
                return false if formal_region == "" and functions.region_param_counts[callee_index] > 0 and proof_resource_expr_contains_region_value(argument, state)
                lent_places.push(proof_resource_empty_place())
                lent_known.push(false)
                lent_exclusive.push(exclusive_formal)
                # A by-value formal receives no capability at all, so the actual must not be one.
                if not reference_formal:
                    return false if kind != "value"
                    continue
                # Elisa permits an implicit shared borrow (`read(values)` rather than
                # `read(&values)`). Its event is syntactically `value`, but it is valid only
                # when the expression carries a tracked resource place. Exclusive formals
                # still require explicit borrow/reference syntax.
                if kind != "borrow" and kind != "reference":
                    return false if exclusive_formal or kind != "value" or not proof_resource_expr_carries_resource(argument, state, report)
                actual: (known: bool, place: ProofResourcePlace, slot: usize, is_reference: bool, mutable_reference: bool, writable: bool) = proof_resource_call_source_actual(argument, state, report)
                return false if not actual.known or actual.place.root == ""
                lent_places[lent_places.count - 1] <- actual.place
                lent_known[lent_known.count - 1] <- true
                if exclusive_formal:
                    # The callee may write through this one, so the caller must actually hold the
                    # permission to write the whole place, and no other borrow of it may be live.
                    return false if kind == "reference" and not actual.mutable_reference
                    if kind == "borrow":
                        if actual.slot < state.binding_reference.count and state.binding_reference[actual.slot]:
                            return false if not actual.mutable_reference
                        else:
                            return false if not actual.writable
                    return false if proof_resource_has_borrow_overlap(state, report, actual.place, state.binding_names.count)
                else:
                    # Shared and exclusive access to the same place cannot be live together. The
                    # summary path excludes the lent binding's own borrow, because the summary
                    # says the callee only reads through that formal; here there is no summary to
                    # say so, and every live exclusive borrow of the place refuses the rule.
                    return false if proof_resource_has_mutable_borrow_overlap(state, report, actual.place, state.binding_names.count)
            # Every lent capability is live at once while the callee runs, so two of them may
            # overlap only when neither is exclusive.
            for left_index in 0..<lent_places.count |left_index, lent_places, lent_known, lent_exclusive, state, report|:
                continue if not lent_known[left_index]
                for right_index in 0..<lent_places.count |right_index, left_index, lent_places, lent_known, lent_exclusive, state, report|:
                    continue if right_index <= left_index or not lent_known[right_index]
                    continue if not lent_exclusive[left_index] and not lent_exclusive[right_index]
                    return false if proof_resource_places_overlap(state, report, lent_places[left_index], lent_places[right_index])
            return true

        # Record the shared-read transition. Every argument place is listed so replay re-checks
        # that each one is a live, unmoved binding at this point in the trace; nothing in the
        # state changes, which is the whole content of the claim.
