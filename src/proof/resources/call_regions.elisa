extend ElisaProof:
    private:
        # Global function rows do not describe a bare function-valued local with the same
        # spelling. Resource callers use this before consulting parameter or return metadata.
        def proof_resource_callee_shadowed_by_local(callee: Ast::Expr, state: ProofResourceState&) -> bool:
            return proof_resource_callee_shadowed_by_local_depth(callee, state, 0)

        def proof_resource_callee_shadowed_by_local_depth(callee: Ast::Expr, state: ProofResourceState&, depth: usize) -> bool:
            return true if depth >= 64
            match callee:
                Ast::Expr.Ident(local_callee, _):
                    return proof_resource_lookup(state, local_callee) < state.bindings.binding_names.count
                Ast::Expr.Paren(inner, _):
                    return proof_resource_callee_shadowed_by_local_depth(inner, state, depth + 1)
                _:
                    return false

        def proof_resource_region_new_parts(expression: Ast::Expr) -> (known: bool, operand: Ast::Expr, region: sview):
            match expression:
                Ast::Expr.RegionNew(operand, region, _):
                    return (true, operand, region)
                Ast::Expr.Paren(inner, _):
                    return proof_resource_region_new_parts(inner)
                _:
                    pass
            return (false, Ast::Expr.Invalid, "")

        def proof_resource_call_argument_kind(expression: Ast::Expr, functions: ProofFunctionTable&, state: ProofResourceState&, report: mutable ProofReport&) -> sview:
            match expression:
                Ast::Expr.RegionNew(_, _, _):
                    return "region-new"
                Ast::Expr.Unary(operator, operand, _):
                    if operator == TokenKind.Ampersand:
                        borrowed: (known: bool, place: ProofResourcePlace) = proof_resource_borrow_place(expression, report)
                        if borrowed.known:
                            slot: usize = proof_resource_lookup(state, borrowed.place.root)
                            return "borrow-opaque" if slot < state.bindings.binding_names.count and (slot >= state.bindings.binding_type_marker_complete.count or not state.bindings.binding_type_marker_complete[slot])
                            return "borrow"
                        return "borrow-opaque"
                Ast::Expr.Paren(inner, _):
                    return proof_resource_call_argument_kind(inner, functions, state, report)
                Ast::Expr.Ident(name, _):
                    slot: usize = proof_resource_lookup(state, name)
                    return "opaque" if slot < state.bindings.binding_names.count and (slot >= state.bindings.binding_type_marker_complete.count or not state.bindings.binding_type_marker_complete[slot])
                    return "reference" if slot < state.bindings.binding_reference.count and state.bindings.binding_reference[slot]
                Ast::Expr.Call(callee, _, _, _):
                    return "opaque" if proof_resource_callee_shadowed_by_local(callee, state)
                    function_index: usize = proof_function_index_for_callee(functions, callee)
                    return "opaque" if function_index >= functions.returns.return_type_marker_complete.count or not functions.returns.return_type_marker_complete[function_index]
                    return "opaque" if function_index < functions.returns.return_sviews.count and functions.returns.return_sviews[function_index]
                    return "reference" if function_index < functions.returns.return_references.count and functions.returns.return_references[function_index]
                    if function_index < functions.returns.return_scalar.count and functions.returns.return_scalar[function_index]:
                        opaque_result_work: mutable usize = report.source_types.source_effect_index.work.implicit_effect_work
                        opaque_call_result: bool = proof_resource_expr_has_opaque_call_result(expression, state, functions, &opaque_result_work, 0)
                        report.source_types.source_effect_index.work.implicit_effect_work <- opaque_result_work
                        return "opaque" if opaque_call_result
                        return "value"
                    return "opaque"
                _:
                    pass
            opaque_result_work: mutable usize = report.source_types.source_effect_index.work.implicit_effect_work
            opaque_call_result: bool = proof_resource_expr_has_opaque_call_result(expression, state, functions, &opaque_result_work, 0)
            report.source_types.source_effect_index.work.implicit_effect_work <- opaque_result_work
            return "opaque" if opaque_call_result
            return "value"

        # A non-scalar value is resource-bearing only when the selected formal can receive the
        # compiler's implicit shared borrow. Passing the same aggregate to a by-value formal is a
        # copy and must not manufacture a resource transition in the certificate.
        def proof_resource_call_argument_requires_resource(functions: ProofFunctionTable&, callee_index: usize, parameter_index: usize, expression: Ast::Expr, state: ProofResourceState&, report: mutable ProofReport&) -> bool:
            kind: sview = proof_resource_call_argument_kind(expression, functions, state, report)
            return true if:
                kind != "value"
                callee_index >= functions.parameters.metadata.param_starts.count or callee_index >= functions.parameters.metadata.all_parameter_references.count
            return false if not proof_resource_expr_carries_resource(expression, state, report)
            parameter_slot: usize = functions.parameters.metadata.param_starts[callee_index] + parameter_index
            return true if parameter_slot >= functions.parameters.metadata.all_parameter_type_marker_complete.count or not functions.parameters.metadata.all_parameter_type_marker_complete[parameter_slot]
            return parameter_slot >= functions.parameters.metadata.all_parameter_references.count or functions.parameters.metadata.all_parameter_references[parameter_slot]

        # A source-authenticated scalar extern signature receives copies, including
        # scalar reads from borrowed records. This grants no native effect/return law.
        def proof_resource_extern_scalar_value_call(functions: ProofFunctionTable&, callee_name: sview, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, state: ProofResourceState&, report: mutable ProofReport&) -> bool:
            return false if proof_resource_lookup(state, callee_name) < state.bindings.binding_names.count
            index: usize = proof_extern_signature_index_for_report(functions, callee_name, report)
            return false if index >= functions.externs.extern_signatures.count
            signature: ProofExternSignature = functions.externs.extern_signatures[index]
            return false if:
                not signature.callable or signature.variadic or not signature.parameters_valid or not signature.return_metadata_valid
                signature.return_reference or signature.return_optional or signature.return_mutable
                signature.declared_arity != arguments.count or signature.parameters.count != arguments.count
                argument_names.count != 0 and argument_names.count != arguments.count
            source = proof_replay_effect_named_declaration(&report.source.source_declarations, callee_name, 0)
            return false if source.matches != 1
            match source.declaration:
                Ast::Decl.Extern(name, first, arity, variadic, callable, result_type, _, source_position):
                    start: usize = first.usize()
                    count: usize = arity.usize()
                    return false if:
                        name != signature.name or source_position.line != signature.line or variadic or not callable or result_type != signature.return_type_name or count != signature.parameters.count
                        start > report.source_contracts.source_extern_parameters.count or count > report.source_contracts.source_extern_parameters.count - start
                    for offset in 0..<count |report, signature, start|:
                        return false if not proof_replay_extern_parameter_matches(report.source_contracts.source_extern_parameters[start + offset], signature.parameters[offset])
                _:
                    return false
            return false if not proof_replay_extern_return_metadata_matches(&report.source.source_annotations, &signature)
            position: Ast::Pos = Ast::Pos{line: signature.line, column: 0, offset: 0}
            return false if signature.return_type_name != "void" and not proof_resource_type_is_scalar(Ast::Expr.Ident(signature.return_type_name, position))
            for parameter in signature.parameters:
                return false if:
                    parameter.provenance_bearing or parameter.mutable_ref or parameter.is_ref or parameter.optional or parameter.element_type_name != "" or parameter.fn_type_line != 0
                    not proof_resource_type_is_scalar(Ast::Expr.Ident(parameter.type_name, position))
            for argument in arguments |state, report|:
                return false if proof_resource_call_argument_kind(argument, functions, state, report) != "value" or proof_expr_has_move(argument)
            return true

        def proof_resource_map_call_arguments(functions: ProofFunctionTable&, function_index: usize, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, mapped: mutable darray[Ast::Expr]&) -> bool:
            return false if function_index >= functions.parameters.metadata.param_counts.count or function_index >= functions.parameters.metadata.param_starts.count
            parameter_count: usize = functions.parameters.metadata.param_counts[function_index]
            return false if arguments.count != parameter_count or (argument_names.count != 0 and argument_names.count != arguments.count)
            mapped.clear()
            for _ in 0..<parameter_count |mapped|:
                mapped.push(Ast::Expr.Absent)
            used: mutable darray[bool] = []
            for _ in 0..<parameter_count |used|:
                used.push(false)
            param_start: usize = functions.parameters.metadata.param_starts[function_index]
            for argument_index in 0..<arguments.count |argument_index, arguments, argument_names, mapped, used, functions, param_start, parameter_count|:
                parameter_index: mutable usize = argument_index
                if argument_names.count == arguments.count and argument_names[argument_index] != "":
                    label: sview = argument_names[argument_index]
                    parameter_index <- parameter_count
                    for candidate in 0..<parameter_count |candidate, functions, param_start, label, parameter_index|:
                        parameter_index <- candidate if functions.parameters.metadata.all_params[param_start + candidate] == label
                    return false if parameter_index >= parameter_count
                return false if used[parameter_index]
                mapped[parameter_index] <- arguments[argument_index]
                used[parameter_index] <- true
            for parameter_index in 0..<parameter_count |parameter_index, used|:
                return false if not used[parameter_index]
            return true

        # Keep allocation roots aligned with the formal parameter order. This is separate from
        # AST argument mapping because a root is a certificate index, not a source expression.
        # In particular, named calls must not accidentally attach one temporary's allocation to
        # another formal.
        def proof_resource_map_call_allocation_roots(functions: ProofFunctionTable&, function_index: usize, arguments: darray[Ast::Expr]&, argument_names: darray[sview]&, source_roots: darray[usize]&, mapped_roots: mutable darray[usize]&) -> bool:
            return false if function_index >= functions.parameters.metadata.param_counts.count or function_index >= functions.parameters.metadata.param_starts.count
            parameter_count: usize = functions.parameters.metadata.param_counts[function_index]
            return false if arguments.count != parameter_count or source_roots.count != arguments.count or (argument_names.count != 0 and argument_names.count != arguments.count)
            mapped_roots.clear()
            for _ in 0..<parameter_count |mapped_roots|:
                mapped_roots.push(0)
            used: mutable darray[bool] = []
            for _ in 0..<parameter_count |used|:
                used.push(false)
            param_start: usize = functions.parameters.metadata.param_starts[function_index]
            for argument_index in 0..<arguments.count |argument_index, arguments, argument_names, source_roots, mapped_roots, used, functions, param_start, parameter_count|:
                parameter_index: mutable usize = argument_index
                if argument_names.count == arguments.count and argument_names[argument_index] != "":
                    label: sview = argument_names[argument_index]
                    parameter_index <- parameter_count
                    for candidate in 0..<parameter_count |candidate, functions, param_start, label, parameter_index|:
                        parameter_index <- candidate if functions.parameters.metadata.all_params[param_start + candidate] == label
                    return false if parameter_index >= parameter_count
                return false if used[parameter_index]
                mapped_roots[parameter_index] <- source_roots[argument_index]
                used[parameter_index] <- true
            for parameter_index in 0..<parameter_count |parameter_index, used|:
                return false if not used[parameter_index]
            return true

        def proof_resource_call_source_actual(expression: Ast::Expr, functions: ProofFunctionTable&, state: ProofResourceState&, report: mutable ProofReport&) -> (known: bool, place: ProofResourcePlace, slot: usize, is_reference: bool, mutable_reference: bool, writable: bool):
            empty: ProofResourcePlace = proof_resource_empty_place()
            kind: sview = proof_resource_call_argument_kind(expression, functions, state, report)
            if kind == "region-new":
                # The allocation is fresh, so it cannot overlap an existing caller borrow. Treat
                # it as writable for a mutable reference formal; replay separately validates the
                # allocation root and discards effects that cannot escape the temporary.
                return (true, empty, state.bindings.binding_names.count, false, true, true)
            if kind == "value":
                if proof_resource_expr_carries_resource(expression, state, report):
                    place: (known: bool, place: ProofResourcePlace) = proof_resource_place(expression, report)
                    return (false, empty, state.bindings.binding_names.count, false, false, false) if not place.known or place.place.root == ""
                    slot: usize = proof_resource_lookup(state, place.place.root)
                    return (false, empty, state.bindings.binding_names.count, false, false, false) if slot >= state.bindings.binding_names.count or proof_resource_binding_is_moved(state, slot)
                    writable: mutable bool = slot < state.bindings.binding_writable.count and state.bindings.binding_writable[slot]
                    writable <- true if slot < state.bindings.binding_mutable_reference.count and state.bindings.binding_mutable_reference[slot]
                    return (true, place.place, slot, false, slot < state.bindings.binding_mutable_reference.count and state.bindings.binding_mutable_reference[slot], writable)
                return (true, empty, state.bindings.binding_names.count, false, false, false)
            if kind == "borrow":
                borrowed: (known: bool, place: ProofResourcePlace) = proof_resource_borrow_place(expression, report)
                return (false, empty, state.bindings.binding_names.count, false, false, false) if not borrowed.known
                slot: usize = proof_resource_lookup(state, borrowed.place.root)
                return (false, empty, state.bindings.binding_names.count, false, false, false) if slot >= state.bindings.binding_names.count or proof_resource_binding_is_moved(state, slot)
                writable: mutable bool = slot < state.bindings.binding_writable.count and state.bindings.binding_writable[slot]
                writable <- true if slot < state.bindings.binding_mutable_reference.count and state.bindings.binding_mutable_reference[slot]
                return (true, borrowed.place, slot, false, slot < state.bindings.binding_mutable_reference.count and state.bindings.binding_mutable_reference[slot], writable)
            place: (known: bool, place: ProofResourcePlace) = proof_resource_place(expression, report)
            slot: usize = proof_resource_lookup(state, place.place.root)
            return (false, empty, state.bindings.binding_names.count, false, false, false) if not place.known or slot >= state.bindings.binding_names.count or slot >= state.bindings.binding_reference.count or not state.bindings.binding_reference[slot] or proof_resource_binding_is_moved(state, slot)
            target: mutable ProofResourcePlace = place.place
            target <- state.borrows.borrow_target_places[slot] if slot < state.borrows.borrow_present.count and state.borrows.borrow_present[slot] and slot < state.borrows.borrow_target_places.count and state.borrows.borrow_target_places[slot].root != ""
            target <- ProofResourcePlace{root: place.place.root, path_root: place.place.path_root, depth: 0, whole: true, exact: false} if target.root == ""
            writable: mutable bool = slot < state.bindings.binding_writable.count and state.bindings.binding_writable[slot]
            writable <- true if slot < state.bindings.binding_mutable_reference.count and state.bindings.binding_mutable_reference[slot]
            return (true, target, slot, true, slot < state.bindings.binding_mutable_reference.count and state.bindings.binding_mutable_reference[slot], writable)

        # This mirrors only the call-site permission preconditions. The kernel repeats the same
        # checks from the serialized nodes; keeping the producer-side diagnostic here avoids
        # turning an obvious alias conflict into a bare replay gap.
        def proof_resource_callee_parameter_node(report: ProofReport&, callee: ElisaProofKernelCore::ProofKernelNode, parameter_index: usize) -> (known: bool, node: ElisaProofKernelCore::ProofKernelNode):
            empty: ElisaProofKernelCore::ProofKernelNode = ElisaProofKernelCore::ProofKernelNode{kind: "", operator: "", left: 0, right: 0, auxiliary: 0, children_start: 0, children_count: 0, value: 0, name: "", secondary_name: ""}
            return (false, empty) if callee.children_start > report.analysis_1.kernel.children.count or callee.children_count > report.analysis_1.kernel.children.count - callee.children_start
            bind_index: mutable usize = 0
            for offset in 0..<callee.children_count |offset, callee, report, parameter_index, bind_index|:
                child: usize = report.analysis_1.kernel.children[callee.children_start + offset]
                continue if child >= report.analysis_1.kernel.nodes.count
                candidate: ElisaProofKernelCore::ProofKernelNode = report.analysis_1.kernel.nodes[child]
                continue if candidate.kind != "resource-bind"
                if bind_index == parameter_index:
                    return (true, candidate)
                bind_index <- bind_index + 1
            return (false, empty)

        def proof_resource_call_source_compatible(state: mutable ProofResourceState&, report: mutable ProofReport&, callee_root: usize, function_index: usize, mapped: darray[Ast::Expr]&, functions: ProofFunctionTable&) -> bool can[Global.Read, Global.Write]:
            return false if callee_root >= report.analysis_1.kernel.nodes.count
            callee: ElisaProofKernelCore::ProofKernelNode = report.analysis_1.kernel.nodes[callee_root]
            return false if:
                callee.kind != "resource-safety" or callee.auxiliary != mapped.count
                callee.children_start > report.analysis_1.kernel.children.count or callee.children_count > report.analysis_1.kernel.children.count - callee.children_start
            for parameter_index in 0..<mapped.count |parameter_index, mapped, report, callee, functions, state|:
                formal_node: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_resource_callee_parameter_node(report, callee, parameter_index)
                return false if not formal_node.known
                formal: ElisaProofKernelCore::ProofKernelNode = formal_node.node
                formal_reference: bool = formal.operator in {"external-shared", "external-mutable"}
                actual_kind: sview = proof_resource_call_argument_kind(mapped[parameter_index], functions, state, report)
                actual: (known: bool, place: ProofResourcePlace, slot: usize, is_reference: bool, mutable_reference: bool, writable: bool) = proof_resource_call_source_actual(mapped[parameter_index], functions, state, report)
                formal_region: sview = proof_resource_function_parameter_region(functions, function_index, parameter_index)
                actual_region: sview = proof_resource_expr_region(mapped[parameter_index], state)
                # A lifetime pinned to the caller's frame is satisfied by a place the caller holds
                # outright, which has no region of its own; that case is checked by the frame
                # pinning rule rather than by matching an active region here.
                frame_lifetime: bool = formal_region != "" and actual_region == "" and proof_resource_frame_lifetime_pinnable(state, functions, function_index, mapped, formal_region, report)
                return false if:
                    formal_region != "" and not frame_lifetime and (actual_region == "" or not proof_resource_region_is_active(state, actual_region))
                    formal_region == "" and actual_region != "" and actual_kind != "region-new"
                if formal_reference:
                    implicit_reference: bool = actual_kind == "value" and actual.known and actual.slot < state.bindings.binding_names.count and proof_resource_binding_is_borrowable(state, actual.slot)
                    return false if:
                        actual_kind != "borrow" and actual_kind != "reference" and actual_kind != "region-new" and not implicit_reference or not actual.known
                        actual_kind != "region-new" and actual.place.root == ""
                    if formal.operator == "external-mutable":
                        if actual_kind != "region-new":
                            return false if actual_kind == "reference" and not actual.mutable_reference
                            if actual_kind == "borrow":
                                if actual.slot < state.bindings.binding_reference.count and state.bindings.binding_reference[actual.slot]:
                                    return false if not actual.mutable_reference
                                else:
                                    return false if not actual.writable
                            if actual_kind == "value":
                                return false if not actual.writable
                            return false if (proof_resource_has_borrow_overlap(state, report, actual.place, actual.slot if actual.is_reference else state.bindings.binding_names.count) can Global{Read,Write})
                    else:
                        if actual_kind != "region-new":
                            return false if (proof_resource_has_mutable_borrow_overlap(state, report, actual.place, actual.slot if actual.is_reference else state.bindings.binding_names.count) can Global{Read,Write})
                else:
                    return false if actual_kind != "value"
            return false if (proof_resource_call_source_has_pairwise_alias(state, report, callee_root, mapped, functions) can Global{Read,Write})
            return true

        # A call creates all of its argument borrows at one boundary. Checking each actual only
        # against borrows that existed before the call misses `f(&x, &x)` (and the equivalent
        # reference-slot form): the two temporaries do not enter the caller state, but they still
        # alias each other while the callee is running. Shared formals may alias shared actuals;
        # any pair involving a mutable formal must be disjoint. Fresh `new[r]` arguments have no
        # caller place and are intentionally excluded.
        def proof_resource_call_source_has_pairwise_alias(state: mutable ProofResourceState&, report: mutable ProofReport&, callee_root: usize, mapped: darray[Ast::Expr]&, functions: ProofFunctionTable&) -> bool can[Global.Read, Global.Write]:
            return false if callee_root >= report.analysis_1.kernel.nodes.count
            callee: ElisaProofKernelCore::ProofKernelNode = report.analysis_1.kernel.nodes[callee_root]
            return false if callee.kind != "resource-safety" or callee.auxiliary != mapped.count
            places: mutable darray[ProofResourcePlace] = []
            has_place: mutable darray[bool] = []
            mutable_formal: mutable darray[bool] = []
            for parameter_index in 0..<mapped.count |parameter_index, mapped, report, callee, functions, state, places, has_place, mutable_formal|:
                formal_node: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_resource_callee_parameter_node(report, callee, parameter_index)
                return false if not formal_node.known
                formal: ElisaProofKernelCore::ProofKernelNode = formal_node.node
                actual_kind: sview = proof_resource_call_argument_kind(mapped[parameter_index], functions, state, report)
                actual: (known: bool, place: ProofResourcePlace, slot: usize, is_reference: bool, mutable_reference: bool, writable: bool) = proof_resource_call_source_actual(mapped[parameter_index], functions, state, report)
                places.push(actual.place)
                is_reference_formal: bool = formal.operator in {"external-shared", "external-mutable"}
                has_place.push(is_reference_formal and actual_kind != "region-new" and actual.known and actual.place.root != "")
                mutable_formal.push(formal.operator == "external-mutable")
            for left_index in 0..<places.count |left_index, places, has_place, mutable_formal, state, report|:
                continue if not has_place[left_index]
                for right_index in 0..<places.count |right_index, left_index, places, has_place, mutable_formal, state, report|:
                    continue if right_index <= left_index or not has_place[right_index]
                    continue if not mutable_formal[left_index] and not mutable_formal[right_index]
                    return true if (proof_resource_places_overlap(state, report, places[left_index], places[right_index]) can Global{Read,Write})
            return false

        # Infer a symbolic callee region only from an explicitly region-pinned formal and a
        # directly tracked caller value carrying that same region. A scalar argument cannot infer
        # `@r`; accepting the ambient region in that case would make a generic allocation summary
        # depend on an unstated call-site fact. Every region parameter must have a witness, and
        # every region-owned actual must be consumed by a matching pinned formal.
        # The distinguished mapping for a lifetime pinned to the caller's own frame. It is not a
        # region with an extent to open and close: the caller's frame outlives any call it makes,
        # which is the whole content of the claim. A hyphen keeps the name outside the identifier
        # grammar, so it can never collide with a region a source file declared.

include "./call_region_lending.elisa"
