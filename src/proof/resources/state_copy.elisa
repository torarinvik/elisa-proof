extend ElisaProof:
    private:
        # Copy into an already-created state. Element-wise copies put values in the destination's
        # own array storage instead of retaining a reference to a shorter-lived source array.
        def proof_resource_copy_into[@source, @target](source: ProofResourceState& @source, target: mutable ProofResourceState& @target) -> void can[Memory.Allocate, Abort.Panic]:
            target.context.function_name <- source.context.function_name
            target.context.generic_declaration_line <- source.context.generic_declaration_line
            target.context.formal_count <- source.context.formal_count
            target.context.expression_depth <- source.context.expression_depth
            target.context.formal_parameter_types.clear()
            target.bindings.inferred_names.clear()
            target.regions.active_regions.clear()
            target.statics.static_scope.clear()
            target.statics.static_names.clear()
            target.statics.static_root_names.clear()
            target.regions.protected_regions.clear()
            target.regions.external_regions.clear()
            target.regions.region_wide_borrows.clear()
            target.evidence.facts.clear()
            target.evidence.trace_events.clear()
            target.bindings.binding_names.clear()
            target.bindings.binding_reference.clear()
            target.bindings.binding_mutable_reference.clear()
            target.bindings.binding_type_marker_complete.clear()
            target.bindings.binding_writable.clear()
            target.bindings.binding_moved.clear()
            target.bindings.binding_region.clear()
            target.bindings.binding_region_live.clear()
            target.bindings.binding_region_destroyed.clear()
            target.bindings.binding_region_owner.clear()
            target.bindings.binding_scalar.clear()
            target.bindings.binding_borrowable.clear()
            target.bindings.binding_extent.clear()
            target.borrows.borrow_target_slots.clear()
            target.borrows.borrow_target_places.clear()
            target.borrows.borrow_mutable.clear()
            target.borrows.borrow_present.clear()
            for index in 0..<source.bindings.binding_names.count |index, target|:
                target.bindings.binding_names.push(source.bindings.binding_names[index])
                target.bindings.binding_reference.push(source.bindings.binding_reference[index])
                target.bindings.binding_mutable_reference.push(source.bindings.binding_mutable_reference[index])
                target.bindings.binding_type_marker_complete.push(source.bindings.binding_type_marker_complete[index])
                target.bindings.binding_writable.push(source.bindings.binding_writable[index])
                target.bindings.binding_moved.push(source.bindings.binding_moved[index])
                target.bindings.binding_region.push(source.bindings.binding_region[index])
                target.bindings.binding_region_live.push(source.bindings.binding_region_live[index])
                target.bindings.binding_region_destroyed.push(source.bindings.binding_region_destroyed[index])
                target.bindings.binding_region_owner.push(source.bindings.binding_region_owner[index])
                target.bindings.binding_scalar.push(source.bindings.binding_scalar[index])
                target.bindings.binding_borrowable.push(source.bindings.binding_borrowable[index])
                target.bindings.binding_extent.push(source.bindings.binding_extent[index])
                target.borrows.borrow_target_slots.push(source.borrows.borrow_target_slots[index])
                target.borrows.borrow_target_places.push(source.borrows.borrow_target_places[index])
                target.borrows.borrow_mutable.push(source.borrows.borrow_mutable[index])
                target.borrows.borrow_present.push(source.borrows.borrow_present[index])
            for parameter_type in source.context.formal_parameter_types |parameter_type, target|:
                target.context.formal_parameter_types.push(parameter_type)
            for inferred_name in source.bindings.inferred_names |inferred_name, target|:
                target.bindings.inferred_names.push(inferred_name)
            for region in source.regions.active_regions |region, target|:
                target.regions.active_regions.push(region)
            for scope_name in source.statics.static_scope |scope_name, target|:
                target.statics.static_scope.push(scope_name)
            for static_name in source.statics.static_names |static_name, target|:
                target.statics.static_names.push(static_name)
            for root_name in source.statics.static_root_names |root_name, target|:
                target.statics.static_root_names.push(root_name)
            for region in source.regions.protected_regions |region, target|:
                target.regions.protected_regions.push(region)
            for region in source.regions.external_regions |region, target|:
                target.regions.external_regions.push(region)
            for region in source.regions.region_wide_borrows |region, target|:
                target.regions.region_wide_borrows.push(region)
            for fact in source.evidence.facts |fact, target|:
                target.evidence.facts.push(fact)
            for event in source.evidence.trace_events |event, target|:
                target.evidence.trace_events.push(event)
