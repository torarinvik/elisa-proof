extend ElisaProof:
    private:
        # Copy into an already-created state. Element-wise copies put values in the destination's
        # own array storage instead of retaining a reference to a shorter-lived source array.
        def proof_resource_copy_into[@source, @target](source: ProofResourceState& @source, target: mutable ProofResourceState& @target) -> void can[Memory.Allocate, Abort.Panic]:
            target.function_name <- source.function_name
            target.generic_declaration_line <- source.generic_declaration_line
            target.formal_count <- source.formal_count
            target.expression_depth <- source.expression_depth
            target.formal_parameter_types.clear()
            target.inferred_names.clear()
            target.active_regions.clear()
            target.static_scope.clear()
            target.static_names.clear()
            target.static_root_names.clear()
            target.protected_regions.clear()
            target.external_regions.clear()
            target.region_wide_borrows.clear()
            target.facts.clear()
            target.trace_events.clear()
            target.binding_names.clear()
            target.binding_reference.clear()
            target.binding_mutable_reference.clear()
            target.binding_writable.clear()
            target.binding_moved.clear()
            target.binding_region.clear()
            target.binding_region_live.clear()
            target.binding_region_destroyed.clear()
            target.binding_region_owner.clear()
            target.binding_scalar.clear()
            target.binding_borrowable.clear()
            target.binding_extent.clear()
            target.borrow_target_slots.clear()
            target.borrow_target_places.clear()
            target.borrow_mutable.clear()
            target.borrow_present.clear()
            for index in 0..<source.binding_names.count |index, target|:
                target.binding_names.push(source.binding_names[index])
                target.binding_reference.push(source.binding_reference[index])
                target.binding_mutable_reference.push(source.binding_mutable_reference[index])
                target.binding_writable.push(source.binding_writable[index])
                target.binding_moved.push(source.binding_moved[index])
                target.binding_region.push(source.binding_region[index])
                target.binding_region_live.push(source.binding_region_live[index])
                target.binding_region_destroyed.push(source.binding_region_destroyed[index])
                target.binding_region_owner.push(source.binding_region_owner[index])
                target.binding_scalar.push(source.binding_scalar[index])
                target.binding_borrowable.push(source.binding_borrowable[index])
                target.binding_extent.push(source.binding_extent[index])
                target.borrow_target_slots.push(source.borrow_target_slots[index])
                target.borrow_target_places.push(source.borrow_target_places[index])
                target.borrow_mutable.push(source.borrow_mutable[index])
                target.borrow_present.push(source.borrow_present[index])
            for parameter_type in source.formal_parameter_types |parameter_type, target|:
                target.formal_parameter_types.push(parameter_type)
            for inferred_name in source.inferred_names |inferred_name, target|:
                target.inferred_names.push(inferred_name)
            for region in source.active_regions |region, target|:
                target.active_regions.push(region)
            for scope_name in source.static_scope |scope_name, target|:
                target.static_scope.push(scope_name)
            for static_name in source.static_names |static_name, target|:
                target.static_names.push(static_name)
            for root_name in source.static_root_names |root_name, target|:
                target.static_root_names.push(root_name)
            for region in source.protected_regions |region, target|:
                target.protected_regions.push(region)
            for region in source.external_regions |region, target|:
                target.external_regions.push(region)
            for region in source.region_wide_borrows |region, target|:
                target.region_wide_borrows.push(region)
            for fact in source.facts |fact, target|:
                target.facts.push(fact)
            for event in source.trace_events |event, target|:
                target.trace_events.push(event)
