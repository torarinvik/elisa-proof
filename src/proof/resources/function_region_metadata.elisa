# Aligned region metadata accessors for executable function summaries.
extend ElisaProof:
    private:
        def proof_resource_function_region_param_count(functions: ProofFunctionTable&, function_index: usize) -> usize:
            return functions.parameters.regions.region_param_counts[function_index] if function_index < functions.parameters.regions.region_param_counts.count
            return 0

        def proof_resource_function_region_param_at[@r](functions: ProofFunctionTable& @r, function_index: usize, region_index: usize) -> sview @r:
            return "" if:
                function_index >= functions.parameters.regions.region_param_starts.count or function_index >= functions.parameters.regions.region_param_counts.count
                region_index >= functions.parameters.regions.region_param_counts[function_index]
            slot: usize = functions.parameters.regions.region_param_starts[function_index] + region_index
            return functions.parameters.regions.all_region_params[slot] if slot < functions.parameters.regions.all_region_params.count
            return ""

        def proof_resource_function_parameter_region[@r](functions: ProofFunctionTable& @r, function_index: usize, parameter_index: usize) -> sview @r:
            return "" if:
                function_index >= functions.parameters.regions.all_param_region_starts.count or function_index >= functions.parameters.metadata.param_counts.count
                parameter_index >= functions.parameters.metadata.param_counts[function_index]
            slot: usize = functions.parameters.regions.all_param_region_starts[function_index] + parameter_index
            return functions.parameters.regions.all_param_regions[slot] if slot < functions.parameters.regions.all_param_regions.count
            return ""

        def proof_resource_function_return_region[@r](functions: ProofFunctionTable& @r, function_index: usize) -> sview @r:
            return functions.returns.return_regions[function_index] if function_index < functions.returns.return_regions.count
            return ""
