# Exact resource-place paths and collection-extent recognition.
extend ElisaProof:
    private:
        def proof_resource_binding_is_extent_bearing(state: ProofResourceState&, slot: usize) -> bool:
            return slot < state.bindings.binding_extent.count and state.bindings.binding_extent[slot]

        # `x.count` on a binding whose declared type is a collection is that collection's element
        # count: a machine integer copied out of it, tied to no lifetime. Everything else about a
        # region-owned binding still is.
        def proof_resource_expr_is_collection_extent(expression: Ast::Expr, state: ProofResourceState&, report: mutable ProofReport&) -> bool:
            match expression:
                Ast::Expr.Field(object, field_name, _):
                    return false if field_name != "count"
                    root: sview = proof_ident_name(object)
                    return false if root == ""
                    binding: (complete: bool, slot: usize) = proof_resource_lookup_with_source_work(state, root, report)
                    return binding.slot < state.bindings.binding_names.count and proof_resource_binding_is_extent_bearing(state, binding.slot) if binding.complete
                    return false
                _:
                    return false

        def proof_resource_empty_place() -> ProofResourcePlace:
            ProofResourcePlace{
                root: "",
                path_root: 0,
                depth: 0,
                whole: false,
                exact: false,
            }

        # The old fixed three-field representation could silently widen a fourth segment into an
        # unrelated whole-root access. State-owned structural paths give the checker arbitrary
        # named-field depth while preserving exact prefix reasoning; unlike a hash, they cannot
        # alias on a collision.
        def proof_resource_place_add_field[@r](report: mutable ProofReport& @r, parent: ProofResourcePlace, field: sview) -> (known: bool, place: ProofResourcePlace):
            empty: ProofResourcePlace = proof_resource_empty_place()
            return (false, empty) if parent.root == "" or field == "" or parent.depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            field_root: usize = proof_kernel_add_node(&report.analysis_1.kernel.nodes, "field", "", parent.path_root, 0, 0, 0, 0, 0, field, "")
            return (true, ProofResourcePlace{root: parent.root, path_root: field_root, depth: parent.depth + 1, whole: false, exact: parent.exact})

        # A literal index is a precise selector. The index expression remains an arena child of
        # the `index` node, so independent replay can require that it is actually closed.
        # Dynamic selectors stay outside this tier and are widened to the whole root below.
        def proof_resource_place_add_index[@r](report: mutable ProofReport& @r, parent: ProofResourcePlace, index_root: usize) -> (known: bool, place: ProofResourcePlace):
            empty: ProofResourcePlace = proof_resource_empty_place()
            return (false, empty) if parent.root == "" or parent.depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT or index_root >= report.analysis_1.kernel.nodes.count
            path_root: usize = proof_kernel_add_node(&report.analysis_1.kernel.nodes, "index", "", parent.path_root, index_root, 0, 0, 0, 0, "", "")
            return (true, ProofResourcePlace{root: parent.root, path_root: path_root, depth: parent.depth + 1, whole: false, exact: parent.exact})
