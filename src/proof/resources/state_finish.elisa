# Function-exit resource trace closure, split from state declarations to keep source units bounded.
extend ElisaProof:
    private:
        def proof_resource_finish[@s, @r](state: mutable ProofResourceState& @s, report: mutable ProofReport& @r, function_name: sview, line: u32, failed_before: u32, parameter_count: usize, functions: mutable ProofFunctionTable&, function_index: usize) -> void:
            return if report.results.failed != failed_before
            # Local regions are implicitly released at function exit; record their close so
            # replay sees a balanced trace. Explicit `destroy r` already removed its entry.
            while state.regions.active_regions.count > 0 and not report.analysis_1.kernel.budget_exhausted |state, report, function_name, line|:
                return if not proof_source_index_work_charge(report, 1)
                region: cstr = state.regions.active_regions[state.regions.active_regions.count - 1]
                state.regions.active_regions <- state.regions.active_regions.truncate(state.regions.active_regions.count - 1)
                region_view: mutable sview = ""
                # Entries are copied into permanent arena storage before entering this array.
                trusted Unsafe{PointerArithmetic,RawExtern}:
                    region_view <- sview(region, 0, region.len)
                if not proof_resource_region_is_external(state, region_view):
                    proof_resource_invalidate_region_bindings(state, report, region_view)
                    proof_resource_record_event(state, report, "resource-region-close", "", 0, region_view, "", 0)
            return if report.analysis_1.kernel.budget_exhausted
            if not proof_resource_kernel_capacity(report, 1, state.evidence.trace_events.count, function_name):
                proof_kernel_budget_note(report, function_name)
                return
            start: usize = report.analysis_1.kernel.children.count
            return if function_index >= functions.lookup.source.offsets.count or function_index >= functions.lookup.source.lines.count
            for event in state.evidence.trace_events |event, report|:
                if event >= report.analysis_1.kernel.nodes.count:
                    proof_kernel_budget_note(report, function_name)
                    return
            for event in state.evidence.trace_events |event, report|:
                report.analysis_1.kernel.children.push(event)
            # The parameter count is part of the certificate header. The replay kernel uses it
            # to distinguish formal external capabilities from body-local bindings when a caller
            # composes this trace into a resource-call transition.
            root: usize = proof_kernel_add_node(&report.analysis_1.kernel.nodes, "resource-safety", "resource-v2", 0, functions.lookup.source.lines[function_index].usize(), parameter_count, start, state.evidence.trace_events.count, functions.lookup.source.offsets[function_index].i64(), function_name, proof_resource_function_owner(functions, function_index))
            if root >= report.analysis_1.kernel.nodes.count:
                report.analysis_1.kernel.children <- report.analysis_1.kernel.children.truncate(start)
                proof_kernel_budget_note(report, function_name)
                return
            if function_index < functions.summaries.resource_summary_roots.count and function_index < functions.summaries.resource_summary_root_valid.count:
                functions.summaries.resource_summary_roots[function_index] <- root
                functions.summaries.resource_summary_root_valid[function_index] <- true
            proof_add_resource_goal_attempt(report, root, line, function_name)
