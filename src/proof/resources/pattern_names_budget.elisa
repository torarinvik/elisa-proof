extend ElisaProof:
    private:
        const PROOF_RESOURCE_PATTERN_WORK_BUDGET: usize = 65536

        def proof_resource_pattern_work_available(report: mutable ProofReport&, work: usize, position: Ast::Pos, function_name: sview) -> bool:
            if report.analysis_1.budgets.resource_pattern_work <= PROOF_RESOURCE_PATTERN_WORK_BUDGET and work <= PROOF_RESOURCE_PATTERN_WORK_BUDGET - report.analysis_1.budgets.resource_pattern_work:
                report.analysis_1.budgets.resource_pattern_work <- report.analysis_1.budgets.resource_pattern_work + work
                return true
            if not report.analysis_1.budgets.resource_pattern_reported:
                report.analysis_1.budgets.resource_pattern_reported <- true
                proof_add_budget_finding(report, "resource-pattern-budget", position.line, function_name, "resource pattern analysis exceeded its bounded traversal budget", "work", report.analysis_1.budgets.resource_pattern_work + work, PROOF_RESOURCE_PATTERN_WORK_BUDGET)
            return false

        def proof_resource_pattern_names_admission(pattern: Ast::Pattern) -> (complete: bool, has_bindings: bool, work: usize):
            work: mutable usize = 0
            has_bindings: mutable bool = false
            complete: bool = proof_resource_pattern_names_admission_depth(pattern, 0, &work, &has_bindings)
            (complete, has_bindings, work)

        def proof_resource_pattern_names_admission_depth(pattern: Ast::Pattern, depth: usize, work: mutable usize&, has_bindings: mutable bool&) -> bool:
            return false if depth >= PROOF_PATTERN_WALK_DEPTH_LIMIT or work >= PROOF_PATTERN_WALK_WORK_LIMIT
            work <- work + 1
            match pattern:
                Ast::Pattern.Binding(name) | Ast::Pattern.Rest(name) | Ast::Pattern.TypeBind(_, name):
                    has_bindings <- true if name != ""
                Ast::Pattern.As(name, inner):
                    has_bindings <- true if name != ""
                    for nested in inner |depth, work, has_bindings|:
                        return false if not proof_resource_pattern_names_admission_depth(nested, depth + 1, work, has_bindings)
                Ast::Pattern.Variant(_, nested) | Ast::Pattern.Struct(_, nested) | Ast::Pattern.Tuple(nested):
                    for child in nested |depth, work, has_bindings|:
                        return false if not proof_resource_pattern_names_admission_depth(child, depth + 1, work, has_bindings)
                Ast::Pattern.Field(_, nested) | Ast::Pattern.Or(nested):
                    for child in nested |depth, work, has_bindings|:
                        return false if not proof_resource_pattern_names_admission_depth(child, depth + 1, work, has_bindings)
                Ast::Pattern.Wildcard | Ast::Pattern.Literal(_) | Ast::Pattern.Pin(_) | Ast::Pattern.Range(_, _, _):
                    pass
                _:
                    return false
            return true

        def proof_resource_check_pattern_names_complete_visit[@s, @r](pattern: Ast::Pattern, state: mutable ProofResourceState& @s, report: mutable ProofReport& @r) -> void:
            match pattern:
                Ast::Pattern.Binding(binding) | Ast::Pattern.Rest(binding) | Ast::Pattern.TypeBind(_, binding):
                    proof_resource_add_binding_traced(state, report, binding, false, false, false, state.bindings.binding_names.count, false, "", proof_resource_empty_place(), 0) if binding != ""
                Ast::Pattern.As(binding, inner):
                    proof_resource_add_binding_traced(state, report, binding, false, false, false, state.bindings.binding_names.count, false, "", proof_resource_empty_place(), 0) if binding != ""
                    for nested in inner |state, report|:
                        proof_resource_check_pattern_names_complete_visit(nested, state, report)
                Ast::Pattern.Variant(_, nested) | Ast::Pattern.Struct(_, nested) | Ast::Pattern.Tuple(nested) | Ast::Pattern.Field(_, nested):
                    for child in nested |state, report|:
                        proof_resource_check_pattern_names_complete_visit(child, state, report)
                Ast::Pattern.Or(options):
                    # The source checker requires every alternative to bind the same names.
                    # Register one alternative's names once; resource-bearing sources are
                    # refused by the caller until projection provenance is modeled.
                    proof_resource_check_pattern_names_complete_visit(options[0], state, report) if options.count > 0
                _:
                    pass

        # Pattern variables need a source projection witness before they can participate in a
        # resource certificate. The transition format does not encode projections yet, so only
        # scrutinees that are provably scalar values are safe to bind without provenance. Keep
        # this allowlist deliberately smaller than the general resource-expression classifier:
        # aggregates, field/index projections, control flow, operators, strings, and future AST
        # forms may carry an opaque reference or view and therefore fail closed.
        def proof_resource_pattern_source_may_carry_resource(expression: Ast::Expr, state: ProofResourceState&, report: mutable ProofReport&, functions: mutable ProofFunctionTable&, depth: usize) -> bool:
            return true if depth >= PROOF_PATTERN_WALK_DEPTH_LIMIT
            return false if:
                proof_resource_expr_is_collection_extent(expression, state, report)
                proof_resource_is_scalar_reference_index_value(expression, state, report)
            match expression:
                Ast::Expr.IntLit(_, _) | Ast::Expr.FloatLit(_, _) | Ast::Expr.CharLit(_, _) | Ast::Expr.BoolLit(_, _):
                    return false
                Ast::Expr.Ident(name, _):
                    binding: (complete: bool, slot: usize) = proof_resource_lookup_with_source_work(state, name, report)
                    return true if not binding.complete
                    slot: usize = binding.slot
                    return true if:
                        slot >= state.bindings.binding_names.count or slot >= state.bindings.binding_reference.count or slot >= state.bindings.binding_borrowable.count or slot >= state.bindings.binding_region.count
                        state.bindings.binding_reference[slot] or state.bindings.binding_borrowable[slot] or proof_resource_binding_region(state, slot) != ""
                    return false
                Ast::Expr.Paren(inner, _):
                    return proof_resource_pattern_source_may_carry_resource(inner, state, report, functions, depth + 1)
                Ast::Expr.Call(callee, _, _, _):
                    return true if proof_resource_callee_shadowed_by_local(callee, state, report, 0)
                    function_index: usize = proof_function_index_for_callee(functions, callee)
                    return function_index >= functions.returns.return_scalar.count or not functions.returns.return_scalar[function_index]
                _:
                    return true
            return true

        def proof_resource_check_pattern_names_with_source[@c, @s, @r](pattern: Ast::Pattern, scrutinee: Ast::Expr, source_classified: mutable bool& @c, source_supported: mutable bool& @c, source_carries_resource: mutable bool& @c, state: mutable ProofResourceState& @s, report: mutable ProofReport& @r, functions: mutable ProofFunctionTable&, position: Ast::Pos, function_name: sview) -> void:
            admission: (complete: bool, has_bindings: bool, work: usize) = proof_resource_pattern_names_admission(pattern)
            if not proof_resource_pattern_work_available(report, admission.work, position, function_name):
                return
            if not admission.complete:
                proof_resource_add_failing_obligation(report, "resource-pattern-budget", position, function_name, "pattern resource analysis exceeded its bounded depth or work budget")
                return
            source_was_classified: bool = proof_replay_summary_bool_ref_value(source_classified)
            if admission.has_bindings and not source_was_classified:
                source_cost: mutable usize = 0
                source_is_supported: bool = proof_replay_summary_expr_cost_with_limit(scrutinee, &source_cost, 0, PROOF_PATTERN_WALK_WORK_LIMIT)
                if not proof_resource_pattern_work_available(report, source_cost, position, function_name):
                    return
                source_supported <- source_is_supported
                if not source_is_supported:
                    proof_resource_add_failing_obligation(report, "pattern-unsupported", position, function_name, "match binder provenance is unknown for this scrutinee shape")
                else:
                    result_region: sview = proof_resource_expr_result_region(scrutinee, state, functions, report, 0)
                    carries_resource: bool = proof_resource_expr_carries_resource(scrutinee, state, report)
                    pattern_source_may_carry: bool = proof_resource_pattern_source_may_carry_resource(scrutinee, state, report, functions, 0)
                    source_carries_resource <- carries_resource or result_region != "" or pattern_source_may_carry
                source_classified <- true
            source_supported_now: bool = proof_replay_summary_bool_ref_value(source_supported)
            source_carries_resource_now: bool = proof_replay_summary_bool_ref_value(source_carries_resource)
            if admission.has_bindings and source_supported_now and source_carries_resource_now:
                proof_resource_add_failing_obligation(report, "pattern-unsupported", position, function_name, "resource-carrying match binders require source projection provenance")
            proof_resource_check_pattern_names_complete_visit(pattern, state, report)
