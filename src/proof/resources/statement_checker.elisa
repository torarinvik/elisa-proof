extend ElisaProof:
    private:
        const PROOF_RESOURCE_ANALYSIS_BUDGET: usize = 128

        def proof_resource_check_statements[@s, @r](statements: darray[Ast::Stmt]& @s, state: mutable ProofResourceState& @s, report: mutable ProofReport& @r, function_name: sview, functions: mutable ProofFunctionTable&) -> void:
            for statement in statements |state, report, function_name|:
                position: Ast::Pos = proof_statement_position(statement)
                return if not proof_resource_analysis_budget_available(report, function_name, position)
                report.analysis_1.budgets.resource_steps <- report.analysis_1.budgets.resource_steps + 1
                match statement:
                    Ast::Stmt.VarDecl(local_name, type_expression, initializer, position):
                        shadow_binding: (complete: bool, slot: usize) = proof_resource_lookup_with_source_work(state, local_name, report)
                        shadowed: bool = not shadow_binding.complete or shadow_binding.slot < state.bindings.binding_names.count
                        local_markers: (reference: bool, mutable_reference: bool, is_mutable: bool, complete: bool) = proof_resource_type_marker_summary_for_owner_at_offset_with_work(type_expression, report.source.source_declarations, report.source_types.source_generic_param_lines, report.source_types.source_generic_param_names, state.context.generic_declaration_line, state.context.generic_declaration_owner_offset, report.source_types.source_generic_owner_params_valid, report.source_types.source_effect_index, report.source_types.source_generic_params_valid and report.source_types.source_generic_param_lines.count == report.source_types.source_generic_param_names.count, &report.source_types.source_effect_index.work.implicit_effect_work)
                        (proof_resource_check_var(local_name, type_expression, initializer, local_markers, state, report, function_name, position, functions) can Global{Read,Write})
                        local_binding: (complete: bool, slot: usize) = proof_resource_lookup_with_source_work(state, local_name, report)
                        local_marker_slot: usize = local_binding.slot
                        state.bindings.binding_type_marker_complete[local_marker_slot] <- local_markers.complete if local_marker_slot < state.bindings.binding_type_marker_complete.count
                        if proof_resource_type_is_scalar(type_expression):
                            scalar_slot: usize = local_marker_slot
                            state.bindings.binding_scalar[scalar_slot] <- true if scalar_slot < state.bindings.binding_scalar.count
                        borrowable: bool = not local_markers.reference and not proof_resource_type_is_scalar(type_expression)
                        borrowable_slot: usize = local_marker_slot
                        state.bindings.binding_borrowable[borrowable_slot] <- borrowable if borrowable_slot < state.bindings.binding_borrowable.count
                        proof_resource_set_binding_borrowable(state, report, local_name, borrowable)
                        if local_markers.complete and proof_resource_type_is_collection(type_expression):
                            extent_slot: usize = local_marker_slot
                            state.bindings.binding_extent[extent_slot] <- true if extent_slot < state.bindings.binding_extent.count
                        state.bindings.binding_darray[local_marker_slot] <- proof_resource_type_is_darray(type_expression, 0, report, state, functions) if local_marker_slot < state.bindings.binding_darray.count
                        state.evidence.facts.clear() if shadowed or proof_resource_expr_has_call(initializer) or proof_resource_expr_has_move(initializer)
                    Ast::Stmt.Assign(target, operator, initializer, position):
                        target_name: sview = proof_resource_direct_binding_name(target, report)
                        target_binding: (complete: bool, slot: usize) = proof_resource_lookup_with_source_work(state, target_name, report)
                        target_slot: usize = target_binding.slot
                        # A first `name = value` declares `name` (inferred_bindings.elisa).
                        # A later `=` to such a local that cannot write it shadows it instead.
                        shadows_inferred: bool = operator == TokenKind.Assign and target_slot < state.bindings.binding_names.count and (any inferred in state.bindings.inferred_names where inferred == target_name) and not (target_slot < state.bindings.binding_writable.count and state.bindings.binding_writable[target_slot])
                        if operator == TokenKind.Assign and target_name != "" and (target_slot >= state.bindings.binding_names.count or shadows_inferred):
                            inferred_type: Ast::Expr = proof_resource_inferred_binding_type(initializer, state, functions, report)
                            if not (inferred_type is Ast::Expr.Absent):
                                declaration: darray[Ast::Stmt] = [Ast::Stmt.VarDecl(target_name, inferred_type, initializer, position)]
                                (proof_resource_check_statements(declaration, state, report, function_name, functions) can Global{Read,Write})
                                state.bindings.inferred_names.push(target_name)
                                continue
                            # An untyped shadow stays untracked, as every first `=` binding was.
                            continue if shadows_inferred
                        target_is_scalar: bool = target_slot < state.bindings.binding_scalar.count and state.bindings.binding_scalar[target_slot]
                        if not proof_resource_is_discard_target(target, report) and not target_is_scalar and proof_resource_expr_returns_local_borrow(initializer, state, functions, report):
                            proof_resource_add_failing_obligation(report, "borrow-escape", position, function_name, "a newly created borrow is assigned across a binding boundary")
                        (proof_resource_check_write(target, state, report, function_name, position, functions) can Global{Read,Write})
                        (proof_resource_check_expression(target, state, report, function_name, functions) can Global{Read,Write})
                        (proof_resource_check_expression(initializer, state, report, function_name, functions) can Global{Read,Write})
                        (proof_resource_handle_region_assignment(target, initializer, state, report, function_name, position, functions) can Global{Read,Write})
                        state.evidence.facts.clear()
                    Ast::Stmt.Expr(expression, position):
                        match expression:
                            Ast::Expr.RegionNew(operand, region, allocation_position):
                                # `new[r] value` is itself the resource transition. A bare
                                # expression statement discards the resulting reference, but
                                # the allocation remains valid and must be replayed explicitly.
                                (proof_resource_check_expression(operand, state, report, function_name, functions) can Global{Read,Write})
                                proof_resource_add_region_discard(state, report, operand, region, allocation_position, function_name)
                            _:
                                (proof_resource_check_expression(expression, state, report, function_name, functions) can Global{Read,Write})
                                proof_resource_add_failing_obligation(report, "region-expression-unsupported", position, function_name, "a region-owned expression must be bound or explicitly rejected at this resource boundary") if proof_resource_expr_statement_discards_region_value(expression, state, functions, report, 0)
                        state.evidence.facts.clear() if proof_resource_expr_has_call(expression) or proof_resource_expr_has_move(expression)
                    Ast::Stmt.Return(value, position):
                        if value is returned:
                            return_function_index: usize = proof_function_index_of_current(functions, function_name)
                            return_is_scalar: bool = return_function_index < functions.returns.return_scalar.count and functions.returns.return_scalar[return_function_index]
                            return_markers_complete: bool = return_function_index < functions.returns.return_type_marker_complete.count and functions.returns.return_type_marker_complete[return_function_index]
                            return_is_sview: mutable bool = false
                            if return_function_index < functions.returns.return_sviews.count:
                                return_is_sview <- functions.returns.return_sviews[return_function_index]
                            if not return_is_scalar and proof_resource_expr_returns_local_borrow(returned, state, functions, report):
                                proof_resource_add_failing_obligation(report, "borrow-escape", position, function_name, "a borrow cannot escape this lexical proof resource state")
                            if not return_is_scalar and proof_resource_expr_returns_local_region_value(returned, state, functions, report):
                                proof_resource_add_failing_obligation(report, "region-return-escape", position, function_name, "a region-owned value cannot escape the region that owns its storage")
                            returned_region: sview = proof_resource_expr_result_region(returned, state, functions, report, 0)
                            # The summary marker records where the value really lives; it must be the
                            # declared lifetime, including when a call permutes region parameters.
                            declared_return_region: sview = proof_resource_function_return_region(functions, return_function_index)
                            proof_resource_add_failing_obligation(report, "region-return-escape", position, function_name, "the returned value lives in a region other than the declared return region") if not return_is_scalar and returned_region != "" and declared_return_region != "" and returned_region != declared_return_region
                            return_mutable_reference: bool = return_function_index < functions.returns.return_mutable_references.count and functions.returns.return_mutable_references[return_function_index]
                            return_is_region_collection: bool = return_function_index < functions.returns.return_types.count and proof_resource_region_collection_value_type(functions.returns.return_types[return_function_index], report)
                            # Check the returned expression before emitting its summary marker. The
                            # resulting resource-use/call transition (or the explicit allocation
                            # transition below) is then available as the marker's witness.
                            return_events_before: usize = state.evidence.trace_events.count
                            (proof_resource_check_expression(returned, state, report, function_name, functions) can Global{Read,Write})
                            if not return_markers_complete:
                                return_marker_work: mutable usize = report.source_types.source_effect_index.work.implicit_effect_work
                                opaque_return_call: bool = proof_resource_expr_has_opaque_call_result(returned, state, functions, return_marker_work, 0)
                                report.source_types.source_effect_index.work.implicit_effect_work <- return_marker_work
                                if proof_resource_expr_carries_resource(returned, state, report) or proof_resource_expr_contains_region_value(returned, state, report) or opaque_return_call:
                                    proof_resource_add_failing_obligation(report, "resource-type-marker-incomplete", position, function_name, "the resource checker cannot classify this resource-bearing return safely")
                            return_witness: mutable usize = report.analysis_1.kernel.nodes.count
                            # The node-count sentinel goes stale as later lookups add nodes, so presence is a flag.
                            return_witness_found: mutable bool = false
                            unlinked_call: bool = proof_resource_sview_return_call_has_unlinked_provenance(returned, functions, report, 0)
                            unlinked_sview_call: bool = return_is_sview and unlinked_call
                            # A reference returned straight out of a verified call is backed by
                            # whatever the callee summary returns, applied to this call's arguments;
                            # it is recorded as a `param-call` marker that replay re-derives.
                            unlinked_reference_call: bool = not return_is_sview and return_function_index < functions.returns.return_references.count and functions.returns.return_references[return_function_index] and unlinked_call
                            call_return_formal: mutable sview = ""
                            if not unlinked_sview_call and not unlinked_reference_call:
                                match returned:
                                    Ast::Expr.RegionNew(operand, allocated_region, _):
                                        return_witness <- proof_resource_add_region_return_alloc(state, report, operand, allocated_region, position, function_name) if return_markers_complete and allocated_region != "" and proof_resource_region_is_external(state, allocated_region)
                                        return_witness_found <- return_markers_complete and allocated_region != "" and proof_resource_region_is_external(state, allocated_region) and return_witness < report.analysis_1.kernel.nodes.count
                                    _:
                                        # The witness is the use of the returned place's own root
                                        # binding, produced by the returned expression itself; see
                                        # return_witnesses.elisa. `return nodes[index].left` uses
                                        # `nodes` and `index`, and only `nodes` backs the result.
                                        return_witness <- proof_resource_exact_return_witness(state, report, return_events_before, proof_resource_return_root_name(returned, functions, report), returned_region, return_is_sview, return_mutable_reference)
                                        return_witness_found <- return_witness < report.analysis_1.kernel.nodes.count
                            else:
                                callee_name: sview = proof_resource_sview_return_call_name(returned, functions, report, 0)
                                callee_index: usize = proof_resource_sview_return_call_function_index(returned, functions, report, 0)
                                callee_root: usize = proof_resource_summary_root_for_function(functions, report, callee_index)
                                callee_return_formal: mutable sview = ""
                                if unlinked_sview_call and callee_name != "":
                                    callee_return_formal <- proof_resource_sview_return_formal_at(report, callee_root)
                                elif callee_name != "":
                                    reference_summary: (known: bool, region: sview, formal: sview, mutable_reference: bool, allocation: bool) = proof_resource_reference_summary_return_at(report, callee_root)
                                    callee_return_formal <- reference_summary.formal if reference_summary.known and not reference_summary.allocation and reference_summary.mutable_reference == return_mutable_reference
                                actual: (known: bool, place: ProofResourcePlace, slot: usize, is_reference: bool, mutable_reference: bool, writable: bool) = proof_resource_call_formal_actual(returned, callee_return_formal, state, functions, report)
                                candidate_call: usize = state.evidence.trace_events[state.evidence.trace_events.count - 1] if state.evidence.trace_events.count > 0 else report.analysis_1.kernel.nodes.count
                                call_event_valid: mutable bool = false
                                if candidate_call < report.analysis_1.kernel.nodes.count:
                                    call_node: ElisaProofKernelCore::ProofKernelNode = report.analysis_1.kernel.nodes[candidate_call]
                                    call_event_valid <- call_node.kind == "resource-call" and call_node.name == callee_name
                                source_valid: mutable bool = actual.known and actual.place.whole and actual.slot < state.bindings.binding_names.count and actual.slot < state.bindings.binding_region.count and proof_resource_binding_region(state, actual.slot) == returned_region and (returned_region == "" or proof_resource_binding_region_is_live(state, actual.slot)) and not proof_resource_binding_is_moved(state, actual.slot)
                                source_slot: mutable usize = actual.slot
                                source_place: mutable ProofResourcePlace = actual.place
                                return if not proof_source_index_work_charge(report, state.bindings.binding_names.count)
                                for _ in 0..<state.bindings.binding_names.count |source_valid, source_slot, source_place, state|:
                                    continue if source_slot >= state.borrows.borrow_present.count or not state.borrows.borrow_present[source_slot]
                                    if source_slot >= state.borrows.borrow_target_slots.count or source_slot >= state.borrows.borrow_target_places.count:
                                        source_valid <- false
                                        continue
                                    next_slot: usize = state.borrows.borrow_target_slots[source_slot]
                                    next_place: ProofResourcePlace = state.borrows.borrow_target_places[source_slot]
                                    if next_slot >= state.bindings.binding_names.count or not next_place.whole or next_place.root == "":
                                        source_valid <- false
                                        continue
                                    source_slot <- next_slot
                                    source_place <- next_place
                                source_valid <- false if source_slot < state.borrows.borrow_present.count and state.borrows.borrow_present[source_slot]
                                source_valid <- false if return_function_index >= functions.parameters.metadata.param_counts.count or return_function_index >= functions.parameters.metadata.param_starts.count
                                source_valid <- false if source_valid and source_slot >= functions.parameters.metadata.param_counts[return_function_index]
                                source_valid <- false if source_valid and functions.parameters.metadata.param_starts[return_function_index] + source_slot >= functions.parameters.metadata.all_params.count
                                caller_formal: mutable sview = ""
                                if source_valid:
                                    caller_formal <- functions.parameters.metadata.all_params[functions.parameters.metadata.param_starts[return_function_index] + source_slot]
                                    source_valid <- caller_formal == state.bindings.binding_names[source_slot] and source_slot < state.bindings.binding_region.count and proof_resource_binding_region(state, source_slot) == returned_region and (returned_region == "" or proof_resource_binding_region_is_live(state, source_slot)) and not proof_resource_binding_is_moved(state, source_slot)
                                # A returned reference keeps the formal's own capability: it must be a
                                # reference formal of exactly the declared pointee mutability.
                                if source_valid and not return_is_sview:
                                    source_valid <- source_slot < state.bindings.binding_reference.count and state.bindings.binding_reference[source_slot] and (source_slot < state.bindings.binding_mutable_reference.count and state.bindings.binding_mutable_reference[source_slot]) == return_mutable_reference
                                if source_valid and call_event_valid and callee_return_formal != "":
                                    return_witness <- candidate_call
                                    return_witness_found <- true
                                    call_return_formal <- caller_formal
                            # A function whose declared return type is a scalar primitive returns
                            # a copy. It cannot carry a lifetime however the expression that
                            # produced it was written, so `return cell.value` out of a region-owned
                            # binding is not a region return and needs no marker at all. Emitting
                            # one made the ordinary shape -- read a number out of a region-owned
                            # parameter -- depend on a witness whose mutability had to match a
                            # return that is not a reference in the first place.
                            if return_markers_complete and returned_region != "" and not return_is_scalar and proof_resource_region_is_external(state, returned_region):
                                proof_resource_add_failing_obligation(report, "region-return-witness-unsupported", position, function_name, "a region return must be tied to a replayed resource use or returned allocation") if not return_witness_found
                                if return_witness_found:
                                    proof_resource_record_sview_call_return(state, report, return_witness, call_return_formal, position, function_name, returned_region) if unlinked_sview_call
                                    proof_resource_record_sview_return(state, report, return_witness, position, function_name, returned_region) if return_is_sview and not unlinked_sview_call
                                    proof_resource_record_event_at_position(state, report, "resource-region-return", "param-call", return_witness, returned_region, call_return_formal, 1 if return_mutable_reference else 0, position) if unlinked_reference_call
                                    proof_resource_record_region_value_return(state, report, return_witness, functions.returns.return_types[return_function_index], returned_region, position, function_name, functions) if return_is_region_collection and not return_is_sview and not unlinked_reference_call
                                    proof_resource_record_event_at_position(state, report, "resource-region-return", "param", return_witness, returned_region, "", 1 if return_mutable_reference else 0, position) if not return_is_sview and not unlinked_reference_call and not return_is_region_collection
                            # A region-less reference return gets a marker only from an exact
                            # witness; without one the summary pins nothing and callers fail closed.
                            # A mutable one must have it: nothing else stops `return shared_formal`
                            # from minting write access the caller never lent.
                            elif return_markers_complete and returned_region == "" and declared_return_region == "" and not return_is_scalar and not return_is_sview and return_function_index < functions.returns.return_references.count and functions.returns.return_references[return_function_index]:
                                direct_formal: bool = return_witness_found and not unlinked_reference_call and proof_resource_regionless_return_witness_is_formal(state, report, functions, return_function_index, return_witness)
                                call_formal: bool = return_witness_found and unlinked_reference_call
                                proof_resource_add_failing_obligation(report, "region-return-witness-unsupported", position, function_name, "a mutable reference return must be tied to a replayed mutable reference formal") if return_mutable_reference and not direct_formal and not call_formal
                                proof_resource_record_event_at_position(state, report, "resource-region-return", "param-call", return_witness, "", call_return_formal, 1 if return_mutable_reference else 0, position) if call_formal
                                proof_resource_record_event_at_position(state, report, "resource-region-return", "param", return_witness, "", "", 1 if return_mutable_reference else 0, position) if direct_formal
                    Ast::Stmt.If(condition, then_body, else_body, position):
                        (proof_resource_check_expression(condition, state, report, function_name, functions) can Global{Read,Write})
                        then_state: mutable ProofResourceState = proof_resource_empty()
                        else_state: mutable ProofResourceState = proof_resource_empty()
                        proof_resource_copy_into(state, &then_state, report)
                        proof_resource_copy_into(state, &else_state, report)
                        proof_resource_mark_scope_inherited(state, &then_state)
                        proof_resource_mark_scope_inherited(state, &else_state)
                        (proof_resource_check_statements(then_body, &then_state, report, function_name, functions) can Global{Read,Write})
                        (proof_resource_check_statements(else_body, &else_state, report, function_name, functions) can Global{Read,Write})
                        proof_resource_close_if_children(state, &then_state, &else_state, report, position.offset.usize())
                        state.evidence.facts.clear()
                    Ast::Stmt.While(condition, while_body, _):
                        (proof_resource_check_expression(condition, state, report, function_name, functions) can Global{Read,Write})
                        while_state: mutable ProofResourceState = proof_resource_empty()
                        proof_resource_copy_into(state, &while_state, report)
                        proof_resource_mark_scope_inherited(state, &while_state)
                        (proof_resource_check_statements(while_body, &while_state, report, function_name, functions) can Global{Read,Write})
                        proof_resource_close_child(state, while_state, report, true)
                        state.evidence.facts.clear()
                    Ast::Stmt.For(_, variables, iterable, for_body, _):
                        (proof_resource_check_expression(iterable, state, report, function_name, functions) can Global{Read,Write})
                        iterable_position: Ast::Pos = Ast::expr_pos(iterable)
                        for_state: mutable ProofResourceState = proof_resource_empty()
                        proof_resource_copy_into(state, &for_state, report)
                        proof_resource_mark_scope_inherited(state, &for_state)
                        iterable_is_range: bool = proof_resource_iterable_is_range(iterable, report)
                        for variable in variables |variable, for_state, iterable_is_range|:
                            if variable != "" and iterable_is_range:
                                # A range binder is a fresh scalar copy of each integer in the
                                # range. Aliasing it to an outer binding of the same name made
                                # `for value in 0..<n: assert value >= 0` read as a local borrow.
                                proof_resource_add_binding_traced_at_position(&for_state, report, variable, false, false, false, for_state.bindings.binding_names.count, false, "", proof_resource_empty_place(), 0, iterable_position)
                            elif variable != "":
                                # A capture listed after `for … |capture|` shadows the outer
                                # binding inside the loop body. Preserve its write capability:
                                # mutable captures stay writable, while readonly captures keep
                                # the readonly rule. Registering every capture as immutable made
                                # legal writes to mutable accumulators look like prover gaps.
                                outer_binding: (complete: bool, slot: usize) = proof_resource_lookup_with_source_work(state, variable, report)
                                outer_slot: usize = outer_binding.slot
                                proof_resource_add_failing_obligation(report, "region-capture-unsupported", position, function_name, "a loop capture could not be resolved within the source analysis budget") if not outer_binding.complete
                                capture_is_reference: bool = outer_binding.complete and outer_slot < state.bindings.binding_reference.count and state.bindings.binding_reference[outer_slot]
                                capture_is_mutable_reference: bool = outer_binding.complete and outer_slot < state.bindings.binding_mutable_reference.count and state.bindings.binding_mutable_reference[outer_slot]
                                capture_is_writable: bool = proof_resource_binding_is_writable(state, outer_slot) if outer_binding.complete and outer_slot < state.bindings.binding_names.count else false
                                capture_target: usize = outer_slot if capture_is_reference and outer_slot < state.bindings.binding_names.count else for_state.bindings.binding_names.count
                                borrow_present: bool = capture_target < state.borrows.borrow_present.count and state.borrows.borrow_present[capture_target]
                                borrow_mutable: bool = borrow_present and capture_target < state.borrows.borrow_mutable.count and state.borrows.borrow_mutable[capture_target]
                                target_place: ProofResourcePlace = state.borrows.borrow_target_places[capture_target] if borrow_present and capture_target < state.borrows.borrow_target_places.count else proof_resource_empty_place()
                                proof_resource_add_binding_traced_at_position(&for_state, report, variable, capture_is_reference, capture_is_mutable_reference, capture_is_writable, capture_target, borrow_mutable, variable if capture_is_reference else "", target_place, 0, iterable_position)
                        (proof_resource_check_statements(for_body, &for_state, report, function_name, functions) can Global{Read,Write})
                        proof_resource_close_child(state, for_state, report, true)
                        state.evidence.facts.clear()
                    Ast::Stmt.Match(scrutinee, arms, position):
                        (proof_resource_check_expression(scrutinee, state, report, function_name, functions) can Global{Read,Write})
                        pattern_source_classified: mutable bool = false
                        pattern_source_supported: mutable bool = false
                        pattern_source_carries_resource: mutable bool = false
                        moved_any: mutable ProofResourceAlternativeMoves = proof_resource_alternative_move_mask(state, report)
                        for arm in arms |arm, state, report, function_name, functions, pattern_source_classified, pattern_source_supported, pattern_source_carries_resource, moved_any|:
                            arm_state: mutable ProofResourceState = proof_resource_empty()
                            proof_resource_copy_into(state, &arm_state, report)
                            proof_resource_mark_scope_inherited(state, &arm_state)
                            proof_resource_check_pattern_names_with_source(arm.pattern, scrutinee, &pattern_source_classified, &pattern_source_supported, &pattern_source_carries_resource, &arm_state, report, functions, position, function_name)
                            match arm.guard:
                                Ast::Expr.Absent:
                                    pass
                                _:
                                    (proof_resource_check_expression(arm.guard, &arm_state, report, function_name, functions) can Global{Read,Write})
                            (proof_resource_check_statements(arm.body, &arm_state, report, function_name, functions) can Global{Read,Write})
                            proof_resource_close_alternative_child(state, &arm_state, report, &moved_any)
                        proof_resource_merge_alternative_moves(state, &moved_any, report, position.offset.usize())
                        state.evidence.facts.clear()
                    Ast::Stmt.Block(block_kind, clause, binding, block_body, block_position):
                        if block_kind == "destroy":
                            region_name: sview = clause[0] if clause.count > 0 else binding
                            proof_resource_close_named_region(state, report, region_name, block_position, function_name)
                            state.evidence.facts.clear()
                            continue
                        if block_kind == "defer":
                            proof_resource_add_failing_obligation(report, "resource-defer-unsupported", block_position, function_name, "deferred resource transitions require exit-time replay")
                            state.evidence.facts.clear()
                            continue
                        if block_kind == "region" and binding != "" and block_body.count == 0:
                            # Canonical statement form: `region r(size)` is an owner declaration,
                            # not an ordinary binding and not a zero-body lexical block. Its
                            # lifetime extends over subsequent statements until `destroy r` (or
                            # the implicit function-scope close in proof_resource_finish).
                            region_valid: bool = not proof_resource_region_is_active(state, binding)
                            proof_resource_add_failing_obligation(report, "region-scope-unsupported", block_position, function_name, "region declaration must introduce a fresh named lexical region") if binding == "" or not region_valid
                            if region_valid:
                                stable_region: cstr = (proof_resource_stable_region_name(binding) can Global{Read,Write})
                                state.regions.active_regions.push(stable_region)
                                proof_resource_record_event_at_position(state, report, "resource-region-open", "", 0, binding, "", 0, block_position)
                            state.evidence.facts.clear()
                            continue
                        block_state: mutable ProofResourceState = proof_resource_empty()
                        proof_resource_copy_into(state, &block_state, report)
                        proof_resource_mark_scope_inherited(state, &block_state)
                        if block_kind == "region" and binding == "":
                            region_name: sview = clause[0] if clause.count > 0 else ""
                            region_valid: bool = region_name != "" and not proof_resource_region_is_active(state, region_name)
                            proof_resource_add_failing_obligation(report, "region-scope-unsupported", block_position, function_name, "region block must introduce a fresh named lexical region") if not region_valid
                            if region_valid:
                                stable_region: cstr = (proof_resource_stable_region_name(region_name) can Global{Read,Write})
                                block_state.regions.active_regions.push(stable_region)
                                proof_resource_record_event_at_position(&block_state, report, "resource-region-open", "", 0, region_name, "", 0, block_position)
                            (proof_resource_check_statements(block_body, &block_state, report, function_name, functions) can Global{Read,Write})
                            proof_resource_check_region_boundary(state, block_state, report, function_name, block_position)
                            if region_valid:
                                if block_state.regions.active_regions.count == state.regions.active_regions.count:
                                    proof_resource_add_failing_obligation(report, "region-scope-unsupported", block_position, function_name, "region scope did not close in the resource transition trace")
                                else:
                                    block_state.regions.active_regions <- block_state.regions.active_regions.truncate(block_state.regions.active_regions.count - 1)
                                    proof_resource_invalidate_region_bindings(&block_state, region_name)
                                    proof_resource_record_event_at_position(&block_state, report, "resource-region-close", "", 0, region_name, "", 0, block_position)
                            proof_resource_close_child(state, block_state, report, true)
                            state.evidence.facts.clear()
                            continue
                        proof_resource_add_binding_traced(&block_state, report, binding, false, false, false, block_state.bindings.binding_names.count, false, "", proof_resource_empty_place(), 0) if binding != ""
                        (proof_resource_check_statements(block_body, &block_state, report, function_name, functions) can Global{Read,Write})
                        proof_resource_close_child(state, block_state, report, true)
                        state.evidence.facts.clear()
                    Ast::Stmt.Contract(kind, expression, position):
                        if kind in {"assert", "requires"} or proof_is_ensure_kind(kind):
                            (proof_resource_check_contract_expression(expression, state, report, function_name, functions, 0) can Global{Read,Write})
                            proof_resource_add_failing_obligation(report, "borrow-contract-unsupported", position, function_name, "resource-bearing expressions are not admitted in logical contracts") if proof_resource_expr_has_address_of(expression) or proof_resource_expr_uses_local_borrow(expression, state, report)
                            proof_resource_add_failing_obligation(report, "region-contract-unsupported", position, function_name, "region-owned expressions are not admitted in logical contracts") if proof_resource_expr_contains_region_value(expression, state, report)
                    Ast::Stmt.Break(_, _):
                        pass
                    Ast::Stmt.Continue(_, _):
                        pass
                    Ast::Stmt.Invalid:
                        # The main proof-state walker owns the canonical invalid-statement
                        # diagnostic. Resource replay has no additional transition to emit.
                        pass
                    _:
                        proof_resource_add_failing_obligation(report, "statement-unsupported", Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}, function_name, "unknown statement form has no resource transition model")

        def proof_check_resource_safety[@r](file: Ast::File&, parameters: darray[Ast::ParamDecl]&, body: darray[Ast::Stmt]&, facts: darray[Ast::Expr]&, report: mutable ProofReport& @r, function_name: sview, line: u32, owner_offset: u32, functions: mutable ProofFunctionTable&) -> void can[Global{Read,Write}]:
            failed_before: u32 = report.results.failed
            state: mutable ProofResourceState = proof_resource_empty()
            state.context.function_name <- function_name
            state.context.generic_declaration_line <- line
            state.context.generic_declaration_owner_offset <- owner_offset
            state.evidence.facts.extend(facts)
            proof_global_constant_static_scope(file, function_name, line, &state.statics.static_scope, &state.statics.static_names, &state.statics.static_root_names, report)
            if report.source_types.source_effect_index.work.implicit_effect_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                report.proof_obligation(false)
                proof_add_budget_finding(report, "resource-analysis-budget", line, function_name, "resource static-scope discovery exceeded its shared source-work budget", "resource-static-scope-work", report.source_types.source_effect_index.work.implicit_effect_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                return
            function_index: usize = proof_function_index_of_current(functions, function_name)
            if function_index < functions.summaries.resource_summary_root_valid.count:
                functions.summaries.resource_summary_root_valid[function_index] <- false
            region_parameter_count: usize = proof_resource_function_region_param_count(functions, function_index)
            for region_index in 0..<region_parameter_count |region_index, functions, function_index, state, report|:
                region: sview = proof_resource_function_region_param_at(functions, function_index, region_index)
                valid_region: bool = region != "" and not proof_resource_region_is_active(state, region)
                proof_resource_add_failing_obligation(report, "region-scope-unsupported", Ast::Pos{line: line, column: 0, offset: 0, end_line: line, end_column: 0, end_offset: 0}, function_name, "region-polymorphic parameters must be distinct lifetime capabilities") if not valid_region
                if valid_region:
                    stable_region: cstr = (proof_resource_stable_region_name(region) can Global{Read,Write})
                    state.regions.active_regions.push(stable_region)
                    state.regions.external_regions.push(region)
                    proof_resource_record_event(&state, report, "resource-region-param", "external", 0, region, "", 0)
            for parameter in parameters |state, report|:
                state.context.formal_parameter_types.push(parameter.type_expression)
                parameter_markers: (reference: bool, mutable_reference: bool, is_mutable: bool, complete: bool) = proof_resource_type_marker_summary_for_owner_at_offset_with_work(parameter.type_expression, report.source.source_declarations, report.source_types.source_generic_param_lines, report.source_types.source_generic_param_names, state.context.generic_declaration_line, state.context.generic_declaration_owner_offset, report.source_types.source_generic_owner_params_valid, report.source_types.source_effect_index, report.source_types.source_generic_params_valid and report.source_types.source_generic_param_lines.count == report.source_types.source_generic_param_names.count, &report.source_types.source_effect_index.work.implicit_effect_work)
                is_reference: bool = parameter_markers.complete and parameter_markers.reference
                scalar_reference_target: (known: bool, target: Ast::Expr) = proof_scalar_reference_target_type_with_work(parameter.type_expression, report.source.source_declarations, 0, &report.source_types.source_effect_index.work.implicit_effect_work) if is_reference else (false, Ast::Expr.Invalid)
                state.context.formal_scalar_reference_index_values.push(is_reference and scalar_reference_target.known)
                is_mutable_reference: bool = parameter_markers.complete and parameter_markers.mutable_reference
                writable: bool = parameter_markers.complete and (parameter.is_mutable or parameter_markers.is_mutable or is_mutable_reference)
                # Unknown formals enter the kernel as values. Their opaque marker bit prevents
                # later resource operations from using that conservative placeholder as a capability.
                proof_resource_add_binding_traced(&state, report, parameter.name, is_reference, is_mutable_reference, writable, state.bindings.binding_names.count, false, "", proof_resource_empty_place(), 0)
                parameter_index: usize = state.bindings.binding_names.count - 1
                state.bindings.binding_type_marker_complete[parameter_index] <- parameter_markers.complete if parameter_index < state.bindings.binding_type_marker_complete.count
                borrowable: bool = parameter_markers.complete and not is_reference and not proof_resource_type_is_scalar(parameter.type_expression)
                state.bindings.binding_borrowable[parameter_index] <- borrowable if parameter_index < state.bindings.binding_borrowable.count
                proof_resource_set_binding_borrowable(state, report, parameter.name, borrowable)
                state.bindings.binding_extent[parameter_index] <- true if parameter_markers.complete and parameter_index < state.bindings.binding_extent.count and proof_resource_type_is_collection(parameter.type_expression)
                state.bindings.binding_darray[parameter_index] <- proof_resource_type_is_darray(parameter.type_expression, 0, report, state, functions) if parameter_index < state.bindings.binding_darray.count
                parameter_region: sview = proof_resource_function_parameter_region(functions, function_index, parameter_index)
                if parameter_region != "" and parameter_markers.complete:
                    if is_reference:
                        proof_resource_set_binding_region(&state, report, parameter.name, parameter_region)
                    elif proof_resource_type_is_sview(parameter.type_expression):
                        proof_resource_record_sview_parameter(&state, report, parameter.type_expression, parameter.name, parameter_region, Ast::expr_pos(parameter.type_expression), function_name)
            state.context.formal_count <- state.bindings.binding_names.count
            (proof_resource_check_statements(body, &state, report, function_name, functions) can Global{Read,Write})
            if report.source_types.source_effect_index.work.implicit_effect_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                report.proof_obligation(false)
                proof_add_budget_finding(report, "resource-analysis-budget", line, function_name, "resource expression classification exceeded its shared source-work budget", "resource-expression-work", report.source_types.source_effect_index.work.implicit_effect_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                return
            proof_resource_finish(&state, report, function_name, line, failed_before, parameters.count, functions, function_index)
