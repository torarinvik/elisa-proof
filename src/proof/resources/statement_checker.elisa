extend ElisaProof:
    private:
        const PROOF_RESOURCE_ANALYSIS_BUDGET: usize = 128

        def proof_resource_analysis_budget_available(report: mutable ProofReport&, function_name: sview, position: Ast::Pos) -> bool:
            return true if report.budgets.resource_steps < PROOF_RESOURCE_ANALYSIS_BUDGET
            if not report.budgets.resource_reported:
                report.budgets.resource_reported <- true
                proof_add_budget_finding(report, "resource-analysis-budget", position.line, function_name, "resource-state analysis exceeded its bounded symbolic-state budget", "steps", report.budgets.resource_steps + 1, PROOF_RESOURCE_ANALYSIS_BUDGET)
            return false

        # Normal calls need a kernel-linked return marker; their argument reads are not
        # interchangeable provenance witnesses. The builtin conversion has a direct receiver.
        def proof_resource_sview_return_call_has_unlinked_provenance(expression: Ast::Expr, functions: ProofFunctionTable&) -> bool:
            match expression:
                Ast::Expr.Call(_, _, _, _):
                    return not proof_resource_builtin_sview_conversion(expression, functions).known
                Ast::Expr.Paren(inner, _):
                    return proof_resource_sview_return_call_has_unlinked_provenance(inner, functions)
                _:
                    return false

        def proof_resource_sview_return_call_name(expression: Ast::Expr, functions: ProofFunctionTable&) -> sview:
            match expression:
                Ast::Expr.Call(callee, _, _, _):
                    return proof_callable_name(callee) if not proof_resource_builtin_sview_conversion(expression, functions).known
                Ast::Expr.Paren(inner, _):
                    return proof_resource_sview_return_call_name(inner, functions)
                _:
                    pass
            return ""

        # Install a by-value sview call result as a shared borrow of the exact actual place
        # selected by the callee's resource-return summary. The kernel repeats this mapping and
        # checks the callee witness before accepting the result event.
        def proof_resource_add_sview_call_result[@s, @r](statement_name: sview, type_expression: Ast::Expr, initializer: Ast::Expr, source_region: sview, state: mutable ProofResourceState& @s, report: mutable ProofReport& @r, function_name: sview, position: Ast::Pos, functions: ProofFunctionTable&) -> void:
            source: (known: bool, place: ProofResourcePlace, slot: usize, is_reference: bool, mutable_reference: bool) = proof_resource_call_result_sview_source_actual(initializer, state, functions, report)
            type_root: (known: bool, root: usize) = proof_resource_encode_expression(type_expression, report)
            exact_sview_type: mutable bool = false
            if type_root.known and type_root.root < report.kernel.nodes.count:
                type_node: ElisaProofKernelCore::ProofKernelNode = report.kernel.nodes[type_root.root]
                exact_sview_type <- type_node.kind == "ident" and type_node.name == "sview"
            target_slot: mutable usize = source.slot
            target_place: mutable ProofResourcePlace = source.place
            source_valid: mutable bool = source.known
            if source_valid:
                if source.slot < state.borrow_present.count:
                    if state.borrow_present[source.slot]:
                        if source.slot < state.borrow_target_slots.count and source.slot < state.borrow_target_places.count:
                            target_slot <- state.borrow_target_slots[source.slot]
                            target_place <- state.borrow_target_places[source.slot]
                        else:
                            source_valid <- false
            source_region_matches: bool = source.slot < state.binding_region.count and proof_resource_binding_region(state, source.slot) == source_region
            target_region_matches: bool = target_slot < state.binding_region.count and proof_resource_binding_region(state, target_slot) == source_region
            source_live: bool = source.slot < state.binding_region_live.count and proof_resource_binding_region_is_live(state, source.slot) and not proof_resource_binding_is_moved(state, source.slot)
            target_live: bool = target_slot < state.binding_region_live.count and proof_resource_binding_region_is_live(state, target_slot) and not proof_resource_binding_is_moved(state, target_slot)
            call_name: mutable sview = ""
            match initializer:
                Ast::Expr.Call(callee, _, _, _):
                    call_name <- proof_callable_name(callee)
                _:
                    pass
            call_event: usize = state.trace_events[state.trace_events.count - 1] if state.trace_events.count > 0 else report.kernel.nodes.count
            call_event_valid: mutable bool = false
            if call_event < report.kernel.nodes.count:
                call_event_node: ElisaProofKernelCore::ProofKernelNode = report.kernel.nodes[call_event]
                call_event_valid <- call_event_node.kind == "resource-call" and call_event_node.name == call_name
            borrow_except: usize = source.slot if source.is_reference and source.mutable_reference else state.binding_names.count
            borrow_conflict: bool = source_valid and proof_resource_has_mutable_borrow_overlap(state, report, target_place, borrow_except)
            valid: bool = statement_name != "" and source_valid and source.place.whole and target_place.root != "" and target_place.whole and exact_sview_type and source_region != "" and proof_resource_region_is_active(state, source_region) and source_region_matches and target_region_matches and source_live and target_live and not borrow_conflict and call_event_valid
            if not valid:
                proof_resource_add_failing_obligation(report, "region-alias-unsupported", position, function_name, "a returned sview requires a replayed region-tied return witness and a live, unconflicted caller place")
                proof_resource_add_binding(state, statement_name, false, false, false, state.binding_names.count, false, proof_resource_empty_place())
                return
            proof_resource_add_binding(state, statement_name, false, false, false, target_slot, false, target_place)
            result_slot: usize = state.binding_names.count - 1
            state.binding_region[result_slot] <- source_region
            state.binding_region_live[result_slot] <- true
            state.binding_region_owner[result_slot] <- false
            state.binding_borrowable[result_slot] <- true
            state.borrow_target_slots[result_slot] <- target_slot
            state.borrow_target_places[result_slot] <- target_place
            state.borrow_mutable[result_slot] <- false
            state.borrow_present[result_slot] <- true
            proof_resource_record_sview_call_result(state, report, call_event, type_root.root, statement_name, source_region)

        def proof_resource_check_var[@s, @r](statement_name: sview, type_expression: Ast::Expr, initializer: Ast::Expr, state: mutable ProofResourceState& @s, report: mutable ProofReport& @r, function_name: sview, position: Ast::Pos, functions: ProofFunctionTable&) -> void:
            is_reference: bool = proof_resource_is_reference_type(type_expression)
            is_mutable_reference: bool = is_reference and proof_resource_is_mutable_reference_type(type_expression)
            declared_region: sview = proof_resource_local_binding_region(functions, statement_name, position.line)
            declared_reference_call: mutable bool = false
            if declared_region != "":
                match initializer:
                    Ast::Expr.Call(callee, _, _, _):
                        callee_index: usize = proof_resource_function_index(functions, proof_callable_name(callee))
                        declared_reference_call <- callee_index < functions.return_references.count and functions.return_references[callee_index]
                    _:
                        pass
            sview_conversion: (known: bool, receiver: Ast::Expr) = proof_resource_builtin_sview_conversion(initializer, functions)
            destination_may_contain_sview: mutable bool = proof_resource_type_may_be_sview(type_expression, functions.type_audit_index)
            carries_sview: mutable bool = destination_may_contain_sview or sview_conversion.known
            direct_region: mutable sview = ""
            direct_region_operand: mutable Ast::Expr = Ast::Expr.Invalid
            match initializer:
                Ast::Expr.RegionNew(operand, region, _):
                    direct_region <- region
                    direct_region_operand <- operand
                _:
                    pass
            if direct_region != "":
                if not is_reference:
                    proof_resource_check_expression(direct_region_operand, state, report, function_name, functions)
                    proof_resource_add_failing_obligation(report, "region-allocation-unsupported", position, function_name, "new[r] produces a region reference and requires a reference-bearing destination")
                    proof_resource_add_binding(state, statement_name, false, false, false, state.binding_names.count, false, proof_resource_empty_place())
                    return
                if not destination_may_contain_sview:
                    destination_may_contain_sview <- proof_resource_type_may_contain_sview(type_expression, functions.type_audit_index)
                    carries_sview <- destination_may_contain_sview or sview_conversion.known
                if carries_sview:
                    proof_resource_check_expression(direct_region_operand, state, report, function_name, functions)
                    proof_resource_add_failing_obligation(report, "region-alias-unsupported", position, function_name, "allocating storage for an sview value does not establish the lifetime of its pointee")
                    proof_resource_add_binding(state, statement_name, false, false, false, state.binding_names.count, false, proof_resource_empty_place())
                    return
                proof_resource_check_expression(direct_region_operand, state, report, function_name, functions)
                proof_resource_add_region_allocation(state, report, statement_name, type_expression, direct_region_operand, direct_region, position, function_name)
                return
            if declared_region != "" and not declared_reference_call:
                if not destination_may_contain_sview:
                    destination_may_contain_sview <- proof_resource_type_may_contain_sview(type_expression, functions.type_audit_index)
                    carries_sview <- destination_may_contain_sview or sview_conversion.known
                proof_resource_check_expression(initializer, state, report, function_name, functions)
                initializer_region: sview = proof_resource_expr_result_region(initializer, state, functions, report)
                if carries_sview and initializer_region == "":
                    proof_resource_add_failing_obligation(report, "region-alias-unsupported", position, function_name, "an sview value has no directly tracked live backing region")
                    proof_resource_add_binding(state, statement_name, false, false, false, state.binding_names.count, false, proof_resource_empty_place())
                    return
                if carries_sview and initializer_region != "":
                    call_name: mutable sview = ""
                    match initializer:
                        Ast::Expr.Call(callee, _, _, _):
                            call_name <- proof_callable_name(callee)
                        _:
                            pass
                    call_function_index: usize = proof_resource_function_index(functions, call_name) if call_name != "" else functions.names.count
                    returns_sview: mutable bool = false
                    if call_function_index < functions.return_sviews.count:
                        returns_sview <- functions.return_sviews[call_function_index]
                    if returns_sview:
                        if initializer_region == declared_region:
                            proof_resource_add_sview_call_result(statement_name, type_expression, initializer, initializer_region, state, report, function_name, position, functions)
                        else:
                            proof_resource_add_failing_obligation(report, "region-alias-unsupported", position, function_name, "a returned sview must be bound to the same live region as its verified return summary")
                            proof_resource_add_binding(state, statement_name, false, false, false, state.binding_names.count, false, proof_resource_empty_place())
                        return
                if initializer_region == "":
                    proof_resource_add_region_allocation(state, report, statement_name, type_expression, initializer, declared_region, position, function_name)
                else:
                    proof_resource_add_region_binding(state, report, statement_name, type_expression, initializer, declared_region, position, function_name, functions)
                return
            # A scalar copied out of a region-owned value is a plain value, not a view into the
            # region. Only reference-like results carry the source lifetime.
            scalar_binding: bool = proof_resource_type_is_scalar(type_expression)
            source_region: sview = "" if scalar_binding else proof_resource_expr_result_region(initializer, state, functions, report)
            # Reference-returning calls need the call-result transition below, even with an
            # explicit local lifetime. Check that annotation before evaluating the call once.
            if declared_reference_call and source_region != declared_region:
                proof_resource_check_expression(initializer, state, report, function_name, functions)
                proof_resource_add_failing_obligation(report, "region-alias-unsupported", position, function_name, "a returned reference must retain the region established by the callee summary")
                proof_resource_add_binding(state, statement_name, is_reference, is_mutable_reference, false, state.binding_names.count, false, proof_resource_empty_place())
                return
            if source_region != "" and not destination_may_contain_sview:
                destination_may_contain_sview <- proof_resource_type_may_contain_sview(type_expression, functions.type_audit_index)
                carries_sview <- destination_may_contain_sview or sview_conversion.known
            if carries_sview and source_region == "":
                proof_resource_check_expression(initializer, state, report, function_name, functions)
                proof_resource_add_failing_obligation(report, "region-alias-unsupported", position, function_name, "an sview value has no directly tracked live backing region")
                proof_resource_add_binding(state, statement_name, false, false, false, state.binding_names.count, false, proof_resource_empty_place())
                return
            if source_region != "":
                proof_resource_check_expression(initializer, state, report, function_name, functions)
                callee_name: mutable sview = ""
                match initializer:
                    Ast::Expr.Call(callee, _, _, _):
                        callee_name <- proof_callable_name(callee)
                    _:
                        pass
                result_function_index: usize = proof_resource_function_index(functions, callee_name) if callee_name != "" else functions.names.count
                result_is_reference: bool = result_function_index < functions.return_references.count and functions.return_references[result_function_index]
                result_is_sview: mutable bool = false
                if result_function_index < functions.return_sviews.count:
                    result_is_sview <- functions.return_sviews[result_function_index]
                if result_is_sview and callee_name != "":
                    proof_resource_add_sview_call_result(statement_name, type_expression, initializer, source_region, state, report, function_name, position, functions)
                    return
                if result_is_reference and callee_name != "":
                    is_mutable_result: bool = result_function_index < functions.return_mutable_references.count and functions.return_mutable_references[result_function_index]
                    writable_result: bool = is_mutable_result or proof_resource_type_has_marker(type_expression, TokenKind.Mutable)
                    result_source: (known: bool, aliases_source: bool, place: ProofResourcePlace, slot: usize, is_reference: bool, mutable_reference: bool, writable: bool) = proof_resource_call_result_source_actual(initializer, state, functions, report)
                    result_target_slot: mutable usize = state.binding_names.count
                    result_target_place: mutable ProofResourcePlace = proof_resource_empty_place()
                    result_alias: mutable bool = false
                    result_owner: mutable bool = result_source.known and not result_source.aliases_source
                    if not result_source.known:
                        proof_resource_add_failing_obligation(report, "region-alias-unsupported", position, function_name, "a region reference result is neither tied to a direct returned formal nor backed by a fresh return allocation")
                    elif result_source.aliases_source:
                        result_target_slot <- result_source.slot
                        result_target_place <- result_source.place
                        result_alias <- result_source.slot < state.binding_names.count and result_source.place.root != ""
                        if result_alias:
                            if is_mutable_result and proof_resource_has_borrow_overlap(state, report, result_source.place, result_source.slot if result_source.is_reference else state.binding_names.count):
                                proof_resource_report_borrow_conflict(state, report, result_source.place, result_source.slot if result_source.is_reference else state.binding_names.count, false, "borrow-alias-conflict", position, function_name, "a returned mutable reference conflicts with another live borrow of its source place")
                            elif not is_mutable_result and proof_resource_has_mutable_borrow_overlap(state, report, result_source.place, result_source.slot if result_source.is_reference else state.binding_names.count):
                                proof_resource_report_borrow_conflict(state, report, result_source.place, result_source.slot if result_source.is_reference else state.binding_names.count, true, "borrow-alias-conflict", position, function_name, "a returned shared reference conflicts with a live mutable borrow of its source place")
                            # Passing a reference handle through a direct-return callee transfers
                            # that handle to the result. Keeping both names live would mint two
                            # independently writable capabilities for one underlying place.
                            result_owner <- result_source.slot < state.binding_region_owner.count and state.binding_region_owner[result_source.slot]
                            proof_resource_mark_binding_moved(state, result_source.slot) if result_source.is_reference
                        else:
                            proof_resource_add_failing_obligation(report, "region-alias-unsupported", position, function_name, "a returned reference source did not resolve to a live caller place")
                    proof_resource_add_binding(state, statement_name, true, is_mutable_result, writable_result, result_target_slot if result_alias else state.binding_names.count, is_mutable_result if result_alias else false, result_target_place if result_alias else proof_resource_empty_place())
                    state.binding_region[state.binding_region.count - 1] <- source_region
                    state.binding_region_live[state.binding_region_live.count - 1] <- proof_resource_region_is_active(state, source_region)
                    state.binding_region_owner[state.binding_region_owner.count - 1] <- result_owner
                    call_event: usize = state.trace_events[state.trace_events.count - 1] if state.trace_events.count > 0 else report.kernel.nodes.count
                    valid_call_event: bool = call_event < report.kernel.nodes.count and report.kernel.nodes[call_event].kind == "resource-call"
                    result_flags: usize = (PROOF_RESOURCE_WRITABLE_FLAG if writable_result else 0) + PROOF_RESOURCE_REFERENCE_FLAG + (PROOF_RESOURCE_MUTABLE_REFERENCE_FLAG if is_mutable_result else 0)
                    proof_resource_record_event(state, report, "resource-call-result", "", call_event, statement_name, source_region, result_flags) if valid_call_event
                    proof_resource_add_failing_obligation(report, "region-expression-unsupported", position, function_name, "a region-returning call did not leave a replayable call transition") if not valid_call_event
                    return
                proof_resource_add_region_binding(state, report, statement_name, type_expression, initializer, source_region, position, function_name, functions)
                return
            if not scalar_binding and proof_resource_expr_contains_unresolved_region_value(initializer, state, functions, report):
                proof_resource_check_expression(initializer, state, report, function_name, functions)
                proof_resource_add_failing_obligation(report, "region-expression-unsupported", position, function_name, "region value flows through an expression without a lifetime summary")
                proof_resource_add_binding_traced(state, report, statement_name, is_reference, is_mutable_reference, is_mutable_reference or proof_resource_type_has_marker(type_expression, TokenKind.Mutable), state.binding_names.count, false, "", proof_resource_empty_place(), 0)
                return
            direct_root: sview = proof_resource_direct_borrow_root(initializer)
            borrowed: (known: bool, place: ProofResourcePlace) = proof_resource_borrow_place(initializer, report)
            proof_resource_check_expression(initializer, state, report, function_name, functions)
            if is_reference and not borrowed.known:
                proof_resource_add_failing_obligation(report, "borrow-source-opaque", position, function_name, "reference initializer is not a bounded static address-of borrow")
            elif not is_reference and proof_resource_expr_returns_local_borrow(initializer, state, functions, report):
                proof_resource_add_failing_obligation(report, "borrow-source-opaque", position, function_name, "address-of value enters a non-reference binding")
            target_slot: mutable usize = state.binding_names.count
            borrow_is_mutable: mutable bool = false
            source_place_root: mutable usize = 0
            source_name: sview = borrowed.place.root if borrowed.known else direct_root
            if borrowed.known:
                target_slot <- proof_resource_lookup(state, borrowed.place.root)
                if target_slot >= state.binding_names.count:
                    proof_resource_add_failing_obligation(report, "borrow-source-opaque", position, function_name, "borrow target is not a live proof binding")
                elif proof_resource_binding_is_moved(state, target_slot):
                    proof_resource_add_failing_obligation(report, "resource-use-after-move", position, function_name, "a borrow cannot be created from a moved resource binding")
                else:
                    borrow_is_mutable <- is_mutable_reference
                    if borrow_is_mutable and proof_resource_has_borrow_overlap(state, report, borrowed.place, state.binding_names.count):
                        proof_resource_report_borrow_conflict(state, report, borrowed.place, state.binding_names.count, false, "borrow-alias-conflict", position, function_name, "mutable borrow conflicts with another live borrow of the same root")
                    elif not borrow_is_mutable and proof_resource_has_mutable_borrow_overlap(state, report, borrowed.place, state.binding_names.count):
                        proof_resource_report_borrow_conflict(state, report, borrowed.place, state.binding_names.count, true, "borrow-alias-conflict", position, function_name, "shared borrow conflicts with a live mutable borrow of the same root")
                    # Reuse the exact path already stored in the resource state. Re-encoding the
                    # same AST would create structurally equal but numerically different roots,
                    # which would make replayed resource-disjoint evidence unable to identify the
                    # path component it justified.
                    source_place_root <- borrowed.place.path_root
            if borrowed.known and target_slot < state.binding_names.count and borrow_is_mutable:
                source_writable: bool = target_slot < state.binding_writable.count and (state.binding_writable[target_slot] or (target_slot < state.binding_mutable_reference.count and state.binding_mutable_reference[target_slot]))
                proof_resource_add_failing_obligation(report, "borrow-mutable-source", position, function_name, "mutable borrow requires a writable source binding") if not source_writable
            # A loop-header accumulator is a mutable local that the parser declares with its bare type.
            writable: bool = is_mutable_reference or proof_resource_type_has_marker(type_expression, TokenKind.Mutable) or proof_resource_is_loop_accumulator(functions, statement_name, position.offset)
            proof_resource_add_binding_traced(state, report, statement_name, is_reference, is_mutable_reference, writable, target_slot, borrow_is_mutable, source_name, borrowed.place, source_place_root) if is_reference
            proof_resource_add_binding_traced(state, report, statement_name, false, false, writable, state.binding_names.count, false, "", proof_resource_empty_place(), 0) if not is_reference

        def proof_resource_check_pattern_names[@s, @r](pattern: Ast::Pattern, state: mutable ProofResourceState& @s, report: mutable ProofReport& @r, functions: ProofFunctionTable&) -> void:
            match pattern:
                Ast::Pattern.Binding(binding):
                    proof_resource_add_binding_traced(state, report, binding, false, false, false, state.binding_names.count, false, "", proof_resource_empty_place(), 0) if binding != ""
                Ast::Pattern.Rest(binding):
                    proof_resource_add_binding_traced(state, report, binding, false, false, false, state.binding_names.count, false, "", proof_resource_empty_place(), 0) if binding != ""
                Ast::Pattern.TypeBind(_, binding):
                    proof_resource_add_binding_traced(state, report, binding, false, false, false, state.binding_names.count, false, "", proof_resource_empty_place(), 0) if binding != ""
                Ast::Pattern.As(binding, inner):
                    proof_resource_add_binding_traced(state, report, binding, false, false, false, state.binding_names.count, false, "", proof_resource_empty_place(), 0) if binding != ""
                    for nested in inner |nested, state, report|:
                        proof_resource_check_pattern_names(nested, state, report, functions)
                Ast::Pattern.Variant(_, fields):
                    for field in fields |field, state, report|:
                        match field:
                            Ast::Pattern.Field(_, inner):
                                for nested in inner |nested, state, report|:
                                    proof_resource_check_pattern_names(nested, state, report, functions)
                            _:
                                pass
                Ast::Pattern.Or(options):
                    # Alternatives are checked independently by the statement walker. Their
                    # bindings are deliberately not merged into one resource state.
                    pass
                _:
                    pass

        def proof_resource_check_statements[@s, @r](statements: darray[Ast::Stmt]&, state: mutable ProofResourceState& @s, report: mutable ProofReport& @r, function_name: sview, functions: ProofFunctionTable&) -> void:
            for statement in statements |state, report, function_name|:
                position: Ast::Pos = proof_statement_position(statement)
                return if not proof_resource_analysis_budget_available(report, function_name, position)
                report.budgets.resource_steps <- report.budgets.resource_steps + 1
                match statement:
                    Ast::Stmt.VarDecl(local_name, type_expression, initializer, position):
                        shadowed: bool = proof_resource_lookup(state, local_name) < state.binding_names.count
                        proof_resource_check_var(local_name, type_expression, initializer, state, report, function_name, position, functions)
                        if proof_resource_type_is_scalar(type_expression):
                            scalar_slot: usize = proof_resource_lookup(state, local_name)
                            state.binding_scalar[scalar_slot] <- true if scalar_slot < state.binding_scalar.count
                        borrowable: bool = not proof_resource_is_reference_type(type_expression) and not proof_resource_type_is_scalar(type_expression)
                        borrowable_slot: usize = proof_resource_lookup(state, local_name)
                        state.binding_borrowable[borrowable_slot] <- borrowable if borrowable_slot < state.binding_borrowable.count
                        proof_resource_set_binding_borrowable(state, report, local_name, borrowable)
                        if proof_resource_type_is_collection(type_expression):
                            extent_slot: usize = proof_resource_lookup(state, local_name)
                            state.binding_extent[extent_slot] <- true if extent_slot < state.binding_extent.count
                        state.facts.clear() if shadowed or proof_resource_expr_has_call(initializer) or proof_resource_expr_has_move(initializer)
                    Ast::Stmt.Assign(target, _, initializer, position):
                        target_name: sview = proof_resource_direct_binding_name(target)
                        target_slot: usize = proof_resource_lookup(state, target_name)
                        target_is_scalar: bool = target_slot < state.binding_scalar.count and state.binding_scalar[target_slot]
                        if not proof_resource_is_discard_target(target) and not target_is_scalar and proof_resource_expr_returns_local_borrow(initializer, state, functions, report):
                            proof_resource_add_failing_obligation(report, "borrow-escape", position, function_name, "a newly created borrow is assigned across a binding boundary")
                        proof_resource_check_write(target, state, report, function_name, position, functions)
                        proof_resource_check_expression(target, state, report, function_name, functions)
                        proof_resource_check_expression(initializer, state, report, function_name, functions)
                        proof_resource_handle_region_assignment(target, initializer, state, report, function_name, position, functions)
                        state.facts.clear()
                    Ast::Stmt.Expr(expression, position):
                        match expression:
                            Ast::Expr.RegionNew(operand, region, _):
                                # `new[r] value` is itself the resource transition. A bare
                                # expression statement discards the resulting reference, but
                                # the allocation remains valid and must be replayed explicitly.
                                proof_resource_check_expression(operand, state, report, function_name, functions)
                                proof_resource_add_region_discard(state, report, operand, region, position, function_name)
                            _:
                                proof_resource_check_expression(expression, state, report, function_name, functions)
                                proof_resource_add_failing_obligation(report, "region-expression-unsupported", position, function_name, "a region-owned expression must be bound or explicitly rejected at this resource boundary") if proof_resource_expr_statement_discards_region_value(expression, state, functions, report)
                        state.facts.clear() if proof_resource_expr_has_call(expression) or proof_resource_expr_has_move(expression)
                    Ast::Stmt.Return(value, position):
                        if value is returned:
                            return_function_index: usize = proof_resource_function_index(functions, function_name)
                            return_is_scalar: bool = return_function_index < functions.return_scalar.count and functions.return_scalar[return_function_index]
                            return_is_sview: mutable bool = false
                            if return_function_index < functions.return_sviews.count:
                                return_is_sview <- functions.return_sviews[return_function_index]
                            if not return_is_scalar and proof_resource_expr_returns_local_borrow(returned, state, functions, report):
                                proof_resource_add_failing_obligation(report, "borrow-escape", position, function_name, "a borrow cannot escape this lexical proof resource state")
                            if not return_is_scalar and proof_resource_expr_returns_local_region_value(returned, state, functions, report):
                                proof_resource_add_failing_obligation(report, "region-return-escape", position, function_name, "a region-owned value cannot escape the region that owns its storage")
                            returned_region: sview = proof_resource_expr_result_region(returned, state, functions, report)
                            # The summary marker records where the value really lives; it must be the
                            # declared lifetime, including when a call permutes region parameters.
                            declared_return_region: sview = proof_resource_function_return_region(functions, return_function_index)
                            proof_resource_add_failing_obligation(report, "region-return-escape", position, function_name, "the returned value lives in a region other than the declared return region") if not return_is_scalar and returned_region != "" and declared_return_region != "" and returned_region != declared_return_region
                            return_mutable_reference: bool = return_function_index < functions.return_mutable_references.count and functions.return_mutable_references[return_function_index]
                            # Check the returned expression before emitting its summary marker. The
                            # resulting resource-use/call transition (or the explicit allocation
                            # transition below) is then available as the marker's witness.
                            return_events_before: usize = state.trace_events.count
                            proof_resource_check_expression(returned, state, report, function_name, functions)
                            return_witness: mutable usize = report.kernel.nodes.count
                            # The node-count sentinel goes stale as later lookups add nodes, so presence is a flag.
                            return_witness_found: mutable bool = false
                            unlinked_call: bool = proof_resource_sview_return_call_has_unlinked_provenance(returned, functions)
                            unlinked_sview_call: bool = return_is_sview and unlinked_call
                            # A reference returned straight out of a verified call is backed by
                            # whatever the callee summary returns, applied to this call's arguments;
                            # it is recorded as a `param-call` marker that replay re-derives.
                            unlinked_reference_call: bool = not return_is_sview and return_function_index < functions.return_references.count and functions.return_references[return_function_index] and unlinked_call
                            call_return_formal: mutable sview = ""
                            if not unlinked_sview_call and not unlinked_reference_call:
                                match returned:
                                    Ast::Expr.RegionNew(operand, allocated_region, _):
                                        return_witness <- proof_resource_add_region_return_alloc(state, report, operand, allocated_region, position, function_name) if allocated_region != "" and proof_resource_region_is_external(state, allocated_region)
                                        return_witness_found <- allocated_region != "" and proof_resource_region_is_external(state, allocated_region) and return_witness < report.kernel.nodes.count
                                    _:
                                        # The witness is the use of the returned place's own root
                                        # binding, produced by the returned expression itself; see
                                        # return_witnesses.elisa. `return nodes[index].left` uses
                                        # `nodes` and `index`, and only `nodes` backs the result.
                                        return_witness <- proof_resource_exact_return_witness(state, report, return_events_before, proof_resource_return_root_name(returned, functions), returned_region, return_is_sview, return_mutable_reference)
                                        return_witness_found <- return_witness < report.kernel.nodes.count
                            else:
                                callee_name: sview = proof_resource_sview_return_call_name(returned, functions)
                                callee_return_formal: mutable sview = ""
                                if unlinked_sview_call and callee_name != "":
                                    callee_return_formal <- proof_resource_sview_return_formal(report, callee_name)
                                elif callee_name != "":
                                    reference_summary: (known: bool, region: sview, formal: sview, mutable_reference: bool, allocation: bool) = proof_resource_reference_summary_return(report, callee_name)
                                    callee_return_formal <- reference_summary.formal if reference_summary.known and not reference_summary.allocation and reference_summary.mutable_reference == return_mutable_reference
                                actual: (known: bool, place: ProofResourcePlace, slot: usize, is_reference: bool, mutable_reference: bool, writable: bool) = proof_resource_call_formal_actual(returned, callee_return_formal, state, functions, report)
                                candidate_call: usize = state.trace_events[state.trace_events.count - 1] if state.trace_events.count > 0 else report.kernel.nodes.count
                                call_event_valid: mutable bool = false
                                if candidate_call < report.kernel.nodes.count:
                                    call_node: ElisaProofKernelCore::ProofKernelNode = report.kernel.nodes[candidate_call]
                                    call_event_valid <- call_node.kind == "resource-call" and call_node.name == callee_name
                                source_valid: mutable bool = actual.known and actual.place.whole and actual.slot < state.binding_names.count and actual.slot < state.binding_region.count and proof_resource_binding_region(state, actual.slot) == returned_region and (returned_region == "" or proof_resource_binding_region_is_live(state, actual.slot)) and not proof_resource_binding_is_moved(state, actual.slot)
                                source_slot: mutable usize = actual.slot
                                source_place: mutable ProofResourcePlace = actual.place
                                for _ in 0..<state.binding_names.count |source_valid, source_slot, source_place, state|:
                                    continue if source_slot >= state.borrow_present.count or not state.borrow_present[source_slot]
                                    if source_slot >= state.borrow_target_slots.count or source_slot >= state.borrow_target_places.count:
                                        source_valid <- false
                                        continue
                                    next_slot: usize = state.borrow_target_slots[source_slot]
                                    next_place: ProofResourcePlace = state.borrow_target_places[source_slot]
                                    if next_slot >= state.binding_names.count or not next_place.whole or next_place.root == "":
                                        source_valid <- false
                                        continue
                                    source_slot <- next_slot
                                    source_place <- next_place
                                source_valid <- false if source_slot < state.borrow_present.count and state.borrow_present[source_slot]
                                source_valid <- false if return_function_index >= functions.param_counts.count or return_function_index >= functions.param_starts.count
                                source_valid <- false if source_valid and source_slot >= functions.param_counts[return_function_index]
                                source_valid <- false if source_valid and functions.param_starts[return_function_index] + source_slot >= functions.all_params.count
                                caller_formal: mutable sview = ""
                                if source_valid:
                                    caller_formal <- functions.all_params[functions.param_starts[return_function_index] + source_slot]
                                    source_valid <- caller_formal == state.binding_names[source_slot] and source_slot < state.binding_region.count and proof_resource_binding_region(state, source_slot) == returned_region and (returned_region == "" or proof_resource_binding_region_is_live(state, source_slot)) and not proof_resource_binding_is_moved(state, source_slot)
                                # A returned reference keeps the formal's own capability: it must be a
                                # reference formal of exactly the declared pointee mutability.
                                if source_valid and not return_is_sview:
                                    source_valid <- source_slot < state.binding_reference.count and state.binding_reference[source_slot] and (source_slot < state.binding_mutable_reference.count and state.binding_mutable_reference[source_slot]) == return_mutable_reference
                                if source_valid and call_event_valid and callee_return_formal != "":
                                    return_witness <- candidate_call
                                    return_witness_found <- true
                                    call_return_formal <- caller_formal
                            # A function whose declared return type is a scalar primitive returns
                            # a copy. It cannot carry a lifetime however the expression that
                            # produced it was written, so `return cell.value` out of a region-owned
                            # binding is not a region return and needs no marker at all. Emitting
                            # one made the ordinary shape -- read a number out of a region-owned
                            # parameter -- depend on a witness whose mutability had to match a
                            # return that is not a reference in the first place.
                            if returned_region != "" and not return_is_scalar and proof_resource_region_is_external(state, returned_region):
                                proof_resource_add_failing_obligation(report, "region-return-witness-unsupported", position, function_name, "a region return must be tied to a replayed resource use or returned allocation") if not return_witness_found
                                if return_witness_found:
                                    proof_resource_record_sview_call_return(state, report, return_witness, call_return_formal, position, function_name, returned_region) if unlinked_sview_call
                                    proof_resource_record_sview_return(state, report, return_witness, position, function_name, returned_region) if return_is_sview and not unlinked_sview_call
                                    proof_resource_record_event(state, report, "resource-region-return", "param-call", return_witness, returned_region, call_return_formal, 1 if return_mutable_reference else 0) if unlinked_reference_call
                                    proof_resource_record_event(state, report, "resource-region-return", "param", return_witness, returned_region, "", 1 if return_mutable_reference else 0) if not return_is_sview and not unlinked_reference_call
                            # A region-less reference return gets a marker only from an exact
                            # witness; without one the summary pins nothing and callers fail closed.
                            # A mutable one must have it: nothing else stops `return shared_formal`
                            # from minting write access the caller never lent.
                            elif returned_region == "" and declared_return_region == "" and not return_is_scalar and not return_is_sview and return_function_index < functions.return_references.count and functions.return_references[return_function_index]:
                                direct_formal: bool = return_witness_found and not unlinked_reference_call and proof_resource_regionless_return_witness_is_formal(state, report, functions, return_function_index, return_witness)
                                call_formal: bool = return_witness_found and unlinked_reference_call
                                proof_resource_add_failing_obligation(report, "region-return-witness-unsupported", position, function_name, "a mutable reference return must be tied to a replayed mutable reference formal") if return_mutable_reference and not direct_formal and not call_formal
                                proof_resource_record_event(state, report, "resource-region-return", "param-call", return_witness, "", call_return_formal, 1 if return_mutable_reference else 0) if call_formal
                                proof_resource_record_event(state, report, "resource-region-return", "param", return_witness, "", "", 1 if return_mutable_reference else 0) if direct_formal
                    Ast::Stmt.If(condition, then_body, else_body, _):
                        proof_resource_check_expression(condition, state, report, function_name, functions)
                        then_state: mutable ProofResourceState = proof_resource_empty()
                        else_state: mutable ProofResourceState = proof_resource_empty()
                        proof_resource_copy_into(state, &then_state)
                        proof_resource_copy_into(state, &else_state)
                        proof_resource_mark_scope_inherited(state, &then_state)
                        proof_resource_mark_scope_inherited(state, &else_state)
                        proof_resource_check_statements(then_body, &then_state, report, function_name, functions)
                        proof_resource_check_statements(else_body, &else_state, report, function_name, functions)
                        proof_resource_close_child(state, then_state, report, true)
                        proof_resource_close_child(state, else_state, report, true)
                        state.facts.clear()
                    Ast::Stmt.While(condition, while_body, _):
                        proof_resource_check_expression(condition, state, report, function_name, functions)
                        while_state: mutable ProofResourceState = proof_resource_empty()
                        proof_resource_copy_into(state, &while_state)
                        proof_resource_mark_scope_inherited(state, &while_state)
                        proof_resource_check_statements(while_body, &while_state, report, function_name, functions)
                        proof_resource_close_child(state, while_state, report, true)
                        state.facts.clear()
                    Ast::Stmt.For(_, variables, iterable, for_body, _):
                        proof_resource_check_expression(iterable, state, report, function_name, functions)
                        for_state: mutable ProofResourceState = proof_resource_empty()
                        proof_resource_copy_into(state, &for_state)
                        proof_resource_mark_scope_inherited(state, &for_state)
                        for variable in variables |variable, for_state|:
                            proof_resource_add_binding_traced(&for_state, report, variable, false, false, false, for_state.binding_names.count, false, "", proof_resource_empty_place(), 0) if variable != ""
                        proof_resource_check_statements(for_body, &for_state, report, function_name, functions)
                        proof_resource_close_child(state, for_state, report, true)
                        state.facts.clear()
                    Ast::Stmt.Match(scrutinee, arms, _):
                        proof_resource_check_expression(scrutinee, state, report, function_name, functions)
                        for arm in arms |arm, state, report, function_name|:
                            arm_state: mutable ProofResourceState = proof_resource_empty()
                            proof_resource_copy_into(state, &arm_state)
                            proof_resource_mark_scope_inherited(state, &arm_state)
                            proof_resource_check_pattern_names(arm.pattern, &arm_state, report, functions)
                            match arm.guard:
                                Ast::Expr.Absent:
                                    pass
                                _:
                                    proof_resource_check_expression(arm.guard, &arm_state, report, function_name, functions)
                            proof_resource_check_statements(arm.body, &arm_state, report, function_name, functions)
                            proof_resource_close_child(state, arm_state, report, true)
                        state.facts.clear()
                    Ast::Stmt.Block(block_kind, clause, binding, block_body, block_position):
                        if block_kind == "destroy":
                            region_name: sview = clause[0] if clause.count > 0 else binding
                            proof_resource_close_named_region(state, report, region_name, block_position, function_name)
                            state.facts.clear()
                            continue
                        if block_kind == "region" and binding != "" and block_body.count == 0:
                            # Canonical statement form: `region r(size)` is an owner declaration,
                            # not an ordinary binding and not a zero-body lexical block. Its
                            # lifetime extends over subsequent statements until `destroy r` (or
                            # the implicit function-scope close in proof_resource_finish).
                            region_valid: bool = not proof_resource_region_is_active(state, binding)
                            proof_resource_add_failing_obligation(report, "region-scope-unsupported", block_position, function_name, "region declaration must introduce a fresh named lexical region") if binding == "" or not region_valid
                            if region_valid:
                                state.active_regions.push(binding)
                                proof_resource_record_event(state, report, "resource-region-open", "", 0, binding, "", 0)
                            state.facts.clear()
                            continue
                        block_state: mutable ProofResourceState = proof_resource_empty()
                        proof_resource_copy_into(state, &block_state)
                        proof_resource_mark_scope_inherited(state, &block_state)
                        if block_kind == "region" and binding == "":
                            region_name: sview = clause[0] if clause.count > 0 else ""
                            region_valid: bool = region_name != "" and not proof_resource_region_is_active(state, region_name)
                            proof_resource_add_failing_obligation(report, "region-scope-unsupported", block_position, function_name, "region block must introduce a fresh named lexical region") if not region_valid
                            if region_valid:
                                block_state.active_regions.push(region_name)
                                proof_resource_record_event(&block_state, report, "resource-region-open", "", 0, region_name, "", 0)
                            proof_resource_check_statements(block_body, &block_state, report, function_name, functions)
                            proof_resource_check_region_boundary(state, block_state, report, function_name, block_position)
                            if region_valid:
                                if block_state.active_regions.count == state.active_regions.count:
                                    proof_resource_add_failing_obligation(report, "region-scope-unsupported", block_position, function_name, "region scope did not close in the resource transition trace")
                                else:
                                    block_state.active_regions <- block_state.active_regions.truncate(block_state.active_regions.count - 1)
                                    proof_resource_invalidate_region_bindings(&block_state, region_name)
                                    proof_resource_record_event(&block_state, report, "resource-region-close", "", 0, region_name, "", 0)
                            proof_resource_close_child(state, block_state, report, true)
                            state.facts.clear()
                            continue
                        proof_resource_add_binding_traced(&block_state, report, binding, false, false, false, block_state.binding_names.count, false, "", proof_resource_empty_place(), 0) if binding != ""
                        proof_resource_check_statements(block_body, &block_state, report, function_name, functions)
                        proof_resource_close_child(state, block_state, report, true)
                        state.facts.clear()
                    Ast::Stmt.Contract(kind, expression, position):
                        if kind == "assert" or kind == "requires" or proof_is_ensure_kind(kind):
                            proof_resource_check_contract_expression(expression, state, report, function_name, functions, 0)
                            proof_resource_add_failing_obligation(report, "borrow-contract-unsupported", position, function_name, "resource-bearing expressions are not admitted in logical contracts") if proof_resource_expr_has_address_of(expression) or proof_resource_expr_uses_local_borrow(expression, state)
                            proof_resource_add_failing_obligation(report, "region-contract-unsupported", position, function_name, "region-owned expressions are not admitted in logical contracts") if proof_resource_expr_contains_region_value(expression, state)
                    Ast::Stmt.Break(_, _):
                        pass
                    Ast::Stmt.Continue(_, _):
                        pass
                    Ast::Stmt.Invalid:
                        # The main proof-state walker owns the canonical invalid-statement
                        # diagnostic. Resource replay has no additional transition to emit.
                        pass
                    _:
                        proof_resource_add_failing_obligation(report, "statement-unsupported", Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}, function_name, "unknown statement form has no resource transition model")

        def proof_check_resource_safety[@r](file: Ast::File&, parameters: darray[Ast::ParamDecl]&, body: darray[Ast::Stmt]&, facts: darray[Ast::Expr]&, report: mutable ProofReport& @r, function_name: sview, line: u32, functions: ProofFunctionTable&) -> void:
            failed_before: u32 = report.failed
            state: mutable ProofResourceState = proof_resource_empty()
            state.function_name <- function_name
            state.facts.extend(facts)
            proof_global_constant_static_scope(file, function_name, line, &state.static_scope, &state.static_names, &state.static_root_names)
            function_index: usize = proof_resource_function_index(functions, function_name)
            region_parameter_count: usize = proof_resource_function_region_param_count(functions, function_index)
            for region_index in 0..<region_parameter_count |region_index, functions, function_index, state, report|:
                region: sview = proof_resource_function_region_param_at(functions, function_index, region_index)
                valid_region: bool = region != "" and not proof_resource_region_is_active(state, region)
                proof_resource_add_failing_obligation(report, "region-scope-unsupported", Ast::Pos{line: line, column: 0, offset: 0, end_line: line, end_column: 0, end_offset: 0}, function_name, "region-polymorphic parameters must be distinct lifetime capabilities") if not valid_region
                if valid_region:
                    state.active_regions.push(region)
                    state.external_regions.push(region)
                    proof_resource_record_event(&state, report, "resource-region-param", "external", 0, region, "", 0)
            for parameter in parameters |state, report|:
                is_reference: bool = proof_resource_is_reference_type(parameter.type_expression)
                is_mutable_reference: bool = is_reference and proof_resource_is_mutable_reference_type(parameter.type_expression)
                writable: bool = parameter.is_mutable or proof_resource_type_has_marker(parameter.type_expression, TokenKind.Mutable) or is_mutable_reference
                proof_resource_add_binding_traced(&state, report, parameter.name, is_reference, is_mutable_reference, writable, state.binding_names.count, false, "", proof_resource_empty_place(), 0)
                parameter_index: usize = state.binding_names.count - 1
                borrowable: bool = not is_reference and not proof_resource_type_is_scalar(parameter.type_expression)
                state.binding_borrowable[parameter_index] <- borrowable if parameter_index < state.binding_borrowable.count
                proof_resource_set_binding_borrowable(state, report, parameter.name, borrowable)
                state.binding_extent[parameter_index] <- true if parameter_index < state.binding_extent.count and proof_resource_type_is_collection(parameter.type_expression)
                parameter_region: sview = proof_resource_function_parameter_region(functions, function_index, parameter_index)
                if parameter_region != "":
                    if is_reference:
                        proof_resource_set_binding_region(&state, report, parameter.name, parameter_region)
                    elif proof_resource_type_is_sview(parameter.type_expression):
                        proof_resource_record_sview_parameter(&state, report, parameter.type_expression, parameter.name, parameter_region, Ast::expr_pos(parameter.type_expression), function_name)
            state.formal_count <- state.binding_names.count
            proof_resource_check_statements(body, &state, report, function_name, functions)
            proof_resource_finish(&state, report, function_name, line, failed_before, parameters.count)
