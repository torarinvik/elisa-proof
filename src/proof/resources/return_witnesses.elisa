# Exact provenance for a direct region return.
#
# A returned `T& @r` or `sview @r` summary names the formal that backs the result through a
# replayed `resource-use` witness, and callers map that formal to their own actual argument. The
# witness therefore has to be the use of the returned place's own root binding, not whichever
# same-region read happened to come last: `return pick(first, second)`-style shapes, index reads
# (`return nodes[index]`) and earlier unrelated reads of another formal in the same region would
# otherwise hand the caller an alias of the wrong argument. The selector below only considers
# events emitted while checking the returned expression itself and only a use whose binding name
# is the syntactic root of that expression; any other shape yields no witness, and the caller
# refuses the return with `region-return-witness-unsupported`.
extend ElisaProof:
    private:
        # The binding a directly returned place is rooted at, or "" when the expression is not a
        # place path. Calls other than the builtin sview conversion produce no root: their result
        # provenance comes from the callee summary, never from an argument read.
        def proof_resource_return_root_name(expression: Ast::Expr, functions: ProofFunctionTable&, report: mutable ProofReport&) -> sview:
            proof_resource_return_root_name_with_depth(expression, functions, report, 0)

        def proof_resource_return_root_name_with_depth(expression: Ast::Expr, functions: ProofFunctionTable&, report: mutable ProofReport&, depth: usize) -> sview:
            if depth >= PROOF_RESOURCE_EXPRESSION_DEPTH_LIMIT:
                proof_source_index_work_charge(report, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1)
                return ""
            return "" if not proof_source_index_work_charge(report, 1)
            match expression:
                Ast::Expr.Ident(name, _):
                    return name
                Ast::Expr.Paren(inner, _):
                    return proof_resource_return_root_name_with_depth(inner, functions, report, depth + 1)
                Ast::Expr.Move(inner, _):
                    return proof_resource_return_root_name_with_depth(inner, functions, report, depth + 1)
                Ast::Expr.Field(object, _, _):
                    return proof_resource_return_root_name_with_depth(object, functions, report, depth + 1)
                Ast::Expr.Scope(base, _, _):
                    return proof_resource_return_root_name_with_depth(base, functions, report, depth + 1)
                Ast::Expr.Index(object, _, _):
                    return proof_resource_return_root_name_with_depth(object, functions, report, depth + 1)
                Ast::Expr.IndexN(object, _, _):
                    return proof_resource_return_root_name_with_depth(object, functions, report, depth + 1)
                Ast::Expr.Slice(object, _, _, _):
                    return proof_resource_return_root_name_with_depth(object, functions, report, depth + 1)
                Ast::Expr.Call(_, _, _, _):
                    conversion: (known: bool, receiver: Ast::Expr) = proof_resource_builtin_sview_conversion(expression, functions, report, depth)
                    return proof_resource_return_root_name_with_depth(conversion.receiver, functions, report, depth + 1) if conversion.known
                    return ""
                _:
                    return ""

        # Select the witness for a direct region return: the first `resource-use` of the returned
        # root binding among the events the returned expression produced (`events_before` is the
        # trace length before it was checked). The root binding must itself be live in the
        # returned region and, for a reference return, carry exactly the declared mutability.
        # Returns `report.kernel.nodes.count` when no exact witness exists.
        def proof_resource_exact_return_witness(state: ProofResourceState&, report: mutable ProofReport&, events_before: usize, root: sview, returned_region: sview, return_is_sview: bool, return_mutable_reference: bool) -> usize:
            none: usize = report.analysis_1.kernel.nodes.count
            return none if root == "" or events_before > state.evidence.trace_events.count
            binding: (complete: bool, slot: usize) = proof_resource_lookup_with_source_work(state, root, report)
            return none if not binding.complete
            slot: usize = binding.slot
            return none if slot >= state.bindings.binding_names.count
            # An empty `returned_region` asks for a region-less reference witness; the caller
            # additionally requires the binding to be a formal, as replay does.
            return none if:
                proof_resource_binding_region(state, slot) != returned_region
                returned_region != "" and not proof_resource_binding_region_is_live(state, slot)
            # Replay requires the witness binding's mutability to match the marker's: a shared
            # binding may not witness a `mutable T&` return, which is what stops a summary from
            # handing the caller write access it never had.
            root_mutable: bool = slot < state.bindings.binding_mutable_reference.count and state.bindings.binding_mutable_reference[slot]
            return none if not return_is_sview and root_mutable != return_mutable_reference
            witness: mutable usize = none
            for offset in 0..<(state.evidence.trace_events.count - events_before) |offset, state, report, events_before, root, witness|:
                return none if not proof_source_index_work_charge(report, 1)
                continue if witness < report.analysis_1.kernel.nodes.count
                candidate: usize = state.evidence.trace_events[events_before + offset]
                continue if candidate >= report.analysis_1.kernel.nodes.count
                candidate_node: ElisaProofKernelCore::ProofKernelNode = report.analysis_1.kernel.nodes[candidate]
                return none if not proof_source_index_work_charge(report, sview_len(candidate_node.kind)) or not proof_source_index_work_charge(report, sview_len(candidate_node.name)) or not proof_source_index_work_charge(report, sview_len(root))
                continue if candidate_node.kind != "resource-use" or candidate_node.name != root
                witness <- candidate
            return witness

        # A region-less reference return has no lifetime to pin it, so its direct witness must be
        # a use of a whole reference formal of this function, never of a local, and that formal
        # must carry no region. Mirrors proof_kernel_replay_resource_regionless_return.
        def proof_resource_regionless_return_witness_is_formal(state: ProofResourceState&, report: mutable ProofReport&, functions: ProofFunctionTable&, function_index: usize, witness: usize) -> bool:
            return false if witness >= report.analysis_1.kernel.nodes.count or report.analysis_1.kernel.nodes[witness].kind != "resource-use"
            name: sview = report.analysis_1.kernel.nodes[witness].name
            binding: (complete: bool, slot: usize) = proof_resource_lookup_with_source_work(state, name, report)
            return false if not binding.complete
            slot: usize = binding.slot
            return false if:
                name == "" or slot >= state.bindings.binding_names.count
                function_index >= functions.parameters.metadata.param_counts.count or function_index >= functions.parameters.metadata.param_starts.count or slot >= functions.parameters.metadata.param_counts[function_index]
                functions.parameters.metadata.param_starts[function_index] + slot >= functions.parameters.metadata.all_params.count or functions.parameters.metadata.all_params[functions.parameters.metadata.param_starts[function_index] + slot] != name
                proof_resource_binding_region(state, slot) != "" or proof_resource_binding_is_moved(state, slot)
            return slot < state.bindings.binding_reference.count and state.bindings.binding_reference[slot]

        # Producer mirror of the kernel's summary marker walk: every return marker of a summary,
        # including returns recorded inside branch scopes.
        def proof_resource_summary_return_markers(report: mutable ProofReport&, summary_root: usize, markers: mutable darray[usize]&) -> bool:
            return false if summary_root >= report.analysis_1.kernel.nodes.count or report.analysis_1.kernel.nodes[summary_root].kind != "resource-safety"
            scopes: mutable darray[usize] = [summary_root]
            next_scope: mutable usize = 0
            for _ in 0..<report.analysis_1.kernel.nodes.count |next_scope, scopes, markers, report|:
                break if next_scope >= scopes.count
                return false if not proof_source_index_work_charge(report, 1)
                container: ElisaProofKernelCore::ProofKernelNode = report.analysis_1.kernel.nodes[scopes[next_scope]]
                next_scope <- next_scope + 1
                return false if container.children_start > report.analysis_1.kernel.children.count or container.children_count > report.analysis_1.kernel.children.count - container.children_start
                for offset in 0..<container.children_count |offset, container, report, scopes, markers|:
                    return false if not proof_source_index_work_charge(report, 1)
                    child: usize = report.analysis_1.kernel.children[container.children_start + offset]
                    return false if child >= report.analysis_1.kernel.nodes.count
                    return false if not proof_source_index_work_charge(report, sview_len(report.analysis_1.kernel.nodes[child].kind))
                    if report.analysis_1.kernel.nodes[child].kind == "resource-scope":
                        return false if scopes.count >= report.analysis_1.kernel.nodes.count
                        scopes.push(child)
                    elif report.analysis_1.kernel.nodes[child].kind == "resource-region-return":
                        markers.push(child)
            return next_scope >= scopes.count

        # Producer mirror of the kernel's reference summary reader: the single region, formal and
        # pointee mutability a verified callee's reference return is backed by, or a fresh
        # allocation. Disagreeing or foreign markers make the summary unusable.
        def proof_resource_reference_summary_return(report: mutable ProofReport&, callee_name: sview) -> (known: bool, region: sview, formal: sview, mutable_reference: bool, allocation: bool):
            summary_root: mutable usize = report.analysis_1.kernel.nodes.count
            summaries: mutable usize = 0
            for candidate_root in 0..<report.analysis_1.kernel.nodes.count |candidate_root, report, callee_name, summary_root, summaries|:
                return (false, "", "", false, false) if not proof_source_index_work_charge(report, 1)
                candidate: ElisaProofKernelCore::ProofKernelNode = report.analysis_1.kernel.nodes[candidate_root]
                return (false, "", "", false, false) if not proof_source_index_work_charge(report, sview_len(candidate.kind)) or not proof_source_index_work_charge(report, sview_len(candidate.name)) or not proof_source_index_work_charge(report, sview_len(callee_name)) or not proof_source_index_work_charge(report, sview_len(candidate.operator))
                if candidate.kind == "resource-safety" and candidate.name == callee_name and candidate.operator == "resource-v2":
                    summary_root <- candidate_root
                    summaries <- summaries + 1
            return (false, "", "", false, false) if summaries != 1
            return proof_resource_reference_summary_return_at(report, summary_root)

        def proof_resource_reference_summary_return_for_owner(report: mutable ProofReport&, callee_name: sview, callee_owner: sview) -> (known: bool, region: sview, formal: sview, mutable_reference: bool, allocation: bool):
            summary_root: mutable usize = report.analysis_1.kernel.nodes.count
            for candidate_root in 0..<report.analysis_1.kernel.nodes.count |candidate_root, report, callee_name, callee_owner, summary_root|:
                return (false, "", "", false, false) if not proof_source_index_work_charge(report, 1)
                candidate: ElisaProofKernelCore::ProofKernelNode = report.analysis_1.kernel.nodes[candidate_root]
                return (false, "", "", false, false) if not proof_source_index_work_charge(report, sview_len(candidate.kind)) or not proof_source_index_work_charge(report, sview_len(candidate.name)) or not proof_source_index_work_charge(report, sview_len(callee_name)) or not proof_source_index_work_charge(report, sview_len(candidate.operator)) or not proof_source_index_work_charge(report, sview_len(candidate.secondary_name)) or not proof_source_index_work_charge(report, sview_len(callee_owner))
                summary_root <- candidate_root if candidate.kind == "resource-safety" and candidate.name == callee_name and candidate.operator == "resource-v2" and candidate.secondary_name == callee_owner
            return proof_resource_reference_summary_return_at(report, summary_root)

        def proof_resource_reference_summary_return_at(report: mutable ProofReport&, summary_root: usize) -> (known: bool, region: sview, formal: sview, mutable_reference: bool, allocation: bool):
            return (false, "", "", false, false) if summary_root >= report.analysis_1.kernel.nodes.count or report.analysis_1.kernel.nodes[summary_root].operator != "resource-v2"
            markers: mutable darray[usize] = []
            return (false, "", "", false, false) if not proof_resource_summary_return_markers(report, summary_root, &markers)
            returned_region: mutable sview = ""
            returned_formal: mutable sview = ""
            returned_mutable: mutable bool = false
            returned_allocation: mutable bool = false
            seen: mutable bool = false
            for marker_root in markers |marker_root, report, seen, returned_region, returned_formal, returned_mutable, returned_allocation|:
                return (false, "", "", false, false) if not proof_source_index_work_charge(report, 1)
                marker: ElisaProofKernelCore::ProofKernelNode = report.analysis_1.kernel.nodes[marker_root]
                return (false, "", "", false, false) if not proof_source_index_work_charge(report, sview_len(marker.operator)) or not proof_source_index_work_charge(report, sview_len(marker.name)) or not proof_source_index_work_charge(report, sview_len(marker.secondary_name))
                return (false, "", "", false, false) if:
                    marker.auxiliary > 1
                    seen and (returned_region != marker.name or returned_mutable != (marker.auxiliary == 1))
                seen <- true
                returned_region <- marker.name
                returned_mutable <- marker.auxiliary == 1
                marker_formal: mutable sview = ""
                if marker.operator == "param":
                    return (false, "", "", false, false) if marker.secondary_name != "" or marker.left >= report.analysis_1.kernel.nodes.count
                    witness: ElisaProofKernelCore::ProofKernelNode = report.analysis_1.kernel.nodes[marker.left]
                    if witness.kind == "resource-region-return-alloc":
                        return (false, "", "", false, false) if returned_formal != "" or marker.name == ""
                        returned_allocation <- true
                        continue
                    return (false, "", "", false, false) if witness.kind != "resource-use" or witness.name == ""
                    marker_formal <- witness.name
                elif marker.operator == "param-call":
                    return (false, "", "", false, false) if marker.secondary_name == ""
                    marker_formal <- marker.secondary_name
                else:
                    return (false, "", "", false, false)
                return (false, "", "", false, false) if returned_allocation or (returned_formal != "" and returned_formal != marker_formal)
                returned_formal <- marker_formal
            return (false, "", "", false, false) if not seen or (returned_formal == "" and not returned_allocation)
            return (true, returned_region, returned_formal, returned_mutable, returned_allocation)

        # The actual argument a call binds to the callee formal `formal_name`, or unknown when the
        # formal does not exist, the arguments do not map, or the argument is not a tracked place.
        def proof_resource_call_formal_actual(expression: Ast::Expr, formal_name: sview, state: ProofResourceState&, functions: mutable ProofFunctionTable&, report: mutable ProofReport&) -> (known: bool, place: ProofResourcePlace, slot: usize, is_reference: bool, mutable_reference: bool, writable: bool):
            proof_resource_call_formal_actual_with_depth(expression, formal_name, state, functions, report, 0)

        def proof_resource_call_formal_actual_with_depth(expression: Ast::Expr, formal_name: sview, state: ProofResourceState&, functions: mutable ProofFunctionTable&, report: mutable ProofReport&, depth: usize) -> (known: bool, place: ProofResourcePlace, slot: usize, is_reference: bool, mutable_reference: bool, writable: bool):
            empty: ProofResourcePlace = proof_resource_empty_place()
            if depth >= PROOF_RESOURCE_EXPRESSION_DEPTH_LIMIT:
                proof_source_index_work_charge(report, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1)
                return (false, empty, state.bindings.binding_names.count, false, false, false)
            return (false, empty, state.bindings.binding_names.count, false, false, false) if not proof_source_index_work_charge(report, 1)
            match expression:
                Ast::Expr.Call(callee, arguments, argument_names, _):
                    return (false, empty, state.bindings.binding_names.count, false, false, false) if proof_resource_callee_shadowed_by_local(callee, state, report, 0)
                    function_index: usize = proof_function_index_for_callee(functions, callee)
                    return (false, empty, state.bindings.binding_names.count, false, false, false) if formal_name == "" or function_index >= functions.parameters.metadata.param_counts.count or function_index >= functions.parameters.metadata.param_starts.count
                    param_start: usize = functions.parameters.metadata.param_starts[function_index]
                    param_count: usize = functions.parameters.metadata.param_counts[function_index]
                    formal_index: mutable usize = param_count
                    for candidate in 0..<param_count |candidate, functions, param_start, formal_name, formal_index|:
                        formal_index <- candidate if param_start + candidate < functions.parameters.metadata.all_params.count and functions.parameters.metadata.all_params[param_start + candidate] == formal_name
                    return (false, empty, state.bindings.binding_names.count, false, false, false) if formal_index >= param_count
                    mapped: mutable darray[Ast::Expr] = []
                    return (false, empty, state.bindings.binding_names.count, false, false, false) if:
                        not proof_resource_map_call_arguments(functions, function_index, arguments, argument_names, &mapped, report)
                        formal_index >= mapped.count
                    return proof_resource_call_source_actual(mapped[formal_index], functions, state, report)
                Ast::Expr.Paren(inner, _):
                    return proof_resource_call_formal_actual_with_depth(inner, formal_name, state, functions, report, depth + 1)
                _:
                    pass
            return (false, empty, state.bindings.binding_names.count, false, false, false)
