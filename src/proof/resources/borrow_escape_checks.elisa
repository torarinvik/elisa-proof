extend ElisaProof:
    private:
        def proof_resource_function_returns_reference(functions: ProofFunctionTable&, name: sview) -> bool:
            index: usize = proof_resource_function_index(functions, name)
            return index < functions.returns.return_references.count and functions.returns.return_references[index]

        # Only a direct return of one reference formal gets a compositional provenance summary.
        # Any richer return expression (field projection, conditional, aggregate, or multiple
        # sources) stays conservative until its lifetime relation is represented explicitly.
        def proof_resource_reference_return_parameter(parameters: darray[Ast::ParamDecl]&, return_type: Ast::Expr?, body: darray[Ast::Stmt]&, declarations: darray[Ast::Decl]&, generic_lines: darray[u32]&, generic_names: darray[sview]&, declaration_line: u32, declaration_offset: u32, exact_metadata_complete: bool, generic_index: ProofSourceEffectIndex&, generic_names_complete: bool, source_work: mutable usize&) -> usize:
            if return_type is declared_return_type:
                return_markers: (reference: bool, mutable_reference: bool, is_mutable: bool, complete: bool) = proof_resource_type_marker_summary_for_owner_at_offset_with_work(declared_return_type, declarations, generic_lines, generic_names, declaration_line, declaration_offset, exact_metadata_complete, generic_index, generic_names_complete, source_work)
                return parameters.count if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or not return_markers.complete or not return_markers.reference
                # Reuse one bounded name index across every top-level return; duplicate formal
                # spellings remain ambiguous because lookup reports their bucket count.
                parameter_names: mutable darray[sview] = []
                for parameter in parameters |parameter_names, source_work|:
                    return parameters.count if not proof_type_audit_work_charge(1, source_work)
                    parameter_names.push(parameter.name)
                parameter_hashes: mutable darray[u32] = []
                parameter_values: mutable darray[usize] = []
                parameter_counts: mutable darray[usize] = []
                return parameters.count if not proof_source_conversion_name_index_build(parameter_names, &parameter_hashes, &parameter_values, &parameter_counts, source_work)
                candidate: mutable usize = parameters.count
                found: mutable bool = false
                for statement in body |parameters, parameter_names, parameter_hashes, parameter_values, parameter_counts, candidate, found, source_work|:
                    return parameters.count if not proof_type_audit_work_charge(1, source_work)
                    match statement:
                        Ast::Stmt.Return(value, _):
                            if value is returned:
                                match returned:
                                    Ast::Expr.Ident(name, _):
                                        lookup: (complete: bool, count: usize, row: usize) = proof_source_conversion_name_lookup_work(name, parameter_names, parameter_hashes, parameter_values, parameter_counts, source_work)
                                        return parameters.count if not lookup.complete or lookup.count != 1 or lookup.row >= parameters.count
                                        parameter_index: usize = lookup.row
                                        if not found:
                                            candidate <- parameter_index
                                            found <- true
                                        else:
                                            return parameters.count if candidate != parameter_index
                                    _:
                                        return parameters.count
                        Ast::Stmt.VarDecl(_, _, _, _) | Ast::Stmt.Assign(_, _, _, _) | Ast::Stmt.Expr(_, _) | Ast::Stmt.Contract(_, _, _):
                            pass
                        _:
                            # A compound statement may hide a nested `return` of another formal;
                            # never let the top-level returns alone pin the provenance.
                            return parameters.count
                return candidate if found else parameters.count
            return parameters.count

        def proof_resource_borrow_result_is_local(expression: Ast::Expr, state: ProofResourceState&, report: mutable ProofReport&) -> bool:
            borrowed: (known: bool, place: ProofResourcePlace) = proof_resource_borrow_place(expression, report)
            return true if not borrowed.known
            binding: (complete: bool, slot: usize) = proof_resource_lookup_with_source_work(state, borrowed.place.root, report)
            return true if not binding.complete
            slot: usize = binding.slot
            return true if slot >= state.bindings.binding_names.count
            return false if slot < state.bindings.binding_reference.count and state.bindings.binding_reference[slot] and not (slot < state.borrows.borrow_present.count and state.borrows.borrow_present[slot])
            return true

        # Return escape is about the value produced by the expression, not every resource
        # operation performed while computing it. In particular, a call may borrow a local for
        # the duration of the call and return an ordinary value. The older whole-expression
        # predicate is still used for binding/contract boundaries where any hidden borrow is
        # intentionally conservative; this result-specific predicate is the narrower rule for
        # explicit returns and expression-arm values.
        def proof_resource_expr_returns_local_borrow(expression: Ast::Expr, state: ProofResourceState&, functions: mutable ProofFunctionTable&, report: mutable ProofReport&) -> bool:
            return proof_resource_expr_returns_local_borrow_depth(expression, state, functions, report, 0)

        def proof_resource_expr_returns_local_borrow_depth(expression: Ast::Expr, state: ProofResourceState&, functions: mutable ProofFunctionTable&, report: mutable ProofReport&, depth: usize) -> bool:
            # Known unsupported expression forms are reported by the expression checker and are
            # not automatically borrow escapes. The depth boundary alone is conservative here so
            # a deeply nested imported term cannot exhaust the verifier stack.
            return true if depth >= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT
            match expression:
                Ast::Expr.Unary(operator, operand, _):
                    return true if operator == TokenKind.Ampersand
                    return proof_resource_expr_returns_local_borrow_depth(operand, state, functions, report, depth + 1)
                Ast::Expr.Move(operand, _):
                    return proof_resource_expr_returns_local_borrow_depth(operand, state, functions, report, depth + 1)
                Ast::Expr.Ident(name, _):
                    binding: (complete: bool, slot: usize) = proof_resource_lookup_with_source_work(state, name, report)
                    return true if not binding.complete
                    slot: usize = binding.slot
                    return slot < state.borrows.borrow_present.count and state.borrows.borrow_present[slot]
                Ast::Expr.Paren(inner, _):
                    return proof_resource_expr_returns_local_borrow_depth(inner, state, functions, report, depth + 1)
                Ast::Expr.Call(callee, arguments, argument_names, _):
                    callee_name: sview = proof_callable_name(callee)
                    # A bare function-valued local shadows any same-named global row. Its
                    # return provenance must stay opaque here: using the global's
                    # `return_references` bit could say "no local borrow" before the actual
                    # arguments are inspected.
                    return true if proof_resource_callee_shadowed_by_local(callee, state, report, 0)
                    callee_index: usize = proof_function_index_for_callee(functions, callee)
                    if callee_index < functions.returns.return_references.count:
                        return false if not functions.returns.return_references[callee_index]
                        return true if callee_index >= functions.returns.return_reference_parameters.count or callee_index >= functions.parameters.metadata.param_starts.count or callee_index >= functions.parameters.metadata.param_counts.count
                        source_parameter: usize = functions.returns.return_reference_parameters[callee_index]
                        return true if source_parameter >= functions.parameters.metadata.param_counts[callee_index]
                        mapped: mutable darray[Ast::Expr] = []
                        # Reference provenance is admitted only for the same exact positional
                        # mapping used by resource calls. Named calls are resolved through the
                        # shared mapping helper below; no default or omitted actual is guessed.
                        return true if:
                            not proof_resource_map_call_arguments(functions, callee_index, arguments, argument_names, &mapped, report)
                            source_parameter >= mapped.count
                        actual: Ast::Expr = mapped[source_parameter]
                        kind: sview = proof_resource_call_argument_kind(actual, functions, state, report)
                        return proof_resource_expr_uses_local_borrow(actual, state, report) if kind == "reference"
                        return proof_resource_borrow_result_is_local(actual, state, report) if kind == "borrow"
                        return true
                    return true if proof_resource_expr_uses_local_borrow(callee, state, report)
                    for argument in arguments |argument, state, functions, depth|:
                        return true if proof_resource_expr_returns_local_borrow_depth(argument, state, functions, report, depth + 1)
                    return false
                Ast::Expr.StaticEffectCall(_, _, _, _, _, _):
                    lowered: (known: bool, call: Ast::Expr) = proof_lower_static_effect_call(expression)
                    return proof_resource_expr_returns_local_borrow_depth(lowered.call, state, functions, report, depth + 1) if lowered.known
                    return true
                Ast::Expr.Field(object, _, _):
                    return proof_resource_expr_returns_local_borrow_depth(object, state, functions, report, depth + 1)
                Ast::Expr.Scope(base, _, _):
                    return proof_resource_expr_returns_local_borrow_depth(base, state, functions, report, depth + 1)
                Ast::Expr.Index(object, index, _):
                    return proof_resource_expr_returns_local_borrow_depth(object, state, functions, report, depth + 1) or proof_resource_expr_returns_local_borrow_depth(index, state, functions, report, depth + 1)
                Ast::Expr.IndexN(object, arguments, _):
                    return true if proof_resource_expr_returns_local_borrow_depth(object, state, functions, report, depth + 1)
                    for argument in arguments |argument, state, functions, report, depth|:
                        return true if proof_resource_expr_returns_local_borrow_depth(argument, state, functions, report, depth + 1)
                    return false
                Ast::Expr.Slice(object, low, high, _):
                    return proof_resource_expr_returns_local_borrow_depth(object, state, functions, report, depth + 1) or proof_resource_expr_returns_local_borrow_depth(low, state, functions, report, depth + 1) or proof_resource_expr_returns_local_borrow_depth(high, state, functions, report, depth + 1)
                Ast::Expr.Binary(_, _, _, _):
                    # Binary operators produce values. Their operands may borrow temporarily,
                    # but that borrow is not itself the returned value.
                    return false
                Ast::Expr.RegionNew(operand, _, _):
                    return proof_resource_expr_returns_local_borrow_depth(operand, state, functions, report, depth + 1)
                Ast::Expr.Array(elements, _):
                    for element in elements |element, state, functions, report, depth|:
                        return true if proof_resource_expr_returns_local_borrow_depth(element, state, functions, report, depth + 1)
                    return false
                Ast::Expr.Tuple(elements, _):
                    for element in elements |element, state, functions, report, depth|:
                        return true if proof_resource_expr_returns_local_borrow_depth(element, state, functions, report, depth + 1)
                    return false
                Ast::Expr.SetLit(elements, _):
                    for element in elements |element, state, functions, report, depth|:
                        return true if proof_resource_expr_returns_local_borrow_depth(element, state, functions, report, depth + 1)
                    return false
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |entry, state, functions, report, depth|:
                        return true if proof_resource_expr_returns_local_borrow_depth(entry.key, state, functions, report, depth + 1) or proof_resource_expr_returns_local_borrow_depth(entry.value, state, functions, report, depth + 1)
                    return false
                Ast::Expr.Construct(_, fields, _):
                    for field in fields |field, state, functions, report, depth|:
                        return true if proof_resource_expr_returns_local_borrow_depth(field.value, state, functions, report, depth + 1)
                    return false
                Ast::Expr.RecordUpdate(base, fields, _):
                    return true if proof_resource_expr_returns_local_borrow_depth(base, state, functions, report, depth + 1)
                    for field in fields |field, state, functions, report, depth|:
                        return true if proof_resource_expr_returns_local_borrow_depth(field.value, state, functions, report, depth + 1)
                    return false
                Ast::Expr.If(condition, then_expr, else_expr, _):
                    return proof_resource_expr_returns_local_borrow_depth(then_expr, state, functions, report, depth + 1) or proof_resource_expr_returns_local_borrow_depth(else_expr, state, functions, report, depth + 1)
                Ast::Expr.Comprehension(_, _, _, body, _):
                    return proof_resource_expr_returns_local_borrow_depth(body, state, functions, report, depth + 1)
                Ast::Expr.Refinement(base, _, _):
                    return proof_resource_expr_returns_local_borrow_depth(base, state, functions, report, depth + 1)
                Ast::Expr.Match(scrutinee, arms, _):
                    return true if proof_resource_expr_returns_local_borrow_depth(scrutinee, state, functions, report, depth + 1)
                    for arm in arms |arm, state, functions, report, depth|:
                        return true if proof_resource_statements_result_uses_local_borrow_depth(arm.body, state, functions, report, depth + 1)
                    return false
                Ast::Expr.Catch(guarded, arms, _):
                    return true if proof_resource_expr_returns_local_borrow_depth(guarded, state, functions, report, depth + 1)
                    for arm in arms |arm, state, functions, report, depth|:
                        return true if proof_resource_statements_result_uses_local_borrow_depth(arm.body, state, functions, report, depth + 1)
                    return false
                Ast::Expr.Block(statements, value, _, _):
                    return true if proof_resource_statements_return_local_borrow_depth(statements, state, functions, report, depth + 1)
                    return proof_resource_expr_returns_local_borrow_depth(value, state, functions, report, depth + 1)
                Ast::Expr.Lambda(_, body, _):
                    # A lambda captures a fresh callable value; a borrow in its body is not the
                    # result of this expression, and closure lifetime checking remains separate.
                    return false if body.count > 0
                    return false
                _:
                    return false

        def proof_resource_statements_return_local_borrow(statements: darray[Ast::Stmt]&, state: ProofResourceState&, functions: mutable ProofFunctionTable&, report: mutable ProofReport&) -> bool:
            return proof_resource_statements_return_local_borrow_depth(statements, state, functions, report, 0)

        def proof_resource_statements_return_local_borrow_depth(statements: darray[Ast::Stmt]&, state: ProofResourceState&, functions: mutable ProofFunctionTable&, report: mutable ProofReport&, depth: usize) -> bool:
            return true if depth >= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT
            for statement in statements |state, functions, report|:
                match statement:
                    Ast::Stmt.Return(value, _):
                        return true if value is returned and proof_resource_expr_returns_local_borrow_depth(returned, state, functions, report, depth + 1)
                    Ast::Stmt.If(_, then_body, else_body, _):
                        return true if proof_resource_statements_return_local_borrow_depth(then_body, state, functions, report, depth + 1) or proof_resource_statements_return_local_borrow_depth(else_body, state, functions, report, depth + 1)
                    Ast::Stmt.While(_, while_body, _):
                        return true if proof_resource_statements_return_local_borrow_depth(while_body, state, functions, report, depth + 1)
                    Ast::Stmt.For(_, _, _, for_body, _):
                        return true if proof_resource_statements_return_local_borrow_depth(for_body, state, functions, report, depth + 1)
                    Ast::Stmt.Match(_, arms, _):
                        for arm in arms |arm, state, functions, report|:
                            return true if proof_resource_statements_return_local_borrow_depth(arm.body, state, functions, report, depth + 1)
                    Ast::Stmt.Block(_, _, _, block_body, _):
                        return true if proof_resource_statements_return_local_borrow_depth(block_body, state, functions, report, depth + 1)
                    _:
                        pass
            return false

        def proof_resource_statements_result_uses_local_borrow(statements: darray[Ast::Stmt]&, state: ProofResourceState&, functions: mutable ProofFunctionTable&, report: mutable ProofReport&) -> bool:
            return proof_resource_statements_result_uses_local_borrow_depth(statements, state, functions, report, 0)

        def proof_resource_statements_result_uses_local_borrow_depth(statements: darray[Ast::Stmt]&, state: ProofResourceState&, functions: mutable ProofFunctionTable&, report: mutable ProofReport&, depth: usize) -> bool:
            return true if depth >= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT
            return false if statements.count == 0
            return true if proof_resource_statements_return_local_borrow_depth(statements, state, functions, report, depth + 1)
            last: Ast::Stmt = statements[statements.count - 1]
            match last:
                Ast::Stmt.Expr(expression, _):
                    return proof_resource_expr_returns_local_borrow_depth(expression, state, functions, report, depth + 1)
                Ast::Stmt.Return(value, _):
                    if value is returned:
                        return proof_resource_expr_returns_local_borrow_depth(returned, state, functions, report, depth + 1)
                    return false
                _:
                    return false

        def proof_resource_is_discard_target(expression: Ast::Expr, report: mutable ProofReport&) -> bool:
            proof_resource_is_discard_target_with_depth(expression, report, 0)

        def proof_resource_is_discard_target_with_depth(expression: Ast::Expr, report: mutable ProofReport&, depth: usize) -> bool:
            if depth >= PROOF_RESOURCE_EXPRESSION_DEPTH_LIMIT:
                proof_source_index_work_charge(report, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1)
                return true
            return true if not proof_source_index_work_charge(report, 1)
            match expression:
                Ast::Expr.Ident(name, _):
                    return name == "_"
                Ast::Expr.Paren(inner, _):
                    return proof_resource_is_discard_target_with_depth(inner, report, depth + 1)
                _:
                    return false

        def proof_resource_expr_uses_borrowed_target(expression: Ast::Expr, state: ProofResourceState&, report: mutable ProofReport&) -> bool:
            proof_resource_expr_uses_borrowed_target_with_depth(expression, state, report, 0)

        def proof_resource_expr_uses_borrowed_target_with_depth(expression: Ast::Expr, state: ProofResourceState&, report: mutable ProofReport&, depth: usize) -> bool:
            if depth >= PROOF_RESOURCE_EXPRESSION_DEPTH_LIMIT:
                proof_source_index_work_charge(report, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1)
                return true
            return true if not proof_source_index_work_charge(report, 1)
            return true if proof_expr_has_call(expression) and not proof_expr_supported(expression)
            # A direct address-of is a resource-bearing value. Field/index places deliberately
            # stay outside the opaque-call rule when they are newly created; existing live field
            # borrows are still checked by the place overlap relation below.
            return true if proof_resource_direct_borrow_root(expression, report) != ""
            accessed: (known: bool, place: ProofResourcePlace) = proof_resource_place(expression, report)
            if accessed.known:
                binding: (complete: bool, slot: usize) = proof_resource_lookup_with_source_work(state, accessed.place.root, report)
                return true if not binding.complete
                slot: usize = binding.slot
                return false if slot >= state.bindings.binding_names.count
                return true if slot < state.borrows.borrow_present.count and state.borrows.borrow_present[slot]
                return proof_resource_has_borrow_overlap_readonly(state, report, accessed.place, state.bindings.binding_names.count)
            match expression:
                Ast::Expr.Ident(name, _):
                    binding: (complete: bool, slot: usize) = proof_resource_lookup_with_source_work(state, name, report)
                    return true if not binding.complete
                    slot: usize = binding.slot
                    return false if slot >= state.bindings.binding_names.count
                    return true if slot < state.borrows.borrow_present.count and state.borrows.borrow_present[slot]
                    return proof_resource_has_borrow_for(state, slot, state.bindings.binding_names.count)
                Ast::Expr.Unary(_, operand, _):
                    return proof_resource_expr_uses_borrowed_target_with_depth(operand, state, report, depth + 1)
                Ast::Expr.Paren(inner, _):
                    return proof_resource_expr_uses_borrowed_target_with_depth(inner, state, report, depth + 1)
                Ast::Expr.Binary(left, _, right, _):
                    return proof_resource_expr_uses_borrowed_target_with_depth(left, state, report, depth + 1) or proof_resource_expr_uses_borrowed_target_with_depth(right, state, report, depth + 1)
                Ast::Expr.Field(object, _, _):
                    return proof_resource_expr_uses_borrowed_target_with_depth(object, state, report, depth + 1)
                Ast::Expr.Scope(base, _, _):
                    return proof_resource_expr_uses_borrowed_target_with_depth(base, state, report, depth + 1)
                Ast::Expr.Index(object, index, _):
                    return proof_resource_expr_uses_borrowed_target_with_depth(object, state, report, depth + 1) or proof_resource_expr_uses_borrowed_target_with_depth(index, state, report, depth + 1)
                Ast::Expr.IndexN(object, arguments, _):
                    return true if proof_resource_expr_uses_borrowed_target_with_depth(object, state, report, depth + 1)
                    for argument in arguments |argument, state, report, depth|:
                        return true if proof_resource_expr_uses_borrowed_target_with_depth(argument, state, report, depth + 1)
                    return false
                Ast::Expr.Slice(object, low, high, _):
                    return proof_resource_expr_uses_borrowed_target_with_depth(object, state, report, depth + 1) or proof_resource_expr_uses_borrowed_target_with_depth(low, state, report, depth + 1) or proof_resource_expr_uses_borrowed_target_with_depth(high, state, report, depth + 1)
                Ast::Expr.Call(callee, arguments, _, _):
                    return true if proof_resource_expr_uses_borrowed_target_with_depth(callee, state, report, depth + 1)
                    for argument in arguments |argument, state, report, depth|:
                        return true if proof_resource_expr_uses_borrowed_target_with_depth(argument, state, report, depth + 1)
                    return false
                Ast::Expr.StaticEffectCall(_, _, _, _, _, _):
                    lowered: (known: bool, call: Ast::Expr) = proof_lower_static_effect_call(expression)
                    return proof_resource_expr_uses_borrowed_target_with_depth(lowered.call, state, report, depth + 1) if lowered.known
                    return true
                Ast::Expr.RegionNew(operand, _, _):
                    return proof_resource_expr_uses_borrowed_target_with_depth(operand, state, report, depth + 1)
                Ast::Expr.Array(elements, _):
                    for element in elements |element, state, report, depth|:
                        return true if proof_resource_expr_uses_borrowed_target_with_depth(element, state, report, depth + 1)
                    return false
                Ast::Expr.Tuple(elements, _):
                    for element in elements |element, state, report, depth|:
                        return true if proof_resource_expr_uses_borrowed_target_with_depth(element, state, report, depth + 1)
                    return false
                Ast::Expr.SetLit(elements, _):
                    for element in elements |element, state, report, depth|:
                        return true if proof_resource_expr_uses_borrowed_target_with_depth(element, state, report, depth + 1)
                    return false
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |entry, state, report, depth|:
                        return true if proof_resource_expr_uses_borrowed_target_with_depth(entry.key, state, report, depth + 1) or proof_resource_expr_uses_borrowed_target_with_depth(entry.value, state, report, depth + 1)
                    return false
                Ast::Expr.Construct(_, fields, _):
                    for field in fields |field, state, report, depth|:
                        return true if proof_resource_expr_uses_borrowed_target_with_depth(field.value, state, report, depth + 1)
                    return false
                Ast::Expr.RecordUpdate(base, fields, _):
                    return true if proof_resource_expr_uses_borrowed_target_with_depth(base, state, report, depth + 1)
                    for field in fields |field, state, report, depth|:
                        return true if proof_resource_expr_uses_borrowed_target_with_depth(field.value, state, report, depth + 1)
                    return false
                Ast::Expr.If(condition, then_expr, else_expr, _):
                    return proof_resource_expr_uses_borrowed_target_with_depth(condition, state, report, depth + 1) or proof_resource_expr_uses_borrowed_target_with_depth(then_expr, state, report, depth + 1) or proof_resource_expr_uses_borrowed_target_with_depth(else_expr, state, report, depth + 1)
                Ast::Expr.Comprehension(_, iterable, condition, body, _):
                    return proof_resource_expr_uses_borrowed_target_with_depth(iterable, state, report, depth + 1) or proof_resource_expr_uses_borrowed_target_with_depth(condition, state, report, depth + 1) or proof_resource_expr_uses_borrowed_target_with_depth(body, state, report, depth + 1)
                Ast::Expr.Refinement(base, predicate, _):
                    return proof_resource_expr_uses_borrowed_target_with_depth(base, state, report, depth + 1) or proof_resource_expr_uses_borrowed_target_with_depth(predicate, state, report, depth + 1)
                Ast::Expr.Match(scrutinee, arms, _):
                    return true if proof_resource_expr_uses_borrowed_target_with_depth(scrutinee, state, report, depth + 1)
                    for arm in arms |arm, state, report, depth|:
                        return true if:
                            proof_resource_expr_uses_borrowed_target_with_depth(arm.guard, state, report, depth + 1)
                            proof_resource_statements_use_borrowed_target_depth(arm.body, state, report, depth + 1)
                    return false
                Ast::Expr.Catch(guarded, arms, _):
                    return true if proof_resource_expr_uses_borrowed_target_with_depth(guarded, state, report, depth + 1)
                    for arm in arms |arm, state, report, depth|:
                        return true if:
                            proof_resource_expr_uses_borrowed_target_with_depth(arm.guard, state, report, depth + 1)
                            proof_resource_statements_use_borrowed_target_depth(arm.body, state, report, depth + 1)
                    return false
                Ast::Expr.GetElse(guarded, recovery, _):
                    return proof_resource_expr_uses_borrowed_target_with_depth(guarded, state, report, depth + 1) or proof_resource_statements_use_borrowed_target_depth(recovery, state, report, depth + 1)
                Ast::Expr.Lambda(_, body, _):
                    return proof_resource_statements_use_borrowed_target_depth(body, state, report, depth + 1)
                Ast::Expr.Block(statements, value, _, _):
                    return proof_resource_statements_use_borrowed_target_depth(statements, state, report, depth + 1) or proof_resource_expr_uses_borrowed_target_with_depth(value, state, report, depth + 1)
                _:
                    return false

        def proof_resource_statements_use_borrowed_target(statements: darray[Ast::Stmt]&, state: ProofResourceState&, report: mutable ProofReport&) -> bool:
            return proof_resource_statements_use_borrowed_target_depth(statements, state, report, 0)

        def proof_resource_statements_use_borrowed_target_depth(statements: darray[Ast::Stmt]&, state: ProofResourceState&, report: mutable ProofReport&, depth: usize) -> bool:
            if depth >= PROOF_RESOURCE_EXPRESSION_DEPTH_LIMIT:
                proof_source_index_work_charge(report, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1)
                return true
            return true if statements.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or not proof_source_index_work_charge(report, statements.count)
            for statement in statements |depth, report|:
                return true if not proof_source_index_work_charge(report, 1)
                match statement:
                    Ast::Stmt.VarDecl(_, _, initializer, _):
                        borrowed: (known: bool, place: ProofResourcePlace) = proof_resource_borrow_place(initializer, report)
                        return true if borrowed.known or proof_resource_expr_uses_borrowed_target_with_depth(initializer, state, report, depth + 1)
                    Ast::Stmt.Assign(target, _, initializer, _):
                        borrowed: (known: bool, place: ProofResourcePlace) = proof_resource_borrow_place(initializer, report)
                        return true if proof_resource_expr_uses_borrowed_target_with_depth(target, state, report, depth + 1) or borrowed.known or proof_resource_expr_uses_borrowed_target_with_depth(initializer, state, report, depth + 1)
                    Ast::Stmt.Expr(expression, _):
                        return true if proof_resource_expr_uses_borrowed_target_with_depth(expression, state, report, depth + 1)
                    Ast::Stmt.Return(value, _):
                        return true if value is returned and proof_resource_expr_uses_borrowed_target_with_depth(returned, state, report, depth + 1)
                    Ast::Stmt.If(condition, then_body, else_body, _):
                        return true if proof_resource_expr_uses_borrowed_target_with_depth(condition, state, report, depth + 1) or proof_resource_statements_use_borrowed_target_depth(then_body, state, report, depth + 1) or proof_resource_statements_use_borrowed_target_depth(else_body, state, report, depth + 1)
                    Ast::Stmt.While(condition, while_body, _):
                        return true if proof_resource_expr_uses_borrowed_target_with_depth(condition, state, report, depth + 1) or proof_resource_statements_use_borrowed_target_depth(while_body, state, report, depth + 1)
                    Ast::Stmt.For(_, _, iterable, for_body, _):
                        return true if proof_resource_expr_uses_borrowed_target_with_depth(iterable, state, report, depth + 1) or proof_resource_statements_use_borrowed_target_depth(for_body, state, report, depth + 1)
                    Ast::Stmt.Match(scrutinee, arms, _):
                        return true if proof_resource_expr_uses_borrowed_target_with_depth(scrutinee, state, report, depth + 1)
                        for arm in arms |arm, state, report, depth|:
                            return true if proof_resource_expr_uses_borrowed_target_with_depth(arm.guard, state, report, depth + 1) or proof_resource_statements_use_borrowed_target_depth(arm.body, state, report, depth + 1)
                    Ast::Stmt.Block(_, _, _, block_body, _):
                        return true if proof_resource_statements_use_borrowed_target_depth(block_body, state, report, depth + 1)
                    Ast::Stmt.Contract(_, expression, _):
                        return true if proof_resource_expr_uses_borrowed_target_with_depth(expression, state, report, depth + 1)
                    _:
                        pass
            return false
