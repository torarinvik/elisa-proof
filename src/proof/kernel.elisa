# Source-neutral certificate terms and the first trusted-kernel lowering boundary.
#
# The main checker works on the compiler AST because that is what makes importing Elisa
# practical. Certificates are additionally lowered here into an arena whose nodes contain
# only canonical operators, literals, names, and indices. The replay implementation consumes
# this arena rather than calling compiler AST helpers. An expression outside this deliberately
# small term language is represented as `unsupported` and can never replay successfully.
include "./replay/numeric_literal_sort.elisa"
extend ElisaProof:
    private:
        const PROOF_KERNEL_AST_SUPPORT_WORK_LIMIT: usize = 1048576

        def proof_kernel_ast_support_charge(amount: usize, work: mutable usize&) -> bool:
            if work > PROOF_KERNEL_AST_SUPPORT_WORK_LIMIT or amount > PROOF_KERNEL_AST_SUPPORT_WORK_LIMIT - work:
                work <- PROOF_KERNEL_AST_SUPPORT_WORK_LIMIT + 1
                return false
            work <- work + amount
            return true

    public:
        def proof_kernel_operator(operator: TokenKind) -> sview:
            return "+" if operator == TokenKind.Plus
            return "-" if operator == TokenKind.Minus
            return "*" if operator == TokenKind.Star
            return "/" if operator == TokenKind.Slash
            return "%" if operator == TokenKind.Percent
            return "==" if operator == TokenKind.EqEq
            return "!=" if operator == TokenKind.BangEq
            return "<" if operator == TokenKind.Lt
            return ">" if operator == TokenKind.Gt
            return "<=" if operator == TokenKind.LtEq
            return ">=" if operator == TokenKind.GtEq
            return "and" if operator == TokenKind.And
            return "or" if operator == TokenKind.Or
            return "=>" if operator == TokenKind.FatArrow
            return "not" if operator == TokenKind.Not
            return "in" if operator == TokenKind.In
            return "is" if operator == TokenKind.Is
            return "as" if operator == TokenKind.As
            return "|" if operator == TokenKind.Pipe
            return "^" if operator == TokenKind.Caret
            return "&" if operator == TokenKind.Ampersand
            return "<<" if operator == TokenKind.LShift
            return ">>" if operator == TokenKind.RShift
            return "range_lt" if operator == TokenKind.RangeLt
            return "range_le" if operator == TokenKind.RangeLe
            return "else" if operator == TokenKind.Else
            return "unknown"

        def proof_kernel_operator_supported(operator: TokenKind) -> bool:
            return proof_kernel_operator(operator) != "unknown"

        def proof_kernel_add_node(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, kind: sview, operator: sview, left: usize, right: usize, auxiliary: usize, children_start: usize, children_count: usize, value: i64, name: sview, secondary_name: sview) -> usize:
            return nodes.count if nodes.count >= ElisaProofKernelCore::PROOF_KERNEL_NODE_BUDGET
            return ElisaProofKernelCore::add_node(nodes, kind, operator, left, right, auxiliary, children_start, children_count, value, name, secondary_name)

        # The parser erases the forall/exists spelling from contract blocks. Bind that
        # proposition kind into the source-neutral node whenever the caller has recovered it
        # from the source annotation. An unbound node remains structurally representable for
        # non-logical transforms, but the quantifier replay rule rejects it.
        def proof_kernel_bind_quantifier_kind(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, kind: sview) -> bool:
            return false if:
                kind != "forall" and kind != "exists"
                root >= nodes.count or nodes[root].kind != "quantifier"
                nodes[root].operator != "" and nodes[root].operator != kind
            nodes[root].operator <- kind
            return true

        # Certificate premises must belong to the source-neutral term language, not merely to
        # the richer AST language accepted by the main prover. This mirrors the encoder's shape
        # boundary so an unsupported child cannot be smuggled into an otherwise supported parent.
        def proof_kernel_expression_supported(expression: Ast::Expr) -> bool:
            work: mutable usize = 0
            result: (complete: bool, supported: bool) = proof_kernel_expression_supported_with_work(expression, &work)
            result.complete and result.supported

        # Batch callers pass one counter across multiple facts so a collection of individually
        # bounded terms cannot multiply the work limit without bound.
        def proof_kernel_expression_supported_with_work(expression: Ast::Expr, work: mutable usize&) -> (complete: bool, supported: bool):
            return (false, false) if work > PROOF_KERNEL_AST_SUPPORT_WORK_LIMIT
            supported: bool = proof_kernel_expression_supported_depth_with_work(expression, 0, &work)
            (work <= PROOF_KERNEL_AST_SUPPORT_WORK_LIMIT, supported)

        def proof_kernel_ast_support_charge_with_work(amount: usize, work: mutable usize&) -> bool:
            proof_kernel_ast_support_charge(amount, &work)

    private:
        # Contract quantifier binders are lowered by the parser to i64. Their annotation is
        # erased from the neutral arena, so admit only that parser-authentic type rather than
        # allowing an unrepresented annotation to disagree with the range-inferred kernel sort.
        def proof_kernel_quantifier_integer_type(type_expression: Ast::Expr) -> bool:
            match type_expression:
                Ast::Expr.Ident(name, _):
                    return name == "i64"
                _:
                    return false

        # Checked-get nodes intentionally erase their recovery body from the source-neutral
        # arena, but that body still belongs to the source term being admitted. Validate its
        # shape before erasure so an Invalid statement or an unsupported child cannot hide behind
        # an otherwise valid guarded index. The statement semantics remain the responsibility of
        # the source checker; this boundary only guarantees that the imported AST is well formed.
        def proof_kernel_recovery_supported_with_work(statements: darray[Ast::Stmt], depth: usize, work: mutable usize&) -> bool:
            return false if not ElisaProofKernelCore::depth_valid(depth)
            for statement in statements |statement, depth, work|:
                return false if not proof_kernel_ast_support_charge(1, &work)
                match statement:
                    Ast::Stmt.Invalid:
                        return false
                    Ast::Stmt.Expr(expression, _):
                        return false if not proof_kernel_expression_supported_depth_with_work(expression, depth + 1, &work)
                    Ast::Stmt.Block(_, _, _, body, _):
                        return false if not proof_kernel_recovery_supported_with_work(body, depth + 1, &work)
                    Ast::Stmt.VarDecl(binder, type_expression, value, _):
                        return false if:
                            binder == ""
                            not proof_kernel_expression_supported_depth_with_work(type_expression, depth + 1, &work) or not proof_kernel_expression_supported_depth_with_work(value, depth + 1, &work)
                    Ast::Stmt.Assign(target, _, value, _):
                        return false if not proof_kernel_expression_supported_depth_with_work(target, depth + 1, &work) or not proof_kernel_expression_supported_depth_with_work(value, depth + 1, &work)
                    Ast::Stmt.If(condition, then_body, else_body, _):
                        return false if:
                            not proof_kernel_expression_supported_depth_with_work(condition, depth + 1, &work)
                            not proof_kernel_recovery_supported_with_work(then_body, depth + 1, &work) or not proof_kernel_recovery_supported_with_work(else_body, depth + 1, &work)
                    Ast::Stmt.While(condition, body, _):
                        return false if not proof_kernel_expression_supported_depth_with_work(condition, depth + 1, &work) or not proof_kernel_recovery_supported_with_work(body, depth + 1, &work)
                    Ast::Stmt.For(_, variables, iterable, body, _):
                        return false if variables.count == 0
                        for variable in variables |work|:
                            return false if not proof_kernel_ast_support_charge(1, &work)
                            return false if variable == ""
                        return false if not proof_kernel_expression_supported_depth_with_work(iterable, depth + 1, &work) or not proof_kernel_recovery_supported_with_work(body, depth + 1, &work)
                    Ast::Stmt.Return(value, _):
                        if value is returned:
                            return false if not proof_kernel_expression_supported_depth_with_work(returned, depth + 1, &work)
                    Ast::Stmt.Break(_, _):
                        pass
                    Ast::Stmt.Continue(_, _):
                        pass
                    Ast::Stmt.Match(scrutinee, arms, _):
                        return false if not proof_kernel_expression_supported_depth_with_work(scrutinee, depth + 1, &work)
                        for arm in arms |arm, depth, work|:
                            return false if not proof_kernel_ast_support_charge(1, &work)
                            return false if not proof_kernel_expression_supported_depth_with_work(arm.guard, depth + 1, &work) or not proof_kernel_recovery_supported_with_work(arm.body, depth + 1, &work)
                    Ast::Stmt.Contract(_, expression, _):
                        return false if not proof_kernel_expression_supported_depth_with_work(expression, depth + 1, &work)
            return true

        # Keep the producer-side AST walk bounded just like the encoder and replay matcher. A
        # compiler-owned AST can still be malformed at an import boundary; rejecting it before
        # descending further is safer than relying on the host call stack to reject it.
        def proof_kernel_expression_supported_depth(expression: Ast::Expr, depth: usize) -> bool:
            work: mutable usize = 0
            proof_kernel_expression_supported_depth_with_work(expression, depth, &work)

        def proof_kernel_expression_supported_depth_with_work(expression: Ast::Expr, depth: usize, work: mutable usize&) -> bool:
            return false if not ElisaProofKernelCore::depth_valid(depth)
            return false if not proof_kernel_ast_support_charge(1, &work)
            match expression:
                Ast::Expr.IntLit(_, _):
                    return true
                Ast::Expr.Absent:
                    # Open slice endpoints are explicit source terms. Keeping the omitted
                    # endpoint distinct from an invalid expression prevents `[:]` from being
                    # confused with a malformed certificate child.
                    return true
                Ast::Expr.BoolLit(_, _):
                    return true
                Ast::Expr.FloatLit(_, _):
                    return true
                Ast::Expr.StringLit(_, _):
                    return true
                Ast::Expr.CharLit(_, _):
                    return true
                Ast::Expr.Ident(name, _):
                    return name != ""
                Ast::Expr.ShorthandMember(parts, _):
                    # Keep enum shorthand distinct from an ordinary identifier. Only the
                    # one-segment value form is admitted until qualified type identity is carried
                    # by the source-neutral term language.
                    return false if parts.count != 1 or not proof_kernel_ast_support_charge(1, &work)
                    return parts[0] != ""
                Ast::Expr.Paren(inner, _):
                    return proof_kernel_expression_supported_depth_with_work(inner, depth + 1, &work)
                # `get collection[index] else fallback` is represented in the compiler AST as
                # an Else binary around an Index. Keep this source form explicit in the arena so
                # the replay kernel can validate the checked-access primitive instead of treating
                # it as an unknown arithmetic operator.
                Ast::Expr.Binary(Ast::Expr.Index(object, index, _), TokenKind.Else, fallback, _):
                    return proof_kernel_expression_supported_depth_with_work(object, depth + 1, &work) and proof_kernel_expression_supported_depth_with_work(index, depth + 1, &work) and proof_kernel_expression_supported_depth_with_work(fallback, depth + 1, &work)
                # A statement-level `get collection[index] else recovery` has no value-shaped
                # fallback to encode. Its control recovery is checked by the AST proof pass;
                # this source-neutral term records only the guarded load boundary so replay can
                # validate that boundary independently.
                Ast::Expr.GetElse(Ast::Expr.Index(object, index, _), recovery, _):
                    return false if recovery.count == 0 or not proof_kernel_recovery_supported_with_work(recovery, depth + 1, &work)
                    return proof_kernel_expression_supported_depth_with_work(object, depth + 1, &work) and proof_kernel_expression_supported_depth_with_work(index, depth + 1, &work)
                Ast::Expr.Unary(operator, operand, _):
                    return proof_kernel_operator_supported(operator) and proof_kernel_expression_supported_depth_with_work(operand, depth + 1, &work)
                Ast::Expr.Binary(left, operator, right, _):
                    return proof_kernel_operator_supported(operator) and proof_kernel_expression_supported_depth_with_work(left, depth + 1, &work) and proof_kernel_expression_supported_depth_with_work(right, depth + 1, &work)
                Ast::Expr.If(condition, then_expression, else_expression, _):
                    return proof_kernel_expression_supported_depth_with_work(condition, depth + 1, &work) and proof_kernel_expression_supported_depth_with_work(then_expression, depth + 1, &work) and proof_kernel_expression_supported_depth_with_work(else_expression, depth + 1, &work)
                Ast::Expr.Move(operand, _):
                    return proof_kernel_expression_supported_depth_with_work(operand, depth + 1, &work)
                Ast::Expr.Call(callee, arguments, argument_names, _):
                    # The parser uses either an empty name vector for all-positional calls or a
                    # slot aligned with every argument. A partial vector would make the
                    # source-neutral call arena assign names to the wrong arguments.
                    return false if:
                        argument_names.count != 0 and argument_names.count != arguments.count
                        not proof_kernel_expression_supported_depth_with_work(callee, depth + 1, &work)
                    for argument in arguments |work|:
                        return false if not proof_kernel_ast_support_charge(1, &work)
                        return false if not proof_kernel_expression_supported_depth_with_work(argument, depth + 1, &work)
                    return true
                Ast::Expr.Field(object, field, _):
                    return field != "" and proof_kernel_expression_supported_depth_with_work(object, depth + 1, &work)
                Ast::Expr.Scope(base, field, _):
                    return field != "" and proof_kernel_expression_supported_depth_with_work(base, depth + 1, &work)
                Ast::Expr.Index(object, index, _):
                    return proof_kernel_expression_supported_depth_with_work(object, depth + 1, &work) and proof_kernel_expression_supported_depth_with_work(index, depth + 1, &work)
                Ast::Expr.Slice(object, low, high, _):
                    return proof_kernel_expression_supported_depth_with_work(object, depth + 1, &work) and proof_kernel_expression_supported_depth_with_work(low, depth + 1, &work) and proof_kernel_expression_supported_depth_with_work(high, depth + 1, &work)
                Ast::Expr.IndexN(object, arguments, _):
                    # Multi-argument indexing/generic application is a structural term here.
                    # It remains outside the memory-bound engine, but losing its argument list
                    # at the certificate boundary would make equal source terms indistinguishable.
                    return false if:
                        arguments.count == 0
                        not proof_kernel_expression_supported_depth_with_work(object, depth + 1, &work)
                    for argument in arguments |work|:
                        return false if not proof_kernel_ast_support_charge(1, &work)
                        return false if not proof_kernel_expression_supported_depth_with_work(argument, depth + 1, &work)
                    return true
                Ast::Expr.Array(elements, _):
                    for element in elements |work|:
                        return false if not proof_kernel_ast_support_charge(1, &work)
                        return false if not proof_kernel_expression_supported_depth_with_work(element, depth + 1, &work)
                    return true
                Ast::Expr.Tuple(elements, _):
                    for element in elements |work|:
                        return false if not proof_kernel_ast_support_charge(1, &work)
                        return false if not proof_kernel_expression_supported_depth_with_work(element, depth + 1, &work)
                    return true
                Ast::Expr.SetLit(elements, _):
                    for element in elements |work|:
                        return false if not proof_kernel_ast_support_charge(1, &work)
                        return false if not proof_kernel_expression_supported_depth_with_work(element, depth + 1, &work)
                    return true
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |work|:
                        return false if not proof_kernel_ast_support_charge(1, &work)
                        return false if not proof_kernel_expression_supported_depth_with_work(entry.key, depth + 1, &work) or not proof_kernel_expression_supported_depth_with_work(entry.value, depth + 1, &work)
                    return true
                Ast::Expr.Construct(type_expression, fields, _):
                    return false if not proof_kernel_expression_supported_depth_with_work(type_expression, depth + 1, &work)
                    for field in fields |work|:
                        return false if not proof_kernel_ast_support_charge(1, &work)
                        return false if:
                            field.name == ""
                            not proof_kernel_expression_supported_depth_with_work(field.value, depth + 1, &work)
                    return true
                Ast::Expr.RecordUpdate(base, fields, _):
                    return false if not proof_kernel_expression_supported_depth_with_work(base, depth + 1, &work)
                    for field in fields |work|:
                        return false if not proof_kernel_ast_support_charge(1, &work)
                        return false if:
                            field.name == ""
                            not proof_kernel_expression_supported_depth_with_work(field.value, depth + 1, &work)
                    return true
                Ast::Expr.Block(statements, value, captures, _):
                    return false if captures.count != 0 or statements.count == 0 or statements.count > ElisaProofKernelCore::PROOF_KERNEL_QUANTIFIER_MAX_STATEMENTS
                    return false if not proof_kernel_ast_support_charge(statements.count, &work)
                    match statements[0]:
                        Ast::Stmt.VarDecl(binder, type_expression, range_expression, _):
                            # Quantifier binders are names in a source-level binding
                            # environment, not anonymous metadata. Empty names cannot be
                            # substituted safely, and the two-binder dictionary form must not
                            # collapse both bindings onto one name.
                            return false if:
                                binder == ""
                                not proof_kernel_ast_support_charge(1, &work)
                                not proof_kernel_quantifier_integer_type(type_expression)
                                not proof_kernel_expression_supported_depth_with_work(range_expression, depth + 1, &work) or not proof_kernel_expression_supported_depth_with_work(value, depth + 1, &work)
                            if statements.count == ElisaProofKernelCore::PROOF_KERNEL_QUANTIFIER_MAX_STATEMENTS:
                                # The second binder is meaningful only for dictionary ranges;
                                # accepting it beside an array/range would encode a shape that
                                # the kernel replay dispatcher cannot interpret.
                                match range_expression:
                                    Ast::Expr.DictLit(_, _):
                                        pass
                                    _:
                                        return false
                                match statements[1]:
                                    # The second dictionary binder is synthetic: the parser
                                    # installs a literal zero because the binder has no runtime
                                    # initializer. The kernel erases that field, so accept only
                                    # this exact placeholder; otherwise an imported/transformed
                                    # AST could hide an effectful or semantically relevant term
                                    # in data that the certificate does not encode.
                                    Ast::Stmt.VarDecl(value_binder, value_type, Ast::Expr.IntLit(value, _), _):
                                        return false if:
                                            value_binder == "" or value_binder == binder
                                            not proof_kernel_ast_support_charge(1, &work)
                                            not proof_kernel_quantifier_integer_type(value_type)
                                            value != 0
                                    _:
                                        return false
                            else:
                                # A dictionary range always carries the key and value binders;
                                # a one-binder encoding would silently discard dictionary
                                # values during substitution.
                                match range_expression:
                                    Ast::Expr.DictLit(_, _):
                                        return false
                                    _:
                                        pass
                            return true
                        _:
                            return false
                _:
                    return false

    public:
        def proof_kernel_encode_annotated_depth(expression: Ast::Expr, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, depth: usize, annotations: darray[Ast::EnumAnnotation]&) -> usize:
            match_work: mutable usize = 0
            return proof_kernel_encode_annotated_depth_with_work(expression, nodes, children, depth, annotations, &match_work)

        def proof_kernel_encode_annotated_depth_with_work(expression: Ast::Expr, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, depth: usize, annotations: darray[Ast::EnumAnnotation]&, match_work: mutable usize&) -> usize:
            return nodes.count if not proof_match_lowering_charge(1, match_work)
            if not ElisaProofKernelCore::depth_valid(depth):
                return proof_kernel_add_node(nodes, "unsupported", "depth", 0, 0, 0, 0, 0, 0, "", "")
            match expression:
                Ast::Expr.IntLit(value, position):
                    literal = proof_replay_numeric_literal_sort(annotations, position.line, position.column, value)
                    if literal.known:
                        sort: sview = proof_numeric_literal_sort_name(literal.unsigned, literal.width)
                        return proof_kernel_add_node(nodes, "typed-int", "", 0, 0, 0, 0, 0, value, sort, "")
                    return proof_kernel_add_node(nodes, "int", "", 0, 0, 0, 0, 0, value, "", "")
                Ast::Expr.Absent:
                    return proof_kernel_add_node(nodes, "absent", "", 0, 0, 0, 0, 0, 0, "", "")
                Ast::Expr.BoolLit(value, _):
                    return proof_kernel_add_node(nodes, "bool", "", 0, 0, 0, 0, 0, 1 if value else 0, "", "")
                Ast::Expr.FloatLit(value, _):
                    # This leaf is only a structural token for an opaque comparison atom.
                    # It is deliberately distinct from the rejected numeric `float` term.
                    return proof_kernel_add_node(nodes, "opaque-float-literal", "", 0, 0, 0, 0, 0, 0, value, "")
                Ast::Expr.StringLit(value, _):
                    return proof_kernel_add_node(nodes, "string", "", 0, 0, 0, 0, 0, 0, value, "")
                Ast::Expr.CharLit(value, _):
                    return proof_kernel_add_node(nodes, "char", "", 0, 0, 0, 0, 0, 0, value, "")
                Ast::Expr.Ident(name, _):
                    return proof_kernel_add_node(nodes, "ident", "", 0, 0, 0, 0, 0, 0, name, "")
                Ast::Expr.ShorthandMember(parts, _):
                    return proof_kernel_add_node(nodes, "shorthand", "", 0, 0, 0, 0, 0, 0, parts[0], "") if parts.count == 1 and parts[0] != ""
                    return proof_kernel_add_node(nodes, "unsupported", "shorthand", 0, 0, 0, 0, 0, 0, "", "")
                Ast::Expr.Paren(inner, _):
                    return proof_kernel_encode_annotated_depth_with_work(inner, nodes, children, depth + 1, annotations, match_work)
                Ast::Expr.Unary(operator, operand, _):
                    return proof_kernel_add_node(nodes, "unsupported", "operator", 0, 0, 0, 0, 0, 0, "", "") if not proof_kernel_operator_supported(operator)
                    operand_index: usize = proof_kernel_encode_annotated_depth_with_work(operand, nodes, children, depth + 1, annotations, match_work)
                    return proof_kernel_add_node(nodes, "unary", proof_kernel_operator(operator), operand_index, 0, 0, 0, 0, 0, "", "")
                Ast::Expr.Binary(Ast::Expr.Index(object, index, _), TokenKind.Else, fallback, _):
                    object_index: usize = proof_kernel_encode_annotated_depth_with_work(object, nodes, children, depth + 1, annotations, match_work)
                    index_index: usize = proof_kernel_encode_annotated_depth_with_work(index, nodes, children, depth + 1, annotations, match_work)
                    index_node: usize = proof_kernel_add_node(nodes, "index", "", object_index, index_index, 0, 0, 0, 0, "", "")
                    fallback_index: usize = proof_kernel_encode_annotated_depth_with_work(fallback, nodes, children, depth + 1, annotations, match_work)
                    return proof_kernel_add_node(nodes, "checked-index", "", index_node, fallback_index, 0, 0, 0, 0, "", "")
                Ast::Expr.GetElse(Ast::Expr.Index(object, index, _), _, _):
                    object_index: usize = proof_kernel_encode_annotated_depth_with_work(object, nodes, children, depth + 1, annotations, match_work)
                    index_index: usize = proof_kernel_encode_annotated_depth_with_work(index, nodes, children, depth + 1, annotations, match_work)
                    index_node: usize = proof_kernel_add_node(nodes, "index", "", object_index, index_index, 0, 0, 0, 0, "", "")
                    return proof_kernel_add_node(nodes, "checked-get", "", index_node, 0, 0, 0, 0, 0, "", "")
                Ast::Expr.Binary(left, operator, right, _):
                    return proof_kernel_add_node(nodes, "unsupported", "operator", 0, 0, 0, 0, 0, 0, "", "") if not proof_kernel_operator_supported(operator)
                    left_index: usize = proof_kernel_encode_annotated_depth_with_work(left, nodes, children, depth + 1, annotations, match_work)
                    right_index: usize = proof_kernel_encode_annotated_depth_with_work(right, nodes, children, depth + 1, annotations, match_work)
                    return proof_kernel_add_node(nodes, "binary", proof_kernel_operator(operator), left_index, right_index, 0, 0, 0, 0, "", "")
                Ast::Expr.If(condition, then_expression, else_expression, _):
                    condition_index: usize = proof_kernel_encode_annotated_depth_with_work(condition, nodes, children, depth + 1, annotations, match_work)
                    then_index: usize = proof_kernel_encode_annotated_depth_with_work(then_expression, nodes, children, depth + 1, annotations, match_work)
                    else_index: usize = proof_kernel_encode_annotated_depth_with_work(else_expression, nodes, children, depth + 1, annotations, match_work)
                    return proof_kernel_add_node(nodes, "if", "", condition_index, then_index, else_index, 0, 0, 0, "", "")
                Ast::Expr.Match(_, _, _):
                    # Encode only the closed, value-producing match fragment. Its checked lowering
                    # preserves arm order, guards, and pattern tests as ordinary kernel terms;
                    # unsupported binders or non-value arms remain an explicit refusal.
                    lowered: (known: bool, value: Ast::Expr) = proof_lower_value_match_with_work(expression, match_work)
                    return proof_kernel_add_node(nodes, "unsupported", "match", 0, 0, 0, 0, 0, 0, "", "") if not lowered.known
                    return proof_kernel_encode_annotated_depth_with_work(lowered.value, nodes, children, depth + 1, annotations, match_work)
                Ast::Expr.Move(operand, _):
                    operand_index: usize = proof_kernel_encode_annotated_depth_with_work(operand, nodes, children, depth + 1, annotations, match_work)
                    return proof_kernel_add_node(nodes, "move", "", operand_index, 0, 0, 0, 0, 0, "", "")
                Ast::Expr.Call(callee, arguments, argument_names, _):
                    return proof_kernel_add_node(nodes, "unsupported", "call-arguments", 0, 0, 0, 0, 0, 0, "", "") if argument_names.count != 0 and argument_names.count != arguments.count
                    callee_index: usize = proof_kernel_encode_annotated_depth_with_work(callee, nodes, children, depth + 1, annotations, match_work)
                    # Nested argument terms may append their own tuple/array child edges to the
                    # shared arena. Stage the enclosing call-argument nodes separately so the
                    # call's child slice contains only `call_arg` roots, regardless of how many
                    # child edges an argument term owns.
                    argument_roots: mutable darray[usize] = []
                    for index in 0..<arguments.count |index, arguments, argument_names, nodes, children, depth, annotations, match_work|:
                        argument_index: usize = proof_kernel_encode_annotated_depth_with_work(arguments[index], nodes, children, depth + 1, annotations, match_work)
                        argument_name: sview = argument_names[index] if index < argument_names.count else ""
                        argument_roots.push(proof_kernel_add_node(nodes, "call_arg", "", argument_index, 0, 0, 0, 0, 0, argument_name, ""))
                    argument_start: usize = children.count
                    children.extend(argument_roots)
                    return proof_kernel_add_node(nodes, "call", "", callee_index, 0, argument_names.count, argument_start, arguments.count, 0, "", "")
                Ast::Expr.Field(object, field, _):
                    object_index: usize = proof_kernel_encode_annotated_depth_with_work(object, nodes, children, depth + 1, annotations, match_work)
                    return proof_kernel_add_node(nodes, "field", "", object_index, 0, 0, 0, 0, 0, field, "")
                Ast::Expr.Scope(base, field, _):
                    base_index: usize = proof_kernel_encode_annotated_depth_with_work(base, nodes, children, depth + 1, annotations, match_work)
                    return proof_kernel_add_node(nodes, "scope", "", base_index, 0, 0, 0, 0, 0, field, "")
                Ast::Expr.Index(object, index, _):
                    object_index: usize = proof_kernel_encode_annotated_depth_with_work(object, nodes, children, depth + 1, annotations, match_work)
                    index_index: usize = proof_kernel_encode_annotated_depth_with_work(index, nodes, children, depth + 1, annotations, match_work)
                    return proof_kernel_add_node(nodes, "index", "", object_index, index_index, 0, 0, 0, 0, "", "")
                Ast::Expr.Slice(object, low, high, _):
                    object_index: usize = proof_kernel_encode_annotated_depth_with_work(object, nodes, children, depth + 1, annotations, match_work)
                    low_index: usize = proof_kernel_encode_annotated_depth_with_work(low, nodes, children, depth + 1, annotations, match_work)
                    high_index: usize = proof_kernel_encode_annotated_depth_with_work(high, nodes, children, depth + 1, annotations, match_work)
                    return proof_kernel_add_node(nodes, "slice", "", object_index, low_index, high_index, 0, 0, 0, "", "")
                Ast::Expr.IndexN(object, arguments, _):
                    object_index: usize = proof_kernel_encode_annotated_depth_with_work(object, nodes, children, depth + 1, annotations, match_work)
                    argument_roots: mutable darray[usize] = []
                    for argument in arguments |argument, nodes, children, depth, argument_roots, annotations, match_work|:
                        argument_roots.push(proof_kernel_encode_annotated_depth_with_work(argument, nodes, children, depth + 1, annotations, match_work))
                    start: usize = children.count
                    children.extend(argument_roots)
                    return proof_kernel_add_node(nodes, "index-n", "", object_index, 0, 0, start, arguments.count, 0, "", "") if arguments.count > 0
                    return proof_kernel_add_node(nodes, "unsupported", "index-n", 0, 0, 0, 0, 0, 0, "", "")
                Ast::Expr.Array(elements, _):
                    element_roots: mutable darray[usize] = []
                    for element in elements |element, nodes, children, depth, element_roots, annotations, match_work|:
                        element_roots.push(proof_kernel_encode_annotated_depth_with_work(element, nodes, children, depth + 1, annotations, match_work))
                    start: usize = children.count
                    children.extend(element_roots)
                    return proof_kernel_add_node(nodes, "array", "", 0, 0, 0, start, elements.count, 0, "", "")
                Ast::Expr.Tuple(elements, _):
                    element_roots: mutable darray[usize] = []
                    for element in elements |element, nodes, children, depth, element_roots, annotations, match_work|:
                        element_roots.push(proof_kernel_encode_annotated_depth_with_work(element, nodes, children, depth + 1, annotations, match_work))
                    start: usize = children.count
                    children.extend(element_roots)
                    return proof_kernel_add_node(nodes, "tuple", "", 0, 0, 0, start, elements.count, 0, "", "")
                Ast::Expr.SetLit(elements, _):
                    element_roots: mutable darray[usize] = []
                    for element in elements |element, nodes, children, depth, element_roots, annotations, match_work|:
                        element_roots.push(proof_kernel_encode_annotated_depth_with_work(element, nodes, children, depth + 1, annotations, match_work))
                    start: usize = children.count
                    children.extend(element_roots)
                    return proof_kernel_add_node(nodes, "set", "", 0, 0, 0, start, elements.count, 0, "", "")
                Ast::Expr.DictLit(entries, _):
                    entry_roots: mutable darray[usize] = []
                    for entry in entries |entry, nodes, children, depth, entry_roots, annotations, match_work|:
                        key_index: usize = proof_kernel_encode_annotated_depth_with_work(entry.key, nodes, children, depth + 1, annotations, match_work)
                        value_index: usize = proof_kernel_encode_annotated_depth_with_work(entry.value, nodes, children, depth + 1, annotations, match_work)
                        entry_index: usize = proof_kernel_add_node(nodes, "dict_entry", "", key_index, value_index, 0, 0, 0, 0, "", "")
                        entry_roots.push(entry_index)
                    start: usize = children.count
                    children.extend(entry_roots)
                    return proof_kernel_add_node(nodes, "dict", "", 0, 0, 0, start, entries.count, 0, "", "")
                Ast::Expr.Construct(type_expression, fields, _):
                    type_index: usize = proof_kernel_encode_annotated_depth_with_work(type_expression, nodes, children, depth + 1, annotations, match_work)
                    field_roots: mutable darray[usize] = []
                    for field in fields |field, nodes, children, depth, field_roots, annotations, match_work|:
                        value_index: usize = proof_kernel_encode_annotated_depth_with_work(field.value, nodes, children, depth + 1, annotations, match_work)
                        field_roots.push(proof_kernel_add_node(nodes, "field-init", "", value_index, 0, 0, 0, 0, 0, field.name, ""))
                    start: usize = children.count
                    children.extend(field_roots)
                    return proof_kernel_add_node(nodes, "construct", "", type_index, 0, 0, start, fields.count, 0, "", "")
                Ast::Expr.RecordUpdate(base, fields, _):
                    base_index: usize = proof_kernel_encode_annotated_depth_with_work(base, nodes, children, depth + 1, annotations, match_work)
                    field_roots: mutable darray[usize] = []
                    for field in fields |field, nodes, children, depth, field_roots, annotations, match_work|:
                        value_index: usize = proof_kernel_encode_annotated_depth_with_work(field.value, nodes, children, depth + 1, annotations, match_work)
                        field_roots.push(proof_kernel_add_node(nodes, "field-init", "", value_index, 0, 0, 0, 0, 0, field.name, ""))
                    start: usize = children.count
                    children.extend(field_roots)
                    return proof_kernel_add_node(nodes, "record-update", "", base_index, 0, 0, start, fields.count, 0, "", "")
                Ast::Expr.Block(statements, value, _, _):
                    # Quantifier blocks are the only block form accepted by the replay kernel.
                    # Preserve the source kind at every nesting level, including hypotheses.
                    return proof_kernel_add_node(nodes, "unsupported", "block", 0, 0, 0, 0, 0, 0, "", "") if statements.count == 0 or statements.count > ElisaProofKernelCore::PROOF_KERNEL_QUANTIFIER_MAX_STATEMENTS
                    match statements[0]:
                        Ast::Stmt.VarDecl(binder, type_expression, range_expression, _):
                            return proof_kernel_add_node(nodes, "unsupported", "block", 0, 0, 0, 0, 0, 0, "", "") if binder == "" or not proof_kernel_quantifier_integer_type(type_expression)
                            if statements.count == ElisaProofKernelCore::PROOF_KERNEL_QUANTIFIER_MAX_STATEMENTS:
                                match range_expression:
                                    Ast::Expr.DictLit(_, _):
                                        pass
                                    _:
                                        return proof_kernel_add_node(nodes, "unsupported", "block", 0, 0, 0, 0, 0, 0, "", "")
                            else:
                                match range_expression:
                                    Ast::Expr.DictLit(_, _):
                                        return proof_kernel_add_node(nodes, "unsupported", "block", 0, 0, 0, 0, 0, 0, "", "")
                                    _:
                                        pass
                            range_index: usize = proof_kernel_encode_annotated_depth_with_work(range_expression, nodes, children, depth + 1, annotations, match_work)
                            body_index: usize = proof_kernel_encode_annotated_depth_with_work(value, nodes, children, depth + 1, annotations, match_work)
                            secondary: mutable sview = ""
                            if statements.count == ElisaProofKernelCore::PROOF_KERNEL_QUANTIFIER_MAX_STATEMENTS:
                                match statements[1]:
                                    # Keep this in lockstep with the support predicate above:
                                    # the erased dictionary value binder must carry the parser's
                                    # exact zero placeholder, never an unencoded expression.
                                    Ast::Stmt.VarDecl(value_binder, value_type, Ast::Expr.IntLit(value, _), _):
                                        return proof_kernel_add_node(nodes, "unsupported", "block", 0, 0, 0, 0, 0, 0, "", "") if:
                                            value_binder == "" or value_binder == binder
                                            not proof_kernel_quantifier_integer_type(value_type)
                                            value != 0
                                        secondary <- value_binder
                                    _:
                                        return proof_kernel_add_node(nodes, "unsupported", "block", 0, 0, 0, 0, 0, 0, "", "")
                            return proof_kernel_add_node(nodes, "quantifier", proof_quantifier_kind(expression, annotations), range_index, body_index, statements.count, 0, 0, 0, binder, secondary)
                        _:
                            return proof_kernel_add_node(nodes, "unsupported", "block", 0, 0, 0, 0, 0, 0, "", "")
                _:
                    return proof_kernel_add_node(nodes, "unsupported", "", 0, 0, 0, 0, 0, 0, "", "")
        def proof_kernel_encode_expression(expression: Ast::Expr, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&) -> usize:
            annotations: darray[Ast::EnumAnnotation] = []
            return proof_kernel_encode_annotated_depth(expression, nodes, children, 0, annotations)

        def proof_kernel_encode_annotated(expression: Ast::Expr, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, annotations: darray[Ast::EnumAnnotation]&) -> usize:
            return proof_kernel_encode_annotated_depth(expression, nodes, children, 0, annotations)
