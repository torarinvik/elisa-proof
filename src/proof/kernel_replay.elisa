# Independent source-neutral kernel facade. The implementation is private and the explicit public
# API is kept in one module so standalone adversarial harnesses depend only on stable entry points.
# The replay core is ordered by the kernel language it implements: terms, bounds, facts,
# quantifiers, tactic transitions, congruence, arithmetic, and resource certificates.
include "./kernel_replay/term_arithmetic.elisa"
include "./kernel_replay/unsigned_bounds.elisa"
include "./kernel_replay/difference_constraints.elisa"
include "./kernel_replay/fact_model.elisa"
include "./kernel_replay/arena_shapes.elisa"
include "./kernel_replay/quantifiers_and_arena.elisa"
include "./kernel_replay/tactic_replay.elisa"
include "./kernel_replay/congruence.elisa"
include "./kernel_replay/order_and_sign.elisa"
include "./kernel_replay/resource_model.elisa"
include "./kernel_replay/resource_state.elisa"
include "./kernel_replay/resource_events.elisa"
include "./kernel_replay/reporters.elisa"
include "./kernel_replay/api.elisa"
