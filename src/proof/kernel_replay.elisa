# Independent replay over ElisaProofKernelCore::ProofKernelNode, not over compiler AST nodes.
#
# This is intentionally a small proof kernel. It rechecks the deterministic arithmetic,
# interval, difference-constraint, propositional, equality, and bounded-quantifier fragment
# emitted by the current certificate producer. The compiler AST replay remains in replay.elisa
# as a diagnostic/reference implementation, but successful certificates are accepted only when
# this source-neutral kernel also validates them.
module ElisaProofKernelReplay:
    private:
        struct ProofKernelReplayInt:
            known: bool
            value: i64

        struct ProofKernelReplayBool:
            known: bool
            value: bool

        struct ProofKernelReplayBound:
            name: sview
            lower: mutable i64
            upper: mutable i64
            has_lower: mutable bool
            has_upper: mutable bool

        struct ProofKernelReplayAffine:
            known: bool
            base: sview
            offset: i64
            negative: bool

        struct ProofKernelReplayDifference:
            left: sview
            right: sview
            bound: i64

        # Arena admission uses an explicit DFS work item rather than the host call stack. The
        # depth is still part of the certificate invariant, so iterative traversal does not turn
        # an unbounded serialized graph into an accepted term merely because it avoids recursion.
        struct ProofKernelReplayArenaWork:
            root: usize
            depth: usize
            exiting: bool

        def proof_kernel_replay_i64_max() -> i64:
            return 9223372036854775807

        def proof_kernel_replay_i64_min() -> i64:
            return 0 - 9223372036854775807 - 1

        def proof_kernel_replay_add_safe(left: i64, right: i64) -> ProofKernelReplayInt:
            return ProofKernelReplayInt{known: false, value: 0} if right > 0 and left > proof_kernel_replay_i64_max() - right
            return ProofKernelReplayInt{known: false, value: 0} if right < 0 and left < proof_kernel_replay_i64_min() - right
            return ProofKernelReplayInt{known: true, value: left + right}

        def proof_kernel_replay_sub_safe(left: i64, right: i64) -> ProofKernelReplayInt:
            return ProofKernelReplayInt{known: false, value: 0} if right > 0 and left < proof_kernel_replay_i64_min() + right
            return ProofKernelReplayInt{known: false, value: 0} if right < 0 and left > proof_kernel_replay_i64_max() + right
            return ProofKernelReplayInt{known: true, value: left - right}

        def proof_kernel_replay_mul_safe(left: i64, right: i64) -> ProofKernelReplayInt:
            return ProofKernelReplayInt{known: true, value: 0} if left == 0 or right == 0
            return ProofKernelReplayInt{known: true, value: right} if left == 1
            return ProofKernelReplayInt{known: true, value: left} if right == 1
            if left == -1:
                return ProofKernelReplayInt{known: false, value: 0} if right == proof_kernel_replay_i64_min()
                return ProofKernelReplayInt{known: true, value: 0 - right}
            if right == -1:
                return ProofKernelReplayInt{known: false, value: 0} if left == proof_kernel_replay_i64_min()
                return ProofKernelReplayInt{known: true, value: 0 - left}
            if left > 0:
                return ProofKernelReplayInt{known: false, value: 0} if right > 0 and left > proof_kernel_replay_i64_max() / right
                return ProofKernelReplayInt{known: false, value: 0} if right < 0 and right < proof_kernel_replay_i64_min() / left
            else:
                return ProofKernelReplayInt{known: false, value: 0} if right > 0 and left < proof_kernel_replay_i64_min() / right
                return ProofKernelReplayInt{known: false, value: 0} if right < 0 and left < proof_kernel_replay_i64_max() / right
            return ProofKernelReplayInt{known: true, value: left * right}

        def proof_kernel_replay_div_safe(left: i64, right: i64) -> ProofKernelReplayInt:
            return ProofKernelReplayInt{known: false, value: 0} if right == 0 or (left == proof_kernel_replay_i64_min() and right == -1)
            return ProofKernelReplayInt{known: true, value: left / right}

        def proof_kernel_replay_mod_safe(left: i64, right: i64) -> ProofKernelReplayInt:
            return ProofKernelReplayInt{known: false, value: 0} if right == 0 or (left == proof_kernel_replay_i64_min() and right == -1)
            return ProofKernelReplayInt{known: true, value: left % right}

        def proof_kernel_replay_shift_safe(value: i64, amount: i64, left: bool) -> ProofKernelReplayInt:
            return ProofKernelReplayInt{known: false, value: 0} if amount < 0 or amount > 63
            return ProofKernelReplayInt{known: true, value: value << amount} if left
            return ProofKernelReplayInt{known: true, value: value >> amount}

        def proof_kernel_replay_valid(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize) -> bool:
            ensure result == (root < nodes.count)
            return ElisaProofKernelCore::root_valid(nodes.count, root)

        # A bounded lookup keeps the replay implementation honest about serialized arena
        # indices. The loop index is intrinsically in range, while the requested index may be
        # hostile input. Callers must check `known` before consuming the returned node.
        def proof_kernel_replay_node_at(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize) -> (known: bool, node: ElisaProofKernelCore::ProofKernelNode):
            empty: ElisaProofKernelCore::ProofKernelNode = ElisaProofKernelCore::ProofKernelNode{kind: "", operator: "", left: 0, right: 0, auxiliary: 0, children_start: 0, children_count: 0, value: 0, name: "", secondary_name: ""}
            return (false, empty) if root >= nodes.count
            assert root < nodes.count
            return (true, nodes[root])

        def proof_kernel_replay_bool_at(values: darray[bool]&, requested: usize) -> (known: bool, value: bool):
            return (false, false) if requested >= values.count
            assert requested < values.count
            return (true, values[requested])

        def proof_kernel_replay_bool_set(values: mutable darray[bool]&, requested: usize, value: bool) -> bool:
            return false if requested >= values.count
            assert requested < values.count
            values[requested] <- value
            return true

        def proof_kernel_replay_child_at(children: darray[usize]&, requested: usize) -> (known: bool, value: usize):
            return (false, 0) if requested >= children.count
            assert requested < children.count
            return (true, children[requested])

        # Keep the hostile serialized-slice check free of a precondition. The compiler core's
        # range_valid predicate is intentionally specified with a precondition for ordinary
        # callers; replay admission instead needs a total predicate that can inspect malformed
        # starts and counts before invoking any indexed operation.
        def proof_kernel_replay_child_range_valid(start: usize, count: usize, total: usize) -> bool:
            return false if start > total
            return false if count > total - start
            return true

        def proof_kernel_replay_constant_int(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, depth: usize) -> ProofKernelReplayInt:
            requires depth <= 127
            decreases 127 - depth
            empty: ProofKernelReplayInt = ProofKernelReplayInt{known: false, value: 0}
            return empty if not ElisaProofKernelCore::depth_valid(depth)
            return empty if depth > 127
            return empty if root >= nodes.count
            return empty if not proof_kernel_replay_valid(nodes, root)
            located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, root)
            return empty if not located.known
            node: ElisaProofKernelCore::ProofKernelNode = located.node
            return ProofKernelReplayInt{known: true, value: node.value} if node.kind == "int"
            if node.kind == "unary" and depth < 127:
                assert depth + 1 <= 127
                inner: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, node.left, depth + 1)
                return ProofKernelReplayInt{known: false, value: 0} if not inner.known
                return inner if node.operator == "+"
                if node.operator == "-":
                    return ProofKernelReplayInt{known: false, value: 0} if inner.value == proof_kernel_replay_i64_min()
                    return ProofKernelReplayInt{known: true, value: 0 - inner.value}
            if node.kind == "binary" and depth < 127:
                assert depth + 1 <= 127
                left: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, node.left, depth + 1)
                right: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, node.right, depth + 1)
                return ProofKernelReplayInt{known: false, value: 0} if not left.known or not right.known
                return proof_kernel_replay_add_safe(left.value, right.value) if node.operator == "+"
                return proof_kernel_replay_sub_safe(left.value, right.value) if node.operator == "-"
                return proof_kernel_replay_mul_safe(left.value, right.value) if node.operator == "*"
                return proof_kernel_replay_div_safe(left.value, right.value) if node.operator == "/"
                return proof_kernel_replay_mod_safe(left.value, right.value) if node.operator == "%"
                return ProofKernelReplayInt{known: true, value: left.value & right.value} if node.operator == "&"
                return ProofKernelReplayInt{known: true, value: left.value | right.value} if node.operator == "|"
                return ProofKernelReplayInt{known: true, value: left.value ^ right.value} if node.operator == "^"
                return proof_kernel_replay_shift_safe(left.value, right.value, true) if node.operator == "<<"
                return proof_kernel_replay_shift_safe(left.value, right.value, false) if node.operator == ">>"
            return ProofKernelReplayInt{known: false, value: 0}

        def proof_kernel_replay_constant_comparison(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, left_root: usize, operator: sview, right_root: usize) -> bool:
            left: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, left_root, 0)
            right: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, right_root, 0)
            return false if not left.known or not right.known
            return left.value == right.value if operator == "=="
            return left.value != right.value if operator == "!="
            return left.value < right.value if operator == "<"
            return left.value > right.value if operator == ">"
            return left.value <= right.value if operator == "<="
            return left.value >= right.value if operator == ">="
            return false

        def proof_kernel_replay_ident_name(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize) -> sview:
            return "" if root >= nodes.count
            return "" if not proof_kernel_replay_valid(nodes, root)
            located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, root)
            return "" if not located.known
            node: ElisaProofKernelCore::ProofKernelNode = located.node
            return node.name if node.kind == "ident" else ""

        def proof_kernel_replay_bound_index(bounds: darray[ProofKernelReplayBound]&, name: sview) -> usize:
            for index in 0..<bounds.count:
                if bounds[index].name == name:
                    return index
            return bounds.count

        def proof_kernel_replay_bound_for(bounds: darray[ProofKernelReplayBound]&, name: sview) -> ProofKernelReplayBound:
            for index in 0..<bounds.count:
                if bounds[index].name == name:
                    return bounds[index]
            return ProofKernelReplayBound{name: name, has_lower: false, lower: 0, has_upper: false, upper: 0}

        def proof_kernel_replay_add_lower(bounds: mutable darray[ProofKernelReplayBound]&, name: sview, value: i64) -> void:
            return if name == ""
            for mutable bound in bounds:
                if bound.name == name:
                    old_has: bool = bound.has_lower
                    old_value: i64 = bound.lower
                    bound.has_lower <- true
                    bound.lower <- value if not old_has or value > old_value
                    return
            bounds <- bounds.push(ProofKernelReplayBound{name: name, has_lower: true, lower: value, has_upper: false, upper: 0})

        def proof_kernel_replay_add_upper(bounds: mutable darray[ProofKernelReplayBound]&, name: sview, value: i64) -> void:
            return if name == ""
            for mutable bound in bounds:
                if bound.name == name:
                    old_has: bool = bound.has_upper
                    old_value: i64 = bound.upper
                    bound.has_upper <- true
                    bound.upper <- value if not old_has or value < old_value
                    return
            bounds <- bounds.push(ProofKernelReplayBound{name: name, has_lower: false, lower: 0, has_upper: true, upper: value})

        def proof_kernel_replay_collect_bound_comparison(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, left_root: usize, operator: sview, right_root: usize, bounds: mutable darray[ProofKernelReplayBound]&) -> void:
            left_name: sview = proof_kernel_replay_ident_name(nodes, left_root)
            right_name: sview = proof_kernel_replay_ident_name(nodes, right_root)
            left_constant: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, left_root, 0)
            right_constant: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, right_root, 0)
            if left_name != "" and right_constant.known:
                incremented: ProofKernelReplayInt = proof_kernel_replay_add_safe(right_constant.value, 1)
                proof_kernel_replay_add_lower(bounds, left_name, incremented.value) if operator == ">" and incremented.known
                proof_kernel_replay_add_lower(bounds, left_name, right_constant.value) if operator == ">=" or operator == "=="
                decremented: ProofKernelReplayInt = proof_kernel_replay_sub_safe(right_constant.value, 1)
                proof_kernel_replay_add_upper(bounds, left_name, decremented.value) if operator == "<" and decremented.known
                proof_kernel_replay_add_upper(bounds, left_name, right_constant.value) if operator == "<=" or operator == "=="
            if right_name != "" and left_constant.known:
                decremented_left: ProofKernelReplayInt = proof_kernel_replay_sub_safe(left_constant.value, 1)
                proof_kernel_replay_add_upper(bounds, right_name, decremented_left.value) if operator == ">" and decremented_left.known
                proof_kernel_replay_add_upper(bounds, right_name, left_constant.value) if operator == ">=" or operator == "=="
                incremented_left: ProofKernelReplayInt = proof_kernel_replay_add_safe(left_constant.value, 1)
                proof_kernel_replay_add_lower(bounds, right_name, incremented_left.value) if operator == "<" and incremented_left.known
                proof_kernel_replay_add_lower(bounds, right_name, left_constant.value) if operator == "<=" or operator == "=="

        def proof_kernel_replay_collect_bounds(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, bounds: mutable darray[ProofKernelReplayBound]&, depth: usize) -> void:
            requires depth <= 127
            decreases 127 - depth
            return if not ElisaProofKernelCore::depth_valid(depth)
            return if depth >= 127
            return if root >= nodes.count
            return if not proof_kernel_replay_valid(nodes, root)
            located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, root)
            return if not located.known
            node: ElisaProofKernelCore::ProofKernelNode = located.node
            if node.kind == "unary" and node.operator == "not" and proof_kernel_replay_valid(nodes, node.left):
                inner_located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, node.left)
                return if not inner_located.known
                inner: ElisaProofKernelCore::ProofKernelNode = inner_located.node
                if inner.kind == "binary":
                    negated: sview = proof_kernel_replay_negation(inner.operator)
                    proof_kernel_replay_collect_bound_comparison(nodes, inner.left, negated, inner.right, bounds) if negated != ""
                return
            if node.kind != "binary":
                return
            if node.operator == "and":
                proof_kernel_replay_collect_bounds(nodes, node.left, bounds, depth + 1)
                proof_kernel_replay_collect_bounds(nodes, node.right, bounds, depth + 1)
                return
            proof_kernel_replay_collect_bound_comparison(nodes, node.left, node.operator, node.right, bounds)

        def proof_kernel_replay_collect_name_equalities(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, left_names: mutable darray[sview]&, right_names: mutable darray[sview]&, depth: usize) -> void:
            requires depth <= 127
            decreases 127 - depth
            return if not ElisaProofKernelCore::depth_valid(depth)
            return if depth >= 127
            return if root >= nodes.count
            return if not proof_kernel_replay_valid(nodes, root)
            located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, root)
            return if not located.known
            node: ElisaProofKernelCore::ProofKernelNode = located.node
            if node.kind == "binary" and node.operator == "and":
                proof_kernel_replay_collect_name_equalities(nodes, node.left, left_names, right_names, depth + 1)
                proof_kernel_replay_collect_name_equalities(nodes, node.right, left_names, right_names, depth + 1)
                return
            if node.kind == "binary" and node.operator == "==":
                left: sview = proof_kernel_replay_ident_name(nodes, node.left)
                right: sview = proof_kernel_replay_ident_name(nodes, node.right)
                if left != "" and right != "":
                    left_names.push(left)
                    right_names.push(right)

        def proof_kernel_replay_close_equalities(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, facts: darray[usize], bounds: mutable darray[ProofKernelReplayBound]&) -> void:
            left_names: mutable darray[sview] = []
            right_names: mutable darray[sview] = []
            for fact in facts |fact, nodes, left_names, right_names|:
                proof_kernel_replay_collect_name_equalities(nodes, fact, &left_names, &right_names, 0)
            rounds: mutable usize = 0
            max_rounds: usize = facts.count * 2 + 2
            while rounds < max_rounds |rounds, left_names, right_names, bounds|:
                for index in 0..<left_names.count |index, left_names, right_names, bounds|:
                    left_bound: ProofKernelReplayBound = proof_kernel_replay_bound_for(bounds, left_names[index])
                    right_bound: ProofKernelReplayBound = proof_kernel_replay_bound_for(bounds, right_names[index])
                    proof_kernel_replay_add_lower(bounds, right_names[index], left_bound.lower) if left_bound.has_lower
                    proof_kernel_replay_add_upper(bounds, right_names[index], left_bound.upper) if left_bound.has_upper
                    proof_kernel_replay_add_lower(bounds, left_names[index], right_bound.lower) if right_bound.has_lower
                    proof_kernel_replay_add_upper(bounds, left_names[index], right_bound.upper) if right_bound.has_upper
                rounds <- rounds + 1

        def proof_kernel_replay_names_equal(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, left_name: sview, right_name: sview, facts: darray[usize]) -> bool:
            return false if left_name == "" or right_name == ""
            return true if left_name == right_name
            left_names: mutable darray[sview] = []
            right_names: mutable darray[sview] = []
            for fact in facts |fact, nodes, left_names, right_names|:
                proof_kernel_replay_collect_name_equalities(nodes, fact, &left_names, &right_names, 0)
            reachable: mutable darray[sview] = [left_name]
            cursor: mutable usize = 0
            while cursor < reachable.count |cursor, reachable, left_names, right_names, right_name|:
                current: sview = reachable[cursor]
                for index in 0..<left_names.count |index, left_names, right_names, reachable, current, right_name|:
                    next_name: mutable sview = ""
                    next_name <- right_names[index] if left_names[index] == current
                    next_name <- left_names[index] if right_names[index] == current
                    if next_name != "":
                        return true if next_name == right_name
                        reachable.push(next_name) if not any existing in reachable where existing == next_name
                cursor <- cursor + 1
            return false

        def proof_kernel_replay_affine_expression(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, depth: usize) -> ProofKernelReplayAffine:
            requires depth <= 127
            decreases 127 - depth
            empty: ProofKernelReplayAffine = ProofKernelReplayAffine{known: false, base: "", offset: 0, negative: false}
            return empty if not ElisaProofKernelCore::depth_valid(depth)
            return empty if depth >= 127
            return empty if root >= nodes.count
            constant: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, root, depth + 1)
            return ProofKernelReplayAffine{known: true, base: "", offset: constant.value, negative: false} if constant.known
            return empty if not proof_kernel_replay_valid(nodes, root)
            located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, root)
            return empty if not located.known
            node: ElisaProofKernelCore::ProofKernelNode = located.node
            return ProofKernelReplayAffine{known: true, base: node.name, offset: 0, negative: false} if node.kind == "ident" and node.name != ""
            return proof_kernel_replay_affine_expression(nodes, node.left, depth + 1) if node.kind == "unary" and node.operator == "+"
            if node.kind == "binary":
                left: ProofKernelReplayAffine = proof_kernel_replay_affine_expression(nodes, node.left, depth + 1)
                right_constant: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, node.right, depth + 1)
                if left.known and left.base != "" and right_constant.known:
                    if node.operator == "+":
                        combined: ProofKernelReplayInt = proof_kernel_replay_add_safe(left.offset, right_constant.value)
                        return ProofKernelReplayAffine{known: true, base: left.base, offset: combined.value, negative: left.negative} if combined.known
                    if node.operator == "-":
                        negated: ProofKernelReplayInt = proof_kernel_replay_sub_safe(0, right_constant.value)
                        return empty if not negated.known
                        combined: ProofKernelReplayInt = proof_kernel_replay_add_safe(left.offset, negated.value)
                        return ProofKernelReplayAffine{known: true, base: left.base, offset: combined.value, negative: left.negative} if combined.known
                left_constant: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, node.left, depth + 1)
                right_affine: ProofKernelReplayAffine = proof_kernel_replay_affine_expression(nodes, node.right, depth + 1)
                if left_constant.known and right_affine.known and right_affine.base != "" and node.operator == "+":
                    combined: ProofKernelReplayInt = proof_kernel_replay_add_safe(left_constant.value, right_affine.offset)
                    return ProofKernelReplayAffine{known: true, base: right_affine.base, offset: combined.value, negative: right_affine.negative} if combined.known
                if left_constant.known and right_affine.known and right_affine.base != "" and node.operator == "-":
                    combined: ProofKernelReplayInt = proof_kernel_replay_sub_safe(left_constant.value, right_affine.offset) if not right_affine.negative else proof_kernel_replay_add_safe(left_constant.value, right_affine.offset)
                    return ProofKernelReplayAffine{known: true, base: right_affine.base, offset: combined.value, negative: not right_affine.negative} if combined.known
            return empty

        def proof_kernel_replay_affine_safe(affine: ProofKernelReplayAffine, bounds: darray[ProofKernelReplayBound]&) -> bool:
            return false if not affine.known
            return true if affine.base == ""
            return true if not affine.negative and affine.offset == 0
            bound: ProofKernelReplayBound = proof_kernel_replay_bound_for(bounds, affine.base)
            if affine.negative:
                return false if not bound.has_lower or not bound.has_upper
                negated_upper: ProofKernelReplayInt = proof_kernel_replay_sub_safe(0, bound.upper)
                negated_lower: ProofKernelReplayInt = proof_kernel_replay_sub_safe(0, bound.lower)
                return false if not negated_upper.known or not negated_lower.known
                lower: ProofKernelReplayInt = proof_kernel_replay_add_safe(negated_upper.value, affine.offset)
                upper: ProofKernelReplayInt = proof_kernel_replay_add_safe(negated_lower.value, affine.offset)
                return lower.known and upper.known
            if affine.offset > 0:
                limit: ProofKernelReplayInt = proof_kernel_replay_sub_safe(proof_kernel_replay_i64_max(), affine.offset)
                return limit.known and bound.has_upper and bound.upper <= limit.value
            limit: ProofKernelReplayInt = proof_kernel_replay_sub_safe(proof_kernel_replay_i64_min(), affine.offset)
            return limit.known and bound.has_lower and bound.lower >= limit.value

        def proof_kernel_replay_affine_comparison(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, left_root: usize, operator: sview, right_root: usize, facts: darray[usize]) -> bool:
            left: ProofKernelReplayAffine = proof_kernel_replay_affine_expression(nodes, left_root, 0)
            right: ProofKernelReplayAffine = proof_kernel_replay_affine_expression(nodes, right_root, 0)
            return false if not left.known or not right.known
            return false if left.base == "" or right.base == ""
            return false if left.base != right.base and not proof_kernel_replay_names_equal(nodes, left.base, right.base, facts)
            return false if left.negative != right.negative
            bounds: mutable darray[ProofKernelReplayBound] = []
            for fact in facts |fact, nodes, bounds|:
                proof_kernel_replay_collect_bounds(nodes, fact, &bounds, 0)
            proof_kernel_replay_close_equalities(nodes, facts, &bounds)
            return false if not proof_kernel_replay_affine_safe(left, bounds) or not proof_kernel_replay_affine_safe(right, bounds)
            difference: ProofKernelReplayInt = proof_kernel_replay_sub_safe(left.offset, right.offset)
            return false if not difference.known
            return difference.value > 0 if operator == ">"
            return difference.value >= 0 if operator == ">="
            return difference.value < 0 if operator == "<"
            return difference.value <= 0 if operator == "<="
            return difference.value != 0 if operator == "!="
            return difference.value == 0 if operator == "=="
            return false

        def proof_kernel_replay_interval(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, bounds: darray[ProofKernelReplayBound]&, depth: usize) -> (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool):
            requires depth <= 127
            decreases 127 - depth
            return (false, 0, 0, false, false) if not ElisaProofKernelCore::depth_valid(depth) or depth >= 127
            return (false, 0, 0, false, false) if root >= nodes.count
            constant: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, root, depth + 1)
            return (true, constant.value, constant.value, true, true) if constant.known
            return (false, 0, 0, false, false) if not proof_kernel_replay_valid(nodes, root)
            located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, root)
            return (false, 0, 0, false, false) if not located.known
            node: ElisaProofKernelCore::ProofKernelNode = located.node
            if node.kind == "ident":
                bound: ProofKernelReplayBound = proof_kernel_replay_bound_for(bounds, node.name)
                return (bound.has_lower and bound.has_upper, bound.lower, bound.upper, bound.has_lower, bound.has_upper)
            if node.kind == "unary" and node.operator == "-":
                inner: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval(nodes, node.left, bounds, depth + 1)
                negated_lower: ProofKernelReplayInt = proof_kernel_replay_sub_safe(0, inner.upper)
                negated_upper: ProofKernelReplayInt = proof_kernel_replay_sub_safe(0, inner.lower)
                return (false, 0, 0, false, false) if not negated_lower.known or not negated_upper.known
                return (inner.has_lower and inner.has_upper, negated_lower.value, negated_upper.value, inner.has_upper, inner.has_lower)
            if node.kind == "binary" and node.operator == "+":
                a: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval(nodes, node.left, bounds, depth + 1)
                b: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval(nodes, node.right, bounds, depth + 1)
                lower_sum: ProofKernelReplayInt = proof_kernel_replay_add_safe(a.lower, b.lower)
                upper_sum: ProofKernelReplayInt = proof_kernel_replay_add_safe(a.upper, b.upper)
                has_lower: bool = a.has_lower and b.has_lower and lower_sum.known
                has_upper: bool = a.has_upper and b.has_upper and upper_sum.known
                return (has_lower and has_upper, lower_sum.value, upper_sum.value, has_lower, has_upper)
            if node.kind == "binary" and node.operator == "-":
                a: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval(nodes, node.left, bounds, depth + 1)
                b: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval(nodes, node.right, bounds, depth + 1)
                lower_difference: ProofKernelReplayInt = proof_kernel_replay_sub_safe(a.lower, b.upper)
                upper_difference: ProofKernelReplayInt = proof_kernel_replay_sub_safe(a.upper, b.lower)
                has_lower: bool = a.has_lower and b.has_upper and lower_difference.known
                has_upper: bool = a.has_upper and b.has_lower and upper_difference.known
                return (has_lower and has_upper, lower_difference.value, upper_difference.value, has_lower, has_upper)
            if node.kind == "binary" and node.operator == "/":
                divisor: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, node.right, 0)
                dividend: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval(nodes, node.left, bounds, depth + 1)
                return (false, 0, 0, false, false) if not divisor.known or divisor.value == 0 or not dividend.has_lower or not dividend.has_upper
                lower_quotient: ProofKernelReplayInt = proof_kernel_replay_div_safe(dividend.lower, divisor.value)
                upper_quotient: ProofKernelReplayInt = proof_kernel_replay_div_safe(dividend.upper, divisor.value)
                return (false, 0, 0, false, false) if not lower_quotient.known or not upper_quotient.known
                return (true, lower_quotient.value, upper_quotient.value, true, true) if divisor.value > 0
                return (true, upper_quotient.value, lower_quotient.value, true, true)
            if node.kind == "binary" and node.operator == "%":
                divisor: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, node.right, 0)
                return (false, 0, 0, false, false) if not divisor.known or divisor.value == 0
                magnitude: mutable i64 = divisor.value
                if magnitude < 0:
                    absolute: ProofKernelReplayInt = proof_kernel_replay_sub_safe(0, magnitude)
                    return (false, 0, 0, false, false) if not absolute.known
                    magnitude <- absolute.value
                limit: ProofKernelReplayInt = proof_kernel_replay_sub_safe(magnitude, 1)
                return (false, 0, 0, false, false) if not limit.known
                negative_limit: ProofKernelReplayInt = proof_kernel_replay_sub_safe(0, limit.value)
                return (false, 0, 0, false, false) if not negative_limit.known
                return (true, negative_limit.value, limit.value, true, true)
            return (false, 0, 0, false, false)

        def proof_kernel_replay_interval_goal(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, left_root: usize, operator: sview, right_root: usize, facts: darray[usize]) -> bool:
            return false if operator != "==" and operator != "!=" and operator != "<" and operator != "<=" and operator != ">" and operator != ">="
            bounds: mutable darray[ProofKernelReplayBound] = []
            for fact in facts |fact, nodes, bounds|:
                proof_kernel_replay_collect_bounds(nodes, fact, &bounds, 0)
            proof_kernel_replay_close_equalities(nodes, facts, &bounds)
            a: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval(nodes, left_root, bounds, 0)
            b: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_kernel_replay_interval(nodes, right_root, bounds, 0)
            return a.has_lower and b.has_upper and a.lower > b.upper if operator == ">"
            return a.has_lower and b.has_upper and a.lower >= b.upper if operator == ">="
            return a.has_upper and b.has_lower and a.upper < b.lower if operator == "<"
            return a.has_upper and b.has_lower and a.upper <= b.lower if operator == "<="
            return a.known and b.known and a.lower == a.upper and b.lower == b.upper and a.lower == b.lower if operator == "=="
            return (a.has_upper and b.has_lower and a.upper < b.lower) or (a.has_lower and b.has_upper and a.lower > b.upper) if operator == "!="
            return false

        def proof_kernel_replay_difference_push(left: ProofKernelReplayAffine, right: ProofKernelReplayAffine, reverse: bool, strict: bool, constraints: mutable darray[ProofKernelReplayDifference]&) -> void:
            first: ProofKernelReplayAffine = left if not reverse else right
            second: ProofKernelReplayAffine = right if not reverse else left
            difference: ProofKernelReplayInt = proof_kernel_replay_sub_safe(second.offset, first.offset)
            return if not difference.known
            bound: mutable i64 = difference.value
            if strict:
                decremented: ProofKernelReplayInt = proof_kernel_replay_sub_safe(bound, 1)
                return if not decremented.known
                bound <- decremented.value
            constraints.push(ProofKernelReplayDifference{left: first.base, right: second.base, bound: bound})

        def proof_kernel_replay_collect_differences(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, bounds: darray[ProofKernelReplayBound]&, constraints: mutable darray[ProofKernelReplayDifference]&, depth: usize) -> void:
            requires depth <= 127
            decreases 127 - depth
            return if not ElisaProofKernelCore::depth_valid(depth)
            return if depth >= 127
            return if root >= nodes.count
            return if not proof_kernel_replay_valid(nodes, root)
            located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, root)
            return if not located.known
            node: ElisaProofKernelCore::ProofKernelNode = located.node
            if node.kind == "unary" and node.operator == "not":
                inner_located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, node.left)
                if inner_located.known and inner_located.node.kind == "binary":
                    inner: ElisaProofKernelCore::ProofKernelNode = inner_located.node
                    negated: sview = proof_kernel_replay_negation(inner.operator)
                    if negated != "":
                        # A negated comparison is represented by its complemented operator.
                        left: ProofKernelReplayAffine = proof_kernel_replay_affine_expression(nodes, inner.left, depth + 1)
                        right: ProofKernelReplayAffine = proof_kernel_replay_affine_expression(nodes, inner.right, depth + 1)
                        if left.known and right.known and proof_kernel_replay_affine_safe(left, bounds) and proof_kernel_replay_affine_safe(right, bounds):
                            proof_kernel_replay_difference_push(left, right, false, false, constraints) if negated == "<="
                            proof_kernel_replay_difference_push(left, right, false, true, constraints) if negated == "<"
                            proof_kernel_replay_difference_push(left, right, true, false, constraints) if negated == ">="
                            proof_kernel_replay_difference_push(left, right, true, true, constraints) if negated == ">"
                            if negated == "==":
                                proof_kernel_replay_difference_push(left, right, false, false, constraints)
                                proof_kernel_replay_difference_push(left, right, true, false, constraints)
                return
            if node.kind == "binary" and node.operator == "and":
                proof_kernel_replay_collect_differences(nodes, node.left, bounds, constraints, depth + 1)
                proof_kernel_replay_collect_differences(nodes, node.right, bounds, constraints, depth + 1)
                return
            return if node.kind != "binary" or node.operator != "==" and node.operator != "<" and node.operator != "<=" and node.operator != ">" and node.operator != ">="
            left: ProofKernelReplayAffine = proof_kernel_replay_affine_expression(nodes, node.left, depth + 1)
            right: ProofKernelReplayAffine = proof_kernel_replay_affine_expression(nodes, node.right, depth + 1)
            return if not left.known or not right.known or not proof_kernel_replay_affine_safe(left, bounds) or not proof_kernel_replay_affine_safe(right, bounds)
            proof_kernel_replay_difference_push(left, right, false, false, constraints) if node.operator == "<="
            proof_kernel_replay_difference_push(left, right, false, true, constraints) if node.operator == "<"
            proof_kernel_replay_difference_push(left, right, true, false, constraints) if node.operator == ">="
            proof_kernel_replay_difference_push(left, right, true, true, constraints) if node.operator == ">"
            if node.operator == "==":
                proof_kernel_replay_difference_push(left, right, false, false, constraints)
                proof_kernel_replay_difference_push(left, right, true, false, constraints)

        def proof_kernel_replay_difference_node_index(nodes: darray[sview]&, name: sview) -> usize:
            for index in 0..<nodes.count:
                if nodes[index] == name:
                    return index
            return nodes.count

        def proof_kernel_replay_difference_query(nodes: darray[sview]&, matrix: darray[i64]&, known: darray[bool]&, left: sview, right: sview, bound: i64) -> bool:
            left_index: usize = proof_kernel_replay_difference_node_index(nodes, left)
            right_index: usize = proof_kernel_replay_difference_node_index(nodes, right)
            return false if left_index >= nodes.count or right_index >= nodes.count
            slot: usize = left_index * nodes.count + right_index
            known_entry: (known: bool, value: bool) = proof_kernel_replay_bool_at(known, slot)
            matrix_entry: (known: bool, value: i64) = proof_kernel_replay_model_value_at(matrix, slot)
            return false if not known_entry.known or not matrix_entry.known
            return known_entry.value and matrix_entry.value <= bound

        def proof_kernel_replay_difference_comparison(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, left_root: usize, operator: sview, right_root: usize, facts: darray[usize]) -> bool:
            return false if operator != "==" and operator != "<" and operator != "<=" and operator != ">" and operator != ">="
            bounds: mutable darray[ProofKernelReplayBound] = []
            for fact in facts |fact, nodes, bounds|:
                proof_kernel_replay_collect_bounds(nodes, fact, &bounds, 0)
            proof_kernel_replay_close_equalities(nodes, facts, &bounds)
            left: ProofKernelReplayAffine = proof_kernel_replay_affine_expression(nodes, left_root, 0)
            right: ProofKernelReplayAffine = proof_kernel_replay_affine_expression(nodes, right_root, 0)
            return false if not left.known or not right.known or not proof_kernel_replay_affine_safe(left, bounds) or not proof_kernel_replay_affine_safe(right, bounds)
            constraints: mutable darray[ProofKernelReplayDifference] = []
            for fact in facts |fact, nodes, bounds, constraints|:
                proof_kernel_replay_collect_differences(nodes, fact, bounds, &constraints, 0)
            return false if constraints.count > 4096
            names: mutable darray[sview] = [""]
            for constraint in constraints |constraint, names|:
                names.push(constraint.left) if constraint.left != "" and proof_kernel_replay_difference_node_index(names, constraint.left) == names.count
                names.push(constraint.right) if constraint.right != "" and proof_kernel_replay_difference_node_index(names, constraint.right) == names.count
            return false if names.count > 128
            matrix: mutable darray[i64] = []
            known: mutable darray[bool] = []
            matrix.resize(names.count * names.count)
            known.resize(names.count * names.count)
            for index in 0..<matrix.count |index, matrix, known|:
                matrix[index] <- 0
                known[index] <- false
            for index in 0..<names.count |index, names, matrix, known|:
                slot: usize = index * names.count + index
                matrix[slot] <- 0
                known[slot] <- true
            for constraint in constraints |constraint, names, matrix, known|:
                left_index: usize = proof_kernel_replay_difference_node_index(names, constraint.left)
                right_index: usize = proof_kernel_replay_difference_node_index(names, constraint.right)
                slot: usize = left_index * names.count + right_index
                matrix[slot] <- constraint.bound if not known[slot] or constraint.bound < matrix[slot]
                known[slot] <- true
            for pivot in 0..<names.count |pivot, names, matrix, known|:
                for source in 0..<names.count |source, pivot, names, matrix, known|:
                    first_slot: usize = source * names.count + pivot
                    continue if not known[first_slot]
                    for target in 0..<names.count |target, source, pivot, names, matrix, known|:
                        second_slot: usize = pivot * names.count + target
                        continue if not known[second_slot]
                        combined: ProofKernelReplayInt = proof_kernel_replay_add_safe(matrix[first_slot], matrix[second_slot])
                        continue if not combined.known
                        result_slot: usize = source * names.count + target
                        matrix[result_slot] <- combined.value if not known[result_slot] or combined.value < matrix[result_slot]
                        known[result_slot] <- true
            if operator == "==":
                forward: ProofKernelReplayInt = proof_kernel_replay_sub_safe(right.offset, left.offset)
                reverse: ProofKernelReplayInt = proof_kernel_replay_sub_safe(left.offset, right.offset)
                return false if not forward.known or not reverse.known
                return proof_kernel_replay_difference_query(names, matrix, known, left.base, right.base, forward.value) and proof_kernel_replay_difference_query(names, matrix, known, right.base, left.base, reverse.value)
            if operator == "<=" or operator == "<":
                target: mutable ProofKernelReplayInt = proof_kernel_replay_sub_safe(right.offset, left.offset)
                return false if not target.known
                if operator == "<":
                    decremented: ProofKernelReplayInt = proof_kernel_replay_sub_safe(target.value, 1)
                    return false if not decremented.known
                    target <- decremented
                return proof_kernel_replay_difference_query(names, matrix, known, left.base, right.base, target.value)
            target: mutable ProofKernelReplayInt = proof_kernel_replay_sub_safe(left.offset, right.offset)
            return false if not target.known
            if operator == ">":
                decremented: ProofKernelReplayInt = proof_kernel_replay_sub_safe(target.value, 1)
                return false if not decremented.known
                target <- decremented
            return proof_kernel_replay_difference_query(names, matrix, known, right.base, left.base, target.value)

        def proof_kernel_replay_negation(operator: sview) -> sview:
            return "!=" if operator == "=="
            return "==" if operator == "!="
            return ">=" if operator == "<"
            return "<" if operator == ">="
            return ">" if operator == "<="
            return "<=" if operator == ">"
            return ""

        def proof_kernel_replay_expr_equal(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, left_root: usize, right_root: usize, depth: usize) -> bool:
            # The recursive descent is bounded by the same depth contract used by the arena
            # validator. Keeping an explicit ranking here lets the verifier audit this helper's
            # recursive edges instead of classifying them as opaque implementation recursion.
            requires depth <= 127
            decreases 127 - depth
            return false if not ElisaProofKernelCore::depth_valid(depth)
            return false if depth >= 127
            return false if not proof_kernel_replay_valid(nodes, left_root) or not proof_kernel_replay_valid(nodes, right_root)
            left_located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, left_root)
            right_located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, right_root)
            return false if not left_located.known or not right_located.known
            left: ElisaProofKernelCore::ProofKernelNode = left_located.node
            right: ElisaProofKernelCore::ProofKernelNode = right_located.node
            return false if left.kind != right.kind or left.operator != right.operator
            return false if left.kind == "unsupported"
            return true if left.kind == "absent"
            return left.value == right.value if left.kind == "int" or left.kind == "bool"
            return left.name == right.name if left.kind == "float" or left.kind == "string" or left.kind == "char"
            return left.name == right.name if left.kind == "ident"
            return left.name == right.name if left.kind == "shorthand"
            if left.kind == "field" or left.kind == "scope":
                return left.name == right.name and proof_kernel_replay_expr_equal(nodes, children, left.left, right.left, depth + 1)
            if left.kind == "unary" or left.kind == "move":
                return proof_kernel_replay_expr_equal(nodes, children, left.left, right.left, depth + 1)
            if left.kind == "call_arg":
                return left.name == right.name and proof_kernel_replay_expr_equal(nodes, children, left.left, right.left, depth + 1)
            if left.kind == "field-init":
                return left.name == right.name and proof_kernel_replay_expr_equal(nodes, children, left.left, right.left, depth + 1)
            if left.kind == "binary" or left.kind == "index" or left.kind == "dict_entry":
                return proof_kernel_replay_expr_equal(nodes, children, left.left, right.left, depth + 1) and proof_kernel_replay_expr_equal(nodes, children, left.right, right.right, depth + 1)
            if left.kind == "slice":
                return proof_kernel_replay_expr_equal(nodes, children, left.left, right.left, depth + 1) and proof_kernel_replay_expr_equal(nodes, children, left.right, right.right, depth + 1) and proof_kernel_replay_expr_equal(nodes, children, left.auxiliary, right.auxiliary, depth + 1)
            if left.kind == "index-n":
                return false if left.children_count == 0 or left.children_count != right.children_count or left.children_count > children.count or right.children_count > children.count or left.children_start > children.count - left.children_count or right.children_start > children.count - right.children_count
                return false if not ElisaProofKernelCore::range_valid(left.children_start, left.children_count, children.count) or not ElisaProofKernelCore::range_valid(right.children_start, right.children_count, children.count)
                return false if not proof_kernel_replay_expr_equal(nodes, children, left.left, right.left, depth + 1)
                for index in 0..<left.children_count |index, left, right, children, nodes, depth|:
                    return false if not proof_kernel_replay_expr_equal(nodes, children, children[left.children_start + index], children[right.children_start + index], depth + 1)
                return true
            if left.kind == "if":
                return proof_kernel_replay_expr_equal(nodes, children, left.left, right.left, depth + 1) and proof_kernel_replay_expr_equal(nodes, children, left.right, right.right, depth + 1) and proof_kernel_replay_expr_equal(nodes, children, left.auxiliary, right.auxiliary, depth + 1)
            if left.kind == "call":
                return false if left.auxiliary != right.auxiliary or left.children_count != right.children_count or left.children_count > children.count or right.children_count > children.count or left.children_start > children.count - left.children_count or right.children_start > children.count - right.children_count
                return false if not ElisaProofKernelCore::range_valid(left.children_start, left.children_count, children.count) or not ElisaProofKernelCore::range_valid(right.children_start, right.children_count, children.count)
                return false if not proof_kernel_replay_expr_equal(nodes, children, left.left, right.left, depth + 1)
                for index in 0..<left.children_count |index, left, right, children, nodes, depth|:
                    left_argument: usize = children[left.children_start + index]
                    right_argument: usize = children[right.children_start + index]
                    return false if not proof_kernel_replay_expr_equal(nodes, children, left_argument, right_argument, depth + 1)
                    left_argument_located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, left_argument)
                    right_argument_located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, right_argument)
                    return false if not left_argument_located.known or not right_argument_located.known or left_argument_located.node.kind != "call_arg" or right_argument_located.node.kind != "call_arg" or left_argument_located.node.name != right_argument_located.node.name
                return true
            if left.kind == "array" or left.kind == "tuple" or left.kind == "set" or left.kind == "dict":
                return false if left.children_count != right.children_count or left.children_count > children.count or right.children_count > children.count or left.children_start > children.count - left.children_count or right.children_start > children.count - right.children_count
                return false if not ElisaProofKernelCore::range_valid(left.children_start, left.children_count, children.count) or not ElisaProofKernelCore::range_valid(right.children_start, right.children_count, children.count)
                for index in 0..<left.children_count |index, left, right, children, nodes, depth|:
                    return false if not proof_kernel_replay_expr_equal(nodes, children, children[left.children_start + index], children[right.children_start + index], depth + 1)
                return true
            if left.kind == "construct" or left.kind == "record-update":
                return false if left.children_count != right.children_count or left.children_count > children.count or right.children_count > children.count or left.children_start > children.count - left.children_count or right.children_start > children.count - right.children_count
                return false if not ElisaProofKernelCore::range_valid(left.children_start, left.children_count, children.count) or not ElisaProofKernelCore::range_valid(right.children_start, right.children_count, children.count)
                return false if not proof_kernel_replay_expr_equal(nodes, children, left.left, right.left, depth + 1)
                for index in 0..<left.children_count |index, left, right, children, nodes, depth|:
                    return false if not proof_kernel_replay_expr_equal(nodes, children, children[left.children_start + index], children[right.children_start + index], depth + 1)
                return true
            if left.kind == "quantifier":
                return left.name == right.name and left.secondary_name == right.secondary_name and proof_kernel_replay_expr_equal(nodes, children, left.left, right.left, depth + 1) and proof_kernel_replay_expr_equal(nodes, children, left.right, right.right, depth + 1)
            return false

        def proof_kernel_replay_definitionally_equal(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, left_root: usize, right_root: usize, depth: usize) -> bool:
            # This normalization follows only a finite chain of explicit identity rewrites. The
            # same depth budget as structural equality prevents a malformed arena from turning
            # definitional comparison into unbounded host recursion.
            requires depth <= 127
            decreases 127 - depth
            return false if not ElisaProofKernelCore::depth_valid(depth)
            return false if depth >= 127
            return true if proof_kernel_replay_expr_equal(nodes, children, left_root, right_root, depth + 1)
            return false if not proof_kernel_replay_valid(nodes, left_root)
            left_located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, left_root)
            return false if not left_located.known
            left: ElisaProofKernelCore::ProofKernelNode = left_located.node
            if left.kind == "unary" and left.operator == "+":
                return proof_kernel_replay_definitionally_equal(nodes, children, left.left, right_root, depth + 1)
            if left.kind == "binary":
                amount: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, left.right, depth + 1)
                if left.operator == "+" or left.operator == "-":
                    return proof_kernel_replay_definitionally_equal(nodes, children, left.left, right_root, depth + 1) if amount.known and amount.value == 0
                if left.operator == "*":
                    return proof_kernel_replay_definitionally_equal(nodes, children, left.left, right_root, depth + 1) if amount.known and amount.value == 1
                    target: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, right_root, depth + 1)
                    return target.known and target.value == 0 if amount.known and amount.value == 0
                    base: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, left.left, depth + 1)
                    return proof_kernel_replay_definitionally_equal(nodes, children, left.right, right_root, depth + 1) if base.known and base.value == 1
                    return target.known and target.value == 0 if base.known and base.value == 0
                if left.operator == "/":
                    return proof_kernel_replay_definitionally_equal(nodes, children, left.left, right_root, depth + 1) if amount.known and amount.value == 1
                if left.operator == "%":
                    target: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, right_root, depth + 1)
                    return target.known and target.value == 0 if amount.known and amount.value == 1
                if left.operator == "&":
                    base: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, left.left, depth + 1)
                    target: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, right_root, depth + 1)
                    return target.known and target.value == 0 if amount.known and amount.value == 0
                    return target.known and target.value == 0 if base.known and base.value == 0
                    return proof_kernel_replay_definitionally_equal(nodes, children, left.left, right_root, depth + 1) if proof_kernel_replay_expr_equal(nodes, children, left.left, left.right, depth + 1)
                if left.operator == "|":
                    base: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, left.left, depth + 1)
                    return proof_kernel_replay_definitionally_equal(nodes, children, left.left, right_root, depth + 1) if amount.known and amount.value == 0
                    return proof_kernel_replay_definitionally_equal(nodes, children, left.right, right_root, depth + 1) if base.known and base.value == 0
                    return proof_kernel_replay_definitionally_equal(nodes, children, left.left, right_root, depth + 1) if proof_kernel_replay_expr_equal(nodes, children, left.left, left.right, depth + 1)
                if left.operator == "^":
                    base: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, left.left, depth + 1)
                    target: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, right_root, depth + 1)
                    return proof_kernel_replay_definitionally_equal(nodes, children, left.left, right_root, depth + 1) if amount.known and amount.value == 0
                    return proof_kernel_replay_definitionally_equal(nodes, children, left.right, right_root, depth + 1) if base.known and base.value == 0
                    return target.known and target.value == 0 if proof_kernel_replay_expr_equal(nodes, children, left.left, left.right, depth + 1)
                if left.operator == "<<" or left.operator == ">>":
                    return proof_kernel_replay_definitionally_equal(nodes, children, left.left, right_root, depth + 1) if amount.known and amount.value == 0
            if not proof_kernel_replay_valid(nodes, right_root):
                return false
            right_located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, right_root)
            return false if not right_located.known
            right: ElisaProofKernelCore::ProofKernelNode = right_located.node
            if right.kind == "unary" and right.operator == "+":
                return proof_kernel_replay_definitionally_equal(nodes, children, left_root, right.left, depth + 1)
            if right.kind == "binary":
                amount: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, right.right, depth + 1)
                if right.operator == "+" or right.operator == "-":
                    return proof_kernel_replay_definitionally_equal(nodes, children, left_root, right.left, depth + 1) if amount.known and amount.value == 0
                if right.operator == "*":
                    return proof_kernel_replay_definitionally_equal(nodes, children, left_root, right.left, depth + 1) if amount.known and amount.value == 1
                    left_constant: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, left_root, depth + 1)
                    return left_constant.known and left_constant.value == 0 if amount.known and amount.value == 0
                    base: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, right.left, depth + 1)
                    return proof_kernel_replay_definitionally_equal(nodes, children, left_root, right.right, depth + 1) if base.known and base.value == 1
                    return left_constant.known and left_constant.value == 0 if base.known and base.value == 0
                if right.operator == "/":
                    return proof_kernel_replay_definitionally_equal(nodes, children, left_root, right.left, depth + 1) if amount.known and amount.value == 1
                if right.operator == "%":
                    left_constant: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, left_root, depth + 1)
                    return left_constant.known and left_constant.value == 0 if amount.known and amount.value == 1
                if right.operator == "&":
                    base: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, right.left, depth + 1)
                    target: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, left_root, depth + 1)
                    return target.known and target.value == 0 if amount.known and amount.value == 0
                    return target.known and target.value == 0 if base.known and base.value == 0
                    return proof_kernel_replay_definitionally_equal(nodes, children, left_root, right.left, depth + 1) if proof_kernel_replay_expr_equal(nodes, children, right.left, right.right, depth + 1)
                if right.operator == "|":
                    base: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, right.left, depth + 1)
                    return proof_kernel_replay_definitionally_equal(nodes, children, left_root, right.left, depth + 1) if amount.known and amount.value == 0
                    return proof_kernel_replay_definitionally_equal(nodes, children, left_root, right.right, depth + 1) if base.known and base.value == 0
                    return proof_kernel_replay_definitionally_equal(nodes, children, left_root, right.left, depth + 1) if proof_kernel_replay_expr_equal(nodes, children, right.left, right.right, depth + 1)
                if right.operator == "^":
                    base: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, right.left, depth + 1)
                    target: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, left_root, depth + 1)
                    return proof_kernel_replay_definitionally_equal(nodes, children, left_root, right.left, depth + 1) if amount.known and amount.value == 0
                    return proof_kernel_replay_definitionally_equal(nodes, children, left_root, right.right, depth + 1) if base.known and base.value == 0
                    return target.known and target.value == 0 if proof_kernel_replay_expr_equal(nodes, children, right.left, right.right, depth + 1)
                if right.operator == "<<" or right.operator == ">>":
                    return proof_kernel_replay_definitionally_equal(nodes, children, left_root, right.left, depth + 1) if amount.known and amount.value == 0
            return false

        def proof_kernel_replay_fact_contains(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, goal_root: usize, depth: usize) -> bool:
            requires depth <= 127
            decreases 127 - depth
            return true if proof_kernel_replay_expr_equal(nodes, children, root, goal_root, 0)
            return false if not ElisaProofKernelCore::depth_valid(depth)
            return false if depth >= 127
            return false if root >= nodes.count
            return false if not proof_kernel_replay_valid(nodes, root)
            located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, root)
            return false if not located.known
            node: ElisaProofKernelCore::ProofKernelNode = located.node
            if node.kind == "binary" and node.operator == "and":
                return proof_kernel_replay_fact_contains(nodes, children, node.left, goal_root, depth + 1) or proof_kernel_replay_fact_contains(nodes, children, node.right, goal_root, depth + 1)
            if node.kind == "unary" and node.operator == "not":
                inner_located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, node.left)
                return proof_kernel_replay_fact_contains(nodes, children, inner_located.node.left, goal_root, depth + 1) if inner_located.known and inner_located.node.kind == "unary" and inner_located.node.operator == "not"
            return false

        def proof_kernel_replay_fact_contains_negated(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, target_root: usize, depth: usize) -> bool:
            requires depth <= 127
            decreases 127 - depth
            return false if not ElisaProofKernelCore::depth_valid(depth)
            return false if depth >= 127
            return false if root >= nodes.count
            return false if not proof_kernel_replay_valid(nodes, root)
            located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, root)
            return false if not located.known
            node: ElisaProofKernelCore::ProofKernelNode = located.node
            if node.kind == "unary" and node.operator == "not":
                return true if proof_kernel_replay_expr_equal(nodes, children, node.left, target_root, 0)
            if node.kind == "binary" and node.operator == "and":
                return proof_kernel_replay_fact_contains_negated(nodes, children, node.left, target_root, depth + 1) or proof_kernel_replay_fact_contains_negated(nodes, children, node.right, target_root, depth + 1)
            return false

        # A function-summary fact equates a call term with its postcondition. If the same Boolean
        # call (or its negation) is present in the branch context, equality substitution justifies
        # the corresponding postcondition. This is intentionally independent of the producer's
        # implementation and remains limited to exact canonical call roots.
        def proof_kernel_replay_fact_proves_call_summary(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], goal_root: usize) -> bool:
            return false if not proof_kernel_replay_valid(nodes, goal_root)
            goal_located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, goal_root)
            return false if not goal_located.known
            goal: ElisaProofKernelCore::ProofKernelNode = goal_located.node
            for summary_root in facts |summary_root, nodes, children, facts, goal_root, goal|:
                return false if not proof_kernel_replay_valid(nodes, summary_root)
                summary_located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, summary_root)
                continue if not summary_located.known
                summary: ElisaProofKernelCore::ProofKernelNode = summary_located.node
                continue if summary.kind != "binary" or summary.operator != "=="
                left_located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, summary.left)
                right_located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, summary.right)
                left_is_call: bool = left_located.known and left_located.node.kind == "call"
                right_is_call: bool = right_located.known and right_located.node.kind == "call"
                for fact_root in facts |fact_root, nodes, children, summary, goal_root, left_is_call, right_is_call, goal|:
                    if left_is_call and proof_kernel_replay_fact_contains(nodes, children, fact_root, summary.left, 0):
                        return true if proof_kernel_replay_expr_equal(nodes, children, summary.right, goal_root, 0)
                    if left_is_call and goal.kind == "unary" and goal.operator == "not" and proof_kernel_replay_valid(nodes, goal.left):
                        return true if proof_kernel_replay_expr_equal(nodes, children, summary.right, goal.left, 0) and proof_kernel_replay_fact_contains_negated(nodes, children, fact_root, summary.left, 0)
                    if right_is_call and proof_kernel_replay_fact_contains(nodes, children, fact_root, summary.right, 0):
                        return true if proof_kernel_replay_expr_equal(nodes, children, summary.left, goal_root, 0)
                    if right_is_call and goal.kind == "unary" and goal.operator == "not" and proof_kernel_replay_valid(nodes, goal.left):
                        return true if proof_kernel_replay_expr_equal(nodes, children, summary.left, goal.left, 0) and proof_kernel_replay_fact_contains_negated(nodes, children, fact_root, summary.right, 0)
            return false

        def proof_kernel_replay_negative_fact(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, left_root: usize, operator: sview, right_root: usize, depth: usize) -> bool:
            requires depth <= 127
            decreases 127 - depth
            return false if not ElisaProofKernelCore::depth_valid(depth)
            return false if depth >= 127
            return false if not proof_kernel_replay_valid(nodes, root)
            located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, root)
            return false if not located.known
            node: ElisaProofKernelCore::ProofKernelNode = located.node
            if node.kind == "binary" and node.operator == "and":
                return proof_kernel_replay_negative_fact(nodes, children, node.left, left_root, operator, right_root, depth + 1) or proof_kernel_replay_negative_fact(nodes, children, node.right, left_root, operator, right_root, depth + 1)
            if node.kind == "unary" and node.operator == "not":
                inner_located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, node.left)
                return false if not inner_located.known or inner_located.node.kind != "binary"
                inner: ElisaProofKernelCore::ProofKernelNode = inner_located.node
                return inner.operator == proof_kernel_replay_negation(operator) and proof_kernel_replay_expr_equal(nodes, children, inner.left, left_root, 0) and proof_kernel_replay_expr_equal(nodes, children, inner.right, right_root, 0)
            return false

        def proof_kernel_replay_facts_inconsistent(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, roots: darray[usize], depth: usize) -> bool:
            requires depth <= 127
            decreases 127 - depth
            return false if not ElisaProofKernelCore::depth_valid(depth)
            return false if depth >= 127
            for root in roots |root, nodes|:
                return false if root >= nodes.count
                return false if not proof_kernel_replay_valid(nodes, root)
                located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, root)
                return false if not located.known
                node: ElisaProofKernelCore::ProofKernelNode = located.node
                return true if node.kind == "bool" and node.value == 0
                if node.kind == "unary" and node.operator == "not" and proof_kernel_replay_valid(nodes, node.left):
                    inner_located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, node.left)
                    return true if inner_located.known and inner_located.node.kind == "bool" and inner_located.node.value != 0
                if node.kind == "binary" and node.operator == "and":
                    nested: mutable darray[usize] = [node.left, node.right]
                    return true if proof_kernel_replay_facts_inconsistent(nodes, nested, depth + 1)
            return false

        # Exact evaluator used by the bounded-model replay rule. It intentionally understands
        # only literals, identifiers, pure integer operators, comparisons, and propositional
        # connectives. Any other canonical node remains unknown and cannot replay a certificate.
        def proof_kernel_replay_model_name_index(names: darray[sview]&, name: sview) -> usize:
            for index in 0..<names.count:
                if names[index] == name:
                    return index
            return names.count

        def proof_kernel_replay_model_value_at(values: darray[i64]&, requested: usize) -> (known: bool, value: i64):
            return (false, 0) if requested >= values.count
            assert requested < values.count
            return (true, values[requested])

        def proof_kernel_replay_i64_set(values: mutable darray[i64]&, requested: usize, value: i64) -> bool:
            return false if requested >= values.count
            assert requested < values.count
            values[requested] <- value
            return true

        def proof_kernel_replay_model_collect_names(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, names: mutable darray[sview]&, depth: usize) -> void:
            requires depth <= 127
            decreases 127 - depth
            return if not ElisaProofKernelCore::depth_valid(depth)
            return if depth >= 127
            return if root >= nodes.count
            return if not proof_kernel_replay_valid(nodes, root)
            located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, root)
            return if not located.known
            node: ElisaProofKernelCore::ProofKernelNode = located.node
            if node.kind == "ident":
                if node.name != "":
                    found: mutable bool = false
                    for existing in names:
                        found <- true if existing == node.name
                    if not found:
                        names.push(node.name)
                return
            if node.kind == "unary":
                proof_kernel_replay_model_collect_names(nodes, node.left, names, depth + 1)
                return
            if node.kind == "binary":
                proof_kernel_replay_model_collect_names(nodes, node.left, names, depth + 1)
                proof_kernel_replay_model_collect_names(nodes, node.right, names, depth + 1)

        def proof_kernel_replay_model_int(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, names: darray[sview]&, values: darray[i64]&, depth: usize) -> ProofKernelReplayInt:
            requires depth <= 127
            decreases 127 - depth
            return ProofKernelReplayInt{known: false, value: 0} if not ElisaProofKernelCore::depth_valid(depth) or depth >= 127 or root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, root)
            return ProofKernelReplayInt{known: false, value: 0} if not located.known
            node: ElisaProofKernelCore::ProofKernelNode = located.node
            return ProofKernelReplayInt{known: true, value: node.value} if node.kind == "int"
            if node.kind == "ident":
                index: usize = proof_kernel_replay_model_name_index(names, node.name)
                value: (known: bool, value: i64) = proof_kernel_replay_model_value_at(values, index)
                return ProofKernelReplayInt{known: true, value: value.value} if value.known
                return ProofKernelReplayInt{known: false, value: 0}
            if node.kind == "unary":
                inner: ProofKernelReplayInt = proof_kernel_replay_model_int(nodes, node.left, names, values, depth + 1)
                return ProofKernelReplayInt{known: false, value: 0} if not inner.known
                return inner if node.operator == "+"
                if node.operator == "-":
                    return ProofKernelReplayInt{known: false, value: 0} if inner.value == proof_kernel_replay_i64_min()
                    return ProofKernelReplayInt{known: true, value: 0 - inner.value}
            if node.kind == "binary":
                left: ProofKernelReplayInt = proof_kernel_replay_model_int(nodes, node.left, names, values, depth + 1)
                right: ProofKernelReplayInt = proof_kernel_replay_model_int(nodes, node.right, names, values, depth + 1)
                return ProofKernelReplayInt{known: false, value: 0} if not left.known or not right.known
                return proof_kernel_replay_add_safe(left.value, right.value) if node.operator == "+"
                return proof_kernel_replay_sub_safe(left.value, right.value) if node.operator == "-"
                return proof_kernel_replay_mul_safe(left.value, right.value) if node.operator == "*"
                return proof_kernel_replay_div_safe(left.value, right.value) if node.operator == "/"
                return proof_kernel_replay_mod_safe(left.value, right.value) if node.operator == "%"
                return ProofKernelReplayInt{known: true, value: left.value & right.value} if node.operator == "&"
                return ProofKernelReplayInt{known: true, value: left.value | right.value} if node.operator == "|"
                return ProofKernelReplayInt{known: true, value: left.value ^ right.value} if node.operator == "^"
                return proof_kernel_replay_shift_safe(left.value, right.value, true) if node.operator == "<<"
                return proof_kernel_replay_shift_safe(left.value, right.value, false) if node.operator == ">>"
            return ProofKernelReplayInt{known: false, value: 0}

        def proof_kernel_replay_model_bool(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, names: darray[sview]&, values: darray[i64]&, depth: usize) -> ProofKernelReplayBool:
            requires depth <= 127
            decreases 127 - depth
            return ProofKernelReplayBool{known: false, value: false} if not ElisaProofKernelCore::depth_valid(depth) or depth >= 127 or root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, root)
            return ProofKernelReplayBool{known: false, value: false} if not located.known
            node: ElisaProofKernelCore::ProofKernelNode = located.node
            return ProofKernelReplayBool{known: node.value != 0, value: node.value != 0} if node.kind == "bool"
            if node.kind == "unary" and node.operator == "not":
                inner: ProofKernelReplayBool = proof_kernel_replay_model_bool(nodes, node.left, names, values, depth + 1)
                return ProofKernelReplayBool{known: true, value: not inner.value} if inner.known
                return ProofKernelReplayBool{known: false, value: false}
            if node.kind == "binary" and (node.operator == "and" or node.operator == "or"):
                left_bool: ProofKernelReplayBool = proof_kernel_replay_model_bool(nodes, node.left, names, values, depth + 1)
                right_bool: ProofKernelReplayBool = proof_kernel_replay_model_bool(nodes, node.right, names, values, depth + 1)
                return ProofKernelReplayBool{known: false, value: false} if not left_bool.known or not right_bool.known
                return ProofKernelReplayBool{known: true, value: left_bool.value and right_bool.value} if node.operator == "and"
                return ProofKernelReplayBool{known: true, value: left_bool.value or right_bool.value}
            if node.kind == "binary":
                left: ProofKernelReplayInt = proof_kernel_replay_model_int(nodes, node.left, names, values, depth + 1)
                right: ProofKernelReplayInt = proof_kernel_replay_model_int(nodes, node.right, names, values, depth + 1)
                if left.known and right.known:
                    return ProofKernelReplayBool{known: true, value: left.value == right.value} if node.operator == "=="
                    return ProofKernelReplayBool{known: true, value: left.value != right.value} if node.operator == "!="
                    return ProofKernelReplayBool{known: true, value: left.value < right.value} if node.operator == "<"
                    return ProofKernelReplayBool{known: true, value: left.value > right.value} if node.operator == ">"
                    return ProofKernelReplayBool{known: true, value: left.value <= right.value} if node.operator == "<="
                    return ProofKernelReplayBool{known: true, value: left.value >= right.value} if node.operator == ">="
                if node.operator == "==" or node.operator == "!=":
                    left_bool: ProofKernelReplayBool = proof_kernel_replay_model_bool(nodes, node.left, names, values, depth + 1)
                    right_bool: ProofKernelReplayBool = proof_kernel_replay_model_bool(nodes, node.right, names, values, depth + 1)
                    if left_bool.known and right_bool.known:
                        equal: bool = left_bool.value == right_bool.value
                        return ProofKernelReplayBool{known: true, value: equal} if node.operator == "=="
                        return ProofKernelReplayBool{known: true, value: not equal}
            return ProofKernelReplayBool{known: false, value: false}

        def proof_kernel_replay_bounded_model_visit(index: usize, names: darray[sview]&, values: mutable darray[i64]&, lowers: darray[i64]&, widths: darray[i64]&, nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, facts: darray[usize], goal_root: usize, budget: mutable usize&, all_known: mutable bool&, holds: mutable bool&) -> void:
            known_now: bool = all_known
            holds_now: bool = holds
            return if not known_now or not holds_now
            if index == names.count:
                if budget == 0:
                    all_known <- false
                    return
                budget <- budget - 1
                facts_hold: mutable bool = true
                for fact in facts |fact, names, values, nodes, facts_hold, all_known|:
                    fact_value: ProofKernelReplayBool = proof_kernel_replay_model_bool(nodes, fact, names, values, 0)
                    if not fact_value.known:
                        all_known <- false
                        return
                    facts_hold <- false if not fact_value.value
                return if not facts_hold
                goal_value: ProofKernelReplayBool = proof_kernel_replay_model_bool(nodes, goal_root, names, values, 0)
                if not goal_value.known:
                    all_known <- false
                    return
                holds <- false if not goal_value.value
                return
            return if index > names.count
            lower_entry: (known: bool, value: i64) = proof_kernel_replay_model_value_at(lowers, index)
            width_entry: (known: bool, value: i64) = proof_kernel_replay_model_value_at(widths, index)
            return if not lower_entry.known or not width_entry.known
            candidate: mutable i64 = lower_entry.value
            offset: mutable i64 = 0
            while offset < width_entry.value |offset, candidate, index, widths, values, nodes, facts, goal_root, budget, all_known, holds, names, lowers, width_entry|:
                proof_kernel_replay_i64_set(values, index, candidate)
                proof_kernel_replay_bounded_model_visit(index + 1, names, values, lowers, widths, nodes, facts, goal_root, budget, all_known, holds)
                known_after: bool = all_known
                holds_after: bool = holds
                return if not known_after or not holds_after
                offset <- offset + 1
                if offset < width_entry.value:
                    next_candidate: ProofKernelReplayInt = proof_kernel_replay_add_safe(candidate, 1)
                    if not next_candidate.known:
                        all_known <- false
                        return
                    candidate <- next_candidate.value

        def proof_kernel_replay_bounded_model_goal(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, facts: darray[usize], goal_root: usize) -> bool:
            names: mutable darray[sview] = []
            for fact in facts |fact, nodes, names|:
                proof_kernel_replay_model_collect_names(nodes, fact, &names, 0)
            proof_kernel_replay_model_collect_names(nodes, goal_root, &names, 0)
            return false if names.count == 0 or names.count > 6
            bounds: mutable darray[ProofKernelReplayBound] = []
            for fact in facts |fact, nodes, bounds|:
                proof_kernel_replay_collect_bounds(nodes, fact, &bounds, 0)
            proof_kernel_replay_close_equalities(nodes, facts, &bounds)
            lowers: mutable darray[i64] = []
            widths: mutable darray[i64] = []
            total: mutable i64 = 1
            for name in names |name, bounds, lowers, widths, total|:
                bound: ProofKernelReplayBound = proof_kernel_replay_bound_for(bounds, name)
                return false if not bound.has_lower or not bound.has_upper or bound.lower > bound.upper
                width_difference: ProofKernelReplayInt = proof_kernel_replay_sub_safe(bound.upper, bound.lower)
                return false if not width_difference.known
                width_with_end: ProofKernelReplayInt = proof_kernel_replay_add_safe(width_difference.value, 1)
                return false if not width_with_end.known or width_with_end.value <= 0 or width_with_end.value > 4096
                total_width: ProofKernelReplayInt = proof_kernel_replay_mul_safe(total, width_with_end.value)
                return false if not total_width.known or total_width.value > 65536
                total <- total_width.value
                lowers.push(bound.lower)
                widths.push(width_with_end.value)
            values: mutable darray[i64] = []
            values.resize(names.count)
            budget: mutable usize = 65536
            all_known: mutable bool = true
            holds: mutable bool = true
            proof_kernel_replay_bounded_model_visit(0, names, &values, lowers, widths, nodes, facts, goal_root, &budget, &all_known, &holds)
            return all_known and holds

        def proof_kernel_replay_exact_int(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, facts: darray[usize]) -> ProofKernelReplayInt:
            constant: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, root, 0)
            return constant if constant.known
            bounds: mutable darray[ProofKernelReplayBound] = []
            for fact in facts |fact, nodes, bounds|:
                proof_kernel_replay_collect_bounds(nodes, fact, &bounds, 0)
            proof_kernel_replay_close_equalities(nodes, facts, &bounds)
            name: sview = proof_kernel_replay_ident_name(nodes, root)
            return ProofKernelReplayInt{known: false, value: 0} if name == ""
            bound: ProofKernelReplayBound = proof_kernel_replay_bound_for(bounds, name)
            return ProofKernelReplayInt{known: true, value: bound.lower} if bound.has_lower and bound.has_upper and bound.lower == bound.upper
            return ProofKernelReplayInt{known: false, value: 0}

        def proof_kernel_replay_substitute(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, root: usize, name: sview, value_root: usize, depth: usize) -> usize:
            requires depth <= 127
            decreases 127 - depth
            return ElisaProofKernelCore::add_node(nodes, "unsupported", "substitution-depth", 0, 0, 0, 0, 0, 0, "", "") if not ElisaProofKernelCore::depth_valid(depth) or depth >= 127 or not proof_kernel_replay_valid(nodes, root)
            located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, root)
            return ElisaProofKernelCore::add_node(nodes, "unsupported", "substitution-root", 0, 0, 0, 0, 0, 0, "", "") if not located.known
            node: ElisaProofKernelCore::ProofKernelNode = located.node
            return value_root if node.kind == "ident" and node.name == name
            return root if node.kind == "int" or node.kind == "bool" or node.kind == "float" or node.kind == "string" or node.kind == "char" or node.kind == "ident" or node.kind == "shorthand" or node.kind == "absent" or node.kind == "unsupported"
            if node.kind == "unary" or node.kind == "move":
                child: usize = proof_kernel_replay_substitute(nodes, children, node.left, name, value_root, depth + 1)
                return ElisaProofKernelCore::add_node(nodes, node.kind, node.operator, child, 0, 0, 0, 0, node.value, node.name, node.secondary_name)
            if node.kind == "binary" or node.kind == "index" or node.kind == "dict_entry":
                left: usize = proof_kernel_replay_substitute(nodes, children, node.left, name, value_root, depth + 1)
                right: usize = proof_kernel_replay_substitute(nodes, children, node.right, name, value_root, depth + 1)
                return ElisaProofKernelCore::add_node(nodes, node.kind, node.operator, left, right, node.auxiliary, 0, 0, node.value, node.name, node.secondary_name)
            if node.kind == "slice":
                object: usize = proof_kernel_replay_substitute(nodes, children, node.left, name, value_root, depth + 1)
                low: usize = proof_kernel_replay_substitute(nodes, children, node.right, name, value_root, depth + 1)
                high: usize = proof_kernel_replay_substitute(nodes, children, node.auxiliary, name, value_root, depth + 1)
                return ElisaProofKernelCore::add_node(nodes, "slice", "", object, low, high, 0, 0, 0, "", "")
            if node.kind == "index-n":
                return ElisaProofKernelCore::add_node(nodes, "unsupported", "index-n-children", 0, 0, 0, 0, 0, 0, "", "") if node.children_count == 0
                return ElisaProofKernelCore::add_node(nodes, "unsupported", "index-n-children", 0, 0, 0, 0, 0, 0, "", "") if node.children_start > children.count
                return ElisaProofKernelCore::add_node(nodes, "unsupported", "index-n-children", 0, 0, 0, 0, 0, 0, "", "") if node.children_count > children.count - node.children_start
                return ElisaProofKernelCore::add_node(nodes, "unsupported", "index-n-children", 0, 0, 0, 0, 0, 0, "", "") if not ElisaProofKernelCore::range_valid(node.children_start, node.children_count, children.count)
                start: usize = children.count
                for index in 0..<node.children_count |index, node, children, nodes, name, value_root, depth|:
                    argument: usize = proof_kernel_replay_substitute(nodes, children, children[node.children_start + index], name, value_root, depth + 1)
                    children.push(argument)
                object: usize = proof_kernel_replay_substitute(nodes, children, node.left, name, value_root, depth + 1)
                return ElisaProofKernelCore::add_node(nodes, "index-n", "", object, 0, 0, start, node.children_count, 0, "", "")
            if node.kind == "checked-index":
                guarded: usize = proof_kernel_replay_substitute(nodes, children, node.left, name, value_root, depth + 1)
                fallback: usize = proof_kernel_replay_substitute(nodes, children, node.right, name, value_root, depth + 1)
                return ElisaProofKernelCore::add_node(nodes, "checked-index", "", guarded, fallback, 0, 0, 0, 0, "", "")
            if node.kind == "checked-get":
                guarded: usize = proof_kernel_replay_substitute(nodes, children, node.left, name, value_root, depth + 1)
                return ElisaProofKernelCore::add_node(nodes, "checked-get", "", guarded, 0, 0, 0, 0, 0, "", "")
            if node.kind == "if":
                condition: usize = proof_kernel_replay_substitute(nodes, children, node.left, name, value_root, depth + 1)
                then_value: usize = proof_kernel_replay_substitute(nodes, children, node.right, name, value_root, depth + 1)
                else_value: usize = proof_kernel_replay_substitute(nodes, children, node.auxiliary, name, value_root, depth + 1)
                return ElisaProofKernelCore::add_node(nodes, "if", "", condition, then_value, else_value, 0, 0, 0, "", "")
            if node.kind == "field" or node.kind == "scope":
                object: usize = proof_kernel_replay_substitute(nodes, children, node.left, name, value_root, depth + 1)
                return ElisaProofKernelCore::add_node(nodes, node.kind, node.operator, object, 0, 0, 0, 0, node.value, node.name, node.secondary_name)
            if node.kind == "call_arg":
                argument: usize = proof_kernel_replay_substitute(nodes, children, node.left, name, value_root, depth + 1)
                return ElisaProofKernelCore::add_node(nodes, "call_arg", "", argument, 0, 0, 0, 0, 0, node.name, node.secondary_name)
            if node.kind == "field-init":
                field_value: usize = proof_kernel_replay_substitute(nodes, children, node.left, name, value_root, depth + 1)
                return ElisaProofKernelCore::add_node(nodes, "field-init", "", field_value, 0, 0, 0, 0, 0, node.name, node.secondary_name)
            if node.kind == "call":
                start: usize = children.count
                return ElisaProofKernelCore::add_node(nodes, "unsupported", "call-children", 0, 0, 0, 0, 0, 0, "", "") if node.children_start > children.count or node.children_count > children.count - node.children_start
                return ElisaProofKernelCore::add_node(nodes, "unsupported", "call-children", 0, 0, 0, 0, 0, 0, "", "") if not ElisaProofKernelCore::range_valid(node.children_start, node.children_count, children.count)
                callee: usize = proof_kernel_replay_substitute(nodes, children, node.left, name, value_root, depth + 1)
                for index in 0..<node.children_count |index, node, children, nodes, name, value_root, depth|:
                    argument: usize = proof_kernel_replay_substitute(nodes, children, children[node.children_start + index], name, value_root, depth + 1)
                    children.push(argument)
                return ElisaProofKernelCore::add_node(nodes, "call", node.operator, callee, 0, node.auxiliary, start, node.children_count, node.value, node.name, node.secondary_name)
            if node.kind == "quantifier":
                range: usize = proof_kernel_replay_substitute(nodes, children, node.left, name, value_root, depth + 1)
                body: mutable usize = node.right
                body <- proof_kernel_replay_substitute(nodes, children, node.right, name, value_root, depth + 1) if node.name != name and node.secondary_name != name
                return ElisaProofKernelCore::add_node(nodes, "quantifier", node.operator, range, body, node.auxiliary, 0, 0, node.value, node.name, node.secondary_name)
            if node.kind == "array" or node.kind == "tuple" or node.kind == "set" or node.kind == "dict":
                return ElisaProofKernelCore::add_node(nodes, "unsupported", "collection-substitution", 0, 0, 0, 0, 0, 0, "", "") if node.children_start > children.count
                return ElisaProofKernelCore::add_node(nodes, "unsupported", "collection-substitution", 0, 0, 0, 0, 0, 0, "", "") if node.children_count > children.count - node.children_start
                return ElisaProofKernelCore::add_node(nodes, "unsupported", "collection-substitution", 0, 0, 0, 0, 0, 0, "", "") if not ElisaProofKernelCore::range_valid(node.children_start, node.children_count, children.count)
                start: usize = children.count
                for index in 0..<node.children_count |index, node, children, nodes, name, value_root, depth|:
                    element: usize = proof_kernel_replay_substitute(nodes, children, children[node.children_start + index], name, value_root, depth + 1)
                    children.push(element)
                return ElisaProofKernelCore::add_node(nodes, node.kind, "", 0, 0, 0, start, node.children_count, 0, "", "")
            if node.kind == "construct" or node.kind == "record-update":
                return ElisaProofKernelCore::add_node(nodes, "unsupported", "construction-substitution", 0, 0, 0, 0, 0, 0, "", "") if node.children_start > children.count
                return ElisaProofKernelCore::add_node(nodes, "unsupported", "construction-substitution", 0, 0, 0, 0, 0, 0, "", "") if node.children_count > children.count - node.children_start
                return ElisaProofKernelCore::add_node(nodes, "unsupported", "construction-substitution", 0, 0, 0, 0, 0, 0, "", "") if not ElisaProofKernelCore::range_valid(node.children_start, node.children_count, children.count)
                base: usize = proof_kernel_replay_substitute(nodes, children, node.left, name, value_root, depth + 1)
                start: usize = children.count
                for index in 0..<node.children_count |index, node, children, nodes, name, value_root, depth|:
                    field: usize = proof_kernel_replay_substitute(nodes, children, children[node.children_start + index], name, value_root, depth + 1)
                    children.push(field)
                return ElisaProofKernelCore::add_node(nodes, node.kind, "", base, 0, 0, start, node.children_count, 0, "", "")
            return ElisaProofKernelCore::add_node(nodes, "unsupported", "substitution", 0, 0, 0, 0, 0, 0, "", "")

        # Replace an exact source-neutral subterm while preserving every surrounding arena
        # constructor. This is the certificate-side counterpart of the AST rewrite tactic and
        # deliberately returns the original root when no occurrence exists. The arena has already
        # passed admission before callers use this helper, so every recursive edge remains bounded
        # by the same 127-level term limit.
        def proof_kernel_replay_replace_exact(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, root: usize, from_root: usize, replacement_root: usize, depth: usize) -> (changed: bool, value: usize):
            requires depth <= 127
            decreases 127 - depth
            return (false, root) if not ElisaProofKernelCore::depth_valid(depth) or depth >= 127 or not proof_kernel_replay_valid(nodes, root)
            return (true, replacement_root) if proof_kernel_replay_expr_equal(nodes, children, root, from_root, 0)
            located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, root)
            return (false, root) if not located.known
            node: ElisaProofKernelCore::ProofKernelNode = located.node
            return (false, root) if node.kind == "int" or node.kind == "bool" or node.kind == "float" or node.kind == "string" or node.kind == "char" or node.kind == "ident" or node.kind == "shorthand" or node.kind == "absent" or node.kind == "unsupported"
            if node.kind == "unary" or node.kind == "move" or node.kind == "field" or node.kind == "scope" or node.kind == "call_arg" or node.kind == "field-init" or node.kind == "checked-get":
                child: (changed: bool, value: usize) = proof_kernel_replay_replace_exact(nodes, children, node.left, from_root, replacement_root, depth + 1)
                return (false, root) if not child.changed
                return (true, ElisaProofKernelCore::add_node(nodes, node.kind, node.operator, child.value, node.right, node.auxiliary, node.children_start, node.children_count, node.value, node.name, node.secondary_name))
            if node.kind == "binary" or node.kind == "index" or node.kind == "dict_entry" or node.kind == "checked-index":
                left: (changed: bool, value: usize) = proof_kernel_replay_replace_exact(nodes, children, node.left, from_root, replacement_root, depth + 1)
                right: (changed: bool, value: usize) = proof_kernel_replay_replace_exact(nodes, children, node.right, from_root, replacement_root, depth + 1)
                return (false, root) if not left.changed and not right.changed
                return (true, ElisaProofKernelCore::add_node(nodes, node.kind, node.operator, left.value if left.changed else node.left, right.value if right.changed else node.right, node.auxiliary, node.children_start, node.children_count, node.value, node.name, node.secondary_name))
            if node.kind == "slice" or node.kind == "if":
                left: (changed: bool, value: usize) = proof_kernel_replay_replace_exact(nodes, children, node.left, from_root, replacement_root, depth + 1)
                right: (changed: bool, value: usize) = proof_kernel_replay_replace_exact(nodes, children, node.right, from_root, replacement_root, depth + 1)
                auxiliary: (changed: bool, value: usize) = proof_kernel_replay_replace_exact(nodes, children, node.auxiliary, from_root, replacement_root, depth + 1)
                return (false, root) if not left.changed and not right.changed and not auxiliary.changed
                return (true, ElisaProofKernelCore::add_node(nodes, node.kind, node.operator, left.value if left.changed else node.left, right.value if right.changed else node.right, auxiliary.value if auxiliary.changed else node.auxiliary, node.children_start, node.children_count, node.value, node.name, node.secondary_name))
            if node.kind == "index-n" or node.kind == "array" or node.kind == "tuple" or node.kind == "set" or node.kind == "dict" or node.kind == "construct" or node.kind == "record-update" or node.kind == "call":
                return (false, root) if node.children_start > children.count or node.children_count > children.count - node.children_start
                return (false, root) if not ElisaProofKernelCore::range_valid(node.children_start, node.children_count, children.count)
                base_value: mutable usize = node.left
                base_changed: mutable bool = false
                if node.kind == "index-n" or node.kind == "construct" or node.kind == "record-update" or node.kind == "call":
                    rewritten_base: (changed: bool, value: usize) = proof_kernel_replay_replace_exact(nodes, children, node.left, from_root, replacement_root, depth + 1)
                    base_value <- rewritten_base.value
                    base_changed <- rewritten_base.changed
                rewritten_children: mutable darray[usize] = []
                any_changed: mutable bool = base_changed
                for index in 0..<node.children_count |index, node, children, nodes, from_root, replacement_root, depth, rewritten_children, any_changed|:
                    child: (changed: bool, value: usize) = proof_kernel_replay_replace_exact(nodes, children, children[node.children_start + index], from_root, replacement_root, depth + 1)
                    rewritten_children.push(child.value)
                    any_changed <- true if child.changed
                return (false, root) if not any_changed
                start: usize = children.count
                children.extend(rewritten_children)
                return (true, ElisaProofKernelCore::add_node(nodes, node.kind, node.operator, base_value, node.right, node.auxiliary, start, node.children_count, node.value, node.name, node.secondary_name))
            if node.kind == "quantifier":
                range: (changed: bool, value: usize) = proof_kernel_replay_replace_exact(nodes, children, node.left, from_root, replacement_root, depth + 1)
                body: (changed: bool, value: usize) = proof_kernel_replay_replace_exact(nodes, children, node.right, from_root, replacement_root, depth + 1)
                return (false, root) if not range.changed and not body.changed
                return (true, ElisaProofKernelCore::add_node(nodes, node.kind, node.operator, range.value if range.changed else node.left, body.value if body.changed else node.right, node.auxiliary, node.children_start, node.children_count, node.value, node.name, node.secondary_name))
            return (false, root)

        def proof_kernel_replay_quantifier_values(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, kind: sview, facts: darray[usize], body: usize, binder: sview, values_start: usize, values_count: usize) -> bool:
            return false if values_count == 0 and kind == "exists"
            return false if values_count > 65536 or values_start > children.count or values_count > children.count - values_start
            return false if not ElisaProofKernelCore::range_valid(values_start, values_count, children.count)
            for index in 0..<values_count |index, children, nodes, facts, body, binder, kind, values_start|:
                instance: usize = proof_kernel_replay_substitute(nodes, children, body, binder, children[values_start + index], 0)
                proven: bool = proof_kernel_replay_goal_depth(nodes, children, facts, instance, 0, 0)
                return false if kind == "forall" and not proven
                return true if kind == "exists" and proven
            return kind == "forall"

        def proof_kernel_replay_quantifier_entries(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, kind: sview, facts: darray[usize], body: usize, key_binder: sview, value_binder: sview, range: ElisaProofKernelCore::ProofKernelNode) -> bool:
            return false if range.children_count == 0 and kind == "exists"
            return false if range.children_count > 32768 or range.children_start > children.count or range.children_count > children.count - range.children_start
            return false if not ElisaProofKernelCore::range_valid(range.children_start, range.children_count, children.count)
            for index in 0..<range.children_count |index, range, children, nodes, facts, body, key_binder, value_binder, kind|:
                entry_root: usize = children[range.children_start + index]
                entry_located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, entry_root)
                return false if not entry_located.known or not proof_kernel_replay_valid(nodes, entry_root) or entry_located.node.kind != "dict_entry"
                entry: ElisaProofKernelCore::ProofKernelNode = entry_located.node
                key_instance: usize = proof_kernel_replay_substitute(nodes, children, body, key_binder, entry.left, 0)
                instance: usize = proof_kernel_replay_substitute(nodes, children, key_instance, value_binder, entry.right, 0)
                proven: bool = proof_kernel_replay_goal_depth(nodes, children, facts, instance, 0, 0)
                return false if kind == "forall" and not proven
                return true if kind == "exists" and proven
            return kind == "forall"

        def proof_kernel_replay_quantifier(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, kind: sview, facts: darray[usize], root: usize) -> bool:
            return false if not proof_kernel_replay_valid(nodes, root)
            quantifier_located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, root)
            return false if not quantifier_located.known or quantifier_located.node.kind != "quantifier"
            quantifier: ElisaProofKernelCore::ProofKernelNode = quantifier_located.node
            return false if not proof_kernel_replay_valid(nodes, quantifier.left) or not proof_kernel_replay_valid(nodes, quantifier.right)
            range_located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, quantifier.left)
            return false if not range_located.known
            range: ElisaProofKernelCore::ProofKernelNode = range_located.node
            if range.kind == "binary" and (range.operator == "range_lt" or range.operator == "range_le"):
                lower: ProofKernelReplayInt = proof_kernel_replay_exact_int(nodes, range.left, facts)
                upper: ProofKernelReplayInt = proof_kernel_replay_exact_int(nodes, range.right, facts)
                return false if not lower.known or not upper.known
                return kind == "forall" if range.operator == "range_lt" and lower.value >= upper.value
                return kind == "forall" if range.operator == "range_le" and lower.value > upper.value
                width: mutable ProofKernelReplayInt = proof_kernel_replay_sub_safe(upper.value, lower.value)
                return false if not width.known
                if range.operator == "range_le":
                    width_with_end: ProofKernelReplayInt = proof_kernel_replay_add_safe(width.value, 1)
                    return false if not width_with_end.known
                    width <- width_with_end
                return false if width.value <= 0 or width.value > 65536
                candidate: mutable i64 = lower.value
                offset: mutable i64 = 0
                while offset < width.value |offset, candidate, facts, nodes, children, quantifier, kind|:
                    candidate_root: usize = ElisaProofKernelCore::add_node(nodes, "int", "", 0, 0, 0, 0, 0, candidate, "", "")
                    instance: usize = proof_kernel_replay_substitute(nodes, children, quantifier.right, quantifier.name, candidate_root, 0)
                    proven: bool = proof_kernel_replay_goal_depth(nodes, children, facts, instance, 0, 0)
                    return false if kind == "forall" and not proven
                    return true if kind == "exists" and proven
                    offset <- offset + 1
                    if offset < width.value:
                        next_candidate: ProofKernelReplayInt = proof_kernel_replay_add_safe(candidate, 1)
                        return false if not next_candidate.known
                        candidate <- next_candidate.value
                return kind == "forall"
            return proof_kernel_replay_quantifier_values(nodes, children, kind, facts, quantifier.right, quantifier.name, range.children_start, range.children_count) if range.kind == "array" or range.kind == "tuple" or range.kind == "set"
            return proof_kernel_replay_quantifier_entries(nodes, children, kind, facts, quantifier.right, quantifier.name, quantifier.secondary_name, range) if range.kind == "dict" and quantifier.auxiliary == 2
            return false

        # Arena admission has one implementation: the iterative validator below. Keeping the
        # public path single-source prevents a future caller from accidentally reintroducing the
        # old recursive fallback and its host-stack behavior.
        # Canonical node validation is kept separate from graph traversal. This makes the
        # serialization format closed: an otherwise harmless-looking node cannot carry hidden
        # edges or payload fields that a replay rule silently ignores.
        def proof_kernel_replay_arena_shape_valid(node: ElisaProofKernelCore::ProofKernelNode) -> bool:
            if node.kind == "int" or node.kind == "bool" or node.kind == "float" or node.kind == "string" or node.kind == "char" or node.kind == "ident":
                return false if node.operator != "" or node.left != 0 or node.right != 0 or node.auxiliary != 0 or node.children_start != 0 or node.children_count != 0 or node.secondary_name != ""
                return false if node.kind == "bool" and node.value != 0 and node.value != 1
                return true
            if node.kind == "shorthand":
                return node.operator == "" and node.left == 0 and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name != "" and node.secondary_name == ""
            if node.kind == "absent":
                return node.operator == "" and node.left == 0 and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name == "" and node.secondary_name == ""
            if node.kind == "unsupported":
                return node.left == 0 and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name == "" and node.secondary_name == ""
            if node.kind == "unary":
                return node.operator != "" and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name == "" and node.secondary_name == ""
            if node.kind == "move":
                return node.operator == "" and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name == "" and node.secondary_name == ""
            if node.kind == "field" or node.kind == "scope":
                return node.operator == "" and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name != "" and node.secondary_name == ""
            if node.kind == "binary":
                return node.operator != "" and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name == "" and node.secondary_name == ""
            if node.kind == "index" or node.kind == "dict_entry":
                return node.operator == "" and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name == "" and node.secondary_name == ""
            if node.kind == "slice":
                return node.operator == "" and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name == "" and node.secondary_name == ""
            if node.kind == "index-n":
                return node.operator == "" and node.children_count > 0 and node.right == 0 and node.auxiliary == 0 and node.value == 0 and node.name == "" and node.secondary_name == ""
            if node.kind == "checked-index":
                return node.operator == "" and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name == "" and node.secondary_name == ""
            if node.kind == "checked-get":
                return node.operator == "" and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name == "" and node.secondary_name == ""
            if node.kind == "if":
                return node.operator == "" and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name == "" and node.secondary_name == ""
            if node.kind == "call_arg":
                return node.operator == "" and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.secondary_name == ""
            if node.kind == "field-init":
                return node.operator == "" and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name != "" and node.secondary_name == ""
            if node.kind == "construct" or node.kind == "record-update":
                return node.operator == "" and node.right == 0 and node.auxiliary == 0 and node.value == 0 and node.name == "" and node.secondary_name == ""
            if node.kind == "call":
                return node.operator == "" and node.right == 0 and node.children_count >= node.auxiliary and node.value == 0 and node.name == "" and node.secondary_name == ""
            if node.kind == "array" or node.kind == "tuple" or node.kind == "set" or node.kind == "dict":
                return node.operator == "" and node.left == 0 and node.right == 0 and node.auxiliary == 0 and node.value == 0 and node.name == "" and node.secondary_name == ""
            if node.kind == "quantifier":
                return node.operator == "" and (node.auxiliary == 1 or node.auxiliary == 2) and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name != "" and (node.auxiliary == 2 or node.secondary_name == "") and (node.auxiliary == 1 or node.secondary_name != "")
            if node.kind == "resource-bind":
                valid_operator: bool = node.operator == "value" or node.operator == "shared" or node.operator == "mutable" or node.operator == "external-shared" or node.operator == "external-mutable"
                has_source: bool = node.operator == "shared" or node.operator == "mutable"
                return valid_operator and (has_source or node.left == 0) and node.right == 0 and node.auxiliary <= 1 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name != "" and (has_source and node.secondary_name != "" or not has_source and node.secondary_name == "")
            if node.kind == "resource-region-open" or node.kind == "resource-region-close":
                return node.operator == "" and node.left == 0 and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name != "" and node.secondary_name == ""
            if node.kind == "resource-region-alloc" or node.kind == "resource-region-bind":
                return node.operator == "" and node.right == 0 and node.auxiliary <= 7 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name != "" and node.secondary_name != ""
            if node.kind == "resource-region-alloc-discard":
                return node.operator == "" and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name == "" and node.secondary_name != ""
            if node.kind == "resource-region-rebind-alloc":
                return node.operator == "" and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name != "" and node.secondary_name != ""
            if node.kind == "resource-region-assign":
                return node.operator == "" and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name != "" and node.secondary_name != ""
            if node.kind == "resource-write" or node.kind == "resource-move":
                return node.operator == "" and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name != "" and node.secondary_name == ""
            if node.kind == "resource-use":
                return node.operator == "" and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name != "" and node.secondary_name == ""
            if node.kind == "resource-call-arg":
                return (node.operator == "value" or node.operator == "borrow" or node.operator == "reference") and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name != "" and node.secondary_name == ""
            if node.kind == "resource-call":
                return node.operator == "" and node.right == 0 and node.children_count == node.auxiliary and node.value == 0 and node.name != "" and node.secondary_name == ""
            if node.kind == "resource-scope":
                return node.operator == "" and node.left == 0 and node.right == 0 and node.auxiliary == 0 and node.value == 0 and node.name == "" and node.secondary_name == ""
            if node.kind == "resource-join-move":
                return node.operator == "" and node.left == 0 and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name != "" and node.secondary_name == ""
            if node.kind == "resource-safety":
                return node.operator == "" and node.left == 0 and node.right == 0 and node.auxiliary < 65536 and node.value == 0 and node.name != "" and node.secondary_name == "resource-v1"
            if node.kind == "resource-disjoint":
                return node.operator == "!=" and node.value == 0 and node.name == "" and node.secondary_name == "" and node.children_count <= 4096
            return false

        def proof_kernel_replay_arena_child_valid(validity: darray[bool]&, root: usize) -> bool:
            located: (known: bool, value: bool) = proof_kernel_replay_bool_at(validity, root)
            return located.known and located.value

        def proof_kernel_replay_arena_child_kind_valid(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, validity: darray[bool]&, root: usize, wanted: sview) -> bool:
            valid: (known: bool, value: bool) = proof_kernel_replay_bool_at(validity, root)
            return false if not valid.known or not valid.value
            return false if root >= nodes.count
            located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, root)
            return false if not located.known
            return false if located.node.kind != wanted
            return true

        def proof_kernel_replay_arena_children_valid(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, node: ElisaProofKernelCore::ProofKernelNode, children: darray[usize]&, validity: darray[bool]&) -> bool:
            if node.kind == "unary" or node.kind == "move" or node.kind == "field" or node.kind == "scope" or node.kind == "call_arg" or node.kind == "field-init" or node.kind == "checked-get" or node.kind == "resource-call-arg" or node.kind == "resource-region-alloc" or node.kind == "resource-region-alloc-discard" or node.kind == "resource-region-rebind-alloc" or node.kind == "resource-region-bind" or node.kind == "resource-region-assign":
                one_child: (known: bool, value: bool) = proof_kernel_replay_bool_at(validity, node.left)
                return one_child.known and one_child.value
            if node.kind == "binary" or node.kind == "index" or node.kind == "dict_entry" or node.kind == "checked-index":
                left_child: (known: bool, value: bool) = proof_kernel_replay_bool_at(validity, node.left)
                return false if not left_child.known or not left_child.value
                right_child: (known: bool, value: bool) = proof_kernel_replay_bool_at(validity, node.right)
                return right_child.known and right_child.value
            if node.kind == "slice":
                slice_object: (known: bool, value: bool) = proof_kernel_replay_bool_at(validity, node.left)
                return false if not slice_object.known or not slice_object.value
                slice_low: (known: bool, value: bool) = proof_kernel_replay_bool_at(validity, node.right)
                return false if not slice_low.known or not slice_low.value
                slice_high: (known: bool, value: bool) = proof_kernel_replay_bool_at(validity, node.auxiliary)
                return slice_high.known and slice_high.value
            if node.kind == "if":
                if_condition: (known: bool, value: bool) = proof_kernel_replay_bool_at(validity, node.left)
                return false if not if_condition.known or not if_condition.value
                if_then: (known: bool, value: bool) = proof_kernel_replay_bool_at(validity, node.right)
                return false if not if_then.known or not if_then.value
                if_else: (known: bool, value: bool) = proof_kernel_replay_bool_at(validity, node.auxiliary)
                return if_else.known and if_else.value
            if node.kind == "quantifier":
                quantifier_range: (known: bool, value: bool) = proof_kernel_replay_bool_at(validity, node.left)
                return false if not quantifier_range.known or not quantifier_range.value
                quantifier_body: (known: bool, value: bool) = proof_kernel_replay_bool_at(validity, node.right)
                return quantifier_body.known and quantifier_body.value
            if node.kind == "index-n" or node.kind == "construct" or node.kind == "record-update" or node.kind == "call" or node.kind == "array" or node.kind == "tuple" or node.kind == "set" or node.kind == "dict" or node.kind == "resource-call":
                return false if not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
                if node.kind == "index-n" or node.kind == "construct" or node.kind == "record-update" or node.kind == "call" or node.kind == "resource-call":
                    collection_head: (known: bool, value: bool) = proof_kernel_replay_bool_at(validity, node.left)
                    return false if not collection_head.known or not collection_head.value
                for index in 0..<node.children_count |index, node, children, validity|:
                    child: (known: bool, value: usize) = proof_kernel_replay_child_at(children, node.children_start + index)
                    return false if not child.known
                    child_validity: (known: bool, value: bool) = proof_kernel_replay_bool_at(validity, child.value)
                    return false if not child_validity.known or not child_validity.value
                    if node.kind == "construct" or node.kind == "record-update":
                        field_child: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, child.value)
                        return false if not field_child.known or field_child.node.kind != "field-init"
                    if node.kind == "call":
                        argument_child: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, child.value)
                        return false if not argument_child.known or argument_child.node.kind != "call_arg"
                    if node.kind == "resource-call":
                        argument_child: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, child.value)
                        return false if not argument_child.known or argument_child.node.kind != "resource-call-arg"
                return true
            if node.kind == "resource-scope" or node.kind == "resource-safety":
                return false if not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
                for index in 0..<node.children_count |index, node, children, validity|:
                    child: (known: bool, value: usize) = proof_kernel_replay_child_at(children, node.children_start + index)
                    return false if not child.known
                    child_validity: (known: bool, value: bool) = proof_kernel_replay_bool_at(validity, child.value)
                    return false if not child_validity.known or not child_validity.value
                return true
            if node.kind == "resource-disjoint":
                left_child: (known: bool, value: bool) = proof_kernel_replay_bool_at(validity, node.left)
                return false if not left_child.known or not left_child.value
                right_child: (known: bool, value: bool) = proof_kernel_replay_bool_at(validity, node.right)
                return false if not right_child.known or not right_child.value
                goal_child: (known: bool, value: bool) = proof_kernel_replay_bool_at(validity, node.auxiliary)
                return false if not goal_child.known or not goal_child.value
                return false if not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
                for index in 0..<node.children_count |index, node, children, validity|:
                    child: (known: bool, value: usize) = proof_kernel_replay_child_at(children, node.children_start + index)
                    return false if not child.known
                    child_validity: (known: bool, value: bool) = proof_kernel_replay_bool_at(validity, child.value)
                    return false if not child_validity.known or not child_validity.value
                return true
            if node.kind == "resource-bind":
                return true if node.operator == "value" or node.operator == "external-shared" or node.operator == "external-mutable"
                source: (known: bool, value: bool) = proof_kernel_replay_bool_at(validity, node.left)
                return source.known and source.value
            if node.kind == "resource-write" or node.kind == "resource-move":
                place: (known: bool, value: bool) = proof_kernel_replay_bool_at(validity, node.left)
                return place.known and place.value
            if node.kind == "resource-use":
                place: (known: bool, value: bool) = proof_kernel_replay_bool_at(validity, node.left)
                return place.known and place.value
            return true

        def proof_kernel_replay_arena_push_children(node: ElisaProofKernelCore::ProofKernelNode, children: darray[usize]&, depth: usize, work: mutable darray[ProofKernelReplayArenaWork]&) -> bool:
            next_depth: usize = depth + 1
            if node.kind == "unary" or node.kind == "move" or node.kind == "field" or node.kind == "scope" or node.kind == "call_arg" or node.kind == "field-init" or node.kind == "checked-get" or node.kind == "resource-call-arg" or node.kind == "resource-region-alloc" or node.kind == "resource-region-alloc-discard" or node.kind == "resource-region-rebind-alloc" or node.kind == "resource-region-bind" or node.kind == "resource-region-assign":
                work.push(ProofKernelReplayArenaWork{root: node.left, depth: next_depth, exiting: false})
                return true
            if node.kind == "binary" or node.kind == "index" or node.kind == "dict_entry" or node.kind == "checked-index":
                work.push(ProofKernelReplayArenaWork{root: node.left, depth: next_depth, exiting: false})
                work.push(ProofKernelReplayArenaWork{root: node.right, depth: next_depth, exiting: false})
                return true
            if node.kind == "slice":
                work.push(ProofKernelReplayArenaWork{root: node.left, depth: next_depth, exiting: false})
                work.push(ProofKernelReplayArenaWork{root: node.right, depth: next_depth, exiting: false})
                work.push(ProofKernelReplayArenaWork{root: node.auxiliary, depth: next_depth, exiting: false})
                return true
            if node.kind == "if" or node.kind == "quantifier":
                work.push(ProofKernelReplayArenaWork{root: node.left, depth: next_depth, exiting: false})
                work.push(ProofKernelReplayArenaWork{root: node.right, depth: next_depth, exiting: false})
                if node.kind == "if":
                    work.push(ProofKernelReplayArenaWork{root: node.auxiliary, depth: next_depth, exiting: false})
                return true
            if node.kind == "index-n" or node.kind == "construct" or node.kind == "record-update" or node.kind == "call" or node.kind == "array" or node.kind == "tuple" or node.kind == "set" or node.kind == "dict" or node.kind == "resource-call":
                return false if not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
                if node.kind == "index-n" or node.kind == "construct" or node.kind == "record-update" or node.kind == "call" or node.kind == "resource-call":
                    work.push(ProofKernelReplayArenaWork{root: node.left, depth: next_depth, exiting: false})
                for index in 0..<node.children_count |index, node, children, work, next_depth|:
                    child: (known: bool, value: usize) = proof_kernel_replay_child_at(children, node.children_start + index)
                    return false if not child.known
                    work.push(ProofKernelReplayArenaWork{root: child.value, depth: next_depth, exiting: false})
                return true
            if node.kind == "resource-scope" or node.kind == "resource-safety":
                return false if not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
                for index in 0..<node.children_count |index, node, children, work, next_depth|:
                    child: (known: bool, value: usize) = proof_kernel_replay_child_at(children, node.children_start + index)
                    return false if not child.known
                    work.push(ProofKernelReplayArenaWork{root: child.value, depth: next_depth, exiting: false})
                return true
            if node.kind == "resource-disjoint":
                work.push(ProofKernelReplayArenaWork{root: node.left, depth: next_depth, exiting: false})
                work.push(ProofKernelReplayArenaWork{root: node.right, depth: next_depth, exiting: false})
                work.push(ProofKernelReplayArenaWork{root: node.auxiliary, depth: next_depth, exiting: false})
                return false if not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
                for index in 0..<node.children_count |index, node, children, work, next_depth|:
                    child: (known: bool, value: usize) = proof_kernel_replay_child_at(children, node.children_start + index)
                    return false if not child.known
                    work.push(ProofKernelReplayArenaWork{root: child.value, depth: next_depth, exiting: false})
                return true
            if node.kind == "resource-bind":
                return true if node.operator == "value" or node.operator == "external-shared" or node.operator == "external-mutable"
                work.push(ProofKernelReplayArenaWork{root: node.left, depth: next_depth, exiting: false})
                return true
            if node.kind == "resource-write" or node.kind == "resource-move":
                work.push(ProofKernelReplayArenaWork{root: node.left, depth: next_depth, exiting: false})
                return true
            if node.kind == "resource-use":
                work.push(ProofKernelReplayArenaWork{root: node.left, depth: next_depth, exiting: false})
                return true
            return true

        # Iterative fail-closed arena admission. `visiting` is the active DFS color, `visited`
        # memoizes completed nodes, and `validity` prevents a malformed shared child from being
        # accepted on a later path. The work stack is bounded by the input graph's own size, while
        # the explicit depth field retains the certificate-level term bound.
        def proof_kernel_replay_arena_valid_iterative(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, facts: darray[usize], goal_root: usize) -> bool:
            visiting: mutable darray[bool] = []
            visited: mutable darray[bool] = []
            validity: mutable darray[bool] = []
            visiting.resize(nodes.count)
            visited.resize(nodes.count)
            validity.resize(nodes.count)
            work: mutable darray[ProofKernelReplayArenaWork] = [ProofKernelReplayArenaWork{root: goal_root, depth: 0, exiting: false}]
            for fact in facts |fact, work|:
                work.push(ProofKernelReplayArenaWork{root: fact, depth: 0, exiting: false})
            while work.count > 0 |work, nodes, children, visiting, visited, validity|:
                current: ProofKernelReplayArenaWork = work.pop()
                return false if current.depth >= 127 or not ElisaProofKernelCore::depth_valid(current.depth) or current.root >= nodes.count
                if current.exiting:
                    located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, current.root)
                    return false if not located.known
                    valid: bool = proof_kernel_replay_arena_shape_valid(located.node) and proof_kernel_replay_arena_children_valid(nodes, located.node, children, validity)
                    return false if not proof_kernel_replay_bool_set(visiting, current.root, false)
                    return false if not proof_kernel_replay_bool_set(visited, current.root, true)
                    return false if not proof_kernel_replay_bool_set(validity, current.root, valid)
                    return false if not valid
                    continue
                visited_value: (known: bool, value: bool) = proof_kernel_replay_bool_at(visited, current.root)
                visiting_value: (known: bool, value: bool) = proof_kernel_replay_bool_at(visiting, current.root)
                validity_value: (known: bool, value: bool) = proof_kernel_replay_bool_at(validity, current.root)
                return false if not visited_value.known or not visiting_value.known or not validity_value.known
                return false if visiting_value.value
                return false if visited_value.value and not validity_value.value
                continue if visited_value.value
                located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, current.root)
                return false if not located.known or not proof_kernel_replay_arena_shape_valid(located.node)
                return false if not proof_kernel_replay_bool_set(visiting, current.root, true)
                work.push(ProofKernelReplayArenaWork{root: current.root, depth: current.depth, exiting: true})
                return false if not proof_kernel_replay_arena_push_children(located.node, children, current.depth, &work)
            return true

        def proof_kernel_replay_arena_valid[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, facts: darray[usize], goal_root: usize) -> bool:
            return proof_kernel_replay_arena_valid_iterative(nodes, children, facts, goal_root)

        # Source-neutral transition checks for the interactive tactic protocol. The caller
        # supplies complete before/after snapshots; this kernel never re-runs an AST tactic.
        # Structural actions are checked by their exact term shape, while closing actions are
        # discharged through the same independent logical replay used for report certificates.
        def proof_kernel_replay_tactic_facts_equal(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, left: darray[usize], right: darray[usize]) -> bool:
            return false if left.count != right.count
            for index in 0..<left.count |index, left, right, nodes, children|:
                return false if not proof_kernel_replay_expr_equal(nodes, children, left[index], right[index], 0)
            return true

        def proof_kernel_replay_tactic_same_state(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, before_facts: darray[usize], before_goal: usize, after_facts: darray[usize], after_goal: usize) -> bool:
            return proof_kernel_replay_expr_equal(nodes, children, before_goal, after_goal, 0) and proof_kernel_replay_tactic_facts_equal(nodes, children, before_facts, after_facts)

        def proof_kernel_replay_tactic_appended(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, before_facts: darray[usize], after_facts: darray[usize], appended: usize) -> bool:
            return false if after_facts.count != before_facts.count + 1
            for index in 0..<before_facts.count |index, before_facts, after_facts, nodes, children|:
                return false if not proof_kernel_replay_expr_equal(nodes, children, before_facts[index], after_facts[index], 0)
            return proof_kernel_replay_expr_equal(nodes, children, appended, after_facts[after_facts.count - 1], 0)

        def proof_kernel_replay_tactic_binary(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, operator: sview) -> (known: bool, node: ElisaProofKernelCore::ProofKernelNode):
            empty: ElisaProofKernelCore::ProofKernelNode = ElisaProofKernelCore::ProofKernelNode{kind: "", operator: "", left: 0, right: 0, auxiliary: 0, children_start: 0, children_count: 0, value: 0, name: "", secondary_name: ""}
            return (false, empty) if not proof_kernel_replay_valid(nodes, root)
            located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, root)
            return (false, empty) if not located.known or located.node.kind != "binary" or located.node.operator != operator
            return located

        def proof_kernel_replay_tactic_effect_free(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, depth: usize) -> bool:
            requires depth <= 127
            decreases 127 - depth
            return false if not ElisaProofKernelCore::depth_valid(depth) or depth >= 127 or not proof_kernel_replay_valid(nodes, root)
            located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, root)
            return false if not located.known
            node: ElisaProofKernelCore::ProofKernelNode = located.node
            return false if node.kind == "call" or node.kind == "move"
            return false if node.kind == "unsupported"
            return true if node.kind == "int" or node.kind == "bool" or node.kind == "float" or node.kind == "string" or node.kind == "char" or node.kind == "ident" or node.kind == "shorthand" or node.kind == "absent"
            if node.kind == "unary" or node.kind == "field" or node.kind == "scope" or node.kind == "call_arg" or node.kind == "field-init" or node.kind == "checked-get":
                return proof_kernel_replay_tactic_effect_free(nodes, children, node.left, depth + 1)
            if node.kind == "binary" or node.kind == "index" or node.kind == "dict_entry" or node.kind == "checked-index":
                return proof_kernel_replay_tactic_effect_free(nodes, children, node.left, depth + 1) and proof_kernel_replay_tactic_effect_free(nodes, children, node.right, depth + 1)
            if node.kind == "slice" or node.kind == "if":
                return proof_kernel_replay_tactic_effect_free(nodes, children, node.left, depth + 1) and proof_kernel_replay_tactic_effect_free(nodes, children, node.right, depth + 1) and proof_kernel_replay_tactic_effect_free(nodes, children, node.auxiliary, depth + 1)
            if node.kind == "index-n" or node.kind == "array" or node.kind == "tuple" or node.kind == "set" or node.kind == "dict" or node.kind == "construct" or node.kind == "record-update" or node.kind == "call":
                return false if node.children_start > children.count or node.children_count > children.count - node.children_start
                return false if not ElisaProofKernelCore::range_valid(node.children_start, node.children_count, children.count)
                return false if node.kind != "array" and node.kind != "tuple" and node.kind != "set" and node.kind != "dict" and not proof_kernel_replay_tactic_effect_free(nodes, children, node.left, depth + 1)
                for index in 0..<node.children_count |index, node, children, nodes, depth|:
                    return false if not proof_kernel_replay_tactic_effect_free(nodes, children, children[node.children_start + index], depth + 1)
                return true
            if node.kind == "quantifier":
                return proof_kernel_replay_tactic_effect_free(nodes, children, node.left, depth + 1) and proof_kernel_replay_tactic_effect_free(nodes, children, node.right, depth + 1)
            return false

        def proof_kernel_replay_tactic_step_impl[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, action: sview, accepted: bool, before_solved: bool, after_solved: bool, before_facts: darray[usize], before_goal: usize, after_facts: darray[usize], after_goal: usize, argument: usize, has_argument: bool, secondary: usize, has_secondary: bool, argument_index: usize, has_argument_index: bool, detail: sview) -> bool:
            return false if not proof_kernel_replay_arena_valid(nodes, children, before_facts, before_goal)
            return false if not proof_kernel_replay_arena_valid(nodes, children, after_facts, after_goal)
            return false if has_argument and not proof_kernel_replay_valid(nodes, argument)
            return false if has_secondary and not proof_kernel_replay_valid(nodes, secondary)
            return false if action != "assumption" and action != "exact" and action != "decide" and action != "intro" and action != "apply" and action != "simp" and action != "have" and action != "instantiate" and action != "rewrite" and action != "split" and action != "left" and action != "right" and action != "cases"
            return false if accepted and before_solved
            if action == "assumption" or action == "exact" or action == "decide" or action == "intro" or action == "apply" or action == "simp" or action == "split" or action == "left" or action == "right" or action == "cases":
                return false if has_argument or has_secondary or has_argument_index or detail != ""
            if action == "have":
                return false if not has_argument or has_secondary or has_argument_index or detail != ""
            if action == "instantiate":
                return false if not has_argument or has_secondary or not has_argument_index or detail != "forall"
            if action == "rewrite":
                return false if not has_argument or not has_secondary or has_argument_index or detail != ""
            return before_solved == after_solved and proof_kernel_replay_tactic_same_state(nodes, children, before_facts, before_goal, after_facts, after_goal) if not accepted
            if action == "assumption":
                return false if not after_solved
                return false if not proof_kernel_replay_tactic_same_state(nodes, children, before_facts, before_goal, after_facts, after_goal)
                for fact in before_facts |fact, nodes, children, before_goal|:
                    return true if proof_kernel_replay_fact_contains(nodes, children, fact, before_goal, 0)
                return false
            if action == "exact" or action == "decide":
                return false if not after_solved
                return false if not proof_kernel_replay_tactic_same_state(nodes, children, before_facts, before_goal, after_facts, after_goal)
                return proof_kernel_replay_goal_depth(nodes, children, before_facts, before_goal, 0, 0)
            if action == "intro":
                return false if after_solved
                shape: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_tactic_binary(nodes, before_goal, "=>")
                return false if not shape.known or not proof_kernel_replay_tactic_appended(nodes, children, before_facts, after_facts, shape.node.left)
                return proof_kernel_replay_expr_equal(nodes, children, after_goal, shape.node.right, 0)
            if action == "apply":
                return false if after_solved
                return false if not proof_kernel_replay_tactic_facts_equal(nodes, children, before_facts, after_facts)
                for fact in before_facts |fact, nodes, children, before_goal, after_goal|:
                    shape: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_tactic_binary(nodes, fact, "=>")
                    return true if shape.known and proof_kernel_replay_tactic_effect_free(nodes, children, fact, 0) and proof_kernel_replay_expr_equal(nodes, children, shape.node.right, before_goal, 0) and proof_kernel_replay_expr_equal(nodes, children, shape.node.left, after_goal, 0)
                return false
            if action == "have":
                return false if after_solved
                return false if not has_argument or not proof_kernel_replay_tactic_appended(nodes, children, before_facts, after_facts, argument)
                return false if not proof_kernel_replay_tactic_same_state(nodes, children, before_facts, before_goal, before_facts, before_goal)
                return false if not proof_kernel_replay_tactic_effect_free(nodes, children, argument, 0)
                return proof_kernel_replay_goal_depth(nodes, children, before_facts, argument, 0, 0)
            if action == "instantiate":
                return false if after_solved or not has_argument or not has_argument_index or detail != "forall"
                return false if argument_index >= before_facts.count
                return false if not proof_kernel_replay_tactic_effect_free(nodes, children, argument, 0)
                return false if after_facts.count != before_facts.count + 1
                for index in 0..<before_facts.count |index, before_facts, after_facts, nodes, children|:
                    return false if not proof_kernel_replay_expr_equal(nodes, children, before_facts[index], after_facts[index], 0)
                selected_fact: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, before_facts[argument_index])
                return false if not selected_fact.known or selected_fact.node.kind != "quantifier"
                quantifier: ElisaProofKernelCore::ProofKernelNode = selected_fact.node
                return false if not proof_kernel_replay_tactic_effect_free(nodes, children, before_facts[argument_index], 0)
                member: mutable bool = false
                range_located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, quantifier.left)
                return false if not range_located.known
                range_node: ElisaProofKernelCore::ProofKernelNode = range_located.node
                if range_node.kind == "binary" and (range_node.operator == "range_lt" or range_node.operator == "range_le"):
                    selected: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, argument, 0)
                    lower: ProofKernelReplayInt = proof_kernel_replay_exact_int(nodes, range_node.left, before_facts)
                    upper: ProofKernelReplayInt = proof_kernel_replay_exact_int(nodes, range_node.right, before_facts)
                    member <- selected.known and lower.known and upper.known and selected.value >= lower.value and (selected.value < upper.value if range_node.operator == "range_lt" else selected.value <= upper.value)
                if range_node.kind == "array" or range_node.kind == "tuple" or range_node.kind == "set":
                    return false if range_node.children_start > children.count or range_node.children_count > children.count - range_node.children_start
                    return false if not ElisaProofKernelCore::range_valid(range_node.children_start, range_node.children_count, children.count)
                    for index in 0..<range_node.children_count |index, range_node, children, nodes, argument, member|:
                        member <- true if proof_kernel_replay_expr_equal(nodes, children, children[range_node.children_start + index], argument, 0)
                return false if not member
                instance: usize = proof_kernel_replay_substitute(nodes, children, quantifier.right, quantifier.name, argument, 0)
                return proof_kernel_replay_expr_equal(nodes, children, instance, after_facts[after_facts.count - 1], 0)
            if action == "rewrite":
                return false if after_solved or not has_argument or not has_secondary
                return false if not proof_kernel_replay_tactic_effect_free(nodes, children, before_goal, 0)
                return false if not proof_kernel_replay_tactic_effect_free(nodes, children, argument, 0) or not proof_kernel_replay_tactic_effect_free(nodes, children, secondary, 0)
                return false if not proof_kernel_replay_tactic_facts_equal(nodes, children, before_facts, after_facts)
                equality_found: mutable bool = false
                for fact in before_facts |fact, nodes, children, argument, secondary, equality_found|:
                    shape: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_tactic_binary(nodes, fact, "==")
                    if shape.known:
                        equality_found <- true if proof_kernel_replay_tactic_effect_free(nodes, children, fact, 0) and ((proof_kernel_replay_expr_equal(nodes, children, shape.node.left, argument, 0) and proof_kernel_replay_expr_equal(nodes, children, shape.node.right, secondary, 0)) or (proof_kernel_replay_expr_equal(nodes, children, shape.node.left, secondary, 0) and proof_kernel_replay_expr_equal(nodes, children, shape.node.right, argument, 0)))
                return false if not equality_found
                rewritten: (changed: bool, value: usize) = proof_kernel_replay_replace_exact(nodes, children, before_goal, argument, secondary, 0)
                return rewritten.changed and proof_kernel_replay_expr_equal(nodes, children, rewritten.value, after_goal, 0)
            if action == "left" or action == "right":
                return false if after_solved
                shape: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_tactic_binary(nodes, before_goal, "or")
                return false if not shape.known or not proof_kernel_replay_tactic_facts_equal(nodes, children, before_facts, after_facts)
                return proof_kernel_replay_expr_equal(nodes, children, after_goal, shape.node.left if action == "left" else shape.node.right, 0)
            if action == "split":
                return false if after_solved
                shape: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_tactic_binary(nodes, before_goal, "and")
                return shape.known and proof_kernel_replay_tactic_same_state(nodes, children, before_facts, before_goal, after_facts, after_goal)
            if action == "cases":
                return false if after_solved
                return false if not proof_kernel_replay_tactic_same_state(nodes, children, before_facts, before_goal, after_facts, after_goal)
                for fact in before_facts |fact, nodes|:
                    shape: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_tactic_binary(nodes, fact, "or")
                    return true if shape.known
                return false
            if action == "simp":
                return false if not proof_kernel_replay_tactic_facts_equal(nodes, children, before_facts, after_facts)
                return false if proof_kernel_replay_expr_equal(nodes, children, before_goal, after_goal, 0)
                simplified_from: mutable darray[usize] = [after_goal]
                return false if after_solved and not proof_kernel_replay_goal_depth(nodes, children, after_facts, after_goal, 0, 0)
                return proof_kernel_replay_goal_depth(nodes, children, simplified_from, before_goal, 0, 0)
            return false

        # Link the two child contexts produced by a branching tactic back to the parent state.
        # This rule is intentionally independent of the AST tactic implementation: it checks the
        # proposition shape and the exact source-neutral fact ordering used by the branch rule.
        def proof_kernel_replay_tactic_branch_report[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, action: sview, parent_facts: darray[usize], parent_goal: usize, left_facts: darray[usize], left_goal: usize, right_facts: darray[usize], right_goal: usize) -> bool:
            return false if action != "split" and action != "cases"
            return false if not proof_kernel_replay_arena_valid(nodes, children, parent_facts, parent_goal)
            return false if not proof_kernel_replay_arena_valid(nodes, children, left_facts, left_goal)
            return false if not proof_kernel_replay_arena_valid(nodes, children, right_facts, right_goal)
            if action == "split":
                shape: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_tactic_binary(nodes, parent_goal, "and")
                return false if not shape.known
                return false if not proof_kernel_replay_tactic_facts_equal(nodes, children, parent_facts, left_facts) or not proof_kernel_replay_tactic_facts_equal(nodes, children, parent_facts, right_facts)
                return proof_kernel_replay_expr_equal(nodes, children, left_goal, shape.node.left, 0) and proof_kernel_replay_expr_equal(nodes, children, right_goal, shape.node.right, 0)
            return false if not proof_kernel_replay_expr_equal(nodes, children, left_goal, parent_goal, 0) or not proof_kernel_replay_expr_equal(nodes, children, right_goal, parent_goal, 0)
            return false if left_facts.count != parent_facts.count or right_facts.count != parent_facts.count or parent_facts.count == 0
            for selected_index in 0..<parent_facts.count |selected_index, parent_facts, left_facts, right_facts, nodes, children|:
                shape: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_tactic_binary(nodes, parent_facts[selected_index], "or")
                continue if not shape.known
                for parent_index in 0..<parent_facts.count |parent_index, selected_index, parent_facts, left_facts, right_facts, nodes, children|:
                    if parent_index < selected_index:
                        return false if not proof_kernel_replay_expr_equal(nodes, children, parent_facts[parent_index], left_facts[parent_index], 0) or not proof_kernel_replay_expr_equal(nodes, children, parent_facts[parent_index], right_facts[parent_index], 0)
                    elif parent_index > selected_index:
                        return false if not proof_kernel_replay_expr_equal(nodes, children, parent_facts[parent_index], left_facts[parent_index - 1], 0) or not proof_kernel_replay_expr_equal(nodes, children, parent_facts[parent_index], right_facts[parent_index - 1], 0)
                return proof_kernel_replay_expr_equal(nodes, children, left_facts[left_facts.count - 1], shape.node.left, 0) and proof_kernel_replay_expr_equal(nodes, children, right_facts[right_facts.count - 1], shape.node.right, 0)
            return false

        def proof_kernel_replay_find_disjunction(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, depth: usize) -> (known: bool, left: usize, right: usize):
            requires depth <= 127
            decreases 127 - depth
            return (false, 0, 0) if not ElisaProofKernelCore::depth_valid(depth) or depth >= 127 or not proof_kernel_replay_valid(nodes, root)
            located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, root)
            return (false, 0, 0) if not located.known
            node: ElisaProofKernelCore::ProofKernelNode = located.node
            return (true, node.left, node.right) if node.kind == "binary" and node.operator == "or"
            if node.kind == "binary" and node.operator == "and":
                left_split: (known: bool, left: usize, right: usize) = proof_kernel_replay_find_disjunction(nodes, node.left, depth + 1)
                if left_split.known:
                    left_join: usize = ElisaProofKernelCore::add_node(nodes, "binary", "and", left_split.left, node.right, 0, 0, 0, 0, "", "")
                    right_join: usize = ElisaProofKernelCore::add_node(nodes, "binary", "and", left_split.right, node.right, 0, 0, 0, 0, "", "")
                    return (true, left_join, right_join)
                right_split: (known: bool, left: usize, right: usize) = proof_kernel_replay_find_disjunction(nodes, node.right, depth + 1)
                if right_split.known:
                    left_join: usize = ElisaProofKernelCore::add_node(nodes, "binary", "and", node.left, right_split.left, 0, 0, 0, 0, "", "")
                    right_join: usize = ElisaProofKernelCore::add_node(nodes, "binary", "and", node.left, right_split.right, 0, 0, 0, 0, "", "")
                    return (true, left_join, right_join)
            return (false, 0, 0)

        def proof_kernel_replay_goal_depth(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], goal_root: usize, split_depth: usize, depth: usize) -> bool:
            requires depth <= 127
            decreases 127 - depth
            return false if not ElisaProofKernelCore::depth_valid(depth)
            return false if depth >= 127
            return false if not proof_kernel_replay_valid(nodes, goal_root)
            for fact in facts |fact, nodes, children, goal_root|:
                return true if proof_kernel_replay_fact_contains(nodes, children, fact, goal_root, depth + 1)
            return true if proof_kernel_replay_facts_inconsistent(nodes, facts, depth + 1)
            return true if proof_kernel_replay_fact_proves_call_summary(nodes, children, facts, goal_root)
            if split_depth < 4:
                for index in 0..<facts.count |index, facts, nodes, children, goal_root, split_depth, depth|:
                    candidate: (known: bool, left: usize, right: usize) = proof_kernel_replay_find_disjunction(nodes, facts[index], depth)
                    if candidate.known:
                        left_facts: mutable darray[usize] = []
                        right_facts: mutable darray[usize] = []
                        for fact_index in 0..<facts.count |fact_index, facts, candidate, left_facts, right_facts|:
                            if fact_index == index:
                                left_facts.push(candidate.left)
                                right_facts.push(candidate.right)
                            else:
                                left_facts.push(facts[fact_index])
                                right_facts.push(facts[fact_index])
                        return proof_kernel_replay_goal_depth(nodes, children, left_facts, goal_root, split_depth + 1, depth + 1) and proof_kernel_replay_goal_depth(nodes, children, right_facts, goal_root, split_depth + 1, depth + 1)
            return true if proof_kernel_replay_bounded_model_goal(nodes, facts, goal_root)
            goal_located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, goal_root)
            return false if not goal_located.known
            node: ElisaProofKernelCore::ProofKernelNode = goal_located.node
            if node.kind == "bool":
                return node.value != 0
            if node.kind == "unary" and node.operator == "not":
                inner_located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, node.left)
                if inner_located.known and inner_located.node.kind == "bool":
                    return inner_located.node.value == 0
                if inner_located.known and inner_located.node.kind == "binary":
                    inner: ElisaProofKernelCore::ProofKernelNode = inner_located.node
                    negated: sview = proof_kernel_replay_negation(inner.operator)
                    return proof_kernel_replay_constant_comparison(nodes, inner.left, negated, inner.right) if negated != ""
            if node.kind == "binary" and node.operator == "and":
                return proof_kernel_replay_goal_depth(nodes, children, facts, node.left, split_depth, depth + 1) and proof_kernel_replay_goal_depth(nodes, children, facts, node.right, split_depth, depth + 1)
            if node.kind == "binary" and node.operator == "or":
                return proof_kernel_replay_goal_depth(nodes, children, facts, node.left, split_depth, depth + 1) or proof_kernel_replay_goal_depth(nodes, children, facts, node.right, split_depth, depth + 1)
            if node.kind == "binary" and node.operator == "=>":
                implication_facts: mutable darray[usize] = []
                implication_facts.extend(facts)
                implication_facts.push(node.left)
                return proof_kernel_replay_goal_depth(nodes, children, implication_facts, node.right, split_depth, depth + 1)
            if node.kind == "binary" and (node.operator == ">" or node.operator == ">=" or node.operator == "<" or node.operator == "<=" or node.operator == "==" or node.operator == "!=") and split_depth < 4:
                left_located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, node.left)
                if left_located.known and left_located.node.kind == "if":
                    conditional: ElisaProofKernelCore::ProofKernelNode = left_located.node
                    then_facts: mutable darray[usize] = []
                    else_facts: mutable darray[usize] = []
                    then_facts.extend(facts)
                    else_facts.extend(facts)
                    then_facts.push(conditional.left)
                    negated_condition: usize = ElisaProofKernelCore::add_node(nodes, "unary", "not", conditional.left, 0, 0, 0, 0, 0, "", "")
                    else_facts.push(negated_condition)
                    then_goal: usize = ElisaProofKernelCore::add_node(nodes, "binary", node.operator, conditional.right, node.right, 0, 0, 0, 0, "", "")
                    else_goal: usize = ElisaProofKernelCore::add_node(nodes, "binary", node.operator, conditional.auxiliary, node.right, 0, 0, 0, 0, "", "")
                    return proof_kernel_replay_goal_depth(nodes, children, then_facts, then_goal, split_depth + 1, depth + 1) and proof_kernel_replay_goal_depth(nodes, children, else_facts, else_goal, split_depth + 1, depth + 1)
                right_located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, node.right)
                if right_located.known and right_located.node.kind == "if":
                    conditional: ElisaProofKernelCore::ProofKernelNode = right_located.node
                    then_facts: mutable darray[usize] = []
                    else_facts: mutable darray[usize] = []
                    then_facts.extend(facts)
                    else_facts.extend(facts)
                    then_facts.push(conditional.left)
                    negated_condition: usize = ElisaProofKernelCore::add_node(nodes, "unary", "not", conditional.left, 0, 0, 0, 0, 0, "", "")
                    else_facts.push(negated_condition)
                    then_goal: usize = ElisaProofKernelCore::add_node(nodes, "binary", node.operator, node.left, conditional.right, 0, 0, 0, 0, "", "")
                    else_goal: usize = ElisaProofKernelCore::add_node(nodes, "binary", node.operator, node.left, conditional.auxiliary, 0, 0, 0, 0, "", "")
                    return proof_kernel_replay_goal_depth(nodes, children, then_facts, then_goal, split_depth + 1, depth + 1) and proof_kernel_replay_goal_depth(nodes, children, else_facts, else_goal, split_depth + 1, depth + 1)
            if node.kind == "binary":
                negated: sview = proof_kernel_replay_negation(node.operator)
                if negated != "" and proof_kernel_replay_definitionally_equal(nodes, children, node.left, node.right, 0):
                    return node.operator == "==" or node.operator == "<=" or node.operator == ">="
                return true if negated != "" and proof_kernel_replay_constant_comparison(nodes, node.left, node.operator, node.right)
                return true if proof_kernel_replay_interval_goal(nodes, node.left, node.operator, node.right, facts)
                return true if proof_kernel_replay_affine_comparison(nodes, node.left, node.operator, node.right, facts)
                return true if proof_kernel_replay_difference_comparison(nodes, node.left, node.operator, node.right, facts)
                for fact in facts |fact, nodes, children, node|:
                    return true if proof_kernel_replay_negative_fact(nodes, children, fact, node.left, node.operator, node.right, depth + 1)
            return false

        struct ProofKernelReplayResourcePlace:
            root: sview
            # The path is an index into the source-neutral arena's field chain. Keeping an
            # arena index rather than a heap-backed darray makes resource places safe to store
            # in replay state while retaining exact structural identity.
            path_root: usize
            depth: usize
            whole: bool

        struct ProofKernelReplayResourceEffect:
            kind: sview
            place: ProofKernelReplayResourcePlace

        def proof_kernel_replay_resource_empty_place() -> ProofKernelReplayResourcePlace:
            return ProofKernelReplayResourcePlace{root: "", path_root: 0, depth: 0, whole: false}

        def proof_kernel_replay_resource_place_add_field(parent: ProofKernelReplayResourcePlace, field: sview, field_root: usize) -> (known: bool, place: ProofKernelReplayResourcePlace):
            empty: ProofKernelReplayResourcePlace = proof_kernel_replay_resource_empty_place()
            return (false, empty) if parent.root == "" or field == "" or parent.depth >= 127
            return (true, ProofKernelReplayResourcePlace{root: parent.root, path_root: field_root, depth: parent.depth + 1, whole: false})

        def proof_kernel_replay_resource_place_add_index(parent: ProofKernelReplayResourcePlace, path_root: usize) -> (known: bool, place: ProofKernelReplayResourcePlace):
            empty: ProofKernelReplayResourcePlace = proof_kernel_replay_resource_empty_place()
            return (false, empty) if parent.root == "" or parent.depth >= 127
            return (true, ProofKernelReplayResourcePlace{root: parent.root, path_root: path_root, depth: parent.depth + 1, whole: false})

        # Field chains are stored outermost-first in the arena (`a.b.c` points at `c`, whose
        # left edge points at `a.b`). Recovering a component by ordinal keeps prefix checking
        # exact without hashing or putting an owned container in every place value.
        def proof_kernel_replay_resource_index_expression_valid(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, root: usize, depth: usize) -> bool:
            return false if depth >= 127 or root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return true if node.kind == "int" and node.operator == "" and node.left == 0 and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.name == "" and node.secondary_name == ""
            return true if node.kind == "ident" and node.name != "" and node.operator == "" and node.left == 0 and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.secondary_name == ""
            if node.kind == "unary" and (node.operator == "+" or node.operator == "-"):
                return node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name == "" and node.secondary_name == "" and proof_kernel_replay_resource_index_expression_valid(nodes, node.left, depth + 1)
            if node.kind == "binary" and (node.operator == "+" or node.operator == "-"):
                return node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.value == 0 and node.name == "" and node.secondary_name == "" and proof_kernel_replay_resource_index_expression_valid(nodes, node.left, depth + 1) and proof_kernel_replay_resource_index_expression_valid(nodes, node.right, depth + 1)
            return false

        def proof_kernel_replay_resource_path_component(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, path_root: usize, position: usize, depth: usize) -> (known: bool, kind: sview, field: sview, value: i64, expression_root: usize):
            requires depth <= 127
            decreases depth
            return (false, "", "", 0, 0) if depth == 0 or path_root >= nodes.count or not proof_kernel_replay_valid(nodes, path_root)
            located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, path_root)
            return (false, "", "", 0, 0) if not located.known
            node: ElisaProofKernelCore::ProofKernelNode = located.node
            if position + 1 == depth:
                return (true, "field", node.name, 0, 0) if node.kind == "field" and node.name != ""
                if node.kind == "index" and node.right < nodes.count:
                    index_value: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, node.right, 0)
                    return (true, "index", "", index_value.value, node.right) if index_value.known
                    return (true, "index", "", 0, node.right) if proof_kernel_replay_resource_index_expression_valid(nodes, node.right, 0)
                return (false, "", "", 0, 0)
            return (false, "", "", 0, 0) if position >= depth - 1
            return proof_kernel_replay_resource_path_component(nodes, node.left, position, depth - 1) if node.kind == "field" or node.kind == "index"
            return (false, "", "", 0, 0)

        # Compose a source place relative to an origin place. This is the small piece that lets
        # a callee's `parameter.field` effect become the caller's `argument.field` effect while
        # retaining the same bounded, fail-closed path representation.
        def proof_kernel_replay_resource_place_append[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, parent: ProofKernelReplayResourcePlace, relative: ProofKernelReplayResourcePlace) -> (known: bool, place: ProofKernelReplayResourcePlace):
            return (false, proof_kernel_replay_resource_empty_place()) if parent.root == "" or relative.root == "" or relative.depth >= 128
            assert(relative.depth <= 127)
            result: mutable ProofKernelReplayResourcePlace = parent
            for index in 0..<relative.depth |index, nodes, result, relative|:
                component: (known: bool, kind: sview, field: sview, value: i64, expression_root: usize) = proof_kernel_replay_resource_path_component(nodes, relative.path_root, index, relative.depth)
                return (false, proof_kernel_replay_resource_empty_place()) if not component.known
                next: mutable (known: bool, place: ProofKernelReplayResourcePlace) = (false, proof_kernel_replay_resource_empty_place())
                if component.kind == "field":
                    field_root: usize = ElisaProofKernelCore::add_node(nodes, "field", "", result.path_root if result.depth > 0 else 0, 0, 0, 0, 0, 0, component.field, "")
                    next <- proof_kernel_replay_resource_place_add_field(result, component.field, field_root)
                elif component.kind == "index":
                    index_root: usize = ElisaProofKernelCore::add_node(nodes, "index", "", result.path_root if result.depth > 0 else 0, component.expression_root, 0, 0, 0, 0, "", "")
                    next <- proof_kernel_replay_resource_place_add_index(result, index_root)
                else:
                    return (false, proof_kernel_replay_resource_empty_place())
                return next if not next.known
                result <- next.place
            return (true, result)

        def proof_kernel_replay_resource_place(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, depth: usize) -> (known: bool, place: ProofKernelReplayResourcePlace):
            empty: ProofKernelReplayResourcePlace = proof_kernel_replay_resource_empty_place()
            return (false, empty) if depth >= 128 or root >= nodes.count or not proof_kernel_replay_valid(nodes, root)
            located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, root)
            return (false, empty) if not located.known
            node: ElisaProofKernelCore::ProofKernelNode = located.node
            if node.kind == "ident":
                return (node.name != "", ProofKernelReplayResourcePlace{root: node.name, path_root: 0, depth: 0, whole: true})
            if node.kind == "field":
                parent: (known: bool, place: ProofKernelReplayResourcePlace) = proof_kernel_replay_resource_place(nodes, children, node.left, depth + 1)
                return proof_kernel_replay_resource_place_add_field(parent.place, node.name, root) if parent.known
            if node.kind == "index":
                parent: (known: bool, place: ProofKernelReplayResourcePlace) = proof_kernel_replay_resource_place(nodes, children, node.left, depth + 1)
                return (false, empty) if not parent.known
                return (false, empty) if not proof_kernel_replay_resource_index_expression_valid(nodes, node.right, 0)
                return proof_kernel_replay_resource_place_add_index(parent.place, root)
            if node.kind == "index-n":
                return (false, empty) if node.children_start > children.count or node.children_count == 0 or node.children_count > children.count - node.children_start
                parent: (known: bool, place: ProofKernelReplayResourcePlace) = proof_kernel_replay_resource_place(nodes, children, node.left, depth + 1)
                return (false, empty) if not parent.known
                result: mutable ProofKernelReplayResourcePlace = parent.place
                for offset in 0..<node.children_count |offset, node, children, nodes, result|:
                    child: (known: bool, value: usize) = proof_kernel_replay_child_at(children, node.children_start + offset)
                    return (false, empty) if not child.known
                    index_root: usize = ElisaProofKernelCore::add_node(nodes, "index", "", result.path_root if result.depth > 0 else 0, child.value, 0, 0, 0, 0, "", "")
                    next: (known: bool, place: ProofKernelReplayResourcePlace) = proof_kernel_replay_resource_place_add_index(result, index_root)
                    return (false, empty) if not next.known
                    result <- next.place
                return (true, result)
            return (false, empty)

        def proof_kernel_replay_resource_index_disjoint(state: ProofKernelReplayResourceState&, left_root: usize, right_root: usize) -> bool:
            for index in 0..<state.disjoint_left.count |index, state, left_root, right_root|:
                return true if index < state.disjoint_right.count and ((state.disjoint_left[index] == left_root and state.disjoint_right[index] == right_root) or (state.disjoint_left[index] == right_root and state.disjoint_right[index] == left_root))
            return false

        def proof_kernel_replay_resource_place_is_prefix(state: ProofKernelReplayResourceState&, nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, prefix: ProofKernelReplayResourcePlace, target: ProofKernelReplayResourcePlace) -> bool:
            return false if prefix.root == "" or target.root == "" or prefix.root != target.root
            return true if prefix.whole
            return false if target.whole or prefix.depth > target.depth or prefix.depth > 127 or target.depth > 127
            for index in 0..<prefix.depth:
                prefix_component: (known: bool, kind: sview, field: sview, value: i64, expression_root: usize) = proof_kernel_replay_resource_path_component(nodes, prefix.path_root, index, prefix.depth)
                target_component: (known: bool, kind: sview, field: sview, value: i64, expression_root: usize) = proof_kernel_replay_resource_path_component(nodes, target.path_root, index, target.depth)
                return false if not prefix_component.known or not target_component.known or prefix_component.kind != target_component.kind
                return false if prefix_component.kind == "field" and prefix_component.field != target_component.field
                if prefix_component.kind == "index":
                    if proof_kernel_replay_resource_index_expression_valid(nodes, prefix_component.expression_root, 0) and proof_kernel_replay_resource_index_expression_valid(nodes, target_component.expression_root, 0):
                        prefix_constant: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, prefix_component.expression_root, 0)
                        target_constant: ProofKernelReplayInt = proof_kernel_replay_constant_int(nodes, target_component.expression_root, 0)
                        return false if prefix_constant.known and target_constant.known and prefix_constant.value != target_constant.value
                    return false if proof_kernel_replay_resource_index_disjoint(state, prefix_component.expression_root, target_component.expression_root)
            return true

        def proof_kernel_replay_resource_places_overlap(state: ProofKernelReplayResourceState&, nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, left: ProofKernelReplayResourcePlace, right: ProofKernelReplayResourcePlace) -> bool:
            return proof_kernel_replay_resource_place_is_prefix(state, nodes, left, right) or proof_kernel_replay_resource_place_is_prefix(state, nodes, right, left)

        struct ProofKernelReplayResourceState:
            binding_names: mutable darray[sview]
            binding_reference: mutable darray[bool]
            binding_mutable_reference: mutable darray[bool]
            binding_writable: mutable darray[bool]
            binding_moved: mutable darray[bool]
            binding_region: mutable darray[sview]
            active_regions: mutable darray[sview]
            borrow_target_slots: mutable darray[usize]
            borrow_target_places: mutable darray[ProofKernelReplayResourcePlace]
            borrow_mutable: mutable darray[bool]
            borrow_present: mutable darray[bool]
            disjoint_left: mutable darray[usize]
            disjoint_right: mutable darray[usize]
            # Empty origin means body-local storage. A non-empty origin is a formal external
            # capability, possibly reached through one or more local borrow aliases.
            binding_origin_places: mutable darray[ProofKernelReplayResourcePlace]

        def proof_kernel_replay_resource_empty() -> ProofKernelReplayResourceState:
            return ProofKernelReplayResourceState{binding_names: [], binding_reference: [], binding_mutable_reference: [], binding_writable: [], binding_moved: [], binding_region: [], active_regions: [], borrow_target_slots: [], borrow_target_places: [], borrow_mutable: [], borrow_present: [], disjoint_left: [], disjoint_right: [], binding_origin_places: []}

        def proof_kernel_replay_resource_copy(source: ProofKernelReplayResourceState&, target: mutable ProofKernelReplayResourceState&) -> void:
            target.binding_names.clear()
            target.binding_reference.clear()
            target.binding_mutable_reference.clear()
            target.binding_writable.clear()
            target.binding_moved.clear()
            target.binding_region.clear()
            target.active_regions.clear()
            target.borrow_target_slots.clear()
            target.borrow_target_places.clear()
            target.borrow_mutable.clear()
            target.borrow_present.clear()
            target.disjoint_left.clear()
            target.disjoint_right.clear()
            target.binding_origin_places.clear()
            target.binding_names.extend(source.binding_names)
            target.binding_reference.extend(source.binding_reference)
            target.binding_mutable_reference.extend(source.binding_mutable_reference)
            target.binding_writable.extend(source.binding_writable)
            target.binding_moved.extend(source.binding_moved)
            target.binding_region.extend(source.binding_region)
            target.active_regions.extend(source.active_regions)
            target.borrow_target_slots.extend(source.borrow_target_slots)
            target.borrow_target_places.extend(source.borrow_target_places)
            target.borrow_mutable.extend(source.borrow_mutable)
            target.borrow_present.extend(source.borrow_present)
            target.disjoint_left.extend(source.disjoint_left)
            target.disjoint_right.extend(source.disjoint_right)
            target.binding_origin_places.extend(source.binding_origin_places)

        def proof_kernel_replay_resource_lookup(state: ProofKernelReplayResourceState&, name: sview) -> usize:
            index: mutable usize = state.binding_names.count
            while index > 0 |index, state, name|:
                index <- index - 1
                return index if state.binding_names[index] == name
            return state.binding_names.count

        def proof_kernel_replay_resource_region_active(state: ProofKernelReplayResourceState&, region: sview) -> bool:
            return false if region == ""
            index: mutable usize = state.active_regions.count
            while index > 0 |index, state, region|:
                index <- index - 1
                return true if state.active_regions[index] == region
            return false

        def proof_kernel_replay_resource_binding_region(state: ProofKernelReplayResourceState&, slot: usize) -> sview:
            return state.binding_region[slot] if slot < state.binding_region.count
            return ""

        def proof_kernel_replay_resource_has_borrow(state: ProofKernelReplayResourceState&, target_slot: usize, except_slot: usize) -> bool:
            for index in 0..<state.borrow_target_slots.count |index, state, target_slot, except_slot|:
                return true if index != except_slot and index < state.borrow_present.count and state.borrow_present[index] and state.borrow_target_slots[index] == target_slot
            return false

        def proof_kernel_replay_resource_has_mutable_borrow(state: ProofKernelReplayResourceState&, target_slot: usize, except_slot: usize) -> bool:
            for index in 0..<state.borrow_target_slots.count |index, state, target_slot, except_slot|:
                return true if index != except_slot and index < state.borrow_present.count and state.borrow_present[index] and state.borrow_target_slots[index] == target_slot and index < state.borrow_mutable.count and state.borrow_mutable[index]
            return false

        def proof_kernel_replay_resource_has_borrow_overlap(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, state: ProofKernelReplayResourceState&, target: ProofKernelReplayResourcePlace, except_slot: usize) -> bool:
            return false if target.root == ""
            for index in 0..<state.borrow_target_places.count |index, state, target, except_slot|:
                return true if index != except_slot and index < state.borrow_present.count and state.borrow_present[index] and proof_kernel_replay_resource_places_overlap(state, nodes, state.borrow_target_places[index], target)
            return false

        def proof_kernel_replay_resource_has_mutable_borrow_overlap(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, state: ProofKernelReplayResourceState&, target: ProofKernelReplayResourcePlace, except_slot: usize) -> bool:
            return false if target.root == ""
            for index in 0..<state.borrow_target_places.count |index, state, target, except_slot|:
                return true if index != except_slot and index < state.borrow_present.count and state.borrow_present[index] and index < state.borrow_mutable.count and state.borrow_mutable[index] and proof_kernel_replay_resource_places_overlap(state, nodes, state.borrow_target_places[index], target)
            return false

        def proof_kernel_replay_resource_origin_for(state: ProofKernelReplayResourceState&, slot: usize) -> (known: bool, place: ProofKernelReplayResourcePlace):
            empty: ProofKernelReplayResourcePlace = proof_kernel_replay_resource_empty_place()
            return (false, empty) if slot >= state.binding_origin_places.count
            origin: ProofKernelReplayResourcePlace = state.binding_origin_places[slot]
            return (origin.root != "", origin)

        def proof_kernel_replay_resource_resolve_origin(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, state: ProofKernelReplayResourceState&, decoded: ProofKernelReplayResourcePlace, binding_name: sview) -> (known: bool, place: ProofKernelReplayResourcePlace):
            empty: ProofKernelReplayResourcePlace = proof_kernel_replay_resource_empty_place()
            return (false, empty) if decoded.root == "" or decoded.root != binding_name
            slot: usize = proof_kernel_replay_resource_lookup(state, binding_name)
            return (false, empty) if slot >= state.binding_names.count
            origin: (known: bool, place: ProofKernelReplayResourcePlace) = proof_kernel_replay_resource_origin_for(state, slot)
            return (false, empty) if not origin.known
            return proof_kernel_replay_resource_place_append(nodes, origin.place, decoded)

        # Replay the ownership transition language without consulting the AST checker. A scope
        # node receives a copy of its parent's resource state. Ordinary lexical scopes discard
        # child transitions on return. Moves of inherited bindings are represented by explicit
        # resource-join-move transitions emitted after the scope, keeping the parent-state update
        # flat and replayable without aliasing the nested state object.
        def proof_kernel_replay_resource_events[@r, @e](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, roots: darray[usize]&, state: mutable ProofKernelReplayResourceState&, effects: mutable darray[ProofKernelReplayResourceEffect]& @e, depth: usize) -> bool:
            requires depth <= 127
            decreases 127 - depth
            return false if depth >= 127
            for root in roots |root, nodes, children, state, depth|:
                located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, root)
                return false if not located.known
                node: ElisaProofKernelCore::ProofKernelNode = located.node
                if node.kind == "resource-disjoint":
                    return false if node.operator != "!=" or node.left >= nodes.count or node.right >= nodes.count or node.auxiliary >= nodes.count
                    return false if not proof_kernel_replay_resource_index_expression_valid(nodes, node.left, 0) or not proof_kernel_replay_resource_index_expression_valid(nodes, node.right, 0)
                    goal_located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, node.auxiliary)
                    return false if not goal_located.known or goal_located.node.kind != "binary" or goal_located.node.operator != "!=" or goal_located.node.left != node.left or goal_located.node.right != node.right
                    return false if not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
                    proof_facts: mutable darray[usize] = []
                    for index in 0..<node.children_count |index, node, children, proof_facts|:
                        child: (known: bool, value: usize) = proof_kernel_replay_child_at(children, node.children_start + index)
                        return false if not child.known or child.value >= nodes.count
                        proof_facts.push(child.value)
                    return false if not proof_kernel_replay_arena_valid(nodes, children, proof_facts, node.auxiliary)
                    return false if not proof_kernel_replay_goal_depth(nodes, children, proof_facts, node.auxiliary, 0, 0)
                    state.disjoint_left.push(node.left)
                    state.disjoint_right.push(node.right)
                    continue
                if node.kind == "resource-scope":
                    return false if not proof_kernel_replay_child_range_valid(node.children_start, node.children_count, children.count)
                    child_roots: mutable darray[usize] = []
                    for index in 0..<node.children_count |index, node, children, child_roots|:
                        child: (known: bool, value: usize) = proof_kernel_replay_child_at(children, node.children_start + index)
                        return false if not child.known
                        child_roots.push(child.value)
                    child_state: mutable ProofKernelReplayResourceState = proof_kernel_replay_resource_empty()
                    proof_kernel_replay_resource_copy(state, &child_state)
                    return false if not proof_kernel_replay_resource_events(nodes, children, child_roots, &child_state, effects, depth + 1)
                    continue
                if node.kind == "resource-region-open":
                    return false if proof_kernel_replay_resource_region_active(state, node.name)
                    state.active_regions.push(node.name)
                    continue
                if node.kind == "resource-region-close":
                    return false if state.active_regions.count == 0
                    return false if state.active_regions[state.active_regions.count - 1] != node.name
                    state.active_regions <- state.active_regions.truncate(state.active_regions.count - 1)
                    continue
                if node.kind == "resource-region-alloc":
                    return false if not proof_kernel_replay_resource_region_active(state, node.secondary_name)
                    return false if not proof_kernel_replay_arena_valid(nodes, children, [], node.left)
                    state.binding_names.push(node.name)
                    state.binding_reference.push((node.auxiliary & 2) != 0)
                    state.binding_mutable_reference.push((node.auxiliary & 4) != 0)
                    state.binding_writable.push((node.auxiliary & 1) != 0)
                    state.binding_moved.push(false)
                    state.binding_region.push(node.secondary_name)
                    state.borrow_target_slots.push(state.binding_names.count - 1)
                    state.borrow_target_places.push(proof_kernel_replay_resource_empty_place())
                    state.borrow_mutable.push(false)
                    state.borrow_present.push(false)
                    state.binding_origin_places.push(proof_kernel_replay_resource_empty_place())
                    continue
                if node.kind == "resource-region-alloc-discard":
                    return false if not proof_kernel_replay_resource_region_active(state, node.secondary_name)
                    return false if not proof_kernel_replay_arena_valid(nodes, children, [], node.left)
                    continue
                if node.kind == "resource-region-rebind-alloc":
                    return false if not proof_kernel_replay_resource_region_active(state, node.secondary_name)
                    return false if not proof_kernel_replay_arena_valid(nodes, children, [], node.left)
                    target_slot: usize = proof_kernel_replay_resource_lookup(state, node.name)
                    return false if target_slot >= state.binding_names.count or target_slot >= state.binding_moved.count or state.binding_moved[target_slot]
                    return false if target_slot >= state.borrow_present.count or state.borrow_present[target_slot]
                    state.binding_region[target_slot] <- node.secondary_name
                    continue
                if node.kind == "resource-region-bind":
                    return false if not proof_kernel_replay_resource_region_active(state, node.secondary_name)
                    source: (known: bool, place: ProofKernelReplayResourcePlace) = proof_kernel_replay_resource_place(nodes, children, node.left, 0)
                    return false if not source.known
                    source_slot: usize = proof_kernel_replay_resource_lookup(state, source.place.root)
                    return false if source_slot >= state.binding_names.count or proof_kernel_replay_resource_binding_region(state, source_slot) != node.secondary_name
                    state.binding_names.push(node.name)
                    state.binding_reference.push((node.auxiliary & 2) != 0)
                    state.binding_mutable_reference.push((node.auxiliary & 4) != 0)
                    state.binding_writable.push((node.auxiliary & 1) != 0)
                    state.binding_moved.push(false)
                    state.binding_region.push(node.secondary_name)
                    state.borrow_target_slots.push(state.binding_names.count - 1)
                    state.borrow_target_places.push(proof_kernel_replay_resource_empty_place())
                    state.borrow_mutable.push(false)
                    state.borrow_present.push(false)
                    state.binding_origin_places.push(proof_kernel_replay_resource_empty_place())
                    continue
                if node.kind == "resource-region-assign":
                    return false if not proof_kernel_replay_resource_region_active(state, node.secondary_name)
                    source: (known: bool, place: ProofKernelReplayResourcePlace) = proof_kernel_replay_resource_place(nodes, children, node.left, 0)
                    return false if not source.known
                    source_slot: usize = proof_kernel_replay_resource_lookup(state, source.place.root)
                    target_slot: usize = proof_kernel_replay_resource_lookup(state, node.name)
                    return false if source_slot >= state.binding_names.count or target_slot >= state.binding_names.count
                    return false if proof_kernel_replay_resource_binding_region(state, source_slot) != node.secondary_name
                    state.binding_region[target_slot] <- node.secondary_name
                    continue
                if node.kind == "resource-bind":
                    is_reference: bool = node.operator == "shared" or node.operator == "mutable" or node.operator == "external-shared" or node.operator == "external-mutable"
                    is_mutable_reference: bool = node.operator == "mutable" or node.operator == "external-mutable"
                    target_slot: mutable usize = state.binding_names.count
                    borrow_is_present: mutable bool = false
                    source_place: mutable ProofKernelReplayResourcePlace = proof_kernel_replay_resource_empty_place()
                    origin_place: mutable ProofKernelReplayResourcePlace = proof_kernel_replay_resource_empty_place()
                    if node.operator == "shared" or node.operator == "mutable":
                        target_slot <- proof_kernel_replay_resource_lookup(state, node.secondary_name)
                        return false if target_slot >= state.binding_names.count
                        decoded: (known: bool, place: ProofKernelReplayResourcePlace) = proof_kernel_replay_resource_place(nodes, children, node.left, 0)
                        return false if not decoded.known or decoded.place.root != node.secondary_name
                        source_place <- decoded.place
                        borrow_is_present <- true
                        if node.operator == "mutable":
                            return false if node.auxiliary != 1
                            return false if proof_kernel_replay_resource_has_borrow_overlap(nodes, state, source_place, state.binding_names.count)
                        else:
                            return false if proof_kernel_replay_resource_has_mutable_borrow_overlap(nodes, state, source_place, state.binding_names.count)
                        source_origin: (known: bool, place: ProofKernelReplayResourcePlace) = proof_kernel_replay_resource_origin_for(state, target_slot)
                        if source_origin.known:
                            composed: (known: bool, place: ProofKernelReplayResourcePlace) = proof_kernel_replay_resource_place_append(nodes, source_origin.place, source_place)
                            origin_place <- composed.place if composed.known
                    elif node.operator == "external-shared" or node.operator == "external-mutable":
                        origin_place <- ProofKernelReplayResourcePlace{root: node.name, path_root: 0, depth: 0, whole: true}
                    state.binding_names.push(node.name)
                    state.binding_reference.push(is_reference)
                    state.binding_mutable_reference.push(is_mutable_reference)
                    state.binding_writable.push(node.auxiliary == 1)
                    state.binding_moved.push(false)
                    state.binding_region.push("")
                    state.borrow_target_slots.push(target_slot)
                    state.borrow_target_places.push(source_place)
                    state.borrow_mutable.push(is_mutable_reference)
                    state.borrow_present.push(borrow_is_present)
                    state.binding_origin_places.push(origin_place)
                    continue
                if node.kind == "resource-use":
                    decoded: (known: bool, place: ProofKernelReplayResourcePlace) = proof_kernel_replay_resource_place(nodes, children, node.left, 0)
                    return false if not decoded.known or not decoded.place.whole or decoded.place.root != node.name
                    slot: usize = proof_kernel_replay_resource_lookup(state, node.name)
                    return false if slot >= state.binding_names.count
                    region: sview = proof_kernel_replay_resource_binding_region(state, slot)
                    return false if region != "" and not proof_kernel_replay_resource_region_active(state, region)
                    return false if slot >= state.binding_moved.count or state.binding_moved[slot]
                    continue
                if node.kind == "resource-write":
                    decoded: (known: bool, place: ProofKernelReplayResourcePlace) = proof_kernel_replay_resource_place(nodes, children, node.left, 0)
                    return false if not decoded.known or decoded.place.root != node.name
                    slot: usize = proof_kernel_replay_resource_lookup(state, node.name)
                    return false if slot >= state.binding_names.count
                    region: sview = proof_kernel_replay_resource_binding_region(state, slot)
                    return false if region != "" and not proof_kernel_replay_resource_region_active(state, region)
                    return false if slot >= state.binding_moved.count or state.binding_moved[slot]
                    is_reference: bool = slot < state.binding_reference.count and state.binding_reference[slot]
                    is_mutable_reference: bool = slot < state.binding_mutable_reference.count and state.binding_mutable_reference[slot]
                    return false if is_reference and not is_mutable_reference
                    return false if not is_reference and proof_kernel_replay_resource_has_borrow_overlap(nodes, state, decoded.place, state.binding_names.count)
                    resolved_origin: (known: bool, place: ProofKernelReplayResourcePlace) = proof_kernel_replay_resource_resolve_origin(nodes, state, decoded.place, node.name)
                    effects.push(ProofKernelReplayResourceEffect{kind: "write", place: resolved_origin.place}) if resolved_origin.known
                    continue
                if node.kind == "resource-move":
                    decoded: (known: bool, place: ProofKernelReplayResourcePlace) = proof_kernel_replay_resource_place(nodes, children, node.left, 0)
                    return false if not decoded.known or decoded.place.root != node.name
                    slot: usize = proof_kernel_replay_resource_lookup(state, node.name)
                    return false if slot >= state.binding_names.count
                    region: sview = proof_kernel_replay_resource_binding_region(state, slot)
                    return false if region != "" and not proof_kernel_replay_resource_region_active(state, region)
                    return false if slot >= state.binding_moved.count or state.binding_moved[slot]
                    return false if slot < state.borrow_present.count and state.borrow_present[slot]
                    return false if proof_kernel_replay_resource_has_borrow_overlap(nodes, state, decoded.place, state.binding_names.count)
                    resolved_origin: (known: bool, place: ProofKernelReplayResourcePlace) = proof_kernel_replay_resource_resolve_origin(nodes, state, decoded.place, node.name)
                    effects.push(ProofKernelReplayResourceEffect{kind: "move", place: resolved_origin.place}) if resolved_origin.known
                    state.binding_moved[slot] <- true
                    continue
                if node.kind == "resource-join-move":
                    slot: usize = proof_kernel_replay_resource_lookup(state, node.name)
                    return false if slot >= state.binding_names.count
                    state.binding_moved[slot] <- true
                    continue
                if node.kind == "resource-call":
                    return false if not proof_kernel_replay_resource_call(nodes, children, state, effects, node, depth + 1)
                    continue
                return false
            return true

        def proof_kernel_replay_resource_parameters(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, names: mutable darray[sview]&, references: mutable darray[bool]&, mutable_references: mutable darray[bool]&) -> bool:
            located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, root)
            return false if not located.known or located.node.kind != "resource-safety"
            return false if located.node.auxiliary > located.node.children_count
            return false if not proof_kernel_replay_child_range_valid(located.node.children_start, located.node.children_count, children.count)
            for index in 0..<located.node.auxiliary |index, located, children, names, references, mutable_references|:
                child: (known: bool, value: usize) = proof_kernel_replay_child_at(children, located.node.children_start + index)
                return false if not child.known
                bind_located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, child.value)
                return false if not bind_located.known or bind_located.node.kind != "resource-bind"
                bind: ElisaProofKernelCore::ProofKernelNode = bind_located.node
                return false if bind.operator != "value" and bind.operator != "external-shared" and bind.operator != "external-mutable"
                return false if bind.name == "" or (any prior in names where prior == bind.name)
                names.push(bind.name)
                references.push(bind.operator == "external-shared" or bind.operator == "external-mutable")
                mutable_references.push(bind.operator == "external-mutable")
            return true

        def proof_kernel_replay_resource_call_actual(state: ProofKernelReplayResourceState&, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, argument: ElisaProofKernelCore::ProofKernelNode) -> (known: bool, place: ProofKernelReplayResourcePlace, slot: usize, has_slot: bool, mutable_reference: bool):
            empty: ProofKernelReplayResourcePlace = proof_kernel_replay_resource_empty_place()
            if argument.operator == "value":
                return (true, empty, state.binding_names.count, false, false)
            decoded: (known: bool, place: ProofKernelReplayResourcePlace) = proof_kernel_replay_resource_place(nodes, children, argument.left, 0)
            return (false, empty, state.binding_names.count, false, false) if not decoded.known
            slot: usize = proof_kernel_replay_resource_lookup(state, decoded.place.root)
            if argument.operator == "reference":
                return (false, empty, state.binding_names.count, false, false) if slot >= state.binding_names.count or slot >= state.binding_reference.count or not state.binding_reference[slot]
                return (false, empty, state.binding_names.count, false, false) if slot >= state.binding_moved.count or state.binding_moved[slot]
                if slot < state.borrow_present.count and state.borrow_present[slot] and slot < state.borrow_target_places.count and state.borrow_target_places[slot].root != "":
                    return (true, state.borrow_target_places[slot], slot, true, slot < state.binding_mutable_reference.count and state.binding_mutable_reference[slot])
                origin: (known: bool, place: ProofKernelReplayResourcePlace) = proof_kernel_replay_resource_origin_for(state, slot)
                return (false, empty, state.binding_names.count, false, false) if not origin.known
                return (true, origin.place, slot, true, slot < state.binding_mutable_reference.count and state.binding_mutable_reference[slot])
            return (false, empty, state.binding_names.count, false, false) if argument.operator != "borrow"
            return (false, empty, state.binding_names.count, false, false) if slot >= state.binding_names.count
            return (false, empty, state.binding_names.count, false, false) if slot >= state.binding_moved.count or state.binding_moved[slot]
            if slot < state.binding_reference.count and state.binding_reference[slot]:
                origin: (known: bool, place: ProofKernelReplayResourcePlace) = proof_kernel_replay_resource_origin_for(state, slot)
                return (false, empty, state.binding_names.count, false, false) if not origin.known
                composed: (known: bool, place: ProofKernelReplayResourcePlace) = proof_kernel_replay_resource_place_append(nodes, origin.place, decoded.place)
                return (false, empty, state.binding_names.count, false, false) if not composed.known
                return (true, composed.place, slot, false, slot < state.binding_mutable_reference.count and state.binding_mutable_reference[slot])
            return (true, decoded.place, slot, false, false)

        # Compose a verified callee trace at a call site. The callee is replayed from an empty
        # state first; only writes whose origin is one of its formal reference capabilities are
        # exported. A move cannot yet be summarized, so the kernel rejects it instead of
        # silently treating ownership transfer as an ordinary write.
        def proof_kernel_replay_resource_call[@r, @e](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, state: mutable ProofKernelReplayResourceState&, effects: mutable darray[ProofKernelReplayResourceEffect]& @e, call: ElisaProofKernelCore::ProofKernelNode, depth: usize) -> bool:
            requires depth <= 127
            decreases 127 - depth
            return false if depth >= 127
            callee: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, call.left)
            return false if not callee.known or callee.node.kind != "resource-safety" or callee.node.name != call.name or callee.node.secondary_name != "resource-v1"
            return false if not proof_kernel_replay_child_range_valid(callee.node.children_start, callee.node.children_count, children.count)
            formal_names: mutable darray[sview] = []
            formal_references: mutable darray[bool] = []
            formal_mutable_references: mutable darray[bool] = []
            return false if not proof_kernel_replay_resource_parameters(nodes, children, call.left, &formal_names, &formal_references, &formal_mutable_references)
            return false if call.auxiliary != formal_names.count or call.children_count != formal_names.count
            return false if not proof_kernel_replay_child_range_valid(call.children_start, call.children_count, children.count)
            seen: mutable darray[bool] = []
            actual_places: mutable darray[ProofKernelReplayResourcePlace] = []
            actual_slots: mutable darray[usize] = []
            actual_is_reference: mutable darray[bool] = []
            for _ in 0..<formal_names.count |seen, actual_places, actual_slots, actual_is_reference|:
                seen.push(false)
                actual_places.push(proof_kernel_replay_resource_empty_place())
                actual_slots.push(state.binding_names.count)
                actual_is_reference.push(false)
            for index in 0..<call.children_count |index, call, children, nodes, state, formal_names, formal_references, formal_mutable_references, seen, actual_places, actual_slots, actual_is_reference|:
                child: (known: bool, value: usize) = proof_kernel_replay_child_at(children, call.children_start + index)
                return false if not child.known
                argument_located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, child.value)
                return false if not argument_located.known or argument_located.node.kind != "resource-call-arg"
                argument: ElisaProofKernelCore::ProofKernelNode = argument_located.node
                formal_index: mutable usize = formal_names.count
                for candidate in 0..<formal_names.count |candidate, formal_names, argument, formal_index|:
                    formal_index <- candidate if formal_names[candidate] == argument.name
                return false if formal_index >= formal_names.count or seen[formal_index]
                seen[formal_index] <- true
                actual: (known: bool, place: ProofKernelReplayResourcePlace, slot: usize, has_slot: bool, mutable_reference: bool) = proof_kernel_replay_resource_call_actual(state, nodes, children, argument)
                return false if not actual.known
                if formal_references[formal_index]:
                    return false if argument.operator != "borrow" and argument.operator != "reference"
                    return false if actual.place.root == ""
                    if formal_mutable_references[formal_index]:
                        if argument.operator == "reference":
                            return false if not actual.mutable_reference
                        else:
                            return false if actual.slot >= state.binding_writable.count or not state.binding_writable[actual.slot] and not actual.mutable_reference
                        return false if proof_kernel_replay_resource_has_borrow_overlap(nodes, state, actual.place, actual.slot if argument.operator == "reference" else state.binding_names.count)
                    else:
                        return false if proof_kernel_replay_resource_has_mutable_borrow_overlap(nodes, state, actual.place, actual.slot if argument.operator == "reference" else state.binding_names.count)
                    actual_places[formal_index] <- actual.place
                    actual_slots[formal_index] <- actual.slot
                    actual_is_reference[formal_index] <- argument.operator == "reference"
                else:
                    return false if argument.operator != "value"
            for index in 0..<seen.count |index, seen|:
                return false if not seen[index]
            callee_roots: mutable darray[usize] = []
            for index in 0..<callee.node.children_count |index, callee, children, callee_roots|:
                child: (known: bool, value: usize) = proof_kernel_replay_child_at(children, callee.node.children_start + index)
                return false if not child.known
                callee_roots.push(child.value)
            callee_state: mutable ProofKernelReplayResourceState = proof_kernel_replay_resource_empty()
            callee_effects: mutable darray[ProofKernelReplayResourceEffect] = []
            return false if not proof_kernel_replay_resource_events(nodes, children, callee_roots, &callee_state, &callee_effects, depth + 1)
            for effect in callee_effects |effect, formal_names, formal_references, formal_mutable_references, actual_places, actual_slots, actual_is_reference, state, effects|:
                return false if effect.kind != "write"
                formal_index: mutable usize = formal_names.count
                for candidate in 0..<formal_names.count |candidate, formal_names, effect, formal_index|:
                    formal_index <- candidate if formal_names[candidate] == effect.place.root
                return false if formal_index >= formal_names.count or not formal_references[formal_index] or not formal_mutable_references[formal_index]
                mapped: (known: bool, place: ProofKernelReplayResourcePlace) = proof_kernel_replay_resource_place_append(nodes, actual_places[formal_index], effect.place)
                return false if not mapped.known or mapped.place.root == ""
                except_slot: mutable usize = state.binding_names.count
                except_slot <- actual_slots[formal_index] if actual_is_reference[formal_index]
                return false if proof_kernel_replay_resource_has_borrow_overlap(nodes, state, mapped.place, except_slot)
                owner_slot: usize = proof_kernel_replay_resource_lookup(state, mapped.place.root)
                return false if owner_slot >= state.binding_names.count
                owner_origin: (known: bool, place: ProofKernelReplayResourcePlace) = proof_kernel_replay_resource_resolve_origin(nodes, state, mapped.place, mapped.place.root)
                effects.push(ProofKernelReplayResourceEffect{kind: "write", place: owner_origin.place}) if owner_origin.known
            return true

        def proof_kernel_replay_resource_report_impl[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, facts: darray[usize], goal_root: usize) -> bool:
            return false if facts.count != 0
            return false if not proof_kernel_replay_arena_valid(nodes, children, facts, goal_root)
            located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, goal_root)
            return false if not located.known or located.node.kind != "resource-safety" or located.node.secondary_name != "resource-v1"
            return false if not proof_kernel_replay_child_range_valid(located.node.children_start, located.node.children_count, children.count)
            roots: mutable darray[usize] = []
            for index in 0..<located.node.children_count |index, located, children, roots|:
                child: (known: bool, value: usize) = proof_kernel_replay_child_at(children, located.node.children_start + index)
                return false if not child.known
                roots.push(child.value)
            state: mutable ProofKernelReplayResourceState = proof_kernel_replay_resource_empty()
            effects: mutable darray[ProofKernelReplayResourceEffect] = []
            return proof_kernel_replay_resource_events(nodes, children, roots, &state, &effects, 0)

        public:
            def proof_kernel_replay_resource_report[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, facts: darray[usize], goal_root: usize) -> bool:
                return proof_kernel_replay_resource_report_impl(nodes, children, facts, goal_root)

            # Public serialization boundary for callers that receive a source-neutral arena
            # from another process. Admission is deliberately separate from logical replay:
            # malformed roots, child slices, out-of-range edges, and cycles must be rejected
            # before any rule can inspect a term.
            def proof_kernel_replay_arena_report[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, facts: darray[usize], goal_root: usize) -> bool:
                return proof_kernel_replay_arena_valid(nodes, children, facts, goal_root)

            # This is the only structural comparison operation exposed to the report adapter.
            # Keeping the implementation private makes the module boundary explicit: callers
            # can ask the kernel to compare terms, but cannot depend on its internal state types.
            def proof_kernel_replay_expr_equal_public(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, left_root: usize, right_root: usize, depth: usize) -> bool:
                requires depth <= 127
                return proof_kernel_replay_expr_equal(nodes, children, left_root, right_root, depth)

            def proof_kernel_replay_goal_report[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, facts: darray[usize], goal_root: usize) -> bool:
                return false if not proof_kernel_replay_arena_valid(nodes, children, facts, goal_root)
                return proof_kernel_replay_goal_depth(nodes, children, facts, goal_root, 0, 0)

            def proof_kernel_replay_tactic_step[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, action: sview, accepted: bool, before_solved: bool, after_solved: bool, before_facts: darray[usize], before_goal: usize, after_facts: darray[usize], after_goal: usize, argument: usize, has_argument: bool, secondary: usize, has_secondary: bool, argument_index: usize, has_argument_index: bool, detail: sview) -> bool:
                return proof_kernel_replay_tactic_step_impl(nodes, children, action, accepted, before_solved, after_solved, before_facts, before_goal, after_facts, after_goal, argument, has_argument, secondary, has_secondary, argument_index, has_argument_index, detail)

            def proof_kernel_replay_tactic_branch[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, action: sview, parent_facts: darray[usize], parent_goal: usize, left_facts: darray[usize], left_goal: usize, right_facts: darray[usize], right_goal: usize) -> bool:
                return proof_kernel_replay_tactic_branch_report(nodes, children, action, parent_facts, parent_goal, left_facts, left_goal, right_facts, right_goal)

            # A checked-index certificate proves the memory-safety boundary supplied by Elisa's
            # `get collection[index] else fallback` operator. It is separate from arithmetic
            # goal replay: the selected element remains opaque, while replay validates only the
            # guarded load/fallback shape.
            def proof_kernel_replay_checked_index_report[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, facts: darray[usize], goal_root: usize) -> bool:
                return false if facts.count != 0
                return false if not proof_kernel_replay_arena_valid(nodes, children, facts, goal_root)
                checked_located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, goal_root)
                return false if not checked_located.known or checked_located.node.kind != "checked-index"
                checked_child: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, checked_located.node.left)
                return checked_child.known and checked_child.node.kind == "index"

            # A checked-get certificate proves the memory-safety boundary of
            # `get collection[index] else <control recovery>`. The recovery's termination and
            # state isolation are checked separately by the source-level control-flow pass.
            def proof_kernel_replay_checked_get_report[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, facts: darray[usize], goal_root: usize) -> bool:
                return false if facts.count != 0
                return false if not proof_kernel_replay_arena_valid(nodes, children, facts, goal_root)
                checked_located: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, goal_root)
                return false if not checked_located.known or checked_located.node.kind != "checked-get"
                checked_child: (known: bool, node: ElisaProofKernelCore::ProofKernelNode) = proof_kernel_replay_node_at(nodes, checked_located.node.left)
                return checked_child.known and checked_child.node.kind == "index" and checked_located.node.right == 0 and checked_located.node.operator == "" and checked_located.node.auxiliary == 0 and checked_located.node.children_start == 0 and checked_located.node.children_count == 0

            def proof_kernel_replay_quantifier_report[@r](nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r, kind: sview, facts: darray[usize], goal_root: usize) -> bool:
                return false if not proof_kernel_replay_arena_valid(nodes, children, facts, goal_root)
                return proof_kernel_replay_quantifier(nodes, children, kind, facts, goal_root)
