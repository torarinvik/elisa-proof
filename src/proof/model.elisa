# Stable public model for proof findings. The AST itself remains Ast::Expr/Stmt/Decl from
# elisa-compiler; this module only owns the proof report and the small symbolic state.
include "./model/extern_signatures.elisa"
include "./model/function_table_constructor.elisa"
module ElisaProof:
    public:
        # A flat proof certificate records the exact logical context accepted by the
        # obligation prover. Facts live in one report-owned arena so certificates do not
        # contain nested dynamic arrays; this also gives a future standalone kernel a stable
        # replay format to consume.
        struct ProofGoalCertificate:
            goal: Ast::Expr
            facts_start: usize
            facts_count: usize
            kernel_goal: usize
            kernel_facts_start: usize
            kernel_facts_count: usize
            line: u32
            name: sview
            rule: sview
            replayed: mutable bool
        # One decided call of the built-in decision procedure (check/goal_result_cache.elisa).
        # The key is the exact premise list (`facts_start`/`facts_count` into
        # `goal_cache_facts`), the goal, operator mask and float decision mode; `hash` only picks a probe path.
        struct ProofGoalCacheEntry:
            hash: u32
            goal: Ast::Expr
            facts_start: usize
            facts_count: usize
            operator_mask: usize
            float_mode: bool
            proven: bool
        struct ProofGoalAttempt:
            goal: Ast::Expr
            # True when the search ended because a fixed budget ran out rather than because no
            # rule applied. This never affects admission: an exhausted attempt is unproven either
            # way. It exists so a client is not told "unknown" when the honest answer is that the
            # obligation was never decided.
            budget_exhausted: mutable bool
            facts_start: usize
            facts_count: usize
            kernel_goal: usize
            kernel_facts_start: usize
            kernel_facts_count: usize
            line: u32
            name: sview
            rule: sview
            proven: bool
            has_certificate: bool
            certificate_index: usize
        # Provenance for a fact that entered a symbolic context. The expression is retained in
        # the report-owned AST region so the replay kernel can reject certificate facts that were
        # never introduced by a recognized proof-state transition.
        struct ProofFactTrace:
            expression: Ast::Expr
            kernel_expression: usize
            kind: sview
            line: u32
            name: sview
            dependency: sview
            premises_start: usize
            premises_count: usize
            kernel_premises_start: usize
            kernel_premises_count: usize
            summary_bindings_start: usize
            summary_bindings_count: usize
            summary_requires_start: usize
            summary_requires_count: usize
            summary_ensure_index: usize
            # Declaration line of the function a global-constant fact was imported for; 0 otherwise.
            owner_line: u32
        # Stable, source-backed declaration metadata for proof-state clients. This is
        # observational only: it is never consulted by the proof kernel when deciding whether
        # an obligation is valid. Contract counts and recursion/purity flags let an AI enumerate
        # candidate definitions without reparsing the imported source.
        struct ProofDeclarationSummary:
            kind: mutable sview
            name: mutable sview
            line: mutable u32
            parameters_start: mutable usize
            parameters_count: mutable usize
            requires_count: mutable usize
            ensures_count: mutable usize
            changes_count: mutable usize
            preserves_count: mutable usize
            decreases_count: mutable usize
            lemma: mutable bool
            recursive: mutable bool
            pure: mutable bool
            verified: mutable bool
            verification_reason: mutable sview
            structural: mutable bool
            # The declared `can[...]` row, as a flat slice into the report's effect names. This
            # is the source-declared row, not a derived one: what the body actually performs is
            # a separate obligation.
            effects_start: mutable usize
            effects_count: mutable usize
            effects_declared: mutable bool
        # Agent-facing theorem signatures. These are observational source summaries; theorem use
        # still goes through the checked lemma table and kernel-backed goal certificates.
        struct ProofTheoremSummary:
            name: sview
            line: u32
            parameters_start: usize
            parameters_count: usize
            requires_start: usize
            requires_count: usize
            ensures_start: usize
            ensures_count: usize
            decreases_start: usize
            decreases_count: usize
            proof_goals_start: usize
            proof_goals_count: usize
            recursive: bool
            verified: bool
            verification_reason: sview
        # Replay-owned executable contract signatures. These are separate from theorem summaries
        # because a function call may bind `result` and invalidate caller state, but its emitted
        # postcondition must still be reconstructed from the exact verified source contract.
        struct ProofExecutableSummary:
            name: sview
            line: u32
            parameters_start: usize
            parameters_count: usize
            requires_start: usize
            requires_count: usize
            ensures_start: usize
            ensures_count: usize
            pure: bool
            verified: bool
            verification_reason: sview

        struct ProofReport:
            declarations: mutable u32
            obligations: mutable u32
            proven: mutable u32
            failed: mutable u32
            # Compiler-owned enum annotations are the semantic source of truth for erased
            # syntax such as `forall` versus `exists`. Source-bound clients may inspect and
            # replay expressions in a fresh store, but must not replace these annotations with
            # labels supplied by an untrusted proof script.
            source_annotations: mutable darray[Ast::EnumAnnotation]
            # Lookup-only cache derived from the compiler-owned annotations. It is valid only
            # after a complete ordered build; otherwise callers use the authoritative slow scan.
            source_primitive_operator_mask: mutable usize
            operator_impl_index: mutable darray[ProofOperatorImpl]
            operator_impl_hashes: mutable darray[u32]
            operator_impl_bucket_heads: mutable darray[usize]
            operator_impl_next_indices: mutable darray[usize]
            operator_impl_index_valid: mutable bool
            source_declarations: mutable darray[Ast::Decl]
            # Exact compiler-admitted `transition[State](move value)` call spans. The
            # resource checker uses these to distinguish the intrinsic state retag from
            # ordinary indexed calls; source spelling alone never grants admission.
            protocol_transition_positions: mutable darray[Ast::Pos]
            # Byte offsets of the lexer's `pass` tokens. The parser lowers `pass` to an invalid
            # expression statement, as it does constructs that error recovery dropped, so a
            # checker may treat that statement as a no-op only when it spans one of these tokens.
            pass_statement_offsets: mutable darray[u32]
            # Spans of explicit `assert ?` proof holes, copied from the parsed file. The parser
            # lowers each one to the same invalid statement; a hole is an open obligation.
            assert_hole_positions: mutable darray[Ast::Pos]
            source_extern_parameters: mutable darray[Ast::ExternParam]
            findings: mutable darray[ProofFinding]
            focused_unrequested_findings: mutable darray[ProofFinding]
            # Flat, optional witness expressions for failed obligations. A finding owns a
            # contiguous range here instead of a nested array so JSON clients and a future
            # standalone checker can consume the report without lifetime-sensitive containers.
            counterexample_facts: mutable darray[Ast::Expr]
            goal_attempts: mutable darray[ProofGoalAttempt]
            linear_hints: mutable darray[i64]
            certificates: mutable darray[ProofGoalCertificate]
            certificate_facts: mutable darray[Ast::Expr]
            kernel_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]
            kernel_children: mutable darray[usize]
            kernel_budget_exhausted: mutable bool
            kernel_budget_reported: mutable bool
            # Replay admits the immutable report arena once before checking its many certificates.
            # This is a cache of that admission, never a proof fact or logical assumption.
            kernel_arena_validated: mutable bool
            kernel_certificate_facts: mutable darray[usize]
            kernel_fact_trace_premises: mutable darray[usize]
            fact_traces: mutable darray[ProofFactTrace]
            # Presentation-only origin index for certificate facts. The sentinel is the trace
            # count at cache-build time; storing a flat index avoids another record arena.
            fact_origin_trace_indices: mutable darray[usize]
            # Replay lookup index. Each owner name occupies one collision-safe hash slot whose
            # value is the newest trace for that owner; the parallel next array links older
            # traces without copying or reordering the authoritative trace records.
            fact_trace_index_hashes: mutable darray[u32]
            fact_trace_index_values: mutable darray[usize]
            fact_trace_next_indices: mutable darray[usize]
            # Exact per-function index of expressions already emitted with `type-bound`
            # provenance. This is scratch state: the certificate still keeps the authoritative
            # trace, but cleanup must not rescan every historical trace for each copied fact.
            type_bound_seen: mutable darray[Ast::Expr]
            # `proof_expr_shape_hash` of each entry, so a lookup compares only hash-equal entries.
            type_bound_seen_hashes: mutable darray[u32]
            type_bound_owner: mutable sview
            # Fact traces are retained for independent replay across the whole report, but a
            # certificate being built may only capture facts introduced during its current
            # function check. Keeping that lower bound here avoids searching every completed
            # function whenever a new goal copies its local context.
            fact_trace_active_start: mutable usize
            # Per-function guard for recursive frame/call analysis. Exceeding either bound only
            # loses completeness; it never turns an unchecked path into a trusted one.
            frame_call_steps: mutable usize
            frame_call_budget_reported: mutable bool
            resource_analysis_steps: mutable usize
            resource_analysis_budget_reported: mutable bool
            # Per-function guard for recursive control-flow state exploration. This is a work
            # budget rather than a proof assumption: exhaustion marks the path unsupported.
            return_analysis_steps: mutable usize
            return_analysis_step_budget: mutable usize
            return_analysis_budget_reported: mutable bool
            return_analysis_fact_state_budget: mutable usize
            # Width of the function's declared unsigned return type for the return-contract
            # boundary. This is scratch context, never a logical fact; zero means signed or
            # otherwise untyped. Return checking uses it only to prevent folding a wrapping
            # literal expression as signed `i64` arithmetic.
            current_return_unsigned_width: mutable i64
            current_return_signed_width: mutable i64
            fact_trace_premises: mutable darray[Ast::Expr]
            fact_trace_summary_names: mutable darray[sview]
            fact_trace_summary_values: mutable darray[Ast::Expr]
            fact_trace_summary_require_goal_ids: mutable darray[usize]
            # Parameter reference shape is replay metadata, not a proof assumption. Call-old
            # summaries use it to establish that their recorded entry snapshot belongs to a
            # reference parameter on both sides of the call.
            executable_parameter_references: mutable darray[bool]
            declaration_details: mutable darray[ProofDeclarationSummary]
            declaration_parameters: mutable darray[sview]
            theorem_summaries: mutable darray[ProofTheoremSummary]
            theorem_parameters: mutable darray[sview]
            theorem_parameter_types: mutable darray[Ast::Expr]
            theorem_parameter_has_defaults: mutable darray[bool]
            theorem_parameter_defaults: mutable darray[Ast::Expr]
            theorem_requires: mutable darray[Ast::Expr]
            theorem_ensures: mutable darray[Ast::Expr]
            theorem_decreases: mutable darray[Ast::Expr]
            theorem_proof_goal_ids: mutable darray[usize]
            executable_summaries: mutable darray[ProofExecutableSummary]
            executable_parameters: mutable darray[sview]
            executable_requires: mutable darray[Ast::Expr]
            executable_ensures: mutable darray[Ast::Expr]
            structural_names: mutable darray[sview]
            structural_subject_positions: mutable darray[usize]
            structural_subject_types: mutable darray[sview]
            structural_component_ids: mutable darray[usize]
            structural_members: mutable darray[bool]
            structural_verified_names: mutable darray[sview]
            # Fresh identities for lexical structural binders. Names alone are insufficient when
            # a pattern binder shadows the recursive parameter (`Node(value)` inside a function
            # whose parameter is also named `value`).
            structural_identity_next: mutable usize
            declaration_effects: mutable darray[sview]
            # Per-function scratch for call havoc: the locals of `aliased_owner` that may be
            # referenced somewhere in its body. A fact over other by-value scalar locals survives
            # an opaque call. Any other owner sees no stable names.
            aliased_names: mutable darray[sview]
            # The subset of `aliased_names` whose lend can outlive the call it was passed to. A
            # lend that cannot is still a write *during* its own call -- which is what
            # `aliased_names` answers -- but it leaves nothing behind that a later call could
            # reach, so a loop entered afterwards need not forget the binding.
            escaping_names: mutable darray[sview]
            # Per-function scratch for call havoc: the parameters of `aliased_owner` bound by a
            # shared borrow. Nothing may write through one for the parameter's lifetime, so its
            # element count is fixed for the whole frame and a fact mentioning it survives a call.
            # A mutable borrow, an owned binding and a local are all absent from this list.
            shared_extent_names: mutable darray[sview]
            # The subset of `shared_extent_names` whose pointee holds no reference or borrowed
            # view: every field place under one is fixed for the frame (`proof_record_shared_borrows`).
            shared_fixed_names: mutable darray[sview]
            # Per-function scratch for call havoc: the locals of `aliased_owner` that hold a
            # collection by value. A callee reaches caller state through arguments, a method
            # receiver, and globals; `aliased_names` already names every binding that is
            # referenced, received or passed to an unknown callee, so a local outside it that owns
            # its collection cannot be resized by any call. Reference-typed locals are excluded,
            # because the object behind one may be reachable by another path.
            local_extent_names: mutable darray[sview]
            # The subset of `local_extent_names` whose type is a plain value
            # (`proof_plain_value_type`): scalars, const enums, payload enums and structs built
            # only from those. Such a binding's text denotes one immutable value, so it may stand
            # as an argument of a witnessed pure call term.
            value_binding_names: mutable darray[sview]
            # Locals declared with a reference type. Assigning through one writes its referent,
            # which the substitution state cannot name, so such a write havocs all values.
            reference_local_names: mutable darray[sview]
            aliased_owner: mutable sview
            # Per-function scratch: locals of `aliased_owner` whose every declaration is a value
            # collection, one whose type holds no reference. A builtin call on one (`push`,
            # `extend`, ...) copies its arguments in, so it lends none of them.
            value_collection_names: mutable darray[sview]
            # Counts the fresh symbols a rebind has taken in the function being checked. Reset at
            # each function so the small literal pool is per frame, not per program.
            rebind_symbols: mutable usize
            # True while a goal is being decided case by case over a conditional (G75).
            conditional_split_active: mutable bool
            # Number of optional primitive-type witnesses emitted for the current function.
            # This is a completeness budget: when it is spent, congruence declines rather than
            # allowing an unbounded fact frame to consume the checker.
            scalar_witness_facts: mutable usize
            # Producer-side hash-consing index over shared kernel terms (kernel_intern.elisa).
            # Slots hold node indices and are candidates only; a hit is compared field by field.
            kernel_intern_slots: mutable darray[usize]
            kernel_intern_used: mutable usize
            # Measurement only: fresh nodes replaced by an identical existing term.
            kernel_interned_nodes: mutable usize
            # Run-local result cache of the built-in decision procedure. Never a proof fact: a hit
            # returns the boolean the procedure already returned for exactly the same inputs, and
            # certificate emission and kernel replay still run for it. See goal_result_cache.elisa.
            goal_cache_entries: mutable darray[ProofGoalCacheEntry]
            goal_cache_facts: mutable darray[Ast::Expr]
            goal_cache_slots: mutable darray[usize]
            goal_cache_annotations: mutable darray[Ast::EnumAnnotation]
            # Measurement only, never read by a decision.
            goal_cache_hits: mutable usize
            goal_cache_misses: mutable usize
            # Measurement only, never read by a decision: control-flow statements and branch
            # arms admitted by the step budget, and the largest fact state seen at one of them.
            measured_control_flow_steps: mutable usize
            measured_live_facts_peak: mutable usize
            replayed: mutable u32
            replay_gaps: mutable u32
            # Declaration line stamped on global-constant traces while importing them.
            trace_owner_line: mutable u32
            # Indices of the "global-constant" traces, so the per-statement constant check scans
            # these few rather than every trace of the function.
            global_constant_trace_ids: mutable darray[usize]
            # Declaration line of the function whose certificate replay is validating facts.
            replay_owner_line: mutable u32
            # The function being checked and its innermost module, stamped on findings that
            # name it so same-named functions of different modules keep separate verdicts.
            finding_function: mutable sview
            finding_owner: mutable sview

        # A frame place is either a whole reference root (`changes box`) or a bounded field
        # path (`changes box.inner.value`). The fixed path slots keep frame summaries flat and
        # replayable in the self-hosted checker; paths deeper than the supported bound are
        # rejected rather than approximated. An empty root is an intentionally conservative
        # wildcard used for compiler signature metadata that records only a field name.
        struct ProofFramePlace:
            root: sview
            field: sview
            field2: sview
            field3: sview
            depth: usize
            whole: bool

        # A per-import hash index over alias and struct declarations. Float-type auditing uses
        # it to inspect only declarations reachable from each signature.
        struct ProofTypeAuditDeclaration:
            declaration: Ast::Decl
            name_hash: u32

        struct ProofTypeAuditIndex:
            entries: mutable darray[ProofTypeAuditDeclaration]
            bucket_heads: mutable darray[usize]
            next_indices: mutable darray[usize]
            complete: mutable bool

        # Frame contract annotations are grouped by owner once per import. Head/tail links keep
        # each owner's source order while avoiding a whole annotation-table scan per function.
        struct ProofFrameAnnotationIndex:
            owner_names: mutable darray[sview]
            owner_hashes: mutable darray[u32]
            slot_values: mutable darray[usize]
            head_indices: mutable darray[usize]
            tail_indices: mutable darray[usize]
            annotation_indices: mutable darray[usize]
            next_indices: mutable darray[usize]

        # Function summaries are deliberately separate from lemma summaries. A lemma call is
        # proof-only and preserves the caller's facts; an executable call may invalidate every
        # caller fact unless a frame-condition tier proves preservation. Recursive SCCs are
        # tracked separately; only edges within a recursive component with checked decreases
        # measures may use an inductive summary.
        struct ProofFunctionTable:
            # Separate source signatures: never included in body/purity/SCC slots.
            extern_signatures: mutable darray[ProofExternSignature]
            type_audit_index: mutable ProofTypeAuditIndex
            enum_index: mutable ProofEnumIndex
            frame_annotation_index: mutable ProofFrameAnnotationIndex
            names: mutable darray[sview]
            # Declaration lines and innermost owning module names are aligned with names. A
            # qualified call `Module::name` whose bare name repeats resolves through them.
            lines: mutable darray[u32]
            owner_modules: mutable darray[sview]
            # The length of each row's declaration-path prefix that ends at its innermost module,
            # 0 for a top-level function. Two rows share a module exactly when these prefixes
            # are equal; a module name alone cannot tell apart two nested modules spelled alike.
            module_prefixes: mutable darray[usize]
            # Source paths are aligned with names. The scheduler retrieves each body from the
            # authoritative source declaration tree without retaining a second function-AST copy.
            declaration_path_starts: mutable darray[usize]
            declaration_path_counts: mutable darray[usize]
            all_declaration_path: mutable darray[usize]
            name_hashes: mutable darray[u32]
            index_hashes: mutable darray[u32]
            index_values: mutable darray[usize]
            param_starts: mutable darray[usize]
            param_counts: mutable darray[usize]
            all_params: mutable darray[sview]
            all_parameter_mutable: mutable darray[bool]
            all_has_defaults: mutable darray[bool]
            all_defaults: mutable darray[Ast::Expr]
            # Whether each parameter's declared type is a reference. A local passed to such a
            # parameter is implicitly referenced and may be written by the callee.
            all_parameter_references: mutable darray[bool]
            # Whether each parameter's declared reference type is mutable. A shared reference is
            # read-only by Elisa's type system, which is what lets a call that hands over only
            # shared references leave the caller's resource state untouched.
            all_parameter_mutable_references: mutable darray[bool]
            # Cached per-parameter type audit: floating-point rejection is a declaration property,
            # and recomputing it for every scheduled summary made large imports quadratic.
            all_parameter_may_contain_float: mutable darray[bool]
            # Signed width of a parameter declared as a bare signed primitive, else zero.
            all_parameter_signed_widths: mutable darray[i64]
            # Whether the storage each parameter names -- the type with an outer reference
            # stripped -- can hold a reference anywhere inside it, and the same for the return
            # type as declared. A callee can only store a reference it was lent into a place whose
            # type can hold one, so a lend to a callee whose every *other* parameter names such a
            # place, and whose return does too, cannot outlive the call.
            all_parameter_target_reference_free: mutable darray[bool]
            # Region-polymorphic function metadata. Region parameters are source-level lifetime
            # variables (`[@r]`), while all_param_regions records the explicit `@r` pin on each
            # value parameter. These are metadata only; calls still need a replayed region map.
            region_param_starts: mutable darray[usize]
            region_param_counts: mutable darray[usize]
            all_region_params: mutable darray[sview]
            all_param_region_starts: mutable darray[usize]
            all_param_regions: mutable darray[sview]
            # Explicit local `name: T @region` pins preserved by the parser's side table. The
            # resource checker uses these to model region-allocated values and views derived
            # from them; source types alone do not retain the `@region` suffix.
            local_region_binding_names: mutable darray[sview]
            local_region_binding_regions: mutable darray[sview]
            local_region_binding_lines: mutable darray[u32]
            # Loop-header accumulators (`|acc: T = init|`): typed immutable, assigned by the loop.
            loop_accumulator_names: mutable darray[sview]
            loop_accumulator_offsets: mutable darray[u32]
            # The imported return shape tells a call that consumes a borrow and returns a plain
            # value from one that propagates a reference. It is source metadata, never a proof:
            # a borrow-carrying call still needs the callee's verified executable summary.
            return_references: mutable darray[bool]
            return_reference_free: mutable darray[bool]
            return_mutable_references: mutable darray[bool]
            return_reference_parameters: mutable darray[usize]
            return_regions: mutable darray[sview]
            # Exact by-value sview results select a shared-borrow rule, validated again by replay.
            return_sviews: mutable darray[bool]
            # Primitive return shape for witnessing verified total-pure calls; not proof evidence.
            return_scalar: mutable darray[bool]
            # A named-tuple return's field labels in element order, so `result.f` projects.
            return_label_starts: mutable darray[usize]
            return_label_counts: mutable darray[usize]
            all_return_labels: mutable darray[sview]
            requires_starts: mutable darray[usize]
            requires_counts: mutable darray[usize]
            all_requires: mutable darray[Ast::Expr]
            ensure_starts: mutable darray[usize]
            ensure_counts: mutable darray[usize]
            all_ensures: mutable darray[Ast::Expr]
            changes_starts: mutable darray[usize]
            changes_counts: mutable darray[usize]
            all_changes: mutable darray[ProofFramePlace]
            preserves_starts: mutable darray[usize]
            preserves_counts: mutable darray[usize]
            all_preserves: mutable darray[ProofFramePlace]
            decreases_starts: mutable darray[usize]
            decreases_counts: mutable darray[usize]
            all_decreases: mutable darray[Ast::Expr]
            decreases_unbounded: mutable darray[bool]
            structural: mutable darray[bool]
            structural_subject_positions: mutable darray[usize]
            structural_subject_types: mutable darray[sview]
            call_starts: mutable darray[usize]
            call_counts: mutable darray[usize]
            all_calls: mutable darray[sview]
            # Aligned with all_calls: the module qualifier the call was written with ("" for a
            # bare call) and the row the call resolves to from its caller (names.count when
            # unresolved). Bare names repeat across modules, so the graph reads the targets.
            all_call_qualifiers: mutable darray[sview]
            all_call_targets: mutable darray[usize]
            # The row whose body is being checked, or names.count outside a scheduled function
            # body. Unqualified calls resolve from this caller's module.
            current_caller: mutable usize
            recursive: mutable darray[bool]
            recursive_component_ids: mutable darray[usize]
            # Local purity is computed before the call-graph fixed point, so every member of a
            # recursive component is checked against one declaration-local certificate.
            direct_pure: mutable darray[bool]
            pure: mutable darray[bool]
            deterministic: mutable darray[bool]
            # Declared `can[...]` rows. A function with no row is not the same as one with an
            # empty row: the first says nothing, the second says it performs no declared effect.
            effect_starts: mutable darray[usize]
            effect_counts: mutable darray[usize]
            all_effects: mutable darray[sview]
            effects_declared: mutable darray[bool]
            # Runtime summaries are available only after the callee's own proof converges.
            verified: mutable darray[bool]
            verification_reasons: mutable darray[sview]

        def proof_empty_report() -> ProofReport:
