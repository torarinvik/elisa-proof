# Stable public model for proof findings. The AST itself remains Ast::Expr/Stmt/Decl from
# elisa-compiler; this module only owns the proof report and the small symbolic state.
include "./model/extern_signatures.elisa"
include "./model/analysis_budgets.elisa"
include "./model/source_effect_index.elisa"
include "./model/frame_annotation_index.elisa"
include "./model/function_index_types.elisa"
include "./model/fact_origin_snapshot.elisa"
include "./model/fact_call_shape_snapshot.elisa"
include "./model/linear_hint_index.elisa"
include "./model/obligation_entry.elisa"
include "./model/structural_table.elisa"
include "./model/type_bound_scratch.elisa"
module ElisaProof:
    public:
        # A flat proof certificate records the exact logical context accepted by the
        # obligation prover. Facts live in one report-owned arena so certificates do not
        # contain nested dynamic arrays; this also gives a future standalone kernel a stable
        # replay format to consume.
        struct ProofGoalCertificate:
            goal: Ast::Expr
            facts_start: usize
            facts_count: usize
            kernel_goal: usize
            kernel_facts_start: usize
            kernel_facts_count: usize
            line: u32
            name: sview
            rule: sview
            # Source phase for loop-invariant obligations. It is not a proof rule; replay
            # checks the phase against the exact loop contract before using the certificate.
            source_phase: sview = ""
            source_call_position: mutable Ast::Pos = Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}
            private:
                replayed: mutable bool
        # Run-local result cache of the built-in decision procedure. Never a proof fact: a hit
        # returns the boolean the procedure already returned for exactly the same inputs, and
        # certificate emission and kernel replay still run for it. See goal_result_cache.elisa.
        struct ProofGoalCache:
            entries: mutable darray[ProofGoalCacheEntry] = []
            facts: mutable darray[Ast::Expr] = []
            slots: mutable darray[usize] = []
            annotations: mutable darray[Ast::EnumAnnotation] = []
            # Exact annotation comparisons are required for cache correctness. Keep their
            # cumulative cost bounded; once spent, the optimization is disabled for this run.
            annotation_work: mutable usize = 0
            annotation_bytes: mutable usize = 0
            annotations_disabled: mutable bool = false
            # Hashing, exact key comparison, and table probes share one run-wide allowance.
            # Exhausting it disables only the optimization; the built-in solver still runs.
            query_work_used: mutable usize = 0
            cache_disabled: mutable bool = false
            # Measurement only, never read by a decision.
            hits: mutable usize = 0
            misses: mutable usize = 0

        # One decided call of the built-in decision procedure (check/goal_result_cache.elisa).
        # The key is the exact premise list (`facts_start`/`facts_count` into
        # `goal_cache.facts`), the goal, operator mask and float decision mode; `hash` only picks a probe path.
        struct ProofGoalCacheEntry:
            hash: u32
            goal: Ast::Expr
            facts_start: usize
            facts_count: usize
            operator_mask: usize
            float_mode: bool
            proven: bool
        struct ProofGoalAttempt:
            goal: Ast::Expr
            # True when the search ended because a fixed budget ran out rather than because no
            # rule applied. This never affects admission: an exhausted attempt is unproven either
            # way. It exists so a client is not told "unknown" when the honest answer is that the
            # obligation was never decided.
            budget_exhausted: mutable bool
            facts_start: usize
            facts_count: usize
            kernel_goal: usize
            kernel_facts_start: usize
            kernel_facts_count: usize
            line: u32
            name: sview
            rule: sview
            source_phase: sview = ""
            source_call_position: mutable Ast::Pos = Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}
            # Producer search result only. Admission requires an immutable replay receipt and
            # source correspondence from ProofCheckedView; this field is not proof authority.
            proven: bool
            has_certificate: bool
            certificate_index: usize
        # Provenance for a fact that entered a symbolic context. The expression is retained in
        # the report-owned AST region so the replay kernel can reject certificate facts that were
        # never introduced by a recognized proof-state transition.
        struct ProofFactTrace:
            expression: Ast::Expr
            kernel_expression: usize
            kind: sview
            line: u32
            name: sview
            dependency: sview
            premises_start: usize
            premises_count: usize
            kernel_premises_start: usize
            kernel_premises_count: usize
            summary_bindings_start: usize
            summary_bindings_count: usize
            summary_requires_start: usize
            summary_requires_count: usize
            summary_ensure_index: usize
            # Declaration line of the function a global-constant fact was imported for; 0 otherwise.
            owner_line: u32
            # Exact source call that introduced a function- or lemma-summary trace; zero for other facts.
            source_call_position: mutable Ast::Pos = Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}
        # Stable, source-backed declaration metadata for proof-state clients. This is
        # observational only: it is never consulted by the proof kernel when deciding whether
        # an obligation is valid. Contract counts and recursion/purity flags let an AI enumerate
        # candidate definitions without reparsing the imported source.
        struct ProofDeclarationSummary:
            kind: mutable sview
            name: mutable sview
            line: mutable u32
            parameters_start: mutable usize
            parameters_count: mutable usize
            requires_count: mutable usize
            ensures_count: mutable usize
            changes_count: mutable usize
            preserves_count: mutable usize
            decreases_count: mutable usize
            lemma: mutable bool
            recursive: mutable bool
            pure: mutable bool
            verified: mutable bool
            verification_reason: mutable sview
            structural: mutable bool
            # The declared `can[...]` row, as a flat slice into the report's effect names. This
            # is the source-declared row, not a derived one: what the body actually performs is
            # a separate obligation.
            effects_start: mutable usize
            effects_count: mutable usize
            effects_declared: mutable bool
        # Agent-facing theorem signatures. These are observational source summaries; theorem use
        # still goes through the checked lemma table and kernel-backed goal certificates.
        struct ProofTheoremSummary:
            name: sview
            line: u32
            parameters_start: usize
            parameters_count: usize
            requires_start: usize
            requires_count: usize
            ensures_start: usize
            ensures_count: usize
            decreases_start: usize
            decreases_count: usize
            proof_goals_start: usize
            proof_goals_count: usize
            recursive: bool
            verified: bool
            verification_reason: sview
        # Replay-owned executable contract signatures. These are separate from theorem summaries
        # because a function call may bind `result` and invalidate caller state, but its emitted
        # postcondition must still be reconstructed from the exact verified source contract.
        struct ProofExecutableSummary:
            name: sview
            line: u32
            parameters_start: usize
            parameters_count: usize
            requires_start: usize
            requires_count: usize
            ensures_start: usize
            ensures_count: usize
            pure: bool
            verified: bool
            verification_reason: sview

        # The report's kernel term arena: the nodes certificates and traces point into, the
        # per-certificate fact and premise index pools, and the producer's interning index.
        struct ProofKernelArena:
            nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
            children: mutable darray[usize] = []
            budget_exhausted: mutable bool = false
            budget_reported: mutable bool = false
            # Replay admits the immutable report arena once before checking its many certificates.
            # This is a cache of that admission, never a proof fact or logical assumption.
            arena_validated: mutable bool = false
            certificate_facts: mutable darray[usize] = []
            fact_trace_premises: mutable darray[usize] = []
            # Producer-side hash-consing index over shared kernel terms (kernel_intern.elisa).
            # Slots hold node indices and are candidates only; a hit is compared field by field.
            intern_slots: mutable darray[usize] = []
            intern_used: mutable usize = 0
            # Optional producer-side hash-consing work shared across all encoded goals.
            intern_work_used: mutable usize = 0
            intern_work_exhausted: mutable bool = false
            # Measurement only: fresh nodes replaced by an identical existing term.
            interned_nodes: mutable usize = 0

        # Fact provenance for independent replay: the authoritative trace records plus the
        # flat pools their premise/summary ranges index, and a lookup index over owners.
        struct ProofFactTraceStore:
            records: mutable darray[ProofFactTrace] = []
            # Presentation-only origin index for certificate facts. The sentinel is the trace
            # count at cache-build time. `origin_snapshots` binds each hit to the fact and
            # returned trace metadata observed when replay built this index.
            origin_indices: mutable darray[usize] = []
            private:
                origin_snapshots: mutable darray[ProofFactOriginSnapshot] = []
            public:
                # Replay lookup index. Each owner name occupies one collision-safe hash slot whose
                # value is the newest trace for that owner; the parallel next array links older
                # traces without copying or reordering the authoritative trace records. The separate
                # expression index narrows source-fact lookups while preserving this owner-only chain
                # for category scans. Each table reserves at most two slots per admitted trace.
                index_hashes: mutable darray[u32] = []
                index_values: mutable darray[usize] = []
                next_indices: mutable darray[usize] = []
                # A second collision-safe table narrows source-fact lookup by the owner plus the
                # equality-preserving AST shape hash. Exact replay equality still decides matches.
                expression_index_hashes: mutable darray[u32] = []
                expression_index_values: mutable darray[usize] = []
                expression_hashes: mutable darray[u32] = []
                next_expression_indices: mutable darray[usize] = []
                # Aggregate replay lookup work across both indexes, origin caching and later walks.
                # Rebuilt for each public replay batch; never treated as proof evidence.
                lookup_work_used: mutable usize = 0
                # Fact traces are retained for independent replay across the whole report, but a
                # certificate being built may only capture facts introduced during its current
                # function check. Keeping that lower bound here avoids searching every completed
                # function whenever a new goal copies its local context.
                active_start: mutable usize = 0
                premises: mutable darray[Ast::Expr] = []
                summary_names: mutable darray[sview] = []
                summary_values: mutable darray[Ast::Expr] = []
                summary_require_goal_ids: mutable darray[usize] = []

        # Theorem summaries plus the flat arrays their start/count ranges index.
        struct ProofTheoremTable:
            summaries: mutable darray[ProofTheoremSummary] = []
            parameters: mutable darray[sview] = []
            parameter_types: mutable darray[Ast::Expr] = []
            parameter_has_defaults: mutable darray[bool] = []
            parameter_defaults: mutable darray[Ast::Expr] = []
            requires: mutable darray[Ast::Expr] = []
            ensures: mutable darray[Ast::Expr] = []
            decreases: mutable darray[Ast::Expr] = []
            proof_goal_ids: mutable darray[usize] = []

        # Executable-function summaries plus the flat arrays their ranges index.
        struct ProofExecutableTable:
            summaries: mutable darray[ProofExecutableSummary] = []
            parameters: mutable darray[sview] = []
            # Parameter reference shape is replay metadata, not a proof assumption. Call-old
            # summaries use it to establish that their recorded entry snapshot belongs to a
            # reference parameter on both sides of the call.
            parameter_references: mutable darray[bool] = []
            requires: mutable darray[Ast::Expr] = []
            ensures: mutable darray[Ast::Expr] = []

        struct ProofReportResults:
            declarations: mutable u32 = 0
            obligations: mutable u32 = 0
            proven: mutable u32 = 0
            failed: mutable u32 = 0
            findings: mutable darray[ProofFinding] = []
            focused_unrequested_findings: mutable darray[ProofFinding] = []
            # Flat, optional witness expressions for failed obligations. A finding owns a
            # contiguous range here instead of a nested array so JSON clients and a future
            # standalone checker can consume the report without lifetime-sensitive containers.
            counterexample_facts: mutable darray[Ast::Expr] = []
            goal_attempts: mutable darray[ProofGoalAttempt] = []
            # Append-only accounting witness for every call to proof_obligation. This ledger is
            # independent of the aggregate totals and the subset of obligations with goal rows.
            obligation_inventory: mutable darray[ProofObligationEntry] = []

        struct ProofReportSource:
            # Compiler-owned enum annotations are the semantic source of truth for erased
            # syntax such as `forall` versus `exists`. Source-bound clients may inspect and
            # replay expressions in a fresh store, but must not replace these annotations with
            # labels supplied by an untrusted proof script.
            source_annotations: mutable darray[Ast::EnumAnnotation] = []
            # Raw decorator arguments are source-owned side-table data referenced by
            # `Ast::Annotation.arg_start`; replay needs them to validate trust markers.
            source_annotation_args: mutable darray[sview] = []
            # Lookup-only cache derived from the compiler-owned annotations. It is valid only
            # after a complete ordered build; otherwise callers use the authoritative slow scan.
            source_primitive_operator_mask: mutable usize = PROOF_SOURCE_OPERATOR_MASK_EMPTY
            # Source operator protocols that may dispatch through an implementation.
            source_operator_protocol_mask: mutable usize = 0
            source_declarations: mutable darray[Ast::Decl] = []
            private:
                # Set only by the source-aware checking entry point after it confirms that the
                # captured parser file is the exact Ast::File checked by the proof engine.
                source_file_identity: mutable uintptr = 0
                source_analysis_bound: mutable bool = false

        struct ProofReportAnalysis1:
            operator_impls: mutable ProofOperatorImplIndex = ProofOperatorImplIndex{}
            frame_producer: mutable ProofFrameProducerWorkspace = ProofFrameProducerWorkspace{}
            linear_hints: mutable darray[i64] = []
            private:
                linear_hint_index: mutable ProofLinearHintIndex = ProofLinearHintIndex{}
            public:
                certificates: mutable darray[ProofGoalCertificate] = []
                certificate_facts: mutable darray[Ast::Expr] = []
                kernel: mutable ProofKernelArena = ProofKernelArena{}
                traces: mutable ProofFactTraceStore = ProofFactTraceStore{}
                type_bounds: mutable ProofTypeBoundScratch = ProofTypeBoundScratch{}
                budgets: mutable ProofAnalysisBudgets = ProofAnalysisBudgets{}
                declaration_details: mutable darray[ProofDeclarationSummary] = []
                declaration_parameters: mutable darray[sview] = []
                theorems: mutable ProofTheoremTable = ProofTheoremTable{}
                executables: mutable ProofExecutableTable = ProofExecutableTable{}
                structural: mutable ProofStructuralTable = ProofStructuralTable{}
                declaration_effects: mutable darray[sview] = []

        struct ProofReportSourceTypes:
            # Generic binders are kept as source-derived rows for conservative type-alias
            # resolution. The arrays must remain parallel, as in the parser-owned Ast::File.
            source_generic_param_lines: mutable darray[u32] = []
            source_generic_param_names: mutable darray[sview] = []
            source_generic_params_valid: mutable bool = false
            source_metadata_work_used: mutable usize = 0
            # Source-derived destructor and callable facts; replay rebuilds this cache.
            source_effect_index: mutable ProofSourceEffectIndex = ProofSourceEffectIndex{}
            private:
                source_const_enum_members: mutable ProofConstEnumMemberIndex = ProofConstEnumMemberIndex{}

        struct ProofReportSourceContracts:
            # Signature contracts are held in compiler file side tables rather than in each
            # function declaration. Preserve them with the source snapshot so replay can rebuild
            # the same call graph used by structural mutual-recursion checking.
            source_signature_contract_lines: mutable darray[u32] = []
            source_signature_contract_kinds: mutable darray[sview] = []
            source_signature_contracts: mutable darray[Ast::Expr] = []
            source_region_param_lines: mutable darray[u32] = []
            source_extern_parameters: mutable darray[Ast::ExternParam] = []

        struct ProofReportSourceSyntax:
            # Exact compiler-admitted `transition[State](move value)` call spans. The
            # resource checker uses these to distinguish the intrinsic state retag from
            # ordinary indexed calls; source spelling alone never grants admission.
            protocol_transition_positions: mutable darray[Ast::Pos] = []
            # Byte offsets of the lexer's `pass` tokens. The parser lowers `pass` to an invalid
            # expression statement, as it does constructs that error recovery dropped, so a
            # checker may treat that statement as a no-op only when it spans one of these tokens.
            pass_statement_offsets: mutable darray[u32] = []
            # Spans of explicit `assert ?` proof holes, copied from the parsed file. The parser
            # lowers each one to the same invalid statement; a hole is an open obligation.
            assert_hole_positions: mutable darray[Ast::Pos] = []

        struct ProofReportContext:
            current_source_postcondition_count: mutable usize = 0
            current_source_postcondition_line: mutable u32 = 0
            current_source_postcondition_name: mutable sview = ""
            focused_function: mutable sview = ""
            public:
                # Width of the function's declared unsigned return type for the return-contract
                # boundary. This is scratch context, never a logical fact; zero means signed or
                # otherwise untyped. Return checking uses it only to prevent folding a wrapping
                # literal expression as signed `i64` arithmetic.
                current_return_unsigned_width: mutable i64 = 0
                current_return_signed_width: mutable i64 = 0
                # True while a goal is being decided case by case over a conditional (G75).
                conditional_split_active: mutable bool = false
            private:
                # Set only while the checker records a loop invariant entry/preservation goal.
                # This annotation is copied into attempts and certificates, then revalidated from
                # source during replay; it is never a logical rule.
                current_loop_invariant_phase: mutable sview = ""

        struct ProofReportAliases:
            public:
                # Per-function scratch for call havoc: the locals of `aliased_owner` that may be
                # referenced somewhere in its body. A fact over other by-value scalar locals survives
                # an opaque call. Any other owner sees no stable names.
                aliased_names: mutable darray[sview] = []
                # The subset of `aliased_names` whose lend can outlive the call it was passed to. A
                # lend that cannot is still a write *during* its own call -- which is what
                # `aliased_names` answers -- but it leaves nothing behind that a later call could
                # reach, so a loop entered afterwards need not forget the binding.
                escaping_names: mutable darray[sview] = []
                # Per-function scratch for call havoc: the parameters of `aliased_owner` bound by a
                # shared borrow. Nothing may write through one for the parameter's lifetime, so its
                # element count is fixed for the whole frame and a fact mentioning it survives a call.
                # A mutable borrow, an owned binding and a local are all absent from this list.
                shared_extent_names: mutable darray[sview] = []
                # The subset of `shared_extent_names` whose pointee holds no reference or borrowed
                # view: every field place under one is fixed for the frame (`proof_record_shared_borrows`).
                shared_fixed_names: mutable darray[sview] = []
                # Per-function scratch for call havoc: the locals of `aliased_owner` that hold a
                # collection by value. A callee reaches caller state through arguments, a method
                # receiver, and globals; `aliased_names` already names every binding that is
                # referenced, received or passed to an unknown callee, so a local outside it that owns
                # its collection cannot be resized by any call. Reference-typed locals are excluded,
                # because the object behind one may be reachable by another path.
                local_extent_names: mutable darray[sview] = []
                # The subset of `local_extent_names` whose type is a plain value
                # (`proof_plain_value_type`): scalars, const enums, payload enums and structs built
                # only from those. Such a binding's text denotes one immutable value, so it may stand
                # as an argument of a witnessed pure call term.
                value_binding_names: mutable darray[sview] = []
                # Locals declared with a reference type. Assigning through one writes its referent,
                # which the substitution state cannot name, so such a write havocs all values.
                reference_local_names: mutable darray[sview] = []
                aliased_owner: mutable sview = ""
                # Per-function scratch: locals of `aliased_owner` whose every declaration is a value
                # collection, one whose type holds no reference. A builtin call on one (`push`,
                # `extend`, ...) copies its arguments in, so it lends none of them.
                value_collection_names: mutable darray[sview] = []

        struct ProofReportThreading:
            public:
                # Counts the fresh symbols a rebind has taken in the function being checked. Reset at
                # each function so the small literal pool is per frame, not per program.
                rebind_symbols: mutable usize = 0
                # Scratch from the last applied call that threaded exclusive `&` arguments: each
                # caller local and the fresh symbol now naming its post-call value (value_threading).
                threaded_names: mutable darray[sview] = []
                threaded_values: mutable darray[Ast::Expr] = []
                # Exit symbols of threaded calls in the function being checked: constants naming one
                # call's post value, so they survive later calls like any other logical constant.
                threaded_symbols: mutable darray[sview] = []
                # Exit symbols appended to the function summaries being recorded for a threaded call.
                summary_threaded_symbols: mutable darray[sview] = []
                # Set only around the statement and assignment calls whose callers apply threading.
                value_thread_site: mutable bool = false

        struct ProofReportAnalysis2:
            public:
                # Number of optional primitive-type witnesses emitted for the current function.
                # This is a completeness budget: when it is spent, congruence declines rather than
                # allowing an unbounded fact frame to consume the checker.
                scalar_witness_facts: mutable usize = 0
                # Run-local result cache of the built-in decision procedure (ProofGoalCache).
                goal_cache: mutable ProofGoalCache = ProofGoalCache{}
            private:
                replayed: mutable u32 = 0
                replay_gaps: mutable u32 = 0
                # Declaration line stamped on global-constant traces while importing them.
                trace_owner_line: mutable u32 = 0
                # One-based active certificate index while independently validating fact provenance; 0 outside replay.
                trace_consumer_certificate_index: mutable usize = 0
                # One-based active open-attempt context used for source-tactic fact checks; 0 outside that snapshot.
                trace_consumer_attempt_index: mutable usize = 0
                # Indices of the "global-constant" traces, so the per-statement constant check scans
                # these few rather than every trace of the function.
                global_constant_trace_ids: mutable darray[usize] = []
                # Source-derived call resolution used by the generic fact publishers. This is
                # private scratch bound to the exact checked source; clients cannot forge a
                # leaf-name-to-return-shape map.
                fact_call_shapes: mutable ProofFactCallShapeSnapshot = ProofFactCallShapeSnapshot{}
                # Declaration line of the function whose certificate replay is validating facts.
                replay_owner_line: mutable u32 = 0
                # The function being checked and its innermost module, stamped on findings that
                # name it so same-named functions of different modules keep separate verdicts.
                finding_function: mutable sview = ""
                finding_owner: mutable sview = ""
                finding_line: mutable u32 = 0
                finding_caller_index: mutable usize = 0

        struct ProofReport:
            results: mutable ProofReportResults = ProofReportResults{}
            source: mutable ProofReportSource = ProofReportSource{}
            analysis_1: mutable ProofReportAnalysis1 = ProofReportAnalysis1{}
            source_types: mutable ProofReportSourceTypes = ProofReportSourceTypes{}
            source_contracts: mutable ProofReportSourceContracts = ProofReportSourceContracts{}
            source_syntax: mutable ProofReportSourceSyntax = ProofReportSourceSyntax{}
            context: mutable ProofReportContext = ProofReportContext{}
            aliases: mutable ProofReportAliases = ProofReportAliases{}
            threading: mutable ProofReportThreading = ProofReportThreading{}
            analysis_2: mutable ProofReportAnalysis2 = ProofReportAnalysis2{}

        # A frame place is either a whole reference root (`changes box`) or a bounded field
        # path (`changes box.inner.value`). The fixed path slots keep frame summaries flat and
        # replayable in the self-hosted checker; paths deeper than the supported bound are
        # rejected rather than approximated. An empty root is an intentionally conservative
        # wildcard used for compiler signature metadata that records only a field name.
        struct ProofFramePlace:
            root: sview
            field: sview
            field2: sview
            field3: sview
            depth: usize
            whole: bool


        def proof_empty_report() -> ProofReport:
            return ProofReport{}

include "./model/function_table_types.elisa"
include "./model/function_table_constructor.elisa"

include "./model/frame_producer.elisa"
include "./model/report_recording.elisa"
include "./model/replay_receipt.elisa"
