# Stable public model for proof findings. The AST itself remains Ast::Expr/Stmt/Decl from
# elisa-compiler; this module only owns the proof report and the small symbolic state.
module ElisaProof:
    public:
        struct ProofFinding:
            kind: sview
            # A diagnostic's status is refined after the fact when the goal attempt it is bound to
            # ended on a resource limit, so it is mutable like the goal binding below.
            status: mutable sview
            line: u32
            name: sview
            message: sview
            counterexample_start: usize
            counterexample_count: usize
            counterexample_found: bool
            goal_id: mutable usize
            has_goal: mutable bool

        # A flat proof certificate records the exact logical context accepted by the
        # obligation prover. Facts live in one report-owned arena so certificates do not
        # contain nested dynamic arrays; this also gives a future standalone kernel a stable
        # replay format to consume.
        struct ProofGoalCertificate:
            goal: Ast::Expr
            facts_start: usize
            facts_count: usize
            kernel_goal: usize
            kernel_facts_start: usize
            kernel_facts_count: usize
            line: u32
            name: sview
            rule: sview
            replayed: mutable bool

        struct ProofGoalAttempt:
            goal: Ast::Expr
            # True when the search ended because a fixed budget ran out rather than because no
            # rule applied. This never affects admission: an exhausted attempt is unproven either
            # way. It exists so a client is not told "unknown" when the honest answer is that the
            # obligation was never decided.
            budget_exhausted: mutable bool
            facts_start: usize
            facts_count: usize
            kernel_goal: usize
            kernel_facts_start: usize
            kernel_facts_count: usize
            line: u32
            name: sview
            rule: sview
            proven: bool
            has_certificate: bool
            certificate_index: usize

        # Provenance for a fact that entered a symbolic context. The expression is retained in
        # the report-owned AST region so the replay kernel can reject certificate facts that were
        # never introduced by a recognized proof-state transition.
        struct ProofFactTrace:
            expression: Ast::Expr
            kernel_expression: usize
            kind: sview
            line: u32
            name: sview
            dependency: sview
            premises_start: usize
            premises_count: usize
            kernel_premises_start: usize
            kernel_premises_count: usize
            summary_bindings_start: usize
            summary_bindings_count: usize
            summary_requires_start: usize
            summary_requires_count: usize
            summary_ensure_index: usize

        # Stable, source-backed declaration metadata for proof-state clients. This is
        # observational only: it is never consulted by the proof kernel when deciding whether
        # an obligation is valid. Contract counts and recursion/purity flags let an AI enumerate
        # candidate definitions without reparsing the imported source.
        struct ProofDeclarationSummary:
            kind: mutable sview
            name: mutable sview
            line: mutable u32
            parameters_start: mutable usize
            parameters_count: mutable usize
            requires_count: mutable usize
            ensures_count: mutable usize
            changes_count: mutable usize
            preserves_count: mutable usize
            decreases_count: mutable usize
            lemma: mutable bool
            recursive: mutable bool
            pure: mutable bool
            verified: mutable bool
            verification_reason: mutable sview
            structural: mutable bool
            # The declared `can[...]` row, as a flat slice into the report's effect names. This
            # is the source-declared row, not a derived one: what the body actually performs is
            # a separate obligation.
            effects_start: mutable usize
            effects_count: mutable usize
            effects_declared: mutable bool

        # Agent-facing theorem signatures. These are observational source summaries; theorem use
        # still goes through the checked lemma table and kernel-backed goal certificates.
        struct ProofTheoremSummary:
            name: sview
            line: u32
            parameters_start: usize
            parameters_count: usize
            requires_start: usize
            requires_count: usize
            ensures_start: usize
            ensures_count: usize
            decreases_start: usize
            decreases_count: usize
            proof_goals_start: usize
            proof_goals_count: usize
            recursive: bool
            verified: bool
            verification_reason: sview

        # Replay-owned executable contract signatures. These are separate from theorem summaries
        # because a function call may bind `result` and invalidate caller state, but its emitted
        # postcondition must still be reconstructed from the exact verified source contract.
        struct ProofExecutableSummary:
            name: sview
            line: u32
            parameters_start: usize
            parameters_count: usize
            requires_start: usize
            requires_count: usize
            ensures_start: usize
            ensures_count: usize
            verified: bool
            verification_reason: sview

        struct ProofReport:
            declarations: mutable u32
            obligations: mutable u32
            proven: mutable u32
            failed: mutable u32
            # Compiler-owned enum annotations are the semantic source of truth for erased
            # syntax such as `forall` versus `exists`. Source-bound clients may inspect and
            # replay expressions in a fresh store, but must not replace these annotations with
            # labels supplied by an untrusted proof script.
            source_annotations: mutable darray[Ast::EnumAnnotation]
            source_declarations: mutable darray[Ast::Decl]
            findings: mutable darray[ProofFinding]
            # Flat, optional witness expressions for failed obligations. A finding owns a
            # contiguous range here instead of a nested array so JSON clients and a future
            # standalone checker can consume the report without lifetime-sensitive containers.
            counterexample_facts: mutable darray[Ast::Expr]
            goal_attempts: mutable darray[ProofGoalAttempt]
            certificates: mutable darray[ProofGoalCertificate]
            certificate_facts: mutable darray[Ast::Expr]
            kernel_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]
            kernel_children: mutable darray[usize]
            kernel_certificate_facts: mutable darray[usize]
            kernel_fact_trace_premises: mutable darray[usize]
            fact_traces: mutable darray[ProofFactTrace]
            fact_trace_premises: mutable darray[Ast::Expr]
            fact_trace_summary_names: mutable darray[sview]
            fact_trace_summary_values: mutable darray[Ast::Expr]
            fact_trace_summary_require_goal_ids: mutable darray[usize]
            declaration_details: mutable darray[ProofDeclarationSummary]
            declaration_parameters: mutable darray[sview]
            theorem_summaries: mutable darray[ProofTheoremSummary]
            theorem_parameters: mutable darray[sview]
            theorem_parameter_types: mutable darray[Ast::Expr]
            theorem_parameter_has_defaults: mutable darray[bool]
            theorem_parameter_defaults: mutable darray[Ast::Expr]
            theorem_requires: mutable darray[Ast::Expr]
            theorem_ensures: mutable darray[Ast::Expr]
            theorem_decreases: mutable darray[Ast::Expr]
            theorem_proof_goal_ids: mutable darray[usize]
            executable_summaries: mutable darray[ProofExecutableSummary]
            executable_parameters: mutable darray[sview]
            executable_requires: mutable darray[Ast::Expr]
            executable_ensures: mutable darray[Ast::Expr]
            structural_names: mutable darray[sview]
            structural_subject_positions: mutable darray[usize]
            structural_subject_types: mutable darray[sview]
            structural_component_ids: mutable darray[usize]
            structural_members: mutable darray[bool]
            structural_verified_names: mutable darray[sview]
            declaration_effects: mutable darray[sview]
            # Per-function scratch for call havoc: the locals of `aliased_owner` that may be
            # referenced somewhere in its body. A fact over other by-value scalar locals survives
            # an opaque call. Any other owner sees no stable names.
            aliased_names: mutable darray[sview]
            aliased_owner: mutable sview
            replayed: mutable u32
            replay_gaps: mutable u32

        # A frame place is either a whole reference root (`changes box`) or a bounded field
        # path (`changes box.inner.value`). The fixed path slots keep frame summaries flat and
        # replayable in the self-hosted checker; paths deeper than the supported bound are
        # rejected rather than approximated. An empty root is an intentionally conservative
        # wildcard used for compiler signature metadata that records only a field name.
        struct ProofFramePlace:
            root: sview
            field: sview
            field2: sview
            field3: sview
            depth: usize
            whole: bool

        # Flat lemma summaries keep all source expressions in the compiler-owned AST region
        # while avoiding nested dynamic arrays whose lifetimes are harder for the Elisa region
        # checker to prove. The layout mirrors the compiler's own lemma summary tables.
        struct ProofLemmaTable:
            names: mutable darray[sview]
            name_hashes: mutable darray[u32]
            index_hashes: mutable darray[u32]
            index_values: mutable darray[usize]
            param_starts: mutable darray[usize]
            param_counts: mutable darray[usize]
            all_params: mutable darray[sview]
            all_has_defaults: mutable darray[bool]
            all_defaults: mutable darray[Ast::Expr]
            requires_starts: mutable darray[usize]
            requires_counts: mutable darray[usize]
            all_requires: mutable darray[Ast::Expr]
            ensure_starts: mutable darray[usize]
            ensure_counts: mutable darray[usize]
            all_ensures: mutable darray[Ast::Expr]
            decreases_starts: mutable darray[usize]
            decreases_counts: mutable darray[usize]
            all_decreases: mutable darray[Ast::Expr]
            decreases_unbounded: mutable darray[bool]
            call_starts: mutable darray[usize]
            call_counts: mutable darray[usize]
            all_calls: mutable darray[sview]
            recursive: mutable darray[bool]
            recursive_component_ids: mutable darray[usize]
            # Proof-only summaries are certified before callers may consume their ensures.
            verified: mutable darray[bool]
            verification_reasons: mutable darray[sview]

        # Function summaries are deliberately separate from lemma summaries. A lemma call is
        # proof-only and preserves the caller's facts; an executable call may invalidate every
        # caller fact unless a frame-condition tier proves preservation. Recursive SCCs are
        # tracked separately; only edges within a recursive component with checked decreases
        # measures may use an inductive summary.
        struct ProofFunctionTable:
            names: mutable darray[sview]
            name_hashes: mutable darray[u32]
            index_hashes: mutable darray[u32]
            index_values: mutable darray[usize]
            param_starts: mutable darray[usize]
            param_counts: mutable darray[usize]
            all_params: mutable darray[sview]
            all_parameter_mutable: mutable darray[bool]
            all_has_defaults: mutable darray[bool]
            all_defaults: mutable darray[Ast::Expr]
            # Whether each parameter's declared type is a reference. A local passed to such a
            # parameter is implicitly referenced and may be written by the callee.
            all_parameter_references: mutable darray[bool]
            # Whether each parameter's declared reference type is mutable. A shared reference is
            # read-only by Elisa's type system, which is what lets a call that hands over only
            # shared references leave the caller's resource state untouched.
            all_parameter_mutable_references: mutable darray[bool]
            # Region-polymorphic function metadata. Region parameters are source-level lifetime
            # variables (`[@r]`), while all_param_regions records the explicit `@r` pin on each
            # value parameter. These are metadata only; calls still need a replayed region map.
            region_param_starts: mutable darray[usize]
            region_param_counts: mutable darray[usize]
            all_region_params: mutable darray[sview]
            all_param_region_starts: mutable darray[usize]
            all_param_regions: mutable darray[sview]
            # The resource checker needs the imported return shape to distinguish a call that
            # consumes a borrow and returns a plain value from one that propagates a reference.
            # This is source metadata, never a proof by itself; the callee still needs a verified
            # executable summary before a borrow-carrying call can be admitted.
            return_references: mutable darray[bool]
            return_mutable_references: mutable darray[bool]
            return_reference_parameters: mutable darray[usize]
            return_regions: mutable darray[sview]
            # Whether the declared return type resolved to a primitive scalar. Consulted only to
            # witness the result of a verified total-pure call; it proves nothing by itself.
            return_scalar: mutable darray[bool]
            requires_starts: mutable darray[usize]
            requires_counts: mutable darray[usize]
            all_requires: mutable darray[Ast::Expr]
            ensure_starts: mutable darray[usize]
            ensure_counts: mutable darray[usize]
            all_ensures: mutable darray[Ast::Expr]
            changes_starts: mutable darray[usize]
            changes_counts: mutable darray[usize]
            all_changes: mutable darray[ProofFramePlace]
            preserves_starts: mutable darray[usize]
            preserves_counts: mutable darray[usize]
            all_preserves: mutable darray[ProofFramePlace]
            decreases_starts: mutable darray[usize]
            decreases_counts: mutable darray[usize]
            all_decreases: mutable darray[Ast::Expr]
            decreases_unbounded: mutable darray[bool]
            structural: mutable darray[bool]
            structural_subject_positions: mutable darray[usize]
            structural_subject_types: mutable darray[sview]
            call_starts: mutable darray[usize]
            call_counts: mutable darray[usize]
            all_calls: mutable darray[sview]
            recursive: mutable darray[bool]
            recursive_component_ids: mutable darray[usize]
            # Local purity is computed before the call-graph fixed point. Keeping it separate
            # lets every member of a mutually recursive component be checked against the same
            # declaration-local certificate instead of depending on traversal order.
            direct_pure: mutable darray[bool]
            pure: mutable darray[bool]
            # Declared `can[...]` rows. A function with no row is not the same as one with an
            # empty row: the first says nothing, the second says it performs no declared effect.
            effect_starts: mutable darray[usize]
            effect_counts: mutable darray[usize]
            all_effects: mutable darray[sview]
            effects_declared: mutable darray[bool]
            # Runtime summaries are available only after the callee's own proof converges.
            verified: mutable darray[bool]
            verification_reasons: mutable darray[sview]

        def proof_empty_report() -> ProofReport:
            return ProofReport{declarations: 0, obligations: 0, proven: 0, failed: 0, source_annotations: [], source_declarations: [], findings: [], counterexample_facts: [], goal_attempts: [], certificates: [], certificate_facts: [], kernel_nodes: [], kernel_children: [], kernel_certificate_facts: [], kernel_fact_trace_premises: [], fact_traces: [], fact_trace_premises: [], fact_trace_summary_names: [], fact_trace_summary_values: [], fact_trace_summary_require_goal_ids: [], declaration_details: [], declaration_parameters: [], theorem_summaries: [], theorem_parameters: [], theorem_parameter_types: [], theorem_parameter_has_defaults: [], theorem_parameter_defaults: [], theorem_requires: [], theorem_ensures: [], theorem_decreases: [], theorem_proof_goal_ids: [], executable_summaries: [], executable_parameters: [], executable_requires: [], executable_ensures: [], structural_names: [], structural_subject_positions: [], structural_subject_types: [], structural_component_ids: [], structural_members: [], structural_verified_names: [], declaration_effects: [], aliased_names: [], aliased_owner: "", replayed: 0, replay_gaps: 0}

        def proof_empty_lemmas() -> ProofLemmaTable:
            return ProofLemmaTable{names: [], name_hashes: [], index_hashes: [], index_values: [], param_starts: [], param_counts: [], all_params: [], all_has_defaults: [], all_defaults: [], requires_starts: [], requires_counts: [], all_requires: [], ensure_starts: [], ensure_counts: [], all_ensures: [], decreases_starts: [], decreases_counts: [], all_decreases: [], decreases_unbounded: [], call_starts: [], call_counts: [], all_calls: [], recursive: [], recursive_component_ids: [], verified: [], verification_reasons: []}

        def proof_empty_functions() -> ProofFunctionTable:
            return ProofFunctionTable{names: [], name_hashes: [], index_hashes: [], index_values: [], param_starts: [], param_counts: [], all_params: [], all_parameter_mutable: [], all_has_defaults: [], all_defaults: [], all_parameter_references: [], all_parameter_mutable_references: [], region_param_starts: [], region_param_counts: [], all_region_params: [], all_param_region_starts: [], all_param_regions: [], return_references: [], return_mutable_references: [], return_reference_parameters: [], return_regions: [], return_scalar: [], requires_starts: [], requires_counts: [], all_requires: [], ensure_starts: [], ensure_counts: [], all_ensures: [], changes_starts: [], changes_counts: [], all_changes: [], preserves_starts: [], preserves_counts: [], all_preserves: [], decreases_starts: [], decreases_counts: [], all_decreases: [], decreases_unbounded: [], structural: [], structural_subject_positions: [], structural_subject_types: [], call_starts: [], call_counts: [], all_calls: [], recursive: [], recursive_component_ids: [], direct_pure: [], pure: [], effect_starts: [], effect_counts: [], all_effects: [], effects_declared: [], verified: [], verification_reasons: []}

        # Mark the most recent goal attempt as ended by a resource limit, and reclassify its
        # diagnostic from "unknown" to "timeout" so a client can tell an undecided obligation from
        # one the kernel decided it could not prove.
        def proof_mark_latest_attempt_exhausted(report: mutable ProofReport&, exhausted: bool) -> void:
            return if not exhausted or report.goal_attempts.count == 0
            report.goal_attempts[report.goal_attempts.count - 1].budget_exhausted <- true

        def proof_latest_attempt_exhausted(report: ProofReport&) -> bool:
            return false if report.goal_attempts.count == 0
            return report.goal_attempts[report.goal_attempts.count - 1].budget_exhausted

        def proof_finding_status(kind: sview) -> sview:
            return "disproved" if kind == "borrow-alias-conflict" or kind == "borrow-move-conflict" or kind == "borrow-mutable-source" or kind == "borrow-readonly-write" or kind == "borrow-write-conflict" or kind == "resource-use-after-move" or kind == "region-use-after-destroy" or kind == "frame-preserve-violated" or kind == "frame-preserve-write" or kind == "frame-write-outside" or kind == "frame-call-outside"
            return "unsupported" if kind == "borrow-call-opaque" or kind == "borrow-call-summary-unsupported" or kind == "borrow-contract-unsupported" or kind == "borrow-escape" or kind == "borrow-source-opaque" or kind == "call-old-opaque" or kind == "catch-arm-unsupported" or kind == "contract-call-unsupported" or kind == "contract-expression-unsupported" or kind == "contract-resource-unsupported" or kind == "control-flow-unsupported" or kind == "declaration-unsupported" or kind == "expression-unsupported" or kind == "frame-call-opaque" or kind == "frame-expression-opaque" or kind == "frame-preserve-opaque" or kind == "frame-spec-opaque" or kind == "frame-write-opaque" or kind == "function-summary-unverified" or kind == "index-bounds-opaque" or kind == "lemma-impure" or kind == "lemma-malformed" or kind == "lemma-recursive-unsupported" or kind == "lemma-result-unbound" or kind == "lemma-return" or kind == "loop-condition-opaque" or kind == "loop-decreases-malformed" or kind == "loop-invariant-scope" or kind == "parallel-control-flow-unsupported" or kind == "parallel-state-unsupported" or kind == "pattern-unsupported" or kind == "proof-malformed" or kind == "recursive-summary-unsupported" or kind == "slice-bounds-opaque" or kind == "statement-unsupported" or kind == "region-alias-unsupported" or kind == "region-allocation-unsupported" or kind == "region-destroy-unsupported" or kind == "region-expression-unsupported" or kind == "region-return-escape" or kind == "region-return-witness-unsupported" or kind == "region-scope-unsupported" or kind == "region-store-escape"
            return "unsupported" if kind == "frame-spec-invalid" or kind == "effect-call-opaque" or kind == "effect-row-abstract"
            return "disproved" if kind == "effect-row-exceeded"
            return "unknown"

        def proof_add_finding(report: mutable ProofReport&, kind: sview, line: u32, name: sview, message: sview) -> void:
            empty: mutable darray[Ast::Expr] = []
            proof_add_finding_with_counterexample(report, kind, line, name, message, &empty, false)

        # Record a diagnostic for the most recently emitted logical goal and bind it by stable
        # goal ID. Line/name matching is insufficient when one expression generates several
        # obligations (for example lower and upper index bounds on the same source line).
        def proof_add_latest_goal_finding(report: mutable ProofReport&, kind: sview, line: u32, name: sview, message: sview) -> void:
            proof_add_finding(report, kind, line, name, message)
            if report.goal_attempts.count > 0 and report.findings.count > 0:
                report.findings[report.findings.count - 1].goal_id <- report.goal_attempts.count - 1
                report.findings[report.findings.count - 1].has_goal <- true

        def proof_add_finding_with_counterexample(report: mutable ProofReport&, kind: sview, line: u32, name: sview, message: sview, counterexample: darray[Ast::Expr]&, counterexample_found: bool) -> void:
            start: usize = report.counterexample_facts.count
            report.counterexample_facts.extend(counterexample)
            finding_status: mutable sview = proof_finding_status(kind)
            finding_status <- "disproved" if counterexample_found
            report.findings <- report.findings.push(ProofFinding{kind: kind, status: finding_status, line: line, name: name, message: message, counterexample_start: start, counterexample_count: counterexample.count, counterexample_found: counterexample_found, goal_id: 0, has_goal: false})
            report.failed <- report.failed + 1

        def proof_obligation(report: mutable ProofReport&, proven: bool) -> void:
            report.obligations <- report.obligations + 1
            report.proven <- report.proven + 1 if proven

        # Certificates carry only facts that entered the current state through a recorded
        # transition. The body checker may keep an opaque/invalid symbolic placeholder after a
        # failed substitution so later obligations remain visible, but such a placeholder is not
        # an admissible certificate premise. Omitting it here is conservative: if the goal relied
        # on that value, independent replay will fail instead of treating it as an axiom.
        def proof_certificate_fact_is_traced(report: ProofReport&, fact: Ast::Expr, owner: sview) -> bool:
            for trace in report.fact_traces:
                return true if trace.name == owner and proof_expr_equal(trace.expression, fact)
            return false

        def proof_add_goal_attempt(report: mutable ProofReport&, facts: darray[Ast::Expr]&, goal: Ast::Expr, line: u32, name: sview, rule: sview, proven: bool) -> void:
            facts_start: usize = report.certificate_facts.count
            captured_facts: mutable darray[Ast::Expr] = []
            for fact in facts |fact, captured_facts, report, name|:
                captured_facts.push(fact) if proof_kernel_expression_supported(fact) and proof_certificate_fact_is_traced(report, fact, name)
            report.certificate_facts.extend(captured_facts)
            kernel_facts_start: usize = report.kernel_certificate_facts.count
            for fact in captured_facts |fact, report|:
                report.kernel_certificate_facts.push(proof_kernel_encode_annotated(fact, &report.kernel_nodes, &report.kernel_children, report.source_annotations))
            kernel_goal: usize = proof_kernel_encode_annotated(goal, &report.kernel_nodes, &report.kernel_children, report.source_annotations)
            if rule == "quantifier-forall" or rule == "quantifier-exists":
                quantifier_kind: sview = "forall" if rule == "quantifier-forall" else "exists"
                # A quantifier certificate must carry the source-side kind in the arena. If the
                # root is not a quantifier, or an already-bound root disagrees, leave the arena
                # unchanged so independent replay rejects the certificate conservatively.
                proof_kernel_bind_quantifier_kind(&report.kernel_nodes, kernel_goal, quantifier_kind)
            kernel_facts_count: usize = captured_facts.count
            certificate_index: usize = report.certificates.count
            report.goal_attempts <- report.goal_attempts.push(ProofGoalAttempt{goal: goal, budget_exhausted: false, facts_start: facts_start, facts_count: captured_facts.count, kernel_goal: kernel_goal, kernel_facts_start: kernel_facts_start, kernel_facts_count: kernel_facts_count, line: line, name: name, rule: rule, proven: proven, has_certificate: proven, certificate_index: certificate_index})
            report.certificates <- report.certificates.push(ProofGoalCertificate{goal: goal, facts_start: facts_start, facts_count: captured_facts.count, kernel_goal: kernel_goal, kernel_facts_start: kernel_facts_start, kernel_facts_count: kernel_facts_count, line: line, name: name, rule: rule, replayed: false}) if proven

        # Resource safety is certified by a source-neutral transition trace rather than by a
        # proposition in the ordinary expression language. Keep the source mirror intentionally
        # inert (`true`): the arena root is the semantic certificate, and replay dispatches it to
        # the resource kernel rule. No facts are admitted for this rule.
        def proof_add_resource_goal_attempt(report: mutable ProofReport&, kernel_goal: usize, line: u32, name: sview) -> void:
            certificate_index: usize = report.certificates.count
            empty_goal: Ast::Expr = Ast::Expr.BoolLit(true)
            facts_start: usize = report.certificate_facts.count
            kernel_facts_start: usize = report.kernel_certificate_facts.count
            report.goal_attempts <- report.goal_attempts.push(ProofGoalAttempt{goal: empty_goal, budget_exhausted: false, facts_start: facts_start, facts_count: 0, kernel_goal: kernel_goal, kernel_facts_start: kernel_facts_start, kernel_facts_count: 0, line: line, name: name, rule: "resource-safety", proven: true, has_certificate: true, certificate_index: certificate_index})
            report.certificates <- report.certificates.push(ProofGoalCertificate{goal: empty_goal, facts_start: facts_start, facts_count: 0, kernel_goal: kernel_goal, kernel_facts_start: kernel_facts_start, kernel_facts_count: 0, line: line, name: name, rule: "resource-safety", replayed: false})

        # An effect certificate is a source-neutral trace, like the resource one above: the source
        # mirror is intentionally inert and the arena root carries the declared row together with
        # every resolved callee row. No facts are admitted for this rule.
        def proof_add_effect_goal_attempt(report: mutable ProofReport&, kernel_goal: usize, line: u32, name: sview) -> void:
            certificate_index: usize = report.certificates.count
            empty_goal: Ast::Expr = Ast::Expr.BoolLit(true)
            facts_start: usize = report.certificate_facts.count
            kernel_facts_start: usize = report.kernel_certificate_facts.count
            report.goal_attempts <- report.goal_attempts.push(ProofGoalAttempt{goal: empty_goal, budget_exhausted: false, facts_start: facts_start, facts_count: 0, kernel_goal: kernel_goal, kernel_facts_start: kernel_facts_start, kernel_facts_count: 0, line: line, name: name, rule: "effect-containment", proven: true, has_certificate: true, certificate_index: certificate_index})
            report.certificates <- report.certificates.push(ProofGoalCertificate{goal: empty_goal, facts_start: facts_start, facts_count: 0, kernel_goal: kernel_goal, kernel_facts_start: kernel_facts_start, kernel_facts_count: 0, line: line, name: name, rule: "effect-containment", replayed: false})

        # Structural termination is a source-neutral transition certificate, just like the
        # resource trace above. The source checker still decides which typed match binders are
        # strict subterms; the kernel independently checks the serialized ranking relation,
        # including preservation of every product subject and at least one strict descent.
        def proof_add_structural_goal_attempt(report: mutable ProofReport&, kernel_goal: usize, line: u32, name: sview) -> void:
            certificate_index: usize = report.certificates.count
            empty_goal: Ast::Expr = Ast::Expr.BoolLit(true)
            facts_start: usize = report.certificate_facts.count
            kernel_facts_start: usize = report.kernel_certificate_facts.count
            report.goal_attempts <- report.goal_attempts.push(ProofGoalAttempt{goal: empty_goal, budget_exhausted: false, facts_start: facts_start, facts_count: 0, kernel_goal: kernel_goal, kernel_facts_start: kernel_facts_start, kernel_facts_count: 0, line: line, name: name, rule: "structural-safety", proven: true, has_certificate: true, certificate_index: certificate_index})
            report.certificates <- report.certificates.push(ProofGoalCertificate{goal: empty_goal, facts_start: facts_start, facts_count: 0, kernel_goal: kernel_goal, kernel_facts_start: kernel_facts_start, kernel_facts_count: 0, line: line, name: name, rule: "structural-safety", replayed: false})
