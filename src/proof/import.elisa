# Textual import support for the proof front end. Elisa's compiler treats `include` as a
# source-level splice, so the proof assistant follows the same rule before parsing. Keeping
# this in Elisa means imported files go through exactly the same parser and AST kernel as the
# root file; there is no second parser or host-language import model.
extend ElisaProof:
    private:
        const PROOF_IMPORT_PATH_BUFFER_SIZE: usize = 4096
        const PROOF_IMPORT_INCLUDE_DEPTH_LIMIT: i64 = 64
        const PROOF_IMPORT_BYTE_NUL: u8 = 0
        const PROOF_IMPORT_BYTE_TAB: u8 = 9
        const PROOF_IMPORT_BYTE_LINE_FEED: u8 = 10
        const PROOF_IMPORT_BYTE_VERTICAL_TAB: u8 = 11
        const PROOF_IMPORT_BYTE_FORM_FEED: u8 = 12
        const PROOF_IMPORT_BYTE_CARRIAGE_RETURN: u8 = 13
        const PROOF_IMPORT_BYTE_SPACE: u8 = 32
        const PROOF_IMPORT_BYTE_HASH: u8 = 35
        const PROOF_IMPORT_BYTE_DOLLAR: u8 = 36
        const PROOF_IMPORT_BYTE_OPEN_BRACE: u8 = 123
        const PROOF_IMPORT_BYTE_CLOSE_BRACE: u8 = 125
        const PROOF_IMPORT_BYTE_SINGLE_QUOTE: u8 = 39
        const PROOF_IMPORT_BYTE_DOUBLE_QUOTE: u8 = 34
        const PROOF_IMPORT_BYTE_DOT: u8 = 46
        const PROOF_IMPORT_BYTE_SLASH: u8 = 47
        const PROOF_IMPORT_ASCII_CASE_DELTA: u8 = 32
        const PROOF_IMPORT_BYTE_UPPERCASE_A: u8 = 65
        const PROOF_IMPORT_BYTE_UPPERCASE_D: u8 = 68
        const PROOF_IMPORT_BYTE_UPPERCASE_P: u8 = 80
        const PROOF_IMPORT_BYTE_UPPERCASE_W: u8 = 87
        const PROOF_IMPORT_BYTE_UPPERCASE_Z: u8 = 90
        const PROOF_IMPORT_BYTE_LOWERCASE_I: u8 = 105
        const PROOF_IMPORT_INCLUDE_KEYWORD_LENGTH: usize = 7
        const PROOF_IMPORT_INCLUDE_ARGUMENT_MIN_LENGTH: usize = 8
        # A single file is bounded by proof_read_file_checked; this second bound covers the
        # complete include-once expansion. Without it, a graph of many individually acceptable
        # files could retain an arbitrarily large parser input before semantic checking begins.
        const PROOF_IMPORT_EXPANDED_SOURCE_MAX_BYTES: usize = 134217728

        def proof_path_directory(path: darray[u8]&) -> darray[u8]:
            directory: mutable darray[u8] = []
            last_slash: mutable i64 = -1
            for index in 0..<path.count |last_slash, path|:
                last_slash <- index.i64() if path[index] == PROOF_IMPORT_BYTE_SLASH
            return directory if last_slash < 0
            prefix_end: usize = (last_slash + 1).usize()
            index: mutable usize = 0
            while index < prefix_end |directory, index, path|:
                directory.push(path[index])
                index <- index + 1
            return directory

        def proof_resolve_include(base_directory: darray[u8]&, relative: darray[u8]&) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            return proof_normalize_path(relative) if proof_path_is_absolute(relative)
            resolved: mutable darray[u8] = []
            resolved.extend(base_directory)
            resolved.extend(relative)
            return proof_normalize_path(resolved)

        def proof_path_is_absolute(path: darray[u8]&) -> bool:
            return path.count > 0 and path[0] == PROOF_IMPORT_BYTE_SLASH

        # Match the compiler's working-directory choice: preserve a symlinked `$PWD` only
        # when it resolves to the same directory as getcwd(). This matters because include-once
        # identity is lexical; using the physical cwd unconditionally can merge two paths that
        # the compiler keeps distinct, or split paths that the compiler treats as one.
        def proof_same_directory(left: darray[u8]&, right: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            left_storage: mutable darray[u8] = []
            left_storage.extend(left)
            left_storage.push(0)
            right_storage: mutable darray[u8] = []
            right_storage.extend(right)
            right_storage.push(0)
            left_path: cstr = (&left_storage[0]).cast[cstr] can Unsafe.PointerCast
            right_path: cstr = (&right_storage[0]).cast[cstr] can Unsafe.PointerCast
            left_buffer: mutable darray[u8] = []
            left_buffer.resize(PROOF_IMPORT_PATH_BUFFER_SIZE)
            right_buffer: mutable darray[u8] = []
            right_buffer.resize(PROOF_IMPORT_PATH_BUFFER_SIZE)
            left_target: void& = (&left_buffer[0]).cast[void&] can Unsafe.PointerCast
            right_target: void& = (&right_buffer[0]).cast[void&] can Unsafe.PointerCast
            if proof_realpath(left_path, left_target) is resolved_left:
                if proof_realpath(right_path, right_target) is resolved_right:
                    for index in 0..<PROOF_IMPORT_PATH_BUFFER_SIZE |left_buffer, right_buffer|:
                        return false if left_buffer[index] != right_buffer[index]
                        return true if left_buffer[index] == 0
            return false

        # Match the compiler's filepath.Clean behavior. The old importer removed only `./`,
        # which let `x`, `./x`, and `sub/../x` become three seen-set entries even though they
        # name one source file. That made cycle detection impossible to make sound over aliases.
        def proof_normalize_path(path: darray[u8]&) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            rooted: bool = proof_path_is_absolute(path)
            starts: mutable darray[usize] = []
            lengths: mutable darray[usize] = []
            depth: mutable usize = 0
            segment_start: mutable usize = 0
            index: mutable usize = 0
            while index <= path.count |index, segment_start, depth, starts, lengths, path|:
                at_end: bool = index == path.count
                byte: u8 = PROOF_IMPORT_BYTE_SLASH if at_end else path[index]
                if byte == PROOF_IMPORT_BYTE_SLASH:
                    length: usize = index - segment_start
                    is_dot: bool = length == 1 and path[segment_start] == PROOF_IMPORT_BYTE_DOT
                    is_parent: bool = length == 2 and path[segment_start] == PROOF_IMPORT_BYTE_DOT and path[segment_start + 1] == PROOF_IMPORT_BYTE_DOT
                    if length == 0 or is_dot:
                        segment_start <- index + 1
                        index <- index + 1
                        continue
                    keep: mutable bool = true
                    if is_parent:
                        keep <- false
                        if depth > 0:
                            top_is_parent: bool = lengths[depth - 1] == 2 and path[starts[depth - 1]] == PROOF_IMPORT_BYTE_DOT and path[starts[depth - 1] + 1] == PROOF_IMPORT_BYTE_DOT
                            if not top_is_parent:
                                depth <- depth - 1
                            else:
                                keep <- true
                        else:
                            keep <- not rooted
                    if keep:
                        if depth < starts.count:
                            starts[depth] <- segment_start
                            lengths[depth] <- length
                        else:
                            starts <- starts.push(segment_start)
                            lengths <- lengths.push(length)
                        depth <- depth + 1
                    segment_start <- index + 1
                index <- index + 1
            out: mutable darray[u8] = []
            out.push(PROOF_IMPORT_BYTE_SLASH) if rooted
            for segment in 0..<depth |out, starts, lengths, path, rooted|:
                out.push(PROOF_IMPORT_BYTE_SLASH) if segment > 0 or (out.count > 0 and not rooted)
                for byte_index in 0..<lengths[segment] |out, starts, lengths, path, segment|:
                    out.push(path[starts[segment] + byte_index])
            if out.count == 0:
                out.push(PROOF_IMPORT_BYTE_DOT)
            return out

        # The compiler turns relative source arguments into cwd-relative paths before walking
        # includes. Use the process cwd here as well, so path identities are stable for a user
        # invoking `elisa-proof file.elisa` instead of an absolute path.
        def proof_absolute_path(path: darray[u8]&) -> darray[u8] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            normalized: darray[u8] = proof_normalize_path(path)
            return normalized if proof_path_is_absolute(normalized)
            cwd_buffer: mutable darray[u8] = []
            cwd_buffer.resize(PROOF_IMPORT_PATH_BUFFER_SIZE)
            target: void& = (&cwd_buffer[0]).cast[void&] can Unsafe.PointerCast
            _ = getcwd(target, PROOF_IMPORT_PATH_BUFFER_SIZE)
            physical_cwd: mutable darray[u8] = []
            for index in 0..<cwd_buffer.count |physical_cwd, cwd_buffer|:
                break if cwd_buffer[index] == PROOF_IMPORT_BYTE_NUL
                physical_cwd.push(cwd_buffer[index])
            pwd_name: mutable darray[u8] = []
            pwd_name.push(PROOF_IMPORT_BYTE_UPPERCASE_P)
            pwd_name.push(PROOF_IMPORT_BYTE_UPPERCASE_W)
            pwd_name.push(PROOF_IMPORT_BYTE_UPPERCASE_D)
            pwd_name.push(PROOF_IMPORT_BYTE_NUL)
            pwd_key: cstr = (&pwd_name[0]).cast[cstr] can Unsafe.PointerCast
            cwd: mutable darray[u8] = physical_cwd
            if proof_getenv(pwd_key) is logical_cwd:
                logical: mutable darray[u8] = []
                for index in 0..<PROOF_IMPORT_PATH_BUFFER_SIZE |logical, logical_cwd|:
                    break if logical_cwd[index] == PROOF_IMPORT_BYTE_NUL
                    logical.push(logical_cwd[index])
                cwd <- logical if proof_path_is_absolute(logical) and proof_same_directory(logical, physical_cwd)
            return normalized if cwd.count == 0
            joined: mutable darray[u8] = []
            joined.extend(cwd)
            joined.push(PROOF_IMPORT_BYTE_SLASH) if joined.count > 0 and normalized.count > 0
            joined.extend(normalized)
            return proof_normalize_path(joined)

        # The compiler's source reader keeps a flat NUL-separated path set. Reuse that shape
        # here so imports remain region-simple and deduplicate diamond include graphs.
        def proof_path_seen(seen: darray[u8]&, path: darray[u8]&) -> bool:
            start: mutable usize = 0
            index: mutable usize = 0
            while index < seen.count |start, index, seen, path|:
                if seen[index] == PROOF_IMPORT_BYTE_NUL:
                    if index - start == path.count:
                        matched: mutable bool = true
                        for offset in 0..<path.count |matched, offset, seen, path, start|:
                            matched <- false if seen[start + offset] != path[offset]
                        return true if matched
                    start <- index + 1
                index <- index + 1
            return false

        def proof_record_path(seen: mutable darray[u8]&, path: darray[u8]&) -> void:
            for byte in path |seen|:
                seen.push(byte)
            seen.push(PROOF_IMPORT_BYTE_NUL)

        def proof_import_space(byte: u8) -> bool:
            return byte == PROOF_IMPORT_BYTE_TAB or byte == PROOF_IMPORT_BYTE_LINE_FEED or byte == PROOF_IMPORT_BYTE_VERTICAL_TAB or byte == PROOF_IMPORT_BYTE_FORM_FEED or byte == PROOF_IMPORT_BYTE_CARRIAGE_RETURN or byte == PROOF_IMPORT_BYTE_SPACE

        def proof_import_path_has_nul(path: darray[u8]&) -> bool:
            for byte in path |path|:
                return true if byte == PROOF_IMPORT_BYTE_NUL
            return false

        # Append one source line including its newline only when the aggregate expansion budget
        # still contains the complete record. Returning false is an import failure, never a
        # truncated source that may be certified as if the missing suffix did not exist.
        def proof_import_append_line(output: mutable darray[u8]&, line: darray[u8]&) -> bool:
            return false if output.count >= PROOF_IMPORT_EXPANDED_SOURCE_MAX_BYTES
            remaining: usize = PROOF_IMPORT_EXPANDED_SOURCE_MAX_BYTES - output.count
            return false if line.count >= remaining
            output.extend(line)
            output.push(PROOF_IMPORT_BYTE_LINE_FEED)
            return true

        # Match the compiler's include parser: ordinary include/#include directives plus the
        # {$include path} and {$i path} macro forms. Keep recognition separate from the path,
        # because an empty but syntactically valid quoted path must still fail during file IO.
        def proof_include_path(line: darray[u8]&) -> (recognized: bool, path: darray[u8]):
            empty: mutable darray[u8] = []
            start: mutable usize = 0
            end: mutable usize = line.count
            while start < end |start, end, line|:
                break if not proof_import_space(line[start])
                start <- start + 1
            while end > start |start, end, line|:
                break if not proof_import_space(line[end - 1])
                end <- end - 1

            if end - start >= 3 and line[start] == 123 and line[start + 1] == 36 and line[end - 1] == 125:
                body_start: mutable usize = start + 2
                body_end: mutable usize = end - 1
                while body_start < body_end |body_start, body_end, line|:
                    break if not proof_import_space(line[body_start])
                    body_start <- body_start + 1
                while body_end > body_start |body_start, body_end, line|:
                    break if not proof_import_space(line[body_end - 1])
                    body_end <- body_end - 1
                keyword_end: mutable usize = body_start
                while keyword_end < body_end |keyword_end, body_end, line|:
                    break if proof_import_space(line[keyword_end])
                    keyword_end <- keyword_end + 1
                keyword_length: usize = keyword_end - body_start
                keyword_is_i: mutable bool = false
                keyword_is_include: mutable bool = keyword_length == PROOF_IMPORT_INCLUDE_KEYWORD_LENGTH
                include_keyword: sview = "include"
                if keyword_length == 1:
                    original: u8 = line[body_start]
                    lowered: u8 = original + PROOF_IMPORT_ASCII_CASE_DELTA if original >= PROOF_IMPORT_BYTE_UPPERCASE_A and original <= PROOF_IMPORT_BYTE_UPPERCASE_Z else original
                    keyword_is_i <- lowered == PROOF_IMPORT_BYTE_LOWERCASE_I
                if keyword_is_include:
                    for offset in 0..<PROOF_IMPORT_INCLUDE_KEYWORD_LENGTH |keyword_is_include, line, body_start, include_keyword|:
                        original: u8 = line[body_start + offset]
                        lowered: u8 = original + PROOF_IMPORT_ASCII_CASE_DELTA if original >= PROOF_IMPORT_BYTE_UPPERCASE_A and original <= PROOF_IMPORT_BYTE_UPPERCASE_Z else original
                        keyword_is_include <- false if lowered != sview_at(include_keyword, offset)
                keyword_recognized: mutable bool = keyword_is_i
                keyword_recognized <- true if keyword_is_include
                if keyword_recognized and keyword_end < body_end:
                    argument_start: mutable usize = keyword_end
                    argument_end: mutable usize = body_end
                    while argument_start < argument_end |argument_start, argument_end, line|:
                        break if not proof_import_space(line[argument_start])
                        argument_start <- argument_start + 1
                    while argument_end > argument_start |argument_start, argument_end, line|:
                        break if not proof_import_space(line[argument_end - 1])
                        argument_end <- argument_end - 1
                    if argument_start < argument_end:
                        first: u8 = line[argument_start]
                        last: u8 = line[argument_end - 1]
                        quoted_path: mutable bool = false
                        quoted_path <- (first == PROOF_IMPORT_BYTE_DOUBLE_QUOTE and last == PROOF_IMPORT_BYTE_DOUBLE_QUOTE) or (first == PROOF_IMPORT_BYTE_SINGLE_QUOTE and last == PROOF_IMPORT_BYTE_SINGLE_QUOTE)
                        if quoted_path:
                            captured: mutable darray[u8] = []
                            for offset in 1..<(argument_end - argument_start - 1) |captured, line, argument_start|:
                                captured.push(line[argument_start + offset])
                            return (true, captured)
                        has_space: mutable bool = false
                        for offset in argument_start..<argument_end |has_space, line|:
                            has_space <- true if proof_import_space(line[offset])
                        if not has_space:
                            captured: mutable darray[u8] = []
                            for offset in argument_start..<argument_end |captured, line|:
                                captured.push(line[offset])
                            return (true, captured)
                return (false, empty)

            cursor: mutable usize = start
            cursor <- cursor + 1 if cursor < end and line[cursor] == PROOF_IMPORT_BYTE_HASH
            while cursor < end |cursor, end, line|:
                break if not proof_import_space(line[cursor])
                cursor <- cursor + 1
            return (false, empty) if end - cursor < PROOF_IMPORT_INCLUDE_ARGUMENT_MIN_LENGTH
            keyword: sview = "include"
            for keyword_index in 0..<PROOF_IMPORT_INCLUDE_KEYWORD_LENGTH |empty, line, cursor, keyword|:
                return (false, empty) if line[cursor + keyword_index] != sview_at(keyword, keyword_index)
            cursor <- cursor + PROOF_IMPORT_INCLUDE_KEYWORD_LENGTH
            return (false, empty) if line[cursor] != PROOF_IMPORT_BYTE_SPACE
            cursor <- cursor + 1
            while cursor < end |cursor, end, line|:
                break if not proof_import_space(line[cursor])
                cursor <- cursor + 1
            return (false, empty) if end - cursor < 2 or line[cursor] != PROOF_IMPORT_BYTE_DOUBLE_QUOTE or line[end - 1] != PROOF_IMPORT_BYTE_DOUBLE_QUOTE
            captured: mutable darray[u8] = []
            for offset in (cursor + 1)..<(end - 1) |captured, line, cursor|:
                captured.push(line[offset])
            return (true, captured)

        # The self-hosted compiler driver's include recognizer (`include_brace_directive_path`
        # and `include_directive_path_span` in Elisa-compiler src/driver/elisac_includes.elisa),
        # byte for byte. It differs from the reference recognizer above: only space and tab
        # separate tokens, `include<TAB>"p"` is a directive, text after the closing quote of a
        # plain directive is ignored, and the path ends at the FIRST closing quote. A line the two
        # compilers read differently builds two different programs, so the importer refuses it
        # instead of certifying one of them (see `proof_include_agreement`).
        def proof_import_blank(byte: u8) -> bool:
            return byte == PROOF_IMPORT_BYTE_SPACE or byte == PROOF_IMPORT_BYTE_TAB

        def proof_include_brace_path_stage1(line: darray[u8]&) -> darray[u8]:
            empty: mutable darray[u8] = []
            begin: mutable usize = 0
            while begin < line.count |begin, line|:
                break if not proof_import_blank(line[begin])
                begin <- begin + 1
            finish: mutable usize = line.count
            while finish > begin |finish, line|:
                break if not proof_import_blank(line[finish - 1]) and line[finish - 1] != PROOF_IMPORT_BYTE_CARRIAGE_RETURN
                finish <- finish - 1
            return empty if finish < begin + 4
            return empty if line[begin] != PROOF_IMPORT_BYTE_OPEN_BRACE or line[begin + 1] != PROOF_IMPORT_BYTE_DOLLAR or line[finish - 1] != PROOF_IMPORT_BYTE_CLOSE_BRACE
            body_start: mutable usize = begin + 2
            body_stop: usize = finish - 1
            while body_start < body_stop |body_start, line|:
                break if not proof_import_blank(line[body_start])
                body_start <- body_start + 1
            keyword_stop: mutable usize = body_start
            while keyword_stop < body_stop |keyword_stop, line|:
                break if proof_import_blank(line[keyword_stop])
                keyword_stop <- keyword_stop + 1
            keyword_length: usize = keyword_stop - body_start
            return empty if keyword_length != 1 and keyword_length != PROOF_IMPORT_INCLUDE_KEYWORD_LENGTH
            include_keyword: sview = "include"
            for offset in 0..<keyword_length |empty, line, body_start, include_keyword|:
                original: u8 = line[body_start + offset]
                lowered: u8 = original + PROOF_IMPORT_ASCII_CASE_DELTA if original >= PROOF_IMPORT_BYTE_UPPERCASE_A and original <= PROOF_IMPORT_BYTE_UPPERCASE_Z else original
                return empty if lowered != sview_at(include_keyword, offset)
            argument_start: mutable usize = keyword_stop
            while argument_start < body_stop |argument_start, line|:
                break if not proof_import_blank(line[argument_start])
                argument_start <- argument_start + 1
            argument_stop: mutable usize = body_stop
            while argument_stop > argument_start |argument_stop, line|:
                break if not proof_import_blank(line[argument_stop - 1])
                argument_stop <- argument_stop - 1
            return empty if argument_stop <= argument_start
            opening: u8 = line[argument_start]
            closing: u8 = line[argument_stop - 1]
            quoted: bool = argument_stop - argument_start >= 2 and ((opening == PROOF_IMPORT_BYTE_SINGLE_QUOTE and closing == PROOF_IMPORT_BYTE_SINGLE_QUOTE) or (opening == PROOF_IMPORT_BYTE_DOUBLE_QUOTE and closing == PROOF_IMPORT_BYTE_DOUBLE_QUOTE))
            inner_start: usize = argument_start + 1 if quoted else argument_start
            inner_stop: usize = argument_stop - 1 if quoted else argument_stop
            return empty if inner_stop <= inner_start
            if not quoted:
                for offset in inner_start..<inner_stop |empty, line|:
                    return empty if proof_import_blank(line[offset])
            captured: mutable darray[u8] = []
            for offset in inner_start..<inner_stop |captured, line|:
                captured.push(line[offset])
            return captured

        # An empty result means "not a directive": the driver keeps such a line as source.
        def proof_include_path_stage1(line: darray[u8]&) -> darray[u8]:
            braced: darray[u8] = proof_include_brace_path_stage1(line)
            return braced if braced.count > 0
            empty: mutable darray[u8] = []
            cursor: mutable usize = 0
            while cursor < line.count |cursor, line|:
                break if not proof_import_blank(line[cursor])
                cursor <- cursor + 1
            cursor <- cursor + 1 if cursor < line.count and line[cursor] == PROOF_IMPORT_BYTE_HASH
            while cursor < line.count |cursor, line|:
                break if not proof_import_blank(line[cursor])
                cursor <- cursor + 1
            return empty if cursor + PROOF_IMPORT_INCLUDE_KEYWORD_LENGTH > line.count
            keyword: sview = "include"
            for keyword_index in 0..<PROOF_IMPORT_INCLUDE_KEYWORD_LENGTH |empty, line, cursor, keyword|:
                return empty if line[cursor + keyword_index] != sview_at(keyword, keyword_index)
            cursor <- cursor + PROOF_IMPORT_INCLUDE_KEYWORD_LENGTH
            return empty if cursor >= line.count or not proof_import_blank(line[cursor])
            while cursor < line.count |cursor, line|:
                break if not proof_import_blank(line[cursor])
                cursor <- cursor + 1
            return empty if cursor >= line.count or line[cursor] != PROOF_IMPORT_BYTE_DOUBLE_QUOTE
            cursor <- cursor + 1
            captured: mutable darray[u8] = []
            while cursor < line.count |cursor, line, captured|:
                break if line[cursor] == PROOF_IMPORT_BYTE_DOUBLE_QUOTE
                captured.push(line[cursor])
                cursor <- cursor + 1
            return empty if cursor >= line.count
            return captured

        # Whether both compilers agree on what this line is. They must both keep it as source, or
        # both splice the same path from a directive at column 0: the reference compiler
        # re-indents the spliced text by the directive's indentation, the self-hosted driver and
        # this importer do not, so an indented directive also builds two different programs.
        def proof_include_agreement(line: darray[u8]&, reference: (recognized: bool, path: darray[u8])) -> bool:
            driver_path: darray[u8] = proof_include_path_stage1(line)
            reference_splices: bool = reference.recognized and reference.path.count > 0
            return false if reference.recognized and not reference_splices
            return driver_path.count == 0 if not reference_splices
            return false if driver_path.count != reference.path.count
            for offset in 0..<driver_path.count |driver_path, reference|:
                return false if driver_path[offset] != reference.path[offset]
            return line.count > 0 and not proof_import_blank(line[0])

        # `line_files[k]` and `line_numbers[k]` give the file (its position in `seen`, which
        # lists files in first-visit order) and the 1-based line there of expanded line k + 1.
        # Include directives are dropped from the expansion, so without the map a line number
        # past the first include no longer points into any one file.
        def proof_expand_file(path: darray[u8]&, output: mutable darray[u8]&, seen: mutable darray[u8]&, active: mutable darray[u8]&, depth: i64, failed: mutable bool&, line_files: mutable darray[u32]&, line_numbers: mutable darray[u32]&, empty_includes: mutable usize&, nonempty_includes: mutable usize&) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            if depth > PROOF_IMPORT_INCLUDE_DEPTH_LIMIT:
                failed <- true
                return
            if proof_import_path_has_nul(path):
                failed <- true
                return
            if proof_path_seen(active, path):
                failed <- true
                return
            return if proof_path_seen(seen, path)
            file_index: mutable u32 = 0
            for byte in seen |file_index|:
                file_index <- file_index + 1 if byte == PROOF_IMPORT_BYTE_NUL
            proof_record_path(seen, path)
            proof_record_path(active, path)
            path_storage: mutable darray[u8] = []
            path_storage.extend(path)
            path_storage.push(0)
            path_cstr: cstr = (&path_storage[0]).cast[cstr] can Unsafe.PointerCast
            read_result: (ok: bool, contents: darray[u8]) = proof_read_file_checked(path_cstr)
            if not read_result.ok:
                failed <- true
                active.count <- active.count - path.count - 1
                return
            contents: darray[u8] = read_result.contents
            if depth > 0:
                empty_includes <- empty_includes + 1 if contents.count == 0
                nonempty_includes <- nonempty_includes + 1 if contents.count > 0
            directory: darray[u8] = proof_path_directory(path)
            line: mutable darray[u8] = []
            index: mutable usize = 0
            source_line: mutable u32 = 0
            trailing_partial: bool = contents.count > 0 and contents[contents.count - 1] != PROOF_IMPORT_BYTE_LINE_FEED
            while index < contents.count + (1 if trailing_partial else 0) and failed == false |index, contents, line, output, seen, active, directory, path, depth, failed, trailing_partial, source_line, file_index, line_files, line_numbers, empty_includes, nonempty_includes|:
                at_end: bool = index == contents.count
                byte: u8 = PROOF_IMPORT_BYTE_LINE_FEED if at_end else contents[index]
                if byte == PROOF_IMPORT_BYTE_LINE_FEED:
                    source_line <- source_line + 1
                    included: (recognized: bool, path: darray[u8]) = proof_include_path(line)
                    if not proof_include_agreement(line, included):
                        failed <- true
                    elif included.recognized:
                        if proof_import_path_has_nul(included.path):
                            failed <- true
                        else:
                            resolved: darray[u8] = proof_resolve_include(directory, included.path)
                            proof_expand_file(resolved, output, seen, active, depth + 1, failed, line_files, line_numbers, empty_includes, nonempty_includes)
                    else:
                        if proof_import_append_line(output, line):
                            line_files.push(file_index)
                            line_numbers.push(source_line)
                        else:
                            failed <- true
                    line <- line.truncate(0)
                else:
                    line.push(byte)
                index <- index + 1
            active.count <- active.count - path.count - 1

        public:
            def proof_import_source(path: darray[u8]&, failed: mutable bool&) -> darray[u8] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
                files: mutable darray[u8] = []
                line_files: mutable darray[u32] = []
                line_numbers: mutable darray[u32] = []
                return proof_import_source_mapped(path, failed, &files, &line_files, &line_numbers)

            # As `proof_import_source`, also returning the NUL-separated file table and, per
            # expanded line, its file index and line in that file.
            def proof_import_source_mapped(path: darray[u8]&, failed: mutable bool&, files: mutable darray[u8]&, line_files: mutable darray[u32]&, line_numbers: mutable darray[u32]&) -> darray[u8] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
                output: mutable darray[u8] = []
                active: mutable darray[u8] = []
                normalized: darray[u8] = proof_absolute_path(path)
                empty_includes: mutable usize = 0
                nonempty_includes: mutable usize = 0
                proof_expand_file(normalized, &output, files, &active, 0, failed, line_files, line_numbers, &empty_includes, &nonempty_includes)
                # The self-hosted driver abandons the whole expansion at an empty included file and
                # compiles the root unexpanded, so any other included text never reaches its build.
                failed <- true if empty_includes > 0 and nonempty_includes > 0
                return output
