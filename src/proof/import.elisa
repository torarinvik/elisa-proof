# Textual import support for the proof front end. Elisa's compiler treats `include` as a
# source-level splice, so the proof assistant follows the same rule before parsing. Keeping
# this in Elisa means imported files go through exactly the same parser and AST kernel as the
# root file; there is no second parser or host-language import model.
extend ElisaProof:
    private:
        const PROOF_IMPORT_PATH_BUFFER_SIZE: usize = 4096
        # A single file is bounded by proof_read_file_checked; this second bound covers the
        # complete include-once expansion. Without it, a graph of many individually acceptable
        # files could retain an arbitrarily large parser input before semantic checking begins.
        const PROOF_IMPORT_EXPANDED_SOURCE_MAX_BYTES: usize = 134217728

        def proof_path_directory(path: darray[u8]&) -> darray[u8]:
            directory: mutable darray[u8] = []
            last_slash: mutable i64 = -1
            for index in 0..<path.count |last_slash, path|:
                last_slash <- index.i64() if path[index] == 47
            return directory if last_slash < 0
            prefix_end: usize = (last_slash + 1).usize()
            index: mutable usize = 0
            while index < prefix_end |directory, index, path|:
                directory.push(path[index])
                index <- index + 1
            return directory

        def proof_resolve_include(base_directory: darray[u8]&, relative: darray[u8]&) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            return proof_normalize_path(relative) if proof_path_is_absolute(relative)
            resolved: mutable darray[u8] = []
            resolved.extend(base_directory)
            resolved.extend(relative)
            return proof_normalize_path(resolved)

        def proof_path_is_absolute(path: darray[u8]&) -> bool:
            return path.count > 0 and path[0] == 47

        # Match the compiler's working-directory choice: preserve a symlinked `$PWD` only
        # when it resolves to the same directory as getcwd(). This matters because include-once
        # identity is lexical; using the physical cwd unconditionally can merge two paths that
        # the compiler keeps distinct, or split paths that the compiler treats as one.
        def proof_same_directory(left: darray[u8]&, right: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            left_storage: mutable darray[u8] = []
            left_storage.extend(left)
            left_storage.push(0)
            right_storage: mutable darray[u8] = []
            right_storage.extend(right)
            right_storage.push(0)
            left_path: cstr = (&left_storage[0]).cast[cstr] can Unsafe.PointerCast
            right_path: cstr = (&right_storage[0]).cast[cstr] can Unsafe.PointerCast
            left_buffer: mutable darray[u8] = []
            left_buffer.resize(PROOF_IMPORT_PATH_BUFFER_SIZE)
            right_buffer: mutable darray[u8] = []
            right_buffer.resize(PROOF_IMPORT_PATH_BUFFER_SIZE)
            left_target: void& = (&left_buffer[0]).cast[void&] can Unsafe.PointerCast
            right_target: void& = (&right_buffer[0]).cast[void&] can Unsafe.PointerCast
            if proof_realpath(left_path, left_target) is resolved_left:
                if proof_realpath(right_path, right_target) is resolved_right:
                    for index in 0..<PROOF_IMPORT_PATH_BUFFER_SIZE |left_buffer, right_buffer|:
                        return false if left_buffer[index] != right_buffer[index]
                        return true if left_buffer[index] == 0
            return false

        # Match the compiler's filepath.Clean behavior. The old importer removed only `./`,
        # which let `x`, `./x`, and `sub/../x` become three seen-set entries even though they
        # name one source file. That made cycle detection impossible to make sound over aliases.
        def proof_normalize_path(path: darray[u8]&) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
            rooted: bool = proof_path_is_absolute(path)
            starts: mutable darray[usize] = []
            lengths: mutable darray[usize] = []
            depth: mutable usize = 0
            segment_start: mutable usize = 0
            index: mutable usize = 0
            while index <= path.count |index, segment_start, depth, starts, lengths, path|:
                at_end: bool = index == path.count
                byte: u8 = 47 if at_end else path[index]
                if byte == 47:
                    length: usize = index - segment_start
                    is_dot: bool = length == 1 and path[segment_start] == 46
                    is_parent: bool = length == 2 and path[segment_start] == 46 and path[segment_start + 1] == 46
                    if length == 0 or is_dot:
                        segment_start <- index + 1
                        index <- index + 1
                        continue
                    keep: mutable bool = true
                    if is_parent:
                        keep <- false
                        if depth > 0:
                            top_is_parent: bool = lengths[depth - 1] == 2 and path[starts[depth - 1]] == 46 and path[starts[depth - 1] + 1] == 46
                            if not top_is_parent:
                                depth <- depth - 1
                            else:
                                keep <- true
                        else:
                            keep <- not rooted
                    if keep:
                        if depth < starts.count:
                            starts[depth] <- segment_start
                            lengths[depth] <- length
                        else:
                            starts <- starts.push(segment_start)
                            lengths <- lengths.push(length)
                        depth <- depth + 1
                    segment_start <- index + 1
                index <- index + 1
            out: mutable darray[u8] = []
            out.push(47) if rooted
            for segment in 0..<depth |out, starts, lengths, path, rooted|:
                out.push(47) if segment > 0 or (out.count > 0 and not rooted)
                for byte_index in 0..<lengths[segment] |out, starts, lengths, path, segment|:
                    out.push(path[starts[segment] + byte_index])
            if out.count == 0:
                out.push(46)
            return out

        # The compiler turns relative source arguments into cwd-relative paths before walking
        # includes. Use the process cwd here as well, so path identities are stable for a user
        # invoking `elisa-proof file.elisa` instead of an absolute path.
        def proof_absolute_path(path: darray[u8]&) -> darray[u8] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            normalized: darray[u8] = proof_normalize_path(path)
            return normalized if proof_path_is_absolute(normalized)
            cwd_buffer: mutable darray[u8] = []
            cwd_buffer.resize(PROOF_IMPORT_PATH_BUFFER_SIZE)
            target: void& = (&cwd_buffer[0]).cast[void&] can Unsafe.PointerCast
            _ = getcwd(target, PROOF_IMPORT_PATH_BUFFER_SIZE)
            physical_cwd: mutable darray[u8] = []
            for index in 0..<cwd_buffer.count |physical_cwd, cwd_buffer|:
                break if cwd_buffer[index] == 0
                physical_cwd.push(cwd_buffer[index])
            pwd_name: mutable darray[u8] = []
            pwd_name.push(80)
            pwd_name.push(87)
            pwd_name.push(68)
            pwd_name.push(0)
            pwd_key: cstr = (&pwd_name[0]).cast[cstr] can Unsafe.PointerCast
            cwd: mutable darray[u8] = physical_cwd
            if proof_getenv(pwd_key) is logical_cwd:
                logical: mutable darray[u8] = []
                for index in 0..<PROOF_IMPORT_PATH_BUFFER_SIZE |logical, logical_cwd|:
                    break if logical_cwd[index] == 0
                    logical.push(logical_cwd[index])
                cwd <- logical if proof_path_is_absolute(logical) and proof_same_directory(logical, physical_cwd)
            return normalized if cwd.count == 0
            joined: mutable darray[u8] = []
            joined.extend(cwd)
            joined.push(47) if joined.count > 0 and normalized.count > 0
            joined.extend(normalized)
            return proof_normalize_path(joined)

        # The compiler's source reader keeps a flat NUL-separated path set. Reuse that shape
        # here so imports remain region-simple and deduplicate diamond include graphs.
        def proof_path_seen(seen: darray[u8]&, path: darray[u8]&) -> bool:
            start: mutable usize = 0
            index: mutable usize = 0
            while index < seen.count |start, index, seen, path|:
                if seen[index] == 0:
                    if index - start == path.count:
                        matched: mutable bool = true
                        for offset in 0..<path.count |matched, offset, seen, path, start|:
                            matched <- false if seen[start + offset] != path[offset]
                        return true if matched
                    start <- index + 1
                index <- index + 1
            return false

        def proof_record_path(seen: mutable darray[u8]&, path: darray[u8]&) -> void:
            for byte in path |seen|:
                seen.push(byte)
            seen.push(0)

        def proof_import_space(byte: u8) -> bool:
            match byte:
                9:
                    return true
                10:
                    return true
                11:
                    return true
                12:
                    return true
                13:
                    return true
                32:
                    return true
                _:
                    return false
            return false

        def proof_import_path_has_nul(path: darray[u8]&) -> bool:
            for byte in path |path|:
                match byte:
                    0:
                        return true
                    _:
                        pass
            return false

        # Append one source line including its newline only when the aggregate expansion budget
        # still contains the complete record. Returning false is an import failure, never a
        # truncated source that may be certified as if the missing suffix did not exist.
        def proof_import_append_line(output: mutable darray[u8]&, line: darray[u8]&) -> bool:
            return false if output.count >= PROOF_IMPORT_EXPANDED_SOURCE_MAX_BYTES
            remaining: usize = PROOF_IMPORT_EXPANDED_SOURCE_MAX_BYTES - output.count
            return false if line.count >= remaining
            output.extend(line)
            output.push(10)
            return true

        # Match the compiler's include parser: ordinary include/#include directives plus the
        # {$include path} and {$i path} macro forms. Keep recognition separate from the path,
        # because an empty but syntactically valid quoted path must still fail during file IO.
        def proof_include_path(line: darray[u8]&) -> (recognized: bool, path: darray[u8]):
            empty: mutable darray[u8] = []
            start: mutable usize = 0
            end: mutable usize = line.count
            while start < end |start, end, line|:
                break if not proof_import_space(line[start])
                start <- start + 1
            while end > start |start, end, line|:
                break if not proof_import_space(line[end - 1])
                end <- end - 1

            if end - start >= 3 and line[start] == 123 and line[start + 1] == 36 and line[end - 1] == 125:
                body_start: mutable usize = start + 2
                body_end: mutable usize = end - 1
                while body_start < body_end |body_start, body_end, line|:
                    break if not proof_import_space(line[body_start])
                    body_start <- body_start + 1
                while body_end > body_start |body_start, body_end, line|:
                    break if not proof_import_space(line[body_end - 1])
                    body_end <- body_end - 1
                keyword_end: mutable usize = body_start
                while keyword_end < body_end |keyword_end, body_end, line|:
                    break if proof_import_space(line[keyword_end])
                    keyword_end <- keyword_end + 1
                keyword_length: usize = keyword_end - body_start
                keyword_is_i: mutable bool = false
                keyword_is_include: mutable bool = keyword_length == 7
                include_keyword: sview = "include"
                if keyword_length == 1:
                    original: u8 = line[body_start]
                    lowered: u8 = original + 32 if original >= 65 and original <= 90 else original
                    keyword_is_i <- lowered == 105
                if keyword_is_include:
                    for offset in 0..<7 |keyword_is_include, line, body_start, include_keyword|:
                        original: u8 = line[body_start + offset]
                        lowered: u8 = original + 32 if original >= 65 and original <= 90 else original
                        keyword_is_include <- false if lowered != sview_at(include_keyword, offset)
                keyword_recognized: mutable bool = keyword_is_i
                keyword_recognized <- true if keyword_is_include
                if keyword_recognized and keyword_end < body_end:
                    argument_start: mutable usize = keyword_end
                    argument_end: mutable usize = body_end
                    while argument_start < argument_end |argument_start, argument_end, line|:
                        break if not proof_import_space(line[argument_start])
                        argument_start <- argument_start + 1
                    while argument_end > argument_start |argument_start, argument_end, line|:
                        break if not proof_import_space(line[argument_end - 1])
                        argument_end <- argument_end - 1
                    if argument_start < argument_end:
                        first: u8 = line[argument_start]
                        last: u8 = line[argument_end - 1]
                        quoted_path: mutable bool = false
                        match first:
                            34:
                                quoted_path <- last == 34
                            39:
                                quoted_path <- last == 39
                            _:
                                pass
                        if quoted_path:
                            captured: mutable darray[u8] = []
                            for offset in 1..<(argument_end - argument_start - 1) |captured, line, argument_start|:
                                captured.push(line[argument_start + offset])
                            return (true, captured)
                        has_space: mutable bool = false
                        for offset in argument_start..<argument_end |has_space, line|:
                            has_space <- true if proof_import_space(line[offset])
                        if not has_space:
                            captured: mutable darray[u8] = []
                            for offset in argument_start..<argument_end |captured, line|:
                                captured.push(line[offset])
                            return (true, captured)
                return (false, empty)

            cursor: mutable usize = start
            cursor <- cursor + 1 if cursor < end and line[cursor] == 35
            while cursor < end |cursor, end, line|:
                break if not proof_import_space(line[cursor])
                cursor <- cursor + 1
            return (false, empty) if end - cursor < 8
            keyword: sview = "include"
            for keyword_index in 0..<7 |empty, line, cursor, keyword|:
                return (false, empty) if line[cursor + keyword_index] != sview_at(keyword, keyword_index)
            cursor <- cursor + 7
            return (false, empty) if line[cursor] != 32
            cursor <- cursor + 1
            while cursor < end |cursor, end, line|:
                break if not proof_import_space(line[cursor])
                cursor <- cursor + 1
            return (false, empty) if end - cursor < 2 or line[cursor] != 34 or line[end - 1] != 34
            captured: mutable darray[u8] = []
            for offset in (cursor + 1)..<(end - 1) |captured, line, cursor|:
                captured.push(line[offset])
            return (true, captured)

        def proof_expand_file(path: darray[u8]&, output: mutable darray[u8]&, seen: mutable darray[u8]&, active: mutable darray[u8]&, depth: i64, failed: mutable bool&) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            if depth > 64:
                failed <- true
                return
            if proof_import_path_has_nul(path):
                failed <- true
                return
            if proof_path_seen(active, path):
                failed <- true
                return
            return if proof_path_seen(seen, path)
            proof_record_path(seen, path)
            proof_record_path(active, path)
            path_storage: mutable darray[u8] = []
            path_storage.extend(path)
            path_storage.push(0)
            path_cstr: cstr = (&path_storage[0]).cast[cstr] can Unsafe.PointerCast
            read_result: (ok: bool, contents: darray[u8]) = proof_read_file_checked(path_cstr)
            if not read_result.ok:
                failed <- true
                active.count <- active.count - path.count - 1
                return
            contents: darray[u8] = read_result.contents
            directory: darray[u8] = proof_path_directory(path)
            line: mutable darray[u8] = []
            index: mutable usize = 0
            trailing_partial: bool = contents.count > 0 and contents[contents.count - 1] != 10
            while index < contents.count + (1 if trailing_partial else 0) and not failed |index, contents, line, output, seen, active, directory, path, depth, failed, trailing_partial|:
                at_end: bool = index == contents.count
                byte: u8 = 10 if at_end else contents[index]
                if byte == 10:
                    included: (recognized: bool, path: darray[u8]) = proof_include_path(line)
                    if included.recognized:
                        if proof_import_path_has_nul(included.path):
                            failed <- true
                        else:
                            resolved: darray[u8] = proof_resolve_include(directory, included.path)
                            proof_expand_file(resolved, output, seen, active, depth + 1, failed)
                    else:
                        failed <- true if not proof_import_append_line(output, line)
                    line <- line.truncate(0)
                else:
                    line.push(byte)
                index <- index + 1
            active.count <- active.count - path.count - 1

        public:
            def proof_import_source(path: darray[u8]&, failed: mutable bool&) -> darray[u8] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
                output: mutable darray[u8] = []
                seen: mutable darray[u8] = []
                active: mutable darray[u8] = []
                normalized: darray[u8] = proof_absolute_path(path)
                proof_expand_file(normalized, &output, &seen, &active, 0, failed)
                return output
