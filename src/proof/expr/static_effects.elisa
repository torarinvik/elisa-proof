extend ElisaProof:
    public:
        # The compiler keeps a generic handler operation deferred until its enclosing clone is
        # type-checked. At the proof import boundary, only one candidate is safe to lower without
        # reproducing the compiler's type-directed selection. The backend emits exactly this
        # ordinary call: handler captures first, then the source arguments.
        def proof_lower_static_effect_call(expression: Ast::Expr) -> (known: bool, call: Ast::Expr):
            invalid: Ast::Expr = Ast::Expr.Invalid
            match expression:
                Ast::Expr.StaticEffectCall(_, _, candidates, arguments, argument_names, position):
                    return (false, invalid) if candidates.count != 1
                    return (false, invalid) if argument_names.count != 0 and argument_names.count != arguments.count
                    candidate: Ast::StaticEffectCandidate = candidates[0]
                    return (false, invalid) if candidate.callee == ""
                    callee: mutable Ast::Expr = Ast::Expr.Ident(candidate.callee, position)
                    if candidate.callee_owner != "":
                        owner: Ast::Expr = Ast::Expr.Ident(candidate.callee_owner, position)
                        callee <- Ast::Expr.Scope(owner, candidate.callee, position)
                    direct_arguments: mutable darray[Ast::Expr] = []
                    direct_names: mutable darray[sview] = []
                    for capture in candidate.captures |direct_arguments, direct_names|:
                        direct_arguments.push(capture)
                        direct_names.push("")
                    for index in 0..<arguments.count |index, arguments, argument_names, direct_arguments, direct_names|:
                        direct_arguments.push(arguments[index])
                        direct_names.push(argument_names[index] if argument_names.count == arguments.count else "")
                    return (true, Ast::Expr.Call(callee, direct_arguments, direct_names, position))
                _:
                    return (false, invalid)
