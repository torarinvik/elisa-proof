extend ElisaProof:
    private:
        # These helpers are used only after the enclosing expression has been validated. Public
        # array/field comparators below the module boundary continue to validate each root term.
        def proof_expr_array_equal_supported(left: darray[Ast::Expr]&, right: darray[Ast::Expr]&) -> bool:
            return false if left.count != right.count
            for index in 0..<left.count |left, right, index|:
                return false if not proof_expr_equal_supported(left[index], right[index])
            return true

        def proof_field_array_equal_supported(left: darray[Ast::FieldInit]&, right: darray[Ast::FieldInit]&) -> bool:
            return false if left.count != right.count
            for index in 0..<left.count |left, right, index|:
                return false if left[index].name != right[index].name
                return false if not proof_expr_equal_supported(left[index].value, right[index].value)
            return true

        def proof_dict_array_equal_supported(left: darray[Ast::DictEntry]&, right: darray[Ast::DictEntry]&) -> bool:
            return false if left.count != right.count
            for index in 0..<left.count |left, right, index|:
                return false if not proof_expr_equal_supported(left[index].key, right[index].key)
                return false if not proof_expr_equal_supported(left[index].value, right[index].value)
            return true

        def proof_expr_equal_supported(left: Ast::Expr, right: Ast::Expr) -> bool:
            # Parentheses are syntax, not propositions. Strip them from either side so
            # facts produced by contract parsing compare the same way as their normalized
            # goals, regardless of which expression was parenthesized.
            match right:
                Ast::Expr.Paren(inner, _):
                    return proof_expr_equal_supported(left, inner)
                _:
                    pass
            match left:
                Ast::Expr.Absent:
                    match right:
                        Ast::Expr.Absent:
                            return true
                        _:
                            return false
                Ast::Expr.IntLit(value, _):
                    match right:
                        Ast::Expr.IntLit(other, _):
                            return value == other
                        _:
                            return false
                Ast::Expr.BoolLit(value, _):
                    match right:
                        Ast::Expr.BoolLit(other, _):
                            return value == other
                        _:
                            return false
                Ast::Expr.FloatLit(value, _):
                    match right:
                        Ast::Expr.FloatLit(other, _):
                            return value == other
                        _:
                            return false
                Ast::Expr.StringLit(value, _):
                    match right:
                        Ast::Expr.StringLit(other, _):
                            return value == other
                        _:
                            return false
                Ast::Expr.CharLit(value, _):
                    match right:
                        Ast::Expr.CharLit(other, _):
                            return value == other
                        _:
                            return false
                Ast::Expr.Ident(name, _):
                    match right:
                        Ast::Expr.Ident(other, _):
                            return name == other
                        _:
                            return false
                Ast::Expr.Paren(inner, _):
                    return proof_expr_equal_supported(inner, right)
                Ast::Expr.Block(left_statements, left_value, left_captures, _):
                    match right:
                        Ast::Expr.Block(right_statements, right_value, right_captures, _):
                            return proof_sview_array_equal(left_captures, right_captures) and proof_stmt_array_equal(left_statements, right_statements) and proof_expr_equal_supported(left_value, right_value)
                        _:
                            return false
                Ast::Expr.Match(left_scrutinee, left_arms, _):
                    match right:
                        Ast::Expr.Match(right_scrutinee, right_arms, _):
                            return proof_expr_equal_supported(left_scrutinee, right_scrutinee) and proof_match_arm_array_equal(left_arms, right_arms)
                        _:
                            return false
                Ast::Expr.Catch(left_guarded, left_arms, _):
                    match right:
                        Ast::Expr.Catch(right_guarded, right_arms, _):
                            return proof_expr_equal_supported(left_guarded, right_guarded) and proof_match_arm_array_equal(left_arms, right_arms)
                        _:
                            return false
                Ast::Expr.Comprehension(left_var, left_iterable, left_condition, left_body, _):
                    match right:
                        Ast::Expr.Comprehension(right_var, right_iterable, right_condition, right_body, _):
                            return left_var == right_var and proof_expr_equal_supported(left_iterable, right_iterable) and proof_expr_equal_supported(left_condition, right_condition) and proof_expr_equal_supported(left_body, right_body)
                        _:
                            return false
                Ast::Expr.Refinement(left_base, left_predicate, _):
                    match right:
                        Ast::Expr.Refinement(right_base, right_predicate, _):
                            return proof_expr_equal_supported(left_base, right_base) and proof_expr_equal_supported(left_predicate, right_predicate)
                        _:
                            return false
                Ast::Expr.GetElse(left_guarded, left_recovery, _):
                    match right:
                        Ast::Expr.GetElse(right_guarded, right_recovery, _):
                            return proof_expr_equal_supported(left_guarded, right_guarded) and proof_stmt_array_equal(left_recovery, right_recovery)
                        _:
                            return false
                Ast::Expr.Lambda(left_params, left_body, _):
                    match right:
                        Ast::Expr.Lambda(right_params, right_body, _):
                            return proof_sview_array_equal(left_params, right_params) and proof_stmt_array_equal(left_body, right_body)
                        _:
                            return false
                Ast::Expr.Unary(op, operand, _):
                    match right:
                        Ast::Expr.Unary(other_op, other_operand, _):
                            return op == other_op and proof_expr_equal_supported(operand, other_operand)
                        _:
                            return false
                Ast::Expr.Binary(left_operand, op, right_operand, _):
                    match right:
                        Ast::Expr.Binary(other_left, other_op, other_right, _):
                            return op == other_op and proof_expr_equal_supported(left_operand, other_left) and proof_expr_equal_supported(right_operand, other_right)
                        _:
                            return false
                Ast::Expr.Call(callee, arguments, argument_names, _):
                    match right:
                        Ast::Expr.Call(other_callee, other_arguments, other_argument_names, _):
                            return false if arguments.count != other_arguments.count
                            return false if not proof_sview_array_equal(argument_names, other_argument_names)
                            return false if not proof_expr_equal_supported(callee, other_callee)
                            for index in 0..<arguments.count |arguments, other_arguments, index|:
                                return false if not proof_expr_equal_supported(arguments[index], other_arguments[index])
                            return true
                        _:
                            return false
                Ast::Expr.Field(object, field, _):
                    match right:
                        Ast::Expr.Field(other_object, other_field, _):
                            return field == other_field and proof_expr_equal_supported(object, other_object)
                        _:
                            return false
                Ast::Expr.Scope(base, name, _):
                    match right:
                        Ast::Expr.Scope(other_base, other_name, _):
                            return name == other_name and proof_expr_equal_supported(base, other_base)
                        _:
                            return false
                Ast::Expr.ShorthandMember(parts, _):
                    match right:
                        Ast::Expr.ShorthandMember(other_parts, _):
                            return proof_sview_array_equal(parts, other_parts)
                        _:
                            return false
                Ast::Expr.Index(object, index, _):
                    match right:
                        Ast::Expr.Index(other_object, other_index, _):
                            return proof_expr_equal_supported(object, other_object) and proof_expr_equal_supported(index, other_index)
                        _:
                            return false
                Ast::Expr.Slice(object, low, high, _):
                    match right:
                        Ast::Expr.Slice(other_object, other_low, other_high, _):
                            return proof_expr_equal_supported(object, other_object) and proof_expr_equal_supported(low, other_low) and proof_expr_equal_supported(high, other_high)
                        _:
                            return false
                Ast::Expr.IndexN(object, arguments, _):
                    match right:
                        Ast::Expr.IndexN(other_object, other_arguments, _):
                            return proof_expr_equal_supported(object, other_object) and proof_expr_array_equal_supported(arguments, other_arguments)
                        _:
                            return false
                Ast::Expr.Move(operand, _):
                    match right:
                        Ast::Expr.Move(other_operand, _):
                            return proof_expr_equal_supported(operand, other_operand)
                        _:
                            return false
                Ast::Expr.RegionNew(operand, region, _):
                    match right:
                        Ast::Expr.RegionNew(other_operand, other_region, _):
                            return region == other_region and proof_expr_equal_supported(operand, other_operand)
                        _:
                            return false
                Ast::Expr.Array(elements, _):
                    match right:
                        Ast::Expr.Array(other_elements, _):
                            return proof_expr_array_equal_supported(elements, other_elements)
                        _:
                            return false
                Ast::Expr.Tuple(elements, _):
                    match right:
                        Ast::Expr.Tuple(other_elements, _):
                            return proof_expr_array_equal_supported(elements, other_elements)
                        _:
                            return false
                Ast::Expr.SetLit(elements, _):
                    match right:
                        Ast::Expr.SetLit(other_elements, _):
                            return proof_expr_array_equal_supported(elements, other_elements)
                        _:
                            return false
                Ast::Expr.DictLit(entries, _):
                    match right:
                        Ast::Expr.DictLit(other_entries, _):
                            return proof_dict_array_equal_supported(entries, other_entries)
                        _:
                            return false
                Ast::Expr.Construct(type_expression, fields, _):
                    match right:
                        Ast::Expr.Construct(other_type, other_fields, _):
                            return proof_expr_equal_supported(type_expression, other_type) and proof_field_array_equal_supported(fields, other_fields)
                        _:
                            return false
                Ast::Expr.RecordUpdate(base, fields, _):
                    match right:
                        Ast::Expr.RecordUpdate(other_base, other_fields, _):
                            return proof_expr_equal_supported(base, other_base) and proof_field_array_equal_supported(fields, other_fields)
                        _:
                            return false
                Ast::Expr.If(condition, then_expr, else_expr, _):
                    match right:
                        Ast::Expr.If(other_condition, other_then, other_else, _):
                            return proof_expr_equal_supported(condition, other_condition) and proof_expr_equal_supported(then_expr, other_then) and proof_expr_equal_supported(else_expr, other_else)
                        _:
                            return false
                _:
                    return false
