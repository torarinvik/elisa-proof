# Guard substitution must not recursively lower a nested match with a fresh local budget.
# Validate this source shape first and meter every expression and collection entry; nested
# matches and opaque statement forms fail closed.
extend ElisaProof:
    private:
        def proof_match_guard_shape_supported(expression: Ast::Expr, work: mutable usize&) -> bool:
            proof_match_guard_shape_supported_depth(expression, 0, &work)

        def proof_match_guard_shape_supported_depth(expression: Ast::Expr, depth: usize, work: mutable usize&) -> bool:
            return false if depth >= PROOF_PATTERN_WALK_DEPTH_LIMIT or work >= PROOF_PATTERN_WALK_WORK_LIMIT
            work <- work + 1
            match expression:
                Ast::Expr.Absent | Ast::Expr.IntLit(_, _) | Ast::Expr.FloatLit(_, _) | Ast::Expr.StringLit(_, _) | Ast::Expr.CharLit(_, _) | Ast::Expr.BoolLit(_, _) | Ast::Expr.Ident(_, _) | Ast::Expr.ShorthandMember(_, _):
                    return true
                Ast::Expr.Paren(inner, _) | Ast::Expr.Unary(_, inner, _) | Ast::Expr.Move(inner, _) | Ast::Expr.RegionNew(inner, _, _) | Ast::Expr.Field(inner, _, _) | Ast::Expr.Scope(inner, _, _):
                    return proof_match_guard_shape_supported_depth(inner, depth + 1, work)
                Ast::Expr.Binary(left, _, right, _) | Ast::Expr.Index(left, right, _) | Ast::Expr.Refinement(left, right, _):
                    return proof_match_guard_shape_supported_depth(left, depth + 1, work) and proof_match_guard_shape_supported_depth(right, depth + 1, work)
                Ast::Expr.Slice(object, low, high, _) | Ast::Expr.If(object, low, high, _):
                    return proof_match_guard_shape_supported_depth(object, depth + 1, work) and proof_match_guard_shape_supported_depth(low, depth + 1, work) and proof_match_guard_shape_supported_depth(high, depth + 1, work)
                Ast::Expr.Call(callee, arguments, _, _):
                    return false if not proof_match_guard_shape_supported_depth(callee, depth + 1, work)
                    for argument in arguments |depth, work|:
                        return false if work >= PROOF_PATTERN_WALK_WORK_LIMIT
                        work <- work + 1
                        return false if not proof_match_guard_shape_supported_depth(argument, depth + 1, work)
                    return true
                Ast::Expr.IndexN(object, arguments, _):
                    return false if not proof_match_guard_shape_supported_depth(object, depth + 1, work)
                    for argument in arguments |depth, work|:
                        return false if work >= PROOF_PATTERN_WALK_WORK_LIMIT
                        work <- work + 1
                        return false if not proof_match_guard_shape_supported_depth(argument, depth + 1, work)
                    return true
                Ast::Expr.Array(elements, _) | Ast::Expr.Tuple(elements, _) | Ast::Expr.SetLit(elements, _):
                    for element in elements |depth, work|:
                        return false if work >= PROOF_PATTERN_WALK_WORK_LIMIT
                        work <- work + 1
                        return false if not proof_match_guard_shape_supported_depth(element, depth + 1, work)
                    return true
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |depth, work|:
                        return false if work >= PROOF_PATTERN_WALK_WORK_LIMIT
                        work <- work + 1
                        return false if not proof_match_guard_shape_supported_depth(entry.key, depth + 1, work)
                        return false if not proof_match_guard_shape_supported_depth(entry.value, depth + 1, work)
                    return true
                Ast::Expr.Construct(type_expression, fields, _) | Ast::Expr.RecordUpdate(type_expression, fields, _):
                    return false if not proof_match_guard_shape_supported_depth(type_expression, depth + 1, work)
                    for field in fields |depth, work|:
                        return false if work >= PROOF_PATTERN_WALK_WORK_LIMIT
                        work <- work + 1
                        return false if not proof_match_guard_shape_supported_depth(field.value, depth + 1, work)
                    return true
                # Blocks can substitute a newly bound initializer into every later statement,
                # causing multiplicative growth. Keep that form opaque until substitution has
                # an output-aware meter; comprehensions are admitted with a scoped-binder bound.
                Ast::Expr.Block(_, _, _, _) | Ast::Expr.Match(_, _, _) | Ast::Expr.Catch(_, _, _) | Ast::Expr.GetElse(_, _, _) | Ast::Expr.Lambda(_, _, _) | Ast::Expr.StaticEffectCall(_, _, _, _, _, _) | Ast::Expr.Invalid:
                    return false
                Ast::Expr.Comprehension(_, iterable, condition, body, _):
                    return proof_match_guard_shape_supported_depth(iterable, depth + 1, work) and proof_match_guard_shape_supported_depth(condition, depth + 1, work) and proof_match_guard_shape_supported_depth(body, depth + 1, work)
                _:
                    return false
