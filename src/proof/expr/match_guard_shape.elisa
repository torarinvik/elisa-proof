# Validate substitution inputs with one caller-owned budget. Nested value matches and pure blocks
# are traversed here before recursive lowering, so the shared depth bound covers the full tree.
extend ElisaProof:
    private:
        def proof_match_guard_shape_supported(expression: Ast::Expr, work: mutable usize&, work_limit: usize) -> bool:
            proof_match_guard_shape_supported_depth(expression, 0, work, work_limit)

        def proof_match_guard_shape_supported_depth(expression: Ast::Expr, depth: usize, work: mutable usize&, work_limit: usize) -> bool:
            return false if depth >= PROOF_PATTERN_WALK_DEPTH_LIMIT or work >= work_limit
            work <- work + 1
            match expression:
                Ast::Expr.Absent | Ast::Expr.IntLit(_, _) | Ast::Expr.FloatLit(_, _) | Ast::Expr.StringLit(_, _) | Ast::Expr.CharLit(_, _) | Ast::Expr.BoolLit(_, _) | Ast::Expr.Ident(_, _) | Ast::Expr.ShorthandMember(_, _):
                    return true
                Ast::Expr.Paren(inner, _) | Ast::Expr.Unary(_, inner, _) | Ast::Expr.Move(inner, _) | Ast::Expr.RegionNew(inner, _, _) | Ast::Expr.Field(inner, _, _) | Ast::Expr.Scope(inner, _, _):
                    return proof_match_guard_shape_supported_depth(inner, depth + 1, work, work_limit)
                Ast::Expr.Binary(left, _, right, _) | Ast::Expr.Index(left, right, _) | Ast::Expr.Refinement(left, right, _):
                    return proof_match_guard_shape_supported_depth(left, depth + 1, work, work_limit) and proof_match_guard_shape_supported_depth(right, depth + 1, work, work_limit)
                Ast::Expr.Slice(object, low, high, _) | Ast::Expr.If(object, low, high, _):
                    return proof_match_guard_shape_supported_depth(object, depth + 1, work, work_limit) and proof_match_guard_shape_supported_depth(low, depth + 1, work, work_limit) and proof_match_guard_shape_supported_depth(high, depth + 1, work, work_limit)
                Ast::Expr.Call(callee, arguments, _, _):
                    return false if not proof_match_guard_shape_supported_depth(callee, depth + 1, work, work_limit)
                    for argument in arguments |depth, work, work_limit|:
                        return false if work >= work_limit
                        work <- work + 1
                        return false if not proof_match_guard_shape_supported_depth(argument, depth + 1, work, work_limit)
                    return true
                Ast::Expr.IndexN(object, arguments, _):
                    return false if not proof_match_guard_shape_supported_depth(object, depth + 1, work, work_limit)
                    for argument in arguments |depth, work, work_limit|:
                        return false if work >= work_limit
                        work <- work + 1
                        return false if not proof_match_guard_shape_supported_depth(argument, depth + 1, work, work_limit)
                    return true
                Ast::Expr.Array(elements, _) | Ast::Expr.Tuple(elements, _) | Ast::Expr.SetLit(elements, _):
                    for element in elements |depth, work, work_limit|:
                        return false if work >= work_limit
                        work <- work + 1
                        return false if not proof_match_guard_shape_supported_depth(element, depth + 1, work, work_limit)
                    return true
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |depth, work, work_limit|:
                        return false if work >= work_limit
                        work <- work + 1
                        return false if not proof_match_guard_shape_supported_depth(entry.key, depth + 1, work, work_limit)
                        return false if not proof_match_guard_shape_supported_depth(entry.value, depth + 1, work, work_limit)
                    return true
                Ast::Expr.Construct(type_expression, fields, _) | Ast::Expr.RecordUpdate(type_expression, fields, _):
                    return false if not proof_match_guard_shape_supported_depth(type_expression, depth + 1, work, work_limit)
                    for field in fields |depth, work, work_limit|:
                        return false if work >= work_limit
                        work <- work + 1
                        return false if not proof_match_guard_shape_supported_depth(field.value, depth + 1, work, work_limit)
                    return true
                Ast::Expr.Match(scrutinee, arms, _):
                    return false if arms.count == 0 or not proof_match_guard_shape_supported_depth(scrutinee, depth + 1, work, work_limit)
                    for arm in arms |depth, work, work_limit|:
                        return false if work >= work_limit
                        work <- work + 1
                        return false if arm.body.count != 1
                        if arm.guard != Ast::Expr.Absent:
                            return false if not proof_match_guard_shape_supported_depth(arm.guard, depth + 1, work, work_limit)
                        match arm.body[0]:
                            Ast::Stmt.Expr(value, _):
                                return false if not proof_match_guard_shape_supported_depth(value, depth + 1, work, work_limit)
                            _:
                                return false
                    return true
                Ast::Expr.Block(statements, value, captures, _):
                    # Substitution models only local value declarations and the final value;
                    # captures and effectful statements need a richer state model.
                    return false if captures.count != 0
                    for statement in statements |depth, work, work_limit|:
                        return false if work >= work_limit
                        work <- work + 1
                        match statement:
                            Ast::Stmt.VarDecl(_, _, initializer, _):
                                return false if not proof_match_guard_shape_supported_depth(initializer, depth + 1, work, work_limit)
                            _:
                                return false
                    return proof_match_guard_shape_supported_depth(value, depth + 1, work, work_limit)
                Ast::Expr.Catch(_, _, _) | Ast::Expr.GetElse(_, _, _) | Ast::Expr.Lambda(_, _, _) | Ast::Expr.StaticEffectCall(_, _, _, _, _, _) | Ast::Expr.Invalid:
                    return false
                Ast::Expr.Comprehension(_, iterable, condition, body, _):
                    return proof_match_guard_shape_supported_depth(iterable, depth + 1, work, work_limit) and proof_match_guard_shape_supported_depth(condition, depth + 1, work, work_limit) and proof_match_guard_shape_supported_depth(body, depth + 1, work, work_limit)
                _:
                    return false
