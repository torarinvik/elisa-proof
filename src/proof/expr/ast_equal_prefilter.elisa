# A cheap mismatch test run ahead of `proof_expr_equal`.
#
# `proof_expr_equal` validates both whole terms (`proof_kernel_expression_supported`) before the
# structural comparator runs. Most calls come from linear scans -- fact membership, duplicate
# checks, trace lookups -- and compare terms that differ near the root, so that validation was
# most of the cost of answering "no". `proof_expr_quick_differs` walks a few levels of both terms
# and reports a mismatch only where `proof_expr_equal_supported` itself returns false: the
# comparator strips parentheses on both sides and is otherwise a conjunction of same-variant,
# same-operator, same-name, same-literal and same-arity checks over the children, so one failed
# check anywhere already decides the comparison. `proof_expr_equal` answers false either for an
# unsupported term or for that comparator, so returning false early never changes its answer.
# Everything the walk does not look at (other variants, argument names, deeper levels) is left
# to the full path, which still validates and compares exactly as before.
extend ElisaProof:
    private:
        const PROOF_EXPR_QUICK_DIFFERS_DEPTH: usize = 6
        # Keep generic fact-membership hashes selective through the full depth the kernel admits.
        # This is separate from the intentionally shallow mismatch walk above: hash collisions
        # only cause extra exact comparisons, and truncating at six made deep same-prefix facts
        # scan linearly against one another.
        const PROOF_EXPR_SHAPE_HASH_DEPTH_LIMIT: usize = ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_BOUND

        # The variants the walk inspects, each of which the comparator only ever equates with the
        # same variant; zero for every other variant.
        def proof_expr_quick_kind(expression: Ast::Expr) -> usize:
            match expression:
                Ast::Expr.IntLit(_, _):
                    return 1
                Ast::Expr.BoolLit(_, _):
                    return 2
                Ast::Expr.Ident(_, _):
                    return 3
                Ast::Expr.Unary(_, _, _):
                    return 4
                Ast::Expr.Binary(_, _, _, _):
                    return 5
                Ast::Expr.Call(_, _, _, _):
                    return 6
                Ast::Expr.Field(_, _, _):
                    return 7
                Ast::Expr.Index(_, _, _):
                    return 8
                Ast::Expr.StringLit(_, _):
                    return 9
                _:
                    return 0

        # Extra tags keep trace-index hashes selective for expression forms that the
        # general quick-diff walk deliberately leaves untouched. These tags only partition
        # hashes; exact equality remains the proof-replay authority.
        def proof_expr_shape_kind(expression: Ast::Expr) -> usize:
            match expression:
                Ast::Expr.FloatLit(_, _):
                    return 10
                Ast::Expr.CharLit(_, _):
                    return 11
                Ast::Expr.Move(_, _):
                    return 12
                Ast::Expr.If(_, _, _, _):
                    return 13
                Ast::Expr.Construct(_, _, _):
                    return 14
                Ast::Expr.Scope(_, _, _):
                    return 15
                Ast::Expr.Tuple(_, _):
                    return 16
                Ast::Expr.Array(_, _):
                    return 17
                Ast::Expr.Block(_, _, _, _):
                    return 18
                _:
                    return proof_expr_quick_kind(expression)

        # Unknown operators share the fallback code. That can add collisions but cannot
        # make unequal terms match because the hash is only a prefilter.
        def proof_expr_shape_operator_code(operator: TokenKind) -> usize:
            return 1 if operator == TokenKind.Plus
            return 2 if operator == TokenKind.Minus
            return 3 if operator == TokenKind.Star
            return 4 if operator == TokenKind.Slash
            return 5 if operator == TokenKind.Percent
            return 6 if operator == TokenKind.EqEq
            return 7 if operator == TokenKind.BangEq
            return 8 if operator == TokenKind.Lt
            return 9 if operator == TokenKind.LtEq
            return 10 if operator == TokenKind.Gt
            return 11 if operator == TokenKind.GtEq
            return 12 if operator == TokenKind.And
            return 13 if operator == TokenKind.Or
            return 14 if operator == TokenKind.Not
            return 15 if operator == TokenKind.Is
            return 16 if operator == TokenKind.LShift
            return 17 if operator == TokenKind.RShift
            return 18 if operator == TokenKind.Ampersand
            return 19 if operator == TokenKind.Pipe
            return 20 if operator == TokenKind.Caret
            return 21 if operator == TokenKind.RangeLt
            return 22 if operator == TokenKind.RangeLe
            return 23 if operator == TokenKind.RangeGt
            return 24 if operator == TokenKind.LArrow
            return 0

    public:
        # True only when `proof_expr_equal_supported(left, right)` is certainly false. A
        # parenthesis counts as a level, so a long chain of them ends the walk undecided.
        def proof_expr_quick_differs(left: Ast::Expr, right: Ast::Expr, depth: usize) -> bool:
            return false if depth >= PROOF_EXPR_QUICK_DIFFERS_DEPTH
            match right:
                Ast::Expr.Paren(inner, _):
                    return proof_expr_quick_differs(left, inner, depth + 1)
                _:
                    pass
            # An inspected variant is equal only to the same variant; two uninspected variants
            # are left to the comparator.
            match left:
                Ast::Expr.Paren(inner, _):
                    return proof_expr_quick_differs(inner, right, depth + 1)
                Ast::Expr.IntLit(value, _):
                    match right:
                        Ast::Expr.IntLit(other, _):
                            return value != other
                        _:
                            return true
                Ast::Expr.BoolLit(value, _):
                    match right:
                        Ast::Expr.BoolLit(other, _):
                            return value != other
                        _:
                            return true
                Ast::Expr.Ident(name, _):
                    match right:
                        Ast::Expr.Ident(other, _):
                            return name != other
                        _:
                            return true
                Ast::Expr.StringLit(value, _):
                    match right:
                        Ast::Expr.StringLit(other, _):
                            return value != other
                        _:
                            return true
                Ast::Expr.Unary(operator, operand, _):
                    match right:
                        Ast::Expr.Unary(other_operator, other_operand, _):
                            return true if operator != other_operator
                            return proof_expr_quick_differs(operand, other_operand, depth + 1)
                        _:
                            return true
                Ast::Expr.Binary(left_operand, operator, right_operand, _):
                    match right:
                        Ast::Expr.Binary(other_left, other_operator, other_right, _):
                            return true if:
                                operator != other_operator
                                proof_expr_quick_differs(left_operand, other_left, depth + 1)
                            return proof_expr_quick_differs(right_operand, other_right, depth + 1)
                        _:
                            return true
                Ast::Expr.Call(callee, arguments, _, _):
                    match right:
                        Ast::Expr.Call(other_callee, other_arguments, _, _):
                            return true if:
                                arguments.count != other_arguments.count
                                proof_expr_quick_differs(callee, other_callee, depth + 1)
                            for index in 0..<arguments.count |arguments, other_arguments, index, depth|:
                                return true if proof_expr_quick_differs(arguments[index], other_arguments[index], depth + 1)
                            return false
                        _:
                            return true
                Ast::Expr.Field(object, field, _):
                    match right:
                        Ast::Expr.Field(other_object, other_field, _):
                            return true if field != other_field
                            return proof_expr_quick_differs(object, other_object, depth + 1)
                        _:
                            return true
                Ast::Expr.Index(object, index, _):
                    match right:
                        Ast::Expr.Index(other_object, other_index, _):
                            return true if proof_expr_quick_differs(object, other_object, depth + 1)
                            return proof_expr_quick_differs(index, other_index, depth + 1)
                        _:
                            return true
                _:
                    return proof_expr_quick_kind(right) != 0
            return false

        # A hash that `proof_expr_equal` respects: equal terms hash alike. It strips parentheses,
        # ignores source positions, and stops at the kernel replay depth bound; unhandled fields
        # may collide, but equality checks remain authoritative.
        # It selects candidates for an equality scan and never stands in for the comparison.
        def proof_expr_shape_hash(expression: Ast::Expr, depth: usize) -> u32:
            return proof_expr_shape_hash_stripped(expression, depth, 0)

        # Parentheses take no level of the walk, so terms equal up to parentheses reach the same
        # nodes at the same depth. A chain of them as long as the kernel's depth bound makes the
        # term unsupported, hence equal to nothing, so its hash is arbitrary.
        def proof_expr_shape_hash_stripped(expression: Ast::Expr, depth: usize, parentheses: usize) -> u32:
            basis: i64 = ElisaProofKernelCore::PROOF_KERNEL_FNV1A_OFFSET_BASIS
            match expression:
                Ast::Expr.Paren(inner, _):
                    return basis.u32() if parentheses >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_BOUND
                    return proof_expr_shape_hash_stripped(inner, depth, parentheses + 1)
                _:
                    pass
            hash: u32 = proof_expr_shape_mix(basis.u32(), proof_expr_shape_kind(expression).i64())
            return hash if depth >= PROOF_EXPR_SHAPE_HASH_DEPTH_LIMIT
            match expression:
                Ast::Expr.IntLit(value, _):
                    return proof_expr_shape_mix(proof_expr_shape_mix(hash, value), value >> 32)
                Ast::Expr.BoolLit(value, _):
                    return proof_expr_shape_mix(hash, 1 if value else 0)
                Ast::Expr.FloatLit(value, _) | Ast::Expr.StringLit(value, _) | Ast::Expr.CharLit(value, _):
                    return proof_expr_shape_mix(hash, proof_name_hash(value).i64())
                Ast::Expr.Ident(name, _):
                    return proof_expr_shape_mix(hash, proof_name_hash(name).i64())
                Ast::Expr.Unary(operator, operand, _):
                    mixed: u32 = proof_expr_shape_mix(hash, proof_expr_shape_operator_code(operator).i64())
                    return proof_expr_shape_mix(mixed, proof_expr_shape_hash(operand, depth + 1).i64())
                Ast::Expr.Move(operand, _):
                    return proof_expr_shape_mix(hash, proof_expr_shape_hash(operand, depth + 1).i64())
                Ast::Expr.Binary(left, operator, right, _):
                    mixed: mutable u32 = proof_expr_shape_mix(hash, proof_expr_shape_operator_code(operator).i64())
                    mixed <- proof_expr_shape_mix(mixed, proof_expr_shape_hash(left, depth + 1).i64())
                    return proof_expr_shape_mix(mixed, proof_expr_shape_hash(right, depth + 1).i64())
                Ast::Expr.Call(callee, arguments, argument_names, _):
                    result: mutable u32 = proof_expr_shape_mix(proof_expr_shape_mix(hash, arguments.count.i64()), proof_expr_shape_hash(callee, depth + 1).i64())
                    for argument in arguments |argument, result, depth|:
                        result <- proof_expr_shape_mix(result, proof_expr_shape_hash(argument, depth + 1).i64())
                    result <- proof_expr_shape_mix(result, argument_names.count.i64())
                    for argument_name in argument_names |argument_name, result|:
                        result <- proof_expr_shape_mix(result, proof_name_hash(argument_name).i64())
                    return result
                Ast::Expr.If(condition, then_expression, else_expression, _):
                    mixed: mutable u32 = proof_expr_shape_mix(hash, proof_expr_shape_hash(condition, depth + 1).i64())
                    mixed <- proof_expr_shape_mix(mixed, proof_expr_shape_hash(then_expression, depth + 1).i64())
                    return proof_expr_shape_mix(mixed, proof_expr_shape_hash(else_expression, depth + 1).i64())
                Ast::Expr.Field(object, field, _):
                    return proof_expr_shape_mix(proof_expr_shape_mix(hash, proof_name_hash(field).i64()), proof_expr_shape_hash(object, depth + 1).i64())
                Ast::Expr.Scope(object, field, _):
                    return proof_expr_shape_mix(proof_expr_shape_mix(hash, proof_name_hash(field).i64()), proof_expr_shape_hash(object, depth + 1).i64())
                Ast::Expr.Index(object, index, _):
                    mixed: u32 = proof_expr_shape_mix(hash, proof_expr_shape_hash(object, depth + 1).i64())
                    return proof_expr_shape_mix(mixed, proof_expr_shape_hash(index, depth + 1).i64())
                Ast::Expr.Construct(type_expression, fields, _):
                    result: mutable u32 = proof_expr_shape_mix(proof_expr_shape_mix(hash, fields.count.i64()), proof_expr_shape_hash(type_expression, depth + 1).i64())
                    for field in fields |field, result, depth|:
                        result <- proof_expr_shape_mix(result, proof_name_hash(field.name).i64())
                        result <- proof_expr_shape_mix(result, proof_expr_shape_hash(field.value, depth + 1).i64())
                    return result
                Ast::Expr.Tuple(elements, _) | Ast::Expr.Array(elements, _):
                    result: mutable u32 = proof_expr_shape_mix(hash, elements.count.i64())
                    for element in elements |element, result, depth|:
                        result <- proof_expr_shape_mix(result, proof_expr_shape_hash(element, depth + 1).i64())
                    return result
                Ast::Expr.Block(statements, body, _, _):
                    result: mutable u32 = proof_expr_shape_mix(proof_expr_shape_mix(hash, statements.count.i64()), proof_expr_shape_hash(body, depth + 1).i64())
                    for statement in statements |statement, result, depth|:
                        match statement:
                            Ast::Stmt.VarDecl(name, type_expression, range_expression, _):
                                result <- proof_expr_shape_mix(result, proof_name_hash(name).i64())
                                result <- proof_expr_shape_mix(result, proof_expr_shape_hash(type_expression, depth + 1).i64())
                                result <- proof_expr_shape_mix(result, proof_expr_shape_hash(range_expression, depth + 1).i64())
                            _:
                                result <- proof_expr_shape_mix(result, 0)
                    return result
                _:
                    return hash
            hash

        def proof_expr_shape_mix(hash: u32, value: i64) -> u32:
            low: i64 = value & 4294967295
            return (((hash.i64() ^ low) * ElisaProofKernelCore::PROOF_KERNEL_FNV1A_PRIME) % ElisaProofKernelCore::PROOF_KERNEL_HASH_U32_MODULUS).u32()

        # Membership in a fact list through the hashes above: `hashes[i]` is the shape hash of
        # `facts[i]`, and only hash-equal entries are compared. Same answer as scanning every entry
        # with `proof_expr_equal`.
        def proof_fact_list_shape_hashes(facts: darray[Ast::Expr]&) -> darray[u32]:
            hashes: mutable darray[u32] = []
            for fact in facts |fact, hashes|:
                hashes.push(proof_expr_shape_hash(fact, 0))
            return hashes

        def proof_fact_list_contains_hashed(facts: darray[Ast::Expr]&, hashes: darray[u32]&, fact: Ast::Expr, hash: u32) -> bool:
            for index in 0..<facts.count |index, facts, hashes, fact, hash|:
                continue if index < hashes.count and hashes[index] != hash
                return true if proof_expr_equal(facts[index], fact)
            return false
