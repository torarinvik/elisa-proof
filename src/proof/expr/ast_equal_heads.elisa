# Cheap refutation for AST term equality, at the root and a few levels below it.
#
# `proof_expr_equal` admits both whole terms (two full kernel-support walks) before comparing
# them, and fact-membership scans call it once per fact, so nearly every call compares two terms
# that already differ at their roots. The structural comparator returns false for every such pair:
# after stripping parentheses from both sides it requires the same constructor, and for the forms
# below the same leaf payload, operator, field name or argument count, before it looks at any
# child. Answering those pairs first changes no result, since `supported and supported and false`
# is false whichever conjunct is evaluated first. It only skips the two walks.
extend ElisaProof:
    private:
        # Outer parentheses the refutation strips before giving up. Deeper chains fall back to the
        # full path, whose support walk rejects them at the kernel depth bound anyway.
        const PROOF_EXPR_HEAD_PAREN_LIMIT: usize = 32
        # Term levels the refutation descends through matching roots.
        const PROOF_EXPR_HEAD_DEPTH_LIMIT: usize = 4

        def proof_expr_head_unparenthesized(expression: Ast::Expr) -> (known: bool, value: Ast::Expr):
            current: mutable Ast::Expr = expression
            for step in 0..<PROOF_EXPR_HEAD_PAREN_LIMIT |current|:
                match current:
                    Ast::Expr.Paren(inner, _):
                        current <- inner
                    _:
                        return (true, current)
            return (false, current)

        # True only when the structural comparator is certain to return false for this pair.
        # False means "not decided here", never "equal".
        def proof_expr_heads_differ(left_term: Ast::Expr, right_term: Ast::Expr) -> bool:
            return proof_expr_terms_differ(left_term, right_term, 0)

        # When two roots agree, the comparator requires each child pair below to be equal, so a
        # refuted child pair refutes the parent as well. A few levels reach the operand that
        # tells apart facts of one shape, such as two marker calls on different names.
        def proof_expr_children_differ(left: Ast::Expr, right: Ast::Expr, depth: usize) -> bool:
            return depth + 1 < PROOF_EXPR_HEAD_DEPTH_LIMIT and proof_expr_terms_differ(left, right, depth + 1)

        def proof_expr_terms_differ(left_term: Ast::Expr, right_term: Ast::Expr, depth: usize) -> bool:
            left_head: (known: bool, value: Ast::Expr) = proof_expr_head_unparenthesized(left_term)
            right_head: (known: bool, value: Ast::Expr) = proof_expr_head_unparenthesized(right_term)
            return false if not left_head.known or not right_head.known
            left: Ast::Expr = left_head.value
            right: Ast::Expr = right_head.value
            match left:
                Ast::Expr.IntLit(value, _):
                    match right:
                        Ast::Expr.IntLit(other, _):
                            return value != other
                        _:
                            return true
                Ast::Expr.BoolLit(value, _):
                    match right:
                        Ast::Expr.BoolLit(other, _):
                            return value != other
                        _:
                            return true
                Ast::Expr.StringLit(value, _):
                    match right:
                        Ast::Expr.StringLit(other, _):
                            return value != other
                        _:
                            return true
                Ast::Expr.Ident(name, _):
                    match right:
                        Ast::Expr.Ident(other, _):
                            return name != other
                        _:
                            return true
                Ast::Expr.Unary(operator, operand, _):
                    match right:
                        Ast::Expr.Unary(other, other_operand, _):
                            return operator != other or proof_expr_children_differ(operand, other_operand, depth)
                        _:
                            return true
                Ast::Expr.Binary(left_operand, operator, right_operand, _):
                    match right:
                        Ast::Expr.Binary(other_left, other, other_right, _):
                            return true if operator != other
                            return proof_expr_children_differ(left_operand, other_left, depth) or proof_expr_children_differ(right_operand, other_right, depth)
                        _:
                            return true
                Ast::Expr.Call(callee, arguments, _, _):
                    match right:
                        Ast::Expr.Call(other_callee, other_arguments, _, _):
                            return true if arguments.count != other_arguments.count
                            return true if proof_expr_children_differ(callee, other_callee, depth)
                            for index in 0..<arguments.count |arguments, other_arguments, depth|:
                                return true if proof_expr_children_differ(arguments[index], other_arguments[index], depth)
                            return false
                        _:
                            return true
                Ast::Expr.Field(object, field, _):
                    match right:
                        Ast::Expr.Field(other_object, other, _):
                            return field != other or proof_expr_children_differ(object, other_object, depth)
                        _:
                            return true
                Ast::Expr.Index(object, index, _):
                    match right:
                        Ast::Expr.Index(other_object, other_index, _):
                            return proof_expr_children_differ(object, other_object, depth) or proof_expr_children_differ(index, other_index, depth)
                        _:
                            return true
                _:
                    return false
