extend ElisaProof:
    public:
        def proof_expr_is_call_rooted(expression: Ast::Expr) -> bool:
            return proof_expr_is_call_rooted_depth(expression, 0)

    private:
        def proof_expr_is_call_rooted_depth(expression: Ast::Expr, depth: usize) -> bool:
            return false if depth >= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT
            match expression:
                Ast::Expr.Call(_, _, _, _):
                    return true
                Ast::Expr.Paren(inner, _):
                    return proof_expr_is_call_rooted_depth(inner, depth + 1)
                _:
                    return false

    public:
        # Detect executable calls inside logical expressions. The checker resolves these calls
        # against its independently built pure-function table; this helper deliberately remains
        # syntax-only so an unknown call cannot be mistaken for `old(...)`.
        def proof_expr_has_executable_call(expression: Ast::Expr) -> bool:
            return proof_expr_has_executable_call_depth(expression, 0)

    private:
        def proof_expr_has_executable_call_depth(expression: Ast::Expr, depth: usize) -> bool:
            return true if depth >= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT
            match expression:
                Ast::Expr.Call(callee, arguments, _, _):
                    if proof_ident_name(callee) == "old" and arguments.count == 1:
                        return proof_expr_has_executable_call_depth(arguments[0], depth + 1)
                    return true
                Ast::Expr.Paren(inner, _):
                    return proof_expr_has_executable_call_depth(inner, depth + 1)
                Ast::Expr.Unary(_, operand, _):
                    return proof_expr_has_executable_call_depth(operand, depth + 1)
                Ast::Expr.Binary(left, _, right, _):
                    return proof_expr_has_executable_call_depth(left, depth + 1) or proof_expr_has_executable_call_depth(right, depth + 1)
                Ast::Expr.Field(object, _, _):
                    return proof_expr_has_executable_call_depth(object, depth + 1)
                Ast::Expr.Scope(base, _, _):
                    return proof_expr_has_executable_call_depth(base, depth + 1)
                Ast::Expr.Index(object, index, _):
                    return proof_expr_has_executable_call_depth(object, depth + 1) or proof_expr_has_executable_call_depth(index, depth + 1)
                Ast::Expr.Slice(object, low, high, _):
                    return proof_expr_has_executable_call_depth(object, depth + 1) or proof_expr_has_executable_call_depth(low, depth + 1) or proof_expr_has_executable_call_depth(high, depth + 1)
                Ast::Expr.IndexN(object, arguments, _):
                    return true if proof_expr_has_executable_call_depth(object, depth + 1)
                    for argument in arguments:
                        return true if proof_expr_has_executable_call_depth(argument, depth + 1)
                    return false
                Ast::Expr.Move(operand, _):
                    return proof_expr_has_executable_call_depth(operand, depth + 1)
                Ast::Expr.RegionNew(operand, _, _):
                    return proof_expr_has_executable_call_depth(operand, depth + 1)
                Ast::Expr.Array(elements, _):
                    for element in elements:
                        return true if proof_expr_has_executable_call_depth(element, depth + 1)
                    return false
                Ast::Expr.Tuple(elements, _):
                    for element in elements:
                        return true if proof_expr_has_executable_call_depth(element, depth + 1)
                    return false
                Ast::Expr.SetLit(elements, _):
                    for element in elements:
                        return true if proof_expr_has_executable_call_depth(element, depth + 1)
                    return false
                Ast::Expr.DictLit(entries, _):
                    for entry in entries:
                        return true if proof_expr_has_executable_call_depth(entry.key, depth + 1) or proof_expr_has_executable_call_depth(entry.value, depth + 1)
                    return false
                Ast::Expr.Construct(_, fields, _):
                    for field in fields:
                        return true if proof_expr_has_executable_call_depth(field.value, depth + 1)
                    return false
                Ast::Expr.RecordUpdate(base, fields, _):
                    return true if proof_expr_has_executable_call_depth(base, depth + 1)
                    for field in fields:
                        return true if proof_expr_has_executable_call_depth(field.value, depth + 1)
                    return false
                Ast::Expr.If(condition, then_expr, else_expr, _):
                    return proof_expr_has_executable_call_depth(condition, depth + 1) or proof_expr_has_executable_call_depth(then_expr, depth + 1) or proof_expr_has_executable_call_depth(else_expr, depth + 1)
                Ast::Expr.Match(scrutinee, arms, _):
                    return true if proof_expr_has_executable_call_depth(scrutinee, depth + 1)
                    for arm in arms:
                        return true if proof_expr_has_executable_call_depth(arm.guard, depth + 1)
                        return true if arm.body.count != 1
                        match arm.body[0]:
                            Ast::Stmt.Expr(value, _):
                                return true if proof_expr_has_executable_call_depth(value, depth + 1)
                            _:
                                return true
                    return false
                Ast::Expr.Comprehension(_, iterable, condition, body, _):
                    return proof_expr_has_executable_call_depth(iterable, depth + 1) or proof_expr_has_executable_call_depth(condition, depth + 1) or proof_expr_has_executable_call_depth(body, depth + 1)
                Ast::Expr.Refinement(base, predicate, _):
                    return proof_expr_has_executable_call_depth(base, depth + 1) or proof_expr_has_executable_call_depth(predicate, depth + 1)
                Ast::Expr.Block(statements, value, _, _):
                    for statement in statements:
                        match statement:
                            Ast::Stmt.VarDecl(_, _, initializer, _):
                                return true if proof_expr_has_executable_call_depth(initializer, depth + 1)
                            _:
                                return true
                    return proof_expr_has_executable_call_depth(value, depth + 1)
                _:
                    return false

        # Lower the proof-safe value-match fragment to the kernel's existing conditional form.
        # This is deliberately narrower than Elisa's runtime matcher: every arm must be a single
        # value expression, patterns may not bind payloads, and the final arm must be an unguarded
        # wildcard. That gives the kernel an exact decision tree instead of treating a match as an
        # opaque oracle. The richer pattern forms stay rejected until their projections and
        # exhaustiveness evidence have a certificate representation.
        def proof_match_closed_pattern(pattern: Ast::Pattern) -> bool:
            match pattern:
                Ast::Pattern.Wildcard:
                    return true
                Ast::Pattern.Literal(_):
                    return true
                Ast::Pattern.Range(_, _, _):
                    return true
                Ast::Pattern.Variant(_, fields):
                    for field in fields:
                        match field:
                            Ast::Pattern.Wildcard:
                                pass
                            Ast::Pattern.Field(selector, inner):
                                # Named payload selectors are stable compiler syntax. Restrict
                                # the nested pattern to a single wildcard or binding so the
                                # lowered arm can use the exact `scrutinee.field` projection;
                                # positional, nested, and literal payload patterns still need
                                # richer constructor evidence.
                                return false if selector == "" or inner.count != 1
                                match inner[0]:
                                    Ast::Pattern.Wildcard:
                                        pass
                                    Ast::Pattern.Binding(binding):
                                        return false if binding == ""
                                    _:
                                        return false
                            _:
                                return false
                    return true
                Ast::Pattern.Or(options):
                    return false if options.count == 0
                    for option in options:
                        return false if not proof_match_closed_pattern(option)
                    return true
                _:
                    return false

        def proof_match_pattern_condition(pattern: Ast::Pattern, scrutinee: Ast::Expr, position: Ast::Pos) -> Ast::Expr?:
            match pattern:
                Ast::Pattern.Wildcard:
                    return Ast::Expr.BoolLit(true, Ast::pos_at_line(0))
                Ast::Pattern.Or(options):
                    return null if options.count == 0
                    first: Ast::Expr? = proof_match_pattern_condition(options[0], scrutinee, position)
                    condition: mutable Ast::Expr = Ast::Expr.Invalid
                    if first is first_condition:
                        condition <- first_condition
                    else:
                        return null
                    index: mutable usize = 1
                    while index < options.count |index, options, scrutinee, position, condition|:
                        next: Ast::Expr? = proof_match_pattern_condition(options[index], scrutinee, position)
                        if next is next_condition:
                            condition <- Ast::Expr.Binary(condition, TokenKind.Or, next_condition, position)
                        else:
                            return null
                        index <- index + 1
                    return condition
                _:
                    return proof_pattern_condition(pattern, scrutinee, position)

        def proof_lower_value_match(expression: Ast::Expr) -> (known: bool, value: Ast::Expr):
            match expression:
                Ast::Expr.Match(scrutinee, arms, position):
                    return (false, Ast::Expr.Invalid) if arms.count == 0
                    return (false, Ast::Expr.Invalid) if proof_expr_has_call(scrutinee) or proof_expr_has_move(scrutinee)
                    return (false, Ast::Expr.Invalid) if not proof_expr_supported(scrutinee)
                    fallback: mutable Ast::Expr = Ast::Expr.Invalid
                    index: mutable usize = arms.count
                    while index > 0 |index, arms, position, fallback|:
                        index <- index - 1
                        arm: Ast::MatchArm = arms[index]
                        return (false, Ast::Expr.Invalid) if arm.body.count != 1
                        arm_value: mutable Ast::Expr = Ast::Expr.Invalid
                        match arm.body[0]:
                            Ast::Stmt.Expr(value, _):
                                arm_value <- value
                            _:
                                return (false, Ast::Expr.Invalid)
                        arm_names: mutable darray[sview] = []
                        arm_values: mutable darray[Ast::Expr] = []
                        return (false, Ast::Expr.Invalid) if not proof_bind_pattern(arm.pattern, position, scrutinee, &arm_names, &arm_values)
                        arm_value <- proof_substitute(arm_value, arm_names, arm_values)
                        # Calls in a value arm are admitted syntactically here. The statement
                        # boundary applies the stronger transitive-purity gate, and the return
                        # checker evaluates each arm against its own proof state. Keeping this
                        # lowering independent of the function table also lets logical helpers
                        # reuse the same decision-tree shape without treating an arbitrary call
                        # as a pure proposition.
                        return (false, Ast::Expr.Invalid) if proof_expr_has_move(arm_value)
                        return (false, Ast::Expr.Invalid) if not proof_expr_supported(arm_value)
                        if index == arms.count - 1:
                            match arm.pattern:
                                Ast::Pattern.Wildcard:
                                    pass
                                _:
                                    return (false, Ast::Expr.Invalid)
                            match arm.guard:
                                Ast::Expr.Absent:
                                    pass
                                _:
                                    return (false, Ast::Expr.Invalid)
                            fallback <- arm_value
                        else:
                            return (false, Ast::Expr.Invalid) if not proof_match_closed_pattern(arm.pattern)
                            condition: Ast::Expr? = proof_match_pattern_condition(arm.pattern, scrutinee, position)
                            resolved_condition: mutable Ast::Expr = Ast::Expr.Invalid
                            if condition is match_condition:
                                resolved_condition <- match_condition
                            else:
                                return (false, Ast::Expr.Invalid)
                            match arm.guard:
                                Ast::Expr.Absent:
                                    pass
                                _:
                                    return (false, Ast::Expr.Invalid) if proof_expr_has_call(arm.guard) or proof_expr_has_move(arm.guard)
                                    return (false, Ast::Expr.Invalid) if not proof_expr_supported(arm.guard)
                                    resolved_condition <- Ast::Expr.Binary(resolved_condition, TokenKind.And, arm.guard, position)
                            fallback <- Ast::Expr.If(resolved_condition, arm_value, fallback, position)
                    return (true, fallback)
                _:
                    return (false, Ast::Expr.Invalid)

        # Runtime expressions outside this modeled fragment are rejected at the statement
        # boundary. Treating them merely as opaque state havoc is not enough: a future expression
        # form may contain a hidden call, branch, or assignment that the proof kernel's evaluator
        # and call graph do not visit.
        def proof_expr_supported(expression: Ast::Expr) -> bool:
            return proof_expr_supported_depth(expression, 0)

    private:
        def proof_expr_supported_depth(expression: Ast::Expr, depth: usize) -> bool:
            return false if depth >= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT
            match expression:
                Ast::Expr.Invalid:
                    return false
                Ast::Expr.Absent:
                    return true
                Ast::Expr.IntLit(_, _):
                    return true
                Ast::Expr.FloatLit(_, _):
                    return true
                Ast::Expr.StringLit(_, _):
                    return true
                Ast::Expr.CharLit(_, _):
                    return true
                Ast::Expr.BoolLit(_, _):
                    return true
                Ast::Expr.Ident(_, _):
                    return true
                Ast::Expr.Call(callee, arguments, _, _):
                    return false if not proof_expr_supported_depth(callee, depth + 1)
                    for argument in arguments:
                        return false if not proof_expr_supported_depth(argument, depth + 1)
                    return true
                Ast::Expr.Paren(inner, _):
                    return proof_expr_supported_depth(inner, depth + 1)
                Ast::Expr.Unary(_, operand, _):
                    return proof_expr_supported_depth(operand, depth + 1)
                Ast::Expr.Binary(left, operator, right, _):
                    # Calls are admitted here as syntax only. Every proof-state/runtime caller
                    # applies its stronger effect and purity gate separately; rejecting a call
                    # merely because it appears under `and`/`or` would also reject short-circuit
                    # guards in otherwise total pure helper functions.
                    return proof_expr_supported_depth(left, depth + 1) and proof_expr_supported_depth(right, depth + 1)
                Ast::Expr.Field(object, _, _):
                    return proof_expr_supported_depth(object, depth + 1)
                Ast::Expr.Scope(base, _, _):
                    return proof_expr_supported_depth(base, depth + 1)
                Ast::Expr.Index(object, index, _):
                    return proof_expr_supported_depth(object, depth + 1) and proof_expr_supported_depth(index, depth + 1)
                Ast::Expr.Slice(object, low, high, _):
                    return proof_expr_supported_depth(object, depth + 1) and proof_expr_supported_depth(low, depth + 1) and proof_expr_supported_depth(high, depth + 1)
                Ast::Expr.IndexN(object, arguments, _):
                    return false if not proof_expr_supported_depth(object, depth + 1)
                    for argument in arguments:
                        return false if not proof_expr_supported_depth(argument, depth + 1)
                    return true
                Ast::Expr.Move(operand, _):
                    # Runtime ownership transfer is modeled at the statement boundary. The
                    # checker invalidates the moved root and all facts after the expression has
                    # evaluated; it is never transparent in a logical contract or pure summary.
                    return proof_expr_supported_depth(operand, depth + 1)
                Ast::Expr.RegionNew(operand, _, _):
                    # Region allocation has lifetime and allocation effects not represented in
                    # the symbolic state, so it must not enter a verified proof transition.
                    return false
                Ast::Expr.Array(elements, _):
                    for element in elements:
                        return false if not proof_expr_supported_depth(element, depth + 1)
                    return true
                Ast::Expr.Tuple(elements, _):
                    for element in elements:
                        return false if not proof_expr_supported_depth(element, depth + 1)
                    return true
                Ast::Expr.SetLit(elements, _):
                    for element in elements:
                        return false if not proof_expr_supported_depth(element, depth + 1)
                    return true
                Ast::Expr.DictLit(entries, _):
                    for entry in entries:
                        return false if not proof_expr_supported_depth(entry.key, depth + 1) or not proof_expr_supported_depth(entry.value, depth + 1)
                    return true
                Ast::Expr.Construct(_, fields, _):
                    for field in fields:
                        return false if not proof_expr_supported_depth(field.value, depth + 1)
                    return true
                Ast::Expr.RecordUpdate(base, fields, _):
                    return false if not proof_expr_supported_depth(base, depth + 1)
                    for field in fields:
                        return false if not proof_expr_supported_depth(field.value, depth + 1)
                    return true
                Ast::Expr.If(condition, then_expr, else_expr, _):
                    return false if proof_expr_has_call(condition) or proof_expr_has_call(then_expr) or proof_expr_has_call(else_expr)
                    return proof_expr_supported_depth(condition, depth + 1) and proof_expr_supported_depth(then_expr, depth + 1) and proof_expr_supported_depth(else_expr, depth + 1)
                Ast::Expr.Comprehension(_, iterable, condition, body, _):
                    return false if proof_expr_has_call(iterable) or proof_expr_has_call(condition) or proof_expr_has_call(body)
                    return proof_expr_supported_depth(iterable, depth + 1) and proof_expr_supported_depth(condition, depth + 1) and proof_expr_supported_depth(body, depth + 1)
                Ast::Expr.Refinement(base, predicate, _):
                    return false if proof_expr_has_call(base) or proof_expr_has_call(predicate)
                    return proof_expr_supported_depth(base, depth + 1) and proof_expr_supported_depth(predicate, depth + 1)
                Ast::Expr.Block(statements, value, captures, _):
                    # Captured value blocks synthesize writes back into their outer bindings.
                    # The proof state does not model that write-back, so accepting the block as
                    # a pure expression would let an outer fact survive a hidden mutation.
                    return false if captures.count > 0
                    return false if proof_expr_has_call(value)
                    for statement in statements:
                        match statement:
                            Ast::Stmt.VarDecl(_, _, initializer, _):
                                return false if proof_expr_has_call(initializer)
                                return false if not proof_expr_supported_depth(initializer, depth + 1)
                            _:
                                return false
                    return proof_expr_supported_depth(value, depth + 1)
                Ast::Expr.Match(_, _, _):
                    lowered: (known: bool, value: Ast::Expr) = proof_lower_value_match(expression)
                    return lowered.known
                Ast::Expr.Catch(_, _, _):
                    return false
                Ast::Expr.GetElse(_, _, _):
                    return false
                Ast::Expr.Lambda(_, _, _):
                    return false
                Ast::Expr.ShorthandMember(parts, _):
                    # A single leading-dot enum member is a closed, pure value atom. Keep
                    # qualified shorthand paths out until the source type/module identity is
                    # represented in the certificate term.
                    return parts.count == 1 and parts[0] != ""
                _:
                    return false

    public:
        # Collect callable leaves for the proof kernel's call graph. Unsupported expression
        # forms become an opaque edge so a hidden recursive call cannot be admitted by a summary
        # lookup. This graph is only used to prevent circular executable postcondition proofs;
        # it is not a semantic call-resolution replacement for the compiler.
        def proof_collect_call_names(expression: Ast::Expr, names: mutable darray[sview]&) -> void:
            match expression:
                Ast::Expr.Invalid:
                    pass
                Ast::Expr.Absent:
                    pass
                Ast::Expr.IntLit(_, _):
                    pass
                Ast::Expr.FloatLit(_, _):
                    pass
                Ast::Expr.StringLit(_, _):
                    pass
                Ast::Expr.CharLit(_, _):
                    pass
                Ast::Expr.BoolLit(_, _):
                    pass
                Ast::Expr.Ident(_, _):
                    pass
                Ast::Expr.Call(callee, arguments, _, _):
                    called: sview = proof_callable_name(callee)
                    names.push(called) if called != "" and not (any existing in names where existing == called)
                    proof_collect_call_names(callee, names)
                    for argument in arguments |names|:
                        proof_collect_call_names(argument, names)
                Ast::Expr.Paren(inner, _):
                    proof_collect_call_names(inner, names)
                Ast::Expr.Unary(_, operand, _):
                    proof_collect_call_names(operand, names)
                Ast::Expr.Binary(left, _, right, _):
                    proof_collect_call_names(left, names)
                    proof_collect_call_names(right, names)
                Ast::Expr.Field(object, _, _):
                    proof_collect_call_names(object, names)
                Ast::Expr.Scope(base, _, _):
                    proof_collect_call_names(base, names)
                Ast::Expr.Index(object, index, _):
                    proof_collect_call_names(object, names)
                    proof_collect_call_names(index, names)
                Ast::Expr.Slice(object, low, high, _):
                    proof_collect_call_names(object, names)
                    proof_collect_call_names(low, names)
                    proof_collect_call_names(high, names)
                Ast::Expr.IndexN(object, arguments, _):
                    proof_collect_call_names(object, names)
                    for argument in arguments |names|:
                        proof_collect_call_names(argument, names)
                Ast::Expr.Move(operand, _):
                    proof_collect_call_names(operand, names)
                Ast::Expr.RegionNew(operand, _, _):
                    proof_collect_call_names(operand, names)
                Ast::Expr.Array(elements, _):
                    for element in elements |names|:
                        proof_collect_call_names(element, names)
                Ast::Expr.Tuple(elements, _):
                    for element in elements |names|:
                        proof_collect_call_names(element, names)
                Ast::Expr.SetLit(elements, _):
                    for element in elements |names|:
                        proof_collect_call_names(element, names)
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |names|:
                        proof_collect_call_names(entry.key, names)
                        proof_collect_call_names(entry.value, names)
                Ast::Expr.Construct(_, fields, _):
                    for field in fields |names|:
                        proof_collect_call_names(field.value, names)
                Ast::Expr.RecordUpdate(base, fields, _):
                    proof_collect_call_names(base, names)
                    for field in fields |names|:
                        proof_collect_call_names(field.value, names)
                Ast::Expr.If(condition, then_expr, else_expr, _):
                    proof_collect_call_names(condition, names)
                    proof_collect_call_names(then_expr, names)
                    proof_collect_call_names(else_expr, names)
                Ast::Expr.Comprehension(_, iterable, condition, body, _):
                    proof_collect_call_names(iterable, names)
                    proof_collect_call_names(condition, names)
                    proof_collect_call_names(body, names)
                Ast::Expr.Refinement(base, predicate, _):
                    proof_collect_call_names(base, names)
                    proof_collect_call_names(predicate, names)
                Ast::Expr.Match(scrutinee, arms, _):
                    proof_collect_call_names(scrutinee, names)
                    for arm in arms |names|:
                        proof_collect_call_names(arm.guard, names)
                        proof_collect_body_call_names(arm.body, names)
                Ast::Expr.Catch(guarded, arms, _):
                    proof_collect_call_names(guarded, names)
                    for arm in arms |names|:
                        proof_collect_call_names(arm.guard, names)
                        proof_collect_body_call_names(arm.body, names)
                Ast::Expr.GetElse(guarded, recovery, _):
                    proof_collect_call_names(guarded, names)
                    proof_collect_body_call_names(recovery, names)
                Ast::Expr.Lambda(_, _, _):
                    # A lambda may be invoked through an opaque value later. Treat its body as
                    # an opaque edge until closure invocation is represented in the graph.
                    names.push("__opaque_call__") if not (any existing in names where existing == "__opaque_call__")
                Ast::Expr.ShorthandMember(_, _):
                    pass
                Ast::Expr.Block(statements, value, _, _):
                    proof_collect_body_call_names(statements, names)
                    proof_collect_call_names(value, names)
                _:
                    names.push("__opaque_call__") if not (any existing in names where existing == "__opaque_call__")
