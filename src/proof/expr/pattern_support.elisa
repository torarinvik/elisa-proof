extend ElisaProof:
    public:
        # Lower only single-expression arms with an unguarded final wildcard. Non-final patterns
        # need exact conditions and modeled payload projections; other forms need richer kernel
        # evidence before they can be admitted.
        def proof_match_closed_pattern(pattern: Ast::Pattern) -> bool:
            work: mutable usize = 0
            return proof_match_closed_pattern_depth(pattern, 0, false, &work)

        def proof_match_closed_pattern_depth(pattern: Ast::Pattern, depth: usize, or_alternative: bool, work: mutable usize&) -> bool:
            return false if depth >= PROOF_PATTERN_WALK_DEPTH_LIMIT or work >= PROOF_PATTERN_WALK_WORK_LIMIT
            work <- work + 1
            match pattern:
                Ast::Pattern.Wildcard:
                    return true
                Ast::Pattern.Literal(_):
                    return true
                Ast::Pattern.Range(_, _, _):
                    return true
                Ast::Pattern.Variant(_, fields):
                    for field in fields |work|:
                        return false if work >= PROOF_PATTERN_WALK_WORK_LIMIT
                        work <- work + 1
                        match field:
                            Ast::Pattern.Wildcard:
                                pass
                            Ast::Pattern.Field(selector, inner):
                                # Named payload selectors are stable compiler syntax. Restrict
                                # the nested pattern to a single wildcard or binding so the
                                # lowered arm can use the exact `scrutinee.field` projection;
                                # positional, nested, and literal payload patterns still need
                                # richer constructor evidence.
                                return false if selector == "" or inner.count != 1
                                match inner[0]:
                                    Ast::Pattern.Wildcard:
                                        pass
                                    Ast::Pattern.Binding(binding):
                                        return false if binding == "" or or_alternative
                                    _:
                                        return false
                            _:
                                return false
                    return true
                Ast::Pattern.Or(options):
                    return false if options.count == 0
                    for option in options |depth, work|:
                        # Alternative-specific binders cannot be represented by `proof_bind_pattern`;
                        # rejecting them prevents substituting an outer name for a branch-local one.
                        return false if not proof_match_closed_pattern_depth(option, depth + 1, true, work)
                    return true
                _:
                    return false

        def proof_match_pattern_condition(pattern: Ast::Pattern, scrutinee: Ast::Expr, position: Ast::Pos) -> Ast::Expr?:
            work: mutable usize = 0
            return proof_match_pattern_condition_depth(pattern, scrutinee, position, 0, &work)

        def proof_match_pattern_condition_depth(pattern: Ast::Pattern, scrutinee: Ast::Expr, position: Ast::Pos, depth: usize, work: mutable usize&) -> Ast::Expr?:
            return null if depth >= PROOF_PATTERN_WALK_DEPTH_LIMIT or work >= PROOF_PATTERN_WALK_WORK_LIMIT
            work <- work + 1
            match pattern:
                Ast::Pattern.Wildcard:
                    return Ast::Expr.BoolLit(true, Ast::pos_at_line(0))
                Ast::Pattern.Or(options):
                    return null if options.count == 0
                    first: Ast::Expr? = proof_match_pattern_condition_depth(options[0], scrutinee, position, depth + 1, work)
                    condition: mutable Ast::Expr = Ast::Expr.Invalid
                    if first is first_condition:
                        condition <- first_condition
                    else:
                        return null
                    index: mutable usize = 1
                    while index < options.count |index, options, scrutinee, position, condition, depth, work|:
                        next: Ast::Expr? = proof_match_pattern_condition_depth(options[index], scrutinee, position, depth + 1, work)
                        if next is next_condition:
                            condition <- Ast::Expr.Binary(condition, TokenKind.Or, next_condition, position)
                        else:
                            return null
                        index <- index + 1
                    return condition
                _:
                    return proof_pattern_condition(pattern, scrutinee, position)

        def proof_lower_value_match(expression: Ast::Expr) -> (known: bool, value: Ast::Expr):
            work: mutable usize = 0
            return proof_lower_value_match_with_work(expression, &work)

        def proof_lower_value_match_with_work(expression: Ast::Expr, work: mutable usize&) -> (known: bool, value: Ast::Expr):
            lowered: (known: bool, value: Ast::Expr) = proof_lower_value_match_core_with_work(expression, work)
            if not lowered.known:
                work <- PROOF_MATCH_LOWERING_WORK_LIMIT + 1
                return (false, Ast::Expr.Invalid)
            return lowered

        def proof_lower_value_match_core_with_work(expression: Ast::Expr, work: mutable usize&) -> (known: bool, value: Ast::Expr):
            return (false, Ast::Expr.Invalid) if work >= PROOF_MATCH_LOWERING_WORK_LIMIT
            match expression:
                Ast::Expr.Match(scrutinee, arms, position):
                    return (false, Ast::Expr.Invalid) if arms.count == 0 or not proof_match_guard_shape_supported(scrutinee, work, PROOF_MATCH_LOWERING_WORK_LIMIT)
                    scrutinee_cost: usize = 0
                    return (false, Ast::Expr.Invalid) if not proof_replay_summary_expr_cost_with_limit(scrutinee, &scrutinee_cost, work, PROOF_MATCH_LOWERING_WORK_LIMIT)
                    # The cost extraction plus the two legacy effect scans are covered here;
                    # the support walk below charges its own visits through the shared ref.
                    return (false, Ast::Expr.Invalid) if scrutinee_cost > (PROOF_MATCH_LOWERING_WORK_LIMIT - work) / 3
                    work <- work + scrutinee_cost * 3
                    return (false, Ast::Expr.Invalid) if proof_expr_has_call(scrutinee) or proof_expr_has_move(scrutinee) or not proof_expr_supported_with_work(scrutinee, work)
                    fallback: mutable Ast::Expr = Ast::Expr.Invalid
                    index: mutable usize = arms.count
                    while index > 0 |index, arms, position, fallback, work, scrutinee_cost|:
                        index <- index - 1
                        arm: Ast::MatchArm = arms[index]
                        return (false, Ast::Expr.Invalid) if arm.body.count != 1
                        arm_value: mutable Ast::Expr = Ast::Expr.Invalid
                        match arm.body[0]:
                            Ast::Stmt.Expr(value, _):
                                arm_value <- value
                            _:
                                return (false, Ast::Expr.Invalid)
                        pattern_cost: mutable usize = 0
                        return (false, Ast::Expr.Invalid) if not proof_replay_summary_pattern_cost(arm.pattern, &pattern_cost, work, 0) or pattern_cost == 0
                        return (false, Ast::Expr.Invalid) if pattern_cost > (PROOF_MATCH_LOWERING_WORK_LIMIT - work) / 2
                        work <- work + pattern_cost * 2
                        arm_names: mutable darray[sview] = []
                        arm_values: mutable darray[Ast::Expr] = []
                        return (false, Ast::Expr.Invalid) if not proof_bind_pattern(arm.pattern, position, scrutinee, &arm_names, &arm_values)
                        return (false, Ast::Expr.Invalid) if not proof_match_guard_shape_supported(arm_value, work, PROOF_MATCH_LOWERING_WORK_LIMIT)
                        arm_value <- proof_substitute_with_work(arm_value, arm_names, arm_values, work)
                        # Calls in a value arm are admitted syntactically here. The statement
                        # boundary applies the stronger transitive-purity gate, and the return
                        # checker evaluates each arm against its own proof state. Keeping this
                        # lowering independent of the function table also lets logical helpers
                        # reuse the same decision-tree shape without treating an arbitrary call
                        # as a pure proposition.
                        return (false, Ast::Expr.Invalid) if not proof_replay_summary_expr_repeat_charge_with_limit(arm_value, 1, work, PROOF_MATCH_LOWERING_WORK_LIMIT)
                        return (false, Ast::Expr.Invalid) if:
                            proof_expr_has_move(arm_value)
                            not proof_expr_supported_with_work(arm_value, work)
                        if index == arms.count - 1:
                            match arm.pattern:
                                Ast::Pattern.Wildcard:
                                    pass
                                _:
                                    return (false, Ast::Expr.Invalid)
                            match arm.guard:
                                Ast::Expr.Absent:
                                    pass
                                _:
                                    return (false, Ast::Expr.Invalid)
                            fallback <- arm_value
                        else:
                            return (false, Ast::Expr.Invalid) if not proof_match_lowering_charge(pattern_cost, work)
                            return (false, Ast::Expr.Invalid) if not proof_match_closed_pattern(arm.pattern)
                            condition_factor: usize = scrutinee_cost + 3
                            return (false, Ast::Expr.Invalid) if pattern_cost > (PROOF_MATCH_LOWERING_WORK_LIMIT - work) / condition_factor
                            condition_bound: usize = pattern_cost * condition_factor
                            work <- work + condition_bound
                            condition: Ast::Expr? = proof_match_pattern_condition(arm.pattern, scrutinee, position)
                            resolved_condition: mutable Ast::Expr = Ast::Expr.Invalid
                            if condition is match_condition:
                                resolved_condition <- match_condition
                            else:
                                return (false, Ast::Expr.Invalid)
                            match arm.guard:
                                Ast::Expr.Absent:
                                    pass
                                _:
                                    return (false, Ast::Expr.Invalid) if not proof_match_guard_shape_supported(arm.guard, work, PROOF_MATCH_LOWERING_WORK_LIMIT)
                                    # The shared substitution entrypoint reserves its own input
                                    # scan, mapping probes, and output growth before rebuilding.
                                    substituted_guard: Ast::Expr = proof_substitute_with_work(arm.guard, arm_names, arm_values, work)
                                    return (false, Ast::Expr.Invalid) if not proof_replay_summary_expr_repeat_charge_with_limit(substituted_guard, 2, work, PROOF_MATCH_LOWERING_WORK_LIMIT)
                                    return (false, Ast::Expr.Invalid) if:
                                        proof_expr_has_call(substituted_guard) or proof_expr_has_move(substituted_guard)
                                        not proof_expr_supported_with_work(substituted_guard, work)
                                    resolved_condition <- Ast::Expr.Binary(resolved_condition, TokenKind.And, substituted_guard, position)
                            fallback <- Ast::Expr.If(resolved_condition, arm_value, fallback, position)
                    return (true, fallback)
                _:
                    return (false, Ast::Expr.Invalid)

        # Runtime expressions outside this modeled fragment are rejected at the statement
        # boundary. Treating them merely as opaque state havoc is not enough: a future expression
        # form may contain a hidden call, branch, or assignment that the proof kernel's evaluator
        # and call graph do not visit.
        def proof_expr_supported(expression: Ast::Expr) -> bool:
            work: mutable usize = 0
            return proof_expr_supported_with_work(expression, &work)

        def proof_expr_supported_with_work(expression: Ast::Expr, work: mutable usize&) -> bool:
            proof_expr_supported_depth_with_work(expression, 0, work)

    private:
        def proof_expr_supported_depth_with_work(expression: Ast::Expr, depth: usize, work: mutable usize&) -> bool:
            return false if not proof_match_lowering_charge(1, work)
            return false if depth >= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT
            match expression:
                Ast::Expr.Invalid:
                    return false
                Ast::Expr.Absent:
                    return true
                Ast::Expr.IntLit(_, _):
                    return true
                Ast::Expr.FloatLit(_, _):
                    return true
                Ast::Expr.StringLit(_, _):
                    return true
                Ast::Expr.CharLit(_, _):
                    return true
                Ast::Expr.BoolLit(_, _):
                    return true
                Ast::Expr.Ident(_, _):
                    return true
                Ast::Expr.Call(callee, arguments, _, _):
                    return false if not proof_expr_supported_depth_with_work(callee, depth + 1, work)
                    for argument in arguments:
                        return false if not proof_expr_supported_depth_with_work(argument, depth + 1, work)
                    return true
                Ast::Expr.Paren(inner, _):
                    return proof_expr_supported_depth_with_work(inner, depth + 1, work)
                Ast::Expr.Unary(_, operand, _):
                    return proof_expr_supported_depth_with_work(operand, depth + 1, work)
                Ast::Expr.Binary(left, operator, right, _):
                    # Calls are admitted here as syntax only. Every proof-state/runtime caller
                    # applies its stronger effect and purity gate separately; rejecting a call
                    # merely because it appears under `and`/`or` would also reject short-circuit
                    # guards in otherwise total pure helper functions.
                    return proof_expr_supported_depth_with_work(left, depth + 1, work) and proof_expr_supported_depth_with_work(right, depth + 1, work)
                Ast::Expr.Field(object, _, _):
                    return proof_expr_supported_depth_with_work(object, depth + 1, work)
                Ast::Expr.Scope(base, _, _):
                    return proof_expr_supported_depth_with_work(base, depth + 1, work)
                Ast::Expr.Index(object, index, _):
                    return proof_expr_supported_depth_with_work(object, depth + 1, work) and proof_expr_supported_depth_with_work(index, depth + 1, work)
                Ast::Expr.Slice(object, low, high, _):
                    return proof_expr_supported_depth_with_work(object, depth + 1, work) and proof_expr_supported_depth_with_work(low, depth + 1, work) and proof_expr_supported_depth_with_work(high, depth + 1, work)
                Ast::Expr.IndexN(object, arguments, _):
                    return false if not proof_expr_supported_depth_with_work(object, depth + 1, work)
                    for argument in arguments:
                        return false if not proof_expr_supported_depth_with_work(argument, depth + 1, work)
                    return true
                Ast::Expr.Move(operand, _):
                    # Runtime ownership transfer is modeled at the statement boundary. The
                    # checker invalidates the moved root and all facts after the expression has
                    # evaluated; it is never transparent in a logical contract or pure summary.
                    return proof_expr_supported_depth_with_work(operand, depth + 1, work)
                Ast::Expr.RegionNew(operand, _, _):
                    # Region allocation has lifetime and allocation effects not represented in
                    # the symbolic state, so it must not enter a verified proof transition.
                    return false
                Ast::Expr.Array(elements, _):
                    for element in elements:
                        return false if not proof_expr_supported_depth_with_work(element, depth + 1, work)
                    return true
                Ast::Expr.Tuple(elements, _):
                    for element in elements:
                        return false if not proof_expr_supported_depth_with_work(element, depth + 1, work)
                    return true
                Ast::Expr.SetLit(elements, _):
                    for element in elements:
                        return false if not proof_expr_supported_depth_with_work(element, depth + 1, work)
                    return true
                Ast::Expr.DictLit(entries, _):
                    for entry in entries:
                        return false if not proof_expr_supported_depth_with_work(entry.key, depth + 1, work) or not proof_expr_supported_depth_with_work(entry.value, depth + 1, work)
                    return true
                Ast::Expr.Construct(type_expression, fields, _):
                    return false if not proof_expr_supported_depth_with_work(type_expression, depth + 1, work)
                    for field in fields:
                        return false if not proof_expr_supported_depth_with_work(field.value, depth + 1, work)
                    return true
                Ast::Expr.RecordUpdate(base, fields, _):
                    return false if not proof_expr_supported_depth_with_work(base, depth + 1, work)
                    for field in fields:
                        return false if not proof_expr_supported_depth_with_work(field.value, depth + 1, work)
                    return true
                Ast::Expr.If(condition, then_expr, else_expr, _):
                    # A conditional call may not run. Only integer conversions, which read their
                    # receiver and nothing else, may sit here; the runtime purity gate then
                    # refuses one that a source function shadows.
                    return false if not proof_replay_summary_expr_repeat_charge_with_limit(condition, 2, work, PROOF_MATCH_LOWERING_WORK_LIMIT)
                    return false if not proof_expr_calls_are_conversion_shapes(condition, depth + 1)
                    return false if not proof_replay_summary_expr_repeat_charge_with_limit(then_expr, 2, work, PROOF_MATCH_LOWERING_WORK_LIMIT)
                    return false if not proof_expr_calls_are_conversion_shapes(then_expr, depth + 1)
                    return false if not proof_replay_summary_expr_repeat_charge_with_limit(else_expr, 2, work, PROOF_MATCH_LOWERING_WORK_LIMIT)
                    return false if not proof_expr_calls_are_conversion_shapes(else_expr, depth + 1)
                    return proof_expr_supported_depth_with_work(condition, depth + 1, work) and proof_expr_supported_depth_with_work(then_expr, depth + 1, work) and proof_expr_supported_depth_with_work(else_expr, depth + 1, work)
                Ast::Expr.Comprehension(_, iterable, condition, body, _):
                    return false if not proof_replay_summary_expr_repeat_charge_with_limit(iterable, 1, work, PROOF_MATCH_LOWERING_WORK_LIMIT)
                    return false if not proof_replay_summary_expr_repeat_charge_with_limit(condition, 1, work, PROOF_MATCH_LOWERING_WORK_LIMIT)
                    return false if not proof_replay_summary_expr_repeat_charge_with_limit(body, 1, work, PROOF_MATCH_LOWERING_WORK_LIMIT)
                    return false if proof_expr_has_call(iterable) or proof_expr_has_call(condition) or proof_expr_has_call(body)
                    return proof_expr_supported_depth_with_work(iterable, depth + 1, work) and proof_expr_supported_depth_with_work(condition, depth + 1, work) and proof_expr_supported_depth_with_work(body, depth + 1, work)
                Ast::Expr.Refinement(base, predicate, _):
                    return false if not proof_replay_summary_expr_repeat_charge_with_limit(base, 1, work, PROOF_MATCH_LOWERING_WORK_LIMIT)
                    return false if not proof_replay_summary_expr_repeat_charge_with_limit(predicate, 1, work, PROOF_MATCH_LOWERING_WORK_LIMIT)
                    return false if proof_expr_has_call(base) or proof_expr_has_call(predicate)
                    return proof_expr_supported_depth_with_work(base, depth + 1, work) and proof_expr_supported_depth_with_work(predicate, depth + 1, work)
                Ast::Expr.Block(statements, value, captures, _):
                    # Captured value blocks synthesize writes back into their outer bindings.
                    # The proof state does not model that write-back, so accepting the block as
                    # a pure expression would let an outer fact survive a hidden mutation.
                    return false if:
                        captures.count > 0
                        not proof_replay_summary_expr_repeat_charge_with_limit(value, 1, work, PROOF_MATCH_LOWERING_WORK_LIMIT)
                        proof_expr_has_call(value)
                    for statement in statements:
                        match statement:
                            Ast::Stmt.VarDecl(_, _, initializer, _):
                                return false if not proof_replay_summary_expr_repeat_charge_with_limit(initializer, 1, work, PROOF_MATCH_LOWERING_WORK_LIMIT)
                                return false if:
                                    proof_expr_has_call(initializer)
                                    not proof_expr_supported_depth_with_work(initializer, depth + 1, work)
                            _:
                                return false
                    return proof_expr_supported_depth_with_work(value, depth + 1, work)
                Ast::Expr.Match(_, _, _):
                    lowered: (known: bool, value: Ast::Expr) = proof_lower_value_match_with_work(expression, work)
                    return false if not lowered.known
                    # Check the generated decision tree at its actual enclosing depth. The work
                    # cap alone is not a substitute for the kernel's AST-depth ceiling.
                    return proof_expr_supported_depth_with_work(lowered.value, depth + 1, work)
                Ast::Expr.Catch(_, _, _):
                    return false
                Ast::Expr.GetElse(_, _, _):
                    return false
                Ast::Expr.Lambda(_, _, _):
                    return false
                Ast::Expr.ShorthandMember(parts, _):
                    # A single leading-dot enum member is a closed, pure value atom. Keep
                    # qualified shorthand paths out until the source type/module identity is
                    # represented in the certificate term.
                    return parts.count == 1 and parts[0] != ""
                _:
                    return false

    public:
        # Every call in the term is a zero-argument integer conversion. Shapes not walked here
        # count only when they hold no call at all.
        def proof_expr_calls_are_conversion_shapes(expression: Ast::Expr, depth: usize) -> bool:
            return false if depth >= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT
            match expression:
                Ast::Expr.Call(callee, arguments, _, _):
                    return false if arguments.count != 0
                    match callee:
                        Ast::Expr.Field(receiver, target, _):
                            integer: bool = target in {"i8", "i16", "i32", "i64", "isize", "u8", "u16", "u32", "u64", "usize"}
                            return integer and proof_expr_calls_are_conversion_shapes(receiver, depth + 1)
                        _:
                            return false
                Ast::Expr.Paren(inner, _):
                    return proof_expr_calls_are_conversion_shapes(inner, depth + 1)
                Ast::Expr.Unary(_, operand, _):
                    return proof_expr_calls_are_conversion_shapes(operand, depth + 1)
                Ast::Expr.Binary(left, _, right, _):
                    return proof_expr_calls_are_conversion_shapes(left, depth + 1) and proof_expr_calls_are_conversion_shapes(right, depth + 1)
                Ast::Expr.Index(object, index, _):
                    return proof_expr_calls_are_conversion_shapes(object, depth + 1) and proof_expr_calls_are_conversion_shapes(index, depth + 1)
                Ast::Expr.Field(object, _, _):
                    return proof_expr_calls_are_conversion_shapes(object, depth + 1)
                _:
                    return not proof_expr_has_call(expression)

    private:
        # A pattern whose logical condition decides it exactly, so its negation holds on later
        # arms. Literal token kind is erased by this parser AST, so only the typed string path
        # can justify literal equality; the untyped exactness query always fails closed.
        def proof_pattern_condition_exact(pattern: Ast::Pattern) -> bool:
            work: mutable usize = 0
            return proof_pattern_condition_exact_depth(pattern, 0, work)

        def proof_pattern_condition_exact_depth(pattern: Ast::Pattern, depth: usize, work: mutable usize&) -> bool:
            return false if depth >= PROOF_PATTERN_WALK_DEPTH_LIMIT or work >= PROOF_PATTERN_WALK_WORK_LIMIT
            work <- work + 1
            match pattern:
                Ast::Pattern.As(_, inner):
                    return inner.count == 1 and proof_pattern_condition_exact_depth(inner[0], depth + 1, work)
                Ast::Pattern.Variant(_, fields):
                    for field in fields |fields, depth, work|:
                        return false if work >= PROOF_PATTERN_WALK_WORK_LIMIT
                        work <- work + 1
                        return false if not proof_pattern_irrefutable_depth(field, depth + 1, work)
                    return true
                Ast::Pattern.Literal(_):
                    return false
                Ast::Pattern.Range(_, _, _):
                    return false
                Ast::Pattern.Or(options):
                    return false if options.count == 0
                    for option in options |options, depth, work|:
                        return false if not proof_pattern_condition_exact_depth(option, depth + 1, work)
                    return true
                _:
                    return false

        def proof_pattern_irrefutable(pattern: Ast::Pattern) -> bool:
            work: mutable usize = 0
            return proof_pattern_irrefutable_depth(pattern, 0, work)

        def proof_pattern_irrefutable_depth(pattern: Ast::Pattern, depth: usize, work: mutable usize&) -> bool:
            return false if depth >= PROOF_PATTERN_WALK_DEPTH_LIMIT or work >= PROOF_PATTERN_WALK_WORK_LIMIT
            work <- work + 1
            match pattern:
                Ast::Pattern.Wildcard:
                    return true
                Ast::Pattern.Binding(_):
                    return true
                Ast::Pattern.As(_, inner):
                    return inner.count == 1 and proof_pattern_irrefutable_depth(inner[0], depth + 1, work)
                Ast::Pattern.Field(_, inner):
                    return inner.count == 1 and proof_pattern_irrefutable_depth(inner[0], depth + 1, work)
                _:
                    return false
