extend ElisaProof:
    public:
        def proof_expr_is_call_rooted(expression: Ast::Expr) -> bool:
            return proof_expr_is_call_rooted_depth(expression, 0)

    private:
        def proof_expr_is_call_rooted_depth(expression: Ast::Expr, depth: usize) -> bool:
            return false if depth >= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT
            match expression:
                Ast::Expr.Call(_, _, _, _):
                    return true
                Ast::Expr.StaticEffectCall(_, _, _, _, _, _):
                    return true
                Ast::Expr.Paren(inner, _):
                    return proof_expr_is_call_rooted_depth(inner, depth + 1)
                _:
                    return false

    public:
        # Detect executable calls inside logical expressions. The checker resolves these calls
        # against its independently built pure-function table; this helper deliberately remains
        # syntax-only so an unknown call cannot be mistaken for `old(...)`.
        def proof_expr_has_executable_call(expression: Ast::Expr) -> bool:
            return proof_expr_has_executable_call_depth(expression, 0)

    private:
        def proof_expr_has_executable_call_depth(expression: Ast::Expr, depth: usize) -> bool:
            return true if depth >= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT
            match expression:
                Ast::Expr.Absent:
                    return false
                Ast::Expr.IntLit(_, _):
                    return false
                Ast::Expr.FloatLit(_, _):
                    return false
                Ast::Expr.StringLit(_, _):
                    return false
                Ast::Expr.CharLit(_, _):
                    return false
                Ast::Expr.BoolLit(_, _):
                    return false
                Ast::Expr.Ident(_, _):
                    return false
                Ast::Expr.ShorthandMember(_, _):
                    return false
                Ast::Expr.Call(callee, arguments, _, _):
                    if proof_ident_name(callee) == "old" and arguments.count == 1:
                        return proof_expr_has_executable_call_depth(arguments[0], depth + 1)
                    return true
                Ast::Expr.StaticEffectCall(_, _, _, _, _, _):
                    return true
                Ast::Expr.Paren(inner, _):
                    return proof_expr_has_executable_call_depth(inner, depth + 1)
                Ast::Expr.Unary(_, operand, _):
                    return proof_expr_has_executable_call_depth(operand, depth + 1)
                Ast::Expr.Binary(left, _, right, _):
                    return proof_expr_has_executable_call_depth(left, depth + 1) or proof_expr_has_executable_call_depth(right, depth + 1)
                Ast::Expr.Field(object, _, _):
                    return proof_expr_has_executable_call_depth(object, depth + 1)
                Ast::Expr.Scope(base, _, _):
                    return proof_expr_has_executable_call_depth(base, depth + 1)
                Ast::Expr.Index(object, index, _):
                    return proof_expr_has_executable_call_depth(object, depth + 1) or proof_expr_has_executable_call_depth(index, depth + 1)
                Ast::Expr.Slice(object, low, high, _):
                    return proof_expr_has_executable_call_depth(object, depth + 1) or proof_expr_has_executable_call_depth(low, depth + 1) or proof_expr_has_executable_call_depth(high, depth + 1)
                Ast::Expr.IndexN(object, arguments, _):
                    return true if proof_expr_has_executable_call_depth(object, depth + 1)
                    for argument in arguments:
                        return true if proof_expr_has_executable_call_depth(argument, depth + 1)
                    return false
                Ast::Expr.Move(operand, _):
                    return proof_expr_has_executable_call_depth(operand, depth + 1)
                Ast::Expr.RegionNew(operand, _, _):
                    return proof_expr_has_executable_call_depth(operand, depth + 1)
                Ast::Expr.Array(elements, _):
                    for element in elements:
                        return true if proof_expr_has_executable_call_depth(element, depth + 1)
                    return false
                Ast::Expr.Tuple(elements, _):
                    for element in elements:
                        return true if proof_expr_has_executable_call_depth(element, depth + 1)
                    return false
                Ast::Expr.SetLit(elements, _):
                    for element in elements:
                        return true if proof_expr_has_executable_call_depth(element, depth + 1)
                    return false
                Ast::Expr.DictLit(entries, _):
                    for entry in entries:
                        return true if proof_expr_has_executable_call_depth(entry.key, depth + 1) or proof_expr_has_executable_call_depth(entry.value, depth + 1)
                    return false
                Ast::Expr.Construct(type_expression, fields, _):
                    return true if proof_expr_has_executable_call_depth(type_expression, depth + 1)
                    for field in fields:
                        return true if proof_expr_has_executable_call_depth(field.value, depth + 1)
                    return false
                Ast::Expr.RecordUpdate(base, fields, _):
                    return true if proof_expr_has_executable_call_depth(base, depth + 1)
                    for field in fields:
                        return true if proof_expr_has_executable_call_depth(field.value, depth + 1)
                    return false
                Ast::Expr.If(condition, then_expr, else_expr, _):
                    return proof_expr_has_executable_call_depth(condition, depth + 1) or proof_expr_has_executable_call_depth(then_expr, depth + 1) or proof_expr_has_executable_call_depth(else_expr, depth + 1)
                Ast::Expr.Match(scrutinee, arms, _):
                    return true if proof_expr_has_executable_call_depth(scrutinee, depth + 1)
                    for arm in arms:
                        return true if:
                            proof_expr_has_executable_call_depth(arm.guard, depth + 1)
                            arm.body.count != 1
                        match arm.body[0]:
                            Ast::Stmt.Expr(value, _):
                                return true if proof_expr_has_executable_call_depth(value, depth + 1)
                            _:
                                return true
                    return false
                Ast::Expr.Comprehension(_, iterable, condition, body, _):
                    return proof_expr_has_executable_call_depth(iterable, depth + 1) or proof_expr_has_executable_call_depth(condition, depth + 1) or proof_expr_has_executable_call_depth(body, depth + 1)
                Ast::Expr.Refinement(base, predicate, _):
                    return proof_expr_has_executable_call_depth(base, depth + 1) or proof_expr_has_executable_call_depth(predicate, depth + 1)
                Ast::Expr.Block(statements, value, _, _):
                    for statement in statements:
                        match statement:
                            Ast::Stmt.VarDecl(_, _, initializer, _):
                                return true if proof_expr_has_executable_call_depth(initializer, depth + 1)
                            _:
                                return true
                    return proof_expr_has_executable_call_depth(value, depth + 1)
                Ast::Expr.GetElse(_, _, _):
                    # Recovery contains executable control flow whose statement effects are
                    # checked elsewhere. Do not let the unconditional-call test treat it as a
                    # call-free value merely because this helper has no recovery-state model.
                    return true
                Ast::Expr.Lambda(_, _, _):
                    # A closure body is executable later, outside the current expression walk.
                    # Keep it opaque until a closure-aware effect model exists.
                    return true
                _:
                    # Unknown expression forms may contain an executable call. Callers use this
                    # predicate as an admission guard, so new syntax must fail closed.
                    return true

        # Lower only single-expression arms with an unguarded final wildcard. Non-final patterns
        # need exact conditions and modeled payload projections; other forms need richer kernel
        # evidence before they can be admitted.
        def proof_match_closed_pattern(pattern: Ast::Pattern) -> bool:
            work: mutable usize = 0
            return proof_match_closed_pattern_depth(pattern, 0, false, &work)

        def proof_match_closed_pattern_depth(pattern: Ast::Pattern, depth: usize, or_alternative: bool, work: mutable usize&) -> bool:
            return false if depth >= PROOF_PATTERN_WALK_DEPTH_LIMIT or work >= PROOF_PATTERN_WALK_WORK_LIMIT
            work <- work + 1
            match pattern:
                Ast::Pattern.Wildcard:
                    return true
                Ast::Pattern.Literal(_):
                    return true
                Ast::Pattern.Range(_, _, _):
                    return true
                Ast::Pattern.Variant(_, fields):
                    for field in fields |work|:
                        return false if work >= PROOF_PATTERN_WALK_WORK_LIMIT
                        work <- work + 1
                        match field:
                            Ast::Pattern.Wildcard:
                                pass
                            Ast::Pattern.Field(selector, inner):
                                # Named payload selectors are stable compiler syntax. Restrict
                                # the nested pattern to a single wildcard or binding so the
                                # lowered arm can use the exact `scrutinee.field` projection;
                                # positional, nested, and literal payload patterns still need
                                # richer constructor evidence.
                                return false if selector == "" or inner.count != 1
                                match inner[0]:
                                    Ast::Pattern.Wildcard:
                                        pass
                                    Ast::Pattern.Binding(binding):
                                        return false if binding == "" or or_alternative
                                    _:
                                        return false
                            _:
                                return false
                    return true
                Ast::Pattern.Or(options):
                    return false if options.count == 0
                    for option in options |depth, work|:
                        # Alternative-specific binders cannot be represented by `proof_bind_pattern`;
                        # rejecting them prevents substituting an outer name for a branch-local one.
                        return false if not proof_match_closed_pattern_depth(option, depth + 1, true, work)
                    return true
                _:
                    return false

        def proof_match_pattern_condition(pattern: Ast::Pattern, scrutinee: Ast::Expr, position: Ast::Pos) -> Ast::Expr?:
            work: mutable usize = 0
            return proof_match_pattern_condition_depth(pattern, scrutinee, position, 0, &work)

        def proof_match_pattern_condition_depth(pattern: Ast::Pattern, scrutinee: Ast::Expr, position: Ast::Pos, depth: usize, work: mutable usize&) -> Ast::Expr?:
            return null if depth >= PROOF_PATTERN_WALK_DEPTH_LIMIT or work >= PROOF_PATTERN_WALK_WORK_LIMIT
            work <- work + 1
            match pattern:
                Ast::Pattern.Wildcard:
                    return Ast::Expr.BoolLit(true, Ast::pos_at_line(0))
                Ast::Pattern.Or(options):
                    return null if options.count == 0
                    first: Ast::Expr? = proof_match_pattern_condition_depth(options[0], scrutinee, position, depth + 1, work)
                    condition: mutable Ast::Expr = Ast::Expr.Invalid
                    if first is first_condition:
                        condition <- first_condition
                    else:
                        return null
                    index: mutable usize = 1
                    while index < options.count |index, options, scrutinee, position, condition, depth, work|:
                        next: Ast::Expr? = proof_match_pattern_condition_depth(options[index], scrutinee, position, depth + 1, work)
                        if next is next_condition:
                            condition <- Ast::Expr.Binary(condition, TokenKind.Or, next_condition, position)
                        else:
                            return null
                        index <- index + 1
                    return condition
                _:
                    return proof_pattern_condition(pattern, scrutinee, position)

        def proof_lower_value_match(expression: Ast::Expr) -> (known: bool, value: Ast::Expr):
            match expression:
                Ast::Expr.Match(scrutinee, arms, position):
                    guard_work: mutable usize = 0
                    return (false, Ast::Expr.Invalid) if arms.count == 0 or not proof_match_guard_shape_supported(scrutinee, &guard_work)
                    scrutinee_cost: usize = 0
                    return (false, Ast::Expr.Invalid) if not proof_replay_summary_expr_cost_with_limit(scrutinee, &scrutinee_cost, guard_work, PROOF_PATTERN_WALK_WORK_LIMIT)
                    return (false, Ast::Expr.Invalid) if scrutinee_cost > (PROOF_PATTERN_WALK_WORK_LIMIT - guard_work) / 4
                    guard_work <- guard_work + scrutinee_cost * 4
                    return (false, Ast::Expr.Invalid) if proof_expr_has_call(scrutinee) or proof_expr_has_move(scrutinee) or not proof_expr_supported(scrutinee)
                    fallback: mutable Ast::Expr = Ast::Expr.Invalid
                    index: mutable usize = arms.count
                    while index > 0 |index, arms, position, fallback, guard_work, scrutinee_cost|:
                        index <- index - 1
                        arm: Ast::MatchArm = arms[index]
                        return (false, Ast::Expr.Invalid) if arm.body.count != 1
                        arm_value: mutable Ast::Expr = Ast::Expr.Invalid
                        match arm.body[0]:
                            Ast::Stmt.Expr(value, _):
                                arm_value <- value
                            _:
                                return (false, Ast::Expr.Invalid)
                        pattern_cost: mutable usize = 0
                        return (false, Ast::Expr.Invalid) if not proof_replay_summary_pattern_cost(arm.pattern, &pattern_cost, guard_work, 0) or pattern_cost == 0
                        return (false, Ast::Expr.Invalid) if pattern_cost > (PROOF_PATTERN_WALK_WORK_LIMIT - guard_work) / 2
                        guard_work <- guard_work + pattern_cost * 2
                        arm_names: mutable darray[sview] = []
                        arm_values: mutable darray[Ast::Expr] = []
                        return (false, Ast::Expr.Invalid) if not proof_bind_pattern(arm.pattern, position, scrutinee, &arm_names, &arm_values)
                        return (false, Ast::Expr.Invalid) if not proof_match_guard_shape_supported(arm_value, &guard_work)
                        arm_value_cost: usize = 0
                        return (false, Ast::Expr.Invalid) if not proof_replay_summary_expr_cost_with_limit(arm_value, &arm_value_cost, guard_work, PROOF_PATTERN_WALK_WORK_LIMIT)
                        return (false, Ast::Expr.Invalid) if arm_value_cost == 0 or arm_value_cost > PROOF_PATTERN_WALK_WORK_LIMIT - guard_work
                        guard_work <- guard_work + arm_value_cost
                        arm_replacement_cost: mutable usize = 1
                        for replacement in arm_values |replacement, arm_replacement_cost, guard_work|:
                            replacement_size: mutable usize = 0
                            return (false, Ast::Expr.Invalid) if not proof_replay_summary_expr_cost_with_limit(replacement, &replacement_size, guard_work, PROOF_PATTERN_WALK_WORK_LIMIT)
                            return (false, Ast::Expr.Invalid) if replacement_size > PROOF_PATTERN_WALK_WORK_LIMIT - guard_work
                            guard_work <- guard_work + replacement_size
                            arm_replacement_cost <- replacement_size if replacement_size > arm_replacement_cost
                        arm_binding_probe_cost: mutable usize = 0
                        for binding_name in arm_names |binding_name, arm_binding_probe_cost|:
                            probe_size: usize = 1 + sview_len(binding_name)
                            return (false, Ast::Expr.Invalid) if probe_size > PROOF_PATTERN_WALK_WORK_LIMIT - arm_binding_probe_cost
                            arm_binding_probe_cost <- arm_binding_probe_cost + probe_size
                        return (false, Ast::Expr.Invalid) if arm_binding_probe_cost > (PROOF_PATTERN_WALK_WORK_LIMIT - guard_work) / arm_value_cost
                        guard_work <- guard_work + arm_value_cost * arm_binding_probe_cost
                        # Every nested comprehension adds one lexical mapping. Account for
                        # repeated lookup across its body and capture scans over active
                        # replacement values before substitution enters those scopes.
                        return (false, Ast::Expr.Invalid) if arm_value_cost > (PROOF_PATTERN_WALK_WORK_LIMIT - guard_work) / arm_value_cost
                        guard_work <- guard_work + arm_value_cost * arm_value_cost
                        arm_scope_slots: usize = arm_names.count + arm_value_cost
                        return (false, Ast::Expr.Invalid) if arm_scope_slots > (PROOF_PATTERN_WALK_WORK_LIMIT - guard_work) / arm_value_cost
                        arm_scope_capture_base: usize = arm_value_cost * arm_scope_slots
                        return (false, Ast::Expr.Invalid) if arm_scope_capture_base > 0 and arm_replacement_cost > (PROOF_PATTERN_WALK_WORK_LIMIT - guard_work) / arm_scope_capture_base
                        guard_work <- guard_work + arm_scope_capture_base * arm_replacement_cost
                        return (false, Ast::Expr.Invalid) if arm_replacement_cost > (PROOF_PATTERN_WALK_WORK_LIMIT - guard_work) / arm_value_cost
                        arm_substitution_bound: usize = arm_value_cost * arm_replacement_cost
                        return (false, Ast::Expr.Invalid) if arm_substitution_bound > (PROOF_PATTERN_WALK_WORK_LIMIT - guard_work) / 3
                        guard_work <- guard_work + arm_substitution_bound * 3
                        arm_value <- proof_substitute(arm_value, arm_names, arm_values)
                        # Calls in a value arm are admitted syntactically here. The statement
                        # boundary applies the stronger transitive-purity gate, and the return
                        # checker evaluates each arm against its own proof state. Keeping this
                        # lowering independent of the function table also lets logical helpers
                        # reuse the same decision-tree shape without treating an arbitrary call
                        # as a pure proposition.
                        return (false, Ast::Expr.Invalid) if:
                            proof_expr_has_move(arm_value)
                            not proof_expr_supported(arm_value)
                        if index == arms.count - 1:
                            match arm.pattern:
                                Ast::Pattern.Wildcard:
                                    pass
                                _:
                                    return (false, Ast::Expr.Invalid)
                            match arm.guard:
                                Ast::Expr.Absent:
                                    pass
                                _:
                                    return (false, Ast::Expr.Invalid)
                            fallback <- arm_value
                        else:
                            return (false, Ast::Expr.Invalid) if not proof_match_closed_pattern(arm.pattern)
                            condition_bound: usize = pattern_cost * (scrutinee_cost + 3)
                            return (false, Ast::Expr.Invalid) if condition_bound > PROOF_PATTERN_WALK_WORK_LIMIT - guard_work
                            guard_work <- guard_work + condition_bound
                            condition: Ast::Expr? = proof_match_pattern_condition(arm.pattern, scrutinee, position)
                            resolved_condition: mutable Ast::Expr = Ast::Expr.Invalid
                            if condition is match_condition:
                                resolved_condition <- match_condition
                            else:
                                return (false, Ast::Expr.Invalid)
                            match arm.guard:
                                Ast::Expr.Absent:
                                    pass
                                _:
                                    return (false, Ast::Expr.Invalid) if not proof_match_guard_shape_supported(arm.guard, &guard_work)
                                    # Bound projection substitution growth, then reserve the
                                    # substitution and admission walks before doing them.
                                    guard_cost: usize = 0
                                    return (false, Ast::Expr.Invalid) if not proof_replay_summary_expr_cost_with_limit(arm.guard, &guard_cost, guard_work, PROOF_PATTERN_WALK_WORK_LIMIT)
                                    return (false, Ast::Expr.Invalid) if guard_cost == 0
                                    return (false, Ast::Expr.Invalid) if guard_cost > PROOF_PATTERN_WALK_WORK_LIMIT - guard_work
                                    guard_work <- guard_work + guard_cost
                                    guard_replacement_cost: mutable usize = 1
                                    for replacement in arm_values |replacement, guard_work, guard_replacement_cost|:
                                        replacement_size: mutable usize = 0
                                        return (false, Ast::Expr.Invalid) if not proof_replay_summary_expr_cost_with_limit(replacement, &replacement_size, guard_work, PROOF_PATTERN_WALK_WORK_LIMIT)
                                        return (false, Ast::Expr.Invalid) if replacement_size > PROOF_PATTERN_WALK_WORK_LIMIT - guard_work
                                        guard_work <- guard_work + replacement_size
                                        guard_replacement_cost <- replacement_size if replacement_size > guard_replacement_cost
                                    binding_probe_cost: mutable usize = 0
                                    for binding_name in arm_names |binding_name, binding_probe_cost|:
                                        probe_size: usize = 1 + sview_len(binding_name)
                                        return (false, Ast::Expr.Invalid) if probe_size > PROOF_PATTERN_WALK_WORK_LIMIT - binding_probe_cost
                                        binding_probe_cost <- binding_probe_cost + probe_size
                                    return (false, Ast::Expr.Invalid) if binding_probe_cost > (PROOF_PATTERN_WALK_WORK_LIMIT - guard_work) / guard_cost
                                    binding_probe_work: usize = guard_cost * binding_probe_cost
                                    guard_work <- guard_work + binding_probe_work
                                    return (false, Ast::Expr.Invalid) if guard_cost > (PROOF_PATTERN_WALK_WORK_LIMIT - guard_work) / guard_cost
                                    guard_work <- guard_work + guard_cost * guard_cost
                                    guard_scope_slots: usize = arm_names.count + guard_cost
                                    return (false, Ast::Expr.Invalid) if guard_scope_slots > (PROOF_PATTERN_WALK_WORK_LIMIT - guard_work) / guard_cost
                                    guard_scope_capture_base: usize = guard_cost * guard_scope_slots
                                    return (false, Ast::Expr.Invalid) if guard_scope_capture_base > 0 and guard_replacement_cost > (PROOF_PATTERN_WALK_WORK_LIMIT - guard_work) / guard_scope_capture_base
                                    guard_work <- guard_work + guard_scope_capture_base * guard_replacement_cost
                                    return (false, Ast::Expr.Invalid) if guard_replacement_cost > (PROOF_PATTERN_WALK_WORK_LIMIT - guard_work) / guard_cost
                                    substituted_guard_bound: usize = guard_cost * guard_replacement_cost
                                    return (false, Ast::Expr.Invalid) if substituted_guard_bound > (PROOF_PATTERN_WALK_WORK_LIMIT - guard_work) / 4
                                    guard_work <- guard_work + substituted_guard_bound * 4
                                    substituted_guard: Ast::Expr = proof_substitute(arm.guard, arm_names, arm_values)
                                    return (false, Ast::Expr.Invalid) if:
                                        proof_expr_has_call(substituted_guard) or proof_expr_has_move(substituted_guard)
                                        not proof_expr_supported(substituted_guard)
                                    resolved_condition <- Ast::Expr.Binary(resolved_condition, TokenKind.And, substituted_guard, position)
                            fallback <- Ast::Expr.If(resolved_condition, arm_value, fallback, position)
                    return (true, fallback)
                _:
                    return (false, Ast::Expr.Invalid)

        # Runtime expressions outside this modeled fragment are rejected at the statement
        # boundary. Treating them merely as opaque state havoc is not enough: a future expression
        # form may contain a hidden call, branch, or assignment that the proof kernel's evaluator
        # and call graph do not visit.
        def proof_expr_supported(expression: Ast::Expr) -> bool:
            return proof_expr_supported_depth(expression, 0)

    private:
        def proof_expr_supported_depth(expression: Ast::Expr, depth: usize) -> bool:
            return false if depth >= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT
            match expression:
                Ast::Expr.Invalid:
                    return false
                Ast::Expr.Absent:
                    return true
                Ast::Expr.IntLit(_, _):
                    return true
                Ast::Expr.FloatLit(_, _):
                    return true
                Ast::Expr.StringLit(_, _):
                    return true
                Ast::Expr.CharLit(_, _):
                    return true
                Ast::Expr.BoolLit(_, _):
                    return true
                Ast::Expr.Ident(_, _):
                    return true
                Ast::Expr.Call(callee, arguments, _, _):
                    return false if not proof_expr_supported_depth(callee, depth + 1)
                    for argument in arguments:
                        return false if not proof_expr_supported_depth(argument, depth + 1)
                    return true
                Ast::Expr.Paren(inner, _):
                    return proof_expr_supported_depth(inner, depth + 1)
                Ast::Expr.Unary(_, operand, _):
                    return proof_expr_supported_depth(operand, depth + 1)
                Ast::Expr.Binary(left, operator, right, _):
                    # Calls are admitted here as syntax only. Every proof-state/runtime caller
                    # applies its stronger effect and purity gate separately; rejecting a call
                    # merely because it appears under `and`/`or` would also reject short-circuit
                    # guards in otherwise total pure helper functions.
                    return proof_expr_supported_depth(left, depth + 1) and proof_expr_supported_depth(right, depth + 1)
                Ast::Expr.Field(object, _, _):
                    return proof_expr_supported_depth(object, depth + 1)
                Ast::Expr.Scope(base, _, _):
                    return proof_expr_supported_depth(base, depth + 1)
                Ast::Expr.Index(object, index, _):
                    return proof_expr_supported_depth(object, depth + 1) and proof_expr_supported_depth(index, depth + 1)
                Ast::Expr.Slice(object, low, high, _):
                    return proof_expr_supported_depth(object, depth + 1) and proof_expr_supported_depth(low, depth + 1) and proof_expr_supported_depth(high, depth + 1)
                Ast::Expr.IndexN(object, arguments, _):
                    return false if not proof_expr_supported_depth(object, depth + 1)
                    for argument in arguments:
                        return false if not proof_expr_supported_depth(argument, depth + 1)
                    return true
                Ast::Expr.Move(operand, _):
                    # Runtime ownership transfer is modeled at the statement boundary. The
                    # checker invalidates the moved root and all facts after the expression has
                    # evaluated; it is never transparent in a logical contract or pure summary.
                    return proof_expr_supported_depth(operand, depth + 1)
                Ast::Expr.RegionNew(operand, _, _):
                    # Region allocation has lifetime and allocation effects not represented in
                    # the symbolic state, so it must not enter a verified proof transition.
                    return false
                Ast::Expr.Array(elements, _):
                    for element in elements:
                        return false if not proof_expr_supported_depth(element, depth + 1)
                    return true
                Ast::Expr.Tuple(elements, _):
                    for element in elements:
                        return false if not proof_expr_supported_depth(element, depth + 1)
                    return true
                Ast::Expr.SetLit(elements, _):
                    for element in elements:
                        return false if not proof_expr_supported_depth(element, depth + 1)
                    return true
                Ast::Expr.DictLit(entries, _):
                    for entry in entries:
                        return false if not proof_expr_supported_depth(entry.key, depth + 1) or not proof_expr_supported_depth(entry.value, depth + 1)
                    return true
                Ast::Expr.Construct(type_expression, fields, _):
                    return false if not proof_expr_supported_depth(type_expression, depth + 1)
                    for field in fields:
                        return false if not proof_expr_supported_depth(field.value, depth + 1)
                    return true
                Ast::Expr.RecordUpdate(base, fields, _):
                    return false if not proof_expr_supported_depth(base, depth + 1)
                    for field in fields:
                        return false if not proof_expr_supported_depth(field.value, depth + 1)
                    return true
                Ast::Expr.If(condition, then_expr, else_expr, _):
                    # A conditional call may not run. Only integer conversions, which read their
                    # receiver and nothing else, may sit here; the runtime purity gate then
                    # refuses one that a source function shadows.
                    return false if not proof_expr_calls_are_conversion_shapes(condition, depth + 1) or not proof_expr_calls_are_conversion_shapes(then_expr, depth + 1) or not proof_expr_calls_are_conversion_shapes(else_expr, depth + 1)
                    return proof_expr_supported_depth(condition, depth + 1) and proof_expr_supported_depth(then_expr, depth + 1) and proof_expr_supported_depth(else_expr, depth + 1)
                Ast::Expr.Comprehension(_, iterable, condition, body, _):
                    return false if proof_expr_has_call(iterable) or proof_expr_has_call(condition) or proof_expr_has_call(body)
                    return proof_expr_supported_depth(iterable, depth + 1) and proof_expr_supported_depth(condition, depth + 1) and proof_expr_supported_depth(body, depth + 1)
                Ast::Expr.Refinement(base, predicate, _):
                    return false if proof_expr_has_call(base) or proof_expr_has_call(predicate)
                    return proof_expr_supported_depth(base, depth + 1) and proof_expr_supported_depth(predicate, depth + 1)
                Ast::Expr.Block(statements, value, captures, _):
                    # Captured value blocks synthesize writes back into their outer bindings.
                    # The proof state does not model that write-back, so accepting the block as
                    # a pure expression would let an outer fact survive a hidden mutation.
                    return false if:
                        captures.count > 0
                        proof_expr_has_call(value)
                    for statement in statements:
                        match statement:
                            Ast::Stmt.VarDecl(_, _, initializer, _):
                                return false if:
                                    proof_expr_has_call(initializer)
                                    not proof_expr_supported_depth(initializer, depth + 1)
                            _:
                                return false
                    return proof_expr_supported_depth(value, depth + 1)
                Ast::Expr.Match(_, _, _):
                    lowered: (known: bool, value: Ast::Expr) = proof_lower_value_match(expression)
                    return lowered.known
                Ast::Expr.Catch(_, _, _):
                    return false
                Ast::Expr.GetElse(_, _, _):
                    return false
                Ast::Expr.Lambda(_, _, _):
                    return false
                Ast::Expr.ShorthandMember(parts, _):
                    # A single leading-dot enum member is a closed, pure value atom. Keep
                    # qualified shorthand paths out until the source type/module identity is
                    # represented in the certificate term.
                    return parts.count == 1 and parts[0] != ""
                _:
                    return false

    public:
        # Every call in the term is a zero-argument integer conversion. Shapes not walked here
        # count only when they hold no call at all.
        def proof_expr_calls_are_conversion_shapes(expression: Ast::Expr, depth: usize) -> bool:
            return false if depth >= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT
            match expression:
                Ast::Expr.Call(callee, arguments, _, _):
                    return false if arguments.count != 0
                    match callee:
                        Ast::Expr.Field(receiver, target, _):
                            integer: bool = target in {"i8", "i16", "i32", "i64", "isize", "u8", "u16", "u32", "u64", "usize"}
                            return integer and proof_expr_calls_are_conversion_shapes(receiver, depth + 1)
                        _:
                            return false
                Ast::Expr.Paren(inner, _):
                    return proof_expr_calls_are_conversion_shapes(inner, depth + 1)
                Ast::Expr.Unary(_, operand, _):
                    return proof_expr_calls_are_conversion_shapes(operand, depth + 1)
                Ast::Expr.Binary(left, _, right, _):
                    return proof_expr_calls_are_conversion_shapes(left, depth + 1) and proof_expr_calls_are_conversion_shapes(right, depth + 1)
                Ast::Expr.Index(object, index, _):
                    return proof_expr_calls_are_conversion_shapes(object, depth + 1) and proof_expr_calls_are_conversion_shapes(index, depth + 1)
                Ast::Expr.Field(object, _, _):
                    return proof_expr_calls_are_conversion_shapes(object, depth + 1)
                _:
                    return not proof_expr_has_call(expression)

    private:
        # A pattern whose logical condition decides it exactly, so its negation holds on later
        # arms. Literal token kind is erased by this parser AST, so only the typed string path
        # can justify literal equality; the untyped exactness query always fails closed.
        def proof_pattern_condition_exact(pattern: Ast::Pattern) -> bool:
            work: mutable usize = 0
            return proof_pattern_condition_exact_depth(pattern, 0, &work)

        def proof_pattern_condition_exact_depth(pattern: Ast::Pattern, depth: usize, work: mutable usize&) -> bool:
            return false if depth >= PROOF_PATTERN_WALK_DEPTH_LIMIT or work >= PROOF_PATTERN_WALK_WORK_LIMIT
            work <- work + 1
            match pattern:
                Ast::Pattern.As(_, inner):
                    return inner.count == 1 and proof_pattern_condition_exact_depth(inner[0], depth + 1, work)
                Ast::Pattern.Variant(_, fields):
                    for field in fields |fields, depth, work|:
                        return false if work >= PROOF_PATTERN_WALK_WORK_LIMIT
                        work <- work + 1
                        return false if not proof_pattern_irrefutable_depth(field, depth + 1, work)
                    return true
                Ast::Pattern.Literal(_):
                    return false
                Ast::Pattern.Range(_, _, _):
                    return false
                Ast::Pattern.Or(options):
                    return false if options.count == 0
                    for option in options |options, depth, work|:
                        return false if not proof_pattern_condition_exact_depth(option, depth + 1, work)
                    return true
                _:
                    return false

        def proof_pattern_irrefutable(pattern: Ast::Pattern) -> bool:
            work: mutable usize = 0
            return proof_pattern_irrefutable_depth(pattern, 0, &work)

        def proof_pattern_irrefutable_depth(pattern: Ast::Pattern, depth: usize, work: mutable usize&) -> bool:
            return false if depth >= PROOF_PATTERN_WALK_DEPTH_LIMIT or work >= PROOF_PATTERN_WALK_WORK_LIMIT
            work <- work + 1
            match pattern:
                Ast::Pattern.Wildcard:
                    return true
                Ast::Pattern.Binding(_):
                    return true
                Ast::Pattern.As(_, inner):
                    return inner.count == 1 and proof_pattern_irrefutable_depth(inner[0], depth + 1, work)
                Ast::Pattern.Field(_, inner):
                    return inner.count == 1 and proof_pattern_irrefutable_depth(inner[0], depth + 1, work)
                _:
                    return false
