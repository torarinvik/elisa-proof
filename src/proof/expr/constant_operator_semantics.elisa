extend ElisaProof:
    private:
        # Keep source-side constant folding aligned with kernel replay. Rejected operations and
        # unsupported operators use the same unknown/zero representation on both paths.
        def proof_constant_unary(operator: TokenKind, known: bool, value: i64) -> (known: bool, value: i64):
            ensure not result.known implies result.value == 0
            ensure result.known == (known and (operator == TokenKind.Plus or (operator == TokenKind.Minus and value != proof_i64_min())))
            ensure result.known and operator == TokenKind.Plus implies result.value == value
            ensure result.known and operator == TokenKind.Minus implies result.value == 0 - value
            return (false, 0) if not known
            return (true, value) if operator == TokenKind.Plus
            if operator == TokenKind.Minus:
                return (false, 0) if value == proof_i64_min()
                return (true, 0 - value)
            return (false, 0)

        def proof_constant_binary(operator: TokenKind, left_known: bool, left_value: i64, right_known: bool, right_value: i64) -> (known: bool, value: i64):
            ensure not result.known implies result.value == 0
            ensure result.known == (
                left_known and right_known and (
                    (operator == TokenKind.Plus and proof_add_safe(left_value, right_value).known)
                    or (operator == TokenKind.Minus and proof_sub_safe(left_value, right_value).known)
                    or (operator == TokenKind.Star and proof_mul_safe(left_value, right_value).known)
                    or (operator == TokenKind.Slash and proof_div_safe(left_value, right_value).known)
                    or (operator == TokenKind.Percent and proof_mod_safe(left_value, right_value).known)
                    or operator == TokenKind.Ampersand or operator == TokenKind.Pipe or operator == TokenKind.Caret
                    or (operator == TokenKind.LShift and proof_shift_safe(left_value, right_value, true).known)
                    or (operator == TokenKind.RShift and proof_shift_safe(left_value, right_value, false).known)
                )
            )
            ensure result.known implies left_known and right_known
            ensure result.known implies (operator == TokenKind.Plus or operator == TokenKind.Minus or operator == TokenKind.Star or operator == TokenKind.Slash or operator == TokenKind.Percent or operator == TokenKind.Ampersand or operator == TokenKind.Pipe or operator == TokenKind.Caret or operator == TokenKind.LShift or operator == TokenKind.RShift)
            ensure left_known and right_known and operator == TokenKind.Plus implies result.known == proof_add_safe(left_value, right_value).known
            ensure left_known and right_known and operator == TokenKind.Plus implies result.value == proof_add_safe(left_value, right_value).value
            ensure left_known and right_known and operator == TokenKind.Minus implies result.known == proof_sub_safe(left_value, right_value).known
            ensure left_known and right_known and operator == TokenKind.Minus implies result.value == proof_sub_safe(left_value, right_value).value
            ensure left_known and right_known and operator == TokenKind.Star implies result.known == proof_mul_safe(left_value, right_value).known
            ensure left_known and right_known and operator == TokenKind.Star implies result.value == proof_mul_safe(left_value, right_value).value
            ensure left_known and right_known and operator == TokenKind.Slash implies result.known == proof_div_safe(left_value, right_value).known
            ensure left_known and right_known and operator == TokenKind.Slash implies result.value == proof_div_safe(left_value, right_value).value
            ensure left_known and right_known and operator == TokenKind.Percent implies result.known == proof_mod_safe(left_value, right_value).known
            ensure left_known and right_known and operator == TokenKind.Percent implies result.value == proof_mod_safe(left_value, right_value).value
            ensure left_known and right_known and operator == TokenKind.Ampersand implies result.known and result.value == (left_value & right_value)
            ensure left_known and right_known and operator == TokenKind.Pipe implies result.known and result.value == (left_value | right_value)
            ensure left_known and right_known and operator == TokenKind.Caret implies result.known and result.value == (left_value ^ right_value)
            ensure left_known and right_known and operator == TokenKind.LShift implies result.known == proof_shift_safe(left_value, right_value, true).known
            ensure left_known and right_known and operator == TokenKind.LShift implies result.value == proof_shift_safe(left_value, right_value, true).value
            ensure left_known and right_known and operator == TokenKind.RShift implies result.known == proof_shift_safe(left_value, right_value, false).known
            ensure left_known and right_known and operator == TokenKind.RShift implies result.value == proof_shift_safe(left_value, right_value, false).value
            return (false, 0) if not left_known or not right_known
            return proof_add_safe(left_value, right_value) if operator == TokenKind.Plus
            return proof_sub_safe(left_value, right_value) if operator == TokenKind.Minus
            return proof_mul_safe(left_value, right_value) if operator == TokenKind.Star
            return proof_div_safe(left_value, right_value) if operator == TokenKind.Slash
            return proof_mod_safe(left_value, right_value) if operator == TokenKind.Percent
            return (true, left_value & right_value) if operator == TokenKind.Ampersand
            return (true, left_value | right_value) if operator == TokenKind.Pipe
            return (true, left_value ^ right_value) if operator == TokenKind.Caret
            return proof_shift_safe(left_value, right_value, true) if operator == TokenKind.LShift
            return proof_shift_safe(left_value, right_value, false) if operator == TokenKind.RShift
            return (false, 0)
