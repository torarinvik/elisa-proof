extend ElisaProof:
    public:
        const PROOF_EXPR_I64_MAX: i64 = 9223372036854775807
        const PROOF_EXPR_I64_MIN: i64 = 0 - 9223372036854775807 - 1

        def proof_is_comparison(operator: TokenKind) -> bool:
            ensure result == (operator == TokenKind.EqEq or operator == TokenKind.BangEq or operator == TokenKind.Lt or operator == TokenKind.Gt or operator == TokenKind.LtEq or operator == TokenKind.GtEq)
            return operator == TokenKind.EqEq or operator == TokenKind.BangEq or operator == TokenKind.Lt or operator == TokenKind.Gt or operator == TokenKind.LtEq or operator == TokenKind.GtEq

        def proof_is_true_comparison(operator: TokenKind) -> bool:
            ensure result == (operator == TokenKind.EqEq or operator == TokenKind.LtEq or operator == TokenKind.GtEq)
            return operator == TokenKind.EqEq or operator == TokenKind.LtEq or operator == TokenKind.GtEq

        def proof_i64_max() -> i64:
            ensure result == PROOF_EXPR_I64_MAX
            return PROOF_EXPR_I64_MAX

        def proof_i64_min() -> i64:
            ensure result == PROOF_EXPR_I64_MIN
            return PROOF_EXPR_I64_MIN

        def proof_add_safe(left: i64, right: i64) -> (known: bool, value: i64):
            ensure not result.known implies result.value == 0
            ensure result.known == ((right <= 0 or left <= proof_i64_max() - right) and (right >= 0 or left >= proof_i64_min() - right))
            ensure result.known implies result.value == left + right
            return (false, 0) if:
                right > 0 and left > proof_i64_max() - right
                right < 0 and left < proof_i64_min() - right
            return (true, left + right)

        def proof_sub_safe(left: i64, right: i64) -> (known: bool, value: i64):
            ensure not result.known implies result.value == 0
            ensure result.known == ((right <= 0 or left >= proof_i64_min() + right) and (right >= 0 or left <= proof_i64_max() + right))
            ensure result.known implies result.value == left - right
            return (false, 0) if:
                right > 0 and left < proof_i64_min() + right
                right < 0 and left > proof_i64_max() + right
            return (true, left - right)

        def proof_mul_safe(left: i64, right: i64) -> (known: bool, value: i64):
            ensure not result.known implies result.value == 0
            ensure result.known == (
                left == 0 or right == 0 or left == 1 or right == 1
                or (left == -1 and right != proof_i64_min())
                or (right == -1 and left != proof_i64_min())
                or (left > 0 and ((right > 0 and left <= proof_i64_max() / right) or (right < 0 and right >= proof_i64_min() / left)))
                or (left < 0 and ((right > 0 and left >= proof_i64_min() / right) or (right < 0 and right >= proof_i64_max() / left)))
            )
            ensure result.known implies result.value == left * right
            return (true, 0) if left == 0 or right == 0
            return (true, right) if left == 1
            return (true, left) if right == 1
            if left == -1:
                return (false, 0) if right == proof_i64_min()
                return (true, 0 - right)
            if right == -1:
                return (false, 0) if left == proof_i64_min()
                return (true, 0 - left)
            if left > 0:
                return (false, 0) if:
                    right > 0 and left > proof_i64_max() / right
                    right < 0 and right < proof_i64_min() / left
            else:
                return (false, 0) if:
                    right > 0 and left < proof_i64_min() / right
                    right < 0 and right < proof_i64_max() / left
            return (true, left * right)

        def proof_div_safe(left: i64, right: i64) -> (known: bool, value: i64):
            ensure not result.known implies result.value == 0
            ensure result.known == (right != 0 and not (left == proof_i64_min() and right == -1))
            ensure result.known implies result.value == left / right
            return (false, 0) if right == 0 or (left == proof_i64_min() and right == -1)
            return (true, left / right)

        def proof_mod_safe(left: i64, right: i64) -> (known: bool, value: i64):
            ensure not result.known implies result.value == 0
            ensure result.known == (right != 0 and not (left == proof_i64_min() and right == -1))
            ensure result.known implies result.value == left % right
            return (false, 0) if right == 0 or (left == proof_i64_min() and right == -1)
            return (true, left % right)

        # Elisa's integer bitwise operators use the target's fixed-width representation. The
        # shift count is still checked by the compiler's semantic pass; keep the same 0..max
        # boundary here so constant folding never relies on a host-language shift convention.
        def proof_shift_safe(value: i64, amount: i64, left: bool) -> (known: bool, value: i64):
            ensure not result.known implies result.value == 0
            ensure result.known == (amount >= 0 and amount <= ElisaProofKernelCore::PROOF_KERNEL_MAX_SHIFT_AMOUNT)
            ensure result.known and left implies result.value == value << amount
            ensure result.known and not left implies result.value == value >> amount
            return (false, 0) if amount < 0 or amount > ElisaProofKernelCore::PROOF_KERNEL_MAX_SHIFT_AMOUNT
            return (true, value << amount) if left
            return (true, value >> amount)

        # The length of a collection literal of at most eight elements, found by comparison so no
        # `usize` to `i64` conversion is needed. Kernel mirror: `proof_kernel_replay_small_count`.
        def proof_small_literal_count(count: usize) -> (known: bool, value: i64):
            ensure result.known == (count <= 8)
            ensure result.known implies (
                (count == 0 and result.value == 0)
                or (count == 1 and result.value == 1)
                or (count == 2 and result.value == 2)
                or (count == 3 and result.value == 3)
                or (count == 4 and result.value == 4)
                or (count == 5 and result.value == 5)
                or (count == 6 and result.value == 6)
                or (count == 7 and result.value == 7)
                or (count == 8 and result.value == 8)
            )
            ensure not result.known implies result.value == 0
            return (true, 0) if count == 0
            return (true, 1) if count == 1
            return (true, 2) if count == 2
            return (true, 3) if count == 3
            return (true, 4) if count == 4
            return (true, 5) if count == 5
            return (true, 6) if count == 6
            return (true, 7) if count == 7
            return (true, 8) if count == 8
            return (false, 0)

        def proof_constant_int(expression: Ast::Expr) -> (known: bool, value: i64):
            return proof_constant_int_depth(expression, 0)

        def proof_constant_int_depth(expression: Ast::Expr, depth: usize) -> (known: bool, value: i64):
            # Constant folding is an admission path for arithmetic facts. An imported term that
            # exceeds the shared AST depth must become unknown, never recurse until the host
            # stack fails.
            return (false, 0) if depth >= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT
            match expression:
                Ast::Expr.IntLit(value, _):
                    return (true, value)
                Ast::Expr.Paren(inner, _):
                    return proof_constant_int_depth(inner, depth + 1)
                Ast::Expr.Field(object, field_name, _):
                    # The element count of a literal collection is written in the literal. This is
                    # not a claim about any storage: the term *is* the value, so nothing can alias
                    # it, mutate it, or make the count something else. A binding initialized to
                    # `[]` reaches a goal as `[].count` after substitution, which is how a length
                    # invariant is established at loop entry.
                    return (false, 0) if field_name != "count"
                    # A `usize` to `i64` conversion is outside the expression fragment this checker
                    # verifies (one here once cost 16 functions and 65 proofs), so a short literal's
                    # length is read by comparison against a small table instead.
                    match object:
                        Ast::Expr.Array(elements, _):
                            return proof_small_literal_count(elements.count)
                        _:
                            return (false, 0)
                Ast::Expr.Unary(operator, operand, _):
                    found: (known: bool, value: i64) = proof_constant_int_depth(operand, depth + 1)
                    return proof_constant_unary(operator, found.known, found.value)
                Ast::Expr.Binary(left, operator, right, _):
                    a: (known: bool, value: i64) = proof_constant_int_depth(left, depth + 1)
                    b: (known: bool, value: i64) = proof_constant_int_depth(right, depth + 1)
                    return proof_constant_binary(operator, a.known, a.value, b.known, b.value)
                _:
                    return (false, 0)

        def proof_normalized_equal(left: Ast::Expr, right: Ast::Expr) -> bool:
            return proof_expr_equal(left, right)

        # Return true when an expression contains a named value. Unsupported expression
        # forms are treated as containing the name: a lemma with an opaque postcondition
        # must not be applied to a caller unless a later kernel tier understands that form.
        def proof_expr_mentions_name(expression: Ast::Expr, target: sview) -> bool:
            return proof_expr_mentions_name_depth(expression, target, 0)

        def proof_expr_mentions_name_depth(expression: Ast::Expr, target: sview, depth: usize) -> bool:
            # At the limit, conservatively report a mention. This predicate is used to reject
            # unsafe substitutions and dependency claims, so false negatives are unsound while
            # a deep-term rejection is safe.
            return true if depth >= PROOF_REPLAY_AST_DEPTH_LIMIT
            match expression:
                Ast::Expr.IntLit(_, _):
                    return false
                Ast::Expr.BoolLit(_, _):
                    return false
                Ast::Expr.FloatLit(_, _):
                    return false
                Ast::Expr.StringLit(_, _):
                    return false
                Ast::Expr.CharLit(_, _):
                    return false
                Ast::Expr.Ident(name, _):
                    return name == target
                Ast::Expr.Paren(inner, _):
                    return proof_expr_mentions_name_depth(inner, target, depth + 1)
                Ast::Expr.Unary(_, operand, _):
                    return proof_expr_mentions_name_depth(operand, target, depth + 1)
                Ast::Expr.Binary(left, _, right, _):
                    return proof_expr_mentions_name_depth(left, target, depth + 1) or proof_expr_mentions_name_depth(right, target, depth + 1)
                Ast::Expr.Call(callee, arguments, _, _):
                    return true if proof_expr_mentions_name_depth(callee, target, depth + 1)
                    for argument in arguments:
                        return true if proof_expr_mentions_name_depth(argument, target, depth + 1)
                    return false
                Ast::Expr.Field(object, _, _):
                    return proof_expr_mentions_name_depth(object, target, depth + 1)
                Ast::Expr.Scope(base, scoped_name, _):
                    # The scope leaf is a binding too. Ignoring it would let a qualified
                    # mutable global (for example `Config.counter`) evade dependency scans and
                    # would make unresolved-formal checks unsound across qualified names.
                    return true if scoped_name == target
                    return proof_expr_mentions_name_depth(base, target, depth + 1)
                Ast::Expr.Index(object, index, _):
                    return proof_expr_mentions_name_depth(object, target, depth + 1) or proof_expr_mentions_name_depth(index, target, depth + 1)
                Ast::Expr.Slice(object, low, high, _):
                    return proof_expr_mentions_name_depth(object, target, depth + 1) or proof_expr_mentions_name_depth(low, target, depth + 1) or proof_expr_mentions_name_depth(high, target, depth + 1)
                Ast::Expr.IndexN(object, arguments, _):
                    return true if proof_expr_mentions_name_depth(object, target, depth + 1)
                    for argument in arguments:
                        return true if proof_expr_mentions_name_depth(argument, target, depth + 1)
                    return false
                Ast::Expr.Move(operand, _):
                    return proof_expr_mentions_name_depth(operand, target, depth + 1)
                Ast::Expr.RegionNew(operand, _, _):
                    return proof_expr_mentions_name_depth(operand, target, depth + 1)
                Ast::Expr.Array(elements, _):
                    for element in elements:
                        return true if proof_expr_mentions_name_depth(element, target, depth + 1)
                    return false
                Ast::Expr.Tuple(elements, _):
                    for element in elements:
                        return true if proof_expr_mentions_name_depth(element, target, depth + 1)
                    return false
                Ast::Expr.SetLit(elements, _):
                    for element in elements:
                        return true if proof_expr_mentions_name_depth(element, target, depth + 1)
                    return false
                Ast::Expr.DictLit(entries, _):
                    for entry in entries:
                        return true if proof_expr_mentions_name_depth(entry.key, target, depth + 1) or proof_expr_mentions_name_depth(entry.value, target, depth + 1)
                    return false
                Ast::Expr.Construct(type_expression, fields, _):
                    return true if proof_expr_mentions_name_depth(type_expression, target, depth + 1)
                    for field in fields:
                        return true if proof_expr_mentions_name_depth(field.value, target, depth + 1)
                    return false
                Ast::Expr.RecordUpdate(base, fields, _):
                    return true if proof_expr_mentions_name_depth(base, target, depth + 1)
                    for field in fields:
                        return true if proof_expr_mentions_name_depth(field.value, target, depth + 1)
                    return false
                Ast::Expr.If(condition, then_expr, else_expr, _):
                    return proof_expr_mentions_name_depth(condition, target, depth + 1) or proof_expr_mentions_name_depth(then_expr, target, depth + 1) or proof_expr_mentions_name_depth(else_expr, target, depth + 1)
                Ast::Expr.Match(scrutinee, arms, _):
                    return true if proof_expr_mentions_name_depth(scrutinee, target, depth + 1)
                    for arm in arms:
                        return true if:
                            proof_expr_mentions_name_depth(arm.guard, target, depth + 1)
                            arm.body.count != 1
                        match arm.body[0]:
                            Ast::Stmt.Expr(value, _):
                                return true if proof_expr_mentions_name_depth(value, target, depth + 1)
                            _:
                                return true
                    return false
                Ast::Expr.Comprehension(variable, iterable, condition, body, _):
                    return true if proof_expr_mentions_name_depth(iterable, target, depth + 1)
                    return false if variable == target
                    return proof_expr_mentions_name_depth(condition, target, depth + 1) or proof_expr_mentions_name_depth(body, target, depth + 1)
                Ast::Expr.Refinement(base, predicate, _):
                    return proof_expr_mentions_name_depth(base, target, depth + 1) or proof_expr_mentions_name_depth(predicate, target, depth + 1)
                Ast::Expr.Block(statements, value, _, _):
                    body_mentions: mutable bool = true
                    for statement in statements |body_mentions|:
                        match statement:
                            Ast::Stmt.VarDecl(local_name, _, initializer, _):
                                return true if proof_expr_mentions_name_depth(initializer, target, depth + 1)
                                body_mentions <- false if local_name == target
                            _:
                                return true
                    return body_mentions and proof_expr_mentions_name_depth(value, target, depth + 1)
                _:
                    return true

        # Calls inside an initializer or expression may mutate aliases outside the symbolic
        # state. Unknown AST forms count as effectful until a kernel tier models them.
        def proof_expr_has_call(expression: Ast::Expr) -> bool:
            work: mutable usize = 0
            return proof_expr_has_call_with_work(expression, &work, PROOF_EXPR_HAS_CALL_WORK_LIMIT)

        # Shared callers can reuse one counter across several expression scans. An exhausted
        # walk is effectful, so a wide AST cannot hide a call by exhausting the scanner.
        def proof_expr_has_call_with_work(expression: Ast::Expr, work: mutable usize&, limit: usize) -> bool:
            return true if limit > PROOF_EXPR_HAS_CALL_WORK_MAX or work > limit
            proof_expr_has_call_depth_with_work(expression, 0, work, limit)

    private:
        const PROOF_EXPR_HAS_CALL_WORK_LIMIT: usize = 16384
        const PROOF_EXPR_HAS_CALL_WORK_MAX: usize = 1048576

        def proof_expr_has_call_charge_with_work(work: mutable usize&, limit: usize, amount: usize) -> bool:
            return false if work > limit
            if amount > limit - work:
                # Keep exhaustion distinguishable from a traversal that completed at the
                # exact limit. Shared callers use `work > limit` to report the budget failure.
                work <- limit + 1
                return false
            work <- work + amount
            true

        def proof_expr_has_call_depth_with_work(expression: Ast::Expr, depth: usize, work: mutable usize&, limit: usize) -> bool:
            return true if not proof_expr_has_call_charge_with_work(work, limit, 1)
            # A deep term is opaque to this effect scan. Treat it as effectful so no hidden call
            # can cross a boundary merely because the scan stopped before reaching it.
            return true if depth >= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT
            match expression:
                Ast::Expr.Invalid:
                    return false
                Ast::Expr.Absent:
                    return false
                Ast::Expr.IntLit(_, _):
                    return false
                Ast::Expr.BoolLit(_, _):
                    return false
                Ast::Expr.FloatLit(_, _):
                    return false
                Ast::Expr.StringLit(_, _):
                    return false
                Ast::Expr.CharLit(_, _):
                    return false
                Ast::Expr.Ident(_, _):
                    return false
                Ast::Expr.ShorthandMember(_, _):
                    return false
                Ast::Expr.Call(_, _, _, _):
                    # This syntax-only effect scan has no imported declaration table, so it
                    # cannot prove method-shaped numeric calls are builtin casts. Keep calls
                    # opaque here; source-aware conversion checks use the function table.
                    return true
                Ast::Expr.StaticEffectCall(_, _, _, _, _, _):
                    return true
                Ast::Expr.Paren(inner, _):
                    return proof_expr_has_call_depth_with_work(inner, depth + 1, work, limit)
                Ast::Expr.Unary(_, operand, _):
                    return proof_expr_has_call_depth_with_work(operand, depth + 1, work, limit)
                Ast::Expr.Binary(left, _, right, _):
                    return proof_expr_has_call_depth_with_work(left, depth + 1, work, limit) or proof_expr_has_call_depth_with_work(right, depth + 1, work, limit)
                Ast::Expr.Field(object, _, _):
                    return proof_expr_has_call_depth_with_work(object, depth + 1, work, limit)
                Ast::Expr.Scope(base, _, _):
                    return proof_expr_has_call_depth_with_work(base, depth + 1, work, limit)
                Ast::Expr.Index(object, index, _):
                    return proof_expr_has_call_depth_with_work(object, depth + 1, work, limit) or proof_expr_has_call_depth_with_work(index, depth + 1, work, limit)
                Ast::Expr.Slice(object, low, high, _):
                    return proof_expr_has_call_depth_with_work(object, depth + 1, work, limit) or proof_expr_has_call_depth_with_work(low, depth + 1, work, limit) or proof_expr_has_call_depth_with_work(high, depth + 1, work, limit)
                Ast::Expr.IndexN(object, arguments, _):
                    return true if proof_expr_has_call_depth_with_work(object, depth + 1, work, limit)
                    for argument in arguments:
                        return true if not proof_expr_has_call_charge_with_work(work, limit, 1)
                        return true if proof_expr_has_call_depth_with_work(argument, depth + 1, work, limit)
                    return false
                Ast::Expr.Move(operand, _):
                    return proof_expr_has_call_depth_with_work(operand, depth + 1, work, limit)
                Ast::Expr.RegionNew(operand, _, _):
                    return proof_expr_has_call_depth_with_work(operand, depth + 1, work, limit)
                Ast::Expr.Array(elements, _):
                    for element in elements:
                        return true if not proof_expr_has_call_charge_with_work(work, limit, 1)
                        return true if proof_expr_has_call_depth_with_work(element, depth + 1, work, limit)
                    return false
                Ast::Expr.Tuple(elements, _):
                    for element in elements:
                        return true if not proof_expr_has_call_charge_with_work(work, limit, 1)
                        return true if proof_expr_has_call_depth_with_work(element, depth + 1, work, limit)
                    return false
                Ast::Expr.SetLit(elements, _):
                    for element in elements:
                        return true if not proof_expr_has_call_charge_with_work(work, limit, 1)
                        return true if proof_expr_has_call_depth_with_work(element, depth + 1, work, limit)
                    return false
                Ast::Expr.DictLit(entries, _):
                    for entry in entries:
                        return true if not proof_expr_has_call_charge_with_work(work, limit, 1)
                        return true if proof_expr_has_call_depth_with_work(entry.key, depth + 1, work, limit) or proof_expr_has_call_depth_with_work(entry.value, depth + 1, work, limit)
                    return false
                Ast::Expr.Construct(type_expression, fields, _):
                    return true if proof_expr_has_call_depth_with_work(type_expression, depth + 1, work, limit)
                    for field in fields:
                        return true if not proof_expr_has_call_charge_with_work(work, limit, 1)
                        return true if proof_expr_has_call_depth_with_work(field.value, depth + 1, work, limit)
                    return false
                Ast::Expr.RecordUpdate(base, fields, _):
                    return true if proof_expr_has_call_depth_with_work(base, depth + 1, work, limit)
                    for field in fields:
                        return true if not proof_expr_has_call_charge_with_work(work, limit, 1)
                        return true if proof_expr_has_call_depth_with_work(field.value, depth + 1, work, limit)
                    return false
                Ast::Expr.If(condition, then_expr, else_expr, _):
                    return proof_expr_has_call_depth_with_work(condition, depth + 1, work, limit) or proof_expr_has_call_depth_with_work(then_expr, depth + 1, work, limit) or proof_expr_has_call_depth_with_work(else_expr, depth + 1, work, limit)
                Ast::Expr.Match(scrutinee, arms, _):
                    return true if proof_expr_has_call_depth_with_work(scrutinee, depth + 1, work, limit)
                    for arm in arms:
                        return true if not proof_expr_has_call_charge_with_work(work, limit, 1)
                        return true if:
                            proof_expr_has_call_depth_with_work(arm.guard, depth + 1, work, limit)
                            arm.body.count != 1
                        match arm.body[0]:
                            Ast::Stmt.Expr(value, _):
                                return true if proof_expr_has_call_depth_with_work(value, depth + 1, work, limit)
                            _:
                                return true
                    return false
                Ast::Expr.Catch(guarded, arms, _):
                    return true if proof_expr_has_call_depth_with_work(guarded, depth + 1, work, limit)
                    for arm in arms:
                        return true if not proof_expr_has_call_charge_with_work(work, limit, 1)
                        return true if:
                            proof_expr_has_call_depth_with_work(arm.guard, depth + 1, work, limit)
                            arm.body.count != 1
                        match arm.body[0]:
                            Ast::Stmt.Expr(value, _):
                                return true if proof_expr_has_call_depth_with_work(value, depth + 1, work, limit)
                            _:
                                return true
                    return false
                Ast::Expr.Comprehension(_, iterable, condition, body, _):
                    return proof_expr_has_call_depth_with_work(iterable, depth + 1, work, limit) or proof_expr_has_call_depth_with_work(condition, depth + 1, work, limit) or proof_expr_has_call_depth_with_work(body, depth + 1, work, limit)
                Ast::Expr.Refinement(base, predicate, _):
                    return proof_expr_has_call_depth_with_work(base, depth + 1, work, limit) or proof_expr_has_call_depth_with_work(predicate, depth + 1, work, limit)
                Ast::Expr.Block(statements, value, _, _):
                    for statement in statements:
                        return true if not proof_expr_has_call_charge_with_work(work, limit, 1)
                        match statement:
                            Ast::Stmt.VarDecl(_, _, initializer, _):
                                return true if proof_expr_has_call_depth_with_work(initializer, depth + 1, work, limit)
                            _:
                                return true
                    return proof_expr_has_call_depth_with_work(value, depth + 1, work, limit)
                _:
                    return true
