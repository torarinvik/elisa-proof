extend ElisaProof:
    public:
        def proof_is_comparison(operator: TokenKind) -> bool:
            return operator == TokenKind.EqEq or operator == TokenKind.BangEq or operator == TokenKind.Lt or operator == TokenKind.Gt or operator == TokenKind.LtEq or operator == TokenKind.GtEq

        def proof_is_true_comparison(operator: TokenKind) -> bool:
            return operator == TokenKind.EqEq or operator == TokenKind.LtEq or operator == TokenKind.GtEq

        def proof_i64_max() -> i64:
            return 9223372036854775807

        def proof_i64_min() -> i64:
            return 0 - 9223372036854775807 - 1

        def proof_add_safe(left: i64, right: i64) -> (known: bool, value: i64):
            return (false, 0) if right > 0 and left > proof_i64_max() - right
            return (false, 0) if right < 0 and left < proof_i64_min() - right
            return (true, left + right)

        def proof_sub_safe(left: i64, right: i64) -> (known: bool, value: i64):
            return (false, 0) if right > 0 and left < proof_i64_min() + right
            return (false, 0) if right < 0 and left > proof_i64_max() + right
            return (true, left - right)

        def proof_mul_safe(left: i64, right: i64) -> (known: bool, value: i64):
            return (true, 0) if left == 0 or right == 0
            return (true, right) if left == 1
            return (true, left) if right == 1
            if left == -1:
                return (false, 0) if right == proof_i64_min()
                return (true, 0 - right)
            if right == -1:
                return (false, 0) if left == proof_i64_min()
                return (true, 0 - left)
            if left > 0:
                return (false, 0) if right > 0 and left > proof_i64_max() / right
                return (false, 0) if right < 0 and right < proof_i64_min() / left
            else:
                return (false, 0) if right > 0 and left < proof_i64_min() / right
                return (false, 0) if right < 0 and left < proof_i64_max() / right
            return (true, left * right)

        def proof_div_safe(left: i64, right: i64) -> (known: bool, value: i64):
            return (false, 0) if right == 0 or (left == proof_i64_min() and right == -1)
            return (true, left / right)

        def proof_mod_safe(left: i64, right: i64) -> (known: bool, value: i64):
            return (false, 0) if right == 0 or (left == proof_i64_min() and right == -1)
            return (true, left % right)

        # Elisa's integer bitwise operators use the target's fixed-width representation. The
        # shift count is still checked by the compiler's semantic pass; keep the same 0..63
        # boundary here so constant folding never relies on a host-language shift convention.
        def proof_shift_safe(value: i64, amount: i64, left: bool) -> (known: bool, value: i64):
            return (false, 0) if amount < 0 or amount > 63
            return (true, value << amount) if left
            return (true, value >> amount)

        def proof_constant_int(expression: Ast::Expr) -> (known: bool, value: i64):
            match expression:
                Ast::Expr.IntLit(value, _):
                    return (true, value)
                Ast::Expr.Paren(inner, _):
                    return proof_constant_int(inner)
                Ast::Expr.Field(object, field_name, _):
                    # The element count of a literal collection is written in the literal. This is
                    # not a claim about any storage: the term *is* the value, so nothing can alias
                    # it, mutate it, or make the count something else. A binding initialized to
                    # `[]` reaches a goal as `[].count` after substitution, which is how a length
                    # invariant is established at loop entry.
                    return (false, 0) if field_name != "count"
                    # Only the empty literal. A non-empty one would need its `usize` length as an
                    # `i64`, and the conversion is outside the expression fragment this checker
                    # verifies: putting one here made `proof_kernel_replay_constant_int` itself
                    # unverifiable and cost 16 functions and 65 proofs to the cascade. The empty
                    # case needs no conversion and is the one a length invariant starts from.
                    match object:
                        Ast::Expr.Array(elements, _):
                            return (false, 0) if elements.count != 0
                            return (true, 0)
                        _:
                            return (false, 0)
                Ast::Expr.Unary(operator, operand, _):
                    found: (known: bool, value: i64) = proof_constant_int(operand)
                    if found.known and operator == TokenKind.Minus:
                        return (true, 0 - found.value) if found.value != proof_i64_min()
                    if found.known and operator == TokenKind.Plus:
                        return found
                    return (false, 0)
                Ast::Expr.Binary(left, operator, right, _):
                    a: (known: bool, value: i64) = proof_constant_int(left)
                    b: (known: bool, value: i64) = proof_constant_int(right)
                    return (false, 0) if not a.known or not b.known
                    if operator == TokenKind.Plus:
                        return proof_add_safe(a.value, b.value)
                    if operator == TokenKind.Minus:
                        return proof_sub_safe(a.value, b.value)
                    if operator == TokenKind.Star:
                        return proof_mul_safe(a.value, b.value)
                    if operator == TokenKind.Slash:
                        return proof_div_safe(a.value, b.value)
                    if operator == TokenKind.Percent:
                        return proof_mod_safe(a.value, b.value)
                    if operator == TokenKind.Ampersand:
                        return (true, a.value & b.value)
                    if operator == TokenKind.Pipe:
                        return (true, a.value | b.value)
                    if operator == TokenKind.Caret:
                        return (true, a.value ^ b.value)
                    if operator == TokenKind.LShift:
                        return proof_shift_safe(a.value, b.value, true)
                    if operator == TokenKind.RShift:
                        return proof_shift_safe(a.value, b.value, false)
                    return (false, 0)
                _:
                    return (false, 0)

        def proof_normalized_equal(left: Ast::Expr, right: Ast::Expr) -> bool:
            return proof_expr_equal(left, right)

        # Return true when an expression contains a named value. Unsupported expression
        # forms are treated as containing the name: a lemma with an opaque postcondition
        # must not be applied to a caller unless a later kernel tier understands that form.
        def proof_expr_mentions_name(expression: Ast::Expr, target: sview) -> bool:
            return proof_expr_mentions_name_depth(expression, target, 0)

        def proof_expr_mentions_name_depth(expression: Ast::Expr, target: sview, depth: usize) -> bool:
            # At the limit, conservatively report a mention. This predicate is used to reject
            # unsafe substitutions and dependency claims, so false negatives are unsound while
            # a deep-term rejection is safe.
            return true if depth >= PROOF_REPLAY_AST_DEPTH_LIMIT
            match expression:
                Ast::Expr.IntLit(_, _):
                    return false
                Ast::Expr.BoolLit(_, _):
                    return false
                Ast::Expr.FloatLit(_, _):
                    return false
                Ast::Expr.StringLit(_, _):
                    return false
                Ast::Expr.CharLit(_, _):
                    return false
                Ast::Expr.Ident(name, _):
                    return name == target
                Ast::Expr.Paren(inner, _):
                    return proof_expr_mentions_name_depth(inner, target, depth + 1)
                Ast::Expr.Unary(_, operand, _):
                    return proof_expr_mentions_name_depth(operand, target, depth + 1)
                Ast::Expr.Binary(left, _, right, _):
                    return proof_expr_mentions_name_depth(left, target, depth + 1) or proof_expr_mentions_name_depth(right, target, depth + 1)
                Ast::Expr.Call(callee, arguments, _, _):
                    return true if proof_expr_mentions_name_depth(callee, target, depth + 1)
                    for argument in arguments:
                        return true if proof_expr_mentions_name_depth(argument, target, depth + 1)
                    return false
                Ast::Expr.Field(object, _, _):
                    return proof_expr_mentions_name_depth(object, target, depth + 1)
                Ast::Expr.Scope(base, scoped_name, _):
                    # The scope leaf is a binding too. Ignoring it would let a qualified
                    # mutable global (for example `Config.counter`) evade dependency scans and
                    # would make unresolved-formal checks unsound across qualified names.
                    return true if scoped_name == target
                    return proof_expr_mentions_name_depth(base, target, depth + 1)
                Ast::Expr.Index(object, index, _):
                    return proof_expr_mentions_name_depth(object, target, depth + 1) or proof_expr_mentions_name_depth(index, target, depth + 1)
                Ast::Expr.Slice(object, low, high, _):
                    return proof_expr_mentions_name_depth(object, target, depth + 1) or proof_expr_mentions_name_depth(low, target, depth + 1) or proof_expr_mentions_name_depth(high, target, depth + 1)
                Ast::Expr.IndexN(object, arguments, _):
                    return true if proof_expr_mentions_name_depth(object, target, depth + 1)
                    for argument in arguments:
                        return true if proof_expr_mentions_name_depth(argument, target, depth + 1)
                    return false
                Ast::Expr.Move(operand, _):
                    return proof_expr_mentions_name_depth(operand, target, depth + 1)
                Ast::Expr.RegionNew(operand, _, _):
                    return proof_expr_mentions_name_depth(operand, target, depth + 1)
                Ast::Expr.Array(elements, _):
                    for element in elements:
                        return true if proof_expr_mentions_name_depth(element, target, depth + 1)
                    return false
                Ast::Expr.Tuple(elements, _):
                    for element in elements:
                        return true if proof_expr_mentions_name_depth(element, target, depth + 1)
                    return false
                Ast::Expr.SetLit(elements, _):
                    for element in elements:
                        return true if proof_expr_mentions_name_depth(element, target, depth + 1)
                    return false
                Ast::Expr.DictLit(entries, _):
                    for entry in entries:
                        return true if proof_expr_mentions_name_depth(entry.key, target, depth + 1) or proof_expr_mentions_name_depth(entry.value, target, depth + 1)
                    return false
                Ast::Expr.Construct(_, fields, _):
                    for field in fields:
                        return true if proof_expr_mentions_name_depth(field.value, target, depth + 1)
                    return false
                Ast::Expr.RecordUpdate(base, fields, _):
                    return true if proof_expr_mentions_name_depth(base, target, depth + 1)
                    for field in fields:
                        return true if proof_expr_mentions_name_depth(field.value, target, depth + 1)
                    return false
                Ast::Expr.If(condition, then_expr, else_expr, _):
                    return proof_expr_mentions_name_depth(condition, target, depth + 1) or proof_expr_mentions_name_depth(then_expr, target, depth + 1) or proof_expr_mentions_name_depth(else_expr, target, depth + 1)
                Ast::Expr.Match(scrutinee, arms, _):
                    return true if proof_expr_mentions_name_depth(scrutinee, target, depth + 1)
                    for arm in arms:
                        return true if proof_expr_mentions_name_depth(arm.guard, target, depth + 1)
                        return true if arm.body.count != 1
                        match arm.body[0]:
                            Ast::Stmt.Expr(value, _):
                                return true if proof_expr_mentions_name_depth(value, target, depth + 1)
                            _:
                                return true
                    return false
                Ast::Expr.Comprehension(variable, iterable, condition, body, _):
                    return true if proof_expr_mentions_name_depth(iterable, target, depth + 1)
                    return false if variable == target
                    return proof_expr_mentions_name_depth(condition, target, depth + 1) or proof_expr_mentions_name_depth(body, target, depth + 1)
                Ast::Expr.Refinement(base, predicate, _):
                    return proof_expr_mentions_name_depth(base, target, depth + 1) or proof_expr_mentions_name_depth(predicate, target, depth + 1)
                Ast::Expr.Block(statements, value, _, _):
                    body_mentions: mutable bool = true
                    for statement in statements |body_mentions|:
                        match statement:
                            Ast::Stmt.VarDecl(local_name, _, initializer, _):
                                return true if proof_expr_mentions_name_depth(initializer, target, depth + 1)
                                body_mentions <- false if local_name == target
                            _:
                                return true
                    return body_mentions and proof_expr_mentions_name_depth(value, target, depth + 1)
                _:
                    return true

        # Calls inside an initializer or expression may mutate aliases outside the symbolic
        # state. Unknown AST forms count as effectful until a kernel tier models them.
        def proof_expr_has_call(expression: Ast::Expr) -> bool:
            return proof_expr_has_call_depth(expression, 0)

    private:
        def proof_expr_has_call_depth(expression: Ast::Expr, depth: usize) -> bool:
            # A deep term is opaque to this effect scan. Treat it as effectful so no hidden call
            # can cross a boundary merely because the scan stopped before reaching it.
            return true if depth >= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT
            match expression:
                Ast::Expr.Invalid:
                    return false
                Ast::Expr.Absent:
                    return false
                Ast::Expr.IntLit(_, _):
                    return false
                Ast::Expr.BoolLit(_, _):
                    return false
                Ast::Expr.FloatLit(_, _):
                    return false
                Ast::Expr.StringLit(_, _):
                    return false
                Ast::Expr.CharLit(_, _):
                    return false
                Ast::Expr.Ident(_, _):
                    return false
                Ast::Expr.ShorthandMember(_, _):
                    return false
                Ast::Expr.Call(_, _, _, _):
                    return true
                Ast::Expr.Paren(inner, _):
                    return proof_expr_has_call_depth(inner, depth + 1)
                Ast::Expr.Unary(_, operand, _):
                    return proof_expr_has_call_depth(operand, depth + 1)
                Ast::Expr.Binary(left, _, right, _):
                    return proof_expr_has_call_depth(left, depth + 1) or proof_expr_has_call_depth(right, depth + 1)
                Ast::Expr.Field(object, _, _):
                    return proof_expr_has_call_depth(object, depth + 1)
                Ast::Expr.Scope(base, _, _):
                    return proof_expr_has_call_depth(base, depth + 1)
                Ast::Expr.Index(object, index, _):
                    return proof_expr_has_call_depth(object, depth + 1) or proof_expr_has_call_depth(index, depth + 1)
                Ast::Expr.Slice(object, low, high, _):
                    return proof_expr_has_call_depth(object, depth + 1) or proof_expr_has_call_depth(low, depth + 1) or proof_expr_has_call_depth(high, depth + 1)
                Ast::Expr.IndexN(object, arguments, _):
                    return true if proof_expr_has_call_depth(object, depth + 1)
                    for argument in arguments:
                        return true if proof_expr_has_call_depth(argument, depth + 1)
                    return false
                Ast::Expr.Move(operand, _):
                    return proof_expr_has_call_depth(operand, depth + 1)
                Ast::Expr.RegionNew(operand, _, _):
                    return proof_expr_has_call_depth(operand, depth + 1)
                Ast::Expr.Array(elements, _):
                    for element in elements:
                        return true if proof_expr_has_call_depth(element, depth + 1)
                    return false
                Ast::Expr.Tuple(elements, _):
                    for element in elements:
                        return true if proof_expr_has_call_depth(element, depth + 1)
                    return false
                Ast::Expr.SetLit(elements, _):
                    for element in elements:
                        return true if proof_expr_has_call_depth(element, depth + 1)
                    return false
                Ast::Expr.DictLit(entries, _):
                    for entry in entries:
                        return true if proof_expr_has_call_depth(entry.key, depth + 1) or proof_expr_has_call_depth(entry.value, depth + 1)
                    return false
                Ast::Expr.Construct(_, fields, _):
                    for field in fields:
                        return true if proof_expr_has_call_depth(field.value, depth + 1)
                    return false
                Ast::Expr.RecordUpdate(base, fields, _):
                    return true if proof_expr_has_call_depth(base, depth + 1)
                    for field in fields:
                        return true if proof_expr_has_call_depth(field.value, depth + 1)
                    return false
                Ast::Expr.If(condition, then_expr, else_expr, _):
                    return proof_expr_has_call_depth(condition, depth + 1) or proof_expr_has_call_depth(then_expr, depth + 1) or proof_expr_has_call_depth(else_expr, depth + 1)
                Ast::Expr.Match(scrutinee, arms, _):
                    return true if proof_expr_has_call_depth(scrutinee, depth + 1)
                    for arm in arms:
                        return true if proof_expr_has_call_depth(arm.guard, depth + 1)
                        return true if arm.body.count != 1
                        match arm.body[0]:
                            Ast::Stmt.Expr(value, _):
                                return true if proof_expr_has_call_depth(value, depth + 1)
                            _:
                                return true
                    return false
                Ast::Expr.Catch(guarded, arms, _):
                    return true if proof_expr_has_call_depth(guarded, depth + 1)
                    for arm in arms:
                        return true if proof_expr_has_call_depth(arm.guard, depth + 1)
                        return true if arm.body.count != 1
                        match arm.body[0]:
                            Ast::Stmt.Expr(value, _):
                                return true if proof_expr_has_call_depth(value, depth + 1)
                            _:
                                return true
                    return false
                Ast::Expr.Comprehension(_, iterable, condition, body, _):
                    return proof_expr_has_call_depth(iterable, depth + 1) or proof_expr_has_call_depth(condition, depth + 1) or proof_expr_has_call_depth(body, depth + 1)
                Ast::Expr.Refinement(base, predicate, _):
                    return proof_expr_has_call_depth(base, depth + 1) or proof_expr_has_call_depth(predicate, depth + 1)
                Ast::Expr.Block(statements, value, _, _):
                    for statement in statements:
                        match statement:
                            Ast::Stmt.VarDecl(_, _, initializer, _):
                                return true if proof_expr_has_call_depth(initializer, depth + 1)
                            _:
                                return true
                    return proof_expr_has_call_depth(value, depth + 1)
                _:
                    return true

    public:
        # A move is an executable ownership transition even when its operand is otherwise a
        # simple symbolic expression. Keep this separate from call detection: a move can be
        # effectful without invoking a function, and facts must not cross that boundary.
        def proof_expr_has_move(expression: Ast::Expr) -> bool:
            return proof_expr_has_move_depth(expression, 0)

    private:
        def proof_expr_has_move_depth(expression: Ast::Expr, depth: usize) -> bool:
            # An unvisited deep term is conservatively considered a move-bearing expression. It
            # must not be allowed to preserve ownership facts merely because the scan stopped.
            return true if depth >= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT
            match expression:
                Ast::Expr.Move(_, _):
                    return true
                Ast::Expr.Paren(inner, _):
                    return proof_expr_has_move_depth(inner, depth + 1)
                Ast::Expr.Unary(_, operand, _):
                    return proof_expr_has_move_depth(operand, depth + 1)
                Ast::Expr.Binary(left, _, right, _):
                    return proof_expr_has_move_depth(left, depth + 1) or proof_expr_has_move_depth(right, depth + 1)
                Ast::Expr.Call(callee, arguments, _, _):
                    return true if proof_expr_has_move_depth(callee, depth + 1)
                    for argument in arguments:
                        return true if proof_expr_has_move_depth(argument, depth + 1)
                    return false
                Ast::Expr.Field(object, _, _):
                    return proof_expr_has_move_depth(object, depth + 1)
                Ast::Expr.Scope(base, _, _):
                    return proof_expr_has_move_depth(base, depth + 1)
                Ast::Expr.Index(object, index, _):
                    return proof_expr_has_move_depth(object, depth + 1) or proof_expr_has_move_depth(index, depth + 1)
                Ast::Expr.Slice(object, low, high, _):
                    return proof_expr_has_move_depth(object, depth + 1) or proof_expr_has_move_depth(low, depth + 1) or proof_expr_has_move_depth(high, depth + 1)
                Ast::Expr.IndexN(object, arguments, _):
                    return true if proof_expr_has_move_depth(object, depth + 1)
                    for argument in arguments:
                        return true if proof_expr_has_move_depth(argument, depth + 1)
                    return false
                Ast::Expr.RegionNew(operand, _, _):
                    return proof_expr_has_move_depth(operand, depth + 1)
                Ast::Expr.Array(elements, _):
                    for element in elements:
                        return true if proof_expr_has_move_depth(element, depth + 1)
                    return false
                Ast::Expr.Tuple(elements, _):
                    for element in elements:
                        return true if proof_expr_has_move_depth(element, depth + 1)
                    return false
                Ast::Expr.SetLit(elements, _):
                    for element in elements:
                        return true if proof_expr_has_move_depth(element, depth + 1)
                    return false
                Ast::Expr.DictLit(entries, _):
                    for entry in entries:
                        return true if proof_expr_has_move_depth(entry.key, depth + 1) or proof_expr_has_move_depth(entry.value, depth + 1)
                    return false
                Ast::Expr.Construct(_, fields, _):
                    for field in fields:
                        return true if proof_expr_has_move_depth(field.value, depth + 1)
                    return false
                Ast::Expr.RecordUpdate(base, fields, _):
                    return true if proof_expr_has_move_depth(base, depth + 1)
                    for field in fields:
                        return true if proof_expr_has_move_depth(field.value, depth + 1)
                    return false
                Ast::Expr.If(condition, then_expr, else_expr, _):
                    return proof_expr_has_move_depth(condition, depth + 1) or proof_expr_has_move_depth(then_expr, depth + 1) or proof_expr_has_move_depth(else_expr, depth + 1)
                Ast::Expr.Match(scrutinee, arms, _):
                    return true if proof_expr_has_move_depth(scrutinee, depth + 1)
                    for arm in arms:
                        return true if proof_expr_has_move_depth(arm.guard, depth + 1)
                        return true if arm.body.count != 1
                        match arm.body[0]:
                            Ast::Stmt.Expr(value, _):
                                return true if proof_expr_has_move_depth(value, depth + 1)
                            _:
                                return true
                    return false
                Ast::Expr.Catch(guarded, arms, _):
                    return true if proof_expr_has_move_depth(guarded, depth + 1)
                    for arm in arms:
                        return true if proof_expr_has_move_depth(arm.guard, depth + 1)
                        return true if arm.body.count != 1
                        match arm.body[0]:
                            Ast::Stmt.Expr(value, _):
                                return true if proof_expr_has_move_depth(value, depth + 1)
                            _:
                                return true
                    return false
                Ast::Expr.Comprehension(_, iterable, condition, body, _):
                    return proof_expr_has_move_depth(iterable, depth + 1) or proof_expr_has_move_depth(condition, depth + 1) or proof_expr_has_move_depth(body, depth + 1)
                Ast::Expr.Refinement(base, predicate, _):
                    return proof_expr_has_move_depth(base, depth + 1) or proof_expr_has_move_depth(predicate, depth + 1)
                Ast::Expr.Block(statements, value, _, _):
                    for statement in statements:
                        match statement:
                            Ast::Stmt.VarDecl(_, _, initializer, _):
                                return true if proof_expr_has_move_depth(initializer, depth + 1)
                            Ast::Stmt.Assign(_, _, initializer, _):
                                return true if proof_expr_has_move_depth(initializer, depth + 1)
                            Ast::Stmt.Expr(statement_expression, _):
                                return true if proof_expr_has_move_depth(statement_expression, depth + 1)
                            Ast::Stmt.Return(statement_value, _):
                                if statement_value is returned:
                                    return true if proof_expr_has_move_depth(returned, depth + 1)
                            _:
                                return true
                    return proof_expr_has_move_depth(value, depth + 1)
                _:
                    return false

        # A call-rooted expression has a stable symbolic result: the whole call node can be
        # retained while its callee/arguments are checked in evaluation order. Nested calls are
        # admitted separately only when the purity fixed point proves every call total and
        # non-mutating; nested effectful calls still require a general expression evaluator and
        # are rejected at the statement boundary.
