extend ElisaProof:
    public:
        def proof_expr_has_old(expression: Ast::Expr) -> bool:
            return proof_expr_has_old_depth(expression, 0)

    private:
        def proof_expr_has_old_depth(expression: Ast::Expr, depth: usize) -> bool:
            # At the boundary, treat the term as containing old-state data. This prevents an
            # unvisited nested `old(...)` from being exported as a post-state fact.
            return true if depth >= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT
            match expression:
                Ast::Expr.Call(callee, arguments, _, _):
                    return true if proof_ident_name(callee) == "old"
                    return true if proof_expr_has_old_depth(callee, depth + 1)
                    for argument in arguments:
                        return true if proof_expr_has_old_depth(argument, depth + 1)
                    return false
                Ast::Expr.StaticEffectCall(_, _, _, _, _, _):
                    return true
                Ast::Expr.Paren(inner, _):
                    return proof_expr_has_old_depth(inner, depth + 1)
                Ast::Expr.Unary(_, operand, _):
                    return proof_expr_has_old_depth(operand, depth + 1)
                Ast::Expr.Binary(left, _, right, _):
                    return proof_expr_has_old_depth(left, depth + 1) or proof_expr_has_old_depth(right, depth + 1)
                Ast::Expr.Field(object, _, _):
                    return proof_expr_has_old_depth(object, depth + 1)
                Ast::Expr.Scope(base, _, _):
                    return proof_expr_has_old_depth(base, depth + 1)
                Ast::Expr.Index(object, index, _):
                    return proof_expr_has_old_depth(object, depth + 1) or proof_expr_has_old_depth(index, depth + 1)
                Ast::Expr.Slice(object, low, high, _):
                    return proof_expr_has_old_depth(object, depth + 1) or proof_expr_has_old_depth(low, depth + 1) or proof_expr_has_old_depth(high, depth + 1)
                Ast::Expr.IndexN(object, arguments, _):
                    return true if proof_expr_has_old_depth(object, depth + 1)
                    for argument in arguments:
                        return true if proof_expr_has_old_depth(argument, depth + 1)
                    return false
                Ast::Expr.Move(operand, _):
                    return proof_expr_has_old_depth(operand, depth + 1)
                Ast::Expr.RegionNew(operand, _, _):
                    return proof_expr_has_old_depth(operand, depth + 1)
                Ast::Expr.Array(elements, _):
                    for element in elements:
                        return true if proof_expr_has_old_depth(element, depth + 1)
                    return false
                Ast::Expr.Tuple(elements, _):
                    for element in elements:
                        return true if proof_expr_has_old_depth(element, depth + 1)
                    return false
                Ast::Expr.SetLit(elements, _):
                    for element in elements:
                        return true if proof_expr_has_old_depth(element, depth + 1)
                    return false
                Ast::Expr.DictLit(entries, _):
                    for entry in entries:
                        return true if proof_expr_has_old_depth(entry.key, depth + 1) or proof_expr_has_old_depth(entry.value, depth + 1)
                    return false
                Ast::Expr.Construct(type_expression, fields, _):
                    return true if proof_expr_has_old_depth(type_expression, depth + 1)
                    for field in fields:
                        return true if proof_expr_has_old_depth(field.value, depth + 1)
                    return false
                Ast::Expr.RecordUpdate(base, fields, _):
                    return true if proof_expr_has_old_depth(base, depth + 1)
                    for field in fields:
                        return true if proof_expr_has_old_depth(field.value, depth + 1)
                    return false
                Ast::Expr.If(condition, then_expr, else_expr, _):
                    return proof_expr_has_old_depth(condition, depth + 1) or proof_expr_has_old_depth(then_expr, depth + 1) or proof_expr_has_old_depth(else_expr, depth + 1)
                Ast::Expr.Comprehension(_, iterable, condition, body, _):
                    return proof_expr_has_old_depth(iterable, depth + 1) or proof_expr_has_old_depth(condition, depth + 1) or proof_expr_has_old_depth(body, depth + 1)
                Ast::Expr.Refinement(base, predicate, _):
                    return proof_expr_has_old_depth(base, depth + 1) or proof_expr_has_old_depth(predicate, depth + 1)
                Ast::Expr.Match(scrutinee, arms, _):
                    return true if proof_expr_has_old_depth(scrutinee, depth + 1)
                    for arm in arms:
                        return true if proof_expr_has_old_depth(arm.guard, depth + 1) or proof_body_has_old_depth(arm.body, depth + 1)
                    return false
                Ast::Expr.Catch(guarded, arms, _):
                    return true if proof_expr_has_old_depth(guarded, depth + 1)
                    for arm in arms:
                        return true if proof_expr_has_old_depth(arm.guard, depth + 1) or proof_body_has_old_depth(arm.body, depth + 1)
                    return false
                Ast::Expr.GetElse(guarded, recovery, _):
                    return proof_expr_has_old_depth(guarded, depth + 1) or proof_body_has_old_depth(recovery, depth + 1)
                Ast::Expr.Lambda(_, body, _):
                    return proof_body_has_old_depth(body, depth + 1)
                Ast::Expr.Block(statements, value, _, _):
                    return proof_body_has_old_depth(statements, depth + 1) or proof_expr_has_old_depth(value, depth + 1)
                _:
                    return false

        # Executable call summaries snapshot only the deliberately small case
        # `old(reference[0])`. Any other old-state shape remains opaque at call boundaries.
        # This scan accepts several occurrences only when they all name the same parameter.
        def proof_old_reference_parameter(expression: Ast::Expr) -> (known: bool, found: bool, parameter: sview):
            return proof_old_reference_parameter_depth(expression, 0)

        def proof_old_reference_merge(left: (known: bool, found: bool, parameter: sview), right: (known: bool, found: bool, parameter: sview)) -> (known: bool, found: bool, parameter: sview):
            return (false, left.found or right.found, "") if not left.known or not right.known
            return (false, true, "") if left.found and right.found and left.parameter != right.parameter
            return left if left.found else right

        def proof_old_reference_parameter_depth(expression: Ast::Expr, depth: usize) -> (known: bool, found: bool, parameter: sview):
            return (false, true, "") if depth >= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT
            match expression:
                Ast::Expr.Call(callee, arguments, _, _):
                    if proof_ident_name(callee) == "old":
                        return (false, true, "") if arguments.count != 1
                        match arguments[0]:
                            Ast::Expr.Index(object, index, _):
                                match object:
                                    Ast::Expr.Ident(parameter, _):
                                        match index:
                                            Ast::Expr.IntLit(offset, _):
                                                return (true, true, parameter) if offset == 0
                                            _:
                                                pass
                                    _:
                                        pass
                            _:
                                pass
                        return (false, true, "")
                    found: mutable (known: bool, found: bool, parameter: sview) = proof_old_reference_parameter_depth(callee, depth + 1)
                    for argument in arguments |found, depth|:
                        found <- proof_old_reference_merge(found, proof_old_reference_parameter_depth(argument, depth + 1))
                    return found
                Ast::Expr.Paren(inner, _):
                    return proof_old_reference_parameter_depth(inner, depth + 1)
                Ast::Expr.Unary(_, operand, _):
                    return proof_old_reference_parameter_depth(operand, depth + 1)
                Ast::Expr.Binary(left, _, right, _):
                    return proof_old_reference_merge(proof_old_reference_parameter_depth(left, depth + 1), proof_old_reference_parameter_depth(right, depth + 1))
                _:
                    return (false, true, "") if proof_expr_has_old(expression)
                    return (true, false, "")
