# Public substitution entrypoints and their up-front work reservation.
extend ElisaProof:
    private:
        def proof_substitute[@r](expression: Ast::Expr, names: darray[sview]&, values: darray[Ast::Expr]& @r) -> Ast::Expr @r:
            work: mutable usize = 0
            return proof_substitute_with_work(expression, names, values, &work)
        def proof_substitute_with_work[@r](expression: Ast::Expr, names: darray[sview]&, values: darray[Ast::Expr]& @r, work: mutable usize&) -> Ast::Expr @r:
            return Ast::Expr.Invalid if not proof_substitution_reserve_work(expression, names, values, [], [], work)
            return proof_substitute_depth_with_work(expression, names, values, work)

    private:
        def proof_substitution_reserve_work(expression: Ast::Expr, names: darray[sview]&, values: darray[Ast::Expr]&, extra_names: darray[sview]&, extra_values: darray[Ast::Expr]&, work: mutable usize&) -> bool:
            reserved: bool = proof_substitution_reserve_work_inner(expression, names, values, extra_names, extra_values, work)
            if not reserved:
                work <- PROOF_MATCH_LOWERING_WORK_LIMIT + 1
                return false
            return true

        def proof_substitution_reserve_work_inner(expression: Ast::Expr, names: darray[sview]&, values: darray[Ast::Expr]&, extra_names: darray[sview]&, extra_values: darray[Ast::Expr]&, work: mutable usize&) -> bool:
            return false if work >= PROOF_MATCH_LOWERING_WORK_LIMIT
            source_cost: mutable usize = 0
            return false if not proof_replay_summary_expr_cost_with_limit(expression, &source_cost, work, PROOF_MATCH_LOWERING_WORK_LIMIT) or source_cost == 0
            mapping_cost: usize = proof_substitution_mapping_cost(names, values, extra_names, extra_values, work)
            return false if mapping_cost == 0
            return false if source_cost > (PROOF_MATCH_LOWERING_WORK_LIMIT - work) / (mapping_cost + source_cost + 2)
            reserved: usize = source_cost * (mapping_cost + source_cost + 2)
            work <- work + reserved
            return true

        def proof_substitution_mapping_cost(names: darray[sview]&, values: darray[Ast::Expr]&, extra_names: darray[sview]&, extra_values: darray[Ast::Expr]&, work: usize) -> usize:
            mapping_cost: mutable usize = 1
            for binding_name in names |binding_name, mapping_cost|:
                return 0 if mapping_cost >= PROOF_MATCH_LOWERING_WORK_LIMIT or sview_len(binding_name) > PROOF_MATCH_LOWERING_WORK_LIMIT - mapping_cost - 1
                mapping_cost <- mapping_cost + 1 + sview_len(binding_name)
            for replacement in values |replacement, mapping_cost, work|:
                replacement_cost: mutable usize = 0
                return 0 if not proof_replay_summary_expr_cost_with_limit(replacement, &replacement_cost, work + mapping_cost, PROOF_MATCH_LOWERING_WORK_LIMIT)
                return 0 if replacement_cost > PROOF_MATCH_LOWERING_WORK_LIMIT - mapping_cost
                mapping_cost <- mapping_cost + replacement_cost
            for binding_name in extra_names |binding_name, mapping_cost|:
                return 0 if mapping_cost >= PROOF_MATCH_LOWERING_WORK_LIMIT or sview_len(binding_name) > PROOF_MATCH_LOWERING_WORK_LIMIT - mapping_cost - 1
                mapping_cost <- mapping_cost + 1 + sview_len(binding_name)
            for replacement in extra_values |replacement, mapping_cost, work|:
                replacement_cost: mutable usize = 0
                return 0 if not proof_replay_summary_expr_cost_with_limit(replacement, &replacement_cost, work + mapping_cost, PROOF_MATCH_LOWERING_WORK_LIMIT)
                return 0 if replacement_cost > PROOF_MATCH_LOWERING_WORK_LIMIT - mapping_cost
                mapping_cost <- mapping_cost + replacement_cost
            mapping_cost
