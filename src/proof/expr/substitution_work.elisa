# Public substitution entrypoints and their up-front work reservation.
extend ElisaProof:
    private:
        def proof_substitute[@r](expression: Ast::Expr, names: darray[sview]&, values: darray[Ast::Expr]& @r) -> Ast::Expr @r:
            work: mutable usize = 0
            return proof_substitute_with_work(expression, names, values, &work)
        def proof_substitute_with_work[@r](expression: Ast::Expr, names: darray[sview]&, values: darray[Ast::Expr]& @r, work: mutable usize&) -> Ast::Expr @r:
            return Ast::Expr.Invalid if not proof_substitution_reserve_work(expression, names, values, [], [], work)
            return proof_substitute_depth_with_work(expression, names, values, work)

        def proof_substitute_with_work_limit[@r](expression: Ast::Expr, names: darray[sview]&, values: darray[Ast::Expr]& @r, work: mutable usize&, limit: usize) -> Ast::Expr @r:
            return Ast::Expr.Invalid if not proof_substitution_reserve_work_with_limit(expression, names, values, [], [], work, limit)
            return proof_substitute_depth_with_work_limit(expression, names, values, work, limit)

    private:
        def proof_substitution_reserve_work(expression: Ast::Expr, names: darray[sview]&, values: darray[Ast::Expr]&, extra_names: darray[sview]&, extra_values: darray[Ast::Expr]&, work: mutable usize&) -> bool:
            proof_substitution_reserve_work_with_limit(expression, names, values, extra_names, extra_values, work, PROOF_MATCH_LOWERING_WORK_LIMIT)

        def proof_substitution_reserve_work_with_limit(expression: Ast::Expr, names: darray[sview]&, values: darray[Ast::Expr]&, extra_names: darray[sview]&, extra_values: darray[Ast::Expr]&, work: mutable usize&, limit: usize) -> bool:
            reserved: bool = proof_substitution_reserve_work_inner(expression, names, values, extra_names, extra_values, work, limit)
            if not reserved:
                work <- limit + 1
                return false
            return true

        def proof_substitution_reserve_work_inner(expression: Ast::Expr, names: darray[sview]&, values: darray[Ast::Expr]&, extra_names: darray[sview]&, extra_values: darray[Ast::Expr]&, work: mutable usize&, limit: usize) -> bool:
            return false if limit == 0 or work >= limit
            source_cost: mutable usize = 0
            return false if not proof_replay_summary_expr_cost_with_limit(expression, &source_cost, work, limit) or source_cost == 0
            mapping_cost: usize = proof_substitution_mapping_cost(names, values, extra_names, extra_values, work, limit)
            return false if mapping_cost == 0
            return false if source_cost > (limit - work) / (mapping_cost + source_cost + 2)
            reserved: usize = source_cost * (mapping_cost + source_cost + 2)
            work <- work + reserved
            return true

        def proof_substitution_mapping_cost(names: darray[sview]&, values: darray[Ast::Expr]&, extra_names: darray[sview]&, extra_values: darray[Ast::Expr]&, work: usize, limit: usize) -> usize:
            return 0 if work >= limit
            mapping_cost: mutable usize = 1
            for binding_name in names |binding_name, mapping_cost|:
                return 0 if mapping_cost >= limit - work or sview_len(binding_name) > limit - work - mapping_cost - 1
                mapping_cost <- mapping_cost + 1 + sview_len(binding_name)
            for replacement in values |replacement, mapping_cost, work|:
                replacement_cost: mutable usize = 0
                return 0 if not proof_replay_summary_expr_cost_with_limit(replacement, &replacement_cost, work + mapping_cost, limit)
                return 0 if replacement_cost > limit - work - mapping_cost
                mapping_cost <- mapping_cost + replacement_cost
            for binding_name in extra_names |binding_name, mapping_cost|:
                return 0 if mapping_cost >= limit - work or sview_len(binding_name) > limit - work - mapping_cost - 1
                mapping_cost <- mapping_cost + 1 + sview_len(binding_name)
            for replacement in extra_values |replacement, mapping_cost, work|:
                replacement_cost: mutable usize = 0
                return 0 if not proof_replay_summary_expr_cost_with_limit(replacement, &replacement_cost, work + mapping_cost, limit)
                return 0 if replacement_cost > limit - work - mapping_cost
                mapping_cost <- mapping_cost + replacement_cost
            mapping_cost
