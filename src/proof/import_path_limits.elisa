# Shared limits and bounded scanners for textual source paths.
extend ElisaProof:
    private:
        const PROOF_IMPORT_RAW_PATH_MAX_BYTES: usize = 131072
        const PROOF_IMPORT_BYTE_NUL: u8 = 0
        const PROOF_IMPORT_MAX_FILES: usize = 4096
        const PROOF_IMPORT_PATH_METADATA_MAX_BYTES: usize = 4194304
        const PROOF_IMPORT_PATH_SCAN_WORK_MAX: usize = 67108864
        # Start small for ordinary one-file imports; geometric growth caps load at one half.
        const PROOF_IMPORT_PATH_INDEX_MAX_CAPACITY: usize = PROOF_IMPORT_MAX_FILES * 2
        const PROOF_IMPORT_PATH_INDEX_INITIAL_CAPACITY: usize = 16

        def proof_import_path_has_nul(path: darray[u8]&) -> bool:
            for byte in path |path|:
                return true if byte == PROOF_IMPORT_BYTE_NUL
            return false

        # Return an over-limit path at the rejection threshold without copying its full span.
        def proof_include_path_prefix(line: darray[u8]&, start: usize, stop: usize) -> darray[u8]:
            prefix: mutable darray[u8] = []
            while start < stop and prefix.count < PROOF_IMPORT_RAW_PATH_MAX_BYTES |line, start, stop, prefix|:
                prefix.push(line[start])
                start <- start + 1
            return prefix
