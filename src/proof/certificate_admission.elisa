# Certificate admission for non-propositional proof rules.
#
# The report model owns storage and ordinary goal certificates. Resource, effect, and structural
# certificates have distinct kernel roots, so their shape checks and admission policy live here.
extend ElisaProof:
    private:
        # Resource safety is certified by a source-neutral transition trace rather than by a
        # proposition in the ordinary expression language. Keep the source mirror intentionally
        # inert (`true`): the arena root is the semantic certificate, and replay dispatches it to
        # the resource kernel rule. No facts are admitted for this rule.
        def proof_add_resource_goal_attempt(report: mutable ProofReport&, kernel_goal: usize, line: u32, name: sview) -> bool:
            if report.analysis_1.kernel.budget_exhausted or kernel_goal >= report.analysis_1.kernel.nodes.count:
                proof_kernel_budget_note(report, name) if report.analysis_1.kernel.budget_exhausted or kernel_goal >= report.analysis_1.kernel.nodes.count
                report.proof_obligation(false)
                proof_add_finding(report, "kernel-certificate-invalid", line, name, "resource certificate root is not present in the kernel arena") if kernel_goal >= report.analysis_1.kernel.nodes.count and not report.analysis_1.kernel.budget_exhausted
                report.results.goal_attempts <- report.results.goal_attempts.push(ProofGoalAttempt{goal: Ast::Expr.BoolLit(true, Ast::pos_at_line(0)), budget_exhausted: report.analysis_1.kernel.budget_exhausted, facts_start: report.analysis_1.certificate_facts.count, facts_count: 0, kernel_goal: kernel_goal, kernel_facts_start: report.analysis_1.kernel.certificate_facts.count, kernel_facts_count: 0, line: line, name: name, rule: "resource-safety", producer_proven: false, has_certificate: false, certificate_index: report.analysis_1.certificates.count, owner_function_line: report.context.current_goal_owner_line, owner_function_offset: report.context.current_goal_owner_offset})
                return false
            root: ElisaProofKernelCore::ProofKernelNode = report.analysis_1.kernel.nodes[kernel_goal]
            if root.kind != "resource-safety" or root.name != name or root.operator != "resource-v2" or root.children_start > report.analysis_1.kernel.children.count or root.children_count > report.analysis_1.kernel.children.count - root.children_start:
                report.proof_obligation(false)
                proof_add_finding(report, "kernel-certificate-invalid", line, name, "resource certificate root has an invalid kernel shape")
                report.results.goal_attempts <- report.results.goal_attempts.push(ProofGoalAttempt{goal: Ast::Expr.BoolLit(true, Ast::pos_at_line(0)), budget_exhausted: false, facts_start: report.analysis_1.certificate_facts.count, facts_count: 0, kernel_goal: kernel_goal, kernel_facts_start: report.analysis_1.kernel.certificate_facts.count, kernel_facts_count: 0, line: line, name: name, rule: "resource-safety", producer_proven: false, has_certificate: false, certificate_index: report.analysis_1.certificates.count, owner_function_line: report.context.current_goal_owner_line, owner_function_offset: report.context.current_goal_owner_offset})
                return false
            certificate_index: usize = report.analysis_1.certificates.count
            empty_goal: Ast::Expr = Ast::Expr.BoolLit(true, Ast::pos_at_line(0))
            facts_start: usize = report.analysis_1.certificate_facts.count
            kernel_facts_start: usize = report.analysis_1.kernel.certificate_facts.count
            report.results.goal_attempts <- report.results.goal_attempts.push(ProofGoalAttempt{goal: empty_goal, budget_exhausted: false, facts_start: facts_start, facts_count: 0, kernel_goal: kernel_goal, kernel_facts_start: kernel_facts_start, kernel_facts_count: 0, line: line, name: name, rule: "resource-safety", producer_proven: true, has_certificate: true, certificate_index: certificate_index, owner_function_line: report.context.current_goal_owner_line, owner_function_offset: report.context.current_goal_owner_offset})
            report.analysis_1.certificates <- report.analysis_1.certificates.push(ProofGoalCertificate{goal: empty_goal, facts_start: facts_start, facts_count: 0, kernel_goal: kernel_goal, kernel_facts_start: kernel_facts_start, kernel_facts_count: 0, line: line, name: name, rule: "resource-safety", replayed: false})
            report.proof_obligation(true)
            return true

        # Effect containment is a source-neutral trace, like the resource one above: the source
        # mirror is intentionally inert and the arena root carries the declared row together with
        # every resolved callee row. No facts are admitted for this rule.
        def proof_add_effect_goal_attempt(report: mutable ProofReport&, kernel_goal: usize, line: u32, name: sview) -> bool:
            if report.analysis_1.kernel.budget_exhausted or kernel_goal >= report.analysis_1.kernel.nodes.count:
                proof_kernel_budget_note(report, name) if report.analysis_1.kernel.budget_exhausted or kernel_goal >= report.analysis_1.kernel.nodes.count
                report.proof_obligation(false)
                proof_add_finding(report, "kernel-certificate-invalid", line, name, "effect certificate root is not present in the kernel arena") if kernel_goal >= report.analysis_1.kernel.nodes.count and not report.analysis_1.kernel.budget_exhausted
                report.results.goal_attempts <- report.results.goal_attempts.push(ProofGoalAttempt{goal: Ast::Expr.BoolLit(true, Ast::pos_at_line(0)), budget_exhausted: report.analysis_1.kernel.budget_exhausted, facts_start: report.analysis_1.certificate_facts.count, facts_count: 0, kernel_goal: kernel_goal, kernel_facts_start: report.analysis_1.kernel.certificate_facts.count, kernel_facts_count: 0, line: line, name: name, rule: "effect-containment", producer_proven: false, has_certificate: false, certificate_index: report.analysis_1.certificates.count, owner_function_line: report.context.current_goal_owner_line, owner_function_offset: report.context.current_goal_owner_offset})
                return false
            root: ElisaProofKernelCore::ProofKernelNode = report.analysis_1.kernel.nodes[kernel_goal]
            if root.kind != "effect-containment" or root.children_start > report.analysis_1.kernel.children.count or root.children_count > report.analysis_1.kernel.children.count - root.children_start:
                report.proof_obligation(false)
                proof_add_finding(report, "kernel-certificate-invalid", line, name, "effect certificate root has an invalid kernel shape")
                report.results.goal_attempts <- report.results.goal_attempts.push(ProofGoalAttempt{goal: Ast::Expr.BoolLit(true, Ast::pos_at_line(0)), budget_exhausted: false, facts_start: report.analysis_1.certificate_facts.count, facts_count: 0, kernel_goal: kernel_goal, kernel_facts_start: report.analysis_1.kernel.certificate_facts.count, kernel_facts_count: 0, line: line, name: name, rule: "effect-containment", producer_proven: false, has_certificate: false, certificate_index: report.analysis_1.certificates.count, owner_function_line: report.context.current_goal_owner_line, owner_function_offset: report.context.current_goal_owner_offset})
                return false
            certificate_index: usize = report.analysis_1.certificates.count
            empty_goal: Ast::Expr = Ast::Expr.BoolLit(true, Ast::pos_at_line(0))
            facts_start: usize = report.analysis_1.certificate_facts.count
            kernel_facts_start: usize = report.analysis_1.kernel.certificate_facts.count
            report.results.goal_attempts <- report.results.goal_attempts.push(ProofGoalAttempt{goal: empty_goal, budget_exhausted: false, facts_start: facts_start, facts_count: 0, kernel_goal: kernel_goal, kernel_facts_start: kernel_facts_start, kernel_facts_count: 0, line: line, name: name, rule: "effect-containment", producer_proven: true, has_certificate: true, certificate_index: certificate_index, owner_function_line: report.context.current_goal_owner_line, owner_function_offset: report.context.current_goal_owner_offset})
            report.analysis_1.certificates <- report.analysis_1.certificates.push(ProofGoalCertificate{goal: empty_goal, facts_start: facts_start, facts_count: 0, kernel_goal: kernel_goal, kernel_facts_start: kernel_facts_start, kernel_facts_count: 0, line: line, name: name, rule: "effect-containment", replayed: false})
            report.proof_obligation(true)
            return true

        # Structural termination is a source-neutral transition certificate, just like the
        # resource trace above. The source checker still decides which typed match binders are
        # strict subterms; the kernel independently checks the serialized ranking relation,
        # including preservation of every product subject and at least one strict descent.
        def proof_add_structural_goal_attempt(report: mutable ProofReport&, kernel_goal: usize, line: u32, name: sview, call_offset: usize) -> bool:
            if report.analysis_1.kernel.budget_exhausted or kernel_goal >= report.analysis_1.kernel.nodes.count:
                proof_kernel_budget_note(report, name) if report.analysis_1.kernel.budget_exhausted or kernel_goal >= report.analysis_1.kernel.nodes.count
                report.proof_obligation(false)
                proof_add_finding(report, "kernel-certificate-invalid", line, name, "structural certificate root is not present in the kernel arena") if kernel_goal >= report.analysis_1.kernel.nodes.count and not report.analysis_1.kernel.budget_exhausted
                report.results.goal_attempts <- report.results.goal_attempts.push(ProofGoalAttempt{goal: Ast::Expr.BoolLit(true, Ast::pos_at_line(0)), budget_exhausted: report.analysis_1.kernel.budget_exhausted, facts_start: report.analysis_1.certificate_facts.count, facts_count: 0, kernel_goal: kernel_goal, kernel_facts_start: report.analysis_1.kernel.certificate_facts.count, kernel_facts_count: 0, line: line, name: name, rule: "structural-safety", producer_proven: false, has_certificate: false, certificate_index: report.analysis_1.certificates.count, owner_function_line: report.context.current_goal_owner_line, owner_function_offset: report.context.current_goal_owner_offset})
                return false
            root: ElisaProofKernelCore::ProofKernelNode = report.analysis_1.kernel.nodes[kernel_goal]
            if root.kind != "structural-safety" or root.left != call_offset or root.secondary_name != "structural-v2" or root.children_start > report.analysis_1.kernel.children.count or root.children_count > report.analysis_1.kernel.children.count - root.children_start:
                report.proof_obligation(false)
                proof_add_finding(report, "kernel-certificate-invalid", line, name, "structural certificate root has an invalid kernel shape")
                report.results.goal_attempts <- report.results.goal_attempts.push(ProofGoalAttempt{goal: Ast::Expr.BoolLit(true, Ast::pos_at_line(0)), budget_exhausted: false, facts_start: report.analysis_1.certificate_facts.count, facts_count: 0, kernel_goal: kernel_goal, kernel_facts_start: report.analysis_1.kernel.certificate_facts.count, kernel_facts_count: 0, line: line, name: name, rule: "structural-safety", producer_proven: false, has_certificate: false, certificate_index: report.analysis_1.certificates.count, owner_function_line: report.context.current_goal_owner_line, owner_function_offset: report.context.current_goal_owner_offset})
                return false
            certificate_index: usize = report.analysis_1.certificates.count
            empty_goal: Ast::Expr = Ast::Expr.BoolLit(true, Ast::pos_at_line(0))
            facts_start: usize = report.analysis_1.certificate_facts.count
            kernel_facts_start: usize = report.analysis_1.kernel.certificate_facts.count
            report.results.goal_attempts <- report.results.goal_attempts.push(ProofGoalAttempt{goal: empty_goal, budget_exhausted: false, facts_start: facts_start, facts_count: 0, kernel_goal: kernel_goal, kernel_facts_start: kernel_facts_start, kernel_facts_count: 0, line: line, name: name, rule: "structural-safety", producer_proven: true, has_certificate: true, certificate_index: certificate_index, owner_function_line: report.context.current_goal_owner_line, owner_function_offset: report.context.current_goal_owner_offset})
            report.analysis_1.certificates <- report.analysis_1.certificates.push(ProofGoalCertificate{goal: empty_goal, facts_start: facts_start, facts_count: 0, kernel_goal: kernel_goal, kernel_facts_start: kernel_facts_start, kernel_facts_count: 0, line: line, name: name, rule: "structural-safety", replayed: false})
            report.proof_obligation(true)
            return true
