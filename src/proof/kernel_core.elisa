# Small implementation core for invariants shared by certificate lowering and replay.
#
# This file intentionally has no compiler-AST dependency. It is the first part of the real proof
# implementation that can be checked as a standalone Elisa module, which is important for the
# eventual dogfood story: the proof assistant must not need to trust its own full frontend in order
# to validate these foundational bounds.
module ElisaProofKernelCore:
    public:
        const PROOF_KERNEL_NODE_BUDGET: usize = 1000000
        const PROOF_KERNEL_CHILD_BUDGET: usize = 4000000
        const PROOF_KERNEL_TYPE_BINDING_BUDGET: usize = 100000
        const PROOF_KERNEL_TYPE_WORK_BUDGET: usize = 16000000
        const PROOF_KERNEL_TYPE_SCAN_BUDGET: usize = PROOF_KERNEL_TYPE_WORK_BUDGET
        const PROOF_KERNEL_TYPE_SCAN_FACTOR: usize = 8
        const PROOF_KERNEL_AST_DEPTH_LIMIT: usize = 128
        const PROOF_KERNEL_FNV1A_OFFSET_BASIS: i64 = 2166136261
        const PROOF_KERNEL_FNV1A_PRIME: i64 = 16777619
        const PROOF_KERNEL_HASH_U32_MODULUS: i64 = 4294967296
        const PROOF_KERNEL_I64_MAX: i64 = 9223372036854775807
        const PROOF_KERNEL_I64_MIN: i64 = 0 - PROOF_KERNEL_I64_MAX - 1
        const PROOF_KERNEL_FIXED_WIDTH_MIN: i64 = 8
        const PROOF_KERNEL_U8_WIDTH: i64 = PROOF_KERNEL_FIXED_WIDTH_MIN
        const PROOF_KERNEL_U16_WIDTH: i64 = 16
        const PROOF_KERNEL_U32_WIDTH: i64 = 32
        const PROOF_KERNEL_MACHINE_WORD_BITS: i64 = 64
        const PROOF_KERNEL_U8_MAX: i64 = 255
        const PROOF_KERNEL_U16_MAX: i64 = 65535
        const PROOF_KERNEL_U32_MAX: i64 = 4294967295
        const PROOF_KERNEL_MAX_SHIFT_AMOUNT: i64 = PROOF_KERNEL_MACHINE_WORD_BITS - 1
        # Replay uses one less than the AST bound because recursive transitions increment the
        # depth before descending. Keeping both names here prevents per-module copies of the
        # protocol limit from drifting apart.
        const PROOF_KERNEL_REPLAY_DEPTH_LIMIT: usize = 127
        const PROOF_KERNEL_REPLAY_DEPTH_BOUND: usize = 128

        # Source-neutral term node shared by the producer and independent replay. Keeping this
        # representation in the AST-free core prevents the trusted replay data model from
        # depending on compiler AST declarations.
        struct ProofKernelNode:
            kind: sview
            # These metadata fields are rewritten while the arena is being enriched with
            # recovered source facts.  Mark the fields mutable explicitly: mutability of the
            # containing darray does not make an immutable struct field writable in Elisa.
            operator: mutable sview
            left: usize
            right: usize
            auxiliary: mutable usize
            children_start: usize
            children_count: usize
            value: i64
            name: sview
            secondary_name: mutable sview

        # Source-neutral declaration context for proposition formation. These entries describe
        # declarations, not proof assumptions and not per-expression Boolean markers. The source
        # adapter is responsible for deriving them from the compiler's checked type environment.
        # Exact `type_name` spellings retain integer width/signedness and named-type identity.
        struct ProofKernelTypingBinding:
            kind: sview
            name: sview
            owner: sview
            sort: sview
            type_name: sview
            element_sort: sview
            element_type_name: sview
            # Tuple and named-type identities come from the source declaration adapter. A spelling such as
            # A module-local type name is not enough to type a projection or variant test:
            # distinct declarations can reuse the same spelling.
            type_identity: usize
            owner_type_identity: usize
            element_type_identity: usize
            signature_identity: usize
            parameter_index: usize
            parameter_count: usize
            parameter_has_default: bool
            parameter_by_reference: bool

        struct ProofKernelTypeEnvironment:
            # Declaration signatures are shared across source obligations; expression-local
            # bindings remain separate so rebuilding an environment never copies the program-wide
            # signature table for every contract.
            global_bindings: darray[ProofKernelTypingBinding]
            bindings: darray[ProofKernelTypingBinding]

        def proof_kernel_add_typing_binding_with_metadata(bindings: mutable darray[ProofKernelTypingBinding]&, kind: sview, name: sview, owner: sview, sort: sview, type_name: sview, element_sort: sview, element_type_name: sview, type_identity: usize, owner_type_identity: usize, element_type_identity: usize, signature_identity: usize, parameter_index: usize, parameter_count: usize) -> bool:
            return false if bindings.count >= PROOF_KERNEL_TYPE_BINDING_BUDGET
            bindings.push(ProofKernelTypingBinding{kind: kind, name: name, owner: owner, sort: sort, type_name: type_name, element_sort: element_sort, element_type_name: element_type_name, type_identity: type_identity, owner_type_identity: owner_type_identity, element_type_identity: element_type_identity, signature_identity: signature_identity, parameter_index: parameter_index, parameter_count: parameter_count, parameter_has_default: false, parameter_by_reference: false})
            return true

        def proof_kernel_add_typing_binding_with_identity(bindings: mutable darray[ProofKernelTypingBinding]&, kind: sview, name: sview, owner: sview, sort: sview, type_name: sview, element_sort: sview, element_type_name: sview, type_identity: usize, owner_type_identity: usize, element_type_identity: usize) -> bool:
            return proof_kernel_add_typing_binding_with_metadata(bindings, kind, name, owner, sort, type_name, element_sort, element_type_name, type_identity, owner_type_identity, element_type_identity, 0, 0, 0)

        def proof_kernel_add_function_signature(bindings: mutable darray[ProofKernelTypingBinding]&, name: sview, sort: sview, type_name: sview, element_sort: sview, element_type_name: sview, type_identity: usize, element_type_identity: usize, signature_identity: usize, parameter_count: usize) -> bool:
            return proof_kernel_add_typing_binding_with_metadata(bindings, "function", name, "", sort, type_name, element_sort, element_type_name, type_identity, 0, element_type_identity, signature_identity, 0, parameter_count)

        def proof_kernel_add_function_parameter(bindings: mutable darray[ProofKernelTypingBinding]&, function_name: sview, parameter_name: sview, sort: sview, type_name: sview, element_sort: sview, element_type_name: sview, type_identity: usize, element_type_identity: usize, signature_identity: usize, parameter_index: usize, has_default: bool, by_reference: bool) -> bool:
            return false if bindings.count >= PROOF_KERNEL_TYPE_BINDING_BUDGET
            bindings.push(ProofKernelTypingBinding{kind: "function-parameter", name: parameter_name, owner: function_name, sort: sort, type_name: type_name, element_sort: element_sort, element_type_name: element_type_name, type_identity: type_identity, owner_type_identity: 0, element_type_identity: element_type_identity, signature_identity: signature_identity, parameter_index: parameter_index, parameter_count: 0, parameter_has_default: has_default, parameter_by_reference: by_reference})
            return true

        # Compatibility helper for scalar and non-aggregate container signatures. Tuple and
        # named-type signatures must use the identity-bearing form above or typed formation
        # rejects them.
        def proof_kernel_add_typing_binding(bindings: mutable darray[ProofKernelTypingBinding]&, kind: sview, name: sview, owner: sview, sort: sview, type_name: sview, element_sort: sview, element_type_name: sview) -> bool:
            return proof_kernel_add_typing_binding_with_identity(bindings, kind, name, owner, sort, type_name, element_sort, element_type_name, 0, 0, 0)

        def add_node(nodes: mutable darray[ProofKernelNode]&, kind: sview, operator: sview, left: usize, right: usize, auxiliary: usize, children_start: usize, children_count: usize, value: i64, name: sview, secondary_name: sview) -> usize:
            return nodes.count if nodes.count >= PROOF_KERNEL_NODE_BUDGET
            index: usize = nodes.count
            nodes.push(ProofKernelNode{kind: kind, operator: operator, left: left, right: right, auxiliary: auxiliary, children_start: children_start, children_count: children_count, value: value, name: name, secondary_name: secondary_name})
            return index


        def root_valid(node_count: usize, root: usize) -> bool:
            ensure result == (root < node_count)
            return root < node_count

        def range_valid(start: usize, count: usize, total: usize) -> bool:
            requires start <= total and count <= total - start
            ensure result == (start <= total and count <= total - start)
            return start <= total and count <= total - start

        def depth_valid(depth: usize) -> bool:
            # Keep the verified core contract literal: the source prover does not
            # unfold module constants in arithmetic postconditions yet. Callers use
            # PROOF_KERNEL_AST_DEPTH_LIMIT for their fail-closed traversal guards.
            ensure result == (depth < 128)
            return depth < 128
