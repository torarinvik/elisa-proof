extend ElisaProof:
    private:
        def proof_source_literal_candidate_work_charge(amount: usize, work: mutable usize&) -> bool:
            return false if work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or amount > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
            work <- work + amount
            true

        def proof_source_literal_ensure_candidate_with_work(declaration: Ast::Decl, source_work: mutable usize&, complete: mutable bool&) -> (known: bool, name: sview, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool):
            complete <- true
            match declaration:
                Ast::Decl.Func(name, parameters, _, body, _, _, _):
                    return (false, "", 0, 0, 0, "", false, false) if body.count < 2
                    has_ensure: mutable bool = false
                    has_return: mutable bool = false
                    contract_value: mutable i64 = 0
                    returned_value: mutable i64 = 0
                    returned_parameter: mutable sview = ""
                    result_on_left: mutable bool = false
                    contract_line: mutable u32 = 0
                    equality_postcondition: mutable bool = false
                    for statement in body |has_ensure, has_return, contract_value, returned_value, returned_parameter, result_on_left, contract_line, equality_postcondition, source_work, complete|:
                        if not proof_source_literal_candidate_work_charge(1, source_work):
                            complete <- false
                            return (false, "", 0, 0, 0, "", false, false)
                        match statement:
                            Ast::Stmt.Contract(kind, expression, position):
                                if not proof_source_literal_candidate_work_charge(sview_len(kind), source_work):
                                    complete <- false
                                    return (false, "", 0, 0, 0, "", false, false)
                                if kind == "requires":
                                    return (false, "", 0, 0, 0, "", false, false) if has_ensure or has_return
                                    pass
                                else:
                                    return (false, "", 0, 0, 0, "", false, false) if (kind != "ensure" and kind != "ensures") or has_ensure or has_return
                                    match expression:
                                        Ast::Expr.BoolLit(value, _):
                                            return (false, "", 0, 0, 0, "", false, false) if not value
                                        Ast::Expr.Binary(Ast::Expr.Ident("result", _), TokenKind.EqEq, Ast::Expr.IntLit(expected, _), _):
                                            equality_postcondition <- true
                                            result_on_left <- true
                                            contract_value <- expected
                                        Ast::Expr.Binary(Ast::Expr.IntLit(expected, _), TokenKind.EqEq, Ast::Expr.Ident("result", _), _):
                                            equality_postcondition <- true
                                            contract_value <- expected
                                        _:
                                            return (false, "", 0, 0, 0, "", false, false)
                                    contract_line <- position.line
                                    has_ensure <- true
                            Ast::Stmt.Return(value, _):
                                return (false, "", 0, 0, 0, "", false, false) if has_return
                                match value:
                                    Ast::Expr.IntLit(returned, _):
                                        has_return <- true
                                        returned_value <- returned
                                    Ast::Expr.Ident(returned, _):
                                        if not proof_source_literal_candidate_work_charge(sview_len(returned), source_work):
                                            complete <- false
                                            return (false, "", 0, 0, 0, "", false, false)
                                        parameter_count: mutable usize = 0
                                        for parameter in parameters |parameter_count, source_work, complete|:
                                            if not proof_source_literal_candidate_work_charge(1, source_work) or not proof_source_literal_candidate_work_charge(sview_len(parameter.name), source_work) or not proof_source_literal_candidate_work_charge(sview_len(returned), source_work):
                                                complete <- false
                                                return (false, "", 0, 0, 0, "", false, false)
                                            parameter_count <- parameter_count + 1 if parameter.name == returned
                                        return (false, "", 0, 0, 0, "", false, false) if parameter_count != 1
                                        has_return <- true
                                        returned_parameter <- returned
                                    _:
                                        return (false, "", 0, 0, 0, "", false, false)
                            _:
                                return (false, "", 0, 0, 0, "", false, false)
                    return (has_ensure and has_return, name, contract_line, contract_value, returned_value, returned_parameter, result_on_left, equality_postcondition)
                _:
                    return (false, "", 0, 0, 0, "", false, false)
