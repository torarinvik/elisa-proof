# Source metadata only. Native declarations have no executable proof summary.
extend ElisaProof:
    public:
        struct ProofExternSignature:
            name: sview
            line: u32
            callable: bool
            variadic: bool
            return_type_name: sview
            # Head/qualifier metadata is not a full return-shape or lifetime proof.
            return_metadata_valid: bool
            return_reference: bool
            return_optional: bool
            return_mutable: bool
            declared_arity: usize
            parameters_valid: bool
            parameters: darray[Ast::ExternParam]
            # Retained source metadata, never an executable resource summary.
            decorators_valid: bool
            decorators: darray[Ast::Annotation]
            decorator_arguments: darray[sview]
            # Native declarations are specifications, not verified bodies.
            contracts_valid: bool
            requires_clauses: darray[Ast::Expr]
            ensures_clauses: darray[Ast::Expr]
            effects_complete: bool
            effects: darray[sview]
