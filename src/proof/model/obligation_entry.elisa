# Stable ordinal identity for one proof_obligation accounting event. Goal attempts are
# only a subset of events, so the ledger owns its own identity and preserves unsupported
# checks that have no extracted goal.
extend ElisaProof:
    public:
        struct ProofObligationEntry:
            identity: usize
            attempts_start: usize
            attempts_count: usize
            proven: bool
            source_line: mutable u32
            source_name: mutable sview
            source_kind: mutable sview
            source_function_offset: mutable u32
            source_obligation_index: mutable usize
            owner_function_line: mutable u32
            owner_function_offset: mutable u32
            source_call_position: mutable Ast::Pos
            source_call_callee_name: mutable sview
            source_call_callee_module: mutable sview
            source_call_callee_line: mutable u32
            source_call_callee_offset: mutable u32
            source_call_requires_index: mutable usize
