# Legacy report diagnostic; checked-view admission owns source-positive status.
extend ElisaProof:
    public:
        def proof_report_source_has_unresolved_checks(report: ProofReport&, import_failed: bool, semantic_errors: u32) -> bool:
            has_open_goal: mutable bool = false
            return true if proof_report_source_admission_failure(report, &has_open_goal) != ""
            return true if import_failed or semantic_errors > 0 or report.results.failed > 0
            return true if not proof_report_all_obligations_proven(report) or has_open_goal
            return false
