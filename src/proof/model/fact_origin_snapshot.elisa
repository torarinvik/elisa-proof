# Presentation-only snapshot for one cached fact origin. Reports expose mutable arrays,
# so an index into `records` is not enough to keep an origin valid after replay. The
# current fact, selected trace expression, and returned metadata must still match this
# replay-time snapshot before output reuses the cache.
extend ElisaProof:
    public:
        struct ProofFactOriginSnapshot:
            expression: Ast::Expr = Ast::Expr.Absent
            trace_index: usize = 0
            kind: sview = ""
            line: u32 = 0
            name: sview = ""
            dependency: sview = ""
            premises_count: usize = 0
