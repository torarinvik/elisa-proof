# Immutable source-derived structural replay indexes shared by all owners in one validation.
extend ElisaProof:
    public:
        struct ProofReplayStructuralSourceEntry:
            name: sview
            declaration: Ast::Decl
            lemma: bool

        struct ProofReplayStructuralSourceIndex:
            entries: mutable darray[ProofReplayStructuralSourceEntry] = []
            hashes: mutable darray[u32] = []
            slots: mutable darray[usize] = []
            ambiguous: mutable darray[bool] = []

        struct ProofReplayStructuralSourceGraph:
            declarations: mutable darray[Ast::Decl] = []
            node_by_source_entry: mutable darray[usize] = []
            direct_extern_contract_unsafe: mutable darray[bool] = []
            reachable_extern_contract_unsafe: mutable darray[bool] = []
            component_ids: mutable darray[usize] = []
            out_starts: mutable darray[usize] = []
            out_counts: mutable darray[usize] = []
            out_targets: mutable darray[usize] = []
            reverse_starts: mutable darray[usize] = []
            reverse_counts: mutable darray[usize] = []
            reverse_targets: mutable darray[usize] = []
            edge_sources: mutable darray[usize] = []
            edge_hashes: mutable darray[u32] = []
            edge_slots: mutable darray[usize] = []
