# Bounded name-to-goal-attempt index used by source literal coverage.
extend ElisaProof:
    private:
        struct ProofGoalAttemptNameIndex:
            slot_values: mutable darray[usize] = []
            hashes: mutable darray[u32] = []
            names: mutable darray[sview] = []
            head_attempts: mutable darray[usize] = []
            next_attempts: mutable darray[usize] = []
            valid: bool = false

        def proof_goal_attempt_name_index_create(report: ProofReport&, source_work: mutable usize&) -> ProofGoalAttemptNameIndex can[Memory.Allocate]:
            attempt_count: usize = report.results.goal_attempts.count
            index: mutable ProofGoalAttemptNameIndex = ProofGoalAttemptNameIndex{valid: true}
            return index if attempt_count == 0
            return ProofGoalAttemptNameIndex{} if attempt_count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 4
            target_capacity: usize = attempt_count * 2
            capacity: mutable usize = 1
            while capacity < target_capacity |capacity, target_capacity|:
                return ProofGoalAttemptNameIndex{} if capacity > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 4
                capacity <- capacity * 2
            return ProofGoalAttemptNameIndex{} if:
                not proof_report_source_postcondition_work_charge(capacity, source_work)
                not proof_report_source_postcondition_work_charge(capacity, source_work)
                not proof_report_source_postcondition_work_charge(capacity, source_work)
                not proof_report_source_postcondition_work_charge(attempt_count, source_work)
                not proof_report_source_postcondition_work_charge(attempt_count, source_work)
            index.slot_values.resize(capacity)
            index.hashes.resize(capacity)
            index.next_attempts.resize(attempt_count)
            for slot in 0..<capacity |slot, index, capacity|:
                index.slot_values[slot] <- capacity
            for attempt_id in 0..<attempt_count |attempt_id, index, attempt_count|:
                index.next_attempts[attempt_id] <- attempt_count
            for attempt_id in 0..<attempt_count |attempt_id, report, index, capacity, attempt_count, source_work|:
                attempt: ProofGoalAttempt = report.results.goal_attempts[attempt_id]
                return ProofGoalAttemptNameIndex{} if:
                    not proof_report_source_postcondition_work_charge(1, source_work)
                    not proof_report_source_postcondition_work_charge(sview_len(attempt.rule), source_work)
                continue if attempt.rule != "goal"
                key: ProofSourcePostconditionKey = ProofSourcePostconditionKey{name: attempt.name, function_offset: 0, line: 0, source_index: 0}
                hashed: (complete: bool, hash: u32) = proof_report_source_postcondition_hash(key, source_work)
                return ProofGoalAttemptNameIndex{} if not hashed.complete
                slot: mutable usize = (hashed.hash.i64() % capacity.i64()).usize()
                probes: mutable usize = 0
                while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, hashed, attempt, attempt_id, index, capacity, attempt_count, source_work|:
                    return ProofGoalAttemptNameIndex{} if not proof_report_source_postcondition_work_charge(1, source_work)
                    current: usize = index.slot_values[slot]
                    if current == capacity:
                        row: usize = index.names.count
                        index.names.push(attempt.name)
                        index.head_attempts.push(attempt_id)
                        index.hashes[slot] <- hashed.hash
                        index.slot_values[slot] <- row
                        break
                    return ProofGoalAttemptNameIndex{} if current >= index.names.count or current >= index.head_attempts.count
                    if index.hashes[slot] == hashed.hash:
                        return ProofGoalAttemptNameIndex{} if not proof_report_source_postcondition_work_charge(sview_len(attempt.name), source_work)
                        if index.names[current] == attempt.name:
                            index.next_attempts[attempt_id] <- index.head_attempts[current]
                            index.head_attempts[current] <- attempt_id
                            break
                    slot <- (slot + 1) % capacity
                    probes <- probes + 1
                return ProofGoalAttemptNameIndex{} if probes >= capacity or probes > PROOF_NAME_INDEX_MAX_CLUSTER
            return index

        def proof_goal_attempt_name_index_find(index: ProofGoalAttemptNameIndex, name: sview, source_work: mutable usize&) -> (complete: bool, found: bool, row: usize):
            missing: usize = index.names.count
            capacity: usize = index.slot_values.count
            return (false, false, missing) if not index.valid or index.slot_values.count != index.hashes.count
            return (true, false, missing) if capacity == 0 or name == ""
            key: ProofSourcePostconditionKey = ProofSourcePostconditionKey{name: name, function_offset: 0, line: 0, source_index: 0}
            hashed: (complete: bool, hash: u32) = proof_report_source_postcondition_hash(key, source_work)
            return (false, false, missing) if not hashed.complete
            slot: mutable usize = (hashed.hash.i64() % capacity.i64()).usize()
            probes: mutable usize = 0
            while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, hashed, name, index, capacity, source_work|:
                return (false, false, missing) if not proof_report_source_postcondition_work_charge(1, source_work)
                current: usize = index.slot_values[slot]
                return (true, false, missing) if current == capacity
                return (false, false, missing) if current >= index.names.count or current >= index.head_attempts.count
                if index.hashes[slot] == hashed.hash:
                    return (false, false, missing) if not proof_report_source_postcondition_work_charge(sview_len(name), source_work)
                    return (true, true, current) if index.names[current] == name
                slot <- (slot + 1) % capacity
                probes <- probes + 1
            return (false, false, missing)
