extend ElisaProof:
    private:
        # `proof_expr_mentions_name` compares each visited identifier with the full target
        # spelling. Reserve the AST walk multiplied by that comparison width before scanning.
        def proof_checked_access_alias_mentions_name_with_work(expression: Ast::Expr, target: sview, work: mutable usize&) -> (complete: bool, mentions: bool):
            return (false, false) if work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            if expression is Ast::Expr.Invalid:
                return (false, false) if not proof_report_source_work_charge(1, work)
                return (true, true)
            cost: mutable usize = 0
            if not proof_replay_summary_expr_cost_with_limit(expression, &cost, work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT):
                work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                return (false, false)
            target_length: usize = sview_len(target)
            return (false, false) if target_length >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            multiplier: usize = target_length + 1
            remaining: usize = PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work
            if cost > remaining / multiplier:
                work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                return (false, false)
            work <- work + cost * multiplier
            (true, proof_expr_mentions_name(expression, target))
