# Bind generic-bound, generic identity, and alias-formal annotations to the parser-owned source
# snapshot. A deleted or rewritten report row cannot weaken replay guards or alter alias expansion.
extend ElisaProof:
    private:
        def proof_source_generic_bound_charge(amount: usize, source_work: mutable usize&) -> bool:
            limit: usize = proof_replay_summary_source_work_limit()
            return false if source_work > limit
            if amount > limit - source_work:
                source_work <- limit + 1
                return false
            source_work <- source_work + amount
            return true

        # The generic parameter side tables also contain non-function declarations and
        # high-bit bound rows. Marker-to-row replay census intentionally filters some of those
        # cases, so bind the complete parallel arrays directly to the retained parser result.
        def proof_source_generic_param_snapshot_matches[@r](source: ProofSourceAnalysis[r]& @r, report: ProofReport&, source_work: mutable usize&) -> bool:
            expected_lines: darray[u32]& = source.file.generic_param_lines
            expected_names: darray[sview]& = source.file.generic_param_names
            expected_offsets: darray[u32]& = source.file.generic_param_owner_offsets
            actual_lines: darray[u32]& = report.source_types.source_generic_param_lines
            actual_names: darray[sview]& = report.source_types.source_generic_param_names
            actual_offsets: darray[u32]& = report.source_types.source_generic_param_owner_offsets
            return false if not proof_source_generic_bound_charge(6, source_work)
            return false if:
                expected_lines.count != expected_names.count or expected_lines.count != expected_offsets.count
                expected_lines.count != actual_lines.count or expected_lines.count != actual_names.count or expected_lines.count != actual_offsets.count
            for row in 0..<expected_lines.count |row, expected_lines, expected_names, expected_offsets, actual_lines, actual_names, actual_offsets, source_work|:
                expected_name: sview = expected_names[row]
                actual_name: sview = actual_names[row]
                return false if not proof_source_generic_bound_charge(6 + sview_len(expected_name) + sview_len(actual_name), source_work)
                return false if expected_lines[row] != actual_lines[row] or expected_names[row] != actual_name or expected_offsets[row] != actual_offsets[row]
            return true

        def proof_source_generic_bound_annotations_payload_match[@r](source: ProofSourceAnalysis[r]& @r, report: ProofReport&, source_work: mutable usize&) -> bool:
            expected: darray[Ast::EnumAnnotation]& = source.file.enum_annotations
            actual: darray[Ast::EnumAnnotation]& = report.source.source_annotations
            expected_row: mutable usize = 0
            actual_row: mutable usize = 0
            while true:
                while expected_row < expected.count:
                    expected_annotation: Ast::EnumAnnotation = expected[expected_row]
                    return false if not proof_source_generic_bound_charge(1, source_work) or not proof_source_generic_bound_charge(sview_len(expected_annotation.owner), source_work)
                    break if expected_annotation.line == 3900000130 or expected_annotation.line == 3900000131 or expected_annotation.owner == "__alias_owner"
                    expected_row <- expected_row + 1
                while actual_row < actual.count:
                    actual_annotation: Ast::EnumAnnotation = actual[actual_row]
                    return false if not proof_source_generic_bound_charge(1, source_work) or not proof_source_generic_bound_charge(sview_len(actual_annotation.owner), source_work)
                    break if actual_annotation.line == 3900000130 or actual_annotation.line == 3900000131 or actual_annotation.owner == "__alias_owner"
                    actual_row <- actual_row + 1
                expected_found: bool = expected_row < expected.count
                actual_found: bool = actual_row < actual.count
                return not expected_found and not actual_found if not expected_found or not actual_found
                expected_annotation: Ast::EnumAnnotation = expected[expected_row]
                actual_annotation: Ast::EnumAnnotation = actual[actual_row]
                return false if not proof_source_generic_bound_charge(2, source_work)
                return false if:
                    not proof_source_generic_bound_charge(sview_len(expected_annotation.owner), source_work)
                    not proof_source_generic_bound_charge(sview_len(expected_annotation.name), source_work)
                    not proof_source_generic_bound_charge(sview_len(expected_annotation.module), source_work)
                    not proof_source_generic_bound_charge(sview_len(expected_annotation.detail_name), source_work)
                    not proof_source_generic_bound_charge(sview_len(actual_annotation.owner), source_work)
                    not proof_source_generic_bound_charge(sview_len(actual_annotation.name), source_work)
                    not proof_source_generic_bound_charge(sview_len(actual_annotation.module), source_work)
                    not proof_source_generic_bound_charge(sview_len(actual_annotation.detail_name), source_work)
                return false if:
                    expected_annotation.owner != actual_annotation.owner or expected_annotation.name != actual_annotation.name
                    expected_annotation.line != actual_annotation.line or expected_annotation.detail_line != actual_annotation.detail_line
                    expected_annotation.module != actual_annotation.module or expected_annotation.identity_id != actual_annotation.identity_id
                    expected_annotation.offset != actual_annotation.offset or expected_annotation.detail_name != actual_annotation.detail_name
                    expected_annotation.arg_start != actual_annotation.arg_start or expected_annotation.arg_count != actual_annotation.arg_count
                    expected_annotation.pos.line != actual_annotation.pos.line or expected_annotation.pos.column != actual_annotation.pos.column
                    expected_annotation.pos.offset != actual_annotation.pos.offset or expected_annotation.pos.end_line != actual_annotation.pos.end_line
                    expected_annotation.pos.end_column != actual_annotation.pos.end_column or expected_annotation.pos.end_offset != actual_annotation.pos.end_offset
                expected_arg_start: usize = expected_annotation.arg_start.usize()
                expected_arg_count: usize = expected_annotation.arg_count.usize()
                actual_arg_start: usize = actual_annotation.arg_start.usize()
                actual_arg_count: usize = actual_annotation.arg_count.usize()
                expected_args: darray[sview]& = source.file.annotation_args
                actual_args: darray[sview]& = report.source.source_annotation_args
                return false if:
                    expected_arg_start > expected_args.count or expected_arg_count > expected_args.count - expected_arg_start
                    actual_arg_start > actual_args.count or actual_arg_count > actual_args.count - actual_arg_start
                    expected_arg_count != actual_arg_count
                for arg_index in 0..<expected_arg_count |arg_index, expected_args, actual_args, expected_arg_start, actual_arg_start, source_work|:
                    expected_argument: sview = expected_args[expected_arg_start + arg_index]
                    actual_argument: sview = actual_args[actual_arg_start + arg_index]
                    return false if:
                        not proof_source_generic_bound_charge(2, source_work)
                        not proof_source_generic_bound_charge(sview_len(expected_argument), source_work)
                        not proof_source_generic_bound_charge(sview_len(actual_argument), source_work)
                        expected_argument != actual_argument
                expected_row <- expected_row + 1
                actual_row <- actual_row + 1
            return true
