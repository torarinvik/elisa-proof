# Bind every source annotation and its argument table to the parser-owned snapshot. Replay uses
# these rows for quantifiers, generic identities, aliases, imports, externs, and effect metadata.
# A deleted, inserted, reordered, or rewritten report row cannot change those source meanings.
extend ElisaProof:
    private:
        def proof_source_snapshot_charge(amount: usize, source_work: mutable usize&) -> bool:
            limit: usize = proof_replay_summary_source_work_limit()
            return false if source_work > limit
            if amount > limit - source_work:
                source_work <- limit + 1
                return false
            source_work <- source_work + amount
            return true

        # The generic parameter side tables also contain non-function declarations and
        # high-bit bound rows. Marker-to-row replay census intentionally filters some of those
        # cases, so bind the complete parallel arrays directly to the retained parser result.
        def proof_source_generic_param_snapshot_matches[@r](source: ProofSourceAnalysis[r]& @r, report: ProofReport&, source_work: mutable usize&) -> bool:
            expected_lines: darray[u32]& = source.file.generic_param_lines
            expected_names: darray[sview]& = source.file.generic_param_names
            expected_offsets: darray[u32]& = source.file.generic_param_owner_offsets
            actual_lines: darray[u32]& = report.source_types.source_generic_param_lines
            actual_names: darray[sview]& = report.source_types.source_generic_param_names
            actual_offsets: darray[u32]& = report.source_types.source_generic_param_owner_offsets
            return false if not proof_source_snapshot_charge(6, source_work)
            return false if:
                expected_lines.count != expected_names.count or expected_lines.count != expected_offsets.count
                expected_lines.count != actual_lines.count or expected_lines.count != actual_names.count or expected_lines.count != actual_offsets.count
            for row in 0..<expected_lines.count |row, expected_lines, expected_names, expected_offsets, actual_lines, actual_names, actual_offsets, source_work|:
                expected_name: sview = expected_names[row]
                actual_name: sview = actual_names[row]
                return false if not proof_source_snapshot_charge(6, source_work)
                return false if not proof_source_snapshot_charge(sview_len(expected_name), source_work)
                return false if not proof_source_snapshot_charge(sview_len(actual_name), source_work)
                return false if expected_lines[row] != actual_lines[row] or expected_names[row] != actual_name or expected_offsets[row] != actual_offsets[row]
            return true

        def proof_source_annotations_snapshot_matches[@r](source: ProofSourceAnalysis[r]& @r, report: ProofReport&, source_work: mutable usize&) -> bool:
            expected: darray[Ast::EnumAnnotation]& = source.file.enum_annotations
            actual: darray[Ast::EnumAnnotation]& = report.source.source_annotations
            expected_args: darray[sview]& = source.file.annotation_args
            actual_args: darray[sview]& = report.source.source_annotation_args
            return false if not proof_source_snapshot_charge(4, source_work)
            return false if expected.count != actual.count or expected_args.count != actual_args.count
            for row in 0..<expected.count |row, expected, actual, source_work|:
                expected_annotation: Ast::EnumAnnotation = expected[row]
                actual_annotation: Ast::EnumAnnotation = actual[row]
                return false if not proof_source_snapshot_charge(2, source_work)
                return false if:
                    not proof_source_snapshot_charge(sview_len(expected_annotation.owner), source_work)
                    not proof_source_snapshot_charge(sview_len(expected_annotation.name), source_work)
                    not proof_source_snapshot_charge(sview_len(expected_annotation.module), source_work)
                    not proof_source_snapshot_charge(sview_len(expected_annotation.detail_name), source_work)
                    not proof_source_snapshot_charge(sview_len(actual_annotation.owner), source_work)
                    not proof_source_snapshot_charge(sview_len(actual_annotation.name), source_work)
                    not proof_source_snapshot_charge(sview_len(actual_annotation.module), source_work)
                    not proof_source_snapshot_charge(sview_len(actual_annotation.detail_name), source_work)
                return false if:
                    expected_annotation.owner != actual_annotation.owner or expected_annotation.name != actual_annotation.name
                    expected_annotation.line != actual_annotation.line or expected_annotation.detail_line != actual_annotation.detail_line
                    expected_annotation.module != actual_annotation.module or expected_annotation.identity_id != actual_annotation.identity_id
                    expected_annotation.offset != actual_annotation.offset or expected_annotation.detail_name != actual_annotation.detail_name
                    expected_annotation.arg_start != actual_annotation.arg_start or expected_annotation.arg_count != actual_annotation.arg_count
                    expected_annotation.pos.line != actual_annotation.pos.line or expected_annotation.pos.column != actual_annotation.pos.column
                    expected_annotation.pos.offset != actual_annotation.pos.offset or expected_annotation.pos.end_line != actual_annotation.pos.end_line
                    expected_annotation.pos.end_column != actual_annotation.pos.end_column or expected_annotation.pos.end_offset != actual_annotation.pos.end_offset
            for row in 0..<expected_args.count |row, expected_args, actual_args, source_work|:
                expected_argument: sview = expected_args[row]
                actual_argument: sview = actual_args[row]
                return false if not proof_source_snapshot_charge(2, source_work)
                return false if not proof_source_snapshot_charge(sview_len(expected_argument), source_work)
                return false if not proof_source_snapshot_charge(sview_len(actual_argument), source_work)
                return false if expected_argument != actual_argument
            return true

        # Resource lifetimes are parsed into a dedicated side table, not the enum-annotation
        # table. Bind the replay copy to that exact parser result before trusting resource-safety
        # formal lifetime markers.
        def proof_source_local_region_annotations_snapshot_matches[@r](source: ProofSourceAnalysis[r]& @r, report: ProofReport&, source_work: mutable usize&) -> bool:
            expected: darray[Ast::EnumAnnotation]& = source.file.local_region_annotations
            actual: darray[Ast::EnumAnnotation]& = report.source.source_local_region_annotations
            return false if not proof_source_snapshot_charge(2, source_work)
            return false if expected.count != actual.count
            for row in 0..<expected.count |row, expected, actual, source_work|:
                expected_annotation: Ast::EnumAnnotation = expected[row]
                actual_annotation: Ast::EnumAnnotation = actual[row]
                return false if not proof_source_snapshot_charge(2, source_work)
                return false if:
                    not proof_source_snapshot_charge(sview_len(expected_annotation.name), source_work)
                    not proof_source_snapshot_charge(sview_len(expected_annotation.region), source_work)
                    not proof_source_snapshot_charge(sview_len(actual_annotation.name), source_work)
                    not proof_source_snapshot_charge(sview_len(actual_annotation.region), source_work)
                    expected_annotation.name != actual_annotation.name
                    expected_annotation.region != actual_annotation.region
                    expected_annotation.line != actual_annotation.line
            return true
