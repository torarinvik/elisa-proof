# Scratch derived from one report's source snapshot during certificate replay.
extend ElisaProof:
    public:
        struct ProofReplayDeterministicDeclarationEntry:
            name: sview
            declaration: Ast::Decl
            owner: sview
            is_function: bool
            next_index: usize
            is_lemma: bool = false
            module_prefix: usize = 0
            declaration_path_start: usize = 0
            declaration_path_count: usize = 0
            # Positive-only memo: set after this function and every reachable call fully validate.
            validated_deterministic_call: mutable bool = false

        struct ProofReplayDeterministicDeclarationIndex:
            entries: mutable darray[ProofReplayDeterministicDeclarationEntry] = []
            declaration_path: mutable darray[usize] = []
            lemma_names: mutable darray[sview] = []
            lemma_hashes: mutable darray[u32] = []
            lemma_slots: mutable darray[usize] = []
            lemma_missing: mutable usize = 0
            lemma_index_valid: mutable bool = false
            hashes: mutable darray[u32] = []
            heads: mutable darray[usize] = []
            counts: mutable darray[usize] = []
            valid: mutable bool = false

        struct ProofReplayDeterministicCastSiteOwner:
            owner: sview
            owner_line: u32
            trace_owner_line: u32
            key_hash: u32
            sites_start: usize
            sites_count: usize
            complete: bool

        struct ProofReplayDeterministicCallReplayCache:
            declaration_index: mutable ProofReplayDeterministicDeclarationIndex = ProofReplayDeterministicDeclarationIndex{}
            declaration_index_attempted: mutable bool = false
            alias_index: mutable ProofModuleAliasIndex = ProofModuleAliasIndex{names: [], targets: [], scopes: [], lines: [], offsets: [], alias_lookup_hashes: [], alias_lookup_values: [], alias_lookup_ambiguous: [], global_alias_lookup_hashes: [], global_alias_lookup_values: [], function_lookup_hashes: [], function_lookup_values: [], function_lookup_ambiguous: [], function_lookup_complete: false, complete: false}
            alias_index_attempted: mutable bool = false
            alias_imports_checked: mutable bool = false
            alias_imports_supported: mutable bool = false
            cast_site_owners: mutable darray[ProofReplayDeterministicCastSiteOwner] = []
            cast_site_owner_bucket_values: mutable darray[usize] = []
            cast_site_owner_bucket_occupied: mutable darray[bool] = []
            cast_site_owner_index_valid: mutable bool = false
            cast_sites: mutable darray[Ast::Expr] = []
            analysis_context_attempted: mutable bool = false
            analysis_context_valid: mutable bool = false
            analysis_scratch: mutable ProofReport = ProofReport{}

        # Per-name linked rows for dependency admission. Every report row is retained, including
        # duplicate spellings; head/tail chains preserve original row order and exact row IDs.
        struct ProofReplayDependencyRowIndex:
            names: mutable darray[sview] = []
            hashes: mutable darray[u32] = []
            heads: mutable darray[usize] = []
            tails: mutable darray[usize] = []
            next_indices: mutable darray[usize] = []
            complete: mutable bool = false

        # The owner hash selects one ordered linked list of structural certificates, so
        # source replay does not rescan every unrelated report certificate for each owner.
        struct ProofReplayStructuralCertificateOwner:
            name: sview
            head: usize
            last_index: usize
            count: usize
            source_validated: mutable bool

        struct ProofReplayStructuralCertificateIndex:
            owners: mutable darray[ProofReplayStructuralCertificateOwner] = []
            hashes: mutable darray[u32] = []
            slots: mutable darray[usize] = []
            certificate_indices: mutable darray[usize] = []
            next_indices: mutable darray[usize] = []
            complete: mutable bool = false

        # Reverse rows from each certificate to its candidate proven goal attempts. Building
        # this once prevents certificate replay from rescanning every attempt for every root.
        struct ProofReplayCertificateAttemptIndex:
            heads: mutable darray[usize] = []
            next_indices: mutable darray[usize] = []
            certificate_count: usize = 0
            attempt_count: usize = 0

        struct ProofReplayStructuralValidationCache:
            initialized: mutable bool = false
            complete: mutable bool = false
            certificate_attempt_index_attempted: mutable bool = false
            certificate_attempt_index_complete: mutable bool = false
            certificate_attempt_index: mutable ProofReplayCertificateAttemptIndex = ProofReplayCertificateAttemptIndex{}
            source_index: mutable ProofReplayStructuralSourceIndex = ProofReplayStructuralSourceIndex{}
            certificate_index: mutable ProofReplayStructuralCertificateIndex = ProofReplayStructuralCertificateIndex{}
            enum_index: mutable ProofEnumIndex = ProofEnumIndex{names: [], name_hashes: [], const_enums: [], declarations: [], root_level: [], bucket_heads: [], next_indices: [], complete: false}
            graph: mutable ProofReplayStructuralSourceGraph = ProofReplayStructuralSourceGraph{}
            scratch: mutable ProofReport = ProofReport{}
            deterministic_calls: mutable ProofReplayDeterministicCallReplayCache = ProofReplayDeterministicCallReplayCache{}
            dependency_indexes_attempted: mutable bool = false
            dependency_indexes_complete: mutable bool = false
            dependency_attempt_rows: mutable ProofReplayDependencyRowIndex = ProofReplayDependencyRowIndex{}
            dependency_finding_rows: mutable ProofReplayDependencyRowIndex = ProofReplayDependencyRowIndex{}
            dependency_certificate_index_attempted: mutable bool = false
            dependency_certificate_index_complete: mutable bool = false
            dependency_certificate_rows: mutable ProofReplayDependencyRowIndex = ProofReplayDependencyRowIndex{}
