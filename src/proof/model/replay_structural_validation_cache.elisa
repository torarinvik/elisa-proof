# Scratch derived from one report's source snapshot during certificate replay.
extend ElisaProof:
    public:
        struct ProofReplayStructuralValidationCache:
            initialized: mutable bool = false
            complete: mutable bool = false
            source_index: mutable ProofReplayStructuralSourceIndex = ProofReplayStructuralSourceIndex{}
            enum_index: mutable ProofEnumIndex = ProofEnumIndex{names: [], name_hashes: [], bucket_heads: [], next_indices: [], complete: false}
            graph: mutable ProofReplayStructuralSourceGraph = ProofReplayStructuralSourceGraph{}
            scratch: mutable ProofReport = ProofReport{}
