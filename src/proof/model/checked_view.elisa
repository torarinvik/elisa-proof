# Source-bound, report-bound capability exposed to output clients. The source analysis is
# captured once from parser-owned declarations; replay binds that analysis and its report into
# one opaque checked view.
extend ElisaProof:
    public:
        # Sanitized accounting data for diagnostics. This deliberately does not expose
        # ProofObligationEntry or provide a proof verdict.
        struct ProofCheckedViewObligationDiagnostic[@r]:
            identity: usize
            attempts_start: usize
            attempts_count: usize
            source_kind: sview
            producer_claim: bool

    private:
        def proof_source_analysis_charge_work(amount: usize, source_work: mutable usize&) -> bool:
            source_work_limit: usize = proof_replay_summary_source_work_limit()
            return false if source_work > source_work_limit
            if amount > source_work_limit - source_work:
                source_work <- source_work_limit + 1
                return false
            source_work <- source_work + amount
            true

        # Signature contracts live outside the declaration AST body, so source-obligation
        # coverage must authenticate the report's parallel contract table against the frozen
        # parser result before using it to enumerate expected postconditions.
        def proof_source_signature_contract_snapshot_matches[@r](source: ProofSourceAnalysis[r]& @r, report: ProofReport&, source_work: mutable usize&) -> bool:
            file: Ast::File& = source.file
            expected_count: usize = file.signature_contract_lines.count
            return false if:
                expected_count != file.signature_contract_kinds.count or expected_count != file.signature_contract_exprs.count
                expected_count != report.source_contracts.source_signature_contract_lines.count
                expected_count != report.source_contracts.source_signature_contract_kinds.count
                expected_count != report.source_contracts.source_signature_contracts.count
            for row in 0..<expected_count |row, file, report, source_work|:
                expected: Ast::Expr = file.signature_contract_exprs[row]
                actual: Ast::Expr = report.source_contracts.source_signature_contracts[row]
                expected_cost: mutable usize = 0
                actual_cost: mutable usize = 0
                return false if:
                    not proof_replay_summary_expr_cost(expected, &expected_cost, source_work, 0)
                    not proof_replay_summary_expr_cost(actual, &actual_cost, source_work, 0)
                    expected_cost > proof_replay_summary_source_work_limit() / 3
                    actual_cost > proof_replay_summary_source_work_limit() / 3
                    not proof_source_analysis_charge_work(1 + sview_len(file.signature_contract_kinds[row]) + expected_cost * 3 + actual_cost * 3, source_work)
                    file.signature_contract_lines[row] != report.source_contracts.source_signature_contract_lines[row]
                    file.signature_contract_kinds[row] != report.source_contracts.source_signature_contract_kinds[row]
                    not proof_expr_equal(expected, actual)
                    Ast::expr_pos(expected).line != Ast::expr_pos(actual).line
                    Ast::expr_pos(expected).offset != Ast::expr_pos(actual).offset
            return true

        # Struct invariants are unsupported by the producer. Admission independently refuses
        # their parser-origin declarations so omitting the producer's refusal finding cannot
        # make a report appear complete.
        def proof_source_struct_invariant_scan(declarations: darray[Ast::Decl]&, source_work: mutable usize&, depth: usize) -> (complete: bool, found: bool):
            return (false, false) if depth >= 96
            for declaration in declarations |source_work, depth|:
                return (false, false) if not proof_source_analysis_charge_work(1, source_work)
                match declaration:
                    Ast::Decl.Struct(_, _, _, _, _, invariants, _):
                        if invariants.count > 0:
                            return (false, false) if not proof_source_analysis_charge_work(invariants.count, source_work)
                            return (true, true)
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        nested_result: (complete: bool, found: bool) = proof_source_struct_invariant_scan(nested, source_work, depth + 1)
                        return nested_result if not nested_result.complete or nested_result.found
                    Ast::Decl.Invalid | Ast::Decl.Func(_, _, _, _, _, _, _) | Ast::Decl.Enum(_, _, _, _, _) | Ast::Decl.Alias(_, _, _) | Ast::Decl.Law(_, _, _) | Ast::Decl.Import(_, _) | Ast::Decl.Extern(_, _, _, _, _, _, _, _) | Ast::Decl.Const(_, _, _, _, _):
                        pass
                    _:
                        return (false, false)
            return (true, false)

        # Build one conservative parser-derived mask. Fail closed if the parser adds a
        # declaration form before its operator-dispatch implications are classified.
        def proof_source_analysis_operator_declaration_mask(declarations: darray[Ast::Decl]&, source_work: mutable usize&, depth: usize, mask: mutable usize&) -> bool:
            return false if depth >= 64
            for declaration in declarations |declaration, source_work, depth, mask|:
                return false if not proof_report_source_work_charge(1, source_work)
                match declaration:
                    Ast::Decl.Module(name, nested, _):
                        return false if not proof_report_source_work_charge(sview_len(name), source_work)
                        return false if not proof_source_analysis_operator_declaration_mask(nested, source_work, depth + 1, mask)
                    Ast::Decl.Scoped(nested, _):
                        return false if not proof_source_analysis_operator_declaration_mask(nested, source_work, depth + 1, mask)
                    Ast::Decl.Func(name, _, _, _, _, _, _) | Ast::Decl.Extern(name, _, _, _, _, _, _, _):
                        return false if not proof_report_source_work_charge(sview_len(name), source_work)
                        mask <- mask | proof_source_operator_dunder_mask(name)
                    Ast::Decl.Import(name, _):
                        return false if not proof_report_source_work_charge(sview_len(name), source_work)
                        mask <- PROOF_SOURCE_OPERATOR_ALL_FLAGS
                    Ast::Decl.Invalid:
                        mask <- PROOF_SOURCE_OPERATOR_ALL_FLAGS
                    Ast::Decl.Const(_, _, _, _, _) | Ast::Decl.Struct(_, _, _, _, _, _, _) | Ast::Decl.Enum(_, _, _, _, _) | Ast::Decl.Alias(_, _, _) | Ast::Decl.Law(_, _, _):
                        pass
                    _:
                        return false
            true

        def proof_source_analysis_operator_mask_from_source(declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, source_work: mutable usize&) -> (complete: bool, mask: usize):
            annotation_shape: (complete: bool, overloaded: bool) = proof_source_primitive_operator_overloaded_with_work(annotations, source_work)
            return (false, PROOF_SOURCE_OPERATOR_ALL_FLAGS) if not annotation_shape.complete
            # Implementation annotations establish scopes, not operator protocols. The
            # compiler dispatches by the matching dunder on a struct receiver, so source-only
            # guards use the retained declarations to deny exactly the protocols present in
            # this source. Receiver typing remains erased here, making the result conservative
            # across custom struct types while preserving unrelated builtin operators.
            mask: mutable usize = PROOF_SOURCE_OPERATOR_MASK_EMPTY
            return (false, PROOF_SOURCE_OPERATOR_ALL_FLAGS) if not proof_source_analysis_operator_declaration_mask(declarations, source_work, 0, &mask)
            generic_bound_mask: (complete: bool, mask: usize) = proof_source_operator_mask_with_generic_bounds(annotations, mask, source_work)
            return (false, PROOF_SOURCE_OPERATOR_ALL_FLAGS) if not generic_bound_mask.complete
            (true, generic_bound_mask.mask)

        def proof_source_analysis_operator_mask(file: Ast::File&, source_work: mutable usize&) -> (complete: bool, mask: usize):
            proof_source_analysis_operator_mask_from_source(file.top_decls, file.enum_annotations, source_work)

        def proof_source_analysis_hash(source: darray[u8]&, source_bytes: usize) -> u32:
            hash: mutable i64 = ElisaProofKernelCore::PROOF_KERNEL_FNV1A_OFFSET_BASIS
            for offset in 0..<source_bytes |offset, source, hash|:
                hash <- ((hash ^ source[offset].i64()) * ElisaProofKernelCore::PROOF_KERNEL_FNV1A_PRIME) % ElisaProofKernelCore::PROOF_KERNEL_HASH_U32_MODULUS
            hash.u32()

    public:
        # The only source-analysis issuer. It imports the root itself, retains the importer's
        # failure result, and reports root-read failure separately so the CLI needs no preflight
        # read. It then tokenizes and parses the exact expanded bytes, freezes direct parser
        # inventories before typed-source augmentation, and captures derived refinement contracts
        # separately before returning an immutable borrow of that AST.
        # Keep both tokens and AST in the caller's arena so every parser-owned borrow remains
        # valid for the full lifetime of the returned capability.
        def proof_source_analysis_import_parse[@r, @files, @line_files, @line_numbers](source_arena: mutable Arena& @r, root_path: darray[u8]&, root_read_failed: mutable bool&, source_files: mutable darray[u8]& @files, source_line_files: mutable darray[u32]& @line_files, source_line_numbers: mutable darray[u32]& @line_numbers, capture_source_map: bool) -> ProofSourceAnalysis[r] can[Memory.Allocate, Memory.Release, Abort.Panic, Global{Read,Write}, Unsafe.PointerCast]:
            in source_arena:
                import_failed: mutable bool = false
                source: mutable darray[u8] = (proof_import_source_mapped(root_path, &import_failed, root_read_failed, source_files, source_line_files, source_line_numbers, capture_source_map) can Global{Read,Write})
                source_bytes: usize = source.count
                source.push(0)
                tokens: mutable darray[Token] = frontend_tokenize_with_length(&source[0], &source[0], source_bytes)
                file: mutable Ast::File = (frontend_parser_parse_file(&source[0], tokens) can Global{Read,Write})
                top_declarations: darray[Ast::Decl] = file.top_decls
                inventory_source_work: mutable usize = 0
                struct_invariant_scan: (complete: bool, found: bool) = proof_source_struct_invariant_scan(top_declarations, &inventory_source_work, 0)
                literal_inventory_status: (inventory: darray[(name: sview, function_offset: u32, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool)], complete: bool, work_limited: bool) = proof_source_literal_ensure_inventory_with_work(top_declarations, &inventory_source_work)
                literal_inventory_complete: bool = literal_inventory_status.complete
                literal_inventory_work_limited: bool = literal_inventory_status.work_limited
                literal_inventory: mutable darray[(name: sview, function_offset: u32, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool)] = literal_inventory_status.inventory
                assert_by_inventory_status: (inventory: darray[(name: sview, function_offset: u32, attempt_line: u32, goal_line: u32, goal_offset: u32, expected_value: bool, source_goal: Ast::Expr, supported: bool)], complete: bool, work_limited: bool) = proof_source_assert_by_inventory_with_work(top_declarations, &inventory_source_work)
                assert_by_inventory_complete: bool = assert_by_inventory_status.complete
                assert_by_inventory_work_limited: bool = assert_by_inventory_status.work_limited
                assert_by_inventory: mutable darray[(name: sview, function_offset: u32, attempt_line: u32, goal_line: u32, goal_offset: u32, expected_value: bool, source_goal: Ast::Expr, supported: bool)] = assert_by_inventory_status.inventory
                proof_push_source_int_types(&file, tokens, source, source_bytes)
                operator_mask_work: mutable usize = 0
                operator_mask_status: (complete: bool, mask: usize) = proof_source_analysis_operator_mask(file, &operator_mask_work)
                refinement_refusals: mutable ProofReport = proof_empty_report()
                refined_functions: mutable darray[sview] = []
                proof_add_refinement_signature_contracts(&file, &refinement_refusals, &refined_functions)
                postcondition_ast_inventory_status: (inventory: darray[(name: sview, function_offset: u32, line: u32, source_index: usize, contract_line: u32, expression: Ast::Expr)], return_inventory: darray[(name: sview, line: u32, offset: u32, supported: bool, expression: Ast::Expr)], complete: bool, work_limited: bool) = proof_source_postcondition_ast_inventory_with_work(top_declarations, file.signature_contract_lines, file.signature_contract_kinds, file.signature_contract_exprs, &inventory_source_work)
                postcondition_ast_inventory_complete: bool = postcondition_ast_inventory_status.complete
                postcondition_ast_inventory_work_limited: bool = postcondition_ast_inventory_status.work_limited
                postcondition_ast_inventory: mutable darray[(name: sview, function_offset: u32, line: u32, source_index: usize, contract_line: u32, expression: Ast::Expr)] = postcondition_ast_inventory_status.inventory
                postcondition_return_inventory_complete: bool = postcondition_ast_inventory_status.complete and not postcondition_ast_inventory_status.work_limited
                postcondition_return_inventory: mutable darray[(name: sview, line: u32, offset: u32, supported: bool, expression: Ast::Expr)] = postcondition_ast_inventory_status.return_inventory
                pass_offsets: mutable darray[u32] = []
                for token in tokens |pass_offsets|:
                    pass_offsets.push(token.start) if token.kind == TokenKind.Pass
                stray_nul_line: u32 = proof_source_stray_nul_line(tokens, source, source_bytes)
                source_identity: uintptr = (&source[0]).cast[uintptr]
                fingerprint: u32 = proof_source_analysis_hash(source, source_bytes)
                analysis: ProofSourceAnalysis[r] = ProofSourceAnalysis{source: source, tokens: tokens, file: file, source_bytes: source_bytes, source_fingerprint: fingerprint, source_identity: source_identity, file_identity: source_identity, import_failed: import_failed, pass_statement_offsets: pass_offsets, stray_nul_line: stray_nul_line, refinement_findings: refinement_refusals.results.findings, refined_functions: refined_functions, source_struct_invariant_scan_complete: struct_invariant_scan.complete, source_has_struct_invariants: struct_invariant_scan.found, source_primitive_operator_mask: operator_mask_status.mask, source_operator_protocol_mask: operator_mask_status.mask, source_operator_masks_valid: operator_mask_status.complete, literal_ensure_inventory: literal_inventory, literal_ensure_inventory_complete: literal_inventory_complete, literal_ensure_inventory_work_limited: literal_inventory_work_limited, postcondition_ast_inventory: postcondition_ast_inventory, postcondition_ast_inventory_complete: postcondition_ast_inventory_complete, postcondition_ast_inventory_work_limited: postcondition_ast_inventory_work_limited, postcondition_return_inventory: postcondition_return_inventory, postcondition_return_inventory_complete: postcondition_return_inventory_complete, assert_by_inventory: assert_by_inventory, assert_by_inventory_complete: assert_by_inventory_complete, assert_by_inventory_work_limited: assert_by_inventory_work_limited, issued: true}
                return analysis

        def proof_source_analysis_import_failed[@r](source: ProofSourceAnalysis[r]& @r) -> bool:
            not source.issued or source.import_failed

        def proof_source_analysis_source[@view](source: ProofSourceAnalysis[view]& @view) -> darray[u8]& @view:
            source.source

    public:
        def proof_source_analysis_stray_nul_line[@r](source: ProofSourceAnalysis[r]& @r) -> u32:
            source.stray_nul_line

        def proof_source_analysis_bytes[@r](source: ProofSourceAnalysis[r]& @r) -> usize:
            source.source_bytes

        def proof_source_analysis_fingerprint[@r](source: ProofSourceAnalysis[r]& @r) -> u32:
            source.source_fingerprint

        def proof_source_analysis_literal_inventory[@view](source: ProofSourceAnalysis[view]& @view) -> darray[(name: sview, function_offset: u32, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool)]& @view:
            source.literal_ensure_inventory

    public:
        def proof_source_analysis_pass_offsets[@view](source: ProofSourceAnalysis[view]& @view) -> darray[u32]& @view:
            source.pass_statement_offsets

        def proof_semantic_diagnostic_counts_with_work(diagnostics: darray[Semantic::Diagnostic]&, report: ProofReport&, source_work: mutable usize&) -> (complete: bool, visible: u32, errors: u32):
            visible: mutable u32 = 0
            errors: mutable u32 = 0
            for diagnostic in diagnostics |visible, errors, report, source_work|:
                if not proof_replay_source_work_charge(1, source_work):
                    source_work <- proof_replay_summary_source_work_limit() + 1
                    return (false, visible, errors)
                diagnostic_visible: mutable bool = true
                if diagnostic.kind == Semantic::DiagnosticKind.AssertByUnproven:
                    diagnostic_visible <- false
                elif diagnostic.kind == Semantic::DiagnosticKind.MutualDecreasesCycle:
                    verified_member: (complete: bool, verified: bool) = proof_structural_verified_member_lookup_with_work(report, diagnostic.name, source_work)
                    if not verified_member.complete:
                        source_work <- proof_replay_summary_source_work_limit() + 1
                        return (false, visible, errors)
                    diagnostic_visible <- false if verified_member.verified
                if diagnostic_visible:
                    visible <- visible + 1
                    errors <- errors + 1 if Semantic::diagnostic_severity(diagnostic) == 1
            (true, visible, errors)

        def proof_source_analysis_refines_function[@r](source: ProofSourceAnalysis[r]& @r, name: sview) -> bool:
            for refined_name in source.refined_functions:
                return true if refined_name == name
            return false

        # Binding checks run before replay so any source-inventory finding is part of the final
        # report revision captured by the receipt. They establish claim identity only; replay is
        # still required before any proof status is presented as confirmed.
        def proof_source_analysis_literal_ensure_binding_coverage[@r](source: ProofSourceAnalysis[r]& @r, report: ProofReport&) -> bool:
            return false if not source.issued or not source.literal_ensure_inventory_complete
            proof_source_literal_ensure_binding_coverage(source.literal_ensure_inventory, report)

        def proof_source_analysis_assert_by_attempt_coverage[@r](source: ProofSourceAnalysis[r]& @r, report: ProofReport&) -> bool:
            return false if not source.issued or not source.assert_by_inventory_complete
            proof_source_assert_by_attempt_coverage(source.assert_by_inventory, report)

        def proof_source_analysis_assert_by_inventory_has_unsupported[@r](source: ProofSourceAnalysis[r]& @r) -> bool:
            return true if not source.issued or not source.assert_by_inventory_complete
            proof_source_assert_by_inventory_has_unsupported(source.assert_by_inventory)

        def proof_source_analysis_focused_obligations_bound[@r](source: ProofSourceAnalysis[r]& @r, report: ProofReport&) -> bool can[Memory.Allocate]:
            return false if not source.issued or not source.literal_ensure_inventory_complete or not source.assert_by_inventory_complete
            proof_source_inventories_focused_obligations_bound(source.literal_ensure_inventory, source.assert_by_inventory, report)

        def proof_source_inventories_focused_obligations_bound(literal_inventory: darray[(name: sview, function_offset: u32, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool)]&, assert_by_inventory: darray[(name: sview, function_offset: u32, attempt_line: u32, goal_line: u32, goal_offset: u32, expected_value: bool, source_goal: Ast::Expr, supported: bool)]&, report: ProofReport&) -> bool can[Memory.Allocate]:
            return false if report.context.focused_function == ""
            return false if not report.context.focused_function_identity_valid
            focused_literals: mutable darray[(name: sview, function_offset: u32, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool)] = []
            for expected in literal_inventory |focused_literals, report|:
                if expected.function_offset == report.context.focused_function_offset:
                    return false if expected.name == ""
                    focused_literals.push(expected)
            return false if not proof_source_literal_ensure_binding_coverage(focused_literals, report)
            focused_asserts: mutable darray[(name: sview, function_offset: u32, attempt_line: u32, goal_line: u32, goal_offset: u32, expected_value: bool, source_goal: Ast::Expr, supported: bool)] = []
            for expected in assert_by_inventory |focused_asserts, report|:
                if expected.function_offset == report.context.focused_function_offset:
                    return false if expected.name == ""
                    focused_asserts.push(expected)
            proof_source_assert_by_attempt_coverage(focused_asserts, report)

        # A checked view is source-authorized only when receipt issuance was atomic with checking
        # this parser capability. It derives front-end status from retained diagnostics/findings;
        # callers cannot pass independent booleans or status arrays.
    public:

        def proof_checked_view_is_issued[@view](view: ProofCheckedView[view]& @view) -> bool:
            view.issued and view.receipt.issued and view.source_analysis.issued

        def proof_checked_view_source_validated[@view](view: ProofCheckedView[view]& @view) -> bool:
            proof_checked_view_is_issued(view) and view.receipt.source_bound and view.receipt.source_validated

    private:
        # Borrowed read-only diagnostic view. Proof status must still come from checked-view
        # verdict methods; payload fields and producer claims are not authority. Keep this
        # getter inside ElisaProof: ProofReport contains mutable nested arrays, so an immutable
        # aggregate borrow does not make those nested rows immutable to external callers.
        def proof_checked_view_diagnostic_report[@view](view: ProofCheckedView[view]& @view) -> ProofReport& @view:
            view.report

    public:
        # Source bytes are read-only and can be projected to serializers and repair tooling.
        def proof_checked_view_source[@view](view: ProofCheckedView[view]& @view) -> darray[u8]& @view:
            view.source_analysis.source

        # Suggestion matching needs parser annotations, but callers must not borrow the
        # parser's mutable side-table aggregate. Copy only the scalar annotation rows under
        # the standard source-admission work ceiling.
        def proof_checked_view_copy_suggestion_annotations[@view](view: ProofCheckedView[view]& @view, output: mutable darray[Ast::EnumAnnotation]&, source_work: mutable usize&) -> bool:
            return false if not proof_checked_view_source_validated(view)
            for annotation in view.source_analysis.file.enum_annotations |annotation, output, source_work|:
                return false if not proof_source_analysis_charge_work(1 + sview_len(annotation.owner) + sview_len(annotation.name), source_work)
                output.push(annotation)
            return true

    private:
        # The full AST file stays internal because its parser metadata contains mutable side tables.
        def proof_checked_view_file[@view](view: ProofCheckedView[view]& @view) -> Ast::File& @view:
            view.source_analysis.file

    public:
        def proof_checked_view_source_bytes[@view](view: ProofCheckedView[view]& @view) -> usize:
            return 0 if not proof_checked_view_is_issued(view)
            view.source_analysis.source_bytes

        def proof_checked_view_source_fingerprint[@view](view: ProofCheckedView[view]& @view) -> u32:
            return 0 if not proof_checked_view_is_issued(view)
            view.source_analysis.source_fingerprint

        def proof_checked_view_literal_inventory[@view](view: ProofCheckedView[view]& @view) -> darray[(name: sview, function_offset: u32, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool)]& @view:
            view.source_analysis.literal_ensure_inventory

    private:
        def proof_checked_view_assert_by_inventory[@view](view: ProofCheckedView[view]& @view) -> darray[(name: sview, function_offset: u32, attempt_line: u32, goal_line: u32, goal_offset: u32, expected_value: bool, source_goal: Ast::Expr, supported: bool)]& @view:
            view.source_analysis.assert_by_inventory

    public:
        def proof_checked_view_import_failed[@view](view: ProofCheckedView[view]& @view) -> bool:
            return true if not proof_checked_view_is_issued(view)
            view.source_analysis.import_failed

        def proof_checked_view_semantic_visible[@view](view: ProofCheckedView[view]& @view) -> u32:
            return 0 if not proof_checked_view_is_issued(view)
            view.receipt.semantic_visible

        def proof_checked_view_semantic_errors[@view](view: ProofCheckedView[view]& @view) -> u32:
            return 1 if not proof_checked_view_is_issued(view)
            view.receipt.semantic_errors

        # Kernel-certificate batch only: this does not mean source obligations or attached
        # premises were admitted. Use source_complete/source_admissible for report authority.
        def proof_checked_view_replay_complete[@view](view: ProofCheckedView[view]& @view) -> bool:
            proof_checked_view_source_validated(view) and proof_replay_receipt_kernel_batch_complete(view.receipt)

        def proof_checked_view_replay_gap_count[@view](view: ProofCheckedView[view]& @view) -> (available: bool, count: u32):
            return (false, 0) if not proof_checked_view_source_validated(view)
            proof_replay_receipt_gap_count(view.receipt)

        # Batch-wide kernel diagnostic. It is not a timeout classification for any one source
        # goal; producer timeout status remains attached to its own attempt/finding.
        def proof_checked_view_goal_search_work_exhausted[@view](view: ProofCheckedView[view]& @view) -> bool:
            proof_checked_view_source_validated(view) and proof_replay_receipt_goal_search_work_exhausted(view.receipt)

        def proof_checked_view_attempt_count[@view](view: ProofCheckedView[view]& @view) -> usize:
            return 0 if not proof_checked_view_source_validated(view)
            proof_replay_receipt_attempt_count(view.receipt)

        # This reports kernel replay only. Use attempt_is_proven for the combined
        # replay, goal-source, and attached-fact verdict.
        def proof_checked_view_attempt_status[@view](view: ProofCheckedView[view]& @view, attempt_index: usize) -> bool:
            proof_checked_view_source_validated(view) and proof_checked_view_attempt_row_matches(view, attempt_index) and proof_replay_receipt_attempt_status(view.receipt, attempt_index)

        # Diagnostic only: this reports whether the producer marked this attempt successful.
        # It is not proof authority; acceptance requires the checked replay and source verdicts.
        def proof_checked_view_attempt_had_producer_claim[@view](view: ProofCheckedView[view]& @view, attempt_index: usize) -> bool:
            return false if not proof_checked_view_source_validated(view) or attempt_index >= view.attempt_rows.count or not proof_checked_view_attempt_row_matches(view, attempt_index)
            view.attempt_rows[attempt_index].producer_proven

        # Aggregate and per-obligation producer claims are diagnostic metadata only. Consumers
        # that decide whether proof succeeded must use the checked-view replay/admission queries.
        def proof_checked_view_obligation_diagnostic_count[@view](view: ProofCheckedView[view]& @view) -> usize:
            return 0 if not proof_checked_view_source_validated(view)
            view.report.results.obligation_inventory.count

        def proof_checked_view_obligation_producer_claim_summary[@view](view: ProofCheckedView[view]& @view) -> (available: bool, producer_claims: u32, obligations: u32):
            return (false, 0, 0) if not proof_checked_view_source_validated(view)
            (true, view.report.results.producer_proven_count, view.report.results.obligations)

        def proof_checked_view_diagnostic_obligation[@view](view: ProofCheckedView[view]& @view, obligation_index: usize) -> (available: bool, obligation: ProofCheckedViewObligationDiagnostic[view]):
            empty: ProofCheckedViewObligationDiagnostic[view] = ProofCheckedViewObligationDiagnostic[view]{identity: 0, attempts_start: 0, attempts_count: 0, source_kind: "", producer_claim: false}
            return (false, empty) if not proof_checked_view_source_validated(view) or obligation_index >= view.report.results.obligation_inventory.count
            entry: ProofObligationEntry = view.report.results.obligation_inventory[obligation_index]
            (true, ProofCheckedViewObligationDiagnostic[view]{identity: entry.identity, attempts_start: entry.attempts_start, attempts_count: entry.attempts_count, source_kind: entry.source_kind, producer_claim: entry.proven})

        def proof_checked_view_theorem_diagnostic[@view](view: ProofCheckedView[view]& @view, theorem_index: usize) -> (available: bool, theorem: ProofTheoremSummary, source_admissible: bool, identity_unambiguous: bool):
            empty: ProofTheoremSummary = ProofTheoremSummary{name: "", line: 0, parameters_start: 0, parameters_count: 0, requires_start: 0, requires_count: 0, ensures_start: 0, ensures_count: 0, decreases_start: 0, decreases_count: 0, proof_goals_start: 0, proof_goals_count: 0, recursive: false, verified: false, verification_reason: "", source_offset: 0}
            return (false, empty, false, false) if not proof_checked_view_source_validated(view) or not view.receipt.theorem_source_admissions_complete or view.receipt.theorem_source_admissions.count != view.theorem_rows.count or theorem_index >= view.theorem_rows.count or not proof_checked_view_theorem_row_matches(view, theorem_index)
            status: (source_admissible: bool, declaration_identity_unambiguous: bool) = view.receipt.theorem_source_admissions[theorem_index] if theorem_index < view.receipt.theorem_source_admissions.count else (false, false)
            (true, view.theorem_rows[theorem_index], status.source_admissible, status.declaration_identity_unambiguous)

        def proof_checked_view_attempt_is_proven[@view](view: ProofCheckedView[view]& @view, attempt_index: usize) -> bool:
            return false if not proof_checked_view_source_validated(view) or not proof_checked_view_attempt_row_matches(view, attempt_index)
            proof_replay_receipt_attempt_is_proven(view.receipt, attempt_index)

        def proof_checked_view_certificate_count[@view](view: ProofCheckedView[view]& @view) -> usize:
            return 0 if not proof_checked_view_source_validated(view)
            proof_replay_receipt_certificate_count(view.receipt)

        # This reports kernel replay only; use attempt/theorem verdicts to
        # determine whether the certificate's source premises were admitted.
        def proof_checked_view_certificate_status[@view](view: ProofCheckedView[view]& @view, certificate_index: usize) -> bool:
            proof_checked_view_source_validated(view) and proof_replay_receipt_certificate_status(view.receipt, certificate_index)

        def proof_checked_view_source_complete[@view](view: ProofCheckedView[view]& @view) -> bool:
            return false if:
                not proof_checked_view_source_validated(view)
                not proof_checked_view_rows_match(view)
                not view.receipt.source_admission_snapshot_complete or not view.receipt.source_goal_statuses_complete or not view.receipt.source_claims_admissible
                view.receipt.source_goal_statuses.count != view.report.results.goal_attempts.count
                not view.receipt.source_attempt_fact_statuses_complete or view.receipt.source_attempt_fact_statuses.count != view.report.results.goal_attempts.count
                not view.receipt.theorem_source_admissions_complete or view.receipt.theorem_source_admissions.count != view.report.analysis_1.theorems.summaries.count
                not view.receipt.source_report_admissible
            view.receipt.source_report_complete
        def proof_checked_view_source_admissible[@view](view: ProofCheckedView[view]& @view) -> bool:
            # A report-level acceptance decision must not turn a replayed individual goal into
            # success when another source obligation or source-analysis phase is incomplete.
            # Individual goal status remains queryable through proof_checked_view_attempt_is_proven.
            return false if not proof_checked_view_source_complete(view)
            view.receipt.source_report_admissible

        # A source-bound tactic may discharge one exact imported goal while unrelated goals
        # remain open. This narrower capability still requires complete source admission
        # snapshots, a valid source/replay binding, and no already-proven claim that failed its
        # source correspondence check; it does not assert that the whole source is verified.
        def proof_checked_view_target_admission_base[@view](view: ProofCheckedView[view]& @view) -> bool:
            return false if:
                not proof_checked_view_source_validated(view)
                not proof_checked_view_rows_match(view)
                not view.receipt.source_admission_snapshot_complete or not view.receipt.source_goal_statuses_complete
                view.receipt.source_goal_statuses.count != view.report.results.goal_attempts.count
                not view.receipt.source_attempt_fact_statuses_complete or view.receipt.source_attempt_fact_statuses.count != view.report.results.goal_attempts.count
                not view.receipt.theorem_source_admissions_complete or view.receipt.theorem_source_admissions.count != view.report.analysis_1.theorems.summaries.count
                not view.receipt.source_claims_admissible
            view.receipt.source_report_admissible

        def proof_checked_view_source_admission_failure[@view](view: ProofCheckedView[view]& @view) -> sview @view:
            return "source-validation-incomplete" if not proof_checked_view_is_issued(view)
            return view.receipt.source_admission_failure if view.receipt.source_admission_failure != ""
            return "source-validation-incomplete" if not proof_checked_view_source_validated(view)
            return "source-admission-work-limit" if:
                not view.receipt.source_admission_snapshot_complete or not view.receipt.source_goal_statuses_complete
                view.receipt.source_goal_statuses.count != view.report.results.goal_attempts.count
                not view.receipt.source_attempt_fact_statuses_complete or view.receipt.source_attempt_fact_statuses.count != view.report.results.goal_attempts.count
                not view.receipt.theorem_source_admissions_complete or view.receipt.theorem_source_admissions.count != view.report.analysis_1.theorems.summaries.count
            return "source-goal-admission-failed" if not view.receipt.source_claims_admissible and view.receipt.source_admission_failure == ""
            view.receipt.source_admission_failure

        def proof_checked_view_source_checks_complete[@view](view: ProofCheckedView[view]& @view) -> bool:
            proof_checked_view_source_validated(view) and proof_checked_view_rows_match(view) and view.receipt.source_admission_snapshot_complete and view.receipt.source_goal_statuses_complete and view.receipt.source_goal_statuses.count == view.report.results.goal_attempts.count and view.receipt.source_attempt_fact_statuses_complete and view.receipt.source_attempt_fact_statuses.count == view.report.results.goal_attempts.count and view.receipt.theorem_source_admissions_complete and view.receipt.theorem_source_admissions.count == view.report.analysis_1.theorems.summaries.count and view.receipt.source_claims_admissible and view.receipt.source_checks_complete

    public:
        def proof_checked_view_goal_source_admissible[@view](view: ProofCheckedView[view]& @view, goal_id: usize) -> bool:
            return false if:
                not proof_checked_view_source_validated(view)
                not proof_checked_view_attempt_row_matches(view, goal_id)
                not view.receipt.source_goal_statuses_complete
                view.receipt.source_goal_statuses.count != view.report.results.goal_attempts.count
                goal_id >= view.receipt.source_goal_statuses.count
            view.receipt.source_goal_statuses[goal_id]

        # A tactic's hypotheses need their own source-trace admission. Goal correspondence
        # cannot authorize facts merely because the producer attached them to that goal.
        def proof_checked_view_goal_facts_source_admissible[@view](view: ProofCheckedView[view]& @view, goal_id: usize) -> bool:
            return false if:
                not proof_checked_view_source_validated(view)
                not proof_checked_view_attempt_row_matches(view, goal_id)
                not view.receipt.source_attempt_fact_statuses_complete
                view.receipt.source_attempt_fact_statuses.count != view.report.results.goal_attempts.count
                goal_id >= view.receipt.source_attempt_fact_statuses.count
            view.receipt.source_attempt_fact_statuses[goal_id]

        def proof_checked_view_goal_source_admissions_complete[@view](view: ProofCheckedView[view]& @view) -> bool:
            proof_checked_view_source_validated(view) and proof_checked_view_rows_match(view) and view.receipt.source_goal_statuses_complete and view.receipt.source_goal_statuses.count == view.report.results.goal_attempts.count and view.receipt.source_attempt_fact_statuses_complete and view.receipt.source_attempt_fact_statuses.count == view.report.results.goal_attempts.count

        def proof_checked_view_theorem_source_admission_with_work[@view](view: ProofCheckedView[view]& @view, theorem_index: usize, source_work: mutable usize&) -> (source_admissible: bool, declaration_identity_unambiguous: bool):
            return (false, false) if:
                not proof_checked_view_source_validated(view)
                not proof_checked_view_theorem_row_matches_with_work(view, theorem_index, source_work)
                not view.receipt.theorem_source_admissions_complete
                view.receipt.theorem_source_admissions.count != view.report.analysis_1.theorems.summaries.count
                theorem_index >= view.report.analysis_1.theorems.summaries.count
                theorem_index >= view.receipt.theorem_source_admissions.count
            view.receipt.theorem_source_admissions[theorem_index]

        def proof_checked_view_theorem_source_admission[@view](view: ProofCheckedView[view]& @view, theorem_index: usize) -> (source_admissible: bool, declaration_identity_unambiguous: bool):
            source_work: mutable usize = 0
            proof_checked_view_theorem_source_admission_with_work(view, theorem_index, &source_work)

        def proof_checked_view_theorem_source_admissions_complete[@view](view: ProofCheckedView[view]& @view) -> bool:
            proof_checked_view_source_validated(view) and proof_checked_view_rows_match(view) and view.receipt.theorem_source_admissions_complete and view.receipt.theorem_source_admissions.count == view.report.analysis_1.theorems.summaries.count

        # Expose declaration status only when both goal and theorem snapshots completed.
        def proof_checked_view_source_admissions_complete[@view](view: ProofCheckedView[view]& @view) -> bool:
            return false if not proof_checked_view_source_validated(view) or not view.receipt.source_admission_snapshot_complete
            proof_checked_view_goal_source_admissions_complete(view) and proof_checked_view_theorem_source_admissions_complete(view)

    private:
        def proof_checked_view_enum_annotations[@view](view: ProofCheckedView[view]& @view) -> darray[Ast::EnumAnnotation]& @view:
            view.source_analysis.file.enum_annotations
