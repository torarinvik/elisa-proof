# Source-bound, report-bound capability exposed to output clients. The source analysis is
# captured once from parser-owned declarations; replay binds that analysis and its report into
# one opaque checked view.
extend ElisaProof:
    private:
        def proof_source_analysis_charge_work(amount: usize, source_work: mutable usize&) -> bool:
            source_work_limit: usize = proof_replay_summary_source_work_limit()
            return false if source_work > source_work_limit
            if amount > source_work_limit - source_work:
                source_work <- source_work_limit + 1
                return false
            source_work <- source_work + amount
            true

        def proof_source_analysis_hash(source: darray[u8]&, source_bytes: usize) -> u32:
            hash: mutable i64 = ElisaProofKernelCore::PROOF_KERNEL_FNV1A_OFFSET_BASIS
            for offset in 0..<source_bytes |offset, source, hash|:
                hash <- ((hash ^ source[offset].i64()) * ElisaProofKernelCore::PROOF_KERNEL_FNV1A_PRIME) % ElisaProofKernelCore::PROOF_KERNEL_HASH_U32_MODULUS
            hash.u32()

    public:
        # The only source-analysis issuer. It imports the root itself, retains the importer's
        # failure result, and reports root-read failure separately so the CLI needs no preflight
        # read. It then tokenizes and parses the exact expanded bytes, freezes parser inventories
        # before typed-source augmentation, and returns an immutable borrow of that exact AST.
        # Keep both tokens and AST in the caller's arena so every parser-owned borrow remains
        # valid for the full lifetime of the returned capability.
        def proof_source_analysis_import_parse[@r, @files, @line_files, @line_numbers](source_arena: mutable Arena& @r, root_path: darray[u8]&, root_read_failed: mutable bool&, source_files: mutable darray[u8]& @files, source_line_files: mutable darray[u32]& @line_files, source_line_numbers: mutable darray[u32]& @line_numbers, capture_source_map: bool) -> ProofSourceAnalysis[r] can[Memory.Allocate, Memory.Release, Abort.Panic, Global.Read, Global.Write, Unsafe.PointerCast]:
            in source_arena:
                import_failed: mutable bool = false
                source: mutable darray[u8] = (proof_import_source_mapped(root_path, &import_failed, root_read_failed, source_files, source_line_files, source_line_numbers, capture_source_map) can Global{Read,Write})
                source_bytes: usize = source.count
                source.push(0)
                tokens: mutable darray[Token] = frontend_tokenize_with_length(&source[0], &source[0], source_bytes)
                file: mutable Ast::File = (frontend_parser_parse_file(&source[0], tokens) can Global{Read,Write})
                top_declarations: darray[Ast::Decl] = file.top_decls
                literal_inventory_status: (inventory: darray[(name: sview, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool)], complete: bool, work_limited: bool) = proof_source_literal_ensure_inventory_with_status(top_declarations)
                literal_inventory_complete: bool = literal_inventory_status.complete
                literal_inventory_work_limited: bool = literal_inventory_status.work_limited
                literal_inventory: mutable darray[(name: sview, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool)] = literal_inventory_status.inventory
                postcondition_ast_inventory_status: (inventory: darray[(name: sview, line: u32, source_index: usize, contract_line: u32, expression: Ast::Expr)], complete: bool, work_limited: bool) = proof_source_postcondition_ast_inventory_with_status(top_declarations)
                postcondition_ast_inventory_complete: bool = postcondition_ast_inventory_status.complete
                postcondition_ast_inventory_work_limited: bool = postcondition_ast_inventory_status.work_limited
                postcondition_ast_inventory: mutable darray[(name: sview, line: u32, source_index: usize, contract_line: u32, expression: Ast::Expr)] = postcondition_ast_inventory_status.inventory
                assert_by_inventory_status: (inventory: darray[(name: sview, attempt_line: u32, goal_line: u32, goal_offset: u32, expected_value: bool, source_goal: Ast::Expr, supported: bool)], complete: bool, work_limited: bool) = proof_source_assert_by_inventory_with_status(top_declarations)
                assert_by_inventory_complete: bool = assert_by_inventory_status.complete
                assert_by_inventory_work_limited: bool = assert_by_inventory_status.work_limited
                assert_by_inventory: mutable darray[(name: sview, attempt_line: u32, goal_line: u32, goal_offset: u32, expected_value: bool, source_goal: Ast::Expr, supported: bool)] = assert_by_inventory_status.inventory
                proof_push_source_int_types(&file, tokens, source, source_bytes)
                refinement_refusals: mutable ProofReport = proof_empty_report()
                refined_functions: mutable darray[sview] = []
                proof_add_refinement_signature_contracts(&file, &refinement_refusals, &refined_functions)
                pass_offsets: mutable darray[u32] = []
                for token in tokens |pass_offsets|:
                    pass_offsets.push(token.start) if token.kind == TokenKind.Pass
                stray_nul_line: u32 = proof_source_stray_nul_line(tokens, source, source_bytes)
                source_identity: uintptr = (&source[0]).cast[uintptr]
                fingerprint: u32 = proof_source_analysis_hash(source, source_bytes)
                analysis: ProofSourceAnalysis[r] = ProofSourceAnalysis{source: source, file: file, source_bytes: source_bytes, source_fingerprint: fingerprint, source_identity: source_identity, file_identity: source_identity, import_failed: import_failed, pass_statement_offsets: pass_offsets, stray_nul_line: stray_nul_line, refinement_findings: refinement_refusals.results.findings, refined_functions: refined_functions, literal_ensure_inventory: literal_inventory, literal_ensure_inventory_complete: literal_inventory_complete, literal_ensure_inventory_work_limited: literal_inventory_work_limited, postcondition_ast_inventory: postcondition_ast_inventory, postcondition_ast_inventory_complete: postcondition_ast_inventory_complete, postcondition_ast_inventory_work_limited: postcondition_ast_inventory_work_limited, assert_by_inventory: assert_by_inventory, assert_by_inventory_complete: assert_by_inventory_complete, assert_by_inventory_work_limited: assert_by_inventory_work_limited, issued: true}
                return analysis

        def proof_source_analysis_import_failed[@r](source: ProofSourceAnalysis[r]& @r) -> bool:
            not source.issued or source.import_failed

        def proof_source_analysis_source[@view](source: ProofSourceAnalysis[view]& @view) -> darray[u8]& @view:
            source.source

        def proof_source_analysis_file[@view](source: ProofSourceAnalysis[view]& @view) -> Ast::File& @view:
            source.file

        def proof_source_analysis_stray_nul_line[@r](source: ProofSourceAnalysis[r]& @r) -> u32:
            source.stray_nul_line

        def proof_source_analysis_bytes[@r](source: ProofSourceAnalysis[r]& @r) -> usize:
            source.source_bytes

        def proof_source_analysis_fingerprint[@r](source: ProofSourceAnalysis[r]& @r) -> u32:
            source.source_fingerprint

        def proof_source_analysis_literal_inventory[@view](source: ProofSourceAnalysis[view]& @view) -> darray[(name: sview, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool)]& @view:
            source.literal_ensure_inventory

        def proof_source_analysis_assert_by_inventory[@view](source: ProofSourceAnalysis[view]& @view) -> darray[(name: sview, attempt_line: u32, goal_line: u32, goal_offset: u32, expected_value: bool, source_goal: Ast::Expr, supported: bool)]& @view:
            source.assert_by_inventory

        def proof_source_analysis_pass_offsets[@view](source: ProofSourceAnalysis[view]& @view) -> darray[u32]& @view:
            source.pass_statement_offsets

        def proof_semantic_diagnostic_counts_with_work(diagnostics: darray[Semantic::Diagnostic]&, report: ProofReport&, source_work: mutable usize&) -> (complete: bool, visible: u32, errors: u32):
            visible: mutable u32 = 0
            errors: mutable u32 = 0
            for diagnostic in diagnostics |visible, errors, report, source_work|:
                if not proof_replay_source_work_charge(1, source_work):
                    source_work <- proof_replay_summary_source_work_limit() + 1
                    return (false, visible, errors)
                diagnostic_visible: mutable bool = true
                if diagnostic.kind == Semantic::DiagnosticKind.AssertByUnproven:
                    diagnostic_visible <- false
                elif diagnostic.kind == Semantic::DiagnosticKind.MutualDecreasesCycle:
                    for verified_name in report.analysis_1.structural.verified_names |diagnostic, diagnostic_visible, source_work|:
                        if not proof_replay_source_work_charge(1, source_work):
                            source_work <- proof_replay_summary_source_work_limit() + 1
                            return (false, visible, errors)
                        if not proof_replay_source_work_charge(sview_len(verified_name), source_work) or not proof_replay_source_work_charge(sview_len(diagnostic.name), source_work):
                            source_work <- proof_replay_summary_source_work_limit() + 1
                            return (false, visible, errors)
                        diagnostic_visible <- false if verified_name == diagnostic.name
                        break if not diagnostic_visible
                if diagnostic_visible:
                    visible <- visible + 1
                    errors <- errors + 1 if Semantic::diagnostic_severity(diagnostic) == 1
            (true, visible, errors)

        def proof_source_analysis_refines_function[@r](source: ProofSourceAnalysis[r]& @r, name: sview) -> bool:
            for refined_name in source.refined_functions:
                return true if refined_name == name
            return false

        def proof_source_analysis_report_structure_bound_failure(issued: bool, source_file_identity: uintptr, report: ProofReport&, source_work: mutable usize&) -> sview:
            return "source-validation-incomplete" if not issued or not report.source.source_analysis_bound or report.source.source_file_identity != source_file_identity
            return "source-admission-work-limit" if:
                not proof_source_analysis_charge_work(report.analysis_1.declaration_details.count, source_work)
                not proof_source_analysis_charge_work(report.source.source_declarations.count, source_work)
                not proof_source_analysis_charge_work(report.results.obligation_inventory.count, source_work)
                not proof_source_analysis_charge_work(report.results.goal_attempts.count, source_work)
                not proof_source_analysis_charge_work(report.analysis_1.certificates.count, source_work)
                not proof_source_analysis_charge_work(report.results.findings.count, source_work)
                not proof_source_analysis_charge_work(report.analysis_1.theorems.summaries.count, source_work)
                not proof_source_analysis_charge_work(report.analysis_1.theorems.proof_goal_ids.count, source_work)
            source_work_limit: usize = proof_replay_summary_source_work_limit()
            theorem_name_bytes: mutable usize = 0
            for theorem in report.analysis_1.theorems.summaries |theorem, theorem_name_bytes, source_work, source_work_limit|:
                name_bytes: usize = sview_len(theorem.name)
                return "source-admission-work-limit" if theorem_name_bytes > source_work_limit or name_bytes > source_work_limit - theorem_name_bytes
                theorem_name_bytes <- theorem_name_bytes + name_bytes
                return "source-admission-work-limit" if not proof_source_analysis_charge_work(name_bytes, source_work)
            for declaration in report.analysis_1.declaration_details |declaration, source_work, source_work_limit|:
                name_bytes: usize = sview_len(declaration.name)
                return "source-admission-work-limit" if:
                    name_bytes > source_work_limit / 2
                    not proof_source_analysis_charge_work(name_bytes * 2, source_work)
            for goal_id in 0..<report.results.goal_attempts.count |goal_id, report, source_work|:
                attempt: ProofGoalAttempt = report.results.goal_attempts[goal_id]
                if attempt.proven and attempt.certificate_index < report.analysis_1.certificates.count:
                    certificate: ProofGoalCertificate = report.analysis_1.certificates[attempt.certificate_index]
                    return "source-admission-work-limit" if:
                        not proof_source_analysis_charge_work(sview_len(attempt.name), source_work)
                        not proof_source_analysis_charge_work(sview_len(attempt.rule), source_work)
                        not proof_source_analysis_charge_work(sview_len(certificate.name), source_work)
                        not proof_source_analysis_charge_work(sview_len(certificate.rule), source_work)
            return "source-admission-work-limit" if:
                not proof_source_analysis_charge_work(report.analysis_1.declaration_details.count, source_work)
                not proof_source_analysis_charge_work(report.source.source_declarations.count, source_work)
            return "finding-count" if not proof_report_failure_count_consistent(report)
            declarations_consistent: bool = proof_report_declaration_inventory_consistent(report, source_work)
            if not declarations_consistent:
                return "source-admission-work-limit" if source_work > source_work_limit
                return "declaration-inventory"
            return "obligation-inventory" if not proof_report_obligation_inventory_consistent(report)
            # Attempt coverage scans the obligation ledger once to count frame rows and once
            # to validate attempt ranges. Reserve both passes before entering that validator.
            return "source-admission-work-limit" if:
                not proof_source_analysis_charge_work(report.results.obligation_inventory.count, source_work)
                not proof_source_analysis_charge_work(report.results.obligation_inventory.count, source_work)
            return "goal-attempt-coverage" if not proof_report_goal_attempts_bounded_by_obligations(report)
            # Proven-attempt consistency scans attempts and recounts proven frame rows.
            return "source-admission-work-limit" if:
                not proof_source_analysis_charge_work(report.results.obligation_inventory.count, source_work)
                not proof_source_analysis_charge_work(report.results.goal_attempts.count, source_work)
                not proof_source_analysis_charge_work(report.analysis_1.certificates.count, source_work)
            return "proven-attempt-certificates" if not proof_report_proven_attempts_consistent(report)
            ""

        # Binding checks run before replay so any source-inventory finding is part of the final
        # report revision captured by the receipt. They establish claim identity only; replay is
        # still required before any proof status is presented as confirmed.
        def proof_source_analysis_literal_ensure_binding_coverage[@r](source: ProofSourceAnalysis[r]& @r, report: ProofReport&) -> bool:
            return false if not source.issued or not source.literal_ensure_inventory_complete
            proof_source_literal_ensure_binding_coverage(source.literal_ensure_inventory, report)

        def proof_source_analysis_literal_inventory_has_unsupported[@r](source: ProofSourceAnalysis[r]& @r) -> bool:
            return true if not source.issued or not source.literal_ensure_inventory_complete
            proof_source_literal_ensure_inventory_has_unsupported(source.literal_ensure_inventory)

        def proof_source_analysis_assert_by_attempt_coverage[@r](source: ProofSourceAnalysis[r]& @r, report: ProofReport&) -> bool:
            return false if not source.issued or not source.assert_by_inventory_complete
            proof_source_assert_by_attempt_coverage(source.assert_by_inventory, report)

        def proof_source_analysis_assert_by_inventory_has_unsupported[@r](source: ProofSourceAnalysis[r]& @r) -> bool:
            return true if not source.issued or not source.assert_by_inventory_complete
            proof_source_assert_by_inventory_has_unsupported(source.assert_by_inventory)

        def proof_source_analysis_focused_obligations_bound[@r](source: ProofSourceAnalysis[r]& @r, report: ProofReport&) -> bool can[Memory.Allocate]:
            return false if not source.issued or not source.literal_ensure_inventory_complete or not source.assert_by_inventory_complete
            proof_source_inventories_focused_obligations_bound(source.literal_ensure_inventory, source.assert_by_inventory, report)

        def proof_source_inventories_focused_obligations_bound(literal_inventory: darray[(name: sview, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool)]&, assert_by_inventory: darray[(name: sview, attempt_line: u32, goal_line: u32, goal_offset: u32, expected_value: bool, source_goal: Ast::Expr, supported: bool)]&, report: ProofReport&) -> bool can[Memory.Allocate]:
            return false if report.context.focused_function == ""
            focused_literals: mutable darray[(name: sview, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool)] = []
            for expected in literal_inventory |focused_literals, report|:
                if expected.name == report.context.focused_function:
                    return false if expected.name == ""
                    focused_literals.push(expected)
            return false if not proof_source_literal_ensure_binding_coverage(focused_literals, report)
            focused_asserts: mutable darray[(name: sview, attempt_line: u32, goal_line: u32, goal_offset: u32, expected_value: bool, source_goal: Ast::Expr, supported: bool)] = []
            for expected in assert_by_inventory |focused_asserts, report|:
                if expected.name == report.context.focused_function:
                    return false if expected.name == ""
                    focused_asserts.push(expected)
            proof_source_assert_by_attempt_coverage(focused_asserts, report)

        # A checked view is source-authorized only when receipt issuance was atomic with checking
        # this parser capability. It derives front-end status from retained diagnostics/findings;
        # callers cannot pass independent booleans or status arrays.
    private:
        # Construction is private so only the combined check/replay transaction can issue a
        # source-authorized view. Recheck source identity and fact-call snapshot binding at the
        # capability boundary after report structure validation and receipt issuance.
        def proof_checked_view_create[@r](report: ProofReport& @r, receipt: ProofReplayReceipt[r]& @r, source: ProofSourceAnalysis[r]) -> ProofCheckedView[r]:
            return ProofCheckedView{report: report, receipt: receipt, source_analysis: source} if not receipt.issued or not source.issued
            if receipt.source_bound:
                return ProofCheckedView{report: report, receipt: receipt, source_analysis: source} if:
                    not report.source.source_analysis_bound or report.source.source_file_identity != source.file_identity
                    receipt.source_identity != source.source_identity or receipt.source_file_identity != source.file_identity
                    receipt.source_bytes != source.source_bytes or receipt.source_fingerprint != source.source_fingerprint
                fact_call_snapshot: ProofFactCallShapeSnapshot& = &report.analysis_2.fact_call_shapes
                return ProofCheckedView{report: report, receipt: receipt, source_analysis: source} if fact_call_snapshot.status.source_identity != source.file_identity or fact_call_snapshot.status.source_fingerprint != source.source_fingerprint
                if fact_call_snapshot.status.initialized:
                    return ProofCheckedView{report: report, receipt: receipt, source_analysis: source} if not fact_call_snapshot.status.complete
                if report.results.goal_attempts.count > 0 or report.analysis_1.certificates.count > 0:
                    return ProofCheckedView{report: report, receipt: receipt, source_analysis: source} if not fact_call_snapshot.status.initialized or not fact_call_snapshot.status.complete
            return ProofCheckedView{report: report, receipt: receipt, source_analysis: source, issued: true}

    public:

        def proof_checked_view_is_issued[@view](view: ProofCheckedView[view]& @view) -> bool:
            view.issued and view.receipt.issued and view.source_analysis.issued

        def proof_checked_view_source_validated[@view](view: ProofCheckedView[view]& @view) -> bool:
            proof_checked_view_is_issued(view) and view.receipt.source_bound and view.receipt.source_validated

    public:
        # Read-only access for the in-process CLI serializer. The report is not exported as a
        # mutable API that can be paired with caller-assembled status vectors.
        def proof_checked_view_report[@view](view: ProofCheckedView[view]& @view) -> ProofReport& @view:
            view.report

    public:

        def proof_checked_view_source[@view](view: ProofCheckedView[view]& @view) -> darray[u8]& @view:
            view.source_analysis.source

        def proof_checked_view_file[@view](view: ProofCheckedView[view]& @view) -> Ast::File& @view:
            view.source_analysis.file

        def proof_checked_view_source_bytes[@view](view: ProofCheckedView[view]& @view) -> usize:
            return 0 if not proof_checked_view_is_issued(view)
            view.source_analysis.source_bytes

        def proof_checked_view_source_fingerprint[@view](view: ProofCheckedView[view]& @view) -> u32:
            return 0 if not proof_checked_view_is_issued(view)
            view.source_analysis.source_fingerprint

        def proof_checked_view_literal_inventory[@view](view: ProofCheckedView[view]& @view) -> darray[(name: sview, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool)]& @view:
            view.source_analysis.literal_ensure_inventory

        def proof_checked_view_assert_by_inventory[@view](view: ProofCheckedView[view]& @view) -> darray[(name: sview, attempt_line: u32, goal_line: u32, goal_offset: u32, expected_value: bool, source_goal: Ast::Expr, supported: bool)]& @view:
            view.source_analysis.assert_by_inventory

        def proof_checked_view_import_failed[@view](view: ProofCheckedView[view]& @view) -> bool:
            return true if not proof_checked_view_is_issued(view)
            view.source_analysis.import_failed

        def proof_checked_view_semantic_visible[@view](view: ProofCheckedView[view]& @view) -> u32:
            return 0 if not proof_checked_view_is_issued(view)
            view.receipt.semantic_visible

        def proof_checked_view_semantic_errors[@view](view: ProofCheckedView[view]& @view) -> u32:
            return 1 if not proof_checked_view_is_issued(view)
            view.receipt.semantic_errors

        def proof_checked_view_replay_complete[@view](view: ProofCheckedView[view]& @view) -> bool:
            proof_checked_view_source_validated(view) and proof_replay_receipt_kernel_batch_complete(view.receipt)

        def proof_checked_view_replay_gap_count[@view](view: ProofCheckedView[view]& @view) -> (available: bool, count: u32):
            return (false, 0) if not proof_checked_view_source_validated(view)
            proof_replay_receipt_gap_count(view.receipt)

        def proof_checked_view_attempt_count[@view](view: ProofCheckedView[view]& @view) -> usize:
            return 0 if not proof_checked_view_source_validated(view)
            proof_replay_receipt_attempt_count(view.receipt)

        def proof_checked_view_attempt_status[@view](view: ProofCheckedView[view]& @view, attempt_index: usize) -> bool:
            proof_checked_view_source_validated(view) and proof_replay_receipt_attempt_status(view.receipt, attempt_index)

        def proof_checked_view_attempt_is_proven[@view](view: ProofCheckedView[view]& @view, attempt_index: usize) -> bool:
            proof_checked_view_source_validated(view) and proof_checked_view_goal_source_admissible(view, attempt_index) and proof_replay_receipt_attempt_is_proven(view.receipt, attempt_index)

        def proof_checked_view_certificate_count[@view](view: ProofCheckedView[view]& @view) -> usize:
            return 0 if not proof_checked_view_source_validated(view)
            proof_replay_receipt_certificate_count(view.receipt)

        def proof_checked_view_certificate_status[@view](view: ProofCheckedView[view]& @view, certificate_index: usize) -> bool:
            proof_checked_view_source_validated(view) and proof_replay_receipt_certificate_status(view.receipt, certificate_index)

        def proof_checked_view_source_complete[@view](view: ProofCheckedView[view]& @view) -> bool:
            return false if not proof_checked_view_source_validated(view) or not view.receipt.source_admission_snapshot_complete or not view.receipt.source_goal_statuses_complete or not view.receipt.source_claims_admissible
            view.receipt.source_report_complete

        def proof_checked_view_source_admissible[@view](view: ProofCheckedView[view]& @view) -> bool:
            # A report-level acceptance decision must not turn a replayed individual goal into
            # success when another source obligation or source-analysis phase is incomplete.
            # Individual goal status remains queryable through proof_checked_view_attempt_is_proven.
            return false if not proof_checked_view_source_complete(view)
            view.receipt.source_report_admissible

        # A source-bound tactic may discharge one exact imported goal while unrelated goals
        # remain open. This narrower capability still requires complete source admission
        # snapshots, a valid source/replay binding, and no already-proven claim that failed its
        # source correspondence check; it does not assert that the whole source is verified.
        def proof_checked_view_target_admission_base[@view](view: ProofCheckedView[view]& @view) -> bool:
            return false if:
                not proof_checked_view_source_validated(view)
                not view.receipt.source_admission_snapshot_complete or not view.receipt.source_goal_statuses_complete
                not view.receipt.source_claims_admissible
            view.receipt.source_report_admissible

        def proof_checked_view_source_admission_failure[@view](view: ProofCheckedView[view]& @view) -> sview @view:
            return "source-validation-incomplete" if not proof_checked_view_is_issued(view)
            return view.receipt.source_admission_failure if view.receipt.source_admission_failure != ""
            return "source-validation-incomplete" if not proof_checked_view_source_validated(view)
            return "source-admission-work-limit" if not view.receipt.source_admission_snapshot_complete or not view.receipt.source_goal_statuses_complete
            return "source-goal-admission-failed" if not view.receipt.source_claims_admissible and view.receipt.source_admission_failure == ""
            view.receipt.source_admission_failure

        def proof_checked_view_source_checks_complete[@view](view: ProofCheckedView[view]& @view) -> bool:
            proof_checked_view_source_validated(view) and view.receipt.source_admission_snapshot_complete and view.receipt.source_goal_statuses_complete and view.receipt.source_claims_admissible and view.receipt.source_checks_complete

    private:
        def proof_source_analysis_report_admission_snapshot[@r](source: ProofSourceAnalysis[r]& @r, report: ProofReport&, import_failed: bool, semantic_errors: u32, replay_complete: bool, goal_finding_clear: mutable darray[bool]&, goal_finding_snapshot_ready: mutable bool&, source_work: mutable usize&) -> (complete: bool, failure: sview, source_checks_complete: bool, source_complete: bool, source_admissible: bool) can[Memory.Allocate]:
            source_work_limit: usize = proof_replay_summary_source_work_limit()
            return (false, "source-admission-work-limit", false, false, false) if:
                not source.issued or source_work > source_work_limit
                source.literal_ensure_inventory_work_limited
            return (true, "source-literal-ensure-inventory-incomplete", false, false, false) if not source.literal_ensure_inventory_complete
            return (false, "source-admission-work-limit", false, false, false) if source.assert_by_inventory_work_limited
            return (true, "source-assert-by-inventory-incomplete", false, false, false) if not source.assert_by_inventory_complete
            if not proof_report_source_postcondition_inventory_consistent_with_work(report, source_work):
                return (false, "source-admission-work-limit", false, false, false) if source_work > source_work_limit
                return (true, "postcondition-inventory", false, false, false)

            literal_inventory: mutable darray[(name: sview, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool)] = []
            assert_by_inventory: mutable darray[(name: sview, attempt_line: u32, goal_line: u32, goal_offset: u32, expected_value: bool, source_goal: Ast::Expr, supported: bool)] = []
            if report.context.focused_function != "":
                for expected in source.literal_ensure_inventory |source, report, literal_inventory, source_work|:
                    return (false, "source-admission-work-limit", false, false, false) if:
                        not proof_source_analysis_charge_work(1, source_work)
                        not proof_source_analysis_charge_work(sview_len(expected.name), source_work)
                        not proof_source_analysis_charge_work(sview_len(report.context.focused_function), source_work)
                    literal_inventory.push(expected) if expected.name == report.context.focused_function
                for expected in source.assert_by_inventory |source, report, assert_by_inventory, source_work|:
                    return (false, "source-admission-work-limit", false, false, false) if:
                        not proof_source_analysis_charge_work(1, source_work)
                        not proof_source_analysis_charge_work(sview_len(expected.name), source_work)
                        not proof_source_analysis_charge_work(sview_len(report.context.focused_function), source_work)
                    assert_by_inventory.push(expected) if expected.name == report.context.focused_function
            else:
                literal_inventory <- source.literal_ensure_inventory
                assert_by_inventory <- source.assert_by_inventory

            if not proof_source_literal_ensure_inventory_coverage_with_work(literal_inventory, report, true, source_work):
                return (false, "source-admission-work-limit", false, false, false) if source_work > source_work_limit
                failure: sview = "focused-source-obligations" if report.context.focused_function != "" else "source-literal-ensure-coverage"
                return (true, failure, false, false, false)
            if not proof_source_assert_by_coverage_inner(assert_by_inventory, report, true, source_work):
                return (false, "source-admission-work-limit", false, false, false) if source_work > source_work_limit
                failure: sview = "focused-source-obligations" if report.context.focused_function != "" else "source-assert-by-coverage"
                return (true, failure, false, false, false)

            semantic_admissible: mutable bool = not import_failed and semantic_errors == 0
            if semantic_admissible:
                # The same bounded scan computes report-level semantic admissibility and
                # records the exact refutations used to build per-goal blocker status.
                refutations: mutable darray[ProofGoalRefutation] = []
                for finding_index in 0..<report.results.findings.count |finding_index, report, source_work, semantic_admissible, refutations|:
                    return (false, "source-admission-work-limit", false, false, false) if not proof_source_analysis_charge_work(1, source_work)
                    finding: ProofFinding = report.results.findings[finding_index]
                    if proof_report_goal_finding_is_refuting(finding.kind, source_work):
                        semantic_admissible <- false
                        return (false, "source-admission-work-limit", false, false, false) if not proof_source_analysis_charge_work(1, source_work)
                        refutations.push(ProofGoalRefutation{finding_index: finding_index})
                finding_snapshot: (goal_finding_clear: darray[bool], complete: bool) = proof_report_source_goal_finding_snapshot_from_refutations(report, refutations, source_work)
                return (false, "source-admission-work-limit", false, false, false) if not finding_snapshot.complete
                goal_finding_clear <- finding_snapshot.goal_finding_clear
                goal_finding_snapshot_ready <- true

            source_checks_complete: mutable bool = semantic_admissible and report.results.failed == 0 and report.results.proven == report.results.obligations
            for attempt in report.results.goal_attempts |source_work, source_checks_complete|:
                return (false, "source-admission-work-limit", false, false, false) if not proof_source_analysis_charge_work(1, source_work)
                source_checks_complete <- false if not attempt.proven
            source_admissible: bool = semantic_admissible and replay_complete
            (true, "", source_checks_complete, source_checks_complete and replay_complete, source_admissible)

        def proof_source_analysis_goal_admission_snapshot[@r](source: ProofSourceAnalysis[r]& @r, report: ProofReport&, import_failed: bool, semantic_errors: u32, goal_finding_clear: mutable darray[bool]&, goal_finding_snapshot_ready: bool, source_work: mutable usize&) -> (statuses: darray[bool], complete: bool, claims_admissible: bool) can[Memory.Allocate]:
            statuses: mutable darray[bool] = []
            claims_admissible: mutable bool = true
            complete: mutable bool = true
            return (statuses, false, false) if:
                not source.issued or source_work > proof_replay_summary_source_work_limit() or source.literal_ensure_inventory_work_limited or source.assert_by_inventory_work_limited
                not source.literal_ensure_inventory_complete or not source.assert_by_inventory_complete
            return (statuses, true, true) if report.results.goal_attempts.count == 0
            check_source_goals: bool = not import_failed and semantic_errors == 0
            if check_source_goals and not goal_finding_snapshot_ready:
                goal_finding_snapshot: (goal_finding_clear: darray[bool], complete: bool) = proof_report_source_goal_finding_snapshot(report, source_work)
                return (statuses, false, false) if not goal_finding_snapshot.complete
                goal_finding_clear <- goal_finding_snapshot.goal_finding_clear
            return (statuses, false, false) if check_source_goals and goal_finding_clear.count != report.results.goal_attempts.count
            needs_postcondition_index: mutable bool = false
            if check_source_goals:
                for obligation in report.results.obligation_inventory |needs_postcondition_index, source_work|:
                    if not proof_source_analysis_charge_work(1, source_work):
                        return (statuses, false, false)
                    needs_postcondition_index <- true if obligation.source_kind == "postcondition" and obligation.attempts_count > 0
            literal_index: mutable ProofSourceLiteralEnsureAdmissionIndex = ProofSourceLiteralEnsureAdmissionIndex{valid: true}
            if needs_postcondition_index:
                literal_index <- proof_source_literal_ensure_admission_index(source.literal_ensure_inventory, source_work)
                return (statuses, false, false) if not literal_index.valid
            postcondition_ast_index: mutable ProofSourcePostconditionAstIndex = ProofSourcePostconditionAstIndex{valid: true}
            if needs_postcondition_index:
                return (statuses, false, false) if source.postcondition_ast_inventory_work_limited or not source.postcondition_ast_inventory_complete
                postcondition_ast_index <- proof_source_postcondition_ast_index_create(source.postcondition_ast_inventory, source_work)
                return (statuses, false, false) if not postcondition_ast_index.valid
            for goal_id in 0..<report.results.goal_attempts.count |goal_id, statuses, complete, claims_admissible, source_work, check_source_goals, source, report, literal_index, postcondition_ast_index, goal_finding_clear|:
                if not proof_source_analysis_charge_work(1, source_work):
                    complete <- false
                    claims_admissible <- false
                    break
                admitted: bool = check_source_goals and proof_report_goal_source_admissible_after_structure_with_snapshots(report, goal_id, source.literal_ensure_inventory, literal_index, postcondition_ast_index, source.assert_by_inventory, goal_finding_clear, source_work)
                statuses.push(admitted)
                claims_admissible <- false if report.results.goal_attempts[goal_id].proven and not admitted
                source_work_limit: usize = proof_replay_summary_source_work_limit()
                if source_work > source_work_limit or source_work == source_work_limit and goal_id + 1 < report.results.goal_attempts.count:
                    complete <- false
                    claims_admissible <- false
                    break
            (statuses, complete, claims_admissible)

    public:
        def proof_checked_view_goal_source_admissible[@view](view: ProofCheckedView[view]& @view, goal_id: usize) -> bool:
            return false if:
                not proof_checked_view_source_validated(view)
                not view.receipt.source_goal_statuses_complete
                goal_id >= view.receipt.source_goal_statuses.count
            view.receipt.source_goal_statuses[goal_id]

        # A tactic's hypotheses need their own source-trace admission. Goal correspondence
        # cannot authorize facts merely because the producer attached them to that goal.
        def proof_checked_view_goal_facts_source_admissible[@view](view: ProofCheckedView[view]& @view, goal_id: usize) -> bool:
            return false if:
                not proof_checked_view_source_validated(view)
                not view.receipt.source_attempt_fact_statuses_complete
                view.receipt.source_attempt_fact_statuses.count != view.report.results.goal_attempts.count
                goal_id >= view.receipt.source_attempt_fact_statuses.count
            view.receipt.source_attempt_fact_statuses[goal_id]

        def proof_checked_view_goal_source_admissions_complete[@view](view: ProofCheckedView[view]& @view) -> bool:
            proof_checked_view_source_validated(view) and view.receipt.source_goal_statuses_complete and view.receipt.source_goal_statuses.count == view.report.results.goal_attempts.count

        def proof_checked_view_theorem_source_admission[@view](view: ProofCheckedView[view]& @view, theorem_index: usize) -> (source_admissible: bool, declaration_identity_unambiguous: bool):
            return (false, false) if:
                not proof_checked_view_source_validated(view)
                not view.receipt.theorem_source_admissions_complete
                view.receipt.theorem_source_admissions.count != view.report.analysis_1.theorems.summaries.count
                theorem_index >= view.report.analysis_1.theorems.summaries.count
                theorem_index >= view.receipt.theorem_source_admissions.count
            view.receipt.theorem_source_admissions[theorem_index]

        def proof_checked_view_theorem_source_admissions_complete[@view](view: ProofCheckedView[view]& @view) -> bool:
            proof_checked_view_source_validated(view) and view.receipt.theorem_source_admissions_complete and view.receipt.theorem_source_admissions.count == view.report.analysis_1.theorems.summaries.count

        # Declaration-level status is meaningful only when both per-goal and per-theorem source
        # admission snapshots completed for this exact checked view. Keep this combined gate here
        # so output clients cannot accidentally expose checker claims after one snapshot ran out
        # of budget.
        def proof_checked_view_source_admissions_complete[@view](view: ProofCheckedView[view]& @view) -> bool:
            return false if not proof_checked_view_source_validated(view) or not view.receipt.source_admission_snapshot_complete
            proof_checked_view_goal_source_admissions_complete(view) and proof_checked_view_theorem_source_admissions_complete(view)

        def proof_checked_view_enum_annotations[@view](view: ProofCheckedView[view]& @view) -> darray[Ast::EnumAnnotation]& @view:
            view.source_analysis.file.enum_annotations
