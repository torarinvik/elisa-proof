# Flat lemma summary table shared by lemma collection, verification, and call checking.
extend ElisaProof:
    public:
        # Flat lemma summaries keep all source expressions in the compiler-owned AST region
        # while avoiding nested dynamic arrays whose lifetimes are harder for the Elisa region
        # checker to prove. The layout mirrors the compiler's own lemma summary tables.
        struct ProofLemmaTableNames:
            names: mutable darray[sview]
            name_hashes: mutable darray[u32]
            index_hashes: mutable darray[u32]
            index_values: mutable darray[usize]
            index_ambiguous: mutable darray[bool]

        struct ProofLemmaTableParameters:
            param_starts: mutable darray[usize]
            param_counts: mutable darray[usize]
            all_params: mutable darray[sview]
            all_has_defaults: mutable darray[bool]
            all_defaults: mutable darray[Ast::Expr]

        struct ProofLemmaTableContracts:
            requires_starts: mutable darray[usize]
            requires_counts: mutable darray[usize]
            all_requires: mutable darray[Ast::Expr]
            ensure_starts: mutable darray[usize]
            ensure_counts: mutable darray[usize]
            all_ensures: mutable darray[Ast::Expr]

        struct ProofLemmaTableTermination:
            decreases_starts: mutable darray[usize]
            decreases_counts: mutable darray[usize]
            all_decreases: mutable darray[Ast::Expr]
            decreases_unbounded: mutable darray[bool]
            call_starts: mutable darray[usize]
            call_counts: mutable darray[usize]
            all_calls: mutable darray[sview]
            recursive: mutable darray[bool]
            recursive_component_ids: mutable darray[usize]

        struct ProofLemmaTableVerification:
            # Preserve the sole exact source declaration for each lemma leaf during the
            # bounded census, so scheduling does not rescan the declaration tree per lemma.
            source_functions: mutable darray[Ast::Decl]
            # Proof-only summaries are certified before callers may consume their ensures.
            # True only when this leaf names one function row in the complete declaration
            # table. The current lemma table lacks owner paths, so ambiguous leaves fail closed.
            unqualified_usable: mutable darray[bool]
            verified: mutable darray[bool]
            verification_reasons: mutable darray[sview]

        struct ProofLemmaTable:
            identity: mutable ProofLemmaTableNames
            parameters: mutable ProofLemmaTableParameters
            contracts: mutable ProofLemmaTableContracts
            termination: mutable ProofLemmaTableTermination
            verification: mutable ProofLemmaTableVerification

        def proof_empty_lemmas() -> ProofLemmaTable:
            return ProofLemmaTable{identity: ProofLemmaTableNames{names: [], name_hashes: [], index_hashes: [], index_values: [], index_ambiguous: []}, parameters: ProofLemmaTableParameters{param_starts: [], param_counts: [], all_params: [], all_has_defaults: [], all_defaults: []}, contracts: ProofLemmaTableContracts{requires_starts: [], requires_counts: [], all_requires: [], ensure_starts: [], ensure_counts: [], all_ensures: []}, termination: ProofLemmaTableTermination{decreases_starts: [], decreases_counts: [], all_decreases: [], decreases_unbounded: [], call_starts: [], call_counts: [], all_calls: [], recursive: [], recursive_component_ids: []}, verification: ProofLemmaTableVerification{source_functions: [], unqualified_usable: [], verified: [], verification_reasons: []}}
