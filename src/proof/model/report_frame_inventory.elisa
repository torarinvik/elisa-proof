# Structural association only. Original frame predicates and full event coverage
# require source-context replay; this does not grant a kernel proof.
extend ElisaProof:
    private:
        def proof_report_frame_owner_count(declarations: darray[Ast::Decl]&, name: sview, line: u32, depth: usize, work: mutable usize&) -> usize:
            return 4097 if depth >= 64
            count: mutable usize = 0
            for declaration in declarations |count, name, line, depth, work|:
                return 4097 if work >= 4096
                work <- work + 1
                match declaration:
                    Ast::Decl.Func(candidate, _, _, _, _, _, position):
                        count <- count + 1 if candidate == name and position.line == line
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        found: usize = proof_report_frame_owner_count(&nested, name, line, depth + 1, work)
                        return 4097 if found > 4096
                        count <- count + found
                    _:
                        pass
            return count

        def proof_report_frame_obligation_associated(report: ProofReport&, entry: ProofObligationEntry) -> bool:
            return false if entry.attempts_count != 1 or entry.attempts_start >= report.goal_attempts.count
            work: mutable usize = 0
            return false if proof_report_frame_owner_count(&report.source_declarations, entry.source_name, entry.source_line, 0, &work) != 1
            attempt = report.goal_attempts[entry.attempts_start]
            expected: sview = "frame-allow" if entry.source_kind == "allow" else "frame-preserve" if entry.source_kind == "preserve" else "frame-spec"
            return false if attempt.name != entry.source_name or attempt.rule != expected or attempt.proven != entry.proven or attempt.has_certificate != entry.proven
            match attempt.goal:
                Ast::Expr.BoolLit(value, _):
                    return value and attempt.facts_count == 0 and attempt.kernel_facts_count == 0
                _:
                    return false
