extend ElisaProof:
    private:
        const PROOF_CHECKED_ACCESS_LOOP_FLOW_DEPTH_LIMIT: usize = 64

        def proof_checked_access_match_arms_have_exit_transfer(arms: darray[Ast::MatchArm]&, work: mutable usize&, depth: usize, nested_loops: usize) -> (complete: bool, found: bool):
            return (false, false) if depth >= PROOF_CHECKED_ACCESS_LOOP_FLOW_DEPTH_LIMIT
            for arm in arms |arm, work, depth, nested_loops|:
                return (false, false) if not proof_report_source_work_charge(1, work)
                guard_transfer: (complete: bool, found: bool) = proof_checked_access_control_expr_has_recovery_transfer(arm.guard, work, depth + 1, nested_loops)
                return (false, false) if not guard_transfer.complete
                return (true, true) if guard_transfer.found
                arm_transfer: (complete: bool, found: bool) = proof_checked_access_loop_has_exit_transfer(arm.body, work, depth + 1, nested_loops)
                return (false, false) if not arm_transfer.complete
                return (true, true) if arm_transfer.found
            (true, false)

        # Keep the loop-transfer walk bounded. The post-loop join includes the zero-iteration
        # entry state and invalidates body aliases whenever any transfer is found, because the
        # collector continues through unreachable statements after break/continue. Nested-loop
        # transfers stay local to their own collector.
        def proof_checked_access_loop_has_exit_transfer(body: darray[Ast::Stmt]&, work: mutable usize&, depth: usize, nested_loops: usize) -> (complete: bool, found: bool):
            return (false, false) if depth >= PROOF_CHECKED_ACCESS_LOOP_FLOW_DEPTH_LIMIT
            for statement in body |statement, work, depth, nested_loops|:
                return (false, false) if not proof_report_source_work_charge(1, work)
                match statement:
                    Ast::Stmt.Return(_, _):
                        return (true, true)
                    Ast::Stmt.Break(_, _) | Ast::Stmt.Continue(_, _):
                        return (true, true) if nested_loops == 0
                    Ast::Stmt.If(condition, yes, no, _):
                        condition_transfer: (complete: bool, found: bool) = proof_checked_access_control_expr_has_recovery_transfer(condition, work, depth + 1, nested_loops)
                        return (false, false) if not condition_transfer.complete
                        return (true, true) if condition_transfer.found
                        yes_transfer: (complete: bool, found: bool) = proof_checked_access_loop_has_exit_transfer(yes, work, depth + 1, nested_loops)
                        no_transfer: (complete: bool, found: bool) = proof_checked_access_loop_has_exit_transfer(no, work, depth + 1, nested_loops)
                        return (false, false) if not yes_transfer.complete or not no_transfer.complete
                        return (true, true) if yes_transfer.found or no_transfer.found
                    Ast::Stmt.Block(_, _, _, nested, _):
                        nested_transfer: (complete: bool, found: bool) = proof_checked_access_loop_has_exit_transfer(nested, work, depth + 1, nested_loops)
                        return (false, false) if not nested_transfer.complete
                        return (true, true) if nested_transfer.found
                    Ast::Stmt.Match(scrutinee, arms, _):
                        scrutinee_transfer: (complete: bool, found: bool) = proof_checked_access_control_expr_has_recovery_transfer(scrutinee, work, depth + 1, nested_loops)
                        return (false, false) if not scrutinee_transfer.complete
                        return (true, true) if scrutinee_transfer.found
                        arms_transfer: (complete: bool, found: bool) = proof_checked_access_match_arms_have_exit_transfer(arms, work, depth + 1, nested_loops)
                        return (false, false) if not arms_transfer.complete
                        return (true, true) if arms_transfer.found
                    Ast::Stmt.While(condition, nested, _):
                        condition_transfer: (complete: bool, found: bool) = proof_checked_access_control_expr_has_recovery_transfer(condition, work, depth + 1, nested_loops + 1)
                        return (false, false) if not condition_transfer.complete
                        return (true, true) if condition_transfer.found
                        nested_transfer: (complete: bool, found: bool) = proof_checked_access_loop_has_exit_transfer(nested, work, depth + 1, nested_loops + 1)
                        return (false, false) if not nested_transfer.complete
                        return (true, true) if nested_transfer.found
                    Ast::Stmt.For(_, _, iterable, nested, _):
                        iterable_transfer: (complete: bool, found: bool) = proof_checked_access_control_expr_has_recovery_transfer(iterable, work, depth + 1, nested_loops)
                        return (false, false) if not iterable_transfer.complete
                        return (true, true) if iterable_transfer.found
                        nested_transfer: (complete: bool, found: bool) = proof_checked_access_loop_has_exit_transfer(nested, work, depth + 1, nested_loops + 1)
                        return (false, false) if not nested_transfer.complete
                        return (true, true) if nested_transfer.found
                    Ast::Stmt.Expr(expression, _):
                        expression_transfer: (complete: bool, found: bool) = proof_checked_access_control_expr_has_recovery_transfer(expression, work, depth + 1, nested_loops)
                        return (false, false) if not expression_transfer.complete
                        return (true, true) if expression_transfer.found
                    Ast::Stmt.Contract(_, expression, _):
                        expression_transfer: (complete: bool, found: bool) = proof_checked_access_control_expr_has_recovery_transfer(expression, work, depth + 1, nested_loops)
                        return (false, false) if not expression_transfer.complete
                        return (true, true) if expression_transfer.found
                    Ast::Stmt.VarDecl(_, type_expression, value, _):
                        type_transfer: (complete: bool, found: bool) = proof_checked_access_control_expr_has_recovery_transfer(type_expression, work, depth + 1, nested_loops)
                        return (false, false) if not type_transfer.complete
                        return (true, true) if type_transfer.found
                        value_transfer: (complete: bool, found: bool) = proof_checked_access_control_expr_has_recovery_transfer(value, work, depth + 1, nested_loops)
                        return (false, false) if not value_transfer.complete
                        return (true, true) if value_transfer.found
                    Ast::Stmt.Assign(target, _, value, _):
                        target_transfer: (complete: bool, found: bool) = proof_checked_access_control_expr_has_recovery_transfer(target, work, depth + 1, nested_loops)
                        return (false, false) if not target_transfer.complete
                        return (true, true) if target_transfer.found
                        value_transfer: (complete: bool, found: bool) = proof_checked_access_control_expr_has_recovery_transfer(value, work, depth + 1, nested_loops)
                        return (false, false) if not value_transfer.complete
                        return (true, true) if value_transfer.found
                    Ast::Stmt.Invalid:
                        return (false, false)
                    _:
                        # Never assume an unrecognized statement cannot transfer control.
                        return (false, false)
            (true, false)

        # A GetElse recovery can transfer control even when it is nested inside a
        # branch/loop control expression. Such transfers bypass the ordinary
        # expression collector, so invalidate aliases before joining those paths.
        def proof_checked_access_control_expr_has_recovery_transfer(expression: Ast::Expr, work: mutable usize&, depth: usize, nested_loops: usize) -> (complete: bool, found: bool):
            return (false, false) if depth >= PROOF_REPLAY_AST_DEPTH_LIMIT or not proof_report_source_work_charge(1, work)
            match expression:
                Ast::Expr.GetElse(value, recovery, _):
                    transfer: (complete: bool, found: bool) = proof_checked_access_loop_has_exit_transfer(recovery, work, depth + 1, nested_loops)
                    return (false, false) if not transfer.complete
                    return (true, true) if transfer.found
                    return proof_checked_access_control_expr_has_recovery_transfer(value, work, depth + 1, nested_loops)
                Ast::Expr.Field(inner, _, _) | Ast::Expr.Scope(inner, _, _) | Ast::Expr.Move(inner, _) | Ast::Expr.RegionNew(inner, _, _) | Ast::Expr.Paren(inner, _) | Ast::Expr.Unary(_, inner, _):
                    return proof_checked_access_control_expr_has_recovery_transfer(inner, work, depth + 1, nested_loops)
                Ast::Expr.Binary(left, _, right, _) | Ast::Expr.Index(left, right, _) | Ast::Expr.Refinement(left, right, _):
                    left_result: (complete: bool, found: bool) = proof_checked_access_control_expr_has_recovery_transfer(left, work, depth + 1, nested_loops)
                    return (false, false) if not left_result.complete
                    return (true, true) if left_result.found
                    return proof_checked_access_control_expr_has_recovery_transfer(right, work, depth + 1, nested_loops)
                Ast::Expr.Slice(object, low, high, _):
                    first: (complete: bool, found: bool) = proof_checked_access_control_expr_has_recovery_transfer(object, work, depth + 1, nested_loops)
                    return (false, false) if not first.complete
                    return (true, true) if first.found
                    second: (complete: bool, found: bool) = proof_checked_access_control_expr_has_recovery_transfer(low, work, depth + 1, nested_loops)
                    return (false, false) if not second.complete
                    return (true, true) if second.found
                    return proof_checked_access_control_expr_has_recovery_transfer(high, work, depth + 1, nested_loops)
                Ast::Expr.Call(callee, arguments, _, _) | Ast::Expr.IndexN(callee, arguments, _):
                    callee_result: (complete: bool, found: bool) = proof_checked_access_control_expr_has_recovery_transfer(callee, work, depth + 1, nested_loops)
                    return (false, false) if not callee_result.complete
                    return (true, true) if callee_result.found
                    for argument in arguments |work, depth, nested_loops|:
                        result: (complete: bool, found: bool) = proof_checked_access_control_expr_has_recovery_transfer(argument, work, depth + 1, nested_loops)
                        return (false, false) if not result.complete
                        return (true, true) if result.found
                    return (true, false)
                Ast::Expr.StaticEffectCall(effect_type, _, _, arguments, _, _):
                    effect_transfer: (complete: bool, found: bool) = proof_checked_access_control_expr_has_recovery_transfer(effect_type, work, depth + 1, nested_loops)
                    return (false, false) if not effect_transfer.complete
                    return (true, true) if effect_transfer.found
                    for argument in arguments |work, depth, nested_loops|:
                        result: (complete: bool, found: bool) = proof_checked_access_control_expr_has_recovery_transfer(argument, work, depth + 1, nested_loops)
                        return (false, false) if not result.complete
                        return (true, true) if result.found
                    return (true, false)
                Ast::Expr.Array(elements, _) | Ast::Expr.Tuple(elements, _) | Ast::Expr.SetLit(elements, _):
                    for element in elements |work, depth, nested_loops|:
                        result: (complete: bool, found: bool) = proof_checked_access_control_expr_has_recovery_transfer(element, work, depth + 1, nested_loops)
                        return (false, false) if not result.complete
                        return (true, true) if result.found
                    return (true, false)
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |work, depth, nested_loops|:
                        key_result: (complete: bool, found: bool) = proof_checked_access_control_expr_has_recovery_transfer(entry.key, work, depth + 1, nested_loops)
                        return (false, false) if not key_result.complete
                        return (true, true) if key_result.found
                        value_result: (complete: bool, found: bool) = proof_checked_access_control_expr_has_recovery_transfer(entry.value, work, depth + 1, nested_loops)
                        return (false, false) if not value_result.complete
                        return (true, true) if value_result.found
                    return (true, false)
                Ast::Expr.Construct(type_expression, fields, _) | Ast::Expr.RecordUpdate(type_expression, fields, _):
                    base_result: (complete: bool, found: bool) = proof_checked_access_control_expr_has_recovery_transfer(type_expression, work, depth + 1, nested_loops)
                    return (false, false) if not base_result.complete
                    return (true, true) if base_result.found
                    for field in fields |work, depth, nested_loops|:
                        result: (complete: bool, found: bool) = proof_checked_access_control_expr_has_recovery_transfer(field.value, work, depth + 1, nested_loops)
                        return (false, false) if not result.complete
                        return (true, true) if result.found
                    return (true, false)
                Ast::Expr.If(condition, yes, no, _):
                    condition_result: (complete: bool, found: bool) = proof_checked_access_control_expr_has_recovery_transfer(condition, work, depth + 1, nested_loops)
                    return (false, false) if not condition_result.complete
                    return (true, true) if condition_result.found
                    yes_result: (complete: bool, found: bool) = proof_checked_access_control_expr_has_recovery_transfer(yes, work, depth + 1, nested_loops)
                    return (false, false) if not yes_result.complete
                    return (true, true) if yes_result.found
                    return proof_checked_access_control_expr_has_recovery_transfer(no, work, depth + 1, nested_loops)
                Ast::Expr.Match(scrutinee, arms, _) | Ast::Expr.Catch(scrutinee, arms, _):
                    scrutinee_result: (complete: bool, found: bool) = proof_checked_access_control_expr_has_recovery_transfer(scrutinee, work, depth + 1, nested_loops)
                    return (false, false) if not scrutinee_result.complete
                    return (true, true) if scrutinee_result.found
                    return proof_checked_access_match_arms_have_exit_transfer(arms, work, depth + 1, nested_loops)
                Ast::Expr.Comprehension(_, iterable, condition, value, _):
                    iterable_result: (complete: bool, found: bool) = proof_checked_access_control_expr_has_recovery_transfer(iterable, work, depth + 1, nested_loops)
                    return (false, false) if not iterable_result.complete
                    return (true, true) if iterable_result.found
                    condition_result: (complete: bool, found: bool) = proof_checked_access_control_expr_has_recovery_transfer(condition, work, depth + 1, nested_loops)
                    return (false, false) if not condition_result.complete
                    return (true, true) if condition_result.found
                    return proof_checked_access_control_expr_has_recovery_transfer(value, work, depth + 1, nested_loops)
                Ast::Expr.Block(statements, value, _, _):
                    statements_result: (complete: bool, found: bool) = proof_checked_access_loop_has_exit_transfer(statements, work, depth + 1, nested_loops)
                    return (false, false) if not statements_result.complete
                    return (true, true) if statements_result.found
                    return proof_checked_access_control_expr_has_recovery_transfer(value, work, depth + 1, nested_loops)
                Ast::Expr.Absent | Ast::Expr.Ident(_, _) | Ast::Expr.StringLit(_, _) | Ast::Expr.CharLit(_, _) | Ast::Expr.FloatLit(_, _) | Ast::Expr.IntLit(_, _) | Ast::Expr.BoolLit(_, _) | Ast::Expr.ShorthandMember(_, _) | Ast::Expr.Lambda(_, _, _):
                    return (true, false)
                _:
                    # Complex control-bearing expressions are unsupported here;
                    # fail closed so an unseen nested recovery cannot retain aliases.
                    return (false, false)
