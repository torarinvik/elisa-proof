extend ElisaProof:
    private:
        # Run-local lookup for untrusted linear hints. The slot table stores the first record
        # for each goal id; a bounded collision path can disable hints without changing proof
        # decisions because every hint still needs ordinary certification and replay.
        struct ProofLinearHintIndex:
            slots: mutable darray[usize] = []
            goal_ids: mutable darray[i64] = []
            record_starts: mutable darray[usize] = []
            row_count: mutable usize = 0
            work_used: mutable usize = 0
            ready: mutable bool = false
            disabled: mutable bool = false
