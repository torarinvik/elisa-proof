# Flat checked-view attempt diagnostics; deliberately excludes the nested AST goal.
extend ElisaProof:
    public:
        struct ProofCheckedViewAttemptDiagnostic[@r]:
            index: usize
            budget_exhausted: bool
            facts_start: usize
            facts_count: usize
            kernel_goal: usize
            kernel_facts_start: usize
            kernel_facts_count: usize
            line: u32
            name: sview
            rule: sview
            source_phase: sview
            float_mode: bool
            loop_source_position: Ast::Pos
            source_call_position: Ast::Pos
            source_call_obligation_selected: bool
            source_call_requires: bool
            source_call_requires_index: usize
            source_call_callee_name: sview
            source_call_callee_module: sview
            source_call_callee_line: u32
            source_call_callee_offset: u32
            loop_transfer_position: Ast::Pos
            # Producer-reported success is diagnostic only; use the receipt verdict tuple.
            producer_claim: bool
            has_certificate: bool
            certificate_index: usize
            owner_function_line: u32
            owner_function_offset: u32

        # Return a flat snapshot paired with every authority bit for that exact row.
        # The mutable legacy report row and nested AST storage never escape as diagnostics.
        # `kernel_replayed` is replay status alone; `proven` includes checked source admission.
        def proof_checked_view_attempt_diagnostic[@view](view: ProofCheckedView[view]& @view, attempt_index: usize) -> (available: bool, attempt: ProofCheckedViewAttemptDiagnostic[view], kernel_replayed: bool, source_goal_admissible: bool, source_facts_admissible: bool, proven: bool):
            empty: ProofCheckedViewAttemptDiagnostic[view] = ProofCheckedViewAttemptDiagnostic[view]{index: 0, budget_exhausted: false, facts_start: 0, facts_count: 0, kernel_goal: 0, kernel_facts_start: 0, kernel_facts_count: 0, line: 0, name: "", rule: "", source_phase: "", float_mode: false, loop_source_position: Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}, source_call_position: Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}, source_call_obligation_selected: false, source_call_requires: false, source_call_requires_index: 0, source_call_callee_name: "", source_call_callee_module: "", source_call_callee_line: 0, source_call_callee_offset: 0, loop_transfer_position: Ast::Pos{line: 0, column: 0, offset: 0, end_line: 0, end_column: 0, end_offset: 0}, producer_claim: false, has_certificate: false, certificate_index: 0, owner_function_line: 0, owner_function_offset: 0}
            return (false, empty, false, false, false, false) if not proof_checked_view_source_validated(view) or not view.receipt.source_goal_statuses_complete or not view.receipt.source_attempt_fact_statuses_complete or view.report.results.goal_attempts.count != view.attempt_rows.count or view.receipt.attempt_statuses.count != view.attempt_rows.count or view.receipt.attempt_proven_statuses.count != view.attempt_rows.count or view.receipt.source_goal_statuses.count != view.attempt_rows.count or view.receipt.source_attempt_fact_statuses.count != view.attempt_rows.count or attempt_index >= view.attempt_rows.count or not proof_checked_view_attempt_row_matches(view, attempt_index)
            row: ProofGoalAttempt = view.attempt_rows[attempt_index]
            attempt: ProofCheckedViewAttemptDiagnostic[view] = ProofCheckedViewAttemptDiagnostic[view]{index: attempt_index, budget_exhausted: row.budget_exhausted, facts_start: row.facts_start, facts_count: row.facts_count, kernel_goal: row.kernel_goal, kernel_facts_start: row.kernel_facts_start, kernel_facts_count: row.kernel_facts_count, line: row.line, name: row.name, rule: row.rule, source_phase: row.source_phase, float_mode: row.float_mode, loop_source_position: row.loop_source_position, source_call_position: row.source_call_position, source_call_obligation_selected: row.source_call_obligation_selected, source_call_requires: row.source_call_requires, source_call_requires_index: row.source_call_requires_index, source_call_callee_name: row.source_call_callee_name, source_call_callee_module: row.source_call_callee_module, source_call_callee_line: row.source_call_callee_line, source_call_callee_offset: row.source_call_callee_offset, loop_transfer_position: row.loop_transfer_position, producer_claim: row.producer_proven, has_certificate: row.has_certificate, certificate_index: row.certificate_index, owner_function_line: row.owner_function_line, owner_function_offset: row.owner_function_offset}
            goal_ok: bool = view.receipt.source_goal_statuses[attempt_index]
            facts_ok: bool = view.receipt.source_attempt_fact_statuses[attempt_index]
            replayed: bool = proof_replay_receipt_attempt_status(view.receipt, attempt_index)
            proven: bool = proof_replay_receipt_attempt_is_proven(view.receipt, attempt_index)
            (true, attempt, replayed, goal_ok, facts_ok, proven)
