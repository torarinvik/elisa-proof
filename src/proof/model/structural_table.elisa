# Source and replay metadata for structural-recursion checking.
extend ElisaProof:
    public:
        struct ProofStructuralTable:
            names: mutable darray[sview] = []
            function_name_index_hashes: mutable darray[u32] = []
            function_name_index_values: mutable darray[usize] = []
            function_name_index_ambiguous: mutable darray[bool] = []
            function_name_index_valid: mutable bool = false
            subject_positions: mutable darray[usize] = []
            subject_types: mutable darray[sview] = []
            formal_starts: mutable darray[usize] = []
            formal_counts: mutable darray[usize] = []
            formal_names: mutable darray[sview] = []
            component_ids: mutable darray[usize] = []
            members: mutable darray[bool] = []
            verified_members: mutable darray[bool] = []
            verified_names: mutable darray[sview] = []
            # Fresh identities for lexical structural binders. Names alone are insufficient when
            # a pattern binder shadows the recursive parameter (`Node(value)` inside a function
            # whose parameter is also named `value`).
            identity_next: mutable usize = 0
