extend ElisaProof:
    public:
        def proof_empty_functions() -> ProofFunctionTable:
            empty_type_index: ProofTypeAuditIndex = ProofTypeAuditIndex{entries: [], bucket_heads: [], next_indices: [], complete: true}
            empty_enum_index: ProofEnumIndex = ProofEnumIndex{names: [], name_hashes: [], const_enums: [], declarations: [], root_level: [], owners: [], bucket_heads: [], next_indices: [], complete: true}
            empty_frame_index: ProofFrameAnnotationIndex = ProofFrameAnnotationIndex{owner_names: [], owner_hashes: [], slot_values: [], head_indices: [], tail_indices: [], annotation_indices: [], next_indices: []}
            empty_alias_index: ProofModuleAliasIndex = ProofModuleAliasIndex{names: [], targets: [], scopes: [], lines: [], offsets: [], alias_lookup_hashes: [], alias_lookup_values: [], alias_lookup_ambiguous: [], global_alias_lookup_hashes: [], global_alias_lookup_values: [], function_lookup_hashes: [], function_lookup_values: [], function_lookup_ambiguous: [], function_lookup_complete: false, complete: false}
            empty_externs: ProofFunctionExterns = ProofFunctionExterns{extern_signatures: [], extern_index_hashes: [], extern_index_values: [], extern_index_ambiguous: [], extern_index_callable: [], custom_cast_hook_present: false, direct_extern_contract_unsafe: [], reachable_extern_contract_unsafe: [], extern_contract_analysis_complete: false}
            empty_type_indexes: ProofFunctionTypeIndexes = ProofFunctionTypeIndexes{type_audit_index: empty_type_index, enum_index: empty_enum_index, frame_annotation_index: empty_frame_index}
            empty_lookup_source: ProofFunctionLookupSource = ProofFunctionLookupSource{names: [], lines: [], offsets: [], owner_modules: [], module_aliases: empty_alias_index, module_prefixes: [], declaration_path_starts: [], declaration_path_counts: [], all_declaration_path: []}
            empty_lookup_indexes: ProofFunctionLookupIndexes = ProofFunctionLookupIndexes{name_hashes: [], index_hashes: [], index_values: [], index_ambiguous: [], index_duplicate_next: [], index_duplicate_tails: [], declaration_line_index_hashes: [], declaration_line_index_values: [], declaration_line_index_ambiguous: [], declaration_line_index_count: 0, declaration_line_index_valid: false}
            empty_lookup_work: ProofFunctionLookupWork = ProofFunctionLookupWork{module_resolution_work_used: 0, module_resolution_work_exhausted: false, runtime_call_analysis_source_work: 0}
            empty_lookup: ProofFunctionLookup = ProofFunctionLookup{source: empty_lookup_source, indexes: empty_lookup_indexes, work: empty_lookup_work}
            empty_parameter_metadata: ProofFunctionParameterMetadata = ProofFunctionParameterMetadata{param_starts: [], param_counts: [], all_params: [], all_parameter_mutable: [], all_has_defaults: [], all_defaults: [], all_parameter_references: [], all_parameter_mutable_references: [], all_parameter_type_marker_complete: [], all_parameter_may_contain_float: [], all_parameter_signed_widths: [], all_parameter_target_reference_free: [], all_parameter_target_borrowed_view_free: []}
            empty_region_metadata: ProofFunctionRegionMetadata = ProofFunctionRegionMetadata{region_param_starts: [], region_param_counts: [], all_region_params: [], all_param_region_starts: [], all_param_regions: []}
            empty_local_metadata: ProofFunctionLocalMetadata = ProofFunctionLocalMetadata{local_region_binding_names: [], local_region_binding_regions: [], local_region_binding_lines: [], mutable_local_names: [], mutable_local_offsets: [], loop_accumulator_names: [], loop_accumulator_offsets: []}
            empty_parameters: ProofFunctionParameters = ProofFunctionParameters{metadata: empty_parameter_metadata, regions: empty_region_metadata, locals: empty_local_metadata}
            empty_returns: ProofFunctionReturns = ProofFunctionReturns{return_references: [], return_reference_free: [], return_borrowed_view_free: [], return_mutable_references: [], return_type_marker_complete: [], return_reference_parameters: [], return_regions: [], return_sviews: [], return_types: [], return_scalar: [], return_label_starts: [], return_label_counts: [], all_return_labels: []}
            empty_obligations: ProofFunctionContractObligations = ProofFunctionContractObligations{requires_starts: [], requires_counts: [], all_requires: [], ensure_starts: [], ensure_counts: [], all_ensures: []}
            empty_frames: ProofFunctionFrameConditions = ProofFunctionFrameConditions{changes_starts: [], changes_counts: [], all_changes: [], preserves_starts: [], preserves_counts: [], all_preserves: []}
            empty_termination: ProofFunctionTerminationMetadata = ProofFunctionTerminationMetadata{decreases_starts: [], decreases_counts: [], all_decreases: [], decreases_unbounded: [], structural: [], structural_subject_positions: [], structural_subject_types: []}
            empty_contracts: ProofFunctionContracts = ProofFunctionContracts{obligations: empty_obligations, frames: empty_frames, termination: empty_termination}
            empty_call_graph: ProofFunctionCallGraph = ProofFunctionCallGraph{call_starts: [], call_counts: [], all_calls: [], all_call_qualifiers: [], all_call_callee_sources: [], all_call_expressions: [], all_call_positions: [], all_call_targets: [], direct_unresolved_calls: [], reachable_unresolved_calls: [], current_caller: 0, current_caller_is_lemma: false, current_caller_module: ""}
            empty_summaries: ProofFunctionSummaries = ProofFunctionSummaries{recursive: [], recursive_component_ids: [], direct_pure: [], pure: [], deterministic: [], effect_starts: [], effect_counts: [], all_effects: [], effects_declared: [], verified: [], verification_reasons: [], resource_summary_roots: [], resource_summary_root_valid: []}
            return ProofFunctionTable{externs: empty_externs, type_indexes: empty_type_indexes, lookup: empty_lookup, parameters: empty_parameters, returns: empty_returns, contracts: empty_contracts, call_graph: empty_call_graph, summaries: empty_summaries}
