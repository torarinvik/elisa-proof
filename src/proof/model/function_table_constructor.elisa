extend ElisaProof:
    public:
        def proof_empty_functions() -> ProofFunctionTable:
            empty_type_index: ProofTypeAuditIndex = ProofTypeAuditIndex{entries: [], bucket_heads: [], next_indices: [], complete: true}
            empty_enum_index: ProofEnumIndex = ProofEnumIndex{names: [], name_hashes: [], bucket_heads: [], next_indices: [], complete: true}
            empty_frame_index: ProofFrameAnnotationIndex = ProofFrameAnnotationIndex{owner_names: [], owner_hashes: [], slot_values: [], head_indices: [], tail_indices: [], annotation_indices: [], next_indices: []}
            return ProofFunctionTable{extern_signatures: [], type_audit_index: empty_type_index, enum_index: empty_enum_index, frame_annotation_index: empty_frame_index, names: [], declaration_path_starts: [], declaration_path_counts: [], all_declaration_path: [], name_hashes: [], index_hashes: [], index_values: [], param_starts: [], param_counts: [], all_params: [], all_parameter_mutable: [], all_has_defaults: [], all_defaults: [], all_parameter_references: [], all_parameter_mutable_references: [], all_parameter_may_contain_float: [], all_parameter_target_reference_free: [], region_param_starts: [], region_param_counts: [], all_region_params: [], all_param_region_starts: [], all_param_regions: [], local_region_binding_names: [], local_region_binding_regions: [], local_region_binding_lines: [], return_references: [], return_reference_free: [], return_mutable_references: [], return_reference_parameters: [], return_regions: [], return_sviews: [], return_scalar: [], requires_starts: [], requires_counts: [], all_requires: [], ensure_starts: [], ensure_counts: [], all_ensures: [], changes_starts: [], changes_counts: [], all_changes: [], preserves_starts: [], preserves_counts: [], all_preserves: [], decreases_starts: [], decreases_counts: [], all_decreases: [], decreases_unbounded: [], structural: [], structural_subject_positions: [], structural_subject_types: [], call_starts: [], call_counts: [], all_calls: [], recursive: [], recursive_component_ids: [], direct_pure: [], pure: [], effect_starts: [], effect_counts: [], all_effects: [], effects_declared: [], verified: [], verification_reasons: []}
