# Private source-derived resolver snapshot used only while publishing facts. The
# resolver rows retain declaration and module identity; leaf names alone never
# distinguish repeated declarations.
extend ElisaProof:
    private:
        struct ProofFactCallShapeSnapshotStatus:
            private:
                initialized: mutable bool = false
                complete: mutable bool = false
                source_check_active: mutable bool = false
                source_identity: mutable uintptr = 0
                source_fingerprint: mutable u32 = 0
                active_caller: mutable usize = 0
                active_caller_line: mutable u32 = 0
                lookup_work_used: mutable usize = 0
                lookup_work_exhausted: mutable bool = false
                lookup_budget_reported: mutable bool = false
                custom_cast_hook_present: mutable bool = false

        struct ProofFactCallShapeSnapshotFunctions:
            private:
                function_names: mutable darray[sview] = []
                function_lines: mutable darray[u32] = []
                owner_modules: mutable darray[sview] = []
                module_aliases: mutable ProofModuleAliasIndex = ProofModuleAliasIndex{names: [], targets: [], scopes: [], lines: [], offsets: [], alias_lookup_hashes: [], alias_lookup_values: [], alias_lookup_ambiguous: [], global_alias_lookup_hashes: [], global_alias_lookup_values: [], function_lookup_hashes: [], function_lookup_values: [], function_lookup_ambiguous: [], function_lookup_complete: false, complete: false}
                module_prefixes: mutable darray[usize] = []
                declaration_path_starts: mutable darray[usize] = []
                declaration_path_counts: mutable darray[usize] = []
                all_declaration_path: mutable darray[usize] = []
                name_hashes: mutable darray[u32] = []
                index_hashes: mutable darray[u32] = []
                index_values: mutable darray[usize] = []
                index_ambiguous: mutable darray[bool] = []

        struct ProofFactCallShapeSnapshotReturns:
            private:
                return_scalar: mutable darray[bool] = []
                return_pure: mutable darray[bool] = []
                return_deterministic: mutable darray[bool] = []
                return_verified: mutable darray[bool] = []
                return_verification_reasons: mutable darray[sview] = []

        struct ProofFactCallShapeSnapshotSignatures:
            private:
                param_starts: mutable darray[usize] = []
                param_counts: mutable darray[usize] = []
                all_params: mutable darray[sview] = []
                signature_contract_starts: mutable darray[usize] = []
                signature_contract_counts: mutable darray[usize] = []
                all_signature_contracts: mutable darray[Ast::Expr] = []

        struct ProofFactCallShapeSnapshotExterns:
            private:
                extern_names: mutable darray[sview] = []
                extern_arities: mutable darray[usize] = []
                extern_callable: mutable darray[bool] = []
                extern_index_hashes: mutable darray[u32] = []
                extern_index_values: mutable darray[usize] = []
                extern_index_ambiguous: mutable darray[bool] = []
                extern_index_callable: mutable darray[bool] = []

        struct ProofFactCallShapeSnapshotShadowQueries:
            private:
                shadow_query_callers: mutable darray[usize] = []
                shadow_query_hashes: mutable darray[u32] = []
                shadow_query_offsets: mutable darray[u32] = []
                shadow_query_names: mutable darray[sview] = []
                shadow_query_results: mutable darray[bool] = []
                shadow_query_index: mutable darray[usize] = []

        struct ProofFactCallShapeSnapshot:
            status: mutable ProofFactCallShapeSnapshotStatus = ProofFactCallShapeSnapshotStatus{}
            functions: mutable ProofFactCallShapeSnapshotFunctions = ProofFactCallShapeSnapshotFunctions{}
            returns: mutable ProofFactCallShapeSnapshotReturns = ProofFactCallShapeSnapshotReturns{}
            signatures: mutable ProofFactCallShapeSnapshotSignatures = ProofFactCallShapeSnapshotSignatures{}
            externs: mutable ProofFactCallShapeSnapshotExterns = ProofFactCallShapeSnapshotExterns{}
            shadow_queries: mutable ProofFactCallShapeSnapshotShadowQueries = ProofFactCallShapeSnapshotShadowQueries{}
