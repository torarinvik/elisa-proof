# Work budgets for proof analyses. Most are reset per function; cumulative scopes are
# stated at their fields. Exceeding a bound only loses completeness, never trust.
extend ElisaProof:
    public:
        struct ProofAnalysisBudgets:
            # Recursive frame/call analysis.
            frame_call_steps: mutable usize = 0
            # Per-function AST work for source operator scans in frame conversions.
            frame_call_source_work: mutable usize = 0
            frame_call_reported: mutable bool = false
            resource_steps: mutable usize = 0
            resource_reported: mutable bool = false
            resource_pattern_work: mutable usize = 0
            resource_pattern_reported: mutable bool = false
            # Recursive control-flow state exploration.
            return_steps: mutable usize = 0
            return_step_budget: mutable usize = 0
            return_reported: mutable bool = false
            return_fact_state_budget: mutable usize = 0
            # Per-function source work spent expanding symbolic values in return-body statements.
            return_source_work: mutable usize = 0
            return_source_reported: mutable bool = false
            # Cumulative report-wide work for direct pattern types and typed literal scans.
            pattern_source_type_work: mutable usize = 0
            # Cumulative report-wide work deriving verified pure-call summaries in guards.
            guard_call_summary_source_work: mutable usize = 0
            guard_call_summary_reported: mutable bool = false
            # Shared source-work state across a lemma's purity pass and later return-body
            # checking, where the same lemma may be applied repeatedly.
            lemma_purity_source_work: mutable usize = 0
            lemma_purity_source_reported: mutable bool = false
            # Per-function source-work state shared by sibling assert-by blocks.
            assert_by_source_work: mutable usize = 0
            assert_by_source_reported: mutable bool = false
            # Measurement only, never read by a decision: control-flow statements and branch
            # arms admitted by the step budget, and the largest fact state seen at one of them.
            measured_control_flow_steps: mutable usize = 0
            measured_live_facts_peak: mutable usize = 0
