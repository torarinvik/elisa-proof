# Budget notes, kernel encoding, findings and goal-attempt recording on the proof report.
extend ElisaProof:
    public:
        def proof_kernel_budget_note(report: mutable ProofReport&, name: sview) -> void:
            report.kernel_budget_exhausted <- true
            if not report.kernel_budget_reported:
                report.kernel_budget_reported <- true
                proof_add_finding(report, "kernel-arena-budget", 0, name, "kernel certificate arena exceeded its bounded storage budget")

        # Replay-side provenance tables are report-owned storage too. Keep their flat appends
        # under the same canonical bound before `resize`/`extend` can allocate. The first check
        # avoids unsigned subtraction underflow when a malformed report already exceeds the
        # budget.
        def proof_kernel_report_append_allowed(report: mutable ProofReport&, current: usize, addition: usize, name: sview) -> bool:
            return true if current <= ElisaProofKernelCore::PROOF_KERNEL_NODE_BUDGET and addition <= ElisaProofKernelCore::PROOF_KERNEL_NODE_BUDGET - current
            proof_kernel_budget_note(report, name)
            return false

        def proof_kernel_encode_annotated_checked(expression: Ast::Expr, report: mutable ProofReport&, name: sview) -> (known: bool, root: usize):
            return (false, 0) if report.kernel_budget_exhausted
            if report.kernel_nodes.count >= ElisaProofKernelCore::PROOF_KERNEL_NODE_BUDGET or report.kernel_children.count >= ElisaProofKernelCore::PROOF_KERNEL_CHILD_BUDGET:
                proof_kernel_budget_note(report, name)
                return (false, 0)
            node_start: usize = report.kernel_nodes.count
            child_start: usize = report.kernel_children.count
            encoded: usize = proof_kernel_encode_annotated(expression, &report.kernel_nodes, &report.kernel_children, report.source_annotations)
            if report.kernel_nodes.count > ElisaProofKernelCore::PROOF_KERNEL_NODE_BUDGET or report.kernel_children.count > ElisaProofKernelCore::PROOF_KERNEL_CHILD_BUDGET:
                report.kernel_nodes <- report.kernel_nodes.truncate(node_start)
                report.kernel_children <- report.kernel_children.truncate(child_start)
                proof_kernel_budget_note(report, name)
                return (false, 0)
            return (false, encoded) if encoded >= report.kernel_nodes.count
            return (true, proof_kernel_intern_encoded(report, node_start, child_start, encoded))

        def proof_kernel_encode_expression_checked(expression: Ast::Expr, report: mutable ProofReport&, name: sview) -> (known: bool, root: usize):
            return (false, 0) if report.kernel_budget_exhausted
            if report.kernel_nodes.count >= ElisaProofKernelCore::PROOF_KERNEL_NODE_BUDGET or report.kernel_children.count >= ElisaProofKernelCore::PROOF_KERNEL_CHILD_BUDGET:
                proof_kernel_budget_note(report, name)
                return (false, 0)
            node_start: usize = report.kernel_nodes.count
            child_start: usize = report.kernel_children.count
            encoded: usize = proof_kernel_encode_expression(expression, &report.kernel_nodes, &report.kernel_children)
            if report.kernel_nodes.count > ElisaProofKernelCore::PROOF_KERNEL_NODE_BUDGET or report.kernel_children.count > ElisaProofKernelCore::PROOF_KERNEL_CHILD_BUDGET:
                report.kernel_nodes <- report.kernel_nodes.truncate(node_start)
                report.kernel_children <- report.kernel_children.truncate(child_start)
                proof_kernel_budget_note(report, name)
                return (false, 0)
            return (false, encoded) if encoded >= report.kernel_nodes.count
            return (true, proof_kernel_intern_encoded(report, node_start, child_start, encoded))

        # Mark the most recent goal attempt as ended by a resource limit, and reclassify its
        # diagnostic from "unknown" to "timeout" so a client can tell an undecided obligation from
        # one the kernel decided it could not prove.
        def proof_mark_latest_attempt_exhausted(report: mutable ProofReport&, exhausted: bool) -> void:
            return if not exhausted or report.goal_attempts.count == 0
            report.goal_attempts[report.goal_attempts.count - 1].budget_exhausted <- true

        def proof_latest_attempt_exhausted(report: ProofReport&) -> bool:
            return false if report.goal_attempts.count == 0
            return report.goal_attempts[report.goal_attempts.count - 1].budget_exhausted

        def proof_finding_status(kind: sview) -> sview:
            return when kind:
                "borrow-alias-conflict" | "borrow-move-conflict" | "borrow-mutable-source" | "borrow-readonly-write" | "borrow-write-conflict" | "getelse-recovery-nonterminating" | "resource-use-after-move" | "region-use-after-destroy" | "frame-preserve-violated" | "frame-preserve-write" | "frame-write-outside" | "frame-call-outside" -> "disproved"
                "borrow-call-opaque" | "borrow-call-summary-unsupported" | "borrow-contract-unsupported" | "borrow-escape" | "borrow-source-opaque" | "call-old-opaque" | "call-result-unbound" | "captured-block-unsupported" | "catch-arm-unsupported" | "contract-call-unsupported" | "contract-expression-unsupported" | "contract-proposition-type" | "contract-resource-unsupported" | "control-flow-unsupported" | "control-flow-analysis-budget" | "declaration-unsupported" | "expression-unsupported" | "frame-call-opaque" | "frame-expression-opaque" | "frame-preserve-opaque" | "frame-spec-invalid" | "frame-spec-opaque" | "frame-write-opaque" | "function-summary-unverified" | "import-error" | "index-bounds-opaque" | "kernel-arena-budget" | "kernel-certificate-invalid" | "lemma-impure" | "lemma-malformed" | "lemma-recursive-unsupported" | "lemma-result-unbound" | "lemma-return" | "loop-condition-opaque" | "loop-decreases-malformed" | "loop-invariant-scope" | "parallel-control-flow-unsupported" | "parallel-state-unsupported" | "parse-error" | "pattern-unsupported" | "proof-impure" | "proof-malformed" | "proof-internal-name" | "recursive-summary-unsupported" | "slice-bounds-opaque" | "statement-unsupported" | "region-alias-unsupported" | "region-allocation-unsupported" | "region-destroy-unsupported" | "region-expression-unsupported" | "region-return-escape" | "region-return-witness-unsupported" | "region-scope-unsupported" | "region-store-escape" | "effect-call-opaque" | "effect-row-abstract" | "frame-analysis-budget" | "resource-analysis-budget" | "resource-expression-depth" | "semantic-analysis-depth" -> "unsupported"
                "effect-row-exceeded" -> "disproved"
                _ -> "unknown"

        # A finding takes the owner of the function being checked only when it names that
        # function; one naming anything else stays unowned and so counts against every row.
        def proof_finding_owner(report: ProofReport&, name: sview) -> sview:
            return report.finding_owner if name == report.finding_function else ""

        def proof_add_finding(report: mutable ProofReport&, kind: sview, line: u32, name: sview, message: sview) -> void:
            empty: mutable darray[Ast::Expr] = []
            proof_add_finding_with_counterexample(report, kind, line, name, message, &empty, false)

        def proof_add_budget_finding(report: mutable ProofReport&, kind: sview, line: u32, name: sview, message: sview, dimension: sview, observed: usize, limit: usize) -> void:
            proof_add_finding(report, kind, line, name, message)
            if report.findings.count > 0:
                finding_index: usize = report.findings.count - 1
                report.findings[finding_index].budget_dimension <- dimension
                report.findings[finding_index].budget_observed <- observed
                report.findings[finding_index].budget_limit <- limit

        # Record a diagnostic for the most recently emitted logical goal and bind it by stable
        # goal ID. Line/name matching is insufficient when one expression generates several
        # obligations (for example lower and upper index bounds on the same source line).
        def proof_add_latest_goal_finding(report: mutable ProofReport&, kind: sview, line: u32, name: sview, message: sview) -> void:
            proof_add_finding(report, kind, line, name, message)
            if report.goal_attempts.count > 0 and report.findings.count > 0:
                report.findings[report.findings.count - 1].goal_id <- report.goal_attempts.count - 1
                report.findings[report.findings.count - 1].has_goal <- true

        def proof_add_finding_with_counterexample(report: mutable ProofReport&, kind: sview, line: u32, name: sview, message: sview, counterexample: darray[Ast::Expr]&, counterexample_found: bool) -> void:
            start: usize = report.counterexample_facts.count
            report.counterexample_facts.extend(counterexample)
            finding_status: mutable sview = proof_finding_status(kind)
            finding_status <- "disproved" if counterexample_found
            report.findings <- report.findings.push(ProofFinding{kind: kind, status: finding_status, line: line, name: name, owner: proof_finding_owner(report, name), message: message, budget_dimension: "", budget_observed: 0, budget_limit: 0, counterexample_start: start, counterexample_count: counterexample.count, counterexample_found: counterexample_found, goal_id: 0, has_goal: false})
            report.failed <- report.failed + 1

        def proof_obligation(report: mutable ProofReport&, proven: bool) -> void:
            report.obligations <- report.obligations + 1
            report.proven <- report.proven + 1 if proven

        # Certificates carry only facts that entered the current state through a recorded
        # transition. The body checker may keep an opaque/invalid symbolic placeholder after a
        # failed substitution so later obligations remain visible, but such a placeholder is not
        # an admissible certificate premise. Omitting it here is conservative: if the goal relied
        # on that value, independent replay will fail instead of treating it as an axiom.
        #
        # This runs for every premise of every attempt against every trace of the function, and
        # `proof_expr_equal` re-validates both whole terms on each call. An unsupported fact
        # equals no trace, so it is rejected once up front; and a trace whose root (under any
        # parentheses) differs in a way `proof_expr_equal` would reject is skipped without the
        # full comparison. Both are exact: the same index is returned as by the plain scan.
        def proof_certificate_fact_trace_index(report: ProofReport&, fact: Ast::Expr, owner: sview) -> usize:
            return report.fact_traces.count if not proof_kernel_expression_supported(fact)
            fact_root: Ast::Expr = proof_strip_parens(fact)
            start: mutable usize = report.fact_trace_active_start
            start <- 0 if start > report.fact_traces.count
            for index in start..<report.fact_traces.count |index, report, fact, fact_root, owner|:
                trace: ProofFactTrace = report.fact_traces[index]
                continue if trace.name != owner or not proof_trace_root_may_equal(proof_strip_parens(trace.expression), fact_root)
                return index if proof_expr_equal(trace.expression, fact)
            return report.fact_traces.count

        # False only when `proof_expr_equal` must be false: both roots (parentheses stripped, as
        # that comparator strips them) are common shapes that differ in variant or root payload.
        # Anything else, including a stripped-to-Invalid deep chain, defers to the comparator.
        def proof_trace_root_may_equal(left: Ast::Expr, right: Ast::Expr) -> bool:
            left_tag: i64 = proof_trace_root_tag(left)
            right_tag: i64 = proof_trace_root_tag(right)
            return true if left_tag == 0 or right_tag == 0
            return false if left_tag != right_tag
            match left:
                Ast::Expr.Binary(_, operator, _, _):
                    match right:
                        Ast::Expr.Binary(_, other_operator, _, _):
                            return operator == other_operator
                        _:
                            return true
                Ast::Expr.Unary(operator, _, _):
                    match right:
                        Ast::Expr.Unary(other_operator, _, _):
                            return operator == other_operator
                        _:
                            return true
                Ast::Expr.Ident(name, _):
                    match right:
                        Ast::Expr.Ident(other, _):
                            return name == other
                        _:
                            return true
                Ast::Expr.IntLit(value, _):
                    match right:
                        Ast::Expr.IntLit(other, _):
                            return value == other
                        _:
                            return true
                _:
                    return true
            return true

        def proof_trace_root_tag(expression: Ast::Expr) -> i64:
            match expression:
                Ast::Expr.Binary(_, _, _, _):
                    return 1
                Ast::Expr.Unary(_, _, _):
                    return 2
                Ast::Expr.Ident(_, _):
                    return 3
                Ast::Expr.IntLit(_, _):
                    return 4
                Ast::Expr.Call(_, _, _, _):
                    return 5
                Ast::Expr.Index(_, _, _):
                    return 6
                Ast::Expr.Field(_, _, _):
                    return 7
                Ast::Expr.BoolLit(_, _):
                    return 8
                _:
                    return 0
            return 0

        def proof_certificate_fact_is_traced(report: ProofReport&, fact: Ast::Expr, owner: sview) -> bool:
            return proof_certificate_fact_trace_index(report, fact, owner) < report.fact_traces.count

    private:
        def proof_add_goal_attempt(report: mutable ProofReport&, facts: darray[Ast::Expr]&, goal: Ast::Expr, line: u32, name: sview, rule: sview, proven: bool) -> void:
            if facts.count > ElisaProofKernelCore::PROOF_KERNEL_NODE_BUDGET:
                proof_kernel_budget_note(report, name)
            if report.kernel_budget_exhausted:
                report.goal_attempts <- report.goal_attempts.push(ProofGoalAttempt{goal: goal, budget_exhausted: true, facts_start: report.certificate_facts.count, facts_count: 0, kernel_goal: report.kernel_nodes.count, kernel_facts_start: report.kernel_certificate_facts.count, kernel_facts_count: 0, line: line, name: name, rule: rule, proven: false, has_certificate: false, certificate_index: report.certificates.count})
                return
            captured_facts: mutable darray[Ast::Expr] = []
            captured_kernel_roots: mutable darray[usize] = []
            for fact in facts |fact, captured_facts, report, name|:
                trace_index: usize = proof_certificate_fact_trace_index(report, fact, name)
                if proof_kernel_expression_supported(fact) and trace_index < report.fact_traces.count:
                    trace_root: usize = report.fact_traces[trace_index].kernel_expression
                    if trace_root < report.kernel_nodes.count:
                        captured_facts.push(fact)
                        captured_kernel_roots.push(trace_root)
            encoded_goal: (known: bool, root: usize) = proof_kernel_encode_annotated_checked(goal, report, name)
            if not encoded_goal.known:
                report.goal_attempts <- report.goal_attempts.push(ProofGoalAttempt{goal: goal, budget_exhausted: true, facts_start: report.certificate_facts.count, facts_count: 0, kernel_goal: report.kernel_nodes.count, kernel_facts_start: report.kernel_certificate_facts.count, kernel_facts_count: 0, line: line, name: name, rule: rule, proven: false, has_certificate: false, certificate_index: report.certificates.count})
                return
            if not proof_kernel_report_append_allowed(report, report.certificate_facts.count, captured_facts.count, name):
                report.goal_attempts <- report.goal_attempts.push(ProofGoalAttempt{goal: goal, budget_exhausted: true, facts_start: report.certificate_facts.count, facts_count: 0, kernel_goal: encoded_goal.root, kernel_facts_start: report.kernel_certificate_facts.count, kernel_facts_count: 0, line: line, name: name, rule: rule, proven: false, has_certificate: false, certificate_index: report.certificates.count})
                return
            if not proof_kernel_report_append_allowed(report, report.kernel_certificate_facts.count, captured_kernel_roots.count, name):
                report.goal_attempts <- report.goal_attempts.push(ProofGoalAttempt{goal: goal, budget_exhausted: true, facts_start: report.certificate_facts.count, facts_count: 0, kernel_goal: encoded_goal.root, kernel_facts_start: report.kernel_certificate_facts.count, kernel_facts_count: 0, line: line, name: name, rule: rule, proven: false, has_certificate: false, certificate_index: report.certificates.count})
                return
            facts_start: usize = report.certificate_facts.count
            report.certificate_facts.extend(captured_facts)
            kernel_facts_start: usize = report.kernel_certificate_facts.count
            report.kernel_certificate_facts.extend(captured_kernel_roots)
            kernel_goal: usize = encoded_goal.root
            certificate_proven: mutable bool = proven and not report.kernel_budget_exhausted
            if rule == "quantifier-forall" or rule == "quantifier-exists":
                quantifier_kind: sview = "forall" if rule == "quantifier-forall" else "exists"
                # A quantifier certificate must carry the source-side kind in the arena. If the
                # root is not a quantifier, or an already-bound root disagrees, no certificate is
                # admissible. Keep the failure local to this attempt so bookkeeping cannot claim
                # a replayable quantifier while relying on the later global gap scan to revoke it.
                quantifier_bound: bool = proof_kernel_bind_quantifier_kind(&report.kernel_nodes, kernel_goal, quantifier_kind)
                certificate_proven <- false if not quantifier_bound
            kernel_facts_count: usize = captured_facts.count
            certificate_index: usize = report.certificates.count
            if certificate_proven and not proof_kernel_report_append_allowed(report, report.certificates.count, 1, name):
                certificate_proven <- false
            report.goal_attempts <- report.goal_attempts.push(ProofGoalAttempt{goal: goal, budget_exhausted: report.kernel_budget_exhausted, facts_start: facts_start, facts_count: captured_facts.count, kernel_goal: kernel_goal, kernel_facts_start: kernel_facts_start, kernel_facts_count: kernel_facts_count, line: line, name: name, rule: rule, proven: certificate_proven, has_certificate: certificate_proven, certificate_index: certificate_index})
            report.certificates <- report.certificates.push(ProofGoalCertificate{goal: goal, facts_start: facts_start, facts_count: captured_facts.count, kernel_goal: kernel_goal, kernel_facts_start: kernel_facts_start, kernel_facts_count: kernel_facts_count, line: line, name: name, rule: rule, replayed: false}) if certificate_proven
