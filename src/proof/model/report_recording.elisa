# Budget notes, kernel encoding, findings and goal-attempt recording on the proof report.
extend ElisaProof:
    public:
        def proof_kernel_budget_note(report: mutable ProofReport&, name: sview) -> void:
            report.analysis_1.kernel.budget_exhausted <- true
            if not report.analysis_1.kernel.budget_reported:
                report.analysis_1.kernel.budget_reported <- true
                proof_add_finding(report, "kernel-arena-budget", 0, name, "kernel certificate arena exceeded its bounded storage budget")

        def proof_kernel_fact_admission_budget_note(report: mutable ProofReport&, name: sview) -> void:
            report.analysis_1.kernel.budget_exhausted <- true
            if not report.analysis_1.kernel.budget_reported:
                report.analysis_1.kernel.budget_reported <- true
                proof_add_finding(report, "kernel-fact-admission-budget", 0, name, "kernel goal fact admission exceeded its bounded work budget")

        # Replay-side provenance tables are report-owned storage too. Keep their flat appends
        # under the same canonical bound before `resize`/`extend` can allocate. The first check
        # avoids unsigned subtraction underflow when a malformed report already exceeds the
        # budget.
        def proof_kernel_report_append_allowed(report: mutable ProofReport&, current: usize, addition: usize, name: sview) -> bool:
            return true if current <= ElisaProofKernelCore::PROOF_KERNEL_NODE_BUDGET and addition <= ElisaProofKernelCore::PROOF_KERNEL_NODE_BUDGET - current
            proof_kernel_budget_note(report, name)
            return false

        def proof_kernel_encode_annotated_checked(expression: Ast::Expr, report: mutable ProofReport&, name: sview) -> (known: bool, root: usize):
            return (false, 0) if report.analysis_1.kernel.budget_exhausted
            if report.analysis_1.kernel.nodes.count >= ElisaProofKernelCore::PROOF_KERNEL_NODE_BUDGET or report.analysis_1.kernel.children.count >= ElisaProofKernelCore::PROOF_KERNEL_CHILD_BUDGET:
                proof_kernel_budget_note(report, name)
                return (false, 0)
            node_start: usize = report.analysis_1.kernel.nodes.count
            child_start: usize = report.analysis_1.kernel.children.count
            encoded: usize = proof_kernel_encode_annotated(expression, &report.analysis_1.kernel.nodes, &report.analysis_1.kernel.children, report.source.source_annotations)
            if report.analysis_1.kernel.nodes.count > ElisaProofKernelCore::PROOF_KERNEL_NODE_BUDGET or report.analysis_1.kernel.children.count > ElisaProofKernelCore::PROOF_KERNEL_CHILD_BUDGET:
                report.analysis_1.kernel.nodes <- report.analysis_1.kernel.nodes.truncate(node_start)
                report.analysis_1.kernel.children <- report.analysis_1.kernel.children.truncate(child_start)
                proof_kernel_budget_note(report, name)
                return (false, 0)
            if encoded >= report.analysis_1.kernel.nodes.count:
                # A work or node-cap refusal can leave a valid but incomplete term suffix in
                # the report arena. It has no certificate root, so discard both suffixes before
                # the next goal so failed attempts cannot consume capacity needed by later terms.
                report.analysis_1.kernel.nodes <- report.analysis_1.kernel.nodes.truncate(node_start)
                report.analysis_1.kernel.children <- report.analysis_1.kernel.children.truncate(child_start)
                return (false, 0)
            return (true, proof_kernel_intern_encoded(report, node_start, child_start, encoded))

        def proof_kernel_encode_expression_checked(expression: Ast::Expr, report: mutable ProofReport&, name: sview) -> (known: bool, root: usize):
            return (false, 0) if report.analysis_1.kernel.budget_exhausted
            if report.analysis_1.kernel.nodes.count >= ElisaProofKernelCore::PROOF_KERNEL_NODE_BUDGET or report.analysis_1.kernel.children.count >= ElisaProofKernelCore::PROOF_KERNEL_CHILD_BUDGET:
                proof_kernel_budget_note(report, name)
                return (false, 0)
            node_start: usize = report.analysis_1.kernel.nodes.count
            child_start: usize = report.analysis_1.kernel.children.count
            encoded: usize = proof_kernel_encode_expression(expression, &report.analysis_1.kernel.nodes, &report.analysis_1.kernel.children)
            if report.analysis_1.kernel.nodes.count > ElisaProofKernelCore::PROOF_KERNEL_NODE_BUDGET or report.analysis_1.kernel.children.count > ElisaProofKernelCore::PROOF_KERNEL_CHILD_BUDGET:
                report.analysis_1.kernel.nodes <- report.analysis_1.kernel.nodes.truncate(node_start)
                report.analysis_1.kernel.children <- report.analysis_1.kernel.children.truncate(child_start)
                proof_kernel_budget_note(report, name)
                return (false, 0)
            if encoded >= report.analysis_1.kernel.nodes.count:
                # Keep the expression-only compatibility path transactional as well; resource
                # admission may encode several candidate values into this shared arena.
                report.analysis_1.kernel.nodes <- report.analysis_1.kernel.nodes.truncate(node_start)
                report.analysis_1.kernel.children <- report.analysis_1.kernel.children.truncate(child_start)
                return (false, 0)
            return (true, proof_kernel_intern_encoded(report, node_start, child_start, encoded))

        # Mark the most recent goal attempt as ended by a resource limit, and reclassify its
        # diagnostic from "unknown" to "timeout" so a client can tell an undecided obligation from
        # one the kernel decided it could not prove.
        def proof_mark_latest_attempt_exhausted(report: mutable ProofReport&, exhausted: bool) -> void:
            return if not exhausted or report.results.goal_attempts.count == 0
            report.results.goal_attempts[report.results.goal_attempts.count - 1].budget_exhausted <- true

        def proof_latest_attempt_exhausted(report: ProofReport&) -> bool:
            return false if report.results.goal_attempts.count == 0
            return report.results.goal_attempts[report.results.goal_attempts.count - 1].budget_exhausted

        def proof_finding_status(kind: sview) -> sview:
            return when kind:
                "borrow-call-opaque" | "borrow-call-summary-unsupported" | "borrow-contract-unsupported" | "borrow-escape" | "borrow-source-opaque" | "call-old-opaque" | "call-result-unbound" | "captured-block-unsupported" | "catch-arm-unsupported" | "checked-get-unsupported" | "checked-index-unsupported" | "contract-call-unsupported" | "contract-expression-unsupported" | "contract-proposition-type" | "contract-resource-unsupported" | "control-flow-unsupported" | "control-flow-analysis-budget" | "declaration-unsupported" | "expression-unsupported" | "frame-call-opaque" | "frame-expression-opaque" | "frame-preserve-opaque" | "frame-spec-invalid" | "frame-spec-opaque" | "frame-write-opaque" | "function-summary-unverified" | "import-error" | "index-bounds-opaque" | "kernel-arena-budget" | "kernel-fact-admission-budget" | "kernel-certificate-invalid" | "lemma-impure" | "lemma-malformed" | "lemma-recursive-unsupported" | "lemma-result-unbound" | "lemma-return" | "loop-condition-opaque" | "loop-decreases-malformed" | "loop-invariant-scope" | "parallel-control-flow-unsupported" | "parallel-state-unsupported" | "parse-error" | "pattern-unsupported" | "proof-impure" | "proof-malformed" | "proof-internal-name" | "recursive-summary-unsupported" | "slice-bounds-opaque" | "statement-unsupported" | "region-alias-unsupported" | "region-allocation-unsupported" | "region-destroy-unsupported" | "region-expression-unsupported" | "region-return-escape" | "region-return-witness-unsupported" | "region-scope-unsupported" | "region-store-escape" | "effect-call-opaque" | "effect-row-abstract" | "frame-analysis-budget" | "resource-analysis-budget" | "resource-expression-depth" | "semantic-analysis-depth" -> "unsupported"
                _ -> "unknown"

        # A finding takes the owner of the function being checked only when it names that
        # function; one naming anything else stays unowned and so counts against every row.
        def proof_finding_owner(report: ProofReport&, name: sview) -> sview:
            return report.analysis_2.finding_owner if name == report.analysis_2.finding_function else ""

        def proof_finding_owner_line(report: ProofReport&, name: sview) -> u32:
            return report.analysis_2.finding_line if name == report.analysis_2.finding_function else 0

        def proof_finding_owner_offset(report: ProofReport&, name: sview) -> u32:
            return report.analysis_2.finding_offset if name == report.analysis_2.finding_function else 0

        def proof_add_finding(report: mutable ProofReport&, kind: sview, line: u32, name: sview, message: sview) -> void:
            empty: mutable darray[Ast::Expr] = []
            proof_add_finding_with_counterexample(report, kind, line, name, message, &empty, false)

        def proof_add_budget_finding(report: mutable ProofReport&, kind: sview, line: u32, name: sview, message: sview, dimension: sview, observed: usize, limit: usize) -> void:
            proof_add_finding(report, kind, line, name, message)
            if report.results.findings.count > 0:
                finding_index: usize = report.results.findings.count - 1
                report.results.findings[finding_index].budget_dimension <- dimension
                report.results.findings[finding_index].budget_observed <- observed
                report.results.findings[finding_index].budget_limit <- limit

        # Record a diagnostic for the most recently emitted logical goal and bind it by stable
        # goal ID. Line/name matching is insufficient when one expression generates several
        # obligations (for example lower and upper index bounds on the same source line).
        def proof_add_latest_goal_finding(report: mutable ProofReport&, kind: sview, line: u32, name: sview, message: sview) -> void:
            proof_add_finding(report, kind, line, name, message)
            if report.results.goal_attempts.count > 0 and report.results.findings.count > 0:
                report.results.findings[report.results.findings.count - 1].goal_id <- report.results.goal_attempts.count - 1
                report.results.findings[report.results.findings.count - 1].has_goal <- true

        def proof_add_finding_with_counterexample(report: mutable ProofReport&, kind: sview, line: u32, name: sview, message: sview, counterexample: darray[Ast::Expr]&, counterexample_found: bool) -> void:
            start: usize = report.results.counterexample_facts.count
            report.results.counterexample_facts.extend(counterexample)
            finding_status: mutable sview = proof_finding_status(kind)
            # Only the exact evaluator path may label a finding disproved. Static
            # diagnostics can establish a concrete source violation without producing a
            # counterexample model, so they remain unknown at theorem-status level.
            finding_status <- "disproved" if counterexample_found
            report.results.findings <- report.results.findings.push(ProofFinding{kind: kind, status: finding_status, line: line, name: name, owner: proof_finding_owner(report, name), owner_line: proof_finding_owner_line(report, name), owner_offset: proof_finding_owner_offset(report, name), message: message, budget_dimension: "", budget_observed: 0, budget_limit: 0, counterexample_start: start, counterexample_count: counterexample.count, counterexample_found: counterexample_found, goal_id: 0, has_goal: false})
            report.results.failed <- report.results.failed + 1

        def proof_obligation(report: mutable ProofReport&, proven: bool) -> void:
            start: usize = 0 if report.results.obligation_inventory.count == 0 else report.results.obligation_inventory[report.results.obligation_inventory.count - 1].attempts_start + report.results.obligation_inventory[report.results.obligation_inventory.count - 1].attempts_count
            count: usize = report.results.goal_attempts.count - start if start <= report.results.goal_attempts.count else 0
            report.results.obligation_inventory.push(ProofObligationEntry{identity: report.results.obligation_inventory.count, attempts_start: start, attempts_count: count, proven: proven, source_line: 0, source_name: "", source_kind: "", source_function_offset: 0, source_obligation_index: 0, owner_function_line: report.context.current_goal_owner_line, owner_function_offset: report.context.current_goal_owner_offset})
            report.results.obligations <- report.results.obligations + 1
            report.results.producer_proven_count <- report.results.producer_proven_count + 1 if proven

        # A frame check (a write or a callee's `changes` against the caller's `changes` and
        # `preserves` frames) is decided syntactically and has no goal attempt or certificate.
        # Its ledger row says so, which is what lets the attempt invariants allow for it.
        def proof_frame_obligation(report: mutable ProofReport&, proven: bool) -> void:
            proof_obligation(report, proven)
            report.results.obligation_inventory[report.results.obligation_inventory.count - 1].source_kind <- "frame"

        def proof_obligation_for_source(report: mutable ProofReport&, proven: bool, line: u32, name: sview, kind: sview, source_index: usize) -> void:
            proof_obligation(report, proven)
            last: usize = report.results.obligation_inventory.count - 1
            report.results.obligation_inventory[last].source_line <- line
            report.results.obligation_inventory[last].source_name <- name
            report.results.obligation_inventory[last].source_kind <- kind
            report.results.obligation_inventory[last].source_function_offset <- report.context.current_source_postcondition_offset if kind == "postcondition"
            report.results.obligation_inventory[last].source_obligation_index <- source_index

        # Certificates carry only facts that entered the current state through a recorded
        # transition. The body checker may keep an opaque/invalid symbolic placeholder after a
        # failed substitution so later obligations remain visible, but such a placeholder is not
        # an admissible certificate premise. Omitting it here is conservative: if the goal relied
        # on that value, independent replay will fail instead of treating it as an axiom.
        #
        # This runs for every premise of every attempt against every trace of the function, and
        # `proof_expr_equal` re-validates both whole terms on each call. An unsupported fact
        # equals no trace, so it is rejected once up front; and a trace whose root (under any
        # parentheses) differs in a way `proof_expr_equal` would reject is skipped without the
        # full comparison. Both are exact: the same index is returned as by the plain scan.
        def proof_certificate_fact_trace_index(report: ProofReport&, fact: Ast::Expr, owner: sview) -> usize:
            work: mutable usize = 0
            equality_work: mutable usize = 0
            support: (complete: bool, supported: bool) = proof_kernel_expression_supported_with_work(fact, &work)
            return report.analysis_1.traces.records.count if not support.complete or not support.supported
            traced: (complete: bool, index: usize) = proof_certificate_fact_trace_index_after_support(report, fact, owner, &work, &equality_work)
            return traced.index if traced.complete
            return report.analysis_1.traces.records.count

    private:
        # The goal-attempt recorder already checks support before retaining a fact. Keep the
        # trace lookup separate so that path does not traverse the same fact AST twice.
        def proof_certificate_fact_trace_index_after_support(report: ProofReport&, fact: Ast::Expr, owner: sview, work: mutable usize&, equality_work: mutable usize&) -> (complete: bool, index: usize):
            owner_length: usize = sview_len(owner)
            return (false, report.analysis_1.traces.records.count) if not proof_kernel_ast_support_charge_with_work(owner_length, &work)
            fact_root_result: (complete: bool, root: Ast::Expr) = proof_trace_root_with_work(fact, 0, &work)
            return (false, report.analysis_1.traces.records.count) if not fact_root_result.complete
            fact_root: Ast::Expr = fact_root_result.root
            start: mutable usize = report.analysis_1.traces.active_start
            start <- 0 if start > report.analysis_1.traces.records.count
            for index in start..<report.analysis_1.traces.records.count |index, report, fact, fact_root, owner, work, equality_work|:
                return (false, report.analysis_1.traces.records.count) if not proof_kernel_ast_support_charge_with_work(1, &work)
                trace: ProofFactTrace = report.analysis_1.traces.records[index]
                trace_name_length: usize = sview_len(trace.name)
                return (false, report.analysis_1.traces.records.count) if not proof_kernel_ast_support_charge_with_work(trace_name_length, &work)
                continue if trace.name != owner
                trace_root_result: (complete: bool, root: Ast::Expr) = proof_trace_root_with_work(trace.expression, 0, &work)
                return (false, report.analysis_1.traces.records.count) if not trace_root_result.complete
                return (false, report.analysis_1.traces.records.count) if not proof_trace_root_names_charge(trace_root_result.root, fact_root, &work)
                continue if not proof_trace_root_may_equal(trace_root_result.root, fact_root)
                trace_support: (complete: bool, supported: bool) = proof_kernel_expression_supported_with_work(trace.expression, &work)
                return (false, report.analysis_1.traces.records.count) if not trace_support.complete
                continue if not trace_support.supported
                equal: bool = proof_replay_summary_expr_proof_equal_with_limit(trace.expression, fact, &equality_work, proof_replay_summary_source_work_limit())
                return (true, index) if equal
                return (false, report.analysis_1.traces.records.count) if equality_work >= proof_replay_summary_source_work_limit()
            return (true, report.analysis_1.traces.records.count)

        def proof_trace_root_with_work(expression: Ast::Expr, depth: usize, work: mutable usize&) -> (complete: bool, root: Ast::Expr):
            return (true, Ast::Expr.Invalid) if depth >= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT
            match expression:
                Ast::Expr.Paren(inner, _):
                    return (false, Ast::Expr.Invalid) if not proof_kernel_ast_support_charge_with_work(1, &work)
                    return proof_trace_root_with_work(inner, depth + 1, &work)
                _:
                    return (true, expression)

        def proof_trace_root_names_charge(left: Ast::Expr, right: Ast::Expr, work: mutable usize&) -> bool:
            match left:
                Ast::Expr.Binary(_, _, _, _):
                    match right:
                        Ast::Expr.Binary(_, _, _, _):
                            return proof_kernel_ast_support_charge_with_work(1, &work)
                        _:
                            return true
                Ast::Expr.Unary(_, _, _):
                    match right:
                        Ast::Expr.Unary(_, _, _):
                            return proof_kernel_ast_support_charge_with_work(1, &work)
                        _:
                            return true
                Ast::Expr.Ident(left_name, _):
                    match right:
                        Ast::Expr.Ident(right_name, _):
                            return false if not proof_kernel_ast_support_charge_with_work(sview_len(left_name), &work)
                            return proof_kernel_ast_support_charge_with_work(sview_len(right_name), &work)
                        _:
                            return true
                _:
                    return true


    public:
        # False only when `proof_expr_equal` must be false: both roots (parentheses stripped, as
        # that comparator strips them) are common shapes that differ in variant or root payload.
        # Anything else, including a stripped-to-Invalid deep chain, defers to the comparator.
        def proof_trace_root_may_equal(left: Ast::Expr, right: Ast::Expr) -> bool:
            left_tag: i64 = proof_trace_root_tag(left)
            right_tag: i64 = proof_trace_root_tag(right)
            return true if left_tag == 0 or right_tag == 0
            return false if left_tag != right_tag
            match left:
                Ast::Expr.Binary(_, operator, _, _):
                    match right:
                        Ast::Expr.Binary(_, other_operator, _, _):
                            return operator == other_operator
                        _:
                            return true
                Ast::Expr.Unary(operator, _, _):
                    match right:
                        Ast::Expr.Unary(other_operator, _, _):
                            return operator == other_operator
                        _:
                            return true
                Ast::Expr.Ident(name, _):
                    match right:
                        Ast::Expr.Ident(other, _):
                            return name == other
                        _:
                            return true
                Ast::Expr.IntLit(value, _):
                    match right:
                        Ast::Expr.IntLit(other, _):
                            return value == other
                        _:
                            return true
                _:
                    return true
            return true

        def proof_trace_root_tag(expression: Ast::Expr) -> i64:
            match expression:
                Ast::Expr.Binary(_, _, _, _):
                    return 1
                Ast::Expr.Unary(_, _, _):
                    return 2
                Ast::Expr.Ident(_, _):
                    return 3
                Ast::Expr.IntLit(_, _):
                    return 4
                Ast::Expr.Call(_, _, _, _):
                    return 5
                Ast::Expr.Index(_, _, _):
                    return 6
                Ast::Expr.Field(_, _, _):
                    return 7
                Ast::Expr.BoolLit(_, _):
                    return 8
                Ast::Expr.Absent:
                    return 9
                Ast::Expr.FloatLit(_, _):
                    return 10
                Ast::Expr.StringLit(_, _):
                    return 11
                Ast::Expr.CharLit(_, _):
                    return 12
                Ast::Expr.Block(_, _, _, _):
                    return 13
                Ast::Expr.Match(_, _, _):
                    return 14
                Ast::Expr.Catch(_, _, _):
                    return 15
                Ast::Expr.Comprehension(_, _, _, _, _):
                    return 16
                Ast::Expr.Refinement(_, _, _):
                    return 17
                Ast::Expr.GetElse(_, _, _):
                    return 18
                Ast::Expr.Lambda(_, _, _):
                    return 19
                Ast::Expr.Scope(_, _, _):
                    return 20
                Ast::Expr.ShorthandMember(_, _):
                    return 21
                Ast::Expr.Slice(_, _, _, _):
                    return 22
                Ast::Expr.IndexN(_, _, _):
                    return 23
                Ast::Expr.Move(_, _):
                    return 24
                Ast::Expr.RegionNew(_, _, _):
                    return 25
                Ast::Expr.Array(_, _):
                    return 26
                Ast::Expr.Tuple(_, _):
                    return 27
                Ast::Expr.SetLit(_, _):
                    return 28
                Ast::Expr.DictLit(_, _):
                    return 29
                Ast::Expr.Construct(_, _, _):
                    return 30
                Ast::Expr.RecordUpdate(_, _, _):
                    return 31
                Ast::Expr.If(_, _, _, _):
                    return 32
                _:
                    return 0
            return 0

        def proof_certificate_fact_is_traced(report: ProofReport&, fact: Ast::Expr, owner: sview) -> bool:
            return proof_certificate_fact_trace_index(report, fact, owner) < report.analysis_1.traces.records.count

    private:
        def proof_add_goal_attempt(report: mutable ProofReport&, facts: darray[Ast::Expr]&, goal: Ast::Expr, line: u32, name: sview, rule: sview, proven: bool) -> void:
            if facts.count > ElisaProofKernelCore::PROOF_KERNEL_NODE_BUDGET:
                proof_kernel_budget_note(report, name)
            if report.analysis_1.kernel.budget_exhausted:
                report.results.goal_attempts <- report.results.goal_attempts.push(ProofGoalAttempt{goal: goal, budget_exhausted: true, facts_start: report.analysis_1.certificate_facts.count, facts_count: 0, kernel_goal: report.analysis_1.kernel.nodes.count, kernel_facts_start: report.analysis_1.kernel.certificate_facts.count, kernel_facts_count: 0, line: line, name: name, rule: rule, source_phase: report.context.current_loop_invariant_phase, float_mode: report.context.current_float_mode, producer_proven: false, has_certificate: false, certificate_index: report.analysis_1.certificates.count, owner_function_line: report.context.current_goal_owner_line, owner_function_offset: report.context.current_goal_owner_offset})
                return
            captured_facts: mutable darray[Ast::Expr] = []
            captured_kernel_roots: mutable darray[usize] = []
            supported_facts: mutable darray[Ast::Expr] = []
            support_work: mutable usize = 0
            equality_work: mutable usize = 0
            fact_admission_exhausted: mutable bool = false
            for fact in facts |fact, supported_facts, report, name, support_work, fact_admission_exhausted|:
                support: (complete: bool, supported: bool) = proof_kernel_expression_supported_with_work(fact, &support_work)
                if not support.complete:
                    fact_admission_exhausted <- true
                    break
                continue if not support.supported
                if not proof_kernel_ast_support_charge_with_work(1, &support_work):
                    fact_admission_exhausted <- true
                    break
                supported_facts.push(fact)
            trace_count: usize = report.analysis_1.traces.records.count
            trace_start: usize = report.analysis_1.traces.active_start
            trace_start <- 0 if trace_start > trace_count
            active_trace_count: usize = trace_count - trace_start
            use_fact_index: bool = not fact_admission_exhausted and supported_facts.count >= 8 and supported_facts.count <= 128 and support_work <= ElisaProofKernelCore::PROOF_KERNEL_AST_SUPPORT_WORK_LIMIT / 8 and active_trace_count >= 256
            if use_fact_index:
                slot_hashes: mutable darray[u32] = []
                slot_heads: mutable darray[usize] = []
                next_facts: mutable darray[usize] = []
                matched_traces: mutable darray[usize] = []
                fact_roots: mutable darray[Ast::Expr] = []
                root_tag_heads: mutable darray[usize] = []
                next_root_facts: mutable darray[usize] = []
                root_key_slot_hashes: mutable darray[u32] = []
                root_key_slot_heads: mutable darray[usize] = []
                next_root_key_facts: mutable darray[usize] = []
                fact_capacity: mutable usize = 0
                can Memory.Allocate:
                    if proof_goal_fact_index_build(supported_facts, trace_count, &support_work, ElisaProofKernelCore::PROOF_KERNEL_AST_SUPPORT_WORK_LIMIT, &fact_capacity, &slot_hashes, &slot_heads, &next_facts, &matched_traces, &fact_roots, &root_tag_heads, &next_root_facts, &root_key_slot_hashes, &root_key_slot_heads, &next_root_key_facts):
                        if not proof_goal_fact_index_scan(report, supported_facts, name, trace_start, fact_capacity, slot_hashes, slot_heads, next_facts, &matched_traces, fact_roots, root_tag_heads, next_root_facts, root_key_slot_hashes, root_key_slot_heads, next_root_key_facts, &support_work, &equality_work):
                            fact_admission_exhausted <- true
                        else:
                            for fact_index in 0..<supported_facts.count |fact_index, supported_facts, matched_traces, captured_facts, captured_kernel_roots, report, trace_count, fact_admission_exhausted|:
                                if fact_index >= matched_traces.count:
                                    fact_admission_exhausted <- true
                                    break
                                traced_index: usize = matched_traces[fact_index]
                                continue if traced_index >= trace_count
                                trace_root: usize = report.analysis_1.traces.records[traced_index].kernel_expression
                                if trace_root < report.analysis_1.kernel.nodes.count:
                                    captured_facts.push(supported_facts[fact_index])
                                    captured_kernel_roots.push(trace_root)
                    else:
                        fact_admission_exhausted <- true
            else:
                for fact in supported_facts |fact, captured_facts, captured_kernel_roots, report, name, support_work, equality_work, fact_admission_exhausted|:
                    traced: (complete: bool, index: usize) = proof_certificate_fact_trace_index_after_support(report, fact, name, &support_work, &equality_work)
                    if not traced.complete:
                        fact_admission_exhausted <- true
                        break
                    if traced.index < report.analysis_1.traces.records.count:
                        trace_root: usize = report.analysis_1.traces.records[traced.index].kernel_expression
                        if trace_root < report.analysis_1.kernel.nodes.count:
                            captured_facts.push(fact)
                            captured_kernel_roots.push(trace_root)
            proof_kernel_fact_admission_budget_note(report, name) if fact_admission_exhausted
            encoded_goal: (known: bool, root: usize) = proof_kernel_encode_annotated_checked(goal, report, name)
            if not encoded_goal.known:
                report.results.goal_attempts <- report.results.goal_attempts.push(ProofGoalAttempt{goal: goal, budget_exhausted: true, facts_start: report.analysis_1.certificate_facts.count, facts_count: 0, kernel_goal: report.analysis_1.kernel.nodes.count, kernel_facts_start: report.analysis_1.kernel.certificate_facts.count, kernel_facts_count: 0, line: line, name: name, rule: rule, source_phase: report.context.current_loop_invariant_phase, float_mode: report.context.current_float_mode, producer_proven: false, has_certificate: false, certificate_index: report.analysis_1.certificates.count, owner_function_line: report.context.current_goal_owner_line, owner_function_offset: report.context.current_goal_owner_offset})
                return
            if not proof_kernel_report_append_allowed(report, report.analysis_1.certificate_facts.count, captured_facts.count, name):
                report.results.goal_attempts <- report.results.goal_attempts.push(ProofGoalAttempt{goal: goal, budget_exhausted: true, facts_start: report.analysis_1.certificate_facts.count, facts_count: 0, kernel_goal: encoded_goal.root, kernel_facts_start: report.analysis_1.kernel.certificate_facts.count, kernel_facts_count: 0, line: line, name: name, rule: rule, source_phase: report.context.current_loop_invariant_phase, float_mode: report.context.current_float_mode, producer_proven: false, has_certificate: false, certificate_index: report.analysis_1.certificates.count, owner_function_line: report.context.current_goal_owner_line, owner_function_offset: report.context.current_goal_owner_offset})
                return
            if not proof_kernel_report_append_allowed(report, report.analysis_1.kernel.certificate_facts.count, captured_kernel_roots.count, name):
                report.results.goal_attempts <- report.results.goal_attempts.push(ProofGoalAttempt{goal: goal, budget_exhausted: true, facts_start: report.analysis_1.certificate_facts.count, facts_count: 0, kernel_goal: encoded_goal.root, kernel_facts_start: report.analysis_1.kernel.certificate_facts.count, kernel_facts_count: 0, line: line, name: name, rule: rule, source_phase: report.context.current_loop_invariant_phase, producer_proven: false, has_certificate: false, certificate_index: report.analysis_1.certificates.count, owner_function_line: report.context.current_goal_owner_line, owner_function_offset: report.context.current_goal_owner_offset})
                return
            facts_start: usize = report.analysis_1.certificate_facts.count
            report.analysis_1.certificate_facts.extend(captured_facts)
            kernel_facts_start: usize = report.analysis_1.kernel.certificate_facts.count
            report.analysis_1.kernel.certificate_facts.extend(captured_kernel_roots)
            kernel_goal: usize = encoded_goal.root
            certificate_proven: mutable bool = proven and not report.analysis_1.kernel.budget_exhausted
            if rule in {"quantifier-forall", "quantifier-exists"}:
                quantifier_kind: sview = "forall" if rule == "quantifier-forall" else "exists"
                # A quantifier certificate must carry the source-side kind in the arena. If the
                # root is not a quantifier, or an already-bound root disagrees, no certificate is
                # admissible. Keep the failure local to this attempt so bookkeeping cannot claim
                # a replayable quantifier while relying on the later global gap scan to revoke it.
                quantifier_bound: bool = proof_kernel_bind_quantifier_kind(&report.analysis_1.kernel.nodes, kernel_goal, quantifier_kind)
                certificate_proven <- false if not quantifier_bound
            kernel_facts_count: usize = captured_facts.count
            certificate_index: usize = report.analysis_1.certificates.count
            if certificate_proven and not proof_kernel_report_append_allowed(report, report.analysis_1.certificates.count, 1, name):
                certificate_proven <- false
            report.results.goal_attempts <- report.results.goal_attempts.push(ProofGoalAttempt{goal: goal, budget_exhausted: report.analysis_1.kernel.budget_exhausted, facts_start: facts_start, facts_count: captured_facts.count, kernel_goal: kernel_goal, kernel_facts_start: kernel_facts_start, kernel_facts_count: kernel_facts_count, line: line, name: name, rule: rule, source_phase: report.context.current_loop_invariant_phase, float_mode: report.context.current_float_mode, producer_proven: certificate_proven, has_certificate: certificate_proven, certificate_index: certificate_index, owner_function_line: report.context.current_goal_owner_line, owner_function_offset: report.context.current_goal_owner_offset})
            report.analysis_1.certificates <- report.analysis_1.certificates.push(ProofGoalCertificate{goal: goal, facts_start: facts_start, facts_count: captured_facts.count, kernel_goal: kernel_goal, kernel_facts_start: kernel_facts_start, kernel_facts_count: kernel_facts_count, line: line, name: name, rule: rule, source_phase: report.context.current_loop_invariant_phase, replayed: false}) if certificate_proven
