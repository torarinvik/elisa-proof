# Parser-origin direct-body postcondition ASTs used for exact source binding.
extend ElisaProof:
    private:
        const PROOF_SOURCE_POSTCONDITION_AST_INDEX_DEPTH_LIMIT: usize = 64

        struct ProofSourcePostconditionAstIndex:
            slot_values: mutable darray[usize] = []
            hashes: mutable darray[u32] = []
            names: mutable darray[sview] = []
            function_offsets: mutable darray[u32] = []
            # `lines` bind report events to a function; literal-shape rows use the contract line.
            lines: mutable darray[u32] = []
            source_indices: mutable darray[usize] = []
            contract_lines: mutable darray[u32] = []
            counts: mutable darray[usize] = []
            expressions: mutable darray[Ast::Expr] = []
            valid: bool = false

        def proof_source_postcondition_ast_inventory_collect(declarations: darray[Ast::Decl]&, all_declarations: darray[Ast::Decl]&, inventory: mutable darray[(name: sview, function_offset: u32, line: u32, source_index: usize, contract_line: u32, expression: Ast::Expr)]&, return_inventory: mutable darray[(name: sview, line: u32, offset: u32, supported: bool, expression: Ast::Expr)]&, type_index: mutable ProofSourceKernelTypeIndex&, module_path: darray[sview]&, source_work: mutable usize&, depth: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if depth >= PROOF_SOURCE_POSTCONDITION_AST_INDEX_DEPTH_LIMIT
            for declaration in declarations |inventory, source_work, depth|:
                return false if not proof_report_source_postcondition_work_charge(1, source_work)
                match declaration:
                    Ast::Decl.Func(name, parameters, return_type, body, _, _, position):
                        return false if not proof_source_kernel_charge_work(module_path.count, source_work)
                        type_index.scope_path.clear()
                        type_index.scope_path.extend(module_path)
                        return_expression: mutable Ast::Expr = Ast::Expr.Absent
                        return_supported: mutable bool = body.count > 0
                        local_return_count: mutable usize = 0
                        local_return_name: mutable sview = ""
                        local_return_type: mutable sview = ""
                        local_return_end_offset: mutable u32 = 0
                        return_type_name: mutable sview = ""
                        return_type_sort: mutable sview = ""
                        return_type_identity: mutable usize = 0
                        if return_type is declared_return_type:
                            return_sort: (known: bool, sort: sview, type_name: sview, element_sort: sview, element_type_name: sview, type_identity: usize, element_type_identity: usize) = proof_source_kernel_type_sort(declared_return_type, "", all_declarations, type_index, source_work, 0)
                            return_supported <- false if not return_sort.known or return_sort.sort == "void"
                            return_type_name <- return_sort.type_name if return_sort.known
                            return_type_sort <- return_sort.sort if return_sort.known
                            return_type_identity <- return_sort.type_identity if return_sort.known
                        else:
                            # No declared return type is the language's unit return.
                            return_supported <- false
                        for parameter in parameters |source_work, return_supported|:
                            return false if not proof_report_source_postcondition_work_charge(1, source_work) or not proof_report_source_postcondition_work_charge(sview_len(parameter.name), source_work)
                            return_supported <- false if parameter.name == "result"
                        source_index: mutable usize = 0
                        for body_index in 0..<body.count |body_index, body, name, position, source_index, inventory, source_work, return_supported, return_expression|:
                            return false if not proof_report_source_postcondition_work_charge(1, source_work)
                            match body[body_index]:
                                Ast::Stmt.Contract(kind, expression, contract_position):
                                    return false if not proof_report_source_postcondition_work_charge(sview_len(kind), source_work)
                                    if body_index + 1 == body.count:
                                        return_supported <- false
                                    else:
                                        return_supported <- false if kind != "requires" and kind != "ensure" and kind != "ensures"
                                    if kind in {"ensure", "ensures"}:
                                        return false if not proof_report_source_postcondition_work_charge(sview_len(name), source_work)
                                        inventory.push((name, position.offset, position.line, source_index, contract_position.line, expression))
                                        source_index <- source_index + 1
                                Ast::Stmt.Expr(expression, _):
                                    if body_index + 1 == body.count:
                                        return_expression <- expression
                                        return_supported <- false if expression == Ast::Expr.Absent or expression == Ast::Expr.Invalid
                                    else:
                                        return_supported <- false
                                Ast::Stmt.Return(expression, _):
                                    if body_index + 1 == body.count:
                                        return_expression <- expression
                                        return_supported <- false if expression == Ast::Expr.Absent or expression == Ast::Expr.Invalid
                                    else:
                                        return_supported <- false
                                Ast::Stmt.VarDecl(local_name, Ast::Expr.Ident(local_type, local_type_position), initializer, local_position):
                                    return false if not proof_report_source_postcondition_work_charge(sview_len(local_name), source_work)
                                    return false if not proof_report_source_postcondition_work_charge(sview_len(local_type), source_work)
                                    return false if not proof_report_source_postcondition_work_charge(sview_len("result"), source_work)
                                    return false if not proof_report_source_postcondition_work_charge(sview_len("old"), source_work)
                                    return false if not proof_report_source_postcondition_work_charge(sview_len(return_type_name), source_work)
                                    local_return_count <- local_return_count + 1
                                    return_supported <- false if local_return_count != 1 or local_name == "" or local_name == "result" or local_name == "old" or initializer == Ast::Expr.Absent or initializer == Ast::Expr.Invalid
                                    return_supported <- false if local_return_type != ""
                                    for parameter in parameters |parameter, local_name, return_supported, source_work|:
                                        return false if not proof_report_source_postcondition_work_charge(sview_len(parameter.name), source_work)
                                        return false if not proof_report_source_postcondition_work_charge(sview_len(local_name), source_work)
                                        return_supported <- false if parameter.name == local_name
                                    local_sort: (known: bool, sort: sview, type_name: sview, element_sort: sview, element_type_name: sview, type_identity: usize, element_type_identity: usize) = proof_source_kernel_type_sort(Ast::Expr.Ident(local_type, local_type_position), "", all_declarations, type_index, source_work, 0)
                                    return false if not proof_report_source_postcondition_work_charge(sview_len(local_sort.type_name), source_work)
                                    return false if not proof_report_source_postcondition_work_charge(sview_len(return_type_name), source_work)
                                    return_supported <- false if:
                                        not local_sort.known or local_sort.sort != "integer" or return_type_sort != "integer"
                                        local_sort.type_name != return_type_name or local_sort.type_identity != return_type_identity
                                    initializer_position: Ast::Pos = Ast::expr_pos(initializer)
                                    return_supported <- false if local_position.line == 0 or local_position.offset == 0 or initializer_position.line == 0 or initializer_position.offset <= local_position.offset or initializer_position.end_offset <= initializer_position.offset
                                    initializer_scan: (complete: bool, has_result: bool, has_old: bool, has_match: bool) = proof_report_postcondition_source_scan(initializer, source_work)
                                    return_supported <- false if not initializer_scan.complete or initializer_scan.has_result or initializer_scan.has_old
                                    local_return_name <- local_name
                                    local_return_type <- local_type
                                    local_return_end_offset <- initializer_position.end_offset
                                _:
                                    return_supported <- false
                        if local_return_count > 0:
                            match return_expression:
                                Ast::Expr.Ident(returned_name, return_position):
                                    return false if not proof_report_source_postcondition_work_charge(sview_len(returned_name), source_work)
                                    return false if not proof_report_source_postcondition_work_charge(sview_len(local_return_name), source_work)
                                    return_supported <- false if returned_name != local_return_name
                                    return_supported <- false if local_return_end_offset == 0 or return_position.offset <= local_return_end_offset
                                _:
                                    return_supported <- false
                        return false if return_inventory.count > 0 and return_inventory[return_inventory.count - 1].offset > position.offset
                        return_inventory.push((name, position.line, position.offset, return_supported, return_expression))
                    Ast::Decl.Module(module_name, nested, _):
                        return false if not proof_source_kernel_charge_work(sview_len(module_name), source_work)
                        return false if not proof_source_kernel_charge_work(module_path.count, source_work)
                        nested_path: darray[sview] = proof_global_constant_scope_with_module(module_path, module_name)
                        return false if not proof_source_postcondition_ast_inventory_collect(nested, all_declarations, inventory, return_inventory, type_index, nested_path, source_work, depth + 1)
                    Ast::Decl.Scoped(nested, _):
                        return false if not proof_source_postcondition_ast_inventory_collect(nested, all_declarations, inventory, return_inventory, type_index, module_path, source_work, depth + 1)
                    _:
                        pass
            return true

        def proof_source_signature_postcondition_ast_inventory_collect(declarations: darray[Ast::Decl]&, signature_lines: darray[u32]&, signature_kinds: darray[sview]&, signature_exprs: darray[Ast::Expr]&, inventory: mutable darray[(name: sview, function_offset: u32, line: u32, source_index: usize, contract_line: u32, expression: Ast::Expr)]&, source_work: mutable usize&, depth: usize) -> bool can[Memory.Allocate]:
            return false if depth >= PROOF_SOURCE_POSTCONDITION_AST_INDEX_DEPTH_LIMIT
            return false if signature_lines.count != signature_kinds.count or signature_lines.count != signature_exprs.count
            for declaration in declarations |signature_lines, signature_kinds, signature_exprs, inventory, source_work, depth|:
                return false if not proof_report_source_postcondition_work_charge(1, source_work)
                match declaration:
                    Ast::Decl.Func(name, _, _, body, _, _, position):
                        return false if not proof_report_source_postcondition_work_charge(body.count, source_work)
                        source_index: mutable usize = proof_report_body_postcondition_count(body)
                        contract_range: (complete: bool, start: usize, count: usize) = proof_structural_signature_contract_range_for_line(signature_lines, signature_kinds, signature_exprs, position.line, source_work)
                        return false if not contract_range.complete or contract_range.start > signature_lines.count or contract_range.count > signature_lines.count - contract_range.start
                        for offset in 0..<contract_range.count |offset, contract_range, signature_lines, signature_kinds, signature_exprs, source_index, name, position, inventory, source_work|:
                            row: usize = contract_range.start + offset
                            kind: sview = signature_kinds[row]
                            return false if not proof_report_source_postcondition_work_charge(1, source_work) or not proof_report_source_postcondition_work_charge(sview_len(kind), source_work) or not proof_report_source_postcondition_work_charge(sview_len(name), source_work)
                            return false if signature_lines[row] != position.line
                            continue if kind != "ensure"
                            expression: Ast::Expr = signature_exprs[row]
                            contract_position: Ast::Pos = Ast::expr_pos(expression)
                            inventory.push((name, position.offset, position.line, source_index, contract_position.line, expression))
                            source_index <- source_index + 1
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        return false if not proof_source_signature_postcondition_ast_inventory_collect(nested, signature_lines, signature_kinds, signature_exprs, inventory, source_work, depth + 1)
                    _:
                        pass
            return true

        def proof_source_postcondition_ast_inventory_with_status(declarations: darray[Ast::Decl]&, signature_lines: darray[u32]&, signature_kinds: darray[sview]&, signature_exprs: darray[Ast::Expr]&) -> (inventory: darray[(name: sview, function_offset: u32, line: u32, source_index: usize, contract_line: u32, expression: Ast::Expr)], return_inventory: darray[(name: sview, line: u32, offset: u32, supported: bool, expression: Ast::Expr)], complete: bool, work_limited: bool) can[Memory.Allocate, Abort.Panic]:
            source_work: mutable usize = 0
            proof_source_postcondition_ast_inventory_with_work(declarations, signature_lines, signature_kinds, signature_exprs, &source_work)

        def proof_source_postcondition_ast_inventory_with_work(declarations: darray[Ast::Decl]&, signature_lines: darray[u32]&, signature_kinds: darray[sview]&, signature_exprs: darray[Ast::Expr]&, source_work: mutable usize&) -> (inventory: darray[(name: sview, function_offset: u32, line: u32, source_index: usize, contract_line: u32, expression: Ast::Expr)], return_inventory: darray[(name: sview, line: u32, offset: u32, supported: bool, expression: Ast::Expr)], complete: bool, work_limited: bool) can[Memory.Allocate, Abort.Panic]:
            inventory: mutable darray[(name: sview, function_offset: u32, line: u32, source_index: usize, contract_line: u32, expression: Ast::Expr)] = []
            return_inventory: mutable darray[(name: sview, line: u32, offset: u32, supported: bool, expression: Ast::Expr)] = []
            complete: mutable bool = proof_structural_signature_contract_table_valid(signature_lines, signature_kinds, signature_exprs, source_work)
            type_entries: mutable darray[ProofSourceKernelTypeEntry] = []
            module_path: darray[sview] = []
            owner_path_segments: mutable usize = 0
            type_index_known: bool = proof_source_kernel_collect_type_index(declarations, &type_entries, module_path, source_work, &owner_path_segments, 0) if complete else false
            type_index: mutable ProofSourceKernelTypeIndex = proof_source_kernel_build_type_index(type_entries, source_work, false) if type_index_known else ProofSourceKernelTypeIndex{}
            complete <- false if complete and (not type_index_known or not type_index.complete)
            complete <- proof_source_postcondition_ast_inventory_collect(declarations, declarations, inventory, return_inventory, type_index, module_path, source_work, 0) if complete else false
            complete <- proof_source_signature_postcondition_ast_inventory_collect(declarations, signature_lines, signature_kinds, signature_exprs, inventory, source_work, 0) if complete else false
            complete <- false if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            work_limited: bool = source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            if not complete:
                inventory.clear()
                return_inventory.clear()
            (inventory, return_inventory, complete, work_limited)

        def proof_source_postcondition_ast_index_create(inventory: darray[(name: sview, function_offset: u32, line: u32, source_index: usize, contract_line: u32, expression: Ast::Expr)]&, source_work: mutable usize&) -> ProofSourcePostconditionAstIndex can[Memory.Allocate]:
            index: mutable ProofSourcePostconditionAstIndex = ProofSourcePostconditionAstIndex{valid: true}
            return index if inventory.count == 0
            return ProofSourcePostconditionAstIndex{} if inventory.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 4
            target_capacity: usize = inventory.count * 2
            capacity: mutable usize = 1
            while capacity < target_capacity |capacity, target_capacity|:
                return ProofSourcePostconditionAstIndex{} if capacity > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 4
                capacity <- capacity * 2
            return ProofSourcePostconditionAstIndex{} if:
                not proof_report_source_postcondition_work_charge(capacity, source_work)
                not proof_report_source_postcondition_work_charge(capacity, source_work)
                not proof_report_source_postcondition_work_charge(capacity, source_work)
            index.slot_values.resize(capacity)
            index.hashes.resize(capacity)
            for slot in 0..<capacity |slot, index, capacity|:
                index.slot_values[slot] <- capacity
            for row in inventory |row, index, capacity, source_work|:
                return ProofSourcePostconditionAstIndex{} if not proof_report_source_postcondition_work_charge(1, source_work)
                key: ProofSourcePostconditionKey = ProofSourcePostconditionKey{name: row.name, function_offset: row.function_offset, line: row.line, source_index: row.source_index}
                hashed: (complete: bool, hash: u32) = proof_report_source_postcondition_hash(key, source_work)
                return ProofSourcePostconditionAstIndex{} if not hashed.complete
                slot: mutable usize = (hashed.hash.i64() % capacity.i64()).usize()
                probes: mutable usize = 0
                while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, hashed, row, index, capacity, source_work|:
                    return ProofSourcePostconditionAstIndex{} if not proof_report_source_postcondition_work_charge(1, source_work)
                    current: usize = index.slot_values[slot]
                    if current == capacity:
                        row_index: usize = index.names.count
                        index.names.push(row.name)
                        index.function_offsets.push(row.function_offset)
                        index.lines.push(row.line)
                        index.source_indices.push(row.source_index)
                        index.contract_lines.push(row.contract_line)
                        index.counts.push(1)
                        index.expressions.push(row.expression)
                        index.hashes[slot] <- hashed.hash
                        index.slot_values[slot] <- row_index
                        break
                    if index.hashes[slot] == hashed.hash:
                        return ProofSourcePostconditionAstIndex{} if not proof_report_source_postcondition_work_charge(sview_len(row.name), source_work)
                        if index.names[current] == row.name and index.function_offsets[current] == row.function_offset and index.lines[current] == row.line and index.source_indices[current] == row.source_index:
                            index.counts[current] <- index.counts[current] + 1
                            break
                    slot <- (slot + 1) % capacity
                    probes <- probes + 1
                return ProofSourcePostconditionAstIndex{} if probes >= capacity or probes > PROOF_NAME_INDEX_MAX_CLUSTER
            return index

        def proof_source_postcondition_ast_index_find(index: ProofSourcePostconditionAstIndex, name: sview, function_offset: u32, line: u32, source_index: usize, source_work: mutable usize&) -> (complete: bool, found: bool, row: usize, count: usize, contract_line: u32, expression: Ast::Expr):
            empty: Ast::Expr = Ast::Expr.Invalid
            empty_row: usize = index.names.count
            capacity: usize = index.slot_values.count
            return (false, false, empty_row, 0, 0, empty) if:
                not index.valid
                index.hashes.count != capacity
            return (true, false, empty_row, 0, 0, empty) if capacity == 0
            key: ProofSourcePostconditionKey = ProofSourcePostconditionKey{name: name, function_offset: function_offset, line: line, source_index: source_index}
            hashed: (complete: bool, hash: u32) = proof_report_source_postcondition_hash(key, source_work)
            return (false, false, empty_row, 0, 0, empty) if not hashed.complete
            slot: mutable usize = (hashed.hash.i64() % capacity.i64()).usize()
            probes: mutable usize = 0
            while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, hashed, name, function_offset, line, source_index, index, capacity, source_work|:
                return (false, false, empty_row, 0, 0, empty) if not proof_report_source_postcondition_work_charge(1, source_work)
                current: usize = index.slot_values[slot]
                return (true, false, empty_row, 0, 0, empty) if current == capacity
                return (false, false, empty_row, 0, 0, empty) if current >= index.names.count or current >= index.function_offsets.count or current >= index.lines.count or current >= index.source_indices.count or current >= index.contract_lines.count or current >= index.counts.count or current >= index.expressions.count
                if index.hashes[slot] == hashed.hash:
                    return (false, false, empty_row, 0, 0, empty) if not proof_report_source_postcondition_work_charge(sview_len(name), source_work)
                    if index.names[current] == name and index.function_offsets[current] == function_offset and index.lines[current] == line and index.source_indices[current] == source_index:
                        return (true, true, current, index.counts[current], index.contract_lines[current], index.expressions[current])
                slot <- (slot + 1) % capacity
                probes <- probes + 1
            return (false, false, empty_row, 0, 0, empty)

        # Reconcile the complete parser-origin ensure inventory with the accounting ledger.
        # Per-goal source binding cannot detect a source contract for which the producer emitted
        # no obligation at all, so checked-view admission requires each AST row to be represented
        # by at least one exact ledger row. Multiple return paths may legitimately record the
        # same source postcondition more than once.
        def proof_source_postcondition_obligations_covered[@r](source: ProofSourceAnalysis[r]& @r, report: ProofReport&, source_work: mutable usize&) -> bool:
            return false if not source.postcondition_ast_inventory_complete or source.postcondition_ast_inventory_work_limited
            index: ProofSourcePostconditionAstIndex = proof_source_postcondition_ast_index_create(source.postcondition_ast_inventory, source_work)
            return false if not index.valid
            matched: mutable darray[bool] = []
            for _ in 0..<index.names.count |matched, source_work|:
                return false if not proof_report_source_postcondition_work_charge(1, source_work)
                matched.push(false)
            for expected in source.postcondition_ast_inventory |expected, index, source_work|:
                return false if not proof_report_source_postcondition_work_charge(1, source_work)
                identity: (complete: bool, found: bool, row: usize, count: usize, contract_line: u32, expression: Ast::Expr) = proof_source_postcondition_ast_index_find(index, expected.name, expected.function_offset, expected.line, expected.source_index, source_work)
                return false if not identity.complete or not identity.found or identity.row >= matched.count or identity.count != 1
            observed: mutable usize = 0
            for obligation in report.results.obligation_inventory |obligation, source, index, matched, observed, source_work|:
                return false if not proof_report_source_postcondition_work_charge(1, source_work)
                continue if obligation.source_kind != "postcondition"
                observed <- observed + 1
                lookup: (complete: bool, found: bool, row: usize, count: usize, contract_line: u32, expression: Ast::Expr) = proof_source_postcondition_ast_index_find(index, obligation.source_name, obligation.source_function_offset, obligation.source_line, obligation.source_obligation_index, source_work)
                return false if not lookup.complete or not lookup.found or lookup.row >= matched.count or lookup.count != 1
                matched[lookup.row] <- true
            return false if observed < source.postcondition_ast_inventory.count
            for found in matched |found, source_work|:
                return false if not proof_report_source_postcondition_work_charge(1, source_work) or not found
            source_work <= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
