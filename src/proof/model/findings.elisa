# Structured diagnostic record. Kept separate from the aggregate report model so findings can
# evolve their source, counterexample, and budget metadata without bloating the central model.
extend ElisaProof:
    public:
        struct ProofFinding:
            kind: sview
            # A diagnostic's status is refined after the fact when the goal attempt it is bound to
            # ended on a resource limit, so it is mutable like the goal binding below.
            status: mutable sview
            line: u32
            name: sview
            message: sview
            budget_dimension: mutable sview
            budget_observed: mutable usize
            budget_limit: mutable usize
            counterexample_start: usize
            counterexample_count: mutable usize
            counterexample_found: mutable bool
            goal_id: mutable usize
            has_goal: mutable bool
