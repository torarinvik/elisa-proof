# Source-bound goal admission against a checked report and parser inventories.
extend ElisaProof:
    private:
        def proof_report_postcondition_pattern_special_binders(pattern: Ast::Pattern, position: Ast::Pos, source: Ast::Expr, source_work: mutable usize&) -> (complete: bool, binds_result: bool, binds_old: bool):
            names: mutable darray[sview] = []
            values: mutable darray[Ast::Expr] = []
            # Both callers precharge the enclosing expression, including this pattern walk and
            # binding collection. Charge only the extra special-name comparisons below.
            return (false, false, false) if not proof_bind_pattern(pattern, position, source, &names, &values)
            binds_result: mutable bool = false
            binds_old: mutable bool = false
            for name in names |name, source_work, binds_result, binds_old|:
                return (false, false, false) if not proof_report_source_work_charge(1, source_work) or not proof_report_source_work_charge(sview_len(name), source_work) or not proof_report_source_work_charge(sview_len("result"), source_work) or not proof_report_source_work_charge(sview_len("old"), source_work)
                binds_result <- true if name == "result"
                binds_old <- true if name == "old"
            (true, binds_result, binds_old)

        def proof_report_postcondition_match_binder_visibility(pattern: Ast::Pattern, position: Ast::Pos, scrutinee: Ast::Expr, check_result: bool, check_old: bool, source_work: mutable usize&) -> (known: bool, check_result: bool, check_old: bool):
            binders: (complete: bool, binds_result: bool, binds_old: bool) = proof_report_postcondition_pattern_special_binders(pattern, position, scrutinee, source_work)
            return (false, check_result, check_old) if not binders.complete
            check_result <- false if binders.binds_result
            check_old <- false if binders.binds_old
            (true, check_result, check_old)

        def proof_report_goal_owner_is_source_declaration(report: ProofReport&, name: sview, owner_line: u32, owner_offset: u32, source_work: mutable usize&) -> bool:
            low: mutable usize = 0
            high: mutable usize = report.analysis_1.declaration_details.count
            # The report structure check binds declaration_details to parser order and offsets.
            while low < high |low, high, report, owner_offset, source_work|:
                return false if not proof_report_source_work_charge(1, source_work)
                middle: usize = low + (high - low) / 2
                if report.analysis_1.declaration_details[middle].source_offset < owner_offset:
                    low <- middle + 1
                else:
                    high <- middle
            matches: mutable usize = 0
            while low < report.analysis_1.declaration_details.count |low, report, name, owner_line, owner_offset, matches, source_work|:
                declaration: ProofDeclarationSummary = report.analysis_1.declaration_details[low]
                break if declaration.source_offset != owner_offset
                return false if not proof_report_source_work_charge(1, source_work) or not proof_report_source_work_charge(sview_len(declaration.name), source_work)
                if declaration.kind in {"function", "lemma"} and declaration.name == name and declaration.line == owner_line and declaration.source_offset == owner_offset:
                    matches <- matches + 1
                    return false if matches > 1
                low <- low + 1
            matches == 1

        # Fuse the two name checks and call check into one bounded AST walk. Unknown forms
        # remain unsafe, matching the fail-closed behavior of the underlying predicates.
        def proof_report_postcondition_has_unsafe_source_shape_depth(expression: Ast::Expr, depth: usize, check_result: bool, check_old: bool, allow_match_lowering: bool, source_work: mutable usize&) -> bool:
            return true if depth >= PROOF_REPLAY_AST_DEPTH_LIMIT or depth >= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT
            match expression:
                Ast::Expr.IntLit(_, _) | Ast::Expr.BoolLit(_, _) | Ast::Expr.FloatLit(_, _) | Ast::Expr.StringLit(_, _) | Ast::Expr.CharLit(_, _):
                    return false
                Ast::Expr.Ident(name, _):
                    return (check_result and name == "result") or (check_old and name == "old")
                Ast::Expr.Call(_, _, _, _) | Ast::Expr.StaticEffectCall(_, _, _, _, _, _):
                    return true
                Ast::Expr.Paren(inner, _) | Ast::Expr.Unary(_, inner, _) | Ast::Expr.Move(inner, _) | Ast::Expr.RegionNew(inner, _, _):
                    return proof_report_postcondition_has_unsafe_source_shape_depth(inner, depth + 1, check_result, check_old, allow_match_lowering, source_work)
                Ast::Expr.Binary(left, _, right, _) | Ast::Expr.Index(left, right, _):
                    return proof_report_postcondition_has_unsafe_source_shape_depth(left, depth + 1, check_result, check_old, allow_match_lowering, source_work) or proof_report_postcondition_has_unsafe_source_shape_depth(right, depth + 1, check_result, check_old, allow_match_lowering, source_work)
                Ast::Expr.Field(object, _, _):
                    return proof_report_postcondition_has_unsafe_source_shape_depth(object, depth + 1, check_result, check_old, allow_match_lowering, source_work)
                Ast::Expr.Scope(object, _, _):
                    return proof_report_postcondition_has_unsafe_source_shape_depth(object, depth + 1, check_result, check_old, allow_match_lowering, source_work)
                Ast::Expr.Slice(object, low, high, _):
                    return proof_report_postcondition_has_unsafe_source_shape_depth(object, depth + 1, check_result, check_old, allow_match_lowering, source_work) or proof_report_postcondition_has_unsafe_source_shape_depth(low, depth + 1, check_result, check_old, allow_match_lowering, source_work) or proof_report_postcondition_has_unsafe_source_shape_depth(high, depth + 1, check_result, check_old, allow_match_lowering, source_work)
                Ast::Expr.IndexN(object, arguments, _):
                    return true if proof_report_postcondition_has_unsafe_source_shape_depth(object, depth + 1, check_result, check_old, allow_match_lowering, source_work)
                    for argument in arguments:
                        return true if proof_report_postcondition_has_unsafe_source_shape_depth(argument, depth + 1, check_result, check_old, allow_match_lowering, source_work)
                    return false
                Ast::Expr.Array(elements, _) | Ast::Expr.Tuple(elements, _) | Ast::Expr.SetLit(elements, _):
                    for element in elements:
                        return true if proof_report_postcondition_has_unsafe_source_shape_depth(element, depth + 1, check_result, check_old, allow_match_lowering, source_work)
                    return false
                Ast::Expr.DictLit(entries, _):
                    for entry in entries:
                        return true if proof_report_postcondition_has_unsafe_source_shape_depth(entry.key, depth + 1, check_result, check_old, allow_match_lowering, source_work) or proof_report_postcondition_has_unsafe_source_shape_depth(entry.value, depth + 1, check_result, check_old, allow_match_lowering, source_work)
                    return false
                Ast::Expr.Construct(_, fields, _):
                    # The constructor head is a type expression; substitution only rewrites
                    # runtime values in the fields.
                    for field in fields:
                        return true if proof_report_postcondition_has_unsafe_source_shape_depth(field.value, depth + 1, check_result, check_old, allow_match_lowering, source_work)
                    return false
                Ast::Expr.RecordUpdate(base, fields, _):
                    return true if proof_report_postcondition_has_unsafe_source_shape_depth(base, depth + 1, check_result, check_old, allow_match_lowering, source_work)
                    for field in fields:
                        return true if proof_report_postcondition_has_unsafe_source_shape_depth(field.value, depth + 1, check_result, check_old, allow_match_lowering, source_work)
                    return false
                Ast::Expr.If(condition, then_expression, else_expression, _):
                    return proof_report_postcondition_has_unsafe_source_shape_depth(condition, depth + 1, check_result, check_old, allow_match_lowering, source_work) or proof_report_postcondition_has_unsafe_source_shape_depth(then_expression, depth + 1, check_result, check_old, allow_match_lowering, source_work) or proof_report_postcondition_has_unsafe_source_shape_depth(else_expression, depth + 1, check_result, check_old, allow_match_lowering, source_work)
                Ast::Expr.Match(scrutinee, arms, position):
                    # Plain substitution invokes an unmetered lowerer that can duplicate the
                    # scrutinee once per arm. Admission rejects this path until lowering shares
                    # the caller's source-work budget.
                    return true if not allow_match_lowering
                    return true if proof_report_postcondition_has_unsafe_source_shape_depth(scrutinee, depth + 1, check_result, check_old, allow_match_lowering, source_work)
                    for arm in arms:
                        return true if arm.body.count != 1
                        return true if not proof_match_closed_pattern(arm.pattern)
                        arm_visibility: (known: bool, check_result: bool, check_old: bool) = proof_report_postcondition_match_binder_visibility(arm.pattern, position, scrutinee, check_result, check_old, source_work)
                        return true if not arm_visibility.known
                        return true if arm.guard != Ast::Expr.Absent and proof_report_postcondition_has_unsafe_source_shape_depth(arm.guard, depth + 1, arm_visibility.check_result, arm_visibility.check_old, allow_match_lowering, source_work)
                        match arm.body[0]:
                            Ast::Stmt.Expr(value, _):
                                return true if proof_report_postcondition_has_unsafe_source_shape_depth(value, depth + 1, arm_visibility.check_result, arm_visibility.check_old, allow_match_lowering, source_work)
                            _:
                                return true
                    return false
                Ast::Expr.Comprehension(variable, iterable, condition, body, _):
                    return true if proof_report_postcondition_has_unsafe_source_shape_depth(iterable, depth + 1, check_result, check_old, allow_match_lowering, source_work)
                    body_checks_result: bool = check_result and variable != "result"
                    body_checks_old: bool = check_old and variable != "old"
                    return proof_report_postcondition_has_unsafe_source_shape_depth(condition, depth + 1, body_checks_result, body_checks_old, allow_match_lowering, source_work) or proof_report_postcondition_has_unsafe_source_shape_depth(body, depth + 1, body_checks_result, body_checks_old, allow_match_lowering, source_work)
                Ast::Expr.Refinement(base, predicate, _):
                    return proof_report_postcondition_has_unsafe_source_shape_depth(base, depth + 1, check_result, check_old, allow_match_lowering, source_work) or proof_report_postcondition_has_unsafe_source_shape_depth(predicate, depth + 1, check_result, check_old, allow_match_lowering, source_work)
                Ast::Expr.Block(statements, value, _, _):
                    value_checks_result: mutable bool = check_result
                    value_checks_old: mutable bool = check_old
                    for statement in statements |value_checks_result, value_checks_old|:
                        match statement:
                            Ast::Stmt.VarDecl(local_name, _, initializer, _):
                                # An initializer sees shadows from earlier declarations, but
                                # not the name introduced by this declaration itself.
                                return true if proof_report_postcondition_has_unsafe_source_shape_depth(initializer, depth + 1, value_checks_result, value_checks_old, allow_match_lowering, source_work)
                                value_checks_result <- false if local_name == "result"
                                value_checks_old <- false if local_name == "old"
                            _:
                                return true
                    proof_report_postcondition_has_unsafe_source_shape_depth(value, depth + 1, value_checks_result, value_checks_old, allow_match_lowering, source_work)
                _:
                    return true

        # Inspect result/old visibility and Match lowering eligibility together. The Match
        # subset and binder projection checks are shared with substitution, so perform them once
        # per arm while retaining the same fail-closed result for unsupported forms.
        def proof_report_postcondition_source_scan(expression: Ast::Expr, source_work: mutable usize&) -> (complete: bool, has_result: bool, has_old: bool, has_match: bool):
            has_result: mutable bool = false
            has_old: mutable bool = false
            has_match: mutable bool = false
            complete: bool = proof_report_postcondition_source_scan_depth(expression, 0, true, true, &has_result, &has_old, &has_match, source_work)
            (complete, has_result, has_old, has_match)

        def proof_report_postcondition_source_scan_depth(expression: Ast::Expr, depth: usize, result_visible: bool, old_visible: bool, has_result: mutable bool&, has_old: mutable bool&, has_match: mutable bool&, source_work: mutable usize&) -> bool:
            return false if depth >= PROOF_REPLAY_AST_DEPTH_LIMIT or depth >= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT
            return true if has_old or (has_result and has_match)
            match expression:
                Ast::Expr.IntLit(_, _) | Ast::Expr.BoolLit(_, _) | Ast::Expr.FloatLit(_, _) | Ast::Expr.StringLit(_, _) | Ast::Expr.CharLit(_, _):
                    return true
                Ast::Expr.Ident(name, _):
                    has_result <- true if result_visible and name == "result"
                    has_old <- true if old_visible and name == "old"
                    return true
                Ast::Expr.Paren(inner, _) | Ast::Expr.Unary(_, inner, _) | Ast::Expr.Move(inner, _) | Ast::Expr.RegionNew(inner, _, _):
                    return proof_report_postcondition_source_scan_depth(inner, depth + 1, result_visible, old_visible, has_result, has_old, has_match, source_work)
                Ast::Expr.Binary(left, _, right, _) | Ast::Expr.Index(left, right, _):
                    return false if not proof_report_postcondition_source_scan_depth(left, depth + 1, result_visible, old_visible, has_result, has_old, has_match, source_work)
                    proof_report_postcondition_source_scan_depth(right, depth + 1, result_visible, old_visible, has_result, has_old, has_match, source_work)
                Ast::Expr.Field(object, _, _) | Ast::Expr.Scope(object, _, _):
                    return proof_report_postcondition_source_scan_depth(object, depth + 1, result_visible, old_visible, has_result, has_old, has_match, source_work)
                Ast::Expr.Slice(object, low, high, _):
                    return false if not proof_report_postcondition_source_scan_depth(object, depth + 1, result_visible, old_visible, has_result, has_old, has_match, source_work)
                    return false if not proof_report_postcondition_source_scan_depth(low, depth + 1, result_visible, old_visible, has_result, has_old, has_match, source_work)
                    proof_report_postcondition_source_scan_depth(high, depth + 1, result_visible, old_visible, has_result, has_old, has_match, source_work)
                Ast::Expr.IndexN(object, arguments, _):
                    return false if not proof_report_postcondition_source_scan_depth(object, depth + 1, result_visible, old_visible, has_result, has_old, has_match, source_work)
                    for argument in arguments |depth, result_visible, old_visible, has_result, has_old, has_match, source_work|:
                        return false if not proof_report_postcondition_source_scan_depth(argument, depth + 1, result_visible, old_visible, has_result, has_old, has_match, source_work)
                    return true
                Ast::Expr.Array(elements, _) | Ast::Expr.Tuple(elements, _) | Ast::Expr.SetLit(elements, _):
                    for element in elements |depth, result_visible, old_visible, has_result, has_old, has_match, source_work|:
                        return false if not proof_report_postcondition_source_scan_depth(element, depth + 1, result_visible, old_visible, has_result, has_old, has_match, source_work)
                    return true
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |depth, result_visible, old_visible, has_result, has_old, has_match, source_work|:
                        return false if not proof_report_postcondition_source_scan_depth(entry.key, depth + 1, result_visible, old_visible, has_result, has_old, has_match, source_work)
                        return false if not proof_report_postcondition_source_scan_depth(entry.value, depth + 1, result_visible, old_visible, has_result, has_old, has_match, source_work)
                    return true
                Ast::Expr.Construct(_, fields, _):
                    # The constructor head is a type expression; substitution only rewrites
                    # runtime values in the fields.
                    for field in fields |depth, result_visible, old_visible, has_result, has_old, has_match, source_work|:
                        return false if not proof_report_postcondition_source_scan_depth(field.value, depth + 1, result_visible, old_visible, has_result, has_old, has_match, source_work)
                    return true
                Ast::Expr.RecordUpdate(base, fields, _):
                    return false if not proof_report_postcondition_source_scan_depth(base, depth + 1, result_visible, old_visible, has_result, has_old, has_match, source_work)
                    for field in fields |depth, result_visible, old_visible, has_result, has_old, has_match, source_work|:
                        return false if not proof_report_postcondition_source_scan_depth(field.value, depth + 1, result_visible, old_visible, has_result, has_old, has_match, source_work)
                    return true
                Ast::Expr.If(condition, then_expression, else_expression, _):
                    return false if not proof_report_postcondition_source_scan_depth(condition, depth + 1, result_visible, old_visible, has_result, has_old, has_match, source_work)
                    return false if not proof_report_postcondition_source_scan_depth(then_expression, depth + 1, result_visible, old_visible, has_result, has_old, has_match, source_work)
                    proof_report_postcondition_source_scan_depth(else_expression, depth + 1, result_visible, old_visible, has_result, has_old, has_match, source_work)
                Ast::Expr.Match(scrutinee, arms, position):
                    has_match <- true
                    return false if has_result
                    return false if not proof_report_postcondition_source_scan_depth(scrutinee, depth + 1, result_visible, old_visible, has_result, has_old, has_match, source_work)
                    return false if has_result
                    for arm in arms |position, depth, result_visible, old_visible, has_result, has_old, has_match, source_work|:
                        return false if arm.body.count != 1 or not proof_match_closed_pattern(arm.pattern)
                        arm_visibility: (known: bool, check_result: bool, check_old: bool) = proof_report_postcondition_match_binder_visibility(arm.pattern, position, scrutinee, result_visible, old_visible, source_work)
                        return false if not arm_visibility.known
                        if arm.guard != Ast::Expr.Absent:
                            return false if not proof_report_postcondition_source_scan_depth(arm.guard, depth + 1, arm_visibility.check_result, arm_visibility.check_old, has_result, has_old, has_match, source_work)
                        match arm.body[0]:
                            Ast::Stmt.Expr(value, _):
                                return false if not proof_report_postcondition_source_scan_depth(value, depth + 1, arm_visibility.check_result, arm_visibility.check_old, has_result, has_old, has_match, source_work)
                            _:
                                return false
                    return true
                Ast::Expr.Comprehension(variable, iterable, condition, body, _):
                    return false if not proof_report_postcondition_source_scan_depth(iterable, depth + 1, result_visible, old_visible, has_result, has_old, has_match, source_work)
                    body_result_visible: bool = result_visible and variable != "result"
                    body_old_visible: bool = old_visible and variable != "old"
                    return false if not proof_report_postcondition_source_scan_depth(condition, depth + 1, body_result_visible, body_old_visible, has_result, has_old, has_match, source_work)
                    proof_report_postcondition_source_scan_depth(body, depth + 1, body_result_visible, body_old_visible, has_result, has_old, has_match, source_work)
                Ast::Expr.Refinement(base, predicate, _):
                    return false if not proof_report_postcondition_source_scan_depth(base, depth + 1, result_visible, old_visible, has_result, has_old, has_match, source_work)
                    proof_report_postcondition_source_scan_depth(predicate, depth + 1, result_visible, old_visible, has_result, has_old, has_match, source_work)
                Ast::Expr.Block(statements, value, _, _):
                    value_result_visible: mutable bool = result_visible
                    value_old_visible: mutable bool = old_visible
                    for statement in statements |value_result_visible, value_old_visible, depth, has_result, has_old, has_match, source_work|:
                        match statement:
                            Ast::Stmt.VarDecl(local_name, _, initializer, _):
                                return false if not proof_report_postcondition_source_scan_depth(initializer, depth + 1, value_result_visible, value_old_visible, has_result, has_old, has_match, source_work)
                                value_result_visible <- false if local_name == "result"
                                value_old_visible <- false if local_name == "old"
                            _:
                                return false
                    proof_report_postcondition_source_scan_depth(value, depth + 1, value_result_visible, value_old_visible, has_result, has_old, has_match, source_work)
                _:
                    # Calls, recovery expressions, and unknown syntax remain inadmissible.
                    return false

        # The frozen parser inventory is sorted by declaration offset. Duplicate offsets remain
        # visible and fail closed, while ordinary owner lookup is logarithmic in function count.
        def proof_report_postcondition_return_lookup(inventory: darray[(name: sview, line: u32, offset: u32, supported: bool, expression: Ast::Expr)]&, name: sview, line: u32, offset: u32, source_work: mutable usize&) -> (complete: bool, found: bool, supported: bool, expression: Ast::Expr):
            absent: Ast::Expr = Ast::Expr.Absent
            low: mutable usize = 0
            high: mutable usize = inventory.count
            while low < high |low, high, inventory, offset, source_work|:
                return (false, false, false, absent) if not proof_report_source_work_charge(1, source_work)
                middle: usize = low + (high - low) / 2
                if inventory[middle].offset < offset:
                    low <- middle + 1
                else:
                    high <- middle
            return (true, false, false, absent) if low >= inventory.count or inventory[low].offset != offset
            first: usize = low
            count: mutable usize = 0
            selected: mutable (name: sview, line: u32, offset: u32, supported: bool, expression: Ast::Expr) = inventory[first]
            selected_matches: mutable bool = false
            while low < inventory.count and inventory[low].offset == offset |low, inventory, name, line, source_work, count, selected, selected_matches|:
                row: (name: sview, line: u32, offset: u32, supported: bool, expression: Ast::Expr) = inventory[low]
                return (false, false, false, absent) if not proof_report_source_work_charge(1, source_work) or not proof_report_source_work_charge(sview_len(row.name), source_work) or not proof_report_source_work_charge(sview_len(name), source_work)
                count <- count + 1
                if row.name == name and row.line == line:
                    selected <- row
                    selected_matches <- true
                low <- low + 1
            return (true, false, false, absent) if count != 1 or not selected_matches
            (true, true, selected.supported, selected.expression)

        def proof_report_postcondition_result_substitution_matches(source_expression: Ast::Expr, return_inventory: darray[(name: sview, line: u32, offset: u32, supported: bool, expression: Ast::Expr)]&, report: ProofReport&, attempt: ProofGoalAttempt, source_work: mutable usize&) -> bool:
            return false if attempt.owner_function_line == 0
            return_row: (complete: bool, found: bool, supported: bool, expression: Ast::Expr) = proof_report_postcondition_return_lookup(return_inventory, attempt.name, attempt.owner_function_line, attempt.owner_function_offset, source_work)
            returned: Ast::Expr = return_row.expression
            return false if not return_row.complete or not return_row.found or not return_row.supported
            work_limit: usize = proof_replay_summary_source_work_limit()
            # The size extraction and `proof_substitute` below each traverse the contract.
            # Reserve both passes before using its measured size to bound replacement growth.
            return false if not proof_replay_summary_expr_repeat_charge_with_limit(source_expression, 2, source_work, work_limit)
            source_expression_cost: mutable usize = 0
            overloaded_return_work_exhausted: mutable bool = false
            return false if:
                not proof_replay_summary_expr_cost_with_limit(source_expression, &source_expression_cost, source_work, work_limit)
                not proof_replay_summary_expr_repeat_charge_with_limit(returned, source_expression_cost + 1, source_work, work_limit)
                proof_report_postcondition_has_unsafe_source_shape_depth(returned, 0, true, true, true, source_work)
                proof_source_expression_has_overloaded_operator_with_work(returned, report.source.source_primitive_operator_mask, source_work, overloaded_return_work_exhausted)
                overloaded_return_work_exhausted
            names: mutable darray[sview] = ["result"]
            values: mutable darray[Ast::Expr] = [returned]
            substituted: Ast::Expr = proof_substitute(source_expression, names, values)
            return false if not proof_replay_summary_expr_equal_with_limit(substituted, attempt.goal, source_work, work_limit)
            true

        # Validate a goal after the caller has checked report-wide structure. Batch callers
        # pass precomputed finding and literal-source snapshots so report ledgers are scanned once.
        def proof_report_source_postcondition_ast_goal_attempt_admitted(source_expression: Ast::Expr, return_inventory: darray[(name: sview, line: u32, offset: u32, supported: bool, expression: Ast::Expr)]&, report: ProofReport&, goal_id: usize, source_work: mutable usize&) -> bool:
            return false if goal_id >= report.results.goal_attempts.count
            attempt: ProofGoalAttempt = report.results.goal_attempts[goal_id]
            work_limit: usize = proof_replay_summary_source_work_limit()
            overloaded_source_work_exhausted: mutable bool = false
            return false if:
                not proof_replay_summary_expr_repeat_charge_with_limit(source_expression, 1, source_work, work_limit)
            source_scan: (complete: bool, has_result: bool, has_old: bool, has_match: bool) = proof_report_postcondition_source_scan(source_expression, source_work)
            return false if not source_scan.complete or source_scan.has_old or (source_scan.has_match and source_scan.has_result)
            has_result_variable: bool = source_scan.has_result
            return false if:
                proof_source_expression_has_overloaded_operator_with_work(source_expression, report.source.source_primitive_operator_mask, source_work, overloaded_source_work_exhausted)
                overloaded_source_work_exhausted
            if has_result_variable:
                return false if not proof_report_postcondition_result_substitution_matches(source_expression, return_inventory, report, attempt, source_work)
            else:
                # Without a result variable, compare the parser-owned expression directly; the
                # equality walk is already bounded by the shared source-work limit.
                return false if not proof_replay_summary_expr_equal_with_limit(source_expression, attempt.goal, source_work, work_limit)
            if attempt.producer_proven:
                return false if not attempt.has_certificate or attempt.certificate_index >= report.analysis_1.certificates.count
                certificate: ProofGoalCertificate = report.analysis_1.certificates[attempt.certificate_index]
                return false if:
                    not proof_replay_summary_expr_equal_with_limit(attempt.goal, certificate.goal, source_work, work_limit)
            return true

        def proof_report_goal_source_admissible_after_structure_internal(report: ProofReport&, return_inventory: darray[(name: sview, line: u32, offset: u32, supported: bool, expression: Ast::Expr)]&, has_return_inventory: bool, goal_id: usize, literal_ensure_inventory: darray[(name: sview, function_offset: u32, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool)]&, literal_index: ProofSourceLiteralEnsureAdmissionIndex, has_literal_index: bool, postcondition_ast_index: ProofSourcePostconditionAstIndex, has_postcondition_ast_index: bool, assert_by_inventory: darray[(name: sview, function_offset: u32, attempt_line: u32, goal_line: u32, goal_offset: u32, expected_value: bool, source_goal: Ast::Expr, supported: bool)]&, goal_finding_clear: darray[bool]&, has_finding_snapshot: bool, source_work: mutable usize&) -> bool:
            return false if goal_id >= report.results.goal_attempts.count
            attempt: ProofGoalAttempt = report.results.goal_attempts[goal_id]
            selected_event: (found: bool, entry: ProofObligationEntry) = proof_report_obligation_event_for_goal(report, goal_id, source_work)
            return false if not selected_event.found
            selected: ProofObligationEntry = selected_event.entry
            return false if:
                selected.owner_function_line == 0
                attempt.owner_function_line != selected.owner_function_line
                attempt.owner_function_offset != selected.owner_function_offset
                not proof_report_goal_owner_is_source_declaration(report, attempt.name, selected.owner_function_line, selected.owner_function_offset, source_work)
            source_kind_bytes: usize = sview_len(selected.source_kind)
            return false if not proof_report_source_work_charge(source_kind_bytes, source_work)
            event_admitted: mutable bool = false
            if selected.source_kind == "postcondition":
                return false if:
                    not proof_report_source_work_charge(sview_len(selected.source_name), source_work)
                    not proof_report_source_work_charge(sview_len(attempt.name), source_work)
                    selected.source_name != attempt.name
                    selected.owner_function_line != selected.source_line
                    selected.owner_function_offset != selected.source_function_offset
                # The report line names the function; literal rows key the ensure statement.
                source_contract_line: mutable u32 = 0
                if has_postcondition_ast_index:
                    source_ast: (complete: bool, found: bool, count: usize, contract_line: u32, expression: Ast::Expr) = proof_source_postcondition_ast_index_find(postcondition_ast_index, selected.source_name, selected.source_function_offset, selected.source_line, selected.source_obligation_index, source_work)
                    return false if not source_ast.complete or not source_ast.found or source_ast.count != 1
                    source_contract_line <- source_ast.contract_line
                    event_admitted <- has_return_inventory and proof_report_source_postcondition_ast_goal_attempt_admitted(source_ast.expression, return_inventory, report, goal_id, source_work)
                if has_literal_index:
                    return false if not has_postcondition_ast_index
                    if not event_admitted:
                        literal_match: (complete: bool, found: bool, count: usize, expected_index: usize) = proof_source_literal_ensure_admission_index_find(literal_index, selected.source_name, selected.source_function_offset, source_contract_line, source_work)
                        return false if not literal_match.complete or not literal_match.found or literal_match.count != 1 or literal_match.expected_index >= literal_ensure_inventory.count
                        expected: (name: sview, function_offset: u32, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool) = literal_ensure_inventory[literal_match.expected_index]
                        return false if not proof_report_source_work_charge(sview_len(expected.returned_parameter), source_work)
                        event_admitted <- selected.source_obligation_index == 0 and proof_report_source_literal_ensure_goal_attempt_admitted(expected, report, goal_id, source_work)
            elif selected.source_kind in {"changes", "preserves", "allow", "preserve"}:
                event_admitted <- false
            elif selected.source_kind == "":
                event_admitted <- proof_source_assert_by_goal_attempt_admitted(assert_by_inventory, report, goal_id, source_work)
            else:
                return false
            return false if not event_admitted
            if has_finding_snapshot:
                return false if goal_id >= goal_finding_clear.count or not goal_finding_clear[goal_id]
            else:
                for finding in report.results.findings |attempt, selected, source_work|:
                    return false if:
                        not proof_report_source_work_charge(1, source_work)
                        not proof_report_source_work_charge(sview_len(finding.name), source_work)
                        not proof_report_source_work_charge(sview_len(attempt.name), source_work)
                    associated: mutable bool = finding.has_goal and finding.goal_id == goal_id
                    associated <- true if finding.name == attempt.name and (finding.line == attempt.line or finding.line == selected.source_line)
                    if associated:
                        return false if not proof_report_source_work_charge(sview_len(finding.kind), source_work)
                        if finding.kind == "contract-proposition-type":
                            return false
                        return false if not proof_report_source_work_charge(sview_len(finding.kind), source_work)
                        if finding.kind == "parse-error":
                            return false
                        return false if not proof_report_source_work_charge(sview_len(finding.kind), source_work)
                        if finding.kind == "arithmetic-safety-refuted":
                            return false
                        return false if:
                            not proof_report_source_work_charge(sview_len(finding.kind), source_work)
                            finding.kind == "semantic-permission-ungranted"
            return true

        def proof_report_goal_source_admissible_after_structure(report: ProofReport&, goal_id: usize, literal_ensure_inventory: darray[(name: sview, function_offset: u32, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool)]&, assert_by_inventory: darray[(name: sview, function_offset: u32, attempt_line: u32, goal_line: u32, goal_offset: u32, expected_value: bool, source_goal: Ast::Expr, supported: bool)]&, source_work: mutable usize&) -> bool:
            no_finding_snapshot: darray[bool] = []
            no_returns: darray[(name: sview, line: u32, offset: u32, supported: bool, expression: Ast::Expr)] = []
            proof_report_goal_source_admissible_after_structure_internal(report, no_returns, false, goal_id, literal_ensure_inventory, ProofSourceLiteralEnsureAdmissionIndex{}, false, ProofSourcePostconditionAstIndex{}, false, assert_by_inventory, no_finding_snapshot, false, source_work)

        def proof_report_goal_source_admissible_after_structure_with_snapshots(report: ProofReport&, return_inventory: darray[(name: sview, line: u32, offset: u32, supported: bool, expression: Ast::Expr)]&, goal_id: usize, literal_ensure_inventory: darray[(name: sview, function_offset: u32, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool)]&, literal_index: ProofSourceLiteralEnsureAdmissionIndex, postcondition_ast_index: ProofSourcePostconditionAstIndex, assert_by_inventory: darray[(name: sview, function_offset: u32, attempt_line: u32, goal_line: u32, goal_offset: u32, expected_value: bool, source_goal: Ast::Expr, supported: bool)]&, goal_finding_clear: darray[bool]&, source_work: mutable usize&) -> bool:
            return false if not literal_index.valid or not postcondition_ast_index.valid
            proof_report_goal_source_admissible_after_structure_internal(report, return_inventory, true, goal_id, literal_ensure_inventory, literal_index, true, postcondition_ast_index, true, assert_by_inventory, goal_finding_clear, true, source_work)

    private:
        # This raw helper is used only after the checked-view transaction has supplied its frozen
        # parser inventories. Public source decisions are issued through ProofCheckedView.
        def proof_report_goal_source_admissible(report: ProofReport&, goal_id: usize, import_failed: bool, semantic_errors: u32, literal_ensure_inventory: darray[(name: sview, function_offset: u32, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool)]&, assert_by_inventory: darray[(name: sview, function_offset: u32, attempt_line: u32, goal_line: u32, goal_offset: u32, expected_value: bool, source_goal: Ast::Expr, supported: bool)]&) -> bool:
            return false if goal_id >= report.results.goal_attempts.count or import_failed or semantic_errors != 0
            source_work: mutable usize = 0
            return false if not proof_report_source_structure_consistent(report, &source_work)
            proof_report_goal_source_admissible_after_structure(report, goal_id, literal_ensure_inventory, assert_by_inventory, &source_work)
