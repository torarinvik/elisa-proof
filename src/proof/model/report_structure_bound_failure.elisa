extend ElisaProof:
    private:
        def proof_source_analysis_report_structure_bound_failure[@r](source: ProofSourceAnalysis[r]& @r, report: ProofReport&, scheduled_owners: darray[ProofSourceScheduledOwner]&, source_certificates_checked: bool, source_work: mutable usize&) -> sview:
            return "source-validation-incomplete" if not source.issued or not report.source.source_analysis_bound or report.source.source_file_identity != source.file_identity
            return "source-admission-work-limit" if source_work > proof_replay_summary_source_work_limit()
            generic_params_match: bool = proof_source_generic_param_snapshot_matches(source, report, source_work)
            return "source-admission-work-limit" if source_work > proof_replay_summary_source_work_limit()
            return "generic-parameter-source-inventory" if not generic_params_match
            source_annotations_match: bool = proof_source_annotations_snapshot_matches(source, report, source_work)
            return "source-admission-work-limit" if source_work > proof_replay_summary_source_work_limit()
            return "source-annotation-inventory" if not source_annotations_match
            source_work_limit: usize = proof_replay_summary_source_work_limit()
            return "finding-count" if not proof_report_failure_count_consistent(report)
            finding_evidence_consistent: bool = proof_report_finding_evidence_consistent_with_work(report, source_work)
            return "source-admission-work-limit" if source_work > source_work_limit
            return "finding-evidence" if not finding_evidence_consistent
            declarations_consistent: bool = proof_report_declaration_inventory_consistent(report, source_work)
            if not declarations_consistent:
                return "source-admission-work-limit" if source_work > source_work_limit
                return "declaration-inventory"
            obligation_consistent: bool = proof_report_obligation_inventory_consistent(report, source_work)
            return "source-admission-work-limit" if source_work > source_work_limit
            return "obligation-inventory" if not obligation_consistent
            frame_clauses_covered: bool = proof_report_frame_clause_inventory_consistent(report, source.file.top_decls, source_work)
            return "source-admission-work-limit" if source_work > source_work_limit
            return "source-frame-clause-coverage" if not frame_clauses_covered
            postconditions_covered: bool = proof_source_postcondition_obligations_covered(source, report, source_work)
            return "source-admission-work-limit" if source_work > source_work_limit
            return "source-postcondition-obligation-coverage" if not postconditions_covered
            effect_containment_covered: bool = proof_source_effect_containment_coverage(source.file.top_decls, report, source_work)
            return "source-admission-work-limit" if source_work > source_work_limit
            return "source-effect-containment-coverage" if not effect_containment_covered
            resource_safety_covered: bool = proof_source_resource_safety_coverage(source.file, report, source_work)
            return "source-admission-work-limit" if source_work > source_work_limit
            return "source-resource-safety-coverage" if not resource_safety_covered
            has_open_goal: mutable bool = false
            attempts_bounded: bool = proof_report_goal_attempts_bounded_by_obligations(report, source_work, false, &has_open_goal)
            return "source-admission-work-limit" if source_work > source_work_limit
            return "goal-attempt-coverage" if not attempts_bounded
            loop_invariants_covered: bool = proof_source_loop_invariant_source_coverage_with_declarations(report, source.file.top_decls, source_work)
            return "source-admission-work-limit" if source_work > source_work_limit
            return "source-loop-invariant-coverage" if not loop_invariants_covered
            loop_transfers_covered: bool = proof_source_loop_transfer_source_coverage(report, source_work)
            return "source-admission-work-limit" if source_work > proof_replay_summary_source_work_limit()
            return "source-loop-transfer-coverage" if not loop_transfers_covered
            recursive_calls_covered: bool = proof_source_recursive_call_obligations_covered(report, source.file.top_decls, scheduled_owners, source_certificates_checked, source_work)
            return "source-admission-work-limit" if source_work > source_work_limit
            return "source-recursive-call-obligation-coverage" if not recursive_calls_covered
            proven_attempts_consistent: bool = proof_report_proven_attempts_consistent_with_declarations(report, source.file.top_decls, source_work)
            return "source-admission-work-limit" if source_work > source_work_limit
            return "proven-attempt-certificates" if not proven_attempts_consistent
            default_calls_safe: bool = proof_report_default_call_requires_safe(source.file.top_decls, source.file.signature_contract_lines, source.file.signature_contract_kinds, source.file.signature_contract_exprs, source_work)
            return "source-admission-work-limit" if source_work > source_work_limit
            return "source-default-call-requires-unsupported" if not default_calls_safe
            ""
