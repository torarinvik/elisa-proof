extend ElisaProof:
    private:
        struct ProofSourceEffectIndex:
            declared_types: mutable darray[sview] = []
            declared_type_owners: mutable darray[sview] = []
            declared_type_scope_index_hashes: mutable darray[u32] = []
            declared_type_scope_index_values: mutable darray[usize] = []
            declared_type_scope_index_counts: mutable darray[usize] = []
            declared_type_scope_index_valid: mutable bool = false
            drop_hook_types: mutable darray[sview] = []
            drop_hook_index_hashes: mutable darray[u32] = []
            drop_hook_index_values: mutable darray[usize] = []
            drop_hook_index_counts: mutable darray[usize] = []
            drop_hook_index_valid: mutable bool = false
            alias_names: mutable darray[sview] = []
            alias_targets: mutable darray[Ast::Expr] = []
            alias_lines: mutable darray[u32] = []
            alias_owners: mutable darray[sview] = []
            resource_marker_type_names: mutable darray[sview] = []
            resource_marker_type_targets: mutable darray[Ast::Expr] = []
            resource_marker_type_is_alias: mutable darray[bool] = []
            resource_marker_type_nested_scope: mutable darray[bool] = []
            resource_marker_type_index_hashes: mutable darray[u32] = []
            resource_marker_type_index_values: mutable darray[usize] = []
            resource_marker_type_index_counts: mutable darray[usize] = []
            resource_marker_type_index_valid: mutable bool = false
            bare_alias_root_fallback_valid: mutable bool = false
            alias_scope_index_hashes: mutable darray[u32] = []
            alias_scope_index_values: mutable darray[usize] = []
            alias_scope_index_counts: mutable darray[usize] = []
            alias_scope_index_valid: mutable bool = false
            alias_index_hashes: mutable darray[u32] = []
            alias_index_values: mutable darray[usize] = []
            alias_index_counts: mutable darray[usize] = []
            alias_index_valid: mutable bool = false
            generic_param_index_hashes: mutable darray[u32] = []
            generic_param_index_values: mutable darray[usize] = []
            generic_param_index_counts: mutable darray[usize] = []
            generic_param_index_valid: mutable bool = false
            generic_param_encoded_line_present: mutable bool = false
            generic_param_line_index_hashes: mutable darray[u32] = []
            generic_param_line_index_values: mutable darray[usize] = []
            generic_param_line_index_counts: mutable darray[usize] = []
            generic_param_line_index_valid: mutable bool = false
            generic_param_names: mutable darray[sview] = []
            alias_has_formals: mutable darray[bool] = []
            declared_type_index_hashes: mutable darray[u32] = []
            declared_type_index_values: mutable darray[usize] = []
            declared_type_index_counts: mutable darray[usize] = []
            declared_type_index_valid: mutable bool = false
            callable_names: mutable darray[sview] = []
            callable_return_types: mutable darray[Ast::Expr] = []
            callable_lines: mutable darray[u32] = []
            callable_index_hashes: mutable darray[u32] = []
            callable_index_values: mutable darray[usize] = []
            callable_index_counts: mutable darray[usize] = []
            callable_index_valid: mutable bool = false
            # Every source function and extern spelling, including non-callable extern rows,
            # shadows field-based primitive conversions during replay.
            field_conversion_names: mutable darray[sview] = []
            field_conversion_index_hashes: mutable darray[u32] = []
            field_conversion_index_values: mutable darray[usize] = []
            field_conversion_index_counts: mutable darray[usize] = []
            field_conversion_index_valid: mutable bool = false
            field_conversion_custom_cast_present: mutable bool = false
            # Source contracts attached to callable, non-trusted externs that could hide
            # executable calls. Built once from declarations and the signature side table.
            extern_contract_names: mutable darray[sview] = []
            extern_contract_lines: mutable darray[u32] = []
            extern_contract_unsafe: mutable darray[bool] = []
            extern_contract_hashes: mutable darray[u32] = []
            extern_contract_slots: mutable darray[usize] = []
            extern_contract_ambiguous: mutable darray[bool] = []
            extern_contract_index_valid: mutable bool = false
            declaration_count: mutable usize = 0
            implicit_effect_work: mutable usize = 0
