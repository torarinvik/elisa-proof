extend ElisaProof:
    private:
        const PROOF_SOURCE_POSTCONDITION_AST_DEPTH_LIMIT: usize = 64

        struct ProofSourcePostconditionKey:
            name: sview
            function_offset: u32
            line: u32
            source_index: usize

        struct ProofSourcePostconditionCountIndex:
            slot_values: mutable darray[usize] = []
            hashes: mutable darray[u32] = []
            names: mutable darray[sview] = []
            function_offsets: mutable darray[u32] = []
            lines: mutable darray[u32] = []
            source_indices: mutable darray[usize] = []
            counts: mutable darray[usize] = []
            valid: bool = false

        struct ProofSourceLiteralEnsureAdmissionIndex:
            slot_values: mutable darray[usize] = []
            hashes: mutable darray[u32] = []
            names: mutable darray[sview] = []
            function_offsets: mutable darray[u32] = []
            contract_lines: mutable darray[u32] = []
            counts: mutable darray[usize] = []
            expected_indices: mutable darray[usize] = []
            valid: bool = false

        def proof_report_source_postcondition_work_charge(amount: usize, work: mutable usize&) -> bool:
            proof_report_source_work_charge(amount, work)

        def proof_report_body_postcondition_count(body: darray[Ast::Stmt]&) -> usize:
            count: mutable usize = 0
            for statement in body |count|:
                match statement:
                    Ast::Stmt.Contract(kind, _, _):
                        count <- count + 1 if kind in {"ensure", "ensures"}
                    _:
                        pass
            return count

        def proof_report_source_postcondition_index_create(expected_keys: usize, source_work: mutable usize&) -> ProofSourcePostconditionCountIndex can[Memory.Allocate]:
            return ProofSourcePostconditionCountIndex{valid: true} if expected_keys == 0
            return ProofSourcePostconditionCountIndex{} if expected_keys > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 4
            capacity: mutable usize = 1
            target_capacity: usize = expected_keys * 2
            while capacity < target_capacity |capacity, target_capacity, expected_keys|:
                return ProofSourcePostconditionCountIndex{} if capacity > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 4
                capacity <- capacity * 2
            return ProofSourcePostconditionCountIndex{} if:
                not proof_report_source_postcondition_work_charge(capacity, source_work)
                not proof_report_source_postcondition_work_charge(capacity, source_work)
                not proof_report_source_postcondition_work_charge(capacity, source_work)
            index: mutable ProofSourcePostconditionCountIndex = ProofSourcePostconditionCountIndex{valid: true}
            index.slot_values.resize(capacity)
            index.hashes.resize(capacity)
            for slot in 0..<capacity |slot, index, capacity|:
                index.slot_values[slot] <- capacity
            return index

        def proof_report_source_postcondition_hash(key: ProofSourcePostconditionKey, source_work: mutable usize&) -> (complete: bool, hash: u32):
            return (false, 0) if not proof_report_source_postcondition_work_charge(sview_len(key.name), source_work)
            hash: mutable i64 = ElisaProofKernelCore::PROOF_KERNEL_FNV1A_OFFSET_BASIS
            for offset in 0..<sview_len(key.name) |offset, key, hash|:
                hash <- ((hash ^ sview_at(key.name, offset).i64()) * ElisaProofKernelCore::PROOF_KERNEL_FNV1A_PRIME) % ElisaProofKernelCore::PROOF_KERNEL_HASH_U32_MODULUS
            return (false, 0) if not proof_report_source_postcondition_work_charge(3, source_work)
            hash <- ((hash ^ key.function_offset.i64()) * ElisaProofKernelCore::PROOF_KERNEL_FNV1A_PRIME) % ElisaProofKernelCore::PROOF_KERNEL_HASH_U32_MODULUS
            hash <- ((hash ^ key.line.i64()) * ElisaProofKernelCore::PROOF_KERNEL_FNV1A_PRIME) % ElisaProofKernelCore::PROOF_KERNEL_HASH_U32_MODULUS
            hash <- ((hash ^ key.source_index.i64()) * ElisaProofKernelCore::PROOF_KERNEL_FNV1A_PRIME) % ElisaProofKernelCore::PROOF_KERNEL_HASH_U32_MODULUS
            (true, hash.u32())

        def proof_report_source_postcondition_index_add(index: mutable ProofSourcePostconditionCountIndex&, key: ProofSourcePostconditionKey, amount: usize, keep_first: bool, source_work: mutable usize&) -> bool:
            capacity: usize = index.slot_values.count
            return false if:
                not index.valid
                capacity == 0 or index.hashes.count != capacity
                index.names.count != index.function_offsets.count or index.names.count != index.lines.count or index.names.count != index.source_indices.count or index.names.count != index.counts.count
            hash_result: (complete: bool, hash: u32) = proof_report_source_postcondition_hash(key, source_work)
            return false if not hash_result.complete
            hash: u32 = hash_result.hash
            slot: mutable usize = (hash.i64() % capacity.i64()).usize()
            probes: mutable usize = 0
            while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, hash, key, amount, keep_first, index, capacity, source_work|:
                return false if not proof_report_source_postcondition_work_charge(1, source_work)
                current: usize = index.slot_values[slot]
                if current == capacity:
                    key_index: usize = index.names.count
                    index.names.push(key.name)
                    index.function_offsets.push(key.function_offset)
                    index.lines.push(key.line)
                    index.source_indices.push(key.source_index)
                    index.counts.push(amount)
                    index.hashes[slot] <- hash
                    index.slot_values[slot] <- key_index
                    return true
                return false if current >= capacity or current >= index.names.count
                if index.hashes[slot] == hash:
                    return false if not proof_report_source_postcondition_work_charge(sview_len(key.name), source_work)
                    if index.names[current] == key.name and index.function_offsets[current] == key.function_offset and index.lines[current] == key.line and index.source_indices[current] == key.source_index:
                        index.counts[current] <- index.counts[current] + amount if not keep_first
                        return true
                slot <- (slot + 1) % capacity
                probes <- probes + 1
            return false

        def proof_report_source_postcondition_index_find(index: ProofSourcePostconditionCountIndex, key: ProofSourcePostconditionKey, source_work: mutable usize&) -> (complete: bool, found: bool, count: usize):
            capacity: usize = index.slot_values.count
            return (false, false, 0) if not index.valid
            return (true, false, 0) if capacity == 0 and index.hashes.count == 0 and index.slot_values.count == 0
            return (false, false, 0) if:
                capacity == 0 or index.hashes.count != capacity
                index.names.count != index.function_offsets.count or index.names.count != index.lines.count or index.names.count != index.source_indices.count or index.names.count != index.counts.count
            hash_result: (complete: bool, hash: u32) = proof_report_source_postcondition_hash(key, source_work)
            return (false, false, 0) if not hash_result.complete
            hash: u32 = hash_result.hash
            slot: mutable usize = (hash.i64() % capacity.i64()).usize()
            probes: mutable usize = 0
            while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, hash, key, index, capacity, source_work|:
                return (false, false, 0) if not proof_report_source_postcondition_work_charge(1, source_work)
                current: usize = index.slot_values[slot]
                return (true, false, 0) if current == capacity
                return (false, false, 0) if current >= capacity or current >= index.names.count
                if index.hashes[slot] == hash:
                    return (false, false, 0) if not proof_report_source_postcondition_work_charge(sview_len(key.name), source_work)
                    return (true, true, index.counts[current]) if index.names[current] == key.name and index.function_offsets[current] == key.function_offset and index.lines[current] == key.line and index.source_indices[current] == key.source_index
                slot <- (slot + 1) % capacity
                probes <- probes + 1
            return (false, false, 0)

        # Batch goal admission needs the unique frozen literal postcondition row for a
        # `(declaration identity, contract line)` pair. Retain multiplicity and its first row so a
        # duplicate source identity fails closed without rescanning the inventory.
        def proof_source_literal_ensure_admission_index(inventory: darray[(name: sview, function_offset: u32, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool)]&, source_work: mutable usize&) -> ProofSourceLiteralEnsureAdmissionIndex can[Memory.Allocate]:
            return ProofSourceLiteralEnsureAdmissionIndex{valid: true} if inventory.count == 0
            return ProofSourceLiteralEnsureAdmissionIndex{} if inventory.count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 4
            capacity: mutable usize = 1
            target_capacity: usize = inventory.count * 2
            while capacity < target_capacity |capacity, target_capacity, inventory|:
                return ProofSourceLiteralEnsureAdmissionIndex{} if capacity > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 4
                capacity <- capacity * 2
            return ProofSourceLiteralEnsureAdmissionIndex{} if:
                not proof_report_source_postcondition_work_charge(capacity, source_work)
                not proof_report_source_postcondition_work_charge(capacity, source_work)
                not proof_report_source_postcondition_work_charge(capacity, source_work)
            index: mutable ProofSourceLiteralEnsureAdmissionIndex = ProofSourceLiteralEnsureAdmissionIndex{valid: true}
            index.slot_values.resize(capacity)
            index.hashes.resize(capacity)
            for slot in 0..<capacity |slot, index, capacity|:
                index.slot_values[slot] <- capacity
            for expected_index in 0..<inventory.count |expected_index, inventory, index, capacity, source_work|:
                return ProofSourceLiteralEnsureAdmissionIndex{} if not proof_report_source_postcondition_work_charge(1, source_work)
                expected: (name: sview, function_offset: u32, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool) = inventory[expected_index]
                key: ProofSourcePostconditionKey = ProofSourcePostconditionKey{name: expected.name, function_offset: expected.function_offset, line: expected.contract_line, source_index: 0}
                hash_result: (complete: bool, hash: u32) = proof_report_source_postcondition_hash(key, source_work)
                return ProofSourceLiteralEnsureAdmissionIndex{} if not hash_result.complete
                hash: u32 = hash_result.hash
                slot: mutable usize = (hash.i64() % capacity.i64()).usize()
                probes: mutable usize = 0
                while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, hash, expected, expected_index, index, capacity, source_work|:
                    return ProofSourceLiteralEnsureAdmissionIndex{} if not proof_report_source_postcondition_work_charge(1, source_work)
                    current: usize = index.slot_values[slot]
                    if current == capacity:
                        row: usize = index.names.count
                        index.names.push(expected.name)
                        index.function_offsets.push(expected.function_offset)
                        index.contract_lines.push(expected.contract_line)
                        index.counts.push(1)
                        index.expected_indices.push(expected_index)
                        index.hashes[slot] <- hash
                        index.slot_values[slot] <- row
                        break
                    if index.hashes[slot] == hash:
                        return ProofSourceLiteralEnsureAdmissionIndex{} if not proof_report_source_postcondition_work_charge(sview_len(expected.name), source_work)
                        if index.names[current] == expected.name and index.function_offsets[current] == expected.function_offset and index.contract_lines[current] == expected.contract_line:
                            index.counts[current] <- index.counts[current] + 1
                            break
                    slot <- (slot + 1) % capacity
                    probes <- probes + 1
                return ProofSourceLiteralEnsureAdmissionIndex{} if probes >= capacity or probes > PROOF_NAME_INDEX_MAX_CLUSTER
            return index

        def proof_source_literal_ensure_admission_index_find(index: ProofSourceLiteralEnsureAdmissionIndex, name: sview, function_offset: u32, contract_line: u32, source_work: mutable usize&) -> (complete: bool, found: bool, count: usize, expected_index: usize):
            capacity: usize = index.slot_values.count
            return (false, false, 0, 0) if not index.valid
            return (true, false, 0, 0) if capacity == 0 and index.hashes.count == 0
            return (false, false, 0, 0) if:
                capacity == 0 or index.hashes.count != capacity
                index.names.count != index.function_offsets.count or index.names.count != index.contract_lines.count or index.names.count != index.counts.count or index.names.count != index.expected_indices.count
            key: ProofSourcePostconditionKey = ProofSourcePostconditionKey{name: name, function_offset: function_offset, line: contract_line, source_index: 0}
            hash_result: (complete: bool, hash: u32) = proof_report_source_postcondition_hash(key, source_work)
            return (false, false, 0, 0) if not hash_result.complete
            hash: u32 = hash_result.hash
            slot: mutable usize = (hash.i64() % capacity.i64()).usize()
            probes: mutable usize = 0
            while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, hash, name, function_offset, contract_line, index, capacity, source_work|:
                return (false, false, 0, 0) if not proof_report_source_postcondition_work_charge(1, source_work)
                current: usize = index.slot_values[slot]
                return (true, false, 0, 0) if current == capacity
                if current >= index.names.count or current >= index.function_offsets.count or current >= index.contract_lines.count or current >= index.counts.count or current >= index.expected_indices.count:
                    return (false, false, 0, 0)
                if index.hashes[slot] == hash:
                    return (false, false, 0, 0) if not proof_report_source_postcondition_work_charge(sview_len(name), source_work)
                    return (true, true, index.counts[current], index.expected_indices[current]) if index.names[current] == name and index.function_offsets[current] == function_offset and index.contract_lines[current] == contract_line
                slot <- (slot + 1) % capacity
                probes <- probes + 1
            return (false, false, 0, 0)

        def proof_report_source_postcondition_keys_collect(declarations: darray[Ast::Decl]&, keys: mutable darray[ProofSourcePostconditionKey]&, source_work: mutable usize&, depth: usize) -> bool can[Memory.Allocate]:
            return false if depth >= PROOF_SOURCE_POSTCONDITION_AST_DEPTH_LIMIT
            for declaration in declarations |keys, source_work, depth|:
                return false if not proof_report_source_postcondition_work_charge(1, source_work)
                match declaration:
                    Ast::Decl.Func(name, _, _, body, _, _, position):
                        return false if not proof_report_source_postcondition_work_charge(body.count, source_work)
                        postcondition_count: usize = proof_report_body_postcondition_count(body)
                        for source_index in 0..<postcondition_count |source_index, name, position, keys, source_work|:
                            return false if:
                                keys.count >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 4
                                not proof_report_source_postcondition_work_charge(1, source_work)
                            keys.push(ProofSourcePostconditionKey{name: name, function_offset: position.offset, line: position.line, source_index: source_index})
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        return false if not proof_report_source_postcondition_keys_collect(nested, keys, source_work, depth + 1)
                    _:
                        pass
            return true

        # Signature ensures are parsed into Ast::File's parallel signature table rather than
        # retained as body statements. Their report events use the same owner-local ordinal as
        # function checking: body ensures first, then signature ensures in parser order.
        def proof_report_signature_postcondition_keys_collect(declarations: darray[Ast::Decl]&, report: ProofReport&, keys: mutable darray[ProofSourcePostconditionKey]&, source_work: mutable usize&, depth: usize) -> bool can[Memory.Allocate]:
            return false if depth >= PROOF_SOURCE_POSTCONDITION_AST_DEPTH_LIMIT
            rows: usize = report.source_contracts.source_signature_contract_lines.count
            return false if rows != report.source_contracts.source_signature_contract_kinds.count or rows != report.source_contracts.source_signature_contracts.count
            for declaration in declarations |report, keys, source_work, depth, rows|:
                return false if not proof_report_source_postcondition_work_charge(1, source_work)
                match declaration:
                    Ast::Decl.Func(name, _, _, body, _, _, position):
                        return false if not proof_report_source_postcondition_work_charge(body.count, source_work)
                        source_index: mutable usize = proof_report_body_postcondition_count(body)
                        contract_range: (complete: bool, start: usize, count: usize) = proof_structural_signature_contract_range_for_line(report.source_contracts.source_signature_contract_lines, report.source_contracts.source_signature_contract_kinds, report.source_contracts.source_signature_contracts, position.line, source_work)
                        return false if not contract_range.complete or contract_range.start > rows or contract_range.count > rows - contract_range.start
                        for offset in 0..<contract_range.count |offset, contract_range, report, name, position, source_index, keys, source_work|:
                            row: usize = contract_range.start + offset
                            kind: sview = report.source_contracts.source_signature_contract_kinds[row]
                            return false if not proof_report_source_postcondition_work_charge(1, source_work) or not proof_report_source_postcondition_work_charge(sview_len(kind), source_work) or not proof_report_source_postcondition_work_charge(sview_len(name), source_work)
                            return false if report.source_contracts.source_signature_contract_lines[row] != position.line
                            continue if kind != "ensure"
                            return false if keys.count >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 4
                            keys.push(ProofSourcePostconditionKey{name: name, function_offset: position.offset, line: position.line, source_index: source_index})
                            source_index <- source_index + 1
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        return false if not proof_report_signature_postcondition_keys_collect(nested, report, keys, source_work, depth + 1)
                    _:
                        pass
            return true

        def proof_report_source_postconditions_have_events_with_work(declarations: darray[Ast::Decl]&, report: ProofReport&, event_index: ProofSourcePostconditionCountIndex, source_work: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_SOURCE_POSTCONDITION_AST_DEPTH_LIMIT
            for declaration in declarations |report, event_index, source_work, depth|:
                return false if not proof_report_source_postcondition_work_charge(1, source_work)
                match declaration:
                    Ast::Decl.Func(name, _, _, body, _, _, position):
                        scheduled: mutable bool = report.context.focused_function == ""
                        if report.context.focused_function != "":
                            return false if:
                                not proof_report_source_postcondition_work_charge(sview_len(report.context.focused_function), source_work)
                                not proof_report_source_postcondition_work_charge(sview_len(name), source_work)
                            if report.context.focused_function_identity_valid:
                                scheduled <- position.offset == report.context.focused_function_offset
                            else:
                                return false
                        if scheduled:
                            return false if not proof_report_source_postcondition_work_charge(body.count, source_work)
                            expected: usize = proof_report_body_postcondition_count(body)
                            for source_index in 0..<expected |source_index, report, name, position, source_work|:
                                return false if not proof_report_source_postcondition_work_charge(1, source_work)
                                event_key: ProofSourcePostconditionKey = ProofSourcePostconditionKey{name: name, function_offset: position.offset, line: position.line, source_index: source_index}
                                event: (complete: bool, found: bool, count: usize) = proof_report_source_postcondition_index_find(event_index, event_key, source_work)
                                return false if not event.complete or not event.found or event.count == 0
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        return false if not proof_report_source_postconditions_have_events_with_work(nested, report, event_index, source_work, depth + 1)
                    _:
                        pass
            if depth == 0:
                signature_keys: mutable darray[ProofSourcePostconditionKey] = []
                return false if not proof_report_signature_postcondition_keys_collect(declarations, report, &signature_keys, source_work, depth)
                for key in signature_keys |event_index, source_work|:
                    event: (complete: bool, found: bool, count: usize) = proof_report_source_postcondition_index_find(event_index, key, source_work)
                    return false if not event.complete or not event.found or event.count == 0
            return true
