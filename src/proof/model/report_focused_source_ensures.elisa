extend ElisaProof:
    private:
        def proof_source_literal_ensure_collect(declarations: darray[Ast::Decl]&, scope_supported: bool, index: ProofSourceFunctionMultiplicityIndex, source_work: mutable usize&, inventory: mutable darray[(name: sview, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool)]&, depth: usize) -> bool:
            return false if depth >= PROOF_SOURCE_ASSERT_BY_AST_DEPTH_LIMIT or not index.valid
            for declaration in declarations |scope_supported, index, source_work, inventory, depth|:
                return false if not proof_report_source_work_charge(1, source_work)
                match declaration:
                    Ast::Decl.Func(_, _, _, _, _, _, _):
                        candidate_complete: mutable bool = true
                        candidate: (known: bool, name: sview, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool) = proof_source_literal_ensure_candidate_with_work(declaration, source_work, &candidate_complete)
                        return false if not candidate_complete
                        if candidate.known:
                            # Proof attempts use bare function names. The global multiplicity
                            # index proves whether that identity remains unique across scopes.
                            unique_name: bool = proof_source_function_name_is_unique(index, candidate.name, source_work)
                            return false if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                            if scope_supported and unique_name:
                                inventory.push((candidate.name, candidate.contract_line, candidate.contract_value, candidate.returned_value, candidate.returned_parameter, candidate.result_on_left, candidate.equality_postcondition))
                            else:
                                # Preserve the local owner for focused queries. Contract line
                                # zero is reserved for a known but unsupported inventory row.
                                inventory.push((candidate.name, 0, 0, 0, "", false, false))
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        return false if not proof_source_literal_ensure_collect(nested, true, index, source_work, inventory, depth + 1)
                    _:
                        pass
            return true

    public:

        def proof_source_literal_ensure_inventory_with_status(declarations: darray[Ast::Decl]&) -> (inventory: darray[(name: sview, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool)], complete: bool, work_limited: bool) can[Memory.Allocate]:
            inventory: mutable darray[(name: sview, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool)] = []
            source_work: mutable usize = 0
            index: ProofSourceFunctionMultiplicityIndex = proof_source_function_multiplicity_index(declarations, &source_work)
            complete: mutable bool = index.valid and source_work <= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            if complete:
                complete <- proof_source_literal_ensure_collect(declarations, true, index, &source_work, inventory, 0)
            complete <- false if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            work_limited: bool = source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            if not complete:
                inventory.clear()
                inventory.push(("", 0, 0, 0, "", false, false))
            (inventory, complete, work_limited)

        def proof_source_literal_ensure_inventory(declarations: darray[Ast::Decl]&) -> darray[(name: sview, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool)] can[Memory.Allocate]:
            inventory_status: (inventory: darray[(name: sview, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool)], complete: bool, work_limited: bool) = proof_source_literal_ensure_inventory_with_status(declarations)
            inventory_status.inventory

    private:
        # Replay-sensitive coverage primitives accept a mutable ProofReport. Keep them inside
        # ElisaProof so callers can only ask through a checked view or the pre-replay binding API.
        # Check the claim stored on either a goal attempt or its certificate against the
        # source-derived postcondition. Checking both matters: a mutable attempt display goal
        # must not relabel a certificate for a different proposition as the source proof.
        def proof_source_literal_ensure_goal_matches(goal: Ast::Expr, expected: (name: sview, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool), source_work: mutable usize&) -> bool:
            return false if not proof_report_source_work_charge(1, source_work)
            match goal:
                Ast::Expr.BoolLit(value, position):
                    return value and not expected.equality_postcondition and position.line == expected.contract_line
                Ast::Expr.Binary(Ast::Expr.IntLit(left, left_position), TokenKind.EqEq, Ast::Expr.IntLit(right, right_position), _):
                    expected_left: mutable i64 = expected.contract_value
                    expected_right: mutable i64 = expected.returned_value
                    if expected.result_on_left:
                        expected_left <- expected.returned_value
                        expected_right <- expected.contract_value
                    return expected.equality_postcondition and expected.returned_parameter == "" and left == expected_left and right == expected_right and (left_position.line == expected.contract_line or right_position.line == expected.contract_line)
                Ast::Expr.Binary(Ast::Expr.Ident(left, left_position), TokenKind.EqEq, Ast::Expr.IntLit(right, right_position), _):
                    return false if:
                        not proof_report_source_work_charge(sview_len(left), source_work)
                        not proof_report_source_work_charge(sview_len(expected.returned_parameter), source_work)
                    return expected.equality_postcondition and expected.returned_parameter != "" and expected.result_on_left and left == expected.returned_parameter and right == expected.contract_value and right_position.line == expected.contract_line
                Ast::Expr.Binary(Ast::Expr.IntLit(left, left_position), TokenKind.EqEq, Ast::Expr.Ident(right, right_position), _):
                    return false if:
                        not proof_report_source_work_charge(sview_len(right), source_work)
                        not proof_report_source_work_charge(sview_len(expected.returned_parameter), source_work)
                    return expected.equality_postcondition and expected.returned_parameter != "" and not expected.result_on_left and left == expected.contract_value and right == expected.returned_parameter and left_position.line == expected.contract_line
                _:
                    return false

        def proof_source_literal_ensure_expected_coverage_with_attempt_index(expected: (name: sview, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool), report: ProofReport&, attempt_index: ProofGoalAttemptNameIndex, require_replayed: bool, source_work: mutable usize&) -> bool:
            return false if expected.name == "" or expected.contract_line == 0 or not attempt_index.valid
            lookup: (complete: bool, found: bool, row: usize) = proof_goal_attempt_name_index_find(attempt_index, expected.name, source_work)
            return false if not lookup.complete or not lookup.found or lookup.row >= attempt_index.head_attempts.count
            matching: mutable usize = 0
            attempt_id: mutable usize = attempt_index.head_attempts[lookup.row]
            missing: usize = report.results.goal_attempts.count
            previous_attempt_id: mutable usize = missing
            while attempt_id != missing |attempt_id, expected, report, attempt_index, matching, missing, require_replayed, source_work, previous_attempt_id|:
                # The builder links older attempts behind newer IDs. Require strict descent so
                # a malformed forward link or cycle fails closed before consuming the work cap.
                return false if attempt_id >= report.results.goal_attempts.count or attempt_id >= attempt_index.next_attempts.count or attempt_id >= previous_attempt_id
                previous_attempt_id <- attempt_id
                return false if not proof_report_source_work_charge(1, source_work)
                attempt: ProofGoalAttempt = report.results.goal_attempts[attempt_id]
                return false if:
                    not proof_report_source_work_charge(sview_len(expected.name), source_work)
                    not proof_report_source_work_charge(sview_len(attempt.name), source_work)
                if attempt.name == expected.name and attempt.rule == "goal":
                    attempt_goal_matches: bool = proof_source_literal_ensure_goal_matches(attempt.goal, expected, source_work)
                    return false if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                    if attempt_goal_matches:
                        if attempt.proven and attempt.has_certificate and attempt.certificate_index < report.analysis_1.certificates.count:
                            certificate: ProofGoalCertificate = report.analysis_1.certificates[attempt.certificate_index]
                            if not require_replayed or certificate.replayed:
                                certificate_matches: bool = proof_source_literal_ensure_goal_matches(certificate.goal, expected, source_work)
                                return false if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                                matching <- matching + 1 if certificate_matches
                        else:
                            matching <- matching + 1 if not attempt.proven and not attempt.has_certificate
                        return false if matching > 1
                attempt_id <- attempt_index.next_attempts[attempt_id]
            matching == 1

        def proof_source_literal_ensure_expected_coverage_with_work(expected: (name: sview, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool), report: ProofReport&, require_replayed: bool, source_work: mutable usize&) -> bool can[Memory.Allocate]:
            attempt_index: ProofGoalAttemptNameIndex = proof_goal_attempt_name_index_create(report, source_work)
            return false if not attempt_index.valid
            proof_source_literal_ensure_expected_coverage_with_attempt_index(expected, report, attempt_index, require_replayed, source_work)

        def proof_source_literal_ensure_inventory_coverage_with_work(inventory: darray[(name: sview, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool)]&, report: ProofReport&, require_replayed: bool, source_work: mutable usize&) -> bool can[Memory.Allocate]:
            return true if inventory.count == 0
            # The parser inventory contains at most one supported candidate per unique
            # function name. Reject unsupported sentinels before constructing the attempt map.
            for expected in inventory |source_work|:
                return false if:
                    not proof_report_source_work_charge(1, source_work)
                    expected.name == "" or expected.contract_line == 0
            attempt_index: ProofGoalAttemptNameIndex = proof_goal_attempt_name_index_create(report, source_work)
            return false if not attempt_index.valid
            for expected in inventory |report, attempt_index, require_replayed, source_work|:
                return false if:
                    not proof_report_source_work_charge(1, source_work)
                    not proof_source_literal_ensure_expected_coverage_with_attempt_index(expected, report, attempt_index, require_replayed, source_work)
            true

        def proof_source_literal_ensure_expected_coverage(expected: (name: sview, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool), report: ProofReport&) -> bool:
            source_work: mutable usize = 0
            return proof_source_literal_ensure_expected_coverage_with_work(expected, report, true, &source_work)

    public:
        # Direct checking APIs bind the generated attempt and certificate before returning.
        # Replay remains a separate public operation, so this pre-return gate checks identity
        # without pretending that an unreplayed certificate is trusted.
        def proof_source_literal_ensure_expected_binding(expected: (name: sview, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool), report: ProofReport&) -> bool:
            source_work: mutable usize = 0
            return proof_source_literal_ensure_expected_coverage_with_work(expected, report, false, &source_work)

    public:
        def proof_source_literal_ensure_coverage(inventory: darray[(name: sview, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool)]&, report: ProofReport&) -> bool:
            source_work: mutable usize = 0
            proof_source_literal_ensure_inventory_coverage_with_work(inventory, report, true, &source_work)

    private:
        def proof_source_literal_ensure_binding_coverage(inventory: darray[(name: sview, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool)]&, report: ProofReport&) -> bool:
            source_work: mutable usize = 0
            proof_source_literal_ensure_inventory_coverage_with_work(inventory, report, false, &source_work)

    private:
        def proof_report_focused_source_literal_ensure_coverage_walk(declarations: darray[Ast::Decl]&, scope_supported: bool, report: ProofReport&, require_replayed: bool, index: ProofSourceFunctionMultiplicityIndex, source_work: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_SOURCE_ASSERT_BY_AST_DEPTH_LIMIT or not index.valid
            for declaration in declarations |scope_supported, report, index, source_work, depth|:
                return false if not proof_report_source_work_charge(1, source_work)
                match declaration:
                    Ast::Decl.Func(name, _, _, body, _, _, _):
                        return false if:
                            not proof_report_source_work_charge(sview_len(name), source_work)
                            not proof_report_source_work_charge(sview_len(report.context.focused_function), source_work)
                            not proof_report_source_work_charge(body.count, source_work)
                        if report.context.focused_function == name and proof_report_body_postcondition_count(body) > 0:
                            return false if not proof_source_function_name_is_unique(index, name, source_work)
                            candidate_complete: mutable bool = true
                            candidate: (known: bool, name: sview, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool) = proof_source_literal_ensure_candidate_with_work(declaration, source_work, &candidate_complete)
                            return false if:
                                not candidate_complete
                                not candidate.known or not scope_supported
                            expected: (name: sview, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool) = (candidate.name, candidate.contract_line, candidate.contract_value, candidate.returned_value, candidate.returned_parameter, candidate.result_on_left, candidate.equality_postcondition)
                            return false if not proof_source_literal_ensure_expected_coverage_with_work(expected, report, require_replayed, source_work)
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        return false if not proof_report_focused_source_literal_ensure_coverage_walk(nested, true, report, require_replayed, index, source_work, depth + 1)
                    _:
                        pass
            return true

    public:
        def proof_report_focused_source_literal_ensures_consistent(report: ProofReport&) -> bool:
            source_work: mutable usize = 0
            index: ProofSourceFunctionMultiplicityIndex = proof_source_function_multiplicity_index(report.source.source_declarations, &source_work)
            return false if not index.valid
            return proof_report_focused_source_literal_ensure_coverage_walk(report.source.source_declarations, true, report, true, index, &source_work, 0)

        def proof_report_focused_source_literal_ensures_bound(report: ProofReport&) -> bool:
            source_work: mutable usize = 0
            index: ProofSourceFunctionMultiplicityIndex = proof_source_function_multiplicity_index(report.source.source_declarations, &source_work)
            return false if not index.valid
            return proof_report_focused_source_literal_ensure_coverage_walk(report.source.source_declarations, true, report, false, index, &source_work, 0)

        def proof_report_focused_source_obligations_covered(report: ProofReport&) -> bool:
            return false if:
                report.context.focused_function == ""
                not proof_report_focused_source_literal_ensures_consistent(report)
            return proof_source_assert_by_focused_coverage(report)

        def proof_source_literal_ensure_inventory_has_unsupported(inventory: darray[(name: sview, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool)]&) -> bool:
            for expected in inventory:
                return true if expected.name == "" or expected.contract_line == 0
            return false

    public:
