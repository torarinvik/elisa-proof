# Source indices owned by ProofFunctionTable.
extend ElisaProof:
    public:
        # A per-import index over alias and struct declarations for type auditing.
        struct ProofTypeAuditDeclaration:
            declaration: Ast::Decl
            name_hash: u32
            root_level: bool

        struct ProofTypeAuditIndex:
            entries: mutable darray[ProofTypeAuditDeclaration]
            bucket_heads: mutable darray[usize]
            next_indices: mutable darray[usize]
            complete: mutable bool

    private:
        # Report-local collision-safe lookup for source enum member spellings. This is built
        # lazily by operator witness production and discarded at the next report reset.
        struct ProofConstEnumMemberIndex:
            names: mutable darray[sview] = []
            owners: mutable darray[sview] = []
            name_hashes: mutable darray[u32] = []
            const_members: mutable darray[bool] = []
            fieldless_members: mutable darray[bool] = []
            bucket_heads: mutable darray[usize] = []
            next_indices: mutable darray[usize] = []
            built: mutable bool = false
            complete: mutable bool = false

        # Paired parser evidence for `using Module as Alias`.
        struct ProofModuleAliasIndex:
            names: mutable darray[sview]
            targets: mutable darray[sview]
            scopes: mutable darray[sview]
            lines: mutable darray[u32]
            offsets: mutable darray[u32]
            alias_lookup_hashes: mutable darray[u32]
            alias_lookup_values: mutable darray[usize]
            alias_lookup_ambiguous: mutable darray[bool]
            # Code generation has a separate first-match table keyed only by alias spelling.
            # Replay compares that effective mapping with lexical source lookup before admitting
            # a qualified call through an alias.
            global_alias_lookup_hashes: mutable darray[u32]
            global_alias_lookup_values: mutable darray[usize]
            function_lookup_hashes: mutable darray[u32]
            function_lookup_values: mutable darray[usize]
            function_lookup_ambiguous: mutable darray[bool]
            function_lookup_complete: mutable bool
            complete: mutable bool
