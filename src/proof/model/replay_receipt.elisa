# Opaque replay-status snapshot for one replay batch. It keeps later edits to report counters
# from rewriting the recorded outcomes, but does not freeze or fingerprint the report payload.
# Consumers must not pair its positional statuses with a report whose proof payload was changed.
extend ElisaProof:
    public:
        struct ProofReplayReceipt:
            private:
                attempt_statuses: mutable darray[bool] = []
                attempt_proven_statuses: mutable darray[bool] = []
                certificate_statuses: mutable darray[bool] = []
                replay_gap_count: mutable u32 = 0
                complete: mutable bool = false
                source_validated: mutable bool = false
                issued: mutable bool = false
