# Opaque per-index replay snapshot for one replay batch. The standalone compatibility API does
# not freeze its caller's report; source-authorized decisions use ProofCheckedView, which owns the
# final report together with its receipt and parser-origin source analysis.
extend ElisaProof:
    public:
        struct ProofReplayReceipt[@r]:
            private:
                attempt_statuses: mutable darray[bool] = []
                attempt_proven_statuses: mutable darray[bool] = []
                certificate_statuses: mutable darray[bool] = []
                replay_gap_count: mutable u32 = 0
                complete: mutable bool = false
                source_validated: mutable bool = false
                issued: mutable bool = false
                source_identity: mutable uintptr = 0
                source_file_identity: mutable uintptr = 0
                source_bytes: mutable usize = 0
                source_fingerprint: mutable u32 = 0
                source_bound: mutable bool = false
                source_goal_statuses: mutable darray[bool] = []
                source_goal_statuses_complete: mutable bool = false
                # Source tactics consume the checker-produced hypotheses attached to an open
                # attempt. Keep their independent source-trace admission beside goal admission;
                # authenticating the goal alone does not authenticate every premise.
                source_attempt_fact_statuses: mutable darray[bool] = []
                source_attempt_fact_statuses_complete: mutable bool = false
                source_claims_admissible: mutable bool = false
                source_admission_snapshot_complete: mutable bool = false
                source_admission_failure: mutable sview = "source-validation-incomplete"
                source_checks_complete: mutable bool = false
                source_report_complete: mutable bool = false
                source_report_admissible: mutable bool = false
                theorem_source_admissions: mutable darray[(source_admissible: bool, declaration_identity_unambiguous: bool)] = []
                theorem_source_admissions_complete: mutable bool = false
                semantic_errors: mutable u32 = 0
                semantic_visible: mutable u32 = 0

        # Frozen parser-origin inputs captured before typed-source augmentation or proof
        # scheduling can rewrite the AST. Inventories are owned by this opaque value, while
        # their source text remains borrowed from the exact imported byte buffer.
        struct ProofSourceAnalysis[@r]:
            private:
                source: darray[u8]
                tokens: darray[Lexer::Token]
                file: Ast::File
                source_bytes: usize
                source_fingerprint: u32
                source_identity: uintptr
                file_identity: uintptr
                import_failed: bool
                pass_statement_offsets: darray[u32] = []
                stray_nul_line: u32
                refinement_findings: darray[ProofFinding] = []
                refined_functions: darray[sview] = []
                source_struct_invariant_scan_complete: bool = false
                source_has_struct_invariants: bool = false
                literal_ensure_inventory: darray[(name: sview, function_offset: u32, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool)] = []
                literal_ensure_inventory_complete: bool = false
                literal_ensure_inventory_work_limited: bool = false
                postcondition_ast_inventory: darray[(name: sview, function_offset: u32, line: u32, source_index: usize, contract_line: u32, expression: Ast::Expr)] = []
                postcondition_ast_inventory_complete: bool = false
                postcondition_ast_inventory_work_limited: bool = false
                assert_by_inventory: darray[(name: sview, function_offset: u32, attempt_line: u32, goal_line: u32, goal_offset: u32, expected_value: bool, source_goal: Ast::Expr, supported: bool)] = []
                assert_by_inventory_complete: bool = false
                assert_by_inventory_work_limited: bool = false
                issued: bool = false

        # The presentation/admission capability owns the final report, replay snapshot, and
        # frozen source analysis from one atomic check/replay transaction.
        struct ProofCheckedView[@r]:
            private:
                report: ProofReport& @r
                receipt: ProofReplayReceipt[r]& @r
                source_analysis: ProofSourceAnalysis[r]
                issued: bool = false
