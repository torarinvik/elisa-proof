extend ElisaProof:
    public:
        struct ProofFrameProducerRow:
            kind: sview
            position: Ast::Pos
            source_index: usize
            root: usize
            proven: bool
        struct ProofFrameProducerWorkspace:
            names: mutable darray[sview] = []
            lines: mutable darray[u32] = []
            starts: mutable darray[usize] = []
            counts: mutable darray[usize] = []
            rows: mutable darray[ProofFrameProducerRow] = []
            active_name: mutable sview = ""
