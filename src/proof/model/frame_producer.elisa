extend ElisaProof:
    public:
        struct ProofFrameProducerRow:
            kind: sview
            position: Ast::Pos
            source_index: usize
            root: usize
            proven: bool
        struct ProofFrameProducerWorkspace:
            names: mutable darray[sview] = []
            lines: mutable darray[u32] = []
            offsets: mutable darray[u32] = []
            starts: mutable darray[usize] = []
            counts: mutable darray[usize] = []
            rows: mutable darray[ProofFrameProducerRow] = []
            owner_lookup_hashes: mutable darray[u32] = []
            owner_lookup_slots: mutable darray[usize] = []
            owner_lookup_valid: mutable bool = false
            owner_lookup_work_used: mutable usize = 0
            source_preparation_complete: mutable bool = false
            active_name: mutable sview = ""
