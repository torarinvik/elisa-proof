# Source-authenticated structural termination certificate index.
extend ElisaProof:
    private:
        # Rebuild this lookup from the report rows consumed by source admission. The
        # report's cached structural hash slots are producer data and are not replay
        # authority, even when replay has built a separate index in a scratch report.
        struct ProofSourceRecursiveCallStructuralOwnerIndex:
            valid: bool = false
            empty: mutable usize = 0
            entries: mutable usize = 0
            hashes: mutable darray[u32] = []
            slots: mutable darray[usize] = []
            names: mutable darray[sview] = []
            counts: mutable darray[usize] = []
            verified: mutable darray[bool] = []
            certificate_heads: mutable darray[usize] = []
            certificate_next: mutable darray[usize] = []
            certificate_owner_rows: mutable darray[usize] = []
            certificate_owner_lines: mutable darray[u32] = []
            certificate_owner_offsets: mutable darray[u32] = []
            certificate_lines: mutable darray[u32] = []
            certificate_call_offsets: mutable darray[usize] = []
            certificate_consumed: mutable darray[bool] = []
            empty_certificate: mutable usize = 0

        def proof_source_recursive_call_structural_owner_index_build(report: ProofReport&, source_certificates_checked: bool, source_work: mutable usize&) -> ProofSourceRecursiveCallStructuralOwnerIndex can[Memory.Allocate]:
            index: mutable ProofSourceRecursiveCallStructuralOwnerIndex = ProofSourceRecursiveCallStructuralOwnerIndex{valid: true, empty: 0}
            return index if not source_certificates_checked
            total: usize = report.analysis_1.structural.names.count
            return ProofSourceRecursiveCallStructuralOwnerIndex{} if total != report.analysis_1.structural.verified_members.count or total > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 2
            index.empty <- total
            if total > 0:
                capacity: usize = proof_name_index_capacity(total)
                return ProofSourceRecursiveCallStructuralOwnerIndex{} if capacity == 0 or capacity > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 3
                return ProofSourceRecursiveCallStructuralOwnerIndex{} if not proof_report_source_work_charge(capacity * 3, source_work)
                index.hashes.resize(capacity)
                index.slots.resize(capacity)
                for slot in 0..<capacity |slot, index, total, source_work|:
                    return ProofSourceRecursiveCallStructuralOwnerIndex{} if not proof_report_source_work_charge(1, source_work)
                    index.slots[slot] <- total
                for row in 0..<total |row, index, report, total, capacity, source_work|:
                    name: sview = report.analysis_1.structural.names[row]
                    return ProofSourceRecursiveCallStructuralOwnerIndex{} if not proof_report_source_work_charge(sview_len(name), source_work)
                    hash: u32 = proof_name_hash(name)
                    slot: mutable usize = (hash.i64() % capacity.i64()).usize()
                    probes: mutable usize = 0
                    placed: mutable bool = false
                    while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, hash, row, index, total, capacity, source_work, placed|:
                        return ProofSourceRecursiveCallStructuralOwnerIndex{} if not proof_report_source_work_charge(1, source_work)
                        current: usize = index.slots[slot]
                        if current == total:
                            unique_row: usize = index.names.count
                            index.hashes[slot] <- hash
                            index.slots[slot] <- unique_row
                            index.names.push(name)
                            index.counts.push(1)
                            index.verified.push(report.analysis_1.structural.verified_members[row])
                            index.entries <- index.entries + 1
                            placed <- true
                            break
                        return ProofSourceRecursiveCallStructuralOwnerIndex{} if current >= index.names.count or current >= index.counts.count or current >= index.verified.count
                        if index.hashes[slot] == hash:
                            return ProofSourceRecursiveCallStructuralOwnerIndex{} if not proof_report_source_work_charge(sview_len(index.names[current]), source_work) or not proof_report_source_work_charge(sview_len(name), source_work)
                            if index.names[current] == name:
                                index.counts[current] <- index.counts[current] + 1
                                index.entries <- index.entries + 1
                                placed <- true
                                break
                        slot <- (slot + 1) % capacity
                        probes <- probes + 1
                    return ProofSourceRecursiveCallStructuralOwnerIndex{} if not placed
            return ProofSourceRecursiveCallStructuralOwnerIndex{} if index.entries != total or index.names.count != index.counts.count or index.names.count != index.verified.count
            certificate_count: usize = report.analysis_1.certificates.count
            return ProofSourceRecursiveCallStructuralOwnerIndex{} if certificate_count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 2
            return ProofSourceRecursiveCallStructuralOwnerIndex{} if not proof_report_source_work_charge(index.names.count, source_work) or not proof_report_source_work_charge(certificate_count, source_work)
            index.empty_certificate <- certificate_count
            index.certificate_heads.resize(index.names.count)
            seen: mutable darray[bool] = []
            seen.resize(certificate_count)
            for owner_row in 0..<index.names.count |owner_row, index, certificate_count, source_work|:
                return ProofSourceRecursiveCallStructuralOwnerIndex{} if not proof_report_source_work_charge(1, source_work)
                index.certificate_heads[owner_row] <- certificate_count
            for attempt in report.results.goal_attempts |attempt, report, index, seen, source_work|:
                return ProofSourceRecursiveCallStructuralOwnerIndex{} if not proof_report_source_work_charge(1, source_work) or not proof_report_source_work_charge(sview_len(attempt.rule), source_work) or not proof_report_source_work_charge(sview_len(attempt.name), source_work)
                continue if attempt.rule != "structural-safety" or not attempt.producer_proven
                return ProofSourceRecursiveCallStructuralOwnerIndex{} if:
                    not attempt.has_certificate
                    attempt.certificate_index >= certificate_count
                certificate_index: usize = attempt.certificate_index
                return ProofSourceRecursiveCallStructuralOwnerIndex{} if seen[certificate_index]
                certificate: ProofGoalCertificate = report.analysis_1.certificates[certificate_index]
                return ProofSourceRecursiveCallStructuralOwnerIndex{} if:
                    not proof_report_source_work_charge(sview_len(certificate.rule), source_work)
                    not proof_report_source_work_charge(sview_len(certificate.name), source_work)
                    certificate.rule != "structural-safety" or certificate.name != attempt.name
                    certificate.kernel_goal != attempt.kernel_goal or not certificate.replayed
                    certificate.kernel_goal >= report.analysis_1.kernel.nodes.count
                root: ElisaProofKernelCore::ProofKernelNode = report.analysis_1.kernel.nodes[certificate.kernel_goal]
                return ProofSourceRecursiveCallStructuralOwnerIndex{} if:
                    not proof_report_source_work_charge(sview_len(root.kind), source_work)
                    not proof_report_source_work_charge(sview_len(root.name), source_work)
                    root.kind != "structural-safety" or root.name != attempt.name
                owner: (complete: bool, verified: bool, row: usize) = proof_source_recursive_call_structural_owner_row(index, attempt.name, source_work)
                return ProofSourceRecursiveCallStructuralOwnerIndex{} if not owner.complete or not owner.verified or owner.row >= index.certificate_heads.count
                record: usize = index.certificate_next.count
                return ProofSourceRecursiveCallStructuralOwnerIndex{} if not proof_report_source_work_charge(7, source_work)
                index.certificate_next.push(index.certificate_heads[owner.row])
                index.certificate_owner_rows.push(owner.row)
                index.certificate_owner_lines.push(attempt.owner_function_line)
                index.certificate_owner_offsets.push(attempt.owner_function_offset)
                index.certificate_lines.push(certificate.line)
                index.certificate_call_offsets.push(root.left)
                index.certificate_consumed.push(false)
                index.certificate_heads[owner.row] <- record
                seen[certificate_index] <- true
            for certificate_index in 0..<certificate_count |certificate_index, report, seen, source_work|:
                return ProofSourceRecursiveCallStructuralOwnerIndex{} if not proof_report_source_work_charge(1, source_work)
                certificate: ProofGoalCertificate = report.analysis_1.certificates[certificate_index]
                return ProofSourceRecursiveCallStructuralOwnerIndex{} if not proof_report_source_work_charge(sview_len(certificate.rule), source_work)
                if certificate.rule == "structural-safety":
                    return ProofSourceRecursiveCallStructuralOwnerIndex{} if not proof_report_source_work_charge(sview_len(certificate.name), source_work)
                    return ProofSourceRecursiveCallStructuralOwnerIndex{} if not seen[certificate_index]
            return ProofSourceRecursiveCallStructuralOwnerIndex{} if:
                index.certificate_next.count != index.certificate_owner_rows.count
                index.certificate_next.count != index.certificate_owner_lines.count
                index.certificate_next.count != index.certificate_owner_offsets.count
                index.certificate_next.count != index.certificate_lines.count
                index.certificate_next.count != index.certificate_call_offsets.count
                index.certificate_next.count != index.certificate_consumed.count
            index

        # Every globally admitted structural row must be consumed by the exact parser
        # owner/call census. This rejects certificates attached to owners that are not
        # eligible recursive source functions, including rows skipped by the collector.
        def proof_source_recursive_call_structural_rows_consumed(index: ProofSourceRecursiveCallStructuralOwnerIndex, source_work: mutable usize&) -> bool:
            count: usize = index.certificate_next.count
            return false if index.certificate_consumed.count != count
            for record in 0..<count |record, index, source_work|:
                return false if not proof_report_source_work_charge(1, source_work) or not index.certificate_consumed[record]
            true

        def proof_source_recursive_call_structural_owner_row(index: ProofSourceRecursiveCallStructuralOwnerIndex&, name: sview, source_work: mutable usize&) -> (complete: bool, verified: bool, row: usize):
            count: usize = index.names.count
            capacity: usize = index.slots.count
            return (false, false, index.empty) if not index.valid or index.entries != index.empty or count != index.counts.count or count != index.verified.count or capacity != index.hashes.count
            return (true, false, index.empty) if index.empty == 0 and capacity == 0
            return (false, false, index.empty) if capacity == 0 or not proof_report_source_work_charge(sview_len(name), source_work)
            wanted_hash: u32 = proof_name_hash(name)
            slot: mutable usize = (wanted_hash.i64() % capacity.i64()).usize()
            probes: mutable usize = 0
            while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, wanted_hash, name, index, count, capacity, source_work|:
                return (false, false, index.empty) if not proof_report_source_work_charge(1, source_work)
                row: usize = index.slots[slot]
                return (true, false, index.empty) if row == index.empty
                return (false, false, index.empty) if row >= count
                if index.hashes[slot] == wanted_hash:
                    return (false, false, index.empty) if not proof_report_source_work_charge(sview_len(index.names[row]), source_work)
                    if index.names[row] == name:
                        return (false, false, index.empty) if index.counts[row] != 1
                        return (true, index.verified[row], row)
                slot <- (slot + 1) % capacity
                probes <- probes + 1
            (false, false, index.empty)

        def proof_source_recursive_call_structural_owner_verified(index: ProofSourceRecursiveCallStructuralOwnerIndex&, name: sview, source_certificates_checked: bool, source_work: mutable usize&) -> (complete: bool, verified: bool):
            return (true, false) if not source_certificates_checked
            name_count: usize = index.names.count
            capacity: usize = index.slots.count
            return (false, false) if:
                not index.valid or index.entries != index.empty or name_count != index.counts.count or name_count != index.verified.count
                name_count > index.empty or capacity != index.hashes.count
            return (true, false) if index.empty == 0 and capacity == 0
            expected_capacity: usize = proof_name_index_capacity(index.empty)
            return (false, false) if expected_capacity == 0 or capacity != expected_capacity
            return (false, false) if not proof_report_source_work_charge(sview_len(name), source_work)
            wanted_hash: u32 = proof_name_hash(name)
            slot: mutable usize = (wanted_hash.i64() % capacity.i64()).usize()
            probes: mutable usize = 0
            while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, wanted_hash, name, index, name_count, capacity, source_work|:
                return (false, false) if not proof_report_source_work_charge(1, source_work)
                row: usize = index.slots[slot]
                return (true, false) if row == index.empty
                return (false, false) if row >= name_count
                if index.hashes[slot] == wanted_hash:
                    return (false, false) if not proof_report_source_work_charge(sview_len(index.names[row]), source_work)
                    if index.names[row] == name:
                        return (false, false) if index.counts[row] != 1
                        return (true, index.verified[row])
                slot <- (slot + 1) % capacity
                probes <- probes + 1
            return (false, false)

