extend ElisaProof:
    private:
        struct ProofDeclarationNameMultiplicityIndex:
            slot_values: mutable darray[usize] = []
            names: mutable darray[sview] = []
            hashes: mutable darray[u32] = []
            counts: mutable darray[usize] = []
            valid: bool = false

        def proof_report_source_work_charge(amount: usize, work: mutable usize&) -> bool:
            return false if work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            if amount > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - work:
                work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                return false
            work <- work + amount
            true

        def proof_report_declaration_name_hash(name: sview, work: mutable usize&) -> (complete: bool, hash: u32):
            return (false, 0) if not proof_report_source_work_charge(sview_len(name), work)
            hash: mutable i64 = ElisaProofKernelCore::PROOF_KERNEL_FNV1A_OFFSET_BASIS
            for offset in 0..<sview_len(name) |offset, name, hash|:
                hash <- ((hash ^ name[offset].i64()) * ElisaProofKernelCore::PROOF_KERNEL_FNV1A_PRIME) % ElisaProofKernelCore::PROOF_KERNEL_HASH_U32_MODULUS
            (true, hash.u32())

        def proof_report_declaration_name_multiplicity_index(report: ProofReport&, work: mutable usize&) -> ProofDeclarationNameMultiplicityIndex can[Memory.Allocate]:
            declarations: mutable usize = 0
            for declaration in report.analysis_1.declaration_details |declarations, work|:
                return ProofDeclarationNameMultiplicityIndex{} if not proof_report_source_work_charge(1, work)
                declarations <- declarations + 1 if declaration.kind == "lemma"
            empty_index: mutable ProofDeclarationNameMultiplicityIndex = ProofDeclarationNameMultiplicityIndex{valid: true}
            return empty_index if declarations == 0
            if declarations > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 4:
                work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                return ProofDeclarationNameMultiplicityIndex{}
            capacity: mutable usize = 1
            target_capacity: usize = declarations * 2
            while capacity < target_capacity |capacity, target_capacity, declarations, work|:
                return ProofDeclarationNameMultiplicityIndex{} if not proof_report_source_work_charge(1, work)
                if capacity > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 4:
                    work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                    return ProofDeclarationNameMultiplicityIndex{}
                capacity <- capacity * 2
            return ProofDeclarationNameMultiplicityIndex{} if not proof_report_source_work_charge(capacity, work)
            index: mutable ProofDeclarationNameMultiplicityIndex = ProofDeclarationNameMultiplicityIndex{valid: true}
            index.slot_values.resize(capacity)
            return ProofDeclarationNameMultiplicityIndex{} if not proof_report_source_work_charge(capacity, work)
            index.hashes.resize(capacity)
            for slot in 0..<capacity |slot, index, capacity, work|:
                return ProofDeclarationNameMultiplicityIndex{} if not proof_report_source_work_charge(1, work)
                index.slot_values[slot] <- capacity
            for declaration in report.analysis_1.declaration_details |declaration, index, capacity, work|:
                return ProofDeclarationNameMultiplicityIndex{} if not proof_report_source_work_charge(1, work)
                continue if declaration.kind != "lemma"
                name_hash: (complete: bool, hash: u32) = proof_report_declaration_name_hash(declaration.name, work)
                return ProofDeclarationNameMultiplicityIndex{} if not name_hash.complete
                hash: u32 = name_hash.hash
                slot: mutable usize = (hash.i64() % capacity.i64()).usize()
                probes: mutable usize = 0
                while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, hash, declaration, index, capacity, work|:
                    return ProofDeclarationNameMultiplicityIndex{} if not proof_report_source_work_charge(1, work)
                    current: usize = index.slot_values[slot]
                    if current == capacity:
                        name_index: usize = index.names.count
                        index.names.push(declaration.name)
                        index.hashes[slot] <- hash
                        index.counts.push(1)
                        index.slot_values[slot] <- name_index
                        break
                    if index.hashes[slot] == hash:
                        return ProofDeclarationNameMultiplicityIndex{} if not proof_report_source_work_charge(sview_len(declaration.name), work)
                        if index.names[current] == declaration.name:
                            index.counts[current] <- index.counts[current] + 1
                            break
                    slot <- (slot + 1) % capacity
                    probes <- probes + 1
                return ProofDeclarationNameMultiplicityIndex{} if probes >= capacity or probes > PROOF_NAME_INDEX_MAX_CLUSTER
            return index

        # Duplicate parser lemma markers intentionally produce no theorem summaries. Build
        # the multiplicity table from parser-owned annotations so the inventory can skip
        # ambiguous names without trusting the producer's declaration inventory for that
        # exclusion.
        def proof_report_source_lemma_name_multiplicity_index[@r](source: ProofSourceAnalysis[r]& @r, work: mutable usize&) -> ProofDeclarationNameMultiplicityIndex can[Memory.Allocate]:
            declarations: mutable usize = 0
            for annotation in source.file.enum_annotations |declarations, work|:
                return ProofDeclarationNameMultiplicityIndex{} if not proof_report_source_work_charge(1, work) or not proof_report_source_work_charge(sview_len(annotation.owner), work)
                declarations <- declarations + 1 if annotation.owner == "__lemma"
            empty_index: mutable ProofDeclarationNameMultiplicityIndex = ProofDeclarationNameMultiplicityIndex{valid: true}
            return empty_index if declarations == 0
            if declarations > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 4:
                work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                return ProofDeclarationNameMultiplicityIndex{}
            capacity: mutable usize = 1
            target_capacity: usize = declarations * 2
            while capacity < target_capacity |capacity, target_capacity, declarations, work|:
                return ProofDeclarationNameMultiplicityIndex{} if not proof_report_source_work_charge(1, work)
                if capacity > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 4:
                    work <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1
                    return ProofDeclarationNameMultiplicityIndex{}
                capacity <- capacity * 2
            return ProofDeclarationNameMultiplicityIndex{} if not proof_report_source_work_charge(capacity, work)
            index: mutable ProofDeclarationNameMultiplicityIndex = ProofDeclarationNameMultiplicityIndex{valid: true}
            index.slot_values.resize(capacity)
            return ProofDeclarationNameMultiplicityIndex{} if not proof_report_source_work_charge(capacity, work)
            index.hashes.resize(capacity)
            for slot in 0..<capacity |slot, index, capacity, work|:
                return ProofDeclarationNameMultiplicityIndex{} if not proof_report_source_work_charge(1, work)
                index.slot_values[slot] <- capacity
            for annotation in source.file.enum_annotations |annotation, index, capacity, work|:
                return ProofDeclarationNameMultiplicityIndex{} if not proof_report_source_work_charge(1, work) or not proof_report_source_work_charge(sview_len(annotation.owner), work)
                continue if annotation.owner != "__lemma"
                name_hash: (complete: bool, hash: u32) = proof_report_declaration_name_hash(annotation.name, work)
                return ProofDeclarationNameMultiplicityIndex{} if not name_hash.complete
                hash: u32 = name_hash.hash
                slot: mutable usize = (hash.i64() % capacity.i64()).usize()
                probes: mutable usize = 0
                while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, hash, annotation, index, capacity, work|:
                    return ProofDeclarationNameMultiplicityIndex{} if not proof_report_source_work_charge(1, work)
                    current: usize = index.slot_values[slot]
                    if current == capacity:
                        name_index: usize = index.names.count
                        index.names.push(annotation.name)
                        index.hashes[slot] <- hash
                        index.counts.push(1)
                        index.slot_values[slot] <- name_index
                        break
                    if index.hashes[slot] == hash:
                        return ProofDeclarationNameMultiplicityIndex{} if not proof_report_source_work_charge(sview_len(annotation.name), work)
                        if index.names[current] == annotation.name:
                            index.counts[current] <- index.counts[current] + 1
                            break
                    slot <- (slot + 1) % capacity
                    probes <- probes + 1
                return ProofDeclarationNameMultiplicityIndex{} if probes >= capacity or probes > PROOF_NAME_INDEX_MAX_CLUSTER
            return index

        def proof_report_declaration_name_is_unique(index: ProofDeclarationNameMultiplicityIndex, name: sview, work: mutable usize&) -> bool:
            capacity: usize = index.slot_values.count
            return false if:
                not index.valid or capacity == 0
                index.hashes.count != capacity or index.names.count != index.counts.count
            name_hash: (complete: bool, hash: u32) = proof_report_declaration_name_hash(name, work)
            return false if not name_hash.complete
            hash: u32 = name_hash.hash
            slot: mutable usize = (hash.i64() % capacity.i64()).usize()
            probes: mutable usize = 0
            while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, hash, name, index, capacity, work|:
                return false if not proof_report_source_work_charge(1, work)
                current: usize = index.slot_values[slot]
                return false if current == capacity or current >= index.names.count or current >= index.counts.count
                if index.hashes[slot] == hash:
                    return false if not proof_report_source_work_charge(sview_len(name), work)
                    return index.counts[current] == 1 if index.names[current] == name
                slot <- (slot + 1) % capacity
                probes <- probes + 1
            return false

        # Re-enumerate unique parser-origin lemma markers before trusting the producer's theorem
        # table. Ambiguous names are deliberately omitted by declaration recording; the unique
        # markers and summaries retain source order, so their sequence gives a bounded bijection.
        def proof_report_source_lemma_inventory_matches_with_work[@r](source: ProofSourceAnalysis[r]& @r, report: ProofReport&, lemma_names: ProofDeclarationNameMultiplicityIndex, source_work: mutable usize&) -> bool:
            return false if not source.issued
            return false if not lemma_names.valid or (lemma_names.names.count > 0 and lemma_names.slot_values.count == 0)
            summary_index: mutable usize = 0
            for annotation in source.file.enum_annotations |source, report, source_work, summary_index|:
                return false if not proof_report_source_work_charge(1, source_work) or not proof_report_source_work_charge(sview_len(annotation.owner), source_work)
                continue if annotation.owner != "__lemma"
                unique_name: bool = proof_report_declaration_name_is_unique(lemma_names, annotation.name, source_work)
                return false if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                continue if not unique_name
                return false if summary_index >= report.analysis_1.theorems.summaries.count
                theorem: ProofTheoremSummary = report.analysis_1.theorems.summaries[summary_index]
                return false if not proof_report_source_work_charge(sview_len(annotation.name), source_work) or not proof_report_source_work_charge(sview_len(theorem.name), source_work)
                return false if annotation.name != theorem.name or annotation.line != theorem.line or annotation.offset != theorem.source_offset
                summary_index <- summary_index + 1
            summary_index == report.analysis_1.theorems.summaries.count

        # This core runs only after report-wide source structure has been checked. It shares
        # the caller's source-work budget across every selected goal and finding scan.
        def proof_report_theorem_source_admissible_after_structure(report: ProofReport&, source_operator_mask: usize, theorem: ProofTheoremSummary, literal_ensure_inventory: darray[(name: sview, function_offset: u32, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool)]&, assert_by_inventory: darray[(name: sview, function_offset: u32, attempt_line: u32, goal_line: u32, goal_offset: u32, expected_value: bool, source_goal: Ast::Expr, supported: bool)]&, goal_finding_clear: darray[bool]&, source_work: mutable usize&) -> bool:
            return false if:
                theorem.proof_goals_count == 0
                theorem.proof_goals_start > report.analysis_1.theorems.proof_goal_ids.count or theorem.proof_goals_count > report.analysis_1.theorems.proof_goal_ids.count - theorem.proof_goals_start
            previous_goal_id: mutable usize = 0
            has_previous_goal: mutable bool = false
            for offset in 0..<theorem.proof_goals_count |offset, report, theorem, literal_ensure_inventory, assert_by_inventory, previous_goal_id, has_previous_goal, goal_finding_clear, source_work|:
                return false if not proof_report_source_work_charge(1, source_work)
                goal_id: usize = report.analysis_1.theorems.proof_goal_ids[theorem.proof_goals_start + offset]
                return false if:
                    goal_id >= report.results.goal_attempts.count
                    not proof_report_source_work_charge(sview_len(report.results.goal_attempts[goal_id].name), source_work)
                    not proof_report_source_work_charge(sview_len(theorem.name), source_work)
                    report.results.goal_attempts[goal_id].name != theorem.name
                    report.results.goal_attempts[goal_id].owner_function_line != theorem.line
                    report.results.goal_attempts[goal_id].owner_function_offset != theorem.source_offset
                # The recorder appends IDs in increasing attempt order. Requiring that order
                # makes the theorem-to-source mapping one-to-one and rejects duplicate IDs.
                return false if has_previous_goal and goal_id <= previous_goal_id
                previous_goal_id <- goal_id
                has_previous_goal <- true
                no_return_inventory: darray[(name: sview, line: u32, offset: u32, supported: bool, expression: Ast::Expr)] = []
                admitted: bool = proof_report_goal_source_admissible_after_structure_internal(report, source_operator_mask, no_return_inventory, false, goal_id, literal_ensure_inventory, ProofSourceLiteralEnsureAdmissionIndex{}, false, ProofSourcePostconditionAstIndex{}, false, assert_by_inventory, goal_finding_clear, true, true, source_work)
                return false if not admitted
            return true

    private:
        # The catalog's source claims are computed once from the checked view's already
        # admitted goal and attempt-fact snapshots. This helper is private so callers cannot supply their own
        # report booleans or source inventories and manufacture a positive theorem status.
        def proof_report_theorem_source_status_snapshot[@r](source: ProofSourceAnalysis[r]& @r, report: ProofReport&, goal_source_statuses: darray[bool]&, goal_statuses_complete: bool, fact_source_statuses: darray[bool]&, fact_statuses_complete: bool, import_failed: bool, semantic_errors: u32, source_work: mutable usize&) -> (statuses: darray[(source_admissible: bool, declaration_identity_unambiguous: bool)], complete: bool, claims_admissible: bool) can[Memory.Allocate]:
            statuses: mutable darray[(source_admissible: bool, declaration_identity_unambiguous: bool)] = []
            return (statuses, false, false) if not goal_statuses_complete or goal_source_statuses.count != report.results.goal_attempts.count or not fact_statuses_complete or fact_source_statuses.count != report.results.goal_attempts.count
            lemma_names: ProofDeclarationNameMultiplicityIndex = proof_report_source_lemma_name_multiplicity_index(source, source_work)
            return (statuses, false, false) if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or not lemma_names.valid
            return (statuses, false, false) if not proof_report_source_lemma_inventory_matches_with_work(source, report, lemma_names, source_work)
            return (statuses, true, true) if report.analysis_1.theorems.summaries.count == 0
            index: ProofDeclarationNameMultiplicityIndex = proof_report_declaration_name_multiplicity_index(report, source_work)
            return (statuses, false, false) if:
                source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                report.analysis_1.theorems.summaries.count > 0 and (not index.valid or index.slot_values.count == 0)
            source_input_clean: bool = not import_failed and semantic_errors == 0
            claims_admissible: mutable bool = true
            for theorem in report.analysis_1.theorems.summaries |report, statuses, index, source_work, goal_source_statuses, fact_source_statuses, source_input_clean|:
                return (statuses, false, false) if not proof_report_source_work_charge(1, source_work)
                declaration_identity_unambiguous: bool = proof_report_declaration_name_is_unique(index, theorem.name, source_work)
                return (statuses, false, false) if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                valid_goal_range: bool = theorem.proof_goals_start <= report.analysis_1.theorems.proof_goal_ids.count and theorem.proof_goals_count <= report.analysis_1.theorems.proof_goal_ids.count - theorem.proof_goals_start
                return (statuses, false, false) if not valid_goal_range
                source_admissible: mutable bool = source_input_clean and declaration_identity_unambiguous and theorem.proof_goals_count > 0 and valid_goal_range
                previous_goal_id: mutable usize = 0
                has_previous_goal: mutable bool = false
                if valid_goal_range:
                    for offset in 0..<theorem.proof_goals_count |offset, theorem, report, statuses, source_work, goal_source_statuses, fact_source_statuses, source_admissible, previous_goal_id, has_previous_goal|:
                        return (statuses, false, false) if not proof_report_source_work_charge(1, source_work)
                        goal_id: usize = report.analysis_1.theorems.proof_goal_ids[theorem.proof_goals_start + offset]
                        return (statuses, false, false) if goal_id >= report.results.goal_attempts.count
                        attempt: ProofGoalAttempt = report.results.goal_attempts[goal_id]
                        return (statuses, false, false) if:
                            not proof_report_source_work_charge(sview_len(theorem.name), source_work)
                            not proof_report_source_work_charge(sview_len(attempt.name), source_work)
                        source_admissible <- false if attempt.name != theorem.name or attempt.owner_function_line != theorem.line or attempt.owner_function_offset != theorem.source_offset or goal_id >= goal_source_statuses.count or not goal_source_statuses[goal_id] or goal_id >= fact_source_statuses.count or not fact_source_statuses[goal_id]
                        source_admissible <- false if has_previous_goal and goal_id <= previous_goal_id
                        previous_goal_id <- goal_id
                        has_previous_goal <- true
                statuses.push((source_admissible, declaration_identity_unambiguous))
                claims_admissible <- false if theorem.verified and (not source_admissible or not declaration_identity_unambiguous)
            (statuses, source_work <= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT, claims_admissible)

    private:
        # Raw source-admission entrypoints remain internal. Positive public decisions are issued
        # only by ProofCheckedView, whose inventories and per-goal statuses are parser-bound.
        def proof_report_theorem_source_admissible(report: ProofReport&, theorem: ProofTheoremSummary, import_failed: bool, semantic_errors: u32, literal_ensure_inventory: darray[(name: sview, function_offset: u32, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool)]&, assert_by_inventory: darray[(name: sview, function_offset: u32, attempt_line: u32, goal_line: u32, goal_offset: u32, expected_value: bool, source_goal: Ast::Expr, supported: bool)]&) -> bool:
            return false if import_failed or semantic_errors != 0
            source_work: mutable usize = 0
            return false if not proof_report_source_structure_consistent(report, &source_work)
            index: ProofDeclarationNameMultiplicityIndex = proof_report_declaration_name_multiplicity_index(report, &source_work)
            return false if not proof_report_declaration_name_is_unique(index, theorem.name, &source_work)
            finding_snapshot: (goal_finding_clear: darray[bool], complete: bool) = proof_report_source_goal_finding_snapshot(report, &source_work)
            return false if not finding_snapshot.complete
            proof_report_theorem_source_admissible_after_structure(report, PROOF_SOURCE_OPERATOR_ALL_FLAGS, theorem, literal_ensure_inventory, assert_by_inventory, finding_snapshot.goal_finding_clear, &source_work)

    public:
        # Precompute declaration attribution once for full report rendering. Per-row scans
        # would turn duplicate-name checks into O(declarations^2) work. This is structural
        # attribution only; source-admission decisions remain behind ProofCheckedView.
        def proof_report_declaration_identity_statuses(report: ProofReport&, work_used: mutable usize&) -> (complete: bool, statuses: darray[bool]) can[Memory.Allocate]:
            return (false, []) if work_used > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            statuses: mutable darray[bool] = []
            index: ProofDeclarationNameMultiplicityIndex = proof_report_declaration_name_multiplicity_index(report, work_used)
            return (false, []) if work_used > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            for declaration in report.analysis_1.declaration_details |report, statuses, index, work_used|:
                return (false, statuses) if not proof_report_source_work_charge(1, work_used)
                identity_unambiguous: mutable bool = true
                # The theorem/source-summary protocol attributes attempts by simple name and
                # therefore requires unique lemma identity. Ordinary function declaration rows
                # are independently checked and may legally share names across modules.
                if declaration.kind == "lemma":
                    return (false, statuses) if not index.valid
                    identity_unambiguous <- proof_report_declaration_name_is_unique(index, declaration.name, work_used)
                    return (false, statuses) if work_used > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                statuses.push(identity_unambiguous)
            return (true, statuses)

    private:

