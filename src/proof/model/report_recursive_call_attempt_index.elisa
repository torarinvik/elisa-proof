# Bounded call-span index for recursive source-obligation reconciliation.
extend ElisaProof:
    private:
        struct ProofSourceRecursiveCallAttemptIndex:
            slot_hashes: mutable darray[u32] = []
            slot_call_indices: mutable darray[usize] = []
            offset_slot_hashes: mutable darray[u32] = []
            offset_slot_call_indices: mutable darray[usize] = []
            call_positions: mutable darray[Ast::Pos] = []
            attempt_heads: mutable darray[usize] = []
            attempt_tails: mutable darray[usize] = []
            attempt_counts: mutable darray[usize] = []
            structural_certificate_counts: mutable darray[usize] = []
            attempt_goals: mutable darray[Ast::Expr] = []
            attempt_next: mutable darray[usize] = []
            empty_call: usize = 0
            empty_attempt: usize = 0
            valid: bool = false

        def proof_source_recursive_call_position_equal(left: Ast::Pos, right: Ast::Pos) -> bool:
            left.line == right.line and left.column == right.column and left.offset == right.offset and left.end_line == right.end_line and left.end_column == right.end_column and left.end_offset == right.end_offset

        # Keep the decreases inventory on source forms whose call-site substitution
        # cannot hide control flow or depend on a preceding local assignment.
        def proof_source_recursive_call_measure_atom(expression: Ast::Expr) -> bool:
            match expression:
                Ast::Expr.Ident(_, _) | Ast::Expr.IntLit(_, _):
                    true
                _:
                    false

        def proof_source_recursive_call_position_hash(position: Ast::Pos, source_work: mutable usize&) -> (complete: bool, hash: u32):
            return (false, 0) if not proof_report_source_work_charge(6, source_work)
            hash: mutable u32 = ElisaProofKernelCore::PROOF_KERNEL_FNV1A_OFFSET_BASIS.u32()
            hash <- proof_expr_shape_mix(hash, position.line.i64())
            hash <- proof_expr_shape_mix(hash, position.column.i64())
            hash <- proof_expr_shape_mix(hash, position.offset.i64())
            hash <- proof_expr_shape_mix(hash, position.end_line.i64())
            hash <- proof_expr_shape_mix(hash, position.end_column.i64())
            hash <- proof_expr_shape_mix(hash, position.end_offset.i64())
            (true, hash)

        def proof_source_recursive_call_offset_hash(offset: usize, source_work: mutable usize&) -> (complete: bool, hash: u32):
            return (false, 0) if not proof_report_source_work_charge(1, source_work)
            hash: u32 = ElisaProofKernelCore::PROOF_KERNEL_FNV1A_OFFSET_BASIS.u32()
            (true, proof_expr_shape_mix(hash, offset.i64()))

        def proof_source_recursive_call_position_hash_index(index: ProofSourceRecursiveCallAttemptIndex&, position: Ast::Pos, source_work: mutable usize&) -> (complete: bool, found: bool, call_index: usize):
            capacity: usize = index.slot_call_indices.count
            return (false, false, index.empty_call) if:
                not index.valid or index.slot_hashes.count != capacity or capacity == 0
                index.call_positions.count != index.attempt_heads.count or index.attempt_heads.count != index.attempt_tails.count or index.attempt_heads.count != index.attempt_counts.count or index.attempt_heads.count != index.structural_certificate_counts.count
            hashed: (complete: bool, hash: u32) = proof_source_recursive_call_position_hash(position, source_work)
            return (false, false, index.empty_call) if not hashed.complete
            slot: mutable usize = (hashed.hash.i64() % capacity.i64()).usize()
            probes: mutable usize = 0
            while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, hashed, index, position, capacity, source_work|:
                return (false, false, index.empty_call) if not proof_report_source_work_charge(1, source_work)
                current: usize = index.slot_call_indices[slot]
                return (true, false, index.empty_call) if current == index.empty_call
                return (false, false, index.empty_call) if current >= index.attempt_heads.count
                if index.slot_hashes[slot] == hashed.hash and proof_source_recursive_call_position_equal(index.call_positions[current], position):
                    return (true, true, current)
                slot <- (slot + 1) % capacity
                probes <- probes + 1
            (false, false, index.empty_call)

        def proof_source_recursive_call_attempt_index_create(calls: darray[(position: Ast::Pos, arguments: darray[Ast::Expr])]&, source_work: mutable usize&) -> ProofSourceRecursiveCallAttemptIndex can[Memory.Allocate]:
            return ProofSourceRecursiveCallAttemptIndex{} if calls.count == 0
            capacity: usize = proof_name_index_capacity(calls.count)
            return ProofSourceRecursiveCallAttemptIndex{} if capacity == 0
            return ProofSourceRecursiveCallAttemptIndex{} if:
                not proof_report_source_work_charge(capacity, source_work)
                not proof_report_source_work_charge(capacity, source_work)
                not proof_report_source_work_charge(capacity, source_work)
                not proof_report_source_work_charge(capacity, source_work)
                not proof_report_source_work_charge(calls.count, source_work)
                not proof_report_source_work_charge(calls.count, source_work)
                not proof_report_source_work_charge(calls.count, source_work)
                not proof_report_source_work_charge(calls.count, source_work)
                not proof_report_source_work_charge(calls.count, source_work)
            index: mutable ProofSourceRecursiveCallAttemptIndex = ProofSourceRecursiveCallAttemptIndex{empty_call: calls.count, empty_attempt: PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT + 1, valid: true}
            index.slot_hashes.resize(capacity)
            index.slot_call_indices.resize(capacity)
            index.offset_slot_hashes.resize(capacity)
            index.offset_slot_call_indices.resize(capacity)
            index.call_positions.reserve(calls.count)
            index.attempt_heads.reserve(calls.count)
            index.attempt_tails.reserve(calls.count)
            index.attempt_counts.reserve(calls.count)
            index.structural_certificate_counts.reserve(calls.count)
            for slot in 0..<capacity |slot, index, calls, capacity, source_work|:
                return ProofSourceRecursiveCallAttemptIndex{} if not proof_report_source_work_charge(1, source_work)
                index.slot_call_indices[slot] <- calls.count
                index.offset_slot_call_indices[slot] <- calls.count
            for call_index in 0..<calls.count |call_index, index, calls, source_work|:
                return ProofSourceRecursiveCallAttemptIndex{} if not proof_report_source_work_charge(1, source_work)
                call: (position: Ast::Pos, arguments: darray[Ast::Expr]) = calls[call_index]
                hashed: (complete: bool, hash: u32) = proof_source_recursive_call_position_hash(call.position, source_work)
                return ProofSourceRecursiveCallAttemptIndex{} if not hashed.complete
                capacity: usize = index.slot_call_indices.count
                slot: mutable usize = (hashed.hash.i64() % capacity.i64()).usize()
                probes: mutable usize = 0
                inserted: mutable bool = false
                while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, hashed, index, calls, call_index, capacity, source_work, inserted|:
                    return ProofSourceRecursiveCallAttemptIndex{} if not proof_report_source_work_charge(1, source_work)
                    current: usize = index.slot_call_indices[slot]
                    if current == calls.count:
                        index.slot_hashes[slot] <- hashed.hash
                        index.slot_call_indices[slot] <- call_index
                        inserted <- true
                        break
                    return ProofSourceRecursiveCallAttemptIndex{} if current >= calls.count
                    if index.slot_hashes[slot] == hashed.hash:
                        existing_call: (position: Ast::Pos, arguments: darray[Ast::Expr]) = calls[current]
                        return ProofSourceRecursiveCallAttemptIndex{} if proof_source_recursive_call_position_equal(existing_call.position, call.position)
                    slot <- (slot + 1) % capacity
                    probes <- probes + 1
                return ProofSourceRecursiveCallAttemptIndex{} if not inserted
                offset_hashed: (complete: bool, hash: u32) = proof_source_recursive_call_offset_hash(call.position.offset, source_work)
                return ProofSourceRecursiveCallAttemptIndex{} if not offset_hashed.complete
                offset_slot: mutable usize = (offset_hashed.hash.i64() % capacity.i64()).usize()
                offset_probes: mutable usize = 0
                offset_inserted: mutable bool = false
                while offset_probes < capacity and offset_probes <= PROOF_NAME_INDEX_MAX_CLUSTER |offset_probes, offset_slot, offset_hashed, index, calls, call_index, capacity, source_work, offset_inserted|:
                    return ProofSourceRecursiveCallAttemptIndex{} if not proof_report_source_work_charge(1, source_work)
                    offset_current: usize = index.offset_slot_call_indices[offset_slot]
                    if offset_current == calls.count:
                        index.offset_slot_hashes[offset_slot] <- offset_hashed.hash
                        index.offset_slot_call_indices[offset_slot] <- call_index
                        offset_inserted <- true
                        break
                    return ProofSourceRecursiveCallAttemptIndex{} if offset_current >= calls.count
                    if index.offset_slot_hashes[offset_slot] == offset_hashed.hash:
                        existing_call: (position: Ast::Pos, arguments: darray[Ast::Expr]) = calls[offset_current]
                        return ProofSourceRecursiveCallAttemptIndex{} if existing_call.position.offset == call.position.offset
                    offset_slot <- (offset_slot + 1) % capacity
                    offset_probes <- offset_probes + 1
                return ProofSourceRecursiveCallAttemptIndex{} if not offset_inserted
                index.call_positions.push(call.position)
                index.attempt_heads.push(index.empty_attempt)
                index.attempt_tails.push(index.empty_attempt)
                index.attempt_counts.push(0)
                index.structural_certificate_counts.push(0)
            index

        def proof_source_recursive_call_offset_hash_index(index: ProofSourceRecursiveCallAttemptIndex&, offset: usize, source_work: mutable usize&) -> (complete: bool, found: bool, call_index: usize):
            capacity: usize = index.offset_slot_call_indices.count
            return (false, false, index.empty_call) if not index.valid or capacity == 0 or index.offset_slot_hashes.count != capacity
            hashed: (complete: bool, hash: u32) = proof_source_recursive_call_offset_hash(offset, source_work)
            return (false, false, index.empty_call) if not hashed.complete
            slot: mutable usize = (hashed.hash.i64() % capacity.i64()).usize()
            probes: mutable usize = 0
            while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, hashed, index, offset, capacity, source_work|:
                return (false, false, index.empty_call) if not proof_report_source_work_charge(1, source_work)
                current: usize = index.offset_slot_call_indices[slot]
                return (true, false, index.empty_call) if current == index.empty_call
                return (false, false, index.empty_call) if current >= index.call_positions.count
                if index.offset_slot_hashes[slot] == hashed.hash and index.call_positions[current].offset == offset:
                    return (true, true, current)
                slot <- (slot + 1) % capacity
                probes <- probes + 1
            (false, false, index.empty_call)

        def proof_source_recursive_call_attempt_index_fill(index: mutable ProofSourceRecursiveCallAttemptIndex&, report: ProofReport&, calls: darray[(position: Ast::Pos, arguments: darray[Ast::Expr])]&, owner_position: Ast::Pos, name: sview, source_work: mutable usize&) -> bool:
            return false if not index.valid or index.call_positions.count != calls.count or index.attempt_heads.count != calls.count or index.attempt_tails.count != calls.count or index.attempt_counts.count != calls.count or index.attempt_goals.count != index.attempt_next.count
            for attempt in report.results.goal_attempts |attempt, index, report, calls, owner_position, name, source_work|:
                return false if not proof_report_source_work_charge(1, source_work) or not proof_report_source_work_charge(sview_len(attempt.name), source_work) or not proof_report_source_work_charge(sview_len(name), source_work)
                continue if attempt.owner_function_line != owner_position.line or attempt.owner_function_offset != owner_position.offset or attempt.name != name
                # The call attribution span is copied onto speculative solver probes
                # as well as the requested obligation. Reconcile only the selected
                # requested goal row; the certificate matcher binds its mirror.
                continue if not attempt.source_call_obligation_selected
                continue if attempt.source_call_position.line == 0 and attempt.source_call_position.offset == 0 and attempt.source_call_position.end_offset == 0
                call: (complete: bool, found: bool, call_index: usize) = proof_source_recursive_call_position_hash_index(index, attempt.source_call_position, source_work)
                return false if not call.complete or not call.found or call.call_index >= calls.count
                attempt_index: usize = index.attempt_goals.count
                return false if not proof_report_source_work_charge(2, source_work)
                index.attempt_goals.push(attempt.goal)
                index.attempt_next.push(index.empty_attempt)
                if index.attempt_counts[call.call_index] == 0:
                    index.attempt_heads[call.call_index] <- attempt_index
                else:
                    attempt_tail: usize = index.attempt_tails[call.call_index]
                    return false if attempt_tail >= index.attempt_next.count
                    index.attempt_next[attempt_tail] <- attempt_index
                index.attempt_tails[call.call_index] <- attempt_index
                index.attempt_counts[call.call_index] <- index.attempt_counts[call.call_index] + 1
            true

        # Consume the shared structural-certificate rows for one source owner and retain only
        # a per-call multiplicity vector for the caller's obligation loop. The global census
        # already paired each row with its attempt and certificate; hashes here only resolve
        # its exact source call offset in this owner's parser-call index.
        def proof_source_recursive_call_structural_index_fill(index: mutable ProofSourceRecursiveCallAttemptIndex&, owners: mutable ProofSourceRecursiveCallStructuralOwnerIndex&, name: sview, owner_position: Ast::Pos, source_work: mutable usize&) -> bool:
            return false if not index.valid or index.call_positions.count != index.structural_certificate_counts.count
            owner: (complete: bool, verified: bool, row: usize) = proof_source_recursive_call_structural_owner_row(owners, name, source_work)
            return false if not owner.complete or not owner.verified or owner.row >= owners.certificate_heads.count
            certificate_count: usize = owners.certificate_next.count
            return false if:
                owners.certificate_owner_rows.count != certificate_count
                owners.certificate_owner_lines.count != certificate_count
                owners.certificate_owner_offsets.count != certificate_count
                owners.certificate_lines.count != certificate_count
                owners.certificate_call_offsets.count != certificate_count
                owners.certificate_consumed.count != certificate_count
            structural_certificates: mutable usize = 0
            record: mutable usize = owners.certificate_heads[owner.row]
            visited: mutable usize = 0
            while record != owners.empty_certificate and visited < certificate_count |record, visited, certificate_count, owners, owner, owner_position, index, source_work, structural_certificates|:
                return false if not proof_report_source_work_charge(1, source_work) or record >= certificate_count
                return false if owners.certificate_consumed[record]
                return false if owners.certificate_owner_rows[record] != owner.row or owners.certificate_owner_lines[record] != owner_position.line or owners.certificate_owner_offsets[record] != owner_position.offset
                call: (complete: bool, found: bool, call_index: usize) = proof_source_recursive_call_offset_hash_index(index, owners.certificate_call_offsets[record], source_work)
                return false if not call.complete or not call.found or call.call_index >= index.call_positions.count
                call_position: Ast::Pos = index.call_positions[call.call_index]
                return false if owners.certificate_call_offsets[record] != call_position.offset.usize() or owners.certificate_lines[record] != call_position.line
                index.structural_certificate_counts[call.call_index] <- index.structural_certificate_counts[call.call_index] + 1
                owners.certificate_consumed[record] <- true
                structural_certificates <- structural_certificates + 1
                record <- owners.certificate_next[record]
                visited <- visited + 1
            return false if record != owners.empty_certificate or structural_certificates == 0
            for count in index.structural_certificate_counts |count, source_work|:
                return false if not proof_report_source_work_charge(1, source_work)
                return false if count > 1
            true

        def proof_source_recursive_call_expected_goals_covered(index: ProofSourceRecursiveCallAttemptIndex&, expected: darray[Ast::Expr]&, call_index: usize, source_work: mutable usize&) -> bool:
            return false if not index.valid or call_index >= index.attempt_heads.count or call_index >= index.attempt_tails.count or call_index >= index.attempt_counts.count or index.attempt_goals.count != index.attempt_next.count or index.empty_attempt <= index.attempt_goals.count
            # One source call can be analyzed on several symbolic paths (for example
            # once for loop preservation and again for termination). Require every
            # independently reconstructed obligation, but permit repeated attempts
            # for those same goals. Extra attempts with any other goal still fail
            # the membership check below. With no expected obligations, keep the
            # stricter empty-site rule.
            return false if expected.count == 0 and index.attempt_counts[call_index] != 0
            return true if expected.count == 0
            capacity: usize = proof_name_index_capacity(expected.count)
            return false if capacity == 0 or not proof_report_source_work_charge(capacity * 4, source_work)
            slot_hashes: mutable darray[u32] = []
            slot_representatives: mutable darray[Ast::Expr] = []
            slot_counts: mutable darray[usize] = []
            slot_occupied: mutable darray[bool] = []
            slot_hashes.resize(capacity)
            slot_representatives.resize(capacity)
            slot_counts.resize(capacity)
            slot_occupied.resize(capacity)
            for slot in 0..<capacity |slot, slot_hashes, slot_counts, slot_occupied, source_work|:
                return false if not proof_report_source_work_charge(1, source_work)
                slot_hashes[slot] <- 0
                slot_counts[slot] <- 0
                slot_occupied[slot] <- false
            for expected_index in 0..<expected.count |expected_index, expected, slot_hashes, slot_representatives, slot_counts, slot_occupied, source_work, capacity|:
                return false if not proof_report_source_work_charge(1, source_work) or not proof_replay_summary_expr_repeat_charge_with_work(expected[expected_index], 1, source_work)
                expected_hash: u32 = proof_expr_shape_hash(expected[expected_index], 0)
                slot: mutable usize = (expected_hash.i64() % capacity.i64()).usize()
                probes: mutable usize = 0
                inserted: mutable bool = false
                while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, expected_hash, expected_index, expected, slot_hashes, slot_representatives, slot_counts, slot_occupied, source_work, inserted, capacity|:
                    return false if not proof_report_source_work_charge(1, source_work)
                    if not slot_occupied[slot]:
                        slot_hashes[slot] <- expected_hash
                        slot_representatives[slot] <- expected[expected_index]
                        slot_counts[slot] <- 1
                        slot_occupied[slot] <- true
                        inserted <- true
                        break
                    if slot_hashes[slot] == expected_hash:
                        same_goal: bool = proof_replay_summary_expr_equal_with_limit(expected[expected_index], slot_representatives[slot], source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                        return false if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        if same_goal:
                            slot_counts[slot] <- slot_counts[slot] + 1
                            inserted <- true
                            break
                    slot <- (slot + 1) % capacity
                    probes <- probes + 1
                return false if not inserted
            attempt_index: mutable usize = index.attempt_heads[call_index]
            while attempt_index != index.empty_attempt |attempt_index, index, source_work, slot_hashes, slot_representatives, slot_counts, slot_occupied, capacity|:
                return false if attempt_index >= index.attempt_goals.count or attempt_index >= index.attempt_next.count or not proof_report_source_work_charge(1, source_work)
                attempt_goal: Ast::Expr = index.attempt_goals[attempt_index]
                return false if not proof_replay_summary_expr_repeat_charge_with_work(attempt_goal, 1, source_work)
                attempt_hash: u32 = proof_expr_shape_hash(attempt_goal, 0)
                slot: mutable usize = (attempt_hash.i64() % capacity.i64()).usize()
                probes: mutable usize = 0
                found: mutable bool = false
                while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, attempt_hash, attempt_goal, slot_hashes, slot_representatives, slot_counts, slot_occupied, source_work, found, capacity|:
                    return false if not proof_report_source_work_charge(1, source_work)
                    break if not slot_occupied[slot]
                    if slot_hashes[slot] == attempt_hash:
                        equal: bool = proof_replay_summary_expr_equal_with_limit(attempt_goal, slot_representatives[slot], source_work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                        return false if source_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
                        if equal:
                            # Additional path-specific attempts may repeat a goal
                            # already covered by an earlier attempt.
                            slot_counts[slot] <- slot_counts[slot] - 1 if slot_counts[slot] > 0
                            found <- true
                            break
                    slot <- (slot + 1) % capacity
                    probes <- probes + 1
                return false if not found
                attempt_index <- index.attempt_next[attempt_index]
            for slot in 0..<capacity |slot, slot_counts, slot_occupied, source_work|:
                return false if not proof_report_source_work_charge(1, source_work)
                return false if slot_occupied[slot] and slot_counts[slot] != 0
            true

