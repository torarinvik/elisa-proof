# Shared-meter fact-to-trace lookup for callers that combine capture with other source work.
extend ElisaProof:
    public:
        def proof_certificate_fact_trace_index_with_work(report: ProofReport&, fact: Ast::Expr, owner: sview, work: mutable usize&) -> (complete: bool, index: usize):
            sentinel: usize = report.analysis_1.traces.records.count
            support: (complete: bool, supported: bool) = proof_kernel_expression_supported_with_work(fact, &work)
            return (false, sentinel) if not support.complete
            return (true, sentinel) if not support.supported
            return (false, sentinel) if not proof_kernel_ast_support_charge_with_work(sview_len(owner), &work)
            fact_root_result: (complete: bool, root: Ast::Expr) = proof_trace_root_with_work(fact, 0, &work)
            return (false, sentinel) if not fact_root_result.complete
            fact_root: Ast::Expr = fact_root_result.root
            start: mutable usize = report.analysis_1.traces.active_start
            start <- 0 if start > sentinel
            for index in start..<sentinel |index, report, fact, fact_root, owner, work, sentinel|:
                return (false, sentinel) if not proof_kernel_ast_support_charge_with_work(1, &work)
                trace: ProofFactTrace = report.analysis_1.traces.records[index]
                trace_name_length: usize = sview_len(trace.name)
                return (false, sentinel) if not proof_kernel_ast_support_charge_with_work(trace_name_length, &work)
                continue if trace.name != owner
                trace_root_result: (complete: bool, root: Ast::Expr) = proof_trace_root_with_work(trace.expression, 0, &work)
                return (false, sentinel) if not trace_root_result.complete
                return (false, sentinel) if not proof_trace_root_names_charge(trace_root_result.root, fact_root, &work)
                return (false, sentinel) if not proof_kernel_ast_support_charge_with_work(1, &work)
                continue if not proof_trace_root_may_equal(trace_root_result.root, fact_root)
                trace_support: (complete: bool, supported: bool) = proof_kernel_expression_supported_with_work(trace.expression, &work)
                return (false, sentinel) if not trace_support.complete
                continue if not trace_support.supported
                equal: bool = proof_replay_summary_expr_proof_equal_with_limit(trace.expression, fact, &work, PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT)
                return (true, index) if equal
                return (false, sentinel) if work >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            return (true, sentinel)
