# Derived invariants shared by report rendering, CLI admission, and adversarial tests.
extend ElisaProof:
    public:
        # Completion requires every counted obligation to have a proven result. This independent
        # counter invariant catches checker paths that accidentally omit both an open attempt and
        # a failure finding.
        def proof_report_all_obligations_proven(report: ProofReport&) -> bool:
            return report.proven == report.obligations

        # Every finding is inserted through proof_add_finding, which increments the failure
        # counter in the same transaction. Treat disagreement as an invalid report, not success.
        def proof_report_failure_count_consistent(report: ProofReport&) -> bool:
            return report.findings.count == report.failed.usize()

        # The declaration schedule increments `declarations` and emits one summary for every
        # AST declaration (including nested module/scope declarations). A count mismatch means
        # the report lost part of its admission inventory, even if its remaining obligations
        # and certificates happen to replay.
        def proof_report_declaration_inventory_consistent(report: ProofReport&) -> bool:
            return report.declarations.usize() == report.declaration_details.count

        def proof_report_has_open_goals(report: ProofReport&) -> bool:
            for attempt in report.goal_attempts:
                return true if not attempt.proven
            return false

        # A source summary cannot be complete if import/semantic checking failed, a proof
        # obligation failed or remains open, or the aggregate obligation counters disagree.
        # Keep this independent predicate shared by the CLI and machine-readable renderers.
        def proof_report_source_has_unresolved_checks(report: ProofReport&, import_failed: bool, semantic_errors: u32) -> bool:
            return true if not proof_report_failure_count_consistent(report)
            return true if not proof_report_declaration_inventory_consistent(report)
            return true if import_failed or semantic_errors > 0 or report.failed > 0
            return true if not proof_report_all_obligations_proven(report) or proof_report_has_open_goals(report)
            return false
