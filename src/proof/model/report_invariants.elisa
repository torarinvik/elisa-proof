# Derived invariants shared by report rendering, CLI admission, and adversarial tests.
extend ElisaProof:
    private:
        const PROOF_SOURCE_ASSERT_BY_AST_DEPTH_LIMIT: usize = 64

        def proof_report_declaration_function_kind_matches(report: ProofReport&, summary: ProofDeclarationSummary) -> bool:
            for theorem in report.theorem_summaries:
                return summary.kind == "lemma" if theorem.name == summary.name and theorem.line == summary.line
            return summary.kind == "function"

        def proof_report_declaration_matches_source(declaration: Ast::Decl, summary: ProofDeclarationSummary, report: ProofReport&) -> bool:
            match declaration:
                Ast::Decl.Func(name, _, _, _, _, _, position):
                    return summary.name == name and summary.line == position.line and proof_report_declaration_function_kind_matches(report, summary)
                Ast::Decl.Struct(name, _, _, _, _, _, position):
                    return summary.kind == "struct" and summary.name == name and summary.line == position.line
                Ast::Decl.Enum(name, _, _, _, position):
                    return summary.kind == "enum" and summary.name == name and summary.line == position.line
                Ast::Decl.Alias(name, _, position):
                    return summary.kind == "alias" and summary.name == name and summary.line == position.line
                Ast::Decl.Law(name, _, position):
                    return summary.kind == "law" and summary.name == name and summary.line == position.line
                Ast::Decl.Import(name, position):
                    return summary.kind == "import" and summary.name == name and summary.line == position.line
                Ast::Decl.Scoped(_, position):
                    return summary.kind == "scope" and summary.name == "" and summary.line == position.line
                Ast::Decl.Extern(name, _, _, _, _, _, _, position):
                    return summary.kind == "extern" and summary.name == name and summary.line == position.line
                Ast::Decl.Const(name, _, _, _, position):
                    return summary.kind == "const" and summary.name == name and summary.line == position.line
                Ast::Decl.Module(name, _, position):
                    return summary.kind == "module" and summary.name == name and summary.line == position.line
                Ast::Decl.Invalid:
                    return summary.kind == "invalid" and summary.name == "" and summary.line == 0
                _:
                    return false

        def proof_report_declaration_sequence_matches_source(declarations: darray[Ast::Decl]&, report: ProofReport&, cursor: mutable usize&) -> bool:
            for declaration in declarations |report, cursor|:
                return false if cursor >= report.declaration_details.count
                return false if not proof_report_declaration_matches_source(declaration, report.declaration_details[cursor], report)
                cursor <- cursor + 1
                match declaration:
                    Ast::Decl.Module(_, nested, _):
                        return false if not proof_report_declaration_sequence_matches_source(nested, report, cursor)
                    Ast::Decl.Scoped(nested, _):
                        return false if not proof_report_declaration_sequence_matches_source(nested, report, cursor)
                    _:
                        pass
            return true

    public:
        # Completion requires every counted obligation to have a proven result. This independent
        # counter invariant catches checker paths that accidentally omit both an open attempt and
        # a failure finding.
        def proof_report_all_obligations_proven(report: ProofReport&) -> bool:
            return report.proven == report.obligations

        # Every finding is inserted through proof_add_finding, which increments the failure
        # counter in the same transaction. Treat disagreement as an invalid report, not success.
        def proof_report_failure_count_consistent(report: ProofReport&) -> bool:
            return report.findings.count == report.failed.usize()

        # The declaration schedule increments `declarations` and emits one summary for every
        # AST declaration (including nested module/scope declarations). A count mismatch means
        # the report lost part of its admission inventory, even if its remaining obligations
        # and certificates happen to replay.
        def proof_report_declaration_inventory_consistent(report: ProofReport&) -> bool:
            return false if report.declarations.usize() != report.declaration_details.count
            cursor: mutable usize = 0
            return false if not proof_report_declaration_sequence_matches_source(report.source_declarations, report, &cursor)
            return cursor == report.declaration_details.count

        # Keep the result row for each source-check accounting event separate from its aggregate
        # totals and goal-attempt rows. Some unsupported obligations intentionally have no goal
        # attempt; the ledger preserves them and prevents deleting an attempt plus both totals.
        def proof_report_obligation_inventory_consistent(report: ProofReport&) -> bool:
            return false if report.obligation_inventory.count != report.obligations.usize()
            proven_obligations: mutable usize = 0
            identity: mutable usize = 0
            for obligation in report.obligation_inventory |proven_obligations, identity|:
                return false if obligation.identity != identity
                identity <- identity + 1
                proven_obligations <- proven_obligations + 1 if obligation.proven
            return proven_obligations == report.proven.usize()

        # Goal attempts are a subset of source-accounted obligations: some unsupported checks
        # terminate before a proof goal exists, but a proof goal must never outlive its counted
        # obligation. This catches coordinated removal of an open obligation row and its total
        # while the corresponding attempted goal remains in the report.
        def proof_report_goal_attempts_bounded_by_obligations(report: ProofReport&) -> bool:
            return report.goal_attempts.count <= report.obligations.usize()

        # Every successful accounting increment must have a corresponding proof attempt. This
        # prevents a report from keeping its `proven` counter while losing the checked root that
        # justifies that result; replay separately verifies each proven attempt's certificate.
        def proof_report_proven_attempts_consistent(report: ProofReport&) -> bool:
            proven_attempts: mutable usize = 0
            expected_certificate: mutable usize = 0
            for attempt in report.goal_attempts |proven_attempts, expected_certificate, report|:
                if attempt.proven:
                    return false if not attempt.has_certificate or attempt.certificate_index != expected_certificate
                    return false if expected_certificate >= report.certificates.count
                    certificate: ProofGoalCertificate = report.certificates[expected_certificate]
                    return false if certificate.kernel_goal != attempt.kernel_goal or certificate.kernel_facts_start != attempt.kernel_facts_start or certificate.kernel_facts_count != attempt.kernel_facts_count
                    return false if certificate.line != attempt.line or certificate.name != attempt.name or certificate.rule != attempt.rule
                    expected_certificate <- expected_certificate + 1
                    proven_attempts <- proven_attempts + 1
                else:
                    return false if attempt.has_certificate
            return false if proven_attempts != report.proven.usize()
            return expected_certificate == report.certificates.count

        # Focused source queries may return one checked goal while another declaration was
        # absent from the report. Their admission still depends on a structurally complete
        # source inventory and a consistent finding ledger, even when other goals remain open.
        def proof_report_source_admission_invariants_consistent(report: ProofReport&) -> bool:
            # This is report-internal consistency, not evidence that every source-required
            # obligation was scheduled. The current event ledger has no source identity, so
            # source-obligation completeness must not be inferred from these aggregate checks.
            return false if not proof_report_failure_count_consistent(report)
            return false if not proof_report_declaration_inventory_consistent(report)
            return false if not proof_report_obligation_inventory_consistent(report)
            return false if not proof_report_goal_attempts_bounded_by_obligations(report)
            return proof_report_proven_attempts_consistent(report)

        # Independent source inventory slice (R-004): unique top-level functions with exactly
        # one ensure/ensures and one integer literal return. Store the substituted equality
        # proposition even when it is false; dropping a mismatched return would hide an
        # obligation instead of recording a source-derived proposition the kernel must reject.
        def proof_source_literal_ensure_candidate(declaration: Ast::Decl) -> (known: bool, name: sview, contract_line: u32, contract_value: i64, returned_value: i64, result_on_left: bool, equality_postcondition: bool):
            match declaration:
                Ast::Decl.Func(name, _, _, body, _, _, _):
                    return (false, "", 0, 0, 0, false, false) if body.count != 2
                    has_ensure: mutable bool = false
                    has_return: mutable bool = false
                    contract_value: mutable i64 = 0
                    returned_value: mutable i64 = 0
                    result_on_left: mutable bool = false
                    contract_line: mutable u32 = 0
                    equality_postcondition: mutable bool = false
                    for statement in body |has_ensure, has_return, contract_value, returned_value, result_on_left, contract_line, equality_postcondition|:
                        match statement:
                            Ast::Stmt.Contract(kind, expression, position):
                                return (false, "", 0, 0, 0, false, false) if (kind != "ensure" and kind != "ensures") or has_ensure or has_return
                                match expression:
                                    Ast::Expr.BoolLit(value, _):
                                        return (false, "", 0, 0, 0, false, false) if not value
                                    Ast::Expr.Binary(Ast::Expr.Ident("result", _), TokenKind.EqEq, Ast::Expr.IntLit(expected, _), _):
                                        equality_postcondition <- true
                                        result_on_left <- true
                                        contract_value <- expected
                                    Ast::Expr.Binary(Ast::Expr.IntLit(expected, _), TokenKind.EqEq, Ast::Expr.Ident("result", _), _):
                                        equality_postcondition <- true
                                        contract_value <- expected
                                    _:
                                        return (false, "", 0, 0, 0, false, false)
                                contract_line <- position.line
                                has_ensure <- true
                            Ast::Stmt.Return(value, _):
                                return (false, "", 0, 0, 0, false, false) if has_return
                                match value:
                                    Ast::Expr.IntLit(returned, _):
                                        has_return <- true
                                        returned_value <- returned
                                    _:
                                        return (false, "", 0, 0, 0, false, false)
                            _:
                                return (false, "", 0, 0, 0, false, false)
                    return (has_ensure and has_return, name, contract_line, contract_value, returned_value, result_on_left, equality_postcondition)
                _:
                    return (false, "", 0, 0, 0, false, false)

        def proof_source_literal_ensure_count(declarations: darray[Ast::Decl]&, name: sview) -> usize:
            count: mutable usize = 0
            for declaration in declarations |count, name|:
                match declaration:
                    Ast::Decl.Func(candidate, _, _, _, _, _, _):
                        count <- count + 1 if candidate == name
                    Ast::Decl.Module(_, nested, _):
                        count <- count + proof_source_literal_ensure_count(nested, name)
                    Ast::Decl.Scoped(nested, _):
                        count <- count + proof_source_literal_ensure_count(nested, name)
                    _:
                        pass
            return count

        def proof_source_literal_ensure_inventory(declarations: darray[Ast::Decl]&) -> darray[(name: sview, contract_line: u32, contract_value: i64, returned_value: i64, result_on_left: bool, equality_postcondition: bool)]:
            inventory: mutable darray[(name: sview, contract_line: u32, contract_value: i64, returned_value: i64, result_on_left: bool, equality_postcondition: bool)] = []
            for declaration in declarations |inventory|:
                match declaration:
                    Ast::Decl.Func(_, _, _, _, _, _, _):
                        candidate: (known: bool, name: sview, contract_line: u32, contract_value: i64, returned_value: i64, result_on_left: bool, equality_postcondition: bool) = proof_source_literal_ensure_candidate(declaration)
                        if candidate.known:
                            # Empty is an explicit fail-closed ambiguity marker; otherwise the
                            # inventory retains only the immutable source name, not a mutable AST
                            # body or any report-owned scheduling information.
                            inventory.push((candidate.name, candidate.contract_line, candidate.contract_value, candidate.returned_value, candidate.result_on_left, candidate.equality_postcondition) if proof_source_literal_ensure_count(declarations, candidate.name) == 1 else ("", 0, 0, 0, false, false))
                    # Module/scope members are outside this first bounded inventory. They are
                    # not silently flattened because that would make bare names ambiguous.
                    Ast::Decl.Module(_, _, _) | Ast::Decl.Scoped(_, _):
                        pass
                    _:
                        pass
            return inventory

        # Check the claim stored on either a goal attempt or its certificate against the
        # source-derived postcondition. Checking both matters: a mutable attempt display goal
        # must not relabel a certificate for a different proposition as the source proof.
        def proof_source_literal_ensure_goal_matches(goal: Ast::Expr, expected: (name: sview, contract_line: u32, contract_value: i64, returned_value: i64, result_on_left: bool, equality_postcondition: bool)) -> bool:
            match goal:
                Ast::Expr.BoolLit(value, position):
                    return value and not expected.equality_postcondition and position.line == expected.contract_line
                Ast::Expr.Binary(Ast::Expr.IntLit(left, left_position), TokenKind.EqEq, Ast::Expr.IntLit(right, right_position), _):
                    expected_left: mutable i64 = expected.contract_value
                    expected_right: mutable i64 = expected.returned_value
                    if expected.result_on_left:
                        expected_left <- expected.returned_value
                        expected_right <- expected.contract_value
                    return expected.equality_postcondition and left == expected_left and right == expected_right and (left_position.line == expected.contract_line or right_position.line == expected.contract_line)
                _:
                    return false

        def proof_source_literal_ensure_coverage(inventory: darray[(name: sview, contract_line: u32, contract_value: i64, returned_value: i64, result_on_left: bool, equality_postcondition: bool)]&, report: ProofReport&) -> bool:
            for expected in inventory |report|:
                return false if expected.name == ""
                matching: mutable usize = 0
                for attempt in report.goal_attempts |expected, matching, report|:
                    if attempt.name == expected.name and attempt.rule == "goal" and attempt.proven and attempt.has_certificate and attempt.certificate_index < report.certificates.count:
                        certificate: ProofGoalCertificate = report.certificates[attempt.certificate_index]
                        matching <- matching + 1 if certificate.replayed and proof_source_literal_ensure_goal_matches(attempt.goal, expected) and proof_source_literal_ensure_goal_matches(certificate.goal, expected)
                return false if matching != 1
            return true

        # Second independent R-004 slice: Boolean-literal goals and checked Boolean proof steps
        # inside `assert … by:` blocks. Store only copied scalar source identity/value data;
        # never retain a mutable report row or an AST subtree that the checker may rewrite.
    private:
        def proof_source_assert_by_is_assert_callee(expression: Ast::Expr) -> bool:
            match expression:
                Ast::Expr.Ident(name, _) | Ast::Expr.Scope(_, name, _):
                    return name == "assert"
                _:
                    return false

        def proof_source_assert_by_candidate(function_name: sview, scope_supported: bool, statement: Ast::Stmt) -> (found: bool, supported: bool, name: sview, attempt_line: u32, goal_line: u32, goal_offset: u32, expected_value: bool):
            match statement:
                Ast::Stmt.Block(kind, _, _, body, block_position):
                    return (false, false, "", 0, 0, 0, false) if kind != "assert_by"
                    return (true, false, function_name, block_position.line, block_position.line, block_position.offset, false) if body.count == 0
                    match body[0]:
                        Ast::Stmt.Contract(contract_kind, expression, contract_position):
                            match expression:
                                Ast::Expr.BoolLit(value, position):
                                    return (true, scope_supported and contract_kind == "assert", function_name, contract_position.line, position.line, position.offset, value)
                                _:
                                    # Nonliteral propositions remain outside this deliberately
                                    # partial inventory; the ordinary checker still owns their
                                    # proof attempts, but this slice makes no completeness claim.
                                    return (false, false, "", 0, 0, 0, false)
                        _:
                            return (true, false, function_name, block_position.line, block_position.line, block_position.offset, false)
                _:
                    return (false, false, "", 0, 0, 0, false)

        def proof_source_assert_by_add_expression(function_name: sview, attempt_line: u32, scope_supported: bool, expression: Ast::Expr, inventory: mutable darray[(name: sview, attempt_line: u32, goal_line: u32, goal_offset: u32, expected_value: bool, supported: bool)]&) -> void:
            match expression:
                Ast::Expr.BoolLit(value, position):
                    inventory.push((function_name, attempt_line, position.line, position.offset, value, scope_supported))
                _:
                    # Only Boolean literals belong to this source-inventory slice. Other
                    # propositions are still checked by the existing proof/replay path.
                    pass

        # Scan nested expressions too: block expressions, lambdas, matches and recovery arms
        # can own statement lists containing assert-by blocks. Such nested executable scopes are
        # inventoried as unsupported rather than silently disappearing from the source walk.
        def proof_source_assert_by_collect_expression(function_name: sview, expression: Ast::Expr, inventory: mutable darray[(name: sview, attempt_line: u32, goal_line: u32, goal_offset: u32, expected_value: bool, supported: bool)]&, depth: usize) -> void:
            if depth >= PROOF_SOURCE_ASSERT_BY_AST_DEPTH_LIMIT:
                inventory.push((function_name, 0, 0, 0, false, false))
                return
            match expression:
                Ast::Expr.Call(callee, arguments, _, _):
                    proof_source_assert_by_collect_expression(function_name, callee, inventory, depth + 1)
                    for argument in arguments |function_name, inventory, depth|:
                        proof_source_assert_by_collect_expression(function_name, argument, inventory, depth + 1)
                Ast::Expr.StaticEffectCall(effect_type, _, _, arguments, _, _):
                    proof_source_assert_by_collect_expression(function_name, effect_type, inventory, depth + 1)
                    for argument in arguments |function_name, inventory, depth|:
                        proof_source_assert_by_collect_expression(function_name, argument, inventory, depth + 1)
                Ast::Expr.Field(object, _, _) | Ast::Expr.Scope(object, _, _) | Ast::Expr.Move(object, _) | Ast::Expr.RegionNew(object, _, _) | Ast::Expr.Paren(object, _):
                    proof_source_assert_by_collect_expression(function_name, object, inventory, depth + 1)
                Ast::Expr.Index(object, index, _) | Ast::Expr.Binary(object, _, index, _):
                    proof_source_assert_by_collect_expression(function_name, object, inventory, depth + 1)
                    proof_source_assert_by_collect_expression(function_name, index, inventory, depth + 1)
                Ast::Expr.Slice(object, low, high, _):
                    proof_source_assert_by_collect_expression(function_name, object, inventory, depth + 1)
                    proof_source_assert_by_collect_expression(function_name, low, inventory, depth + 1)
                    proof_source_assert_by_collect_expression(function_name, high, inventory, depth + 1)
                Ast::Expr.IndexN(object, arguments, _):
                    proof_source_assert_by_collect_expression(function_name, object, inventory, depth + 1)
                    for argument in arguments |function_name, inventory, depth|:
                        proof_source_assert_by_collect_expression(function_name, argument, inventory, depth + 1)
                Ast::Expr.Unary(_, operand, _):
                    proof_source_assert_by_collect_expression(function_name, operand, inventory, depth + 1)
                Ast::Expr.Array(elements, _) | Ast::Expr.Tuple(elements, _) | Ast::Expr.SetLit(elements, _):
                    for element in elements |function_name, inventory, depth|:
                        proof_source_assert_by_collect_expression(function_name, element, inventory, depth + 1)
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |function_name, inventory, depth|:
                        proof_source_assert_by_collect_expression(function_name, entry.key, inventory, depth + 1)
                        proof_source_assert_by_collect_expression(function_name, entry.value, inventory, depth + 1)
                Ast::Expr.Construct(type_expression, fields, _):
                    proof_source_assert_by_collect_expression(function_name, type_expression, inventory, depth + 1)
                    for field in fields |function_name, inventory, depth|:
                        proof_source_assert_by_collect_expression(function_name, field.value, inventory, depth + 1)
                Ast::Expr.RecordUpdate(base, fields, _):
                    proof_source_assert_by_collect_expression(function_name, base, inventory, depth + 1)
                    for field in fields |function_name, inventory, depth|:
                        proof_source_assert_by_collect_expression(function_name, field.value, inventory, depth + 1)
                Ast::Expr.If(condition, then_expression, else_expression, _):
                    proof_source_assert_by_collect_expression(function_name, condition, inventory, depth + 1)
                    proof_source_assert_by_collect_expression(function_name, then_expression, inventory, depth + 1)
                    proof_source_assert_by_collect_expression(function_name, else_expression, inventory, depth + 1)
                Ast::Expr.Match(scrutinee, arms, _) | Ast::Expr.Catch(scrutinee, arms, _):
                    proof_source_assert_by_collect_expression(function_name, scrutinee, inventory, depth + 1)
                    for arm in arms |function_name, inventory, depth|:
                        proof_source_assert_by_collect_expression(function_name, arm.guard, inventory, depth + 1)
                        proof_source_assert_by_collect_body(function_name, false, arm.body, inventory, depth + 1, false)
                Ast::Expr.Comprehension(_, iterable, condition, body, _):
                    proof_source_assert_by_collect_expression(function_name, iterable, inventory, depth + 1)
                    proof_source_assert_by_collect_expression(function_name, condition, inventory, depth + 1)
                    proof_source_assert_by_collect_expression(function_name, body, inventory, depth + 1)
                Ast::Expr.Refinement(base, predicate, _):
                    proof_source_assert_by_collect_expression(function_name, base, inventory, depth + 1)
                    proof_source_assert_by_collect_expression(function_name, predicate, inventory, depth + 1)
                Ast::Expr.GetElse(guarded, recovery, _):
                    proof_source_assert_by_collect_expression(function_name, guarded, inventory, depth + 1)
                    proof_source_assert_by_collect_body(function_name, false, recovery, inventory, depth + 1, false)
                Ast::Expr.Lambda(_, body, _):
                    proof_source_assert_by_collect_body(function_name, false, body, inventory, depth + 1, false)
                Ast::Expr.Block(statements, value, _, _):
                    proof_source_assert_by_collect_body(function_name, false, statements, inventory, depth + 1, false)
                    proof_source_assert_by_collect_expression(function_name, value, inventory, depth + 1)
                Ast::Expr.Invalid | Ast::Expr.Absent | Ast::Expr.IntLit(_, _) | Ast::Expr.FloatLit(_, _) | Ast::Expr.StringLit(_, _) | Ast::Expr.CharLit(_, _) | Ast::Expr.BoolLit(_, _) | Ast::Expr.Ident(_, _) | Ast::Expr.ShorthandMember(_, _):
                    pass
                _:
                    position: Ast::Pos = Ast::expr_pos(expression)
                    inventory.push((function_name, position.line, position.line, position.offset, false, false))

        # This mirrors the proof-step forms that actually create proposition attempts.
        # Other statements are recursively scanned for nested block expressions; if one owns
        # assert-by source, it is recorded with supported=false until scope identity is modeled.
        def proof_source_assert_by_collect_steps(function_name: sview, scope_supported: bool, body: darray[Ast::Stmt]&, start: usize, inventory: mutable darray[(name: sview, attempt_line: u32, goal_line: u32, goal_offset: u32, expected_value: bool, supported: bool)]&, depth: usize) -> void:
            if depth >= PROOF_SOURCE_ASSERT_BY_AST_DEPTH_LIMIT:
                inventory.push((function_name, 0, 0, 0, false, false))
                return
            return if start >= body.count
            for index in start..<body.count |index, body, function_name, scope_supported, inventory, depth|:
                statement: Ast::Stmt = body[index]
                match statement:
                    Ast::Stmt.Contract(kind, expression, position):
                        proof_source_assert_by_add_expression(function_name, position.line, scope_supported, expression, inventory) if kind == "assert"
                        proof_source_assert_by_collect_expression(function_name, expression, inventory, depth + 1)
                    Ast::Stmt.Expr(expression, position):
                        match expression:
                            Ast::Expr.Call(callee, arguments, _, _):
                                if proof_source_assert_by_is_assert_callee(callee):
                                    proof_source_assert_by_add_expression(function_name, position.line, scope_supported, arguments[0], inventory) if arguments.count == 1
                                    inventory.push((function_name, position.line, position.line, position.offset, false, false)) if arguments.count != 1
                            _:
                                pass
                        proof_source_assert_by_collect_expression(function_name, expression, inventory, depth + 1)
                    Ast::Stmt.Block(kind, _, _, nested, _):
                        if kind == "assert_by":
                            candidate: (found: bool, supported: bool, name: sview, attempt_line: u32, goal_line: u32, goal_offset: u32, expected_value: bool) = proof_source_assert_by_candidate(function_name, false, statement)
                            inventory.push((candidate.name, candidate.attempt_line, candidate.goal_line, candidate.goal_offset, candidate.expected_value, candidate.supported)) if candidate.found
                            proof_source_assert_by_collect_steps(function_name, false, nested, 1, inventory, depth + 1)
                        else:
                            proof_source_assert_by_collect_body(function_name, false, nested, inventory, depth + 1, false)
                    Ast::Stmt.If(condition, then_body, else_body, _):
                        proof_source_assert_by_collect_expression(function_name, condition, inventory, depth + 1)
                        proof_source_assert_by_collect_body(function_name, false, then_body, inventory, depth + 1, false)
                        proof_source_assert_by_collect_body(function_name, false, else_body, inventory, depth + 1, false)
                    Ast::Stmt.While(condition, nested, _):
                        proof_source_assert_by_collect_expression(function_name, condition, inventory, depth + 1)
                        proof_source_assert_by_collect_body(function_name, false, nested, inventory, depth + 1, false)
                    Ast::Stmt.For(_, _, iterable, nested, _):
                        proof_source_assert_by_collect_expression(function_name, iterable, inventory, depth + 1)
                        proof_source_assert_by_collect_body(function_name, false, nested, inventory, depth + 1, false)
                    Ast::Stmt.Match(scrutinee, arms, _):
                        proof_source_assert_by_collect_expression(function_name, scrutinee, inventory, depth + 1)
                        for arm in arms |function_name, inventory, depth|:
                            proof_source_assert_by_collect_expression(function_name, arm.guard, inventory, depth + 1)
                            proof_source_assert_by_collect_body(function_name, false, arm.body, inventory, depth + 1, false)
                    Ast::Stmt.VarDecl(_, type_expression, value, _):
                        proof_source_assert_by_collect_expression(function_name, type_expression, inventory, depth + 1)
                        proof_source_assert_by_collect_expression(function_name, value, inventory, depth + 1)
                    Ast::Stmt.Assign(target, _, value, _):
                        proof_source_assert_by_collect_expression(function_name, target, inventory, depth + 1)
                        proof_source_assert_by_collect_expression(function_name, value, inventory, depth + 1)
                    Ast::Stmt.Return(value, _):
                        if value is returned:
                            proof_source_assert_by_collect_expression(function_name, returned, inventory, depth + 1)
                    Ast::Stmt.Break(_, _) | Ast::Stmt.Continue(_, _):
                        pass
                    _:
                        inventory.push((function_name, 0, 0, 0, false, false))

        def proof_source_assert_by_collect_body(function_name: sview, scope_supported: bool, body: darray[Ast::Stmt]&, inventory: mutable darray[(name: sview, attempt_line: u32, goal_line: u32, goal_offset: u32, expected_value: bool, supported: bool)]&, depth: usize, allow_direct_branch: bool) -> void:
            if depth >= PROOF_SOURCE_ASSERT_BY_AST_DEPTH_LIMIT:
                inventory.push((function_name, 0, 0, 0, false, false))
                return
            for statement in body |function_name, scope_supported, inventory, depth, allow_direct_branch|:
                match statement:
                    Ast::Stmt.Block(kind, _, _, nested, _):
                        if kind == "assert_by":
                            candidate: (found: bool, supported: bool, name: sview, attempt_line: u32, goal_line: u32, goal_offset: u32, expected_value: bool) = proof_source_assert_by_candidate(function_name, scope_supported, statement)
                            inventory.push((candidate.name, candidate.attempt_line, candidate.goal_line, candidate.goal_offset, candidate.expected_value, candidate.supported)) if candidate.found
                            if nested.count > 0:
                                match nested[0]:
                                    Ast::Stmt.Contract(_, expression, _):
                                        proof_source_assert_by_collect_expression(function_name, expression, inventory, depth + 1)
                                    _:
                                        pass
                            proof_source_assert_by_collect_steps(function_name, scope_supported, nested, 1, inventory, depth + 1)
                        else:
                            block_scope_supported: bool = scope_supported and kind == ""
                            proof_source_assert_by_collect_body(function_name, block_scope_supported, nested, inventory, depth + 1, allow_direct_branch and kind == "")
                    Ast::Stmt.If(condition, then_body, else_body, _):
                        proof_source_assert_by_collect_expression(function_name, condition, inventory, depth + 1)
                        # Only a direct function-body branch gets branch coverage. A nested
                        # branch would need its full path in the report identity, which the
                        # current goal-attempt model does not carry; keep it visible, unsupported.
                        branch_supported: bool = scope_supported and allow_direct_branch
                        proof_source_assert_by_collect_body(function_name, branch_supported, then_body, inventory, depth + 1, false)
                        proof_source_assert_by_collect_body(function_name, branch_supported, else_body, inventory, depth + 1, false)
                    Ast::Stmt.While(condition, nested, _):
                        proof_source_assert_by_collect_expression(function_name, condition, inventory, depth + 1)
                        proof_source_assert_by_collect_body(function_name, scope_supported, nested, inventory, depth + 1, false)
                    Ast::Stmt.For(_, _, iterable, nested, _):
                        proof_source_assert_by_collect_expression(function_name, iterable, inventory, depth + 1)
                        proof_source_assert_by_collect_body(function_name, scope_supported, nested, inventory, depth + 1, false)
                    Ast::Stmt.Match(scrutinee, arms, _):
                        proof_source_assert_by_collect_expression(function_name, scrutinee, inventory, depth + 1)
                        branch_supported: bool = scope_supported and allow_direct_branch
                        for arm in arms |function_name, branch_supported, inventory, depth|:
                            proof_source_assert_by_collect_expression(function_name, arm.guard, inventory, depth + 1)
                            proof_source_assert_by_collect_body(function_name, branch_supported, arm.body, inventory, depth + 1, false)
                    Ast::Stmt.Expr(expression, _):
                        proof_source_assert_by_collect_expression(function_name, expression, inventory, depth + 1)
                    Ast::Stmt.VarDecl(_, type_expression, value, _):
                        proof_source_assert_by_collect_expression(function_name, type_expression, inventory, depth + 1)
                        proof_source_assert_by_collect_expression(function_name, value, inventory, depth + 1)
                    Ast::Stmt.Assign(target, _, value, _):
                        proof_source_assert_by_collect_expression(function_name, target, inventory, depth + 1)
                        proof_source_assert_by_collect_expression(function_name, value, inventory, depth + 1)
                    Ast::Stmt.Return(value, _):
                        if value is returned:
                            proof_source_assert_by_collect_expression(function_name, returned, inventory, depth + 1)
                    Ast::Stmt.Contract(_, expression, _):
                        proof_source_assert_by_collect_expression(function_name, expression, inventory, depth + 1)
                    Ast::Stmt.Break(_, _) | Ast::Stmt.Continue(_, _):
                        pass
                    _:
                        inventory.push((function_name, 0, 0, 0, false, false))

    private:
        def proof_source_assert_by_collect_declarations(declarations: darray[Ast::Decl]&, scope_supported: bool, inventory: mutable darray[(name: sview, attempt_line: u32, goal_line: u32, goal_offset: u32, expected_value: bool, supported: bool)]&, depth: usize) -> void:
            if depth >= PROOF_SOURCE_ASSERT_BY_AST_DEPTH_LIMIT:
                inventory.push(("", 0, 0, 0, false, false))
                return
            for declaration in declarations |scope_supported, inventory, depth|:
                match declaration:
                    Ast::Decl.Func(name, _, _, body, _, _, _):
                        proof_source_assert_by_collect_body(name, scope_supported, body, inventory, depth + 1, true)
                    # Names in nested namespaces are intentionally marked unsupported until
                    # source and attempt identities include the full namespace path.
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        proof_source_assert_by_collect_declarations(nested, false, inventory, depth + 1)
                    _:
                        pass

    public:
        def proof_source_assert_by_inventory(declarations: darray[Ast::Decl]&) -> darray[(name: sview, attempt_line: u32, goal_line: u32, goal_offset: u32, expected_value: bool, supported: bool)]:
            inventory: mutable darray[(name: sview, attempt_line: u32, goal_line: u32, goal_offset: u32, expected_value: bool, supported: bool)] = []
            proof_source_assert_by_collect_declarations(declarations, true, inventory, 0)
            return inventory

        def proof_source_assert_by_inventory_has_unsupported(inventory: darray[(name: sview, attempt_line: u32, goal_line: u32, goal_offset: u32, expected_value: bool, supported: bool)]&) -> bool:
            for expected in inventory:
                return true if not expected.supported
            return false

    private:
        def proof_source_assert_by_inventory_find(inventory: darray[(name: sview, attempt_line: u32, goal_line: u32, goal_offset: u32, expected_value: bool, supported: bool)]&, goal: Ast::Expr) -> usize:
            position: Ast::Pos = Ast::expr_pos(goal)
            low: mutable usize = 0
            high: mutable usize = inventory.count
            while low < high |low, high, inventory, position|:
                middle: usize = low + (high - low) / 2
                if inventory[middle].goal_offset < position.offset:
                    low <- middle + 1
                else:
                    high <- middle
            return inventory.count if low >= inventory.count
            return low if inventory[low].goal_offset == position.offset and inventory[low].goal_line == position.line
            return inventory.count

        def proof_source_assert_by_goal_has_identity(goal: Ast::Expr, expected: (name: sview, attempt_line: u32, goal_line: u32, goal_offset: u32, expected_value: bool, supported: bool)) -> bool:
            position: Ast::Pos = Ast::expr_pos(goal)
            return position.line == expected.goal_line and position.offset == expected.goal_offset

        def proof_source_assert_by_goal_matches(goal: Ast::Expr, expected: (name: sview, attempt_line: u32, goal_line: u32, goal_offset: u32, expected_value: bool, supported: bool)) -> bool:
            return false if not expected.supported or not proof_source_assert_by_goal_has_identity(goal, expected)
            match goal:
                Ast::Expr.BoolLit(actual_value, position):
                    return actual_value == expected.expected_value and position.line == expected.goal_line and position.offset == expected.goal_offset
                _:
                    return false

    public:
        # Every source-owned Boolean assert-by goal must have exactly one produced attempt at
        # its source offset, and that attempt plus its certificate must replay the exact source
        # proposition. A source function's direct if/match branches preserve that function
        # owner; nested branch paths fail closed until their path identity is modeled. The
        # importer traversal emits rows in source order; validate that
        # invariant, then binary-search attempts by byte offset to avoid a quadratic scan.
        def proof_source_assert_by_coverage(inventory: darray[(name: sview, attempt_line: u32, goal_line: u32, goal_offset: u32, expected_value: bool, supported: bool)]&, report: ProofReport&) -> bool:
            matched: mutable darray[bool] = []
            previous_offset: mutable u32 = 0
            has_previous: mutable bool = false
            for expected in inventory |matched, previous_offset, has_previous|:
                return false if expected.name == "" or not expected.supported
                return false if has_previous and expected.goal_offset <= previous_offset
                previous_offset <- expected.goal_offset
                has_previous <- true
                matched.push(false)
            for attempt in report.goal_attempts |inventory, matched, report|:
                expected_index: usize = proof_source_assert_by_inventory_find(inventory, attempt.goal)
                if expected_index < inventory.count and attempt.name == inventory[expected_index].name:
                    expected: (name: sview, attempt_line: u32, goal_line: u32, goal_offset: u32, expected_value: bool, supported: bool) = inventory[expected_index]
                    return false if matched[expected_index]
                    matched[expected_index] <- true
                    return false if attempt.rule != "goal" or attempt.line != expected.attempt_line or not attempt.proven or not attempt.has_certificate or attempt.certificate_index >= report.certificates.count
                    certificate: ProofGoalCertificate = report.certificates[attempt.certificate_index]
                    return false if not certificate.replayed or certificate.name != expected.name or certificate.line != expected.attempt_line or certificate.rule != "goal"
                    return false if not proof_source_assert_by_goal_matches(attempt.goal, expected) or not proof_source_assert_by_goal_matches(certificate.goal, expected)
            for expected_index in 0..<matched.count |expected_index, matched|:
                return false if not matched[expected_index]
            return true

        def proof_report_has_open_goals(report: ProofReport&) -> bool:
            for attempt in report.goal_attempts:
                return true if not attempt.proven
            return false

        # A source summary cannot be complete if import/semantic checking failed, a proof
        # obligation failed or remains open, or the aggregate obligation counters disagree.
        # Keep this independent predicate shared by the CLI and machine-readable renderers.
        def proof_report_source_has_unresolved_checks(report: ProofReport&, import_failed: bool, semantic_errors: u32) -> bool:
            return true if not proof_report_source_admission_invariants_consistent(report)
            return true if import_failed or semantic_errors > 0 or report.failed > 0
            return true if not proof_report_all_obligations_proven(report) or proof_report_has_open_goals(report)
            return false
