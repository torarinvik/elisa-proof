# Derived invariants shared by report rendering, CLI admission, and adversarial tests.
include "./report_assert_by_inventory.elisa"
include "./report_frame_inventory.elisa"
include "./report_postcondition_inventory.elisa"
include "./report_goal_attempt_index.elisa"
include "./report_theorem_line_index.elisa"
extend ElisaProof:
    private:
        const PROOF_SOURCE_ASSERT_BY_AST_DEPTH_LIMIT: usize = 64

        def proof_report_declaration_function_kind_matches(summary: ProofDeclarationSummary, theorem_index: ProofTheoremLineIndex&, source_work: mutable usize&) -> bool:
            found: (complete: bool, contains: bool) = proof_report_theorem_line_index_contains(theorem_index, summary.name, summary.line, source_work)
            return false if not found.complete
            return summary.kind == "lemma" if found.contains
            return summary.kind == "function"

        def proof_report_declaration_matches_source(declaration: Ast::Decl, summary: ProofDeclarationSummary, theorem_index: ProofTheoremLineIndex&, source_work: mutable usize&) -> bool:
            match declaration:
                Ast::Decl.Func(name, _, _, _, _, _, position):
                    return false if:
                        not proof_report_source_work_charge(sview_len(summary.name), source_work)
                        not proof_report_source_work_charge(sview_len(name), source_work)
                    return summary.name == name and summary.line == position.line and proof_report_declaration_function_kind_matches(summary, theorem_index, source_work)
                Ast::Decl.Struct(name, _, _, _, _, _, position):
                    return false if:
                        not proof_report_source_work_charge(sview_len(summary.name), source_work)
                        not proof_report_source_work_charge(sview_len(name), source_work)
                    return summary.kind == "struct" and summary.name == name and summary.line == position.line
                Ast::Decl.Enum(name, _, _, _, position):
                    return false if:
                        not proof_report_source_work_charge(sview_len(summary.name), source_work)
                        not proof_report_source_work_charge(sview_len(name), source_work)
                    return summary.kind == "enum" and summary.name == name and summary.line == position.line
                Ast::Decl.Alias(name, _, position):
                    return false if:
                        not proof_report_source_work_charge(sview_len(summary.name), source_work)
                        not proof_report_source_work_charge(sview_len(name), source_work)
                    return summary.kind == "alias" and summary.name == name and summary.line == position.line
                Ast::Decl.Law(name, _, position):
                    return false if:
                        not proof_report_source_work_charge(sview_len(summary.name), source_work)
                        not proof_report_source_work_charge(sview_len(name), source_work)
                    return summary.kind == "law" and summary.name == name and summary.line == position.line
                Ast::Decl.Import(name, position):
                    return false if:
                        not proof_report_source_work_charge(sview_len(summary.name), source_work)
                        not proof_report_source_work_charge(sview_len(name), source_work)
                    return summary.kind == "import" and summary.name == name and summary.line == position.line
                Ast::Decl.Scoped(_, position):
                    return summary.kind == "scope" and summary.name == "" and summary.line == position.line
                Ast::Decl.Extern(name, _, _, _, _, _, _, position):
                    return false if:
                        not proof_report_source_work_charge(sview_len(summary.name), source_work)
                        not proof_report_source_work_charge(sview_len(name), source_work)
                    return summary.kind == "extern" and summary.name == name and summary.line == position.line
                Ast::Decl.Const(name, _, _, _, position):
                    return false if:
                        not proof_report_source_work_charge(sview_len(summary.name), source_work)
                        not proof_report_source_work_charge(sview_len(name), source_work)
                    return summary.kind == "const" and summary.name == name and summary.line == position.line
                Ast::Decl.Module(name, _, position):
                    return false if:
                        not proof_report_source_work_charge(sview_len(summary.name), source_work)
                        not proof_report_source_work_charge(sview_len(name), source_work)
                    return summary.kind == "module" and summary.name == name and summary.line == position.line
                Ast::Decl.Invalid:
                    return summary.kind == "invalid" and summary.name == "" and summary.line == 0
                _:
                    return false

        def proof_report_declaration_sequence_matches_source(declarations: darray[Ast::Decl]&, report: ProofReport&, theorem_index: ProofTheoremLineIndex&, cursor: mutable usize&, source_work: mutable usize&) -> bool:
            for declaration in declarations |report, theorem_index, cursor, source_work|:
                return false if:
                    not proof_report_source_work_charge(1, source_work)
                    cursor >= report.analysis_1.declaration_details.count
                    not proof_report_declaration_matches_source(declaration, report.analysis_1.declaration_details[cursor], theorem_index, source_work)
                cursor <- cursor + 1
                match declaration:
                    Ast::Decl.Module(_, nested, _):
                        return false if not proof_report_declaration_sequence_matches_source(nested, report, theorem_index, cursor, source_work)
                    Ast::Decl.Scoped(nested, _):
                        return false if not proof_report_declaration_sequence_matches_source(nested, report, theorem_index, cursor, source_work)
                    _:
                        pass
            return true

    public:
        # Low-trust producer diagnostic only: this compares mutable report counters and does not
        # establish replay or source admission. Never use it as a proof verdict; admission decisions
        # must go through an opaque ProofCheckedView.
        def proof_report_all_obligations_proven(report: ProofReport&) -> bool:
            return report.results.proven == report.results.obligations

        # Every finding is inserted through proof_add_finding, which increments the failure
        # counter in the same transaction. Treat disagreement as an invalid report, not success.
        def proof_report_failure_count_consistent(report: ProofReport&) -> bool:
            return report.results.findings.count == report.results.failed.usize()

        # The declaration schedule increments `declarations` and emits one summary for every
        # AST declaration (including nested module/scope declarations). A count mismatch means
        # the report lost part of its admission inventory, even if its remaining obligations
        # and certificates happen to replay.
        def proof_report_declaration_inventory_consistent(report: ProofReport&, source_work: mutable usize&) -> bool:
            return false if report.results.declarations.usize() != report.analysis_1.declaration_details.count
            theorem_index: (index: ProofTheoremLineIndex, complete: bool) = proof_report_theorem_line_index(report, source_work)
            return false if not theorem_index.complete
            cursor: mutable usize = 0
            return false if not proof_report_declaration_sequence_matches_source(report.source.source_declarations, report, theorem_index.index, &cursor, source_work)
            return cursor == report.analysis_1.declaration_details.count

        # Keep the result row for each source-check accounting event separate from its aggregate
        # totals and goal-attempt rows. Some unsupported obligations intentionally have no goal
        # attempt; the ledger preserves them and prevents deleting an attempt plus both totals.
        def proof_report_obligation_inventory_consistent(report: ProofReport&) -> bool:
            return false if report.results.obligation_inventory.count != report.results.obligations.usize()
            proven_obligations: mutable usize = 0
            identity: mutable usize = 0
            for obligation in report.results.obligation_inventory |proven_obligations, identity|:
                return false if obligation.identity != identity
                identity <- identity + 1
                proven_obligations <- proven_obligations + 1 if obligation.proven
            return proven_obligations == report.results.proven.usize()

        # A source contract can create several path-specific goal attempts when a body has
        # multiple returns. Therefore the attempt count may exceed the source obligation count.
        # Proven attempts still have exact sequential certificate accounting below, and the
        # obligation inventory independently binds the aggregate source count and proven count.
        def proof_report_goal_attempts_bounded_by_obligations(report: ProofReport&) -> bool:
            return false if report.results.proven.usize() > report.results.obligations.usize() or report.results.goal_attempts.count + proof_report_proven_frame_obligations(report) < report.results.proven.usize()
            cursor: mutable usize = 0
            for event in report.results.obligation_inventory |event, report, cursor|:
                return false if:
                    event.attempts_start != cursor or cursor > report.results.goal_attempts.count
                    event.attempts_count > report.results.goal_attempts.count - cursor
                cursor <- cursor + event.attempts_count
            return cursor == report.results.goal_attempts.count

        # Proven frame-check rows: accounted obligations that by construction have no attempt.
        def proof_report_proven_frame_obligations(report: ProofReport&) -> usize:
            count: mutable usize = 0
            for obligation in report.results.obligation_inventory |count|:
                count <- count + 1 if obligation.proven and obligation.source_kind == "frame"
            return count

        # Every successful accounting increment must have a corresponding proof attempt. This
        # prevents a report from keeping its `proven` counter while losing the checked root that
        # justifies that result; replay separately verifies each proven attempt's certificate.
        def proof_report_proven_attempts_consistent(report: ProofReport&) -> bool:
            proven_attempts: mutable usize = 0
            expected_certificate: mutable usize = 0
            for attempt in report.results.goal_attempts |proven_attempts, expected_certificate, report|:
                if attempt.proven:
                    return false if:
                        not attempt.has_certificate or attempt.certificate_index != expected_certificate
                        expected_certificate >= report.analysis_1.certificates.count
                    certificate: ProofGoalCertificate = report.analysis_1.certificates[expected_certificate]
                    return false if:
                        certificate.kernel_goal != attempt.kernel_goal or certificate.kernel_facts_start != attempt.kernel_facts_start or certificate.kernel_facts_count != attempt.kernel_facts_count
                        certificate.line != attempt.line or certificate.name != attempt.name or certificate.rule != attempt.rule
                    expected_certificate <- expected_certificate + 1
                    proven_attempts <- proven_attempts + 1
                else:
                    return false if attempt.has_certificate
            # Branch analysis may prove several execution paths for one source obligation.
            # The obligation inventory owns the source-level count; certificates own every
            # path-specific attempt, so attempts can outnumber proven obligations.
            return false if proven_attempts + proof_report_proven_frame_obligations(report) < report.results.proven.usize()
            return expected_certificate == report.analysis_1.certificates.count

        # Bounded Q0.8 coverage: body-level ensures are recounted from the retained AST and
        # each distinct source index must have at least one accounting event. Multiple return
        # paths may legitimately emit multiple events for the same index. Signature-only
        # contracts and other obligation families are deliberately outside this invariant.
        def proof_report_source_postcondition_inventory_consistent(report: ProofReport&) -> bool:
            source_work: mutable usize = 0
            proof_report_source_postcondition_inventory_consistent_with_work(report, &source_work)

        def proof_report_source_postcondition_inventory_consistent_with_work(report: ProofReport&, source_work: mutable usize&) -> bool:
            event_keys: mutable darray[ProofSourcePostconditionKey] = []
            for obligation in report.results.obligation_inventory |report, source_work|:
                return false if not proof_report_source_postcondition_work_charge(1, source_work)
                if obligation.source_kind == "postcondition":
                    return false if:
                        event_keys.count >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 4
                        not proof_report_source_postcondition_work_charge(sview_len(obligation.source_name), source_work)
                    event_keys.push(ProofSourcePostconditionKey{name: obligation.source_name, line: obligation.source_line, source_index: obligation.source_obligation_index})
                elif obligation.source_kind in {"changes", "preserves", "allow", "preserve"}:
                    return false if not proof_report_frame_obligation_associated(report, obligation, source_work)
                else:
                    return false if:
                        obligation.source_kind != "" and obligation.source_kind != "frame"
                        obligation.source_line != 0 or obligation.source_name != "" or obligation.source_obligation_index != 0

            owner_keys: mutable darray[ProofSourcePostconditionKey] = []
            return false if not proof_report_source_postcondition_keys_collect(report.source.source_declarations, &owner_keys, source_work, 0)
            owner_index: mutable ProofSourcePostconditionCountIndex = proof_report_source_postcondition_index_create(owner_keys.count, source_work)
            return false if not owner_index.valid
            for key in owner_keys |owner_index, source_work|:
                return false if not proof_report_source_postcondition_index_add(&owner_index, key, 1, false, source_work)

            event_index: mutable ProofSourcePostconditionCountIndex = proof_report_source_postcondition_index_create(event_keys.count, source_work)
            return false if not event_index.valid
            for key in event_keys |event_index, source_work|:
                return false if not proof_report_source_postcondition_index_add(&event_index, key, 1, false, source_work)
            for key in event_keys |owner_index, source_work|:
                owner: (complete: bool, found: bool, count: usize) = proof_report_source_postcondition_index_find(owner_index, key, source_work)
                return false if not owner.complete or not owner.found or owner.count != 1

            schedule_index: mutable ProofSourcePostconditionCountIndex = ProofSourcePostconditionCountIndex{valid: true}
            if report.context.focused_function != "":
                schedule_index <- proof_report_source_postcondition_schedule_index(report, source_work)
                return false if not schedule_index.valid
            proof_report_source_postconditions_have_events_with_work(report.source.source_declarations, report, event_index, schedule_index, source_work, 0)

        # Focused source queries may return one checked goal while another declaration was
        # absent from the report. Their admission still depends on a structurally complete
        # source inventory and a consistent finding ledger, even when other goals remain open.
        # Return the first failed accounting boundary for diagnostics. The empty string means
        # these invariants hold, not that source checking succeeded.
        def proof_report_source_admission_failure(report: ProofReport&) -> sview:
            source_work: mutable usize = 0
            return "finding-count" if not proof_report_failure_count_consistent(report)
            declarations_consistent: bool = proof_report_declaration_inventory_consistent(report, &source_work)
            return "source-admission-work-limit" if not declarations_consistent and source_work > proof_replay_summary_source_work_limit()
            return "declaration-inventory" if not declarations_consistent
            return "obligation-inventory" if not proof_report_obligation_inventory_consistent(report)
            return "goal-attempt-coverage" if not proof_report_goal_attempts_bounded_by_obligations(report)
            return "postcondition-inventory" if not proof_report_source_postcondition_inventory_consistent(report)
            if report.context.focused_function != "":
                return "focused-source-obligations" if not proof_report_focused_source_obligations_covered(report)
            else:
                source_literal_ensures: darray[(name: sview, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool)] = proof_source_literal_ensure_inventory(report.source.source_declarations)
                return "source-literal-ensure-coverage" if not proof_source_literal_ensure_coverage(source_literal_ensures, report)
                source_assert_by_goals: darray[(name: sview, attempt_line: u32, goal_line: u32, goal_offset: u32, expected_value: bool, source_goal: Ast::Expr, supported: bool)] = proof_source_assert_by_inventory(report.source.source_declarations)
                return "source-assert-by-coverage" if not proof_source_assert_by_coverage(source_assert_by_goals, report)
            return "proven-attempt-certificates" if not proof_report_proven_attempts_consistent(report)
            return ""

        def proof_report_source_admission_invariants_consistent(report: ProofReport&) -> bool:
            return proof_report_source_admission_failure(report) == ""

    private:
        # Global accounting and declaration structure protect every local query. Whole-source
        # coverage is intentionally kept out of this predicate so an unrelated open claim does
        # not suppress a separately source-bound goal.
        def proof_report_source_structure_consistent(report: ProofReport&, source_work: mutable usize&) -> bool:
            return false if:
                not proof_report_failure_count_consistent(report)
                not proof_report_declaration_inventory_consistent(report, source_work)
                not proof_report_obligation_inventory_consistent(report)
                not proof_report_goal_attempts_bounded_by_obligations(report)
            return proof_report_proven_attempts_consistent(report)

        def proof_report_source_literal_ensure_goal_attempt_admitted(expected: (name: sview, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool), report: ProofReport&, goal_id: usize, source_work: mutable usize&) -> bool:
            return false if goal_id >= report.results.goal_attempts.count or expected.name == "" or expected.contract_line == 0
            attempt: ProofGoalAttempt = report.results.goal_attempts[goal_id]
            return false if:
                not proof_report_source_work_charge(sview_len(expected.name), source_work)
                not proof_report_source_work_charge(sview_len(attempt.name), source_work)
                not proof_report_source_work_charge(sview_len(attempt.rule), source_work)
                attempt.name != expected.name or attempt.rule != "goal" or not proof_source_literal_ensure_goal_matches(attempt.goal, expected, source_work)
                attempt.has_certificate != attempt.proven
            if attempt.proven:
                return false if attempt.certificate_index >= report.analysis_1.certificates.count
                certificate: ProofGoalCertificate = report.analysis_1.certificates[attempt.certificate_index]
                return false if:
                    not proof_report_source_work_charge(sview_len(certificate.name), source_work)
                    not proof_report_source_work_charge(sview_len(certificate.rule), source_work)
                return certificate.name == expected.name and certificate.line == attempt.line and certificate.rule == attempt.rule and proof_source_literal_ensure_goal_matches(certificate.goal, expected, source_work)
            return true

        def proof_report_obligation_event_for_goal(report: ProofReport&, goal_id: usize, source_work: mutable usize&) -> (found: bool, entry: ProofObligationEntry):
            low: mutable usize = 0
            high: mutable usize = report.results.obligation_inventory.count
            empty: ProofObligationEntry = ProofObligationEntry{identity: 0, attempts_start: 0, attempts_count: 0, proven: false, source_line: 0, source_name: "", source_kind: "", source_obligation_index: 0}
            while low < high |low, high, report, goal_id, source_work|:
                return (false, empty) if not proof_report_source_work_charge(1, source_work)
                middle: usize = low + (high - low) / 2
                entry: ProofObligationEntry = report.results.obligation_inventory[middle]
                if goal_id < entry.attempts_start:
                    high <- middle
                else:
                    attempt_offset: usize = goal_id - entry.attempts_start
                    if attempt_offset < entry.attempts_count:
                        return (true, entry)
                    low <- middle + 1
            (false, empty)

    public:
        def proof_source_parameter_name_count(parameters: darray[Ast::ParamDecl]&, name: sview) -> usize:
            count: mutable usize = 0
            for parameter in parameters |count, name|:
                count <- count + 1 if parameter.name == name
            return count

        # Independent source inventory slice (R-004): unique top-level functions with leading
        # requires clauses, one ensure/ensures, and one integer literal or declared-parameter
        # return. Store the substituted equality proposition even when it is false; dropping a
        # mismatched return would hide an obligation instead of recording the source claim.
        def proof_source_literal_ensure_candidate(declaration: Ast::Decl) -> (known: bool, name: sview, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool):
            source_work: mutable usize = 0
            complete: mutable bool = true
            proof_source_literal_ensure_candidate_with_work(declaration, &source_work, &complete)

    private:
        # Name multiplicity is needed by source admission, but recounting the full declaration
        # tree for every postcondition turns a large module into quadratic work. Build this
        # collision-safe index once and refuse admission if its bounded construction runs out.
        struct ProofSourceFunctionMultiplicityIndex:
            valid: bool = false
            slot_values: mutable darray[usize] = []
            hashes: mutable darray[u32] = []
            names: mutable darray[sview] = []
            counts: mutable darray[usize] = []

        def proof_source_function_declaration_count(declarations: darray[Ast::Decl]&, depth: usize, count: mutable usize&, source_work: mutable usize&) -> bool:
            return false if depth >= PROOF_SOURCE_ASSERT_BY_AST_DEPTH_LIMIT
            for declaration in declarations |depth, count, source_work|:
                return false if not proof_report_source_work_charge(1, source_work)
                match declaration:
                    Ast::Decl.Func(_, _, _, _, _, _, _):
                        count <- count + 1
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        return false if not proof_source_function_declaration_count(nested, depth + 1, count, source_work)
                    _:
                        pass
            return true

        def proof_source_function_multiplicity_insert(declarations: darray[Ast::Decl]&, index: mutable ProofSourceFunctionMultiplicityIndex&, source_work: mutable usize&, depth: usize) -> bool:
            return false if depth >= PROOF_SOURCE_ASSERT_BY_AST_DEPTH_LIMIT
            capacity: usize = index.slot_values.count
            for declaration in declarations |index, source_work, depth, capacity|:
                return false if not proof_report_source_work_charge(1, source_work)
                match declaration:
                    Ast::Decl.Func(name, _, _, _, _, _, _):
                        name_hash: (complete: bool, hash: u32) = proof_report_declaration_name_hash(name, source_work)
                        return false if not name_hash.complete or capacity == 0
                        slot: mutable usize = (name_hash.hash.i64() % capacity.i64()).usize()
                        probes: mutable usize = 0
                        while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, name, name_hash, index, capacity, source_work|:
                            return false if not proof_report_source_work_charge(1, source_work)
                            current: usize = index.slot_values[slot]
                            if current == capacity:
                                name_index: usize = index.names.count
                                index.names.push(name)
                                index.hashes[slot] <- name_hash.hash
                                index.counts.push(1)
                                index.slot_values[slot] <- name_index
                                break
                            return false if current >= index.names.count
                            if index.hashes[slot] == name_hash.hash:
                                return false if not proof_report_source_work_charge(sview_len(name), source_work)
                                if index.names[current] == name:
                                    index.counts[current] <- index.counts[current] + 1
                                    break
                            slot <- (slot + 1) % capacity
                            probes <- probes + 1
                        return false if probes >= capacity or probes > PROOF_NAME_INDEX_MAX_CLUSTER
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        return false if not proof_source_function_multiplicity_insert(nested, index, source_work, depth + 1)
                    _:
                        pass
            return true

        def proof_source_function_multiplicity_index(declarations: darray[Ast::Decl]&, source_work: mutable usize&) -> ProofSourceFunctionMultiplicityIndex can[Memory.Allocate]:
            declaration_count: mutable usize = 0
            return ProofSourceFunctionMultiplicityIndex{} if not proof_source_function_declaration_count(declarations, 0, &declaration_count, source_work)
            index: mutable ProofSourceFunctionMultiplicityIndex = ProofSourceFunctionMultiplicityIndex{valid: true}
            return index if declaration_count == 0
            return ProofSourceFunctionMultiplicityIndex{} if declaration_count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 4
            target_capacity: usize = declaration_count * 2
            capacity: mutable usize = 1
            while capacity < target_capacity |capacity, target_capacity|:
                return ProofSourceFunctionMultiplicityIndex{} if capacity > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 4
                capacity <- capacity * 2
            return ProofSourceFunctionMultiplicityIndex{} if not proof_report_source_work_charge(capacity, source_work)
            index.slot_values.resize(capacity)
            index.hashes.resize(capacity)
            for slot in 0..<capacity |slot, index, capacity|:
                index.slot_values[slot] <- capacity
            return ProofSourceFunctionMultiplicityIndex{} if not proof_source_function_multiplicity_insert(declarations, index, source_work, 0)
            return index

        def proof_source_function_name_is_unique(index: ProofSourceFunctionMultiplicityIndex, name: sview, source_work: mutable usize&) -> bool:
            capacity: usize = index.slot_values.count
            return false if not index.valid or capacity == 0
            name_hash: (complete: bool, hash: u32) = proof_report_declaration_name_hash(name, source_work)
            return false if not name_hash.complete
            slot: mutable usize = (name_hash.hash.i64() % capacity.i64()).usize()
            probes: mutable usize = 0
            while probes < capacity and probes <= PROOF_NAME_INDEX_MAX_CLUSTER |probes, slot, name, name_hash, index, capacity, source_work|:
                return false if not proof_report_source_work_charge(1, source_work)
                current: usize = index.slot_values[slot]
                return false if current == capacity or current >= index.names.count
                if index.hashes[slot] == name_hash.hash:
                    return false if not proof_report_source_work_charge(sview_len(name), source_work)
                    return index.counts[current] == 1 if index.names[current] == name
                slot <- (slot + 1) % capacity
                probes <- probes + 1
            return false

        def proof_report_has_open_goals(report: ProofReport&) -> bool:
            for attempt in report.results.goal_attempts:
                return true if not attempt.proven
            return false

        # Legacy report diagnostic: this checks aggregate report invariants and producer-marked
        # obligation closure only. It does not carry a replay receipt or parser-origin source
        # capability, so false is not a source-admission verdict. Source-positive status belongs
        # to ProofCheckedView after source validation and independent replay.
        def proof_report_source_has_unresolved_checks(report: ProofReport&, import_failed: bool, semantic_errors: u32) -> bool:
            return true if:
                not proof_report_source_admission_invariants_consistent(report)
                import_failed or semantic_errors > 0 or report.results.failed > 0
                not proof_report_all_obligations_proven(report) or proof_report_has_open_goals(report)
            return false

include "./report_focused_source_ensures.elisa"
