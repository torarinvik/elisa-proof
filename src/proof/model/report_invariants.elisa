# Derived invariants shared by report rendering, CLI admission, and adversarial tests.
include "./report_assert_by_inventory.elisa"
include "./report_postcondition_inventory.elisa"
include "./report_frame_inventory.elisa"
include "./report_goal_attempt_index.elisa"
include "./report_theorem_line_index.elisa"
extend ElisaProof:
    private:
        const PROOF_SOURCE_ASSERT_BY_AST_DEPTH_LIMIT: usize = 64

        def proof_report_declaration_function_kind_matches(summary: ProofDeclarationSummary, theorem_index: ProofTheoremLineIndex&, source_work: mutable usize&) -> bool:
            found: (complete: bool, contains: bool) = proof_report_theorem_line_index_contains(theorem_index, summary.name, summary.line, summary.source_offset, source_work)
            return false if not found.complete
            return summary.kind == "lemma" if found.contains
            return summary.kind == "function"

        def proof_report_declaration_matches_source(declaration: Ast::Decl, summary: ProofDeclarationSummary, theorem_index: ProofTheoremLineIndex&, source_work: mutable usize&) -> bool:
            match declaration:
                Ast::Decl.Func(name, _, _, _, _, _, position):
                    return false if:
                        not proof_report_source_work_charge(sview_len(summary.name), source_work)
                        not proof_report_source_work_charge(sview_len(name), source_work)
                    return summary.name == name and summary.line == position.line and summary.source_offset == position.offset and proof_report_declaration_function_kind_matches(summary, theorem_index, source_work)
                Ast::Decl.Struct(name, _, _, _, _, _, position):
                    return false if:
                        not proof_report_source_work_charge(sview_len(summary.name), source_work)
                        not proof_report_source_work_charge(sview_len(name), source_work)
                    return summary.kind == "struct" and summary.name == name and summary.line == position.line and summary.source_offset == position.offset
                Ast::Decl.Enum(name, _, _, _, position):
                    return false if:
                        not proof_report_source_work_charge(sview_len(summary.name), source_work)
                        not proof_report_source_work_charge(sview_len(name), source_work)
                    return summary.kind == "enum" and summary.name == name and summary.line == position.line and summary.source_offset == position.offset
                Ast::Decl.Alias(name, _, position):
                    return false if:
                        not proof_report_source_work_charge(sview_len(summary.name), source_work)
                        not proof_report_source_work_charge(sview_len(name), source_work)
                    return summary.kind == "alias" and summary.name == name and summary.line == position.line and summary.source_offset == position.offset
                Ast::Decl.Law(name, _, position):
                    return false if:
                        not proof_report_source_work_charge(sview_len(summary.name), source_work)
                        not proof_report_source_work_charge(sview_len(name), source_work)
                    return summary.kind == "law" and summary.name == name and summary.line == position.line and summary.source_offset == position.offset
                Ast::Decl.Import(name, position):
                    return false if:
                        not proof_report_source_work_charge(sview_len(summary.name), source_work)
                        not proof_report_source_work_charge(sview_len(name), source_work)
                    return summary.kind == "import" and summary.name == name and summary.line == position.line and summary.source_offset == position.offset
                Ast::Decl.Scoped(_, position):
                    return summary.kind == "scope" and summary.name == "" and summary.line == position.line and summary.source_offset == position.offset
                Ast::Decl.Extern(name, _, _, _, _, _, _, position):
                    return false if:
                        not proof_report_source_work_charge(sview_len(summary.name), source_work)
                        not proof_report_source_work_charge(sview_len(name), source_work)
                    return summary.kind == "extern" and summary.name == name and summary.line == position.line and summary.source_offset == position.offset
                Ast::Decl.Const(name, _, _, _, position):
                    return false if:
                        not proof_report_source_work_charge(sview_len(summary.name), source_work)
                        not proof_report_source_work_charge(sview_len(name), source_work)
                    return summary.kind == "const" and summary.name == name and summary.line == position.line and summary.source_offset == position.offset
                Ast::Decl.Module(name, _, position):
                    return false if:
                        not proof_report_source_work_charge(sview_len(summary.name), source_work)
                        not proof_report_source_work_charge(sview_len(name), source_work)
                    return summary.kind == "module" and summary.name == name and summary.line == position.line and summary.source_offset == position.offset
                Ast::Decl.Invalid:
                    return summary.kind == "invalid" and summary.name == "" and summary.line == 0 and summary.source_offset == 0
                _:
                    return false

        def proof_report_declaration_sequence_matches_source(declarations: darray[Ast::Decl]&, report: ProofReport&, theorem_index: ProofTheoremLineIndex&, cursor: mutable usize&, source_work: mutable usize&) -> bool:
            for declaration in declarations |report, theorem_index, cursor, source_work|:
                return false if:
                    not proof_report_source_work_charge(1, source_work)
                    cursor >= report.analysis_1.declaration_details.count
                    not proof_report_declaration_matches_source(declaration, report.analysis_1.declaration_details[cursor], theorem_index, source_work)
                cursor <- cursor + 1
                match declaration:
                    Ast::Decl.Module(_, nested, _):
                        return false if not proof_report_declaration_sequence_matches_source(nested, report, theorem_index, cursor, source_work)
                    Ast::Decl.Scoped(nested, _):
                        return false if not proof_report_declaration_sequence_matches_source(nested, report, theorem_index, cursor, source_work)
                    _:
                        pass
            return true

    private:
        # Internal producer consistency check only. It compares mutable report counters and does
        # not establish replay or source admission; proof verdicts come from ProofCheckedView.
        def proof_report_all_obligations_proven(report: ProofReport&) -> bool:
            return report.results.producer_proven_count == report.results.obligations

    public:
        # Every finding is inserted through proof_add_finding, which increments the failure
        # counter in the same transaction. Treat disagreement as an invalid report, not success.
        def proof_report_failure_count_consistent(report: ProofReport&) -> bool:
            return report.results.findings.count == report.results.failed.usize()

        # A report may call a finding disproved only when its exact evaluator retained a
        # counterexample row. Keep that status bound to an in-range witness slice before the
        # finding can enter source admission or output summaries.
        def proof_report_finding_evidence_consistent_with_work(report: ProofReport&, source_work: mutable usize&) -> bool:
            for finding in report.results.findings |finding, report, source_work|:
                return false if not proof_report_source_work_charge(1, source_work)
                return false if finding.counterexample_start > report.results.counterexample_facts.count
                return false if finding.counterexample_count > report.results.counterexample_facts.count - finding.counterexample_start
                return false if:
                    not proof_report_source_work_charge(sview_len(finding.status), source_work)
                    not proof_report_source_work_charge(sview_len("disproved"), source_work)
                    not proof_report_source_work_charge(sview_len(finding.status), source_work)
                return false if not (finding.status in {"unknown", "unsupported", "timeout", "disproved"})
                return false if finding.counterexample_found != (finding.status == "disproved")
            true

        # The declaration schedule increments `declarations` and emits one summary for every
        # AST declaration (including nested module/scope declarations). A count mismatch means
        # the report lost part of its admission inventory, even if its remaining obligations
        # and certificates happen to replay.
        def proof_report_declaration_inventory_consistent(report: ProofReport&, source_work: mutable usize&) -> bool:
            return false if report.results.declarations.usize() != report.analysis_1.declaration_details.count
            theorem_index: (index: ProofTheoremLineIndex, complete: bool) = proof_report_theorem_line_index(report, source_work)
            return false if not theorem_index.complete
            cursor: mutable usize = 0
            return false if not proof_report_declaration_sequence_matches_source(report.source.source_declarations, report, theorem_index.index, &cursor, source_work)
            return cursor == report.analysis_1.declaration_details.count

        # Keep the result row for each source-check accounting event separate from its aggregate
        # totals and goal-attempt rows. Some unsupported obligations intentionally have no goal
        # attempt; the ledger preserves them and prevents deleting an attempt plus both totals.
        def proof_report_obligation_inventory_consistent(report: ProofReport&, source_work: mutable usize&) -> bool:
            return false if report.results.obligation_inventory.count != report.results.obligations.usize()
            proven_obligations: mutable usize = 0
            identity: mutable usize = 0
            for obligation in report.results.obligation_inventory |proven_obligations, identity, source_work|:
                return false if not proof_report_source_work_charge(1, source_work) or obligation.identity != identity
                identity <- identity + 1
                proven_obligations <- proven_obligations + 1 if obligation.proven
            return proven_obligations == report.results.producer_proven_count.usize()

        # A source contract can create several path-specific goal attempts when a body has
        # multiple returns. Therefore the attempt count may exceed the source obligation count.
        # Proven attempts still have exact sequential certificate accounting below, and the
        # obligation inventory independently binds the aggregate source count and proven count.
        def proof_report_goal_attempts_bounded_by_obligations(report: ProofReport&, source_work: mutable usize&, track_open_goals: bool, has_open_goal: mutable bool&) -> bool:
            frame_obligations: (complete: bool, count: usize) = proof_report_proven_frame_obligations(report, source_work)
            return false if not frame_obligations.complete or report.results.producer_proven_count.usize() > report.results.obligations.usize() or report.results.goal_attempts.count + frame_obligations.count < report.results.producer_proven_count.usize()
            cursor: mutable usize = 0
            for event in report.results.obligation_inventory |event, report, cursor, source_work, track_open_goals, has_open_goal|:
                return false if:
                    not proof_report_source_work_charge(1, source_work)
                    event.attempts_start != cursor or cursor > report.results.goal_attempts.count
                    event.attempts_count > report.results.goal_attempts.count - cursor
                return false if event.attempts_count > 0 and event.owner_function_line == 0
                for attempt_offset in 0..<event.attempts_count |attempt_offset, event, report, cursor, source_work, track_open_goals, has_open_goal|:
                    return false if not proof_report_source_work_charge(1, source_work)
                    attempt: ProofGoalAttempt = report.results.goal_attempts[cursor + attempt_offset]
                    has_open_goal <- true if track_open_goals and not attempt.producer_proven
                    return false if attempt.owner_function_line != event.owner_function_line or attempt.owner_function_offset != event.owner_function_offset
                cursor <- cursor + event.attempts_count
            return cursor == report.results.goal_attempts.count

        # Proven frame-check rows: accounted obligations that by construction have no attempt.
        def proof_report_proven_frame_obligations(report: ProofReport&, source_work: mutable usize&) -> (complete: bool, count: usize):
            count: mutable usize = 0
            for obligation in report.results.obligation_inventory |count, source_work|:
                return (false, count) if not proof_report_source_work_charge(1, source_work)
                count <- count + 1 if obligation.proven and obligation.source_kind == "frame"
            return (true, count)

        # Every successful accounting increment must have a corresponding proof attempt. This
        # prevents a report from keeping its `proven` counter while losing the checked root that
        # justifies that result; replay separately verifies each proven attempt's certificate.
        def proof_report_proven_attempts_consistent(report: ProofReport&, source_work: mutable usize&) -> bool:
            proven_attempts: mutable usize = 0
            expected_certificate: mutable usize = 0
            for attempt in report.results.goal_attempts |proven_attempts, expected_certificate, report, source_work|:
                return false if not proof_report_source_work_charge(1, source_work) or not proof_report_source_work_charge(sview_len(attempt.name), source_work) or not proof_report_source_work_charge(sview_len(attempt.rule), source_work)
                if attempt.producer_proven:
                    return false if:
                        not attempt.has_certificate or attempt.certificate_index != expected_certificate
                        expected_certificate >= report.analysis_1.certificates.count
                    certificate: ProofGoalCertificate = report.analysis_1.certificates[expected_certificate]
                    return false if:
                        not proof_report_source_work_charge(1, source_work)
                        not proof_report_source_work_charge(sview_len(certificate.name), source_work)
                        not proof_report_source_work_charge(sview_len(certificate.rule), source_work)
                        certificate.kernel_goal != attempt.kernel_goal or certificate.kernel_facts_start != attempt.kernel_facts_start or certificate.kernel_facts_count != attempt.kernel_facts_count
                        certificate.line != attempt.line or certificate.name != attempt.name or certificate.rule != attempt.rule
                    expected_certificate <- expected_certificate + 1
                    proven_attempts <- proven_attempts + 1
                else:
                    return false if attempt.has_certificate
            # Branch analysis may prove several execution paths for one source obligation.
            # The obligation inventory owns the source-level count; certificates own every
            # path-specific attempt, so attempts can outnumber proven obligations.
            frame_obligations: (complete: bool, count: usize) = proof_report_proven_frame_obligations(report, source_work)
            return false if not frame_obligations.complete or proven_attempts + frame_obligations.count < report.results.producer_proven_count.usize()
            return expected_certificate == report.analysis_1.certificates.count

        # Bounded Q0.8 coverage: body-level ensures are recounted from the retained AST and
        # each distinct source index must have at least one accounting event. Multiple return
        # paths may legitimately emit multiple events for the same index. Signature-only
        # contracts and other obligation families are deliberately outside this invariant.
        def proof_report_source_postcondition_inventory_consistent(report: ProofReport&) -> bool:
            source_work: mutable usize = 0
            proof_report_source_postcondition_inventory_consistent_with_work(report, &source_work)

        def proof_report_source_postcondition_inventory_consistent_with_work(report: ProofReport&, source_work: mutable usize&) -> bool:
            event_keys: mutable darray[ProofSourcePostconditionKey] = []
            frame_entry_indices: mutable darray[usize] = []
            for obligation_index in 0..<report.results.obligation_inventory.count |obligation_index, report, event_keys, frame_entry_indices, source_work|:
                return false if not proof_report_source_postcondition_work_charge(1, source_work)
                obligation: ProofObligationEntry = report.results.obligation_inventory[obligation_index]
                if obligation.source_kind == "postcondition":
                    return false if:
                        event_keys.count >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 4
                        not proof_report_source_postcondition_work_charge(sview_len(obligation.source_name), source_work)
                    event_keys.push(ProofSourcePostconditionKey{name: obligation.source_name, function_offset: obligation.source_function_offset, line: obligation.source_line, source_index: obligation.source_obligation_index})
                elif obligation.source_kind in {"changes", "preserves", "allow", "preserve"}:
                    frame_entry_indices.push(obligation_index)
                else:
                    return false if:
                        obligation.source_kind != "" and obligation.source_kind != "frame"
                        obligation.source_line != 0 or obligation.source_name != "" or obligation.source_function_offset != 0 or obligation.source_obligation_index != 0

            if frame_entry_indices.count > 0:
                frame_owner_keys: mutable darray[ProofSourcePostconditionKey] = []
                return false if not proof_report_frame_owner_keys_collect(report.source.source_declarations, &frame_owner_keys, source_work, 0)
                frame_owner_index: mutable ProofSourcePostconditionCountIndex = proof_report_source_postcondition_index_create(frame_owner_keys.count, source_work)
                return false if not frame_owner_index.valid
                for key in frame_owner_keys |frame_owner_index, source_work|:
                    return false if not proof_report_source_postcondition_index_add(&frame_owner_index, key, 1, false, source_work)
                for frame_entry_index in frame_entry_indices |frame_entry_index, report, frame_owner_index, source_work|:
                    return false if frame_entry_index >= report.results.obligation_inventory.count
                    frame_entry: ProofObligationEntry = report.results.obligation_inventory[frame_entry_index]
                    owner_key: ProofSourcePostconditionKey = ProofSourcePostconditionKey{name: frame_entry.source_name, function_offset: frame_entry.owner_function_offset, line: frame_entry.owner_function_line, source_index: 0}
                    owner: (complete: bool, found: bool, count: usize) = proof_report_source_postcondition_index_find(frame_owner_index, owner_key, source_work)
                    return false if not owner.complete or not owner.found or owner.count != 1
                    return false if not proof_report_frame_obligation_associated(report, frame_entry, source_work)

            return false if not proof_structural_signature_contract_table_valid(report.source_contracts.source_signature_contract_lines, report.source_contracts.source_signature_contract_kinds, report.source_contracts.source_signature_contracts, source_work)
            owner_keys: mutable darray[ProofSourcePostconditionKey] = []
            return false if not proof_report_source_postcondition_keys_collect(report.source.source_declarations, &owner_keys, source_work, 0)
            return false if not proof_report_signature_postcondition_keys_collect(report.source.source_declarations, report, &owner_keys, source_work, 0)
            owner_index: mutable ProofSourcePostconditionCountIndex = proof_report_source_postcondition_index_create(owner_keys.count, source_work)
            return false if not owner_index.valid
            for key in owner_keys |owner_index, source_work|:
                return false if not proof_report_source_postcondition_index_add(&owner_index, key, 1, false, source_work)

            event_index: mutable ProofSourcePostconditionCountIndex = proof_report_source_postcondition_index_create(event_keys.count, source_work)
            return false if not event_index.valid
            for key in event_keys |event_index, source_work|:
                return false if not proof_report_source_postcondition_index_add(&event_index, key, 1, false, source_work)
            for key in event_keys |owner_index, source_work|:
                owner: (complete: bool, found: bool, count: usize) = proof_report_source_postcondition_index_find(owner_index, key, source_work)
                return false if not owner.complete or not owner.found or owner.count != 1

            proof_report_source_postconditions_have_events_with_work(report.source.source_declarations, report, event_index, source_work, 0)

        # Focused source queries may return one checked goal while another declaration was
        # absent from the report. Their admission still depends on a structurally complete
        # source inventory and a consistent finding ledger, even when other goals remain open.
        # Return the first failed accounting boundary for diagnostics. The empty string means
        # these invariants hold, not that source checking succeeded.
        def proof_report_source_admission_failure(report: ProofReport&, has_open_goal: mutable bool&) -> sview:
            source_work: mutable usize = 0
            return "finding-count" if not proof_report_failure_count_consistent(report)
            finding_evidence_consistent: bool = proof_report_finding_evidence_consistent_with_work(report, &source_work)
            return "source-admission-work-limit" if source_work > proof_replay_summary_source_work_limit()
            return "finding-evidence" if not finding_evidence_consistent
            declarations_consistent: bool = proof_report_declaration_inventory_consistent(report, &source_work)
            return "source-admission-work-limit" if not declarations_consistent and source_work > proof_replay_summary_source_work_limit()
            return "declaration-inventory" if not declarations_consistent
            obligation_consistent: bool = proof_report_obligation_inventory_consistent(report, &source_work)
            return "source-admission-work-limit" if source_work > proof_replay_summary_source_work_limit()
            return "obligation-inventory" if not obligation_consistent
            attempts_bounded: bool = proof_report_goal_attempts_bounded_by_obligations(report, &source_work, true, has_open_goal)
            return "source-admission-work-limit" if source_work > proof_replay_summary_source_work_limit()
            return "goal-attempt-coverage" if not attempts_bounded
            postconditions_consistent: bool = proof_report_source_postcondition_inventory_consistent_with_work(report, &source_work)
            return "source-admission-work-limit" if source_work > proof_replay_summary_source_work_limit()
            return "postcondition-inventory" if not postconditions_consistent
            if report.context.focused_function != "":
                focused_covered: bool = proof_report_focused_source_obligations_covered_with_work(report, &source_work)
                return "source-admission-work-limit" if source_work > proof_replay_summary_source_work_limit()
                return "focused-source-obligations" if not focused_covered
            else:
                literal_status: (inventory: darray[(name: sview, function_offset: u32, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool)], complete: bool, work_limited: bool) = proof_source_literal_ensure_inventory_with_work(report.source.source_declarations, &source_work)
                return "source-admission-work-limit" if literal_status.work_limited or not literal_status.complete
                return "source-admission-work-limit" if source_work > proof_replay_summary_source_work_limit()
                literal_covered: bool = proof_source_literal_ensure_inventory_coverage_with_work(literal_status.inventory, report, true, &source_work)
                return "source-admission-work-limit" if source_work > proof_replay_summary_source_work_limit()
                return "source-literal-ensure-coverage" if not literal_covered
                assert_by_status: (inventory: darray[(name: sview, function_offset: u32, attempt_line: u32, goal_line: u32, goal_offset: u32, expected_value: bool, source_goal: Ast::Expr, supported: bool)], complete: bool, work_limited: bool) = proof_source_assert_by_inventory_with_work(report.source.source_declarations, &source_work)
                return "source-admission-work-limit" if assert_by_status.work_limited or not assert_by_status.complete
                return "source-admission-work-limit" if source_work > proof_replay_summary_source_work_limit()
                assert_by_covered: bool = proof_source_assert_by_coverage_inner(assert_by_status.inventory, report, true, &source_work)
                return "source-admission-work-limit" if source_work > proof_replay_summary_source_work_limit()
                return "source-assert-by-coverage" if not assert_by_covered
            proven_consistent: bool = proof_report_proven_attempts_consistent(report, &source_work)
            return "source-admission-work-limit" if source_work > proof_replay_summary_source_work_limit()
            return "proven-attempt-certificates" if not proven_consistent
            return ""

    private:
        # Global accounting and declaration structure protect every local query. Whole-source
        # coverage is intentionally kept out of this predicate so an unrelated open claim does
        # not suppress a separately source-bound goal.
        def proof_report_source_structure_consistent(report: ProofReport&, source_work: mutable usize&) -> bool:
            has_open_goal: mutable bool = false
            return false if:
                not proof_report_failure_count_consistent(report)
                not proof_report_finding_evidence_consistent_with_work(report, source_work)
                not proof_report_declaration_inventory_consistent(report, source_work)
                not proof_report_obligation_inventory_consistent(report, source_work)
                not proof_report_goal_attempts_bounded_by_obligations(report, source_work, false, &has_open_goal)
            return proof_report_proven_attempts_consistent(report, source_work)

        def proof_report_source_literal_ensure_goal_attempt_admitted(expected: (name: sview, function_offset: u32, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool), report: ProofReport&, goal_id: usize, source_work: mutable usize&) -> bool:
            return false if goal_id >= report.results.goal_attempts.count or expected.name == "" or expected.contract_line == 0
            attempt: ProofGoalAttempt = report.results.goal_attempts[goal_id]
            return false if:
                not proof_report_source_work_charge(sview_len(expected.name), source_work)
                not proof_report_source_work_charge(sview_len(attempt.name), source_work)
                not proof_report_source_work_charge(sview_len(attempt.rule), source_work)
                attempt.name != expected.name or attempt.rule != "goal" or not proof_source_literal_ensure_goal_matches(attempt.goal, expected, source_work)
                attempt.has_certificate != attempt.producer_proven
            if attempt.producer_proven:
                return false if attempt.certificate_index >= report.analysis_1.certificates.count
                certificate: ProofGoalCertificate = report.analysis_1.certificates[attempt.certificate_index]
                return false if:
                    not proof_report_source_work_charge(sview_len(certificate.name), source_work)
                    not proof_report_source_work_charge(sview_len(certificate.rule), source_work)
                return certificate.name == expected.name and certificate.line == attempt.line and certificate.rule == attempt.rule and proof_source_literal_ensure_goal_matches(certificate.goal, expected, source_work)
            return true

        def proof_report_obligation_event_for_goal(report: ProofReport&, goal_id: usize, source_work: mutable usize&) -> (found: bool, entry: ProofObligationEntry):
            low: mutable usize = 0
            high: mutable usize = report.results.obligation_inventory.count
            empty: ProofObligationEntry = ProofObligationEntry{identity: 0, attempts_start: 0, attempts_count: 0, proven: false, source_line: 0, source_name: "", source_kind: "", source_function_offset: 0, source_obligation_index: 0, owner_function_line: 0, owner_function_offset: 0}
            while low < high |low, high, report, goal_id, source_work|:
                return (false, empty) if not proof_report_source_work_charge(1, source_work)
                middle: usize = low + (high - low) / 2
                entry: ProofObligationEntry = report.results.obligation_inventory[middle]
                if goal_id < entry.attempts_start:
                    high <- middle
                else:
                    attempt_offset: usize = goal_id - entry.attempts_start
                    if attempt_offset < entry.attempts_count:
                        return (true, entry)
                    low <- middle + 1
            (false, empty)

    public:
        def proof_source_parameter_name_count_with_work(parameters: darray[Ast::ParamDecl]&, name: sview, source_work: mutable usize&) -> (complete: bool, count: usize):
            return (false, 0) if not proof_report_source_work_charge(sview_len(name), source_work)
            count: mutable usize = 0
            for parameter in parameters |count, name, source_work|:
                return (false, count) if:
                    not proof_report_source_work_charge(1, source_work)
                    not proof_report_source_work_charge(sview_len(parameter.name), source_work)
                    not proof_report_source_work_charge(sview_len(name), source_work)
                count <- count + 1 if parameter.name == name
            (true, count)

        # Compatibility exact-count helper. New admission code should use the work-aware form so
        # an exhausted scan cannot be mistaken for a complete parameter multiplicity.
        def proof_source_parameter_name_count(parameters: darray[Ast::ParamDecl]&, name: sview) -> usize:
            count: mutable usize = 0
            for parameter in parameters |count, name|:
                count <- count + 1 if parameter.name == name
            return count

        # Independent source inventory slice (R-004): unique top-level functions with leading
        # requires clauses, one ensure/ensures, and one integer literal or declared-parameter
        # return. Store the substituted equality proposition even when it is false; dropping a
        # mismatched return would hide an obligation instead of recording the source claim.
        def proof_source_literal_ensure_candidate(declaration: Ast::Decl) -> (known: bool, name: sview, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool):
            source_work: mutable usize = 0
            complete: mutable bool = true
            proof_source_literal_ensure_candidate_with_work(declaration, &source_work, &complete)

    private:
    public:
        # Legacy report diagnostic: this checks aggregate report invariants and producer-marked
        # obligation closure only. It does not carry a replay receipt or parser-origin source
        # capability, so false is not a source-admission verdict. Source-positive status belongs
        # to ProofCheckedView after source validation and independent replay.
        def proof_report_source_has_unresolved_checks(report: ProofReport&, import_failed: bool, semantic_errors: u32) -> bool:
            has_open_goal: mutable bool = false
            return true if proof_report_source_admission_failure(report, &has_open_goal) != ""
            return true if import_failed or semantic_errors > 0 or report.results.failed > 0
            return true if not proof_report_all_obligations_proven(report) or has_open_goal
            return false

include "./report_focused_source_ensures.elisa"
