# Derived invariants shared by report rendering, CLI admission, and adversarial tests.
include "./report_assert_by_inventory.elisa"
extend ElisaProof:
    private:
        const PROOF_SOURCE_ASSERT_BY_AST_DEPTH_LIMIT: usize = 64

        def proof_report_declaration_function_kind_matches(report: ProofReport&, summary: ProofDeclarationSummary) -> bool:
            for theorem in report.theorems.summaries:
                return summary.kind == "lemma" if theorem.name == summary.name and theorem.line == summary.line
            return summary.kind == "function"

        def proof_report_declaration_matches_source(declaration: Ast::Decl, summary: ProofDeclarationSummary, report: ProofReport&) -> bool:
            match declaration:
                Ast::Decl.Func(name, _, _, _, _, _, position):
                    return summary.name == name and summary.line == position.line and proof_report_declaration_function_kind_matches(report, summary)
                Ast::Decl.Struct(name, _, _, _, _, _, position):
                    return summary.kind == "struct" and summary.name == name and summary.line == position.line
                Ast::Decl.Enum(name, _, _, _, position):
                    return summary.kind == "enum" and summary.name == name and summary.line == position.line
                Ast::Decl.Alias(name, _, position):
                    return summary.kind == "alias" and summary.name == name and summary.line == position.line
                Ast::Decl.Law(name, _, position):
                    return summary.kind == "law" and summary.name == name and summary.line == position.line
                Ast::Decl.Import(name, position):
                    return summary.kind == "import" and summary.name == name and summary.line == position.line
                Ast::Decl.Scoped(_, position):
                    return summary.kind == "scope" and summary.name == "" and summary.line == position.line
                Ast::Decl.Extern(name, _, _, _, _, _, _, position):
                    return summary.kind == "extern" and summary.name == name and summary.line == position.line
                Ast::Decl.Const(name, _, _, _, position):
                    return summary.kind == "const" and summary.name == name and summary.line == position.line
                Ast::Decl.Module(name, _, position):
                    return summary.kind == "module" and summary.name == name and summary.line == position.line
                Ast::Decl.Invalid:
                    return summary.kind == "invalid" and summary.name == "" and summary.line == 0
                _:
                    return false

        def proof_report_declaration_sequence_matches_source(declarations: darray[Ast::Decl]&, report: ProofReport&, cursor: mutable usize&) -> bool:
            for declaration in declarations |report, cursor|:
                return false if cursor >= report.declaration_details.count
                return false if not proof_report_declaration_matches_source(declaration, report.declaration_details[cursor], report)
                cursor <- cursor + 1
                match declaration:
                    Ast::Decl.Module(_, nested, _):
                        return false if not proof_report_declaration_sequence_matches_source(nested, report, cursor)
                    Ast::Decl.Scoped(nested, _):
                        return false if not proof_report_declaration_sequence_matches_source(nested, report, cursor)
                    _:
                        pass
            return true

    public:
        # Completion requires every counted obligation to have a proven result. This independent
        # counter invariant catches checker paths that accidentally omit both an open attempt and
        # a failure finding.
        def proof_report_all_obligations_proven(report: ProofReport&) -> bool:
            return report.proven == report.obligations

        # Every finding is inserted through proof_add_finding, which increments the failure
        # counter in the same transaction. Treat disagreement as an invalid report, not success.
        def proof_report_failure_count_consistent(report: ProofReport&) -> bool:
            return report.findings.count == report.failed.usize()

        # The declaration schedule increments `declarations` and emits one summary for every
        # AST declaration (including nested module/scope declarations). A count mismatch means
        # the report lost part of its admission inventory, even if its remaining obligations
        # and certificates happen to replay.
        def proof_report_declaration_inventory_consistent(report: ProofReport&) -> bool:
            return false if report.declarations.usize() != report.declaration_details.count
            cursor: mutable usize = 0
            return false if not proof_report_declaration_sequence_matches_source(report.source_declarations, report, &cursor)
            return cursor == report.declaration_details.count

        # Keep the result row for each source-check accounting event separate from its aggregate
        # totals and goal-attempt rows. Some unsupported obligations intentionally have no goal
        # attempt; the ledger preserves them and prevents deleting an attempt plus both totals.
        def proof_report_obligation_inventory_consistent(report: ProofReport&) -> bool:
            return false if report.obligation_inventory.count != report.obligations.usize()
            proven_obligations: mutable usize = 0
            identity: mutable usize = 0
            for obligation in report.obligation_inventory |proven_obligations, identity|:
                return false if obligation.identity != identity
                identity <- identity + 1
                proven_obligations <- proven_obligations + 1 if obligation.proven
            return proven_obligations == report.proven.usize()

        # A source contract can create several path-specific goal attempts when a body has
        # multiple returns. Therefore the attempt count may exceed the source obligation count.
        # Proven attempts still have exact sequential certificate accounting below, and the
        # obligation inventory independently binds the aggregate source count and proven count.
        def proof_report_goal_attempts_bounded_by_obligations(report: ProofReport&) -> bool:
            return report.proven.usize() <= report.obligations.usize() and report.goal_attempts.count + proof_report_proven_frame_obligations(report) >= report.proven.usize()

        # Proven frame-check rows: accounted obligations that by construction have no attempt.
        def proof_report_proven_frame_obligations(report: ProofReport&) -> usize:
            count: mutable usize = 0
            for obligation in report.obligation_inventory |count|:
                count <- count + 1 if obligation.proven and obligation.source_kind == "frame"
            return count

        # Every successful accounting increment must have a corresponding proof attempt. This
        # prevents a report from keeping its `proven` counter while losing the checked root that
        # justifies that result; replay separately verifies each proven attempt's certificate.
        def proof_report_proven_attempts_consistent(report: ProofReport&) -> bool:
            proven_attempts: mutable usize = 0
            expected_certificate: mutable usize = 0
            for attempt in report.goal_attempts |proven_attempts, expected_certificate, report|:
                if attempt.proven:
                    return false if not attempt.has_certificate or attempt.certificate_index != expected_certificate
                    return false if expected_certificate >= report.certificates.count
                    certificate: ProofGoalCertificate = report.certificates[expected_certificate]
                    return false if certificate.kernel_goal != attempt.kernel_goal or certificate.kernel_facts_start != attempt.kernel_facts_start or certificate.kernel_facts_count != attempt.kernel_facts_count
                    return false if certificate.line != attempt.line or certificate.name != attempt.name or certificate.rule != attempt.rule
                    expected_certificate <- expected_certificate + 1
                    proven_attempts <- proven_attempts + 1
                else:
                    return false if attempt.has_certificate
            # Branch analysis may prove several execution paths for one source obligation.
            # The obligation inventory owns the source-level count; certificates own every
            # path-specific attempt, so attempts can outnumber proven obligations.
            return false if proven_attempts + proof_report_proven_frame_obligations(report) < report.proven.usize()
            return expected_certificate == report.certificates.count

        def proof_report_body_postcondition_count(body: darray[Ast::Stmt]&) -> usize:
            count: mutable usize = 0
            for statement in body |count|:
                match statement:
                    Ast::Stmt.Contract(kind, _, _):
                        count <- count + 1 if kind == "ensure" or kind == "ensures"
                    _:
                        pass
            return count

        def proof_report_source_postcondition_owner_count(declarations: darray[Ast::Decl]&, name: sview, line: u32, source_index: usize) -> usize:
            count: mutable usize = 0
            for declaration in declarations |name, line, source_index, count|:
                match declaration:
                    Ast::Decl.Func(candidate, _, _, body, _, _, position):
                        count <- count + 1 if candidate == name and position.line == line and source_index < proof_report_body_postcondition_count(body)
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        count <- count + proof_report_source_postcondition_owner_count(nested, name, line, source_index)
                    _:
                        pass
            return count

        def proof_report_source_function_is_scheduled(report: ProofReport&, name: sview, line: u32) -> bool:
            return true if report.focused_function == ""
            return true if report.focused_function == name
            for summary in report.declaration_details |name, line, report|:
                return summary.verification_reason != "not-requested" if summary.name == name and summary.line == line
            return false

        def proof_report_source_postconditions_have_events(declarations: darray[Ast::Decl]&, report: ProofReport&) -> bool:
            for declaration in declarations |report|:
                match declaration:
                    Ast::Decl.Func(name, _, _, body, _, _, position):
                        expected: usize = proof_report_body_postcondition_count(body)
                        if proof_report_source_function_is_scheduled(report, name, position.line):
                            for source_index in 0..<expected |source_index, report, name, position|:
                                found: mutable bool = false
                                for obligation in report.obligation_inventory |source_index, name, position, found|:
                                    found <- true if obligation.source_kind == "postcondition" and obligation.source_name == name and obligation.source_line == position.line and obligation.source_obligation_index == source_index
                                return false if not found
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        return false if not proof_report_source_postconditions_have_events(nested, report)
                    _:
                        pass
            return true

        # Bounded Q0.8 coverage: body-level ensures are recounted from the retained AST and
        # each distinct source index must have at least one accounting event. Multiple return
        # paths may legitimately emit multiple events for the same index. Signature-only
        # contracts and other obligation families are deliberately outside this invariant.
        def proof_report_source_postcondition_inventory_consistent(report: ProofReport&) -> bool:
            for obligation in report.obligation_inventory:
                if obligation.source_kind == "postcondition":
                    return false if proof_report_source_postcondition_owner_count(report.source_declarations, obligation.source_name, obligation.source_line, obligation.source_obligation_index) != 1
                else:
                    return false if obligation.source_kind != "" and obligation.source_kind != "frame"
                    return false if obligation.source_line != 0 or obligation.source_name != "" or obligation.source_obligation_index != 0
            return proof_report_source_postconditions_have_events(report.source_declarations, report)

        # Focused source queries may return one checked goal while another declaration was
        # absent from the report. Their admission still depends on a structurally complete
        # source inventory and a consistent finding ledger, even when other goals remain open.
        def proof_report_source_admission_invariants_consistent(report: ProofReport&) -> bool:
            return false if not proof_report_failure_count_consistent(report)
            return false if not proof_report_declaration_inventory_consistent(report)
            return false if not proof_report_obligation_inventory_consistent(report)
            return false if not proof_report_goal_attempts_bounded_by_obligations(report)
            return false if not proof_report_source_postcondition_inventory_consistent(report)
            if report.focused_function != "":
                return false if not proof_report_focused_source_obligations_covered(report)
            else:
                source_literal_ensures: darray[(name: sview, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool)] = proof_source_literal_ensure_inventory(report.source_declarations)
                return false if not proof_source_literal_ensure_coverage(source_literal_ensures, report)
            return proof_report_proven_attempts_consistent(report)

        def proof_source_parameter_name_count(parameters: darray[Ast::ParamDecl]&, name: sview) -> usize:
            count: mutable usize = 0
            for parameter in parameters |count, name|:
                count <- count + 1 if parameter.name == name
            return count

        # Independent source inventory slice (R-004): unique top-level functions with leading
        # requires clauses, one ensure/ensures, and one integer literal or declared-parameter
        # return. Store the substituted equality proposition even when it is false; dropping a
        # mismatched return would hide an obligation instead of recording the source claim.
        def proof_source_literal_ensure_candidate(declaration: Ast::Decl) -> (known: bool, name: sview, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool):
            match declaration:
                Ast::Decl.Func(name, parameters, _, body, _, _, _):
                    return (false, "", 0, 0, 0, "", false, false) if body.count < 2
                    has_ensure: mutable bool = false
                    has_return: mutable bool = false
                    contract_value: mutable i64 = 0
                    returned_value: mutable i64 = 0
                    returned_parameter: mutable sview = ""
                    result_on_left: mutable bool = false
                    contract_line: mutable u32 = 0
                    equality_postcondition: mutable bool = false
                    for statement in body |has_ensure, has_return, contract_value, returned_value, returned_parameter, result_on_left, contract_line, equality_postcondition|:
                        match statement:
                            Ast::Stmt.Contract(kind, expression, position):
                                if kind == "requires":
                                    return (false, "", 0, 0, 0, "", false, false) if has_ensure or has_return
                                    pass
                                else:
                                    return (false, "", 0, 0, 0, "", false, false) if (kind != "ensure" and kind != "ensures") or has_ensure or has_return
                                    match expression:
                                        Ast::Expr.BoolLit(value, _):
                                            return (false, "", 0, 0, 0, "", false, false) if not value
                                        Ast::Expr.Binary(Ast::Expr.Ident("result", _), TokenKind.EqEq, Ast::Expr.IntLit(expected, _), _):
                                            equality_postcondition <- true
                                            result_on_left <- true
                                            contract_value <- expected
                                        Ast::Expr.Binary(Ast::Expr.IntLit(expected, _), TokenKind.EqEq, Ast::Expr.Ident("result", _), _):
                                            equality_postcondition <- true
                                            contract_value <- expected
                                        _:
                                            return (false, "", 0, 0, 0, "", false, false)
                                    contract_line <- position.line
                                    has_ensure <- true
                            Ast::Stmt.Return(value, _):
                                return (false, "", 0, 0, 0, "", false, false) if has_return
                                match value:
                                    Ast::Expr.IntLit(returned, _):
                                        has_return <- true
                                        returned_value <- returned
                                    Ast::Expr.Ident(returned, _):
                                        return (false, "", 0, 0, 0, "", false, false) if proof_source_parameter_name_count(parameters, returned) != 1
                                        has_return <- true
                                        returned_parameter <- returned
                                    _:
                                        return (false, "", 0, 0, 0, "", false, false)
                            _:
                                return (false, "", 0, 0, 0, "", false, false)
                    return (has_ensure and has_return, name, contract_line, contract_value, returned_value, returned_parameter, result_on_left, equality_postcondition)
                _:
                    return (false, "", 0, 0, 0, "", false, false)

        def proof_source_literal_ensure_count(declarations: darray[Ast::Decl]&, name: sview) -> usize:
            count: mutable usize = 0
            for declaration in declarations |count, name|:
                match declaration:
                    Ast::Decl.Func(candidate, _, _, _, _, _, _):
                        count <- count + 1 if candidate == name
                    Ast::Decl.Module(_, nested, _):
                        count <- count + proof_source_literal_ensure_count(nested, name)
                    Ast::Decl.Scoped(nested, _):
                        count <- count + proof_source_literal_ensure_count(nested, name)
                    _:
                        pass
            return count

        def proof_source_literal_ensure_collect(declarations: darray[Ast::Decl]&, scope_supported: bool, inventory: mutable darray[(name: sview, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool)]&) -> void:
            for declaration in declarations |scope_supported, inventory|:
                match declaration:
                    Ast::Decl.Func(_, _, _, _, _, _, _):
                        candidate: (known: bool, name: sview, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool) = proof_source_literal_ensure_candidate(declaration)
                        if candidate.known:
                            # Nested functions are found, but bare-name attempt identities do not
                            # authenticate their namespace. Preserve a refusal marker instead of
                            # omitting them from the independent source inventory.
                            unique_name: bool = proof_source_literal_ensure_count(declarations, candidate.name) == 1
                            inventory.push((candidate.name, candidate.contract_line, candidate.contract_value, candidate.returned_value, candidate.returned_parameter, candidate.result_on_left, candidate.equality_postcondition) if scope_supported and unique_name else ("", 0, 0, 0, "", false, false))
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        proof_source_literal_ensure_collect(nested, false, inventory)
                    _:
                        pass

        def proof_source_literal_ensure_inventory(declarations: darray[Ast::Decl]&) -> darray[(name: sview, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool)]:
            inventory: mutable darray[(name: sview, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool)] = []
            proof_source_literal_ensure_collect(declarations, true, inventory)
            return inventory

        # Check the claim stored on either a goal attempt or its certificate against the
        # source-derived postcondition. Checking both matters: a mutable attempt display goal
        # must not relabel a certificate for a different proposition as the source proof.
        def proof_source_literal_ensure_goal_matches(goal: Ast::Expr, expected: (name: sview, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool)) -> bool:
            match goal:
                Ast::Expr.BoolLit(value, position):
                    return value and not expected.equality_postcondition and position.line == expected.contract_line
                Ast::Expr.Binary(Ast::Expr.IntLit(left, left_position), TokenKind.EqEq, Ast::Expr.IntLit(right, right_position), _):
                    expected_left: mutable i64 = expected.contract_value
                    expected_right: mutable i64 = expected.returned_value
                    if expected.result_on_left:
                        expected_left <- expected.returned_value
                        expected_right <- expected.contract_value
                    return expected.equality_postcondition and expected.returned_parameter == "" and left == expected_left and right == expected_right and (left_position.line == expected.contract_line or right_position.line == expected.contract_line)
                Ast::Expr.Binary(Ast::Expr.Ident(left, left_position), TokenKind.EqEq, Ast::Expr.IntLit(right, right_position), _):
                    return expected.equality_postcondition and expected.returned_parameter != "" and expected.result_on_left and left == expected.returned_parameter and right == expected.contract_value and right_position.line == expected.contract_line
                Ast::Expr.Binary(Ast::Expr.IntLit(left, left_position), TokenKind.EqEq, Ast::Expr.Ident(right, right_position), _):
                    return expected.equality_postcondition and expected.returned_parameter != "" and not expected.result_on_left and left == expected.contract_value and right == expected.returned_parameter and left_position.line == expected.contract_line
                _:
                    return false

        def proof_source_literal_ensure_expected_coverage_with_replay(expected: (name: sview, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool), report: ProofReport&, require_replayed: bool) -> bool:
            return false if expected.name == ""
            matching: mutable usize = 0
            for attempt in report.goal_attempts |expected, matching, report|:
                if attempt.name == expected.name and attempt.rule == "goal" and proof_source_literal_ensure_goal_matches(attempt.goal, expected):
                    if attempt.proven and attempt.has_certificate and attempt.certificate_index < report.certificates.count:
                        certificate: ProofGoalCertificate = report.certificates[attempt.certificate_index]
                        matching <- matching + 1 if (not require_replayed or certificate.replayed) and proof_source_literal_ensure_goal_matches(certificate.goal, expected)
                    else:
                        matching <- matching + 1 if not attempt.proven and not attempt.has_certificate
            return matching == 1

        def proof_source_literal_ensure_expected_coverage(expected: (name: sview, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool), report: ProofReport&) -> bool:
            return proof_source_literal_ensure_expected_coverage_with_replay(expected, report, true)

        # Direct checking APIs bind the generated attempt and certificate before returning.
        # Replay remains a separate public operation, so this pre-return gate checks identity
        # without pretending that an unreplayed certificate is trusted.
        def proof_source_literal_ensure_expected_binding(expected: (name: sview, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool), report: ProofReport&) -> bool:
            return proof_source_literal_ensure_expected_coverage_with_replay(expected, report, false)

        def proof_source_literal_ensure_coverage(inventory: darray[(name: sview, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool)]&, report: ProofReport&) -> bool:
            for expected in inventory |report|:
                return false if not proof_source_literal_ensure_expected_coverage(expected, report)
            return true

        def proof_source_literal_ensure_binding_coverage(inventory: darray[(name: sview, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool)]&, report: ProofReport&) -> bool:
            for expected in inventory |report|:
                return false if not proof_source_literal_ensure_expected_binding(expected, report)
            return true

        def proof_report_focused_source_literal_ensure_coverage_walk(declarations: darray[Ast::Decl]&, scope_supported: bool, report: ProofReport&, require_replayed: bool) -> bool:
            for declaration in declarations |scope_supported, report|:
                match declaration:
                    Ast::Decl.Func(name, _, _, body, _, _, position):
                        if proof_report_source_function_is_scheduled(report, name, position.line) and proof_report_body_postcondition_count(body) > 0:
                            candidate: (known: bool, name: sview, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool) = proof_source_literal_ensure_candidate(declaration)
                            return false if not candidate.known or not scope_supported
                            return false if proof_source_literal_ensure_count(report.source_declarations, candidate.name) != 1
                            expected: (name: sview, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool) = (candidate.name, candidate.contract_line, candidate.contract_value, candidate.returned_value, candidate.returned_parameter, candidate.result_on_left, candidate.equality_postcondition)
                            return false if not proof_source_literal_ensure_expected_coverage_with_replay(expected, report, require_replayed)
                    Ast::Decl.Module(_, nested, _) | Ast::Decl.Scoped(nested, _):
                        return false if not proof_report_focused_source_literal_ensure_coverage_walk(nested, false, report, require_replayed)
                    _:
                        pass
            return true

        def proof_report_focused_source_literal_ensures_consistent(report: ProofReport&) -> bool:
            return proof_report_focused_source_literal_ensure_coverage_walk(report.source_declarations, true, report, true)

        def proof_report_focused_source_literal_ensures_bound(report: ProofReport&) -> bool:
            return proof_report_focused_source_literal_ensure_coverage_walk(report.source_declarations, true, report, false)

        def proof_report_focused_source_obligations_covered(report: ProofReport&) -> bool:
            return false if report.focused_function == ""
            return false if not proof_report_focused_source_literal_ensures_consistent(report)
            return proof_source_assert_by_focused_coverage(report)

        def proof_source_literal_ensure_inventory_has_unsupported(inventory: darray[(name: sview, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool)]&) -> bool:
            for expected in inventory:
                return true if expected.name == ""
            return false

    public:
        def proof_report_has_open_goals(report: ProofReport&) -> bool:
            for attempt in report.goal_attempts:
                return true if not attempt.proven
            return false

        # A source summary cannot be complete if import/semantic checking failed, a proof
        # obligation failed or remains open, or the aggregate obligation counters disagree.
        # Keep this independent predicate shared by the CLI and machine-readable renderers.
        def proof_report_source_has_unresolved_checks(report: ProofReport&, import_failed: bool, semantic_errors: u32) -> bool:
            return true if not proof_report_source_admission_invariants_consistent(report)
            return true if import_failed or semantic_errors > 0 or report.failed > 0
            return true if not proof_report_all_obligations_proven(report) or proof_report_has_open_goals(report)
            return false
