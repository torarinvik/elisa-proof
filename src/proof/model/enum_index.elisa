# Compact per-import enum index for scalar-type classification and structural termination discovery.
extend ElisaProof:
    public:
        struct ProofEnumIndex:
            names: mutable darray[sview]
            name_hashes: mutable darray[u32]
            const_enums: mutable darray[bool]
            declarations: mutable darray[Ast::Decl]
            root_level: mutable darray[bool]
            bucket_heads: mutable darray[usize]
            next_indices: mutable darray[usize]
            complete: mutable bool
