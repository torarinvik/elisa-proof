# Bounded source and target metadata readers for imported proof scripts.
extend ElisaProof:
    public:
        def proof_tactic_json_source_fingerprint[@r](root: JsonValueHandle[r]) -> (present: bool, valid: bool, value: u32):
            work_used: mutable usize = 0
            return proof_tactic_json_source_fingerprint_with_work(root, &work_used)

        def proof_tactic_json_source_fingerprint_with_work[@r](root: JsonValueHandle[r], work_used: mutable usize&) -> (present: bool, valid: bool, value: u32):
            field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(root, "source_fingerprint", work_used)
            return (false, false, 0) if work_used > PROOF_JSON_EXPRESSION_WORK_LIMIT
            return (false, true, 0) if not field.known
            parsed: (known: bool, value: i64) = proof_tactic_json_integer(field.value)
            return (true, parsed.known and parsed.value >= 0 and parsed.value <= ElisaProofKernelCore::PROOF_KERNEL_U32_MAX, parsed.value.u32())

        def proof_tactic_json_target[@r](root: JsonValueHandle[r]) -> (present: bool, valid: bool, goal_id: usize):
            work_used: mutable usize = 0
            return proof_tactic_json_target_with_work(root, &work_used)

        def proof_tactic_json_target_with_work[@r](root: JsonValueHandle[r], work_used: mutable usize&) -> (present: bool, valid: bool, goal_id: usize):
            field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(root, "target", work_used)
            return (false, false, 0) if work_used > PROOF_JSON_EXPRESSION_WORK_LIMIT
            return (false, true, 0) if not field.known
            goal_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(field.value, "goal_id", work_used)
            return (false, false, 0) if work_used > PROOF_JSON_EXPRESSION_WORK_LIMIT
            parsed: (known: bool, value: i64) = proof_tactic_json_integer(goal_field.value)
            return (true, parsed.known and parsed.value >= 0, parsed.value.usize())

        def proof_tactic_json_target_fingerprint[@r](root: JsonValueHandle[r]) -> (present: bool, valid: bool, value: u32):
            work_used: mutable usize = 0
            return proof_tactic_json_target_fingerprint_with_work(root, &work_used)

        def proof_tactic_json_target_fingerprint_with_work[@r](root: JsonValueHandle[r], work_used: mutable usize&) -> (present: bool, valid: bool, value: u32):
            target_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(root, "target", work_used)
            return (false, false, 0) if work_used > PROOF_JSON_EXPRESSION_WORK_LIMIT
            return (false, true, 0) if not target_field.known
            fingerprint_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(target_field.value, "goal_fingerprint", work_used)
            return (false, false, 0) if work_used > PROOF_JSON_EXPRESSION_WORK_LIMIT
            return (false, true, 0) if not fingerprint_field.known
            parsed: (known: bool, value: i64) = proof_tactic_json_integer(fingerprint_field.value)
            return (true, parsed.known and parsed.value >= 0 and parsed.value <= ElisaProofKernelCore::PROOF_KERNEL_U32_MAX, parsed.value.u32())
