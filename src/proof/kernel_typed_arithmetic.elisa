# Closed typed expression evaluation is independent of the compiler AST and
# interval solver. Both depth and total work are bounded, including shared DAGs.
extend ElisaProofKernelCore:
    private:
        const TYPED_CONSTANT_WORK_BUDGET: usize = 4096

        def typed_constant_expression_remaining(nodes: darray[ProofKernelNode]&, root: usize, depth: usize, work: mutable usize&) -> (known: bool, node: ProofKernelNode):
            requires depth <= PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            decreases PROOF_KERNEL_REPLAY_DEPTH_LIMIT - depth
            empty: ProofKernelNode = ProofKernelNode{kind: "unsupported", operator: "", left: 0, right: 0, auxiliary: 0, children_start: 0, children_count: 0, value: 0, name: "", secondary_name: ""}
            return (false, empty) if depth >= PROOF_KERNEL_REPLAY_DEPTH_LIMIT or work == 0 or root >= nodes.count
            work <- work - 1
            node: ProofKernelNode = nodes[root]
            return (typed_literal_value(node).known, node) if node.kind == "typed-int"
            return (false, empty) if node.kind != "binary" or (node.operator != "+" and node.operator != "-")
            return (false, empty) if node.auxiliary != 0 or node.children_start != 0 or node.children_count != 0 or node.value != 0 or node.name != "" or node.secondary_name != ""
            left = typed_constant_expression_remaining(nodes, node.left, depth + 1, work)
            return (false, empty) if not left.known
            right = typed_constant_expression_remaining(nodes, node.right, depth + 1, work)
            return (false, empty) if not right.known
            value = typed_unsigned_add_sub(left.node, node.operator, right.node)
            return (false, empty) if not value.known
            result: ProofKernelNode = ProofKernelNode{kind: "typed-int", operator: "", left: 0, right: 0, auxiliary: 0, children_start: 0, children_count: 0, value: value.bits.i64(), name: left.node.name, secondary_name: ""}
            return (true, result)

    public:
        def typed_constant_expression_comparison(nodes: darray[ProofKernelNode]&, left: usize, operator: sview, right: usize) -> (known: bool, value: bool):
            work: mutable usize = TYPED_CONSTANT_WORK_BUDGET
            a = typed_constant_expression_remaining(nodes, left, 0, &work)
            return (false, false) if not a.known
            b = typed_constant_expression_remaining(nodes, right, 0, &work)
            return (false, false) if not b.known
            return typed_literal_comparison(a.node, operator, b.node)
