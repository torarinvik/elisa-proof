const PROOF_NORMAL_TERM_LIMIT: usize = 64

extend ElisaProof:
    public:
        # One signed occurrence in a sum of names and literals. An empty name is a constant, so
        # the collector needs no scalar accumulator: every occurrence is pushed, and the sums are
        # formed once the whole comparison has been read.
        struct ProofNormalTerm:
            name: sview
            coefficient: i64

        # Read `expression` as a sum of signed names and literals, pushing each occurrence with
        # `sign`. Only `+`, `-`, their unary forms and parentheses are admitted, and every
        # operator node must carry an integer width. That width is what the goal's wrap guard
        # decides each operation under, so no admitted operation is left unchecked, and a node
        # made of literals alone -- whose type the source leaves to inference -- is declined.
        def proof_collect_normal_terms(expression: Ast::Expr, sign: i64, signed: bool, facts: darray[Ast::Expr]&, terms: mutable darray[ProofNormalTerm]&, depth: usize) -> bool:
            return false if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT or terms.count >= PROOF_NORMAL_TERM_LIMIT
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_collect_normal_terms(inner, sign, signed, facts, terms, depth + 1)
                Ast::Expr.IntLit(value, _):
                    return false if value < 0
                    terms.push(ProofNormalTerm{name: "", coefficient: value if sign > 0 else 0 - value})
                    return true
                Ast::Expr.Ident(name, _):
                    return false if name == "" or not proof_normal_term_has_width(expression, facts)
                    terms.push(ProofNormalTerm{name: name, coefficient: sign})
                    return true
                Ast::Expr.Unary(operator, operand, _):
                    return false if operator != TokenKind.Plus and operator != TokenKind.Minus
                    negated: (known: bool, value: i64) = proof_signed_negated_literal(expression, signed)
                    if negated.known:
                        terms.push(ProofNormalTerm{name: "", coefficient: negated.value if sign > 0 else 0 - negated.value})
                        return true
                    return false if not proof_normal_term_has_width(expression, facts)
                    return proof_collect_normal_terms(operand, sign if operator == TokenKind.Plus else 0 - sign, signed, facts, terms, depth + 1)
                Ast::Expr.Binary(left, operator, right, _):
                    return false if:
                        operator != TokenKind.Plus and operator != TokenKind.Minus
                        not proof_normal_term_has_width(expression, facts)
                        not proof_collect_normal_terms(left, sign, signed, facts, terms, depth + 1)
                    return proof_collect_normal_terms(right, sign if operator == TokenKind.Plus else 0 - sign, signed, facts, terms, depth + 1)
                _:
                    return false

        # Certificate production already builds this witness index once. Use indexed width
        # lookup while normalizing candidate rows instead of rescanning every fact at each AST
        # node. An incomplete indexed lookup rejects the candidate rather than treating an
        # unknown width as absent.
        def proof_normal_term_has_width_with_witnesses(expression: Ast::Expr, markers: ProofScalarWitnesses&) -> (complete: bool, has_width: bool):
            work: mutable usize = 0
            exhausted: mutable bool = false
            signed_width: i64 = proof_signed_width_in_expression_with_work(expression, markers, 0, &work, &exhausted)
            return (false, false) if exhausted
            return (true, true) if signed_width != 0
            unsigned_width: i64 = proof_unsigned_width_in_expression_with_work(expression, markers, &work, &exhausted)
            return (false, false) if exhausted
            return (true, unsigned_width != 0)

        def proof_normal_comparison_signed_with_witnesses(left: Ast::Expr, right: Ast::Expr, markers: ProofScalarWitnesses&) -> (complete: bool, signed: bool):
            work: mutable usize = 0
            exhausted: mutable bool = false
            left_width: i64 = proof_signed_width_in_expression_with_work(left, markers, 0, &work, &exhausted)
            return (false, false) if exhausted
            return (true, true) if left_width != 0
            right_width: i64 = proof_signed_width_in_expression_with_work(right, markers, 0, &work, &exhausted)
            return (false, false) if exhausted
            return (true, right_width != 0)

        def proof_collect_normal_terms_with_witnesses(expression: Ast::Expr, sign: i64, signed: bool, markers: ProofScalarWitnesses&, terms: mutable darray[ProofNormalTerm]&, depth: usize) -> bool:
            return false if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT or terms.count >= PROOF_NORMAL_TERM_LIMIT
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_collect_normal_terms_with_witnesses(inner, sign, signed, markers, terms, depth + 1)
                Ast::Expr.IntLit(value, _):
                    return false if value < 0
                    terms.push(ProofNormalTerm{name: "", coefficient: value if sign > 0 else 0 - value})
                    return true
                Ast::Expr.Ident(name, _):
                    width: (complete: bool, has_width: bool) = proof_normal_term_has_width_with_witnesses(expression, markers)
                    return false if name == "" or not width.complete or not width.has_width
                    terms.push(ProofNormalTerm{name: name, coefficient: sign})
                    return true
                Ast::Expr.Unary(operator, operand, _):
                    return false if operator != TokenKind.Plus and operator != TokenKind.Minus
                    negated: (known: bool, value: i64) = proof_signed_negated_literal(expression, signed)
                    if negated.known:
                        terms.push(ProofNormalTerm{name: "", coefficient: negated.value if sign > 0 else 0 - negated.value})
                        return true
                    width: (complete: bool, has_width: bool) = proof_normal_term_has_width_with_witnesses(expression, markers)
                    return false if not width.complete or not width.has_width
                    return proof_collect_normal_terms_with_witnesses(operand, sign if operator == TokenKind.Plus else 0 - sign, signed, markers, terms, depth + 1)
                Ast::Expr.Binary(left, operator, right, _):
                    if operator == TokenKind.Star and metered:
                        literal_left: (complete: bool, known: bool, value: i64) = proof_linear_literal_with_work(left, &work, work_limit, true, 0)
                        literal_right: (complete: bool, known: bool, value: i64) = proof_linear_literal_with_work(right, &work, work_limit, true, 0)
                        return false if not literal_left.complete or not literal_right.complete
                        if literal_left.known and literal_right.known and (literal_left.value <= 1 or literal_right.value <= 1):
                            product: (known: bool, value: i64) = proof_mul_safe(literal_left.value, literal_right.value)
                            return false if not product.known
                            scaled_product: (known: bool, value: i64) = proof_mul_safe(product.value, sign)
                            return false if not scaled_product.known or not proof_linear_search_width_debit(&work, work_limit, 1)
                            terms.push(ProofNormalTerm{name: "", coefficient: scaled_product.value})
                            return true
                        width: (complete: bool, has_width: bool) = proof_normal_term_has_width_with_witnesses_work(expression, facts, markers, &work, work_limit, true)
                        return false if not width.complete or not width.has_width
                        if literal_left.known:
                            scaled: (known: bool, value: i64) = proof_mul_safe(literal_left.value, sign)
                            return false if not scaled.known
                            return proof_collect_normal_terms_with_witnesses_work(right, scaled.value, signed, facts, markers, terms, depth + 1, &work, work_limit, metered)
                        if literal_right.known:
                            scaled: (known: bool, value: i64) = proof_mul_safe(literal_right.value, sign)
                            return false if not scaled.known
                            return proof_collect_normal_terms_with_witnesses_work(left, scaled.value, signed, facts, markers, terms, depth + 1, &work, work_limit, metered)
                        return false
                    return false if operator != TokenKind.Plus and operator != TokenKind.Minus
                    width: (complete: bool, has_width: bool) = proof_normal_term_has_width_with_witnesses(expression, markers)
                    return false if not width.complete or not width.has_width
                    return false if not proof_collect_normal_terms_with_witnesses(left, sign, signed, markers, terms, depth + 1)
                    return proof_collect_normal_terms_with_witnesses(right, sign if operator == TokenKind.Plus else 0 - sign, signed, markers, terms, depth + 1)
                _:
                    return false

        def proof_linear_search_width_debit(work: mutable usize&, work_limit: usize, amount: usize) -> bool:
            return false if work > work_limit
            if amount > work_limit - work:
                work <- work_limit
                return false
            work <- work + amount
            return true

        # Give a nested width walk only the portion of the shared search allowance that
        # remains. The width readers use the linear safety ceiling internally, so offsetting
        # their local counter makes that fixed ceiling enforce the smaller caller allowance
        # while the walk is in progress, not after it has completed.
        def proof_linear_search_width_local_start(work: usize, work_limit: usize) -> (complete: bool, baseline: usize):
            return (false, PROOF_LINEAR_SAFETY_WORK_LIMIT) if work >= work_limit
            remaining: usize = work_limit - work
            allowance: usize = remaining if remaining < PROOF_LINEAR_SAFETY_WORK_LIMIT else PROOF_LINEAR_SAFETY_WORK_LIMIT
            return (true, PROOF_LINEAR_SAFETY_WORK_LIMIT - allowance)

        # Search variants meter each indexed query and feed its measured local safety work into
        # the shared tactic allowance. The per-query cap prevents one malformed equality from
        # monopolizing a search; the tactic meter still governs the sum across all queries.
        def proof_normal_term_has_width_with_witnesses_work(expression: Ast::Expr, facts: darray[Ast::Expr]&, markers: ProofScalarWitnesses&, work: mutable usize&, work_limit: usize, metered: bool) -> (complete: bool, has_width: bool):
            return (true, proof_normal_term_has_width(expression, facts)) if not metered
            start: (complete: bool, baseline: usize) = proof_linear_search_width_local_start(work, work_limit)
            return (false, false) if not start.complete
            local_work: mutable usize = start.baseline
            exhausted: mutable bool = false
            signed_width: i64 = proof_signed_width_in_expression_with_work(expression, markers, 0, &local_work, &exhausted)
            if exhausted:
                work <- work_limit
                return (false, false)
            return (false, false) if not proof_linear_search_width_debit(&work, work_limit, local_work - start.baseline)
            return (true, true) if signed_width != 0
            start <- proof_linear_search_width_local_start(work, work_limit)
            return (false, false) if not start.complete
            local_work <- start.baseline
            exhausted <- false
            unsigned_width: i64 = proof_unsigned_width_in_expression_with_work(expression, markers, &local_work, &exhausted)
            if exhausted:
                work <- work_limit
                return (false, false)
            return (false, false) if not proof_linear_search_width_debit(&work, work_limit, local_work - start.baseline)
            return (true, unsigned_width != 0)

        def proof_linear_literal_with_work(expression: Ast::Expr, work: mutable usize&, work_limit: usize, metered: bool, depth: usize) -> (complete: bool, known: bool, value: i64):
            return (false, false, 0) if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            return (false, false, 0) if metered and not proof_linear_search_width_debit(&work, work_limit, 1)
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_linear_literal_with_work(inner, &work, work_limit, metered, depth + 1)
                Ast::Expr.IntLit(value, _):
                    return (true, true, value) if value >= 0
                    return (true, false, 0)
                _:
                    return (true, false, 0)

        def proof_normal_comparison_signed_with_witnesses_work(left: Ast::Expr, right: Ast::Expr, facts: darray[Ast::Expr]&, markers: ProofScalarWitnesses&, work: mutable usize&, work_limit: usize, metered: bool) -> (complete: bool, signed: bool):
            return (true, proof_normal_comparison_signed(left, right, facts)) if not metered
            start: (complete: bool, baseline: usize) = proof_linear_search_width_local_start(work, work_limit)
            return (false, false) if not start.complete
            local_work: mutable usize = start.baseline
            exhausted: mutable bool = false
            left_width: i64 = proof_signed_width_in_expression_with_work(left, markers, 0, &local_work, &exhausted)
            if exhausted:
                work <- work_limit
                return (false, false)
            return (false, false) if not proof_linear_search_width_debit(&work, work_limit, local_work - start.baseline)
            return (true, true) if left_width != 0
            start <- proof_linear_search_width_local_start(work, work_limit)
            return (false, false) if not start.complete
            local_work <- start.baseline
            exhausted <- false
            right_width: i64 = proof_signed_width_in_expression_with_work(right, markers, 0, &local_work, &exhausted)
            if exhausted:
                work <- work_limit
                return (false, false)
            return (false, false) if not proof_linear_search_width_debit(&work, work_limit, local_work - start.baseline)
            return (true, right_width != 0)

        def proof_collect_normal_terms_with_witnesses_work(expression: Ast::Expr, sign: i64, signed: bool, facts: darray[Ast::Expr]&, markers: ProofScalarWitnesses&, terms: mutable darray[ProofNormalTerm]&, depth: usize, work: mutable usize&, work_limit: usize, metered: bool) -> bool:
            return false if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT or terms.count >= PROOF_NORMAL_TERM_LIMIT
            return false if metered and not proof_linear_search_width_debit(&work, work_limit, 1)
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_collect_normal_terms_with_witnesses_work(inner, sign, signed, facts, markers, terms, depth + 1, &work, work_limit, metered)
                Ast::Expr.IntLit(value, _):
                    return false if value < 0
                    terms.push(ProofNormalTerm{name: "", coefficient: value if sign > 0 else 0 - value})
                    return true
                Ast::Expr.Ident(name, _):
                    width: (complete: bool, has_width: bool) = proof_normal_term_has_width_with_witnesses_work(expression, facts, markers, &work, work_limit, metered)
                    return false if name == "" or not width.complete or not width.has_width
                    terms.push(ProofNormalTerm{name: name, coefficient: sign})
                    return true
                Ast::Expr.Unary(operator, operand, _):
                    return false if operator != TokenKind.Plus and operator != TokenKind.Minus
                    negated: (known: bool, value: i64) = proof_signed_negated_literal(expression, signed)
                    if negated.known:
                        terms.push(ProofNormalTerm{name: "", coefficient: negated.value if sign > 0 else 0 - negated.value})
                        return true
                    width: (complete: bool, has_width: bool) = proof_normal_term_has_width_with_witnesses_work(expression, facts, markers, &work, work_limit, metered)
                    return false if not width.complete or not width.has_width
                    return proof_collect_normal_terms_with_witnesses_work(operand, sign if operator == TokenKind.Plus else 0 - sign, signed, facts, markers, terms, depth + 1, &work, work_limit, metered)
                Ast::Expr.Binary(left, operator, right, _):
                    if operator == TokenKind.Star:
                        left_literal: (complete: bool, known: bool, value: i64) = proof_linear_literal_with_work(left, &work, work_limit, metered, 0)
                        return false if not left_literal.complete
                        right_literal: (complete: bool, known: bool, value: i64) = proof_linear_literal_with_work(right, &work, work_limit, metered, 0)
                        return false if not right_literal.complete
                        if left_literal.known and right_literal.known and (left_literal.value <= 1 or right_literal.value <= 1):
                            product: (known: bool, value: i64) = proof_mul_safe(left_literal.value, right_literal.value)
                            return false if not product.known
                            scaled: (known: bool, value: i64) = proof_mul_safe(product.value, sign)
                            return false if not scaled.known
                            terms.push(ProofNormalTerm{name: "", coefficient: scaled.value})
                            return true
                    return false if operator != TokenKind.Plus and operator != TokenKind.Minus and operator != TokenKind.Star
                    width: (complete: bool, has_width: bool) = proof_normal_term_has_width_with_witnesses_work(expression, facts, markers, &work, work_limit, metered)
                    return false if not width.complete or not width.has_width
                    if operator == TokenKind.Star:
                        left_scale: (complete: bool, known: bool, value: i64) = proof_linear_literal_with_work(left, &work, work_limit, metered, 0)
                        return false if not left_scale.complete
                        if left_scale.known:
                            scaled: (known: bool, value: i64) = proof_mul_safe(left_scale.value, sign)
                            return false if not scaled.known
                            return proof_collect_normal_terms_with_witnesses_work(right, scaled.value, signed, facts, markers, terms, depth + 1, &work, work_limit, metered)
                        right_scale: (complete: bool, known: bool, value: i64) = proof_linear_literal_with_work(right, &work, work_limit, metered, 0)
                        return false if not right_scale.complete or not right_scale.known
                        scaled: (known: bool, value: i64) = proof_mul_safe(right_scale.value, sign)
                        return false if not scaled.known
                        return proof_collect_normal_terms_with_witnesses_work(left, scaled.value, signed, facts, markers, terms, depth + 1, &work, work_limit, metered)
                    return false if not proof_collect_normal_terms_with_witnesses_work(left, sign, signed, facts, markers, terms, depth + 1, &work, work_limit, metered)
                    return proof_collect_normal_terms_with_witnesses_work(right, sign if operator == TokenKind.Plus else 0 - sign, signed, facts, markers, terms, depth + 1, &work, work_limit, metered)
                _:
                    return false

        # `-literal` has no width of its own, but in a comparison one of whose sides is signed
        # it is read at that side's width, where the negation of a non-negative i64 literal is
        # exact. The ambiguity guard admitted the goal at that width; an unsigned comparison is
        # still declined, since there `-literal` wraps.
        def proof_signed_negated_literal(expression: Ast::Expr, signed: bool) -> (known: bool, value: i64):
            return (false, 0) if not signed
            match expression:
                Ast::Expr.Unary(TokenKind.Minus, operand, _):
                    match operand:
                        Ast::Expr.IntLit(value, _):
                            return (true, 0 - value) if value >= 0
                        _:
                            pass
                _:
                    pass
            return (false, 0)

        def proof_normal_comparison_signed(left: Ast::Expr, right: Ast::Expr, facts: darray[Ast::Expr]&) -> bool:
            return proof_signed_width_in_expression(left, facts) != 0 or proof_signed_width_in_expression(right, facts) != 0

        def proof_normal_term_has_width(expression: Ast::Expr, facts: darray[Ast::Expr]&) -> bool:
            return proof_signed_width_in_expression(expression, facts) != 0 or proof_unsigned_width_in_expression(expression, facts) != 0

        # `left - right` as `first - second` for two affine forms with a unit coefficient: the
        # names left over once equal occurrences cancel, at most one of each sign, and every
        # literal folded into the first form's offset. Anything else -- a coefficient of two, a
        # third name -- is outside difference logic and is declined.
        def proof_normal_difference(left: Ast::Expr, right: Ast::Expr, facts: darray[Ast::Expr]&) -> (known: bool, first: ProofAffine, second: ProofAffine):
            empty: ProofAffine = ProofAffine{known: false, base: "", offset: 0, negative: false}
            terms: mutable darray[ProofNormalTerm] = []
            signed: bool = proof_normal_comparison_signed(left, right, facts)
            return (false, empty, empty) if:
                not proof_collect_normal_terms(left, 1, signed, facts, &terms, 0)
                not proof_collect_normal_terms(right, -1, signed, facts, &terms, 0)
            constant: mutable i64 = 0
            positive: mutable sview = ""
            negative: mutable sview = ""
            for index in 0..<terms.count |index, terms, constant, positive, negative|:
                term: ProofNormalTerm = terms[index]
                if term.name == "":
                    folded: (known: bool, value: i64) = proof_add_safe(constant, term.coefficient)
                    return (false, empty, empty) if not folded.known
                    constant <- folded.value
                    continue
                seen: mutable bool = false
                for earlier in 0..<index |earlier, index, terms, term, seen|:
                    seen <- true if terms[earlier].name == term.name
                continue if seen
                # Coefficients are unit and the term count is capped, so this sum cannot overflow.
                total: mutable i64 = 0
                for later in index..<terms.count |later, terms, term, total|:
                    total <- total + terms[later].coefficient if terms[later].name == term.name
                continue if total == 0
                return (false, empty, empty) if total != 1 and total != -1
                if total == 1:
                    return (false, empty, empty) if positive != ""
                    positive <- term.name
                else:
                    return (false, empty, empty) if negative != ""
                    negative <- term.name
            return (true, ProofAffine{known: true, base: positive, offset: constant, negative: false}, ProofAffine{known: true, base: negative, offset: 0, negative: false})

        # Cancellation. `x - (count + 1) < x - count` and `x - count >= 0` are difference claims
        # the affine tier cannot read, because each side mentions two names; normalized, they are
        # `-1 < 0` and `count <= x`. Reading a side as a sum over the integers is only valid when
        # none of its operations wrapped, and this tier does not decide that: it runs after the
        # goal's wrap guard has certified every operation it admits, and after the primitive
        # witness gate that keeps an unwitnessed subterm from slipping past that guard. That is
        # why the affine forms are handed on as certified -- their own evaluation never happens.
        def proof_normalized_difference_goal(left: Ast::Expr, operator: TokenKind, right: Ast::Expr, facts: darray[Ast::Expr]&) -> bool:
            return false if not proof_is_comparison(operator) or operator == TokenKind.BangEq
            normal: (known: bool, first: ProofAffine, second: ProofAffine) = proof_normal_difference(left, right, facts)
            if not normal.known:
                scaled: (known: bool, first: ProofAffine, second: ProofAffine, operator: TokenKind) = proof_scaled_single_difference(left, operator, right, facts)
                return false if not scaled.known
                return proof_difference_affine_goal(scaled.first, scaled.operator, scaled.second, facts, true)
            return proof_difference_affine_goal(normal.first, operator, normal.second, facts, true)

        # `numerator / divisor` rounded toward negative infinity, for a positive divisor.
        def proof_floor_quotient(numerator: i64, divisor: i64) -> (known: bool, value: i64):
            return (false, 0) if divisor <= 0
            quotient: i64 = numerator / divisor
            product: (known: bool, value: i64) = proof_mul_safe(quotient, divisor)
            return (false, 0) if not product.known
            return (true, quotient - 1) if product.value > numerator
            return (true, quotient)

        # One name left with a coefficient of two or more, `origin - (origin + cap) <= cap`
        # reading as `-2 * cap <= 0`. Over the integers `k * x + c <= 0` is exactly
        # `x <= floor(-c / k)` for positive `k`, and `x >= ceil(c / -k)` for negative `k`;
        # strict and reversed comparisons move by one first, and an equality needs `k` to
        # divide `c`. The result is a unit difference claim, which the same tier then decides.
        def proof_scaled_single_difference(left: Ast::Expr, operator: TokenKind, right: Ast::Expr, facts: darray[Ast::Expr]&) -> (known: bool, first: ProofAffine, second: ProofAffine, operator: TokenKind):
            empty: ProofAffine = ProofAffine{known: false, base: "", offset: 0, negative: false}
            terms: mutable darray[ProofNormalTerm] = []
            signed: bool = proof_normal_comparison_signed(left, right, facts)
            return (false, empty, empty, operator) if:
                not proof_collect_normal_terms(left, 1, signed, facts, &terms, 0)
                not proof_collect_normal_terms(right, -1, signed, facts, &terms, 0)
            constant: mutable i64 = 0
            name: mutable sview = ""
            scale: mutable i64 = 0
            for index in 0..<terms.count |index, terms, constant, name, scale|:
                term: ProofNormalTerm = terms[index]
                if term.name == "":
                    folded: (known: bool, value: i64) = proof_add_safe(constant, term.coefficient)
                    return (false, empty, empty, operator) if not folded.known
                    constant <- folded.value
                    continue
                seen: mutable bool = false
                for earlier in 0..<index |earlier, index, terms, term, seen|:
                    seen <- true if terms[earlier].name == term.name
                continue if seen
                # Unit coefficients under a capped term count: this sum cannot overflow.
                total: mutable i64 = 0
                for later in index..<terms.count |later, terms, term, total|:
                    total <- total + terms[later].coefficient if terms[later].name == term.name
                continue if total == 0
                return (false, empty, empty, operator) if name != ""
                name <- term.name
                scale <- total
            return (false, empty, empty, operator) if name == "" or scale == 1 or scale == -1 or scale == 0
            if operator == TokenKind.EqEq:
                quotient: i64 = constant / scale
                product: (known: bool, value: i64) = proof_mul_safe(quotient, scale)
                return (false, empty, empty, operator) if not product.known or product.value != constant
                return (true, ProofAffine{known: true, base: name, offset: quotient, negative: false}, ProofAffine{known: true, base: "", offset: 0, negative: false}, TokenKind.EqEq)
            coefficient: mutable i64 = scale
            offset: mutable i64 = constant
            if operator == TokenKind.Lt or operator == TokenKind.Gt or operator == TokenKind.GtEq:
                if operator == TokenKind.Gt or operator == TokenKind.GtEq:
                    coefficient <- 0 - scale
                    flipped: (known: bool, value: i64) = proof_sub_safe(0, constant)
                    return (false, empty, empty, operator) if not flipped.known
                    offset <- flipped.value
                if operator == TokenKind.Lt or operator == TokenKind.Gt:
                    stepped: (known: bool, value: i64) = proof_add_safe(offset, 1)
                    return (false, empty, empty, operator) if not stepped.known
                    offset <- stepped.value
            elif operator != TokenKind.LtEq:
                return (false, empty, empty, operator)
            negated: (known: bool, value: i64) = proof_sub_safe(0, offset)
            return (false, empty, empty, operator) if not negated.known
            if coefficient > 0:
                upper: (known: bool, value: i64) = proof_floor_quotient(negated.value, coefficient)
                return (false, empty, empty, operator) if not upper.known
                shifted: (known: bool, value: i64) = proof_sub_safe(0, upper.value)
                return (false, empty, empty, operator) if not shifted.known
                return (true, ProofAffine{known: true, base: name, offset: shifted.value, negative: false}, ProofAffine{known: true, base: "", offset: 0, negative: false}, TokenKind.LtEq)
            floor: (known: bool, value: i64) = proof_floor_quotient(negated.value, 0 - coefficient)
            return (false, empty, empty, operator) if not floor.known
            lower: (known: bool, value: i64) = proof_sub_safe(0, floor.value)
            return (false, empty, empty, operator) if not lower.known
            return (true, ProofAffine{known: true, base: "", offset: lower.value, negative: false}, ProofAffine{known: true, base: name, offset: 0, negative: false}, TokenKind.LtEq)

        # A counter's rebind, `next == count + 1`, is an order fact in disguise once the step is
        # known not to wrap: it then says `next - count == 1` over the integers. The strict peer
        # `count < bound` of the same unsigned width decides that without an interval, which is the
        # argument the difference collector applies when it imports the same equality. Both sides
        # name only atoms and a unit step, so the unsigned subtraction guard can take it among its
        # orders without being handed any arithmetic it is itself deciding. A modular equality with
        # no such peer -- `y == x + 1` at `x == 255` -- stays out.
        def proof_unsigned_peer_increment_equality(expression: Ast::Expr, orders: darray[Ast::Expr]&) -> bool:
            match proof_strip_parens(expression):
                Ast::Expr.Binary(left, TokenKind.EqEq, right, _):
                    return proof_unsigned_peer_increment_side(left, right, orders) or proof_unsigned_peer_increment_side(right, left, orders)
                _:
                    return false

        def proof_unsigned_peer_increment_side(name_side: Ast::Expr, increment_side: Ast::Expr, orders: darray[Ast::Expr]&) -> bool:
            return false if proof_ident_name(proof_strip_parens(name_side)) == ""
            match proof_strip_parens(increment_side):
                Ast::Expr.Binary(left, TokenKind.Plus, right, _):
                    unit: (known: bool, base: Ast::Expr) = proof_unsigned_unit_increment_base(left, right)
                    return false if not unit.known
                    base_name: sview = proof_ident_name(proof_strip_parens(unit.base))
                    return false if base_name == ""
                    width: i64 = proof_unsigned_marker_width_for_name(orders, base_name)
                    return width != 0 and proof_unsigned_increment_has_strict_peer(unit.base, width, orders)
                _:
                    return false
