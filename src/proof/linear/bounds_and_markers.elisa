extend ElisaProof:
    public:
        const PROOF_CONGRUENCE_SCAN_DEPTH: usize = 127
        const PROOF_UNSIGNED_PLACE_DEPTH_LIMIT: usize = 64

        struct ProofBound:
            name: sview
            term: Ast::Expr
            term_key: bool
            lower: mutable i64
            upper: mutable i64
            has_lower: mutable bool
            has_upper: mutable bool

        # A normalized signed-integer difference constraint `left - right <= bound`. Empty
        # names denote the mathematical zero node, so the same representation covers ordinary
        # bounds (`x >= 0`) and relations between two symbolic values.
        struct ProofDifference:
            left: sview
            right: sview
            bound: i64

        # A deliberately small affine form. The base is one bare identifier, the coefficient is
        # either +1 or -1, and the offset is a fixed i64 constant. This is still far from a
        # general Presburger solver, but it covers both `x + k` and well-founded ranks such as
        # `127 - depth` without treating arithmetic normalization as an axiom.
        struct ProofAffine:
            known: bool
            base: sview
            offset: i64
            negative: bool

        def proof_unsigned_place_marker(term: Ast::Expr, width: i64, position: Ast::Pos) -> Ast::Expr:
            arguments: darray[Ast::Expr] = [term, Ast::Expr.IntLit(width, position)]
            return Ast::Expr.Call(Ast::Expr.Ident("__elisa_unsigned_type_bound", position), arguments, [], position)

        def proof_signed_type_marker(term: Ast::Expr, width: i64, position: Ast::Pos) -> Ast::Expr:
            arguments: darray[Ast::Expr] = [term, Ast::Expr.IntLit(width, position)]
            return Ast::Expr.Call(Ast::Expr.Ident("__elisa_signed_type_bound", position), arguments, [], position)

        def proof_signed_place_marker(term: Ast::Expr, width: i64, position: Ast::Pos) -> Ast::Expr:
            arguments: darray[Ast::Expr] = [term, Ast::Expr.IntLit(width, position)]
            return Ast::Expr.Call(Ast::Expr.Ident("__elisa_signed_place_type_bound", position), arguments, [], position)

        def proof_signed_place_marker_info(expression: Ast::Expr) -> (known: bool, term: Ast::Expr, width: i64) can[Memory.Allocate, Abort.Panic]:
            match expression:
                Ast::Expr.Call(callee, arguments, argument_names, _):
                    return (false, Ast::Expr.Invalid, 0) if argument_names.count != 0 and argument_names.count != arguments.count
                    return (false, Ast::Expr.Invalid, 0) if proof_ident_name(callee) != "__elisa_signed_place_type_bound" or arguments.count != 2
                    width: (known: bool, value: i64) = proof_constant_int(arguments[1])
                    return (false, Ast::Expr.Invalid, 0) if not width.known or not ElisaProofKernelCore::proof_kernel_signed_width_valid(width.value)
                    return (proof_place_root_name(arguments[0], 0) != "" or proof_call_result_label(arguments[0]) or proof_named_call_term(arguments[0]), arguments[0], width.value)
                _:
                    return (false, Ast::Expr.Invalid, 0)

        # `f(x).label`: a labeled element of a named call's tuple result, which
        # `proof_add_tuple_field_call_witnesses` types from the declared return type.
        def proof_call_result_label(expression: Ast::Expr) -> bool:
            match expression:
                Ast::Expr.Field(object, field_name, _):
                    return field_name != "" and proof_named_call_term(object)
                _:
                    return false

        # A call of a named function, bare or module-qualified, never of an internal marker.
        # Markers are always bare names, so a qualified callee is a source function.
        def proof_named_call_term(expression: Ast::Expr) -> bool:
            match expression:
                Ast::Expr.Call(Ast::Expr.Scope(_, member, _), _, _, _):
                    return member != "" and not proof_name_is_reserved_internal(member)
                _:
                    pass
            callee: sview = proof_marker_callee_name(expression)
            return callee != "" and not proof_name_is_reserved_internal(callee)

        def proof_signed_marker_info(expression: Ast::Expr) -> (known: bool, term: Ast::Expr, width: i64):
            match expression:
                Ast::Expr.Call(callee, arguments, argument_names, _):
                    return (false, Ast::Expr.Invalid, 0) if argument_names.count != 0 and argument_names.count != arguments.count
                    return (false, Ast::Expr.Invalid, 0) if proof_ident_name(callee) != "__elisa_signed_type_bound" or arguments.count != 2
                    width: (known: bool, value: i64) = proof_constant_int(arguments[1])
                    return (false, Ast::Expr.Invalid, 0) if not width.known or not ElisaProofKernelCore::proof_kernel_signed_width_valid(width.value)
                    return (proof_ident_name(arguments[0]) != "", arguments[0], width.value)
                _:
                    return (false, Ast::Expr.Invalid, 0)

        def proof_signed_marker_width_for_term(facts: darray[Ast::Expr]&, term: Ast::Expr) -> i64:
            for fact in facts |term|:
                match proof_marker_callee_name(fact):
                    "__elisa_signed_type_bound":
                        marker = proof_signed_marker_info(fact)
                        return marker.width if marker.known and proof_expr_equal(marker.term, term)
                    "__elisa_signed_place_type_bound":
                        place = proof_signed_place_marker_info(fact)
                        return place.width if place.known and proof_expr_equal(place.term, term)
                    _:
                        pass
            return 0

        def proof_signed_width_in_expression(expression: Ast::Expr, facts: darray[Ast::Expr]&) -> i64:
            match expression:
                Ast::Expr.Tuple(_, _):
                    return proof_signed_marker_width_for_term(facts, expression) if proof_structural_bound_atom(expression, facts)
                    return 0
                Ast::Expr.Ident(_, _) or Ast::Expr.Field(_, _, _) or Ast::Expr.Index(_, _, _) or Ast::Expr.IndexN(_, _, _):
                    return proof_signed_marker_width_for_term(facts, expression)
                Ast::Expr.Paren(inner, _):
                    return proof_signed_width_in_expression(inner, facts)
                Ast::Expr.Unary(_, operand, _):
                    return proof_signed_width_in_expression(operand, facts)
                Ast::Expr.Binary(left, _, right, _):
                    left_width: i64 = proof_signed_width_in_expression(left, facts)
                    right_width: i64 = proof_signed_width_in_expression(right, facts)
                    return 0 if left_width != 0 and right_width != 0 and left_width != right_width
                    return left_width if left_width != 0
                    return right_width
                Ast::Expr.If(_, then_expression, else_expression, _):
                    then_width: i64 = proof_signed_width_in_expression(then_expression, facts)
                    else_width: i64 = proof_signed_width_in_expression(else_expression, facts)
                    return then_width if then_width == else_width
                _:
                    pass
            return 0

        def proof_indexed_element_path(expression: Ast::Expr, depth: usize) -> (known: bool, container: Ast::Expr, subscripts: i64):
            return (false, Ast::Expr.Invalid, 0) if depth > PROOF_CONGRUENCE_SCAN_DEPTH
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_indexed_element_path(inner, depth + 1)
                Ast::Expr.Index(object, _, _):
                    path: (known: bool, container: Ast::Expr, subscripts: i64) = proof_indexed_element_path(object, depth + 1)
                    return (false, Ast::Expr.Invalid, 0) if not path.known or path.subscripts >= PROOF_TYPE_AUDIT_DEPTH_LIMIT.i64()
                    return (true, path.container, path.subscripts + 1)
                Ast::Expr.IndexN(object, arguments, _):
                    return (false, Ast::Expr.Invalid, 0) if arguments.count == 0 or arguments.count > PROOF_TYPE_AUDIT_DEPTH_LIMIT
                    path: (known: bool, container: Ast::Expr, subscripts: i64) = proof_indexed_element_path(object, depth + 1)
                    return (false, Ast::Expr.Invalid, 0) if not path.known or path.subscripts > PROOF_TYPE_AUDIT_DEPTH_LIMIT.i64() - arguments.count.i64()
                    return (true, path.container, path.subscripts + arguments.count.i64())
                _:
                    return (true, expression, 0)

        def proof_unsigned_element_width_for_expression(expression: Ast::Expr, facts: darray[Ast::Expr]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            path: (known: bool, container: Ast::Expr, subscripts: i64) = proof_indexed_element_path(expression, 0)
            return 0 if not path.known or path.subscripts == 0
            width: mutable i64 = 0
            for fact in facts |fact, path, width|:
                continue if not proof_marker_has_callee(fact, "__elisa_primitive_scalar_element")
                marker: (known: bool, term: Ast::Expr, depth: i64, width: i64) = proof_element_marker_info(fact)
                continue if not marker.known or marker.width == 0 or marker.depth != path.subscripts or not proof_expr_equal(marker.term, path.container)
                width <- marker.width if width == 0 or marker.width < width
            return width

        # The place form read as a marker rather than as a bare-name marker. Retention follows the
        # root binding, so the exact field width stays live only as long as the place it describes.
        def proof_unsigned_place_marker_info(expression: Ast::Expr) -> (known: bool, term: Ast::Expr, width: i64) can[Memory.Allocate, Abort.Panic]:
            match expression:
                Ast::Expr.Call(callee, arguments, argument_names, _):
                    return (false, Ast::Expr.Invalid, 0) if argument_names.count != 0 and argument_names.count != arguments.count
                    return (false, Ast::Expr.Invalid, 0) if proof_ident_name(callee) != "__elisa_unsigned_type_bound" or arguments.count != 2
                    marked: (known: bool, value: i64) = proof_constant_int(arguments[1])
                    return (false, Ast::Expr.Invalid, 0) if not marked.known or marked.value < ElisaProofKernelCore::PROOF_KERNEL_FIXED_WIDTH_MIN or marked.value > ElisaProofKernelCore::PROOF_KERNEL_MACHINE_WORD_BITS
                    return (proof_place_root_name(arguments[0], 0) != "", arguments[0], marked.value)
                _:
                    return (false, Ast::Expr.Invalid, 0)

        def proof_unsigned_place_marker_width(facts: darray[Ast::Expr]&, term: Ast::Expr) -> i64 can[Memory.Allocate, Abort.Panic]:
            width: mutable i64 = 0
            for fact in facts |fact, term, width|:
                match fact:
                    Ast::Expr.Call(callee, arguments, argument_names, _):
                        continue if argument_names.count != 0 and argument_names.count != arguments.count
                        continue if proof_ident_name(callee) != "__elisa_unsigned_type_bound" or arguments.count != 2
                        continue if not proof_expr_equal(arguments[0], term)
                        marked: (known: bool, value: i64) = proof_constant_int(arguments[1])
                        continue if not marked.known or marked.value < ElisaProofKernelCore::PROOF_KERNEL_FIXED_WIDTH_MIN or marked.value > ElisaProofKernelCore::PROOF_KERNEL_MACHINE_WORD_BITS
                        width <- marked.value if width == 0 or marked.value < width
                    _:
                        pass
            return width

        # Whether a term has an unsigned type. Arithmetic between an unsigned operand and anything
        # else does not typecheck, so one unsigned atom settles the whole term. This answers a
        # narrower question than the width function: it is used only where the answer alone is the
        # argument, never to decide whether a term stays in range.
        def proof_term_is_unsigned(expression: Ast::Expr, facts: darray[Ast::Expr]&, depth: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if depth >= ElisaProofKernelCore::PROOF_KERNEL_STRUCTURAL_SCAN_DEPTH_LIMIT
            return true if proof_unsigned_width_in_expression(expression, facts) != 0
            stripped: Ast::Expr = proof_strip_parens(expression)
            match stripped:
                Ast::Expr.Binary(left, operator, right, _):
                    arithmetic: bool = operator == TokenKind.Plus or operator == TokenKind.Minus or operator == TokenKind.Star or operator == TokenKind.Slash or operator == TokenKind.Percent or operator == TokenKind.LShift or operator == TokenKind.RShift
                    return false if not arithmetic
                    return proof_term_is_unsigned(left, facts, depth + 1) or proof_term_is_unsigned(right, facts, depth + 1)
                _:
                    return proof_unsigned_place_marker_width(facts, stripped) != 0

        # Elisa dispatches `==`, `+`, `-`, `*`, `/` and the ordering operators to a user
        # `__eq__`/`__add__`/`__cmp__` implementation whenever an operand's type is a struct, and
        # a user `__eq__` need not be Leibniz equality. Ground congruence is therefore admitted
        # only over terms whose operators are the language's primitive ones. The proof AST carries
        # no compiler type metadata, so the producer records the declared primitive scalar types
        # it resolved through the same traced-fact channel used for unsigned widths. The marker is
        # opaque to every arithmetic tier and proves no proposition by itself; manufacturing one
        # can only lose completeness, because the source trace still has to identify it as a
        # type-bound fact of the owning declaration.
        def proof_scalar_type_marker(name: sview, position: Ast::Pos) -> Ast::Expr:
            return proof_scalar_term_marker(Ast::Expr.Ident(name, position), position)

        # The declared type of a term, not only of a name. The producer resolves a field
        # selection's declared type through the owning struct declaration, so the witness has to
        # be keyed by the exact term rather than by a symbol.
        def proof_scalar_term_marker(term: Ast::Expr, position: Ast::Pos) -> Ast::Expr:
            arguments: darray[Ast::Expr] = [term]
            return Ast::Expr.Call(Ast::Expr.Ident("__elisa_primitive_scalar_type", position), arguments, [], position)

        # A container whose declared element type is a primitive scalar. The index set is not
        # enumerable, so the witness is recorded once against the container term and says only
        # that every element of it is a primitive scalar.
        # The depth is how many subscripts reach the scalar: 1 for `darray[i64]`, 2 for
        # `array[array[i64, 4], 4]`, so a nested or multi-argument subscript is witnessed only
        # when it goes exactly that deep.
        def proof_scalar_element_marker(term: Ast::Expr, depth: i64, position: Ast::Pos, width: i64) -> Ast::Expr:
            arguments: mutable darray[Ast::Expr] = [term, Ast::Expr.IntLit(depth, position)]
            arguments.push(Ast::Expr.IntLit(width, position)) if width >= ElisaProofKernelCore::PROOF_KERNEL_FIXED_WIDTH_MIN and width <= ElisaProofKernelCore::PROOF_KERNEL_MACHINE_WORD_BITS
            return Ast::Expr.Call(Ast::Expr.Ident("__elisa_primitive_scalar_element", position), arguments, [], position)

        # A cheap filter, never an admission rule. The full marker parser must still check
        # arguments and widths. Avoid allocating its Invalid result for unrelated facts in
        # the hot scalar-witness scans; even sentinel AST nodes occupy the source store.
        def proof_marker_callee_name(expression: Ast::Expr) -> sview:
            match expression:
                # Match the bare callee directly: forwarding its AST through
                # proof_ident_name repeatedly materializes source-store records
                # in the scalar-witness hot path. Recognition is unchanged;
                # parenthesized, qualified and field callees still are not markers.
                Ast::Expr.Call(Ast::Expr.Ident(name, _), _, _, _):
                    return name
                _:
                    return ""

        def proof_marker_has_callee(expression: Ast::Expr, name: sview) -> bool:
            return name != "" and proof_marker_callee_name(expression) == name

        def proof_element_marker_info(expression: Ast::Expr) -> (known: bool, term: Ast::Expr, depth: i64, width: i64):
            match expression:
                Ast::Expr.Call(callee, arguments, argument_names, _):
                    return (false, Ast::Expr.Invalid, 0, 0) if argument_names.count != 0 and argument_names.count != arguments.count
                    return (false, Ast::Expr.Invalid, 0, 0) if proof_ident_name(callee) != "__elisa_primitive_scalar_element" or (arguments.count != 2 and arguments.count != 3)
                    depth: (known: bool, value: i64) = proof_constant_int(arguments[1])
                    return (false, Ast::Expr.Invalid, 0, 0) if not depth.known or depth.value < 1 or depth.value > PROOF_TYPE_AUDIT_DEPTH_LIMIT.i64()
                    width: mutable i64 = 0
                    if arguments.count == 3:
                        marked_width: (known: bool, value: i64) = proof_constant_int(arguments[2])
                        return (false, Ast::Expr.Invalid, 0, 0) if not marked_width.known or marked_width.value < ElisaProofKernelCore::PROOF_KERNEL_FIXED_WIDTH_MIN or marked_width.value > ElisaProofKernelCore::PROOF_KERNEL_MACHINE_WORD_BITS
                        width <- marked_width.value
                    return (true, arguments[0], depth.value, width)
                _:
                    return (false, Ast::Expr.Invalid, 0, 0)

        def proof_marker_argument(expression: Ast::Expr, callee_name: sview) -> (known: bool, term: Ast::Expr):
            match expression:
                Ast::Expr.Call(callee, arguments, argument_names, _):
                    return (false, Ast::Expr.Invalid) if argument_names.count != 0 and argument_names.count != arguments.count
                    return (false, Ast::Expr.Invalid) if proof_ident_name(callee) != callee_name or arguments.count != 1
                    return (true, arguments[0])
                _:
                    return (false, Ast::Expr.Invalid)

        # True only for a canonical compiler type marker. A marker states a declared type; it
        # constrains no model and proves no proposition by itself. Keep this parser strict because
        # the bounded model treats a recognized marker as a tautological model fact.
        def proof_type_marker_callee(expression: Ast::Expr) -> bool:
            return match proof_marker_callee_name(expression):
                "__elisa_unsigned_type_bound":
                    unsigned = proof_unsigned_marker_info(expression)
                    place = proof_unsigned_place_marker_info(expression)
                    unsigned.known or place.known
                "__elisa_primitive_scalar_type":
                    scalar = proof_marker_argument(expression, "__elisa_primitive_scalar_type")
                    scalar.known
                "__elisa_signed_type_bound":
                    signed = proof_signed_marker_info(expression)
                    signed.known
                "__elisa_signed_place_type_bound":
                    signed_place = proof_signed_place_marker_info(expression)
                    signed_place.known
                "__elisa_primitive_scalar_element":
                    element = proof_element_marker_info(expression)
                    element.known
                _:
                    false

        # The bare-name form of the scalar witness. A term-shaped witness answers "" here and is
        # matched structurally by `proof_scalar_term_witnessed` instead.
        def proof_scalar_marker_name(expression: Ast::Expr) -> sview:
            return "" if not proof_marker_has_callee(expression, "__elisa_primitive_scalar_type")
            argument: (known: bool, term: Ast::Expr) = proof_marker_argument(expression, "__elisa_primitive_scalar_type")
            return "" if not argument.known
            return proof_ident_name(argument.term)

        # The symbol a type witness hangs off: the root of its argument place. Retention and
        # invalidation follow that symbol, so a field or element witness dies exactly when the
        # binding it was resolved against does.
        def proof_type_marker_root_name(expression: Ast::Expr) -> sview:
            return match proof_marker_callee_name(expression):
                "__elisa_primitive_scalar_type":
                    scalar = proof_marker_argument(expression, "__elisa_primitive_scalar_type")
                    proof_place_root_name(scalar.term, 0) if scalar.known else ""
                "__elisa_primitive_scalar_element":
                    element = proof_element_marker_info(expression)
                    proof_place_root_name(element.term, 0) if element.known else ""
                "__elisa_unsigned_type_bound":
                    place = proof_unsigned_place_marker_info(expression)
                    proof_place_root_name(place.term, 0) if place.known else ""
                "__elisa_signed_type_bound":
                    signed = proof_signed_marker_info(expression)
                    proof_place_root_name(signed.term, 0) if signed.known else ""
                "__elisa_signed_place_type_bound":
                    signed_place = proof_signed_place_marker_info(expression)
                    proof_place_root_name(signed_place.term, 0) if signed_place.known else ""
                _:
                    ""

        def proof_place_root_name(expression: Ast::Expr, depth: usize) -> sview:
            return "" if depth >= PROOF_UNSIGNED_PLACE_DEPTH_LIMIT
            match expression:
                Ast::Expr.Ident(name, _):
                    return name
                Ast::Expr.Paren(inner, _):
                    return proof_place_root_name(inner, depth + 1)
                Ast::Expr.Field(object, _, _):
                    return proof_place_root_name(object, depth + 1)
                Ast::Expr.Index(object, _, _):
                    return proof_place_root_name(object, depth + 1)
                Ast::Expr.Tuple(elements, _):
                    # A loop binder's proof atom is `(name, offset)`; it belongs to that name.
                    return "" if elements.count != 2
                    offset: (known: bool, value: i64) = proof_constant_int(elements[1])
                    return proof_ident_name(elements[0]) if offset.known
                    return ""
                _:
                    return ""

        def proof_unsigned_marker_info(expression: Ast::Expr) -> (known: bool, name: sview, width: i64):
            match expression:
                Ast::Expr.Call(callee, arguments, argument_names, _):
                    return (false, "", 0) if argument_names.count != 0 and argument_names.count != arguments.count
                    return (false, "", 0) if proof_ident_name(callee) != "__elisa_unsigned_type_bound" or arguments.count != 2
                    name: sview = proof_ident_name(arguments[0])
                    width: (known: bool, value: i64) = proof_constant_int(arguments[1])
                    return (width.known and name != "" and width.value >= ElisaProofKernelCore::PROOF_KERNEL_FIXED_WIDTH_MIN and width.value <= ElisaProofKernelCore::PROOF_KERNEL_MACHINE_WORD_BITS, name, width.value)
                _:
                    return (false, "", 0)

        def proof_unsigned_marker_name(expression: Ast::Expr) -> sview:
            marker: (known: bool, name: sview, width: i64) = proof_unsigned_marker_info(expression)
            return marker.name if marker.known
            return ""

        def proof_unsigned_marker_width_for_name(facts: darray[Ast::Expr]&, name: sview) -> i64:
            width: mutable i64 = 0
            for fact in facts |fact, name, width|:
                marker: (known: bool, name: sview, width: i64) = proof_unsigned_marker_info(fact)
                continue if not marker.known or marker.name != name
                width <- marker.width if width == 0 or marker.width < width
            return width

        def proof_unsigned_width_max(width: i64) -> i64:
            return ElisaProofKernelCore::PROOF_KERNEL_U8_MAX if width == ElisaProofKernelCore::PROOF_KERNEL_U8_WIDTH
            return ElisaProofKernelCore::PROOF_KERNEL_U16_MAX if width == ElisaProofKernelCore::PROOF_KERNEL_U16_WIDTH
            return ElisaProofKernelCore::PROOF_KERNEL_U32_MAX if width == ElisaProofKernelCore::PROOF_KERNEL_U32_WIDTH
            # i64 is the largest signed value representable by this proof AST. For u64/usize,
            # a finite proof interval must establish this conservative representable ceiling;
            # an unbounded unsigned value consequently cannot enter an arithmetic proof.
            return ElisaProofKernelCore::PROOF_KERNEL_I64_MAX if width == ElisaProofKernelCore::PROOF_KERNEL_MACHINE_WORD_BITS
            return 0

        def proof_unsigned_width_in_expression(expression: Ast::Expr, facts: darray[Ast::Expr]&) -> i64:
            match expression:
                Ast::Expr.Ident(name, _):
                    return proof_unsigned_marker_width_for_name(facts, name)
                Ast::Expr.Field(_, _, _):
                    return proof_unsigned_place_marker_width(facts, expression)
                Ast::Expr.Index(_, _, _) or Ast::Expr.IndexN(_, _, _):
                    return proof_unsigned_element_width_for_expression(expression, facts)
                Ast::Expr.Paren(inner, _):
                    return proof_unsigned_width_in_expression(inner, facts)
                Ast::Expr.Unary(_, operand, _):
                    return proof_unsigned_width_in_expression(operand, facts)
                Ast::Expr.Binary(left, _, right, _):
                    left_width: i64 = proof_unsigned_width_in_expression(left, facts)
                    right_width: i64 = proof_unsigned_width_in_expression(right, facts)
                    return right_width if left_width == 0
                    return left_width if right_width == 0 or left_width < right_width
                    return right_width
                Ast::Expr.If(condition, then_expression, else_expression, _):
                    then_width: i64 = proof_unsigned_width_in_expression(then_expression, facts)
                    else_width: i64 = proof_unsigned_width_in_expression(else_expression, facts)
                    return 0 if then_width == 0 or else_width == 0
                    return then_width if then_width < else_width
                    return else_width
                # Argument and callee types do not determine a call's return type. Calls need an
                # explicit result-width witness; inheriting an unsigned argument's width here can
                # misclassify a signed result.
                Ast::Expr.Call(_, _, _, _):
                    return 0
                _:
                    return 0

        def proof_unsigned_order_atom(expression: Ast::Expr) -> bool:
            match expression:
                Ast::Expr.IntLit(_, _):
                    return true
                Ast::Expr.Ident(_, _):
                    return true
                Ast::Expr.Field(object, field_name, _):
                    # A field of a bare name is a place, not arithmetic, so it carries the same
                    # guarantee an identifier does: reading it twice in one fact set reads the
                    # same value, because any write to it, and any call that is not stable for
                    # it, discards these facts first. `values.count` is the term this admits in
                    # practice, and it is the bound every loop over a collection is written
                    # against. The peer rule already names exactly this shape.
                    return field_name != "" and proof_ident_name(proof_strip_parens(object)) != ""
                Ast::Expr.Paren(inner, _):
                    return proof_unsigned_order_atom(inner)
                _:
                    return false

        # Range safety must not be justified by reinterpreting the very modular
        # arithmetic whose safety is in question. Only plain scalar orders enter
        # the subtraction-order solver; split conjunctions without importing their
        # arithmetic siblings.
        def proof_collect_unsigned_order_facts(expression: Ast::Expr, orders: mutable darray[Ast::Expr]&) -> void:
            match expression:
                Ast::Expr.Paren(inner, _):
                    proof_collect_unsigned_order_facts(inner, orders)
                Ast::Expr.Unary(TokenKind.Not, operand, _):
                    # An early return leaves its condition negated, which is the ordinary way a
                    # guard reaches the statements after it. The negation of a comparison between
                    # two atoms is a comparison between the same two atoms, so it imports no
                    # arithmetic; the bound and difference collectors already complement it.
                    match operand:
                        Ast::Expr.Binary(left, operator, right, _):
                            orders.push(expression) if proof_is_comparison(operator) and proof_unsigned_order_atom(left) and proof_unsigned_order_atom(right)
                        _:
                            pass
                Ast::Expr.Binary(left, operator, right, _):
                    if operator == TokenKind.And:
                        proof_collect_unsigned_order_facts(left, orders)
                        proof_collect_unsigned_order_facts(right, orders)
                    elif proof_is_comparison(operator) and proof_unsigned_order_atom(left) and proof_unsigned_order_atom(right):
                        orders.push(expression)
                _:
                    pass

        # A boolean constant, seeing through the negation the contract substitution leaves behind.
        # `ensure not result or X` becomes `not false or X` on a path that returns false.
        def proof_constant_bool(expression: Ast::Expr) -> (known: bool, value: bool):
            match proof_strip_parens(expression):
                Ast::Expr.BoolLit(value, _):
                    return (true, value)
                Ast::Expr.Unary(operator, operand, _):
                    return (false, false) if operator != TokenKind.Not
                    inner: (known: bool, value: bool) = proof_constant_bool(operand)
                    return (inner.known, not inner.value)
                _:
                    return (false, false)

include "./bounds_and_markers_integrated_helpers.elisa"
