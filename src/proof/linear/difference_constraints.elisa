const PROOF_LINEAR_MAX_DIFFERENCE_CONSTRAINTS: usize = 4096
# The producer search cap is distinct from the kernel replay cap, even while their value matches.
const PROOF_LINEAR_DIFFERENCE_NODE_LIMIT: usize = 33
const PROOF_LINEAR_MAX_ENUMERATED_ELEMENTS: usize = 65536
const PROOF_LINEAR_MAX_QUANTIFIER_ENTRIES: usize = 32768

extend ElisaProof:
    public:
        # Generated signed range instances must not look like parsed unsigned
        # high-bit literals. Keep the minimum-i64 case fail-closed when its
        # positive magnitude cannot be represented.
        def proof_unsigned_increment_has_direct_peer(base: Ast::Expr, width: i64, facts: darray[Ast::Expr]&) -> bool:
            for fact in facts |fact, base, width, facts|:
                candidate: mutable Ast::Expr = proof_strip_parens(fact)
                match candidate:
                    Ast::Expr.Unary(TokenKind.Not, operand, position):
                        match proof_strip_parens(operand):
                            Ast::Expr.Binary(left, operator, right, _):
                                candidate <- Ast::Expr.Binary(left, proof_comparison_negation(operator), right, position) if operator == TokenKind.GtEq or operator == TokenKind.LtEq
                            _:
                                pass
                    _:
                        pass
                match candidate:
                    Ast::Expr.Binary(fact_left, fact_operator, fact_right, _):
                        if fact_operator == TokenKind.Lt and proof_expr_equal(fact_left, base) and proof_peer_is_nameable(fact_right):
                            return true if proof_peer_unsigned_width(fact_right, facts) == width
                        if fact_operator == TokenKind.Gt and proof_expr_equal(fact_right, base) and proof_peer_is_nameable(fact_left):
                            return true if proof_peer_unsigned_width(fact_left, facts) == width
                    _:
                        pass
            return false

        def proof_affine_unsigned_peer_safe(affine: ProofAffine, constraints: darray[ProofDifference]&, facts: darray[Ast::Expr]&) -> bool:
            return false if not affine.known or affine.negative or affine.offset != 1 or affine.base == ""
            width: i64 = proof_unsigned_marker_width_for_name(facts, affine.base)
            return false if width == 0
            for constraint in constraints |constraint, affine, width, facts|:
                continue if constraint.left != affine.base or constraint.right == ""
                # `left - right <= -1` is `left < right`, which is the strictness the argument needs.
                continue if constraint.bound > -1
                return true if proof_unsigned_marker_width_for_name(facts, constraint.right) == width
            return false

        def proof_close_bounds_through_differences(constraints: darray[ProofDifference]&, bounds: mutable darray[ProofBound]&) -> void:
            return if constraints.count == 0
            for round in 0..<PROOF_BOUND_PROPAGATION_ROUND_LIMIT |round, constraints, bounds|:
                changed: mutable bool = false
                for constraint in constraints |constraint, bounds, changed|:
                    continue if constraint.left == "" or constraint.right == ""
                    right_bound: ProofBound = proof_bound_for(bounds, constraint.right)
                    if right_bound.has_upper:
                        derived_upper: (known: bool, value: i64) = proof_add_safe(right_bound.upper, constraint.bound)
                        if derived_upper.known:
                            prior: ProofBound = proof_bound_for(bounds, constraint.left)
                            changed <- true if not prior.has_upper or derived_upper.value < prior.upper
                            proof_add_upper(bounds, constraint.left, derived_upper.value)
                    left_bound: ProofBound = proof_bound_for(bounds, constraint.left)
                    if left_bound.has_lower:
                        derived_lower: (known: bool, value: i64) = proof_sub_safe(left_bound.lower, constraint.bound)
                        if derived_lower.known:
                            prior: ProofBound = proof_bound_for(bounds, constraint.right)
                            changed <- true if not prior.has_lower or derived_lower.value > prior.lower
                            proof_add_lower(bounds, constraint.right, derived_lower.value)
                break if not changed

        # Linear-safety variants charge every constraint visit and every entry examined by the
        # bound index. They stage updates in a private copy, so callers never observe a prefix of
        # a closure when the shared work budget runs out.
        def proof_linear_safety_bound_index_with_work(bounds: darray[ProofBound]&, name: sview, budget: mutable usize&, exhausted: mutable bool&) -> usize:
            index: mutable usize = 0
            while index < bounds.count |index, bounds, name, budget, exhausted|:
                return bounds.count if not proof_linear_safety_work_charge(budget, exhausted, 1) or not proof_linear_safety_work_charge(budget, exhausted, sview_len(name)) or not proof_linear_safety_work_charge(budget, exhausted, sview_len(bounds[index].name))
                return index if not bounds[index].term_key and bounds[index].name == name
                index <- index + 1
            return bounds.count

        def proof_linear_safety_bound_for_with_work(bounds: darray[ProofBound]&, name: sview, budget: mutable usize&, exhausted: mutable bool&) -> ProofBound:
            can Abort.Panic:
                index: usize = proof_linear_safety_bound_index_with_work(bounds, name, budget, exhausted)
                return ProofBound{name: name, term: Ast::Expr.Invalid, term_key: false, has_lower: false, lower: 0, has_upper: false, upper: 0} if proof_goal_bool_ref_value(exhausted) or index >= bounds.count
                return bounds[index]

        def proof_linear_safety_add_lower_with_work(bounds: mutable darray[ProofBound]&, name: sview, value: i64, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            can Abort.Panic:
                return true if name == ""
                index: usize = proof_linear_safety_bound_index_with_work(bounds, name, budget, exhausted)
                return false if proof_goal_bool_ref_value(exhausted)
                if index == bounds.count:
                    bounds <- bounds.push(ProofBound{name: name, term: Ast::Expr.Invalid, term_key: false, has_lower: true, lower: value, has_upper: false, upper: 0})
                    return true
                old_has: bool = bounds[index].has_lower
                old_value: i64 = bounds[index].lower
                bounds[index].has_lower <- true
                bounds[index].lower <- value if not old_has or value > old_value
                return true

        def proof_linear_safety_add_upper_with_work(bounds: mutable darray[ProofBound]&, name: sview, value: i64, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            can Abort.Panic:
                return true if name == ""
                index: usize = proof_linear_safety_bound_index_with_work(bounds, name, budget, exhausted)
                return false if proof_goal_bool_ref_value(exhausted)
                if index == bounds.count:
                    bounds <- bounds.push(ProofBound{name: name, term: Ast::Expr.Invalid, term_key: false, has_lower: false, lower: 0, has_upper: true, upper: value})
                    return true
                old_has: bool = bounds[index].has_upper
                old_value: i64 = bounds[index].upper
                bounds[index].has_upper <- true
                bounds[index].upper <- value if not old_has or value < old_value
                return true

        def proof_linear_safety_bound_at_vertex_with_work(bounds: darray[ProofBound]&, rows: darray[usize]&, found: darray[bool]&, vertex: usize, name: sview, budget: mutable usize&, exhausted: mutable bool&) -> ProofBound:
            empty: ProofBound = ProofBound{name: name, term: Ast::Expr.Invalid, term_key: false, has_lower: false, lower: 0, has_upper: false, upper: 0}
            if vertex >= rows.count or vertex >= found.count:
                exhausted <- true
                return empty
            return empty if not found[vertex]
            row: usize = rows[vertex]
            if row >= bounds.count or bounds[row].term_key:
                exhausted <- true
                return empty
            return empty if not proof_linear_safety_work_charge(budget, exhausted, 1) or not proof_linear_safety_work_charge(budget, exhausted, sview_len(bounds[row].name)) or not proof_linear_safety_work_charge(budget, exhausted, sview_len(name))
            if bounds[row].name != name:
                exhausted <- true
                return empty
            bounds[row]

        def proof_linear_safety_add_lower_at_vertex_with_work(bounds: mutable darray[ProofBound]&, rows: mutable darray[usize]&, found: mutable darray[bool]&, vertex: usize, name: sview, value: i64, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            can Abort.Panic:
                return false if vertex >= rows.count or vertex >= found.count or proof_goal_bool_ref_value(exhausted)
                if not found[vertex]:
                    return false if not proof_linear_safety_work_charge(budget, exhausted, 1) or not proof_linear_safety_work_charge(budget, exhausted, sview_len(name))
                    row: usize = bounds.count
                    bounds.push(ProofBound{name: name, term: Ast::Expr.Invalid, term_key: false, has_lower: true, lower: value, has_upper: false, upper: 0})
                    rows[vertex] <- row
                    found[vertex] <- true
                    return true
                row: usize = rows[vertex]
                if row >= bounds.count or bounds[row].term_key:
                    exhausted <- true
                    return false
                return false if not proof_linear_safety_work_charge(budget, exhausted, sview_len(bounds[row].name)) or not proof_linear_safety_work_charge(budget, exhausted, sview_len(name))
                if bounds[row].name != name:
                    exhausted <- true
                    return false
                return true if bounds[row].has_lower and value <= bounds[row].lower
                return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                bounds[row].has_lower <- true
                bounds[row].lower <- value
                return true

        def proof_linear_safety_add_upper_at_vertex_with_work(bounds: mutable darray[ProofBound]&, rows: mutable darray[usize]&, found: mutable darray[bool]&, vertex: usize, name: sview, value: i64, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            can Abort.Panic:
                return false if vertex >= rows.count or vertex >= found.count or proof_goal_bool_ref_value(exhausted)
                if not found[vertex]:
                    return false if not proof_linear_safety_work_charge(budget, exhausted, 1) or not proof_linear_safety_work_charge(budget, exhausted, sview_len(name))
                    row: usize = bounds.count
                    bounds.push(ProofBound{name: name, term: Ast::Expr.Invalid, term_key: false, has_lower: false, lower: 0, has_upper: true, upper: value})
                    rows[vertex] <- row
                    found[vertex] <- true
                    return true
                row: usize = rows[vertex]
                if row >= bounds.count or bounds[row].term_key:
                    exhausted <- true
                    return false
                return false if not proof_linear_safety_work_charge(budget, exhausted, sview_len(bounds[row].name)) or not proof_linear_safety_work_charge(budget, exhausted, sview_len(name))
                if bounds[row].name != name:
                    exhausted <- true
                    return false
                return true if bounds[row].has_upper and value >= bounds[row].upper
                return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                bounds[row].has_upper <- true
                bounds[row].upper <- value
                return true

        def proof_close_bounds_through_differences_with_work(constraints: darray[ProofDifference]&, bounds: mutable darray[ProofBound]&, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            can Abort.Panic:
                return false if proof_goal_bool_ref_value(exhausted)
                if constraints.count > PROOF_LINEAR_MAX_DIFFERENCE_CONSTRAINTS:
                    exhausted <- true
                    return false
                ignored_bound_nodes: mutable usize = 0
                return false if not proof_linear_safety_bound_shape_total_with_work(bounds, &ignored_bound_nodes, budget, exhausted)
                staged: mutable darray[ProofBound] = []
                for bound in bounds |bound, staged, budget, exhausted|:
                    return false if not proof_linear_safety_work_charge(budget, exhausted, 1) or not proof_linear_safety_work_charge(budget, exhausted, sview_len(bound.name))
                    staged.push(bound)
                if constraints.count == 0:
                    bounds <- staged
                    return true
                vertex_index_result: (complete: bool, index: ProofNameEqualityVertexIndex) = proof_name_equality_vertex_index_build(constraints.count, budget, exhausted)
                return false if not vertex_index_result.complete
                vertex_index: mutable ProofNameEqualityVertexIndex = vertex_index_result.index
                names: mutable darray[sview] = []
                left_vertices: mutable darray[usize] = []
                right_vertices: mutable darray[usize] = []
                for constraint in constraints |constraint, vertex_index, names, left_vertices, right_vertices, budget, exhausted|:
                    if constraint.left == "" or constraint.right == "":
                        return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                        left_vertices.push(names.count)
                        right_vertices.push(names.count)
                    else:
                        left_vertex: (complete: bool, row: usize) = proof_name_equality_vertex_index_insert(&vertex_index, &names, constraint.left, budget, exhausted)
                        return false if not left_vertex.complete
                        right_vertex: (complete: bool, row: usize) = proof_name_equality_vertex_index_insert(&vertex_index, &names, constraint.right, budget, exhausted)
                        return false if not right_vertex.complete
                        return false if not proof_linear_safety_work_charge(budget, exhausted, 2)
                        left_vertices.push(left_vertex.row)
                        right_vertices.push(right_vertex.row)
                bound_rows: mutable darray[usize] = []
                bound_found: mutable darray[bool] = []
                for vertex in 0..<names.count |vertex, names, bound_rows, bound_found, budget, exhausted|:
                    return false if not proof_linear_safety_work_charge(budget, exhausted, 2)
                    bound_rows.push(0)
                    bound_found.push(false)
                for row in 0..<staged.count |row, staged, names, vertex_index, bound_rows, bound_found, budget, exhausted|:
                    return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                    continue if staged[row].term_key or staged[row].name == ""
                    vertex: (complete: bool, found: bool, row: usize) = proof_name_equality_vertex_index_find(vertex_index, names, staged[row].name, budget, exhausted)
                    return false if not vertex.complete
                    if vertex.found and not bound_found[vertex.row]:
                        bound_rows[vertex.row] <- row
                        bound_found[vertex.row] <- true
                for round in 0..<PROOF_BOUND_PROPAGATION_ROUND_LIMIT |round, constraints, staged, budget, exhausted|:
                    return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                    changed: mutable bool = false
                    for constraint_index in 0..<constraints.count |constraint_index, constraints, left_vertices, right_vertices, staged, bound_rows, bound_found, names, changed, budget, exhausted|:
                        return false if constraint_index >= left_vertices.count or constraint_index >= right_vertices.count or not proof_linear_safety_work_charge(budget, exhausted, 1)
                        constraint: ProofDifference = constraints[constraint_index]
                        continue if constraint.left == "" or constraint.right == ""
                        left_vertex: usize = left_vertices[constraint_index]
                        right_vertex: usize = right_vertices[constraint_index]
                        right_bound: ProofBound = proof_linear_safety_bound_at_vertex_with_work(staged, bound_rows, bound_found, right_vertex, constraint.right, budget, exhausted)
                        return false if proof_goal_bool_ref_value(exhausted) or right_vertex >= names.count
                        if right_bound.has_upper:
                            derived_upper: (known: bool, value: i64) = proof_add_safe(right_bound.upper, constraint.bound)
                            if derived_upper.known:
                                prior: ProofBound = proof_linear_safety_bound_at_vertex_with_work(staged, bound_rows, bound_found, left_vertex, constraint.left, budget, exhausted)
                                return false if proof_goal_bool_ref_value(exhausted) or left_vertex >= names.count
                                changed <- true if not prior.has_upper or derived_upper.value < prior.upper
                                return false if not proof_linear_safety_add_upper_at_vertex_with_work(&staged, &bound_rows, &bound_found, left_vertex, constraint.left, derived_upper.value, budget, exhausted)
                        left_bound: ProofBound = proof_linear_safety_bound_at_vertex_with_work(staged, bound_rows, bound_found, left_vertex, constraint.left, budget, exhausted)
                        return false if proof_goal_bool_ref_value(exhausted) or left_vertex >= names.count
                        if left_bound.has_lower:
                            derived_lower: (known: bool, value: i64) = proof_sub_safe(left_bound.lower, constraint.bound)
                            if derived_lower.known:
                                prior: ProofBound = proof_linear_safety_bound_at_vertex_with_work(staged, bound_rows, bound_found, right_vertex, constraint.right, budget, exhausted)
                                return false if proof_goal_bool_ref_value(exhausted) or right_vertex >= names.count
                                changed <- true if not prior.has_lower or derived_lower.value > prior.lower
                                return false if not proof_linear_safety_add_lower_at_vertex_with_work(&staged, &bound_rows, &bound_found, right_vertex, constraint.right, derived_lower.value, budget, exhausted)
                    break if not changed
                bounds <- staged
                return true

        def proof_affine_safe(affine: ProofAffine, bounds: darray[ProofBound]&) -> bool:
            return false if not affine.known
            return true if:
                affine.base == ""
                not affine.negative and affine.offset == 0
            base_bound: ProofBound = proof_bound_for(bounds, affine.base)
            if affine.negative:
                return false if not base_bound.has_lower or not base_bound.has_upper
                negated_upper: (known: bool, value: i64) = proof_sub_safe(0, base_bound.upper)
                negated_lower: (known: bool, value: i64) = proof_sub_safe(0, base_bound.lower)
                return false if not negated_upper.known or not negated_lower.known
                lower: (known: bool, value: i64) = proof_add_safe(negated_upper.value, affine.offset)
                upper: (known: bool, value: i64) = proof_add_safe(negated_lower.value, affine.offset)
                return lower.known and upper.known
            if affine.offset > 0:
                limit: (known: bool, value: i64) = proof_sub_safe(proof_i64_max(), affine.offset)
                return limit.known and base_bound.has_upper and base_bound.upper <= limit.value
            limit: (known: bool, value: i64) = proof_sub_safe(proof_i64_min(), affine.offset)
            return limit.known and base_bound.has_lower and base_bound.lower >= limit.value

        def proof_difference_push(left: ProofAffine, right: ProofAffine, reverse: bool, strict: bool, constraints: mutable darray[ProofDifference]&) -> void:
            first: ProofAffine = left if not reverse else right
            second: ProofAffine = right if not reverse else left
            difference: (known: bool, value: i64) = proof_sub_safe(second.offset, first.offset)
            return if not difference.known
            bound: mutable i64 = difference.value
            if strict:
                decremented: (known: bool, value: i64) = proof_sub_safe(bound, 1)
                return if not decremented.known
                bound <- decremented.value
            # Encode `sign * base + offset` as a difference constraint only when the resulting
            # relation is representable by the graph. A negative affine term reverses the graph
            # edge; dropping that sign would turn `0 - x <= 0` into the false bound `x <= 0`.
            if first.base == "" and second.base == "":
                constraints.push(ProofDifference{left: "", right: "", bound: bound})
                return
            if first.base == "":
                constraints.push(ProofDifference{left: second.base, right: "", bound: bound}) if second.negative
                constraints.push(ProofDifference{left: "", right: second.base, bound: bound}) if not second.negative
                return
            if second.base == "":
                constraints.push(ProofDifference{left: "", right: first.base, bound: bound}) if first.negative
                constraints.push(ProofDifference{left: first.base, right: "", bound: bound}) if not first.negative
                return
            return if first.negative != second.negative
            constraints.push(ProofDifference{left: second.base, right: first.base, bound: bound}) if first.negative
            constraints.push(ProofDifference{left: first.base, right: second.base, bound: bound}) if not first.negative

        def proof_difference_constraint_push_with_work(left: sview, right: sview, bound: i64, constraints: mutable darray[ProofDifference]&, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            if constraints.count >= PROOF_LINEAR_MAX_DIFFERENCE_CONSTRAINTS:
                exhausted <- true
                return false
            return false if not proof_linear_safety_work_charge(budget, exhausted, 1) or not proof_linear_safety_work_charge(budget, exhausted, sview_len(left)) or not proof_linear_safety_work_charge(budget, exhausted, sview_len(right))
            constraints.push(ProofDifference{left: left, right: right, bound: bound})
            return true

        # Work-aware counterpart of `proof_difference_push`. A cap failure is reported before
        # appending the 4097th edge, and callers stage the whole graph so no truncated relation
        # set is used to narrow bounds.
        def proof_difference_push_with_work(left: ProofAffine, right: ProofAffine, reverse: bool, strict: bool, constraints: mutable darray[ProofDifference]&, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
            first: ProofAffine = left if not reverse else right
            second: ProofAffine = right if not reverse else left
            difference: (known: bool, value: i64) = proof_sub_safe(second.offset, first.offset)
            return true if not difference.known
            bound: mutable i64 = difference.value
            if strict:
                decremented: (known: bool, value: i64) = proof_sub_safe(bound, 1)
                return true if not decremented.known
                bound <- decremented.value
            if first.base == "" and second.base == "":
                return proof_difference_constraint_push_with_work("", "", bound, constraints, budget, exhausted)
            if first.base == "":
                if second.negative:
                    return proof_difference_constraint_push_with_work(second.base, "", bound, constraints, budget, exhausted)
                return proof_difference_constraint_push_with_work("", second.base, bound, constraints, budget, exhausted)
            if second.base == "":
                if first.negative:
                    return proof_difference_constraint_push_with_work("", first.base, bound, constraints, budget, exhausted)
                return proof_difference_constraint_push_with_work(first.base, "", bound, constraints, budget, exhausted)
            return true if first.negative != second.negative
            if first.negative:
                return proof_difference_constraint_push_with_work(second.base, first.base, bound, constraints, budget, exhausted)
            return proof_difference_constraint_push_with_work(first.base, second.base, bound, constraints, budget, exhausted)

        # The same increment argument as `proof_affine_unsigned_peer_safe`, asked of the facts alone
        # rather than of an already-collected constraint graph. The goal side could ask the graph
        # because the graph was finished by then; a fact is being imported *into* that graph, so
        # its own admissibility has to be decided before there is one. `x + 1` cannot wrap when a
        # fact says `x < peer` and the peer has the same unsigned width, because the peer is then
        # at most that width's maximum. Without this, an equality naming an increment -- which is
        # what every counter rebind records -- was dropped from the graph entirely.
        def proof_affine_peer_safe_from_facts(affine: ProofAffine, facts: darray[Ast::Expr]&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if not affine.known or affine.negative or affine.offset != 1 or affine.base == ""
            width: i64 = proof_unsigned_marker_width_for_name(facts, affine.base)
            return false if width == 0
            return proof_unsigned_increment_has_strict_peer(Ast::Expr.Ident(affine.base, Ast::pos_at_line(0)), width, facts)

        # Normalize only comparison facts whose affine subexpressions are safe to evaluate for
        # the current fixed-width intervals. A relation involving `x + 1` is not imported unless
        # the known bounds prove that expression cannot wrap.
        # `markers` must be exactly `proof_scalar_witness_markers(facts)`.
        def proof_collect_difference_constraints_marked(expression: Ast::Expr, bounds: darray[ProofBound]&, facts: darray[Ast::Expr]&, markers: ProofScalarWitnesses&, constraints: mutable darray[ProofDifference]&) -> void:
            match expression:
                Ast::Expr.Paren(inner, _):
                    proof_collect_difference_constraints_marked(inner, bounds, facts, markers, constraints)
                Ast::Expr.Unary(TokenKind.Not, operand, _):
                    match operand:
                        Ast::Expr.Binary(left, operator, right, _):
                            negated_operator: TokenKind = proof_comparison_negation(operator)
                            # Equality complements are exact for IEEE values. Ordered
                            # complements are not: NaN makes both the comparison and its
                            # flipped form false, so keep a negated order opaque here.
                            proof_collect_difference_constraints_marked(Ast::Expr.Binary(left, negated_operator, right, Ast::expr_pos(expression)), bounds, facts, markers, constraints) if negated_operator != TokenKind.Eof and (operator == TokenKind.EqEq or operator == TokenKind.BangEq)
                        _:
                            pass
                Ast::Expr.Binary(left, operator, right, _):
                    if operator == TokenKind.And:
                        proof_collect_difference_constraints_marked(left, bounds, facts, markers, constraints)
                        proof_collect_difference_constraints_marked(right, bounds, facts, markers, constraints)
                        return
                    return if not proof_is_comparison(operator) or not proof_primitive_comparison_marked(left, right, markers)
                    return if operator != TokenKind.BangEq and proof_guarded_difference_import(left, operator, right, facts, constraints)
                    left_affine: ProofAffine = proof_affine_expression(left)
                    right_affine: ProofAffine = proof_affine_expression(right)
                    return if not (proof_affine_safe(left_affine, bounds) or proof_affine_peer_safe_from_facts(left_affine, facts))
                    return if not (proof_affine_safe(right_affine, bounds) or proof_affine_peer_safe_from_facts(right_affine, facts))
                    # `a <= b` beside a fact `a != b` over the same two terms is `a < b`.
                    distinct: bool = (operator == TokenKind.LtEq or operator == TokenKind.GtEq) and proof_facts_state_disequality(left, right, facts)
                    if operator == TokenKind.LtEq:
                        proof_difference_push(left_affine, right_affine, false, distinct, constraints)
                    if operator == TokenKind.Lt:
                        proof_difference_push(left_affine, right_affine, false, true, constraints)
                    if operator == TokenKind.GtEq:
                        proof_difference_push(left_affine, right_affine, true, distinct, constraints)
                    if operator == TokenKind.Gt:
                        proof_difference_push(left_affine, right_affine, true, true, constraints)
                    if operator == TokenKind.EqEq:
                        proof_difference_push(left_affine, right_affine, false, false, constraints)
                        proof_difference_push(left_affine, right_affine, true, false, constraints)
                _:
                    pass

        def proof_difference_node_index(nodes: darray[sview]&, name: sview) -> usize:
            index: mutable usize = 0
            while index < nodes.count |index, nodes, name|:
                return index if nodes[index] == name
                index <- index + 1
            return nodes.count

        def proof_difference_matrix_query(nodes: darray[sview]&, matrix: darray[i64]&, known: darray[bool]&, left: sview, right: sview, bound: i64) -> bool:
            left_index: usize = proof_difference_node_index(nodes, left)
            right_index: usize = proof_difference_node_index(nodes, right)
            return false if left_index >= nodes.count or right_index >= nodes.count
            slot: usize = left_index * nodes.count + right_index
            return known[slot] and matrix[slot] <= bound

        # Query the graph representation of `first OP second` after offsets have been moved
        # into `bound`. The sign bit is part of the affine meaning: `-x <= 0` is an edge from
        # zero to x, while `x <= 0` is an edge from x to zero. Mixed signs with two symbolic
        # bases would require a non-difference constraint such as `x + y <= k`, so decline them.
        def proof_difference_affine_query(nodes: darray[sview]&, matrix: darray[i64]&, known: darray[bool]&, first: ProofAffine, second: ProofAffine, bound: i64) -> bool:
            return proof_difference_matrix_query(nodes, matrix, known, "", "", bound) if first.base == "" and second.base == ""
            if first.base == "":
                return proof_difference_matrix_query(nodes, matrix, known, second.base, "", bound) if second.negative
                return proof_difference_matrix_query(nodes, matrix, known, "", second.base, bound)
            if second.base == "":
                return proof_difference_matrix_query(nodes, matrix, known, "", first.base, bound) if first.negative
                return proof_difference_matrix_query(nodes, matrix, known, first.base, "", bound)
            return false if first.negative != second.negative
            return proof_difference_matrix_query(nodes, matrix, known, second.base, first.base, bound) if first.negative
            return proof_difference_matrix_query(nodes, matrix, known, first.base, second.base, bound)

        def proof_difference_goal(left: Ast::Expr, operator: TokenKind, right: Ast::Expr, facts: darray[Ast::Expr]&) -> bool:
            return proof_difference_affine_goal(proof_affine_expression(left), operator, proof_affine_expression(right), facts, false)

        # Floyd-Warshall closure over a bounded relation graph. The node and constraint caps are
        # resource guards: a hostile source file can force an opaque proof failure, never an
        # unbounded allocation or an arithmetic overflow in the closure itself. `certified` says
        # the caller has already shown that the source terms the two forms stand for do not wrap;
        # every other caller has the forms checked here against the collected intervals.
        def proof_difference_affine_goal(left_affine: ProofAffine, operator: TokenKind, right_affine: ProofAffine, facts: darray[Ast::Expr]&, certified: bool) -> bool:
            return false if:
                not proof_is_comparison(operator) or operator == TokenKind.BangEq
                not left_affine.known or not right_affine.known
            bounds: mutable darray[ProofBound] = []
            constraints: mutable darray[ProofDifference] = []
            proof_collect_fact_bounds(facts, &bounds)
            proof_close_equalities(facts, &bounds)
            proof_collect_fact_difference_constraints(facts, bounds, &constraints)
            return false if constraints.count > PROOF_LINEAR_MAX_DIFFERENCE_CONSTRAINTS
            # The constraints are collected before the overflow guard runs, because they are what
            # gives a name an interval when no fact states one about it directly.
            proof_close_bounds_through_differences(constraints, &bounds)
            left_safe: bool = certified or proof_affine_safe(left_affine, bounds) or proof_affine_unsigned_peer_safe(left_affine, constraints, facts)
            right_safe: bool = certified or proof_affine_safe(right_affine, bounds) or proof_affine_unsigned_peer_safe(right_affine, constraints, facts)
            return false if not left_safe or not right_safe
            proof_push_base_bounds(bounds, left_affine.base, &constraints)
            proof_push_base_bounds(bounds, right_affine.base, &constraints)
            nodes: mutable darray[sview] = [""]
            for constraint in constraints |nodes|:
                nodes.push(constraint.left) if constraint.left != "" and proof_difference_node_index(nodes, constraint.left) == nodes.count
                nodes.push(constraint.right) if constraint.right != "" and proof_difference_node_index(nodes, constraint.right) == nodes.count
            return false if nodes.count > PROOF_LINEAR_DIFFERENCE_NODE_LIMIT
            matrix: mutable darray[i64] = []
            known: mutable darray[bool] = []
            matrix.resize(nodes.count * nodes.count)
            known.resize(nodes.count * nodes.count)
            for index in 0..<matrix.count |index, matrix, known|:
                matrix[index] <- 0
                known[index] <- false
            for index in 0..<nodes.count |index, nodes, matrix, known|:
                slot: usize = index * nodes.count + index
                matrix[slot] <- 0
                known[slot] <- true
            for constraint in constraints |constraint, nodes, matrix, known|:
                left_index: usize = proof_difference_node_index(nodes, constraint.left)
                right_index: usize = proof_difference_node_index(nodes, constraint.right)
                slot: usize = left_index * nodes.count + right_index
                matrix[slot] <- constraint.bound if not known[slot] or constraint.bound < matrix[slot]
                known[slot] <- true
            for pivot in 0..<nodes.count |pivot, nodes, matrix, known|:
                for source in 0..<nodes.count |source, pivot, nodes, matrix, known|:
                    first_slot: usize = source * nodes.count + pivot
                    continue if not known[first_slot]
                    for target in 0..<nodes.count |target, source, pivot, nodes, matrix, known|:
                        second_slot: usize = pivot * nodes.count + target
                        continue if not known[second_slot]
                        combined: (known: bool, value: i64) = proof_add_safe(matrix[first_slot], matrix[second_slot])
                        continue if not combined.known
                        result_slot: usize = source * nodes.count + target
                        matrix[result_slot] <- combined.value if not known[result_slot] or combined.value < matrix[result_slot]
                        known[result_slot] <- true
            target_bound: mutable i64 = 0
            if operator == TokenKind.LtEq or operator == TokenKind.Lt:
                difference: (known: bool, value: i64) = proof_sub_safe(right_affine.offset, left_affine.offset)
                return false if not difference.known
                target_bound <- difference.value
                if operator == TokenKind.Lt:
                    decremented: (known: bool, value: i64) = proof_sub_safe(target_bound, 1)
                    return false if not decremented.known
                    target_bound <- decremented.value
            if operator == TokenKind.GtEq or operator == TokenKind.Gt:
                difference: (known: bool, value: i64) = proof_sub_safe(left_affine.offset, right_affine.offset)
                return false if not difference.known
                target_bound <- difference.value
                if operator == TokenKind.Gt:
                    decremented: (known: bool, value: i64) = proof_sub_safe(target_bound, 1)
                    return false if not decremented.known
                    target_bound <- decremented.value
            if operator == TokenKind.EqEq:
                forward_difference: (known: bool, value: i64) = proof_sub_safe(right_affine.offset, left_affine.offset)
                reverse_difference: (known: bool, value: i64) = proof_sub_safe(left_affine.offset, right_affine.offset)
                return false if not forward_difference.known or not reverse_difference.known
                return proof_difference_affine_query(nodes, matrix, known, left_affine, right_affine, forward_difference.value) and proof_difference_affine_query(nodes, matrix, known, right_affine, left_affine, reverse_difference.value)
            return proof_difference_affine_query(nodes, matrix, known, left_affine, right_affine, target_bound) if operator == TokenKind.LtEq or operator == TokenKind.Lt
            return proof_difference_affine_query(nodes, matrix, known, right_affine, left_affine, target_bound)

        # Compare two affine expressions sharing the same base. The operation safety checks are
        # independent of the comparison itself; without them a wrapped `x + 1` could reverse
        # the mathematical difference at the i64 endpoint.
        def proof_affine_goal(left: Ast::Expr, operator: TokenKind, right: Ast::Expr, bounds: darray[ProofBound]&, facts: darray[Ast::Expr]&) -> bool:
            left_affine: ProofAffine = proof_affine_expression(left)
            right_affine: ProofAffine = proof_affine_expression(right)
            return false if:
                not left_affine.known or not right_affine.known or left_affine.base == ""
                left_affine.base != right_affine.base and not proof_names_equal_from_facts(left_affine.base, right_affine.base, facts)
                left_affine.negative != right_affine.negative
                not proof_affine_safe(left_affine, bounds) or not proof_affine_safe(right_affine, bounds)
            difference: (known: bool, value: i64) = proof_sub_safe(left_affine.offset, right_affine.offset)
            return false if not difference.known
            return difference.value > 0 if operator == TokenKind.Gt
            return difference.value >= 0 if operator == TokenKind.GtEq
            return difference.value < 0 if operator == TokenKind.Lt
            return difference.value <= 0 if operator == TokenKind.LtEq
            return difference.value != 0 if operator == TokenKind.BangEq
            return difference.value == 0 if operator == TokenKind.EqEq
            return false

        # Evaluate a bounded contract quantifier by finite instantiation. The range bounds must
        # be constants (possibly made constant by exact facts), the body must be understood by
        # the ordinary kernel, and the work budget is capped. This is a proof-producing check,
        # not a heuristic: forall requires every instance and exists requires a checked witness.

include "./difference_constraints_quantifier_goal.elisa"
include "./difference_constraints_integrated_helpers.elisa"
include "./difference_constraints_safety_work.elisa"
