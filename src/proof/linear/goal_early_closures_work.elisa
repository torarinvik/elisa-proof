# Meter the source goal solver's structural contradiction checks before arithmetic pruning.
extend ElisaProof:
    private:
        def proof_linear_fact_contains_with_work(fact: Ast::Expr, goal: Ast::Expr, depth: usize, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, contains: bool):
            return (false, false) if exhausted
            if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT:
                budget <- PROOF_LINEAR_SAFETY_WORK_LIMIT
                exhausted <- true
                return (false, false)
            return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
            equal: (complete: bool, matches: bool) = proof_linear_search_expr_equal_with_work(fact, goal, budget, PROOF_LINEAR_SAFETY_WORK_LIMIT, true)
            return (false, false) if not equal.complete
            return (true, true) if equal.matches
            match fact:
                Ast::Expr.Paren(inner, _):
                    return proof_linear_fact_contains_with_work(inner, goal, depth + 1, budget, exhausted)
                Ast::Expr.Binary(left, TokenKind.And, right, _):
                    left_contains: (complete: bool, contains: bool) = proof_linear_fact_contains_with_work(left, goal, depth + 1, budget, exhausted)
                    return (false, false) if not left_contains.complete
                    return (true, true) if left_contains.contains
                    return proof_linear_fact_contains_with_work(right, goal, depth + 1, budget, exhausted)
                Ast::Expr.Unary(TokenKind.Not, inner, _):
                    match inner:
                        Ast::Expr.Unary(TokenKind.Not, nested, _):
                            return proof_linear_fact_contains_with_work(nested, goal, depth + 1, budget, exhausted)
                        _:
                            return (true, false)
                _:
                    return (true, false)

        def proof_linear_fact_denies_with_work(candidate: Ast::Expr, facts: darray[Ast::Expr]&, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, denies: bool):
            negated: (complete: bool, known: bool, operand: Ast::Expr) = proof_negated_operand_with_work(candidate, budget, exhausted)
            return (false, false) if not negated.complete
            for fact in facts |fact, candidate, negated, budget, exhausted|:
                return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                if negated.known:
                    contains: (complete: bool, contains: bool) = proof_linear_fact_contains_with_work(fact, negated.operand, 0, budget, exhausted)
                    return (false, false) if not contains.complete
                    return (true, true) if contains.contains
                fact_negated: (complete: bool, known: bool, operand: Ast::Expr) = proof_negated_operand_with_work(fact, budget, exhausted)
                return (false, false) if not fact_negated.complete
                if fact_negated.known:
                    contains: (complete: bool, contains: bool) = proof_linear_fact_contains_with_work(candidate, fact_negated.operand, 0, budget, exhausted)
                    return (false, false) if not contains.complete
                    return (true, true) if contains.contains
            return (true, false)

        def proof_linear_closed_false_comparison_with_work(fact: Ast::Expr, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, is_false: bool):
            stripped: (complete: bool, expression: Ast::Expr) = proof_linear_strip_parens_with_work(fact, budget, exhausted)
            if not stripped.complete:
                budget <- PROOF_LINEAR_SAFETY_WORK_LIMIT
                exhausted <- true
                return (false, false)
            match stripped.expression:
                Ast::Expr.Binary(_, operator, _, _):
                    return (true, false) if not proof_is_comparison(operator)
                _:
                    return (true, false)
            # The legacy constant reader may recursively evaluate nested constant subtrees.
            # Reserve a quadratic bound in the measured expression size before invoking it.
            cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(fact, budget, exhausted)
            return (false, false) if not cost.complete
            return (false, false) if not proof_linear_safety_work_charge_product4_with_work(budget, exhausted, cost.cost, cost.cost, 1, 1, 32)
            return (true, proof_closed_safe_constant_comparison_false(fact))

        def proof_linear_facts_propositionally_inconsistent_with_work(facts: darray[Ast::Expr]&, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, inconsistent: bool):
            return (false, false) if exhausted
            for fact in facts |fact, budget, exhausted|:
                return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                match fact:
                    Ast::Expr.BoolLit(value, _):
                        return (true, true) if not value
                    Ast::Expr.Unary(TokenKind.Not, Ast::Expr.BoolLit(value, _), _):
                        return (true, true) if value
                    _:
                        pass
            for fact in facts |fact, facts, budget, exhausted|:
                constant: (complete: bool, is_false: bool) = proof_linear_closed_false_comparison_with_work(fact, budget, exhausted)
                return (false, false) if not constant.complete
                return (true, true) if constant.is_false
                denies: (complete: bool, denies: bool) = proof_linear_fact_denies_with_work(fact, facts, budget, exhausted)
                return (false, false) if not denies.complete
                return (true, true) if denies.denies
            return (true, false)

        # Work-aware mirror of call-summary substitution. Both the summary/fact cross product
        # and each structural comparison are charged to the goal's shared search budget.
        def proof_linear_fact_proves_call_summary_with_work(facts: darray[Ast::Expr]&, goal: Ast::Expr, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, proves: bool):
            for summary in facts |summary, facts, goal, budget, exhausted|:
                return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                match summary:
                    Ast::Expr.Binary(left, TokenKind.EqEq, right, position):
                        left_is_call: bool = match left:
                            Ast::Expr.Call(_, _, _, _): true
                            _: false
                        right_is_call: bool = match right:
                            Ast::Expr.Call(_, _, _, _): true
                            _: false
                        for fact in facts |fact, left, right, goal, left_is_call, right_is_call, position, budget, exhausted|:
                            return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                            if left_is_call:
                                equal: (complete: bool, matches: bool) = proof_linear_search_expr_equal_with_work(right, goal, budget, PROOF_LINEAR_SAFETY_WORK_LIMIT, true)
                                return (false, false) if not equal.complete
                                if equal.matches:
                                    contains: (complete: bool, contains: bool) = proof_linear_fact_contains_with_work(fact, left, 0, budget, exhausted)
                                    return (false, false) if not contains.complete
                                    return (true, true) if contains.contains
                                match goal:
                                    Ast::Expr.Unary(TokenKind.Not, inner, _):
                                        negated_equal: (complete: bool, matches: bool) = proof_linear_search_expr_equal_with_work(right, inner, budget, PROOF_LINEAR_SAFETY_WORK_LIMIT, true)
                                        return (false, false) if not negated_equal.complete
                                        if negated_equal.matches:
                                            return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                                            contains: (complete: bool, contains: bool) = proof_linear_fact_contains_with_work(fact, Ast::Expr.Unary(TokenKind.Not, left, position), 0, budget, exhausted)
                                            return (false, false) if not contains.complete
                                            return (true, true) if contains.contains
                                    _:
                                        pass
                            if right_is_call:
                                equal: (complete: bool, matches: bool) = proof_linear_search_expr_equal_with_work(left, goal, budget, PROOF_LINEAR_SAFETY_WORK_LIMIT, true)
                                return (false, false) if not equal.complete
                                if equal.matches:
                                    contains: (complete: bool, contains: bool) = proof_linear_fact_contains_with_work(fact, right, 0, budget, exhausted)
                                    return (false, false) if not contains.complete
                                    return (true, true) if contains.contains
                                match goal:
                                    Ast::Expr.Unary(TokenKind.Not, inner, _):
                                        negated_equal: (complete: bool, matches: bool) = proof_linear_search_expr_equal_with_work(left, inner, budget, PROOF_LINEAR_SAFETY_WORK_LIMIT, true)
                                        return (false, false) if not negated_equal.complete
                                        if negated_equal.matches:
                                            return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                                            contains: (complete: bool, contains: bool) = proof_linear_fact_contains_with_work(fact, Ast::Expr.Unary(TokenKind.Not, right, position), 0, budget, exhausted)
                                            return (false, false) if not contains.complete
                                            return (true, true) if contains.contains
                                    _:
                                        pass
                    _:
                        pass
            return (true, false)

        def proof_goal_with_call_consequences_with_work(facts: darray[Ast::Expr]&, goal: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, operator_mask: usize, depth: usize, budget: mutable usize&, split_depth: usize, exhausted: mutable bool&) -> (complete: bool, proves: bool) can[Global.Read, Global.Write]:
            marker_result: (complete: bool, witnesses: ProofScalarWitnesses) = proof_scalar_witness_markers_with_work(facts, true, budget, exhausted)
            return (false, false) if not marker_result.complete or exhausted
            derived: mutable darray[Ast::Expr] = []
            for fact in facts |fact, facts, marker_result, derived, budget, exhausted|:
                stripped: (complete: bool, expression: Ast::Expr) = proof_linear_strip_parens_with_work(fact, budget, exhausted)
                return (false, false) if not stripped.complete
                match stripped.expression:
                    Ast::Expr.Binary(left, TokenKind.EqEq, right, _):
                        primitive: (complete: bool, primitive: bool) = proof_linear_search_primitive_comparison(left, right, marker_result.witnesses, budget, PROOF_LINEAR_SAFETY_WORK_LIMIT, true)
                        return (false, false) if not primitive.complete or exhausted
                        continue if not primitive.primitive
                        for orientation in 0..<2 |orientation, left, right, facts, derived, budget, exhausted|:
                            consequence: Ast::Expr = right if orientation == 0 else left
                            cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(consequence, budget, exhausted)
                            return (false, false) if not cost.complete
                            # The cost walk is already charged. Reserve both local scans here;
                            # each can traverse the full expression when it finds no effect.
                            return (false, false) if not proof_linear_safety_work_charge_scaled(budget, exhausted, cost.cost, 2)
                            call_work: mutable usize = 0
                            move_work: mutable usize = 0
                            has_call: bool = proof_expr_has_call_with_work(consequence, &call_work, cost.cost)
                            has_move: bool = proof_expr_has_move_with_work(consequence, &move_work, cost.cost)
                            continue if has_call or has_move
                            present: mutable bool = false
                            for premise in facts |premise, consequence, present, budget, exhausted|:
                                return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                                contains: (complete: bool, contains: bool) = proof_linear_fact_contains_with_work(premise, consequence, 0, budget, exhausted)
                                return (false, false) if not contains.complete
                                present <- true if contains.contains
                            continue if present
                            summary: (complete: bool, proves: bool) = proof_linear_fact_proves_call_summary_with_work(facts, consequence, budget, exhausted)
                            return (false, false) if not summary.complete or exhausted
                            if summary.proves:
                                return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                                derived.push(consequence)
                    _:
                        pass
            return (true, false) if derived.count == 0
            return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, facts.count + derived.count)
            enriched: mutable darray[Ast::Expr] = []
            enriched.extend(facts)
            enriched.extend(derived)
            proves: bool = (proof_goal_depth(&enriched, goal, annotations, operator_mask, depth + 1, budget, split_depth, exhausted) can Global{Read,Write})
            return (false, false) if exhausted
            return (true, proves)

        def proof_linear_push_conjuncts_with_work(expression: Ast::Expr, conjuncts: mutable darray[Ast::Expr]&, depth: usize, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            if depth >= ElisaProofKernelCore::PROOF_KERNEL_STRUCTURAL_SCAN_DEPTH_LIMIT:
                budget <- PROOF_LINEAR_SAFETY_WORK_LIMIT
                exhausted <- true
                return false
            stripped: (complete: bool, expression: Ast::Expr) = proof_linear_strip_parens_with_work(expression, budget, exhausted)
            if not stripped.complete:
                budget <- PROOF_LINEAR_SAFETY_WORK_LIMIT
                exhausted <- true
                return false
            return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
            match stripped.expression:
                Ast::Expr.Binary(left, TokenKind.And, right, _):
                    return false if not proof_linear_push_conjuncts_with_work(left, conjuncts, depth + 1, budget, exhausted)
                    return proof_linear_push_conjuncts_with_work(right, conjuncts, depth + 1, budget, exhausted)
                _:
                    return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                    conjuncts.push(stripped.expression)
                    return true

        def proof_linear_readable_order_with_work(fact: Ast::Expr, facts: darray[Ast::Expr]&, markers: ProofScalarWitnesses&, marker_scale: usize, fact_scan_cost: usize, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, known: bool, left: Ast::Expr, operator: TokenKind, right: Ast::Expr):
            match fact:
                Ast::Expr.Binary(left, operator, right, _):
                    return (true, false, fact, TokenKind.Eof, fact) if not proof_is_order_operator(operator)
                    left_scalar: (complete: bool, matches: bool) = proof_linear_safety_scalar_witness_with_work(left, markers, marker_scale, budget, exhausted)
                    return (false, false, fact, TokenKind.Eof, fact) if not left_scalar.complete
                    return (true, false, fact, TokenKind.Eof, fact) if not left_scalar.matches
                    right_scalar: (complete: bool, matches: bool) = proof_linear_safety_scalar_witness_with_work(right, markers, marker_scale, budget, exhausted)
                    return (false, false, fact, TokenKind.Eof, fact) if not right_scalar.complete
                    return (right_scalar.complete, left_scalar.matches and right_scalar.matches, left, operator, right)
                Ast::Expr.Unary(TokenKind.Not, Ast::Expr.Binary(left, original_operator, right, _), _):
                    operator: TokenKind = proof_comparison_negation(original_operator)
                    return (true, false, fact, TokenKind.Eof, fact) if not proof_is_order_operator(operator)
                    left_scalar: (complete: bool, matches: bool) = proof_linear_safety_scalar_witness_with_work(left, markers, marker_scale, budget, exhausted)
                    return (false, false, fact, TokenKind.Eof, fact) if not left_scalar.complete
                    return (true, false, fact, TokenKind.Eof, fact) if not left_scalar.matches
                    right_scalar: (complete: bool, matches: bool) = proof_linear_safety_scalar_witness_with_work(right, markers, marker_scale, budget, exhausted)
                    return (false, false, fact, TokenKind.Eof, fact) if not right_scalar.complete
                    return (true, false, fact, TokenKind.Eof, fact) if not right_scalar.matches
                    left_integer: (complete: bool, integer: bool) = proof_disjunction_denial_integer_term_with_work(left, facts, markers, marker_scale, fact_scan_cost, 0, budget, exhausted)
                    return (false, false, fact, TokenKind.Eof, fact) if not left_integer.complete
                    return (true, false, fact, TokenKind.Eof, fact) if not left_integer.integer
                    right_integer: (complete: bool, integer: bool) = proof_disjunction_denial_integer_term_with_work(right, facts, markers, marker_scale, fact_scan_cost, 0, budget, exhausted)
                    return (false, false, fact, TokenKind.Eof, fact) if not right_integer.complete
                    return (right_integer.complete, left_integer.integer and right_integer.integer, left, operator, right)
                _:
                    return (true, false, fact, TokenKind.Eof, fact)

        def proof_linear_facts_order_complementary_with_work(facts: darray[Ast::Expr]&, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, complementary: bool):
            markers_result: (complete: bool, witnesses: ProofScalarWitnesses) = proof_scalar_witness_markers_with_work(facts, true, budget, exhausted)
            return (false, false) if not markers_result.complete or exhausted
            marker_scale_result: (complete: bool, scale: usize) = proof_linear_safety_marker_scale_with_work(markers_result.witnesses, budget, exhausted)
            return (false, false) if not marker_scale_result.complete or exhausted
            fact_scan_cost: mutable usize = 0
            for fact in facts |fact, fact_scan_cost, budget, exhausted|:
                return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(fact, budget, exhausted)
                return (false, false) if not cost.complete
                if cost.cost >= PROOF_LINEAR_SAFETY_WORK_LIMIT - fact_scan_cost:
                    budget <- PROOF_LINEAR_SAFETY_WORK_LIMIT
                    exhausted <- true
                    return (false, false)
                fact_scan_cost <- fact_scan_cost + cost.cost + 1
            conjuncts: mutable darray[Ast::Expr] = []
            for fact in facts |fact, conjuncts, budget, exhausted|:
                return (false, false) if not proof_linear_push_conjuncts_with_work(fact, &conjuncts, 0, budget, exhausted)
            lefts: mutable darray[Ast::Expr] = []
            operators: mutable darray[TokenKind] = []
            rights: mutable darray[Ast::Expr] = []
            for fact in conjuncts |fact, facts, markers_result, marker_scale_result, fact_scan_cost, lefts, operators, rights, budget, exhausted|:
                readable: (complete: bool, known: bool, left: Ast::Expr, operator: TokenKind, right: Ast::Expr) = proof_linear_readable_order_with_work(fact, facts, markers_result.witnesses, marker_scale_result.scale, fact_scan_cost, budget, exhausted)
                return (false, false) if not readable.complete
                if readable.known:
                    return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 3)
                    lefts.push(readable.left)
                    operators.push(readable.operator)
                    rights.push(readable.right)
            for first in 0..<lefts.count |first, lefts, operators, rights, budget, exhausted|:
                return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                complement: TokenKind = proof_comparison_negation(operators[first])
                mirror: TokenKind = proof_order_mirror(complement)
                for second in 0..<lefts.count |second, first, complement, mirror, lefts, operators, rights, budget, exhausted|:
                    return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                    same_operator: bool = operators[second] == complement
                    swapped_operator: bool = operators[second] == mirror
                    continue if not same_operator and not swapped_operator
                    if same_operator:
                        same_left: (complete: bool, matches: bool) = proof_linear_search_expr_equal_with_work(lefts[second], lefts[first], budget, PROOF_LINEAR_SAFETY_WORK_LIMIT, true)
                        return (false, false) if not same_left.complete
                        if same_left.matches:
                            same_right: (complete: bool, matches: bool) = proof_linear_search_expr_equal_with_work(rights[second], rights[first], budget, PROOF_LINEAR_SAFETY_WORK_LIMIT, true)
                            return (false, false) if not same_right.complete
                            return (true, true) if same_right.matches
                    if swapped_operator:
                        swapped_left: (complete: bool, matches: bool) = proof_linear_search_expr_equal_with_work(lefts[second], rights[first], budget, PROOF_LINEAR_SAFETY_WORK_LIMIT, true)
                        return (false, false) if not swapped_left.complete
                        if swapped_left.matches:
                            swapped_right: (complete: bool, matches: bool) = proof_linear_search_expr_equal_with_work(rights[second], lefts[first], budget, PROOF_LINEAR_SAFETY_WORK_LIMIT, true)
                            return (false, false) if not swapped_right.complete
                            return (true, true) if swapped_right.matches
            return (true, false)
