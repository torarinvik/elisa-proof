# Set while a function with a floating-point parameter is checked. IEEE values are not a
        # field: NaN breaks reflexivity and trichotomy, rounding breaks associativity, and +0 == -0
        # breaks substitution. Float-bearing goals use only exact fact containment or the separate
        # Boolean-only atom model below; no float comparison is interpreted numerically.
global mutable proof_float_mode: bool

extend ElisaProof:
    private:
        def proof_float_goal(facts: darray[Ast::Expr]&, goal: Ast::Expr) -> bool:
            for fact in facts:
                return true if proof_fact_contains(fact, goal)
            return false

        # Float mode may still contain integer bounds. Admit those using exact integer
        # type witnesses, and drop every numeric premise involving an IEEE value.
        def proof_float_integer_fragment(expression: Ast::Expr, facts: darray[Ast::Expr]&, depth: usize) -> bool:
            return false if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            match expression:
                Ast::Expr.BoolLit(_, _):
                    return true
                Ast::Expr.Paren(inner, _) | Ast::Expr.Unary(TokenKind.Not, inner, _):
                    return proof_float_integer_fragment(inner, facts, depth + 1)
                Ast::Expr.Binary(left, operator, right, _):
                    return proof_float_integer_fragment(left, facts, depth + 1) and proof_float_integer_fragment(right, facts, depth + 1) if operator == TokenKind.And or operator == TokenKind.Or
                    comparison: bool = operator == TokenKind.EqEq or operator == TokenKind.BangEq or operator == TokenKind.Lt or operator == TokenKind.LtEq or operator == TokenKind.Gt or operator == TokenKind.GtEq
                    return comparison and proof_primitive_comparison(left, right, facts) and proof_disjunction_denial_integer_term(left, facts, depth + 1) and proof_disjunction_denial_integer_term(right, facts, depth + 1)
                _:
                    return false

        def proof_float_integer_marker(expression: Ast::Expr, facts: darray[Ast::Expr]&) -> bool:
            return true if proof_unsigned_place_marker_info(expression).known or proof_signed_marker_info(expression).known or proof_signed_place_marker_info(expression).known
            match expression:
                Ast::Expr.Call(callee, arguments, _, _):
                    return false if proof_ident_name(callee) != "__elisa_primitive_scalar_type" or arguments.count != 1
                    return proof_disjunction_denial_integer_term(arguments[0], facts, 0)
                _:
                    return false

        def proof_float_integer_goal(facts: darray[Ast::Expr]&, goal: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, operator_mask: usize, exhausted: mutable bool&) -> bool:
            return false if not proof_float_integer_fragment(goal, facts, 0)
            integers: mutable darray[Ast::Expr] = []
            for fact in facts |integers|:
                integers.push(fact) if proof_float_integer_marker(fact, facts) or proof_float_integer_fragment(fact, facts, 0)
            return false if not proof_state_literals_fit(integers, goal, annotations)
            budget: mutable usize = 0
            return proof_goal_depth(integers, goal, annotations, operator_mask, 0, budget, 0, exhausted)

        def proof_goal_with_operator_mask(facts: darray[Ast::Expr]&, goal: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, operator_mask: usize, exhausted: mutable bool&) -> bool:
            return proof_float_goal(facts, goal) or proof_float_propositional_goal(facts, goal, operator_mask) or proof_float_integer_goal(facts, goal, annotations, operator_mask, exhausted) if proof_float_mode
            return false if not proof_state_literals_fit(facts, goal, annotations)
            budget: mutable usize = 0
            return proof_goal_depth(facts, goal, annotations, operator_mask, 0, budget, 0, exhausted)

        def proof_goal_fact_is_disjunction(fact: Ast::Expr) -> bool:
            match fact:
                Ast::Expr.Binary(_, operator, _, _):
                    return operator == TokenKind.Or
                Ast::Expr.Paren(inner, _):
                    return proof_goal_fact_is_disjunction(inner)
                Ast::Expr.Unary(TokenKind.Not, inner, _):
                    match proof_strip_parens(inner):
                        Ast::Expr.Binary(_, TokenKind.And, _, _):
                            return true
                        _:
                            pass
                _:
                    return false
            return false

    public:
        def proof_goal_with_limits(facts: darray[Ast::Expr]&, goal: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, exhausted: mutable bool&) -> bool:
            operator_mask: usize = proof_source_primitive_operator_mask(annotations)
            return proof_goal_with_operator_mask(facts, goal, annotations, operator_mask, exhausted)

        def proof_goal(facts: darray[Ast::Expr]&, goal: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&) -> bool:
            # Dropping hypotheses only weakens them, so facts without a disjunction are tried
            # first: their search has no case splits, and most goals beside a disjunctive loop
            # update (`found <- index if c == 32 or c == 9 ...`) or a helper summary
            # `not f(x) or (x == 32 or x == 9)` need only the loop range. Recognize both `A or B`
            # and `not (A and B)` as disjunctive facts, so equivalent branch conditions get the
            # same cheap attempt. Splitting first made such loops ~17x slower. The full facts
            # remain the fallback.
            plain: mutable darray[Ast::Expr] = []
            for fact in facts |plain|:
                plain.push(fact) if not proof_goal_fact_is_disjunction(fact)
            if plain.count < facts.count:
                cheap: mutable bool = false
                return true if proof_goal_with_limits(plain, goal, annotations, &cheap)
            exhausted: mutable bool = false
            return proof_goal_with_limits(facts, goal, annotations, &exhausted)
