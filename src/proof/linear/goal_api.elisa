# Set while a function with a floating-point parameter is checked. IEEE values are not a
        # field: NaN breaks reflexivity and trichotomy, rounding breaks associativity, and +0 == -0
        # breaks substitution. Float-bearing goals use only exact fact containment or the separate
        # Boolean-only atom model below; no float comparison is interpreted numerically.
global mutable proof_float_mode: bool

extend ElisaProof:
    public:
        const PROOF_LINEAR_TACTIC_PREFLIGHT_WORK_LIMIT: usize = 1073741824
    private:
        def proof_goal_tactic_preflight_charge(work: mutable usize&, amount: usize) -> bool:
            return false if work > PROOF_LINEAR_TACTIC_PREFLIGHT_WORK_LIMIT
            if amount > PROOF_LINEAR_TACTIC_PREFLIGHT_WORK_LIMIT - work:
                work <- PROOF_LINEAR_TACTIC_PREFLIGHT_WORK_LIMIT
                return false
            work <- work + amount
            return true

        def proof_goal_tactic_preflight_charge_scaled(work: mutable usize&, amount: usize, multiplier: usize) -> bool:
            return false if work > PROOF_LINEAR_TACTIC_PREFLIGHT_WORK_LIMIT
            return true if amount == 0 or multiplier == 0
            if amount > (PROOF_LINEAR_TACTIC_PREFLIGHT_WORK_LIMIT - work) / multiplier:
                work <- PROOF_LINEAR_TACTIC_PREFLIGHT_WORK_LIMIT
                return false
            return proof_goal_tactic_preflight_charge(&work, amount * multiplier)

        # Find potential literal-width probes in one bottom-up walk. The previous detector
        # rescanned each nested comparison's subtrees and queried literal annotations before
        # reserving cubic work; a deeply nested expression could therefore spend quadratic work
        # outside the budget. This deliberately over-approximates closed literals, and treats a
        # depth cutoff as requiring validation, so it only reserves extra fuel or declines.
        def proof_goal_literal_width_probe(expression: Ast::Expr, depth: usize) -> (contains_integer: bool, required: bool):
            return (true, true) if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            match expression:
                Ast::Expr.Paren(inner, _) | Ast::Expr.Unary(_, inner, _):
                    return proof_goal_literal_width_probe(inner, depth + 1)
                Ast::Expr.If(condition, then_expression, else_expression, _):
                    condition_result: (contains_integer: bool, required: bool) = proof_goal_literal_width_probe(condition, depth + 1)
                    then_result: (contains_integer: bool, required: bool) = proof_goal_literal_width_probe(then_expression, depth + 1)
                    else_result: (contains_integer: bool, required: bool) = proof_goal_literal_width_probe(else_expression, depth + 1)
                    return (condition_result.contains_integer or then_result.contains_integer or else_result.contains_integer, condition_result.required or then_result.required or else_result.required)
                Ast::Expr.Binary(left, operator, right, _):
                    left_result: (contains_integer: bool, required: bool) = proof_goal_literal_width_probe(left, depth + 1)
                    right_result: (contains_integer: bool, required: bool) = proof_goal_literal_width_probe(right, depth + 1)
                    candidate: bool = proof_is_comparison(operator) or proof_literal_width_arithmetic(operator)
                    return (left_result.contains_integer or right_result.contains_integer, left_result.required or right_result.required or (candidate and (left_result.contains_integer or right_result.contains_integer)))
                Ast::Expr.IntLit(_, _):
                    return (true, false)
                Ast::Expr.Field(Ast::Expr.Array(elements, _), "count", _):
                    return (true, false) if proof_small_literal_count(elements.count).known
                    return (false, false)
                _:
                    return (false, false)

        # Float-mode exact containment uses the work-aware reader, charging structural scans
        # before comparing facts and preserving budget for the guarded propositional fallback.
        # Conjunction projection is valid only inside the same side-effect-free, built-in
        # fragment as the float Boolean solver. Otherwise an opaque call nested in `A and B`
        # could be projected into a separately evaluated goal.
        def proof_float_goal_with_work(facts: darray[Ast::Expr]&, goal: Ast::Expr, operator_mask: usize, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            goal_cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(goal, budget, exhausted)
            return false if not goal_cost.complete or exhausted
            return false if not proof_linear_safety_work_charge_scaled(budget, exhausted, goal_cost.cost, 6) or exhausted
            return false if not proof_float_boolean_formula(goal, operator_mask, 0)
            for fact in facts |fact, goal, budget, exhausted|:
                fact_cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(fact, budget, exhausted)
                return false if not fact_cost.complete or exhausted
                return false if not proof_linear_safety_work_charge_scaled(budget, exhausted, fact_cost.cost, 6) or exhausted
                continue if not proof_float_boolean_formula(fact, operator_mask, 0)
                contains: (complete: bool, contains: bool) = proof_linear_fact_contains_with_work(fact, goal, 0, budget, exhausted)
                if not contains.complete:
                    budget <- PROOF_LINEAR_SAFETY_WORK_LIMIT
                    exhausted <- true
                    return false
                return true if contains.contains
            return false

        def proof_goal_with_operator_mask_and_work(facts: darray[Ast::Expr]&, goal: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, operator_mask: usize, literals_preflighted: bool, literal_width_required: bool, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            if (proof_float_mode can Global.Read):
                return true if proof_float_goal_with_work(facts, goal, operator_mask, budget, exhausted)
                return false if exhausted
                return (proof_float_propositional_goal_with_shared_work(facts, goal, operator_mask, &budget, PROOF_LINEAR_SAFETY_WORK_LIMIT) can Global.Read)
            if literals_preflighted:
                return false if literal_width_required and not proof_state_literals_fit(facts, goal, annotations)
            else:
                return false if not proof_goal_literals_fit_with_work(facts, goal, annotations, budget, exhausted)
                return false if exhausted
            return (proof_goal_depth(facts, goal, annotations, operator_mask, 0, budget, 0, exhausted) can Global{Read,Write})

        def proof_goal_literals_fit_with_work(facts: darray[Ast::Expr]&, goal: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            goal_cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(goal, budget, exhausted)
            return false if not goal_cost.complete or exhausted
            total_cost: mutable usize = goal_cost.cost
            for fact in facts |fact, total_cost, budget, exhausted|:
                fact_cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(fact, budget, exhausted)
                return false if not fact_cost.complete or exhausted or fact_cost.cost > PROOF_LINEAR_SAFETY_WORK_LIMIT - total_cost
                total_cost <- total_cost + fact_cost.cost
            for annotation in annotations |annotation, total_cost, budget, exhausted|:
                owner_cost: usize = sview_len(annotation.owner)
                annotation_name_cost: usize = sview_len(annotation.name)
                return false if total_cost >= PROOF_LINEAR_SAFETY_WORK_LIMIT or owner_cost >= PROOF_LINEAR_SAFETY_WORK_LIMIT - total_cost
                remaining: usize = PROOF_LINEAR_SAFETY_WORK_LIMIT - total_cost - owner_cost
                return false if annotation_name_cost >= remaining
                name_cost: usize = owner_cost + annotation_name_cost + 1
                return false if not proof_linear_safety_work_charge(budget, exhausted, name_cost)
                total_cost <- total_cost + name_cost
            # This single-pass probe determines whether any literal can require a type-width
            # check. Its work is charged independently from shape measurement above.
            return false if not proof_linear_safety_work_charge(budget, exhausted, total_cost)
            goal_probe: (contains_integer: bool, required: bool) = proof_goal_literal_width_probe(goal, 0)
            required: mutable bool = goal_probe.required
            for fact in facts |fact, required|:
                probe: (contains_integer: bool, required: bool) = proof_goal_literal_width_probe(fact, 0)
                required <- required or probe.required
            return true if not required
            # The legacy literal validator may revisit subtrees and rescan all marker facts
            # for each arithmetic node. Reserve the product before invoking it.
            return false if not proof_linear_safety_work_charge_product4_with_work(budget, exhausted, total_cost, total_cost, total_cost, 1, 1)
            proof_state_literals_fit(facts, goal, annotations)

        def proof_goal_with_operator_mask(facts: darray[Ast::Expr]&, goal: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, operator_mask: usize, exhausted: mutable bool&) -> bool:
            budget: mutable usize = 0
            return (proof_goal_with_operator_mask_and_work(facts, goal, annotations, operator_mask, false, false, &budget, &exhausted) can Global{Read,Write})

        def proof_goal_fact_is_disjunction_with_work(fact: Ast::Expr, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, is_disjunction: bool):
            stripped: (complete: bool, expression: Ast::Expr) = proof_linear_strip_parens_with_work(fact, budget, exhausted)
            return (false, false) if not stripped.complete
            match stripped.expression:
                Ast::Expr.Binary(_, TokenKind.Or, _, _):
                    return (true, true)
                Ast::Expr.Unary(TokenKind.Not, inner, _):
                    equality: (complete: bool, expression: Ast::Expr) = proof_linear_strip_parens_with_work(inner, budget, exhausted)
                    return (false, false) if not equality.complete
                    match equality.expression:
                        Ast::Expr.Binary(_, TokenKind.And, _, _):
                            return (true, true)
                        _:
                            return (true, false)
                _:
                    return (true, false)

    public:
        def proof_goal_with_limits(facts: darray[Ast::Expr]&, goal: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, exhausted: mutable bool&) -> bool can[Global{Read,Write}]:
            operator_mask: usize = proof_source_primitive_operator_mask(annotations)
            return (proof_goal_with_operator_mask(facts, goal, annotations, operator_mask, exhausted) can Global{Read,Write})

        # Imported tactic trees pass one counter through every solver-backed action and its
        # deterministic replay. Keeping this overload separate preserves ordinary checker fuel.
        def proof_goal_with_shared_work(facts: darray[Ast::Expr]&, goal: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, operator_mask: usize, budget: mutable usize&, preflight_work: mutable usize&) -> bool can[Global{Read,Write}]:
            # The legacy preflight readers (literal validation, disjunction filtering, and
            # float-safe containment) are pure recursive scans. Reserve their worst-case
            # repeated traversal cost before invoking them, then let proof_goal_depth continue
            # from the same counter. This bounds repeated action calls as well as enumeration.
            return false if budget >= PROOF_LINEAR_MAX_ENUMERATED_ELEMENTS or preflight_work >= PROOF_LINEAR_TACTIC_PREFLIGHT_WORK_LIMIT
            exhausted: mutable bool = false
            goal_cost: mutable usize = 0
            return false if not proof_replay_summary_expr_cost_with_limit(goal, &goal_cost, 0, PROOF_LINEAR_MAX_ENUMERATED_ELEMENTS)
            return false if not proof_goal_tactic_preflight_charge_scaled(&preflight_work, goal_cost, PROOF_LINEAR_SAFETY_SCAN_MULTIPLIER)
            shape_cost: mutable usize = goal_cost
            for fact in facts |fact, preflight_work, shape_cost|:
                fact_cost: mutable usize = 0
                return false if not proof_replay_summary_expr_cost_with_limit(fact, &fact_cost, 0, PROOF_LINEAR_MAX_ENUMERATED_ELEMENTS)
                return false if not proof_goal_tactic_preflight_charge_scaled(&preflight_work, fact_cost, PROOF_LINEAR_SAFETY_SCAN_MULTIPLIER)
                return false if fact_cost > PROOF_LINEAR_TACTIC_PREFLIGHT_WORK_LIMIT - shape_cost
                shape_cost <- shape_cost + fact_cost
            for annotation in annotations |annotation, shape_cost, preflight_work|:
                return false if not proof_goal_tactic_preflight_charge(&preflight_work, 1)
                owner_cost: usize = sview_len(annotation.owner)
                name_cost: usize = sview_len(annotation.name)
                return false if:
                    not proof_goal_tactic_preflight_charge(&preflight_work, owner_cost)
                    not proof_goal_tactic_preflight_charge(&preflight_work, name_cost)
                if shape_cost >= PROOF_LINEAR_TACTIC_PREFLIGHT_WORK_LIMIT:
                    preflight_work <- PROOF_LINEAR_TACTIC_PREFLIGHT_WORK_LIMIT
                    return false
                remaining_shape: usize = PROOF_LINEAR_TACTIC_PREFLIGHT_WORK_LIMIT - shape_cost
                if owner_cost >= remaining_shape or name_cost > remaining_shape - owner_cost - 1:
                    preflight_work <- PROOF_LINEAR_TACTIC_PREFLIGHT_WORK_LIMIT
                    return false
                shape_cost <- shape_cost + owner_cost + name_cost + 1
            if (proof_float_mode can Global.Read):
                if shape_cost == 0 or shape_cost > PROOF_LINEAR_TACTIC_PREFLIGHT_WORK_LIMIT / shape_cost:
                    preflight_work <- PROOF_LINEAR_TACTIC_PREFLIGHT_WORK_LIMIT
                    return false
                float_square_cost: usize = shape_cost * shape_cost
                # Reserve the guarded exact-containment scans before invoking them. If F is the
                # total fact shape and G the goal shape, candidate-subtree costs sum to at most
                # F^2, while repeated goal costs are at most F*G. Together these are bounded by
                # (F+G)^2 = S^2; each equality reserves six shape passes. Input sizing, formula
                # checks, and recursion-node charges add at most 16*S. The factor 8 leaves
                # margin without reserving 16 passes for every candidate pair.
                return false if not proof_goal_tactic_preflight_charge_scaled(&preflight_work, float_square_cost, 8)
                return false if not proof_goal_tactic_preflight_charge_scaled(&preflight_work, shape_cost, 16)
                float_work: mutable usize = 0
                float_exhausted: mutable bool = false
                float_contained: bool = proof_float_goal_with_work(facts, goal, operator_mask, &float_work, &float_exhausted)
                return true if float_contained
                # The full exact-scan worst case is already reserved above. If its local cap
                # declines the shortcut, let the independently guarded propositional solver use
                # whatever aggregate allowance remains; its own exhaustion still fails closed.
                return (proof_float_propositional_goal_with_shared_work(facts, goal, operator_mask, &preflight_work, PROOF_LINEAR_TACTIC_PREFLIGHT_WORK_LIMIT) can Global.Read)
            goal_width_probe: (contains_integer: bool, required: bool) = proof_goal_literal_width_probe(goal, 0)
            width_probe_required: mutable bool = goal_width_probe.required
            for fact in facts |fact, width_probe_required|:
                fact_width_probe: (contains_integer: bool, required: bool) = proof_goal_literal_width_probe(fact, 0)
                width_probe_required <- width_probe_required or fact_width_probe.required
            if width_probe_required:
                # Literal-width validation nests AST walks over facts and typed markers. Bound
                # expression × fact × marker comparisons for both the plain and full attempts.
                if shape_cost == 0 or shape_cost > PROOF_LINEAR_TACTIC_PREFLIGHT_WORK_LIMIT / shape_cost:
                    preflight_work <- PROOF_LINEAR_TACTIC_PREFLIGHT_WORK_LIMIT
                    return false
                square_cost: usize = shape_cost * shape_cost
                if square_cost > PROOF_LINEAR_TACTIC_PREFLIGHT_WORK_LIMIT / shape_cost:
                    preflight_work <- PROOF_LINEAR_TACTIC_PREFLIGHT_WORK_LIMIT
                    return false
                cubic_cost: usize = square_cost * shape_cost
                return false if not proof_goal_tactic_preflight_charge_scaled(&preflight_work, cubic_cost, 2)
            plain: mutable darray[Ast::Expr] = []
            for fact in facts |plain, budget, exhausted|:
                disjunction: (complete: bool, is_disjunction: bool) = proof_goal_fact_is_disjunction_with_work(fact, &budget, &exhausted)
                return false if not disjunction.complete or exhausted
                plain.push(fact) if not disjunction.is_disjunction
            if plain.count < facts.count:
                plain_proven: bool = (proof_goal_with_operator_mask_and_work(plain, goal, annotations, operator_mask, true, width_probe_required, &budget, &exhausted) can Global{Read,Write})
                return true if plain_proven
                return false if exhausted or budget >= PROOF_LINEAR_MAX_ENUMERATED_ELEMENTS
            return (proof_goal_with_operator_mask_and_work(facts, goal, annotations, operator_mask, true, width_probe_required, &budget, &exhausted) can Global{Read,Write})

        def proof_goal_with_precomputed_operator_mask(facts: darray[Ast::Expr]&, goal: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, operator_mask: usize) -> bool can[Global{Read,Write}]:
            # Dropping hypotheses only weakens them, so facts without a disjunction are tried
            # first: their search has no case splits, and most goals beside a disjunctive loop
            # update (`found <- index if c == 32 or c == 9 ...`) or a helper summary
            # `not f(x) or (x == 32 or x == 9)` need only the loop range. Recognize both `A or B`
            # and `not (A and B)` as disjunctive facts, so equivalent branch conditions get the
            # same cheap attempt. Splitting first made such loops ~17x slower. The full facts
            # remain the fallback.
            plain: mutable darray[Ast::Expr] = []
            budget: mutable usize = 0
            exhausted: mutable bool = false
            for fact in facts |plain, budget, exhausted|:
                disjunction: (complete: bool, is_disjunction: bool) = proof_goal_fact_is_disjunction_with_work(fact, &budget, &exhausted)
                return false if not disjunction.complete or exhausted
                plain.push(fact) if not disjunction.is_disjunction
            if plain.count < facts.count:
                plain_proven: bool = (proof_goal_with_operator_mask_and_work(plain, goal, annotations, operator_mask, false, false, &budget, &exhausted) can Global{Read,Write})
                return true if plain_proven
                return false if exhausted
            return (proof_goal_with_operator_mask_and_work(facts, goal, annotations, operator_mask, false, false, &budget, &exhausted) can Global{Read,Write})

        def proof_goal(facts: darray[Ast::Expr]&, goal: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&) -> bool can[Global{Read,Write}]:
            operator_mask: usize = proof_source_primitive_operator_mask(annotations)
            return (proof_goal_with_precomputed_operator_mask(facts, goal, annotations, operator_mask) can Global{Read,Write})
