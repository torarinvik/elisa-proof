extend ElisaProof:
    private:
        def proof_goal_with_operator_mask(facts: darray[Ast::Expr]&, goal: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, operator_mask: usize, exhausted: mutable bool&) -> bool:
            return false if not proof_state_literals_fit(facts, goal, annotations)
            budget: mutable usize = 0
            return proof_goal_depth(facts, goal, annotations, operator_mask, 0, budget, 0, exhausted)

        def proof_goal_fact_is_disjunction(fact: Ast::Expr) -> bool:
            match fact:
                Ast::Expr.Binary(_, operator, _, _):
                    return operator == TokenKind.Or
                Ast::Expr.Paren(inner, _):
                    return proof_goal_fact_is_disjunction(inner)
                _:
                    return false

    public:
        def proof_goal_with_limits(facts: darray[Ast::Expr]&, goal: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, exhausted: mutable bool&) -> bool:
            operator_mask: usize = proof_source_primitive_operator_mask(annotations)
            return proof_goal_with_operator_mask(facts, goal, annotations, operator_mask, exhausted)

        def proof_goal(facts: darray[Ast::Expr]&, goal: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&) -> bool:
            exhausted: mutable bool = false
            return true if proof_goal_with_limits(facts, goal, annotations, &exhausted)
            # Dropping hypotheses only weakens them, so a goal the search refused or ran out of budget on
            # may still be proved from the facts without a top-level disjunction, whose case
            # splits are what exhaust it: a helper summary `not f(x) or (x == 32 or x == 9)`
            # beside the loop range that alone proves `start <= index`.
            plain: mutable darray[Ast::Expr] = []
            for fact in facts |plain|:
                plain.push(fact) if not proof_goal_fact_is_disjunction(fact)
            return false if plain.count == facts.count
            retried: mutable bool = false
            return proof_goal_with_limits(plain, goal, annotations, &retried)
