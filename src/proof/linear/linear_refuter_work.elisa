# Work-aware Fourier-Motzkin refutation for source-side linear pruning.
extend ElisaProof:
    private:
        def proof_linear_collect_with_work(expression: Ast::Expr, sign: i64, signed: bool, signed_only: bool, facts: darray[Ast::Expr]&, markers: ProofScalarWitnesses&, marker_scale: usize, terms: mutable darray[ProofNormalTerm]&, depth: usize, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            can Abort.Panic:
                return false if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT or terms.count >= PROOF_LINEAR_FM_TERM_LIMIT or proof_goal_bool_ref_value(exhausted)
                return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                match expression:
                    Ast::Expr.Paren(inner, _):
                        return proof_linear_collect_with_work(inner, sign, signed, signed_only, facts, markers, marker_scale, terms, depth + 1, budget, exhausted)
                    Ast::Expr.IntLit(value, _):
                        return false if value < 0
                        scaled: (known: bool, value: i64) = proof_mul_safe(value, sign)
                        return false if not scaled.known
                        terms.push(ProofNormalTerm{name: "", coefficient: scaled.value})
                        return true
                    Ast::Expr.Ident(name, _):
                        width: mutable i64 = 0
                        if signed_only:
                            width <- proof_signed_width_in_expression_with_scale_work(expression, markers, 0, marker_scale, budget, exhausted)
                        else:
                            width <- proof_unsigned_width_in_expression_with_work(expression, markers, budget, exhausted)
                            if width == 0 and not proof_goal_bool_ref_value(exhausted):
                                width <- proof_signed_width_in_expression_with_scale_work(expression, markers, 0, marker_scale, budget, exhausted)
                        return false if name == "" or width == 0 or proof_goal_bool_ref_value(exhausted)
                        terms.push(ProofNormalTerm{name: name, coefficient: sign})
                        return true
                    Ast::Expr.Unary(operator, operand, _):
                        return false if operator != TokenKind.Plus and operator != TokenKind.Minus
                        negated: (known: bool, value: i64) = proof_signed_negated_literal(expression, signed)
                        if negated.known:
                            scaled: (known: bool, value: i64) = proof_mul_safe(negated.value, sign)
                            return false if not scaled.known
                            terms.push(ProofNormalTerm{name: "", coefficient: scaled.value})
                            return true
                        width: mutable i64 = 0
                        if signed_only:
                            width <- proof_signed_width_in_expression_with_scale_work(expression, markers, 0, marker_scale, budget, exhausted)
                        else:
                            width <- proof_unsigned_width_in_expression_with_work(expression, markers, budget, exhausted)
                            if width == 0 and not proof_goal_bool_ref_value(exhausted):
                                width <- proof_signed_width_in_expression_with_scale_work(expression, markers, 0, marker_scale, budget, exhausted)
                        return false if width == 0 or proof_goal_bool_ref_value(exhausted)
                        flipped: (known: bool, value: i64) = proof_sub_safe(0, sign)
                        return false if not flipped.known
                        return proof_linear_collect_with_work(operand, sign if operator == TokenKind.Plus else flipped.value, signed, signed_only, facts, markers, marker_scale, terms, depth + 1, budget, exhausted)
                    Ast::Expr.Binary(left, operator, right, _):
                        if operator == TokenKind.Star:
                            left_literal: (complete: bool, known: bool, value: i64) = proof_linear_literal_with_work(left, budget, PROOF_LINEAR_SAFETY_WORK_LIMIT, true, 0)
                            return false if not left_literal.complete
                            right_literal: (complete: bool, known: bool, value: i64) = proof_linear_literal_with_work(right, budget, PROOF_LINEAR_SAFETY_WORK_LIMIT, true, 0)
                            return false if not right_literal.complete
                            if left_literal.known and right_literal.known and (left_literal.value <= 1 or right_literal.value <= 1):
                                product: (known: bool, value: i64) = proof_mul_safe(left_literal.value, right_literal.value)
                                return false if not product.known
                                scaled_product: (known: bool, value: i64) = proof_mul_safe(product.value, sign)
                                return false if not scaled_product.known
                                terms.push(ProofNormalTerm{name: "", coefficient: scaled_product.value})
                                return true
                        return false if operator != TokenKind.Star and operator != TokenKind.Plus and operator != TokenKind.Minus
                        width: mutable i64 = 0
                        if signed_only:
                            width <- proof_signed_width_in_expression_with_scale_work(expression, markers, 0, marker_scale, budget, exhausted)
                        else:
                            width <- proof_unsigned_width_in_expression_with_work(expression, markers, budget, exhausted)
                            if width == 0 and not proof_goal_bool_ref_value(exhausted):
                                width <- proof_signed_width_in_expression_with_scale_work(expression, markers, 0, marker_scale, budget, exhausted)
                        return false if width == 0 or proof_goal_bool_ref_value(exhausted)
                        if operator == TokenKind.Star:
                            left_scale: (complete: bool, known: bool, value: i64) = proof_linear_literal_with_work(left, budget, PROOF_LINEAR_SAFETY_WORK_LIMIT, true, 0)
                            return false if not left_scale.complete
                            if left_scale.known:
                                scaled: (known: bool, value: i64) = proof_mul_safe(left_scale.value, sign)
                                return false if not scaled.known
                                return proof_linear_collect_with_work(right, scaled.value, signed, signed_only, facts, markers, marker_scale, terms, depth + 1, budget, exhausted)
                            right_scale: (complete: bool, known: bool, value: i64) = proof_linear_literal_with_work(right, budget, PROOF_LINEAR_SAFETY_WORK_LIMIT, true, 0)
                            return false if not right_scale.complete or not right_scale.known
                            scaled: (known: bool, value: i64) = proof_mul_safe(right_scale.value, sign)
                            return false if not scaled.known
                            return proof_linear_collect_with_work(left, scaled.value, signed, signed_only, facts, markers, marker_scale, terms, depth + 1, budget, exhausted)
                        return false if not proof_linear_collect_with_work(left, sign, signed, signed_only, facts, markers, marker_scale, terms, depth + 1, budget, exhausted)
                        flipped: (known: bool, value: i64) = proof_sub_safe(0, sign)
                        return false if not flipped.known
                        return proof_linear_collect_with_work(right, sign if operator == TokenKind.Plus else flipped.value, signed, signed_only, facts, markers, marker_scale, terms, depth + 1, budget, exhausted)
                    _:
                        return false

        def proof_linear_push_order_with_work(lower: Ast::Expr, upper: Ast::Expr, strict: bool, signed: bool, signed_only: bool, facts: darray[Ast::Expr]&, markers: ProofScalarWitnesses&, marker_scale: usize, terms: mutable darray[ProofNormalTerm]&, spans: mutable darray[ProofLinearSpan]&, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            can Abort.Panic:
                return false if spans.count >= PROOF_LINEAR_FM_CONSTRAINT_LIMIT or proof_goal_bool_ref_value(exhausted)
                start: usize = terms.count
                return false if not proof_linear_collect_with_work(lower, 1, signed, signed_only, facts, markers, marker_scale, terms, 0, budget, exhausted)
                return false if not proof_linear_collect_with_work(upper, -1, signed, signed_only, facts, markers, marker_scale, terms, 0, budget, exhausted)
                if strict:
                    return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                    terms.push(ProofNormalTerm{name: "", coefficient: 1})
                return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                spans.push(ProofLinearSpan{start: start, stop: terms.count})
                return true

        def proof_linear_push_comparison_with_work(left: Ast::Expr, operator: TokenKind, right: Ast::Expr, signed_only: bool, facts: darray[Ast::Expr]&, markers: ProofScalarWitnesses&, marker_scale: usize, terms: mutable darray[ProofNormalTerm]&, spans: mutable darray[ProofLinearSpan]&, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            can Abort.Panic:
                signed_result: (complete: bool, signed: bool) = proof_normal_comparison_signed_with_witnesses_work(left, right, facts, markers, budget, PROOF_LINEAR_SAFETY_WORK_LIMIT, true)
                return false if not signed_result.complete or proof_goal_bool_ref_value(exhausted)
                signed: bool = signed_result.signed
                if operator == TokenKind.Lt:
                    return proof_linear_push_order_with_work(left, right, true, signed, signed_only, facts, markers, marker_scale, terms, spans, budget, exhausted)
                elif operator == TokenKind.LtEq:
                    return proof_linear_push_order_with_work(left, right, false, signed, signed_only, facts, markers, marker_scale, terms, spans, budget, exhausted)
                elif operator == TokenKind.Gt:
                    return proof_linear_push_order_with_work(right, left, true, signed, signed_only, facts, markers, marker_scale, terms, spans, budget, exhausted)
                elif operator == TokenKind.GtEq:
                    return proof_linear_push_order_with_work(right, left, false, signed, signed_only, facts, markers, marker_scale, terms, spans, budget, exhausted)
                elif operator == TokenKind.EqEq:
                    return proof_linear_push_order_with_work(left, right, false, signed, signed_only, facts, markers, marker_scale, terms, spans, budget, exhausted) and proof_linear_push_order_with_work(right, left, false, signed, signed_only, facts, markers, marker_scale, terms, spans, budget, exhausted)
                return false

        def proof_linear_fm_gcd_with_work(left: i64, right: i64, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, divisor: i64):
            a: mutable i64 = left
            b: mutable i64 = right
            if a < 0:
                magnitude: (known: bool, value: i64) = proof_sub_safe(0, a)
                return (false, 0) if not magnitude.known
                a <- magnitude.value
            if b < 0:
                magnitude: (known: bool, value: i64) = proof_sub_safe(0, b)
                return (false, 0) if not magnitude.known
                b <- magnitude.value
            for step in 0..<128 |step, a, b, budget, exhausted|:
                return (true, a) if b == 0 and a > 0
                return (true, 1) if b == 0
                return (false, 0) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                remainder: i64 = a % b
                a <- b
                b <- remainder
            return (true, a) if a > 0 else (true, 1)

        def proof_linear_farkas_valid_with_work(original: darray[i64]&, atom_count: usize, width: usize, multipliers: darray[i64]&, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            any_positive: mutable bool = false
            for multiplier in multipliers |multiplier, any_positive, budget, exhausted|:
                return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                return false if multiplier < 0
                any_positive <- true if multiplier > 0
            return false if not any_positive
            for column in 0..<(atom_count + 1) |column, original, atom_count, width, multipliers, budget, exhausted|:
                total: mutable i64 = 0
                for index in 0..<multipliers.count |index, column, original, width, multipliers, total, budget, exhausted|:
                    return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                    product: (known: bool, value: i64) = proof_mul_safe(multipliers[index], original[index * width + column])
                    return false if not product.known
                    summed: (known: bool, value: i64) = proof_add_safe(total, product.value)
                    return false if not summed.known
                    total <- summed.value
                return false if (column < atom_count and total != 0) or (column == atom_count and total <= 0)
            return true

        def proof_linear_refutes_with_work(terms: darray[ProofNormalTerm]&, spans: darray[ProofLinearSpan]&, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, refutes: bool):
            can Abort.Panic:
                count: usize = spans.count
                return (true, false) if count == 0 or count > PROOF_LINEAR_FM_CONSTRAINT_LIMIT
                atoms: mutable darray[sview] = []
                for span in spans |span, terms, atoms, budget, exhausted|:
                    return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                    return (false, false) if span.start > span.stop or span.stop > terms.count
                    for position in span.start..<span.stop |position, terms, atoms, budget, exhausted|:
                        return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                        term: ProofNormalTerm = terms[position]
                        continue if term.name == ""
                        seen: mutable bool = false
                        for atom in atoms |atom, term, seen, budget, exhausted|:
                            return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                            return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, sview_len(atom)) or not proof_linear_safety_work_charge(budget, exhausted, sview_len(term.name))
                            seen <- true if atom == term.name
                        if not seen:
                            return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1) or not proof_linear_safety_work_charge(budget, exhausted, sview_len(term.name))
                            atoms.push(term.name)
                return (true, false) if atoms.count > PROOF_LINEAR_FM_ATOM_LIMIT
                width: usize = atoms.count + 1 + count
                original: mutable darray[i64] = []
                for index in 0..<count |index, spans, terms, atoms, width, count, original, budget, exhausted|:
                    return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                    row_start: usize = original.count
                    for column in 0..<width |column, original, budget, exhausted|:
                        return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                        original.push(0)
                    span: ProofLinearSpan = spans[index]
                    for position in span.start..<span.stop |position, terms, atoms, row_start, original, budget, exhausted|:
                        return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                        term: ProofNormalTerm = terms[position]
                        column: mutable usize = atoms.count
                        for atom_index in 0..<atoms.count |atom_index, atoms, term, column, budget, exhausted|:
                            return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                            return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, sview_len(atoms[atom_index])) or not proof_linear_safety_work_charge(budget, exhausted, sview_len(term.name))
                            column <- atom_index if atoms[atom_index] == term.name
                        summed: (known: bool, value: i64) = proof_add_safe(original[row_start + column], term.coefficient)
                        return (true, false) if not summed.known
                        original[row_start + column] <- summed.value
                    original[row_start + atoms.count + 1 + index] <- 1
                rows: mutable darray[i64] = []
                return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, original.count)
                rows.extend(original)
                row_count: mutable usize = count
                for atom_index in 0..<atoms.count |atom_index, width, rows, row_count, budget, exhausted|:
                    next: mutable darray[i64] = []
                    next_count: mutable usize = 0
                    for row in 0..<row_count |row, width, atom_index, rows, next, next_count, budget, exhausted|:
                        return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                        if rows[row * width + atom_index] == 0:
                            for column in 0..<width |column, row, width, rows, next, budget, exhausted|:
                                return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                                next.push(rows[row * width + column])
                            next_count <- next_count + 1
                    for positive in 0..<row_count |positive, width, atom_index, rows, next, next_count, budget, exhausted|:
                        return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                        upper: i64 = rows[positive * width + atom_index]
                        continue if upper <= 0
                        for negative in 0..<row_count |negative, positive, upper, width, atom_index, rows, next, next_count, budget, exhausted|:
                            return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                            lower: i64 = rows[negative * width + atom_index]
                            continue if lower >= 0
                            return (true, false) if next_count >= PROOF_LINEAR_FM_ROW_LIMIT
                            gcd: (complete: bool, divisor: i64) = proof_linear_fm_gcd_with_work(upper, lower, budget, exhausted)
                            return (false, false) if proof_goal_bool_ref_value(exhausted)
                            return (true, false) if not gcd.complete or gcd.divisor <= 0
                            negated_lower: (known: bool, value: i64) = proof_sub_safe(0, lower)
                            return (true, false) if not negated_lower.known
                            positive_scale: i64 = negated_lower.value / gcd.divisor
                            negative_scale: i64 = upper / gcd.divisor
                            for column in 0..<width |column, positive, negative, positive_scale, negative_scale, width, rows, next, budget, exhausted|:
                                return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                                first: (known: bool, value: i64) = proof_mul_safe(positive_scale, rows[positive * width + column])
                                second: (known: bool, value: i64) = proof_mul_safe(negative_scale, rows[negative * width + column])
                                return (true, false) if not first.known or not second.known
                                combined: (known: bool, value: i64) = proof_add_safe(first.value, second.value)
                                return (true, false) if not combined.known
                                next.push(combined.value)
                            next_count <- next_count + 1
                    rows <- next
                    row_count <- next_count
                for row in 0..<row_count |row, width, atoms, rows, original, count, budget, exhausted|:
                    return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                    continue if rows[row * width + atoms.count] <= 0
                    multipliers: mutable darray[i64] = []
                    for index in 0..<count |index, row, width, atoms, rows, multipliers, budget, exhausted|:
                        return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                        multipliers.push(rows[row * width + atoms.count + 1 + index])
                    return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                    return (true, true) if proof_linear_farkas_valid_with_work(original, atoms.count, width, multipliers, budget, exhausted)
                    return (false, false) if proof_goal_bool_ref_value(exhausted)
                return (true, false)
