# Meter the producer's exact comparison-complement closures on the shared goal budget.
extend ElisaProof:
    private:
        def proof_operand_matches_through_pins_with_work(fact_operand: Ast::Expr, goal_operand: Ast::Expr, facts: darray[Ast::Expr]&, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, matches: bool):
            can Abort.Panic:
                direct: (complete: bool, matches: bool) = proof_linear_search_expr_equal_with_work(fact_operand, goal_operand, budget, PROOF_LINEAR_SAFETY_WORK_LIMIT, true)
                return (false, false) if not direct.complete
                return (true, true) if direct.matches
                fact_value: (complete: bool, known: bool, value: i64) = proof_pinned_constant_value_with_work(fact_operand, facts, budget, exhausted)
                return (false, false) if not fact_value.complete or proof_goal_bool_ref_value(exhausted)
                return (true, false) if not fact_value.known
                goal_value: (complete: bool, known: bool, value: i64) = proof_pinned_constant_value_with_work(goal_operand, facts, budget, exhausted)
                return (false, false) if not goal_value.complete or proof_goal_bool_ref_value(exhausted)
                return (true, false) if not goal_value.known
                (true, goal_value.known and goal_value.value == fact_value.value)

        def proof_pinned_constant_value_with_work(expression: Ast::Expr, facts: darray[Ast::Expr]&, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, known: bool, value: i64):
            can Abort.Panic:
                stripped: (complete: bool, expression: Ast::Expr) = proof_linear_strip_parens_with_work(expression, budget, exhausted)
                return (false, false, 0) if not stripped.complete or proof_goal_bool_ref_value(exhausted)
                match stripped.expression:
                    Ast::Expr.IntLit(value, _):
                        return (true, true, value)
                    Ast::Expr.Ident(_, _) | Ast::Expr.Scope(_, _, _):
                        for fact in facts |fact, stripped, budget, exhausted|:
                            return (false, false, 0) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                            match fact:
                                Ast::Expr.Binary(pin_left, TokenKind.EqEq, pin_right, _):
                                    match pin_left:
                                        Ast::Expr.Ident(_, _) | Ast::Expr.Scope(_, _, _):
                                            equal: (complete: bool, matches: bool) = proof_linear_search_expr_equal_with_work(pin_left, stripped.expression, budget, PROOF_LINEAR_SAFETY_WORK_LIMIT, true)
                                            return (false, false, 0) if not equal.complete
                                            if equal.matches:
                                                match pin_right:
                                                    Ast::Expr.IntLit(value, _):
                                                        return (true, true, value)
                                                    _:
                                                        pass
                                        _:
                                            pass
                                _:
                                    pass
                        return (true, false, 0)
                    _:
                        return (true, false, 0)

        def proof_fact_proves_comparison_negation_with_work(left: Ast::Expr, operator: TokenKind, right: Ast::Expr, facts: darray[Ast::Expr]&, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, proves: bool):
            can Abort.Panic:
                negated_operator: TokenKind = proof_comparison_negation(operator)
                return (true, false) if negated_operator == TokenKind.Eof
                if proof_is_order_operator(operator):
                    left_integer: (complete: bool, integer: bool) = proof_disjunction_integer_term_with_work(left, facts, budget, exhausted)
                    return (false, false) if not left_integer.complete or proof_goal_bool_ref_value(exhausted)
                    return (true, false) if not left_integer.integer
                    right_integer: (complete: bool, integer: bool) = proof_disjunction_integer_term_with_work(right, facts, budget, exhausted)
                    return (false, false) if not right_integer.complete or proof_goal_bool_ref_value(exhausted)
                    # IEEE NaN breaks the reverse complement implication: not (x >= y) need
                    # not imply x < y. Ordered complement matching is valid only for integers.
                    return (true, false) if not right_integer.integer
                for fact in facts |fact, left, right, negated_operator, budget, exhausted|:
                    return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                    match fact:
                        Ast::Expr.Unary(TokenKind.Not, operand, _):
                            match operand:
                                Ast::Expr.Binary(inner_left, inner_operator, inner_right, _):
                                    continue if inner_operator != negated_operator
                                    left_match: (complete: bool, matches: bool) = proof_operand_matches_through_pins_with_work(inner_left, left, facts, budget, exhausted)
                                    return (false, false) if not left_match.complete or proof_goal_bool_ref_value(exhausted)
                                    continue if not left_match.matches
                                    right_match: (complete: bool, matches: bool) = proof_operand_matches_through_pins_with_work(inner_right, right, facts, budget, exhausted)
                                    return (false, false) if not right_match.complete or proof_goal_bool_ref_value(exhausted)
                                    return (true, true) if right_match.matches
                                _:
                                    pass
                        _:
                            pass
                return (true, false)

        def proof_strict_order_fact_implies_disequality_with_work(goal: Ast::Expr, facts: darray[Ast::Expr]&, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, proves: bool):
            can Abort.Panic:
                stripped: (complete: bool, expression: Ast::Expr) = proof_linear_strip_parens_with_work(goal, budget, exhausted)
                return (false, false) if not stripped.complete or proof_goal_bool_ref_value(exhausted)
                match stripped.expression:
                    Ast::Expr.Binary(left, TokenKind.BangEq, right, _):
                        marker_result: (complete: bool, witnesses: ProofScalarWitnesses) = proof_scalar_witness_markers_with_work(facts, false, budget, exhausted)
                        return (false, false) if not marker_result.complete or proof_goal_bool_ref_value(exhausted)
                        marker_scale: (complete: bool, scale: usize) = proof_linear_safety_marker_scale_with_work(marker_result.witnesses, budget, exhausted)
                        return (false, false) if not marker_scale.complete or proof_goal_bool_ref_value(exhausted)
                        goal_comparison: (complete: bool, matches: bool) = proof_linear_safety_comparison_with_work(left, right, marker_result.witnesses, marker_scale.scale, budget, exhausted)
                        return (false, false) if not goal_comparison.complete or proof_goal_bool_ref_value(exhausted)
                        return (true, false) if not goal_comparison.matches
                        for fact in facts |fact, left, right, marker_result, marker_scale, budget, exhausted|:
                            return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                            fact_stripped: (complete: bool, expression: Ast::Expr) = proof_linear_strip_parens_with_work(fact, budget, exhausted)
                            return (false, false) if not fact_stripped.complete or proof_goal_bool_ref_value(exhausted)
                            match fact_stripped.expression:
                                Ast::Expr.Binary(ordered_left, order, ordered_right, _):
                                    continue if order != TokenKind.Lt and order != TokenKind.Gt
                                    primitive: (complete: bool, matches: bool) = proof_linear_safety_comparison_with_work(ordered_left, ordered_right, marker_result.witnesses, marker_scale.scale, budget, exhausted)
                                    return (false, false) if not primitive.complete or proof_goal_bool_ref_value(exhausted)
                                    continue if not primitive.matches
                                    direct_left: (complete: bool, matches: bool) = proof_linear_search_expr_equal_with_work(left, ordered_left, budget, PROOF_LINEAR_SAFETY_WORK_LIMIT, true)
                                    return (false, false) if not direct_left.complete
                                    direct_right: (complete: bool, matches: bool) = proof_linear_search_expr_equal_with_work(right, ordered_right, budget, PROOF_LINEAR_SAFETY_WORK_LIMIT, true) if direct_left.matches else (true, false)
                                    return (false, false) if not direct_right.complete
                                    return (true, true) if direct_left.matches and direct_right.matches
                                    reverse_left: (complete: bool, matches: bool) = proof_linear_search_expr_equal_with_work(left, ordered_right, budget, PROOF_LINEAR_SAFETY_WORK_LIMIT, true)
                                    return (false, false) if not reverse_left.complete
                                    reverse_right: (complete: bool, matches: bool) = proof_linear_search_expr_equal_with_work(right, ordered_left, budget, PROOF_LINEAR_SAFETY_WORK_LIMIT, true) if reverse_left.matches else (true, false)
                                    return (false, false) if not reverse_right.complete
                                    return (true, true) if reverse_left.matches and reverse_right.matches
                                _:
                                    pass
                        return (true, false)
                    _:
                        return (true, false)

        def proof_goal_strict_order_disequality_with_work(goal: Ast::Expr, facts: darray[Ast::Expr]&, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            can Abort.Panic:
                result: (complete: bool, proves: bool) = proof_strict_order_fact_implies_disequality_with_work(goal, facts, budget, exhausted)
                if not result.complete or proof_goal_bool_ref_value(exhausted):
                    exhausted <- true
                    return false
                result.proves

        def proof_goal_comparison_negation_with_work(goal: Ast::Expr, facts: darray[Ast::Expr]&, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, proves: bool):
            can Abort.Panic:
                stripped: (complete: bool, expression: Ast::Expr) = proof_linear_strip_parens_with_work(goal, budget, exhausted)
                return (false, false) if not stripped.complete or proof_goal_bool_ref_value(exhausted)
                match stripped.expression:
                    Ast::Expr.Binary(left, operator, right, _):
                        return (true, false) if not proof_is_comparison(operator)
                        left_stripped: (complete: bool, expression: Ast::Expr) = proof_linear_strip_parens_with_work(left, budget, exhausted)
                        right_stripped: (complete: bool, expression: Ast::Expr) = proof_linear_strip_parens_with_work(right, budget, exhausted)
                        return (false, false) if not left_stripped.complete or not right_stripped.complete or proof_goal_bool_ref_value(exhausted)
                        left_name: sview = proof_ident_name(left_stripped.expression)
                        right_name: sview = proof_ident_name(right_stripped.expression)
                        return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, sview_len(left_name)) or not proof_linear_safety_work_charge(budget, exhausted, sview_len(right_name))
                        return (true, true) if operator == TokenKind.EqEq and left_name == "null" and right_name == "null"
                        null_equality: bool = (operator == TokenKind.EqEq or operator == TokenKind.BangEq) and (left_name == "null" or right_name == "null")
                        if not null_equality:
                            marker_result: (complete: bool, witnesses: ProofScalarWitnesses) = proof_scalar_witness_markers_with_work(facts, false, budget, exhausted)
                            return (false, false) if not marker_result.complete or proof_goal_bool_ref_value(exhausted)
                            marker_scale: (complete: bool, scale: usize) = proof_linear_safety_marker_scale_with_work(marker_result.witnesses, budget, exhausted)
                            return (false, false) if not marker_scale.complete or proof_goal_bool_ref_value(exhausted)
                            primitive: (complete: bool, matches: bool) = proof_linear_safety_comparison_with_work(left, right, marker_result.witnesses, marker_scale.scale, budget, exhausted)
                            return (false, false) if not primitive.complete or proof_goal_bool_ref_value(exhausted)
                            return (true, false) if not primitive.matches
                        proof_fact_proves_comparison_negation_with_work(left, operator, right, facts, budget, exhausted)
                    _:
                        return (true, false)

        def proof_goal_comparison_negation_closure_with_work(goal: Ast::Expr, facts: darray[Ast::Expr]&, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            can Abort.Panic:
                result: (complete: bool, proves: bool) = proof_goal_comparison_negation_with_work(goal, facts, budget, exhausted)
                if not result.complete or proof_goal_bool_ref_value(exhausted):
                    exhausted <- true
                    return false
                result.proves
