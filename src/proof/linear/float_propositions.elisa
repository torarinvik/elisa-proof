# A narrow propositional fragment for float-bearing functions. Float comparisons remain opaque
# Boolean atoms; this admits control-flow tautologies without assigning them IEEE arithmetic laws.
extend ElisaProof:
    private:
        const PROOF_FLOAT_BOOLEAN_ATOM_LIMIT: usize = 8
        const PROOF_FLOAT_BOOLEAN_WORK_LIMIT: usize = 4194304

        def proof_float_boolean_charge_product(work: mutable usize&, limit: usize, first: usize, second: usize, third: usize) -> bool:
            return false if work > limit
            return true if first == 0 or second == 0 or third == 0
            return false if first > limit / second
            product: usize = first * second
            return false if product > (limit - work) / third
            work <- work + product * third
            return true

        def proof_float_boolean_operand(expression: Ast::Expr) -> bool:
            match proof_strip_parens(expression):
                Ast::Expr.Ident(name, _):
                    return name != ""
                Ast::Expr.FloatLit(value, _):
                    return value != ""
                _:
                    return false

        def proof_float_boolean_atom(expression: Ast::Expr, operator_mask: usize) -> bool:
            return false if:
                not proof_kernel_expression_supported(expression)
                proof_expr_has_call(expression) or proof_expr_has_move(expression)
                proof_source_expression_has_overloaded_operator(expression, operator_mask, 0)
            match proof_strip_parens(expression):
                Ast::Expr.BoolLit(_, _) | Ast::Expr.Ident(_, _):
                    return true
                Ast::Expr.Binary(left, operator, right, _):
                    return false if operator != TokenKind.EqEq and operator != TokenKind.BangEq and operator != TokenKind.Lt and operator != TokenKind.LtEq and operator != TokenKind.Gt and operator != TokenKind.GtEq
                    return proof_float_boolean_operand(left) and proof_float_boolean_operand(right)
                _:
                    return false

        def proof_float_boolean_formula(expression: Ast::Expr, operator_mask: usize, depth: usize) -> bool:
            return false if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            match expression:
                Ast::Expr.BoolLit(_, _):
                    return true
                Ast::Expr.Paren(inner, _):
                    return proof_float_boolean_formula(inner, operator_mask, depth + 1)
                Ast::Expr.Unary(TokenKind.Not, inner, _):
                    protocol: sview = proof_builtin_unary_operator_protocol(TokenKind.Not)
                    return false if protocol != "" and proof_source_primitive_operator_mask_has(operator_mask, protocol)
                    return proof_float_boolean_formula(inner, operator_mask, depth + 1)
                Ast::Expr.Binary(left, operator, right, _):
                    if operator == TokenKind.And or operator == TokenKind.Or:
                        protocol: sview = proof_builtin_operator_protocol(operator)
                        return false if protocol != "" and proof_source_primitive_operator_mask_has(operator_mask, protocol)
                        return proof_float_boolean_formula(left, operator_mask, depth + 1) and proof_float_boolean_formula(right, operator_mask, depth + 1)
                    return proof_float_boolean_atom(expression, operator_mask)
                _:
                    return proof_float_boolean_atom(expression, operator_mask)

        def proof_float_boolean_expression_equal_with_work(left: Ast::Expr, right: Ast::Expr, work: mutable usize&, work_limit: usize) -> (complete: bool, equal: bool):
            return (false, false) if work > work_limit
            remaining: usize = work_limit - work
            scan_limit: mutable usize = remaining / 2
            scan_limit <- PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT if scan_limit > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT
            if scan_limit == 0:
                work <- work_limit
                return (false, false)
            comparison_cost: mutable usize = 0
            left_cost: mutable usize = 0
            if not proof_replay_summary_expr_cost_with_limit(left, &left_cost, 0, scan_limit):
                work <- work_limit
                return (false, false)
            right_cost: mutable usize = 0
            if not proof_replay_summary_expr_cost_with_limit(right, &right_cost, 0, scan_limit):
                work <- work_limit
                return (false, false)
            comparison_cost <- left_cost + right_cost
            # Each cost walk is capped at half the remaining allowance, so their combined
            # preflight cannot overshoot it. `comparison_cost` covers both operands; charging six
            # times that total accounts for the two cost walks plus proof_expr_equal's five
            # structural passes. If that total does not fit, latch exhaustion and skip equality.
            if comparison_cost > remaining / 6:
                work <- work_limit
                return (false, false)
            work <- work + comparison_cost * 6
            return (true, proof_expr_equal(left, right))

        def proof_float_boolean_collect(expression: Ast::Expr, atoms: mutable darray[Ast::Expr]&, atom_hashes: mutable darray[u32]&, work: mutable usize&, work_limit: usize, depth: usize) -> bool:
            return false if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            match expression:
                Ast::Expr.BoolLit(_, _):
                    return true
                Ast::Expr.Paren(inner, _):
                    return proof_float_boolean_collect(inner, atoms, atom_hashes, work, work_limit, depth + 1)
                Ast::Expr.Unary(TokenKind.Not, inner, _):
                    return proof_float_boolean_collect(inner, atoms, atom_hashes, work, work_limit, depth + 1)
                Ast::Expr.Binary(left, operator, right, _):
                    if operator == TokenKind.And or operator == TokenKind.Or:
                        return false if not proof_float_boolean_collect(left, atoms, atom_hashes, work, work_limit, depth + 1)
                        return proof_float_boolean_collect(right, atoms, atom_hashes, work, work_limit, depth + 1)
                _:
                    pass
            return false if atoms.count != atom_hashes.count
            expression_hash: u32 = proof_expr_shape_hash(expression, 0)
            for index in 0..<atoms.count |index, atoms, atom_hashes, expression_hash, work, work_limit|:
                return false if not proof_float_boolean_charge_product(work, work_limit, 1, 1, 1)
                continue if atom_hashes[index] != expression_hash
                equal: (complete: bool, equal: bool) = proof_float_boolean_expression_equal_with_work(atoms[index], expression, work, work_limit)
                return false if not equal.complete
                return true if equal.equal
            return false if atoms.count >= PROOF_FLOAT_BOOLEAN_ATOM_LIMIT
            atoms.push(expression)
            atom_hashes.push(expression_hash)
            return true

        def proof_float_boolean_evaluate(expression: Ast::Expr, atoms: darray[Ast::Expr]&, atom_hashes: darray[u32]&, values: darray[bool]&, work: mutable usize&, work_limit: usize, depth: usize) -> (known: bool, value: bool):
            return (false, false) if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT or atoms.count != atom_hashes.count or atoms.count != values.count
            match expression:
                Ast::Expr.BoolLit(value, _):
                    return (true, value)
                Ast::Expr.Paren(inner, _):
                    return proof_float_boolean_evaluate(inner, atoms, atom_hashes, values, work, work_limit, depth + 1)
                Ast::Expr.Unary(TokenKind.Not, inner, _):
                    nested: (known: bool, value: bool) = proof_float_boolean_evaluate(inner, atoms, atom_hashes, values, work, work_limit, depth + 1)
                    return (nested.known, not nested.value)
                Ast::Expr.Binary(left, TokenKind.And, right, _):
                    first: (known: bool, value: bool) = proof_float_boolean_evaluate(left, atoms, atom_hashes, values, work, work_limit, depth + 1)
                    return (false, false) if not first.known
                    return (true, false) if not first.value
                    return proof_float_boolean_evaluate(right, atoms, atom_hashes, values, work, work_limit, depth + 1)
                Ast::Expr.Binary(left, TokenKind.Or, right, _):
                    first: (known: bool, value: bool) = proof_float_boolean_evaluate(left, atoms, atom_hashes, values, work, work_limit, depth + 1)
                    return (false, false) if not first.known
                    return (true, true) if first.value
                    return proof_float_boolean_evaluate(right, atoms, atom_hashes, values, work, work_limit, depth + 1)
                _:
                    pass
            return (false, false) if atoms.count != atom_hashes.count
            expression_hash: u32 = proof_expr_shape_hash(expression, 0)
            for index in 0..<atoms.count |index, atoms, atom_hashes, values, expression_hash, work, work_limit|:
                return (false, false) if not proof_float_boolean_charge_product(work, work_limit, 1, 1, 1)
                continue if atom_hashes[index] != expression_hash
                equal: (complete: bool, equal: bool) = proof_float_boolean_expression_equal_with_work(atoms[index], expression, work, work_limit)
                return (false, false) if not equal.complete
                return (true, values[index]) if equal.equal
            return (false, false)

        def proof_float_boolean_all_assignments(facts: darray[Ast::Expr]&, goal: Ast::Expr, atoms: darray[Ast::Expr]&, atom_hashes: darray[u32]&, values: mutable darray[bool]&, atom_index: usize, work: mutable usize&, work_limit: usize) -> bool:
            if atom_index >= atoms.count:
                for fact in facts |fact, goal, atoms, atom_hashes, values, work, work_limit|:
                    premise: (known: bool, value: bool) = proof_float_boolean_evaluate(fact, atoms, atom_hashes, values, work, work_limit, 0)
                    return false if not premise.known
                    continue if premise.value
                    return true
                conclusion: (known: bool, value: bool) = proof_float_boolean_evaluate(goal, atoms, atom_hashes, values, work, work_limit, 0)
                return conclusion.known and conclusion.value
            values.push(false)
            if not proof_float_boolean_all_assignments(facts, goal, atoms, atom_hashes, values, atom_index + 1, work, work_limit):
                values.truncate(values.count - 1)
                return false
            values[values.count - 1] <- true
            valid: bool = proof_float_boolean_all_assignments(facts, goal, atoms, atom_hashes, values, atom_index + 1, work, work_limit)
            values.truncate(values.count - 1)
            return valid

        def proof_float_propositional_goal(facts: darray[Ast::Expr]&, goal: Ast::Expr, operator_mask: usize) -> bool:
            work: mutable usize = 0
            return proof_float_propositional_goal_with_shared_work(facts, goal, operator_mask, &work, PROOF_FLOAT_BOOLEAN_WORK_LIMIT)

        def proof_float_propositional_goal_with_shared_work(facts: darray[Ast::Expr]&, goal: Ast::Expr, operator_mask: usize, work: mutable usize&, work_limit: usize) -> bool:
            total_nodes: mutable usize = 0
            cost_work: mutable usize = 0
            for fact in facts |total_nodes, cost_work|:
                cost: mutable usize = 0
                return false if:
                    not proof_replay_summary_expr_cost(fact, &cost, cost_work, 0)
                    cost > PROOF_FLOAT_BOOLEAN_WORK_LIMIT - total_nodes or cost > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - cost_work
                total_nodes <- total_nodes + cost
                cost_work <- cost_work + cost
            goal_cost: mutable usize = 0
            return false if:
                not proof_replay_summary_expr_cost(goal, &goal_cost, cost_work, 0)
                goal_cost > PROOF_FLOAT_BOOLEAN_WORK_LIMIT - total_nodes or goal_cost > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - cost_work
            total_nodes <- total_nodes + goal_cost
            # Validation, formula collection, atom hashing, and the bounded linear hash-table
            # probes each traverse the input at most a fixed number of times. Structural equality
            # is separately metered only when hashes collide.
            return false if:
                not proof_float_boolean_charge_product(work, work_limit, total_nodes, 1, 32)
                not proof_float_boolean_formula(goal, operator_mask, 0)
            relevant_facts: mutable darray[Ast::Expr] = []
            atoms: mutable darray[Ast::Expr] = []
            atom_hashes: mutable darray[u32] = []
            for fact in facts |fact, goal, operator_mask, relevant_facts, atoms, atom_hashes, work, work_limit|:
                continue if not proof_float_boolean_formula(fact, operator_mask, 0)
                relevant_facts.push(fact)
                return false if not proof_float_boolean_collect(fact, &atoms, &atom_hashes, work, work_limit, 0)
            return false if not proof_float_boolean_collect(goal, &atoms, &atom_hashes, work, work_limit, 0)
            return false if atoms.count != atom_hashes.count
            model_count: mutable usize = 1
            for _ in 0..<atoms.count |model_count|:
                model_count <- model_count * 2
            # Every model evaluates the relevant formulas, hashes each opaque atom once, and
            # scans at most eight stored atom hashes. Any colliding structural equality is charged
            # by proof_float_boolean_expression_equal_with_work.
            return false if not proof_float_boolean_charge_product(work, work_limit, total_nodes, model_count, 32)
            assignments: mutable darray[bool] = []
            return proof_float_boolean_all_assignments(relevant_facts, goal, atoms, atom_hashes, &assignments, 0, work, work_limit)
