# Factored helpers retained by the branch integration.
extend ElisaProof:
    public:
        def proof_bound_index(bounds: darray[ProofBound]&, name: sview) -> usize:
            index: mutable usize = 0
            while index < bounds.count |index, bounds, name|:
                return index if not bounds[index].term_key and bounds[index].name == name
                index <- index + 1
            return bounds.count

        def proof_bound_for(bounds: darray[ProofBound]&, name: sview) -> ProofBound:
            index: usize = proof_bound_index(bounds, name)
            return bounds[index] if index < bounds.count
            return ProofBound{name: name, term: Ast::Expr.Invalid, term_key: false, has_lower: false, lower: 0, has_upper: false, upper: 0}

        def proof_add_lower(bounds: mutable darray[ProofBound]&, name: sview, value: i64) -> void:
            return if name == ""
            index: usize = proof_bound_index(bounds, name)
            if index == bounds.count:
                bounds <- bounds.push(ProofBound{name: name, term: Ast::Expr.Invalid, term_key: false, has_lower: true, lower: value, has_upper: false, upper: 0})
                return
            old_has: bool = bounds[index].has_lower
            old_value: i64 = bounds[index].lower
            bounds[index].has_lower <- true
            bounds[index].lower <- value if not old_has or value > old_value

        def proof_add_upper(bounds: mutable darray[ProofBound]&, name: sview, value: i64) -> void:
            return if name == ""
            index: usize = proof_bound_index(bounds, name)
            if index == bounds.count:
                bounds <- bounds.push(ProofBound{name: name, term: Ast::Expr.Invalid, term_key: false, has_lower: false, lower: 0, has_upper: true, upper: value})
                return
            old_has: bool = bounds[index].has_upper
            old_value: i64 = bounds[index].upper
            bounds[index].has_upper <- true
            bounds[index].upper <- value if not old_has or value < old_value

        def proof_comparison_negation(operator: TokenKind) -> TokenKind:
            return TokenKind.BangEq if operator == TokenKind.EqEq
            return TokenKind.EqEq if operator == TokenKind.BangEq
            return TokenKind.GtEq if operator == TokenKind.Lt
            return TokenKind.Lt if operator == TokenKind.GtEq
            return TokenKind.Gt if operator == TokenKind.LtEq
            return TokenKind.LtEq if operator == TokenKind.Gt
            # Eof is outside the comparison-token set and serves as the impossible result.
            return TokenKind.Eof

        def proof_collect_comparison_bounds(left: Ast::Expr, operator: TokenKind, right: Ast::Expr, markers: ProofScalarWitnesses&, bounds: mutable darray[ProofBound]&) -> void:
            return if not proof_is_comparison(operator) or not proof_primitive_comparison_marked(left, right, markers)
            left_name: sview = proof_ident_name(left)
            right_name: sview = proof_ident_name(right)
            right_constant: (known: bool, value: i64) = proof_constant_int(right)
            left_constant: (known: bool, value: i64) = proof_constant_int(left)
            if left_name != "" and right_constant.known:
                incremented: (known: bool, value: i64) = proof_add_safe(right_constant.value, 1)
                proof_add_lower(bounds, left_name, incremented.value) if operator == TokenKind.Gt and incremented.known
                proof_add_lower(bounds, left_name, right_constant.value) if operator == TokenKind.GtEq
                decremented: (known: bool, value: i64) = proof_sub_safe(right_constant.value, 1)
                proof_add_upper(bounds, left_name, decremented.value) if operator == TokenKind.Lt and decremented.known
                proof_add_upper(bounds, left_name, right_constant.value) if operator == TokenKind.LtEq
                proof_add_lower(bounds, left_name, right_constant.value) if operator == TokenKind.EqEq
                proof_add_upper(bounds, left_name, right_constant.value) if operator == TokenKind.EqEq
            if right_name != "" and left_constant.known:
                decremented_left: (known: bool, value: i64) = proof_sub_safe(left_constant.value, 1)
                proof_add_upper(bounds, right_name, decremented_left.value) if operator == TokenKind.Gt and decremented_left.known
                proof_add_upper(bounds, right_name, left_constant.value) if operator == TokenKind.GtEq
                incremented_left: (known: bool, value: i64) = proof_add_safe(left_constant.value, 1)
                proof_add_lower(bounds, right_name, incremented_left.value) if operator == TokenKind.Lt and incremented_left.known
                proof_add_lower(bounds, right_name, left_constant.value) if operator == TokenKind.LtEq
                proof_add_lower(bounds, right_name, left_constant.value) if operator == TokenKind.EqEq
                proof_add_upper(bounds, right_name, left_constant.value) if operator == TokenKind.EqEq
            if left_name == "" and proof_structural_bound_atom_marked(left, markers) and right_constant.known:
                incremented: (known: bool, value: i64) = proof_add_safe(right_constant.value, 1)
                proof_add_term_lower(bounds, left, incremented.value) if operator == TokenKind.Gt and incremented.known
                proof_add_term_lower(bounds, left, right_constant.value) if operator == TokenKind.GtEq or operator == TokenKind.EqEq
                decremented: (known: bool, value: i64) = proof_sub_safe(right_constant.value, 1)
                proof_add_term_upper(bounds, left, decremented.value) if operator == TokenKind.Lt and decremented.known
                proof_add_term_upper(bounds, left, right_constant.value) if operator == TokenKind.LtEq or operator == TokenKind.EqEq
            if right_name == "" and proof_structural_bound_atom_marked(right, markers) and left_constant.known:
                decremented_left: (known: bool, value: i64) = proof_sub_safe(left_constant.value, 1)
                proof_add_term_upper(bounds, right, decremented_left.value) if operator == TokenKind.Gt and decremented_left.known
                proof_add_term_upper(bounds, right, left_constant.value) if operator == TokenKind.GtEq or operator == TokenKind.EqEq
                incremented_left: (known: bool, value: i64) = proof_add_safe(left_constant.value, 1)
                proof_add_term_lower(bounds, right, incremented_left.value) if operator == TokenKind.Lt and incremented_left.known
                proof_add_term_lower(bounds, right, left_constant.value) if operator == TokenKind.LtEq or operator == TokenKind.EqEq

        def proof_collect_negated_comparison(expression: Ast::Expr, facts: darray[Ast::Expr]&, markers: ProofScalarWitnesses&, bounds: mutable darray[ProofBound]&) -> void:
            match expression:
                Ast::Expr.Binary(left, operator, right, _):
                    return if proof_is_order_operator(operator) and (not proof_disjunction_denial_integer_term(left, facts, 0) or not proof_disjunction_denial_integer_term(right, facts, 0))
                    negated_operator: TokenKind = proof_comparison_negation(operator)
                    proof_collect_comparison_bounds(left, negated_operator, right, markers, bounds) if negated_operator != TokenKind.Eof
                _:
                    pass

        # Extract facts of the form x OP constant or constant OP x, including conjunctions.
        # Bound collection reads the fact list only through the scalar witness, which reads only
        # the type-witness markers, so callers that collect from every fact select them once
        # (`proof_collect_fact_bounds`) instead of once per comparison.
        def proof_collect_bounds(expression: Ast::Expr, facts: darray[Ast::Expr]&, bounds: mutable darray[ProofBound]&) -> void:
            markers: ProofScalarWitnesses = proof_scalar_witness_markers(facts)
            proof_collect_bounds_marked(expression, facts, markers, bounds)

        def proof_collect_fact_bounds(facts: darray[Ast::Expr]&, bounds: mutable darray[ProofBound]&) -> void:
            markers: ProofScalarWitnesses = proof_scalar_witness_markers(facts)
            for fact in facts |markers, bounds|:
                proof_collect_bounds_marked(fact, facts, markers, bounds)

        def proof_collect_bounds_marked(expression: Ast::Expr, facts: darray[Ast::Expr]&, markers: ProofScalarWitnesses&, bounds: mutable darray[ProofBound]&) -> void:
            match expression:
                Ast::Expr.Paren(inner, _):
                    proof_collect_bounds_marked(inner, facts, markers, bounds)
                Ast::Expr.Unary(TokenKind.Not, operand, _):
                    match operand:
                        Ast::Expr.Binary(left, TokenKind.Or, right, _):
                            # De Morgan, one level deep as the kernel mirror reads it.
                            proof_collect_negated_comparison(left, facts, markers, bounds)
                            proof_collect_negated_comparison(right, facts, markers, bounds)
                        _:
                            proof_collect_negated_comparison(operand, facts, markers, bounds)
                Ast::Expr.Binary(left, operator, right, position):
                    if operator == TokenKind.And:
                        proof_collect_bounds_marked(left, facts, markers, bounds)
                        proof_collect_bounds_marked(right, facts, markers, bounds)
                        return
                    proof_collect_comparison_bounds(left, operator, right, markers, bounds)
                _:
                    pass

        # The proof AST does not carry compiler type metadata. Unsigned widths therefore travel
        # through the same traced-fact channel as compiler-derived bounds. This marker is opaque
        # to the arithmetic fragment, but it is encoded in the kernel arena and independently
        # recognized by kernel replay. A proof author can manufacture the marker only to lose
        # completeness: it never proves a proposition by itself, and the source trace still has
        # to identify it as a type-bound fact.
        def proof_unsigned_type_marker(name: sview, width: i64, position: Ast::Pos) -> Ast::Expr:
            arguments: darray[Ast::Expr] = [Ast::Expr.Ident(name, position), Ast::Expr.IntLit(width, position)]
            return Ast::Expr.Call(Ast::Expr.Ident("__elisa_unsigned_type_bound", position), arguments, [], position)

        # The same marker over a place rather than a bare name. The bare-name reader intentionally
        # ignores it; the arithmetic-width reader consults it only for an exact field node, so a
        # width cannot spread from a container's synthetic `.count` witness to neighboring terms.
