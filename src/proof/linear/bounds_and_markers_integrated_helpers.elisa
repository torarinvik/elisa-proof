# Factored helpers retained by the branch integration.
extend ElisaProof:
    public:
        def proof_bound_index(bounds: darray[ProofBound]&, name: sview) -> usize:
            index: mutable usize = 0
            while index < bounds.count |index, bounds, name|:
                return index if not bounds[index].term_key and bounds[index].name == name
                index <- index + 1
            return bounds.count

        def proof_bound_for(bounds: darray[ProofBound]&, name: sview) -> ProofBound:
            index: usize = proof_bound_index(bounds, name)
            return bounds[index] if index < bounds.count
            return ProofBound{name: name, term: Ast::Expr.Invalid, term_key: false, has_lower: false, lower: 0, has_upper: false, upper: 0}

        def proof_add_lower(bounds: mutable darray[ProofBound]&, name: sview, value: i64) -> void:
            return if name == ""
            index: usize = proof_bound_index(bounds, name)
            if index == bounds.count:
                bounds <- bounds.push(ProofBound{name: name, term: Ast::Expr.Invalid, term_key: false, has_lower: true, lower: value, has_upper: false, upper: 0})
                return
            old_has: bool = bounds[index].has_lower
            old_value: i64 = bounds[index].lower
            bounds[index].has_lower <- true
            bounds[index].lower <- value if not old_has or value > old_value

        def proof_add_upper(bounds: mutable darray[ProofBound]&, name: sview, value: i64) -> void:
            return if name == ""
            index: usize = proof_bound_index(bounds, name)
            if index == bounds.count:
                bounds <- bounds.push(ProofBound{name: name, term: Ast::Expr.Invalid, term_key: false, has_lower: false, lower: 0, has_upper: true, upper: value})
                return
            old_has: bool = bounds[index].has_upper
            old_value: i64 = bounds[index].upper
            bounds[index].has_upper <- true
            bounds[index].upper <- value if not old_has or value < old_value

        def proof_comparison_negation(operator: TokenKind) -> TokenKind:
            return TokenKind.BangEq if operator == TokenKind.EqEq
            return TokenKind.EqEq if operator == TokenKind.BangEq
            return TokenKind.GtEq if operator == TokenKind.Lt
            return TokenKind.Lt if operator == TokenKind.GtEq
            return TokenKind.Gt if operator == TokenKind.LtEq
            return TokenKind.LtEq if operator == TokenKind.Gt
            # Eof is outside the comparison-token set and serves as the impossible result.
            return TokenKind.Eof

        def proof_collect_comparison_bounds(left: Ast::Expr, operator: TokenKind, right: Ast::Expr, markers: ProofScalarWitnesses&, bounds: mutable darray[ProofBound]&) -> void:
            return if not proof_is_comparison(operator) or not proof_primitive_comparison_marked(left, right, markers)
            left_name: sview = proof_ident_name(left)
            right_name: sview = proof_ident_name(right)
            right_constant: (known: bool, value: i64) = proof_constant_int(right)
            left_constant: (known: bool, value: i64) = proof_constant_int(left)
            if left_name != "" and right_constant.known:
                incremented: (known: bool, value: i64) = proof_add_safe(right_constant.value, 1)
                proof_add_lower(bounds, left_name, incremented.value) if operator == TokenKind.Gt and incremented.known
                proof_add_lower(bounds, left_name, right_constant.value) if operator == TokenKind.GtEq
                decremented: (known: bool, value: i64) = proof_sub_safe(right_constant.value, 1)
                proof_add_upper(bounds, left_name, decremented.value) if operator == TokenKind.Lt and decremented.known
                proof_add_upper(bounds, left_name, right_constant.value) if operator == TokenKind.LtEq
                proof_add_lower(bounds, left_name, right_constant.value) if operator == TokenKind.EqEq
                proof_add_upper(bounds, left_name, right_constant.value) if operator == TokenKind.EqEq
            if right_name != "" and left_constant.known:
                decremented_left: (known: bool, value: i64) = proof_sub_safe(left_constant.value, 1)
                proof_add_upper(bounds, right_name, decremented_left.value) if operator == TokenKind.Gt and decremented_left.known
                proof_add_upper(bounds, right_name, left_constant.value) if operator == TokenKind.GtEq
                incremented_left: (known: bool, value: i64) = proof_add_safe(left_constant.value, 1)
                proof_add_lower(bounds, right_name, incremented_left.value) if operator == TokenKind.Lt and incremented_left.known
                proof_add_lower(bounds, right_name, left_constant.value) if operator == TokenKind.LtEq
                proof_add_lower(bounds, right_name, left_constant.value) if operator == TokenKind.EqEq
                proof_add_upper(bounds, right_name, left_constant.value) if operator == TokenKind.EqEq
            if left_name == "" and proof_structural_bound_atom_marked(left, markers) and right_constant.known:
                incremented: (known: bool, value: i64) = proof_add_safe(right_constant.value, 1)
                proof_add_term_lower(bounds, left, incremented.value) if operator == TokenKind.Gt and incremented.known
                proof_add_term_lower(bounds, left, right_constant.value) if operator == TokenKind.GtEq or operator == TokenKind.EqEq
                decremented: (known: bool, value: i64) = proof_sub_safe(right_constant.value, 1)
                proof_add_term_upper(bounds, left, decremented.value) if operator == TokenKind.Lt and decremented.known
                proof_add_term_upper(bounds, left, right_constant.value) if operator == TokenKind.LtEq or operator == TokenKind.EqEq
            if right_name == "" and proof_structural_bound_atom_marked(right, markers) and left_constant.known:
                decremented_left: (known: bool, value: i64) = proof_sub_safe(left_constant.value, 1)
                proof_add_term_upper(bounds, right, decremented_left.value) if operator == TokenKind.Gt and decremented_left.known
                proof_add_term_upper(bounds, right, left_constant.value) if operator == TokenKind.GtEq or operator == TokenKind.EqEq
                incremented_left: (known: bool, value: i64) = proof_add_safe(left_constant.value, 1)
                proof_add_term_lower(bounds, right, incremented_left.value) if operator == TokenKind.Lt and incremented_left.known
                proof_add_term_lower(bounds, right, left_constant.value) if operator == TokenKind.LtEq or operator == TokenKind.EqEq

        def proof_collect_negated_comparison(expression: Ast::Expr, facts: darray[Ast::Expr]&, markers: ProofScalarWitnesses&, bounds: mutable darray[ProofBound]&) -> void:
            match expression:
                Ast::Expr.Binary(left, operator, right, _):
                    return if proof_is_order_operator(operator) and (not proof_disjunction_denial_integer_term(left, facts, 0) or not proof_disjunction_denial_integer_term(right, facts, 0))
                    negated_operator: TokenKind = proof_comparison_negation(operator)
                    proof_collect_comparison_bounds(left, negated_operator, right, markers, bounds) if negated_operator != TokenKind.Eof
                _:
                    pass

        # Extract facts of the form x OP constant or constant OP x, including conjunctions.
        # Bound collection reads the fact list only through the scalar witness, which reads only
        # the type-witness markers, so callers that collect from every fact select them once
        # (`proof_collect_fact_bounds`) instead of once per comparison.
        def proof_collect_bounds(expression: Ast::Expr, facts: darray[Ast::Expr]&, bounds: mutable darray[ProofBound]&) -> void:
            markers: ProofScalarWitnesses = proof_scalar_witness_markers(facts)
            proof_collect_bounds_marked(expression, facts, markers, bounds)

        def proof_collect_fact_bounds(facts: darray[Ast::Expr]&, bounds: mutable darray[ProofBound]&) -> void:
            markers: ProofScalarWitnesses = proof_scalar_witness_markers(facts)
            proof_collect_fact_bounds_with_markers(facts, markers, bounds)

        def proof_collect_fact_bounds_with_markers(facts: darray[Ast::Expr]&, markers: ProofScalarWitnesses&, bounds: mutable darray[ProofBound]&) -> void:
            for fact in facts |markers, bounds|:
                proof_collect_bounds_marked(fact, facts, markers, bounds)

        # Metered source-list entry point. This walks each fact once, meters marker
        # comparisons and bound-index operations, and returns false only on exhaustion.
        def proof_collect_fact_bounds_with_work(facts: darray[Ast::Expr]&, markers: ProofScalarWitnesses&, bounds: mutable darray[ProofBound]&, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            marker_scan: (complete: bool, scale: usize) = proof_linear_safety_marker_scale_with_work(markers, budget, exhausted)
            return false if not marker_scan.complete
            fact_scan_cost: mutable usize = 0
            for fact in facts |fact, budget, exhausted|:
                return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(fact, budget, exhausted)
                return false if not cost.complete
                fact_scan_cost <- fact_scan_cost + cost.cost + 1
            for bound in bounds |bound, budget, exhausted|:
                return false if not proof_linear_safety_work_charge(budget, exhausted, 1 + sview_len(bound.name))
                if bound.term_key:
                    cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(bound.term, budget, exhausted)
                    return false if not cost.complete
            for fact in facts |fact, facts, markers, marker_scan, fact_scan_cost, bounds, budget, exhausted|:
                return false if not proof_collect_bounds_marked_with_work(fact, facts, markers, marker_scan.scale, fact_scan_cost, bounds, budget, exhausted)
            return true

        def proof_collect_bounds_marked_with_work(expression: Ast::Expr, facts: darray[Ast::Expr]&, markers: ProofScalarWitnesses&, marker_scale: usize, fact_scan_cost: usize, bounds: mutable darray[ProofBound]&, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_collect_bounds_marked_with_work(inner, facts, markers, marker_scale, fact_scan_cost, bounds, budget, exhausted)
                Ast::Expr.Unary(TokenKind.Not, operand, _):
                    match operand:
                        Ast::Expr.Binary(left, TokenKind.Or, right, _):
                            return false if not proof_collect_negated_comparison_with_work(left, facts, markers, marker_scale, fact_scan_cost, bounds, budget, exhausted)
                            return proof_collect_negated_comparison_with_work(right, facts, markers, marker_scale, fact_scan_cost, bounds, budget, exhausted)
                        _:
                            return proof_collect_negated_comparison_with_work(operand, facts, markers, marker_scale, fact_scan_cost, bounds, budget, exhausted)
                Ast::Expr.Binary(left, operator, right, _):
                    if operator == TokenKind.And:
                        return false if not proof_collect_bounds_marked_with_work(left, facts, markers, marker_scale, fact_scan_cost, bounds, budget, exhausted)
                        return proof_collect_bounds_marked_with_work(right, facts, markers, marker_scale, fact_scan_cost, bounds, budget, exhausted)
                    return proof_collect_comparison_bounds_with_work(left, operator, right, markers, marker_scale, bounds, budget, exhausted)
                _:
                    return true

        def proof_collect_negated_comparison_with_work(expression: Ast::Expr, facts: darray[Ast::Expr]&, markers: ProofScalarWitnesses&, marker_scale: usize, fact_scan_cost: usize, bounds: mutable darray[ProofBound]&, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
            match expression:
                Ast::Expr.Binary(left, operator, right, _):
                    if proof_is_order_operator(operator):
                        left_integer: (complete: bool, integer: bool) = proof_disjunction_denial_integer_term_with_work(left, facts, markers, marker_scale, fact_scan_cost, 0, budget, exhausted)
                        return false if not left_integer.complete
                        return true if not left_integer.integer
                        right_integer: (complete: bool, integer: bool) = proof_disjunction_denial_integer_term_with_work(right, facts, markers, marker_scale, fact_scan_cost, 0, budget, exhausted)
                        return false if not right_integer.complete
                        return true if not right_integer.integer
                    negated_operator: TokenKind = proof_comparison_negation(operator)
                    return true if negated_operator == TokenKind.Eof
                    return proof_collect_comparison_bounds_with_work(left, negated_operator, right, markers, marker_scale, bounds, budget, exhausted)
                _:
                    return true

        # Work-aware mirror of the narrow integer-order recognizer. Scalar checks use the
        # already-indexed marker set; the remaining width-marker readers are reserved against
        # the pre-counted fact AST cost before their legacy exact scans run.
        def proof_disjunction_denial_integer_term_with_work(expression: Ast::Expr, facts: darray[Ast::Expr]&, markers: ProofScalarWitnesses&, marker_scale: usize, fact_scan_cost: usize, depth: usize, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, integer: bool):
            return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
            return (true, false) if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            match expression:
                Ast::Expr.IntLit(_, _):
                    return (true, true)
                Ast::Expr.Paren(inner, _):
                    return proof_disjunction_denial_integer_term_with_work(inner, facts, markers, marker_scale, fact_scan_cost, depth + 1, budget, exhausted)
                Ast::Expr.Binary(Ast::Expr.IntLit(numerator, _), TokenKind.Slash, Ast::Expr.IntLit(denominator, _), _):
                    witnessed: (complete: bool, matches: bool) = proof_linear_safety_scalar_witness_with_work(expression, markers, marker_scale, budget, exhausted)
                    return (false, false) if not witnessed.complete
                    return (true, numerator >= 0 and denominator > 0 and witnessed.matches)
                Ast::Expr.Binary(left, operator, right, _):
                    if operator == TokenKind.Star:
                        witnessed: (complete: bool, matches: bool) = proof_linear_safety_scalar_witness_with_work(expression, markers, marker_scale, budget, exhausted)
                        return (false, false) if not witnessed.complete
                        if witnessed.matches:
                            left_literal: (known: bool, value: i64) = proof_constant_int(left)
                            right_literal: (known: bool, value: i64) = proof_constant_int(right)
                            return proof_disjunction_denial_integer_term_with_work(right, facts, markers, marker_scale, fact_scan_cost, depth + 1, budget, exhausted) if left_literal.known and left_literal.value >= 0
                            return proof_disjunction_denial_integer_term_with_work(left, facts, markers, marker_scale, fact_scan_cost, depth + 1, budget, exhausted) if right_literal.known and right_literal.value >= 0
                        return (true, false)
                    return (true, false) if operator != TokenKind.Plus and operator != TokenKind.Minus
                    witnessed: (complete: bool, matches: bool) = proof_linear_safety_scalar_witness_with_work(expression, markers, marker_scale, budget, exhausted)
                    return (false, false) if not witnessed.complete
                    return (true, false) if not witnessed.matches
                    left_integer: (complete: bool, integer: bool) = proof_disjunction_denial_integer_term_with_work(left, facts, markers, marker_scale, fact_scan_cost, depth + 1, budget, exhausted)
                    return (false, false) if not left_integer.complete
                    return (true, false) if not left_integer.integer
                    return proof_disjunction_denial_integer_term_with_work(right, facts, markers, marker_scale, fact_scan_cost, depth + 1, budget, exhausted)
                Ast::Expr.Ident(name, _):
                    return (false, false) if not proof_linear_safety_fact_term_scan_with_work(expression, facts, fact_scan_cost, 1, budget, exhausted)
                    for fact in facts |expression, fact_scan_cost, budget, exhausted|:
                        integer: (known: bool, term: Ast::Expr) = proof_marker_argument(fact, "__elisa_primitive_integer_type")
                        return (true, true) if integer.known and proof_expr_equal(integer.term, expression)
                    return (false, false) if not proof_linear_safety_fact_term_scan_with_work(expression, facts, fact_scan_cost, 2, budget, exhausted)
                    return (true, proof_unsigned_marker_width_for_name(facts, name) != 0 or proof_signed_marker_width_for_term(facts, expression) != 0)
                Ast::Expr.Field(_, _, _) | Ast::Expr.Tuple(_, _):
                    return (false, false) if not proof_linear_safety_fact_term_scan_with_work(expression, facts, fact_scan_cost, 2, budget, exhausted)
                    return (true, proof_unsigned_place_marker_width(facts, expression) != 0 or proof_signed_marker_width_for_term(facts, expression) != 0)
                Ast::Expr.Call(_, _, _, _):
                    witnessed: (complete: bool, matches: bool) = proof_linear_safety_scalar_witness_with_work(expression, markers, marker_scale, budget, exhausted)
                    return (false, false) if not witnessed.complete
                    return (true, false) if not witnessed.matches
                    return (false, false) if not proof_linear_safety_fact_term_scan_with_work(expression, facts, fact_scan_cost, 2, budget, exhausted)
                    return (true, proof_unsigned_place_marker_width(facts, expression) != 0 or proof_signed_marker_width_for_term(facts, expression) != 0)
                _:
                    return (true, false)

        def proof_linear_safety_scalar_witness_with_work(expression: Ast::Expr, markers: ProofScalarWitnesses&, marker_scale: usize, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, matches: bool):
            cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(expression, budget, exhausted)
            return (false, false) if not cost.complete
            return (false, false) if not proof_linear_safety_work_charge_scaled(budget, exhausted, cost.cost, marker_scale + 1)
            return (true, proof_scalar_term_witnessed_in(expression, markers, 0))

        def proof_linear_safety_fact_term_scan_with_work(term: Ast::Expr, facts: darray[Ast::Expr]&, fact_scan_cost: usize, passes: usize, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            term_cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(term, budget, exhausted)
            return false if not term_cost.complete
            for pass in 0..<passes |pass, facts, fact_scan_cost, term_cost, budget, exhausted|:
                return false if not proof_linear_safety_work_charge(budget, exhausted, fact_scan_cost)
                return false if not proof_linear_safety_work_charge_scaled(budget, exhausted, term_cost.cost, facts.count)
            return true

        def proof_collect_comparison_bounds_with_work(left: Ast::Expr, operator: TokenKind, right: Ast::Expr, markers: ProofScalarWitnesses&, marker_scale: usize, bounds: mutable darray[ProofBound]&, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            return true if not proof_is_comparison(operator)
            comparison: (complete: bool, matches: bool) = proof_linear_safety_comparison_with_work(left, right, markers, marker_scale, budget, exhausted)
            return false if not comparison.complete
            return true if not comparison.matches
            left_cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(left, budget, exhausted)
            return false if not left_cost.complete
            right_cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(right, budget, exhausted)
            return false if not right_cost.complete
            return false if not proof_linear_safety_work_charge(budget, exhausted, left_cost.cost + right_cost.cost)
            left_name: sview = proof_ident_name(left)
            right_name: sview = proof_ident_name(right)
            right_constant: (known: bool, value: i64) = proof_constant_int(right)
            left_constant: (known: bool, value: i64) = proof_constant_int(left)
            if left_name != "" and right_constant.known:
                incremented: (known: bool, value: i64) = proof_add_safe(right_constant.value, 1)
                return false if operator == TokenKind.Gt and incremented.known and not proof_equalities_add_lower_with_work(bounds, left_name, incremented.value, budget, exhausted)
                return false if operator == TokenKind.GtEq and not proof_equalities_add_lower_with_work(bounds, left_name, right_constant.value, budget, exhausted)
                decremented: (known: bool, value: i64) = proof_sub_safe(right_constant.value, 1)
                return false if operator == TokenKind.Lt and decremented.known and not proof_equalities_add_upper_with_work(bounds, left_name, decremented.value, budget, exhausted)
                return false if operator == TokenKind.LtEq and not proof_equalities_add_upper_with_work(bounds, left_name, right_constant.value, budget, exhausted)
                return false if operator == TokenKind.EqEq and not proof_equalities_add_lower_with_work(bounds, left_name, right_constant.value, budget, exhausted)
                return false if operator == TokenKind.EqEq and not proof_equalities_add_upper_with_work(bounds, left_name, right_constant.value, budget, exhausted)
            if right_name != "" and left_constant.known:
                decremented_left: (known: bool, value: i64) = proof_sub_safe(left_constant.value, 1)
                return false if operator == TokenKind.Gt and decremented_left.known and not proof_equalities_add_upper_with_work(bounds, right_name, decremented_left.value, budget, exhausted)
                return false if operator == TokenKind.GtEq and not proof_equalities_add_upper_with_work(bounds, right_name, left_constant.value, budget, exhausted)
                incremented_left: (known: bool, value: i64) = proof_add_safe(left_constant.value, 1)
                return false if operator == TokenKind.Lt and incremented_left.known and not proof_equalities_add_lower_with_work(bounds, right_name, incremented_left.value, budget, exhausted)
                return false if operator == TokenKind.LtEq and not proof_equalities_add_lower_with_work(bounds, right_name, left_constant.value, budget, exhausted)
                return false if operator == TokenKind.EqEq and not proof_equalities_add_lower_with_work(bounds, right_name, left_constant.value, budget, exhausted)
                return false if operator == TokenKind.EqEq and not proof_equalities_add_upper_with_work(bounds, right_name, left_constant.value, budget, exhausted)
            if left_name == "" and right_constant.known:
                structural: (complete: bool, matches: bool) = proof_structural_bound_atom_with_work(left, markers, marker_scale, budget, exhausted)
                return false if not structural.complete
                if structural.matches:
                    incremented: (known: bool, value: i64) = proof_add_safe(right_constant.value, 1)
                    return false if operator == TokenKind.Gt and incremented.known and not proof_add_term_lower_with_work(bounds, left, incremented.value, budget, exhausted)
                    return false if (operator == TokenKind.GtEq or operator == TokenKind.EqEq) and not proof_add_term_lower_with_work(bounds, left, right_constant.value, budget, exhausted)
                    decremented: (known: bool, value: i64) = proof_sub_safe(right_constant.value, 1)
                    return false if operator == TokenKind.Lt and decremented.known and not proof_add_term_upper_with_work(bounds, left, decremented.value, budget, exhausted)
                    return false if (operator == TokenKind.LtEq or operator == TokenKind.EqEq) and not proof_add_term_upper_with_work(bounds, left, right_constant.value, budget, exhausted)
            if right_name == "" and left_constant.known:
                structural: (complete: bool, matches: bool) = proof_structural_bound_atom_with_work(right, markers, marker_scale, budget, exhausted)
                return false if not structural.complete
                if structural.matches:
                    decremented_left: (known: bool, value: i64) = proof_sub_safe(left_constant.value, 1)
                    return false if operator == TokenKind.Gt and decremented_left.known and not proof_add_term_upper_with_work(bounds, right, decremented_left.value, budget, exhausted)
                    return false if (operator == TokenKind.GtEq or operator == TokenKind.EqEq) and not proof_add_term_upper_with_work(bounds, right, left_constant.value, budget, exhausted)
                    incremented_left: (known: bool, value: i64) = proof_add_safe(left_constant.value, 1)
                    return false if operator == TokenKind.Lt and incremented_left.known and not proof_add_term_lower_with_work(bounds, right, incremented_left.value, budget, exhausted)
                    return false if (operator == TokenKind.LtEq or operator == TokenKind.EqEq) and not proof_add_term_lower_with_work(bounds, right, left_constant.value, budget, exhausted)
            return true

        def proof_structural_bound_atom_with_work(term: Ast::Expr, markers: ProofScalarWitnesses&, marker_scale: usize, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, matches: bool):
            cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(term, budget, exhausted)
            return (false, false) if not cost.complete
            return (false, false) if not proof_linear_safety_work_charge_scaled(budget, exhausted, cost.cost, marker_scale + 1)
            return (true, proof_structural_bound_atom_marked(term, markers))

        def proof_add_term_lower_with_work(bounds: mutable darray[ProofBound]&, term: Ast::Expr, value: i64, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            term_cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(term, budget, exhausted)
            return false if not term_cost.complete
            for mutable bound in bounds |bounds, term, value, term_cost, budget, exhausted|:
                return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                continue if not bound.term_key
                bound_cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(bound.term, budget, exhausted)
                return false if not bound_cost.complete
                if proof_expr_equal(bound.term, term):
                    if not bound.has_lower or value > bound.lower:
                        return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                        bound.has_lower <- true
                        bound.lower <- value
                    return true
            return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
            bounds <- bounds.push(ProofBound{name: "", term: term, term_key: true, has_lower: true, lower: value, has_upper: false, upper: 0})
            return true

        def proof_add_term_upper_with_work(bounds: mutable darray[ProofBound]&, term: Ast::Expr, value: i64, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            term_cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(term, budget, exhausted)
            return false if not term_cost.complete
            for mutable bound in bounds |bounds, term, value, term_cost, budget, exhausted|:
                return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                continue if not bound.term_key
                bound_cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(bound.term, budget, exhausted)
                return false if not bound_cost.complete
                if proof_expr_equal(bound.term, term):
                    if not bound.has_upper or value < bound.upper:
                        return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                        bound.has_upper <- true
                        bound.upper <- value
                    return true
            return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
            bounds <- bounds.push(ProofBound{name: "", term: term, term_key: true, has_lower: false, lower: 0, has_upper: true, upper: value})
            return true

        def proof_collect_bounds_marked(expression: Ast::Expr, facts: darray[Ast::Expr]&, markers: ProofScalarWitnesses&, bounds: mutable darray[ProofBound]&) -> void:
            match expression:
                Ast::Expr.Paren(inner, _):
                    proof_collect_bounds_marked(inner, facts, markers, bounds)
                Ast::Expr.Unary(TokenKind.Not, operand, _):
                    match operand:
                        Ast::Expr.Binary(left, TokenKind.Or, right, _):
                            # De Morgan, one level deep as the kernel mirror reads it.
                            proof_collect_negated_comparison(left, facts, markers, bounds)
                            proof_collect_negated_comparison(right, facts, markers, bounds)
                        _:
                            proof_collect_negated_comparison(operand, facts, markers, bounds)
                Ast::Expr.Binary(left, operator, right, position):
                    if operator == TokenKind.And:
                        proof_collect_bounds_marked(left, facts, markers, bounds)
                        proof_collect_bounds_marked(right, facts, markers, bounds)
                        return
                    proof_collect_comparison_bounds(left, operator, right, markers, bounds)
                _:
                    pass

        # The proof AST does not carry compiler type metadata. Unsigned widths therefore travel
        # through the same traced-fact channel as compiler-derived bounds. This marker is opaque
        # to the arithmetic fragment, but it is encoded in the kernel arena and independently
        # recognized by kernel replay. A proof author can manufacture the marker only to lose
        # completeness: it never proves a proposition by itself, and the source trace still has
        # to identify it as a type-bound fact.
        def proof_unsigned_type_marker(name: sview, width: i64, position: Ast::Pos) -> Ast::Expr:
            arguments: darray[Ast::Expr] = [Ast::Expr.Ident(name, position), Ast::Expr.IntLit(width, position)]
            return Ast::Expr.Call(Ast::Expr.Ident("__elisa_unsigned_type_bound", position), arguments, [], position)

        # The same marker over a place rather than a bare name. The bare-name reader intentionally
        # ignores it; the arithmetic-width reader consults it only for an exact field node, so a
        # width cannot spread from a container's synthetic `.count` witness to neighboring terms.
