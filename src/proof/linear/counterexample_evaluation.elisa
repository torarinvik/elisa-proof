# Private exact evaluators used by the diagnostic model search.
extend ElisaProof:
    private:
        def proof_diagnostic_counterexample_diagnostic_int(expression: Ast::Expr, names: darray[sview]&, boolean_names: darray[sview]&, values: darray[i64]&) -> (known: bool, value: i64):
            match expression:
                Ast::Expr.IntLit(value, _):
                    return (true, value)
                Ast::Expr.Paren(inner, _):
                    return proof_diagnostic_counterexample_diagnostic_int(inner, names, boolean_names, values)
                Ast::Expr.Ident(name, _):
                    return (false, 0) if proof_diagnostic_counterexample_has_name(boolean_names, name)
                    index: usize = proof_diagnostic_counterexample_name_index(names, name)
                    return (true, values[index]) if index < values.count
                Ast::Expr.Unary(operator, operand, _):
                    inner: (known: bool, value: i64) = proof_diagnostic_counterexample_diagnostic_int(operand, names, boolean_names, values)
                    return (false, 0) if not inner.known
                    return inner if operator == TokenKind.Plus
                    if operator == TokenKind.Minus:
                        return (false, 0) if inner.value == proof_i64_min()
                        return (true, 0 - inner.value)
                Ast::Expr.Binary(left, operator, right, _):
                    a: (known: bool, value: i64) = proof_diagnostic_counterexample_diagnostic_int(left, names, boolean_names, values)
                    b: (known: bool, value: i64) = proof_diagnostic_counterexample_diagnostic_int(right, names, boolean_names, values)
                    return (false, 0) if not a.known or not b.known
                    if operator == TokenKind.Plus:
                        return proof_add_safe(a.value, b.value)
                    if operator == TokenKind.Minus:
                        return proof_sub_safe(a.value, b.value)
                    if operator == TokenKind.Star:
                        return proof_mul_safe(a.value, b.value)
                    if operator == TokenKind.Slash:
                        return proof_div_safe(a.value, b.value)
                    if operator == TokenKind.Percent:
                        return proof_mod_safe(a.value, b.value)
                    if operator == TokenKind.Ampersand:
                        return (true, a.value & b.value)
                    if operator == TokenKind.Pipe:
                        return (true, a.value | b.value)
                    if operator == TokenKind.Caret:
                        return (true, a.value ^ b.value)
                    if operator == TokenKind.LShift:
                        return proof_shift_safe(a.value, b.value, true)
                    if operator == TokenKind.RShift:
                        return proof_shift_safe(a.value, b.value, false)
                _:
                    pass
            return (false, 0)

        def proof_diagnostic_counterexample_diagnostic_bool(expression: Ast::Expr, names: darray[sview]&, boolean_names: darray[sview]&, values: darray[i64]&) -> (known: bool, value: bool):
            # A compiler type marker states a declared type, not a constraint on the model. It holds at
            # every point of the domain, so bounded enumeration reads it as true.
            return (true, true) if proof_type_marker_callee(expression)
            match expression:
                Ast::Expr.BoolLit(value, _):
                    return (true, value)
                Ast::Expr.Ident(name, _):
                    index: usize = proof_diagnostic_counterexample_name_index(names, name)
                    return (false, false) if not proof_diagnostic_counterexample_has_name(boolean_names, name) or index >= values.count
                    return (true, values[index] != 0)
                Ast::Expr.Paren(inner, _):
                    return proof_diagnostic_counterexample_diagnostic_bool(inner, names, boolean_names, values)
                Ast::Expr.Unary(TokenKind.Not, operand, _):
                    inner: (known: bool, value: bool) = proof_diagnostic_counterexample_diagnostic_bool(operand, names, boolean_names, values)
                    return (inner.known, not inner.value) if inner.known
                Ast::Expr.Binary(left, operator, right, _):
                    if operator == TokenKind.And or operator == TokenKind.Or:
                        a_bool: (known: bool, value: bool) = proof_diagnostic_counterexample_diagnostic_bool(left, names, boolean_names, values)
                        b_bool: (known: bool, value: bool) = proof_diagnostic_counterexample_diagnostic_bool(right, names, boolean_names, values)
                        return (false, false) if not a_bool.known or not b_bool.known
                        return (true, a_bool.value and b_bool.value) if operator == TokenKind.And
                        return (true, a_bool.value or b_bool.value)
                    if proof_is_comparison(operator):
                        a: (known: bool, value: i64) = proof_diagnostic_counterexample_diagnostic_int(left, names, boolean_names, values)
                        b: (known: bool, value: i64) = proof_diagnostic_counterexample_diagnostic_int(right, names, boolean_names, values)
                        if a.known and b.known:
                            return (true, a.value == b.value) if operator == TokenKind.EqEq
                            return (true, a.value != b.value) if operator == TokenKind.BangEq
                            return (true, a.value < b.value) if operator == TokenKind.Lt
                            return (true, a.value > b.value) if operator == TokenKind.Gt
                            return (true, a.value <= b.value) if operator == TokenKind.LtEq
                            return (true, a.value >= b.value) if operator == TokenKind.GtEq
                        if operator == TokenKind.EqEq or operator == TokenKind.BangEq:
                            left_bool: (known: bool, value: bool) = proof_diagnostic_counterexample_diagnostic_bool(left, names, boolean_names, values)
                            right_bool: (known: bool, value: bool) = proof_diagnostic_counterexample_diagnostic_bool(right, names, boolean_names, values)
                            if left_bool.known and right_bool.known:
                                equal: bool = left_bool.value == right_bool.value
                                return (true, equal) if operator == TokenKind.EqEq
                                return (true, not equal)
                _:
                    pass
            return (false, false)

        # The exhaustive bounded-model proof tier uses the same evaluator with no Boolean symbols: its
        # current fragment obtains symbolic values from integer intervals only. Keep this adapter so the
        # diagnostic type inference cannot silently broaden or narrow the kernel's admission rule.
        def proof_diagnostic_counterexample_bool(expression: Ast::Expr, names: darray[sview]&, values: darray[i64]&) -> (known: bool, value: bool):
            boolean_names: darray[sview] = []
            return proof_diagnostic_counterexample_diagnostic_bool(expression, names, boolean_names, values)
