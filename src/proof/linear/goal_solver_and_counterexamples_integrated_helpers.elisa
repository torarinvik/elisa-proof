# Factored helpers retained by the branch integration.
extend ElisaProof:
    public:
        def proof_unsigned_span_cursor_bound(facts: darray[Ast::Expr]&, goal: Ast::Expr) -> bool:
            for fact in facts |fact, facts, goal|:
                match proof_strip_parens(fact):
                    Ast::Expr.Binary(step, relation, span, _):
                        continue if relation != TokenKind.LtEq
                        parts: (known: bool, left: Ast::Expr, right: Ast::Expr) = proof_difference_operands(span)
                        continue if not parts.known
                        end: Ast::Expr = parts.left
                        start: Ast::Expr = parts.right
                        position: Ast::Pos = Ast::expr_pos(span)
                        continue if proof_ident_name(start) == "" or proof_ident_name(end) == "" or proof_ident_name(step) == ""
                        width: i64 = proof_unsigned_width_in_expression(start, facts)
                        continue if width == 0 or proof_unsigned_width_in_expression(end, facts) != width or proof_unsigned_width_in_expression(step, facts) != width
                        continue if not proof_has_order_fact(start, end, false, facts)
                        sum: Ast::Expr = Ast::Expr.Binary(start, TokenKind.Plus, step, position)
                        difference: Ast::Expr = Ast::Expr.Binary(end, TokenKind.Minus, step, position)
                        match proof_strip_parens(goal):
                            Ast::Expr.Binary(left, operator, right, _):
                                continue if operator != TokenKind.LtEq and operator != TokenKind.GtEq
                                low: Ast::Expr = right if operator == TokenKind.GtEq else left
                                high: Ast::Expr = left if operator == TokenKind.GtEq else right
                                return true if:
                                    proof_expr_equal(low, sum) and proof_expr_equal(high, end)
                                    proof_expr_equal(low, start) and proof_expr_equal(high, sum)
                                    proof_expr_equal(low, difference) and proof_expr_equal(high, end)
                                    proof_expr_equal(low, start) and proof_expr_equal(high, difference)
                            _:
                                pass
                    _:
                        pass
            return false

        # For equally typed unsigned names, b <= a makes a - b non-wrapping,
        # hence a - b <= a. Read only this direct order premise; no arithmetic
        # assumptions are reinterpreted through the signed interval solver.
        def proof_unsigned_subtraction_upper_shape(facts: darray[Ast::Expr]&, goal: Ast::Expr) -> bool:
            match proof_strip_parens(goal):
                Ast::Expr.Binary(difference, TokenKind.LtEq, bound, _):
                    match proof_strip_parens(difference):
                        Ast::Expr.Binary(first, TokenKind.Minus, second, _):
                            return false if:
                                proof_ident_name(first) == "" or proof_ident_name(second) == ""
                                not proof_expr_equal(first, bound)
                            width: i64 = proof_unsigned_width_in_expression(first, facts)
                            return false if width == 0 or proof_unsigned_width_in_expression(second, facts) != width
                            return proof_has_order_fact(second, first, false, facts)
                        _:
                            return false
                _:
                    return false

        # A witnessed unsigned sum can be proved below a same-width bound when the facts give
        # `second <= bound - first` and separately establish `first <= bound`. The subtraction
        # and peer-width checks make that witness a non-wrapping proof of the sum itself, so run
        # this shape before the generic unsigned-goal guard rejects the very addition being
        # justified. Signed sums stay on the ordinary fully range-checked path.
        def proof_unsigned_sum_upper_shape(facts: darray[Ast::Expr]&, goal: Ast::Expr) -> bool:
            match proof_strip_parens(goal):
                Ast::Expr.Binary(sum, operator, bound, _):
                    return false if operator != TokenKind.Lt and operator != TokenKind.LtEq
                    operands: (known: bool, left: Ast::Expr, right: Ast::Expr) = proof_sum_operands(sum)
                    return false if not operands.known or proof_unsigned_width_in_expression(sum, facts) == 0
                    return proof_sum_bound_goal(sum, operator, bound, facts)
                _:
                    return false

        # An unsigned unit successor is strictly above its base when the addition is proved
        # non-wrapping. Keep this rule structural: one side must be exactly the other's `+ 1`
        # (in either operand order), both must have the same witnessed unsigned width, and the
        # existing expression-safety checker must establish the successor is in range.
        def proof_unsigned_unit_increment_order_shape(facts: darray[Ast::Expr]&, goal: Ast::Expr) -> bool:
            match proof_strip_parens(goal):
                Ast::Expr.Binary(left, operator, right, _):
                    return false if operator != TokenKind.LtEq and operator != TokenKind.GtEq
                    increment: mutable Ast::Expr = left
                    base: mutable Ast::Expr = right
                    if operator == TokenKind.LtEq:
                        increment <- right
                        base <- left
                    shifted: (known: bool, base: Ast::Expr) = proof_shifted_unit_base(increment)
                    return false if not shifted.known or not proof_expr_equal(shifted.base, base)
                    width: i64 = proof_unsigned_width_in_expression(increment, facts)
                    return false if width == 0 or proof_unsigned_width_in_expression(base, facts) != width
                    return proof_unsigned_expression_safe(increment, facts)
                _:
                    return false

        # If `base <= ceiling / k` for a positive same-width unsigned constant k, then
        # `base * k <= ceiling`. Return only the exact structural witness; division by a
        # different factor, a signed term, or a mismatched-width ceiling cannot close it.
        def proof_unsigned_scaled_product_witness(product: Ast::Expr, facts: darray[Ast::Expr]&, strict_required: bool) -> (known: bool, base: Ast::Expr, bound: Ast::Expr, factor: i64) can[Memory.Allocate, Abort.Panic]:
            unknown: (known: bool, base: Ast::Expr, bound: Ast::Expr, factor: i64) = (false, Ast::Expr.Invalid, Ast::Expr.Invalid, 0)
            match proof_strip_parens(product):
                Ast::Expr.Binary(left, TokenKind.Star, right, _):
                    right_constant: (known: bool, value: i64) = proof_constant_int(right)
                    base: mutable Ast::Expr = left
                    factor_expression: mutable Ast::Expr = right
                    factor: mutable i64 = right_constant.value
                    if not right_constant.known or right_constant.value <= 0:
                        left_constant: (known: bool, value: i64) = proof_constant_int(left)
                        return unknown if not left_constant.known or left_constant.value <= 0
                        base <- right
                        factor_expression <- left
                        factor <- left_constant.value
                    width: i64 = proof_unsigned_width_in_expression(product, facts)
                    return unknown if:
                        width == 0 or proof_unsigned_width_in_expression(base, facts) != width
                        not proof_unsigned_constants_fit(factor_expression, width, 0)
                    conjuncts: darray[Ast::Expr] = proof_conjunct_facts(facts)
                    for fact in conjuncts |fact, base, factor_expression, factor, width|:
                        order: (known: bool, left: Ast::Expr, operator: TokenKind, right: Ast::Expr) = proof_readable_order(fact, facts)
                        continue if not order.known
                        quotient: mutable Ast::Expr = Ast::Expr.Invalid
                        if (order.operator == TokenKind.Lt or (not strict_required and order.operator == TokenKind.LtEq)) and proof_expr_equal(order.left, base):
                            quotient <- order.right
                        elif (order.operator == TokenKind.Gt or (not strict_required and order.operator == TokenKind.GtEq)) and proof_expr_equal(order.right, base):
                            quotient <- order.left
                        else:
                            continue
                        match proof_strip_parens(quotient):
                            Ast::Expr.Binary(ceiling, TokenKind.Slash, divisor, _):
                                divisor_constant: (known: bool, value: i64) = proof_constant_int(divisor)
                                continue if not divisor_constant.known or divisor_constant.value != factor
                                continue if not proof_expr_equal(divisor, factor_expression)
                                continue if proof_unsigned_width_in_expression(ceiling, facts) != width
                                return (true, base, ceiling, factor)
                            _:
                                continue
                    return unknown
                _:
                    return unknown

        # Metered mirror used by recursive unsigned safety. It reuses the caller's decoded
        # markers and charges recursive fact inspection and every scalar/order comparison.
        def proof_unsigned_scaled_product_witness_with_work(product: Ast::Expr, facts: darray[Ast::Expr]&, markers: ProofScalarWitnesses&, strict_required: bool, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, known: bool, base: Ast::Expr, bound: Ast::Expr, factor: i64):
            unknown: (complete: bool, known: bool, base: Ast::Expr, bound: Ast::Expr, factor: i64) = (true, false, Ast::Expr.Invalid, Ast::Expr.Invalid, 0)
            product_view: (complete: bool, expression: Ast::Expr) = proof_unsigned_strip_parens_with_work(product, budget, exhausted)
            return (false, false, Ast::Expr.Invalid, Ast::Expr.Invalid, 0) if not product_view.complete
            match product_view.expression:
                Ast::Expr.Binary(left, TokenKind.Star, right, _):
                    right_constant: (known: bool, value: i64) = proof_constant_int_with_work(right, 0, budget, exhausted)
                    return (false, false, Ast::Expr.Invalid, Ast::Expr.Invalid, 0) if exhausted
                    base: mutable Ast::Expr = left
                    factor_expression: mutable Ast::Expr = right
                    factor: mutable i64 = right_constant.value
                    if not right_constant.known or right_constant.value <= 0:
                        left_constant: (known: bool, value: i64) = proof_constant_int_with_work(left, 0, budget, exhausted)
                        return (false, false, Ast::Expr.Invalid, Ast::Expr.Invalid, 0) if exhausted
                        return unknown if not left_constant.known or left_constant.value <= 0
                        base <- right
                        factor_expression <- left
                        factor <- left_constant.value
                    width: i64 = proof_unsigned_width_in_expression_with_work(product, markers, budget, exhausted)
                    return (false, false, Ast::Expr.Invalid, Ast::Expr.Invalid, 0) if exhausted
                    return unknown if width == 0
                    base_width: i64 = proof_unsigned_width_in_expression_with_work(base, markers, budget, exhausted)
                    return (false, false, Ast::Expr.Invalid, Ast::Expr.Invalid, 0) if exhausted
                    return unknown if base_width != width
                    fits: bool = proof_unsigned_constants_fit_with_work(factor_expression, width, 0, budget, exhausted)
                    return (false, false, Ast::Expr.Invalid, Ast::Expr.Invalid, 0) if exhausted
                    return unknown if not fits
                    marker_scale: (complete: bool, scale: usize) = proof_linear_safety_marker_scale_with_work(markers, budget, exhausted)
                    return (false, false, Ast::Expr.Invalid, Ast::Expr.Invalid, 0) if not marker_scale.complete
                    fact_scan_cost: mutable usize = 0
                    fact_scan_cost_valid: mutable bool = false
                    for fact in facts |fact, facts, markers, marker_scale, fact_scan_cost, fact_scan_cost_valid, strict_required, base, factor_expression, factor, width, budget, exhausted|:
                        order: (complete: bool, known: bool, left: Ast::Expr, operator: TokenKind, right: Ast::Expr) = proof_unsigned_scaled_product_order_with_work(fact, facts, markers, marker_scale.scale, &fact_scan_cost, &fact_scan_cost_valid, 0, budget, exhausted)
                        return (false, false, Ast::Expr.Invalid, Ast::Expr.Invalid, 0) if not order.complete
                        continue if not order.known
                        quotient: mutable Ast::Expr = Ast::Expr.Invalid
                        if (order.operator == TokenKind.Lt or (not strict_required and order.operator == TokenKind.LtEq)) and proof_unsigned_witness_terms_equal_with_work(order.left, base, budget, exhausted):
                            quotient <- order.right
                        elif (order.operator == TokenKind.Gt or (not strict_required and order.operator == TokenKind.GtEq)) and proof_unsigned_witness_terms_equal_with_work(order.right, base, budget, exhausted):
                            quotient <- order.left
                        else:
                            return (false, false, Ast::Expr.Invalid, Ast::Expr.Invalid, 0) if exhausted
                            continue
                        return (false, false, Ast::Expr.Invalid, Ast::Expr.Invalid, 0) if exhausted
                        quotient_view: (complete: bool, expression: Ast::Expr) = proof_unsigned_strip_parens_with_work(quotient, budget, exhausted)
                        return (false, false, Ast::Expr.Invalid, Ast::Expr.Invalid, 0) if not quotient_view.complete
                        match quotient_view.expression:
                            Ast::Expr.Binary(ceiling, TokenKind.Slash, divisor, _):
                                divisor_constant: (known: bool, value: i64) = proof_constant_int_with_work(divisor, 0, budget, exhausted)
                                return (false, false, Ast::Expr.Invalid, Ast::Expr.Invalid, 0) if exhausted
                                continue if not divisor_constant.known or divisor_constant.value != factor
                                same_factor: bool = proof_unsigned_witness_terms_equal_with_work(divisor, factor_expression, budget, exhausted)
                                return (false, false, Ast::Expr.Invalid, Ast::Expr.Invalid, 0) if exhausted
                                continue if not same_factor
                                ceiling_width: i64 = proof_unsigned_width_in_expression_with_work(ceiling, markers, budget, exhausted)
                                return (false, false, Ast::Expr.Invalid, Ast::Expr.Invalid, 0) if exhausted
                                return (true, true, base, ceiling, factor) if ceiling_width == width
                            _:
                                pass
                    return unknown
                _:
                    return unknown

        def proof_unsigned_scaled_product_order_with_work(expression: Ast::Expr, facts: darray[Ast::Expr]&, markers: ProofScalarWitnesses&, marker_scale: usize, fact_scan_cost: mutable usize&, fact_scan_cost_valid: mutable bool&, depth: usize, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, known: bool, left: Ast::Expr, operator: TokenKind, right: Ast::Expr):
            cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(expression, budget, exhausted)
            return (false, false, expression, TokenKind.Eof, expression) if not cost.complete
            stripped_view: (complete: bool, expression: Ast::Expr) = proof_unsigned_strip_parens_with_work(expression, budget, exhausted)
            return (false, false, expression, TokenKind.Eof, expression) if not stripped_view.complete
            stripped: Ast::Expr = stripped_view.expression
            if depth < ElisaProofKernelCore::PROOF_KERNEL_STRUCTURAL_SCAN_DEPTH_LIMIT:
                match stripped:
                    Ast::Expr.Binary(first, TokenKind.And, second, _):
                        first_order: (complete: bool, known: bool, left: Ast::Expr, operator: TokenKind, right: Ast::Expr) = proof_unsigned_scaled_product_order_with_work(first, facts, markers, marker_scale, fact_scan_cost, fact_scan_cost_valid, depth + 1, budget, exhausted)
                        return first_order if not first_order.complete or first_order.known
                        return proof_unsigned_scaled_product_order_with_work(second, facts, markers, marker_scale, fact_scan_cost, fact_scan_cost_valid, depth + 1, budget, exhausted)
                    _:
                        pass
            match stripped:
                Ast::Expr.Binary(left, operator, right, _):
                    return (true, false, expression, TokenKind.Eof, expression) if not proof_is_order_operator(operator)
                    left_scalar: (complete: bool, matches: bool) = proof_linear_safety_scalar_witness_with_work(left, markers, marker_scale, budget, exhausted)
                    return (false, false, expression, TokenKind.Eof, expression) if not left_scalar.complete
                    return (true, false, expression, TokenKind.Eof, expression) if not left_scalar.matches
                    right_scalar: (complete: bool, matches: bool) = proof_linear_safety_scalar_witness_with_work(right, markers, marker_scale, budget, exhausted)
                    return (false, false, expression, TokenKind.Eof, expression) if not right_scalar.complete
                    return (true, right_scalar.matches, left, operator, right)
                Ast::Expr.Unary(TokenKind.Not, operand, _):
                    match operand:
                        Ast::Expr.Binary(left, operator, right, _):
                            negated: TokenKind = proof_comparison_negation(operator)
                            return (true, false, expression, TokenKind.Eof, expression) if not proof_is_order_operator(negated)
                            left_scalar: (complete: bool, matches: bool) = proof_linear_safety_scalar_witness_with_work(left, markers, marker_scale, budget, exhausted)
                            return (false, false, expression, TokenKind.Eof, expression) if not left_scalar.complete
                            return (true, false, expression, TokenKind.Eof, expression) if not left_scalar.matches
                            right_scalar: (complete: bool, matches: bool) = proof_linear_safety_scalar_witness_with_work(right, markers, marker_scale, budget, exhausted)
                            return (false, false, expression, TokenKind.Eof, expression) if not right_scalar.complete
                            return (true, false, expression, TokenKind.Eof, expression) if not right_scalar.matches
                            return (false, false, expression, TokenKind.Eof, expression) if not proof_signed_fact_scan_cost_ensure_with_work(facts, &fact_scan_cost, &fact_scan_cost_valid, budget, exhausted)
                            left_integer: (complete: bool, integer: bool) = proof_disjunction_denial_integer_term_with_work(left, facts, markers, marker_scale, fact_scan_cost, 0, budget, exhausted)
                            return (false, false, expression, TokenKind.Eof, expression) if not left_integer.complete
                            return (true, false, expression, TokenKind.Eof, expression) if not left_integer.integer
                            right_integer: (complete: bool, integer: bool) = proof_disjunction_denial_integer_term_with_work(right, facts, markers, marker_scale, fact_scan_cost, 0, budget, exhausted)
                            return (false, false, expression, TokenKind.Eof, expression) if not right_integer.complete
                            return (right_integer.complete, right_integer.integer, left, negated, right)
                        _:
                            return (true, false, expression, TokenKind.Eof, expression)
                _:
                    return (true, false, expression, TokenKind.Eof, expression)

        def proof_unsigned_increment_has_direct_peer_with_work(base: Ast::Expr, width: i64, facts: darray[Ast::Expr]&, markers: ProofScalarWitnesses&, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, matches: bool):
            return (true, false) if width == 0
            for fact in facts |fact, base, width, facts, markers, budget, exhausted|:
                cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(fact, budget, exhausted)
                return (false, false) if not cost.complete
                candidate_view: (complete: bool, expression: Ast::Expr) = proof_unsigned_strip_parens_with_work(fact, budget, exhausted)
                return (false, false) if not candidate_view.complete
                candidate: Ast::Expr = candidate_view.expression
                left: mutable Ast::Expr = Ast::Expr.Invalid
                right: mutable Ast::Expr = Ast::Expr.Invalid
                operator: mutable TokenKind = TokenKind.Eof
                match candidate:
                    Ast::Expr.Unary(TokenKind.Not, operand, _):
                        operand_view: (complete: bool, expression: Ast::Expr) = proof_unsigned_strip_parens_with_work(operand, budget, exhausted)
                        return (false, false) if not operand_view.complete
                        match operand_view.expression:
                            Ast::Expr.Binary(inner_left, inner_operator, inner_right, _):
                                left <- inner_left
                                right <- inner_right
                                operator <- proof_comparison_negation(inner_operator) if inner_operator == TokenKind.GtEq or inner_operator == TokenKind.LtEq
                            _:
                                pass
                    Ast::Expr.Binary(fact_left, fact_operator, fact_right, _):
                        left <- fact_left
                        right <- fact_right
                        operator <- fact_operator
                    _:
                        pass
                if operator == TokenKind.Lt and proof_unsigned_witness_terms_equal_with_work(left, base, budget, exhausted):
                    peer: (complete: bool, nameable: bool) = proof_unsigned_peer_nameable_with_work(right, budget, exhausted)
                    return (false, false) if exhausted or not peer.complete
                    if peer.nameable:
                        width_match: (complete: bool, matches: bool) = proof_unsigned_peer_width_matches_with_work(right, width, markers, budget, exhausted)
                        return (false, false) if not width_match.complete
                        return (true, true) if width_match.matches
                if operator == TokenKind.Gt and proof_unsigned_witness_terms_equal_with_work(right, base, budget, exhausted):
                    peer: (complete: bool, nameable: bool) = proof_unsigned_peer_nameable_with_work(left, budget, exhausted)
                    return (false, false) if exhausted or not peer.complete
                    if peer.nameable:
                        width_match: (complete: bool, matches: bool) = proof_unsigned_peer_width_matches_with_work(left, width, markers, budget, exhausted)
                        return (false, false) if not width_match.complete
                        return (true, true) if width_match.matches
                return (false, false) if exhausted
            return (true, false)

        def proof_unsigned_increment_has_strict_peer_with_work(base: Ast::Expr, width: i64, facts: darray[Ast::Expr]&, markers: ProofScalarWitnesses&, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, matches: bool):
            direct: (complete: bool, matches: bool) = proof_unsigned_increment_has_direct_peer_with_work(base, width, facts, markers, budget, exhausted)
            return direct if not direct.complete or direct.matches
            for fact in facts |fact, base, width, facts, markers, budget, exhausted|:
                cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(fact, budget, exhausted)
                return (false, false) if not cost.complete
                match fact:
                    Ast::Expr.Binary(fact_left, TokenKind.LtEq, fact_right, _):
                        left_matches: bool = proof_unsigned_witness_terms_equal_with_work(fact_left, base, budget, exhausted)
                        return (false, false) if exhausted
                        continue if not left_matches
                        peer: (complete: bool, nameable: bool) = proof_unsigned_peer_nameable_with_work(fact_right, budget, exhausted)
                        return (false, false) if not peer.complete
                        continue if not peer.nameable
                        same_base: bool = proof_unsigned_witness_terms_equal_with_work(fact_right, base, budget, exhausted)
                        return (false, false) if exhausted
                        continue if same_base
                        middle: (complete: bool, matches: bool) = proof_unsigned_increment_has_direct_peer_with_work(fact_right, width, facts, markers, budget, exhausted)
                        return middle if not middle.complete or middle.matches
                    Ast::Expr.Binary(fact_left, TokenKind.GtEq, fact_right, _):
                        right_matches: bool = proof_unsigned_witness_terms_equal_with_work(fact_right, base, budget, exhausted)
                        return (false, false) if exhausted
                        continue if not right_matches
                        peer: (complete: bool, nameable: bool) = proof_unsigned_peer_nameable_with_work(fact_left, budget, exhausted)
                        return (false, false) if not peer.complete
                        continue if not peer.nameable
                        same_base: bool = proof_unsigned_witness_terms_equal_with_work(fact_left, base, budget, exhausted)
                        return (false, false) if exhausted
                        continue if same_base
                        middle: (complete: bool, matches: bool) = proof_unsigned_increment_has_direct_peer_with_work(fact_left, width, facts, markers, budget, exhausted)
                        return middle if not middle.complete or middle.matches
                    _:
                        pass
                return (false, false) if exhausted
            return (true, false)

        def proof_unsigned_peer_nameable_with_work(expression: Ast::Expr, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, nameable: bool):
            cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(expression, budget, exhausted)
            return (false, false) if not cost.complete
            peer_view: (complete: bool, expression: Ast::Expr) = proof_unsigned_strip_parens_with_work(expression, budget, exhausted)
            return (false, false) if not peer_view.complete
            match peer_view.expression:
                Ast::Expr.Ident(name, _):
                    return (true, name != "")
                Ast::Expr.Field(object, field_name, _):
                    return (true, false) if field_name == ""
                    object_view: (complete: bool, expression: Ast::Expr) = proof_unsigned_strip_parens_with_work(object, budget, exhausted)
                    return (false, false) if not object_view.complete
                    return (true, proof_ident_name(object_view.expression) != "")
                _:
                    return (true, false)

        def proof_unsigned_peer_width_matches_with_work(expression: Ast::Expr, width: i64, markers: ProofScalarWitnesses&, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, matches: bool):
            declared: i64 = proof_unsigned_width_in_expression_with_work(expression, markers, budget, exhausted)
            return (false, false) if exhausted
            return (true, declared == width) if declared != 0
            expression_view: (complete: bool, expression: Ast::Expr) = proof_unsigned_strip_parens_with_work(expression, budget, exhausted)
            return (false, false) if not expression_view.complete
            match expression_view.expression:
                Ast::Expr.Field(object, field_name, _):
                    return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, sview_len(field_name))
                    return (true, false) if field_name != "count"
                    object_view: (complete: bool, expression: Ast::Expr) = proof_unsigned_strip_parens_with_work(object, budget, exhausted)
                    return (false, false) if not object_view.complete
                    return (true, proof_ident_name(object_view.expression) != "" and width == 64)
                _:
                    return (true, false)

        def proof_sum_upper_witness_with_work(left: Ast::Expr, right: Ast::Expr, facts: darray[Ast::Expr]&, markers: ProofScalarWitnesses&, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, known: bool, bound: Ast::Expr, strict: bool):
            marker_scale: (complete: bool, scale: usize) = proof_linear_safety_marker_scale_with_work(markers, budget, exhausted)
            return (false, false, Ast::Expr.Invalid, false) if not marker_scale.complete
            fact_scan_cost: mutable usize = 0
            fact_scan_cost_valid: mutable bool = false
            forward: (complete: bool, known: bool, bound: Ast::Expr, strict: bool) = proof_sum_witness_for_with_work(left, right, facts, markers, marker_scale.scale, &fact_scan_cost, &fact_scan_cost_valid, budget, exhausted)
            return forward if not forward.complete or forward.known
            return proof_sum_witness_for_with_work(right, left, facts, markers, marker_scale.scale, &fact_scan_cost, &fact_scan_cost_valid, budget, exhausted)

        def proof_sum_witness_for_with_work(first: Ast::Expr, second: Ast::Expr, facts: darray[Ast::Expr]&, markers: ProofScalarWitnesses&, marker_scale: usize, fact_scan_cost: mutable usize&, fact_scan_cost_valid: mutable bool&, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, known: bool, bound: Ast::Expr, strict: bool):
            for fact in facts |fact, facts, first, second, markers, marker_scale, fact_scan_cost, fact_scan_cost_valid, budget, exhausted|:
                witness: (complete: bool, known: bool, bound: Ast::Expr, strict: bool) = proof_sum_witness_fact_with_work(fact, first, second, facts, markers, marker_scale, fact_scan_cost, fact_scan_cost_valid, 0, budget, exhausted)
                return witness if not witness.complete or witness.known
            return (not exhausted, false, Ast::Expr.Invalid, false)

        def proof_sum_witness_fact_with_work(expression: Ast::Expr, first: Ast::Expr, second: Ast::Expr, facts: darray[Ast::Expr]&, markers: ProofScalarWitnesses&, marker_scale: usize, fact_scan_cost: mutable usize&, fact_scan_cost_valid: mutable bool&, depth: usize, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, known: bool, bound: Ast::Expr, strict: bool):
            cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(expression, budget, exhausted)
            return (false, false, Ast::Expr.Invalid, false) if not cost.complete
            fact_view: (complete: bool, expression: Ast::Expr) = proof_unsigned_strip_parens_with_work(expression, budget, exhausted)
            return (false, false, Ast::Expr.Invalid, false) if not fact_view.complete
            fact: Ast::Expr = fact_view.expression
            if depth < ElisaProofKernelCore::PROOF_KERNEL_STRUCTURAL_SCAN_DEPTH_LIMIT:
                match fact:
                    Ast::Expr.Binary(left, TokenKind.And, right, _):
                        first_witness: (complete: bool, known: bool, bound: Ast::Expr, strict: bool) = proof_sum_witness_fact_with_work(left, first, second, facts, markers, marker_scale, fact_scan_cost, fact_scan_cost_valid, depth + 1, budget, exhausted)
                        return first_witness if not first_witness.complete or first_witness.known
                        return proof_sum_witness_fact_with_work(right, first, second, facts, markers, marker_scale, fact_scan_cost, fact_scan_cost_valid, depth + 1, budget, exhausted)
                    _:
                        pass
            order: (complete: bool, known: bool, left: Ast::Expr, operator: TokenKind, right: Ast::Expr) = proof_unsigned_scaled_product_order_with_work(fact, facts, markers, marker_scale, fact_scan_cost, fact_scan_cost_valid, ElisaProofKernelCore::PROOF_KERNEL_STRUCTURAL_SCAN_DEPTH_LIMIT, budget, exhausted)
            return (false, false, Ast::Expr.Invalid, false) if not order.complete
            return (true, false, Ast::Expr.Invalid, false) if not order.known or (order.operator != TokenKind.Lt and order.operator != TokenKind.LtEq)
            difference_cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(order.right, budget, exhausted)
            return (false, false, Ast::Expr.Invalid, false) if not difference_cost.complete
            difference_view: (complete: bool, expression: Ast::Expr) = proof_unsigned_strip_parens_with_work(order.right, budget, exhausted)
            return (false, false, Ast::Expr.Invalid, false) if not difference_view.complete
            difference: Ast::Expr = difference_view.expression
            match difference:
                Ast::Expr.Binary(bound, TokenKind.Minus, minuend, _):
                    return (false, false, Ast::Expr.Invalid, false) if:
                        not proof_unsigned_witness_terms_equal_with_work(minuend, first, budget, exhausted)
                        exhausted
                    first_bounded: (complete: bool, matches: bool) = proof_sum_has_order_fact_with_work(first, bound, false, facts, markers, marker_scale, fact_scan_cost, fact_scan_cost_valid, budget, exhausted)
                    return (false, false, Ast::Expr.Invalid, false) if not first_bounded.complete
                    return (true, false, Ast::Expr.Invalid, false) if not first_bounded.matches
                    same_second: bool = proof_unsigned_witness_terms_equal_with_work(order.left, second, budget, exhausted)
                    return (false, false, Ast::Expr.Invalid, false) if exhausted
                    return (true, true, bound, order.operator == TokenKind.Lt) if same_second
                    second_strictly_below: (complete: bool, matches: bool) = proof_sum_has_order_fact_with_work(second, order.left, true, facts, markers, marker_scale, fact_scan_cost, fact_scan_cost_valid, budget, exhausted)
                    return (false, false, Ast::Expr.Invalid, false) if not second_strictly_below.complete
                    return (true, true, bound, true) if second_strictly_below.matches
                    if order.operator == TokenKind.Lt:
                        second_below: (complete: bool, matches: bool) = proof_sum_has_order_fact_with_work(second, order.left, false, facts, markers, marker_scale, fact_scan_cost, fact_scan_cost_valid, budget, exhausted)
                        return (false, false, Ast::Expr.Invalid, false) if not second_below.complete
                        return (true, true, bound, true) if second_below.matches
                    second_bounded: (complete: bool, matches: bool) = proof_sum_has_order_fact_with_work(second, order.left, false, facts, markers, marker_scale, fact_scan_cost, fact_scan_cost_valid, budget, exhausted)
                    return (false, false, Ast::Expr.Invalid, false) if not second_bounded.complete
                    return (true, true, bound, false) if second_bounded.matches
                    return (true, false, Ast::Expr.Invalid, false)
                _:
                    return (true, false, Ast::Expr.Invalid, false)

        def proof_sum_has_order_fact_with_work(term: Ast::Expr, bound: Ast::Expr, strict_only: bool, facts: darray[Ast::Expr]&, markers: ProofScalarWitnesses&, marker_scale: usize, fact_scan_cost: mutable usize&, fact_scan_cost_valid: mutable bool&, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, matches: bool):
            for fact in facts |fact, term, bound, strict_only, facts, markers, marker_scale, fact_scan_cost, fact_scan_cost_valid, budget, exhausted|:
                found: (complete: bool, matches: bool) = proof_sum_has_order_in_fact_with_work(fact, term, bound, strict_only, facts, markers, marker_scale, fact_scan_cost, fact_scan_cost_valid, 0, budget, exhausted)
                return found if not found.complete or found.matches
            return (not exhausted, false)

        def proof_sum_has_order_in_fact_with_work(expression: Ast::Expr, term: Ast::Expr, bound: Ast::Expr, strict_only: bool, facts: darray[Ast::Expr]&, markers: ProofScalarWitnesses&, marker_scale: usize, fact_scan_cost: mutable usize&, fact_scan_cost_valid: mutable bool&, depth: usize, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, matches: bool):
            cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(expression, budget, exhausted)
            return (false, false) if not cost.complete
            fact_view: (complete: bool, expression: Ast::Expr) = proof_unsigned_strip_parens_with_work(expression, budget, exhausted)
            return (false, false) if not fact_view.complete
            fact: Ast::Expr = fact_view.expression
            if depth < ElisaProofKernelCore::PROOF_KERNEL_STRUCTURAL_SCAN_DEPTH_LIMIT:
                match fact:
                    Ast::Expr.Binary(left, TokenKind.And, right, _):
                        first_match: (complete: bool, matches: bool) = proof_sum_has_order_in_fact_with_work(left, term, bound, strict_only, facts, markers, marker_scale, fact_scan_cost, fact_scan_cost_valid, depth + 1, budget, exhausted)
                        return first_match if not first_match.complete or first_match.matches
                        return proof_sum_has_order_in_fact_with_work(right, term, bound, strict_only, facts, markers, marker_scale, fact_scan_cost, fact_scan_cost_valid, depth + 1, budget, exhausted)
                    _:
                        pass
            order: (complete: bool, known: bool, left: Ast::Expr, operator: TokenKind, right: Ast::Expr) = proof_unsigned_scaled_product_order_with_work(fact, facts, markers, marker_scale, fact_scan_cost, fact_scan_cost_valid, ElisaProofKernelCore::PROOF_KERNEL_STRUCTURAL_SCAN_DEPTH_LIMIT, budget, exhausted)
            return (false, false) if not order.complete
            return (true, false) if not order.known
            left_matches: bool = proof_unsigned_witness_terms_equal_with_work(order.left, term, budget, exhausted)
            return (false, false) if exhausted
            right_matches: bool = proof_unsigned_witness_terms_equal_with_work(order.right, bound, budget, exhausted)
            return (false, false) if exhausted
            if order.operator == TokenKind.Lt and left_matches and right_matches:
                return (true, true)
            left_reverse: bool = proof_unsigned_witness_terms_equal_with_work(order.right, term, budget, exhausted)
            return (false, false) if exhausted
            right_reverse: bool = proof_unsigned_witness_terms_equal_with_work(order.left, bound, budget, exhausted)
            return (false, false) if exhausted
            if order.operator == TokenKind.Gt and left_reverse and right_reverse:
                return (true, true)
            return (true, false) if strict_only
            if order.operator == TokenKind.LtEq and left_matches and right_matches:
                return (true, true)
            return (true, order.operator == TokenKind.GtEq and left_reverse and right_reverse)

        def proof_unsigned_scaled_product_upper_shape(facts: darray[Ast::Expr]&, goal: Ast::Expr) -> bool:
            match proof_strip_parens(goal):
                Ast::Expr.Binary(product, operator, bound, _):
                    return false if operator != TokenKind.LtEq and operator != TokenKind.Lt
                    witness: (known: bool, base: Ast::Expr, bound: Ast::Expr, factor: i64) = proof_unsigned_scaled_product_witness(product, facts, operator == TokenKind.Lt)
                    return witness.known and proof_expr_equal(witness.bound, bound)
                _:
                    return false

        def proof_sum_bound_goal_with_work(left: Ast::Expr, operator: TokenKind, right: Ast::Expr, facts: darray[Ast::Expr]&, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, proven: bool):
            return (true, false) if operator != TokenKind.Lt and operator != TokenKind.LtEq
            left_cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(left, budget, exhausted)
            return (false, false) if not left_cost.complete
            sum_view: (complete: bool, expression: Ast::Expr) = proof_linear_strip_parens_with_work(left, budget, exhausted)
            return (false, false) if not sum_view.complete or exhausted
            match sum_view.expression:
                Ast::Expr.Binary(first, TokenKind.Plus, second, _):
                    markers_result: (complete: bool, witnesses: ProofScalarWitnesses) = proof_scalar_witness_markers_with_work(facts, true, budget, exhausted)
                    return (false, false) if not markers_result.complete or exhausted
                    markers: mutable ProofScalarWitnesses = markers_result.witnesses
                    witness: (complete: bool, known: bool, bound: Ast::Expr, strict: bool) = proof_sum_upper_witness_with_work(first, second, facts, markers, budget, exhausted)
                    return (false, false) if not witness.complete or exhausted
                    return (true, false) if not witness.known or operator == TokenKind.Lt and not witness.strict
                    same_bound: bool = proof_unsigned_witness_terms_equal_with_work(witness.bound, right, budget, exhausted)
                    return (false, false) if exhausted
                    return (true, false) if not same_bound
                    width: i64 = proof_unsigned_width_in_expression_with_work(left, markers, budget, exhausted)
                    return (false, false) if exhausted
                    if width == 0:
                        bounds: mutable darray[ProofBound] = []
                        signed_bounds: mutable darray[ProofBound] = []
                        return (false, false) if not proof_collect_fact_bounds_with_work(facts, markers, &bounds, budget, exhausted)
                        return (false, false) if not proof_close_equalities_with_work(facts, markers, &bounds, budget, exhausted)
                        return (false, false) if not proof_signed_safety_bounds_from_base_with_work(facts, bounds, &signed_bounds, markers, budget, exhausted)
                        safe: bool = proof_unsigned_expression_safe_with_context_and_markers_work(left, facts, &bounds, signed_bounds, markers, budget, exhausted)
                        return (false, false) if exhausted
                        return (safe, safe)
                    nameable: (complete: bool, nameable: bool) = proof_unsigned_peer_nameable_with_work(witness.bound, budget, exhausted)
                    return (false, false) if not nameable.complete
                    peer_width: (complete: bool, matches: bool) = proof_unsigned_peer_width_matches_with_work(witness.bound, width, markers, budget, exhausted)
                    return (false, false) if not peer_width.complete or exhausted
                    return (true, true) if nameable.nameable and peer_width.matches
                    bound_view: (complete: bool, expression: Ast::Expr) = proof_linear_strip_parens_with_work(witness.bound, budget, exhausted)
                    return (false, false) if not bound_view.complete or exhausted
                    match bound_view.expression:
                        Ast::Expr.IntLit(value, _):
                            return (true, value >= 0 and value <= proof_unsigned_width_max(width))
                        _:
                            return (true, false)
                _:
                    return (true, false)

        def proof_strict_shift_goal_with_work(left: Ast::Expr, operator: TokenKind, right: Ast::Expr, facts: darray[Ast::Expr]&, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, proven: bool):
            return (true, false) if operator != TokenKind.LtEq
            left_view: (complete: bool, expression: Ast::Expr) = proof_linear_strip_parens_with_work(left, budget, exhausted)
            return (false, false) if not left_view.complete or exhausted
            match left_view.expression:
                Ast::Expr.Binary(first, TokenKind.Plus, second, _):
                    shifted: (known: bool, base: Ast::Expr) = proof_unsigned_unit_increment_base_with_work(first, second, budget, exhausted)
                    return (false, false) if exhausted
                    return (true, false) if not shifted.known
                    bounds: mutable darray[ProofBound] = []
                    signed_bounds: mutable darray[ProofBound] = []
                    markers: mutable ProofScalarWitnesses = ProofScalarWitnesses{untrusted_terms: [], scalar_terms: [], names: [], name_unsigned_widths: [], signed_terms: [], signed_widths: [], element_terms: [], element_depths: [], element_widths: [], unsigned_terms: [], unsigned_widths: [], name_hashes: [], name_slots: [], sorted_name_indices: [], signed_hashes: [], signed_slots: [], unsigned_hashes: [], unsigned_slots: []}
                    return (false, false) if not proof_unsigned_safety_context_with_work(facts, &bounds, &signed_bounds, &markers, budget, exhausted)
                    safe: bool = proof_unsigned_expression_safe_with_context_and_markers_work(left, facts, &bounds, signed_bounds, markers, budget, exhausted)
                    return (false, false) if exhausted
                    return (true, false) if not safe
                    marker_scale: (complete: bool, scale: usize) = proof_linear_safety_marker_scale_with_work(markers, budget, exhausted)
                    return (false, false) if not marker_scale.complete
                    fact_scan_cost: mutable usize = 0
                    fact_scan_cost_valid: mutable bool = false
                    for fact in facts |fact, shifted, right, facts, markers, marker_scale, fact_scan_cost, fact_scan_cost_valid, budget, exhausted|:
                        match fact:
                            Ast::Expr.Paren(_, _):
                                continue
                            _:
                                pass
                        order: (complete: bool, known: bool, left: Ast::Expr, operator: TokenKind, right: Ast::Expr) = proof_unsigned_scaled_product_order_with_work(fact, facts, markers, marker_scale.scale, &fact_scan_cost, &fact_scan_cost_valid, ElisaProofKernelCore::PROOF_KERNEL_STRUCTURAL_SCAN_DEPTH_LIMIT, budget, exhausted)
                        return (false, false) if not order.complete
                        continue if not order.known or (order.operator != TokenKind.Lt and order.operator != TokenKind.Gt)
                        if order.operator == TokenKind.Lt:
                            left_matches: bool = proof_unsigned_witness_terms_equal_with_work(order.left, shifted.base, budget, exhausted)
                            return (false, false) if exhausted
                            right_matches: bool = proof_unsigned_witness_terms_equal_with_work(order.right, right, budget, exhausted)
                            return (false, false) if exhausted
                            return (true, true) if left_matches and right_matches
                        else:
                            left_matches: bool = proof_unsigned_witness_terms_equal_with_work(order.right, shifted.base, budget, exhausted)
                            return (false, false) if exhausted
                            right_matches: bool = proof_unsigned_witness_terms_equal_with_work(order.left, right, budget, exhausted)
                            return (false, false) if exhausted
                            return (true, true) if left_matches and right_matches
                    return (not exhausted, false)
                _:
                    return (true, false)
