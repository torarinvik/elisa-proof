extend ElisaProof:
    public:
        # Pure same-width subtraction has a well-defined machine value even
        # when it wraps. Recording its equality does not assert an integer range.
        def proof_unsigned_named_subtraction_value(value: Ast::Expr, width: i64, facts: darray[Ast::Expr]&) -> bool:
            return false if width != 8 and width != 16 and width != 32 and width != 64
            match value:
                Ast::Expr.Binary(a, TokenKind.Minus, b, _):
                    return proof_ident_name(a) != "" and proof_ident_name(b) != "" and proof_peer_unsigned_width(a, facts) == width and proof_peer_unsigned_width(b, facts) == width and proof_primitive_comparison(a, b, facts)
                _:
                    return false

        def proof_unsigned_named_subtraction_value_with_work(value: Ast::Expr, width: i64, markers: ProofScalarWitnesses&, marker_scale: usize, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, matches: bool):
            return (true, false) if width != 8 and width != 16 and width != 32 and width != 64
            match value:
                Ast::Expr.Binary(left, TokenKind.Minus, right, _):
                    return (true, false) if proof_ident_name(left) == "" or proof_ident_name(right) == ""
                    left_width: i64 = proof_unsigned_width_in_expression_with_work(left, markers, budget, exhausted)
                    right_width: i64 = proof_unsigned_width_in_expression_with_work(right, markers, budget, exhausted)
                    return (false, false) if exhausted
                    return (true, false) if left_width != width or right_width != width
                    comparison: (complete: bool, matches: bool) = proof_linear_safety_comparison_with_work(left, right, markers, marker_scale, budget, exhausted)
                    return comparison
                _:
                    return (true, false)

        def proof_subtraction_alias_expr_equal_with_work(left: Ast::Expr, right: Ast::Expr, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            equal: (complete: bool, matches: bool) = proof_linear_search_expr_equal_with_work(left, right, budget, PROOF_LINEAR_SAFETY_WORK_LIMIT, true)
            if not equal.complete:
                exhausted <- true
                return false
            equal.matches

        def proof_subtraction_alias_mentions_name_with_work(expression: Ast::Expr, target: sview, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            shape: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(expression, budget, exhausted)
            return false if not shape.complete or exhausted
            target_length: usize = sview_len(target)
            multiplier: usize = target_length + 1
            return false if multiplier == 0 or not proof_linear_safety_work_charge_scaled(budget, exhausted, shape.cost, multiplier)
            proof_expr_mentions_name(expression, target)

        def proof_subtraction_alias_rewrite(expression: Ast::Expr, term: Ast::Expr, alias: Ast::Expr, depth: usize, budget: mutable usize&, exhausted: mutable bool&) -> Ast::Expr:
            if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT or budget >= PROOF_LINEAR_MAX_ENUMERATED_ELEMENTS:
                exhausted <- true
                return Ast::Expr.Invalid
            budget <- budget + 1
            return alias if proof_subtraction_alias_expr_equal_with_work(expression, term, budget, exhausted)
            return Ast::Expr.Invalid if exhausted
            match expression:
                Ast::Expr.Paren(inner, position):
                    rewritten = proof_subtraction_alias_rewrite(inner, term, alias, depth + 1, budget, exhausted)
                    return Ast::Expr.Invalid if exhausted
                    return expression if proof_subtraction_alias_expr_equal_with_work(inner, rewritten, budget, exhausted)
                    return Ast::Expr.Invalid if exhausted
                    return Ast::Expr.Paren(rewritten, position)
                Ast::Expr.Unary(operator, inner, position):
                    rewritten = proof_subtraction_alias_rewrite(inner, term, alias, depth + 1, budget, exhausted)
                    return Ast::Expr.Invalid if exhausted
                    return expression if proof_subtraction_alias_expr_equal_with_work(inner, rewritten, budget, exhausted)
                    return Ast::Expr.Invalid if exhausted
                    return Ast::Expr.Unary(operator, rewritten, position)
                Ast::Expr.Binary(left, operator, right, position):
                    a = proof_subtraction_alias_rewrite(left, term, alias, depth + 1, budget, exhausted)
                    return Ast::Expr.Invalid if exhausted
                    b = proof_subtraction_alias_rewrite(right, term, alias, depth + 1, budget, exhausted)
                    return Ast::Expr.Invalid if exhausted
                    left_unchanged: bool = proof_subtraction_alias_expr_equal_with_work(left, a, budget, exhausted)
                    return Ast::Expr.Invalid if exhausted
                    right_unchanged: bool = proof_subtraction_alias_expr_equal_with_work(right, b, budget, exhausted)
                    return Ast::Expr.Invalid if exhausted
                    return expression if left_unchanged and right_unchanged
                    return Ast::Expr.Binary(a, operator, b, position)
                Ast::Expr.If(condition, then_expression, else_expression, position):
                    c = proof_subtraction_alias_rewrite(condition, term, alias, depth + 1, budget, exhausted)
                    return Ast::Expr.Invalid if exhausted
                    a = proof_subtraction_alias_rewrite(then_expression, term, alias, depth + 1, budget, exhausted)
                    return Ast::Expr.Invalid if exhausted
                    b = proof_subtraction_alias_rewrite(else_expression, term, alias, depth + 1, budget, exhausted)
                    return Ast::Expr.Invalid if exhausted
                    condition_unchanged: bool = proof_subtraction_alias_expr_equal_with_work(condition, c, budget, exhausted)
                    return Ast::Expr.Invalid if exhausted
                    then_unchanged: bool = proof_subtraction_alias_expr_equal_with_work(then_expression, a, budget, exhausted)
                    return Ast::Expr.Invalid if exhausted
                    else_unchanged: bool = proof_subtraction_alias_expr_equal_with_work(else_expression, b, budget, exhausted)
                    return Ast::Expr.Invalid if exhausted
                    return expression if condition_unchanged and then_unchanged and else_unchanged
                    return Ast::Expr.If(c, a, b, position)
                _:
                    # No traversal through binders, calls or resource places.
                    return expression

        def proof_subtraction_alias_goal(facts: darray[Ast::Expr]&, goal: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, operator_mask: usize, depth: usize, budget: mutable usize&, split_depth: usize, exhausted: mutable bool&) -> bool can[Global{Read,Write}]:
            # Subtracting a source-pinned zero is an exact machine identity,
            # including at u64::MAX. Do not reinterpret arbitrary subtraction
            # as unbounded signed arithmetic or rewrite overloaded operators.
            marker_result: (complete: bool, witnesses: ProofScalarWitnesses) = proof_scalar_witness_markers_with_work(facts, false, budget, exhausted)
            return false if not marker_result.complete or exhausted
            marker_scale_result: (complete: bool, scale: usize) = proof_linear_safety_marker_scale_with_work(marker_result.witnesses, budget, exhausted)
            return false if not marker_scale_result.complete or exhausted
            markers: ProofScalarWitnesses = marker_result.witnesses
            marker_scale: usize = marker_scale_result.scale
            goal_view: (complete: bool, stripped: Ast::Expr) = proof_linear_strip_parens_with_work(goal, budget, exhausted)
            return false if not goal_view.complete or exhausted
            match goal_view.stripped:
                Ast::Expr.Binary(left, TokenKind.EqEq, right, position):
                    for orientation in 0..<2 |orientation, left, right, position, facts, annotations, operator_mask, depth, budget, split_depth, exhausted|:
                        term: Ast::Expr = right if orientation == 0 else left
                        peer: Ast::Expr = left if orientation == 0 else right
                        term_view: (complete: bool, stripped: Ast::Expr) = proof_linear_strip_parens_with_work(term, budget, exhausted)
                        return false if not term_view.complete or exhausted
                        match term_view.stripped:
                            Ast::Expr.Binary(base, TokenKind.Minus, zero, _):
                                width: i64 = proof_unsigned_width_in_expression_with_work(base, markers, budget, exhausted)
                                return false if exhausted
                                continue if width != 8 and width != 16 and width != 32 and width != 64
                                continue if proof_ident_name(base) == "" or proof_ident_name(zero) == ""
                                zero_width: i64 = proof_unsigned_width_in_expression_with_work(zero, markers, budget, exhausted)
                                return false if exhausted
                                continue if zero_width != width
                                primitive: (complete: bool, matches: bool) = proof_linear_safety_comparison_with_work(peer, term, markers, marker_scale, budget, exhausted)
                                return false if not primitive.complete or exhausted
                                continue if not primitive.matches
                                pin: (complete: bool, known: bool, value: i64) = proof_pinned_constant_value_with_work(zero, facts, budget, exhausted)
                                return false if not pin.complete or exhausted
                                continue if not pin.known or pin.value != 0
                                rewritten = Ast::Expr.Binary(peer, TokenKind.EqEq, base, position)
                                return (proof_goal_depth(facts, rewritten, annotations, operator_mask, depth + 1, budget, split_depth, exhausted) can Global{Read,Write})
                            _:
                                pass
                _:
                    pass
            for fact in facts |fact, facts, goal, annotations, operator_mask, depth, budget, split_depth, exhausted|:
                return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                fact_view: (complete: bool, stripped: Ast::Expr) = proof_linear_strip_parens_with_work(fact, budget, exhausted)
                return false if not fact_view.complete or exhausted
                match fact_view.stripped:
                    Ast::Expr.Binary(left, TokenKind.EqEq, right, _):
                        alias: Ast::Expr = left if proof_ident_name(left) != "" else right
                        term: Ast::Expr = right if proof_ident_name(left) != "" else left
                        name: sview = proof_ident_name(alias)
                        continue if name == ""
                        term_mentions_alias: bool = proof_subtraction_alias_mentions_name_with_work(term, name, budget, exhausted)
                        return false if exhausted
                        continue if term_mentions_alias
                        width: i64 = proof_unsigned_width_in_expression_with_work(alias, markers, budget, exhausted)
                        return false if exhausted
                        named_subtraction: (complete: bool, matches: bool) = proof_unsigned_named_subtraction_value_with_work(term, width, markers, marker_scale, budget, exhausted)
                        return false if not named_subtraction.complete or exhausted
                        continue if not named_subtraction.matches
                        primitive: (complete: bool, matches: bool) = proof_linear_safety_comparison_with_work(alias, term, markers, marker_scale, budget, exhausted)
                        return false if not primitive.complete or exhausted
                        continue if not primitive.matches
                        rewritten = proof_subtraction_alias_rewrite(goal, term, alias, 0, budget, exhausted)
                        return false if proof_replay_summary_bool_ref_value(exhausted)
                        goal_unchanged: bool = proof_subtraction_alias_expr_equal_with_work(goal, rewritten, budget, exhausted)
                        return false if exhausted
                        continue if goal_unchanged
                        return (proof_goal_depth(facts, rewritten, annotations, operator_mask, depth + 1, budget, split_depth, exhausted) can Global{Read,Write})
                    _:
                        pass
            return false
