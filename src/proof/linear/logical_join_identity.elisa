extend ElisaProof:
    public:
        # Comparisons remain opaque atoms: no arithmetic evaluation or operator
        # complementation. Only stable, witnessed primitive operands qualify.
        def proof_logical_comparison_operand(expression: Ast::Expr, facts: darray[Ast::Expr]&) -> bool:
            match proof_strip_parens(expression):
                Ast::Expr.Ident(_, _) | Ast::Expr.Scope(_, _, _) | Ast::Expr.IntLit(_, _) | Ast::Expr.BoolLit(_, _) | Ast::Expr.CharLit(_, _):
                    return proof_scalar_term_witnessed(expression, facts, 0)
                _:
                    return false

        def proof_logical_comparison_atom(expression: Ast::Expr, facts: darray[Ast::Expr]&) -> bool:
            current = proof_strip_parens(expression)
            for fact in facts:
                marker = proof_untrusted_operator_marker_info(fact)
                return false if marker.known and proof_scalar_untrusted_operator_applies(current, marker.term, 0)
            match current:
                Ast::Expr.Binary(left, operator, right, _):
                    return false if operator != TokenKind.EqEq and operator != TokenKind.BangEq and operator != TokenKind.Lt and operator != TokenKind.LtEq and operator != TokenKind.Gt and operator != TokenKind.GtEq
                    return proof_logical_comparison_operand(left, facts) and proof_logical_comparison_operand(right, facts)
                _:
                    return false

        struct ProofLogicalSignedAtom:
            expression: Ast::Expr
            negated: bool
            constant: bool
            value: bool

        def proof_logical_signed_operator(expression: Ast::Expr, negated: bool = false, depth: usize = 0) -> TokenKind:
            return TokenKind.Eof if depth >= 64
            match proof_strip_parens(expression):
                Ast::Expr.Unary(TokenKind.Not, inner, _):
                    return proof_logical_signed_operator(inner, not negated, depth + 1)
                Ast::Expr.Binary(_, operator, _, _):
                    return TokenKind.Eof if operator != TokenKind.And and operator != TokenKind.Or
                    return (TokenKind.Or if operator == TokenKind.And else TokenKind.And) if negated else operator
                _:
                    return TokenKind.Eof

        # Negation-normal form without distribution or synthetic premise facts.
        def proof_logical_signed_atoms(expression: Ast::Expr, operator: TokenKind, negated: bool, facts: darray[Ast::Expr]&, atoms: mutable darray[ProofLogicalSignedAtom]&, fuel: mutable usize&, depth: usize = 0) -> bool:
            return false if fuel == 0 or depth >= 64 or atoms.count >= 64
            fuel <- fuel - 1
            current = proof_strip_parens(expression)
            folded = proof_logical_constant(current, facts, fuel, depth)
            return false if not folded.valid
            if folded.known:
                value = not folded.value if negated else folded.value
                return true if (operator == TokenKind.And and value) or (operator == TokenKind.Or and not value)
                atoms.push(ProofLogicalSignedAtom{expression: current, negated: false, constant: true, value: value})
                return true
            match current:
                Ast::Expr.Unary(TokenKind.Not, inner, _):
                    return proof_logical_signed_atoms(inner, operator, not negated, facts, atoms, fuel, depth + 1)
                Ast::Expr.Binary(left, candidate, right, _):
                    if candidate != TokenKind.And and candidate != TokenKind.Or:
                        return false if not proof_logical_comparison_atom(current, facts)
                        atoms.push(ProofLogicalSignedAtom{expression: current, negated: negated, constant: false, value: false})
                        return true
                    effective = (TokenKind.Or if candidate == TokenKind.And else TokenKind.And) if negated else candidate
                    return false if effective != operator
                    return proof_logical_signed_atoms(left, operator, negated, facts, atoms, fuel, depth + 1) and proof_logical_signed_atoms(right, operator, negated, facts, atoms, fuel, depth + 1)
                Ast::Expr.Ident(_, _) | Ast::Expr.Scope(_, _, _):
                    atoms.push(ProofLogicalSignedAtom{expression: current, negated: negated, constant: false, value: false})
                    return true
                _:
                    return false

        def proof_logical_signed_identity(facts: darray[Ast::Expr]&, goal: Ast::Expr) -> bool:
            match proof_strip_parens(goal):
                Ast::Expr.Binary(left, TokenKind.EqEq, right, _):
                    first = proof_logical_signed_operator(left)
                    second = proof_logical_signed_operator(right)
                    operator = first if first != TokenKind.Eof else second if second != TokenKind.Eof else TokenKind.And
                    a: mutable darray[ProofLogicalSignedAtom] = []
                    b: mutable darray[ProofLogicalSignedAtom] = []
                    fuel: mutable usize = 1024
                    return false if not proof_logical_signed_atoms(left, operator, false, facts, a, fuel) or not proof_logical_signed_atoms(right, operator, false, facts, b, fuel)
                    for atom in a:
                        matched: mutable bool = false
                        for peer in b |matched|:
                            matched <- true if (atom.constant and peer.constant and atom.value == peer.value) or (not atom.constant and not peer.constant and atom.negated == peer.negated and proof_expr_equal(atom.expression, peer.expression))
                        return false if not matched
                    for atom in b:
                        matched: mutable bool = false
                        for peer in a |matched|:
                            matched <- true if (atom.constant and peer.constant and atom.value == peer.value) or (not atom.constant and not peer.constant and atom.negated == peer.negated and proof_expr_equal(atom.expression, peer.expression))
                        return false if not matched
                    return true
                _:
                    return false

        # Validate the entire primitive logical tree before using constant
        # absorption. No calls, fields or unwitnessed atoms.
        def proof_logical_constant(expression: Ast::Expr, facts: darray[Ast::Expr]&, fuel: mutable usize&, depth: usize = 0) -> (valid: bool, known: bool, value: bool):
            return (false, false, false) if fuel == 0 or depth >= 64
            fuel <- fuel - 1
            match proof_strip_parens(expression):
                Ast::Expr.BoolLit(value, _):
                    return (true, true, value)
                Ast::Expr.Ident(_, _) | Ast::Expr.Scope(_, _, _):
                    return (proof_scalar_term_witnessed(expression, facts, 0), false, false)
                Ast::Expr.Unary(TokenKind.Not, operand, _):
                    inner = proof_logical_constant(operand, facts, fuel, depth + 1)
                    return (inner.valid, inner.known, not inner.value)
                Ast::Expr.Binary(left, candidate, right, _):
                    return (proof_logical_comparison_atom(expression, facts), false, false) if candidate != TokenKind.And and candidate != TokenKind.Or
                    a = proof_logical_constant(left, facts, fuel, depth + 1)
                    b = proof_logical_constant(right, facts, fuel, depth + 1)
                    return (false, false, false) if not a.valid or not b.valid
                    if candidate == TokenKind.And:
                        return (true, true, false) if (a.known and not a.value) or (b.known and not b.value)
                        return (true, a.known and b.known, a.value and b.value)
                    return (true, true, true) if (a.known and a.value) or (b.known and b.value)
                    return (true, a.known and b.known, a.value or b.value)
                _:
                    return (false, false, false)

        # Flatten only one logical operator. Preserve every non-identity atom;
        # set comparison implements associativity, commutativity and idempotence.
        def proof_logical_join_atoms(expression: Ast::Expr, operator: TokenKind, facts: darray[Ast::Expr]&, atoms: mutable darray[Ast::Expr]&, fuel: mutable usize&, depth: usize = 0) -> bool:
            return false if fuel == 0 or depth >= 64 or atoms.count >= 64
            fuel <- fuel - 1
            current = proof_strip_parens(expression)
            constant = proof_logical_constant(current, facts, fuel, depth)
            return false if not constant.valid
            if constant.known:
                return true if (operator == TokenKind.And and constant.value) or (operator == TokenKind.Or and not constant.value)
                atoms.push(current)
                return true
            match current:
                Ast::Expr.Binary(left, candidate, right, _):
                    if candidate != operator:
                        a = proof_logical_constant(left, facts, fuel, depth + 1)
                        b = proof_logical_constant(right, facts, fuel, depth + 1)
                        return false if not a.valid or not b.valid
                        if a.known and ((candidate == TokenKind.And and a.value) or (candidate == TokenKind.Or and not a.value)):
                            return proof_logical_join_atoms(right, operator, facts, atoms, fuel, depth + 1)
                        if b.known and ((candidate == TokenKind.And and b.value) or (candidate == TokenKind.Or and not b.value)):
                            return proof_logical_join_atoms(left, operator, facts, atoms, fuel, depth + 1)
                        return false
                    return proof_logical_join_atoms(left, operator, facts, atoms, fuel, depth + 1) and proof_logical_join_atoms(right, operator, facts, atoms, fuel, depth + 1)
                Ast::Expr.BoolLit(value, _):
                    return true if (operator == TokenKind.And and value) or (operator == TokenKind.Or and not value)
                Ast::Expr.Ident(_, _) | Ast::Expr.Scope(_, _, _):
                    return false if not proof_scalar_term_witnessed(current, facts, 0)
                Ast::Expr.Unary(TokenKind.Not, _, _):
                    pass
                _:
                    return false
            atoms.push(current)
            return true

        def proof_logical_join_identity(facts: darray[Ast::Expr]&, goal: Ast::Expr) -> bool:
            return true if proof_logical_signed_identity(facts, goal)
            match proof_strip_parens(goal):
                Ast::Expr.Binary(left, TokenKind.EqEq, right, _):
                    operator: mutable TokenKind = TokenKind.Eof
                    match proof_strip_parens(left):
                        Ast::Expr.Binary(_, candidate, _, _):
                            operator <- candidate
                        _:
                            pass
                    if operator != TokenKind.And and operator != TokenKind.Or:
                        match proof_strip_parens(right):
                            Ast::Expr.Binary(_, candidate, _, _):
                                operator <- candidate
                            _:
                                pass
                    return false if operator != TokenKind.And and operator != TokenKind.Or
                    a: mutable darray[Ast::Expr] = []
                    b: mutable darray[Ast::Expr] = []
                    fuel: mutable usize = 1024
                    return false if not proof_logical_join_atoms(left, operator, facts, a, fuel) or not proof_logical_join_atoms(right, operator, facts, b, fuel)
                    for atom in a:
                        matched: mutable bool = false
                        atom_constant = proof_logical_constant(atom, facts, fuel)
                        for peer in b |matched, fuel|:
                            peer_constant = proof_logical_constant(peer, facts, fuel)
                            matched <- true if proof_expr_equal(atom, peer) or (atom_constant.valid and atom_constant.known and peer_constant.valid and peer_constant.known and atom_constant.value == peer_constant.value)
                        return false if not matched
                    for atom in b:
                        matched: mutable bool = false
                        atom_constant = proof_logical_constant(atom, facts, fuel)
                        for peer in a |matched, fuel|:
                            peer_constant = proof_logical_constant(peer, facts, fuel)
                            matched <- true if proof_expr_equal(atom, peer) or (atom_constant.valid and atom_constant.known and peer_constant.valid and peer_constant.known and atom_constant.value == peer_constant.value)
                        return false if not matched
                    return true
                _:
                    return false
