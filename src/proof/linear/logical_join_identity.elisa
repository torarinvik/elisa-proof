extend ElisaProof:
    private:
        # Comparisons remain opaque atoms: no arithmetic evaluation or operator
        # complementation. Only stable, witnessed primitive operands qualify.
        def proof_logical_comparison_operand(expression: Ast::Expr, facts: darray[Ast::Expr]&) -> bool:
            match proof_strip_parens(expression):
                Ast::Expr.Ident(_, _) | Ast::Expr.Scope(_, _, _) | Ast::Expr.IntLit(_, _) | Ast::Expr.BoolLit(_, _) | Ast::Expr.CharLit(_, _):
                    return proof_scalar_term_witnessed(expression, facts, 0)
                _:
                    return false

        def proof_logical_comparison_atom(expression: Ast::Expr, facts: darray[Ast::Expr]&) -> bool:
            current = proof_strip_parens(expression)
            for fact in facts:
                marker = proof_untrusted_operator_marker_info(fact)
                return false if marker.known and proof_scalar_untrusted_operator_applies(current, marker.term, 0)
            match current:
                Ast::Expr.Binary(left, operator, right, _):
                    return false if operator != TokenKind.EqEq and operator != TokenKind.BangEq and operator != TokenKind.Lt and operator != TokenKind.LtEq and operator != TokenKind.Gt and operator != TokenKind.GtEq
                    return proof_logical_comparison_operand(left, facts) and proof_logical_comparison_operand(right, facts)
                _:
                    return false

        struct ProofLogicalSignedAtom:
            expression: Ast::Expr
            negated: bool
            constant: bool
            value: bool

        def proof_logical_signed_operator(expression: Ast::Expr, negated: bool = false, depth: usize = 0) -> TokenKind:
            return TokenKind.Eof if depth >= 64
            match proof_strip_parens(expression):
                Ast::Expr.Unary(TokenKind.Not, inner, _):
                    return proof_logical_signed_operator(inner, not negated, depth + 1)
                Ast::Expr.Binary(_, operator, _, _):
                    return TokenKind.Eof if operator != TokenKind.And and operator != TokenKind.Or
                    return (TokenKind.Or if operator == TokenKind.And else TokenKind.And) if negated else operator
                _:
                    return TokenKind.Eof

        # Negation-normal form without distribution or synthetic premise facts.
        def proof_logical_signed_atoms(expression: Ast::Expr, operator: TokenKind, negated: bool, facts: darray[Ast::Expr]&, atoms: mutable darray[ProofLogicalSignedAtom]&, fuel: mutable usize&, depth: usize = 0) -> bool:
            return false if fuel == 0 or depth >= 64 or atoms.count >= 64
            fuel <- fuel - 1
            current = proof_strip_parens(expression)
            folded = proof_logical_constant(current, facts, fuel, depth)
            return false if not folded.valid
            if folded.known:
                value = not folded.value if negated else folded.value
                return true if (operator == TokenKind.And and value) or (operator == TokenKind.Or and not value)
                atoms.push(ProofLogicalSignedAtom{expression: current, negated: false, constant: true, value: value})
                return true
            match current:
                Ast::Expr.Unary(TokenKind.Not, inner, _):
                    return proof_logical_signed_atoms(inner, operator, not negated, facts, atoms, fuel, depth + 1)
                Ast::Expr.Binary(left, candidate, right, _):
                    if candidate != TokenKind.And and candidate != TokenKind.Or:
                        return false if not proof_logical_comparison_atom(current, facts)
                        atoms.push(ProofLogicalSignedAtom{expression: current, negated: negated, constant: false, value: false})
                        return true
                    effective = (TokenKind.Or if candidate == TokenKind.And else TokenKind.And) if negated else candidate
                    if effective != operator:
                        a = proof_logical_constant(left, facts, fuel, depth + 1)
                        b = proof_logical_constant(right, facts, fuel, depth + 1)
                        return false if not a.valid or not b.valid
                        if a.known and ((candidate == TokenKind.And and a.value) or (candidate == TokenKind.Or and not a.value)):
                            return proof_logical_signed_atoms(right, operator, negated, facts, atoms, fuel, depth + 1)
                        if b.known and ((candidate == TokenKind.And and b.value) or (candidate == TokenKind.Or and not b.value)):
                            return proof_logical_signed_atoms(left, operator, negated, facts, atoms, fuel, depth + 1)
                        # A validated opposite connective is an opaque island.
                        # Exact subtree/polarity matching only; no distribution.
                        atoms.push(ProofLogicalSignedAtom{expression: current, negated: negated, constant: false, value: false})
                        return true
                    return proof_logical_signed_atoms(left, operator, negated, facts, atoms, fuel, depth + 1) and proof_logical_signed_atoms(right, operator, negated, facts, atoms, fuel, depth + 1)
                Ast::Expr.Ident(_, _) | Ast::Expr.Scope(_, _, _):
                    atoms.push(ProofLogicalSignedAtom{expression: current, negated: negated, constant: false, value: false})
                    return true
                _:
                    return false

        def proof_logical_signed_identity(facts: darray[Ast::Expr]&, goal: Ast::Expr) -> bool:
            match proof_strip_parens(goal):
                Ast::Expr.Binary(left, TokenKind.EqEq, right, _):
                    first = proof_logical_signed_operator(left)
                    second = proof_logical_signed_operator(right)
                    operator = first if first != TokenKind.Eof else second if second != TokenKind.Eof else TokenKind.And
                    a: mutable darray[ProofLogicalSignedAtom] = []
                    b: mutable darray[ProofLogicalSignedAtom] = []
                    fuel: mutable usize = 1024
                    return false if not proof_logical_signed_atoms(left, operator, false, facts, a, fuel) or not proof_logical_signed_atoms(right, operator, false, facts, b, fuel)
                    for atom in a:
                        matched: mutable bool = false
                        for peer in b |matched|:
                            matched <- true if (atom.constant and peer.constant and atom.value == peer.value) or (not atom.constant and not peer.constant and atom.negated == peer.negated and proof_expr_equal(atom.expression, peer.expression))
                        return false if not matched
                    for atom in b:
                        matched: mutable bool = false
                        for peer in a |matched|:
                            matched <- true if (atom.constant and peer.constant and atom.value == peer.value) or (not atom.constant and not peer.constant and atom.negated == peer.negated and proof_expr_equal(atom.expression, peer.expression))
                        return false if not matched
                    return true
                _:
                    return false

        # Validate the entire primitive logical tree before using constant
        # absorption. No calls, fields or unwitnessed atoms.
        def proof_logical_constant(expression: Ast::Expr, facts: darray[Ast::Expr]&, fuel: mutable usize&, depth: usize = 0) -> (valid: bool, known: bool, value: bool):
            return (false, false, false) if fuel == 0 or depth >= 64
            fuel <- fuel - 1
            match proof_strip_parens(expression):
                Ast::Expr.BoolLit(value, _):
                    return (true, true, value)
                Ast::Expr.Ident(_, _) | Ast::Expr.Scope(_, _, _):
                    return (proof_scalar_term_witnessed(expression, facts, 0), false, false)
                Ast::Expr.Unary(TokenKind.Not, operand, _):
                    inner = proof_logical_constant(operand, facts, fuel, depth + 1)
                    return (inner.valid, inner.known, not inner.value)
                Ast::Expr.Binary(left, candidate, right, _):
                    return (proof_logical_comparison_atom(expression, facts), false, false) if candidate != TokenKind.And and candidate != TokenKind.Or
                    a = proof_logical_constant(left, facts, fuel, depth + 1)
                    b = proof_logical_constant(right, facts, fuel, depth + 1)
                    return (false, false, false) if not a.valid or not b.valid
                    if candidate == TokenKind.And:
                        return (true, true, false) if (a.known and not a.value) or (b.known and not b.value)
                        return (true, a.known and b.known, a.value and b.value)
                    return (true, true, true) if (a.known and a.value) or (b.known and b.value)
                    return (true, a.known and b.known, a.value or b.value)
                _:
                    return (false, false, false)

        # Flatten only one logical operator. Preserve every non-identity atom;
        # set comparison implements associativity, commutativity and idempotence.
        def proof_logical_join_atoms(expression: Ast::Expr, operator: TokenKind, facts: darray[Ast::Expr]&, atoms: mutable darray[Ast::Expr]&, fuel: mutable usize&, depth: usize = 0) -> bool:
            return false if fuel == 0 or depth >= 64 or atoms.count >= 64
            fuel <- fuel - 1
            current = proof_strip_parens(expression)
            constant = proof_logical_constant(current, facts, fuel, depth)
            return false if not constant.valid
            if constant.known:
                return true if (operator == TokenKind.And and constant.value) or (operator == TokenKind.Or and not constant.value)
                atoms.push(current)
                return true
            match current:
                Ast::Expr.Binary(left, candidate, right, _):
                    if candidate != operator:
                        a = proof_logical_constant(left, facts, fuel, depth + 1)
                        b = proof_logical_constant(right, facts, fuel, depth + 1)
                        return false if not a.valid or not b.valid
                        if a.known and ((candidate == TokenKind.And and a.value) or (candidate == TokenKind.Or and not a.value)):
                            return proof_logical_join_atoms(right, operator, facts, atoms, fuel, depth + 1)
                        if b.known and ((candidate == TokenKind.And and b.value) or (candidate == TokenKind.Or and not b.value)):
                            return proof_logical_join_atoms(left, operator, facts, atoms, fuel, depth + 1)
                        return false
                    return proof_logical_join_atoms(left, operator, facts, atoms, fuel, depth + 1) and proof_logical_join_atoms(right, operator, facts, atoms, fuel, depth + 1)
                Ast::Expr.BoolLit(value, _):
                    return true if (operator == TokenKind.And and value) or (operator == TokenKind.Or and not value)
                Ast::Expr.Ident(_, _) | Ast::Expr.Scope(_, _, _):
                    return false if not proof_scalar_term_witnessed(current, facts, 0)
                Ast::Expr.Unary(TokenKind.Not, _, _):
                    pass
                _:
                    return false
            atoms.push(current)
            return true

    public:
        # Compatibility entry point with an isolated fixed work cap. Goal search uses the
        # shared-budget sibling below so recursive work is charged to its caller.
        def proof_logical_join_identity(facts: darray[Ast::Expr]&, goal: Ast::Expr) -> bool:
            budget: mutable usize = 0
            exhausted: mutable bool = false
            result: (complete: bool, identity: bool) = proof_logical_join_identity_with_work(facts, goal, &budget, &exhausted)
            result.complete and result.identity and not exhausted

    private:
        def proof_logical_untrusted_applies_with_work(term: Ast::Expr, marked_term: Ast::Expr, depth: usize, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, applies: bool):
            return (false, false) if exhausted
            if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT:
                exhausted <- true
                return (false, false)
            return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
            match term:
                Ast::Expr.Field(object, field_name, _):
                    container: mutable Ast::Expr = object
                    indexes: mutable darray[Ast::Expr] = []
                    path: (complete: bool, indexed: bool) = proof_logical_indexed_container_path_with_work(object, &container, &indexes, depth + 1, budget, exhausted)
                    return (false, false) if not path.complete
                    return (true, false) if not path.indexed or indexes.count == 0
                    match marked_term:
                        Ast::Expr.Field(marked_container, marked_field, _):
                            return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, sview_len(field_name)) or not proof_linear_safety_work_charge(budget, exhausted, sview_len(marked_field))
                            return (true, false) if field_name != marked_field
                            equal: (complete: bool, matches: bool) = proof_linear_search_expr_equal_with_work(container, marked_container, budget, PROOF_LINEAR_SAFETY_WORK_LIMIT, true)
                            return (equal.complete, equal.matches)
                        _:
                            return (true, false)
                _:
                    equal: (complete: bool, matches: bool) = proof_linear_search_expr_equal_with_work(marked_term, term, budget, PROOF_LINEAR_SAFETY_WORK_LIMIT, true)
                    return (equal.complete, equal.matches)

        def proof_logical_indexed_container_path_with_work(expression: Ast::Expr, root: mutable Ast::Expr&, indexes: mutable darray[Ast::Expr]&, depth: usize, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, indexed: bool):
            return (false, false) if exhausted
            if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT:
                exhausted <- true
                return (false, false)
            return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_logical_indexed_container_path_with_work(inner, &root, &indexes, depth + 1, budget, exhausted)
                Ast::Expr.Index(object, index, _):
                    path: (complete: bool, indexed: bool) = proof_logical_indexed_container_path_with_work(object, &root, &indexes, depth + 1, budget, exhausted)
                    return (false, false) if not path.complete
                    return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                    indexes.push(index)
                    return (true, true)
                Ast::Expr.IndexN(object, arguments, _):
                    path: (complete: bool, indexed: bool) = proof_logical_indexed_container_path_with_work(object, &root, &indexes, depth + 1, budget, exhausted)
                    return (false, false) if not path.complete
                    for argument in arguments |indexes, budget, exhausted|:
                        return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                        indexes.push(argument)
                    return (true, true)
                _:
                    root <- expression
                    return (true, false)

        def proof_logical_comparison_operand_with_work(expression: Ast::Expr, markers: ProofScalarWitnesses&, marker_scale: usize, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, scalar: bool):
            stripped: (complete: bool, expression: Ast::Expr) = proof_linear_strip_parens_with_work(expression, budget, exhausted)
            return (false, false) if not stripped.complete
            match stripped.expression:
                Ast::Expr.Ident(_, _) | Ast::Expr.Scope(_, _, _) | Ast::Expr.IntLit(_, _) | Ast::Expr.BoolLit(_, _) | Ast::Expr.CharLit(_, _):
                    witnessed: (complete: bool, matches: bool) = proof_linear_safety_scalar_witness_with_work(expression, markers, marker_scale, budget, exhausted)
                    return (witnessed.complete, witnessed.matches)
                _:
                    return (true, false)

        def proof_logical_comparison_atom_with_work(expression: Ast::Expr, markers: ProofScalarWitnesses&, marker_scale: usize, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, atom: bool):
            stripped: (complete: bool, expression: Ast::Expr) = proof_linear_strip_parens_with_work(expression, budget, exhausted)
            return (false, false) if not stripped.complete
            for marked_term in markers.untrusted_terms |stripped, budget, exhausted|:
                return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                applies: (complete: bool, applies: bool) = proof_logical_untrusted_applies_with_work(stripped.expression, marked_term, 0, budget, exhausted)
                return (false, false) if not applies.complete
                return (true, false) if applies.applies
            match stripped.expression:
                Ast::Expr.Binary(left, operator, right, _):
                    return (true, false) if operator != TokenKind.EqEq and operator != TokenKind.BangEq and operator != TokenKind.Lt and operator != TokenKind.LtEq and operator != TokenKind.Gt and operator != TokenKind.GtEq
                    left_scalar: (complete: bool, scalar: bool) = proof_logical_comparison_operand_with_work(left, markers, marker_scale, budget, exhausted)
                    return (false, false) if not left_scalar.complete
                    return (true, false) if not left_scalar.scalar
                    right_scalar: (complete: bool, scalar: bool) = proof_logical_comparison_operand_with_work(right, markers, marker_scale, budget, exhausted)
                    return (right_scalar.complete, left_scalar.scalar and right_scalar.scalar)
                _:
                    return (true, false)

        def proof_logical_constant_with_work(expression: Ast::Expr, markers: ProofScalarWitnesses&, marker_scale: usize, fuel: mutable usize&, depth: usize, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, valid: bool, known: bool, value: bool):
            return (false, false, false, false) if exhausted
            return (true, false, false, false) if fuel == 0 or depth >= 64
            return (false, false, false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
            fuel <- fuel - 1
            stripped: (complete: bool, expression: Ast::Expr) = proof_linear_strip_parens_with_work(expression, budget, exhausted)
            return (false, false, false, false) if not stripped.complete
            match stripped.expression:
                Ast::Expr.BoolLit(value, _):
                    return (true, true, true, value)
                Ast::Expr.Ident(_, _) | Ast::Expr.Scope(_, _, _):
                    witnessed: (complete: bool, matches: bool) = proof_linear_safety_scalar_witness_with_work(expression, markers, marker_scale, budget, exhausted)
                    return (witnessed.complete, witnessed.complete and witnessed.matches, false, false)
                Ast::Expr.Unary(TokenKind.Not, operand, _):
                    inner: (complete: bool, valid: bool, known: bool, value: bool) = proof_logical_constant_with_work(operand, markers, marker_scale, &fuel, depth + 1, &budget, &exhausted)
                    return (false, false, false, false) if not inner.complete
                    return (true, inner.valid, inner.known, not inner.value)
                Ast::Expr.Binary(left, candidate, right, _):
                    if candidate != TokenKind.And and candidate != TokenKind.Or:
                        atom: (complete: bool, atom: bool) = proof_logical_comparison_atom_with_work(stripped.expression, markers, marker_scale, budget, exhausted)
                        return (atom.complete, atom.complete and atom.atom, false, false)
                    a: (complete: bool, valid: bool, known: bool, value: bool) = proof_logical_constant_with_work(left, markers, marker_scale, &fuel, depth + 1, &budget, &exhausted)
                    return (false, false, false, false) if not a.complete
                    b: (complete: bool, valid: bool, known: bool, value: bool) = proof_logical_constant_with_work(right, markers, marker_scale, &fuel, depth + 1, &budget, &exhausted)
                    return (false, false, false, false) if not b.complete
                    return (true, false, false, false) if not a.valid or not b.valid
                    if candidate == TokenKind.And:
                        return (true, true, true, false) if (a.known and not a.value) or (b.known and not b.value)
                        return (true, true, a.known and b.known, a.value and b.value)
                    return (true, true, true, true) if (a.known and a.value) or (b.known and b.value)
                    return (true, true, a.known and b.known, a.value or b.value)
                _:
                    return (true, false, false, false)

        def proof_logical_signed_operator_with_work(expression: Ast::Expr, negated: bool, depth: usize, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, operator: TokenKind):
            return (true, TokenKind.Eof) if depth >= 64
            stripped: (complete: bool, expression: Ast::Expr) = proof_linear_strip_parens_with_work(expression, budget, exhausted)
            return (false, TokenKind.Eof) if not stripped.complete
            match stripped.expression:
                Ast::Expr.Unary(TokenKind.Not, inner, _):
                    return proof_logical_signed_operator_with_work(inner, not negated, depth + 1, budget, exhausted)
                Ast::Expr.Binary(_, operator, _, _):
                    return (true, TokenKind.Eof) if operator != TokenKind.And and operator != TokenKind.Or
                    return (true, TokenKind.Or if operator == TokenKind.And else TokenKind.And) if negated
                    return (true, operator)
                _:
                    return (true, TokenKind.Eof)

        def proof_logical_signed_atoms_with_work(expression: Ast::Expr, operator: TokenKind, negated: bool, markers: ProofScalarWitnesses&, marker_scale: usize, atoms: mutable darray[ProofLogicalSignedAtom]&, fuel: mutable usize&, depth: usize, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, valid: bool):
            return (false, false) if exhausted
            return (true, false) if fuel == 0 or depth >= 64 or atoms.count >= 64
            return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
            fuel <- fuel - 1
            stripped: (complete: bool, expression: Ast::Expr) = proof_linear_strip_parens_with_work(expression, budget, exhausted)
            return (false, false) if not stripped.complete
            current: Ast::Expr = stripped.expression
            folded: (complete: bool, valid: bool, known: bool, value: bool) = proof_logical_constant_with_work(current, markers, marker_scale, &fuel, depth, &budget, &exhausted)
            return (false, false) if not folded.complete
            return (true, false) if not folded.valid
            if folded.known:
                value: bool = not folded.value if negated else folded.value
                return (true, true) if (operator == TokenKind.And and value) or (operator == TokenKind.Or and not value)
                return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                atoms.push(ProofLogicalSignedAtom{expression: current, negated: false, constant: true, value: value})
                return (true, true)
            match current:
                Ast::Expr.Unary(TokenKind.Not, inner, _):
                    return proof_logical_signed_atoms_with_work(inner, operator, not negated, markers, marker_scale, &atoms, &fuel, depth + 1, &budget, &exhausted)
                Ast::Expr.Binary(left, candidate, right, _):
                    if candidate != TokenKind.And and candidate != TokenKind.Or:
                        atom: (complete: bool, atom: bool) = proof_logical_comparison_atom_with_work(current, markers, marker_scale, budget, exhausted)
                        return (false, false) if not atom.complete
                        return (true, false) if not atom.atom
                        return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                        atoms.push(ProofLogicalSignedAtom{expression: current, negated: negated, constant: false, value: false})
                        return (true, true)
                    effective: TokenKind = (TokenKind.Or if candidate == TokenKind.And else TokenKind.And) if negated else candidate
                    if effective != operator:
                        a: (complete: bool, valid: bool, known: bool, value: bool) = proof_logical_constant_with_work(left, markers, marker_scale, &fuel, depth + 1, &budget, &exhausted)
                        return (false, false) if not a.complete
                        b: (complete: bool, valid: bool, known: bool, value: bool) = proof_logical_constant_with_work(right, markers, marker_scale, &fuel, depth + 1, &budget, &exhausted)
                        return (false, false) if not b.complete
                        return (true, false) if not a.valid or not b.valid
                        if a.known and ((candidate == TokenKind.And and a.value) or (candidate == TokenKind.Or and not a.value)):
                            return proof_logical_signed_atoms_with_work(right, operator, negated, markers, marker_scale, &atoms, &fuel, depth + 1, &budget, &exhausted)
                        if b.known and ((candidate == TokenKind.And and b.value) or (candidate == TokenKind.Or and not b.value)):
                            return proof_logical_signed_atoms_with_work(left, operator, negated, markers, marker_scale, &atoms, &fuel, depth + 1, &budget, &exhausted)
                        return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                        atoms.push(ProofLogicalSignedAtom{expression: current, negated: negated, constant: false, value: false})
                        return (true, true)
                    first: (complete: bool, valid: bool) = proof_logical_signed_atoms_with_work(left, operator, negated, markers, marker_scale, &atoms, &fuel, depth + 1, &budget, &exhausted)
                    return (false, false) if not first.complete
                    return (true, false) if not first.valid
                    return proof_logical_signed_atoms_with_work(right, operator, negated, markers, marker_scale, &atoms, &fuel, depth + 1, &budget, &exhausted)
                Ast::Expr.Ident(_, _) | Ast::Expr.Scope(_, _, _):
                    return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                    atoms.push(ProofLogicalSignedAtom{expression: current, negated: negated, constant: false, value: false})
                    return (true, true)
                _:
                    return (true, false)

        def proof_logical_signed_identity_with_work(goal: Ast::Expr, markers: ProofScalarWitnesses&, marker_scale: usize, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, identity: bool):
            stripped: (complete: bool, expression: Ast::Expr) = proof_linear_strip_parens_with_work(goal, budget, exhausted)
            return (false, false) if not stripped.complete
            match stripped.expression:
                Ast::Expr.Binary(left, TokenKind.EqEq, right, _):
                    first: (complete: bool, operator: TokenKind) = proof_logical_signed_operator_with_work(left, false, 0, budget, exhausted)
                    return (false, false) if not first.complete
                    second: (complete: bool, operator: TokenKind) = proof_logical_signed_operator_with_work(right, false, 0, budget, exhausted)
                    return (false, false) if not second.complete
                    operator: TokenKind = first.operator if first.operator != TokenKind.Eof else second.operator if second.operator != TokenKind.Eof else TokenKind.And
                    a: mutable darray[ProofLogicalSignedAtom] = []
                    b: mutable darray[ProofLogicalSignedAtom] = []
                    fuel: mutable usize = 1024
                    left_atoms: (complete: bool, valid: bool) = proof_logical_signed_atoms_with_work(left, operator, false, markers, marker_scale, &a, &fuel, 0, &budget, &exhausted)
                    return (false, false) if not left_atoms.complete
                    return (true, false) if not left_atoms.valid
                    right_atoms: (complete: bool, valid: bool) = proof_logical_signed_atoms_with_work(right, operator, false, markers, marker_scale, &b, &fuel, 0, &budget, &exhausted)
                    return (false, false) if not right_atoms.complete
                    return (true, false) if not right_atoms.valid
                    for atom in a |b, budget, exhausted|:
                        return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                        matched: mutable bool = false
                        for peer in b |matched, atom, budget, exhausted|:
                            return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                            if atom.constant and peer.constant and atom.value == peer.value:
                                matched <- true
                            elif not atom.constant and not peer.constant and atom.negated == peer.negated:
                                equal: (complete: bool, matches: bool) = proof_linear_search_expr_equal_with_work(atom.expression, peer.expression, budget, PROOF_LINEAR_SAFETY_WORK_LIMIT, true)
                                return (false, false) if not equal.complete
                                matched <- true if equal.matches
                        return (true, false) if not matched
                    for atom in b |a, budget, exhausted|:
                        return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                        matched: mutable bool = false
                        for peer in a |matched, atom, budget, exhausted|:
                            return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                            if atom.constant and peer.constant and atom.value == peer.value:
                                matched <- true
                            elif not atom.constant and not peer.constant and atom.negated == peer.negated:
                                equal: (complete: bool, matches: bool) = proof_linear_search_expr_equal_with_work(atom.expression, peer.expression, budget, PROOF_LINEAR_SAFETY_WORK_LIMIT, true)
                                return (false, false) if not equal.complete
                                matched <- true if equal.matches
                        return (true, false) if not matched
                    return (true, true)
                _:
                    return (true, false)

        def proof_logical_join_atoms_with_work(expression: Ast::Expr, operator: TokenKind, markers: ProofScalarWitnesses&, marker_scale: usize, atoms: mutable darray[Ast::Expr]&, fuel: mutable usize&, depth: usize, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, valid: bool):
            return (false, false) if exhausted
            return (true, false) if fuel == 0 or depth >= 64 or atoms.count >= 64
            return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
            fuel <- fuel - 1
            stripped: (complete: bool, expression: Ast::Expr) = proof_linear_strip_parens_with_work(expression, budget, exhausted)
            return (false, false) if not stripped.complete
            current: Ast::Expr = stripped.expression
            constant: (complete: bool, valid: bool, known: bool, value: bool) = proof_logical_constant_with_work(current, markers, marker_scale, &fuel, depth, &budget, &exhausted)
            return (false, false) if not constant.complete
            return (true, false) if not constant.valid
            if constant.known:
                return (true, true) if (operator == TokenKind.And and constant.value) or (operator == TokenKind.Or and not constant.value)
                return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                atoms.push(current)
                return (true, true)
            match current:
                Ast::Expr.Binary(left, candidate, right, _):
                    if candidate != operator:
                        a: (complete: bool, valid: bool, known: bool, value: bool) = proof_logical_constant_with_work(left, markers, marker_scale, &fuel, depth + 1, &budget, &exhausted)
                        return (false, false) if not a.complete
                        b: (complete: bool, valid: bool, known: bool, value: bool) = proof_logical_constant_with_work(right, markers, marker_scale, &fuel, depth + 1, &budget, &exhausted)
                        return (false, false) if not b.complete
                        return (true, false) if not a.valid or not b.valid
                        if a.known and ((candidate == TokenKind.And and a.value) or (candidate == TokenKind.Or and not a.value)):
                            return proof_logical_join_atoms_with_work(right, operator, markers, marker_scale, &atoms, &fuel, depth + 1, &budget, &exhausted)
                        if b.known and ((candidate == TokenKind.And and b.value) or (candidate == TokenKind.Or and not b.value)):
                            return proof_logical_join_atoms_with_work(left, operator, markers, marker_scale, &atoms, &fuel, depth + 1, &budget, &exhausted)
                        return (true, false)
                    first: (complete: bool, valid: bool) = proof_logical_join_atoms_with_work(left, operator, markers, marker_scale, &atoms, &fuel, depth + 1, &budget, &exhausted)
                    return (false, false) if not first.complete
                    return (true, false) if not first.valid
                    return proof_logical_join_atoms_with_work(right, operator, markers, marker_scale, &atoms, &fuel, depth + 1, &budget, &exhausted)
                Ast::Expr.BoolLit(value, _):
                    return (true, true) if (operator == TokenKind.And and value) or (operator == TokenKind.Or and not value)
                Ast::Expr.Ident(_, _) | Ast::Expr.Scope(_, _, _):
                    witnessed: (complete: bool, matches: bool) = proof_linear_safety_scalar_witness_with_work(current, markers, marker_scale, budget, exhausted)
                    return (false, false) if not witnessed.complete
                    return (true, false) if not witnessed.matches
                Ast::Expr.Unary(TokenKind.Not, _, _):
                    pass
                _:
                    return (true, false)
            return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
            atoms.push(current)
            return (true, true)

        def proof_logical_join_identity_with_work(facts: darray[Ast::Expr]&, goal: Ast::Expr, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, identity: bool):
            return (false, false) if exhausted
            stripped: (complete: bool, expression: Ast::Expr) = proof_linear_strip_parens_with_work(goal, budget, exhausted)
            return (false, false) if not stripped.complete
            match stripped.expression:
                Ast::Expr.Binary(left, TokenKind.EqEq, right, _):
                    # Most equality goals have no logical structure on either side. Check
                    # that shape before building the scalar marker index; large irrelevant
                    # frames must not consume the budget ahead of exact-fact closure.
                    left_operator: (complete: bool, operator: TokenKind) = proof_logical_signed_operator_with_work(left, false, 0, budget, exhausted)
                    return (false, false) if not left_operator.complete
                    right_operator: (complete: bool, operator: TokenKind) = proof_logical_signed_operator_with_work(right, false, 0, budget, exhausted)
                    return (false, false) if not right_operator.complete
                    return (true, false) if left_operator.operator == TokenKind.Eof and right_operator.operator == TokenKind.Eof
                _:
                    return (true, false)
            markers_result: (complete: bool, witnesses: ProofScalarWitnesses) = proof_scalar_witness_markers_with_work(facts, false, budget, exhausted)
            return (false, false) if not markers_result.complete or exhausted
            marker_scale: (complete: bool, scale: usize) = proof_linear_safety_marker_scale_with_work(markers_result.witnesses, budget, exhausted)
            return (false, false) if not marker_scale.complete or exhausted
            signed: (complete: bool, identity: bool) = proof_logical_signed_identity_with_work(stripped.expression, markers_result.witnesses, marker_scale.scale, budget, exhausted)
            return (false, false) if not signed.complete
            return (true, true) if signed.identity
            match stripped.expression:
                Ast::Expr.Binary(left, TokenKind.EqEq, right, _):
                    operator: mutable TokenKind = TokenKind.Eof
                    left_root: (complete: bool, expression: Ast::Expr) = proof_linear_strip_parens_with_work(left, budget, exhausted)
                    return (false, false) if not left_root.complete
                    match left_root.expression:
                        Ast::Expr.Binary(_, candidate, _, _):
                            operator <- candidate
                        _:
                            pass
                    if operator != TokenKind.And and operator != TokenKind.Or:
                        right_root: (complete: bool, expression: Ast::Expr) = proof_linear_strip_parens_with_work(right, budget, exhausted)
                        return (false, false) if not right_root.complete
                        match right_root.expression:
                            Ast::Expr.Binary(_, candidate, _, _):
                                operator <- candidate
                            _:
                                pass
                    return (true, false) if operator != TokenKind.And and operator != TokenKind.Or
                    a: mutable darray[Ast::Expr] = []
                    b: mutable darray[Ast::Expr] = []
                    fuel: mutable usize = 1024
                    left_atoms: (complete: bool, valid: bool) = proof_logical_join_atoms_with_work(left, operator, markers_result.witnesses, marker_scale.scale, &a, &fuel, 0, &budget, &exhausted)
                    return (false, false) if not left_atoms.complete
                    return (true, false) if not left_atoms.valid
                    right_atoms: (complete: bool, valid: bool) = proof_logical_join_atoms_with_work(right, operator, markers_result.witnesses, marker_scale.scale, &b, &fuel, 0, &budget, &exhausted)
                    return (false, false) if not right_atoms.complete
                    return (true, false) if not right_atoms.valid
                    for atom in a |b, fuel, markers_result, marker_scale, facts, budget, exhausted|:
                        return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                        matched: mutable bool = false
                        atom_constant: (complete: bool, valid: bool, known: bool, value: bool) = proof_logical_constant_with_work(atom, markers_result.witnesses, marker_scale.scale, &fuel, 0, &budget, &exhausted)
                        return (false, false) if not atom_constant.complete
                        for peer in b |matched, fuel, atom_constant, markers_result, marker_scale, budget, exhausted|:
                            return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                            peer_constant: (complete: bool, valid: bool, known: bool, value: bool) = proof_logical_constant_with_work(peer, markers_result.witnesses, marker_scale.scale, &fuel, 0, &budget, &exhausted)
                            return (false, false) if not peer_constant.complete
                            equal: (complete: bool, matches: bool) = proof_linear_search_expr_equal_with_work(atom, peer, budget, PROOF_LINEAR_SAFETY_WORK_LIMIT, true)
                            return (false, false) if not equal.complete
                            matched <- true if equal.matches or (atom_constant.valid and atom_constant.known and peer_constant.valid and peer_constant.known and atom_constant.value == peer_constant.value)
                        return (true, false) if not matched
                    for atom in b |a, fuel, markers_result, marker_scale, facts, budget, exhausted|:
                        return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                        matched: mutable bool = false
                        atom_constant: (complete: bool, valid: bool, known: bool, value: bool) = proof_logical_constant_with_work(atom, markers_result.witnesses, marker_scale.scale, &fuel, 0, &budget, &exhausted)
                        return (false, false) if not atom_constant.complete
                        for peer in a |matched, fuel, atom_constant, markers_result, marker_scale, budget, exhausted|:
                            return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                            peer_constant: (complete: bool, valid: bool, known: bool, value: bool) = proof_logical_constant_with_work(peer, markers_result.witnesses, marker_scale.scale, &fuel, 0, &budget, &exhausted)
                            return (false, false) if not peer_constant.complete
                            equal: (complete: bool, matches: bool) = proof_linear_search_expr_equal_with_work(atom, peer, budget, PROOF_LINEAR_SAFETY_WORK_LIMIT, true)
                            return (false, false) if not equal.complete
                            matched <- true if equal.matches or (atom_constant.valid and atom_constant.known and peer_constant.valid and peer_constant.known and atom_constant.value == peer_constant.value)
                        return (true, false) if not matched
                    return (true, true)
                _:
                    return (true, false)
