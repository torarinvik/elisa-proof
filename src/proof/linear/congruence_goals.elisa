# Congruence seeds and case-split goal depth for the linear tier.
extend ElisaProof:
    public:
        # Congruence can only seed a class from a positive equality premise. Check that cheap
        # shape before lowering a large fact frame into a scratch arena; the ordinary arithmetic,
        # identity, and model tiers already handled every goal that needs no equality premise.
        # Conjunction is the only proposition whose equality children are exported here, and
        # `not (a != b)` is the equivalent positive form used by the kernel seed rule.
        def proof_congruence_has_seed(expression: Ast::Expr, depth: usize) -> bool:
            return false if depth >= PROOF_CONGRUENCE_SCAN_DEPTH
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_congruence_has_seed(inner, depth + 1)
                Ast::Expr.Binary(_, TokenKind.EqEq, _, _):
                    return true
                Ast::Expr.Binary(left, TokenKind.And, right, _):
                    return proof_congruence_has_seed(left, depth + 1) or proof_congruence_has_seed(right, depth + 1)
                Ast::Expr.Unary(TokenKind.Not, inner, _):
                    match inner:
                        Ast::Expr.Binary(_, TokenKind.BangEq, _, _):
                            return true
                        _:
                            pass
                _:
                    pass
            return false

        def proof_congruence_has_seed_in_facts(facts: darray[Ast::Expr]&) -> bool:
            for fact in facts |fact|:
                return true if proof_congruence_has_seed(fact, 0)
            return false

        # Whether an equality premise, in the shapes `proof_congruence_has_seed` reads, has the
        # literal `value` as one side. Parentheses are looked through, which only admits more.
        def proof_congruence_seed_has_literal(expression: Ast::Expr, value: i64, depth: usize) -> bool:
            return false if depth >= PROOF_CONGRUENCE_SCAN_DEPTH
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_congruence_seed_has_literal(inner, value, depth + 1)
                Ast::Expr.Binary(left, TokenKind.EqEq, right, _):
                    return proof_congruence_literal_side(left, value) or proof_congruence_literal_side(right, value)
                Ast::Expr.Binary(left, TokenKind.And, right, _):
                    return proof_congruence_seed_has_literal(left, value, depth + 1) or proof_congruence_seed_has_literal(right, value, depth + 1)
                Ast::Expr.Unary(TokenKind.Not, inner, _):
                    match inner:
                        Ast::Expr.Binary(left, TokenKind.BangEq, right, _):
                            return proof_congruence_literal_side(left, value) or proof_congruence_literal_side(right, value)
                        _:
                            pass
                _:
                    pass
            return false

        def proof_congruence_literal_side(side: Ast::Expr, value: i64) -> bool:
            match proof_strip_parens(side):
                Ast::Expr.IntLit(literal, _):
                    return literal == value
                _:
                    return false
            return false

        # The closure merges a leaf only through a premise that names it as one side: the
        # congruence step relates terms with operands. An integer literal goal side that no
        # premise names stays alone in its class, so `b == 9` beside the case `b == 32` is
        # refused here without lowering every fact into a scratch arena.
        def proof_congruence_literal_side_unseeded(facts: darray[Ast::Expr]&, side: Ast::Expr) -> bool:
            match side:
                Ast::Expr.IntLit(value, _):
                    for fact in facts |fact, value|:
                        return false if proof_congruence_seed_has_literal(fact, value, 0)
                    return true
                _:
                    return false
            return false

        def proof_congruence_goal(facts: darray[Ast::Expr]&, goal: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, exhausted: mutable bool&) -> bool:
            return false if not proof_kernel_expression_supported(goal)
            return false if not proof_congruence_has_seed_in_facts(facts)
            match goal:
                Ast::Expr.Binary(goal_left, TokenKind.EqEq, goal_right, _):
                    if not proof_expr_equal(goal_left, goal_right):
                        return false if proof_congruence_literal_side_unseeded(facts, goal_left) or proof_congruence_literal_side_unseeded(facts, goal_right)
                _:
                    pass
            nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
            children: mutable darray[usize] = []
            roots: mutable darray[usize] = []
            for fact in facts |fact, nodes, children, roots, annotations|:
                continue if not proof_kernel_expression_supported(fact)
                roots.push(proof_kernel_encode_annotated(fact, &nodes, &children, annotations))
            return false if roots.count == 0
            goal_root: usize = proof_kernel_encode_annotated(goal, &nodes, &children, annotations)
            return ElisaProofKernelReplay::proof_kernel_replay_congruence_report_status(&nodes, &children, roots, goal_root, exhausted)

        # Weakening: drop every premise the wrap guard cannot read and retry the goal. Replay
        # sees the certificate's smaller fact list, so nothing unreadable is ever consumed.
        def proof_goal_without_unsafe_premises(facts: darray[Ast::Expr]&, goal: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, operator_mask: usize, depth: usize, budget: mutable usize&, split_depth: usize, exhausted: mutable bool&) -> bool:
            kept: mutable darray[Ast::Expr] = []
            proof_unsigned_safe_facts(facts, &kept)
            return false if kept.count == facts.count
            proof_goal_depth(kept, goal, annotations, operator_mask, depth + 1, budget, split_depth, exhausted)

        def proof_goal_depth(facts: darray[Ast::Expr]&, goal: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, operator_mask: usize, depth: usize, budget: mutable usize&, split_depth: usize, exhausted: mutable bool&) -> bool:
            if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT:
                exhausted <- true
                return false
            # Disjunction introduction from the left must happen before inspecting a right-hand
            # fixed-width term that is not evaluated once the left proposition is true. The left
            # subgoal still enters its own source-dispatch and machine-range guards.
            match proof_strip_parens(goal):
                Ast::Expr.Binary(left, TokenKind.Or, _, _):
                    # The source replay boundary currently rejects local-binding facts because it
                    # cannot authenticate their reaching definitions. Do not let any disjunction
                    # search path build a theorem certificate from that incomplete context.
                    return false if proof_disjunction_has_call_valued_local_alias(facts)
                    return true if proof_source_arithmetic_operator_guard(goal, facts, operator_mask) and proof_closed_formula_width_uniform(goal) and proof_closed_formula_at_width(goal, 64, true, 0).value
                    # A disjunction that is itself a fact, the branch condition `b == 32 or
                    # b == 9 or ...` a join re-proves in its own arm, is closed by assumption
                    # here, behind the same operator guard the assumption step below passes.
                    # Recursing into the left alternative first ran a full failing case split
                    # over that very fact at every nesting level of the chain. Taking the
                    # assumption early returns only what the step below would return.
                    if proof_source_arithmetic_operator_guard(goal, facts, operator_mask):
                        for fact in facts:
                            return true if proof_fact_contains(fact, goal)
                    # If the same conditional occurs under both alternatives, split once
                    # around the whole disjunction before spending the proof budget on a
                    # failing left branch. Each path then reduces one alternative to reflexivity.
                    nested: (found: bool, value: Ast::Expr) = proof_first_nested_conditional(goal, 0, 0)
                    return true if nested.found and proof_source_arithmetic_operator_guard(goal, facts, operator_mask) and proof_nested_conditional_goal(facts, goal, annotations, operator_mask, depth, budget, split_depth, exhausted)
                    return true if not proof_source_expression_has_overloaded_operator(goal, operator_mask, 0) and proof_disjunction_direct_branch(goal, facts, 0)
                    return true if proof_source_arithmetic_operator_guard(goal, facts, operator_mask) and proof_disjunction_premise_entails_goal(goal, facts, annotations)
                    false_left: (applicable: bool, proven: bool) = proof_disjunction_false_left_goal(facts, goal, annotations, operator_mask, depth, budget, split_depth, exhausted)
                    return false_left.proven if false_left.applicable
                    # Preserve correlations before a failing left-alternative search spends
                    # fuel splitting this same premise. The kernel uses this order too.
                    if proof_source_arithmetic_operator_guard(goal, facts, operator_mask):
                        candidate: (known: bool, index: usize, left: Ast::Expr, right: Ast::Expr) = proof_find_goal_relevant_disjunction(facts, goal)
                        exhausted <- true if candidate.known and split_depth >= PROOF_LINEAR_CASE_SPLIT_DEPTH_LIMIT
                        if candidate.known and split_depth < PROOF_LINEAR_CASE_SPLIT_DEPTH_LIMIT:
                            left_facts: mutable darray[Ast::Expr] = []
                            right_facts: mutable darray[Ast::Expr] = []
                            for index in 0..<facts.count |index, facts, left_facts, right_facts, candidate|:
                                continue if index == candidate.index
                                left_facts.push(facts[index])
                                right_facts.push(facts[index])
                            left_facts.push(candidate.left)
                            right_facts.push(candidate.right)
                            return true if proof_goal_depth(left_facts, goal, annotations, operator_mask, depth + 1, budget, split_depth + 1, exhausted) and proof_goal_depth(right_facts, goal, annotations, operator_mask, depth + 1, budget, split_depth + 1, exhausted)
                    return true if proof_goal_depth(facts, left, annotations, operator_mask, depth + 1, budget, split_depth, exhausted)
                _:
                    pass
            # A direct comparison against an exact primitive equality premise is independent
            # of unrelated path facts. Guard the goal operator itself, and let the narrow rule
            # validate the exact equality/term witnesses it consumes; do not let an unrelated
            # imported operator elsewhere in the frame suppress this local proof.
            match proof_strip_parens(goal):
                Ast::Expr.Binary(left, operator, right, _):
                    if proof_is_comparison(operator) and not proof_source_expression_has_overloaded_operator(goal, operator_mask, 0):
                        return true if proof_comparison_from_equality_literal(left, operator, right, facts)
                _:
                    pass
            # Reject overloaded operators before arithmetic conversion rules.
            return false if not proof_source_arithmetic_operator_guard(goal, facts, operator_mask)
            return true if proof_signed_scaled_quotient_sum_goal(facts, goal)
            # A Boolean call may be the surviving alternative of a verified
            # summary. Eliminate only explicitly refuted siblings, without
            # spending case-split fuel on unrelated selector summaries.
            match proof_strip_parens(goal):
                Ast::Expr.Call(_, _, _, _):
                    return true if proof_disjunction_premise_entails_goal(goal, facts, annotations)
                _:
                    pass
            return true if proof_logical_join_identity(facts, goal)
            widening: (known: bool, goal: Ast::Expr) = proof_unsigned_widening_comparison(goal, facts)
            if widening.known:
                return proof_goal_depth(facts, widening.goal, annotations, operator_mask, depth + 1, budget, split_depth, exhausted)
            return true if proof_signed_disequality_from_equality_fact(goal, facts)
            return true if proof_signed_distinct_disequality_disjunction(goal, facts)
            return true if proof_unsigned_disequality_from_equality_fact(goal, facts)
            return true if proof_unsigned_distinct_disequality_disjunction(goal, facts)
            return true if proof_unsigned_nonzero_lower_bound(goal, facts)
            return true if proof_negated_boolean_goal(facts, goal, annotations, operator_mask, depth, budget, split_depth, exhausted)
            match proof_strip_parens(goal):
                Ast::Expr.BoolLit(value, _):
                    return true if value
                _:
                    pass
            return true if proof_closed_signed_literal_comparison(goal)
            return true if proof_closed_typed_constant_comparison(goal, annotations)
            return true if proof_closed_literal_comparison(goal)
            # An explicitly asserted proposition is accepted before trying the arithmetic
            # fragment. This matters for one-sided facts such as `x >= 0`: the fact itself is
            # valid even though it is not enough to construct a finite interval for `x`.
            for fact in facts:
                return true if proof_fact_contains(fact, goal) or proof_quantifier_equal(fact, goal, annotations)
            # The exact unsigned quotient bound is cheap when its divisor precondition is already
            # a fact. Try it before recursive symbolic/quantifier search can consume the shared
            # case-split budget. The kernel checks the same theorem immediately after exact-fact
            # closure in `proof_kernel_replay_goal_depth_remaining`.
            return true if proof_unsigned_quotient_upper_goal(facts, goal, annotations, operator_mask, depth, budget, split_depth, exhausted)
            return true if proof_symbolic_instance_goal(facts, goal, annotations, operator_mask, depth, budget, split_depth, exhausted)
            return true if proof_symbolic_renamed_goal(facts, goal, annotations, operator_mask, depth, budget, split_depth, exhausted)
            return true if proof_symbolic_alias_instance_goal(facts, goal, annotations, operator_mask, depth, budget, split_depth, exhausted)
            return true if proof_goal_without_quantified_premises(facts, goal, annotations, operator_mask, depth, budget, split_depth, exhausted)
            return true if proof_finite_universal_premise_goal(facts, goal, annotations, operator_mask, depth, budget, split_depth, exhausted)
            return true if proof_goal_with_strict_order_consequence(facts, goal, annotations, operator_mask, depth, budget, split_depth, exhausted)
            return true if proof_predicate_equality_goal(facts, goal, annotations, operator_mask, depth, budget, split_depth, exhausted)
            return true if proof_index_read_equality_goal(facts, goal, annotations, operator_mask, depth, budget, split_depth, exhausted)
            # The broader signed remainder/quotient interval rule may need recursive side goals,
            # so retain it after the cheaper symbolic consequences above.
            return true if proof_division_goal(facts, goal, annotations, operator_mask, depth, budget, split_depth, exhausted)
            return true if proof_negated_name_goal(facts, goal, annotations, operator_mask, depth, budget, split_depth, exhausted)
            # A comparison of full-width unsigned literals is decided by their recorded type, never
            # by their wrapped i64 payloads; untyped comparisons stay with the tiers below.
            return true if proof_typed_constant_comparison(goal, annotations)
            # A negated primitive comparison and its complement are propositionally equivalent
            # even when an operand contains fixed-width arithmetic whose integer range is
            # intentionally unknown. This consumes no arithmetic interpretation: both sides
            # compare the same evaluated terms with complementary operators. Keep the source
            # operator and primitive-type guards above, then let the independent kernel replay
            # this exact-complement step before its own unsigned-wrap guard.
            match goal:
                Ast::Expr.Binary(left, operator, right, _):
                    return true if operator == TokenKind.BangEq and proof_strict_order_fact_implies_disequality(goal, facts)
                    # Typed nullable-field substitution can leave two reserved null literals.
                    # This exact identity grants no equality of arbitrary reference values.
                    return true if operator == TokenKind.EqEq and proof_ident_name(proof_strip_parens(left)) == "null" and proof_ident_name(proof_strip_parens(right)) == "null"
                    # Source proposition formation admits null equality only for nullable
                    # references. Its complement is Boolean logic, with no numeric pointer
                    # interpretation; consume the same operands from the negated premise.
                    null_equality: bool = (operator == TokenKind.EqEq or operator == TokenKind.BangEq) and (proof_ident_name(proof_strip_parens(left)) == "null" or proof_ident_name(proof_strip_parens(right)) == "null")
                    if proof_is_comparison(operator) and (proof_primitive_comparison(left, right, facts) or null_equality):
                        return true if proof_fact_proves_comparison_negation(left, operator, right, facts)
                _:
                    pass
            # Do not let the unbounded signed interval/model tiers prove a fixed-width unsigned
            # expression unless every arithmetic subterm is shown to remain in its declared
            # range. Directly asserted facts were handled above and remain valid path assumptions.
            return true if proof_unsigned_goal_identity(goal, facts)
            return true if proof_comparison_boolean_equation_goal(facts, goal, annotations, operator_mask, depth, budget, split_depth, exhausted)
            return true if proof_unsigned_pinned_comparison(facts, goal, annotations) or proof_unsigned_pinned_premise_goal(facts, goal, annotations, operator_mask, depth, budget, split_depth, exhausted)
            return true if proof_subtraction_alias_goal(facts, goal, annotations, operator_mask, depth, budget, split_depth, exhausted)
            # A validated same-width subtraction witness can establish that a sum is in range;
            # consult it before the generic wrap guard rejects the sum under proof.
            return true if proof_unsigned_sum_upper_shape(facts, goal) or proof_unsigned_strict_progress_shape(facts, goal) or proof_unsigned_literal_progress(facts, goal, annotations) or proof_unsigned_maximum_equality(facts, goal, annotations)
            return true if proof_unsigned_unit_increment_order_shape(facts, goal)
            return true if proof_unsigned_scaled_product_upper_shape(facts, goal)
            return true if proof_unsigned_scaled_child_quotient_shape(facts, goal, annotations)
            return true if proof_monotone_order_goal(facts, goal, annotations, operator_mask, depth, budget, split_depth, exhausted)
            return true if proof_unsigned_conditional_alias_goal(facts, goal, annotations, operator_mask, depth, budget, split_depth, exhausted)
            return true if proof_facts_propositionally_inconsistent(facts) or proof_conditional_comparison_goal(facts, goal, annotations, operator_mask, depth, budget, split_depth, exhausted)
            # Disjunctive syllogism consumes no case split: retain the surviving
            # subexpression, with fewer connective nodes and unchanged fact count.
            for index in 0..<facts.count |index, facts, goal, annotations, operator_mask, depth, budget, split_depth, exhausted|:
                candidate: (known: bool, left: Ast::Expr, right: Ast::Expr) = proof_find_disjunction(facts[index])
                continue if not candidate.known
                left_refuted: bool = proof_disjunct_refuted(candidate.left, facts, annotations, 0)
                right_refuted: bool = proof_disjunct_refuted(candidate.right, facts, annotations, 0)
                continue if not left_refuted and not right_refuted
                # Charge the existing work budget, not quantifier nesting depth.
                if budget >= PROOF_LINEAR_MAX_ENUMERATED_ELEMENTS:
                    exhausted <- true
                    return false
                budget <- budget + 1
                reduced: mutable darray[Ast::Expr] = []
                reduced.extend(facts)
                reduced[index] <- candidate.right if left_refuted else candidate.left
                return proof_goal_depth(reduced, goal, annotations, operator_mask, depth + 1, budget, split_depth, exhausted)
            # Simplify forced alternatives before instantiation; instantiate
            # before generic case splitting loses the per-instance relevance.
            quantifier_kind: sview = proof_quantifier_kind(goal, annotations)
            if quantifier_kind != "" and depth >= PROOF_LINEAR_CASE_SPLIT_DEPTH_LIMIT:
                exhausted <- true
                return false
            return proof_quantifier_goal(facts, goal, annotations, operator_mask, depth, budget, split_depth, exhausted) if quantifier_kind != ""
            # The entry rule already attempted the left alternative with these exact facts.
            # The right alternative still enters all operator and machine-range guards.
            match goal:
                Ast::Expr.Binary(left, TokenKind.Or, right, _):
                    return true if proof_goal_depth(facts, right, annotations, operator_mask, depth + 1, budget, split_depth, exhausted)
                    return false if not proof_disjunction_denial_fragment(left, facts, 0)
                    if split_depth >= PROOF_LINEAR_CASE_SPLIT_DEPTH_LIMIT:
                        exhausted <- true
                        return false
                    denied_facts: mutable darray[Ast::Expr] = []
                    denied_facts.extend(facts)
                    if not proof_push_disjunction_denial(left, &denied_facts, facts.count + PROOF_DISJUNCTION_DENIAL_FACT_LIMIT, 0):
                        exhausted <- true
                        return false
                    return proof_goal_depth(denied_facts, right, annotations, operator_mask, depth + 1, budget, split_depth + 1, exhausted)
                _:
                    pass
            # Propositional inconsistency first. It reads no term as a number, so no wrapping
            # premise can mislead it, and a contradictory branch must be able to close before the
            # guard below asks its facts to be range-safe -- the branch a disjunctive premise
            # refutes often cannot answer that, and does not have to.
            return true if proof_facts_propositionally_inconsistent(facts)
            return true if split_depth > 0 and proof_facts_order_complementary(facts)
            pruned_facts: mutable darray[Ast::Expr] = []
            return proof_goal_depth(pruned_facts, goal, annotations, operator_mask, depth + 1, budget, split_depth, exhausted) if proof_disjunct_prune_facts(facts, &pruned_facts)
            # Alternatives the linear tier refutes from the other facts are removed before a
            # split opens them; a disjunction left with none closes the goal.
            linear_pruned: mutable darray[Ast::Expr] = []
            linear_prune: i64 = proof_linear_prune_facts(facts, &linear_pruned)
            return true if linear_prune == 2
            return proof_goal_depth(linear_pruned, goal, annotations, operator_mask, depth + 1, budget, split_depth, exhausted) if linear_prune == 1
            # A disjunctive premise over call results, `f(x) - x <= c or ...`, is opaque to the
            # linear pruning above, which reads identifiers only, so every split would open it
            # blind. Generalizing the witnessed places first, once at the top of a goal, lets the
            # pruning read them; a failed attempt falls through to the ordinary split. Kernel
            # mirror in `proof_kernel_replay_goal_depth_remaining`.
            if split_depth == 0 and proof_facts_have_disjunction(facts) and proof_comparison_goal_shape(goal):
                return true if proof_field_place_goal(facts, goal, annotations, operator_mask, depth, budget, split_depth, exhausted)
            selected: (known: bool, index: usize, left: Ast::Expr, right: Ast::Expr) = proof_find_goal_relevant_disjunction(facts, goal)
            disjunction_index: usize = selected.index if selected.known else facts.count
            disjunction_left: Ast::Expr = selected.left
            disjunction_right: Ast::Expr = selected.right
            # A disjunctive premise the split budget refuses to open leaves the goal undecided,
            # not unprovable: the remaining tiers run without it, and a failure is a timeout.
            exhausted <- true if disjunction_index < facts.count and split_depth >= PROOF_LINEAR_CASE_SPLIT_DEPTH_LIMIT
            if disjunction_index < facts.count and split_depth < PROOF_LINEAR_CASE_SPLIT_DEPTH_LIMIT:
                left_facts: mutable darray[Ast::Expr] = []
                right_facts: mutable darray[Ast::Expr] = []
                for index in 0..<facts.count |index, facts, left_facts, right_facts, disjunction_index|:
                    continue if index == disjunction_index
                    left_facts.push(facts[index])
                    right_facts.push(facts[index])
                # Modus ponens: an alternative the other facts refute is dropped and the survivor
                # is assumed outright, so `a != b or result == b` at a call with `a` and `b` the
                # same value yields `result == b` without a split that must close both sides.
                # Once an alternative is refuted the split's surviving branch is the same search,
                # so the modus-ponens answer is final either way. It runs at the outermost split
                # only: two refutation searches at every nested level multiply the whole search.
                for side in 0..<(2 if split_depth == 0 else 0) |side, left_facts, disjunction_left, disjunction_right, goal, annotations, operator_mask, depth, budget, split_depth, exhausted|:
                    refuted: Ast::Expr = disjunction_left if side == 0 else disjunction_right
                    survivor: Ast::Expr = disjunction_right if side == 0 else disjunction_left
                    step: (refuted: bool, proven: bool) = proof_disjunct_modus_ponens(left_facts, refuted, survivor, goal, annotations, operator_mask, depth, budget, split_depth, exhausted)
                    return step.proven if step.refuted
                left_facts.push(disjunction_left)
                right_facts.push(disjunction_right)
                return proof_goal_depth(left_facts, goal, annotations, operator_mask, depth + 1, budget, split_depth + 1, exhausted) and proof_goal_depth(right_facts, goal, annotations, operator_mask, depth + 1, budget, split_depth + 1, exhausted)
            # Nonnegativity is decided before the wrap guards below. It is the one claim that
            # holds under both readings of a fixed-width term -- an unsigned machine value is
            # nonnegative, and so is a subtraction-free combination of nonnegative leaves -- and
            # it consumes no premise: only the type markers, which state declared types rather
            # than values. Behind the guards it was unreachable, because a guard written over the
            # same sum leaves a premise the guard itself refuses.
            return true if proof_unsigned_nonnegative_shape(facts, goal)
            return true if proof_unsigned_span_descent(facts, goal)
            return true if proof_unsigned_subtraction_upper_shape(facts, goal) or proof_unsigned_span_cursor_bound(facts, goal)
            # Equality congruence is valid for deterministic fixed-width operators even when an
            # intermediate wraps; it does not reinterpret signed operations as unbounded integers.
            match goal:
                Ast::Expr.Binary(_, TokenKind.EqEq, _, _):
                    unsigned_free: mutable bool = proof_unsigned_width_in_expression(goal, facts) == 0
                    for fact in facts |fact, unsigned_free|:
                        unsigned_free <- false if proof_unsigned_width_in_expression(fact, facts) != 0
                    if unsigned_free and proof_source_arithmetic_operator_guard(goal, facts, operator_mask):
                        return true if proof_congruence_goal(facts, goal, annotations, exhausted)
                _:
                    pass
            return true if proof_closed_safe_constant_comparison_in(goal, facts)
            return true if proof_closed_signed_i64_comparison(goal, facts)
            # Signed decision procedures consume premises as well as the goal.
            # A true wrapping premise may be false over integers; treating it as
            # such can discard every actual execution and prove an arbitrary goal.
            # Each branch of a split above re-enters here, so every premise a tier
            # below actually consumes has passed this guard in its own branch. A
            # quantifier is a block, which the guard cannot read; its range bounds
            # are guarded where they are evaluated and every instance re-enters here.
            # A quantified fact is likewise skipped: no tier below reads it as a number
            # (it closes a goal only by exact match, above), and an instance a tactic
            # derives from it re-enters this guard as an ordinary fact.
            # A closed goal true at every width holds even when each disjunct alone is
            # width-dependent, `(0 - 1) < 0 or (0 - 1) >= 22`. A false one may still close
            # from inconsistent premises below.
            return true if proof_closed_formula_width_uniform(goal) and proof_closed_formula_at_width(goal, 64, true, 0).value
            return false if quantifier_kind == "" and proof_has_ambiguous_integer_constant_in(goal, facts, 0)
            # An ambiguous premise is dropped rather than refusing the goal: forgetting a fact
            # only weakens the premises, so a module constant such as `NONE == -1` no longer
            # blocks goals that never read it.
            admitted_facts: mutable darray[Ast::Expr] = []
            dropped_fact: mutable bool = false
            for fact in facts |fact, facts, annotations, admitted_facts, dropped_fact|:
                # A linear-certificate marker is kept: its checker admits it only when every
                # premise it cites is itself among the admitted facts.
                if proof_quantifier_kind(fact, annotations) == "" and not proof_linear_certificate_marker(fact) and proof_has_ambiguous_integer_constant_in(fact, facts, 0):
                    dropped_fact <- true
                else:
                    admitted_facts.push(fact)
            return proof_goal_depth(admitted_facts, goal, annotations, operator_mask, depth + 1, budget, split_depth, exhausted) if dropped_fact
            # A premise's sum, `left_size + right_size < cap` over two call results, may be
            # in range only through its places' own bounds, which the guard cannot read.
            # Generalizing the places re-enters every guard over fresh names.
            if not proof_unsigned_facts_safe(facts):
                # The generalization below takes one comparison. A conjunction is split first so
                # each conjunct reaches it on its own and re-enters every guard (G75: an `and`
                # bound on a nested call result). Kernel mirror in
                # `proof_kernel_replay_goal_depth_remaining`.
                match goal:
                    Ast::Expr.Binary(left, TokenKind.And, right, _):
                        return proof_goal_depth(facts, left, annotations, operator_mask, depth + 1, budget, split_depth, exhausted) and proof_goal_depth(facts, right, annotations, operator_mask, depth + 1, budget, split_depth, exhausted)
                    _:
                        pass
                return true if proof_comparison_goal_shape(goal) and (proof_field_place_goal(facts, goal, annotations, operator_mask, depth, budget, split_depth, exhausted) or proof_nested_conditional_goal(facts, goal, annotations, operator_mask, depth, budget, split_depth, exhausted))
                # Otherwise the premises the guard refuses are set aside: fewer premises
                # only weaken the claim, and every tier below re-enters over the rest.
                return proof_goal_without_unsafe_premises(facts, goal, annotations, operator_mask, depth, budget, split_depth, exhausted)
            return true if proof_facts_inconsistent(facts)
            return true if proof_linear_disequality_refuted(facts)
            # To prove primitive a != b, refute a == b with an existing linear
            # disequality premise. All consumed facts have passed the wrap guard.
            match proof_strip_parens(goal):
                Ast::Expr.Binary(left, TokenKind.BangEq, right, position):
                    if proof_primitive_comparison(left, right, facts) and proof_signed_expression_safe(goal, facts) and proof_unsigned_expression_safe(goal, facts):
                        denied: mutable darray[Ast::Expr] = []
                        denied.extend(facts)
                        denied.push(Ast::Expr.Binary(left, TokenKind.EqEq, right, position))
                        return true if proof_linear_disequality_refuted(denied)
                _:
                    pass
            return true if proof_fact_proves_call_summary(facts, goal)
            return true if proof_goal_with_call_consequences(facts, goal, annotations, operator_mask, depth, budget, split_depth, exhausted)
            if not proof_unsigned_expression_safe(goal, facts):
                # The goal's sum may be in range only through a field place, `start + 3` under
                # `stop <= text.length`, which the guard cannot read. Generalizing the place
                # re-enters every guard over fresh names. A conjunction is split first, as above.
                match goal:
                    Ast::Expr.Binary(left, TokenKind.And, right, _):
                        return proof_goal_depth(facts, left, annotations, operator_mask, depth + 1, budget, split_depth, exhausted) and proof_goal_depth(facts, right, annotations, operator_mask, depth + 1, budget, split_depth, exhausted)
                    _:
                        pass
                return proof_comparison_goal_shape(goal) and (proof_field_place_goal(facts, goal, annotations, operator_mask, depth, budget, split_depth, exhausted) or proof_nested_conditional_goal(facts, goal, annotations, operator_mask, depth, budget, split_depth, exhausted))
            return true if proof_linear_certificate_goal(facts, goal)
            return true if proof_bounded_model_goal(facts, goal, exhausted)
            match goal:
                Ast::Expr.BoolLit(value, _):
                    return value
                Ast::Expr.Paren(inner, _):
                    return proof_goal_depth(facts, inner, annotations, operator_mask, depth + 1, budget, split_depth, exhausted)
                Ast::Expr.Unary(TokenKind.Not, operand, _):
                    match operand:
                        Ast::Expr.BoolLit(value, _):
                            return not value
                        Ast::Expr.Binary(left, operator, right, _):
                            negated_operator: TokenKind = proof_comparison_negation(operator)
                            return proof_linear_goal(left, negated_operator, right, facts) if negated_operator != TokenKind.Eof
                        _:
                            pass
                Ast::Expr.Binary(left, operator, right, position):
                    if operator == TokenKind.And:
                        return proof_goal_depth(facts, left, annotations, operator_mask, depth + 1, budget, split_depth, exhausted) and proof_goal_depth(facts, right, annotations, operator_mask, depth + 1, budget, split_depth, exhausted)
                    if operator == TokenKind.Or:
                        # The left alternative was already tried at the top of this very call,
                        # over these facts and this split depth; the shared budget has only
                        # grown since, so a second attempt cannot succeed. Repeating it doubled
                        # the search at every level of a left-nested chain `a or b or c or d`.
                        # At the split limit the right one was tried alone above, with these
                        # same arguments.
                        return true if split_depth < PROOF_LINEAR_CASE_SPLIT_DEPTH_LIMIT and proof_goal_depth(facts, right, annotations, operator_mask, depth + 1, budget, split_depth, exhausted)
                        # A conditional shared by both disjuncts, `(a if c else b) == a or ... == b`,
                        # is split across the whole disjunction so each branch sees one value.
                        return true if proof_nested_conditional_goal(facts, goal, annotations, operator_mask, depth, budget, split_depth, exhausted)
                        # Neither disjunct holds alone. `A or B` is `not A => B`, the rule below
                        # with a derived premise, so prove the right disjunct under the left one's
                        # negation: `P` itself when the left is `not P`, the shape of an ensure
                        # `not result or bound`. The premise opens a case, so it spends the split
                        # budget, and a refused split leaves the goal undecided.
                        if split_depth >= PROOF_LINEAR_CASE_SPLIT_DEPTH_LIMIT:
                            exhausted <- true
                            return false
                        negated_facts: mutable darray[Ast::Expr] = []
                        negated_facts.extend(facts)
                        negated_left: mutable Ast::Expr = Ast::Expr.Unary(TokenKind.Not, left, position)
                        match left:
                            Ast::Expr.Unary(TokenKind.Not, inner, _):
                                negated_left <- inner
                            _:
                                pass
                        negated_facts.push(negated_left)
                        return proof_goal_depth(negated_facts, right, annotations, operator_mask, depth + 1, budget, split_depth + 1, exhausted)
                    if operator == TokenKind.FatArrow:
                        implication_facts: mutable darray[Ast::Expr] = []
                        implication_facts.extend(facts)
                        implication_facts.push(left)
                        return proof_goal_depth(implication_facts, right, annotations, operator_mask, depth + 1, budget, split_depth, exhausted)
                    # Eliminate a conditional expression by checking both semantic branches.
                    # The condition and its negation are path assumptions, not asserted facts;
                    # both branches are required, so an opaque condition cannot manufacture a
                    # proof. Bound the split with the same small case-splitting budget used for
                    # disjunctive facts. A conditional the budget refuses to eliminate leaves the
                    # goal undecided rather than unprovable.
                    exhausted <- true if split_depth >= PROOF_LINEAR_CASE_SPLIT_DEPTH_LIMIT and (proof_expression_is_conditional(left) or proof_expression_is_conditional(right))
                    if split_depth < PROOF_LINEAR_CASE_SPLIT_DEPTH_LIMIT:
                        match left:
                            Ast::Expr.If(condition, then_expression, else_expression, _):
                                then_facts: mutable darray[Ast::Expr] = []
                                else_facts: mutable darray[Ast::Expr] = []
                                then_facts.extend(facts)
                                else_facts.extend(facts)
                                then_facts.push(condition)
                                else_facts.push(Ast::Expr.Unary(TokenKind.Not, condition, position))
                                then_goal: Ast::Expr = Ast::Expr.Binary(then_expression, operator, right, position)
                                else_goal: Ast::Expr = Ast::Expr.Binary(else_expression, operator, right, position)
                                # A failed case split proves nothing either way, so it must not
                                # consume the goal; later tiers still get to decide it.
                                return true if proof_goal_depth(then_facts, then_goal, annotations, operator_mask, depth + 1, budget, split_depth + 1, exhausted) and proof_goal_depth(else_facts, else_goal, annotations, operator_mask, depth + 1, budget, split_depth + 1, exhausted)
                            _:
                                pass
                        match right:
                            Ast::Expr.If(condition, then_expression, else_expression, _):
                                then_facts: mutable darray[Ast::Expr] = []
                                else_facts: mutable darray[Ast::Expr] = []
                                then_facts.extend(facts)
                                else_facts.extend(facts)
                                then_facts.push(condition)
                                else_facts.push(Ast::Expr.Unary(TokenKind.Not, condition, position))
                                then_goal: Ast::Expr = Ast::Expr.Binary(left, operator, then_expression, position)
                                else_goal: Ast::Expr = Ast::Expr.Binary(left, operator, else_expression, position)
                                return true if proof_goal_depth(then_facts, then_goal, annotations, operator_mask, depth + 1, budget, split_depth + 1, exhausted) and proof_goal_depth(else_facts, else_goal, annotations, operator_mask, depth + 1, budget, split_depth + 1, exhausted)
                            _:
                                pass
                    return true if proof_nested_conditional_goal(facts, goal, annotations, operator_mask, depth, budget, split_depth, exhausted)
                    if proof_is_comparison(operator):
                        return false if not proof_source_arithmetic_operator_guard(goal, facts, operator_mask)
                        return true if proof_linear_goal(left, operator, right, facts)
                        # Cancellation reads each side as a sum over the integers, which is only
                        # sound here: the wrap guard above has certified every operation in it.
                        return true if proof_primitive_comparison(left, right, facts) and proof_normalized_difference_goal(left, operator, right, facts)
                        # General linear tier: Fourier-Motzkin with a checked Farkas certificate.
                        return true if proof_primitive_comparison(left, right, facts) and proof_linear_arithmetic_goal(left, operator, right, facts)
                        return true if proof_product_sign_goal(left, operator, right, facts)
                        return true if proof_comparison_chain_goal(left, operator, right, facts)
                        return true if proof_strict_shift_goal(left, operator, right, facts)
                        return true if proof_sum_bound_goal(left, operator, right, facts)
                        return true if proof_unsigned_nonnegative_goal(left, operator, right, facts)
                        return true if proof_place_alias_goal(facts, goal, annotations, operator_mask, depth, budget, split_depth, exhausted)
                        return true if proof_field_place_goal(facts, goal, annotations, operator_mask, depth, budget, split_depth, exhausted)
                        # Antisymmetry: over integers `a == b` is `a <= b and a >= b`, each of
                        # which a chain or generalized tier may close where equality has none.
                        # Kernel mirror in `proof_kernel_replay_goal_depth_remaining`.
                        if operator == TokenKind.EqEq and split_depth < PROOF_LINEAR_CASE_SPLIT_DEPTH_LIMIT and proof_primitive_comparison(left, right, facts):
                            return true if proof_goal_depth(facts, Ast::Expr.Binary(left, TokenKind.LtEq, right, position), annotations, operator_mask, depth + 1, budget, split_depth + 1, exhausted) and proof_goal_depth(facts, Ast::Expr.Binary(left, TokenKind.GtEq, right, position), annotations, operator_mask, depth + 1, budget, split_depth + 1, exhausted)
                        return true if proof_comparison_congruence_fact(facts, goal, annotations, operator_mask, depth, budget, split_depth, exhausted)
                        # Congruence is the last equality tier and runs only after the
                        # fixed-width safety guards above rejected every wrapping premise/goal.
                        return proof_congruence_goal(facts, goal, annotations, exhausted) if operator == TokenKind.EqEq
                        return false
                _:
                    pass
            return false

        # A search that ends because a fixed budget ran out is not the same answer as one that
        # ends because no rule applies. Callers that report a verdict take the second entry point
        # so the two can be told apart downstream; `exhausted` is advisory and never widens what
        # is provable.
