include "./signed_product_growth.elisa"
# Case-split goal search for the linear tier.
extend ElisaProof:
    public:
        def proof_congruence_goal_with_work(facts: darray[Ast::Expr]&, goal: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            fact_nodes: mutable usize = 0
            return false if not proof_linear_safety_fact_shape_total_with_work(facts, &fact_nodes, budget, exhausted)
            goal_nodes: mutable usize = 0
            return false if:
                not proof_linear_safety_expression_shape_with_work(goal, 0, &goal_nodes, budget, exhausted)
                goal_nodes > PROOF_LINEAR_SAFETY_WORK_LIMIT - fact_nodes
            total_nodes: usize = fact_nodes + goal_nodes
            # The shape walk above counts most child nodes, but does not count all payload
            # bytes or every vector field read by proof_expr_equal's admission and structural
            # comparison passes. Derive the reservation from complete expression costs so long
            # identifiers, literal strings, member names, and named-call arguments cannot hide
            # work behind a small node count.
            equality_cost: mutable usize = 0
            for fact in facts |fact, equality_cost, budget, exhausted|:
                fact_cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(fact, budget, exhausted)
                return false if not fact_cost.complete or fact_cost.cost > PROOF_LINEAR_SAFETY_WORK_LIMIT - equality_cost
                equality_cost <- equality_cost + fact_cost.cost
            goal_cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(goal, budget, exhausted)
            return false if not goal_cost.complete or goal_cost.cost > PROOF_LINEAR_SAFETY_WORK_LIMIT - equality_cost
            equality_cost <- equality_cost + goal_cost.cost
            seed_start: usize = budget
            seed: (complete: bool, found: bool) = proof_congruence_has_seed_in_facts_with_work(facts, budget, exhausted)
            return false if not seed.complete or not seed.found
            seed_work: usize = budget - seed_start
            if equality_cost > PROOF_LINEAR_SAFETY_WORK_LIMIT / 8:
                budget <- PROOF_LINEAR_SAFETY_WORK_LIMIT
                exhausted <- true
                return false
            # Eight complete-expression passes cover the replay equality precheck and its
            # structural consumers, including their variable-width payload comparisons.
            reserved_work: usize = equality_cost * 8
            if seed_work > reserved_work:
                budget <- PROOF_LINEAR_SAFETY_WORK_LIMIT
                exhausted <- true
                return false
            return false if not proof_linear_safety_work_charge(budget, exhausted, reserved_work - seed_work)
            # `proof_kernel_encode_annotated` may scan the complete annotation table for each
            # block expression while recovering its erased quantifier kind. Per row, reserve one
            # visit, up to 21 owner-text bytes, one line comparison, and up to 6 bytes for each
            # of the two quantifier-name comparisons. Block count is bounded by total_nodes.
            return false if not proof_linear_safety_charge_cross_with_work(budget, exhausted, total_nodes, annotations.count, 35)
            if budget >= PROOF_LINEAR_SAFETY_WORK_LIMIT:
                exhausted <- true
                return false
            remaining: usize = PROOF_LINEAR_SAFETY_WORK_LIMIT - budget
            replay: (proven: bool, work_used: usize) = proof_congruence_goal(facts, goal, annotations, seed.found, remaining, exhausted)
            if replay.work_used > remaining:
                budget <- PROOF_LINEAR_SAFETY_WORK_LIMIT
                exhausted <- true
                return false
            budget <- budget + replay.work_used
            return replay.proven

        # Weakening: discard premises the wrap guard cannot read and retry the goal. Replay
        # sees the smaller fact list, so the proof never consumes an unreadable premise.
        def proof_goal_without_unsafe_premises(facts: darray[Ast::Expr]&, kept: darray[Ast::Expr]&, goal: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, operator_mask: usize, depth: usize, budget: mutable usize&, split_depth: usize, exhausted: mutable bool&) -> bool can[Global.Read, Global.Write]:
            return false if kept.count == facts.count
            (proof_goal_depth(kept, goal, annotations, operator_mask, depth + 1, budget, split_depth, exhausted) can Global{Read,Write})
