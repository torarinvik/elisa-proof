extend ElisaProof:
    public:
        def proof_logical_constant_value(expression: Ast::Expr, depth: usize = 0) -> (known: bool, value: bool):
            return (false, false) if depth >= 64
            match proof_strip_parens(expression):
                Ast::Expr.BoolLit(value, _):
                    return (true, value)
                Ast::Expr.Unary(TokenKind.Not, inner, _):
                    inner_value = proof_logical_constant_value(inner, depth + 1)
                    return (inner_value.known, not inner_value.value)
                Ast::Expr.Binary(left, operator, right, _):
                    return (false, false) if operator != TokenKind.And and operator != TokenKind.Or
                    a = proof_logical_constant_value(left, depth + 1)
                    b = proof_logical_constant_value(right, depth + 1)
                    if operator == TokenKind.And:
                        return (true, false) if (a.known and not a.value) or (b.known and not b.value)
                        return (a.known and b.known, a.value and b.value)
                    return (true, true) if (a.known and a.value) or (b.known and b.value)
                    return (a.known and b.known, a.value or b.value)
                _:
                    return (false, false)

        # Truth transport from exact primitive comparison premises. Fuel is
        # shared across both children; no arithmetic model is treated as proof.
        def proof_logical_context_value(expression: Ast::Expr, facts: darray[Ast::Expr]&, fuel: mutable usize&, depth: usize = 0) -> (known: bool, value: bool):
            return (false, false) if depth >= 64 or fuel == 0
            fuel <- fuel - 1
            match proof_strip_parens(expression):
                Ast::Expr.BoolLit(value, _):
                    return (true, value)
                Ast::Expr.Unary(TokenKind.Not, inner, _):
                    result = proof_logical_context_value(inner, facts, fuel, depth + 1)
                    return (result.known, not result.value)
                Ast::Expr.Binary(left, operator, right, _):
                    if operator == TokenKind.And or operator == TokenKind.Or:
                        a = proof_logical_context_value(left, facts, fuel, depth + 1)
                        b = proof_logical_context_value(right, facts, fuel, depth + 1)
                        if operator == TokenKind.And:
                            return (true, false) if (a.known and not a.value) or (b.known and not b.value)
                            return (a.known and b.known, a.value and b.value)
                        return (true, true) if (a.known and a.value) or (b.known and b.value)
                        return (a.known and b.known, a.value or b.value)
                    return (false, false) if not proof_is_comparison(operator) or not proof_primitive_comparison(left, right, facts)
                    for fact in facts |fact, facts, left, right, operator|:
                        match proof_strip_parens(fact):
                            Ast::Expr.Binary(a, relation, b, _):
                                continue if not proof_is_comparison(relation) or not proof_primitive_comparison(a, b, facts)
                                continue if not proof_expr_equal(a, left) or not proof_expr_equal(b, right)
                                return (true, true) if relation == operator
                                return (true, false) if relation == proof_comparison_negation(operator)
                            _:
                                pass
                _:
                    pass
            return (false, false)

        def proof_logical_equation_form(expression: Ast::Expr, facts: darray[Ast::Expr]&, depth: usize = 0) -> bool:
            return false if depth >= 64
            match proof_strip_parens(expression):
                Ast::Expr.BoolLit(_, _):
                    return true
                Ast::Expr.Ident(_, _) | Ast::Expr.Scope(_, _, _) | Ast::Expr.Call(_, _, _, _):
                    return proof_scalar_term_witnessed(expression, facts, 0)
                Ast::Expr.Unary(TokenKind.Not, inner, _):
                    return proof_logical_equation_form(inner, facts, depth + 1)
                Ast::Expr.Binary(left, operator, right, _):
                    if operator == TokenKind.And or operator == TokenKind.Or:
                        return proof_logical_equation_form(left, facts, depth + 1) and proof_logical_equation_form(right, facts, depth + 1)
                    return proof_is_comparison(operator) and proof_primitive_comparison(left, right, facts)
                _:
                    return false

        def proof_logical_equation_form_with_work(expression: Ast::Expr, markers: ProofScalarWitnesses&, marker_scale: usize, budget: mutable usize&, exhausted: mutable bool&, depth: usize = 0) -> (complete: bool, form: bool):
            return (true, false) if depth >= 64
            stripped: (complete: bool, expression: Ast::Expr) = proof_linear_strip_parens_with_work(expression, budget, exhausted)
            return (false, false) if not stripped.complete or exhausted
            match stripped.expression:
                Ast::Expr.BoolLit(_, _):
                    return (true, true)
                Ast::Expr.Ident(_, _) | Ast::Expr.Scope(_, _, _) | Ast::Expr.Call(_, _, _, _):
                    witnessed: (complete: bool, matches: bool) = proof_linear_safety_scalar_witness_with_work(stripped.expression, markers, marker_scale, budget, exhausted)
                    return (witnessed.complete, witnessed.matches)
                Ast::Expr.Unary(TokenKind.Not, inner, _):
                    return proof_logical_equation_form_with_work(inner, markers, marker_scale, budget, exhausted, depth + 1)
                Ast::Expr.Binary(left, operator, right, _):
                    if operator == TokenKind.And or operator == TokenKind.Or:
                        left_form: (complete: bool, form: bool) = proof_logical_equation_form_with_work(left, markers, marker_scale, budget, exhausted, depth + 1)
                        return (false, false) if not left_form.complete or exhausted
                        return (true, false) if not left_form.form
                        return proof_logical_equation_form_with_work(right, markers, marker_scale, budget, exhausted, depth + 1)
                    return (true, false) if not proof_is_comparison(operator)
                    comparison: (complete: bool, matches: bool) = proof_linear_safety_comparison_with_work(left, right, markers, marker_scale, budget, exhausted)
                    return (comparison.complete, comparison.matches)
                _:
                    return (true, false)

        def proof_logical_context_value_with_work(expression: Ast::Expr, facts: darray[Ast::Expr]&, markers: ProofScalarWitnesses&, marker_scale: usize, fuel: mutable usize&, budget: mutable usize&, exhausted: mutable bool&, depth: usize = 0) -> (complete: bool, known: bool, value: bool):
            return (true, false, false) if depth >= 64 or fuel == 0
            fuel <- fuel - 1
            return (false, false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
            stripped: (complete: bool, expression: Ast::Expr) = proof_linear_strip_parens_with_work(expression, budget, exhausted)
            return (false, false, false) if not stripped.complete or exhausted
            match stripped.expression:
                Ast::Expr.BoolLit(value, _):
                    return (true, true, value)
                Ast::Expr.Unary(TokenKind.Not, inner, _):
                    result: (complete: bool, known: bool, value: bool) = proof_logical_context_value_with_work(inner, facts, markers, marker_scale, fuel, budget, exhausted, depth + 1)
                    return (false, false, false) if not result.complete or exhausted
                    return (true, result.known, not result.value)
                Ast::Expr.Binary(left, operator, right, _):
                    if operator == TokenKind.And or operator == TokenKind.Or:
                        first: (complete: bool, known: bool, value: bool) = proof_logical_context_value_with_work(left, facts, markers, marker_scale, fuel, budget, exhausted, depth + 1)
                        return (false, false, false) if not first.complete or exhausted
                        second: (complete: bool, known: bool, value: bool) = proof_logical_context_value_with_work(right, facts, markers, marker_scale, fuel, budget, exhausted, depth + 1)
                        return (false, false, false) if not second.complete or exhausted
                        if operator == TokenKind.And:
                            return (true, true, false) if (first.known and not first.value) or (second.known and not second.value)
                            return (true, first.known and second.known, first.value and second.value)
                        return (true, true, true) if (first.known and first.value) or (second.known and second.value)
                        return (true, first.known and second.known, first.value or second.value)
                    return (true, false, false) if not proof_is_comparison(operator)
                    goal_primitive: (complete: bool, matches: bool) = proof_linear_safety_comparison_with_work(left, right, markers, marker_scale, budget, exhausted)
                    return (false, false, false) if not goal_primitive.complete or exhausted
                    return (true, false, false) if not goal_primitive.matches
                    for fact in facts |fact, facts, left, right, operator, markers, marker_scale, fuel, budget, exhausted|:
                        return (false, false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                        fact_view: (complete: bool, expression: Ast::Expr) = proof_linear_strip_parens_with_work(fact, budget, exhausted)
                        return (false, false, false) if not fact_view.complete or exhausted
                        match fact_view.expression:
                            Ast::Expr.Binary(a, relation, b, _):
                                continue if not proof_is_comparison(relation)
                                fact_primitive: (complete: bool, matches: bool) = proof_linear_safety_comparison_with_work(a, b, markers, marker_scale, budget, exhausted)
                                return (false, false, false) if not fact_primitive.complete or exhausted
                                continue if not fact_primitive.matches
                                left_equal: (complete: bool, matches: bool) = proof_linear_search_expr_equal_with_work(a, left, budget, PROOF_LINEAR_SAFETY_WORK_LIMIT, true)
                                return (false, false, false) if not left_equal.complete
                                continue if not left_equal.matches
                                right_equal: (complete: bool, matches: bool) = proof_linear_search_expr_equal_with_work(b, right, budget, PROOF_LINEAR_SAFETY_WORK_LIMIT, true)
                                return (false, false, false) if not right_equal.complete
                                continue if not right_equal.matches
                                return (true, true, true) if relation == operator
                                return (true, true, false) if relation == proof_comparison_negation(operator)
                            _:
                                pass
                _:
                    pass
            return (true, false, false)

        def proof_comparison_boolean_equation_goal(facts: darray[Ast::Expr]&, goal: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, operator_mask: usize, depth: usize, budget: mutable usize&, split_depth: usize, exhausted: mutable bool&) -> bool can[Global{Read,Write}]:
            goal_view: (complete: bool, stripped: Ast::Expr) = proof_linear_strip_parens_with_work(goal, budget, exhausted)
            return false if not goal_view.complete or exhausted
            match goal_view.stripped:
                Ast::Expr.Binary(left, equality, right, _):
                    return false if equality != TokenKind.EqEq and equality != TokenKind.BangEq
                    comparison: mutable Ast::Expr = left
                    literal: mutable Ast::Expr = right
                    match left:
                        Ast::Expr.BoolLit(_, _):
                            comparison <- right
                            literal <- left
                        _:
                            pass
                    match literal:
                        Ast::Expr.BoolLit(value, _):
                            positive: bool = value if equality == TokenKind.EqEq else not value
                            # Logical connective results are Boolean by formation, not
                            # integer terms. Equality to a Boolean literal preserves
                            # the proposition or its exact negation.
                            logical: mutable bool = false
                            match comparison:
                                Ast::Expr.Binary(_, connective, _, _):
                                    logical <- connective == TokenKind.And or connective == TokenKind.Or
                                Ast::Expr.Unary(unary_operator, _, _):
                                    logical <- unary_operator == TokenKind.Not
                                _:
                                    pass
                            comparison_boolean: bool = match comparison:
                                Ast::Expr.Binary(_, candidate_operator, _, _): proof_is_comparison(candidate_operator)
                                _: false
                            return false if not logical and not comparison_boolean
                            marker_result: (complete: bool, witnesses: ProofScalarWitnesses) = proof_scalar_witness_markers_with_work(facts, false, budget, exhausted)
                            return false if not marker_result.complete or exhausted
                            marker_scale: (complete: bool, scale: usize) = proof_linear_safety_marker_scale_with_work(marker_result.witnesses, budget, exhausted)
                            return false if not marker_scale.complete or exhausted
                            if logical:
                                form: (complete: bool, form: bool) = proof_logical_equation_form_with_work(comparison, marker_result.witnesses, marker_scale.scale, budget, exhausted)
                                return false if not form.complete or exhausted or not form.form
                                fuel: mutable usize = 128
                                constant: (complete: bool, known: bool, value: bool) = proof_logical_context_value_with_work(comparison, facts, marker_result.witnesses, marker_scale.scale, fuel, budget, exhausted)
                                return false if not constant.complete or exhausted
                                return constant.value == positive if constant.known
                                rewritten: Ast::Expr = comparison if positive else Ast::Expr.Unary(TokenKind.Not, comparison, Ast::pos_at_line(0))
                                return (proof_goal_depth(facts, rewritten, annotations, operator_mask, depth + 1, budget, split_depth, exhausted) can Global{Read,Write})
                            match comparison:
                                Ast::Expr.Binary(a, operator, b, position):
                                    return false if not proof_is_comparison(operator)
                                    primitive: (complete: bool, matches: bool) = proof_linear_safety_comparison_with_work(a, b, marker_result.witnesses, marker_scale.scale, budget, exhausted)
                                    return false if not primitive.complete or exhausted or not primitive.matches
                                    rewritten: Ast::Expr = Ast::Expr.Binary(a, operator if positive else proof_comparison_negation(operator), b, position)
                                    return (proof_goal_depth(facts, rewritten, annotations, operator_mask, depth + 1, budget, split_depth, exhausted) can Global{Read,Write})
                                _:
                                    pass
                        _:
                            pass
                _:
                    pass
            return false

        def proof_unsigned_pinned_comparison(facts: darray[Ast::Expr]&, goal: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&) -> bool:
            match proof_strip_parens(goal):
                Ast::Expr.Binary(left, operator, right, _):
                    return false if not proof_is_comparison(operator) or not proof_primitive_comparison(left, right, facts)
                    on_left: bool = proof_ident_name(left) != ""
                    alias: Ast::Expr = left if on_left else right
                    cap: Ast::Expr = right if on_left else left
                    return false if proof_ident_name(alias) == ""
                    width: i64 = proof_peer_unsigned_width(alias, facts)
                    return false if width != 8 and width != 16 and width != 32 and width != 64
                    if proof_ident_name(cap) != "" and (operator == TokenKind.LtEq or operator == TokenKind.GtEq):
                        zero: Ast::Expr = left if operator == TokenKind.LtEq else right
                        peer: Ast::Expr = right if operator == TokenKind.LtEq else left
                        return false if proof_peer_unsigned_width(peer, facts) != width or proof_peer_unsigned_width(zero, facts) != width
                        for fact in facts |fact, zero, facts, width, annotations|:
                            match proof_strip_parens(fact):
                                Ast::Expr.Binary(a, TokenKind.EqEq, b, _):
                                    continue if not proof_primitive_comparison(a, b, facts)
                                    pinned: Ast::Expr = b if proof_expr_equal(a, zero) else a
                                    continue if not proof_expr_equal(a, zero) and not proof_expr_equal(b, zero)
                                    match pinned:
                                        Ast::Expr.IntLit(payload, at):
                                            continue if payload != 0
                                            literal = proof_replay_numeric_literal_sort(annotations, at.line, at.column, 0)
                                            return true if not literal.known or (literal.unsigned and literal.width == width and literal.bits == 0)
                                        _:
                                            pass
                                _:
                                    pass
                        return false
                    match cap:
                        Ast::Expr.IntLit(value, position):
                            target = proof_replay_numeric_literal_sort(annotations, position.line, position.column, value)
                            return false if not target.known or not target.unsigned or target.width != width
                            for fact in facts |fact, facts, alias, width, annotations, target, on_left, operator|:
                                match proof_strip_parens(fact):
                                    Ast::Expr.Binary(a, TokenKind.EqEq, b, _):
                                        continue if not proof_primitive_comparison(a, b, facts)
                                        known: Ast::Expr = b if proof_expr_equal(a, alias) else a
                                        continue if not proof_expr_equal(a, alias) and not proof_expr_equal(b, alias)
                                        match known:
                                            Ast::Expr.IntLit(payload, at):
                                                literal = proof_replay_numeric_literal_sort(annotations, at.line, at.column, payload)
                                                bits: mutable u64 = 0
                                                if literal.known:
                                                    continue if not literal.unsigned or literal.width != width
                                                    bits <- literal.bits
                                                else:
                                                    continue if payload < 0 or (width != 64 and payload > proof_unsigned_width_max(width))
                                                    bits <- payload.u64()
                                                x: u64 = bits if on_left else target.bits
                                                y: u64 = target.bits if on_left else bits
                                                return x == y if operator == TokenKind.EqEq
                                                return x != y if operator == TokenKind.BangEq
                                                return x < y if operator == TokenKind.Lt
                                                return x <= y if operator == TokenKind.LtEq
                                                return x > y if operator == TokenKind.Gt
                                                return x >= y
                                            _:
                                                pass
                                    _:
                                        pass
                        _:
                            pass
                _:
                    pass
            return false

    private:
        def proof_peer_unsigned_width_with_work(expression: Ast::Expr, markers: ProofScalarWitnesses&, budget: mutable usize&, exhausted: mutable bool&) -> i64:
            declared: i64 = proof_unsigned_width_in_expression_with_work(expression, markers, budget, exhausted)
            return 0 if exhausted or declared != 0
            stripped: (complete: bool, value: Ast::Expr) = proof_linear_strip_parens_with_work(expression, budget, exhausted)
            return 0 if not stripped.complete
            match stripped.value:
                Ast::Expr.Field(object, field_name, _):
                    return 0 if field_name != "count"
                    object_view: (complete: bool, value: Ast::Expr) = proof_linear_strip_parens_with_work(object, budget, exhausted)
                    return 0 if not object_view.complete
                    return 64 if proof_ident_name(object_view.value) != ""
                _:
                    pass
            return 0

        def proof_unsigned_pinned_comparison_with_markers_work(facts: darray[Ast::Expr]&, goal: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, markers: ProofScalarWitnesses&, marker_scale: usize, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, proven: bool):
            goal_view: (complete: bool, value: Ast::Expr) = proof_linear_strip_parens_with_work(goal, budget, exhausted)
            return (false, false) if not goal_view.complete
            match goal_view.value:
                Ast::Expr.Binary(left, operator, right, _):
                    return (true, false) if not proof_is_comparison(operator)
                    left_scalar: (complete: bool, matches: bool) = proof_linear_safety_scalar_witness_with_work(left, markers, marker_scale, budget, exhausted)
                    return (false, false) if not left_scalar.complete
                    return (true, false) if not left_scalar.matches
                    right_scalar: (complete: bool, matches: bool) = proof_linear_safety_scalar_witness_with_work(right, markers, marker_scale, budget, exhausted)
                    return (false, false) if not right_scalar.complete
                    return (true, false) if not right_scalar.matches
                    on_left: bool = proof_ident_name(left) != ""
                    alias: Ast::Expr = left if on_left else right
                    cap: Ast::Expr = right if on_left else left
                    return (true, false) if proof_ident_name(alias) == ""
                    width: i64 = proof_peer_unsigned_width_with_work(alias, markers, budget, exhausted)
                    return (false, false) if exhausted
                    return (true, false) if width != 8 and width != 16 and width != 32 and width != 64
                    if proof_ident_name(cap) != "" and (operator == TokenKind.LtEq or operator == TokenKind.GtEq):
                        zero: Ast::Expr = left if operator == TokenKind.LtEq else right
                        peer: Ast::Expr = right if operator == TokenKind.LtEq else left
                        peer_width: i64 = proof_peer_unsigned_width_with_work(peer, markers, budget, exhausted)
                        return (false, false) if exhausted
                        zero_width: i64 = proof_peer_unsigned_width_with_work(zero, markers, budget, exhausted)
                        return (false, false) if exhausted
                        return (true, false) if peer_width != width or zero_width != width
                        for fact in facts |fact, zero, width, annotations, markers, marker_scale, budget, exhausted|:
                            return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                            fact_view: (complete: bool, value: Ast::Expr) = proof_linear_strip_parens_with_work(fact, budget, exhausted)
                            return (false, false) if not fact_view.complete
                            match fact_view.value:
                                Ast::Expr.Binary(a, TokenKind.EqEq, b, _):
                                    a_scalar: (complete: bool, matches: bool) = proof_linear_safety_scalar_witness_with_work(a, markers, marker_scale, budget, exhausted)
                                    return (false, false) if not a_scalar.complete
                                    continue if not a_scalar.matches
                                    b_scalar: (complete: bool, matches: bool) = proof_linear_safety_scalar_witness_with_work(b, markers, marker_scale, budget, exhausted)
                                    return (false, false) if not b_scalar.complete
                                    continue if not b_scalar.matches
                                    a_zero: (complete: bool, matches: bool) = proof_linear_search_expr_equal_with_work(a, zero, budget, PROOF_LINEAR_SAFETY_WORK_LIMIT, true)
                                    return (false, false) if not a_zero.complete
                                    pinned: Ast::Expr = b
                                    if not a_zero.matches:
                                        b_zero: (complete: bool, matches: bool) = proof_linear_search_expr_equal_with_work(b, zero, budget, PROOF_LINEAR_SAFETY_WORK_LIMIT, true)
                                        return (false, false) if not b_zero.complete
                                        continue if not b_zero.matches
                                        pinned <- a
                                    match pinned:
                                        Ast::Expr.IntLit(payload, at):
                                            continue if payload != 0
                                            return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                                            literal = proof_replay_numeric_literal_sort(annotations, at.line, at.column, 0)
                                            return (true, true) if not literal.known or (literal.unsigned and literal.width == width and literal.bits == 0)
                                        _:
                                            pass
                                _:
                                    pass
                        return (true, false)
                    match cap:
                        Ast::Expr.IntLit(value, position):
                            return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                            target = proof_replay_numeric_literal_sort(annotations, position.line, position.column, value)
                            return (true, false) if not target.known or not target.unsigned or target.width != width
                            for fact in facts |fact, markers, marker_scale, alias, width, annotations, target, on_left, operator, budget, exhausted|:
                                return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                                fact_view: (complete: bool, value: Ast::Expr) = proof_linear_strip_parens_with_work(fact, budget, exhausted)
                                return (false, false) if not fact_view.complete
                                match fact_view.value:
                                    Ast::Expr.Binary(a, TokenKind.EqEq, b, _):
                                        a_scalar: (complete: bool, matches: bool) = proof_linear_safety_scalar_witness_with_work(a, markers, marker_scale, budget, exhausted)
                                        return (false, false) if not a_scalar.complete
                                        continue if not a_scalar.matches
                                        b_scalar: (complete: bool, matches: bool) = proof_linear_safety_scalar_witness_with_work(b, markers, marker_scale, budget, exhausted)
                                        return (false, false) if not b_scalar.complete
                                        continue if not b_scalar.matches
                                        a_alias: (complete: bool, matches: bool) = proof_linear_search_expr_equal_with_work(a, alias, budget, PROOF_LINEAR_SAFETY_WORK_LIMIT, true)
                                        return (false, false) if not a_alias.complete
                                        known: Ast::Expr = b
                                        if not a_alias.matches:
                                            b_alias: (complete: bool, matches: bool) = proof_linear_search_expr_equal_with_work(b, alias, budget, PROOF_LINEAR_SAFETY_WORK_LIMIT, true)
                                            return (false, false) if not b_alias.complete
                                            continue if not b_alias.matches
                                            known <- a
                                        match known:
                                            Ast::Expr.IntLit(payload, at):
                                                return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                                                literal = proof_replay_numeric_literal_sort(annotations, at.line, at.column, payload)
                                                bits: mutable u64 = 0
                                                if literal.known:
                                                    continue if not literal.unsigned or literal.width != width
                                                    bits <- literal.bits
                                                else:
                                                    return (true, false) if payload < 0 or (width != 64 and payload > proof_unsigned_width_max(width))
                                                    bits <- payload.u64()
                                                x: u64 = bits if on_left else target.bits
                                                y: u64 = target.bits if on_left else bits
                                                return (true, x == y) if operator == TokenKind.EqEq
                                                return (true, x != y) if operator == TokenKind.BangEq
                                                return (true, x < y) if operator == TokenKind.Lt
                                                return (true, x <= y) if operator == TokenKind.LtEq
                                                return (true, x > y) if operator == TokenKind.Gt
                                                return (true, x >= y)
                                            _:
                                                pass
                                    _:
                                        pass
                        _:
                            pass
                    return (true, false)
                _:
                    return (true, false)

        def proof_unsigned_pinned_premise_goal_with_markers_work(facts: darray[Ast::Expr]&, goal: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, operator_mask: usize, depth: usize, split_depth: usize, markers: ProofScalarWitnesses&, marker_scale: usize, budget: mutable usize&, exhausted: mutable bool&) -> bool can[Global{Read,Write}]:
            for index in 0..<facts.count |index, facts, goal, annotations, operator_mask, depth, split_depth, markers, marker_scale, budget, exhausted|:
                return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                premise_view: (complete: bool, value: Ast::Expr) = proof_linear_strip_parens_with_work(facts[index], budget, exhausted)
                if not premise_view.complete:
                    exhausted <- true
                    return false
                premise: mutable Ast::Expr = premise_view.value
                negated: mutable bool = false
                match premise:
                    Ast::Expr.Unary(TokenKind.Not, inner, _):
                        negated <- true
                        inner_view: (complete: bool, value: Ast::Expr) = proof_linear_strip_parens_with_work(inner, budget, exhausted)
                        if not inner_view.complete:
                            exhausted <- true
                            return false
                        premise <- inner_view.value
                    _:
                        pass
                match premise:
                    Ast::Expr.Binary(a, operator, b, position):
                        continue if not proof_is_comparison(operator) or operator == TokenKind.EqEq
                        positive: (complete: bool, proven: bool) = proof_unsigned_pinned_comparison_with_markers_work(facts, premise, annotations, markers, marker_scale, budget, exhausted)
                        if not positive.complete:
                            exhausted <- true
                            return false
                        negative_goal: Ast::Expr = Ast::Expr.Binary(a, proof_comparison_negation(operator), b, position)
                        negative: (complete: bool, proven: bool) = proof_unsigned_pinned_comparison_with_markers_work(facts, negative_goal, annotations, markers, marker_scale, budget, exhausted)
                        if not negative.complete:
                            exhausted <- true
                            return false
                        continue if not positive.proven and not negative.proven
                        return true if (positive.proven and negated) or (negative.proven and not negated)
                        if budget >= PROOF_LINEAR_MAX_ENUMERATED_ELEMENTS:
                            exhausted <- true
                            return false
                        budget <- budget + 1
                        reduced: mutable darray[Ast::Expr] = []
                        for other in 0..<facts.count |other, index, facts, reduced, budget, exhausted|:
                            return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                            reduced.push(facts[other]) if other != index
                        return (proof_goal_depth(reduced, goal, annotations, operator_mask, depth + 1, budget, split_depth, exhausted) can Global{Read,Write})
                    _:
                        pass
            return false

        def proof_unsigned_pinned_goal_with_work(facts: darray[Ast::Expr]&, goal: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, operator_mask: usize, depth: usize, split_depth: usize, budget: mutable usize&, exhausted: mutable bool&) -> bool can[Global{Read,Write}]:
            marker_result: (complete: bool, witnesses: ProofScalarWitnesses) = proof_scalar_witness_markers_with_work(facts, false, budget, exhausted)
            if not marker_result.complete or exhausted:
                exhausted <- true
                return false
            marker_scale: (complete: bool, scale: usize) = proof_linear_safety_marker_scale_with_work(marker_result.witnesses, budget, exhausted)
            if not marker_scale.complete or exhausted:
                exhausted <- true
                return false
            direct: (complete: bool, proven: bool) = proof_unsigned_pinned_comparison_with_markers_work(facts, goal, annotations, marker_result.witnesses, marker_scale.scale, budget, exhausted)
            if not direct.complete or exhausted:
                exhausted <- true
                return false
            return true if direct.proven
            return (proof_unsigned_pinned_premise_goal_with_markers_work(facts, goal, annotations, operator_mask, depth, split_depth, marker_result.witnesses, marker_scale.scale, budget, exhausted) can[Global{Read,Write}])
    public:
        def proof_unsigned_pinned_premise_goal(facts: darray[Ast::Expr]&, goal: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, operator_mask: usize, depth: usize, budget: mutable usize&, split_depth: usize, exhausted: mutable bool&) -> bool can[Global{Read,Write}]:
            marker_result: (complete: bool, witnesses: ProofScalarWitnesses) = proof_scalar_witness_markers_with_work(facts, false, budget, exhausted)
            if not marker_result.complete or exhausted:
                exhausted <- true
                return false
            marker_scale: (complete: bool, scale: usize) = proof_linear_safety_marker_scale_with_work(marker_result.witnesses, budget, exhausted)
            if not marker_scale.complete or exhausted:
                exhausted <- true
                return false
            return (proof_unsigned_pinned_premise_goal_with_markers_work(facts, goal, annotations, operator_mask, depth, split_depth, marker_result.witnesses, marker_scale.scale, budget, exhausted) can[Global{Read,Write}])
