# Private type-domain inference for user-facing counterexample models. Primitive-scalar witnesses
# alone do not distinguish integer, Boolean, and character values, so ambiguous names are refused.
extend ElisaProof:
    private:
        def proof_diagnostic_counterexample_name_index(names: darray[sview]&, name: sview) -> usize:
            index: mutable usize = 0
            while index < names.count |index, names, name|:
                return index if names[index] == name
                index <- index + 1
            return names.count

        def proof_diagnostic_counterexample_has_name(names: darray[sview]&, name: sview) -> bool:
            return proof_diagnostic_counterexample_name_index(names, name) < names.count

        def proof_diagnostic_counterexample_add_name(names: mutable darray[sview]&, name: sview) -> void:
            if name != "" and not proof_diagnostic_counterexample_has_name(names, name):
                names.push(name)

        def proof_diagnostic_counterexample_boolean_expression(expression: Ast::Expr, boolean_names: darray[sview]&, depth: usize) -> bool:
            return false if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            match expression:
                Ast::Expr.BoolLit(_, _):
                    return true
                Ast::Expr.Ident(name, _):
                    return proof_diagnostic_counterexample_has_name(boolean_names, name)
                Ast::Expr.Paren(inner, _):
                    return proof_diagnostic_counterexample_boolean_expression(inner, boolean_names, depth + 1)
                Ast::Expr.Unary(TokenKind.Not, operand, _):
                    return proof_diagnostic_counterexample_boolean_expression(operand, boolean_names, depth + 1)
                Ast::Expr.Binary(left, operator, right, _):
                    if operator == TokenKind.And or operator == TokenKind.Or:
                        return proof_diagnostic_counterexample_boolean_expression(left, boolean_names, depth + 1) and proof_diagnostic_counterexample_boolean_expression(right, boolean_names, depth + 1)
                    return false
                _:
                    return false

        # Infer only Boolean domains explicit in proposition position or anchored by a Boolean literal.
        # Equality between two otherwise-unclassified names remains ambiguous.
        def proof_diagnostic_counterexample_collect_boolean_names(expression: Ast::Expr, boolean_names: mutable darray[sview]&, depth: usize) -> void:
            return if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT or proof_type_marker_callee(expression)
            match expression:
                Ast::Expr.Ident(name, _):
                    proof_diagnostic_counterexample_add_name(boolean_names, name)
                Ast::Expr.Paren(inner, _):
                    proof_diagnostic_counterexample_collect_boolean_names(inner, boolean_names, depth + 1)
                Ast::Expr.Unary(TokenKind.Not, operand, _):
                    proof_diagnostic_counterexample_collect_boolean_names(operand, boolean_names, depth + 1)
                Ast::Expr.Binary(left, operator, right, _):
                    if operator == TokenKind.And or operator == TokenKind.Or:
                        proof_diagnostic_counterexample_collect_boolean_names(left, boolean_names, depth + 1)
                        proof_diagnostic_counterexample_collect_boolean_names(right, boolean_names, depth + 1)
                    if (operator == TokenKind.EqEq or operator == TokenKind.BangEq) and proof_diagnostic_counterexample_boolean_expression(left, boolean_names, depth + 1):
                        proof_diagnostic_counterexample_collect_boolean_names(right, boolean_names, depth + 1)
                    if (operator == TokenKind.EqEq or operator == TokenKind.BangEq) and proof_diagnostic_counterexample_boolean_expression(right, boolean_names, depth + 1):
                        proof_diagnostic_counterexample_collect_boolean_names(left, boolean_names, depth + 1)
                _:
                    pass

        def proof_diagnostic_counterexample_integer_anchor(expression: Ast::Expr, name: sview, depth: usize) -> bool:
            return false if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_diagnostic_counterexample_integer_anchor(inner, name, depth + 1)
                Ast::Expr.Unary(TokenKind.Not, operand, _):
                    return proof_diagnostic_counterexample_integer_anchor(operand, name, depth + 1)
                Ast::Expr.Binary(left, operator, right, _):
                    if operator == TokenKind.And or operator == TokenKind.Or:
                        return proof_diagnostic_counterexample_integer_anchor(left, name, depth + 1) or proof_diagnostic_counterexample_integer_anchor(right, name, depth + 1)
                    return false if not proof_is_comparison(operator)
                    match left:
                        Ast::Expr.Ident(left_name, _):
                            return true if left_name == name and proof_constant_int(right).known
                        _:
                            pass
                    match right:
                        Ast::Expr.Ident(right_name, _):
                            return true if right_name == name and proof_constant_int(left).known
                        _:
                            pass
                _:
                    pass
            return false

        def proof_diagnostic_counterexample_integer_name(facts: darray[Ast::Expr]&, goal: Ast::Expr, name: sview, boolean_names: darray[sview]&) -> bool:
            return false if proof_diagnostic_counterexample_has_name(boolean_names, name)
            return true if proof_diagnostic_counterexample_integer_anchor(goal, name, 0)
            for fact in facts:
                return true if proof_diagnostic_counterexample_integer_anchor(fact, name, 0)
            return false
