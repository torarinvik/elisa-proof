extend ElisaProof:
    public:
        # Case analysis is logical, not signed interpretation of the arms.
        # Both branches must prove, using the existing split and work budgets.
        def proof_conditional_comparison_goal(facts: darray[Ast::Expr]&, goal: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, operator_mask: usize, depth: usize, budget: mutable usize&, split_depth: usize, exhausted: mutable bool&) -> bool:
            match goal:
                Ast::Expr.Binary(left, operator, right, position):
                    return false if not proof_is_comparison(operator)
                    return false if not proof_expression_is_conditional(left) and not proof_expression_is_conditional(right)
                    if split_depth >= PROOF_LINEAR_CASE_SPLIT_DEPTH_LIMIT:
                        exhausted <- true
                        return false
                    return false if not proof_primitive_comparison(left, right, facts)
                    match left:
                        Ast::Expr.If(condition, then_expression, else_expression, _):
                            then_facts: mutable darray[Ast::Expr] = []
                            else_facts: mutable darray[Ast::Expr] = []
                            then_facts.extend(facts)
                            else_facts.extend(facts)
                            then_facts.push(condition)
                            else_facts.push(Ast::Expr.Unary(TokenKind.Not, condition, position))
                            then_goal: Ast::Expr = Ast::Expr.Binary(then_expression, operator, right, position)
                            else_goal: Ast::Expr = Ast::Expr.Binary(else_expression, operator, right, position)
                            return true if proof_goal_depth(then_facts, then_goal, annotations, operator_mask, depth, budget, split_depth + 1, exhausted) and proof_goal_depth(else_facts, else_goal, annotations, operator_mask, depth, budget, split_depth + 1, exhausted)
                        _:
                            pass
                    match right:
                        Ast::Expr.If(condition, then_expression, else_expression, _):
                            then_facts: mutable darray[Ast::Expr] = []
                            else_facts: mutable darray[Ast::Expr] = []
                            then_facts.extend(facts)
                            else_facts.extend(facts)
                            then_facts.push(condition)
                            else_facts.push(Ast::Expr.Unary(TokenKind.Not, condition, position))
                            then_goal: Ast::Expr = Ast::Expr.Binary(left, operator, then_expression, position)
                            else_goal: Ast::Expr = Ast::Expr.Binary(left, operator, else_expression, position)
                            return true if proof_goal_depth(then_facts, then_goal, annotations, operator_mask, depth, budget, split_depth + 1, exhausted) and proof_goal_depth(else_facts, else_goal, annotations, operator_mask, depth, budget, split_depth + 1, exhausted)
                        _:
                            pass
                _:
                    pass
            return false
