extend ElisaProof:
    private:
        def proof_unsigned_nonzero_lower_bound_with_work(goal: Ast::Expr, facts: darray[Ast::Expr]&, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, proven: bool):
            can Abort.Panic:
                goal_result: (complete: bool, expression: Ast::Expr) = proof_linear_strip_parens_with_work(goal, budget, exhausted)
                return (false, false) if not goal_result.complete
                term: mutable Ast::Expr = Ast::Expr.Invalid
                match goal_result.expression:
                    Ast::Expr.Binary(left, operator, right, _):
                        a: (known: bool, value: i64) = proof_constant_int_with_work(left, 0, budget, exhausted)
                        return (false, false) if proof_goal_bool_ref_value(exhausted)
                        b: (known: bool, value: i64) = proof_constant_int_with_work(right, 0, budget, exhausted)
                        return (false, false) if proof_goal_bool_ref_value(exhausted)
                        if a.known and ((operator == TokenKind.LtEq and a.value == 1) or (operator == TokenKind.Lt and a.value == 0)):
                            term <- right
                        elif b.known and ((operator == TokenKind.GtEq and b.value == 1) or (operator == TokenKind.Gt and b.value == 0)):
                            term <- left
                        else:
                            return (true, false)
                    _:
                        return (true, false)
                markers_result: (complete: bool, witnesses: ProofScalarWitnesses) = proof_scalar_witness_markers_with_work(facts, true, budget, exhausted)
                return (false, false) if not markers_result.complete or proof_goal_bool_ref_value(exhausted)
                scale_result: (complete: bool, scale: usize) = proof_linear_safety_marker_scale_with_work(markers_result.witnesses, budget, exhausted)
                return (false, false) if not scale_result.complete or proof_goal_bool_ref_value(exhausted)
                match goal_result.expression:
                    Ast::Expr.Binary(left, _, right, _):
                        comparison: (complete: bool, matches: bool) = proof_linear_safety_comparison_with_work(left, right, markers_result.witnesses, scale_result.scale, budget, exhausted)
                        return (false, false) if not comparison.complete
                        return (true, false) if not comparison.matches
                    _:
                        return (true, false)
                width: i64 = proof_unsigned_width_in_expression_with_work(term, markers_result.witnesses, budget, exhausted)
                return (false, false) if proof_goal_bool_ref_value(exhausted)
                return (true, false) if width == 0
                for fact in facts |fact, term, markers_result, scale_result, budget, exhausted|:
                    candidate_result: (complete: bool, expression: Ast::Expr) = proof_linear_strip_parens_with_work(fact, budget, exhausted)
                    return (false, false) if not candidate_result.complete
                    candidate: mutable Ast::Expr = candidate_result.expression
                    negated: mutable bool = false
                    match candidate:
                        Ast::Expr.Unary(TokenKind.Not, inner, _):
                            nested_result: (complete: bool, expression: Ast::Expr) = proof_linear_strip_parens_with_work(inner, budget, exhausted)
                            return (false, false) if not nested_result.complete
                            candidate <- nested_result.expression
                            negated <- true
                        _:
                            pass
                    match candidate:
                        Ast::Expr.Binary(left, operator, right, _):
                            continue if (not negated and operator != TokenKind.BangEq) or (negated and operator != TokenKind.EqEq)
                            comparison: (complete: bool, matches: bool) = proof_linear_safety_comparison_with_work(left, right, markers_result.witnesses, scale_result.scale, budget, exhausted)
                            return (false, false) if not comparison.complete
                            continue if not comparison.matches
                            a: (known: bool, value: i64) = proof_constant_int_with_work(left, 0, budget, exhausted)
                            return (false, false) if proof_goal_bool_ref_value(exhausted)
                            b: (known: bool, value: i64) = proof_constant_int_with_work(right, 0, budget, exhausted)
                            return (false, false) if proof_goal_bool_ref_value(exhausted)
                            if a.known and a.value == 0:
                                equal: (complete: bool, matches: bool) = proof_linear_search_expr_equal_with_work(right, term, budget, PROOF_LINEAR_SAFETY_WORK_LIMIT, true)
                                return (false, false) if not equal.complete
                                return (true, true) if equal.matches
                            if b.known and b.value == 0:
                                equal: (complete: bool, matches: bool) = proof_linear_search_expr_equal_with_work(left, term, budget, PROOF_LINEAR_SAFETY_WORK_LIMIT, true)
                                return (false, false) if not equal.complete
                                return (true, true) if equal.matches
                        _:
                            pass
                return (true, false)

        # Mirror an independently checked intermediate assertion: primitive
        # strict order implies disequality, even when a conditional call
        # summary obscures the direct interval path to the final goal.
        def proof_goal_with_strict_order_consequence(facts: darray[Ast::Expr]&, goal: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, operator_mask: usize, depth: usize, budget: mutable usize&, split_depth: usize, exhausted: mutable bool&) -> bool can[Global{Read,Write}]:
            candidate_goal: mutable Ast::Expr = proof_strip_parens(goal)
            match candidate_goal:
                Ast::Expr.Binary(_, TokenKind.Or, right, _):
                    candidate_goal <- proof_strip_parens(right)
                _:
                    pass
            nonzero_goal: mutable bool = false
            match candidate_goal:
                Ast::Expr.Binary(left, TokenKind.BangEq, right, _):
                    a = proof_constant_int(left)
                    b = proof_constant_int(right)
                    nonzero_goal <- (a.known and a.value == 0) or (b.known and b.value == 0)
                _:
                    pass
            return false if not nonzero_goal and not proof_expr_has_call(goal)
            for fact in facts |fact, facts, goal, annotations, operator_mask, depth, budget, split_depth, exhausted|:
                match proof_strip_parens(fact):
                    Ast::Expr.Binary(left, operator, right, position):
                        continue if operator != TokenKind.Lt and operator != TokenKind.Gt
                        a = proof_constant_int(left)
                        zero_left: bool = a.known and a.value == 0
                        consequence: Ast::Expr = Ast::Expr.Binary(right if zero_left else left, TokenKind.BangEq, left if zero_left else right, position)
                        present: mutable bool = false
                        for premise in facts |premise, consequence, present|:
                            present <- true if proof_fact_contains(premise, consequence)
                        continue if present or not proof_strict_order_fact_implies_disequality(consequence, facts)
                        if budget >= PROOF_LINEAR_MAX_ENUMERATED_ELEMENTS:
                            exhausted <- true
                            return false
                        budget <- budget + 1
                        enriched: mutable darray[Ast::Expr] = []
                        enriched.extend(facts)
                        enriched.push(consequence)
                        return true if (proof_goal_depth(&enriched, goal, annotations, operator_mask, depth + 1, budget, split_depth, exhausted) can Global{Read,Write})
                    _:
                        pass
            return false

        # Congruence may transport an established primitive comparison, but
        # may not establish a comparison merely because its operands are typed.
        def proof_comparison_congruence_fact(facts: darray[Ast::Expr]&, goal: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, operator_mask: usize, depth: usize, budget: mutable usize&, split_depth: usize, exhausted: mutable bool&) -> bool can[Global{Read,Write}]:
            match proof_strip_parens(goal):
                Ast::Expr.Binary(left, operator, right, position):
                    return false if operator == TokenKind.EqEq or not proof_is_comparison(operator)
                    # One witness index serves every fact: the loop never changes `facts`.
                    markers: ProofScalarWitnesses = proof_scalar_witness_markers(facts)
                    return false if not proof_primitive_comparison_marked(left, right, markers)
                    for fact in facts |fact, facts, markers, left, right, operator, position, annotations, operator_mask, depth, budget, split_depth, exhausted|:
                        match proof_strip_parens(fact):
                            Ast::Expr.Binary(a, fact_operator, b, _):
                                continue if operator != fact_operator or not proof_primitive_comparison_marked(a, b, markers)
                                left_equal: Ast::Expr = Ast::Expr.Binary(left, TokenKind.EqEq, a, position)
                                right_equal: Ast::Expr = Ast::Expr.Binary(right, TokenKind.EqEq, b, position)
                                # Cases are handled around the comparison goal. Keep operand
                                # equality searches deterministic, matching kernel transport,
                                # so failed equalities cannot reopen antisymmetry case trees.
                                return true if (proof_goal_depth(facts, left_equal, annotations, operator_mask, depth + 1, budget, PROOF_LINEAR_CASE_SPLIT_DEPTH_LIMIT, exhausted) can Global{Read,Write}) and (proof_goal_depth(facts, right_equal, annotations, operator_mask, depth + 1, budget, PROOF_LINEAR_CASE_SPLIT_DEPTH_LIMIT, exhausted) can Global{Read,Write})
                            _:
                                pass
                _:
                    pass
            return false

        # Weakening removes unused quantified premises from the entire recursive
        # proof context, not merely from the machine-arithmetic safety checks.
        def proof_goal_without_quantified_premises(facts: darray[Ast::Expr]&, goal: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, operator_mask: usize, depth: usize, budget: mutable usize&, split_depth: usize, exhausted: mutable bool&) -> bool can[Global{Read,Write}]:
            reduced: mutable darray[Ast::Expr] = []
            removed: mutable bool = false
            for fact in facts |reduced, removed, annotations, budget, exhausted|:
                quantifier: (complete: bool, kind: sview) = proof_symbolic_quantifier_kind_with_budget(fact, annotations, budget, exhausted)
                return false if not quantifier.complete
                if quantifier.kind != "":
                    removed <- true
                else:
                    reduced.push(fact)
            return false if not removed
            return (proof_goal_depth(&reduced, goal, annotations, operator_mask, depth + 1, budget, split_depth, exhausted) can Global{Read,Write})

        # Eliminate an exact primitive predicate equation, not an arbitrary
        # overloaded equality. The replacement itself must still be proved.
        def proof_predicate_equality_goal(facts: darray[Ast::Expr]&, goal: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, operator_mask: usize, depth: usize, budget: mutable usize&, split_depth: usize, exhausted: mutable bool&) -> bool can[Global{Read,Write}]:
            predicate_call: mutable Ast::Expr = proof_strip_parens(goal)
            predicate_negated: mutable bool = false
            match predicate_call:
                Ast::Expr.Unary(TokenKind.Not, operand, _):
                    predicate_call <- proof_strip_parens(operand)
                    predicate_negated <- true
                _:
                    pass
            return false if not proof_expr_is_call_rooted(predicate_call) or not proof_scalar_term_witnessed(predicate_call, facts, 0)
            for fact in facts |facts, predicate_call, predicate_negated, annotations, operator_mask, depth, budget, split_depth, exhausted|:
                match proof_strip_parens(fact):
                    Ast::Expr.Binary(left, TokenKind.EqEq, right, position):
                        continue if not proof_expr_equal(left, predicate_call) and not proof_expr_equal(right, predicate_call)
                        replacement: Ast::Expr = right if proof_expr_equal(left, predicate_call) else left
                        continue if proof_expr_is_invalid(replacement) or proof_expr_has_call(replacement) or proof_expr_has_move(replacement)
                        continue if not proof_primitive_comparison(left, right, facts)
                        rewritten: Ast::Expr = Ast::Expr.Unary(TokenKind.Not, replacement, position) if predicate_negated else replacement
                        return true if (proof_goal_depth(facts, rewritten, annotations, operator_mask, depth + 1, budget, split_depth, exhausted) can Global{Read,Write})
                    _:
                        pass
            return false
