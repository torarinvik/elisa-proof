# The wrap guards applied to a whole premise list. Both read the intervals of the list once:
# they depend on the facts alone, never on the fact being guarded.
extend ElisaProof:
    public:
        # `proof_unsigned_expression_safe` of every fact, with the intervals both guards read
        # computed once for the list instead of once per fact: they depend on the facts alone.
        # The plain-order closure is still consulted only for a fact the first intervals miss.
        def proof_unsigned_facts_safe(facts: darray[Ast::Expr]&) -> bool:
            bounds: mutable darray[ProofBound] = []
            proof_collect_fact_bounds(facts, &bounds)
            proof_close_equalities(facts, &bounds)
            closed: mutable darray[ProofBound] = []
            has_closed: mutable bool = false
            signed_bounds: darray[ProofBound] = proof_signed_safety_bounds(facts)
            for fact in facts |facts, bounds, closed, has_closed, signed_bounds|:
                unsigned_safe: mutable bool = proof_unsigned_expression_safe_with_bounds(fact, facts, bounds)
                if not unsigned_safe:
                    if not has_closed:
                        closed.extend(bounds)
                        proof_close_plain_bounds(facts, &closed)
                        has_closed <- true
                    unsigned_safe <- proof_unsigned_expression_safe_with_bounds(fact, facts, closed)
                return false if not unsigned_safe or not proof_signed_expression_safe_with_bounds(fact, facts, signed_bounds, 0)
            return true

        # The facts `proof_unsigned_expression_safe` admits, in order. As above, the intervals
        # depend on the list alone, so they are computed once rather than once per fact.
        def proof_unsigned_safe_facts(facts: darray[Ast::Expr]&, kept: mutable darray[Ast::Expr]&) -> void:
            bounds: mutable darray[ProofBound] = []
            proof_collect_fact_bounds(facts, &bounds)
            proof_close_equalities(facts, &bounds)
            closed: mutable darray[ProofBound] = []
            has_closed: mutable bool = false
            signed_bounds: darray[ProofBound] = proof_signed_safety_bounds(facts)
            for fact in facts |facts, bounds, closed, has_closed, signed_bounds, kept|:
                unsigned_safe: mutable bool = proof_unsigned_expression_safe_with_bounds(fact, facts, bounds)
                if not unsigned_safe:
                    if not has_closed:
                        closed.extend(bounds)
                        proof_close_plain_bounds(facts, &closed)
                        has_closed <- true
                    unsigned_safe <- proof_unsigned_expression_safe_with_bounds(fact, facts, closed)
                kept.push(fact) if unsigned_safe and proof_signed_expression_safe_with_bounds(fact, facts, signed_bounds, 0)
