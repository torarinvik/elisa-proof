extend ElisaProof:
    public:
        def proof_delta_constant(left: Ast::Expr, right: Ast::Expr) -> (known: bool, value: i64):
            if proof_expr_equal(left, right):
                return (true, 0)
            match left:
                Ast::Expr.Binary(base, operator, amount, _):
                    amount_value: (known: bool, value: i64) = proof_constant_int(amount)
                    if amount_value.known and proof_expr_equal(base, right):
                        return (true, 0) if amount_value.value == 0 and (operator == TokenKind.Plus or operator == TokenKind.Minus)
                _:
                    pass
            match right:
                Ast::Expr.Binary(base, operator, amount, _):
                    amount_value: (known: bool, value: i64) = proof_constant_int(amount)
                    if amount_value.known and proof_expr_equal(base, left):
                        return (true, 0) if amount_value.value == 0 and (operator == TokenKind.Plus or operator == TokenKind.Minus)
                _:
                    pass
            return (false, 0)

        # Definitional fixed-width identities. These rewrites are valid for every i64 value,
        # including endpoints: adding/subtracting zero, multiplying by zero/one, dividing by
        # one, taking a remainder by one, and the listed bitwise identities cannot introduce an
        # arithmetic side condition. We intentionally do not add cancellation, distributivity,
        # or x / x rules here.
        def proof_definitionally_equal(left: Ast::Expr, right: Ast::Expr) -> bool:
            return true if proof_expr_equal(left, right)
            match left:
                Ast::Expr.Paren(inner, _):
                    return proof_definitionally_equal(inner, right)
                Ast::Expr.Unary(TokenKind.Plus, operand, _):
                    return proof_definitionally_equal(operand, right)
                Ast::Expr.Binary(base, operator, amount, _):
                    amount_constant: (known: bool, value: i64) = proof_constant_int(amount)
                    if operator == TokenKind.Plus or operator == TokenKind.Minus:
                        return proof_definitionally_equal(base, right) if amount_constant.known and amount_constant.value == 0
                    if operator == TokenKind.Star:
                        return proof_definitionally_equal(base, right) if amount_constant.known and amount_constant.value == 1
                        target_constant: (known: bool, value: i64) = proof_constant_int(right)
                        return target_constant.known and target_constant.value == 0 if amount_constant.known and amount_constant.value == 0
                        base_constant: (known: bool, value: i64) = proof_constant_int(base)
                        return proof_definitionally_equal(amount, right) if base_constant.known and base_constant.value == 1
                        return target_constant.known and target_constant.value == 0 if base_constant.known and base_constant.value == 0
                    if operator == TokenKind.Slash:
                        return proof_definitionally_equal(base, right) if amount_constant.known and amount_constant.value == 1
                    if operator == TokenKind.Percent:
                        target_constant: (known: bool, value: i64) = proof_constant_int(right)
                        return target_constant.known and target_constant.value == 0 if amount_constant.known and amount_constant.value == 1
                    if operator == TokenKind.Ampersand:
                        base_constant: (known: bool, value: i64) = proof_constant_int(base)
                        target_constant: (known: bool, value: i64) = proof_constant_int(right)
                        return target_constant.known and target_constant.value == 0 if amount_constant.known and amount_constant.value == 0
                        return target_constant.known and target_constant.value == 0 if base_constant.known and base_constant.value == 0
                        return proof_definitionally_equal(base, right) if proof_expr_equal(base, amount)
                    if operator == TokenKind.Pipe:
                        base_constant: (known: bool, value: i64) = proof_constant_int(base)
                        return proof_definitionally_equal(base, right) if amount_constant.known and amount_constant.value == 0
                        return proof_definitionally_equal(amount, right) if base_constant.known and base_constant.value == 0
                        return proof_definitionally_equal(base, right) if proof_expr_equal(base, amount)
                    if operator == TokenKind.Caret:
                        base_constant: (known: bool, value: i64) = proof_constant_int(base)
                        target_constant: (known: bool, value: i64) = proof_constant_int(right)
                        return proof_definitionally_equal(base, right) if amount_constant.known and amount_constant.value == 0
                        return proof_definitionally_equal(amount, right) if base_constant.known and base_constant.value == 0
                        return target_constant.known and target_constant.value == 0 if proof_expr_equal(base, amount)
                    if operator == TokenKind.LShift or operator == TokenKind.RShift:
                        return proof_definitionally_equal(base, right) if amount_constant.known and amount_constant.value == 0
                _:
                    pass
            match right:
                Ast::Expr.Paren(inner, _):
                    return proof_definitionally_equal(left, inner)
                Ast::Expr.Unary(TokenKind.Plus, operand, _):
                    return proof_definitionally_equal(left, operand)
                Ast::Expr.Binary(base, operator, amount, _):
                    amount_constant: (known: bool, value: i64) = proof_constant_int(amount)
                    if operator == TokenKind.Plus or operator == TokenKind.Minus:
                        return proof_definitionally_equal(left, base) if amount_constant.known and amount_constant.value == 0
                    if operator == TokenKind.Star:
                        return proof_definitionally_equal(left, base) if amount_constant.known and amount_constant.value == 1
                        left_constant: (known: bool, value: i64) = proof_constant_int(left)
                        return left_constant.known and left_constant.value == 0 if amount_constant.known and amount_constant.value == 0
                        base_constant: (known: bool, value: i64) = proof_constant_int(base)
                        return proof_definitionally_equal(left, amount) if base_constant.known and base_constant.value == 1
                        return left_constant.known and left_constant.value == 0 if base_constant.known and base_constant.value == 0
                    if operator == TokenKind.Slash:
                        return proof_definitionally_equal(left, base) if amount_constant.known and amount_constant.value == 1
                    if operator == TokenKind.Percent:
                        left_constant: (known: bool, value: i64) = proof_constant_int(left)
                        return left_constant.known and left_constant.value == 0 if amount_constant.known and amount_constant.value == 1
                    if operator == TokenKind.Ampersand:
                        base_constant: (known: bool, value: i64) = proof_constant_int(base)
                        left_constant: (known: bool, value: i64) = proof_constant_int(left)
                        return left_constant.known and left_constant.value == 0 if amount_constant.known and amount_constant.value == 0
                        return left_constant.known and left_constant.value == 0 if base_constant.known and base_constant.value == 0
                        return proof_definitionally_equal(left, base) if proof_expr_equal(base, amount)
                    if operator == TokenKind.Pipe:
                        base_constant: (known: bool, value: i64) = proof_constant_int(base)
                        return proof_definitionally_equal(left, base) if amount_constant.known and amount_constant.value == 0
                        return proof_definitionally_equal(left, amount) if base_constant.known and base_constant.value == 0
                        return proof_definitionally_equal(left, base) if proof_expr_equal(base, amount)
                    if operator == TokenKind.Caret:
                        base_constant: (known: bool, value: i64) = proof_constant_int(base)
                        left_constant: (known: bool, value: i64) = proof_constant_int(left)
                        return proof_definitionally_equal(left, base) if amount_constant.known and amount_constant.value == 0
                        return proof_definitionally_equal(left, amount) if base_constant.known and base_constant.value == 0
                        return left_constant.known and left_constant.value == 0 if proof_expr_equal(base, amount)
                    if operator == TokenKind.LShift or operator == TokenKind.RShift:
                        return proof_definitionally_equal(left, base) if amount_constant.known and amount_constant.value == 0
                _:
                    pass
            return false

        # The sign of a product, the one nonlinear fact worth deciding. Every other tier here is
        # linear, so `x >= 0, y >= 0 |- x * y >= 0` was out of reach even though it is decidable
        # from the operands' signs alone and needs no multiplication reasoning beyond them.
        #
        # The rule is deliberately syntactic: the required sign facts must be present as facts,
        # matched structurally, rather than re-derived by another search. That keeps it small, and
        # it keeps the producer and the replay kernel able to state exactly the same rule — a tier
        # the two could only approximate would show up as a replay gap rather than a proof.
        #
        # Both operands must be witnessed primitive scalars. Elisa rewrites `*` on a struct operand
        # to a user `__mul__`, which is an ordinary method under no sign law at all.
        def proof_product_sign_operands(expression: Ast::Expr) -> (known: bool, left: Ast::Expr, right: Ast::Expr):
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_product_sign_operands(inner)
                Ast::Expr.Binary(left, operator, right, _):
                    return (true, left, right) if operator == TokenKind.Star
                    return (false, Ast::Expr.Absent, Ast::Expr.Absent)
                _:
                    return (false, Ast::Expr.Absent, Ast::Expr.Absent)

        # Is `term <relation> 0` an explicit fact? Only the four orderings against a literal zero
        # count; anything else would need the arithmetic tiers this rule sits beside.
        def proof_product_sign_fact(term: Ast::Expr, relation: TokenKind, facts: darray[Ast::Expr]&) -> bool:
            for fact in facts |fact, term, relation|:
                match fact:
                    Ast::Expr.Binary(fact_left, fact_operator, fact_right, _):
                        if fact_operator == relation and proof_expr_is_zero_literal(fact_right) and proof_expr_equal(fact_left, term):
                            return true
                        # `0 <= x` is the same fact as `x >= 0`; accept the mirrored form too.
                        mirrored: TokenKind = proof_product_sign_mirror(relation)
                        if fact_operator == mirrored and proof_expr_is_zero_literal(fact_left) and proof_expr_equal(fact_right, term):
                            return true
                    _:
                        pass
            return false

        def proof_product_sign_mirror(relation: TokenKind) -> TokenKind:
            return TokenKind.LtEq if relation == TokenKind.GtEq
            return TokenKind.GtEq if relation == TokenKind.LtEq
            return TokenKind.Lt if relation == TokenKind.Gt
            return TokenKind.Gt if relation == TokenKind.Lt
            return relation

        def proof_expr_is_zero_literal(expression: Ast::Expr) -> bool:
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_expr_is_zero_literal(inner)
                Ast::Expr.IntLit(value, _):
                    return value == 0
                _:
                    return false

        def proof_product_sign_goal(left: Ast::Expr, operator: TokenKind, right: Ast::Expr, facts: darray[Ast::Expr]&) -> bool:
            # Only `product <relation> 0` shapes; the product may sit on either side.
            product: mutable (known: bool, left: Ast::Expr, right: Ast::Expr) = proof_product_sign_operands(left)
            relation: mutable TokenKind = operator
            if not product.known:
                product <- proof_product_sign_operands(right)
                relation <- proof_product_sign_mirror(operator)
                return false if not product.known or not proof_expr_is_zero_literal(left)
            else:
                return false if not proof_expr_is_zero_literal(right)
            return false if not proof_scalar_term_witnessed(product.left, facts, 0) or not proof_scalar_term_witnessed(product.right, facts, 0)
            if relation == TokenKind.GtEq:
                return true if proof_product_sign_fact(product.left, TokenKind.GtEq, facts) and proof_product_sign_fact(product.right, TokenKind.GtEq, facts)
                return proof_product_sign_fact(product.left, TokenKind.LtEq, facts) and proof_product_sign_fact(product.right, TokenKind.LtEq, facts)
            if relation == TokenKind.LtEq:
                return true if proof_product_sign_fact(product.left, TokenKind.GtEq, facts) and proof_product_sign_fact(product.right, TokenKind.LtEq, facts)
                return proof_product_sign_fact(product.left, TokenKind.LtEq, facts) and proof_product_sign_fact(product.right, TokenKind.GtEq, facts)
            if relation == TokenKind.Gt:
                return true if proof_product_sign_fact(product.left, TokenKind.Gt, facts) and proof_product_sign_fact(product.right, TokenKind.Gt, facts)
                return proof_product_sign_fact(product.left, TokenKind.Lt, facts) and proof_product_sign_fact(product.right, TokenKind.Lt, facts)
            if relation == TokenKind.Lt:
                return true if proof_product_sign_fact(product.left, TokenKind.Gt, facts) and proof_product_sign_fact(product.right, TokenKind.Lt, facts)
                return proof_product_sign_fact(product.left, TokenKind.Lt, facts) and proof_product_sign_fact(product.right, TokenKind.Gt, facts)
            return false

        # Chain two recorded comparisons through a shared middle term. The difference engine
        # already does this, but only over atoms it can name: its affine form carries one bare
        # identifier, so `limit <= items.count` is invisible to it and `index < limit` cannot
        # reach `index < items.count`. Structural transitivity needs no atom at all -- the middle
        # term is matched with the same structural equality the kernel replays.
        #
        # The whole rule rests on `<` and `<=` being the primitive integer order, which they are
        # only for witnessed scalars: on a struct they are a user `__lt__`/`__le__` under no
        # transitivity law. Every one of the three terms therefore needs its own scalar witness,
        # exactly as the other comparison rules require.
        const PROOF_CHAIN_CANDIDATE_BUDGET: usize = 32

        def proof_chain_strict(operator: TokenKind) -> bool:
            return operator == TokenKind.Lt

        def proof_chain_ascending(operator: TokenKind) -> bool:
            return operator == TokenKind.Lt or operator == TokenKind.LtEq

        # `a op1 b` and `b op2 c` compose to a strict `a < c` when either step is strict, and to
        # `a <= c` otherwise. A strict conclusion also discharges a non-strict goal; a non-strict
        # one never discharges a strict goal.
        def proof_chain_discharges(first: TokenKind, second: TokenKind, goal: TokenKind) -> bool:
            strict: bool = proof_chain_strict(first) or proof_chain_strict(second)
            return true if strict
            return goal == TokenKind.LtEq

        # `a < R` gives `a + 1 <= R` over the integers, for *any* term `R`. The difference engine
        # already draws this conclusion whenever it can name both sides, but its atom is one bare
        # identifier, so `index < values.count` reaches nothing -- a field place is not an atom,
        # which is the same representation limit the comparison chain was written around. This tier
        # needs no atom at all: it matches the shifted side structurally against the strict fact's
        # own right-hand side.
        #
        # The shift is only sound if `a + 1` does not wrap, which is exactly what the unsigned peer
        # rule decides from this same fact, and for a signed term the ordinary overflow guard does.
        # A goal that is `<` rather than `<=` is not this rule: `a < R` does not give `a + 1 < R`.
        # A sum of two non-constant terms is not an affine form here -- `ProofAffine.base` is one
        # identifier -- so `children_start + index < children.count` reaches no tier that can name
        # it. Both facts that bound such a sum are themselves structural, so the search is too.
        #
        # Shape A, the offset chain: `a + n <= C` and `b < n` give `a + b < C`, because
        # `a + b < a + n <= C`.
        # Shape B, the subtraction transposed: `b <= C - a` with `a <= C` gives `a + b <= C`. The
        # second premise is what makes `C - a` meaningful for an unsigned type, and it is exactly
        # the guard such code already writes beside the subtraction.
        #
        # Both return the bounding term as well as the strictness, because the same search answers
        # the range question: the sum is at most `C`, so it cannot wrap whenever `C` is a term of
        # the same unsigned width. That is the relational argument the peer rule uses for `a + 1`,
        # and it is the only kind available for a 64-bit unsigned value.
        def proof_sum_operands(expression: Ast::Expr) -> (known: bool, left: Ast::Expr, right: Ast::Expr) can[Memory.Allocate, Abort.Panic]:
            match proof_strip_parens(expression):
                Ast::Expr.Binary(left, operator, right, _):
                    return (true, left, right) if operator == TokenKind.Plus
                    return (false, Ast::Expr.Invalid, Ast::Expr.Invalid)
                _:
                    return (false, Ast::Expr.Invalid, Ast::Expr.Invalid)

        def proof_difference_operands(expression: Ast::Expr) -> (known: bool, left: Ast::Expr, right: Ast::Expr) can[Memory.Allocate, Abort.Panic]:
            match proof_strip_parens(expression):
                Ast::Expr.Binary(left, operator, right, _):
                    return (true, left, right) if operator == TokenKind.Minus
                    return (false, Ast::Expr.Invalid, Ast::Expr.Invalid)
                _:
                    return (false, Ast::Expr.Invalid, Ast::Expr.Invalid)

        # A conjunction asserts both of its sides, so a rule that scans facts for a shape has to
        # see inside one. The structural rules matched only a top-level comparison, so a single
        # `requires a <= b and c <= d` was invisible where the same two facts written separately
        # were not. Flattening is a reading of the fact list, not an addition to it: every
        # conjunct was already asserted, and the range guard certifies the whole conjunction
        # before any rule reads either half.
        def proof_push_conjuncts(expression: Ast::Expr, conjuncts: mutable darray[Ast::Expr]&, depth: usize) -> void:
            stripped: Ast::Expr = proof_strip_parens(expression)
            if depth < 32:
                match stripped:
                    Ast::Expr.Binary(left, operator, right, _):
                        if operator == TokenKind.And:
                            proof_push_conjuncts(left, conjuncts, depth + 1)
                            proof_push_conjuncts(right, conjuncts, depth + 1)
                            return
                    _:
                        pass
            conjuncts.push(stripped)

        # `not e` where the expression is one, seen through parentheses.
        def proof_negated_operand(expression: Ast::Expr) -> (known: bool, operand: Ast::Expr) can[Memory.Allocate, Abort.Panic]:
            match proof_strip_parens(expression):
                Ast::Expr.Unary(operator, operand, _):
                    return (true, operand) if operator == TokenKind.Not
                    return (false, Ast::Expr.Invalid)
                _:
                    return (false, Ast::Expr.Invalid)

        # A candidate an existing fact denies outright: the fact is its negation, or it is the
        # negation of the fact. Only a literal denial counts -- no tier is consulted, so this
        # cannot decide anything the fact list did not already state.
        def proof_fact_denies(candidate: Ast::Expr, facts: darray[Ast::Expr]&) -> bool:
            negated: (known: bool, operand: Ast::Expr) = proof_negated_operand(candidate)
            for fact in facts |fact, candidate, negated|:
                return true if negated.known and proof_expr_equal(fact, negated.operand)
                fact_negated: (known: bool, operand: Ast::Expr) = proof_negated_operand(fact)
                return true if fact_negated.known and proof_expr_equal(fact_negated.operand, candidate)
            return false

        # The facts a structural rule may read directly, with conjunctions flattened. A
        # disjunctive premise is not resolved here: the goal solver already opens one by case
        # split, and each branch reaches these rules with the disjunct as an ordinary fact.
        def proof_conjunct_facts(facts: darray[Ast::Expr]&) -> darray[Ast::Expr] can[Memory.Allocate, Abort.Panic]:
            conjuncts: mutable darray[Ast::Expr] = []
            for fact in facts |conjuncts|:
                proof_push_conjuncts(fact, &conjuncts, 0)
            return conjuncts

        # The order a fact states, seeing through the negation an early-return guard leaves behind.
        # `return ... if x > n` reaches the statements after it as `not (x > n)`, which is the
        # commonest guard form in the language, and every rule built on the order query used to be
        # blind to it: only the affine tiers normalized a negation, and they name one bare
        # identifier, so a guard over a place or a sum was stated and unreadable.
        #
        # Reading `not (x > n)` as `x <= n` is the totality of the primitive order. `>` dispatches
        # to a user `__cmp__` whenever an operand is a struct, and that method need not be total,
        # so both operands have to carry a primitive scalar witness. A positive fact needs no such
        # witness: it is used as itself, with no inference over the operator at all.
        def proof_readable_order(fact: Ast::Expr, facts: darray[Ast::Expr]&) -> (known: bool, left: Ast::Expr, operator: TokenKind, right: Ast::Expr) can[Memory.Allocate, Abort.Panic]:
            match fact:
                Ast::Expr.Binary(left, operator, right, _):
                    return (proof_is_order_operator(operator), left, operator, right)
                Ast::Expr.Unary(TokenKind.Not, operand, _):
                    match operand:
                        Ast::Expr.Binary(left, operator, right, _):
                            negated: TokenKind = proof_comparison_negation(operator)
                            return (false, Ast::Expr.Invalid, TokenKind.Eof, Ast::Expr.Invalid) if not proof_is_order_operator(negated)
                            return (false, Ast::Expr.Invalid, TokenKind.Eof, Ast::Expr.Invalid) if not proof_scalar_term_witnessed(left, facts, 0)
                            return (false, Ast::Expr.Invalid, TokenKind.Eof, Ast::Expr.Invalid) if not proof_scalar_term_witnessed(right, facts, 0)
                            return (true, left, negated, right)
                        _:
                            return (false, Ast::Expr.Invalid, TokenKind.Eof, Ast::Expr.Invalid)
                _:
                    return (false, Ast::Expr.Invalid, TokenKind.Eof, Ast::Expr.Invalid)

        def proof_is_order_operator(operator: TokenKind) -> bool:
            return operator == TokenKind.Lt or operator == TokenKind.LtEq or operator == TokenKind.Gt or operator == TokenKind.GtEq

        # `term <= bound` or `term < bound` recorded as a fact, in either spelling.
        def proof_has_order_fact(term: Ast::Expr, bound: Ast::Expr, strict_only: bool, facts: darray[Ast::Expr]&) -> bool:
            conjuncts: darray[Ast::Expr] = proof_conjunct_facts(facts)
            for fact in conjuncts |fact, term, bound, strict_only, facts|:
                readable: (known: bool, left: Ast::Expr, operator: TokenKind, right: Ast::Expr) = proof_readable_order(fact, facts)
                continue if not readable.known
                if readable.operator == TokenKind.Lt and proof_expr_equal(readable.left, term) and proof_expr_equal(readable.right, bound):
                    return true
                if readable.operator == TokenKind.Gt and proof_expr_equal(readable.right, term) and proof_expr_equal(readable.left, bound):
                    return true
                continue if strict_only
                if readable.operator == TokenKind.LtEq and proof_expr_equal(readable.left, term) and proof_expr_equal(readable.right, bound):
                    return true
                if readable.operator == TokenKind.GtEq and proof_expr_equal(readable.right, term) and proof_expr_equal(readable.left, bound):
                    return true
            return false

        def proof_sum_witness_for(first: Ast::Expr, second: Ast::Expr, facts: darray[Ast::Expr]&) -> (known: bool, bound: Ast::Expr, strict: bool) can[Memory.Allocate, Abort.Panic]:
            conjuncts: darray[Ast::Expr] = proof_conjunct_facts(facts)
            for fact in conjuncts |fact, first, second, facts|:
                readable: (known: bool, left: Ast::Expr, operator: TokenKind, right: Ast::Expr) = proof_readable_order(fact, facts)
                continue if not readable.known
                fact_left: Ast::Expr = readable.left
                fact_operator: TokenKind = readable.operator
                fact_right: Ast::Expr = readable.right
                continue if fact_operator != TokenKind.Lt and fact_operator != TokenKind.LtEq
                # Shape B: some term is bounded by `bound - first`, with `first <= bound`
                # recorded beside it -- the guard that makes the subtraction meaningful for
                # an unsigned type, and the one such code already writes. The bounded term
                # is `second` itself, or a term `second` is under in turn: a range check
                # states `count <= total - start` once and every index into it is `< count`.
                #
                # The premise is deliberately this shape rather than `first + second <=
                # bound`. For an unsigned type the latter is a *modular* claim about a sum
                # that may already have wrapped, so it cannot be read as a bound on the
                # mathematical sum, and using it to justify its own range is the mistake
                # `examples/rejected_unsigned_fact_explosion.elisa` pins.
                difference: (known: bool, left: Ast::Expr, right: Ast::Expr) = proof_difference_operands(fact_right)
                continue if not difference.known
                continue if not proof_expr_equal(difference.right, first)
                continue if not proof_has_order_fact(first, difference.left, false, facts)
                return (true, difference.left, fact_operator == TokenKind.Lt) if proof_expr_equal(fact_left, second)
                return (true, difference.left, true) if proof_has_order_fact(second, fact_left, true, facts)
                return (true, difference.left, true) if fact_operator == TokenKind.Lt and proof_has_order_fact(second, fact_left, false, facts)
                return (true, difference.left, false) if proof_has_order_fact(second, fact_left, false, facts)
                # There is deliberately no rule reading `first + middle <= bound` as a
                # premise. For a fixed-width type that is a claim about a sum that may
                # already have wrapped: at `start = MAX, count = 1, total = 0` the premise
                # `start + count <= total` holds modulo 2^64 while the mathematical sum does
                # not, and reading it as an integer bound proves `start + 0 < 0`. The
                # subtraction form above says the same thing without a sum in it.
            return (false, Ast::Expr.Invalid, false)

        def proof_sum_upper_witness(left: Ast::Expr, right: Ast::Expr, facts: darray[Ast::Expr]&) -> (known: bool, bound: Ast::Expr, strict: bool) can[Memory.Allocate, Abort.Panic]:
            forward: (known: bool, bound: Ast::Expr, strict: bool) = proof_sum_witness_for(left, right, facts)
            return forward if forward.known
            return proof_sum_witness_for(right, left, facts)

        # An unsigned expression that is certified not to wrap has a mathematical value equal to
        # its machine value, and an unsigned machine value is nonnegative. The certification is
        # the same guard every other rule here is gated on, so the rule adds no new assumption:
        # it only reads the answer the guard already computed. Without it a lower-bound obligation
        # on `start + index` is refused even where the matching upper bound is proved, because no
        # affine tier can name a sum of two terms.
        # Whether a term is built without subtraction. Every leaf of an arithmetic term one
        # unsigned atom settles is itself unsigned, because arithmetic between an unsigned operand
        # and anything else does not typecheck, so every leaf is nonnegative; addition,
        # multiplication, division, remainder and the shifts all carry nonnegativity forward.
        # Subtraction is the one operator whose mathematical value can be negative while its
        # unsigned machine value is not, which is exactly what the wrap guard exists to catch.
        # Any form this does not name is treated as containing a subtraction.
