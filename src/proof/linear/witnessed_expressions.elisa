extend ElisaProof:
    public:
        # The parser stores a full-width unsigned literal's bit pattern in the signed integer
        # AST payload (u64.max is -1). Until the kernel term format retains the literal sort,
        # refuse bounded arithmetic reasoning that mixes such a payload with a machine-word
        # unsigned term instead of manufacturing a contradictory signed interval.
        def proof_expression_has_negative_integer_bit_pattern(expression: Ast::Expr, depth: usize) -> bool:
            return true if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            match expression:
                Ast::Expr.IntLit(value, _):
                    return value < 0
                Ast::Expr.Unary(_, operand, _) | Ast::Expr.Paren(operand, _):
                    return proof_expression_has_negative_integer_bit_pattern(operand, depth + 1)
                Ast::Expr.Binary(left, _, right, _):
                    return proof_expression_has_negative_integer_bit_pattern(left, depth + 1) or proof_expression_has_negative_integer_bit_pattern(right, depth + 1)
                Ast::Expr.If(condition, then_expression, else_expression, _):
                    return proof_expression_has_negative_integer_bit_pattern(condition, depth + 1) or proof_expression_has_negative_integer_bit_pattern(then_expression, depth + 1) or proof_expression_has_negative_integer_bit_pattern(else_expression, depth + 1)
                Ast::Expr.Call(callee, arguments, _, _):
                    return true if proof_expression_has_negative_integer_bit_pattern(callee, depth + 1)
                    for argument in arguments |depth|:
                        return true if proof_expression_has_negative_integer_bit_pattern(argument, depth + 1)
                    return false
                Ast::Expr.Field(object, _, _) | Ast::Expr.Scope(object, _, _) | Ast::Expr.Move(object, _) | Ast::Expr.RegionNew(object, _, _):
                    return proof_expression_has_negative_integer_bit_pattern(object, depth + 1)
                Ast::Expr.Index(object, index, _):
                    return proof_expression_has_negative_integer_bit_pattern(object, depth + 1) or proof_expression_has_negative_integer_bit_pattern(index, depth + 1)
                Ast::Expr.IndexN(object, indices, _):
                    return true if proof_expression_has_negative_integer_bit_pattern(object, depth + 1)
                    for index in indices |depth|:
                        return true if proof_expression_has_negative_integer_bit_pattern(index, depth + 1)
                    return false
                Ast::Expr.Slice(object, low, high, _):
                    return proof_expression_has_negative_integer_bit_pattern(object, depth + 1) or proof_expression_has_negative_integer_bit_pattern(low, depth + 1) or proof_expression_has_negative_integer_bit_pattern(high, depth + 1)
                _:
                    return false

        def proof_unsigned_expression_safe_with_bounds(expression: Ast::Expr, facts: darray[Ast::Expr]&, bounds: darray[ProofBound]&) -> bool:
            width: i64 = proof_unsigned_width_in_expression(expression, facts)
            return false if width == ElisaProofKernelCore::PROOF_KERNEL_MACHINE_WORD_BITS and proof_expression_has_negative_integer_bit_pattern(expression, 0)
            return true if proof_unsigned_conditional_difference_safe(expression, facts)
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_unsigned_expression_safe_with_bounds(inner, facts, bounds)
                Ast::Expr.Unary(operator, operand, _):
                    return false if not proof_unsigned_expression_safe_with_bounds(operand, facts, bounds)
                    if operator == TokenKind.Minus:
                        width: i64 = proof_unsigned_width_in_expression(operand, facts)
                        if width != 0:
                            interval: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_interval(expression, bounds)
                            return interval.has_lower and interval.has_upper and interval.lower >= 0 and interval.upper <= proof_unsigned_width_max(width)
                    return true
                Ast::Expr.Binary(left, operator, right, _):
                    # `or` and `and` short-circuit, so an operand the left one settles is never
                    # evaluated and its arithmetic never happens. Requiring it to be in range
                    # refuses goals whose own structure makes it unreachable -- `ensure not result
                    # or count <= total - start` on the path that returns false, where the guard
                    # the subtraction needs is exactly what failed.
                    if operator == TokenKind.Or or operator == TokenKind.And:
                        return false if not proof_unsigned_expression_safe_with_bounds(left, facts, bounds)
                        settled: (known: bool, value: bool) = proof_constant_bool(left)
                        return true if settled.known and settled.value and operator == TokenKind.Or
                        return true if settled.known and not settled.value and operator == TokenKind.And
                        return proof_unsigned_expression_safe_with_bounds(right, facts, bounds)
                    return false if not proof_unsigned_expression_safe_with_bounds(left, facts, bounds)
                    return false if not proof_unsigned_expression_safe_with_bounds(right, facts, bounds)
                    arithmetic: bool = operator == TokenKind.Plus or operator == TokenKind.Minus or operator == TokenKind.Star or operator == TokenKind.Slash or operator == TokenKind.Percent or operator == TokenKind.LShift or operator == TokenKind.RShift
                    width: i64 = proof_unsigned_width_in_expression(expression, facts)
                    return true if not arithmetic or width == 0
                    # Unsigned subtraction is defined for every nonnegative pair when the
                    # minuend is at least the subtrahend, even when the values are wider than
                    # this prover's i64 interval domain. Preserve useful range proofs such as
                    # `count <= total - start` under the explicit `start <= total` precondition.
                    if operator == TokenKind.Plus:
                        unit: (known: bool, base: Ast::Expr) = proof_unsigned_unit_increment_base(left, right)
                        if unit.known:
                            return true if proof_unsigned_increment_has_strict_peer(unit.base, width, facts)
                        # A sum of two non-constant terms has no interval here, and for a 64-bit
                        # unsigned value it never can. What it can have is a bound: the same search
                        # that discharges `a + b <= C` also names the `C`, and a sum bounded by a
                        # term of its own width is in range without any magnitude being known.
                        sum_witness: (known: bool, bound: Ast::Expr, strict: bool) = proof_sum_upper_witness(left, right, facts)
                        if sum_witness.known and proof_peer_is_nameable(sum_witness.bound):
                            return true if proof_peer_unsigned_width(sum_witness.bound, facts) == width
                    if operator == TokenKind.Star:
                        scaled_witness: (known: bool, base: Ast::Expr, bound: Ast::Expr, factor: i64) = proof_unsigned_scaled_product_witness(expression, facts, false)
                        return true if scaled_witness.known
                    if operator == TokenKind.Minus:
                        orders: mutable darray[Ast::Expr] = []
                        # Read the facts the same way the structural rules do: conjuncts
                        # flattened, and a disjunction one side of which an existing fact denies
                        # contributing the other. A callee's postcondition arrives as
                        # `not result or ...` and the caller has already guarded on the result, so
                        # without this the order the subtraction needs is stated and unreadable.
                        readable: darray[Ast::Expr] = proof_conjunct_facts(facts)
                        for fact in readable |orders|:
                            proof_collect_unsigned_order_facts(fact, &orders)
                        # The order tier is gated on its operands' primitive type witness, which
                        # is a type statement rather than an order fact. Carry the markers across
                        # with the orders; they are inert for every bound and alias collector.
                        for fact in facts |orders|:
                            orders.push(fact) if proof_type_marker_root_name(fact) != "" or proof_unsigned_marker_name(fact) != ""
                        increments: mutable darray[Ast::Expr] = []
                        for fact in readable |orders, increments|:
                            increments.push(fact) if proof_unsigned_peer_increment_equality(fact, orders)
                        orders.extend(increments)
                        # The order the subtraction needs may be stated between two places, and
                        # the affine tiers below name one bare identifier, so they cannot read it.
                        # A collected order is a comparison between two atoms and contains no
                        # arithmetic, so matching one directly imports nothing this guard would
                        # then be deciding about itself.
                        return true if proof_has_order_fact(right, left, false, orders)
                        return true if proof_linear_goal(right, TokenKind.LtEq, left, orders)
                    # For an unsigned remainder, a positive, representable constant divisor
                    # gives the machine result range [0, divisor - 1] regardless of the
                    # dividend. The generic interval below is signed and intentionally spans
                    # negative values, which used to reject safe `%` terms in conditional paths.
                    # Keep this rule narrow: variable/zero/negative divisors and divisors that
                    # do not fit the witnessed result width still fall through to rejection.
                    if operator == TokenKind.Percent and width > 0:
                        divisor: (known: bool, value: i64) = proof_constant_int(right)
                        return false if not divisor.known or divisor.value <= 0
                        return false if not proof_unsigned_constants_fit(right, width, 0)
                        remainder_upper: (known: bool, value: i64) = proof_sub_safe(divisor.value, 1)
                        return false if not remainder_upper.known
                        return remainder_upper.value <= proof_unsigned_width_max(width)
                    interval: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_interval(expression, bounds)
                    return interval.has_lower and interval.has_upper and interval.lower >= 0 and interval.upper <= proof_unsigned_width_max(width)
                Ast::Expr.If(condition, then_expression, else_expression, position):
                    return false if not proof_unsigned_expression_safe_with_bounds(condition, facts, bounds)
                    then_safe: bool = proof_unsigned_expression_safe_with_bounds(then_expression, facts, bounds) or proof_unsigned_arm_safe_under(then_expression, condition, facts)
                    return false if not then_safe
                    return true if proof_unsigned_expression_safe_with_bounds(else_expression, facts, bounds)
                    return proof_unsigned_arm_safe_unless(else_expression, condition, facts, position)
                Ast::Expr.Call(callee, arguments, _, _):
                    return false if not proof_unsigned_expression_safe_with_bounds(callee, facts, bounds)
                    for argument in arguments |argument, facts, bounds|:
                        return false if not proof_unsigned_expression_safe_with_bounds(argument, facts, bounds)
                    return true
                _:
                    return true

        # The then arm of `a if c else b` runs only when `c` holds, so `x - k if x >= k else 0`
        # does not wrap. The condition, already found range-safe, joins the facts for that arm alone.
        def proof_unsigned_arm_safe_under(arm: Ast::Expr, condition: Ast::Expr, facts: darray[Ast::Expr]&) -> bool:
            guarded: mutable darray[Ast::Expr] = []
            guarded.extend(facts)
            guarded.push(condition)
            bounds: mutable darray[ProofBound] = []
            proof_collect_fact_bounds(guarded, &bounds)
            proof_close_equalities(guarded, &bounds)
            return true if proof_unsigned_expression_safe_with_bounds(arm, guarded, bounds)
            proof_close_plain_bounds(guarded, &bounds)
            proof_unsigned_expression_safe_with_bounds(arm, guarded, bounds)

        # The else arm runs only when the condition fails; its complement enters the bounds alone.
        def proof_unsigned_arm_safe_unless(arm: Ast::Expr, condition: Ast::Expr, facts: darray[Ast::Expr]&, position: Ast::Pos) -> bool:
            bounds: mutable darray[ProofBound] = []
            proof_collect_fact_bounds(facts, &bounds)
            proof_collect_bounds(Ast::Expr.Unary(TokenKind.Not, condition, position), facts, &bounds)
            proof_close_equalities(facts, &bounds)
            return true if proof_unsigned_expression_safe_with_bounds(arm, facts, bounds)
            proof_close_plain_bounds(facts, &bounds)
            proof_unsigned_expression_safe_with_bounds(arm, facts, bounds)

        def proof_unsigned_expression_safe(expression: Ast::Expr, facts: darray[Ast::Expr]&) -> bool:
            bounds: mutable darray[ProofBound] = []
            proof_collect_fact_bounds(facts, &bounds)
            proof_close_equalities(facts, &bounds)
            # Deliberately no bound propagation here beyond plain orders (see
            # `proof_close_plain_bounds`), and that only when the collected bounds fall short:
            # the closure only narrows intervals, so running it later decides the same terms. A difference constraint is read off a fact
            # such as `y == x + 1`, which for an unsigned type is a *modular* equality: it is true
            # at `x == 255, y == 0` for a `u8` and says nothing about the integers. Propagating it
            # would hand this guard an interval that only holds if the term does not wrap, which is
            # the very question the guard is deciding, and `examples/rejected_unsigned_fact_explosion.elisa`
            # then proves `x == 0` from `x == 255`. The goal tier may propagate because it runs
            # after every affine term in the goal has been certified non-wrapping.
            unsigned_safe: mutable bool = proof_unsigned_expression_safe_with_bounds(expression, facts, bounds)
            if not unsigned_safe:
                proof_close_plain_bounds(facts, &bounds)
                unsigned_safe <- proof_unsigned_expression_safe_with_bounds(expression, facts, bounds)
            return unsigned_safe and proof_signed_expression_safe(expression, facts)

        # A closed integer subexpression is evaluated with the destination type's machine
        # semantics, not as an unbounded mathematical integer. The ordinary unsigned guard gets
        # its width from identifier markers; literals have no identifier to carry that marker, so
        # a typed declaration or return boundary must check them explicitly. Unknown leaves remain
        # for the ordinary fact-based guard, while every closed subtree must fit before it may be
        # folded into a signed `i64` proof term.
        def proof_unsigned_negative_integer_literal(expression: Ast::Expr, depth: usize) -> bool:
            return false if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            match expression:
                Ast::Expr.IntLit(value, _):
                    return value < 0
                Ast::Expr.Paren(inner, _):
                    return proof_unsigned_negative_integer_literal(inner, depth + 1)
                _:
                    return false

        def proof_unsigned_constants_fit(expression: Ast::Expr, width: i64, depth: usize) -> bool:
            return false if width <= 0 or depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            constant: (known: bool, value: i64) = proof_constant_int(expression)
            if constant.known:
                return constant.value <= proof_unsigned_width_max(width) if constant.value >= 0
                # The parser stores a positive u64 literal with its high bit set as
                # the corresponding negative i64 bit pattern. Admit that spelling
                # only as an integer literal in u64 context; unary negative
                # arithmetic remains outside this range proof.
                return width == 64 and proof_unsigned_negative_integer_literal(expression, 0)
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_unsigned_constants_fit(inner, width, depth + 1)
                Ast::Expr.Unary(_, operand, _):
                    return proof_unsigned_constants_fit(operand, width, depth + 1)
                Ast::Expr.Binary(left, _, right, _):
                    return proof_unsigned_constants_fit(left, width, depth + 1) and proof_unsigned_constants_fit(right, width, depth + 1)
                Ast::Expr.If(condition, then_expression, else_expression, _):
                    return proof_unsigned_constants_fit(condition, width, depth + 1) and proof_unsigned_constants_fit(then_expression, width, depth + 1) and proof_unsigned_constants_fit(else_expression, width, depth + 1)
                Ast::Expr.Call(callee, arguments, _, _):
                    return false if not proof_unsigned_constants_fit(callee, width, depth + 1)
                    for argument in arguments |argument, width, depth|:
                        return false if not proof_unsigned_constants_fit(argument, width, depth + 1)
                _:
                    pass
            return true

        # Reflexivity, symmetry, and coherence with arithmetic are not universal in Elisa. `==`,
        # `!=` and the four ordering operators dispatch to a user `__eq__`/`__cmp__` whenever an
        # operand's type is a struct, and neither protocol method is required to have any of those
        # properties, so `p == p`, `p <= p`, and `q == p` from `p == q` are not theorems for an
        # arbitrary type. Every rule that concludes a comparison because its operands denote the
        # same value therefore needs the operand's primitive type witness. A bare identifier is
        # the shape whose declared type the producer records; a richer operand shape is left to
        # the numeric tiers, which cannot construct an interval for a struct anyway.
        def proof_scalar_witnessed(facts: darray[Ast::Expr]&, name: sview) -> bool:
            return false if name == ""
            for fact in facts:
                # Only these two marker kinds can witness a bare scalar name.
                # Dispatch once; the full parsers retain arity/name/width checks.
                marker_name: sview = proof_marker_callee_name(fact)
                if marker_name == "__elisa_primitive_scalar_type" or marker_name == "__elisa_primitive_integer_type":
                    argument: (known: bool, term: Ast::Expr) = proof_marker_argument(fact, marker_name)
                    return true if argument.known and proof_ident_name(argument.term) == name
                elif marker_name == "__elisa_unsigned_type_bound":
                    return true if proof_unsigned_marker_name(fact) == name
            return false

        # Ground congruence and the identity tiers admit only the language's own operators; a
        # struct operand would dispatch to a user protocol method instead. This mirrors the
        # kernel's list exactly, including the deliberate exclusion of unary `&`: an address is
        # not a function of the value stored at it.
        def proof_congruent_binary_operator(operator: TokenKind) -> bool:
            return true if operator == TokenKind.Plus or operator == TokenKind.Minus or operator == TokenKind.Star or operator == TokenKind.Slash or operator == TokenKind.Percent
            return true if operator == TokenKind.EqEq or operator == TokenKind.BangEq or operator == TokenKind.Lt or operator == TokenKind.Gt or operator == TokenKind.LtEq or operator == TokenKind.GtEq
            return true if operator == TokenKind.And or operator == TokenKind.Or or operator == TokenKind.FatArrow
            return true if operator == TokenKind.Ampersand or operator == TokenKind.Pipe or operator == TokenKind.Caret or operator == TokenKind.LShift or operator == TokenKind.RShift
            return false

        def proof_congruent_unary_operator(operator: TokenKind) -> bool:
            return operator == TokenKind.Plus or operator == TokenKind.Minus or operator == TokenKind.Not

        # How many further subscripts this term needs to reach a primitive scalar: the marker's
        # depth for a witnessed container, one less per subscript over a witnessed index term,
        # and -1 when nothing is known. A term is a scalar element exactly when this reaches 0.
        def proof_indexed_container_path(expression: Ast::Expr, root: mutable Ast::Expr&, indexes: mutable darray[Ast::Expr]&, depth: usize) -> bool:
            return false if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_indexed_container_path(inner, root, indexes, depth + 1)
                Ast::Expr.Index(object, index, _):
                    return false if not proof_indexed_container_path(object, root, indexes, depth + 1)
                    indexes.push(index)
                    return true
                Ast::Expr.IndexN(object, arguments, _):
                    return false if not proof_indexed_container_path(object, root, indexes, depth + 1)
                    for argument in arguments |indexes|:
                        indexes.push(argument)
                    return true
                _:
                    root <- expression
                    return true

        def proof_scalar_untrusted_operator_applies(term: Ast::Expr, marked_term: Ast::Expr, depth: usize) -> bool:
            return false if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            match term:
                Ast::Expr.Field(object, field_name, _):
                    container: mutable Ast::Expr = object
                    indexes: mutable darray[Ast::Expr] = []
                    return false if not proof_indexed_container_path(object, &container, &indexes, depth + 1) or indexes.count == 0
                    match marked_term:
                        Ast::Expr.Field(marked_container, marked_field, _):
                            return field_name == marked_field and proof_expr_equal(container, marked_container)
                        _:
                            return false
                _:
                    return proof_expr_equal(marked_term, term)

        def proof_scalar_term_witnessed(expression: Ast::Expr, facts: darray[Ast::Expr]&, depth: usize) -> bool:
            markers: ProofScalarWitnesses = proof_scalar_witness_markers(facts)
            return proof_scalar_term_witnessed_in(expression, markers, depth)

        def proof_scalar_element_remaining(expression: Ast::Expr, facts: darray[Ast::Expr]&, depth: usize) -> i64:
            markers: ProofScalarWitnesses = proof_scalar_witness_markers(facts)
            return proof_scalar_element_remaining_in(expression, markers, depth)

        def proof_scalar_element_remaining_in(expression: Ast::Expr, facts: ProofScalarWitnesses&, depth: usize) -> i64:
            return -1 if depth > PROOF_CONGRUENCE_SCAN_DEPTH
            element: mutable usize = 0
            while element < facts.element_terms.count |element, facts, expression|:
                return facts.element_depths[element] if proof_expr_equal(facts.element_terms[element], expression)
                element <- element + 1
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_scalar_element_remaining_in(inner, facts, depth + 1)
                Ast::Expr.Field(object, field_name, _):
                    container: mutable Ast::Expr = object
                    indexes: mutable darray[Ast::Expr] = []
                    return -1 if not proof_indexed_container_path(object, &container, &indexes, depth + 1) or indexes.count == 0
                    element: mutable usize = 0
                    while element < facts.element_terms.count |element, container, field_name, indexes, facts, depth|:
                        if proof_expr_equal_field(facts.element_terms[element], container, field_name):
                            marker_depth: i64 = facts.element_depths[element]
                            return -1 if marker_depth < indexes.count.i64()
                            for index in indexes |facts, depth|:
                                return -1 if not proof_scalar_term_witnessed_in(index, facts, depth + 1)
                            return marker_depth - indexes.count.i64()
                        element <- element + 1
                    return -1
                Ast::Expr.Index(object, index, _):
                    remaining: i64 = proof_scalar_element_remaining_in(object, facts, depth + 1)
                    return -1 if remaining < 1 or not proof_scalar_term_witnessed_in(index, facts, depth + 1)
                    return remaining - 1
                Ast::Expr.IndexN(object, arguments, _):
                    remaining: i64 = proof_scalar_element_remaining_in(object, facts, depth + 1)
                    return -1 if remaining < arguments.count.i64()
                    for argument in arguments |facts, depth|:
                        return -1 if not proof_scalar_term_witnessed_in(argument, facts, depth + 1)
                    return remaining - arguments.count.i64()
                _:
                    return -1

        # Whether this term is known to denote a primitive scalar value. The producer mirror of
        # `proof_kernel_replay_scalar_term_witnessed`; the kernel re-derives the same judgement
        # from the certificate and owns the decision.
        #
        # A witness is a scalar literal, a term whose declared primitive scalar type the producer
        # resolved and recorded, an element of a container whose element type it resolved indexed
        # by a witnessed term, or a former built from the language's own operators over witnessed
        # operands. A call result is deliberately not witnessed: its return type is not resolved
        # here, and a function need not be deterministic, so two occurrences of the same call text
        # need not denote one value.
        def proof_scalar_term_witnessed_in(expression: Ast::Expr, facts: ProofScalarWitnesses&, depth: usize) -> bool:
            return false if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            for untrusted_term in facts.untrusted_terms |expression|:
                return false if proof_scalar_untrusted_operator_applies(expression, untrusted_term, depth + 1)
            match expression:
                Ast::Expr.IntLit(_, _):
                    return true
                Ast::Expr.BoolLit(_, _):
                    return true
                Ast::Expr.CharLit(_, _):
                    return true
                _:
                    pass
            # Preserve the existing exact-witness lookup for ordinary expression kinds.
            for scalar_term in facts.scalar_terms |expression|:
                return true if proof_expr_equal(scalar_term, expression)
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_scalar_term_witnessed_in(inner, facts, depth + 1)
                Ast::Expr.Ident(name, _):
                    return proof_scalar_witnesses_name(facts, name)
                Ast::Expr.Index(_, _, _):
                    return proof_scalar_element_remaining_in(expression, facts, depth + 1) == 0
                Ast::Expr.IndexN(_, _, _):
                    return proof_scalar_element_remaining_in(expression, facts, depth + 1) == 0
                Ast::Expr.Field(object, field_name, _):
                    return true if field_name == "count" and proof_expr_is_collection_literal(object)
                    return proof_scalar_element_remaining_in(expression, facts, depth + 1) == 0
                Ast::Expr.Unary(operator, operand, _):
                    return proof_congruent_unary_operator(operator) and proof_scalar_term_witnessed_in(operand, facts, depth + 1)
                Ast::Expr.Binary(left, operator, right, _):
                    return proof_congruent_binary_operator(operator) and proof_scalar_term_witnessed_in(left, facts, depth + 1) and proof_scalar_term_witnessed_in(right, facts, depth + 1)
                Ast::Expr.If(condition, then_expression, else_expression, _):
                    return proof_scalar_term_witnessed_in(condition, facts, depth + 1) and proof_scalar_term_witnessed_in(then_expression, facts, depth + 1) and proof_scalar_term_witnessed_in(else_expression, facts, depth + 1)
                Ast::Expr.Call(_, _, _, _):
                    # A call-shaped cast is witnessed only by an explicit, source-aware marker
                    # above. This syntax-only relation has no function table and cannot rule out
                    # a user-defined `__cast__` overload or justify its integer semantics.
                    return false
                _:
                    return false

        # The count of a collection literal is the literal's own length, a `usize` whatever its
        # elements are; the kernel mirrors this in `proof_kernel_replay_scalar_term_witnessed`.
        def proof_expr_is_collection_literal(expression: Ast::Expr) -> bool:
            match expression:
                Ast::Expr.Array(_, _):
                    return true
                _:
                    return false

        def proof_primitive_comparison(left: Ast::Expr, right: Ast::Expr, facts: darray[Ast::Expr]&) -> bool:
            markers: ProofScalarWitnesses = proof_scalar_witness_markers(facts)
            return proof_primitive_comparison_marked(left, right, markers)

        # `markers` must be exactly `proof_scalar_witness_markers` of the fact list.
        def proof_primitive_comparison_marked(left: Ast::Expr, right: Ast::Expr, markers: ProofScalarWitnesses&) -> bool:
            return proof_scalar_term_witnessed_in(left, markers, 0) and proof_scalar_term_witnessed_in(right, markers, 0)

        def proof_unsigned_goal_identity(expression: Ast::Expr, facts: darray[Ast::Expr]&) -> bool:
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_unsigned_goal_identity(inner, facts)
                Ast::Expr.Binary(left, operator, right, _):
                    return proof_primitive_comparison(left, right, facts) and proof_definitionally_equal(left, right) and proof_is_true_comparison(operator)
                _:
                    return false

        # An inconsistent set of explicit interval facts has no reachable state. Applying
        # ex-falso here is sound Hoare reasoning (a function with impossible preconditions has
        # no executions), and it also makes contradictory branch complements useful without
        # teaching the kernel a general-purpose theorem prover.
        # The part of inconsistency that needs no arithmetic: a false literal, or a proposition
        # beside its own negation. Nothing is evaluated and no interval is consulted, so this may
        # run before the fixed-width guard -- it cannot be misled by a modular premise, because it
        # never reads one as a number. That ordering is what closes the branch a disjunctive
        # premise refutes: a callee's `not result or p` beside the caller's own `result` leaves
        # `p` in the only branch that survives, and the branch that assumed `not result` is shut
        # without its facts ever having to be range-safe.
        def proof_facts_propositionally_inconsistent(facts: darray[Ast::Expr]&) -> bool:
            for fact in facts:
                match fact:
                    Ast::Expr.BoolLit(value, _):
                        return true if not value
                    Ast::Expr.Unary(TokenKind.Not, operand, _):
                        match operand:
                            Ast::Expr.BoolLit(value, _):
                                return true if value
                            _:
                                pass
                    _:
                        pass
            for fact in facts |facts|:
                return true if proof_closed_safe_constant_comparison_false(fact) or proof_fact_denies(fact, facts)
            return false

        def proof_facts_inconsistent(facts: darray[Ast::Expr]&) -> bool:
            bounds: mutable darray[ProofBound] = []
            proof_collect_fact_bounds(facts, &bounds)
            proof_close_equalities(facts, &bounds)
            for bound in bounds:
                return true if bound.has_lower and bound.has_upper and bound.lower > bound.upper
            return proof_facts_propositionally_inconsistent(facts)

        # Return a conservative interval for affine expressions. Lower and upper knowledge are
        # tracked independently: a fact such as x >= 0 is enough for a later lower-bound goal,
        # but never gets mistaken for a finite interval or used to justify an unsafe operation.
        def proof_interval(expression: Ast::Expr, bounds: darray[ProofBound]&) -> (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool):
            constant: (known: bool, value: i64) = proof_constant_int(expression)
            return (true, constant.value, constant.value, true, true) if constant.known
            term_bound: ProofBound = proof_bound_for_term(bounds, expression)
            return (term_bound.has_lower and term_bound.has_upper, term_bound.lower, term_bound.upper, term_bound.has_lower, term_bound.has_upper) if term_bound.term_key
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_interval(inner, bounds)
                Ast::Expr.Ident(name, _):
                    found: ProofBound = proof_bound_for(bounds, name)
                    return (found.has_lower and found.has_upper, found.lower, found.upper, found.has_lower, found.has_upper)
                Ast::Expr.Unary(operator, operand, _):
                    inner: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_interval(operand, bounds)
                    if operator == TokenKind.Minus:
                        negated_lower: mutable i64 = 0
                        negated_upper: mutable i64 = 0
                        has_negated_lower: mutable bool = inner.has_upper and inner.upper != proof_i64_min()
                        has_negated_upper: mutable bool = inner.has_lower and inner.lower != proof_i64_min()
                        negated_lower <- 0 - inner.upper if has_negated_lower
                        negated_upper <- 0 - inner.lower if has_negated_upper
                        return (has_negated_lower and has_negated_upper, negated_lower, negated_upper, has_negated_lower, has_negated_upper)
                    if operator == TokenKind.Plus:
                        return inner
                Ast::Expr.Binary(left, operator, right, position):
                    a: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_interval(left, bounds)
                    b: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_interval(right, bounds)
                    if operator == TokenKind.Plus:
                        lower: mutable i64 = 0
                        upper: mutable i64 = 0
                        has_lower: mutable bool = false
                        has_upper: mutable bool = false
                        if a.has_lower and b.has_lower:
                            low: (known: bool, value: i64) = proof_add_safe(a.lower, b.lower)
                            lower <- low.value if low.known
                            has_lower <- low.known
                        if a.has_upper and b.has_upper:
                            high: (known: bool, value: i64) = proof_add_safe(a.upper, b.upper)
                            upper <- high.value if high.known
                            has_upper <- high.known
                        return (has_lower and has_upper, lower, upper, has_lower, has_upper)
                    if operator == TokenKind.Minus:
                        lower: mutable i64 = 0
                        upper: mutable i64 = 0
                        has_lower: mutable bool = false
                        has_upper: mutable bool = false
                        if a.has_lower and b.has_upper:
                            low_sub: (known: bool, value: i64) = proof_sub_safe(a.lower, b.upper)
                            lower <- low_sub.value if low_sub.known
                            has_lower <- low_sub.known
                        if a.has_upper and b.has_lower:
                            high_sub: (known: bool, value: i64) = proof_sub_safe(a.upper, b.lower)
                            upper <- high_sub.value if high_sub.known
                            has_upper <- high_sub.known
                        return (has_lower and has_upper, lower, upper, has_lower, has_upper)
                    if operator == TokenKind.Star and a.known and b.known:
                        p1_result: (known: bool, value: i64) = proof_mul_safe(a.lower, b.lower)
                        p2_result: (known: bool, value: i64) = proof_mul_safe(a.lower, b.upper)
                        p3_result: (known: bool, value: i64) = proof_mul_safe(a.upper, b.lower)
                        p4_result: (known: bool, value: i64) = proof_mul_safe(a.upper, b.upper)
                        return (false, 0, 0, false, false) if not p1_result.known or not p2_result.known or not p3_result.known or not p4_result.known
                        p1: i64 = p1_result.value
                        p2: i64 = p2_result.value
                        p3: i64 = p3_result.value
                        p4: i64 = p4_result.value
                        low: mutable i64 = p1
                        high: mutable i64 = p1
                        low <- p2 if p2 < low
                        low <- p3 if p3 < low
                        low <- p4 if p4 < low
                        high <- p2 if p2 > high
                        high <- p3 if p3 > high
                        high <- p4 if p4 > high
                        return (true, low, high, true, true)
                    if operator == TokenKind.Slash and b.known and b.lower == b.upper and a.has_lower and a.has_upper:
                        lower_quotient: (known: bool, value: i64) = proof_div_safe(a.lower, b.lower)
                        upper_quotient: (known: bool, value: i64) = proof_div_safe(a.upper, b.lower)
                        return (false, 0, 0, false, false) if not lower_quotient.known or not upper_quotient.known
                        return (true, lower_quotient.value, upper_quotient.value, true, true) if b.lower > 0
                        return (true, upper_quotient.value, lower_quotient.value, true, true)
                    # A divisor bounded to a positive range: truncating division is monotone in
                    # each operand there, so the corners give the quotient's range. Signed
                    # division only wraps at `MIN / -1`, which a divisor >= 1 excludes.
                    if operator == TokenKind.Slash and b.has_lower and b.has_upper and b.lower >= 1 and a.has_lower and a.has_upper:
                        return (true, a.lower / b.upper, a.upper / b.lower, true, true) if a.lower >= 0
                        return (true, a.lower / b.lower, a.upper / b.upper, true, true) if a.upper <= 0
                        return (true, a.lower / b.lower, a.upper / b.lower, true, true)
                    return proof_variable_divisor_interval(a, b) if operator == TokenKind.Slash
                    if operator == TokenKind.Percent:
                        divisor: (known: bool, value: i64) = proof_constant_int(right)
                        # `MIN_I64 % -1` is the fixed-width overflow edge. The interval
                        # tier does not retain enough information to prove that the dividend
                        # excludes MIN_I64, so reject divisor -1 instead of treating this as a
                        # universally safe machine-integer remainder.
                        return (false, 0, 0, false, false) if not divisor.known or divisor.value == 0 or divisor.value == -1
                        magnitude: mutable i64 = divisor.value
                        if magnitude < 0:
                            absolute: (known: bool, value: i64) = proof_sub_safe(0, magnitude)
                            return (false, 0, 0, false, false) if not absolute.known
                            magnitude <- absolute.value
                        remainder_limit: (known: bool, value: i64) = proof_sub_safe(magnitude, 1)
                        return (false, 0, 0, false, false) if not remainder_limit.known
                        negative_limit: (known: bool, value: i64) = proof_sub_safe(0, remainder_limit.value)
                        return (false, 0, 0, false, false) if not negative_limit.known
                        return (true, negative_limit.value, remainder_limit.value, true, true)
                _:
                    pass
            return (false, 0, 0, false, false)
