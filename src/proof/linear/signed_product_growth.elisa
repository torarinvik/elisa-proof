extend ElisaProof:
    public:
        # Multiplication grows a nonnegative base when the factor is at least
        # one and the complete signed operation cannot overflow.
        def proof_signed_product_growth(facts: darray[Ast::Expr]&, goal: Ast::Expr) -> bool:
            match proof_strip_parens(goal):
                Ast::Expr.Binary(left, operator, right, _):
                    return false if operator != TokenKind.GtEq and operator != TokenKind.LtEq
                    product: Ast::Expr = left if operator == TokenKind.GtEq else right
                    base: Ast::Expr = right if operator == TokenKind.GtEq else left
                    match proof_strip_parens(product):
                        Ast::Expr.Binary(first, TokenKind.Star, second, _):
                            factor: Ast::Expr = second if proof_expr_equal(first, base) else first
                            return false if not proof_expr_equal(first, base) and not proof_expr_equal(second, base)
                            width: i64 = proof_signed_width_in_expression(base, facts)
                            return false if width <= 0 or proof_signed_width_in_expression(factor, facts) != width
                            return false if not proof_scalar_term_witnessed(base, facts, 0) or not proof_scalar_term_witnessed(factor, facts, 0)
                            bounds: mutable darray[ProofBound] = []
                            for fact in facts |facts, bounds|:
                                proof_collect_bounds(fact, facts, &bounds) if proof_product_direct_bound(fact, 0)
                            base_range = proof_interval(base, &bounds)
                            factor_range = proof_interval(factor, &bounds)
                            return base_range.has_lower and base_range.lower >= 0 and factor_range.has_lower and factor_range.lower >= 1 and proof_signed_expression_safe_with_bounds(product, facts, &bounds, 0)
                        _:
                            return false
                _:
                    return false

        def proof_product_direct_bound(expression: Ast::Expr, depth: usize) -> bool:
            return false if depth >= 64
            match proof_strip_parens(expression):
                Ast::Expr.Binary(left, TokenKind.And, right, _):
                    return proof_product_direct_bound(left, depth + 1) and proof_product_direct_bound(right, depth + 1)
                Ast::Expr.Binary(left, operator, right, _):
                    return false if not proof_is_order_operator(operator)
                    return (proof_ident_name(left) != "" and proof_product_bound_literal(right)) or (proof_ident_name(right) != "" and proof_product_bound_literal(left))
                _:
                    return false

        def proof_product_bound_literal(expression: Ast::Expr) -> bool:
            match expression:
                Ast::Expr.IntLit(_, _) | Ast::Expr.Unary(TokenKind.Minus, Ast::Expr.IntLit(_, _), _):
                    return true
                _:
                    return false
