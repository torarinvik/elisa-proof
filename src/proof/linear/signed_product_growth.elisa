extend ElisaProof:
    public:
        # Compare a signed product with its base using interval-proven sign cases.
        def proof_signed_product_growth(facts: darray[Ast::Expr]&, goal: Ast::Expr) -> bool:
            match proof_strip_parens(goal):
                Ast::Expr.Binary(left, operator, right, _):
                    return false if operator != TokenKind.GtEq and operator != TokenKind.LtEq
                    left_factor: (known: bool, factor: Ast::Expr) = proof_signed_product_factor(left, right)
                    if left_factor.known:
                        return true if proof_signed_product_comparison_supported(facts, left, right, left_factor.factor, operator == TokenKind.GtEq)
                    right_factor: (known: bool, factor: Ast::Expr) = proof_signed_product_factor(right, left)
                    if right_factor.known:
                        return true if proof_signed_product_comparison_supported(facts, right, left, right_factor.factor, operator == TokenKind.LtEq)
                    return false
                _:
                    return false

        def proof_signed_product_factor(product: Ast::Expr, base: Ast::Expr) -> (known: bool, factor: Ast::Expr):
            match proof_strip_parens(product):
                Ast::Expr.Binary(first, TokenKind.Star, second, _):
                    return (true, second) if proof_expr_equal(first, base)
                    return (true, first) if proof_expr_equal(second, base)
                _:
                    pass
            (false, Ast::Expr.Invalid)

        # `product_ge_base` selects the appropriate sign cases for the goal direction.
        # Both operands must be witnessed at the same signed width, and the product must
        # remain representable throughout its evaluation.
        def proof_signed_product_comparison_supported(facts: darray[Ast::Expr]&, product: Ast::Expr, base: Ast::Expr, factor: Ast::Expr, product_ge_base: bool) -> bool:
            width: i64 = proof_signed_width_in_expression(base, facts)
            return false if width <= 0 or proof_signed_width_in_expression(factor, facts) != width
            return false if not proof_scalar_term_witnessed(base, facts, 0) or not proof_scalar_term_witnessed(factor, facts, 0)
            bounds: mutable darray[ProofBound] = []
            for fact in facts |facts, bounds|:
                proof_collect_bounds(fact, facts, &bounds) if proof_product_direct_bound(fact, 0)
            base_range = proof_interval(base, &bounds)
            factor_range = proof_interval(factor, &bounds)
            grows: bool = (base_range.has_lower and base_range.lower >= 0 and factor_range.has_lower and factor_range.lower >= 1) or (base_range.has_upper and base_range.upper <= 0 and factor_range.has_upper and factor_range.upper <= 1)
            shrinks: bool = (base_range.has_lower and base_range.lower >= 0 and factor_range.has_upper and factor_range.upper <= 1) or (base_range.has_upper and base_range.upper <= 0 and factor_range.has_lower and factor_range.lower >= 1)
            return (grows if product_ge_base else shrinks) and proof_signed_expression_safe_with_bounds(product, facts, &bounds, 0)

        def proof_product_direct_bound(expression: Ast::Expr, depth: usize) -> bool:
            return false if depth >= 64
            match proof_strip_parens(expression):
                Ast::Expr.Binary(left, TokenKind.And, right, _):
                    # One explicit bound conjunct is enough to run the collector: it descends
                    # only through conjunctions and validates each comparison independently.
                    return proof_product_direct_bound(left, depth + 1) or proof_product_direct_bound(right, depth + 1)
                Ast::Expr.Binary(left, operator, right, _):
                    return false if not proof_is_order_operator(operator)
                    return (proof_ident_name(left) != "" and proof_product_bound_literal(right)) or (proof_ident_name(right) != "" and proof_product_bound_literal(left))
                _:
                    return false

        def proof_product_bound_literal(expression: Ast::Expr) -> bool:
            match expression:
                Ast::Expr.IntLit(_, _) | Ast::Expr.Unary(TokenKind.Minus, Ast::Expr.IntLit(_, _), _):
                    return true
                _:
                    return false
