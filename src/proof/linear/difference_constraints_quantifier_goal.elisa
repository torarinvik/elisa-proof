extend ElisaProof:
    private:
        def proof_quantifier_goal(facts: darray[Ast::Expr]&, expression: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, operator_mask: usize, depth: usize, budget: mutable usize&, split_depth: usize, exhausted: mutable bool&) -> bool can[Global.Read, Global.Write]:
            quantifier: (complete: bool, kind: sview) = proof_symbolic_quantifier_kind_with_budget(expression, annotations, budget, exhausted)
            return false if not quantifier.complete or quantifier.kind == ""
            kind: sview = quantifier.kind
            # Keep source-side instantiation behind the same shape gate as the certificate
            # encoder. In particular, dictionary binders must be distinct and their erased
            # initializer must be the exact parser placeholder.
            return false if not proof_kernel_expression_supported(expression)
            match expression:
                Ast::Expr.Paren(inner, _):
                    return (proof_quantifier_goal(facts, inner, annotations, operator_mask, depth, budget, split_depth, exhausted) can Global{Read,Write})
                Ast::Expr.Block(statements, body, _, _):
                    return false if statements.count == 0
                    match statements[0]:
                        Ast::Stmt.VarDecl(binder, _, range_expression, _):
                            match range_expression:
                                Ast::Expr.Binary(lower_expression, range_operator, upper_expression, _):
                                    return false if:
                                        statements.count != 1
                                        range_operator != TokenKind.RangeLt and range_operator != TokenKind.RangeLe
                                        proof_has_ambiguous_integer_constant(lower_expression, 0) and not proof_quantifier_small_signed_bound(lower_expression, annotations)
                                        proof_has_ambiguous_integer_constant(upper_expression, 0) and not proof_quantifier_small_signed_bound(upper_expression, annotations)
                                    lower: (known: bool, value: i64) = proof_exact_int_from_facts(lower_expression, facts)
                                    upper: (known: bool, value: i64) = proof_exact_int_from_facts(upper_expression, facts)
                                    return (proof_symbolic_quantifier_goal(facts, expression, annotations, operator_mask, depth, budget, split_depth, exhausted) can Global{Read,Write}) if not lower.known or not upper.known
                                    if range_operator == TokenKind.RangeLt and lower.value >= upper.value:
                                        return kind == "forall"
                                    if range_operator == TokenKind.RangeLe and lower.value > upper.value:
                                        return kind == "forall"
                                    width_difference: (known: bool, value: i64) = proof_sub_safe(upper.value, lower.value)
                                    return false if not width_difference.known
                                    width: mutable i64 = width_difference.value
                                    if range_operator == TokenKind.RangeLe:
                                        width_with_end: (known: bool, value: i64) = proof_add_safe(width, 1)
                                        return false if not width_with_end.known
                                        width <- width_with_end.value
                                    return false if width <= 0
                                    if width > PROOF_LINEAR_MAX_ENUMERATED_ELEMENTS:
                                        # The range is finite but larger than the instantiation
                                        # budget. That is a resource limit, not a verdict.
                                        exhausted <- true
                                        return false
                                    binder_names: mutable darray[sview] = [binder]
                                    binder_values: mutable darray[Ast::Expr] = []
                                    candidate: mutable i64 = lower.value
                                    offset: mutable i64 = 0
                                    while offset < width |offset, candidate, binder_values, binder_names, facts, body, annotations, operator_mask, kind, budget, exhausted|:
                                        if budget >= PROOF_LINEAR_MAX_ENUMERATED_ELEMENTS:
                                            exhausted <- true
                                            return false
                                        budget <- budget + 1
                                        binder_values.clear()
                                        binder_values.push(proof_signed_quantifier_instance(candidate))
                                        instance: Ast::Expr = proof_substitute(body, binder_names, binder_values)
                                        proven: bool = (proof_goal_depth(facts, instance, annotations, operator_mask, depth + 1, budget, split_depth, exhausted) can Global{Read,Write})
                                        return false if kind == "forall" and not proven
                                        return true if kind == "exists" and proven
                                        offset <- offset + 1
                                        if offset < width:
                                            next_candidate: (known: bool, value: i64) = proof_add_safe(candidate, 1)
                                            return false if not next_candidate.known
                                            candidate <- next_candidate.value
                                    return kind == "forall"
                                _:
                                    pass
                            # Finite literal collections are also safe to instantiate. Dynamic
                            # collections remain opaque: without a heap snapshot or a quantified
                            # collection invariant, iterating them here would silently assume
                            # that their contents are stable and fully represented by the AST.
                            match range_expression:
                                Ast::Expr.Array(elements, _):
                                    return false if:
                                        statements.count != 1
                                        elements.count > PROOF_LINEAR_MAX_ENUMERATED_ELEMENTS
                                        elements.count == 0 and kind == "exists"
                                    binder_names: mutable darray[sview] = [binder]
                                    binder_values: mutable darray[Ast::Expr] = []
                                    collection_offset: mutable usize = 0
                                    while collection_offset < elements.count |collection_offset, elements, binder_names, binder_values, facts, body, annotations, operator_mask, kind, budget, depth, exhausted|:
                                        if budget >= PROOF_LINEAR_MAX_ENUMERATED_ELEMENTS:
                                            exhausted <- true
                                            return false
                                        budget <- budget + 1
                                        binder_values.clear()
                                        binder_values.push(elements[collection_offset])
                                        instance: Ast::Expr = proof_substitute(body, binder_names, binder_values)
                                        proven: bool = (proof_goal_depth(facts, instance, annotations, operator_mask, depth + 1, budget, split_depth, exhausted) can Global{Read,Write})
                                        return false if kind == "forall" and not proven
                                        return true if kind == "exists" and proven
                                        collection_offset <- collection_offset + 1
                                    return kind == "forall"
                                Ast::Expr.Tuple(elements, _):
                                    return false if:
                                        statements.count != 1
                                        elements.count > PROOF_LINEAR_MAX_ENUMERATED_ELEMENTS
                                        elements.count == 0 and kind == "exists"
                                    binder_names: mutable darray[sview] = [binder]
                                    binder_values: mutable darray[Ast::Expr] = []
                                    collection_offset: mutable usize = 0
                                    while collection_offset < elements.count |collection_offset, elements, binder_names, binder_values, facts, body, annotations, operator_mask, kind, budget, depth, exhausted|:
                                        if budget >= PROOF_LINEAR_MAX_ENUMERATED_ELEMENTS:
                                            exhausted <- true
                                            return false
                                        budget <- budget + 1
                                        binder_values.clear()
                                        binder_values.push(elements[collection_offset])
                                        instance: Ast::Expr = proof_substitute(body, binder_names, binder_values)
                                        proven: bool = (proof_goal_depth(facts, instance, annotations, operator_mask, depth + 1, budget, split_depth, exhausted) can Global{Read,Write})
                                        return false if kind == "forall" and not proven
                                        return true if kind == "exists" and proven
                                        collection_offset <- collection_offset + 1
                                    return kind == "forall"
                                Ast::Expr.SetLit(elements, _):
                                    return false if:
                                        statements.count != 1
                                        elements.count > PROOF_LINEAR_MAX_ENUMERATED_ELEMENTS
                                        elements.count == 0 and kind == "exists"
                                    binder_names: mutable darray[sview] = [binder]
                                    binder_values: mutable darray[Ast::Expr] = []
                                    collection_offset: mutable usize = 0
                                    while collection_offset < elements.count |collection_offset, elements, binder_names, binder_values, facts, body, annotations, operator_mask, kind, budget, depth, exhausted|:
                                        if budget >= PROOF_LINEAR_MAX_ENUMERATED_ELEMENTS:
                                            exhausted <- true
                                            return false
                                        budget <- budget + 1
                                        binder_values.clear()
                                        binder_values.push(elements[collection_offset])
                                        instance: Ast::Expr = proof_substitute(body, binder_names, binder_values)
                                        proven: bool = (proof_goal_depth(facts, instance, annotations, operator_mask, depth + 1, budget, split_depth, exhausted) can Global{Read,Write})
                                        return false if kind == "forall" and not proven
                                        return true if kind == "exists" and proven
                                        collection_offset <- collection_offset + 1
                                    return kind == "forall"
                                Ast::Expr.DictLit(entries, _):
                                    return false if:
                                        statements.count != 2
                                        entries.count > PROOF_LINEAR_MAX_QUANTIFIER_ENTRIES
                                        entries.count == 0 and kind == "exists"
                                    match statements[1]:
                                        Ast::Stmt.VarDecl(value_binder, _, _, _):
                                            binder_names: mutable darray[sview] = [binder, value_binder]
                                            binder_values: mutable darray[Ast::Expr] = []
                                            dictionary_offset: mutable usize = 0
                                            while dictionary_offset < entries.count |dictionary_offset, entries, binder_names, binder_values, facts, body, annotations, operator_mask, kind, budget, depth, exhausted|:
                                                if budget >= PROOF_LINEAR_MAX_ENUMERATED_ELEMENTS:
                                                    exhausted <- true
                                                    return false
                                                budget <- budget + 1
                                                binder_values.clear()
                                                binder_values.push(entries[dictionary_offset].key)
                                                binder_values.push(entries[dictionary_offset].value)
                                                instance: Ast::Expr = proof_substitute(body, binder_names, binder_values)
                                                proven: bool = (proof_goal_depth(facts, instance, annotations, operator_mask, depth + 1, budget, split_depth, exhausted) can Global{Read,Write})
                                                return false if kind == "forall" and not proven
                                                return true if kind == "exists" and proven
                                                dictionary_offset <- dictionary_offset + 1
                                            return kind == "forall"
                                        _:
                                            return false
                                _:
                                    return false
                        _:
                            return false
                _:
                    return false

        # A cancellation rule handles only exact identities and x + 0 / x - 0. We deliberately
        # do not infer x + c OP x for c != 0 here: Elisa integers are fixed-width, so that
        # statement can fail at an endpoint because of overflow. The separate affine tier may
        # prove such a relation only when explicit bounds establish that both expressions are
        # safe; neither tier guesses about opaque calls.
