extend ElisaProof:
    public:
        def proof_unsigned_maximum_equality(facts: darray[Ast::Expr]&, goal: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&) -> bool:
            match proof_strip_parens(goal):
                Ast::Expr.Binary(left, TokenKind.EqEq, right, _):
                    base: Ast::Expr = left if proof_ident_name(left) != "" else right
                    cap: Ast::Expr = right if proof_ident_name(left) != "" else left
                    return false if proof_ident_name(base) == "" or not proof_primitive_comparison(left, right, facts)
                    width: i64 = proof_peer_unsigned_width(base, facts)
                    return false if width != 8 and width != 16 and width != 32 and width != 64
                    match cap:
                        Ast::Expr.IntLit(value, position):
                            literal = proof_replay_numeric_literal_sort(annotations, position.line, position.column, value)
                            maximum: u64 = 255 if width == 8 else 65535 if width == 16 else 4294967295 if width == 32 else 18446744073709551615u64
                            return false if not literal.known or not literal.unsigned or literal.width != width or literal.bits != maximum
                        _:
                            return false
                    for fact in facts |fact, base, cap, facts, width, annotations|:
                        order = proof_readable_order(fact, facts)
                        continue if not order.known
                        fact_cap: Ast::Expr = order.right if order.operator == TokenKind.GtEq else order.left
                        match fact_cap:
                            Ast::Expr.IntLit(value, position):
                                literal = proof_replay_numeric_literal_sort(annotations, position.line, position.column, value)
                                continue if not literal.known or not literal.unsigned or literal.width != width
                            _:
                                continue
                        return true if order.operator == TokenKind.GtEq and proof_expr_equal(order.left, base) and proof_expr_equal(order.right, cap)
                        return true if order.operator == TokenKind.LtEq and proof_expr_equal(order.right, base) and proof_expr_equal(order.left, cap)
                    return false
                _:
                    return false
