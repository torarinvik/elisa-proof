# Budgeted closed signed-i64 comparison fallback used by the goal search.
extend ElisaProof:
    private:
        def proof_signed_i64_marker_decode_charge_with_work(fact: Ast::Expr, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            nodes: mutable usize = 0
            return false if not proof_linear_safety_expression_shape_with_work(fact, 0, &nodes, budget, exhausted)
            # The marker readers below are legacy pure parsers. Reserve a bound for their
            # repeated constant and place walks after the full marker shape has been charged.
            return proof_linear_safety_work_charge_scaled(budget, exhausted, nodes, 8)

        def proof_signed_i64_only_context_with_work(facts: darray[Ast::Expr]&, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, only: bool):
            can Abort.Panic:
                has_i64_type: mutable bool = false
                for fact in facts |fact, has_i64_type, budget, exhausted|:
                    return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                    callee: sview = proof_marker_callee_name(fact)
                    return (false, false) if:
                        not proof_linear_safety_work_charge(budget, exhausted, 5)
                        not proof_linear_safety_work_charge_scaled(budget, exhausted, sview_len(callee), 5)
                    match callee:
                        "__elisa_signed_type_bound":
                            return (false, false) if not proof_signed_i64_marker_decode_charge_with_work(fact, budget, exhausted)
                            signed = proof_signed_marker_info(fact)
                            return (true, false) if signed.known and signed.width != ElisaProofKernelCore::PROOF_KERNEL_I64_WIDTH
                            has_i64_type <- true if signed.known
                        "__elisa_signed_place_type_bound":
                            return (false, false) if not proof_signed_i64_marker_decode_charge_with_work(fact, budget, exhausted)
                            match fact:
                                Ast::Expr.Call(_, arguments, argument_names, _):
                                    return (false, false) if arguments.count != 2 or (argument_names.count != 0 and argument_names.count != arguments.count)
                                    width: (known: bool, value: i64) = proof_constant_int_with_work(arguments[1], 0, budget, exhausted)
                                    return (false, false) if proof_goal_bool_ref_value(exhausted) or not width.known or not ElisaProofKernelCore::proof_kernel_signed_width_valid(width.value)
                                    return (true, false) if width.value != ElisaProofKernelCore::PROOF_KERNEL_I64_WIDTH
                                    has_i64_type <- true
                                _:
                                    return (false, false)
                        "__elisa_unsigned_type_bound":
                            return (false, false) if not proof_signed_i64_marker_decode_charge_with_work(fact, budget, exhausted)
                            unsigned = proof_unsigned_marker_info(fact)
                            return (true, false) if unsigned.known
                            place = proof_unsigned_place_marker_info(fact)
                            return (true, false) if place.known
                        "__elisa_unsigned_place_type_bound":
                            return (false, false) if not proof_signed_i64_marker_decode_charge_with_work(fact, budget, exhausted)
                            return (true, false)
                        "__elisa_primitive_scalar_element":
                            return (false, false) if not proof_signed_i64_marker_decode_charge_with_work(fact, budget, exhausted)
                            element = proof_element_marker_info(fact)
                            return (true, false) if element.known and element.width > 0
                        "__elisa_untrusted_operator_type":
                            return (false, false) if not proof_signed_i64_marker_decode_charge_with_work(fact, budget, exhausted)
                            untrusted = proof_untrusted_operator_marker_info(fact)
                            return (true, false) if untrusted.known
                        _:
                            pass
                return (true, has_i64_type)

        def proof_closed_signed_i64_comparison_with_work(goal: Ast::Expr, facts: darray[Ast::Expr]&, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, proven: bool):
            can Abort.Panic:
                return (false, false) if proof_goal_bool_ref_value(exhausted)
                match goal:
                    Ast::Expr.Binary(left, operator, right, _):
                        return (true, false) if not proof_is_comparison(operator)
                        a: (known: bool, value: i64) = proof_constant_int_with_work(left, 0, budget, exhausted)
                        return (false, false) if proof_goal_bool_ref_value(exhausted)
                        b: (known: bool, value: i64) = proof_constant_int_with_work(right, 0, budget, exhausted)
                        return (false, false) if proof_goal_bool_ref_value(exhausted)
                        return (true, false) if not a.known or not b.known
                        ambiguous: bool = proof_goal_has_ambiguous_integer_constant_with_work(goal, 0, budget, exhausted)
                        return (false, false) if proof_goal_bool_ref_value(exhausted)
                        return (true, false) if ambiguous
                        context: (complete: bool, only: bool) = proof_signed_i64_only_context_with_work(facts, budget, exhausted)
                        return (false, false) if not context.complete or proof_goal_bool_ref_value(exhausted)
                        return (true, false) if not context.only
                        return (true, a.value == b.value) if operator == TokenKind.EqEq
                        return (true, a.value != b.value) if operator == TokenKind.BangEq
                        return (true, a.value < b.value) if operator == TokenKind.Lt
                        return (true, a.value > b.value) if operator == TokenKind.Gt
                        return (true, a.value <= b.value) if operator == TokenKind.LtEq
                        return (true, a.value >= b.value) if operator == TokenKind.GtEq
                        return (true, false)
                    _:
                        return (true, false)
