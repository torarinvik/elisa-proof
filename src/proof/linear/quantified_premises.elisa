extend ElisaProof:
    private:
        # A search hint only: an index literal is not evidence of a predicate.
        # Exact range checking, substitution and ordinary proof search follow.
        def proof_finite_predicate_goal_candidate(goal: Ast::Expr, depth: usize) -> (known: bool, value: i64):
            return (false, 0) if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            match goal:
                Ast::Expr.Paren(inner, _) | Ast::Expr.Unary(_, inner, _):
                    return proof_finite_predicate_goal_candidate(inner, depth + 1)
                Ast::Expr.Binary(left, TokenKind.Or, right, _):
                    candidate = proof_finite_predicate_goal_candidate(right, depth + 1)
                    return candidate if candidate.known
                    return proof_finite_predicate_goal_candidate(left, depth + 1)
                Ast::Expr.Call(_, arguments, _, _):
                    for argument in arguments |depth|:
                        candidate = proof_finite_predicate_goal_candidate(argument, depth + 1)
                        return candidate if candidate.known
                    return (false, 0)
                Ast::Expr.Index(_, index, _):
                    candidate = proof_constant_int(index)
                    return candidate if candidate.known
                    match proof_strip_parens(index):
                        Ast::Expr.Binary(_, TokenKind.Plus, offset, _):
                            return proof_constant_int(offset)
                        _:
                            return (false, 0)
                _:
                    return (false, 0)

        # Replace a finite universal premise by all its checked instances.
        # Constant bounds avoid interpreting machine arithmetic in path facts.
        def proof_finite_universal_premise_goal(facts: darray[Ast::Expr]&, goal: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, operator_mask: usize, depth: usize, budget: mutable usize&, split_depth: usize, exhausted: mutable bool&) -> bool:
            return false if depth >= PROOF_LINEAR_CASE_SPLIT_DEPTH_LIMIT
            for fact_index in 0..<facts.count |facts, goal, annotations, operator_mask, depth, budget, split_depth, exhausted|:
                continue if proof_quantifier_kind(facts[fact_index], annotations) != "forall"
                quantifier: Ast::Expr = proof_strip_parens(facts[fact_index])
                continue if not proof_kernel_expression_supported(quantifier)
                match quantifier:
                    Ast::Expr.Block(statements, body, _, _):
                        # Logical-call purity is checked when the contract or
                        # invariant enters the context. Instantiation preserves
                        # the exact call; it grants neither its truth nor an
                        # equation between different invocations. The kernel
                        # independently substitutes the same finite premise.
                        continue if statements.count != 1 or proof_expr_has_move(body)
                        match statements[0]:
                            Ast::Stmt.VarDecl(binder, _, range_expression, _):
                                continue if binder == ""
                                match range_expression:
                                    Ast::Expr.Binary(lower_expression, range_operator, upper_expression, _):
                                        continue if range_operator != TokenKind.RangeLt and range_operator != TokenKind.RangeLe
                                        lower: (known: bool, value: i64) = proof_constant_int(lower_expression)
                                        upper: (known: bool, value: i64) = proof_constant_int(upper_expression)
                                        continue if not lower.known or not upper.known
                                        width: mutable (known: bool, value: i64) = proof_sub_safe(upper.value, lower.value)
                                        continue if not width.known
                                        width <- proof_add_safe(width.value, 1) if range_operator == TokenKind.RangeLe
                                        # Keep automatic premise expansion small and bounded.
                                        continue if not width.known or width.value <= 0 or width.value > 64
                                        reduced: mutable darray[Ast::Expr] = []
                                        for index in 0..<facts.count |facts, fact_index, reduced|:
                                            reduced.push(facts[index]) if index != fact_index
                                        names: mutable darray[sview] = [binder]
                                        values: mutable darray[Ast::Expr] = []
                                        hint = proof_finite_predicate_goal_candidate(goal, 0)
                                        hint_offset = proof_sub_safe(hint.value, lower.value)
                                        if hint.known and hint_offset.known and hint_offset.value >= 0 and hint_offset.value < width.value and budget < PROOF_LINEAR_MAX_ENUMERATED_ELEMENTS:
                                            budget <- budget + 1
                                            values.push(proof_signed_quantifier_instance(hint.value))
                                            selected: Ast::Expr = proof_substitute(body, names, values)
                                            if not proof_expr_is_invalid(selected):
                                                reduced.push(selected)
                                                return true if (proof_goal_depth(&reduced, goal, annotations, operator_mask, depth + 1, budget, split_depth, exhausted) can Global{Read,Write})
                                                reduced.pop()
                                            values.clear()
                                        candidate: mutable i64 = lower.value
                                        offset: mutable i64 = 0
                                        while offset < width.value |offset, candidate, body, names, values, reduced, budget, exhausted|:
                                            if budget >= PROOF_LINEAR_MAX_ENUMERATED_ELEMENTS:
                                                exhausted <- true
                                                return false
                                            budget <- budget + 1
                                            values.clear()
                                            values.push(proof_signed_quantifier_instance(candidate))
                                            instance: Ast::Expr = proof_substitute(body, names, values)
                                            return false if proof_expr_is_invalid(instance)
                                            reduced.push(instance)
                                            offset <- offset + 1
                                            if offset < width.value:
                                                next: (known: bool, value: i64) = proof_add_safe(candidate, 1)
                                                return false if not next.known
                                                candidate <- next.value
                                        return true if (proof_goal_depth(&reduced, goal, annotations, operator_mask, depth + 1, budget, split_depth, exhausted) can Global{Read,Write})
                                    _:
                                        pass
                            _:
                                pass
                    _:
                        pass
            return false
