extend ElisaProof:
    public:
        # Diagnostic only, never an admission path: after a goal is refused, name the first
        # guard in `proof_goal_depth`'s order that can be identified after refusal, so a census
        # or an agent can see why without instrumenting the search. This is a post-hoc diagnostic,
        # not a trace of the actual search path. If no rejecting guard can be identified, report
        # "unknown" instead of guessing that a particular rule was the first refusal.
        def proof_refusal_gate(facts: darray[Ast::Expr]&, goal: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, exhausted: bool) -> sview:
            return "budget" if exhausted
            return "literal-width" if not proof_state_literals_fit(facts, goal, annotations)
            return "ambiguous-constant-goal" if proof_quantifier_kind(goal, annotations) == "" and proof_has_ambiguous_integer_constant_in(goal, facts, 0)
            budget: mutable usize = 0
            safety_exhausted: mutable bool = false
            facts_bounds: mutable darray[ProofBound] = []
            signed_facts_bounds: mutable darray[ProofBound] = []
            kept_safe_facts: mutable darray[Ast::Expr] = []
            facts_safe: bool = proof_unsigned_safe_facts_with_context_work(facts, &kept_safe_facts, &facts_bounds, &signed_facts_bounds, &budget, &safety_exhausted)
            return "unknown" if safety_exhausted
            return "wrap-guard-fact" if not facts_safe
            goal_safe: bool = proof_unsigned_expression_safe_with_context_work(goal, facts, &facts_bounds, &signed_facts_bounds, &budget, &safety_exhausted)
            return "unknown" if safety_exhausted
            return "wrap-guard-goal" if not goal_safe
            return "quantifier" if proof_quantifier_kind(goal, annotations) != ""
            operator_mask: usize = proof_source_primitive_operator_mask(annotations)
            return "overloaded-operator" if not proof_source_arithmetic_operator_guard(goal, facts, operator_mask)
            match goal:
                Ast::Expr.Binary(_, operator, _, _):
                    return "unknown" if proof_is_comparison(operator)
                    return "connective" if operator == TokenKind.And or operator == TokenKind.Or or operator == TokenKind.FatArrow
                    return "non-comparison-goal"
                Ast::Expr.Call(_, _, _, _):
                    return "opaque-call-goal"
                _:
                    return "non-comparison-goal"
