# Work-metered product-sign closure for the linear goal dispatcher.
extend ElisaProof:
    private:
        def proof_product_sign_zero_with_work(expression: Ast::Expr, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, zero: bool):
            stripped: (complete: bool, expression: Ast::Expr) = proof_linear_strip_parens_with_work(expression, budget, exhausted)
            return (false, false) if not stripped.complete or exhausted
            match stripped.expression:
                Ast::Expr.IntLit(value, _):
                    return (true, value == 0)
                _:
                    return (true, false)

        def proof_product_sign_fact_with_work(term: Ast::Expr, relation: TokenKind, facts: darray[Ast::Expr]&, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, matches: bool):
            mirrored: TokenKind = proof_product_sign_mirror(relation)
            for fact in facts |fact, term, relation, mirrored, budget, exhausted|:
                cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(fact, budget, exhausted)
                return (false, false) if not cost.complete
                match fact:
                    Ast::Expr.Binary(fact_left, fact_operator, fact_right, _):
                        if fact_operator == relation:
                            zero: (complete: bool, zero: bool) = proof_product_sign_zero_with_work(fact_right, budget, exhausted)
                            return (false, false) if not zero.complete
                            if zero.zero:
                                equal: bool = proof_unsigned_witness_terms_equal_with_work(fact_left, term, budget, exhausted)
                                return (false, false) if exhausted
                                return (true, true) if equal
                        if fact_operator == mirrored:
                            zero: (complete: bool, zero: bool) = proof_product_sign_zero_with_work(fact_left, budget, exhausted)
                            return (false, false) if not zero.complete
                            if zero.zero:
                                equal: bool = proof_unsigned_witness_terms_equal_with_work(fact_right, term, budget, exhausted)
                                return (false, false) if exhausted
                                return (true, true) if equal
                    _:
                        pass
            return (not exhausted, false)

        def proof_product_sign_goal_with_work(left: Ast::Expr, operator: TokenKind, right: Ast::Expr, facts: darray[Ast::Expr]&, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, proven: bool):
            left_view: (complete: bool, expression: Ast::Expr) = proof_linear_strip_parens_with_work(left, budget, exhausted)
            return (false, false) if not left_view.complete or exhausted
            right_view: (complete: bool, expression: Ast::Expr) = proof_linear_strip_parens_with_work(right, budget, exhausted)
            return (false, false) if not right_view.complete or exhausted
            product_left: mutable Ast::Expr = Ast::Expr.Invalid
            product_right: mutable Ast::Expr = Ast::Expr.Invalid
            relation: mutable TokenKind = operator
            match left_view.expression:
                Ast::Expr.Binary(first, TokenKind.Star, second, _):
                    product_left <- first
                    product_right <- second
                    zero: (complete: bool, zero: bool) = proof_product_sign_zero_with_work(right_view.expression, budget, exhausted)
                    return (false, false) if not zero.complete
                    return (true, false) if not zero.zero
                _:
                    match right_view.expression:
                        Ast::Expr.Binary(first, TokenKind.Star, second, _):
                            product_left <- first
                            product_right <- second
                            relation <- proof_product_sign_mirror(operator)
                            zero: (complete: bool, zero: bool) = proof_product_sign_zero_with_work(left_view.expression, budget, exhausted)
                            return (false, false) if not zero.complete
                            return (true, false) if not zero.zero
                        _:
                            return (true, false)
            markers_result: (complete: bool, witnesses: ProofScalarWitnesses) = proof_scalar_witness_markers_with_work(facts, true, budget, exhausted)
            return (false, false) if not markers_result.complete or exhausted
            markers: mutable ProofScalarWitnesses = markers_result.witnesses
            marker_scale: (complete: bool, scale: usize) = proof_linear_safety_marker_scale_with_work(markers, budget, exhausted)
            return (false, false) if not marker_scale.complete
            first_scalar: (complete: bool, matches: bool) = proof_linear_safety_scalar_witness_with_work(product_left, markers, marker_scale.scale, budget, exhausted)
            return (false, false) if not first_scalar.complete
            second_scalar: (complete: bool, matches: bool) = proof_linear_safety_scalar_witness_with_work(product_right, markers, marker_scale.scale, budget, exhausted)
            return (false, false) if not second_scalar.complete
            return (true, false) if not first_scalar.matches or not second_scalar.matches
            if relation == TokenKind.GtEq:
                first: (complete: bool, matches: bool) = proof_product_sign_fact_with_work(product_left, TokenKind.GtEq, facts, budget, exhausted)
                return (false, false) if not first.complete
                second: (complete: bool, matches: bool) = proof_product_sign_fact_with_work(product_right, TokenKind.GtEq, facts, budget, exhausted) if first.matches else (true, false)
                return (false, false) if not second.complete
                return (true, true) if first.matches and second.matches
                first_negative: (complete: bool, matches: bool) = proof_product_sign_fact_with_work(product_left, TokenKind.LtEq, facts, budget, exhausted)
                return (false, false) if not first_negative.complete
                second_negative: (complete: bool, matches: bool) = proof_product_sign_fact_with_work(product_right, TokenKind.LtEq, facts, budget, exhausted) if first_negative.matches else (true, false)
                return (false, false) if not second_negative.complete
                return (true, first_negative.matches and second_negative.matches)
            if relation == TokenKind.LtEq:
                first: (complete: bool, matches: bool) = proof_product_sign_fact_with_work(product_left, TokenKind.GtEq, facts, budget, exhausted)
                return (false, false) if not first.complete
                second: (complete: bool, matches: bool) = proof_product_sign_fact_with_work(product_right, TokenKind.LtEq, facts, budget, exhausted) if first.matches else (true, false)
                return (false, false) if not second.complete
                return (true, true) if first.matches and second.matches
                first_negative: (complete: bool, matches: bool) = proof_product_sign_fact_with_work(product_left, TokenKind.LtEq, facts, budget, exhausted)
                return (false, false) if not first_negative.complete
                second_positive: (complete: bool, matches: bool) = proof_product_sign_fact_with_work(product_right, TokenKind.GtEq, facts, budget, exhausted) if first_negative.matches else (true, false)
                return (false, false) if not second_positive.complete
                return (true, first_negative.matches and second_positive.matches)
            if relation == TokenKind.Gt:
                first: (complete: bool, matches: bool) = proof_product_sign_fact_with_work(product_left, TokenKind.Gt, facts, budget, exhausted)
                return (false, false) if not first.complete
                second: (complete: bool, matches: bool) = proof_product_sign_fact_with_work(product_right, TokenKind.Gt, facts, budget, exhausted) if first.matches else (true, false)
                return (false, false) if not second.complete
                return (true, true) if first.matches and second.matches
                first_negative: (complete: bool, matches: bool) = proof_product_sign_fact_with_work(product_left, TokenKind.Lt, facts, budget, exhausted)
                return (false, false) if not first_negative.complete
                second_negative: (complete: bool, matches: bool) = proof_product_sign_fact_with_work(product_right, TokenKind.Lt, facts, budget, exhausted) if first_negative.matches else (true, false)
                return (false, false) if not second_negative.complete
                return (true, first_negative.matches and second_negative.matches)
            if relation == TokenKind.Lt:
                first: (complete: bool, matches: bool) = proof_product_sign_fact_with_work(product_left, TokenKind.Gt, facts, budget, exhausted)
                return (false, false) if not first.complete
                second: (complete: bool, matches: bool) = proof_product_sign_fact_with_work(product_right, TokenKind.Lt, facts, budget, exhausted) if first.matches else (true, false)
                return (false, false) if not second.complete
                return (true, true) if first.matches and second.matches
                first_negative: (complete: bool, matches: bool) = proof_product_sign_fact_with_work(product_left, TokenKind.Lt, facts, budget, exhausted)
                return (false, false) if not first_negative.complete
                second_positive: (complete: bool, matches: bool) = proof_product_sign_fact_with_work(product_right, TokenKind.Gt, facts, budget, exhausted) if first_negative.matches else (true, false)
                return (false, false) if not second_positive.complete
                return (true, first_negative.matches and second_positive.matches)
            return (true, false)

        def proof_unsigned_term_is_unsigned_with_work(expression: Ast::Expr, markers: ProofScalarWitnesses&, depth: usize, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, unsigned: bool):
            return (true, false) if depth >= ElisaProofKernelCore::PROOF_KERNEL_STRUCTURAL_SCAN_DEPTH_LIMIT
            width: i64 = proof_unsigned_width_in_expression_with_work(expression, markers, budget, exhausted)
            return (false, false) if exhausted
            return (true, true) if width != 0
            stripped: (complete: bool, expression: Ast::Expr) = proof_linear_strip_parens_with_work(expression, budget, exhausted)
            return (false, false) if not stripped.complete or exhausted
            match stripped.expression:
                Ast::Expr.Binary(left, operator, right, _):
                    arithmetic: bool = operator == TokenKind.Plus or operator == TokenKind.Minus or operator == TokenKind.Star or operator == TokenKind.Slash or operator == TokenKind.Percent or operator == TokenKind.LShift or operator == TokenKind.RShift
                    return (true, false) if not arithmetic
                    first: (complete: bool, unsigned: bool) = proof_unsigned_term_is_unsigned_with_work(left, markers, depth + 1, budget, exhausted)
                    return (false, false) if not first.complete
                    return (true, true) if first.unsigned
                    return proof_unsigned_term_is_unsigned_with_work(right, markers, depth + 1, budget, exhausted)
                _:
                    place_width: i64 = proof_unsigned_place_marker_width_with_work(stripped.expression, markers, budget, exhausted)
                    return (false, false) if exhausted
                    return (true, place_width != 0)

        def proof_unsigned_nonnegative_goal_with_work(left: Ast::Expr, operator: TokenKind, right: Ast::Expr, facts: darray[Ast::Expr]&, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, proven: bool):
            zero_left: (known: bool, value: i64) = proof_constant_int_with_work(left, 0, budget, exhausted)
            return (false, false) if exhausted
            zero_right: (known: bool, value: i64) = proof_constant_int_with_work(right, 0, budget, exhausted)
            return (false, false) if exhausted
            term: mutable Ast::Expr = Ast::Expr.Invalid
            if zero_left.known and zero_left.value == 0 and (operator == TokenKind.LtEq or operator == TokenKind.Lt):
                term <- right
            elif zero_right.known and zero_right.value == 0 and (operator == TokenKind.GtEq or operator == TokenKind.Gt):
                term <- left
            else:
                return (true, false)
            return (true, false) if operator == TokenKind.Lt or operator == TokenKind.Gt
            markers_result: (complete: bool, witnesses: ProofScalarWitnesses) = proof_scalar_witness_markers_with_work(facts, false, budget, exhausted)
            return (false, false) if not markers_result.complete or exhausted
            markers: ProofScalarWitnesses = markers_result.witnesses
            unsigned: (complete: bool, unsigned: bool) = proof_unsigned_term_is_unsigned_with_work(term, markers, 0, budget, exhausted)
            return (unsigned.complete, unsigned.unsigned)
