# Linear certificates (BACKLOG C-02/C-03). A comparison goal over at most six integer names that
# no cheaper tier closes is searched by Fourier-Motzkin elimination over the comparison facts
# that mention its names. A refutation of the negated goal is emitted as one traced fact,
#
#     __elisa_linear_certificate(m_goal, premise_1, m_1, ..., premise_k, m_k)
#
# which names each premise structurally beside its multiplier. The checker below -- and its
# kernel mirror -- never trusts the certificate: every premise must be a fact, every inequality
# multiplier non-negative, and the weighted sum of the constraints `e <= 0` must cancel every
# name and leave a positive constant, `0 < c <= 0`. A forged or stale certificate only fails.
const module ProofLinearCertificateLimit:
    ATOMS: usize = 6
    PREMISES: usize = 15
    ROWS: usize = 96
    MULTIPLIER: i64 = 1048576

extend ElisaProof:
    public:
        def proof_linear_certificate_marker(expression: Ast::Expr) -> bool:
            return proof_marker_has_callee(expression, "__elisa_linear_certificate")

        def proof_linear_sum_term(name: sview, coefficient: i64, names: mutable darray[sview]&, coefficients: mutable darray[i64]&) -> bool:
            index: mutable usize = 0
            while index < names.count |index, names, name|:
                break if names[index] == name
                index <- index + 1
            if index == names.count:
                names.push(name)
                coefficients.push(0)
            return false if index >= coefficients.count
            sum: (known: bool, value: i64) = proof_add_safe(coefficients[index], coefficient)
            return false if not sum.known
            coefficients[index] <- sum.value
            return true

        # Add `multiplier * (left - right + offset)` to the sum.
        def proof_linear_sum_add(left: Ast::Expr, right: Ast::Expr, offset: i64, multiplier: i64, facts: darray[Ast::Expr]&, names: mutable darray[sview]&, coefficients: mutable darray[i64]&, constant: mutable i64&) -> bool:
            terms: mutable darray[ProofNormalTerm] = []
            signed: bool = proof_normal_comparison_signed(left, right, facts)
            return false if:
                not proof_collect_normal_terms(left, 1, signed, facts, &terms, 0)
                not proof_collect_normal_terms(right, -1, signed, facts, &terms, 0)
            terms.push(ProofNormalTerm{name: "", coefficient: offset})
            for term in terms |term, multiplier, names, coefficients, constant|:
                product: (known: bool, value: i64) = proof_mul_safe(term.coefficient, multiplier)
                return false if not product.known
                if term.name == "":
                    sum: (known: bool, value: i64) = proof_add_safe(constant, product.value)
                    return false if not sum.known
                    constant <- sum.value
                else:
                    return false if not proof_linear_sum_term(term.name, product.value, names, coefficients)
            return true

        # Producer variant: reuse the witness index built once for the whole search instead of
        # rebuilding it from the full fact list for every candidate constraint.
        def proof_linear_sum_add_with_witnesses(left: Ast::Expr, right: Ast::Expr, offset: i64, multiplier: i64, facts: darray[Ast::Expr]&, markers: ProofScalarWitnesses&, names: mutable darray[sview]&, coefficients: mutable darray[i64]&, constant: mutable i64&) -> bool:
            terms: mutable darray[ProofNormalTerm] = []
            signed_result: (complete: bool, signed: bool) = proof_normal_comparison_signed_with_witnesses(left, right, markers)
            return false if:
                not signed_result.complete
                not proof_collect_normal_terms_with_witnesses(left, 1, signed_result.signed, markers, &terms, 0)
                not proof_collect_normal_terms_with_witnesses(right, -1, signed_result.signed, markers, &terms, 0)
            terms.push(ProofNormalTerm{name: "", coefficient: offset})
            for term in terms |term, multiplier, names, coefficients, constant|:
                product: (known: bool, value: i64) = proof_mul_safe(term.coefficient, multiplier)
                return false if not product.known
                if term.name == "":
                    sum: (known: bool, value: i64) = proof_add_safe(constant, product.value)
                    return false if not sum.known
                    constant <- sum.value
                else:
                    return false if not proof_linear_sum_term(term.name, product.value, names, coefficients)
            return true

        # Producer-only metered form. The verifier above keeps its independent canonical
        # checker; search debits every indexed width lookup and AST visit to its shared meter.
        def proof_linear_sum_add_with_search_work(left: Ast::Expr, right: Ast::Expr, offset: i64, multiplier: i64, facts: darray[Ast::Expr]&, markers: ProofScalarWitnesses&, names: mutable darray[sview]&, coefficients: mutable darray[i64]&, constant: mutable i64&, work: mutable usize&, work_limit: usize, metered: bool) -> bool:
            terms: mutable darray[ProofNormalTerm] = []
            signed_result: (complete: bool, signed: bool) = proof_normal_comparison_signed_with_witnesses_work(left, right, facts, markers, &work, work_limit, metered)
            return false if not signed_result.complete
            return false if:
                not proof_collect_normal_terms_with_witnesses_work(left, 1, signed_result.signed, facts, markers, &terms, 0, &work, work_limit, metered)
                not proof_collect_normal_terms_with_witnesses_work(right, -1, signed_result.signed, facts, markers, &terms, 0, &work, work_limit, metered)
            terms.push(ProofNormalTerm{name: "", coefficient: offset})
            for term in terms |term, multiplier, names, coefficients, constant, work, work_limit, metered|:
                return false if metered and not proof_linear_search_width_debit(&work, work_limit, 1)
                product: (known: bool, value: i64) = proof_mul_safe(term.coefficient, multiplier)
                return false if not product.known
                if term.name == "":
                    sum: (known: bool, value: i64) = proof_add_safe(constant, product.value)
                    return false if not sum.known
                    constant <- sum.value
                else:
                    return false if not proof_linear_sum_term_with_search_work(term.name, product.value, names, coefficients, &work, work_limit, metered)
            return true

        def proof_linear_sum_term_with_search_work(name: sview, coefficient: i64, names: mutable darray[sview]&, coefficients: mutable darray[i64]&, work: mutable usize&, work_limit: usize, metered: bool) -> bool:
            index: mutable usize = 0
            while index < names.count |index, names, name, work, work_limit, metered|:
                if metered and not proof_linear_search_width_debit(&work, work_limit, 1 + sview_len(names[index]) + sview_len(name)):
                    return false
                break if names[index] == name
                index <- index + 1
            if index == names.count:
                names.push(name)
                coefficients.push(0)
            return false if index >= coefficients.count
            sum: (known: bool, value: i64) = proof_add_safe(coefficients[index], coefficient)
            return false if not sum.known
            coefficients[index] <- sum.value
            return true

        # Add `multiplier` times the constraint `e <= 0` that `fact` states, or that its negation
        # states when `negate`. Integers make a strict `<` the same as `<=` with one added.
        def proof_linear_constraint_add(fact: Ast::Expr, multiplier: i64, negate: bool, facts: darray[Ast::Expr]&, names: mutable darray[sview]&, coefficients: mutable darray[i64]&, constant: mutable i64&) -> bool:
            match fact:
                Ast::Expr.Paren(inner, _):
                    return proof_linear_constraint_add(inner, multiplier, negate, facts, names, coefficients, constant)
                Ast::Expr.Binary(left, operator, right, _):
                    return false if not proof_primitive_comparison(left, right, facts)
                    relation: mutable TokenKind = operator
                    if negate:
                        return false if operator == TokenKind.EqEq
                        relation <- TokenKind.Gt if operator == TokenKind.LtEq
                        relation <- TokenKind.GtEq if operator == TokenKind.Lt
                        relation <- TokenKind.Lt if operator == TokenKind.GtEq
                        relation <- TokenKind.LtEq if operator == TokenKind.Gt
                    return false if multiplier < 0 and relation != TokenKind.EqEq
                    return proof_linear_sum_add(left, right, 0, multiplier, facts, names, coefficients, constant) if relation == TokenKind.LtEq or relation == TokenKind.EqEq
                    return proof_linear_sum_add(left, right, 1, multiplier, facts, names, coefficients, constant) if relation == TokenKind.Lt
                    return proof_linear_sum_add(right, left, 0, multiplier, facts, names, coefficients, constant) if relation == TokenKind.GtEq
                    return proof_linear_sum_add(right, left, 1, multiplier, facts, names, coefficients, constant) if relation == TokenKind.Gt
                    return false
                _:
                    # An unsigned width marker states `0 <= x`, the constraint `-x <= 0`.
                    return false if negate or multiplier < 0
                    marker: (known: bool, name: sview, width: i64) = proof_unsigned_marker_info(fact)
                    return false if not marker.known
                    return proof_linear_sum_term(marker.name, 0 - multiplier, names, coefficients)

        def proof_linear_constraint_add_with_witnesses(fact: Ast::Expr, multiplier: i64, negate: bool, facts: darray[Ast::Expr]&, markers: ProofScalarWitnesses&, names: mutable darray[sview]&, coefficients: mutable darray[i64]&, constant: mutable i64&) -> bool:
            match fact:
                Ast::Expr.Paren(inner, _):
                    return proof_linear_constraint_add_with_witnesses(inner, multiplier, negate, facts, markers, names, coefficients, constant)
                Ast::Expr.Binary(left, operator, right, _):
                    return false if not proof_primitive_comparison_marked(left, right, markers)
                    relation: mutable TokenKind = operator
                    if negate:
                        return false if operator == TokenKind.EqEq
                        relation <- TokenKind.Gt if operator == TokenKind.LtEq
                        relation <- TokenKind.GtEq if operator == TokenKind.Lt
                        relation <- TokenKind.Lt if operator == TokenKind.GtEq
                        relation <- TokenKind.LtEq if operator == TokenKind.Gt
                    return false if multiplier < 0 and relation != TokenKind.EqEq
                    return proof_linear_sum_add_with_witnesses(left, right, 0, multiplier, facts, markers, names, coefficients, constant) if relation == TokenKind.LtEq or relation == TokenKind.EqEq
                    return proof_linear_sum_add_with_witnesses(left, right, 1, multiplier, facts, markers, names, coefficients, constant) if relation == TokenKind.Lt
                    return proof_linear_sum_add_with_witnesses(right, left, 0, multiplier, facts, markers, names, coefficients, constant) if relation == TokenKind.GtEq
                    return proof_linear_sum_add_with_witnesses(right, left, 1, multiplier, facts, markers, names, coefficients, constant) if relation == TokenKind.Gt
                    return false
                _:
                    return false if negate or multiplier < 0
                    marker: (known: bool, name: sview, width: i64) = proof_unsigned_marker_info(fact)
                    return false if not marker.known
                    return proof_linear_sum_term(marker.name, 0 - multiplier, names, coefficients)

        def proof_linear_constraint_add_with_search_work(fact: Ast::Expr, multiplier: i64, negate: bool, facts: darray[Ast::Expr]&, markers: ProofScalarWitnesses&, names: mutable darray[sview]&, coefficients: mutable darray[i64]&, constant: mutable i64&, work: mutable usize&, work_limit: usize, metered: bool) -> bool:
            return false if metered and not proof_linear_search_width_debit(&work, work_limit, 1)
            match fact:
                Ast::Expr.Paren(inner, _):
                    return proof_linear_constraint_add_with_search_work(inner, multiplier, negate, facts, markers, names, coefficients, constant, &work, work_limit, metered)
                Ast::Expr.Binary(left, operator, right, _):
                    primitive: (complete: bool, primitive: bool) = proof_linear_search_primitive_comparison(left, right, markers, &work, work_limit, metered)
                    return false if not primitive.complete or not primitive.primitive
                    relation: mutable TokenKind = operator
                    if negate:
                        return false if operator == TokenKind.EqEq
                        relation <- TokenKind.Gt if operator == TokenKind.LtEq
                        relation <- TokenKind.GtEq if operator == TokenKind.Lt
                        relation <- TokenKind.Lt if operator == TokenKind.GtEq
                        relation <- TokenKind.LtEq if operator == TokenKind.Gt
                    return false if multiplier < 0 and relation != TokenKind.EqEq
                    return proof_linear_sum_add_with_search_work(left, right, 0, multiplier, facts, markers, names, coefficients, constant, &work, work_limit, metered) if relation == TokenKind.LtEq or relation == TokenKind.EqEq
                    return proof_linear_sum_add_with_search_work(left, right, 1, multiplier, facts, markers, names, coefficients, constant, &work, work_limit, metered) if relation == TokenKind.Lt
                    return proof_linear_sum_add_with_search_work(right, left, 0, multiplier, facts, markers, names, coefficients, constant, &work, work_limit, metered) if relation == TokenKind.GtEq
                    return proof_linear_sum_add_with_search_work(right, left, 1, multiplier, facts, markers, names, coefficients, constant, &work, work_limit, metered) if relation == TokenKind.Gt
                    return false
                _:
                    return false if negate or multiplier < 0
                    return false if metered and not proof_linear_search_marker_parse_charge(fact, &work, work_limit)
                    marker: (known: bool, name: sview, width: i64) = proof_unsigned_marker_info(fact)
                    return false if not marker.known
                    return proof_linear_sum_term_with_search_work(marker.name, 0 - multiplier, names, coefficients, &work, work_limit, metered)

        def proof_linear_multiplier(expression: Ast::Expr) -> (known: bool, value: i64):
            value: (known: bool, value: i64) = proof_constant_int(expression)
            return (false, 0) if not value.known or value.value > ProofLinearCertificateLimit::MULTIPLIER or value.value < 0 - ProofLinearCertificateLimit::MULTIPLIER
            return value

        def proof_linear_certificate_closes_with_search_work(certificate: Ast::Expr, facts: darray[Ast::Expr]&, goal: Ast::Expr, markers: ProofScalarWitnesses&, fact_index: ProofLinearCertificateFactIndex, work: mutable usize&, work_limit: usize, premise_lookup_attempted: mutable bool&) -> bool:
            match certificate:
                Ast::Expr.Call(_, arguments, argument_names, _):
                    return false if:
                        argument_names.count != 0 or arguments.count % 2 != 1
                        arguments.count > 1 + 2 * ProofLinearCertificateLimit::PREMISES
                    return false if not proof_linear_search_width_debit(&work, work_limit, 1 + arguments.count)
                    names: mutable darray[sview] = []
                    coefficients: mutable darray[i64] = []
                    constant: mutable i64 = 0
                    return false if not proof_linear_search_marker_parse_charge(arguments[0], &work, work_limit)
                    goal_multiplier: (known: bool, value: i64) = proof_linear_multiplier(arguments[0])
                    return false if:
                        not goal_multiplier.known or goal_multiplier.value <= 0
                        not proof_linear_constraint_add_with_search_work(goal, goal_multiplier.value, true, facts, markers, &names, &coefficients, &constant, &work, work_limit, true)
                    index: mutable usize = 1
                    while index + 1 < arguments.count |index, arguments, facts, names, coefficients, constant, markers, work, work_limit|:
                        return false if not proof_linear_search_width_debit(&work, work_limit, 1)
                        premise: Ast::Expr = arguments[index]
                        return false if not proof_linear_search_marker_parse_charge(premise, &work, work_limit)
                        return false if not proof_linear_search_marker_parse_charge(arguments[index + 1], &work, work_limit)
                        multiplier: (known: bool, value: i64) = proof_linear_multiplier(arguments[index + 1])
                        premise_callee: sview = proof_marker_callee_name(premise)
                        premise_is_certificate: (complete: bool, equal: bool) = proof_linear_search_name_equal(premise_callee, "__elisa_linear_certificate", &work, work_limit, true)
                        index <- index + 2
                        return false if:
                            not multiplier.known or not premise_is_certificate.complete or premise_is_certificate.equal
                        premise_lookup_attempted <- true
                        present: (complete: bool, found: bool) = proof_linear_certificate_fact_index_contains(fact_index, facts, premise, &work, work_limit)
                        return false if not present.complete or not present.found
                        return false if not proof_linear_constraint_add_with_search_work(premise, multiplier.value, false, facts, markers, &names, &coefficients, &constant, &work, work_limit, true)
                    for coefficient in coefficients |coefficient, work, work_limit|:
                        return false if not proof_linear_search_width_debit(&work, work_limit, 1)
                        return false if coefficient != 0
                    return constant > 0
                _:
                    return false

        def proof_linear_certificate_goal(facts: darray[Ast::Expr]&, goal: Ast::Expr, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            return false if exhausted
            work: mutable usize = budget
            goal_marker: sview = proof_marker_callee_name(goal)
            goal_is_certificate: (complete: bool, equal: bool) = proof_linear_search_name_equal(goal_marker, "__elisa_linear_certificate", &work, PROOF_LINEAR_SAFETY_WORK_LIMIT, true)
            if not goal_is_certificate.complete:
                budget <- work
                exhausted <- true
                return false
            if goal_is_certificate.equal:
                budget <- work
                exhausted <- true if work >= PROOF_LINEAR_SAFETY_WORK_LIMIT
                return false
            candidates: mutable darray[usize] = []
            index: mutable usize = 0
            for fact in facts |fact, candidates, index, work, budget, exhausted|:
                if not proof_linear_search_width_debit(&work, PROOF_LINEAR_SAFETY_WORK_LIMIT, 1):
                    budget <- work
                    exhausted <- true
                    return false
                callee: sview = proof_marker_callee_name(fact)
                is_certificate: (complete: bool, equal: bool) = proof_linear_search_name_equal(callee, "__elisa_linear_certificate", &work, PROOF_LINEAR_SAFETY_WORK_LIMIT, true)
                if not is_certificate.complete:
                    budget <- work
                    exhausted <- true
                    return false
                candidates.push(index) if is_certificate.equal
                index <- index + 1
            if candidates.count == 0:
                budget <- work
                exhausted <- true if work >= PROOF_LINEAR_SAFETY_WORK_LIMIT
                return false
            budget <- work
            marker_result: (complete: bool, witnesses: ProofScalarWitnesses) = proof_scalar_witness_markers_with_work(facts, true, &budget, &exhausted)
            return false if not marker_result.complete or exhausted
            markers: ProofScalarWitnesses = marker_result.witnesses
            work <- budget
            # Preserve the common early-hit case: a first certificate whose premises are
            # already near the front of `facts` can close without the up-front full-fact index
            # construction. The contains helper uses a metered exact linear scan until the
            # shared index exists.
            first_candidate: usize = candidates[0]
            if not proof_linear_search_width_debit(&work, PROOF_LINEAR_SAFETY_WORK_LIMIT, 1):
                budget <- work
                exhausted <- true
                return false
            if first_candidate >= facts.count:
                budget <- work
                exhausted <- true
                return false
            empty_index: ProofLinearCertificateFactIndex = ProofLinearCertificateFactIndex{hashes: [], heads: [], next_rows: [], valid: false}
            first_lookup_attempted: mutable bool = false
            first_closed: bool = proof_linear_certificate_closes_with_search_work(facts[first_candidate], facts, goal, markers, empty_index, &work, PROOF_LINEAR_SAFETY_WORK_LIMIT, &first_lookup_attempted)
            if first_closed:
                budget <- work
                return true
            if work >= PROOF_LINEAR_SAFETY_WORK_LIMIT:
                budget <- work
                exhausted <- true
                return false
            fact_index: mutable ProofLinearCertificateFactIndex = empty_index
            for candidate_index in 1..<candidates.count |candidate_index, candidates, facts, goal, markers, fact_index, work, budget, exhausted|:
                if not proof_linear_search_width_debit(&work, PROOF_LINEAR_SAFETY_WORK_LIMIT, 1):
                    budget <- work
                    exhausted <- true
                    return false
                candidate: usize = candidates[candidate_index]
                if candidate >= facts.count:
                    budget <- work
                    exhausted <- true
                    return false
                # Certificates with only a goal multiplier need no premise lookup. Defer the
                # full-fact index until the first well-shaped candidate that actually has a
                # premise, preserving source candidate order and avoiding setup for zero-premise
                # searches.
                needs_index: mutable bool = false
                premise_lookup_attempted: mutable bool = false
                match facts[candidate]:
                    Ast::Expr.Call(_, arguments, argument_names, _):
                        needs_index <- argument_names.count == 0 and arguments.count > 1 and arguments.count % 2 == 1 and arguments.count <= 1 + 2 * ProofLinearCertificateLimit::PREMISES
                    _:
                        pass
                closed: bool = proof_linear_certificate_closes_with_search_work(facts[candidate], facts, goal, markers, fact_index, &work, PROOF_LINEAR_SAFETY_WORK_LIMIT, &premise_lookup_attempted)
                if closed:
                    budget <- work
                    return true
                if work >= PROOF_LINEAR_SAFETY_WORK_LIMIT:
                    budget <- work
                    exhausted <- true
                    return false
                # Let this candidate use a bounded exact linear scan first. If it did not close,
                # build the shared index only when a later candidate can reuse the setup.
                if needs_index and premise_lookup_attempted and not fact_index.valid and candidate_index + 1 < candidates.count:
                    index_result: (complete: bool, index: ProofLinearCertificateFactIndex) = proof_linear_certificate_fact_index_build(facts, &work, PROOF_LINEAR_SAFETY_WORK_LIMIT)
                    budget <- work
                    if not index_result.complete:
                        exhausted <- true
                        return false
                    fact_index <- index_result.index
            budget <- work
            return false
