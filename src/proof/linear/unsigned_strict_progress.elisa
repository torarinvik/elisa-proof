extend ElisaProof:
    public:
        # Direct positive-step evidence only. No nonzero/signed reinterpretation.
        def proof_unsigned_progress_positive(step: Ast::Expr, facts: darray[Ast::Expr]&) -> bool:
            orders: darray[Ast::Expr] = proof_conjunct_facts(facts)
            for fact in orders |step, facts|:
                order: (known: bool, left: Ast::Expr, operator: TokenKind, right: Ast::Expr) = proof_readable_order(fact, facts)
                continue if not order.known
                low: Ast::Expr = order.right if order.operator == TokenKind.Gt else order.left
                high: Ast::Expr = order.left if order.operator == TokenKind.Gt else order.right
                continue if order.operator != TokenKind.Gt and order.operator != TokenKind.Lt
                zero: (known: bool, value: i64) = proof_constant_int(low)
                return true if zero.known and zero.value == 0 and proof_expr_equal(high, step)
            return false

        # a + b > a needs b > 0 AND an independently witnessed nonwrapping sum.
        def proof_unsigned_positive_sum(sum: Ast::Expr, base: Ast::Expr, facts: darray[Ast::Expr]&) -> bool:
            operands: (known: bool, left: Ast::Expr, right: Ast::Expr) = proof_sum_operands(sum)
            return false if not operands.known
            step: mutable Ast::Expr = operands.right
            if proof_expr_equal(base, operands.right):
                step <- operands.left
            elif not proof_expr_equal(base, operands.left):
                return false
            return false if proof_ident_name(base) == "" or proof_ident_name(step) == ""
            width: i64 = proof_unsigned_width_in_expression(sum, facts)
            return false if width <= 0
            return false if proof_peer_unsigned_width(base, facts) != width or proof_peer_unsigned_width(step, facts) != width
            return false if not proof_unsigned_progress_positive(step, facts)
            return proof_sum_range_safe(sum, operands.left, operands.right, facts)

        def proof_unsigned_strict_progress_shape(facts: darray[Ast::Expr]&, goal: Ast::Expr) -> bool:
            match proof_strip_parens(goal):
                Ast::Expr.Binary(left, operator, right, _):
                    return proof_unsigned_positive_sum(left, right, facts) if operator == TokenKind.Gt
                    return false if operator != TokenKind.Lt
                    return true if proof_unsigned_positive_sum(right, left, facts)
                    # cap - (a + b) < cap - a follows only when both
                    # subtractions and the positive sum cannot wrap.
                    lower: (known: bool, left: Ast::Expr, right: Ast::Expr) = proof_difference_operands(left)
                    upper: (known: bool, left: Ast::Expr, right: Ast::Expr) = proof_difference_operands(right)
                    return false if not lower.known or not upper.known
                    return false if not proof_expr_equal(lower.left, upper.left)
                    return false if not proof_unsigned_positive_sum(lower.right, upper.right, facts)
                    sum: (known: bool, left: Ast::Expr, right: Ast::Expr) = proof_sum_operands(lower.right)
                    witness: (known: bool, bound: Ast::Expr, strict: bool) = proof_sum_upper_witness(sum.left, sum.right, facts)
                    return witness.known and proof_expr_equal(witness.bound, lower.left)
                _:
                    return false
