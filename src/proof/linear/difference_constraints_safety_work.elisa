# Budgeted shape scans and difference-fact collection used by all linear-safety clients.
extend ElisaProof:
    public:
        def proof_linear_safety_expression_shape_with_work(expression: Ast::Expr, depth: usize, nodes: mutable usize&, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT:
                exhausted <- true
                return false
            return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
            nodes <- nodes + 1
            match expression:
                Ast::Expr.Ident(name, _):
                    return proof_linear_safety_work_charge(budget, exhausted, sview_len(name))
                Ast::Expr.Paren(inner, _) | Ast::Expr.Unary(_, inner, _) | Ast::Expr.Move(inner, _) | Ast::Expr.RegionNew(inner, _, _):
                    return proof_linear_safety_expression_shape_with_work(inner, depth + 1, &nodes, &budget, &exhausted)
                Ast::Expr.Field(inner, member, _) | Ast::Expr.Scope(inner, member, _):
                    return false if not proof_linear_safety_work_charge(budget, exhausted, sview_len(member))
                    return proof_linear_safety_expression_shape_with_work(inner, depth + 1, &nodes, &budget, &exhausted)
                Ast::Expr.Binary(left, _, right, _):
                    return false if not proof_linear_safety_expression_shape_with_work(left, depth + 1, &nodes, &budget, &exhausted)
                    return proof_linear_safety_expression_shape_with_work(right, depth + 1, &nodes, &budget, &exhausted)
                Ast::Expr.Index(object, index, _):
                    return false if not proof_linear_safety_expression_shape_with_work(object, depth + 1, &nodes, &budget, &exhausted)
                    return proof_linear_safety_expression_shape_with_work(index, depth + 1, &nodes, &budget, &exhausted)
                Ast::Expr.IndexN(object, indices, _):
                    return false if not proof_linear_safety_expression_shape_with_work(object, depth + 1, &nodes, &budget, &exhausted)
                    for index in indices |depth, nodes, budget, exhausted|:
                        return false if not proof_linear_safety_expression_shape_with_work(index, depth + 1, &nodes, &budget, &exhausted)
                    return true
                Ast::Expr.Slice(object, low, high, _):
                    return false if not proof_linear_safety_expression_shape_with_work(object, depth + 1, &nodes, &budget, &exhausted)
                    return false if not proof_linear_safety_expression_shape_with_work(low, depth + 1, &nodes, &budget, &exhausted)
                    return proof_linear_safety_expression_shape_with_work(high, depth + 1, &nodes, &budget, &exhausted)
                Ast::Expr.If(condition, yes, no, _):
                    return false if not proof_linear_safety_expression_shape_with_work(condition, depth + 1, &nodes, &budget, &exhausted)
                    return false if not proof_linear_safety_expression_shape_with_work(yes, depth + 1, &nodes, &budget, &exhausted)
                    return proof_linear_safety_expression_shape_with_work(no, depth + 1, &nodes, &budget, &exhausted)
                Ast::Expr.Call(callee, arguments, _, _):
                    return false if not proof_linear_safety_expression_shape_with_work(callee, depth + 1, &nodes, &budget, &exhausted)
                    for argument in arguments |depth, nodes, budget, exhausted|:
                        return false if not proof_linear_safety_expression_shape_with_work(argument, depth + 1, &nodes, &budget, &exhausted)
                    return true
                Ast::Expr.Array(elements, _) | Ast::Expr.Tuple(elements, _) | Ast::Expr.SetLit(elements, _):
                    for element in elements |depth, nodes, budget, exhausted|:
                        return false if not proof_linear_safety_expression_shape_with_work(element, depth + 1, &nodes, &budget, &exhausted)
                    return true
                _:
                    return true

        def proof_linear_safety_fact_shape_total_with_work(facts: darray[Ast::Expr]&, total_nodes: mutable usize&, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            total_nodes <- 0
            for fact in facts |fact, total_nodes, budget, exhausted|:
                return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                return false if not proof_linear_safety_expression_shape_with_work(fact, 0, &total_nodes, &budget, &exhausted)
            return true

        def proof_linear_safety_bound_shape_total_with_work(bounds: darray[ProofBound]&, total_nodes: mutable usize&, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            total_nodes <- 0
            for bound in bounds |bound, total_nodes, budget, exhausted|:
                return false if not proof_linear_safety_work_charge(budget, exhausted, 1 + sview_len(bound.name))
                if bound.term_key:
                    return false if not proof_linear_safety_expression_shape_with_work(bound.term, 0, &total_nodes, &budget, &exhausted)
            return true

        def proof_linear_safety_charge_cross_with_work(budget: mutable usize&, exhausted: mutable bool&, first: usize, second: usize, multiplier: usize) -> bool:
            return false if exhausted
            return true if first == 0 or second == 0 or multiplier == 0
            if first > PROOF_LINEAR_SAFETY_WORK_LIMIT / second:
                budget <- PROOF_LINEAR_SAFETY_WORK_LIMIT
                exhausted <- true
                return false
            product: usize = first * second
            return false if not proof_linear_safety_work_charge_scaled(budget, exhausted, product, multiplier)

        def proof_collect_difference_constraints_marked_with_work(expression: Ast::Expr, bounds: darray[ProofBound]&, facts: darray[Ast::Expr]&, markers: ProofScalarWitnesses&, constraints: mutable darray[ProofDifference]&, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            fact_nodes: mutable usize = 0
            bound_nodes: mutable usize = 0
            return false if not proof_linear_safety_fact_shape_total_with_work(facts, &fact_nodes, budget, exhausted)
            return false if not proof_linear_safety_bound_shape_total_with_work(bounds, &bound_nodes, budget, exhausted)
            return proof_collect_difference_constraints_marked_work_inner(expression, bounds, facts, markers, fact_nodes, bound_nodes, &constraints, 0, budget, exhausted)

        def proof_collect_difference_constraints_marked_work_inner(expression: Ast::Expr, bounds: darray[ProofBound]&, facts: darray[Ast::Expr]&, markers: ProofScalarWitnesses&, fact_nodes: usize, bound_nodes: usize, constraints: mutable darray[ProofDifference]&, depth: usize, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            return true if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_collect_difference_constraints_marked_work_inner(inner, bounds, facts, markers, fact_nodes, bound_nodes, &constraints, depth + 1, budget, exhausted)
                Ast::Expr.Unary(TokenKind.Not, operand, _):
                    match operand:
                        Ast::Expr.Binary(left, operator, right, _):
                            negated_operator: TokenKind = proof_comparison_negation(operator)
                            if negated_operator != TokenKind.Eof:
                                negated: Ast::Expr = Ast::Expr.Binary(left, negated_operator, right, Ast::expr_pos(expression))
                                return proof_collect_difference_constraints_marked_work_inner(negated, bounds, facts, markers, fact_nodes, bound_nodes, &constraints, depth + 1, budget, exhausted)
                        _:
                            pass
                    return true
                Ast::Expr.Binary(left, operator, right, _):
                    if operator == TokenKind.And:
                        return false if not proof_collect_difference_constraints_marked_work_inner(left, bounds, facts, markers, fact_nodes, bound_nodes, &constraints, depth + 1, budget, exhausted)
                        return proof_collect_difference_constraints_marked_work_inner(right, bounds, facts, markers, fact_nodes, bound_nodes, &constraints, depth + 1, budget, exhausted)
                    return true if not proof_is_comparison(operator)
                    left_nodes: mutable usize = 0
                    right_nodes: mutable usize = 0
                    return false if not proof_linear_safety_expression_shape_with_work(left, 0, &left_nodes, &budget, &exhausted)
                    return false if not proof_linear_safety_expression_shape_with_work(right, 0, &right_nodes, &budget, &exhausted)
                    term_nodes: usize = left_nodes + right_nodes
                    return false if not proof_linear_safety_charge_cross_with_work(budget, exhausted, term_nodes, fact_nodes, PROOF_LINEAR_SAFETY_SCAN_MULTIPLIER)
                    return false if not proof_linear_safety_charge_cross_with_work(budget, exhausted, term_nodes, bound_nodes, PROOF_LINEAR_SAFETY_SCAN_MULTIPLIER)
                    return false if not proof_linear_safety_charge_cross_with_work(budget, exhausted, term_nodes, constraints.count + 1, PROOF_LINEAR_SAFETY_SCAN_MULTIPLIER)
                    return true if not proof_primitive_comparison_marked(left, right, markers)
                    if operator != TokenKind.BangEq:
                        imported: bool = proof_guarded_difference_import_with_work(left, operator, right, facts, constraints, budget, exhausted)
                        return false if exhausted
                        return true if imported
                    left_affine: ProofAffine = proof_affine_expression(left)
                    right_affine: ProofAffine = proof_affine_expression(right)
                    left_safe: bool = proof_affine_safe(left_affine, bounds) or proof_affine_peer_safe_from_facts(left_affine, facts)
                    return true if not left_safe
                    right_safe: bool = proof_affine_safe(right_affine, bounds) or proof_affine_peer_safe_from_facts(right_affine, facts)
                    return true if not right_safe
                    distinct: bool = (operator == TokenKind.LtEq or operator == TokenKind.GtEq) and proof_facts_state_disequality(left, right, facts)
                    if operator == TokenKind.LtEq:
                        return proof_difference_push_with_work(left_affine, right_affine, false, distinct, &constraints, budget, exhausted)
                    if operator == TokenKind.Lt:
                        return proof_difference_push_with_work(left_affine, right_affine, false, true, &constraints, budget, exhausted)
                    if operator == TokenKind.GtEq:
                        return proof_difference_push_with_work(left_affine, right_affine, true, distinct, &constraints, budget, exhausted)
                    if operator == TokenKind.Gt:
                        return proof_difference_push_with_work(left_affine, right_affine, true, true, &constraints, budget, exhausted)
                    if operator == TokenKind.EqEq:
                        return false if not proof_difference_push_with_work(left_affine, right_affine, false, false, &constraints, budget, exhausted)
                        return proof_difference_push_with_work(left_affine, right_affine, true, false, &constraints, budget, exhausted)
                    return true
                _:
                    return true

        # Conservative replacement for the legacy goal query in metered safety paths. This
        # tier proves only reflexive comparisons between distinct names connected by explicit,
        # primitive equality facts. The alias collector validates each equality witness and
        # shares the caller's budget; unsupported arithmetic simply remains unproved.
        def proof_linear_goal_with_work(left: Ast::Expr, operator: TokenKind, right: Ast::Expr, facts: darray[Ast::Expr]&, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            return false if exhausted
            reflexive: bool = operator == TokenKind.EqEq or operator == TokenKind.LtEq or operator == TokenKind.GtEq
            return false if not reflexive
            left_nodes: mutable usize = 0
            right_nodes: mutable usize = 0
            if not proof_linear_safety_expression_shape_with_work(left, 0, &left_nodes, &budget, &exhausted):
                exhausted <- true
                return false
            if not proof_linear_safety_expression_shape_with_work(right, 0, &right_nodes, &budget, &exhausted):
                exhausted <- true
                return false
            left_name: sview = proof_ident_name(left)
            right_name: sview = proof_ident_name(right)
            return false if left_name == "" or right_name == ""
            if left_name == right_name:
                witnessed: bool = proof_linear_safety_scalar_name_witnessed_with_work(left_name, facts, budget, exhausted)
                return false if exhausted
                return witnessed
            return proof_names_equal_from_facts_with_work(left_name, right_name, facts, budget, exhausted)

        def proof_linear_safety_scalar_name_witnessed_with_work(name: sview, facts: darray[Ast::Expr]&, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            for fact in facts |fact, name, budget, exhausted|:
                return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                fact_cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(fact, budget, exhausted)
                return false if not fact_cost.complete
                marker_name: sview = proof_marker_callee_name(fact)
                if marker_name == "__elisa_primitive_scalar_type" or marker_name == "__elisa_primitive_integer_type":
                    argument: (known: bool, term: Ast::Expr) = proof_marker_argument(fact, marker_name)
                    return true if argument.known and proof_ident_name(argument.term) == name
                elif marker_name == "__elisa_unsigned_type_bound":
                    return true if proof_unsigned_marker_name(fact) == name
            return false
