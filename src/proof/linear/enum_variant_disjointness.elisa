# Prove that one enum scrutinee cannot carry two different tags from the same owner.
# Source search proposes this narrow step; typed kernel replay independently checks that both
# operands are real variants of the receiver's exact enum declaration.
extend ElisaProof:
    private:
        def proof_enum_variant_paths_are_distinct(left: Ast::Expr, right: Ast::Expr) -> bool:
            match left:
                Ast::Expr.Field(left_owner, left_name, _):
                    match right:
                        Ast::Expr.Field(right_owner, right_name, _):
                            return left_name != right_name and proof_expr_equal(left_owner, right_owner)
                        _:
                            return false
                Ast::Expr.Scope(left_owner, left_name, _):
                    match right:
                        Ast::Expr.Scope(right_owner, right_name, _):
                            return left_name != right_name and proof_expr_equal(left_owner, right_owner)
                        _:
                            return false
                _:
                    return false

        def proof_enum_variant_fact_disjoint_from_tag(fact: Ast::Expr, scrutinee: Ast::Expr, variant: Ast::Expr, depth: usize) -> bool:
            requires depth <= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            decreases PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT - depth
            return false if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            match proof_strip_parens(fact):
                Ast::Expr.Binary(fact_scrutinee, TokenKind.Is, fact_variant, _):
                    return proof_expr_equal(fact_scrutinee, scrutinee) and proof_enum_variant_paths_are_distinct(fact_variant, variant)
                Ast::Expr.Binary(left, TokenKind.And, right, _):
                    return proof_enum_variant_fact_disjoint_from_tag(left, scrutinee, variant, depth + 1) or proof_enum_variant_fact_disjoint_from_tag(right, scrutinee, variant, depth + 1)
                _:
                    return false

        def proof_enum_variant_disjoint_from_facts(facts: darray[Ast::Expr]&, goal: Ast::Expr) -> bool:
            match proof_strip_parens(goal):
                Ast::Expr.Unary(TokenKind.Not, operand, _):
                    match proof_strip_parens(operand):
                        Ast::Expr.Binary(scrutinee, TokenKind.Is, variant, _):
                            for fact in facts |facts, scrutinee, variant|:
                                return true if proof_enum_variant_fact_disjoint_from_tag(fact, scrutinee, variant, 0)
                        _:
                            pass
                _:
                    pass
            return false
