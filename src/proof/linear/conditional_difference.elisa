extend ElisaProof:
    public:
        # The guard itself witnesses nonwrapping subtraction on its true arm.
        # Named operands are stable scalar values; no calls or field reads are
        # assumed repeatable here. The false arm must be the zero literal.
        def proof_unsigned_conditional_difference_safe(expression: Ast::Expr, facts: darray[Ast::Expr]&) -> bool:
            match expression:
                Ast::Expr.If(condition, then_expression, otherwise, _):
                    match otherwise:
                        Ast::Expr.IntLit(value, _):
                            return false if value != 0
                        _:
                            return false
                    match then_expression:
                        Ast::Expr.Binary(a, TokenKind.Minus, b, _):
                            return false if proof_ident_name(a) == "" or proof_ident_name(b) == ""
                            width: i64 = proof_peer_unsigned_width(a, facts)
                            return false if:
                                width != 8 and width != 16 and width != 32 and width != 64
                                proof_peer_unsigned_width(b, facts) != width
                                not proof_primitive_comparison(a, b, facts)
                            match condition:
                                Ast::Expr.Binary(left, operator, right, _):
                                    return false if not proof_primitive_comparison(left, right, facts)
                                    if operator == TokenKind.Gt or operator == TokenKind.GtEq:
                                        return proof_expr_equal(left, a) and proof_expr_equal(right, b)
                                    if operator == TokenKind.Lt or operator == TokenKind.LtEq:
                                        return proof_expr_equal(left, b) and proof_expr_equal(right, a)
                                    return false
                                _:
                                    return false
                        _:
                            return false
                _:
                    return false

        # Work-aware form reuses the caller's witness index instead of rebuilding markers and
        # rescanning the fact list for the two identifier widths on every nested conditional.
        def proof_unsigned_conditional_difference_safe_with_work(expression: Ast::Expr, markers: ProofScalarWitnesses&, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            can Abort.Panic:
                return false if proof_goal_bool_ref_value(exhausted)
                match expression:
                    Ast::Expr.If(condition, then_expression, otherwise, _):
                        match otherwise:
                            Ast::Expr.IntLit(value, _):
                                return false if value != 0
                            _:
                                return false
                        match then_expression:
                            Ast::Expr.Binary(left_term, TokenKind.Minus, right_term, _):
                                return false if proof_ident_name(left_term) == "" or proof_ident_name(right_term) == ""
                                left_width: i64 = proof_unsigned_width_in_expression_with_work(left_term, markers, budget, exhausted)
                                return false if:
                                    exhausted
                                    left_width != 8 and left_width != 16 and left_width != 32 and left_width != 64
                                right_width: i64 = proof_unsigned_width_in_expression_with_work(right_term, markers, budget, exhausted)
                                return false if proof_goal_bool_ref_value(exhausted) or right_width != left_width
                                marker_scan: (complete: bool, scale: usize) = proof_linear_safety_marker_scale_with_work(markers, budget, exhausted)
                                return false if not marker_scan.complete
                                operands_comparable: (complete: bool, matches: bool) = proof_linear_safety_comparison_with_work(left_term, right_term, markers, marker_scan.scale, budget, exhausted)
                                return false if not operands_comparable.complete or not operands_comparable.matches
                                match condition:
                                    Ast::Expr.Binary(left, operator, right, _):
                                        condition_comparable: (complete: bool, matches: bool) = proof_linear_safety_comparison_with_work(left, right, markers, marker_scan.scale, budget, exhausted)
                                        return false if not condition_comparable.complete or not condition_comparable.matches
                                        if operator == TokenKind.Gt or operator == TokenKind.GtEq:
                                            return proof_unsigned_witness_terms_equal_with_work(left, left_term, budget, exhausted) and proof_unsigned_witness_terms_equal_with_work(right, right_term, budget, exhausted)
                                        if operator == TokenKind.Lt or operator == TokenKind.LtEq:
                                            return proof_unsigned_witness_terms_equal_with_work(left, right_term, budget, exhausted) and proof_unsigned_witness_terms_equal_with_work(right, left_term, budget, exhausted)
                                        return false
                                    _:
                                        return false
                            _:
                                return false
                    _:
                        return false
