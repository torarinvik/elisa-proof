extend ElisaProof:
    private:
        const PROOF_CROSS_WIDTH_SAFE_INTEGER_MAX: i64 = ElisaProofKernelCore::PROOF_KERNEL_I8_MAX

        def proof_small_nonnegative_constant(expression: Ast::Expr) -> (known: bool, value: i64):
            return proof_small_nonnegative_constant_depth(expression, 0)

        def proof_small_nonnegative_constant_depth(expression: Ast::Expr, depth: usize) -> (known: bool, value: i64):
            requires depth <= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            decreases PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT - depth
            return (false, 0) if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            match expression:
                Ast::Expr.IntLit(value, _):
                    return (value >= 0 and value <= PROOF_CROSS_WIDTH_SAFE_INTEGER_MAX, value)
                Ast::Expr.Paren(inner, _):
                    return proof_small_nonnegative_constant_depth(inner, depth + 1)
                Ast::Expr.Unary(operator, operand, _):
                    inner: (known: bool, value: i64) = proof_small_nonnegative_constant_depth(operand, depth + 1)
                    return (false, 0) if not inner.known
                    return inner if operator == TokenKind.Plus
                    return (true, 0) if operator == TokenKind.Minus and inner.value == 0
                    return (false, 0)
                Ast::Expr.Binary(left, operator, right, _):
                    # The imported term does not retain the operand width. A shift can therefore
                    # be in range at i64 width but invalid/poison at a narrower fixed width.
                    return (false, 0) if operator == TokenKind.LShift or operator == TokenKind.RShift
                    left_value: (known: bool, value: i64) = proof_small_nonnegative_constant_depth(left, depth + 1)
                    right_value: (known: bool, value: i64) = proof_small_nonnegative_constant_depth(right, depth + 1)
                    return (false, 0) if not left_value.known or not right_value.known
                    result: (known: bool, value: i64) = proof_constant_int(expression)
                    return (false, 0) if not result.known or result.value < 0 or result.value > PROOF_CROSS_WIDTH_SAFE_INTEGER_MAX
                    return result
                _:
                    return (false, 0)

        def proof_safe_comparison_constant(expression: Ast::Expr) -> (known: bool, value: i64):
            match expression:
                Ast::Expr.IntLit(value, _):
                    return (value >= 0, value)
                _:
                    return proof_small_nonnegative_constant(expression)

        # A source `-N` is a unary minus applied to a nonnegative integer token, not a negative
        # integer payload. Comparisons made solely from these literals have the same value in
        # every signed primitive type that can represent both operands. Keep arithmetic out of
        # this fragment: its fixed-width overflow behavior requires the existing typed model.
        def proof_nonnegative_literal_constant(expression: Ast::Expr) -> (known: bool, value: i64):
            return proof_nonnegative_literal_constant_depth(expression, 0)

        def proof_nonnegative_literal_constant_depth(expression: Ast::Expr, depth: usize) -> (known: bool, value: i64):
            requires depth <= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            decreases PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT - depth
            return (false, 0) if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            match expression:
                Ast::Expr.IntLit(value, _):
                    return (value >= 0, value)
                Ast::Expr.Paren(inner, _):
                    return proof_nonnegative_literal_constant_depth(inner, depth + 1)
                Ast::Expr.Unary(TokenKind.Plus, operand, _):
                    return proof_nonnegative_literal_constant_depth(operand, depth + 1)
                _:
                    return (false, 0)

        def proof_signed_literal_comparison_constant(expression: Ast::Expr) -> (known: bool, value: i64):
            return proof_signed_literal_comparison_constant_depth(expression, 0)

        def proof_signed_literal_comparison_constant_depth(expression: Ast::Expr, depth: usize) -> (known: bool, value: i64):
            requires depth <= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            decreases PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT - depth
            return (false, 0) if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            match expression:
                Ast::Expr.IntLit(value, _):
                    return (value >= 0, value)
                Ast::Expr.Paren(inner, _):
                    return proof_signed_literal_comparison_constant_depth(inner, depth + 1)
                Ast::Expr.Unary(TokenKind.Plus, operand, _):
                    return proof_signed_literal_comparison_constant_depth(operand, depth + 1)
                Ast::Expr.Unary(TokenKind.Minus, operand, _):
                    magnitude: (known: bool, value: i64) = proof_nonnegative_literal_constant_depth(operand, depth + 1)
                    return (false, 0) if not magnitude.known or magnitude.value == proof_i64_min()
                    return (true, 0 - magnitude.value)
                _:
                    return (false, 0)

        def proof_closed_signed_literal_comparison(goal: Ast::Expr) -> bool:
            comparison: mutable Ast::Expr = proof_strip_parens(goal)
            match comparison:
                Ast::Expr.Unary(TokenKind.Not, operand, position):
                    match proof_strip_parens(operand):
                        Ast::Expr.Binary(left, operator, right, _):
                            complement: TokenKind = proof_comparison_negation(operator)
                            return false if complement == TokenKind.Eof
                            comparison <- Ast::Expr.Binary(left, complement, right, position)
                        _:
                            return false
                _:
                    pass
            match comparison:
                Ast::Expr.Binary(left, operator, right, _):
                    return false if not proof_is_comparison(operator)
                    a: (known: bool, value: i64) = proof_signed_literal_comparison_constant(left)
                    b: (known: bool, value: i64) = proof_signed_literal_comparison_constant(right)
                    return false if not a.known or not b.known
                    return a.value == b.value if operator == TokenKind.EqEq
                    return a.value != b.value if operator == TokenKind.BangEq
                    return a.value < b.value if operator == TokenKind.Lt
                    return a.value > b.value if operator == TokenKind.Gt
                    return a.value <= b.value if operator == TokenKind.LtEq
                    return a.value >= b.value if operator == TokenKind.GtEq
                    return false
                _:
                    return false

        def proof_closed_integer_arithmetic(expression: Ast::Expr, depth: usize) -> bool:
            return true if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            match expression:
                Ast::Expr.IntLit(_, _):
                    return true
                Ast::Expr.Paren(inner, _):
                    return proof_closed_integer_arithmetic(inner, depth + 1)
                Ast::Expr.Unary(operator, operand, _):
                    return (operator == TokenKind.Plus or operator == TokenKind.Minus) and proof_closed_integer_arithmetic(operand, depth + 1)
                Ast::Expr.Binary(left, operator, right, _):
                    arithmetic: bool = operator == TokenKind.Plus or operator == TokenKind.Minus or operator == TokenKind.Star or operator == TokenKind.Slash or operator == TokenKind.Percent or operator == TokenKind.Ampersand or operator == TokenKind.Pipe or operator == TokenKind.Caret or operator == TokenKind.LShift or operator == TokenKind.RShift
                    return arithmetic and proof_closed_integer_arithmetic(left, depth + 1) and proof_closed_integer_arithmetic(right, depth + 1)
                _:
                    return false

        # Integer literals and constant expressions reach the proof IR without resolved
        # primitive widths. Negative payloads may be unsigned bit patterns, and even positive
        # constant arithmetic may wrap at a narrow width. Numeric solvers may still use them
        # when explicit typing evidence is modeled; until then, this predicate identifies terms
        # that must not enter the unbounded-i64 fragment.
        def proof_has_ambiguous_integer_constant(expression: Ast::Expr, depth: usize) -> bool:
            return true if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            match expression:
                Ast::Expr.Invalid:
                    return true
                Ast::Expr.Absent:
                    return true
                Ast::Expr.IntLit(value, _):
                    return value < 0
                Ast::Expr.FloatLit(_, _):
                    return false
                Ast::Expr.StringLit(_, _):
                    return false
                Ast::Expr.CharLit(_, _):
                    return false
                Ast::Expr.BoolLit(_, _):
                    return false
                Ast::Expr.Ident(_, _):
                    return false
                Ast::Expr.ShorthandMember(_, _):
                    return false
                Ast::Expr.Paren(inner, _):
                    return proof_has_ambiguous_integer_constant(inner, depth + 1)
                Ast::Expr.Unary(operator, operand, _):
                    if operator == TokenKind.Plus or operator == TokenKind.Minus:
                        safe: (known: bool, value: i64) = proof_small_nonnegative_constant(expression)
                        return not safe.known if proof_closed_integer_arithmetic(expression, depth)
                    return proof_has_ambiguous_integer_constant(operand, depth + 1)
                Ast::Expr.Binary(left, operator, right, _):
                    if operator == TokenKind.Plus or operator == TokenKind.Minus or operator == TokenKind.Star or operator == TokenKind.Slash or operator == TokenKind.Percent or operator == TokenKind.Ampersand or operator == TokenKind.Pipe or operator == TokenKind.Caret or operator == TokenKind.LShift or operator == TokenKind.RShift:
                        safe: (known: bool, value: i64) = proof_small_nonnegative_constant(expression)
                        return not safe.known if proof_closed_integer_arithmetic(expression, depth)
                    return proof_has_ambiguous_integer_constant(left, depth + 1) or proof_has_ambiguous_integer_constant(right, depth + 1)
                Ast::Expr.Call(callee, arguments, _, _):
                    return true if proof_has_ambiguous_integer_constant(callee, depth + 1)
                    for argument in arguments |depth|:
                        return true if proof_has_ambiguous_integer_constant(argument, depth + 1)
                    return false
                Ast::Expr.Field(object, _, _):
                    return proof_has_ambiguous_integer_constant(object, depth + 1)
                Ast::Expr.Scope(base, _, _):
                    return proof_has_ambiguous_integer_constant(base, depth + 1)
                Ast::Expr.Index(object, index, _):
                    return proof_has_ambiguous_integer_constant(object, depth + 1) or proof_has_ambiguous_integer_constant(index, depth + 1)
                Ast::Expr.Slice(object, low, high, _):
                    return proof_has_ambiguous_integer_constant(object, depth + 1) or proof_has_ambiguous_integer_constant(low, depth + 1) or proof_has_ambiguous_integer_constant(high, depth + 1)
                Ast::Expr.IndexN(object, arguments, _):
                    return true if proof_has_ambiguous_integer_constant(object, depth + 1)
                    for argument in arguments |depth|:
                        return true if proof_has_ambiguous_integer_constant(argument, depth + 1)
                    return false
                Ast::Expr.Move(operand, _):
                    return proof_has_ambiguous_integer_constant(operand, depth + 1)
                Ast::Expr.RegionNew(operand, _, _):
                    return proof_has_ambiguous_integer_constant(operand, depth + 1)
                Ast::Expr.StaticEffectCall(_, _, _, _, _, _):
                    return true
                Ast::Expr.Array(elements, _):
                    for element in elements |depth|:
                        return true if proof_has_ambiguous_integer_constant(element, depth + 1)
                    return false
                Ast::Expr.Tuple(elements, _):
                    for element in elements |depth|:
                        return true if proof_has_ambiguous_integer_constant(element, depth + 1)
                    return false
                Ast::Expr.SetLit(elements, _):
                    for element in elements |depth|:
                        return true if proof_has_ambiguous_integer_constant(element, depth + 1)
                    return false
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |depth|:
                        return true if proof_has_ambiguous_integer_constant(entry.key, depth + 1) or proof_has_ambiguous_integer_constant(entry.value, depth + 1)
                    return false
                Ast::Expr.Construct(type_expression, fields, _):
                    return true if proof_has_ambiguous_integer_constant(type_expression, depth + 1)
                    for field in fields |depth|:
                        return true if proof_has_ambiguous_integer_constant(field.value, depth + 1)
                    return false
                Ast::Expr.RecordUpdate(base, fields, _):
                    return true if proof_has_ambiguous_integer_constant(base, depth + 1)
                    for field in fields |depth|:
                        return true if proof_has_ambiguous_integer_constant(field.value, depth + 1)
                    return false
                Ast::Expr.If(condition, then_expression, else_expression, _):
                    return proof_has_ambiguous_integer_constant(condition, depth + 1) or proof_has_ambiguous_integer_constant(then_expression, depth + 1) or proof_has_ambiguous_integer_constant(else_expression, depth + 1)
                Ast::Expr.Comprehension(_, iterable, condition, body, _):
                    return proof_has_ambiguous_integer_constant(iterable, depth + 1) or proof_has_ambiguous_integer_constant(condition, depth + 1) or proof_has_ambiguous_integer_constant(body, depth + 1)
                Ast::Expr.Refinement(base, predicate, _):
                    return proof_has_ambiguous_integer_constant(base, depth + 1) or proof_has_ambiguous_integer_constant(predicate, depth + 1)
                Ast::Expr.Match(_, _, _):
                    return true
                Ast::Expr.Catch(_, _, _):
                    return true
                Ast::Expr.GetElse(_, _, _):
                    return true
                Ast::Expr.Lambda(_, _, _):
                    return true
                Ast::Expr.Block(_, _, _, _):
                    return true
                _:
                    return true

        def proof_signed_i64_only_context(facts: darray[Ast::Expr]&) -> bool:
            has_i64_type: mutable bool = false
            for fact in facts |fact, has_i64_type|:
                match proof_marker_callee_name(fact):
                    "__elisa_signed_type_bound":
                        signed = proof_signed_marker_info(fact)
                        return false if signed.known and signed.width != ElisaProofKernelCore::PROOF_KERNEL_I64_WIDTH
                        has_i64_type <- true if signed.known
                    "__elisa_unsigned_type_bound":
                        unsigned = proof_unsigned_marker_info(fact)
                        return false if unsigned.known
                        place = proof_unsigned_place_marker_info(fact)
                        return false if place.known
                    "__elisa_primitive_scalar_element":
                        element = proof_element_marker_info(fact)
                        return false if element.known and element.width > 0
                    "__elisa_untrusted_operator_type":
                        untrusted = proof_untrusted_operator_marker_info(fact)
                        return false if untrusted.known
                    _:
                        pass
            return has_i64_type

        def proof_closed_signed_i64_comparison(goal: Ast::Expr, facts: darray[Ast::Expr]&) -> bool:
            return false if proof_has_ambiguous_integer_constant(goal, 0)
            return false if not proof_signed_i64_only_context(facts)
            match goal:
                Ast::Expr.Binary(left, operator, right, _):
                    return false if not proof_is_comparison(operator)
                    a: (known: bool, value: i64) = proof_constant_int(left)
                    b: (known: bool, value: i64) = proof_constant_int(right)
                    return false if not a.known or not b.known
                    return a.value == b.value if operator == TokenKind.EqEq
                    return a.value != b.value if operator == TokenKind.BangEq
                    return a.value < b.value if operator == TokenKind.Lt
                    return a.value > b.value if operator == TokenKind.Gt
                    return a.value <= b.value if operator == TokenKind.LtEq
                    return a.value >= b.value if operator == TokenKind.GtEq
                    return false
                _:
                    return false

        # A comparison between closed safe constants has the same truth value in every supported
        # integer width. Do not let unrelated unsigned facts in the surrounding context suppress
        # this fact: no premise is consumed by the comparison. Match the kernel's ambiguity guard
        # as well as its constant-comparison replay rule.
        def proof_closed_safe_constant_comparison(goal: Ast::Expr, facts: darray[Ast::Expr]&) -> bool:
            return false if proof_has_ambiguous_integer_constant(goal, 0)
            for fact in facts:
                return false if proof_has_ambiguous_integer_constant(fact, 0)
            match proof_strip_parens(goal):
                Ast::Expr.Binary(left, operator, right, _):
                    return false if not proof_is_comparison(operator)
                    a: (known: bool, value: i64) = proof_safe_comparison_constant(left)
                    b: (known: bool, value: i64) = proof_safe_comparison_constant(right)
                    return false if not a.known or not b.known
                    return a.value == b.value if operator == TokenKind.EqEq
                    return a.value != b.value if operator == TokenKind.BangEq
                    return a.value < b.value if operator == TokenKind.Lt
                    return a.value > b.value if operator == TokenKind.Gt
                    return a.value <= b.value if operator == TokenKind.LtEq
                    return a.value >= b.value if operator == TokenKind.GtEq
                    return false
                _:
                    return false

        # Direct comparisons between nonnegative integer literals have the same truth value in
        # every primitive integer width in which both literals are representable. This narrower
        # fact is safe to use without numeric premises: it contains no arithmetic and excludes
        # negative i64 payloads used to encode out-of-range unsigned literals.
        def proof_closed_literal_comparison(goal: Ast::Expr) -> bool:
            match proof_strip_parens(goal):
                Ast::Expr.Binary(left, operator, right, _):
                    return false if not proof_is_comparison(operator)
                    match proof_strip_parens(left):
                        Ast::Expr.IntLit(left_value, _):
                            match proof_strip_parens(right):
                                Ast::Expr.IntLit(right_value, _):
                                    return false if left_value < 0 or right_value < 0
                                    return left_value == right_value if operator == TokenKind.EqEq
                                    return left_value != right_value if operator == TokenKind.BangEq
                                    return left_value < right_value if operator == TokenKind.Lt
                                    return left_value > right_value if operator == TokenKind.Gt
                                    return left_value <= right_value if operator == TokenKind.LtEq
                                    return left_value >= right_value if operator == TokenKind.GtEq
                                    return false
                                _:
                                    return false
                        Ast::Expr.StringLit(left_value, _):
                            match proof_strip_parens(right):
                                Ast::Expr.StringLit(right_value, _):
                                    return left_value == right_value if operator == TokenKind.EqEq
                                    return left_value != right_value if operator == TokenKind.BangEq
                                    return false
                                _:
                                    return false
                        _:
                            return false
                _:
                    return false

        def proof_signed_add_type_bounds(facts: darray[Ast::Expr]&, bounds: mutable darray[ProofBound]&) -> void:
            for fact in facts |fact, bounds|:
                continue if not proof_marker_has_callee(fact, "__elisa_signed_type_bound")
                marker: (known: bool, term: Ast::Expr, width: i64) = proof_signed_marker_info(fact)
                continue if not marker.known
                name: sview = proof_ident_name(marker.term)
                continue if name == ""
                proof_add_lower(bounds, name, ElisaProofKernelCore::proof_kernel_signed_width_min(marker.width))
                proof_add_upper(bounds, name, ElisaProofKernelCore::proof_kernel_signed_width_max(marker.width))

        def proof_signed_guarded_subtraction_safe(expression: Ast::Expr, facts: darray[Ast::Expr]&, bounds: darray[ProofBound]&) -> bool:
            match expression:
                Ast::Expr.Binary(left, operator, right, _):
                    return false if operator != TokenKind.Minus
                    width: i64 = proof_signed_width_in_expression(expression, facts)
                    return false if width == 0 or proof_signed_width_in_expression(left, facts) != width or proof_signed_width_in_expression(right, facts) != width
                    right_interval: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_interval(right, bounds)
                    return right_interval.has_lower and right_interval.lower >= 0 and proof_has_order_fact(right, left, false, facts)
                _:
                    return false

        def proof_signed_nonnegative_sum_safe(expression: Ast::Expr, facts: darray[Ast::Expr]&, bounds: darray[ProofBound]&) -> bool can[Memory.Allocate, Abort.Panic]:
            match expression:
                Ast::Expr.Binary(left, operator, right, _):
                    return false if operator != TokenKind.Plus
                    width: i64 = proof_signed_width_in_expression(expression, facts)
                    return false if width == 0 or proof_signed_width_in_expression(left, facts) != width or proof_signed_width_in_expression(right, facts) != width
                    left_interval: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_interval(left, bounds)
                    right_interval: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_interval(right, bounds)
                    return false if not left_interval.has_lower or left_interval.lower < 0 or not right_interval.has_lower or right_interval.lower < 0
                    witness: (known: bool, bound: Ast::Expr, strict: bool) = proof_sum_upper_witness(left, right, facts)
                    bound_width: i64 = proof_signed_width_in_expression(witness.bound, facts)
                    return witness.known and bound_width > 0 and bound_width <= width
                _:
                    return false

        def proof_signed_increment_has_strict_peer(expression: Ast::Expr, facts: darray[Ast::Expr]&) -> bool:
            match expression:
                Ast::Expr.Binary(left, operator, right, _):
                    return false if operator != TokenKind.Plus
                    unit: (known: bool, base: Ast::Expr) = proof_unsigned_unit_increment_base(left, right)
                    return false if not unit.known
                    width: i64 = proof_signed_width_in_expression(unit.base, facts)
                    return false if width == 0
                    for fact in facts |unit, width, facts|:
                        order: (known: bool, left: Ast::Expr, operator: TokenKind, right: Ast::Expr) = proof_readable_order(fact, facts)
                        continue if not order.known
                        if order.operator == TokenKind.Lt and proof_expr_equal(order.left, unit.base):
                            peer_width: i64 = proof_signed_width_in_expression(order.right, facts)
                            return true if peer_width > 0 and peer_width <= width
                        if order.operator == TokenKind.Gt and proof_expr_equal(order.right, unit.base):
                            peer_width: i64 = proof_signed_width_in_expression(order.left, facts)
                            return true if peer_width > 0 and peer_width <= width
                _:
                    pass
            return false

        def proof_signed_expression_safe_with_bounds(expression: Ast::Expr, facts: darray[Ast::Expr]&, bounds: darray[ProofBound]&, depth: usize) -> bool:
            return false if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_signed_expression_safe_with_bounds(inner, facts, bounds, depth + 1)
                Ast::Expr.Unary(operator, operand, _):
                    return false if not proof_signed_expression_safe_with_bounds(operand, facts, bounds, depth + 1)
                    if operator == TokenKind.Minus:
                        width: i64 = proof_signed_width_in_expression(operand, facts)
                        if width != 0:
                            interval: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_interval(expression, bounds)
                            return interval.has_lower and interval.has_upper and interval.lower >= ElisaProofKernelCore::proof_kernel_signed_width_min(width) and interval.upper <= ElisaProofKernelCore::proof_kernel_signed_width_max(width)
                    return true
                Ast::Expr.Binary(left, operator, right, _):
                    return false if not proof_signed_expression_safe_with_bounds(left, facts, bounds, depth + 1)
                    return false if not proof_signed_expression_safe_with_bounds(right, facts, bounds, depth + 1)
                    arithmetic: bool = operator == TokenKind.Plus or operator == TokenKind.Minus or operator == TokenKind.Star or operator == TokenKind.Slash or operator == TokenKind.Percent or operator == TokenKind.LShift or operator == TokenKind.RShift or operator == TokenKind.Ampersand or operator == TokenKind.Pipe or operator == TokenKind.Caret
                    return true if not arithmetic
                    width: i64 = proof_signed_width_in_expression(expression, facts)
                    if width == 0:
                        return true if proof_unsigned_width_in_expression(expression, facts) != 0
                        constant: (known: bool, value: i64) = proof_constant_int(expression)
                        return constant.known and constant.value >= ElisaProofKernelCore::PROOF_KERNEL_I64_MIN and constant.value <= ElisaProofKernelCore::PROOF_KERNEL_I64_MAX if constant.known
                        # A range binder can be a witnessed primitive integer without carrying
                        # a signed/unsigned width marker. Admit only nonnegative intervals that
                        # fit even in the smallest supported integer type; that is safe for either
                        # signed arithmetic or unsigned arithmetic, including subtraction.
                        interval: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_interval(expression, bounds)
                        return interval.has_lower and interval.has_upper and interval.lower >= 0 and interval.upper <= ElisaProofKernelCore::PROOF_KERNEL_I8_MAX if proof_scalar_term_witnessed(expression, facts, depth + 1)
                        # A witnessed primitive integer with no signed-width trace is not safe to
                        # reinterpret using the host i64 model. Calls and overloaded terms are
                        # independently excluded by their witness/dispatch gates.
                        return not proof_scalar_term_witnessed(expression, facts, depth + 1)
                    interval: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_interval(expression, bounds)
                    return true if interval.has_lower and interval.has_upper and interval.lower >= ElisaProofKernelCore::proof_kernel_signed_width_min(width) and interval.upper <= ElisaProofKernelCore::proof_kernel_signed_width_max(width)
                    return true if proof_signed_guarded_subtraction_safe(expression, facts, bounds)
                    return true if proof_signed_nonnegative_sum_safe(expression, facts, bounds)
                    return proof_signed_increment_has_strict_peer(expression, facts) if width > 0
                    return false
                Ast::Expr.If(condition, then_expression, else_expression, _):
                    return proof_signed_expression_safe_with_bounds(condition, facts, bounds, depth + 1) and proof_signed_expression_safe_with_bounds(then_expression, facts, bounds, depth + 1) and proof_signed_expression_safe_with_bounds(else_expression, facts, bounds, depth + 1)
                Ast::Expr.Call(callee, arguments, _, _):
                    return false if not proof_signed_expression_safe_with_bounds(callee, facts, bounds, depth + 1)
                    for argument in arguments |argument, facts, bounds, depth|:
                        return false if not proof_signed_expression_safe_with_bounds(argument, facts, bounds, depth + 1)
                    return true
                _:
                    return true

        def proof_signed_expression_safe(expression: Ast::Expr, facts: darray[Ast::Expr]&) -> bool:
            bounds: mutable darray[ProofBound] = []
            for fact in facts |bounds|:
                proof_collect_bounds(fact, facts, &bounds)
            proof_close_equalities(facts, &bounds)
            proof_signed_add_type_bounds(facts, &bounds)
            constraints: mutable darray[ProofDifference] = []
            for fact in facts |fact, bounds, constraints|:
                proof_collect_difference_constraints(fact, bounds, facts, &constraints)
            if constraints.count <= PROOF_LINEAR_MAX_DIFFERENCE_CONSTRAINTS:
                proof_close_bounds_through_differences(constraints, &bounds)
            return proof_signed_expression_safe_with_bounds(expression, facts, bounds, 0)
