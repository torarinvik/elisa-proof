extend ElisaProof:
    private:
        const PROOF_CROSS_WIDTH_SAFE_INTEGER_MAX: i64 = ElisaProofKernelCore::PROOF_KERNEL_I8_MAX

        # A comparison between closed safe constants has the same truth value in every supported
        # integer width and consumes no premise, so unrelated unsigned facts in scope must not
        # suppress it. The kernel replays it through its constant-comparison rule.
        def proof_closed_safe_constant_comparison(goal: Ast::Expr) -> bool:
            return false if proof_has_ambiguous_integer_constant(goal, 0)
            match proof_strip_parens(goal):
                Ast::Expr.Binary(left, operator, right, _):
                    return false if not proof_is_comparison(operator)
                    a: (known: bool, value: i64) = proof_safe_comparison_constant(left)
                    b: (known: bool, value: i64) = proof_safe_comparison_constant(right)
                    return false if not a.known or not b.known
                    return a.value == b.value if operator == TokenKind.EqEq
                    return a.value != b.value if operator == TokenKind.BangEq
                    return a.value < b.value if operator == TokenKind.Lt
                    return a.value > b.value if operator == TokenKind.Gt
                    return a.value <= b.value if operator == TokenKind.LtEq
                    return a.value >= b.value if operator == TokenKind.GtEq
                    return false
                _:
                    return false

        # A premise comparing two closed safe constants that evaluates to false: no execution
        # reaches it, so its branch is shut. This is what closes the branch a callee's
        # `result == c or d > 0` summary leaves when the caller passed the literal `0`.
        def proof_closed_safe_constant_comparison_false(fact: Ast::Expr) -> bool:
            return false if proof_has_ambiguous_integer_constant(fact, 0)
            match proof_strip_parens(fact):
                Ast::Expr.Binary(left, operator, right, _):
                    return false if not proof_is_comparison(operator)
                    a: (known: bool, value: i64) = proof_safe_comparison_constant(left)
                    b: (known: bool, value: i64) = proof_safe_comparison_constant(right)
                    return false if not a.known or not b.known
                    return a.value != b.value if operator == TokenKind.EqEq
                    return a.value == b.value if operator == TokenKind.BangEq
                    return a.value >= b.value if operator == TokenKind.Lt
                    return a.value <= b.value if operator == TokenKind.Gt
                    return a.value > b.value if operator == TokenKind.LtEq
                    return a.value < b.value if operator == TokenKind.GtEq
                    return false
                _:
                    return false

        # A comparison between closed safe constants has the same truth value in every supported
        # integer width. Do not let unrelated unsigned facts in the surrounding context suppress
        # this fact: no premise is consumed by the comparison. Match the kernel's ambiguity guard
        # as well as its constant-comparison replay rule.
        def proof_closed_safe_constant_comparison_in(goal: Ast::Expr, facts: darray[Ast::Expr]&) -> bool:
            return false if proof_has_ambiguous_integer_constant(goal, 0)
            for fact in facts:
                return false if proof_has_ambiguous_integer_constant(fact, 0)
            match proof_strip_parens(goal):
                Ast::Expr.Binary(left, operator, right, _):
                    return false if not proof_is_comparison(operator)
                    a: (known: bool, value: i64) = proof_safe_comparison_constant(left)
                    b: (known: bool, value: i64) = proof_safe_comparison_constant(right)
                    return false if not a.known or not b.known
                    return a.value == b.value if operator == TokenKind.EqEq
                    return a.value != b.value if operator == TokenKind.BangEq
                    return a.value < b.value if operator == TokenKind.Lt
                    return a.value > b.value if operator == TokenKind.Gt
                    return a.value <= b.value if operator == TokenKind.LtEq
                    return a.value >= b.value if operator == TokenKind.GtEq
                    return false
                _:
                    return false

        # Search asks the source-neutral kernel for the same closed typed rule
        # that certificate replay will check. No signed-payload arithmetic or
        # premise-derived type guesses enter this path.
        def proof_typed_constant_guard_candidate(expression: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, depth: usize, work: mutable usize&) -> bool:
            return false if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT or work == 0
            work <- work - 1
            match proof_strip_parens(expression):
                Ast::Expr.Binary(a, operator, b, _):
                    if operator == TokenKind.And or operator == TokenKind.Or:
                        return proof_typed_constant_guard_candidate(a, annotations, depth + 1, work) and proof_typed_constant_guard_candidate(b, annotations, depth + 1, work)
                    return proof_is_comparison(operator) and proof_typed_constant_expression_candidate(a, annotations, depth + 1, work) and proof_typed_constant_expression_candidate(b, annotations, depth + 1, work)
                _:
                    return false

        def proof_typed_constant_expression_candidate(expression: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, depth: usize, work: mutable usize&) -> bool:
            return false if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT or work == 0
            work <- work - 1
            match proof_strip_parens(expression):
                Ast::Expr.IntLit(value, position):
                    return proof_replay_numeric_literal_sort(annotations, position.line, position.column, value).known or value >= 0
                Ast::Expr.Binary(left, operator, right, _):
                    return false if operator != TokenKind.Plus and operator != TokenKind.Minus and operator != TokenKind.RShift
                    return proof_typed_constant_expression_candidate(left, annotations, depth + 1, work) and proof_typed_constant_expression_candidate(right, annotations, depth + 1, work)
                Ast::Expr.If(condition, yes, no, _):
                    return proof_typed_constant_guard_candidate(condition, annotations, depth + 1, work) and proof_typed_constant_expression_candidate(yes, annotations, depth + 1, work) and proof_typed_constant_expression_candidate(no, annotations, depth + 1, work)
                _:
                    return false

        def proof_closed_typed_constant_comparison(goal: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, budget: mutable usize&, exhausted: mutable bool&) -> bool can[Global.Read, Global.Write]:
            return false if exhausted
            expression_cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(goal, budget, exhausted)
            return false if not expression_cost.complete
            # The candidate reader and annotated encoder traverse this restricted expression
            # separately. Reserve both passes before calling the bounded legacy reader.
            return false if not proof_linear_safety_work_charge_scaled(budget, exhausted, expression_cost.cost, 2)
            work: mutable usize = 4096
            match proof_strip_parens(goal):
                Ast::Expr.Binary(left, operator, right, _):
                    return false if not proof_is_comparison(operator)
                    left_candidate: bool = proof_typed_constant_expression_candidate(left, annotations, 0, &work)
                    if not left_candidate and work == 0:
                        exhausted <- true
                        return false
                    return false if not left_candidate
                    right_candidate: bool = proof_typed_constant_expression_candidate(right, annotations, 0, &work)
                    if not right_candidate and work == 0:
                        exhausted <- true
                        return false
                    return false if not right_candidate
                _:
                    return false
            nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
            children: mutable darray[usize] = []
            root: usize = proof_kernel_encode_annotated(goal, &nodes, &children, annotations)
            return false if root >= nodes.count
            comparison: ElisaProofKernelCore::ProofKernelNode = nodes[root]
            return false if comparison.left >= nodes.count or comparison.right >= nodes.count
            typed_value: (known: bool, value: bool) = ElisaProofKernelCore::typed_constant_expression_comparison_with_goal_work(&nodes, comparison.left, comparison.operator, comparison.right, &budget, PROOF_LINEAR_SAFETY_WORK_LIMIT)
            if budget > PROOF_LINEAR_SAFETY_WORK_LIMIT:
                exhausted <- true
                return false
            proven: mutable bool = typed_value.known and typed_value.value
            if not proven:
                contextual_value: (known: bool, value: bool) = ElisaProofKernelCore::contextual_unsigned_constant_comparison_with_goal_work(&nodes, comparison.left, comparison.operator, comparison.right, &budget, PROOF_LINEAR_SAFETY_WORK_LIMIT)
                if budget > PROOF_LINEAR_SAFETY_WORK_LIMIT:
                    exhausted <- true
                    return false
                proven <- contextual_value.known and contextual_value.value
            return false if not proven
            if nodes.count >= PROOF_LINEAR_SAFETY_WORK_LIMIT:
                budget <- PROOF_LINEAR_SAFETY_WORK_LIMIT
                exhausted <- true
                return false
            remaining_nodes: usize = PROOF_LINEAR_SAFETY_WORK_LIMIT - nodes.count
            if children.count >= remaining_nodes:
                budget <- PROOF_LINEAR_SAFETY_WORK_LIMIT
                exhausted <- true
                return false
            encoded_size: usize = nodes.count + children.count + 1
            return false if not proof_linear_safety_work_charge_scaled(budget, exhausted, encoded_size, PROOF_LINEAR_SAFETY_SCAN_MULTIPLIER)
            return (ElisaProofKernelReplay::proof_kernel_replay_goal_report(&nodes, &children, [], root) can Global{Read,Write})

        def proof_closed_typed_return_fits(expression: Ast::Expr, width: i64, annotations: darray[Ast::EnumAnnotation]&) -> bool:
            return false if width != 8 and width != 16 and width != 32 and width != 64
            work: mutable usize = 4096
            return false if not proof_typed_constant_expression_candidate(expression, annotations, 0, &work)
            nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
            children: mutable darray[usize] = []
            root: usize = proof_kernel_encode_annotated(expression, &nodes, &children, annotations)
            return ElisaProofKernelCore::typed_constant_expression_unsigned_width(&nodes, root) == width or ElisaProofKernelCore::contextual_constant_expression_unsigned_width(&nodes, root) == width

        def proof_signed_add_type_bounds(facts: darray[Ast::Expr]&, bounds: mutable darray[ProofBound]&) -> void:
            for fact in facts |fact, bounds|:
                continue if not proof_marker_has_callee(fact, "__elisa_signed_type_bound")
                marker: (known: bool, term: Ast::Expr, width: i64) = proof_signed_marker_info(fact)
                continue if not marker.known
                name: sview = proof_ident_name(marker.term)
                continue if name == ""
                proof_add_lower(bounds, name, ElisaProofKernelCore::proof_kernel_signed_width_min(marker.width))
                proof_add_upper(bounds, name, ElisaProofKernelCore::proof_kernel_signed_width_max(marker.width))

        def proof_signed_add_type_bounds_with_work(facts: darray[Ast::Expr]&, bounds: mutable darray[ProofBound]&, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            for fact in facts |fact, bounds, budget, exhausted|:
                callee: sview = proof_marker_callee_name(fact)
                return false if not proof_linear_safety_work_charge(budget, exhausted, 1) or not proof_linear_safety_work_charge(budget, exhausted, sview_len(callee))
                continue if callee != "__elisa_signed_type_bound"
                marker_nodes: mutable usize = 0
                return false if not proof_linear_safety_expression_shape_with_work(fact, 0, &marker_nodes, &budget, &exhausted)
                # Decoding inspects the call arguments and recursively parses the width
                # expression. Reserve a bounded pass over the measured AST before
                # invoking the legacy decoder.
                return false if not proof_linear_safety_work_charge_scaled(budget, exhausted, marker_nodes, 2)
                marker: (known: bool, term: Ast::Expr, width: i64) = proof_signed_marker_info(fact)
                continue if not marker.known
                name: sview = proof_ident_name(marker.term)
                continue if name == ""
                return false if:
                    not proof_linear_safety_work_charge(budget, exhausted, sview_len(name))
                    not proof_linear_safety_add_lower_with_work(&bounds, name, ElisaProofKernelCore::proof_kernel_signed_width_min(marker.width), budget, exhausted)
                    not proof_linear_safety_add_upper_with_work(&bounds, name, ElisaProofKernelCore::proof_kernel_signed_width_max(marker.width), budget, exhausted)
            return true

        def proof_signed_guarded_subtraction_safe(expression: Ast::Expr, facts: darray[Ast::Expr]&, bounds: darray[ProofBound]&, width: i64) -> bool:
            match expression:
                Ast::Expr.Binary(left, operator, right, _):
                    return false if:
                        operator != TokenKind.Minus
                        width == 0 or proof_signed_width_in_expression(left, facts) != width or proof_signed_width_in_expression(right, facts) != width
                    right_interval: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_interval(right, bounds)
                    return right_interval.has_lower and right_interval.lower >= 0 and proof_has_order_fact(right, left, false, facts)
                _:
                    return false

        def proof_signed_nonnegative_sum_safe(expression: Ast::Expr, facts: darray[Ast::Expr]&, bounds: darray[ProofBound]&, width: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            match expression:
                Ast::Expr.Binary(left, operator, right, _):
                    return false if:
                        operator != TokenKind.Plus
                        width == 0 or proof_signed_width_in_expression(left, facts) != width or proof_signed_width_in_expression(right, facts) != width
                    left_interval: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_interval(left, bounds)
                    right_interval: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_interval(right, bounds)
                    return false if not left_interval.has_lower or left_interval.lower < 0 or not right_interval.has_lower or right_interval.lower < 0
                    witness: (known: bool, bound: Ast::Expr, strict: bool) = proof_sum_upper_witness(left, right, facts)
                    return false if not witness.known
                    bound_width: i64 = proof_signed_width_in_expression(witness.bound, facts)
                    return bound_width > 0 and bound_width <= width
                _:
                    return false

        def proof_signed_increment_has_strict_peer(expression: Ast::Expr, facts: darray[Ast::Expr]&, width: i64) -> bool:
            # Reuse one marker index across candidate facts instead of rebuilding it per order.
            markers: ProofScalarWitnesses = proof_scalar_witness_markers(facts)
            return proof_signed_increment_has_strict_peer_with_markers(expression, facts, markers, width)

        def proof_signed_increment_has_strict_peer_with_markers(expression: Ast::Expr, facts: darray[Ast::Expr]&, markers: ProofScalarWitnesses&, width: i64) -> bool:
            match expression:
                Ast::Expr.Binary(left, operator, right, _):
                    return false if operator != TokenKind.Plus
                    unit: (known: bool, base: Ast::Expr) = proof_unsigned_unit_increment_base(left, right)
                    return false if:
                        not unit.known
                        width == 0
                    for fact in facts |unit, width, facts, markers|:
                        order: (known: bool, left: Ast::Expr, operator: TokenKind, right: Ast::Expr) = proof_readable_order_with_markers(fact, facts, markers)
                        continue if not order.known
                        if order.operator == TokenKind.Lt and proof_expr_equal(order.left, unit.base):
                            peer_width: i64 = proof_signed_width_in_expression(order.right, facts)
                            return true if peer_width > 0 and peer_width <= width
                        if order.operator == TokenKind.Gt and proof_expr_equal(order.right, unit.base):
                            peer_width: i64 = proof_signed_width_in_expression(order.left, facts)
                            return true if peer_width > 0 and peer_width <= width
                _:
                    pass
            return false

        def proof_signed_expression_safe_with_bounds(expression: Ast::Expr, facts: darray[Ast::Expr]&, bounds: darray[ProofBound]&, depth: usize) -> bool:
            budget: mutable usize = 0
            exhausted: mutable bool = false
            markers: (complete: bool, witnesses: ProofScalarWitnesses) = proof_scalar_witness_markers_with_work(facts, true, &budget, &exhausted)
            return false if not markers.complete or exhausted
            proof_signed_expression_safe_with_bounds_work(expression, facts, bounds, depth, markers.witnesses, &budget, &exhausted)

        # A signed name equal to a signed term, `p == v - g`, takes the term's interval when
        # every subterm of it is itself range-safe under the bounds so far: the machine value
        # is then the integer one, so the name lies in it. Kernel mirror:
        # `proof_kernel_replay_close_term_equalities`.
        def proof_close_term_equalities(facts: darray[Ast::Expr]&, bounds: mutable darray[ProofBound]&) -> void:
            for fact in facts |fact, facts, bounds|:
                match proof_strip_parens(fact):
                    Ast::Expr.Binary(left, TokenKind.EqEq, right, _):
                        for side in 0..<2 |side, left, right, facts, bounds|:
                            name_side: Ast::Expr = left if side == 0 else right
                            term_side: Ast::Expr = right if side == 0 else left
                            name: sview = proof_ident_name(name_side)
                            continue if name == "" or proof_ident_name(term_side) != ""
                            width: i64 = proof_signed_width_in_expression(name_side, facts)
                            continue if width <= 0 or proof_signed_width_in_expression(term_side, facts) != width
                            continue if not proof_signed_expression_safe_with_bounds(term_side, facts, bounds, 0)
                            interval: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_interval(term_side, bounds)
                            continue if not interval.has_lower or not interval.has_upper
                            continue if interval.lower < ElisaProofKernelCore::proof_kernel_signed_width_min(width) or interval.upper > ElisaProofKernelCore::proof_kernel_signed_width_max(width)
                            proof_add_lower(bounds, name, interval.lower)
                            proof_add_upper(bounds, name, interval.upper)
                    _:
                        pass

        def proof_close_term_equalities_with_work(facts: darray[Ast::Expr]&, bounds: mutable darray[ProofBound]&, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            markers_result: (complete: bool, witnesses: ProofScalarWitnesses) = proof_scalar_witness_markers_with_work(facts, true, budget, exhausted)
            return false if not markers_result.complete
            markers: ProofScalarWitnesses = markers_result.witnesses
            return proof_close_term_equalities_work_inner(facts, &bounds, markers, budget, exhausted)

        def proof_close_term_equalities_work_inner(facts: darray[Ast::Expr]&, bounds: mutable darray[ProofBound]&, markers: ProofScalarWitnesses&, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            marker_scale: (complete: bool, scale: usize) = proof_linear_safety_marker_scale_with_work(markers, budget, exhausted)
            return false if not marker_scale.complete
            for fact in facts |fact, facts, bounds, markers, marker_scale, budget, exhausted|:
                return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                match proof_strip_parens(fact):
                    Ast::Expr.Binary(left, TokenKind.EqEq, right, _):
                        for side in 0..<2 |side, left, right, facts, bounds, markers, marker_scale, budget, exhausted|:
                            return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                            name_side: Ast::Expr = left if side == 0 else right
                            term_side: Ast::Expr = right if side == 0 else left
                            name: sview = proof_ident_name(name_side)
                            continue if name == "" or proof_ident_name(term_side) != ""
                            width: i64 = proof_signed_width_in_expression_with_scale_work(name_side, markers, 0, marker_scale.scale, budget, exhausted)
                            return false if exhausted
                            continue if width <= 0
                            term_width: i64 = proof_signed_width_in_expression_with_scale_work(term_side, markers, 0, marker_scale.scale, budget, exhausted)
                            return false if exhausted
                            continue if term_width != width
                            safe: bool = proof_signed_expression_safe_with_bounds_work_inner_scaled(term_side, facts, bounds, 0, markers, marker_scale.scale, budget, exhausted)
                            return false if exhausted
                            continue if not safe
                            interval: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_interval_with_work(term_side, bounds, 0, budget, exhausted)
                            return false if exhausted
                            continue if not interval.has_lower or not interval.has_upper
                            continue if interval.lower < ElisaProofKernelCore::proof_kernel_signed_width_min(width) or interval.upper > ElisaProofKernelCore::proof_kernel_signed_width_max(width)
                            return false if:
                                not proof_linear_safety_add_lower_with_work(&bounds, name, interval.lower, budget, exhausted)
                                not proof_linear_safety_add_upper_with_work(&bounds, name, interval.upper, budget, exhausted)
                    _:
                        pass
            return true

        def proof_signed_expression_safe(expression: Ast::Expr, facts: darray[Ast::Expr]&) -> bool:
            bounds: darray[ProofBound] = proof_signed_safety_bounds(facts)
            return proof_signed_expression_safe_with_bounds(expression, facts, bounds, 0)

        # The intervals the signed guard reads. They depend on the facts alone, so a caller
        # guarding many terms under one fact list computes them once.
        def proof_signed_safety_bounds(facts: darray[Ast::Expr]&) -> darray[ProofBound]:
            bounds: mutable darray[ProofBound] = []
            proof_collect_fact_bounds(facts, &bounds)
            proof_close_equalities(facts, &bounds)
            return proof_signed_safety_bounds_from_base(facts, bounds)

        # Extend an already collected and equality-closed fact interval with signed-only facts.
        # The unsigned fact-list guard uses this to share its base closure without letting
        # signed-only inferences leak into the unsigned range check.
        def proof_signed_safety_bounds_from_base(facts: darray[Ast::Expr]&, base_bounds: darray[ProofBound]&) -> darray[ProofBound]:
            bounds: mutable darray[ProofBound] = []
            bounds.extend(base_bounds)
            proof_signed_add_type_bounds(facts, &bounds)
            proof_close_term_equalities(facts, &bounds)
            constraints: mutable darray[ProofDifference] = []
            proof_collect_fact_difference_constraints(facts, bounds, &constraints)
            if constraints.count <= PROOF_LINEAR_MAX_DIFFERENCE_CONSTRAINTS:
                proof_close_bounds_through_differences(constraints, &bounds)
            return bounds

        # The width a comparison operand is evaluated at, when every leaf of it is a
        # witnessed primitive term of one type. Closed constants carry no width of their own;
        # they are typed by the operand they meet. Zero means "not known", and a term with any
        # unwitnessed leaf, unmarked call, shift or bitwise operator is not known. An unsigned name
        # reports its width negated, so a signed and an unsigned leaf never agree on a width.
        # The declared signed width of a named call's result, read from a place marker whose
        # term is exactly that call. The general place reader keeps to terms rooted at a
        # binding, whose root governs retention and invalidation, so calls are read here.
        def proof_signed_call_marker_width(facts: darray[Ast::Expr]&, term: Ast::Expr) -> i64:
            return 0 if not proof_named_call_term(term)
            for fact in facts |term|:
                if proof_marker_callee_name(fact) == "__elisa_signed_place_type_bound":
                    match fact:
                        Ast::Expr.Call(_, arguments, argument_names, _):
                            if argument_names.count == 0 and arguments.count == 2:
                                width: (known: bool, value: i64) = proof_constant_int(arguments[1])
                                return width.value if width.known and ElisaProofKernelCore::proof_kernel_signed_width_valid(width.value) and proof_expr_equal(arguments[0], term)
                        _:
                            pass
            return 0

        def proof_strict_signed_width(expression: Ast::Expr, facts: darray[Ast::Expr]&, depth: usize) -> i64:
            return 0 if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            match expression:
                Ast::Expr.Ident(_, _) or Ast::Expr.Field(_, _, _) or Ast::Expr.Index(_, _, _) or Ast::Expr.IndexN(_, _, _):
                    unsigned_width: i64 = proof_unsigned_marker_width_for_name(facts, proof_ident_name(expression))
                    return 0 - unsigned_width if unsigned_width > 0 and proof_signed_marker_width_for_term(facts, expression) == 0
                    return 0 if not proof_scalar_term_witnessed(expression, facts, depth + 1)
                    return proof_signed_marker_width_for_term(facts, expression)
                Ast::Expr.Call(_, _, _, _):
                    # A witnessed call result carries its declared signed width as a place
                    # marker; an unsigned or undeclared result has none and stays untyped.
                    return 0 if not proof_scalar_term_witnessed(expression, facts, depth + 1)
                    return proof_signed_call_marker_width(facts, expression)
                Ast::Expr.Paren(inner, _):
                    return proof_strict_signed_width(inner, facts, depth + 1)
                Ast::Expr.Unary(operator, operand, _):
                    return 0 if operator != TokenKind.Minus and operator != TokenKind.Plus
                    return proof_strict_signed_width(operand, facts, depth + 1)
                Ast::Expr.Binary(left, operator, right, _):
                    return 0 if operator != TokenKind.Plus and operator != TokenKind.Minus and operator != TokenKind.Star and operator != TokenKind.Slash and operator != TokenKind.Percent
                    return proof_strict_joined_width(left, right, facts, depth + 1)
                Ast::Expr.If(_, then_expression, else_expression, _):
                    # A conditional has the type of its arms; its condition is typed on its own.
                    return proof_strict_joined_width(then_expression, else_expression, facts, depth + 1)
                _:
                    return 0

        # The one width two operands of a single type share, read from whichever are not closed.
        def proof_strict_joined_width(left: Ast::Expr, right: Ast::Expr, facts: darray[Ast::Expr]&, depth: usize) -> i64:
            return 0 if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            left_closed: bool = proof_closed_integer_arithmetic(left, depth)
            right_closed: bool = proof_closed_integer_arithmetic(right, depth)
            return 0 if left_closed and right_closed
            left_width: mutable i64 = 0
            left_width <- proof_strict_signed_width(left, facts, depth) if not left_closed
            right_width: mutable i64 = 0
            right_width <- proof_strict_signed_width(right, facts, depth) if not right_closed
            return 0 if:
                not left_closed and left_width == 0
                not right_closed and right_width == 0
                left_width != 0 and right_width != 0 and left_width != right_width
            return left_width if left_width != 0
            return right_width

        # The exact value of a closed constant evaluated at a width, known only when every
        # literal is a non-negative payload and every intermediate result fits. A negative width
        # is unsigned: its floor is zero, so a subtraction that would wrap is refused, and a
        # 64-bit value above the i64 ceiling is unrepresentable here and refused too.

include "./fixed_width_arithmetic_integrated_helpers.elisa"

include "./fixed_width_arithmetic_safety_work.elisa"
