extend ElisaProof:
    private:
        # Exact value of a closed ring term (literals, unary sign, +, -, *). Wrapping at any
        # width is reduction of this value modulo 2^w, so one exact value fixes every reading.
        def proof_closed_ring_value(expression: Ast::Expr, depth: usize) -> (known: bool, value: i64):
            return (false, 0) if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            match expression:
                Ast::Expr.IntLit(value, _):
                    return (true, value)
                Ast::Expr.Paren(inner, _):
                    return proof_closed_ring_value(inner, depth + 1)
                Ast::Expr.Unary(operator, operand, _):
                    inner: (known: bool, value: i64) = proof_closed_ring_value(operand, depth + 1)
                    return (false, 0) if not inner.known
                    return inner if operator == TokenKind.Plus
                    return proof_sub_safe(0, inner.value) if operator == TokenKind.Minus
                    return (false, 0)
                Ast::Expr.Binary(left, operator, right, _):
                    left_value: (known: bool, value: i64) = proof_closed_ring_value(left, depth + 1)
                    right_value: (known: bool, value: i64) = proof_closed_ring_value(right, depth + 1)
                    return (false, 0) if not left_value.known or not right_value.known
                    return proof_add_safe(left_value.value, right_value.value) if operator == TokenKind.Plus
                    return proof_sub_safe(left_value.value, right_value.value) if operator == TokenKind.Minus
                    return proof_mul_safe(left_value.value, right_value.value) if operator == TokenKind.Star
                    return (false, 0)
                _:
                    return (false, 0)

        # The value read at `bits` (8, 16, 32 or 64) and signedness, as an ordered pair: `high`
        # marks a u64 pattern at or above 2^63, which orders above every other value.
        def proof_closed_value_at_width(value: i64, bits: i64, signed: bool) -> (high: bool, low: i64):
            if bits >= 64:
                return (false, value) if signed
                return (value < 0, value)
            modulus: i64 = 256 if bits == 8 else (65536 if bits == 16 else 4294967296)
            reduced: mutable i64 = value % modulus
            reduced <- reduced + modulus if reduced < 0
            reduced <- reduced - modulus if signed and reduced >= modulus / 2
            return (false, reduced)

        def proof_closed_formula_at_width(expression: Ast::Expr, bits: i64, signed: bool, depth: usize) -> (known: bool, value: bool):
            return (false, false) if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            match expression:
                Ast::Expr.BoolLit(value, _):
                    return (true, value)
                Ast::Expr.Paren(inner, _):
                    return proof_closed_formula_at_width(inner, bits, signed, depth + 1)
                Ast::Expr.Unary(TokenKind.Not, operand, _):
                    inner: (known: bool, value: bool) = proof_closed_formula_at_width(operand, bits, signed, depth + 1)
                    return (inner.known, not inner.value)
                Ast::Expr.Binary(left, operator, right, _):
                    if operator == TokenKind.And or operator == TokenKind.Or or operator == TokenKind.FatArrow:
                        left_truth: (known: bool, value: bool) = proof_closed_formula_at_width(left, bits, signed, depth + 1)
                        right_truth: (known: bool, value: bool) = proof_closed_formula_at_width(right, bits, signed, depth + 1)
                        return (false, false) if not left_truth.known or not right_truth.known
                        return (true, left_truth.value and right_truth.value) if operator == TokenKind.And
                        return (true, left_truth.value or right_truth.value) if operator == TokenKind.Or
                        return (true, not left_truth.value or right_truth.value)
                    return (false, false) if not proof_is_comparison(operator)
                    left_exact: (known: bool, value: i64) = proof_closed_ring_value(left, depth + 1)
                    right_exact: (known: bool, value: i64) = proof_closed_ring_value(right, depth + 1)
                    return (false, false) if not left_exact.known or not right_exact.known
                    a: (high: bool, low: i64) = proof_closed_value_at_width(left_exact.value, bits, signed)
                    b: (high: bool, low: i64) = proof_closed_value_at_width(right_exact.value, bits, signed)
                    less: bool = (b.high and not a.high) or (a.high == b.high and a.low < b.low)
                    equal: bool = a.high == b.high and a.low == b.low
                    return (true, equal) if operator == TokenKind.EqEq
                    return (true, not equal) if operator == TokenKind.BangEq
                    return (true, less) if operator == TokenKind.Lt
                    return (true, less or equal) if operator == TokenKind.LtEq
                    return (true, not less and not equal) if operator == TokenKind.Gt
                    return (true, not less)
                _:
                    return (false, false)

        # A closed formula over ring terms whose truth is the same at every signed and unsigned
        # width 8..64 carries no width ambiguity: the unbounded-i64 reading has that truth too.
        # `(0 - 1) < 0 or (0 - 1) >= 22` holds at every width; `(0 - 1) < 0` alone does not.
        def proof_closed_formula_width_uniform(expression: Ast::Expr) -> bool:
            reference: (known: bool, value: bool) = proof_closed_formula_at_width(expression, 64, true, 0)
            return false if not reference.known
            for index in 0..<8 |index, expression, reference|:
                level: usize = index / 2
                bits: i64 = 8 if level == 0 else (16 if level == 1 else (32 if level == 2 else 64))
                reading: (known: bool, value: bool) = proof_closed_formula_at_width(expression, bits, index % 2 == 0, 0)
                return false if not reading.known or reading.value != reference.value
            return true

        # The ambiguity guard with typing evidence. A primitive comparison forces both
        # operands to one type, so when one side is a witnessed signed term of width w and
        # the other is too or is closed, each constant is read at w and admitted only if its
        # exact value fits there. Anything else falls back to the untyped guard.
        def proof_has_ambiguous_integer_constant_in(expression: Ast::Expr, facts: darray[Ast::Expr]&, depth: usize) -> bool:
            return true if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            return false if proof_closed_formula_width_uniform(expression)
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_has_ambiguous_integer_constant_in(inner, facts, depth + 1)
                Ast::Expr.Unary(TokenKind.Not, operand, _):
                    return proof_has_ambiguous_integer_constant_in(operand, facts, depth + 1)
                Ast::Expr.Binary(left, operator, right, _):
                    if operator == TokenKind.And or operator == TokenKind.Or or operator == TokenKind.FatArrow:
                        return proof_has_ambiguous_integer_constant_in(left, facts, depth + 1) or proof_has_ambiguous_integer_constant_in(right, facts, depth + 1)
                    if proof_is_comparison(operator):
                        left_closed: bool = proof_closed_integer_arithmetic(left, depth + 1)
                        right_closed: bool = proof_closed_integer_arithmetic(right, depth + 1)
                        left_width: mutable i64 = 0
                        left_width <- proof_strict_signed_width(left, facts, depth + 1) if not left_closed
                        right_width: mutable i64 = 0
                        right_width <- proof_strict_signed_width(right, facts, depth + 1) if not right_closed
                        typed: mutable bool = (left_closed or left_width != 0) and (right_closed or right_width != 0) and not (left_closed and right_closed)
                        typed <- false if left_width != 0 and right_width != 0 and left_width != right_width
                        width: i64 = left_width if left_width != 0 else right_width
                        return proof_ambiguous_constant_at_width(left, facts, width, depth + 1) or proof_ambiguous_constant_at_width(right, facts, width, depth + 1) if typed
                _:
                    pass
            return proof_has_ambiguous_integer_constant(expression, depth)
