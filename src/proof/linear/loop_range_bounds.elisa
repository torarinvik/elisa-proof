extend ElisaProof:
    public:
        # For-loop binders use a source-offset tuple atom so shadowed names cannot share facts.
        # Qualified scalar constants are also valid structural atoms: their exact expression is
        # the key, and the compiler-derived primitive-scalar marker rules out arbitrary paths.
        def proof_structural_bound_atom(term: Ast::Expr, facts: darray[Ast::Expr]&) -> bool:
            match term:
                Ast::Expr.Tuple(elements, _):
                    return false if elements.count != 2
                    match elements[0]:
                        Ast::Expr.Ident(name, _):
                            return false if name == ""
                        _:
                            return false
                    match elements[1]:
                        Ast::Expr.IntLit(_, _):
                            return proof_scalar_term_witnessed(term, facts, 0)
                        _:
                            return false
                Ast::Expr.Scope(_, member, _):
                    return member != "" and proof_scalar_term_witnessed(term, facts, 0)
                _:
                    return false

        def proof_bound_for_term(bounds: darray[ProofBound]&, term: Ast::Expr) -> ProofBound:
            for bound in bounds:
                if bound.term_key and proof_expr_equal(bound.term, term):
                    return bound
            return ProofBound{name: "", term: term, term_key: false, has_lower: false, lower: 0, has_upper: false, upper: 0}

        def proof_add_term_lower(bounds: mutable darray[ProofBound]&, term: Ast::Expr, value: i64) -> void:
            for mutable bound in bounds:
                if bound.term_key and proof_expr_equal(bound.term, term):
                    old_has: bool = bound.has_lower
                    old_value: i64 = bound.lower
                    bound.has_lower <- true
                    bound.lower <- value if not old_has or value > old_value
                    return
            bounds <- bounds.push(ProofBound{name: "", term: term, term_key: true, has_lower: true, lower: value, has_upper: false, upper: 0})

        def proof_add_term_upper(bounds: mutable darray[ProofBound]&, term: Ast::Expr, value: i64) -> void:
            for mutable bound in bounds:
                if bound.term_key and proof_expr_equal(bound.term, term):
                    old_has: bool = bound.has_upper
                    old_value: i64 = bound.upper
                    bound.has_upper <- true
                    bound.upper <- value if not old_has or value < old_value
                    return
            bounds <- bounds.push(ProofBound{name: "", term: term, term_key: true, has_lower: false, lower: 0, has_upper: true, upper: value})
