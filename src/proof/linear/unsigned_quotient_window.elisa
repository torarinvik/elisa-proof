# A half-open chunk window indexed below floor(total / size) ends within total.
# The goal is kept in the exact source shape `index * size + size <= total`; the
# kernel replays this independently and checks every participating usize width.
extend ElisaProof:
    private:
        def proof_unsigned_quotient_window_bound_goal(facts: darray[Ast::Expr]&, goal: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, operator_mask: usize, depth: usize, budget: mutable usize&, split_depth: usize, exhausted: mutable bool&) -> bool can[Global.Read, Global.Write]:
            can Memory.Allocate, Abort.Panic:
                return false if split_depth >= PROOF_LINEAR_CASE_SPLIT_DEPTH_LIMIT or not proof_comparison_goal_shape(goal)
                total: mutable Ast::Expr = Ast::Expr.Invalid
                index: mutable Ast::Expr = Ast::Expr.Invalid
                size: mutable Ast::Expr = Ast::Expr.Invalid
                product: mutable Ast::Expr = Ast::Expr.Invalid
                sum: mutable Ast::Expr = Ast::Expr.Invalid
                match proof_strip_parens(goal):
                    Ast::Expr.Binary(left, TokenKind.LtEq, right, _):
                        total <- right
                        sum <- proof_strip_parens(left)
                    _:
                        return false
                terms: (known: bool, index: Ast::Expr, size: Ast::Expr, product: Ast::Expr) = proof_unsigned_quotient_window_terms(sum, budget, exhausted)
                return false if:
                    exhausted
                    not terms.known
                index <- terms.index
                size <- terms.size
                product <- terms.product
                return false if not proof_unsigned_quotient_window_scalar_witness_work_charge(facts, goal, budget, exhausted)
                markers: ProofScalarWitnesses = proof_scalar_witness_markers(facts)
                return false if not proof_scalar_term_witnessed_in(index, markers, 0) or not proof_scalar_term_witnessed_in(size, markers, 0) or not proof_scalar_term_witnessed_in(total, markers, 0)
                width: i64 = proof_unsigned_quotient_window_width_in_expression(index, facts, 0, budget, exhausted)
                return false if:
                    exhausted or width == 0
                    proof_unsigned_quotient_window_width_in_expression(size, facts, 0, budget, exhausted) != width or exhausted
                    proof_unsigned_quotient_window_width_in_expression(total, facts, 0, budget, exhausted) != width or exhausted
                    proof_unsigned_quotient_window_width_in_expression(product, facts, 0, budget, exhausted) != width or exhausted
                    proof_unsigned_quotient_window_width_in_expression(sum, facts, 0, budget, exhausted) != width or exhausted
                position: Ast::Pos = Ast::expr_pos(size)
                zero: Ast::Expr = Ast::Expr.IntLit(0, position)
                positive_size: Ast::Expr = Ast::Expr.Binary(size, TokenKind.Gt, zero, position)
                return false if not (proof_goal_depth(facts, positive_size, annotations, operator_mask, depth + 1, budget, split_depth + 1, exhausted) can Global{Read,Write})
                quotient: Ast::Expr = Ast::Expr.Binary(total, TokenKind.Slash, size, position)
                proof_unsigned_quotient_window_index_fact(facts, index, quotient, width, 0, budget, exhausted)

        # Reserve one scalar marker index build plus its three recursive term queries. Each
        # query node can compare against every marker and each comparison can walk both terms, so
        # charge a quadratic term cost; width scans are separately charged per fact.
        def proof_unsigned_quotient_window_scalar_witness_work_charge(facts: darray[Ast::Expr]&, goal: Ast::Expr, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            if exhausted or budget >= PROOF_LINEAR_MAX_ENUMERATED_ELEMENTS:
                exhausted <- true
                return false
            remaining: usize = PROOF_LINEAR_MAX_ENUMERATED_ELEMENTS - budget
            facts_cost: mutable usize = 0
            for fact in facts |fact, facts_cost, budget, remaining, exhausted|:
                cost: mutable usize = 0
                if not proof_replay_summary_expr_cost_with_limit(fact, &cost, budget + facts_cost, PROOF_LINEAR_MAX_ENUMERATED_ELEMENTS):
                    exhausted <- true
                    return false
                if cost > remaining - facts_cost:
                    exhausted <- true
                    return false
                facts_cost <- facts_cost + cost
            goal_cost: mutable usize = 0
            if not proof_replay_summary_expr_cost_with_limit(goal, &goal_cost, budget + facts_cost, PROOF_LINEAR_MAX_ENUMERATED_ELEMENTS):
                exhausted <- true
                return false
            if goal_cost == 0:
                exhausted <- true
                return false
            if goal_cost > PROOF_LINEAR_MAX_ENUMERATED_ELEMENTS / 48 / goal_cost:
                exhausted <- true
                return false
            factor: usize = goal_cost * goal_cost * 48
            rows: usize = facts_cost + 1
            if rows > remaining / factor:
                exhausted <- true
                return false
            budget <- budget + rows * factor
            return true

        def proof_unsigned_quotient_window_width_charge(budget: mutable usize&, exhausted: mutable bool&) -> bool:
            if exhausted or budget >= PROOF_LINEAR_MAX_ENUMERATED_ELEMENTS:
                exhausted <- true
                return false
            budget <- budget + 1
            return true

        # Marker decoders inspect names and constant payloads, so charge the full bounded fact
        # AST size for every visit. Identifier lookup also compares the query name on each row.
        def proof_unsigned_quotient_window_width_fact_charge(fact: Ast::Expr, extra_text: usize, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            if exhausted or budget >= PROOF_LINEAR_MAX_ENUMERATED_ELEMENTS:
                exhausted <- true
                return false
            cost: mutable usize = 0
            if not proof_replay_summary_expr_cost_with_limit(fact, &cost, budget, PROOF_LINEAR_MAX_ENUMERATED_ELEMENTS):
                exhausted <- true
                return false
            remaining: usize = PROOF_LINEAR_MAX_ENUMERATED_ELEMENTS - budget
            if extra_text >= remaining or cost >= remaining - extra_text:
                exhausted <- true
                return false
            budget <- budget + cost + extra_text + 1
            return true

        def proof_unsigned_quotient_window_width_in_expression(expression: Ast::Expr, facts: darray[Ast::Expr]&, depth: usize, budget: mutable usize&, exhausted: mutable bool&) -> i64 can[Memory.Allocate, Abort.Panic]:
            if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT:
                exhausted <- true
                return 0
            return 0 if not proof_unsigned_quotient_window_width_charge(budget, exhausted)
            match expression:
                Ast::Expr.Ident(name, _):
                    width: mutable i64 = 0
                    for fact in facts |fact, name, width, budget, exhausted|:
                        return 0 if not proof_unsigned_quotient_window_width_fact_charge(fact, sview_len(name), budget, exhausted)
                        marker: (known: bool, name: sview, width: i64) = proof_unsigned_marker_info(fact)
                        continue if not marker.known or marker.name != name
                        width <- marker.width if width == 0 or marker.width < width
                    return width
                Ast::Expr.Field(_, _, _):
                    width: mutable i64 = 0
                    for fact in facts |fact, expression, width, budget, exhausted|:
                        return 0 if not proof_unsigned_quotient_window_width_fact_charge(fact, 0, budget, exhausted)
                        match fact:
                            Ast::Expr.Call(callee, arguments, argument_names, _):
                                continue if argument_names.count != 0 and argument_names.count != arguments.count
                                continue if proof_ident_name(callee) != "__elisa_unsigned_type_bound" or arguments.count != 2
                                matches: bool = proof_exact_division_expr_equal_with_budget(arguments[0], expression, budget, exhausted)
                                return 0 if exhausted
                                continue if not matches
                                marked: (known: bool, value: i64) = proof_constant_int(arguments[1])
                                continue if not marked.known or marked.value < ElisaProofKernelCore::PROOF_KERNEL_FIXED_WIDTH_MIN or marked.value > ElisaProofKernelCore::PROOF_KERNEL_MACHINE_WORD_BITS
                                width <- marked.value if width == 0 or marked.value < width
                            _:
                                pass
                    return width
                Ast::Expr.Index(_, _, _) | Ast::Expr.IndexN(_, _, _):
                    path: (known: bool, container: Ast::Expr, subscripts: i64) = proof_indexed_element_path(expression, 0)
                    return 0 if not path.known or path.subscripts == 0
                    width: mutable i64 = 0
                    for fact in facts |fact, path, width, budget, exhausted|:
                        return 0 if not proof_unsigned_quotient_window_width_fact_charge(fact, 0, budget, exhausted)
                        continue if not proof_marker_has_callee(fact, "__elisa_primitive_scalar_element")
                        marker: (known: bool, term: Ast::Expr, depth: i64, width: i64) = proof_element_marker_info(fact)
                        continue if not marker.known or marker.width == 0 or marker.depth != path.subscripts
                        matches: bool = proof_exact_division_expr_equal_with_budget(marker.term, path.container, budget, exhausted)
                        return 0 if exhausted
                        width <- marker.width if matches and (width == 0 or marker.width < width)
                    return width
                Ast::Expr.Paren(inner, _):
                    return proof_unsigned_quotient_window_width_in_expression(inner, facts, depth + 1, budget, exhausted)
                Ast::Expr.Unary(_, operand, _):
                    return proof_unsigned_quotient_window_width_in_expression(operand, facts, depth + 1, budget, exhausted)
                Ast::Expr.Binary(left, _, right, _):
                    left_width: i64 = proof_unsigned_quotient_window_width_in_expression(left, facts, depth + 1, budget, exhausted)
                    return 0 if exhausted
                    right_width: i64 = proof_unsigned_quotient_window_width_in_expression(right, facts, depth + 1, budget, exhausted)
                    return 0 if exhausted
                    return right_width if left_width == 0
                    return left_width if right_width == 0 or left_width < right_width
                    return right_width
                Ast::Expr.If(_, then_expression, else_expression, _):
                    then_width: i64 = proof_unsigned_quotient_window_width_in_expression(then_expression, facts, depth + 1, budget, exhausted)
                    return 0 if exhausted
                    else_width: i64 = proof_unsigned_quotient_window_width_in_expression(else_expression, facts, depth + 1, budget, exhausted)
                    return 0 if exhausted or then_width == 0 or else_width == 0
                    return then_width if then_width < else_width
                    return else_width
                Ast::Expr.Call(_, _, _, _):
                    return 0
                _:
                    return 0

        def proof_unsigned_quotient_window_index_fact(facts: darray[Ast::Expr]&, index: Ast::Expr, quotient: Ast::Expr, width: i64, depth: usize, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            requires depth <= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            decreases PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT - depth
            can Memory.Allocate, Abort.Panic:
                return false if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
                for fact in facts |fact, facts, index, quotient, depth, budget, exhausted|:
                    if budget >= PROOF_LINEAR_MAX_ENUMERATED_ELEMENTS:
                        exhausted <- true
                        return false
                    budget <- budget + 1
                    return true if proof_unsigned_quotient_window_index_in_fact(facts, fact, index, quotient, width, depth, budget, exhausted)
                    return false if exhausted
                return false

        def proof_unsigned_quotient_window_index_in_fact(facts: darray[Ast::Expr]&, fact: Ast::Expr, index: Ast::Expr, quotient: Ast::Expr, width: i64, depth: usize, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            requires depth <= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            decreases PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT - depth
            can Memory.Allocate, Abort.Panic:
                return false if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
                if budget >= PROOF_LINEAR_MAX_ENUMERATED_ELEMENTS:
                    exhausted <- true
                    return false
                budget <- budget + 1
                match proof_strip_parens(fact):
                    Ast::Expr.Binary(left, TokenKind.And, right, _):
                        return true if proof_unsigned_quotient_window_index_in_fact(facts, left, index, quotient, width, depth + 1, budget, exhausted)
                        return false if exhausted
                        proof_unsigned_quotient_window_index_in_fact(facts, right, index, quotient, width, depth + 1, budget, exhausted)
                    Ast::Expr.Binary(left, TokenKind.Lt, right, _):
                        if proof_exact_division_expr_equal_with_budget(left, index, budget, exhausted):
                            return proof_unsigned_quotient_window_bound_matches(facts, right, quotient, width, depth + 1, budget, exhausted)
                        return false if exhausted
                    Ast::Expr.Binary(left, TokenKind.Gt, right, _):
                        if proof_exact_division_expr_equal_with_budget(right, index, budget, exhausted):
                            return proof_unsigned_quotient_window_bound_matches(facts, left, quotient, width, depth + 1, budget, exhausted)
                        return false if exhausted
                    _:
                        return false
                return false

        def proof_unsigned_quotient_window_bound_matches(facts: darray[Ast::Expr]&, bound: Ast::Expr, quotient: Ast::Expr, width: i64, depth: usize, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            requires depth <= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            decreases PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT - depth
            can Memory.Allocate, Abort.Panic:
                return false if:
                    depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
                    proof_unsigned_quotient_window_width_in_expression(bound, facts, 0, budget, exhausted) != width or exhausted
                return true if proof_exact_division_expr_equal_with_budget(bound, quotient, budget, exhausted)
                return false if exhausted
                for fact in facts |fact, bound, quotient, depth, budget, exhausted|:
                    if budget >= PROOF_LINEAR_MAX_ENUMERATED_ELEMENTS:
                        exhausted <- true
                        return false
                    budget <- budget + 1
                    return true if proof_unsigned_quotient_window_equality_in_fact(fact, bound, quotient, depth, budget, exhausted)
                    return false if exhausted
                return false

        def proof_unsigned_quotient_window_equality_in_fact(fact: Ast::Expr, bound: Ast::Expr, quotient: Ast::Expr, depth: usize, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            requires depth <= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            decreases PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT - depth
            can Memory.Allocate, Abort.Panic:
                return false if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
                if budget >= PROOF_LINEAR_MAX_ENUMERATED_ELEMENTS:
                    exhausted <- true
                    return false
                budget <- budget + 1
                match proof_strip_parens(fact):
                    Ast::Expr.Binary(left, TokenKind.And, right, _):
                        return true if proof_unsigned_quotient_window_equality_in_fact(left, bound, quotient, depth + 1, budget, exhausted)
                        return false if exhausted
                        proof_unsigned_quotient_window_equality_in_fact(right, bound, quotient, depth + 1, budget, exhausted)
                    Ast::Expr.Binary(left, TokenKind.EqEq, right, _):
                        left_matches: bool = proof_exact_division_expr_equal_with_budget(left, bound, budget, exhausted)
                        return false if exhausted
                        if left_matches:
                            return proof_exact_division_expr_equal_with_budget(right, quotient, budget, exhausted)
                        right_matches: bool = proof_exact_division_expr_equal_with_budget(right, bound, budget, exhausted)
                        return false if exhausted or not right_matches
                        proof_exact_division_expr_equal_with_budget(left, quotient, budget, exhausted)
                    _:
                        return false
                return false

        def proof_unsigned_quotient_window_terms(sum: Ast::Expr, budget: mutable usize&, exhausted: mutable bool&) -> (known: bool, index: Ast::Expr, size: Ast::Expr, product: Ast::Expr):
            can Memory.Allocate, Abort.Panic:
                empty: (known: bool, index: Ast::Expr, size: Ast::Expr, product: Ast::Expr) = (false, Ast::Expr.Invalid, Ast::Expr.Invalid, Ast::Expr.Invalid)
                match proof_strip_parens(sum):
                    Ast::Expr.Binary(first, TokenKind.Plus, second, _):
                        match proof_strip_parens(first):
                            Ast::Expr.Binary(factor_left, TokenKind.Star, factor_right, _):
                                if proof_exact_division_expr_equal_with_budget(factor_left, second, budget, exhausted):
                                    return (true, factor_right, second, proof_strip_parens(first))
                                return empty if exhausted
                                if proof_exact_division_expr_equal_with_budget(factor_right, second, budget, exhausted):
                                    return (true, factor_left, second, proof_strip_parens(first))
                                return empty if exhausted
                                match proof_strip_parens(second):
                                    Ast::Expr.Binary(other_left, TokenKind.Star, other_right, _):
                                        if proof_exact_division_expr_equal_with_budget(other_left, first, budget, exhausted):
                                            return (true, other_right, first, proof_strip_parens(second))
                                        return empty if exhausted
                                        if proof_exact_division_expr_equal_with_budget(other_right, first, budget, exhausted):
                                            return (true, other_left, first, proof_strip_parens(second))
                                        return empty
                                    _:
                                        return empty
                            _:
                                match proof_strip_parens(second):
                                    Ast::Expr.Binary(factor_left, TokenKind.Star, factor_right, _):
                                        if proof_exact_division_expr_equal_with_budget(factor_left, first, budget, exhausted):
                                            return (true, factor_right, first, proof_strip_parens(second))
                                        return empty if exhausted
                                        if proof_exact_division_expr_equal_with_budget(factor_right, first, budget, exhausted):
                                            return (true, factor_left, first, proof_strip_parens(second))
                                        return empty
                                    _:
                                        return empty
                    _:
                        return empty
                empty
