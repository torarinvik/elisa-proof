extend ElisaProof:
    private:
        def proof_disjunction_strip_parens_with_work(expression: Ast::Expr, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, value: Ast::Expr):
            current: mutable Ast::Expr = expression
            while true |current, budget, exhausted|:
                return (false, Ast::Expr.Absent) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                match current:
                    Ast::Expr.Paren(inner, _):
                        current <- inner
                    _:
                        return (true, current)

        # Work-aware mirror of the legacy split finder. Charge every node on the search path;
        # and each synthesized wrapper before allocating branch expressions.
        def proof_disjunction_find_with_work(expression: Ast::Expr, budget: mutable usize&, exhausted: mutable bool&, depth: usize) -> (complete: bool, known: bool, left: Ast::Expr, right: Ast::Expr):
            return (false, false, Ast::Expr.Absent, Ast::Expr.Absent) if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT or not proof_linear_safety_work_charge(budget, exhausted, 1)
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_disjunction_find_with_work(inner, budget, exhausted, depth + 1)
                Ast::Expr.Binary(left, TokenKind.Or, right, _):
                    return (true, true, left, right)
                Ast::Expr.Binary(left, TokenKind.EqEq, Ast::Expr.If(condition, then_expression, else_expression, _), position):
                    return (false, false, Ast::Expr.Absent, Ast::Expr.Absent) if not proof_linear_safety_work_charge(budget, exhausted, 5)
                    negated: Ast::Expr = Ast::Expr.Unary(TokenKind.Not, condition, position)
                    return (true, true, Ast::Expr.Binary(condition, TokenKind.And, Ast::Expr.Binary(left, TokenKind.EqEq, then_expression, position), position), Ast::Expr.Binary(negated, TokenKind.And, Ast::Expr.Binary(left, TokenKind.EqEq, else_expression, position), position))
                Ast::Expr.Binary(left, TokenKind.And, right, position):
                    left_split: (complete: bool, known: bool, left: Ast::Expr, right: Ast::Expr) = proof_disjunction_find_with_work(left, budget, exhausted, depth + 1)
                    return (false, false, Ast::Expr.Absent, Ast::Expr.Absent) if not left_split.complete
                    if left_split.known:
                        return (false, false, Ast::Expr.Absent, Ast::Expr.Absent) if not proof_linear_safety_work_charge(budget, exhausted, 2)
                        return (true, true, Ast::Expr.Binary(left_split.left, TokenKind.And, right, position), Ast::Expr.Binary(left_split.right, TokenKind.And, right, position))
                    right_split: (complete: bool, known: bool, left: Ast::Expr, right: Ast::Expr) = proof_disjunction_find_with_work(right, budget, exhausted, depth + 1)
                    return (false, false, Ast::Expr.Absent, Ast::Expr.Absent) if not right_split.complete
                    if right_split.known:
                        return (false, false, Ast::Expr.Absent, Ast::Expr.Absent) if not proof_linear_safety_work_charge(budget, exhausted, 2)
                        return (true, true, Ast::Expr.Binary(left, TokenKind.And, right_split.left, position), Ast::Expr.Binary(left, TokenKind.And, right_split.right, position))
                Ast::Expr.Unary(TokenKind.Not, operand, _):
                    stripped: (complete: bool, value: Ast::Expr) = proof_disjunction_strip_parens_with_work(operand, budget, exhausted)
                    return (false, false, Ast::Expr.Absent, Ast::Expr.Absent) if not stripped.complete
                    match stripped.value:
                        Ast::Expr.Binary(left, TokenKind.And, right, position):
                            return (false, false, Ast::Expr.Absent, Ast::Expr.Absent) if not proof_linear_safety_work_charge(budget, exhausted, 2)
                            return (true, true, Ast::Expr.Unary(TokenKind.Not, left, position), Ast::Expr.Unary(TokenKind.Not, right, position))
                        _:
                            pass
                _:
                    pass
            return (true, false, expression, expression)

