# Shared-budget reader for the unsigned span cursor shortcut.
extend ElisaProof:
    private:
        def proof_unsigned_span_push_conjuncts_with_work(expression: Ast::Expr, conjuncts: mutable darray[Ast::Expr]&, depth: usize, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            stripped: (complete: bool, expression: Ast::Expr) = proof_linear_strip_parens_with_work(expression, budget, exhausted)
            return false if not stripped.complete or not proof_linear_safety_work_charge(budget, exhausted, 1)
            if depth < ElisaProofKernelCore::PROOF_KERNEL_STRUCTURAL_SCAN_DEPTH_LIMIT:
                match stripped.expression:
                    Ast::Expr.Binary(left, TokenKind.And, right, _):
                        return false if not proof_unsigned_span_push_conjuncts_with_work(left, conjuncts, depth + 1, budget, exhausted)
                        return proof_unsigned_span_push_conjuncts_with_work(right, conjuncts, depth + 1, budget, exhausted)
                    _:
                        pass
            return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
            conjuncts.push(stripped.expression)
            return true

        def proof_unsigned_span_cursor_fallback_with_work(facts: darray[Ast::Expr]&, goal: Ast::Expr, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            goal_view: (complete: bool, expression: Ast::Expr) = proof_linear_strip_parens_with_work(goal, budget, exhausted)
            if not goal_view.complete or exhausted:
                exhausted <- true
                return false
            match goal_view.expression:
                Ast::Expr.Binary(left, operator, right, _):
                    nonnegative: (complete: bool, proven: bool) = proof_unsigned_nonnegative_goal_with_work(left, operator, right, facts, budget, exhausted)
                    if not nonnegative.complete or exhausted:
                        exhausted <- true
                        return false
                    return true if nonnegative.proven
                _:
                    return false
            span_cursor: (complete: bool, proven: bool) = proof_unsigned_span_cursor_bound_with_work(facts, goal, budget, exhausted)
            if not span_cursor.complete or exhausted:
                exhausted <- true
                return false
            return span_cursor.proven

        def proof_unsigned_span_cursor_bound_with_work(facts: darray[Ast::Expr]&, goal: Ast::Expr, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, proven: bool):
            goal_cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(goal, budget, exhausted)
            return (false, false) if not goal_cost.complete
            goal_view: (complete: bool, expression: Ast::Expr) = proof_linear_strip_parens_with_work(goal, budget, exhausted)
            return (false, false) if not goal_view.complete
            goal_left: mutable Ast::Expr = Ast::Expr.Invalid
            goal_right: mutable Ast::Expr = Ast::Expr.Invalid
            goal_operator: mutable TokenKind = TokenKind.Eof
            match goal_view.expression:
                Ast::Expr.Binary(left, operator, right, _):
                    return (true, false) if operator != TokenKind.LtEq and operator != TokenKind.GtEq
                    goal_left <- left
                    goal_right <- right
                    goal_operator <- operator
                _:
                    return (true, false)
            markers_result: (complete: bool, witnesses: ProofScalarWitnesses) = proof_scalar_witness_markers_with_work(facts, false, budget, exhausted)
            return (false, false) if not markers_result.complete or exhausted
            markers: ProofScalarWitnesses = markers_result.witnesses
            marker_scale_result: (complete: bool, scale: usize) = proof_linear_safety_marker_scale_with_work(markers, budget, exhausted)
            return (false, false) if not marker_scale_result.complete
            marker_scale: usize = marker_scale_result.scale
            fact_scan_cost: mutable usize = 0
            for fact in facts |fact, fact_scan_cost, budget, exhausted|:
                return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                fact_cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(fact, budget, exhausted)
                return (false, false) if not fact_cost.complete
                return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, fact_cost.cost)
                if fact_scan_cost >= PROOF_LINEAR_SAFETY_WORK_LIMIT or fact_cost.cost > PROOF_LINEAR_SAFETY_WORK_LIMIT - fact_scan_cost - 1:
                    exhausted <- true
                    return (false, false)
                fact_scan_cost <- fact_scan_cost + fact_cost.cost + 1
            conjuncts: mutable darray[Ast::Expr] = []
            for fact in facts |fact, conjuncts, budget, exhausted|:
                return (false, false) if not proof_unsigned_span_push_conjuncts_with_work(fact, &conjuncts, 0, budget, exhausted)
            order_lefts: mutable darray[Ast::Expr] = []
            order_operators: mutable darray[TokenKind] = []
            order_rights: mutable darray[Ast::Expr] = []
            for fact in conjuncts |fact, facts, markers, marker_scale, fact_scan_cost, order_lefts, order_operators, order_rights, budget, exhausted|:
                readable: (complete: bool, known: bool, left: Ast::Expr, operator: TokenKind, right: Ast::Expr) = proof_linear_readable_order_with_work(fact, facts, markers, marker_scale, fact_scan_cost, budget, exhausted)
                return (false, false) if not readable.complete or exhausted
                if readable.known:
                    return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 3)
                    order_lefts.push(readable.left)
                    order_operators.push(readable.operator)
                    order_rights.push(readable.right)
            match goal_view.expression:
                Ast::Expr.Binary(difference, TokenKind.LtEq, bound, _):
                    difference_view: (complete: bool, expression: Ast::Expr) = proof_linear_strip_parens_with_work(difference, budget, exhausted)
                    return (false, false) if not difference_view.complete
                    match difference_view.expression:
                        Ast::Expr.Binary(first, TokenKind.Minus, second, _):
                            first_match: bool = proof_unsigned_witness_terms_equal_with_work(first, bound, budget, exhausted)
                            return (false, false) if exhausted
                            if first_match and proof_ident_name(first) != "" and proof_ident_name(second) != "":
                                first_width: i64 = proof_unsigned_width_in_expression_with_work(first, markers, budget, exhausted)
                                return (false, false) if exhausted
                                second_width: i64 = proof_unsigned_width_in_expression_with_work(second, markers, budget, exhausted)
                                return (false, false) if exhausted
                                if first_width != 0 and first_width == second_width:
                                    for order_index in 0..<order_lefts.count |order_index, order_lefts, order_operators, order_rights, first, second, budget, exhausted|:
                                        return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                                        forward: bool = order_operators[order_index] == TokenKind.Lt or order_operators[order_index] == TokenKind.LtEq
                                        reverse: bool = order_operators[order_index] == TokenKind.Gt or order_operators[order_index] == TokenKind.GtEq
                                        matches: bool = forward and proof_unsigned_witness_terms_equal_with_work(order_lefts[order_index], second, budget, exhausted) and proof_unsigned_witness_terms_equal_with_work(order_rights[order_index], first, budget, exhausted)
                                        matches <- matches or (reverse and proof_unsigned_witness_terms_equal_with_work(order_rights[order_index], second, budget, exhausted) and proof_unsigned_witness_terms_equal_with_work(order_lefts[order_index], first, budget, exhausted))
                                        return (false, false) if exhausted
                                        return (true, true) if matches
                        _:
                            pass
                _:
                    pass
            for fact in facts |fact, goal_left, goal_right, goal_operator, markers, budget, exhausted|:
                fact_view: (complete: bool, expression: Ast::Expr) = proof_linear_strip_parens_with_work(fact, budget, exhausted)
                return (false, false) if not fact_view.complete
                match fact_view.expression:
                    Ast::Expr.Binary(step, TokenKind.LtEq, span, _):
                        span_view: (complete: bool, expression: Ast::Expr) = proof_linear_strip_parens_with_work(span, budget, exhausted)
                        return (false, false) if not span_view.complete
                        start: mutable Ast::Expr = Ast::Expr.Invalid
                        end: mutable Ast::Expr = Ast::Expr.Invalid
                        match span_view.expression:
                            Ast::Expr.Binary(span_end, TokenKind.Minus, span_start, _):
                                start <- span_start
                                end <- span_end
                            _:
                                continue
                        continue if proof_ident_name(start) == "" or proof_ident_name(end) == "" or proof_ident_name(step) == ""
                        start_width: i64 = proof_unsigned_width_in_expression_with_work(start, markers, budget, exhausted)
                        return (false, false) if exhausted
                        continue if start_width == 0
                        end_width: i64 = proof_unsigned_width_in_expression_with_work(end, markers, budget, exhausted)
                        return (false, false) if exhausted
                        continue if end_width != start_width
                        step_width: i64 = proof_unsigned_width_in_expression_with_work(step, markers, budget, exhausted)
                        return (false, false) if exhausted
                        continue if step_width != start_width
                        ordered: mutable bool = false
                        for order_index in 0..<order_lefts.count |order_index, order_lefts, order_operators, order_rights, start, end, budget, exhausted|:
                            return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                            low: bool = order_operators[order_index] == TokenKind.Lt and (proof_unsigned_witness_terms_equal_with_work(order_lefts[order_index], start, budget, exhausted) and proof_unsigned_witness_terms_equal_with_work(order_rights[order_index], end, budget, exhausted))
                            reverse_low: bool = order_operators[order_index] == TokenKind.Gt and (proof_unsigned_witness_terms_equal_with_work(order_rights[order_index], start, budget, exhausted) and proof_unsigned_witness_terms_equal_with_work(order_lefts[order_index], end, budget, exhausted))
                            low_equal: bool = order_operators[order_index] == TokenKind.LtEq and (proof_unsigned_witness_terms_equal_with_work(order_lefts[order_index], start, budget, exhausted) and proof_unsigned_witness_terms_equal_with_work(order_rights[order_index], end, budget, exhausted))
                            reverse_equal: bool = order_operators[order_index] == TokenKind.GtEq and (proof_unsigned_witness_terms_equal_with_work(order_rights[order_index], start, budget, exhausted) and proof_unsigned_witness_terms_equal_with_work(order_lefts[order_index], end, budget, exhausted))
                            return (false, false) if exhausted
                            ordered <- low or reverse_low or low_equal or reverse_equal
                            break if ordered
                        continue if not ordered
                        position: Ast::Pos = Ast::expr_pos(span)
                        sum: Ast::Expr = Ast::Expr.Binary(start, TokenKind.Plus, step, position)
                        difference: Ast::Expr = Ast::Expr.Binary(end, TokenKind.Minus, step, position)
                        low_goal: Ast::Expr = goal_right if goal_operator == TokenKind.GtEq else goal_left
                        high_goal: Ast::Expr = goal_left if goal_operator == TokenKind.GtEq else goal_right
                        equal_low: bool = proof_unsigned_witness_terms_equal_with_work(low_goal, sum, budget, exhausted)
                        return (false, false) if exhausted
                        equal_high: bool = proof_unsigned_witness_terms_equal_with_work(high_goal, end, budget, exhausted)
                        return (false, false) if exhausted
                        return (true, true) if equal_low and equal_high
                        equal_low <- proof_unsigned_witness_terms_equal_with_work(low_goal, start, budget, exhausted)
                        return (false, false) if exhausted
                        equal_high <- proof_unsigned_witness_terms_equal_with_work(high_goal, sum, budget, exhausted)
                        return (false, false) if exhausted
                        return (true, true) if equal_low and equal_high
                        equal_low <- proof_unsigned_witness_terms_equal_with_work(low_goal, difference, budget, exhausted)
                        return (false, false) if exhausted
                        equal_high <- proof_unsigned_witness_terms_equal_with_work(high_goal, end, budget, exhausted)
                        return (false, false) if exhausted
                        return (true, true) if equal_low and equal_high
                        equal_low <- proof_unsigned_witness_terms_equal_with_work(low_goal, start, budget, exhausted)
                        return (false, false) if exhausted
                        equal_high <- proof_unsigned_witness_terms_equal_with_work(high_goal, difference, budget, exhausted)
                        return (false, false) if exhausted
                        return (true, true) if equal_low and equal_high
                    _:
                        pass
            return (not exhausted, false)
