# Signed disequality from exact primitive scalar facts. A signed type witness
# and representable constants are required for both production and replay.
extend ElisaProof:
    private:
        def proof_signed_constant_fits(expression: Ast::Expr, width: i64) -> bool:
            return false if not ElisaProofKernelCore::proof_kernel_signed_width_valid(width)
            constant: (known: bool, value: i64) = proof_signed_literal_comparison_constant(expression)
            return constant.known and constant.value >= ElisaProofKernelCore::proof_kernel_signed_width_min(width) and constant.value <= ElisaProofKernelCore::proof_kernel_signed_width_max(width)

        def proof_signed_disequality_constant(expression: Ast::Expr, facts: darray[Ast::Expr]&) -> (known: bool, term: Ast::Expr, value: i64):
            match proof_strip_parens(expression):
                Ast::Expr.Binary(term, TokenKind.BangEq, constant, _):
                    width: i64 = proof_signed_width_in_expression(term, facts)
                    parsed: (known: bool, value: i64) = proof_signed_literal_comparison_constant(constant)
                    return (false, Ast::Expr.Invalid, 0) if width == 0 or not parsed.known or not proof_signed_constant_fits(constant, width)
                    return (false, Ast::Expr.Invalid, 0) if not proof_primitive_comparison(term, constant, facts)
                    return (true, term, parsed.value)
                _:
                    return (false, Ast::Expr.Invalid, 0)

        def proof_signed_distinct_disequality_disjunction(goal: Ast::Expr, facts: darray[Ast::Expr]&) -> bool:
            match proof_strip_parens(goal):
                Ast::Expr.Binary(left, TokenKind.Or, right, _):
                    first: (known: bool, term: Ast::Expr, value: i64) = proof_signed_disequality_constant(left, facts)
                    second: (known: bool, term: Ast::Expr, value: i64) = proof_signed_disequality_constant(right, facts)
                    return false if not first.known or not second.known or first.value == second.value
                    return proof_expr_equal(first.term, second.term)
                _:
                    return false

        def proof_signed_disequality_from_equality_fact(goal: Ast::Expr, facts: darray[Ast::Expr]&) -> bool:
            match proof_strip_parens(goal):
                Ast::Expr.Binary(term, TokenKind.BangEq, constant, _):
                    width: i64 = proof_signed_width_in_expression(term, facts)
                    target: (known: bool, value: i64) = proof_signed_literal_comparison_constant(constant)
                    return false if width == 0 or not target.known or not proof_signed_constant_fits(constant, width)
                    return false if not proof_primitive_comparison(term, constant, facts)
                    for fact in facts |fact, term, width, target|:
                        match proof_strip_parens(fact):
                            Ast::Expr.Binary(left, TokenKind.EqEq, right, _):
                                if proof_expr_equal(term, left) and proof_primitive_comparison(left, right, facts):
                                    known_value: (known: bool, value: i64) = proof_signed_literal_comparison_constant(right)
                                    return true if known_value.known and proof_signed_constant_fits(right, width) and known_value.value != target.value
                                if proof_expr_equal(term, right) and proof_primitive_comparison(left, right, facts):
                                    known_value: (known: bool, value: i64) = proof_signed_literal_comparison_constant(left)
                                    return true if known_value.known and proof_signed_constant_fits(left, width) and known_value.value != target.value
                            _:
                                pass
                _:
                    pass
            return false
