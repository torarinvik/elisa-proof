extend ElisaProof:
    private:
        # A bounded signed-place-plus-literal conversion preserves value only
        # when both source arithmetic and the destination interval are safe.
        # Keep this separate from type-wide unsigned widening.
        def proof_bounded_u8_receiver(receiver: Ast::Expr, facts: darray[Ast::Expr]&) -> bool:
            expression: Ast::Expr = proof_strip_parens(receiver)
            match expression:
                Ast::Expr.Binary(base, TokenKind.Plus, literal, _):
                    match base:
                        Ast::Expr.Ident(_, _) or Ast::Expr.Field(_, _, _) or Ast::Expr.Tuple(_, _):
                            pass
                        _:
                            return false
                    match literal:
                        Ast::Expr.IntLit(value, _):
                            return false if value < 0 or value > 255
                        _:
                            return false
                    return false if proof_signed_width_in_expression(base, facts) == 0
                    return false if not proof_scalar_term_witnessed(base, facts, 0)
                    return false if not proof_signed_expression_safe(expression, facts)
                    bounds: mutable darray[ProofBound] = []
                    for fact in facts |bounds|:
                        proof_collect_bounds(fact, facts, &bounds)
                    proof_close_equalities(facts, &bounds)
                    interval = proof_interval(expression, bounds)
                    return interval.has_lower and interval.has_upper and interval.lower >= 0 and interval.upper <= 255
                _:
                    return false

        # Only reserved unsigned conversions with a source width witness. No
        # narrowing, signedness change, float conversion or inferred call type.
        def proof_unsigned_widening_receiver(expression: Ast::Expr, facts: darray[Ast::Expr]&) -> (known: bool, receiver: Ast::Expr):
            match expression:
                Ast::Expr.Call(callee, arguments, _, _):
                    return (false, expression) if arguments.count != 0
                    match callee:
                        Ast::Expr.Field(receiver, target, _):
                            if target == "u8" and proof_bounded_u8_receiver(receiver, facts):
                                return (true, proof_strip_parens(receiver))
                            # Compound expressions may mix signed/float operands.
                            # Require an exact place type, not propagated widths.
                            match receiver:
                                Ast::Expr.Ident(_, _) or Ast::Expr.Field(_, _, _) or Ast::Expr.Index(_, _, _) or Ast::Expr.IndexN(_, _, _):
                                    pass
                                _:
                                    return (false, expression)
                            target_width: i64 = 8 if target == "u8" else 16 if target == "u16" else 32 if target == "u32" else 64 if target == "u64" else 0
                            source_width: i64 = proof_unsigned_width_in_expression(receiver, facts)
                            valid: bool = target_width > 0 and source_width > 0 and source_width <= target_width and proof_scalar_term_witnessed(receiver, facts, 0)
                            return (valid, receiver)
                        _:
                            pass
                _:
                    pass
            return (false, expression)

        def proof_unsigned_widening_comparison(goal: Ast::Expr, facts: darray[Ast::Expr]&) -> (known: bool, goal: Ast::Expr):
            match proof_strip_parens(goal):
                Ast::Expr.Binary(left, operator, right, position):
                    return (false, goal) if not proof_is_comparison(operator)
                    first: (known: bool, receiver: Ast::Expr) = proof_unsigned_widening_receiver(left, facts)
                    second: (known: bool, receiver: Ast::Expr) = proof_unsigned_widening_receiver(right, facts)
                    return (false, goal) if not first.known and not second.known
                    return (true, Ast::Expr.Binary(first.receiver if first.known else left, operator, second.receiver if second.known else right, position))
                _:
                    return (false, goal)
