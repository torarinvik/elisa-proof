extend ElisaProof:
    private:
        # A bounded signed-place-plus-literal conversion preserves value only when source
        # arithmetic and the destination interval are safe. Build one metered marker/bound
        # context for this check instead of rebuilding scalar witnesses once per fact.
        def proof_bounded_u8_receiver_with_work(receiver: Ast::Expr, facts: darray[Ast::Expr]&, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, accepted: bool):
            can Abort.Panic:
                expression_view: (complete: bool, expression: Ast::Expr) = proof_linear_strip_parens_with_work(receiver, budget, exhausted)
                return (false, false) if not expression_view.complete or proof_goal_bool_ref_value(exhausted)
                match expression_view.expression:
                    Ast::Expr.Binary(base, TokenKind.Plus, literal, _):
                        match base:
                            Ast::Expr.Ident(_, _) | Ast::Expr.Field(_, _, _) | Ast::Expr.Tuple(_, _):
                                pass
                            _:
                                return (true, false)
                        match literal:
                            Ast::Expr.IntLit(value, _):
                                return (true, false) if value < 0 or value > 255
                            _:
                                return (true, false)
                        markers_result: (complete: bool, witnesses: ProofScalarWitnesses) = proof_scalar_witness_markers_with_work(facts, true, budget, exhausted)
                        return (false, false) if not markers_result.complete or proof_goal_bool_ref_value(exhausted)
                        markers: mutable ProofScalarWitnesses = markers_result.witnesses
                        marker_scale: (complete: bool, scale: usize) = proof_linear_safety_marker_scale_with_work(markers, budget, exhausted)
                        return (false, false) if not marker_scale.complete or proof_goal_bool_ref_value(exhausted)
                        width: i64 = proof_signed_width_in_expression_with_scale_work(base, markers, 0, marker_scale.scale, budget, exhausted)
                        return (false, false) if proof_goal_bool_ref_value(exhausted)
                        return (true, false) if width == 0
                        witnessed: (complete: bool, matches: bool) = proof_linear_safety_scalar_witness_with_work(base, markers, marker_scale.scale, budget, exhausted)
                        return (false, false) if not witnessed.complete or proof_goal_bool_ref_value(exhausted)
                        return (true, false) if not witnessed.matches
                        bounds: mutable darray[ProofBound] = []
                        if not proof_collect_fact_bounds_with_work(facts, markers, &bounds, budget, exhausted):
                            exhausted <- true
                            return (false, false)
                        if not proof_close_equalities_with_work(facts, markers, &bounds, budget, exhausted):
                            exhausted <- true
                            return (false, false)
                        signed_bounds: mutable darray[ProofBound] = []
                        if not proof_signed_safety_bounds_from_base_with_work(facts, bounds, &signed_bounds, markers, budget, exhausted):
                            exhausted <- true
                            return (false, false)
                        safe: bool = proof_signed_expression_safe_with_bounds_work(expression_view.expression, facts, signed_bounds, 0, markers, budget, exhausted)
                        return (false, false) if proof_goal_bool_ref_value(exhausted)
                        return (true, false) if not safe
                        interval: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_interval_with_work(expression_view.expression, bounds, 0, budget, exhausted)
                        return (false, false) if proof_goal_bool_ref_value(exhausted)
                        return (true, interval.has_lower and interval.has_upper and interval.lower >= 0 and interval.upper <= 255)
                    _:
                        return (true, false)
