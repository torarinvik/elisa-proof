extend ElisaProof:
    public:
        # The scalar-witness judgements recurse over every subterm and, at each node, looked for
        # the untrusted-operator, primitive-scalar and element markers among the selected
        # markers, parsing each marker again on every visit. The markers are decoded once here
        # into one list per kind, keeping their order, so each node compares against the
        # already-parsed terms only. Every list holds exactly the markers the old scans
        # accepted, so each judgement is unchanged.
        struct ProofScalarWitnesses:
            # Known `__elisa_untrusted_operator_type` terms.
            untrusted_terms: mutable darray[Ast::Expr]
            # Known `__elisa_primitive_scalar_type` arguments.
            scalar_terms: mutable darray[Ast::Expr]
            # Non-empty bare names from scalar-type and unsigned-width markers.
            names: mutable darray[sview]
            # Known `__elisa_primitive_scalar_element` terms and depths, in fact order.
            element_terms: mutable darray[Ast::Expr]
            element_depths: mutable darray[i64]

        def proof_scalar_witness_markers(facts: darray[Ast::Expr]&) -> ProofScalarWitnesses:
            witnesses: mutable ProofScalarWitnesses = ProofScalarWitnesses{untrusted_terms: [], scalar_terms: [], names: [], element_terms: [], element_depths: []}
            for fact in facts |witnesses|:
                callee: sview = proof_marker_callee_name(fact)
                if callee == "__elisa_untrusted_operator_type":
                    untrusted: (known: bool, term: Ast::Expr, protocol: sview) = proof_untrusted_operator_marker_info(fact)
                    witnesses.untrusted_terms.push(untrusted.term) if untrusted.known
                elif callee == "__elisa_primitive_scalar_type":
                    argument: (known: bool, term: Ast::Expr) = proof_marker_argument(fact, "__elisa_primitive_scalar_type")
                    if argument.known:
                        witnesses.scalar_terms.push(argument.term)
                        name: sview = proof_ident_name(argument.term)
                        witnesses.names.push(name) if name != ""
                elif callee == "__elisa_primitive_scalar_element":
                    element: (known: bool, term: Ast::Expr, depth: i64, width: i64) = proof_element_marker_info(fact)
                    if element.known:
                        witnesses.element_terms.push(element.term)
                        witnesses.element_depths.push(element.depth)
                elif callee == "__elisa_unsigned_type_bound":
                    unsigned_name: sview = proof_unsigned_marker_name(fact)
                    witnesses.names.push(unsigned_name) if unsigned_name != ""
            return witnesses

        def proof_scalar_witnesses_name(witnesses: ProofScalarWitnesses&, name: sview) -> bool:
            return false if name == ""
            return any known in witnesses.names where known == name
