# Keep the common hash lookup bounded, with an exact sorted fallback for collision-heavy inputs.
const PROOF_SCALAR_WITNESS_NAME_PROBE_LIMIT: usize = 64

extend ElisaProof:
    public:
        # The scalar-witness judgements recurse over every subterm and, at each node, looked for
        # the untrusted-operator, primitive-scalar and element markers among the selected
        # markers, parsing each marker again on every visit. The markers are decoded once here
        # into one list per kind, keeping their order, so each node compares against the
        # already-parsed terms only. Every list holds exactly the markers the old scans
        # accepted, so each judgement is unchanged.
        struct ProofScalarWitnesses:
            # Known `__elisa_untrusted_operator_type` terms.
            untrusted_terms: mutable darray[Ast::Expr]
            # Known `__elisa_primitive_scalar_type` arguments.
            scalar_terms: mutable darray[Ast::Expr]
            # Non-empty bare names from scalar-type and unsigned-width markers.
            names: mutable darray[sview]
            # Minimum declared unsigned width for each indexed name; zero means none.
            name_unsigned_widths: mutable darray[i64]
            # Ordered signed-width markers, including non-name places, for exact-term queries.
            signed_terms: mutable darray[Ast::Expr]
            signed_widths: mutable darray[i64]
            # Known `__elisa_primitive_scalar_element` terms and depths, in fact order.
            element_terms: mutable darray[Ast::Expr]
            element_depths: mutable darray[i64]
            element_widths: mutable darray[i64]
            # Exact terms and widths from unsigned type-bound markers, including call results.
            unsigned_terms: mutable darray[Ast::Expr]
            unsigned_widths: mutable darray[i64]
            # Collision-safe open-addressed lookup for `names`; slots store an index into the
            # ordered source list so exact equality remains authoritative.
            name_hashes: mutable darray[u32]
            name_slots: mutable darray[usize]
            # Exact deterministic fallback, sorted by name without changing source order above.
            sorted_name_indices: mutable darray[usize]
            # Shape hashes narrow exact signed/unsigned term lookups; slots retain source row indices.
            signed_hashes: mutable darray[u32]
            signed_slots: mutable darray[usize]
            unsigned_hashes: mutable darray[u32]
            unsigned_slots: mutable darray[usize]

        # Build a bounded exact-term index. Shape hashes only choose candidates; exact AST
        # equality remains authoritative. Duplicate rows retain the first signed width, while
        # unsigned exact-term markers merge to their narrowest width just as the legacy lookup did.
    private:
        def proof_scalar_witness_term_index_build(terms: darray[Ast::Expr]&, widths: mutable darray[i64]&, hashes: mutable darray[u32]&, slots: mutable darray[usize]&, merge_min_width: bool, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            can Abort.Panic:
                return false if terms.count != widths.count or proof_goal_bool_ref_value(exhausted)
                return true if terms.count == 0
                if terms.count > PROOF_LINEAR_SAFETY_WORK_LIMIT / 2:
                    exhausted <- true
                    return false
                capacity: mutable usize = 1
                target: usize = terms.count * 2
                while capacity < target |capacity, target, budget, exhausted|:
                    return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                    if capacity > PROOF_LINEAR_SAFETY_WORK_LIMIT / 2:
                        exhausted <- true
                        return false
                    capacity <- capacity * 2
                return false if not proof_linear_safety_work_charge(budget, exhausted, capacity) or not proof_linear_safety_work_charge(budget, exhausted, terms.count)
                hashes.resize(terms.count)
                slots.resize(capacity)
                for slot in 0..<capacity |slot, slots, terms, budget, exhausted|:
                    return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                    slots[slot] <- terms.count
                for row in 0..<terms.count |row, terms, widths, hashes, slots, capacity, merge_min_width, budget, exhausted|:
                    cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(terms[row], budget, exhausted)
                    return false if not cost.complete or not proof_linear_safety_work_charge(budget, exhausted, cost.cost)
                    hash: u32 = proof_expr_shape_hash(terms[row], 0)
                    slot: mutable usize = (hash.i64() % capacity.i64()).usize()
                    probes: mutable usize = 0
                    placed: mutable bool = false
                    while probes < capacity |probes, row, terms, widths, hashes, slots, capacity, merge_min_width, hash, slot, budget, exhausted|:
                        return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                        existing: usize = slots[slot]
                        if existing >= terms.count:
                            slots[slot] <- row
                            hashes[row] <- hash
                            placed <- true
                            break
                        if hashes[existing] == hash:
                            equal: bool = proof_unsigned_witness_terms_equal_with_work(terms[existing], terms[row], budget, exhausted)
                            return false if proof_goal_bool_ref_value(exhausted)
                            if equal:
                                if merge_min_width:
                                    widths[existing] <- proof_scalar_witness_merge_unsigned_width(widths[existing], widths[row])
                                placed <- true
                                break
                        slot <- (slot + 1) % capacity
                        probes <- probes + 1
                    if not placed:
                        exhausted <- true
                        return false
                return true

        def proof_scalar_witness_bare_name(expression: Ast::Expr, depth: usize) -> (complete: bool, name: sview):
            return (false, "") if depth >= PROOF_UNSIGNED_PLACE_DEPTH_LIMIT
            match expression:
                Ast::Expr.Ident(name, _):
                    return (true, name)
                Ast::Expr.Paren(inner, _):
                    return proof_scalar_witness_bare_name(inner, depth + 1)
                _:
                    return (true, "")

        def proof_scalar_witness_bare_name_with_work(expression: Ast::Expr, budget: mutable usize&, exhausted: mutable bool&, depth: usize) -> (complete: bool, name: sview):
            return (false, "") if depth >= PROOF_UNSIGNED_PLACE_DEPTH_LIMIT or not proof_linear_safety_work_charge(budget, exhausted, 1)
            match expression:
                Ast::Expr.Ident(name, _):
                    return (false, "") if not proof_linear_safety_work_charge(budget, exhausted, sview_len(name))
                    return (true, name)
                Ast::Expr.Paren(inner, _):
                    return proof_scalar_witness_bare_name_with_work(inner, budget, exhausted, depth + 1)
                _:
                    return (true, "")

    public:
        def proof_scalar_witness_markers(facts: darray[Ast::Expr]&) -> ProofScalarWitnesses:
            witnesses: mutable ProofScalarWitnesses = ProofScalarWitnesses{untrusted_terms: [], scalar_terms: [], names: [], name_unsigned_widths: [], signed_terms: [], signed_widths: [], element_terms: [], element_depths: [], element_widths: [], unsigned_terms: [], unsigned_widths: [], name_hashes: [], name_slots: [], sorted_name_indices: [], signed_hashes: [], signed_slots: [], unsigned_hashes: [], unsigned_slots: []}
            for fact in facts |witnesses|:
                callee: sview = proof_marker_callee_name(fact)
                if callee == "__elisa_untrusted_operator_type":
                    untrusted: (known: bool, term: Ast::Expr, protocol: sview) = proof_untrusted_operator_marker_info(fact)
                    witnesses.untrusted_terms.push(untrusted.term) if untrusted.known
                elif callee in {"__elisa_primitive_scalar_type", "__elisa_primitive_integer_type"}:
                    argument: (known: bool, term: Ast::Expr) = proof_marker_argument(fact, "__elisa_primitive_scalar_type")
                    if argument.known:
                        witnesses.scalar_terms.push(argument.term)
                        named: (complete: bool, name: sview) = proof_scalar_witness_bare_name(argument.term, 0)
                        if named.complete and named.name != "":
                            name: sview = named.name
                            witnesses.names.push(name)
                            witnesses.name_unsigned_widths.push(0)
                elif callee == "__elisa_primitive_scalar_element":
                    element: (known: bool, term: Ast::Expr, depth: i64, width: i64) = proof_element_marker_info(fact)
                    if element.known:
                        witnesses.element_terms.push(element.term)
                        witnesses.element_depths.push(element.depth)
                        witnesses.element_widths.push(element.width)
                elif callee == "__elisa_unsigned_type_bound":
                    marker: (known: bool, term: Ast::Expr, width: i64) = proof_unsigned_exact_term_marker_info(fact)
                    if marker.known:
                        named: (complete: bool, name: sview) = proof_scalar_witness_bare_name(marker.term, 0)
                        if named.complete and named.name != "":
                            name: sview = named.name
                            witnesses.names.push(name)
                            witnesses.name_unsigned_widths.push(marker.width)
                        if proof_place_root_name(marker.term, 0) != "":
                            match marker.term:
                                Ast::Expr.Tuple(_, _):
                                    witnesses.scalar_terms.push(marker.term)
                                _:
                                    pass
                        witnesses.unsigned_terms.push(marker.term)
                        witnesses.unsigned_widths.push(marker.width)
            # Keep `names` in source order for diagnostics and differential checks. The hash
            # table is the common-case index; build an exact sorted fallback only if a collision
            # cluster exceeds the bounded probe window.
            capacity: mutable usize = 1 if witnesses.names.count > 0 else 0
            target: usize = witnesses.names.count * 2
            while capacity > 0 and capacity < target |capacity, target|:
                capacity <- capacity * 2
            if capacity > 0:
                witnesses.name_slots.resize(capacity)
                witnesses.name_hashes.resize(witnesses.names.count)
                for name_index in 0..<witnesses.names.count |name_index, witnesses|:
                    witnesses.name_hashes[name_index] <- proof_name_hash(witnesses.names[name_index])
                for slot in 0..<capacity |slot, witnesses, capacity|:
                    witnesses.name_slots[slot] <- witnesses.names.count
                needs_sorted_fallback: mutable bool = false
                for name_index in 0..<witnesses.names.count |name_index, witnesses, capacity, needs_sorted_fallback|:
                    hash: u32 = witnesses.name_hashes[name_index]
                    slot: mutable usize = (hash.i64() % capacity.i64()).usize()
                    probes: mutable usize = 0
                    placed: mutable bool = false
                    while probes < capacity and probes < PROOF_SCALAR_WITNESS_NAME_PROBE_LIMIT |probes, slot, hash, name_index, witnesses, capacity, placed|:
                        existing: usize = witnesses.name_slots[slot]
                        if existing >= witnesses.names.count:
                            witnesses.name_slots[slot] <- name_index
                            placed <- true
                            break
                        if witnesses.name_hashes[existing] == hash and witnesses.names[existing] == witnesses.names[name_index]:
                            width: i64 = proof_scalar_witness_merge_unsigned_width(witnesses.name_unsigned_widths[existing], witnesses.name_unsigned_widths[name_index])
                            witnesses.name_unsigned_widths[existing] <- width
                            witnesses.name_unsigned_widths[name_index] <- width
                            placed <- true
                            break
                        slot <- (slot + 1) % capacity
                        probes <- probes + 1
                    needs_sorted_fallback <- true if not placed
                if needs_sorted_fallback:
                    for name_index in 0..<witnesses.names.count |name_index, witnesses|:
                        witnesses.sorted_name_indices.push(name_index)
                    proof_scalar_witness_name_indices_sort(&witnesses.sorted_name_indices, witnesses.names)
                    proof_scalar_witness_merge_sorted_unsigned_widths(witnesses.sorted_name_indices, witnesses.names, &witnesses.name_unsigned_widths)
            return witnesses

        def proof_scalar_witness_indexed_term_width_with_work(term: Ast::Expr, terms: darray[Ast::Expr]&, widths: darray[i64]&, hashes: darray[u32]&, slots: darray[usize]&, budget: mutable usize&, exhausted: mutable bool&) -> (indexed: bool, width: i64):
            can Abort.Panic:
                return (false, 0) if hashes.count == 0 and slots.count == 0
                if hashes.count != terms.count or terms.count != widths.count or slots.count < terms.count:
                    exhausted <- true
                    return (true, 0)
                cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(term, budget, exhausted)
                return (true, 0) if not cost.complete or not proof_linear_safety_work_charge(budget, exhausted, cost.cost)
                hash: u32 = proof_expr_shape_hash(term, 0)
                capacity: usize = slots.count
                slot: mutable usize = (hash.i64() % capacity.i64()).usize()
                probes: mutable usize = 0
                while probes < capacity |probes, slot, hash, term, terms, widths, hashes, slots, capacity, budget, exhausted|:
                    return (true, 0) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                    current: usize = slots[slot]
                    return (true, 0) if current == terms.count
                    if current >= terms.count:
                        exhausted <- true
                        return (true, 0)
                    if hashes[current] == hash:
                        equal: bool = proof_unsigned_witness_terms_equal_with_work(terms[current], term, budget, exhausted)
                        return (true, 0) if proof_goal_bool_ref_value(exhausted)
                        return (true, widths[current]) if equal
                    slot <- (slot + 1) % capacity
                    probes <- probes + 1
                exhausted <- true
                return (true, 0)


        def proof_scalar_witness_merge_unsigned_width(first: i64, second: i64) -> i64:
            return second if first == 0
            return first if second == 0 or first <= second
            return second

        def proof_scalar_witness_merge_sorted_unsigned_widths(indices: darray[usize]&, names: darray[sview]&, widths: mutable darray[i64]&) -> void:
            start: mutable usize = 0
            while start < indices.count |start, indices, names, widths|:
                first_index: usize = indices[start]
                name: sview = names[first_index]
                width: mutable i64 = 0
                end: mutable usize = start
                while end < indices.count |end, indices, names, widths, name, width|:
                    current: usize = indices[end]
                    if names[current] != name:
                        break
                    width <- proof_scalar_witness_merge_unsigned_width(width, widths[current])
                    end <- end + 1
                for member in start..<end |member, indices, widths, width|:
                    widths[indices[member]] <- width
                start <- end

        # Budgeted counterpart for source-driven proof search. Each fact's syntax walk and
        # marker decode are charged before decoding; name hashing, collision probes, and the
        # rare exact-sort fallback are charged at the operations that perform them. Exhaustion
        # returns no partially built witness index.
        def proof_scalar_witness_markers_with_work(facts: darray[Ast::Expr]&, include_signed_markers: bool, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, witnesses: ProofScalarWitnesses):
            can Abort.Panic:
                empty: ProofScalarWitnesses = ProofScalarWitnesses{untrusted_terms: [], scalar_terms: [], names: [], name_unsigned_widths: [], signed_terms: [], signed_widths: [], element_terms: [], element_depths: [], element_widths: [], unsigned_terms: [], unsigned_widths: [], name_hashes: [], name_slots: [], sorted_name_indices: [], signed_hashes: [], signed_slots: [], unsigned_hashes: [], unsigned_slots: []}
                return (false, empty) if proof_goal_bool_ref_value(exhausted)
                witnesses: mutable ProofScalarWitnesses = empty
                for fact in facts |fact, witnesses, budget, exhausted|:
                    return (false, empty) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                    nodes: mutable usize = 0
                    return (false, empty) if not proof_linear_safety_expression_shape_with_work(fact, 0, &nodes, budget, exhausted)
                    callee: sview = proof_marker_callee_name(fact)
                    return (false, empty) if:
                        not proof_linear_safety_work_charge(budget, exhausted, 5)
                        not proof_linear_safety_work_charge_scaled(budget, exhausted, sview_len(callee), 5)
                    if callee == "__elisa_untrusted_operator_type":
                        return (false, empty) if not proof_linear_safety_work_charge_scaled(budget, exhausted, nodes, 2)
                        untrusted: (known: bool, term: Ast::Expr, protocol: sview) = proof_untrusted_operator_marker_info(fact)
                        if untrusted.known:
                            return (false, empty) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                            witnesses.untrusted_terms.push(untrusted.term)
                    elif callee in {"__elisa_primitive_scalar_type", "__elisa_primitive_integer_type"}:
                        return (false, empty) if not proof_linear_safety_work_charge_scaled(budget, exhausted, nodes, 2)
                        argument: (known: bool, term: Ast::Expr) = proof_marker_argument(fact, "__elisa_primitive_scalar_type")
                        if argument.known:
                            return (false, empty) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                            witnesses.scalar_terms.push(argument.term)
                            named: (complete: bool, name: sview) = proof_scalar_witness_bare_name_with_work(argument.term, budget, exhausted, 0)
                            return (false, empty) if not named.complete
                            name: sview = named.name
                            if name != "":
                                return (false, empty) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                                witnesses.names.push(name)
                                witnesses.name_unsigned_widths.push(0)
                    elif callee == "__elisa_primitive_scalar_element":
                        return (false, empty) if not proof_linear_safety_work_charge_scaled(budget, exhausted, nodes, 2)
                        element: (known: bool, term: Ast::Expr, depth: i64, width: i64) = proof_element_marker_info(fact)
                        if element.known:
                            return (false, empty) if not proof_linear_safety_work_charge(budget, exhausted, 3)
                            witnesses.element_terms.push(element.term)
                            witnesses.element_depths.push(element.depth)
                            witnesses.element_widths.push(element.width)
                    elif callee == "__elisa_unsigned_type_bound":
                        return (false, empty) if not proof_linear_safety_work_charge_scaled(budget, exhausted, nodes, 3)
                        marker: (known: bool, term: Ast::Expr, width: i64) = proof_unsigned_exact_term_marker_info(fact)
                        if marker.known:
                            named: (complete: bool, name: sview) = proof_scalar_witness_bare_name_with_work(marker.term, budget, exhausted, 0)
                            return (false, empty) if not named.complete
                            name: sview = named.name
                            if name != "":
                                return (false, empty) if not proof_linear_safety_work_charge(budget, exhausted, 2)
                                witnesses.names.push(name)
                                witnesses.name_unsigned_widths.push(marker.width)
                            if proof_place_root_name(marker.term, 0) != "":
                                match marker.term:
                                    Ast::Expr.Tuple(_, _):
                                        return (false, empty) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                                        witnesses.scalar_terms.push(marker.term)
                                    _:
                                        pass
                            return (false, empty) if not proof_linear_safety_work_charge(budget, exhausted, 2)
                            witnesses.unsigned_terms.push(marker.term)
                            witnesses.unsigned_widths.push(marker.width)
                    elif include_signed_markers and callee == "__elisa_signed_type_bound":
                        return (false, empty) if not proof_linear_safety_work_charge_scaled(budget, exhausted, nodes, 3)
                        marker: (known: bool, term: Ast::Expr, width: i64) = proof_signed_marker_info(fact)
                        if marker.known:
                            return (false, empty) if not proof_linear_safety_work_charge(budget, exhausted, 2)
                            witnesses.signed_terms.push(marker.term)
                            witnesses.signed_widths.push(marker.width)
                    elif include_signed_markers and callee == "__elisa_signed_place_type_bound":
                        return (false, empty) if not proof_linear_safety_work_charge_scaled(budget, exhausted, nodes, 3)
                        marker: (known: bool, term: Ast::Expr, width: i64) = proof_signed_place_marker_info(fact)
                        if marker.known:
                            return (false, empty) if not proof_linear_safety_work_charge(budget, exhausted, 2)
                            witnesses.signed_terms.push(marker.term)
                            witnesses.signed_widths.push(marker.width)
                capacity: mutable usize = 1 if witnesses.names.count > 0 else 0
                if witnesses.names.count > PROOF_LINEAR_SAFETY_WORK_LIMIT / 2:
                    exhausted <- true
                    return (false, empty)
                target: usize = witnesses.names.count * 2
                while capacity > 0 and capacity < target |capacity, target, budget, exhausted|:
                    return (false, empty) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                    if capacity > PROOF_LINEAR_SAFETY_WORK_LIMIT / 2:
                        exhausted <- true
                        return (false, empty)
                    capacity <- capacity * 2
                if capacity > 0:
                    return (false, empty) if not proof_linear_safety_work_charge(budget, exhausted, capacity) or not proof_linear_safety_work_charge(budget, exhausted, witnesses.names.count)
                    witnesses.name_slots.resize(capacity)
                    witnesses.name_hashes.resize(witnesses.names.count)
                    for name_index in 0..<witnesses.names.count |name_index, witnesses, budget, exhausted|:
                        name: sview = witnesses.names[name_index]
                        return (false, empty) if not proof_linear_safety_work_charge(budget, exhausted, 1) or not proof_linear_safety_work_charge(budget, exhausted, sview_len(name))
                        witnesses.name_hashes[name_index] <- proof_name_hash(name)
                    for slot in 0..<capacity |slot, witnesses, capacity, budget, exhausted|:
                        return (false, empty) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                        witnesses.name_slots[slot] <- witnesses.names.count
                    needs_sorted_fallback: mutable bool = false
                    for name_index in 0..<witnesses.names.count |name_index, witnesses, capacity, needs_sorted_fallback, budget, exhausted|:
                        hash: u32 = witnesses.name_hashes[name_index]
                        slot: mutable usize = (hash.i64() % capacity.i64()).usize()
                        probes: mutable usize = 0
                        placed: mutable bool = false
                        while probes < capacity |probes, slot, hash, name_index, witnesses, capacity, placed, budget, exhausted|:
                            return (false, empty) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                            existing: usize = witnesses.name_slots[slot]
                            if existing >= witnesses.names.count:
                                witnesses.name_slots[slot] <- name_index
                                placed <- true
                                break
                            if witnesses.name_hashes[existing] == hash:
                                first: sview = witnesses.names[existing]
                                second: sview = witnesses.names[name_index]
                                return (false, empty) if not proof_linear_safety_work_charge(budget, exhausted, sview_len(first)) or not proof_linear_safety_work_charge(budget, exhausted, sview_len(second))
                                if first == second:
                                    width: i64 = proof_scalar_witness_merge_unsigned_width(witnesses.name_unsigned_widths[existing], witnesses.name_unsigned_widths[name_index])
                                    return (false, empty) if not proof_linear_safety_work_charge(budget, exhausted, 2)
                                    witnesses.name_unsigned_widths[existing] <- width
                                    witnesses.name_unsigned_widths[name_index] <- width
                                    placed <- true
                                    break
                            slot <- (slot + 1) % capacity
                            probes <- probes + 1
                        needs_sorted_fallback <- true if not placed
                    if needs_sorted_fallback:
                        for name_index in 0..<witnesses.names.count |name_index, witnesses, budget, exhausted|:
                            return (false, empty) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                            witnesses.sorted_name_indices.push(name_index)
                        if not proof_scalar_witness_name_indices_sort_with_work(&witnesses.sorted_name_indices, witnesses.names, budget, exhausted):
                            return (false, empty)
                        if not proof_scalar_witness_merge_sorted_unsigned_widths_with_work(&witnesses.sorted_name_indices, witnesses.names, &witnesses.name_unsigned_widths, budget, exhausted):
                            return (false, empty)
                return (false, empty) if not proof_scalar_witness_term_index_build(witnesses.signed_terms, &witnesses.signed_widths, &witnesses.signed_hashes, &witnesses.signed_slots, false, budget, exhausted)
                return (false, empty) if not proof_scalar_witness_term_index_build(witnesses.unsigned_terms, &witnesses.unsigned_widths, &witnesses.unsigned_hashes, &witnesses.unsigned_slots, true, budget, exhausted)
                return (true, witnesses)

        def proof_scalar_witness_merge_sorted_unsigned_widths_with_work(indices: darray[usize]&, names: darray[sview]&, widths: mutable darray[i64]&, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            start: mutable usize = 0
            while start < indices.count |start, indices, names, widths, budget, exhausted|:
                return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                first_index: usize = indices[start]
                name: sview = names[first_index]
                width: mutable i64 = 0
                end: mutable usize = start
                while end < indices.count |end, indices, names, widths, name, width, budget, exhausted|:
                    return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                    current: usize = indices[end]
                    candidate: sview = names[current]
                    return false if not proof_linear_safety_work_charge(budget, exhausted, sview_len(name)) or not proof_linear_safety_work_charge(budget, exhausted, sview_len(candidate))
                    if candidate != name:
                        break
                    width <- proof_scalar_witness_merge_unsigned_width(width, widths[current])
                    end <- end + 1
                for member in start..<end |member, indices, widths, width, budget, exhausted|:
                    return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                    widths[indices[member]] <- width
                start <- end
            return true

        def proof_scalar_witness_name_indices_sort_with_work(indices: mutable darray[usize]&, names: darray[sview]&, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            start: mutable usize = indices.count / 2
            while start > 0 |start, indices, names, budget, exhausted|:
                start <- start - 1
                if not proof_scalar_witness_name_sift_down_with_work(indices, names, start, indices.count, budget, exhausted):
                    return false
            end: mutable usize = indices.count
            while end > 1 |end, indices, names, budget, exhausted|:
                return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                temporary: usize = indices[0]
                indices[0] <- indices[end - 1]
                indices[end - 1] <- temporary
                end <- end - 1
                return false if not proof_scalar_witness_name_sift_down_with_work(indices, names, 0, end, budget, exhausted)
            return true

        def proof_scalar_witness_name_sift_down_with_work(indices: mutable darray[usize]&, names: darray[sview]&, start: usize, end: usize, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            root: mutable usize = start
            while root < end / 2 |root, end, indices, names, budget, exhausted|:
                return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                child: usize = root * 2 + 1
                swap_index: mutable usize = root
                first: mutable sview = names[indices[swap_index]]
                second: mutable sview = names[indices[child]]
                return false if not proof_linear_safety_work_charge(budget, exhausted, sview_len(first)) or not proof_linear_safety_work_charge(budget, exhausted, sview_len(second))
                swap_index <- child if proof_scalar_witness_name_less(first, second)
                if child + 1 < end:
                    first <- names[indices[swap_index]]
                    second <- names[indices[child + 1]]
                    return false if not proof_linear_safety_work_charge(budget, exhausted, sview_len(first)) or not proof_linear_safety_work_charge(budget, exhausted, sview_len(second))
                    swap_index <- child + 1 if proof_scalar_witness_name_less(first, second)
                return true if swap_index == root
                temporary: usize = indices[root]
                indices[root] <- indices[swap_index]
                indices[swap_index] <- temporary
                root <- swap_index
            return true

        def proof_scalar_witness_name_less(first: sview, second: sview) -> bool:
            first_length: usize = sview_len(first)
            second_length: usize = sview_len(second)
            common_length: usize = first_length if first_length < second_length else second_length
            for offset in 0..<common_length |offset, first, second|:
                first_byte: u8 = first[offset]
                second_byte: u8 = second[offset]
                return first_byte < second_byte if first_byte != second_byte
            return first_length < second_length

        def proof_scalar_witness_name_sift_down(indices: mutable darray[usize]&, names: darray[sview]&, start: usize, end: usize) -> void:
            root: mutable usize = start
            while root < end / 2 |root, end, indices, names|:
                child: usize = root * 2 + 1
                swap_index: mutable usize = root
                swap_index <- child if proof_scalar_witness_name_less(names[indices[swap_index]], names[indices[child]])
                if child + 1 < end:
                    swap_index <- child + 1 if proof_scalar_witness_name_less(names[indices[swap_index]], names[indices[child + 1]])
                return if swap_index == root
                temporary: usize = indices[root]
                indices[root] <- indices[swap_index]
                indices[swap_index] <- temporary
                root <- swap_index

        def proof_scalar_witness_name_indices_sort(indices: mutable darray[usize]&, names: darray[sview]&) -> void:
            start: mutable usize = indices.count / 2
            while start > 0 |start, indices, names|:
                start <- start - 1
                proof_scalar_witness_name_sift_down(indices, names, start, indices.count)
            end: mutable usize = indices.count
            while end > 1 |end, indices, names|:
                temporary: usize = indices[0]
                indices[0] <- indices[end - 1]
                indices[end - 1] <- temporary
                end <- end - 1
                proof_scalar_witness_name_sift_down(indices, names, 0, end)

        def proof_scalar_witnesses_name(witnesses: ProofScalarWitnesses&, name: sview) -> bool:
            return false if name == ""
            capacity: usize = witnesses.name_slots.count
            return false if capacity == 0
            wanted_hash: u32 = proof_name_hash(name)
            slot: mutable usize = (wanted_hash.i64() % capacity.i64()).usize()
            probes: mutable usize = 0
            while probes < capacity and probes < PROOF_SCALAR_WITNESS_NAME_PROBE_LIMIT |probes, slot, wanted_hash, name, witnesses, capacity|:
                current: usize = witnesses.name_slots[slot]
                return false if current >= witnesses.names.count
                return true if witnesses.name_hashes[current] == wanted_hash and witnesses.names[current] == name
                slot <- (slot + 1) % capacity
                probes <- probes + 1
            # The bounded hash chain can stop before an adversarial collision cluster ends.
            # Binary search the full source list so every retained marker remains discoverable.
            return false if witnesses.sorted_name_indices.count == 0
            lower: mutable usize = 0
            upper: mutable usize = witnesses.sorted_name_indices.count
            while lower < upper |lower, upper, name, witnesses|:
                middle: usize = lower + (upper - lower) / 2
                current: sview = witnesses.names[witnesses.sorted_name_indices[middle]]
                return true if current == name
                current_less: bool = proof_scalar_witness_name_less(current, name)
                if current_less:
                    lower <- middle + 1
                else:
                    upper <- middle
            return false

        def proof_scalar_witness_unsigned_width_with_work(witnesses: ProofScalarWitnesses&, name: sview, budget: mutable usize&, exhausted: mutable bool&) -> i64:
            can Abort.Panic:
                return 0 if proof_goal_bool_ref_value(exhausted) or name == ""
                capacity: usize = witnesses.name_slots.count
                return 0 if:
                    capacity == 0
                    not proof_linear_safety_work_charge(budget, exhausted, 1)
                    not proof_linear_safety_work_charge(budget, exhausted, sview_len(name))
                wanted_hash: u32 = proof_name_hash(name)
                slot: mutable usize = (wanted_hash.i64() % capacity.i64()).usize()
                probes: mutable usize = 0
                while probes < capacity |probes, slot, wanted_hash, name, witnesses, capacity, budget, exhausted|:
                    return 0 if not proof_linear_safety_work_charge(budget, exhausted, 1)
                    current: usize = witnesses.name_slots[slot]
                    return 0 if current >= witnesses.names.count
                    if witnesses.name_hashes[current] == wanted_hash:
                        candidate: sview = witnesses.names[current]
                        return 0 if not proof_linear_safety_work_charge(budget, exhausted, sview_len(candidate)) or not proof_linear_safety_work_charge(budget, exhausted, sview_len(name))
                        return witnesses.name_unsigned_widths[current] if candidate == name
                    slot <- (slot + 1) % capacity
                    probes <- probes + 1
                lower: mutable usize = 0
                upper: mutable usize = witnesses.sorted_name_indices.count
                while lower < upper |lower, upper, name, witnesses, budget, exhausted|:
                    return 0 if not proof_linear_safety_work_charge(budget, exhausted, 1)
                    middle: usize = lower + (upper - lower) / 2
                    current_index: usize = witnesses.sorted_name_indices[middle]
                    current: sview = witnesses.names[current_index]
                    return 0 if not proof_linear_safety_work_charge(budget, exhausted, sview_len(current)) or not proof_linear_safety_work_charge(budget, exhausted, sview_len(name))
                    return witnesses.name_unsigned_widths[current_index] if current == name
                    if proof_scalar_witness_name_less(current, name):
                        lower <- middle + 1
                    else:
                        upper <- middle
                return 0
