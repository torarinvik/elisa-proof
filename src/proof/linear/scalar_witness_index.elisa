extend ElisaProof:
    public:
        # The scalar-witness judgements recurse over every subterm and, at each node, looked for
        # the untrusted-operator, primitive-scalar and element markers among the selected
        # markers, parsing each marker again on every visit. The markers are decoded once here
        # into one list per kind, keeping their order, so each node compares against the
        # already-parsed terms only. Every list holds exactly the markers the old scans
        # accepted, so each judgement is unchanged.
        struct ProofScalarWitnesses:
            # Known `__elisa_untrusted_operator_type` terms.
            untrusted_terms: mutable darray[Ast::Expr]
            # Known `__elisa_primitive_scalar_type` arguments.
            scalar_terms: mutable darray[Ast::Expr]
            # Non-empty bare names from scalar-type and unsigned-width markers.
            names: mutable darray[sview]
            # Known `__elisa_primitive_scalar_element` terms and depths, in fact order.
            element_terms: mutable darray[Ast::Expr]
            element_depths: mutable darray[i64]
            # Collision-safe open-addressed lookup for `names`; slots store an index into the
            # ordered source list so exact equality remains authoritative.
            name_hashes: mutable darray[u32]
            name_slots: mutable darray[usize]

        def proof_scalar_witness_markers(facts: darray[Ast::Expr]&) -> ProofScalarWitnesses:
            witnesses: mutable ProofScalarWitnesses = ProofScalarWitnesses{untrusted_terms: [], scalar_terms: [], names: [], element_terms: [], element_depths: [], name_hashes: [], name_slots: []}
            for fact in facts |witnesses|:
                callee: sview = proof_marker_callee_name(fact)
                if callee == "__elisa_untrusted_operator_type":
                    untrusted: (known: bool, term: Ast::Expr, protocol: sview) = proof_untrusted_operator_marker_info(fact)
                    witnesses.untrusted_terms.push(untrusted.term) if untrusted.known
                elif callee == "__elisa_primitive_scalar_type" or callee == "__elisa_primitive_integer_type":
                    argument: (known: bool, term: Ast::Expr) = proof_marker_argument(fact, "__elisa_primitive_scalar_type")
                    if argument.known:
                        witnesses.scalar_terms.push(argument.term)
                        name: sview = proof_ident_name(argument.term)
                        witnesses.names.push(name) if name != ""
                elif callee == "__elisa_primitive_scalar_element":
                    element: (known: bool, term: Ast::Expr, depth: i64, width: i64) = proof_element_marker_info(fact)
                    if element.known:
                        witnesses.element_terms.push(element.term)
                        witnesses.element_depths.push(element.depth)
                elif callee == "__elisa_unsigned_type_bound":
                    unsigned_name: sview = proof_unsigned_marker_name(fact)
                    witnesses.names.push(unsigned_name) if unsigned_name != ""
                    place = proof_unsigned_place_marker_info(fact)
                    if place.known:
                        match place.term:
                            Ast::Expr.Tuple(_, _):
                                witnesses.scalar_terms.push(place.term)
                            _:
                                pass
            # Keep `names` in source order for diagnostics and differential checks. The hash
            # table is only an accelerator and stores exact source-list indexes.
            capacity: mutable usize = 1 if witnesses.names.count > 0 else 0
            target: usize = witnesses.names.count * 2
            while capacity > 0 and capacity < target |capacity, target|:
                capacity <- capacity * 2
            if capacity > 0:
                witnesses.name_slots.resize(capacity)
                witnesses.name_hashes.resize(witnesses.names.count)
                for name_index in 0..<witnesses.names.count |name_index, witnesses|:
                    witnesses.name_hashes[name_index] <- proof_name_hash(witnesses.names[name_index])
                for slot in 0..<capacity |slot, witnesses, capacity|:
                    witnesses.name_slots[slot] <- witnesses.names.count
                for name_index in 0..<witnesses.names.count |name_index, witnesses, capacity|:
                    hash: u32 = witnesses.name_hashes[name_index]
                    slot: mutable usize = (hash.i64() % capacity.i64()).usize()
                    probes: mutable usize = 0
                    while probes < capacity |probes, slot, hash, name_index, witnesses, capacity|:
                        existing: usize = witnesses.name_slots[slot]
                        if existing >= witnesses.names.count:
                            witnesses.name_slots[slot] <- name_index
                            break
                        if witnesses.name_hashes[existing] == hash and witnesses.names[existing] == witnesses.names[name_index]:
                            break
                        slot <- (slot + 1) % capacity
                        probes <- probes + 1
            return witnesses

        def proof_scalar_witnesses_name(witnesses: ProofScalarWitnesses&, name: sview) -> bool:
            return false if name == ""
            capacity: usize = witnesses.name_slots.count
            return false if capacity == 0
            wanted_hash: u32 = proof_name_hash(name)
            slot: mutable usize = (wanted_hash.i64() % capacity.i64()).usize()
            probes: mutable usize = 0
            while probes < capacity |probes, slot, wanted_hash, name, witnesses, capacity|:
                current: usize = witnesses.name_slots[slot]
                return false if current >= witnesses.names.count
                return true if witnesses.name_hashes[current] == wanted_hash and witnesses.names[current] == name
                slot <- (slot + 1) % capacity
                probes <- probes + 1
            return false
