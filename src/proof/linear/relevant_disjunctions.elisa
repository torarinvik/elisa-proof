const PROOF_LINEAR_MAX_DISJUNCTION_ENTAILMENT_CANDIDATES: usize = 8

extend ElisaProof:
    private:
        def proof_disjunction_expr_equal_with_work(left: Ast::Expr, right: Ast::Expr, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, equal: bool):
            left_cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(left, budget, exhausted)
            return (false, false) if not left_cost.complete
            right_cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(right, budget, exhausted)
            return (false, false) if:
                not right_cost.complete
                not proof_linear_safety_work_charge_scaled(budget, exhausted, left_cost.cost + right_cost.cost + 1, 5)
            return (true, proof_expr_equal(left, right))

        # Build the scalar witness snapshot once, then meter every recursive denial read against
        # the same search budget. This avoids charging the cubic worst case for a small match.
        def proof_disjunction_denial_fragment_with_work(expression: Ast::Expr, facts: darray[Ast::Expr]&, annotation_rows: usize, budget: mutable usize&, exhausted: mutable bool&, depth: usize) -> bool:
            return false if not proof_linear_safety_work_charge(budget, exhausted, annotation_rows)
            markers_result: (complete: bool, witnesses: ProofScalarWitnesses) = proof_scalar_witness_markers_with_work(facts, true, budget, exhausted)
            return false if not markers_result.complete
            marker_scale: (complete: bool, scale: usize) = proof_linear_safety_marker_scale_with_work(markers_result.witnesses, budget, exhausted)
            return false if not marker_scale.complete
            fact_scan_cost: mutable usize = 0
            for fact in facts |fact, fact_scan_cost, budget, exhausted|:
                cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(fact, budget, exhausted)
                return false if:
                    not cost.complete
                    cost.cost >= PROOF_LINEAR_SAFETY_WORK_LIMIT - fact_scan_cost
                fact_scan_cost <- fact_scan_cost + cost.cost + 1
            result: (complete: bool, closed: bool) = proof_disjunction_denial_fragment_with_markers_work(expression, facts, markers_result.witnesses, marker_scale.scale, fact_scan_cost, depth, budget, exhausted)
            return false if not result.complete or exhausted
            result.closed

        def proof_disjunction_closed_safe_constant_comparison_in_with_work(goal: Ast::Expr, facts: darray[Ast::Expr]&, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            goal_cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(goal, budget, exhausted)
            return false if not goal_cost.complete
            # The ambiguity reader refolds each arithmetic subtree, so reserve a quadratic bound
            # before calling the legacy constant check. Use expression cost for complete shapes,
            # including collection entries and payload bytes.
            return false if:
                not proof_linear_safety_work_charge_product4_with_work(budget, exhausted, goal_cost.cost, goal_cost.cost, 1, 1, 3)
                not proof_linear_safety_work_charge(budget, exhausted, facts.count)
            for fact in facts |fact, budget, exhausted|:
                fact_cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(fact, budget, exhausted)
                return false if:
                    not fact_cost.complete
                    not proof_linear_safety_work_charge_product4_with_work(budget, exhausted, fact_cost.cost, fact_cost.cost, 1, 1, 3)
            proof_closed_safe_constant_comparison_in(goal, facts)

        def proof_disjunction_comparison_from_equality_literal_with_work(left: Ast::Expr, operator: TokenKind, right: Ast::Expr, facts: darray[Ast::Expr]&, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            return false if not proof_is_comparison(operator)
            left_constant: (known: bool, value: i64) = proof_small_nonnegative_constant_with_work(left, 0, budget, exhausted)
            return false if exhausted
            right_constant: (known: bool, value: i64) = proof_small_nonnegative_constant_with_work(right, 0, budget, exhausted)
            return false if exhausted
            return proof_small_comparison_value(left_constant.value, operator, right_constant.value) if left_constant.known and right_constant.known
            return false if left_constant.known == right_constant.known
            term: Ast::Expr = right if left_constant.known else left
            goal_constant: i64 = left_constant.value if left_constant.known else right_constant.value
            term_is_left: bool = not left_constant.known
            marker_result: (complete: bool, witnesses: ProofScalarWitnesses) = proof_scalar_witness_markers_with_work(facts, false, budget, exhausted)
            return false if not marker_result.complete
            marker_scale: (complete: bool, scale: usize) = proof_linear_safety_marker_scale_with_work(marker_result.witnesses, budget, exhausted)
            return false if not marker_scale.complete
            markers: ProofScalarWitnesses = marker_result.witnesses
            goal_left_scalar: (complete: bool, matches: bool) = proof_linear_safety_scalar_witness_with_work(left, markers, marker_scale.scale, budget, exhausted)
            return false if not goal_left_scalar.complete
            goal_right_scalar: (complete: bool, matches: bool) = proof_linear_safety_scalar_witness_with_work(right, markers, marker_scale.scale, budget, exhausted)
            return false if:
                not goal_right_scalar.complete
                not goal_left_scalar.matches or not goal_right_scalar.matches
            for fact in facts |fact, term, operator, goal_constant, term_is_left, facts, markers, marker_scale, budget, exhausted|:
                return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                match fact:
                    Ast::Expr.Binary(fact_left, TokenKind.EqEq, fact_right, _):
                        right_literal: (known: bool, value: i64) = proof_small_nonnegative_constant_with_work(fact_right, 0, budget, exhausted)
                        return false if exhausted
                        if right_literal.known:
                            left_equal: (complete: bool, equal: bool) = proof_disjunction_expr_equal_with_work(fact_left, term, budget, exhausted)
                            return false if not left_equal.complete
                            if left_equal.equal:
                                right_literal_left_scalar: (complete: bool, matches: bool) = proof_linear_safety_scalar_witness_with_work(fact_left, markers, marker_scale.scale, budget, exhausted)
                                return false if not right_literal_left_scalar.complete
                                right_literal_right_scalar: (complete: bool, matches: bool) = proof_linear_safety_scalar_witness_with_work(fact_right, markers, marker_scale.scale, budget, exhausted)
                                return false if not right_literal_right_scalar.complete
                                continue if not right_literal_left_scalar.matches or not right_literal_right_scalar.matches
                                return proof_small_comparison_value(right_literal.value, operator, goal_constant) if term_is_left
                                return proof_small_comparison_value(goal_constant, operator, right_literal.value)
                        left_literal: (known: bool, value: i64) = proof_small_nonnegative_constant_with_work(fact_left, 0, budget, exhausted)
                        return false if exhausted
                        if left_literal.known:
                            right_equal: (complete: bool, equal: bool) = proof_disjunction_expr_equal_with_work(fact_right, term, budget, exhausted)
                            return false if not right_equal.complete
                            if right_equal.equal:
                                left_literal_left_scalar: (complete: bool, matches: bool) = proof_linear_safety_scalar_witness_with_work(fact_left, markers, marker_scale.scale, budget, exhausted)
                                return false if not left_literal_left_scalar.complete
                                left_literal_right_scalar: (complete: bool, matches: bool) = proof_linear_safety_scalar_witness_with_work(fact_right, markers, marker_scale.scale, budget, exhausted)
                                return false if not left_literal_right_scalar.complete
                                continue if not left_literal_left_scalar.matches or not left_literal_right_scalar.matches
                                return proof_small_comparison_value(left_literal.value, operator, goal_constant) if term_is_left
                                return proof_small_comparison_value(goal_constant, operator, left_literal.value)
                    _:
                        pass
            return false

        def proof_disjunction_fact_contains_with_work(fact: Ast::Expr, goal: Ast::Expr, budget: mutable usize&, exhausted: mutable bool&, depth: usize) -> (complete: bool, contains: bool):
            return (false, false) if exhausted
            return (true, false) if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            equality: (complete: bool, equal: bool) = proof_disjunction_expr_equal_with_work(fact, goal, budget, exhausted)
            return (false, false) if not equality.complete
            return (true, true) if equality.equal
            match fact:
                Ast::Expr.Paren(inner, _):
                    return proof_disjunction_fact_contains_with_work(inner, goal, budget, exhausted, depth + 1)
                Ast::Expr.Binary(left, TokenKind.And, right, _):
                    left_result: (complete: bool, contains: bool) = proof_disjunction_fact_contains_with_work(left, goal, budget, exhausted, depth + 1)
                    return (false, false) if not left_result.complete
                    return (true, true) if left_result.contains
                    return proof_disjunction_fact_contains_with_work(right, goal, budget, exhausted, depth + 1)
                Ast::Expr.Unary(TokenKind.Not, inner, _):
                    match inner:
                        Ast::Expr.Unary(TokenKind.Not, nested, _):
                            return proof_disjunction_fact_contains_with_work(nested, goal, budget, exhausted, depth + 1)
                        _:
                            pass
                _:
                    pass
            return (true, false)

        def proof_disjunction_fact_denies_with_work(candidate: Ast::Expr, facts: darray[Ast::Expr]&, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, denied: bool):
            return (false, false) if exhausted
            candidate_cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(candidate, budget, exhausted)
            return (false, false) if not candidate_cost.complete
            negated_result: (complete: bool, known: bool, operand: Ast::Expr) = proof_negated_operand_with_work(candidate, budget, exhausted)
            return (false, false) if not negated_result.complete
            for fact in facts |fact, candidate, negated_result, budget, exhausted|:
                return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                fact_cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(fact, budget, exhausted)
                return (false, false) if not fact_cost.complete
                if negated_result.known:
                    contained: (complete: bool, contains: bool) = proof_disjunction_fact_contains_with_work(fact, negated_result.operand, budget, exhausted, 0)
                    return (false, false) if not contained.complete
                    return (true, true) if contained.contains
                fact_negated_result: (complete: bool, known: bool, operand: Ast::Expr) = proof_negated_operand_with_work(fact, budget, exhausted)
                return (false, false) if not fact_negated_result.complete
                if fact_negated_result.known:
                    contained: (complete: bool, contains: bool) = proof_disjunction_fact_contains_with_work(candidate, fact_negated_result.operand, budget, exhausted, 0)
                    return (false, false) if not contained.complete
                    return (true, true) if contained.contains
            return (true, false)

        def proof_disjunction_integer_term_with_work(expression: Ast::Expr, facts: darray[Ast::Expr]&, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, integer: bool):
            expression_cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(expression, budget, exhausted)
            return (false, false) if not expression_cost.complete
            markers_result: (complete: bool, witnesses: ProofScalarWitnesses) = proof_scalar_witness_markers_with_work(facts, true, budget, exhausted)
            return (false, false) if not markers_result.complete
            marker_scan: (complete: bool, scale: usize) = proof_linear_safety_marker_scale_with_work(markers_result.witnesses, budget, exhausted)
            return (false, false) if not marker_scan.complete
            fact_scan_cost: mutable usize = 0
            for fact in facts |fact, fact_scan_cost, budget, exhausted|:
                cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(fact, budget, exhausted)
                return (false, false) if not cost.complete
                if fact_scan_cost >= PROOF_LINEAR_SAFETY_WORK_LIMIT or cost.cost >= PROOF_LINEAR_SAFETY_WORK_LIMIT - fact_scan_cost:
                    budget <- PROOF_LINEAR_SAFETY_WORK_LIMIT
                    exhausted <- true
                    return (false, false)
                fact_scan_cost <- fact_scan_cost + cost.cost + 1
            result: (complete: bool, integer: bool) = proof_disjunction_denial_integer_term_with_work(expression, facts, markers_result.witnesses, marker_scan.scale, fact_scan_cost, 0, budget, exhausted)
            return result

        # Applicability is separate from proof success: false OR P reduces to P
        # even when P remains unproved. Retrying the whole OR repeats that search.
        def proof_disjunction_false_left_goal(facts: darray[Ast::Expr]&, goal: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, operator_mask: usize, operator_safe: bool, depth: usize, budget: mutable usize&, split_depth: usize, exhausted: mutable bool&) -> (applicable: bool, proven: bool) can[Global{Read,Write}]:
            goal_stripped: (complete: bool, value: Ast::Expr) = proof_disjunction_strip_parens_with_work(goal, budget, exhausted)
            return (false, false) if not goal_stripped.complete
            match goal_stripped.value:
                Ast::Expr.Binary(left, TokenKind.Or, right, _):
                    known_left: mutable (known: bool, value: bool) = proof_constant_bool_with_work(left, 0, budget, exhausted)
                    return (false, false) if exhausted
                    left_stripped: (complete: bool, value: Ast::Expr) = proof_disjunction_strip_parens_with_work(left, budget, exhausted)
                    return (false, false) if not left_stripped.complete
                    match left_stripped.value:
                        Ast::Expr.Binary(a, TokenKind.BangEq, b, _):
                            a_stripped: (complete: bool, value: Ast::Expr) = proof_disjunction_strip_parens_with_work(a, budget, exhausted)
                            return (false, false) if not a_stripped.complete
                            match a_stripped.value:
                                Ast::Expr.IntLit(first, _):
                                    b_stripped: (complete: bool, value: Ast::Expr) = proof_disjunction_strip_parens_with_work(b, budget, exhausted)
                                    return (false, false) if not b_stripped.complete
                                    match b_stripped.value:
                                        Ast::Expr.IntLit(second, _):
                                            known_left <- (true, false) if first == second
                                        _:
                                            pass
                                _:
                                    pass
                        _:
                            pass
                    return (false, false) if:
                        not known_left.known or known_left.value
                        not operator_safe
                    return (true, (proof_goal_depth(facts, right, annotations, operator_mask, depth + 1, budget, split_depth, exhausted) can Global{Read,Write}))
                _:
                    return (false, false)

        def proof_disjunction_premise_entails_goal(goal: Ast::Expr, facts: darray[Ast::Expr]&, annotations: darray[Ast::EnumAnnotation]&, budget: mutable usize&, exhausted: mutable bool&) -> bool can[Global{Read,Write}]:
            return false if exhausted
            candidates: mutable usize = 0
            for fact in facts |candidates, goal, facts, annotations, budget, exhausted|:
                return false if:
                    exhausted
                    not proof_linear_safety_work_charge(budget, exhausted, 1)
                can Global{Read,Write}:
                    proof_disjunction_facts_scanned <- proof_disjunction_facts_scanned + 1
                stripped: (complete: bool, value: Ast::Expr) = proof_disjunction_strip_parens_with_work(fact, budget, exhausted)
                return false if not stripped.complete
                match stripped.value:
                    Ast::Expr.Binary(_, TokenKind.Or, _, _):
                        relevance: usize = (proof_disjunction_candidate_relevance(goal, fact, facts, annotations, budget, exhausted, 0) can Global{Read,Write})
                        return false if exhausted
                        return true if relevance == 1
                        if relevance == 2:
                            if (proof_disjunction_entails_goal(fact, goal, facts, annotations, budget, exhausted, 0) can Global{Read,Write}):
                                return true
                            return false if exhausted
                            candidates <- candidates + 1
                            break if candidates >= PROOF_LINEAR_MAX_DISJUNCTION_ENTAILMENT_CANDIDATES
                    _:
                        pass
            return false

        # Keep a premise eligible if it has a goal-matching alternative or if
        # every alternative is refuted. The latter preserves the old
        # contradiction case; unrelated, non-refuted alternatives stay cheap.
        def proof_disjunction_candidate_relevance(goal: Ast::Expr, candidate: Ast::Expr, facts: darray[Ast::Expr]&, annotations: darray[Ast::EnumAnnotation]&, budget: mutable usize&, exhausted: mutable bool&, depth: usize) -> usize can[Global{Read,Write}]:
            requires depth <= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            decreases PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT - depth
            return 0 if exhausted or depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            # The prior entailment rule accepts the whole premise when it is a
            # goal disjunct, including compound disjunctions.
            if proof_goal_contains_disjunct(goal, candidate, facts, budget, exhausted, 0):
                return 2
            return 0 if exhausted
            stripped: (complete: bool, value: Ast::Expr) = proof_disjunction_strip_parens_with_work(candidate, budget, exhausted)
            return 0 if not stripped.complete
            match stripped.value:
                Ast::Expr.Binary(left, TokenKind.Or, right, _):
                    left_relevance: usize = (proof_disjunction_candidate_relevance(goal, left, facts, annotations, budget, exhausted, depth + 1) can Global{Read,Write})
                    return 0 if exhausted
                    right_relevance: usize = (proof_disjunction_candidate_relevance(goal, right, facts, annotations, budget, exhausted, depth + 1) can Global{Read,Write})
                    return 0 if exhausted
                    return 2 if left_relevance == 2 or right_relevance == 2
                    return 1 if left_relevance == 1 and right_relevance == 1
                    return 0
                _:
                    # Status 1 means this leaf is refuted. Its parent returns
                    # status 1 only when every alternative is refuted.
                    return 1 if (proof_disjunct_refuted(candidate, facts, annotations, budget, exhausted, 0) can Global{Read,Write})
            return 0

        # Every alternative of one premise either introduces the goal or is
        # explicitly refuted. This is OR elimination without case-state copies.
        def proof_disjunction_entails_goal(premise: Ast::Expr, goal: Ast::Expr, facts: darray[Ast::Expr]&, annotations: darray[Ast::EnumAnnotation]&, budget: mutable usize&, exhausted: mutable bool&, depth: usize) -> bool can[Global{Read,Write}]:
            return false if exhausted or depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            if proof_goal_contains_disjunct(goal, premise, facts, budget, exhausted, 0):
                return true
            return false if exhausted
            premise_stripped: (complete: bool, value: Ast::Expr) = proof_disjunction_strip_parens_with_work(premise, budget, exhausted)
            return false if not premise_stripped.complete
            match premise_stripped.value:
                Ast::Expr.Binary(left, TokenKind.Or, right, _):
                    left_proven: bool = (proof_disjunction_entails_goal(left, goal, facts, annotations, budget, exhausted, depth + 1) can Global{Read,Write})
                    return false if exhausted or not left_proven
                    return (proof_disjunction_entails_goal(right, goal, facts, annotations, budget, exhausted, depth + 1) can Global{Read,Write})
                _:
                    return (proof_disjunct_refuted(premise, facts, annotations, budget, exhausted, 0) can Global{Read,Write})

        # OR introduction from an already known subtree needs no case search.
        # The caller checks source operator dispatch for the entire goal first.
        def proof_disjunction_direct_branch(goal: Ast::Expr, facts: darray[Ast::Expr]&, depth: usize, fact_containment_checked: bool, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            return false if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            if not fact_containment_checked:
                for fact in facts |fact, budget, exhausted|:
                    contained: (complete: bool, contains: bool) = proof_disjunction_fact_contains_with_work(fact, goal, budget, exhausted, 0)
                    return false if not contained.complete
                    return true if contained.contains
            stripped_goal: (complete: bool, value: Ast::Expr) = proof_disjunction_strip_parens_with_work(goal, budget, exhausted)
            return false if not stripped_goal.complete
            match stripped_goal.value:
                Ast::Expr.BoolLit(value, _):
                    return value
                Ast::Expr.Binary(left, TokenKind.Or, right, _):
                    # Exact excluded middle for a checked, deterministic Boolean fragment.
                    right_stripped: (complete: bool, value: Ast::Expr) = proof_disjunction_strip_parens_with_work(right, budget, exhausted)
                    return false if not right_stripped.complete
                    match right_stripped.value:
                        Ast::Expr.Unary(TokenKind.Not, inner, _):
                            equal: (complete: bool, equal: bool) = proof_disjunction_expr_equal_with_work(left, inner, budget, exhausted)
                            return false if not equal.complete
                            if equal.equal:
                                return true if proof_disjunction_denial_fragment_with_work(left, facts, 0, budget, exhausted, depth + 1)
                        _:
                            pass
                    left_stripped: (complete: bool, value: Ast::Expr) = proof_disjunction_strip_parens_with_work(left, budget, exhausted)
                    return false if not left_stripped.complete
                    match left_stripped.value:
                        Ast::Expr.Unary(TokenKind.Not, inner, _):
                            equal: (complete: bool, equal: bool) = proof_disjunction_expr_equal_with_work(right, inner, budget, exhausted)
                            return false if not equal.complete
                            if equal.equal:
                                return true if proof_disjunction_denial_fragment_with_work(right, facts, 0, budget, exhausted, depth + 1)
                        _:
                            pass
                    left_proven: bool = proof_disjunction_direct_branch(left, facts, depth + 1, false, budget, exhausted)
                    return false if exhausted or left_proven
                    return proof_disjunction_direct_branch(right, facts, depth + 1, false, budget, exhausted)
                Ast::Expr.Binary(left, operator, right, _):
                    if proof_is_comparison(operator):
                        return proof_disjunction_comparison_from_equality_literal_with_work(left, operator, right, facts, budget, exhausted)
                _:
                    pass
            return false

        # Eliminate an explicitly refuted alternative without branching. Ordering
        # complements require integer witnesses; never assume float totality.
        def proof_disjunct_refuted(expression: Ast::Expr, facts: darray[Ast::Expr]&, annotations: darray[Ast::EnumAnnotation]&, budget: mutable usize&, exhausted: mutable bool&, depth: usize) -> bool:
            can Global{Read,Write}:
                proof_disjunction_refutation_checks <- proof_disjunction_refutation_checks + 1
            return false if exhausted or depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            expression_cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(expression, budget, exhausted)
            return false if not expression_cost.complete
            denied_fact: (complete: bool, denied: bool) = proof_disjunction_fact_denies_with_work(expression, facts, budget, exhausted)
            return false if not denied_fact.complete
            return true if denied_fact.denied
            # Contract substitution leaves literal negations such as not true.
            # Fold only Boolean literals/parentheses/not, never symbolic terms.
            constant: (known: bool, value: bool) = proof_constant_bool_with_work(expression, 0, budget, exhausted)
            return false if exhausted
            return true if constant.known and not constant.value
            expression_stripped: (complete: bool, value: Ast::Expr) = proof_disjunction_strip_parens_with_work(expression, budget, exhausted)
            return false if not expression_stripped.complete
            match expression_stripped.value:
                Ast::Expr.BoolLit(value, _):
                    return not value
                Ast::Expr.Binary(left, TokenKind.Or, right, _):
                    left_refuted: bool = (proof_disjunct_refuted(left, facts, annotations, budget, exhausted, depth + 1) can Global{Read,Write})
                    return false if exhausted or not left_refuted
                    return (proof_disjunct_refuted(right, facts, annotations, budget, exhausted, depth + 1) can Global{Read,Write})
                Ast::Expr.Binary(left, TokenKind.And, right, _):
                    left_refuted: bool = (proof_disjunct_refuted(left, facts, annotations, budget, exhausted, depth + 1) can Global{Read,Write})
                    return true if left_refuted
                    return false if exhausted
                    return (proof_disjunct_refuted(right, facts, annotations, budget, exhausted, depth + 1) can Global{Read,Write})
                Ast::Expr.Binary(left, operator, right, position):
                    complement: TokenKind = proof_comparison_negation(operator)
                    return false if complement == TokenKind.Eof
                    # These constant-only rules encode the expression into fresh kernel nodes.
                    # The source AST arena is append-only, so reject ordinary variable, field,
                    # and call comparisons before constructing a temporary comparison.
                    left_nodes: mutable usize = 0
                    right_nodes: mutable usize = 0
                    return false if:
                        not proof_linear_safety_expression_shape_with_work(left, 0, &left_nodes, budget, exhausted)
                        not proof_linear_safety_expression_shape_with_work(right, 0, &right_nodes, budget, exhausted)
                    denied_constant: Ast::Expr = Ast::Expr.Binary(left, complement, right, position)
                    typed_constant_proof: bool = (proof_closed_typed_constant_comparison(denied_constant, annotations, budget, exhausted) can Global{Read,Write})
                    return false if exhausted
                    return true if typed_constant_proof
                    return false if not proof_linear_safety_work_charge_scaled(budget, exhausted, left_nodes + right_nodes + 1, 2)
                    safe_left: (known: bool, value: i64) = proof_safe_comparison_constant(left)
                    safe_right: (known: bool, value: i64) = proof_safe_comparison_constant(right)
                    if safe_left.known and safe_right.known:
                        safe_constant_proof: bool = proof_disjunction_closed_safe_constant_comparison_in_with_work(denied_constant, facts, budget, exhausted)
                        return false if exhausted
                        return true if safe_constant_proof
                    # A literal equality fixes this exact primitive term. This
                    # also handles witnessed pure call results, without treating
                    # arbitrary calls or wrapping arithmetic as integer bounds.
                    equality_literal_proof: bool = proof_disjunction_comparison_from_equality_literal_with_work(left, complement, right, facts, budget, exhausted)
                    return false if exhausted
                    return true if equality_literal_proof
                    equality: bool = operator == TokenKind.EqEq or operator == TokenKind.BangEq
                    marker_result: (complete: bool, witnesses: ProofScalarWitnesses) = proof_scalar_witness_markers_with_work(facts, false, budget, exhausted)
                    return false if not marker_result.complete
                    marker_scale: (complete: bool, scale: usize) = proof_linear_safety_marker_scale_with_work(marker_result.witnesses, budget, exhausted)
                    return false if not marker_scale.complete
                    markers: ProofScalarWitnesses = marker_result.witnesses
                    primitive_left: (complete: bool, matches: bool) = proof_linear_safety_scalar_witness_with_work(left, markers, marker_scale.scale, budget, exhausted)
                    return false if not primitive_left.complete
                    primitive_right: (complete: bool, matches: bool) = proof_linear_safety_scalar_witness_with_work(right, markers, marker_scale.scale, budget, exhausted)
                    return false if not primitive_right.complete
                    primitive: bool = primitive_left.matches and primitive_right.matches
                    left_integer: (complete: bool, integer: bool) = (true, false)
                    right_integer: (complete: bool, integer: bool) = (true, false)
                    if not equality and primitive:
                        left_integer <- proof_disjunction_integer_term_with_work(left, facts, budget, exhausted)
                        return false if not left_integer.complete
                        right_integer <- proof_disjunction_integer_term_with_work(right, facts, budget, exhausted)
                        return false if not right_integer.complete
                    integer_order: bool = not equality and primitive and left_integer.integer and right_integer.integer
                    for fact in facts |left, right, complement, equality, primitive, integer_order, facts, markers|:
                        return false if exhausted
                        # Early-return guards retain not(comparison). Normalize
                        # only its operator; preserve primitive and term guards.
                        premise: (complete: bool, known: bool, left: Ast::Expr, operator: TokenKind, right: Ast::Expr) = proof_comparison_disjunct_shape_with_work(fact, facts, budget, exhausted)
                        return false if not premise.complete
                        continue if not premise.known or premise.operator != complement or not primitive
                        premise_left_scalar: (complete: bool, matches: bool) = proof_linear_safety_scalar_witness_with_work(premise.left, markers, marker_scale.scale, budget, exhausted)
                        return false if not premise_left_scalar.complete
                        premise_right_scalar: (complete: bool, matches: bool) = proof_linear_safety_scalar_witness_with_work(premise.right, markers, marker_scale.scale, budget, exhausted)
                        return false if not premise_right_scalar.complete
                        continue if not premise_left_scalar.matches or not premise_right_scalar.matches
                        integers: bool = false
                        if integer_order:
                            premise_left_integer: (complete: bool, integer: bool) = proof_disjunction_integer_term_with_work(premise.left, facts, budget, exhausted)
                            return false if not premise_left_integer.complete
                            premise_right_integer: (complete: bool, integer: bool) = proof_disjunction_integer_term_with_work(premise.right, facts, budget, exhausted)
                            return false if not premise_right_integer.complete
                            integers <- premise_left_integer.integer and premise_right_integer.integer
                        terms_match: bool = (equality or integers) and proof_disjunct_terms_equivalent(left, premise.left, facts, budget, exhausted)
                        return false if exhausted or not terms_match
                        return true if proof_disjunct_terms_equivalent(right, premise.right, facts, budget, exhausted)
                    return false if not proof_disjunction_denial_fragment_with_work(expression, facts, 0, budget, exhausted, 0)
                    denied: Ast::Expr = Ast::Expr.Binary(left, complement, right, position)
                    for fact in facts |fact, budget, exhausted|:
                        contained: (complete: bool, contains: bool) = proof_disjunction_fact_contains_with_work(fact, denied, budget, exhausted, 0)
                        return false if not contained.complete
                        return true if contained.contains
                _:
                    pass
            return false

        # Prioritize disjunctions whose branches match the postcondition. Guarded selectors
        # accumulate unrelated fall-through facts, while the case-split budget is deliberately
        # shallow.
        def proof_comparison_disjunct_shape_with_work(expression: Ast::Expr, facts: darray[Ast::Expr]&, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, known: bool, left: Ast::Expr, operator: TokenKind, right: Ast::Expr):
            return (false, false, Ast::Expr.Absent, TokenKind.Eof, Ast::Expr.Absent) if not proof_linear_safety_work_charge(budget, exhausted, 1)
            expression_stripped: (complete: bool, value: Ast::Expr) = proof_disjunction_strip_parens_with_work(expression, budget, exhausted)
            return (false, false, Ast::Expr.Absent, TokenKind.Eof, Ast::Expr.Absent) if not expression_stripped.complete
            match expression_stripped.value:
                Ast::Expr.Binary(left, operator, right, _):
                    return (true, true, left, operator, right) if proof_is_comparison(operator)
                Ast::Expr.Unary(TokenKind.Not, operand, _):
                    operand_stripped: (complete: bool, value: Ast::Expr) = proof_disjunction_strip_parens_with_work(operand, budget, exhausted)
                    return (false, false, Ast::Expr.Absent, TokenKind.Eof, Ast::Expr.Absent) if not operand_stripped.complete
                    match operand_stripped.value:
                        Ast::Expr.Binary(left, operator, right, _):
                            if proof_is_order_operator(operator):
                                left_integer: (complete: bool, integer: bool) = proof_disjunction_integer_term_with_work(left, facts, budget, exhausted)
                                return (false, false, Ast::Expr.Absent, TokenKind.Eof, Ast::Expr.Absent) if not left_integer.complete
                                return (true, false, Ast::Expr.Absent, TokenKind.Eof, Ast::Expr.Absent) if not left_integer.integer
                                right_integer: (complete: bool, integer: bool) = proof_disjunction_integer_term_with_work(right, facts, budget, exhausted)
                                return (false, false, Ast::Expr.Absent, TokenKind.Eof, Ast::Expr.Absent) if not right_integer.complete
                                return (true, false, Ast::Expr.Absent, TokenKind.Eof, Ast::Expr.Absent) if not right_integer.integer
                            complement: TokenKind = proof_comparison_negation(operator)
                            return (true, true, left, complement, right) if complement != TokenKind.Eof
                        _:
                            pass
                _:
                    pass
            return (true, false, Ast::Expr.Absent, TokenKind.Eof, Ast::Expr.Absent)

        def proof_disjunct_terms_equivalent(left: Ast::Expr, right: Ast::Expr, facts: darray[Ast::Expr]&, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            left_calls: (complete: bool, found: bool) = proof_disjunction_term_has_call_with_work(left, budget, exhausted, 0)
            return false if not left_calls.complete or left_calls.found
            right_calls: (complete: bool, found: bool) = proof_disjunction_term_has_call_with_work(right, budget, exhausted, 0)
            return false if not right_calls.complete or right_calls.found
            same: (complete: bool, equal: bool) = proof_disjunction_expr_equal_with_work(left, right, budget, exhausted)
            return false if not same.complete
            return true if same.equal
            for fact in facts |fact, facts, left, right, budget, exhausted|:
                return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                stripped: (complete: bool, value: Ast::Expr) = proof_disjunction_strip_parens_with_work(fact, budget, exhausted)
                return false if not stripped.complete
                match stripped.value:
                    Ast::Expr.Binary(name, TokenKind.EqEq, value, _):
                        name_calls: (complete: bool, found: bool) = proof_disjunction_term_has_call_with_work(name, budget, exhausted, 0)
                        return false if not name_calls.complete
                        continue if name_calls.found
                        value_calls: (complete: bool, found: bool) = proof_disjunction_term_has_call_with_work(value, budget, exhausted, 0)
                        return false if not value_calls.complete
                        continue if value_calls.found
                        first_left: (complete: bool, equal: bool) = proof_disjunction_expr_equal_with_work(left, name, budget, exhausted)
                        return false if not first_left.complete
                        first_right: (complete: bool, equal: bool) = proof_disjunction_expr_equal_with_work(right, value, budget, exhausted)
                        return false if not first_right.complete
                        return true if first_left.equal and first_right.equal
                        second_left: (complete: bool, equal: bool) = proof_disjunction_expr_equal_with_work(left, value, budget, exhausted)
                        return false if not second_left.complete
                        second_right: (complete: bool, equal: bool) = proof_disjunction_expr_equal_with_work(right, name, budget, exhausted)
                        return false if not second_right.complete
                        return true if second_left.equal and second_right.equal
                    _:
                        pass
            return false

        def proof_disjunct_atoms_equivalent(left: Ast::Expr, right: Ast::Expr, facts: darray[Ast::Expr]&, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            return true if proof_disjunct_terms_equivalent(left, right, facts, budget, exhausted)
            return false if exhausted
            first: (complete: bool, known: bool, left: Ast::Expr, operator: TokenKind, right: Ast::Expr) = proof_comparison_disjunct_shape_with_work(left, facts, budget, exhausted)
            return false if not first.complete
            second: (complete: bool, known: bool, left: Ast::Expr, operator: TokenKind, right: Ast::Expr) = proof_comparison_disjunct_shape_with_work(right, facts, budget, exhausted)
            return false if:
                not second.complete
                not first.known or not second.known or first.operator != second.operator
            left_match: bool = proof_disjunct_terms_equivalent(first.left, second.left, facts, budget, exhausted)
            return false if exhausted or not left_match
            return proof_disjunct_terms_equivalent(first.right, second.right, facts, budget, exhausted)

        def proof_goal_contains_disjunct(goal: Ast::Expr, candidate: Ast::Expr, facts: darray[Ast::Expr]&, budget: mutable usize&, exhausted: mutable bool&, depth: usize) -> bool:
            requires depth <= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            decreases PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT - depth
            return false if:
                exhausted or depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
                not proof_linear_safety_work_charge(budget, exhausted, 1)
            stripped: (complete: bool, value: Ast::Expr) = proof_disjunction_strip_parens_with_work(goal, budget, exhausted)
            return false if not stripped.complete
            match stripped.value:
                Ast::Expr.Binary(left, TokenKind.Or, right, _):
                    left_found: bool = proof_goal_contains_disjunct(left, candidate, facts, budget, exhausted, depth + 1)
                    return true if left_found
                    return false if exhausted
                    return proof_goal_contains_disjunct(right, candidate, facts, budget, exhausted, depth + 1)
                _:
                    return proof_disjunct_atoms_equivalent(goal, candidate, facts, budget, exhausted)

        def proof_goal_disjunction_relevance(goal: Ast::Expr, left: Ast::Expr, right: Ast::Expr, facts: darray[Ast::Expr]&, budget: mutable usize&, exhausted: mutable bool&) -> usize:
            left_matches: bool = proof_goal_contains_disjunct(goal, left, facts, budget, exhausted, 0)
            return 0 if exhausted
            right_matches: bool = proof_goal_contains_disjunct(goal, right, facts, budget, exhausted, 0)
            return 0 if exhausted
            return 2 if left_matches and right_matches
            return 1 if left_matches or right_matches
            return 0

        def proof_find_goal_relevant_disjunction(facts: darray[Ast::Expr]&, goal: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, budget: mutable usize&, exhausted: mutable bool&) -> (known: bool, index: usize, left: Ast::Expr, right: Ast::Expr) can[Global{Read,Write}]:
            return (false, facts.count, Ast::Expr.Absent, Ast::Expr.Absent) if exhausted
            first_index: mutable usize = facts.count
            first_left: mutable Ast::Expr = Ast::Expr.Absent
            first_right: mutable Ast::Expr = Ast::Expr.Absent
            best_index: mutable usize = facts.count
            best_left: mutable Ast::Expr = Ast::Expr.Absent
            best_right: mutable Ast::Expr = Ast::Expr.Absent
            best_score: mutable usize = 0
            for index in 0..<facts.count |index, facts, goal, first_index, first_left, first_right, best_index, best_left, best_right, best_score, annotations, budget, exhausted|:
                return (false, facts.count, Ast::Expr.Absent, Ast::Expr.Absent) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                can Global{Read,Write}:
                    proof_disjunction_facts_scanned <- proof_disjunction_facts_scanned + 1
                discovery_cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(facts[index], budget, exhausted)
                return (false, facts.count, Ast::Expr.Absent, Ast::Expr.Absent) if:
                    not discovery_cost.complete
                    not proof_linear_safety_work_charge_scaled(budget, exhausted, discovery_cost.cost, 4)
                candidate: (complete: bool, known: bool, left: Ast::Expr, right: Ast::Expr) = proof_disjunction_find_with_work(facts[index], budget, exhausted, 0)
                return (false, facts.count, Ast::Expr.Absent, Ast::Expr.Absent) if not candidate.complete
                continue if not candidate.known
                if first_index == facts.count:
                    first_index <- index
                    first_left <- candidate.left
                    first_right <- candidate.right
                score: usize = proof_goal_disjunction_relevance(goal, candidate.left, candidate.right, facts, budget, exhausted)
                return (false, facts.count, Ast::Expr.Absent, Ast::Expr.Absent) if exhausted
                if score > best_score:
                    best_index <- index
                    best_left <- candidate.left
                    best_right <- candidate.right
                    best_score <- score
                break if best_score == 2
            return (true, best_index, best_left, best_right) if best_score > 0
            return (true, first_index, first_left, first_right) if first_index < facts.count
            return (false, facts.count, Ast::Expr.Absent, Ast::Expr.Absent)
