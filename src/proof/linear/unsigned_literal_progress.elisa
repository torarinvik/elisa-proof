extend ElisaProof:
    public:
        def proof_unsigned_progress_plain_one(expression: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&) -> bool:
            match expression:
                Ast::Expr.IntLit(value, position):
                    return false if value != 1
                    return not proof_replay_numeric_literal_sort(annotations, position.line, position.column, 1).known
                _:
                    return false
        # Consume a source-typed literal, never its signed payload alone.
        # x >= positive implies x >= 1; x < a representable positive cap
        # implies x + 1 >= 1 in the same unsigned width.
        def proof_unsigned_literal_progress(facts: darray[Ast::Expr]&, goal: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&) -> bool:
            term: mutable Ast::Expr = Ast::Expr.Invalid
            relative_base: mutable Ast::Expr = Ast::Expr.Invalid
            match proof_strip_parens(goal):
                Ast::Expr.Binary(left, TokenKind.GtEq, right, _):
                    if proof_ident_name(right) != "":
                        relative_base <- right
                    else:
                        return false if not proof_unsigned_progress_plain_one(right, annotations)
                    return false if not proof_primitive_comparison(left, right, facts)
                    term <- left
                _:
                    return false
            increment: mutable bool = false
            match proof_strip_parens(term):
                Ast::Expr.Binary(base, TokenKind.Plus, step, _):
                    return false if not proof_unsigned_progress_plain_one(step, annotations)
                    term <- base
                    increment <- true
                _:
                    pass
            return false if proof_ident_name(term) == ""
            return false if not proof_expr_is_invalid(relative_base) and (not increment or not proof_expr_equal(relative_base, term))
            width: i64 = proof_peer_unsigned_width(term, facts)
            return false if width != 8 and width != 16 and width != 32 and width != 64
            for fact in facts |fact, term, width, increment, annotations, facts|:
                order = proof_readable_order(fact, facts)
                continue if not order.known
                base: mutable Ast::Expr = order.right if order.operator == TokenKind.Gt or order.operator == TokenKind.GtEq else order.left
                cap: mutable Ast::Expr = order.left if order.operator == TokenKind.Gt or order.operator == TokenKind.GtEq else order.right
                # Normalize to base < cap (increment), or base >= cap (positive).
                if increment:
                    continue if order.operator != TokenKind.Lt and order.operator != TokenKind.Gt
                else:
                    base <- order.left if order.operator == TokenKind.GtEq else order.right
                    cap <- order.right if order.operator == TokenKind.GtEq else order.left
                    continue if order.operator != TokenKind.GtEq and order.operator != TokenKind.LtEq
                continue if not proof_expr_equal(base, term)
                match proof_strip_parens(cap):
                    Ast::Expr.IntLit(value, position):
                        literal = proof_replay_numeric_literal_sort(annotations, position.line, position.column, value)
                        return true if literal.known and literal.unsigned and literal.width == width and literal.bits > 0
                    _:
                        pass
            return false
