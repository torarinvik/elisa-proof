# Work-aware signed overflow analysis and its shared signed-bound context.
extend ElisaProof:
    public:
        # `exhausted` distinguishes budget/depth failure from an ordinary unsafe result. Recursive
        # safety visits, exact marker comparisons, order candidates, and name-bound updates are
        # charged where they happen; no fact-by-expression reserve is needed on this path.
        def proof_signed_expression_safe_with_bounds_work(expression: Ast::Expr, facts: darray[Ast::Expr]&, bounds: darray[ProofBound]&, depth: usize, markers: ProofScalarWitnesses&, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            can Abort.Panic:
                if proof_goal_bool_ref_value(exhausted):
                    return false
                if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT:
                    exhausted <- true
                    return false
                marker_scale: (complete: bool, scale: usize) = proof_linear_safety_marker_scale_with_work(markers, budget, exhausted)
                return false if not marker_scale.complete
                return proof_signed_expression_safe_with_bounds_work_inner_scaled(expression, facts, bounds, depth, markers, marker_scale.scale, budget, exhausted)

        def proof_signed_expression_safe_with_bounds_work_inner(expression: Ast::Expr, facts: darray[Ast::Expr]&, bounds: darray[ProofBound]&, depth: usize, markers: ProofScalarWitnesses&, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            marker_scale: (complete: bool, scale: usize) = proof_linear_safety_marker_scale_with_work(markers, budget, exhausted)
            return false if not marker_scale.complete
            return proof_signed_expression_safe_with_bounds_work_inner_scaled(expression, facts, bounds, depth, markers, marker_scale.scale, budget, exhausted)

        def proof_signed_expression_safe_with_bounds_work_inner_scaled(expression: Ast::Expr, facts: darray[Ast::Expr]&, bounds: darray[ProofBound]&, depth: usize, markers: ProofScalarWitnesses&, marker_scale: usize, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            can Abort.Panic:
                return false if proof_goal_bool_ref_value(exhausted)
                if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT:
                    exhausted <- true
                    return false
                return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                match expression:
                    Ast::Expr.Paren(inner, _):
                        return proof_signed_expression_safe_with_bounds_work_inner_scaled(inner, facts, bounds, depth + 1, markers, marker_scale, budget, exhausted)
                    Ast::Expr.Unary(operator, operand, _):
                        return false if not proof_signed_expression_safe_with_bounds_work_inner_scaled(operand, facts, bounds, depth + 1, markers, marker_scale, budget, exhausted)
                        if operator == TokenKind.Minus:
                            width: i64 = proof_signed_width_in_expression_with_scale_work(operand, markers, depth + 1, marker_scale, budget, exhausted)
                            return false if proof_goal_bool_ref_value(exhausted)
                            if width != 0:
                                interval: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_interval_with_work(expression, bounds, 0, budget, exhausted)
                                return false if proof_goal_bool_ref_value(exhausted)
                                return interval.has_lower and interval.has_upper and interval.lower >= ElisaProofKernelCore::proof_kernel_signed_width_min(width) and interval.upper <= ElisaProofKernelCore::proof_kernel_signed_width_max(width)
                        return true
                    Ast::Expr.Binary(left, operator, right, _):
                        return false if:
                            not proof_signed_expression_safe_with_bounds_work_inner_scaled(left, facts, bounds, depth + 1, markers, marker_scale, budget, exhausted)
                            exhausted
                            not proof_signed_expression_safe_with_bounds_work_inner_scaled(right, facts, bounds, depth + 1, markers, marker_scale, budget, exhausted)
                            exhausted
                        arithmetic: bool = operator == TokenKind.Plus or operator == TokenKind.Minus or operator == TokenKind.Star or operator == TokenKind.Slash or operator == TokenKind.Percent or operator == TokenKind.LShift or operator == TokenKind.RShift or operator == TokenKind.Ampersand or operator == TokenKind.Pipe or operator == TokenKind.Caret
                        return true if not arithmetic
                        width: i64 = proof_signed_width_in_expression_with_scale_work(expression, markers, depth, marker_scale, budget, exhausted)
                        return false if proof_goal_bool_ref_value(exhausted)
                        if width == 0:
                            return true if proof_unsigned_width_in_expression_with_work(expression, markers, budget, exhausted) != 0
                            return false if proof_goal_bool_ref_value(exhausted)
                            constant: (known: bool, value: i64) = proof_constant_int_with_work(expression, 0, budget, exhausted)
                            return false if proof_goal_bool_ref_value(exhausted)
                            return constant.known and constant.value >= ElisaProofKernelCore::PROOF_KERNEL_I64_MIN and constant.value <= ElisaProofKernelCore::PROOF_KERNEL_I64_MAX if constant.known
                            interval: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_interval_with_work(expression, bounds, 0, budget, exhausted)
                            return false if proof_goal_bool_ref_value(exhausted)
                            scalar_result: (complete: bool, matches: bool) = proof_linear_safety_scalar_witness_with_work(expression, markers, marker_scale, budget, exhausted)
                            return false if not scalar_result.complete
                            scalar_witnessed: bool = scalar_result.matches
                            return interval.has_lower and interval.has_upper and interval.lower >= 0 and interval.upper <= ElisaProofKernelCore::PROOF_KERNEL_I8_MAX if scalar_witnessed
                            return not scalar_witnessed
                        interval: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_interval_with_work(expression, bounds, 0, budget, exhausted)
                        return false if proof_goal_bool_ref_value(exhausted)
                        return true if interval.has_lower and interval.has_upper and interval.lower >= ElisaProofKernelCore::proof_kernel_signed_width_min(width) and interval.upper <= ElisaProofKernelCore::proof_kernel_signed_width_max(width)
                        guarded_subtraction: (complete: bool, safe: bool) = proof_signed_guarded_subtraction_safe_with_work(expression, facts, bounds, markers, marker_scale, width, budget, exhausted)
                        return false if not guarded_subtraction.complete or proof_goal_bool_ref_value(exhausted)
                        return true if guarded_subtraction.safe
                        return false if proof_goal_bool_ref_value(exhausted)
                        nonnegative_sum: (complete: bool, safe: bool) = proof_signed_nonnegative_sum_safe_with_work(expression, facts, bounds, markers, marker_scale, width, budget, exhausted)
                        return false if not nonnegative_sum.complete or proof_goal_bool_ref_value(exhausted)
                        return true if nonnegative_sum.safe
                        return false if proof_goal_bool_ref_value(exhausted)
                        return proof_signed_increment_has_strict_peer_with_work(expression, facts, markers, marker_scale, width, budget, exhausted) if width > 0
                        return false
                    Ast::Expr.If(condition, then_expression, else_expression, _):
                        branch_sorts: (complete: bool, compatible: bool) = proof_fixed_width_if_branch_sorts_compatible_with_work(then_expression, else_expression, markers, marker_scale, budget, exhausted)
                        return false if not branch_sorts.complete or not branch_sorts.compatible
                        return false if:
                            not proof_signed_expression_safe_with_bounds_work_inner_scaled(condition, facts, bounds, depth + 1, markers, marker_scale, budget, exhausted)
                            exhausted
                            not proof_signed_expression_safe_with_bounds_work_inner_scaled(then_expression, facts, bounds, depth + 1, markers, marker_scale, budget, exhausted)
                            exhausted
                        return proof_signed_expression_safe_with_bounds_work_inner_scaled(else_expression, facts, bounds, depth + 1, markers, marker_scale, budget, exhausted)
                    Ast::Expr.Field(object, _, _) | Ast::Expr.Scope(object, _, _):
                        return proof_signed_expression_safe_with_bounds_work_inner_scaled(object, facts, bounds, depth + 1, markers, marker_scale, budget, exhausted)
                    Ast::Expr.Call(callee, arguments, _, _):
                        return false if:
                            not proof_signed_expression_safe_with_bounds_work_inner_scaled(callee, facts, bounds, depth + 1, markers, marker_scale, budget, exhausted)
                            exhausted
                        for argument in arguments |argument, facts, bounds, depth, markers, marker_scale, budget, exhausted|:
                            return false if:
                                not proof_signed_expression_safe_with_bounds_work_inner_scaled(argument, facts, bounds, depth + 1, markers, marker_scale, budget, exhausted)
                                exhausted
                        return true
                    _:
                        return true

        def proof_signed_increment_has_strict_peer_with_work(expression: Ast::Expr, facts: darray[Ast::Expr]&, markers: ProofScalarWitnesses&, marker_scale: usize, width: i64, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            can Abort.Panic:
                return false if proof_goal_bool_ref_value(exhausted) or width == 0
                match expression:
                    Ast::Expr.Binary(left, operator, right, _):
                        return false if operator != TokenKind.Plus
                        unit: (known: bool, base: Ast::Expr) = proof_unsigned_unit_increment_base_with_work(left, right, budget, exhausted)
                        return false if proof_goal_bool_ref_value(exhausted) or not unit.known
                        fact_scan_cost: mutable usize = 0
                        fact_scan_cost_valid: mutable bool = false
                        for fact in facts |fact, unit, width, facts, markers, marker_scale, fact_scan_cost, fact_scan_cost_valid, budget, exhausted|:
                            return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                            order: (complete: bool, known: bool, left: Ast::Expr, operator: TokenKind, right: Ast::Expr) = proof_signed_readable_order_with_work(fact, facts, markers, marker_scale, &fact_scan_cost, &fact_scan_cost_valid, budget, exhausted)
                            return false if not order.complete or proof_goal_bool_ref_value(exhausted)
                            continue if not order.known
                            if order.operator == TokenKind.Lt:
                                same_base: bool = proof_unsigned_witness_terms_equal_with_work(order.left, unit.base, budget, exhausted)
                                return false if proof_goal_bool_ref_value(exhausted)
                                if same_base:
                                    peer_width: i64 = proof_signed_width_in_expression_with_scale_work(order.right, markers, 0, marker_scale, budget, exhausted)
                                    return false if proof_goal_bool_ref_value(exhausted)
                                    return true if peer_width > 0 and peer_width <= width
                            if order.operator == TokenKind.Gt:
                                same_base: bool = proof_unsigned_witness_terms_equal_with_work(order.right, unit.base, budget, exhausted)
                                return false if proof_goal_bool_ref_value(exhausted)
                                if same_base:
                                    peer_width: i64 = proof_signed_width_in_expression_with_scale_work(order.left, markers, 0, marker_scale, budget, exhausted)
                                    return false if proof_goal_bool_ref_value(exhausted)
                                    return true if peer_width > 0 and peer_width <= width
                        return false
                    _:
                        return false

        def proof_signed_guarded_subtraction_safe_with_work(expression: Ast::Expr, facts: darray[Ast::Expr]&, bounds: darray[ProofBound]&, markers: ProofScalarWitnesses&, marker_scale: usize, width: i64, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, safe: bool):
            can Abort.Panic:
                match expression:
                    Ast::Expr.Binary(left, operator, right, _):
                        return (true, false) if:
                            operator != TokenKind.Minus
                            width == 0
                        left_width: i64 = proof_signed_width_in_expression_with_scale_work(left, markers, 0, marker_scale, budget, exhausted)
                        return (false, false) if proof_goal_bool_ref_value(exhausted)
                        return (true, false) if left_width != width
                        right_width: i64 = proof_signed_width_in_expression_with_scale_work(right, markers, 0, marker_scale, budget, exhausted)
                        return (false, false) if proof_goal_bool_ref_value(exhausted)
                        return (true, false) if right_width != width
                        right_interval: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_interval_with_work(right, bounds, 0, budget, exhausted)
                        return (false, false) if proof_goal_bool_ref_value(exhausted)
                        return (true, false) if not right_interval.has_lower or right_interval.lower < 0
                        fact_scan_cost: mutable usize = 0
                        fact_scan_cost_valid: mutable bool = false
                        order_fact: (complete: bool, matches: bool) = proof_signed_has_order_fact_with_work(right, left, false, facts, markers, marker_scale, &fact_scan_cost, &fact_scan_cost_valid, budget, exhausted)
                        return (false, false) if not order_fact.complete
                        return (true, order_fact.matches)
                    _:
                        return (true, false)

        def proof_signed_nonnegative_sum_safe_with_work(expression: Ast::Expr, facts: darray[Ast::Expr]&, bounds: darray[ProofBound]&, markers: ProofScalarWitnesses&, marker_scale: usize, width: i64, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, safe: bool):
            can Abort.Panic:
                match expression:
                    Ast::Expr.Binary(left, operator, right, _):
                        return (true, false) if operator != TokenKind.Plus or width == 0
                        left_width: i64 = proof_signed_width_in_expression_with_scale_work(left, markers, 0, marker_scale, budget, exhausted)
                        return (false, false) if proof_goal_bool_ref_value(exhausted)
                        return (true, false) if left_width != width
                        right_width: i64 = proof_signed_width_in_expression_with_scale_work(right, markers, 0, marker_scale, budget, exhausted)
                        return (false, false) if proof_goal_bool_ref_value(exhausted)
                        return (true, false) if right_width != width
                        left_interval: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_interval_with_work(left, bounds, 0, budget, exhausted)
                        return (false, false) if proof_goal_bool_ref_value(exhausted)
                        right_interval: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_interval_with_work(right, bounds, 0, budget, exhausted)
                        return (false, false) if proof_goal_bool_ref_value(exhausted)
                        return (true, false) if not left_interval.has_lower or left_interval.lower < 0 or not right_interval.has_lower or right_interval.lower < 0
                        witness: (complete: bool, known: bool, bound: Ast::Expr, strict: bool) = proof_sum_upper_witness_with_work(left, right, facts, markers, budget, exhausted)
                        return (false, false) if not witness.complete or proof_goal_bool_ref_value(exhausted)
                        return (true, false) if not witness.known
                        bound_width: i64 = proof_signed_width_in_expression_with_scale_work(witness.bound, markers, 0, marker_scale, budget, exhausted)
                        return (false, false) if proof_goal_bool_ref_value(exhausted)
                        return (true, bound_width > 0 and bound_width <= width)
                    _:
                        return (true, false)

        def proof_signed_has_order_fact_with_work(term: Ast::Expr, bound: Ast::Expr, strict_only: bool, facts: darray[Ast::Expr]&, markers: ProofScalarWitnesses&, marker_scale: usize, fact_scan_cost: mutable usize&, fact_scan_cost_valid: mutable bool&, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, matches: bool):
            can Abort.Panic:
                for fact in facts |fact, term, bound, strict_only, facts, markers, marker_scale, fact_scan_cost, fact_scan_cost_valid, budget, exhausted|:
                    found: (complete: bool, matches: bool) = proof_signed_has_order_in_fact_with_work(fact, term, bound, strict_only, facts, markers, marker_scale, fact_scan_cost, fact_scan_cost_valid, 0, budget, exhausted)
                    return found if not found.complete or found.matches
                return (not proof_goal_bool_ref_value(exhausted), false)

        def proof_signed_has_order_in_fact_with_work(expression: Ast::Expr, term: Ast::Expr, bound: Ast::Expr, strict_only: bool, facts: darray[Ast::Expr]&, markers: ProofScalarWitnesses&, marker_scale: usize, fact_scan_cost: mutable usize&, fact_scan_cost_valid: mutable bool&, depth: usize, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, matches: bool):
            can Abort.Panic:
                stripped: (complete: bool, fact: Ast::Expr) = proof_signed_strip_parens_with_work(expression, budget, exhausted)
                return (false, false) if not stripped.complete
                fact: Ast::Expr = stripped.fact
                if depth < ElisaProofKernelCore::PROOF_KERNEL_STRUCTURAL_SCAN_DEPTH_LIMIT:
                    match fact:
                        Ast::Expr.Binary(left, TokenKind.And, right, _):
                            first: (complete: bool, matches: bool) = proof_signed_has_order_in_fact_with_work(left, term, bound, strict_only, facts, markers, marker_scale, fact_scan_cost, fact_scan_cost_valid, depth + 1, budget, exhausted)
                            return first if not first.complete or first.matches
                            return proof_signed_has_order_in_fact_with_work(right, term, bound, strict_only, facts, markers, marker_scale, fact_scan_cost, fact_scan_cost_valid, depth + 1, budget, exhausted)
                        _:
                            pass
                else:
                    match fact:
                        Ast::Expr.Binary(_, TokenKind.And, _, _):
                            return (true, false)
                        _:
                            pass
                order: (complete: bool, known: bool, left: Ast::Expr, operator: TokenKind, right: Ast::Expr) = proof_signed_readable_order_with_work(fact, facts, markers, marker_scale, fact_scan_cost, fact_scan_cost_valid, budget, exhausted)
                return (false, false) if not order.complete
                return (true, false) if not order.known
                left_matches: bool = proof_unsigned_witness_terms_equal_with_work(order.left, term, budget, exhausted)
                return (false, false) if proof_goal_bool_ref_value(exhausted)
                right_matches: bool = proof_unsigned_witness_terms_equal_with_work(order.right, bound, budget, exhausted)
                return (false, false) if proof_goal_bool_ref_value(exhausted)
                if order.operator == TokenKind.Lt and left_matches and right_matches:
                    return (true, true)
                left_reverse: bool = proof_unsigned_witness_terms_equal_with_work(order.right, term, budget, exhausted)
                return (false, false) if proof_goal_bool_ref_value(exhausted)
                right_reverse: bool = proof_unsigned_witness_terms_equal_with_work(order.left, bound, budget, exhausted)
                return (false, false) if proof_goal_bool_ref_value(exhausted)
                if order.operator == TokenKind.Gt and left_reverse and right_reverse:
                    return (true, true)
                return (true, false) if strict_only
                if order.operator == TokenKind.LtEq and left_matches and right_matches:
                    return (true, true)
                return (true, order.operator == TokenKind.GtEq and left_reverse and right_reverse)

        def proof_signed_strip_parens_with_work(expression: Ast::Expr, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, fact: Ast::Expr):
            current: mutable Ast::Expr = expression
            depth: mutable usize = 0
            while depth < ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT |current, depth, budget, exhausted|:
                return (false, current) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                match current:
                    Ast::Expr.Paren(inner, _):
                        current <- inner
                        depth <- depth + 1
                    _:
                        return (true, current)
            exhausted <- true
            return (false, current)

        def proof_signed_fact_scan_cost_ensure_with_work(facts: darray[Ast::Expr]&, fact_scan_cost: mutable usize&, valid: mutable bool&, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            can Abort.Panic:
                return false if proof_goal_bool_ref_value(exhausted)
                return true if proof_goal_bool_ref_value(valid)
                for candidate in facts |candidate, fact_scan_cost, budget, exhausted|:
                    candidate_cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(candidate, budget, exhausted)
                    return false if not candidate_cost.complete
                    if candidate_cost.cost >= PROOF_LINEAR_SAFETY_WORK_LIMIT or fact_scan_cost > PROOF_LINEAR_SAFETY_WORK_LIMIT - candidate_cost.cost - 1:
                        exhausted <- true
                        return false
                    return false if not proof_linear_safety_work_charge(budget, exhausted, candidate_cost.cost) or not proof_linear_safety_work_charge(budget, exhausted, 1)
                    fact_scan_cost <- fact_scan_cost + candidate_cost.cost + 1
                valid <- true
                return true

        def proof_signed_readable_order_with_work(fact: Ast::Expr, facts: darray[Ast::Expr]&, markers: ProofScalarWitnesses&, marker_scale: usize, fact_scan_cost: mutable usize&, fact_scan_cost_valid: mutable bool&, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, known: bool, left: Ast::Expr, operator: TokenKind, right: Ast::Expr):
            can Abort.Panic:
                unknown: (complete: bool, known: bool, left: Ast::Expr, operator: TokenKind, right: Ast::Expr) = (not proof_goal_bool_ref_value(exhausted), false, fact, TokenKind.Eof, fact)
                cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(fact, budget, exhausted)
                return (false, false, fact, TokenKind.Eof, fact) if not cost.complete
                match fact:
                    Ast::Expr.Binary(left, operator, right, _):
                        return unknown if not proof_is_order_operator(operator)
                        left_scalar: (complete: bool, matches: bool) = proof_linear_safety_scalar_witness_with_work(left, markers, marker_scale, budget, exhausted)
                        return (false, false, fact, TokenKind.Eof, fact) if not left_scalar.complete
                        return unknown if not left_scalar.matches
                        right_scalar: (complete: bool, matches: bool) = proof_linear_safety_scalar_witness_with_work(right, markers, marker_scale, budget, exhausted)
                        return (false, false, fact, TokenKind.Eof, fact) if not right_scalar.complete
                        return unknown if not right_scalar.matches
                        return (true, true, left, operator, right)
                    Ast::Expr.Unary(TokenKind.Not, operand, _):
                        match operand:
                            Ast::Expr.Binary(left, operator, right, _):
                                negated: TokenKind = proof_comparison_negation(operator)
                                return unknown if not proof_is_order_operator(negated)
                                left_scalar: (complete: bool, matches: bool) = proof_linear_safety_scalar_witness_with_work(left, markers, marker_scale, budget, exhausted)
                                return (false, false, fact, TokenKind.Eof, fact) if not left_scalar.complete
                                return unknown if not left_scalar.matches
                                right_scalar: (complete: bool, matches: bool) = proof_linear_safety_scalar_witness_with_work(right, markers, marker_scale, budget, exhausted)
                                return (false, false, fact, TokenKind.Eof, fact) if not right_scalar.complete
                                return unknown if not right_scalar.matches
                                return (false, false, fact, TokenKind.Eof, fact) if not proof_signed_fact_scan_cost_ensure_with_work(facts, fact_scan_cost, fact_scan_cost_valid, budget, exhausted)
                                left_integer: (complete: bool, integer: bool) = proof_disjunction_denial_integer_term_with_work(left, facts, markers, marker_scale, fact_scan_cost, 0, budget, exhausted)
                                return (false, false, fact, TokenKind.Eof, fact) if not left_integer.complete
                                return unknown if not left_integer.integer
                                right_integer: (complete: bool, integer: bool) = proof_disjunction_denial_integer_term_with_work(right, facts, markers, marker_scale, fact_scan_cost, 0, budget, exhausted)
                                return (false, false, fact, TokenKind.Eof, fact) if not right_integer.complete
                                return unknown if not right_integer.integer
                                return (true, true, left, negated, right)
                            _:
                                return unknown
                    _:
                        return unknown

        def proof_signed_safety_bounds_from_base_with_work(facts: darray[Ast::Expr]&, base_bounds: darray[ProofBound]&, signed_bounds: mutable darray[ProofBound]&, markers: ProofScalarWitnesses&, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            can Abort.Panic:
                signed_bounds <- []
                return false if proof_goal_bool_ref_value(exhausted)
                bounds: mutable darray[ProofBound] = []
                for base_bound in base_bounds |base_bound, bounds, budget, exhausted|:
                    return false if not proof_linear_safety_work_charge(budget, exhausted, 1) or not proof_linear_safety_work_charge(budget, exhausted, sview_len(base_bound.name))
                    bounds.push(base_bound)
                return false if:
                    not proof_signed_add_type_bounds_with_work(facts, &bounds, budget, exhausted)
                    not proof_close_term_equalities_work_inner(facts, &bounds, markers, budget, exhausted)
                constraints: mutable darray[ProofDifference] = []
                return false if:
                    not proof_collect_fact_difference_constraints_with_work(facts, bounds, &constraints, budget, exhausted)
                    not proof_close_bounds_through_differences_with_work(constraints, &bounds, budget, exhausted)
                signed_bounds <- bounds
                return true

