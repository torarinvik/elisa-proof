# Work-aware signed overflow analysis and its shared signed-bound context.
extend ElisaProof:
    public:
        def proof_signed_safety_reserve_expression_read_with_work(expression: Ast::Expr, fact_nodes: usize, bound_nodes: usize, bound_count: usize, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            nodes: mutable usize = 0
            if not proof_linear_safety_expression_shape_with_work(expression, 0, &nodes, &budget, &exhausted):
                exhausted <- true
                return false
            return false if not proof_linear_safety_charge_cross_with_work(budget, exhausted, nodes, fact_nodes, PROOF_LINEAR_SAFETY_SCAN_MULTIPLIER)
            return false if not proof_linear_safety_charge_cross_with_work(budget, exhausted, nodes, bound_nodes, PROOF_LINEAR_SAFETY_SCAN_MULTIPLIER)
            return proof_linear_safety_charge_cross_with_work(budget, exhausted, nodes, bound_count, PROOF_LINEAR_SAFETY_SCAN_MULTIPLIER)

        # `exhausted` distinguishes budget/depth failure from an ordinary unsafe result. Expensive
        # legacy width, witness, order, and interval readers are preceded by a cross-scan reserve
        # based on the full fact and bound AST sizes. Recursive safety visits and each name-bound
        # index/update scan are charged directly.
        def proof_signed_expression_safe_with_bounds_work(expression: Ast::Expr, facts: darray[Ast::Expr]&, bounds: darray[ProofBound]&, depth: usize, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            if exhausted:
                return false
            if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT:
                exhausted <- true
                return false
            fact_nodes: mutable usize = 0
            bound_nodes: mutable usize = 0
            return false if not proof_linear_safety_fact_shape_total_with_work(facts, &fact_nodes, budget, exhausted)
            return false if not proof_linear_safety_bound_shape_total_with_work(bounds, &bound_nodes, budget, exhausted)
            return proof_signed_expression_safe_with_bounds_work_inner(expression, facts, bounds, depth, fact_nodes, bound_nodes, budget, exhausted)

        def proof_signed_expression_safe_with_bounds_work_inner(expression: Ast::Expr, facts: darray[Ast::Expr]&, bounds: darray[ProofBound]&, depth: usize, fact_nodes: usize, bound_nodes: usize, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            return false if exhausted
            if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT:
                exhausted <- true
                return false
            return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_signed_expression_safe_with_bounds_work_inner(inner, facts, bounds, depth + 1, fact_nodes, bound_nodes, budget, exhausted)
                Ast::Expr.Unary(operator, operand, _):
                    return false if not proof_signed_expression_safe_with_bounds_work_inner(operand, facts, bounds, depth + 1, fact_nodes, bound_nodes, budget, exhausted)
                    if operator == TokenKind.Minus:
                        return false if not proof_signed_safety_reserve_expression_read_with_work(operand, fact_nodes, bound_nodes, bounds.count, budget, exhausted)
                        width: i64 = proof_signed_width_in_expression(operand, facts)
                        if width != 0:
                            return false if not proof_signed_safety_reserve_expression_read_with_work(expression, fact_nodes, bound_nodes, bounds.count, budget, exhausted)
                            interval: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_interval(expression, bounds)
                            return interval.has_lower and interval.has_upper and interval.lower >= ElisaProofKernelCore::proof_kernel_signed_width_min(width) and interval.upper <= ElisaProofKernelCore::proof_kernel_signed_width_max(width)
                    return true
                Ast::Expr.Binary(left, operator, right, _):
                    return false if not proof_signed_expression_safe_with_bounds_work_inner(left, facts, bounds, depth + 1, fact_nodes, bound_nodes, budget, exhausted)
                    return false if exhausted
                    return false if not proof_signed_expression_safe_with_bounds_work_inner(right, facts, bounds, depth + 1, fact_nodes, bound_nodes, budget, exhausted)
                    return false if exhausted
                    arithmetic: bool = operator == TokenKind.Plus or operator == TokenKind.Minus or operator == TokenKind.Star or operator == TokenKind.Slash or operator == TokenKind.Percent or operator == TokenKind.LShift or operator == TokenKind.RShift or operator == TokenKind.Ampersand or operator == TokenKind.Pipe or operator == TokenKind.Caret
                    return true if not arithmetic
                    return false if not proof_signed_safety_reserve_expression_read_with_work(expression, fact_nodes, bound_nodes, bounds.count, budget, exhausted)
                    width: i64 = proof_signed_width_in_expression(expression, facts)
                    if width == 0:
                        return false if not proof_signed_safety_reserve_expression_read_with_work(expression, fact_nodes, bound_nodes, bounds.count, budget, exhausted)
                        return true if proof_unsigned_width_in_expression(expression, facts) != 0
                        constant: (known: bool, value: i64) = proof_constant_int(expression)
                        return constant.known and constant.value >= ElisaProofKernelCore::PROOF_KERNEL_I64_MIN and constant.value <= ElisaProofKernelCore::PROOF_KERNEL_I64_MAX if constant.known
                        return false if not proof_signed_safety_reserve_expression_read_with_work(expression, fact_nodes, bound_nodes, bounds.count, budget, exhausted)
                        interval: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_interval(expression, bounds)
                        return interval.has_lower and interval.has_upper and interval.lower >= 0 and interval.upper <= ElisaProofKernelCore::PROOF_KERNEL_I8_MAX if proof_scalar_term_witnessed(expression, facts, depth + 1)
                        return not proof_scalar_term_witnessed(expression, facts, depth + 1)
                    return false if not proof_signed_safety_reserve_expression_read_with_work(expression, fact_nodes, bound_nodes, bounds.count, budget, exhausted)
                    interval: (known: bool, lower: i64, upper: i64, has_lower: bool, has_upper: bool) = proof_interval(expression, bounds)
                    return true if interval.has_lower and interval.has_upper and interval.lower >= ElisaProofKernelCore::proof_kernel_signed_width_min(width) and interval.upper <= ElisaProofKernelCore::proof_kernel_signed_width_max(width)
                    return false if not proof_signed_safety_reserve_expression_read_with_work(expression, fact_nodes, bound_nodes, bounds.count, budget, exhausted)
                    return true if proof_signed_guarded_subtraction_safe(expression, facts, bounds)
                    return false if exhausted
                    return false if not proof_signed_safety_reserve_expression_read_with_work(expression, fact_nodes, bound_nodes, bounds.count, budget, exhausted)
                    return true if proof_signed_nonnegative_sum_safe(expression, facts, bounds)
                    return false if exhausted
                    return false if not proof_signed_safety_reserve_expression_read_with_work(expression, fact_nodes, bound_nodes, bounds.count, budget, exhausted)
                    return proof_signed_increment_has_strict_peer(expression, facts) if width > 0
                    return false
                Ast::Expr.If(condition, then_expression, else_expression, _):
                    return false if not proof_signed_expression_safe_with_bounds_work_inner(condition, facts, bounds, depth + 1, fact_nodes, bound_nodes, budget, exhausted)
                    return false if exhausted
                    return false if not proof_signed_expression_safe_with_bounds_work_inner(then_expression, facts, bounds, depth + 1, fact_nodes, bound_nodes, budget, exhausted)
                    return false if exhausted
                    return proof_signed_expression_safe_with_bounds_work_inner(else_expression, facts, bounds, depth + 1, fact_nodes, bound_nodes, budget, exhausted)
                Ast::Expr.Call(callee, arguments, _, _):
                    return false if not proof_signed_expression_safe_with_bounds_work_inner(callee, facts, bounds, depth + 1, fact_nodes, bound_nodes, budget, exhausted)
                    return false if exhausted
                    for argument in arguments |argument, facts, bounds, depth, fact_nodes, bound_nodes, budget, exhausted|:
                        return false if not proof_signed_expression_safe_with_bounds_work_inner(argument, facts, bounds, depth + 1, fact_nodes, bound_nodes, budget, exhausted)
                        return false if exhausted
                    return true
                _:
                    return true

        def proof_signed_safety_bounds_from_base_with_work(facts: darray[Ast::Expr]&, base_bounds: darray[ProofBound]&, signed_bounds: mutable darray[ProofBound]&, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            signed_bounds <- []
            return false if exhausted
            fact_nodes: mutable usize = 0
            base_bound_nodes: mutable usize = 0
            return false if not proof_linear_safety_fact_shape_total_with_work(facts, &fact_nodes, budget, exhausted)
            return false if not proof_linear_safety_bound_shape_total_with_work(base_bounds, &base_bound_nodes, budget, exhausted)
            bounds: mutable darray[ProofBound] = []
            for base_bound in base_bounds |base_bound, bounds, budget, exhausted|:
                return false if not proof_linear_safety_work_charge(budget, exhausted, 1 + sview_len(base_bound.name))
                bounds.push(base_bound)
            return false if not proof_signed_add_type_bounds_with_work(facts, &bounds, budget, exhausted)
            return false if not proof_close_term_equalities_work_inner(facts, &bounds, fact_nodes, base_bound_nodes, budget, exhausted)
            constraints: mutable darray[ProofDifference] = []
            return false if not proof_collect_fact_difference_constraints_with_work(facts, bounds, &constraints, budget, exhausted)
            return false if not proof_close_bounds_through_differences_with_work(constraints, &bounds, budget, exhausted)
            signed_bounds <- bounds
            return true

