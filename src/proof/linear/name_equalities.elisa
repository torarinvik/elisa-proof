const PROOF_LINEAR_NAME_EQUALITY_VISIT_LIMIT: usize = 65536
const PROOF_LINEAR_NAME_EQUALITY_FACT_LIMIT: usize = 256

extend ElisaProof:
    public:
        def proof_name_equality_sort_from_facts(expression: Ast::Expr, facts: darray[Ast::Expr]&) -> i64:
            name: sview = proof_ident_name(expression)
            return 0 if name == ""
            budget: mutable usize = 0
            exhausted: mutable bool = false
            indexed: (complete: bool, index: ProofNameEqualitySortIndex) = proof_name_equality_sort_index_build(facts, &budget, &exhausted)
            return 0 if not indexed.complete or exhausted
            width: i64 = proof_name_equality_sort_index_lookup(indexed.index, name, &budget, &exhausted)
            return 0 if exhausted
            width

        def proof_name_equality_sort_with_work(expression: Ast::Expr, index: ProofNameEqualitySortIndex, budget: mutable usize&, exhausted: mutable bool&) -> i64:
            return 0 if exhausted
            name: sview = proof_ident_name(expression)
            proof_name_equality_sort_index_lookup(index, name, budget, exhausted)

        # Charge a bounded structural scan before a scalar comparison can walk the
        # candidate terms against every retained witness marker.
        def proof_linear_safety_expr_cost_with_work(expression: Ast::Expr, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, cost: usize):
            return (false, 0) if exhausted
            cost: mutable usize = 0
            if not proof_replay_summary_expr_cost_with_limit(expression, &cost, budget, PROOF_LINEAR_SAFETY_WORK_LIMIT):
                # An incomplete cost walk may have stopped at a depth or remaining-work
                # boundary without updating the caller's counter. Exhaust this shared meter
                # so a later phase cannot restart the same oversized expression scan.
                budget <- PROOF_LINEAR_SAFETY_WORK_LIMIT
                exhausted <- true
                return (false, 0)
            return (false, 0) if not proof_linear_safety_work_charge(budget, exhausted, cost)
            return (true, cost)

        def proof_linear_safety_marker_scale_with_work(markers: ProofScalarWitnesses&, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, scale: usize):
            scale: mutable usize = 0
            if markers.names.count != markers.name_unsigned_widths.count or markers.names.count != markers.name_hashes.count or (markers.sorted_name_indices.count != 0 and markers.names.count != markers.sorted_name_indices.count) or markers.element_terms.count != markers.element_depths.count or markers.element_terms.count != markers.element_widths.count or markers.signed_terms.count != markers.signed_widths.count or markers.unsigned_terms.count != markers.unsigned_widths.count:
                exhausted <- true
                return (false, 0)
            if (markers.signed_hashes.count != 0 and markers.signed_hashes.count != markers.signed_terms.count) or (markers.signed_slots.count != 0 and markers.signed_slots.count < markers.signed_terms.count) or (markers.unsigned_hashes.count != 0 and markers.unsigned_hashes.count != markers.unsigned_terms.count) or (markers.unsigned_slots.count != 0 and markers.unsigned_slots.count < markers.unsigned_terms.count) or ((markers.signed_hashes.count == 0) != (markers.signed_slots.count == 0)) or ((markers.unsigned_hashes.count == 0) != (markers.unsigned_slots.count == 0)):
                exhausted <- true
                return (false, 0)
            if markers.names.count == 0:
                if markers.name_slots.count != 0:
                    exhausted <- true
                    return (false, 0)
            elif markers.name_slots.count < markers.names.count:
                exhausted <- true
                return (false, 0)
            for term in markers.untrusted_terms |term, scale, budget, exhausted|:
                return (false, 0) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(term, budget, exhausted)
                return (false, 0) if not cost.complete
                scale <- scale + cost.cost + 1
            for term in markers.scalar_terms |term, scale, budget, exhausted|:
                return (false, 0) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(term, budget, exhausted)
                return (false, 0) if not cost.complete
                scale <- scale + cost.cost + 1
            for term in markers.element_terms |term, scale, budget, exhausted|:
                return (false, 0) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(term, budget, exhausted)
                return (false, 0) if not cost.complete
                scale <- scale + cost.cost + 1
            for name in markers.names |name, scale, budget, exhausted|:
                amount: usize = 1 + sview_len(name)
                return (false, 0) if not proof_linear_safety_work_charge(budget, exhausted, amount)
                scale <- scale + amount
            return (false, 0) if not proof_linear_safety_work_charge(budget, exhausted, markers.name_hashes.count) or not proof_linear_safety_work_charge(budget, exhausted, markers.name_slots.count) or not proof_linear_safety_work_charge(budget, exhausted, markers.sorted_name_indices.count)
            scale <- scale + markers.name_hashes.count + markers.name_slots.count + markers.sorted_name_indices.count + 1
            for slot in markers.name_slots |slot, markers, budget, exhausted|:
                return (false, 0) if slot > markers.names.count
            for name_index in markers.sorted_name_indices |name_index, markers, budget, exhausted|:
                if name_index >= markers.names.count:
                    exhausted <- true
                    return (false, 0)
            return (true, scale)

        def proof_linear_safety_comparison_with_work(left: Ast::Expr, right: Ast::Expr, markers: ProofScalarWitnesses&, marker_scale: usize, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, matches: bool):
            left_cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(left, budget, exhausted)
            return (false, false) if not left_cost.complete
            right_cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(right, budget, exhausted)
            return (false, false) if not right_cost.complete
            term_cost: usize = left_cost.cost + right_cost.cost
            factor: usize = marker_scale + 1
            remaining: usize = PROOF_LINEAR_SAFETY_WORK_LIMIT - budget
            if factor != 0 and term_cost > remaining / factor:
                proof_linear_safety_work_charge(budget, exhausted, remaining + 1)
                return (false, false)
            return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, term_cost * factor)
            return (true, proof_primitive_comparison_marked(left, right, markers))

        def proof_alias_name_index_with_work(names: darray[sview]&, name: sview, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, index: usize):
            index: mutable usize = 0
            while index < names.count |index, names, name, budget, exhausted|:
                return (false, names.count) if not proof_linear_safety_work_charge(budget, exhausted, 1) or not proof_linear_safety_work_charge(budget, exhausted, sview_len(name))
                return (true, index) if names[index] == name
                index <- index + 1
            return (true, names.count)

        # Work-aware sibling of the legacy closure. False means the shared work cap
        # stopped analysis; callers must treat the result as unknown.
        def proof_close_equalities_with_work(facts: darray[Ast::Expr]&, markers: ProofScalarWitnesses&, bounds: mutable darray[ProofBound]&, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            marker_scan: (complete: bool, scale: usize) = proof_linear_safety_marker_scale_with_work(markers, budget, exhausted)
            return false if not marker_scan.complete
            left_names: mutable darray[sview] = []
            right_names: mutable darray[sview] = []
            sort_index_result: (complete: bool, index: ProofNameEqualitySortIndex) = proof_name_equality_sort_index_build(facts, budget, exhausted)
            return false if not sort_index_result.complete
            root_checks: mutable usize = 0
            for fact in facts |fact, markers, sort_index_result, left_names, right_names, budget, exhausted, marker_scan|:
                return false if:
                    not proof_linear_safety_work_charge(budget, exhausted, 1)
                    not proof_collect_name_equalities_metered_with_work(fact, markers, sort_index_result.index, marker_scan.scale, left_names, right_names, root_checks, PROOF_LINEAR_SAFETY_WORK_LIMIT, budget, exhausted, 0)

            names: mutable darray[sview] = []
            edge_left: mutable darray[usize] = []
            edge_right: mutable darray[usize] = []
            return false if left_names.count != right_names.count
            vertex_index_result: (complete: bool, index: ProofNameEqualityVertexIndex) = proof_name_equality_vertex_index_build(left_names.count, budget, exhausted)
            return false if not vertex_index_result.complete
            vertex_index: mutable ProofNameEqualityVertexIndex = vertex_index_result.index
            for edge in 0..<left_names.count |edge, left_names, right_names, names, edge_left, edge_right, vertex_index, budget, exhausted|:
                left_index: (complete: bool, row: usize) = proof_name_equality_vertex_index_insert(&vertex_index, &names, left_names[edge], budget, exhausted)
                return false if not left_index.complete
                left_value: usize = left_index.row
                right_index: (complete: bool, row: usize) = proof_name_equality_vertex_index_insert(&vertex_index, &names, right_names[edge], budget, exhausted)
                return false if not right_index.complete
                right_value: usize = right_index.row
                return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                edge_left.push(left_value)
                edge_right.push(right_value)

            adjacency_heads: mutable darray[usize] = []
            adjacency_names: mutable darray[usize] = []
            adjacency_next: mutable darray[usize] = []
            for name in names |name, adjacency_heads, budget, exhausted|:
                return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                adjacency_heads.push(0)
            for edge in 0..<edge_left.count |edge, edge_left, edge_right, adjacency_heads, adjacency_names, adjacency_next, budget, exhausted|:
                return false if not proof_linear_safety_work_charge(budget, exhausted, 2)
                adjacency_names.push(edge_right[edge])
                adjacency_next.push(adjacency_heads[edge_left[edge]])
                adjacency_heads[edge_left[edge]] <- adjacency_names.count
                adjacency_names.push(edge_left[edge])
                adjacency_next.push(adjacency_heads[edge_right[edge]])
                adjacency_heads[edge_right[edge]] <- adjacency_names.count

            visited: mutable darray[bool] = []
            for name_index in 0..<names.count |name_index, names, visited, budget, exhausted|:
                return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                visited.push(false)
            bound_rows: mutable darray[usize] = []
            bound_found: mutable darray[bool] = []
            for name_index in 0..<names.count |name_index, names, bound_rows, bound_found, budget, exhausted|:
                return false if not proof_linear_safety_work_charge(budget, exhausted, 2)
                bound_rows.push(0)
                bound_found.push(false)
            for bound_row in 0..<bounds.count |bound_row, bounds, names, vertex_index, bound_rows, bound_found, budget, exhausted|:
                return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                continue if bounds[bound_row].term_key or bounds[bound_row].name == ""
                vertex: (complete: bool, found: bool, row: usize) = proof_name_equality_vertex_index_find(vertex_index, names, bounds[bound_row].name, budget, exhausted)
                return false if not vertex.complete
                if vertex.found and not bound_found[vertex.row]:
                    bound_rows[vertex.row] <- bound_row
                    bound_found[vertex.row] <- true
            for start in 0..<names.count |start, names, adjacency_heads, adjacency_names, adjacency_next, visited, bounds, budget, exhausted|:
                return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                continue if visited[start]
                queue: mutable darray[usize] = [start]
                members: mutable darray[usize] = []
                visited[start] <- true
                cursor: mutable usize = 0
                while cursor < queue.count |cursor, queue, members, adjacency_heads, adjacency_names, adjacency_next, visited, budget, exhausted|:
                    return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                    current: usize = queue[cursor]
                    members.push(current)
                    arc: mutable usize = adjacency_heads[current]
                    while arc != 0 |arc, adjacency_names, adjacency_next, queue, visited, budget, exhausted|:
                        return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                        arc_index: usize = arc - 1
                        neighbor: usize = adjacency_names[arc_index]
                        if not visited[neighbor]:
                            return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                            visited[neighbor] <- true
                            queue.push(neighbor)
                        arc <- adjacency_next[arc_index]
                    cursor <- cursor + 1

                has_lower: mutable bool = false
                lower: mutable i64 = 0
                has_upper: mutable bool = false
                upper: mutable i64 = 0
                for member in members |member, members, names, bounds, bound_rows, bound_found, has_lower, lower, has_upper, upper, budget, exhausted|:
                    return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                    continue if not bound_found[member]
                    return false if bound_rows[member] >= bounds.count or bounds[bound_rows[member]].term_key or bounds[bound_rows[member]].name != names[member]
                    bound: ProofBound = bounds[bound_rows[member]]
                    if bound.has_lower and (not has_lower or bound.lower > lower):
                        has_lower <- true
                        lower <- bound.lower
                    if bound.has_upper and (not has_upper or bound.upper < upper):
                        has_upper <- true
                        upper <- bound.upper
                for member in members |member, members, names, bounds, bound_rows, bound_found, has_lower, lower, has_upper, upper, budget, exhausted|:
                    return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                    if not bound_found[member] and (has_lower or has_upper):
                        return false if not proof_linear_safety_work_charge(budget, exhausted, 1) or not proof_linear_safety_work_charge(budget, exhausted, sview_len(names[member]))
                        new_row: usize = bounds.count
                        bounds.push(ProofBound{name: names[member], term: Ast::Expr.Invalid, term_key: false, has_lower: has_lower, lower: lower, has_upper: has_upper, upper: upper})
                        bound_rows[member] <- new_row
                        bound_found[member] <- true
                    elif bound_found[member]:
                        row: usize = bound_rows[member]
                        return false if row >= bounds.count or bounds[row].term_key or bounds[row].name != names[member]
                        if has_lower and (not bounds[row].has_lower or lower > bounds[row].lower):
                            return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                            bounds[row].has_lower <- true
                            bounds[row].lower <- lower
                        if has_upper and (not bounds[row].has_upper or upper < bounds[row].upper):
                            return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                            bounds[row].has_upper <- true
                            bounds[row].upper <- upper
            return proof_tighten_disequality_bounds_with_work(facts, bounds, markers, budget, exhausted)

        def proof_collect_name_equalities_metered_with_work(expression: Ast::Expr, markers: ProofScalarWitnesses&, sort_index: ProofNameEqualitySortIndex, marker_scale: usize, left_names: mutable darray[sview]&, right_names: mutable darray[sview]&, root_checks: mutable usize&, root_limit: usize, budget: mutable usize&, exhausted: mutable bool&, depth: usize) -> bool:
            return true if root_checks >= root_limit
            return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
            return true if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_collect_name_equalities_metered_with_work(inner, markers, sort_index, marker_scale, left_names, right_names, root_checks, root_limit, budget, exhausted, depth + 1)
                Ast::Expr.Binary(left, operator, right, _):
                    if operator == TokenKind.And:
                        return false if not proof_collect_name_equalities_metered_with_work(left, markers, sort_index, marker_scale, left_names, right_names, root_checks, root_limit, budget, exhausted, depth + 1)
                        return proof_collect_name_equalities_metered_with_work(right, markers, sort_index, marker_scale, left_names, right_names, root_checks, root_limit, budget, exhausted, depth + 1)
                    if operator == TokenKind.EqEq:
                        left_view: (complete: bool, stripped: Ast::Expr) = proof_linear_strip_parens_with_work(left, budget, exhausted)
                        return false if not left_view.complete
                        right_view: (complete: bool, stripped: Ast::Expr) = proof_linear_strip_parens_with_work(right, budget, exhausted)
                        return false if not right_view.complete
                        left_name: sview = proof_ident_name(left_view.stripped)
                        right_name: sview = proof_ident_name(right_view.stripped)
                        if left_name != "" and right_name != "":
                            root_checks <- root_checks + 1
                            comparison: (complete: bool, matches: bool) = proof_linear_safety_comparison_with_work(left, right, markers, marker_scale, budget, exhausted)
                            return false if:
                                not comparison.complete
                                not proof_linear_safety_work_charge(budget, exhausted, sview_len(left_name))
                                not proof_linear_safety_work_charge(budget, exhausted, sview_len(right_name))
                            if comparison.matches:
                                left_sort: i64 = proof_name_equality_sort_with_work(left_view.stripped, sort_index, budget, exhausted)
                                return false if exhausted
                                right_sort: i64 = proof_name_equality_sort_with_work(right_view.stripped, sort_index, budget, exhausted)
                                return false if exhausted
                                if left_sort != 0 and left_sort == right_sort:
                                    left_names.push(left_name)
                                    right_names.push(right_name)
                    return true
                _:
                    return true

        # Compatibility entries share the same bounded closure as goal search.
        def proof_close_equalities(facts: darray[Ast::Expr]&, bounds: mutable darray[ProofBound]&) -> void:
            budget: mutable usize = 0
            exhausted: mutable bool = false
            markers: (complete: bool, witnesses: ProofScalarWitnesses) = proof_scalar_witness_markers_with_work(facts, true, &budget, &exhausted)
            return if not markers.complete or exhausted
            proof_close_equalities_with_work(facts, markers.witnesses, bounds, &budget, &exhausted)

        def proof_close_equalities_with_markers(facts: darray[Ast::Expr]&, markers: ProofScalarWitnesses&, bounds: mutable darray[ProofBound]&) -> void:
            budget: mutable usize = 0
            exhausted: mutable bool = false
            proof_close_equalities_with_work(facts, markers, bounds, &budget, &exhausted)

        def proof_names_equal_from_facts(left_name: sview, right_name: sview, facts: darray[Ast::Expr]&) -> bool:
            budget: mutable usize = 0
            exhausted: mutable bool = false
            proof_names_equal_from_facts_with_work(left_name, right_name, facts, &budget, &exhausted)

        def proof_names_equal_from_facts_with_work(left_name: sview, right_name: sview, facts: darray[Ast::Expr]&, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            return false if:
                left_name == "" or right_name == ""
                not proof_linear_safety_work_charge(budget, exhausted, 1)
                not proof_linear_safety_work_charge(budget, exhausted, sview_len(left_name))
                not proof_linear_safety_work_charge(budget, exhausted, sview_len(right_name))
            return true if left_name == right_name
            # Keep producer-side equality aliasing within the same fact, candidate, and
            # traversal bounds used by kernel replay. A truncated graph contains only witnessed
            # positive equalities, so it can lose answers but cannot invent an alias.
            fact_count: usize = facts.count if facts.count < PROOF_LINEAR_NAME_EQUALITY_FACT_LIMIT else PROOF_LINEAR_NAME_EQUALITY_FACT_LIMIT
            bounded_facts: mutable darray[Ast::Expr] = []
            for fact_index in 0..<fact_count |fact_index, facts, bounded_facts|:
                return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                bounded_facts.push(facts[fact_index])
            marker_count: mutable usize = 0
            marker_name_cost: mutable usize = 0
            for fact in bounded_facts |fact, marker_count, marker_name_cost, budget, exhausted|:
                cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(fact, budget, exhausted)
                return false if:
                    not cost.complete
                    not proof_linear_safety_work_charge(budget, exhausted, 1)
                    not proof_linear_safety_work_charge_scaled(budget, exhausted, cost.cost, 2)
                callee: sview = proof_marker_callee_name(fact)
                if callee in {"__elisa_primitive_scalar_type", "__elisa_primitive_integer_type"}:
                    marker_count <- marker_count + 1
                    argument: (known: bool, term: Ast::Expr) = proof_marker_argument(fact, "__elisa_primitive_scalar_type")
                    marker_name: sview = proof_ident_name(argument.term) if argument.known else ""
                    marker_name_cost <- marker_name_cost + 1 + sview_len(marker_name) if marker_name != ""
                elif callee == "__elisa_unsigned_type_bound":
                    marker_count <- marker_count + 1
                    marker_name: sview = proof_unsigned_marker_name(fact)
                    marker_name_cost <- marker_name_cost + 1 + sview_len(marker_name) if marker_name != ""
                elif callee in {"__elisa_untrusted_operator_type", "__elisa_primitive_scalar_element"}:
                    marker_count <- marker_count + 1
            # Marker decoding scans the bounded source facts once more. The name table then
            # performs at most the configured probe count per insertion; a collision fallback
            # sorts at most marker_count names, with byte comparisons bounded by this total.
            return false if:
                not proof_linear_safety_work_charge_scaled(budget, exhausted, marker_name_cost, PROOF_SCALAR_WITNESS_NAME_PROBE_LIMIT + marker_count)
            relation_left: mutable darray[sview] = []
            relation_right: mutable darray[sview] = []
            markers: ProofScalarWitnesses = proof_scalar_witness_markers(bounded_facts)
            marker_scan: (complete: bool, scale: usize) = proof_linear_safety_marker_scale_with_work(markers, budget, exhausted)
            return false if not marker_scan.complete
            sort_index_result: (complete: bool, index: ProofNameEqualitySortIndex) = proof_name_equality_sort_index_build(bounded_facts, budget, exhausted)
            return false if not sort_index_result.complete
            root_checks: mutable usize = 0
            for fact in bounded_facts |relation_left, relation_right, markers, marker_scan, sort_index_result, root_checks, budget, exhausted|:
                return false if:
                    not proof_linear_safety_work_charge(budget, exhausted, 1)
                    not proof_collect_name_equalities_metered_with_work(fact, markers, sort_index_result.index, marker_scan.scale, relation_left, relation_right, root_checks, PROOF_LINEAR_SAFETY_WORK_LIMIT, budget, exhausted, 0)

            names: mutable darray[sview] = []
            edge_left: mutable darray[usize] = []
            edge_right: mutable darray[usize] = []
            return false if relation_left.count != relation_right.count
            vertex_index_result: (complete: bool, index: ProofNameEqualityVertexIndex) = proof_name_equality_vertex_index_build(relation_left.count, budget, exhausted)
            return false if not vertex_index_result.complete
            vertex_index: mutable ProofNameEqualityVertexIndex = vertex_index_result.index
            for edge in 0..<relation_left.count |edge, relation_left, relation_right, names, edge_left, edge_right, vertex_index, budget, exhausted|:
                left_index: (complete: bool, row: usize) = proof_name_equality_vertex_index_insert(&vertex_index, &names, relation_left[edge], budget, exhausted)
                return false if not left_index.complete
                left_value: usize = left_index.row
                right_index: (complete: bool, row: usize) = proof_name_equality_vertex_index_insert(&vertex_index, &names, relation_right[edge], budget, exhausted)
                return false if not right_index.complete
                right_value: usize = right_index.row
                return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                edge_left.push(left_value)
                edge_right.push(right_value)

            adjacency_heads: mutable darray[usize] = []
            adjacency_names: mutable darray[usize] = []
            adjacency_next: mutable darray[usize] = []
            for name in names |name, adjacency_heads, budget, exhausted|:
                return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                adjacency_heads.push(0)
            for edge in 0..<edge_left.count |edge, edge_left, edge_right, adjacency_heads, adjacency_names, adjacency_next, budget, exhausted|:
                return false if not proof_linear_safety_work_charge(budget, exhausted, 2)
                adjacency_names.push(edge_right[edge])
                adjacency_next.push(adjacency_heads[edge_left[edge]])
                adjacency_heads[edge_left[edge]] <- adjacency_names.count
                adjacency_names.push(edge_left[edge])
                adjacency_next.push(adjacency_heads[edge_right[edge]])
                adjacency_heads[edge_right[edge]] <- adjacency_names.count
            start_result: (complete: bool, index: usize) = proof_alias_name_index_with_work(names, left_name, budget, exhausted)
            return false if not start_result.complete
            target_result: (complete: bool, index: usize) = proof_alias_name_index_with_work(names, right_name, budget, exhausted)
            return false if not target_result.complete
            start: usize = start_result.index
            target: usize = target_result.index
            return false if start == names.count or target == names.count
            visited: mutable darray[bool] = []
            for name_index in 0..<names.count |name_index, names, visited, budget, exhausted|:
                return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                visited.push(false)
            queue: mutable darray[usize] = [start]
            visited[start] <- true
            cursor: mutable usize = 0
            while cursor < queue.count |cursor, queue, adjacency_heads, adjacency_names, adjacency_next, visited, target, budget, exhausted|:
                return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                current: usize = queue[cursor]
                return true if current == target
                arc: mutable usize = adjacency_heads[current]
                while arc != 0 |arc, adjacency_names, adjacency_next, queue, visited, budget, exhausted|:
                    return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                    arc_index: usize = arc - 1
                    neighbor: usize = adjacency_names[arc_index]
                    if not visited[neighbor]:
                        return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                        visited[neighbor] <- true
                        queue.push(neighbor)
                    arc <- adjacency_next[arc_index]
                cursor <- cursor + 1
            return false
