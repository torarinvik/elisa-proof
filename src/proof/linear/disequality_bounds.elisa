extend ElisaProof:
    public:
        # A disequality `x != c` removes one integer from x's interval. It only narrows the
        # interval when c is an endpoint: then `x >= c` with `x != c` gives `x >= c + 1`, which
        # is how an unsigned `length != 0` becomes the `length >= 1` that `length - 1` needs.
        # Each pass can expose a new endpoint (`x != 0, x != 1`), so passes repeat while one
        # moved a bound, at most once per disequality. Other facts are skipped up front: this
        # runs on every equality closure, so a scan of every fact per pass is too slow.
        # The kernel mirror is `proof_kernel_replay_tighten_disequality_bounds`.
        def proof_tighten_disequality_bounds(facts: darray[Ast::Expr]&, bounds: mutable darray[ProofBound]&) -> void:
            disequalities: mutable darray[Ast::Expr] = []
            for fact in facts |fact, disequalities|:
                disequalities.push(fact) if proof_fact_is_disequality(fact)
            rounds: mutable usize = 0
            changed: mutable bool = true
            while changed and rounds < disequalities.count |rounds, changed, disequalities, facts, bounds|:
                changed <- false
                for fact in disequalities |fact, changed, facts, bounds|:
                    changed <- true if proof_tighten_by_disequality(fact, facts, bounds)
                rounds <- rounds + 1

        # Metered sibling used by the safety-analysis context. False means the
        # shared cap was exhausted, so callers must report unknown.
        def proof_tighten_disequality_bounds_with_work(facts: darray[Ast::Expr]&, bounds: mutable darray[ProofBound]&, markers: ProofScalarWitnesses&, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            marker_scan: (complete: bool, scale: usize) = proof_linear_safety_marker_scale_with_work(markers, budget, exhausted)
            return false if not marker_scan.complete
            return proof_tighten_disequality_bounds_with_marker_work(facts, bounds, markers, marker_scan.scale, budget, exhausted)

        def proof_tighten_disequality_bounds_with_marker_work(facts: darray[Ast::Expr]&, bounds: mutable darray[ProofBound]&, markers: ProofScalarWitnesses&, marker_scale: usize, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            disequalities: mutable darray[Ast::Expr] = []
            for fact in facts |fact, disequalities, budget, exhausted|:
                return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                disequalities.push(fact) if proof_fact_is_disequality(fact)
            rounds: mutable usize = 0
            changed: mutable bool = true
            while changed and rounds < disequalities.count |rounds, changed, disequalities, facts, bounds, markers, marker_scale, budget, exhausted|:
                return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                changed <- false
                for fact in disequalities |fact, changed, facts, bounds, markers, marker_scale, budget, exhausted|:
                    return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                    tightened: (complete: bool, changed: bool) = proof_tighten_by_disequality_with_work(fact, bounds, markers, marker_scale, budget, exhausted)
                    return false if not tightened.complete
                    changed <- true if tightened.changed
                rounds <- rounds + 1
            return true

        def proof_tighten_by_disequality_with_work(fact: Ast::Expr, bounds: mutable darray[ProofBound]&, markers: ProofScalarWitnesses&, marker_scale: usize, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, changed: bool):
            match fact:
                Ast::Expr.Binary(left, TokenKind.BangEq, right, _):
                    return proof_tighten_named_disequality_with_work(left, right, bounds, markers, marker_scale, budget, exhausted)
                Ast::Expr.Unary(TokenKind.Not, operand, _):
                    match operand:
                        Ast::Expr.Binary(left, TokenKind.EqEq, right, _):
                            return proof_tighten_named_disequality_with_work(left, right, bounds, markers, marker_scale, budget, exhausted)
                        _:
                            return (true, false)
                _:
                    return (true, false)

        def proof_tighten_named_disequality_with_work(left: Ast::Expr, right: Ast::Expr, bounds: mutable darray[ProofBound]&, markers: ProofScalarWitnesses&, marker_scale: usize, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, changed: bool):
            comparison: (complete: bool, matches: bool) = proof_linear_safety_comparison_with_work(left, right, markers, marker_scale, budget, exhausted)
            return (false, false) if not comparison.complete
            return (true, false) if not comparison.matches
            name: mutable sview = proof_ident_name(left)
            constant: mutable (known: bool, value: i64) = proof_constant_int_with_work(right, 0, budget, exhausted)
            return (false, false) if exhausted
            if name == "" or not constant.known:
                name <- proof_ident_name(right)
                constant <- proof_constant_int_with_work(left, 0, budget, exhausted)
                return (false, false) if exhausted
            return (true, false) if name == "" or not constant.known
            found: (complete: bool, index: usize) = proof_bound_index_with_work(bounds, name, budget, exhausted)
            return (false, false) if not found.complete
            return (true, false) if found.index == bounds.count
            bound: ProofBound = bounds[found.index]
            changed: mutable bool = false
            if bound.has_lower and bound.lower == constant.value:
                raised: (known: bool, value: i64) = proof_add_safe(constant.value, 1)
                if raised.known:
                    return (false, false) if not proof_equalities_add_lower_with_work(bounds, name, raised.value, budget, exhausted)
                    changed <- true
            if bound.has_upper and bound.upper == constant.value:
                lowered: (known: bool, value: i64) = proof_sub_safe(constant.value, 1)
                if lowered.known:
                    return (false, false) if not proof_equalities_add_upper_with_work(bounds, name, lowered.value, budget, exhausted)
                    changed <- true
            return (true, changed)

        def proof_fact_is_disequality(fact: Ast::Expr) -> bool:
            match fact:
                Ast::Expr.Binary(_, TokenKind.BangEq, _, _):
                    return true
                Ast::Expr.Unary(TokenKind.Not, operand, _):
                    match operand:
                        Ast::Expr.Binary(_, TokenKind.EqEq, _, _):
                            return true
                        _:
                            return false
                _:
                    return false

        def proof_tighten_by_disequality(fact: Ast::Expr, facts: darray[Ast::Expr]&, bounds: mutable darray[ProofBound]&) -> bool:
            match fact:
                Ast::Expr.Binary(left, TokenKind.BangEq, right, _):
                    return proof_tighten_named_disequality(left, right, facts, bounds)
                Ast::Expr.Unary(TokenKind.Not, operand, _):
                    match operand:
                        Ast::Expr.Binary(left, TokenKind.EqEq, right, _):
                            return proof_tighten_named_disequality(left, right, facts, bounds)
                        _:
                            return false
                _:
                    return false

        def proof_tighten_named_disequality(left: Ast::Expr, right: Ast::Expr, facts: darray[Ast::Expr]&, bounds: mutable darray[ProofBound]&) -> bool:
            return false if not proof_primitive_comparison(left, right, facts)
            name: mutable sview = proof_ident_name(left)
            constant: mutable (known: bool, value: i64) = proof_constant_int(right)
            if name == "" or not constant.known:
                name <- proof_ident_name(right)
                constant <- proof_constant_int(left)
            return false if name == "" or not constant.known
            bound: ProofBound = proof_bound_for(bounds, name)
            changed: mutable bool = false
            if bound.has_lower and bound.lower == constant.value:
                raised: (known: bool, value: i64) = proof_add_safe(constant.value, 1)
                if raised.known:
                    proof_add_lower(bounds, name, raised.value)
                    changed <- true
            if bound.has_upper and bound.upper == constant.value:
                lowered: (known: bool, value: i64) = proof_sub_safe(constant.value, 1)
                if lowered.known:
                    proof_add_upper(bounds, name, lowered.value)
                    changed <- true
            return changed

        # Whether a top-level fact says the two terms differ, as `l != r`, `r != l` or `not (l == r)`.
        # Kernel mirror: `proof_kernel_replay_facts_state_disequality`.
        def proof_facts_state_disequality(left: Ast::Expr, right: Ast::Expr, facts: darray[Ast::Expr]&) -> bool:
            for fact in facts |fact, left, right|:
                match fact:
                    Ast::Expr.Binary(a, TokenKind.BangEq, b, _):
                        return true if proof_expr_equal(a, left) and proof_expr_equal(b, right) or proof_expr_equal(a, right) and proof_expr_equal(b, left)
                    Ast::Expr.Unary(TokenKind.Not, operand, _):
                        match operand:
                            Ast::Expr.Binary(a, TokenKind.EqEq, b, _):
                                return true if proof_expr_equal(a, left) and proof_expr_equal(b, right) or proof_expr_equal(a, right) and proof_expr_equal(b, left)
                            _:
                                pass
                    _:
                        pass
            return false
