# Exact quotient reconstruction is a relational law, not a quotient interval bound. It is used
# only for a goal that explicitly states (a / b) * b == a, with a matching premise a % b == 0
# and a proven positive divisor. The kernel independently checks this same narrow shape.
extend ElisaProof:
    private:
        def proof_exact_division_reconstruction_goal(facts: darray[Ast::Expr]&, goal: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, operator_mask: usize, depth: usize, budget: mutable usize&, split_depth: usize, exhausted: mutable bool&) -> bool can[Global.Read, Global.Write]:
            return false if split_depth >= PROOF_LINEAR_CASE_SPLIT_DEPTH_LIMIT or not proof_comparison_goal_shape(goal)
            return false if not proof_linear_candidate_analysis_work_charge(facts, goal, budget, exhausted)
            markers: ProofScalarWitnesses = proof_scalar_witness_markers(facts)
            match proof_strip_parens(goal):
                Ast::Expr.Binary(left, TokenKind.EqEq, right, _):
                    return true if proof_exact_division_reconstruction_matches(facts, left, right, markers, annotations, operator_mask, depth, budget, split_depth, exhausted)
                    return false if exhausted
                    return proof_exact_division_reconstruction_matches(facts, right, left, markers, annotations, operator_mask, depth, budget, split_depth, exhausted)
                _:
                    return false
            return false

        # Reserve a conservative shared-work estimate for building one scalar-witness index,
        # consulting it across the bounded candidate orientations, and traversing the same
        # source terms for width lookup. These helpers predate the shared budget and are not
        # themselves instrumented, so account for their worst-case nested fact/term scans here.
        def proof_linear_candidate_analysis_work_charge(facts: darray[Ast::Expr]&, goal: Ast::Expr, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            if exhausted or budget >= PROOF_LINEAR_MAX_ENUMERATED_ELEMENTS:
                exhausted <- true
                return false
            remaining: usize = PROOF_LINEAR_MAX_ENUMERATED_ELEMENTS - budget
            facts_cost: mutable usize = 0
            for fact in facts |fact, facts_cost, budget, remaining, exhausted|:
                cost: mutable usize = 0
                if not proof_replay_summary_expr_cost_with_limit(fact, &cost, budget + facts_cost, PROOF_LINEAR_MAX_ENUMERATED_ELEMENTS):
                    exhausted <- true
                    return false
                if cost > remaining - facts_cost:
                    exhausted <- true
                    return false
                facts_cost <- facts_cost + cost
            goal_cost: mutable usize = 0
            if not proof_replay_summary_expr_cost_with_limit(goal, &goal_cost, budget + facts_cost, PROOF_LINEAR_MAX_ENUMERATED_ELEMENTS):
                exhausted <- true
                return false
            if goal_cost == 0:
                exhausted <- true
                return false
            if goal_cost > PROOF_LINEAR_MAX_ENUMERATED_ELEMENTS / 48 / goal_cost:
                exhausted <- true
                return false
            factor: usize = goal_cost * goal_cost * 48
            rows: usize = facts_cost + 1
            if rows > remaining / factor:
                exhausted <- true
                return false
            budget <- budget + rows * factor
            return true

        def proof_exact_division_reconstruction_matches(facts: darray[Ast::Expr]&, product: Ast::Expr, dividend: Ast::Expr, markers: ProofScalarWitnesses&, annotations: darray[Ast::EnumAnnotation]&, operator_mask: usize, depth: usize, budget: mutable usize&, split_depth: usize, exhausted: mutable bool&) -> bool can[Global.Read, Global.Write]:
            match proof_strip_parens(product):
                Ast::Expr.Binary(left, TokenKind.Star, right, _):
                    return true if proof_exact_division_reconstruction_candidate(facts, left, right, dividend, markers, annotations, operator_mask, depth, budget, split_depth, exhausted)
                    return false if exhausted
                    return proof_exact_division_reconstruction_candidate(facts, right, left, dividend, markers, annotations, operator_mask, depth, budget, split_depth, exhausted)
                _:
                    return false
            return false

        def proof_exact_division_reconstruction_candidate(facts: darray[Ast::Expr]&, quotient: Ast::Expr, multiplier: Ast::Expr, dividend: Ast::Expr, markers: ProofScalarWitnesses&, annotations: darray[Ast::EnumAnnotation]&, operator_mask: usize, depth: usize, budget: mutable usize&, split_depth: usize, exhausted: mutable bool&) -> bool can[Global.Read, Global.Write]:
            parts: (known: bool, dividend: Ast::Expr, percent: bool, divisor: Ast::Expr) = proof_division_parts(quotient)
            return false if not parts.known or parts.percent
            return false if not proof_exact_division_expr_equal_with_budget(multiplier, parts.divisor, budget, exhausted) or not proof_exact_division_expr_equal_with_budget(dividend, parts.dividend, budget, exhausted)
            return false if not proof_exact_division_zero_remainder_fact(facts, parts.dividend, parts.divisor, 0, budget, exhausted)
            return false if not proof_scalar_term_witnessed_in(parts.dividend, markers, 0) or not proof_scalar_term_witnessed_in(quotient, markers, 0)
            product: Ast::Expr = Ast::Expr.Binary(quotient, TokenKind.Star, parts.divisor, Ast::expr_pos(quotient))
            return false if not proof_exact_division_widths_match(facts, quotient, parts.dividend, parts.divisor, product, markers, annotations)
            position: Ast::Pos = Ast::expr_pos(parts.divisor)
            positive: Ast::Expr = Ast::Expr.Binary(parts.divisor, TokenKind.Gt, Ast::Expr.IntLit(0, position), position)
            side_exhausted: mutable bool = false
            positive_proven: bool = (proof_goal_depth(facts, positive, annotations, operator_mask, depth + 1, budget, split_depth + 1, &side_exhausted) can Global{Read,Write})
            if not positive_proven:
                exhausted <- true if side_exhausted
            positive_proven

        def proof_exact_division_widths_match(facts: darray[Ast::Expr]&, quotient: Ast::Expr, dividend: Ast::Expr, divisor: Ast::Expr, product: Ast::Expr, markers: ProofScalarWitnesses&, annotations: darray[Ast::EnumAnnotation]&) -> bool:
            unsigned_width: i64 = proof_unsigned_width_in_expression(quotient, facts)
            if unsigned_width != 0:
                return false if proof_unsigned_width_in_expression(dividend, facts) != unsigned_width or proof_unsigned_width_in_expression(product, facts) != unsigned_width
                return false if proof_unsigned_width_in_expression(Ast::Expr.Binary(dividend, TokenKind.Percent, divisor, Ast::expr_pos(dividend)), facts) != unsigned_width
                return false if not proof_scalar_term_witnessed_in(dividend, markers, 0)
                return proof_exact_division_unsigned_divisor_width_matches(divisor, facts, annotations, markers, unsigned_width, 0)
            signed_width: i64 = proof_signed_width_in_expression(quotient, facts)
            return false if signed_width == 0 or proof_signed_width_in_expression(dividend, facts) != signed_width or proof_signed_width_in_expression(product, facts) != signed_width
            return false if proof_signed_width_in_expression(Ast::Expr.Binary(dividend, TokenKind.Percent, divisor, Ast::expr_pos(dividend)), facts) != signed_width
            return false if not proof_scalar_term_witnessed_in(dividend, markers, 0)
            return proof_exact_division_signed_divisor_width_matches(divisor, facts, markers, annotations, signed_width, 0)

        def proof_exact_division_signed_divisor_width_matches(divisor: Ast::Expr, facts: darray[Ast::Expr]&, markers: ProofScalarWitnesses&, annotations: darray[Ast::EnumAnnotation]&, width: i64, depth: usize) -> bool:
            return false if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT or width == 0
            match proof_strip_parens(divisor):
                Ast::Expr.IntLit(value, position):
                    literal: (known: bool, bits: u64, unsigned: bool, width: i64) = proof_replay_numeric_literal_sort(annotations, position.line, position.column, value)
                    if literal.known:
                        return not literal.unsigned and literal.width == width and value > 0
                    return value > 0 and value <= ElisaProofKernelCore::proof_kernel_signed_width_max(width)
                _:
                    return proof_signed_width_in_expression(divisor, facts) == width and proof_scalar_term_witnessed_in(divisor, markers, 0)

        def proof_exact_division_unsigned_divisor_width_matches(divisor: Ast::Expr, facts: darray[Ast::Expr]&, annotations: darray[Ast::EnumAnnotation]&, markers: ProofScalarWitnesses&, width: i64, depth: usize) -> bool:
            return false if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT or width == 0
            match proof_strip_parens(divisor):
                Ast::Expr.IntLit(value, position):
                    literal: (known: bool, bits: u64, unsigned: bool, width: i64) = proof_replay_numeric_literal_sort(annotations, position.line, position.column, value)
                    if literal.known:
                        return literal.unsigned and literal.width == width and literal.bits > 0
                    return value > 0 and proof_unsigned_constants_fit(divisor, width, 0)
                Ast::Expr.Ident(_, _):
                    return proof_unsigned_width_in_expression(divisor, facts) == width and proof_scalar_term_witnessed_in(divisor, markers, 0)
                Ast::Expr.Paren(inner, _):
                    return proof_exact_division_unsigned_divisor_width_matches(inner, facts, annotations, markers, width, depth + 1)
                _:
                    return false

        def proof_exact_division_zero_remainder_fact(facts: darray[Ast::Expr]&, dividend: Ast::Expr, divisor: Ast::Expr, depth: usize, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            for fact in facts |fact, dividend, divisor, depth, budget, exhausted|:
                if budget >= PROOF_LINEAR_MAX_ENUMERATED_ELEMENTS:
                    exhausted <- true
                    return false
                budget <- budget + 1
                return true if proof_exact_division_zero_remainder_in_fact(fact, dividend, divisor, depth, budget, exhausted)
                return false if exhausted
            return false

        def proof_exact_division_zero_remainder_in_fact(fact: Ast::Expr, dividend: Ast::Expr, divisor: Ast::Expr, depth: usize, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            requires depth <= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            decreases PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT - depth
            return false if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            if budget >= PROOF_LINEAR_MAX_ENUMERATED_ELEMENTS:
                exhausted <- true
                return false
            budget <- budget + 1
            match proof_strip_parens(fact):
                Ast::Expr.Binary(left, TokenKind.And, right, _):
                    return true if proof_exact_division_zero_remainder_in_fact(left, dividend, divisor, depth + 1, budget, exhausted)
                    return false if exhausted
                    return proof_exact_division_zero_remainder_in_fact(right, dividend, divisor, depth + 1, budget, exhausted)
                Ast::Expr.Binary(left, TokenKind.EqEq, right, _):
                    return true if proof_exact_division_zero_literal(left) and proof_exact_division_remainder_matches(right, dividend, divisor, budget, exhausted)
                    return false if exhausted
                    return proof_exact_division_zero_literal(right) and proof_exact_division_remainder_matches(left, dividend, divisor, budget, exhausted)
                _:
                    return false
            return false

        def proof_exact_division_zero_literal(expression: Ast::Expr) -> bool:
            match proof_strip_parens(expression):
                Ast::Expr.IntLit(value, _):
                    return value == 0
                _:
                    return false
            return false

        def proof_exact_division_remainder_matches(expression: Ast::Expr, dividend: Ast::Expr, divisor: Ast::Expr, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            parts: (known: bool, dividend: Ast::Expr, percent: bool, divisor: Ast::Expr) = proof_division_parts(expression)
            return false if not parts.known or not parts.percent
            return false if not proof_exact_division_expr_equal_with_budget(parts.dividend, dividend, budget, exhausted)
            proof_exact_division_expr_equal_with_budget(parts.divisor, divisor, budget, exhausted)

        # `proof_expr_equal` validates and compares both whole terms. Reserve the same five-pass
        # structural cost used by the other bounded witness indexes before calling it.
        def proof_exact_division_expr_equal_with_budget(left: Ast::Expr, right: Ast::Expr, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            return false if exhausted
            if budget >= PROOF_LINEAR_MAX_ENUMERATED_ELEMENTS:
                exhausted <- true
                return false
            remaining: usize = PROOF_LINEAR_MAX_ENUMERATED_ELEMENTS - budget
            # Reserve room for the term cost walk and all five passes performed by
            # proof_expr_equal, before walking either term.
            term_limit: usize = budget + remaining / 5
            term_cost: mutable usize = 0
            if not proof_replay_summary_expr_cost_with_limit(left, &term_cost, budget, term_limit) or not proof_replay_summary_expr_cost_with_limit(right, &term_cost, budget, term_limit):
                exhausted <- true
                return false
            budget <- budget + term_cost * 5
            proof_expr_equal(left, right)
