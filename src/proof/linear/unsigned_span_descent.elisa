extend ElisaProof:
    public:
        # a < end and next == a+1 imply both subtractions are non-wrapping.
        # Cursors are same-width names; the endpoint is a matching name or
        # literal 0..255 (representable in every supported unsigned width).
        def proof_unsigned_span_endpoint(end: Ast::Expr, width: i64, facts: darray[Ast::Expr]&) -> bool:
            return proof_unsigned_width_in_expression(end, facts) == width if proof_ident_name(end) != ""
            match proof_strip_parens(end):
                Ast::Expr.IntLit(value, _):
                    return value >= 0 and value <= 255
                _:
                    return false

        def proof_unsigned_span_descent(facts: darray[Ast::Expr]&, goal: Ast::Expr) -> bool:
            match proof_strip_parens(goal):
                Ast::Expr.Binary(left, relation, right, _):
                    return false if relation != TokenKind.Lt
                    first: (known: bool, left: Ast::Expr, right: Ast::Expr) = proof_difference_operands(left)
                    second: (known: bool, left: Ast::Expr, right: Ast::Expr) = proof_difference_operands(right)
                    return false if not first.known or not second.known
                    end: Ast::Expr = first.left
                    next: Ast::Expr = first.right
                    other_end: Ast::Expr = second.left
                    start: Ast::Expr = second.right
                    return false if not proof_expr_equal(end, other_end)
                    return false if proof_ident_name(start) == "" or proof_ident_name(next) == ""
                    width: i64 = proof_unsigned_width_in_expression(start, facts)
                    return false if width == 0 or not proof_unsigned_span_endpoint(end, width, facts) or proof_unsigned_width_in_expression(next, facts) != width
                    return false if not proof_has_order_fact(start, end, true, facts)
                    for fact in facts |fact, facts, next, start|:
                        match proof_strip_parens(fact):
                            Ast::Expr.Binary(left, TokenKind.EqEq, right, _):
                                term: mutable Ast::Expr = Ast::Expr.Invalid
                                term <- right if proof_expr_equal(left, next)
                                term <- left if proof_expr_equal(right, next)
                                shifted: (known: bool, base: Ast::Expr) = proof_shifted_unit_base(term)
                                return true if shifted.known and proof_expr_equal(shifted.base, start)
                            _:
                                pass
                _:
                    pass
            return false
