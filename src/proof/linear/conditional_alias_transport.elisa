extend ElisaProof:
    public:
        def proof_scalar_alias_occurs(expression: Ast::Expr, name: sview, depth: usize) -> bool:
            return false if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            match expression:
                Ast::Expr.Ident(candidate, _):
                    return candidate == name
                Ast::Expr.Paren(inner, _) | Ast::Expr.Unary(_, inner, _):
                    return proof_scalar_alias_occurs(inner, name, depth + 1)
                Ast::Expr.Field(object, _, _):
                    return proof_scalar_alias_occurs(object, name, depth + 1)
                Ast::Expr.Index(object, index, _):
                    return proof_scalar_alias_occurs(object, name, depth + 1) or proof_scalar_alias_occurs(index, name, depth + 1)
                Ast::Expr.IndexN(object, indices, _):
                    return true if proof_scalar_alias_occurs(object, name, depth + 1)
                    for index in indices |index, name, depth|:
                        return true if proof_scalar_alias_occurs(index, name, depth + 1)
                    return false
                Ast::Expr.Binary(left, _, right, _):
                    return proof_scalar_alias_occurs(left, name, depth + 1) or proof_scalar_alias_occurs(right, name, depth + 1)
                Ast::Expr.If(condition, then_expression, else_expression, _):
                    return proof_scalar_alias_occurs(condition, name, depth + 1) or proof_scalar_alias_occurs(then_expression, name, depth + 1) or proof_scalar_alias_occurs(else_expression, name, depth + 1)
                _:
                    return false

        def proof_scalar_alias_occurs_with_work(expression: Ast::Expr, name: sview, expression_cost: usize, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            return false if exhausted
            name_length: usize = sview_len(name)
            multiplier: usize = name_length + 1
            return false if multiplier == 0 or not proof_linear_safety_work_charge_scaled(budget, exhausted, expression_cost, multiplier)
            proof_scalar_alias_occurs(expression, name, 0)

        def proof_conditional_alias_readable_order_with_work(fact: Ast::Expr, facts: darray[Ast::Expr]&, markers: ProofScalarWitnesses&, marker_scale: usize, fact_scan_cost: usize, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, known: bool, left: Ast::Expr, operator: TokenKind, right: Ast::Expr):
            view: (complete: bool, stripped: Ast::Expr) = proof_linear_strip_parens_with_work(fact, budget, exhausted)
            return (false, false, fact, TokenKind.Eof, fact) if not view.complete or exhausted
            match view.stripped:
                Ast::Expr.Binary(left, operator, right, _):
                    return (true, false, fact, TokenKind.Eof, fact) if not proof_is_order_operator(operator)
                    left_scalar: (complete: bool, matches: bool) = proof_linear_safety_scalar_witness_with_work(left, markers, marker_scale, budget, exhausted)
                    return (false, false, fact, TokenKind.Eof, fact) if not left_scalar.complete or exhausted
                    return (true, false, fact, TokenKind.Eof, fact) if not left_scalar.matches
                    right_scalar: (complete: bool, matches: bool) = proof_linear_safety_scalar_witness_with_work(right, markers, marker_scale, budget, exhausted)
                    return (false, false, fact, TokenKind.Eof, fact) if not right_scalar.complete or exhausted
                    return (true, false, fact, TokenKind.Eof, fact) if not right_scalar.matches
                    return (true, true, left, operator, right)
                Ast::Expr.Unary(TokenKind.Not, operand, _):
                    operand_view: (complete: bool, stripped: Ast::Expr) = proof_linear_strip_parens_with_work(operand, budget, exhausted)
                    return (false, false, fact, TokenKind.Eof, fact) if not operand_view.complete or exhausted
                    match operand_view.stripped:
                        Ast::Expr.Binary(left, operator, right, _):
                            negated: TokenKind = proof_comparison_negation(operator)
                            return (true, false, fact, TokenKind.Eof, fact) if not proof_is_order_operator(negated)
                            left_scalar: (complete: bool, matches: bool) = proof_linear_safety_scalar_witness_with_work(left, markers, marker_scale, budget, exhausted)
                            return (false, false, fact, TokenKind.Eof, fact) if not left_scalar.complete or exhausted
                            return (true, false, fact, TokenKind.Eof, fact) if not left_scalar.matches
                            right_scalar: (complete: bool, matches: bool) = proof_linear_safety_scalar_witness_with_work(right, markers, marker_scale, budget, exhausted)
                            return (false, false, fact, TokenKind.Eof, fact) if not right_scalar.complete or exhausted
                            return (true, false, fact, TokenKind.Eof, fact) if not right_scalar.matches
                            left_integer: (complete: bool, integer: bool) = proof_disjunction_denial_integer_term_with_work(left, facts, markers, marker_scale, fact_scan_cost, 0, budget, exhausted)
                            return (false, false, fact, TokenKind.Eof, fact) if not left_integer.complete or exhausted
                            return (true, false, fact, TokenKind.Eof, fact) if not left_integer.integer
                            right_integer: (complete: bool, integer: bool) = proof_disjunction_denial_integer_term_with_work(right, facts, markers, marker_scale, fact_scan_cost, 0, budget, exhausted)
                            return (false, false, fact, TokenKind.Eof, fact) if not right_integer.complete or exhausted
                            return (true, false, fact, TokenKind.Eof, fact) if not right_integer.integer
                            return (true, true, left, negated, right)
                        _:
                            return (true, false, fact, TokenKind.Eof, fact)
                _:
                    return (true, false, fact, TokenKind.Eof, fact)
        # Eliminate a relevant immutable conditional equality by cases. Replacing
        # the premise prevents repeated splitting; both arms keep original budgets.
        def proof_unsigned_conditional_alias_goal(facts: darray[Ast::Expr]&, goal: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, operator_mask: usize, depth: usize, budget: mutable usize&, split_depth: usize, exhausted: mutable bool&) -> bool can[Global{Read,Write}]:
            return false if split_depth >= PROOF_LINEAR_CASE_SPLIT_DEPTH_LIMIT
            goal_view: (complete: bool, stripped: Ast::Expr) = proof_linear_strip_parens_with_work(goal, budget, exhausted)
            return false if not goal_view.complete or exhausted
            match goal_view.stripped:
                Ast::Expr.Binary(goal_left, operator, goal_right, _):
                    return false if not proof_is_comparison(operator)
                    marker_result: (complete: bool, witnesses: ProofScalarWitnesses) = proof_scalar_witness_markers_with_work(facts, true, budget, exhausted)
                    return false if not marker_result.complete or exhausted
                    marker_scale_result: (complete: bool, scale: usize) = proof_linear_safety_marker_scale_with_work(marker_result.witnesses, budget, exhausted)
                    return false if not marker_scale_result.complete or exhausted
                    frame: (complete: bool, cost: usize, goal_cost: usize) = proof_linear_goal_frame_cost_with_work(goal, facts, budget, exhausted)
                    return false if not frame.complete or exhausted
                    for index in 0..<facts.count |index, facts, goal, goal_left, goal_right, marker_result, marker_scale_result, frame, annotations, operator_mask, depth, budget, split_depth, exhausted|:
                        return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                        fact_view: (complete: bool, stripped: Ast::Expr) = proof_linear_strip_parens_with_work(facts[index], budget, exhausted)
                        return false if not fact_view.complete or exhausted
                        match fact_view.stripped:
                            Ast::Expr.Binary(left, TokenKind.EqEq, right, position):
                                alias: Ast::Expr = left if proof_ident_name(left) != "" else right
                                conditional: Ast::Expr = right if proof_ident_name(left) != "" else left
                                alias_name: sview = proof_ident_name(alias)
                                continue if alias_name == ""
                                occurs: bool = proof_scalar_alias_occurs_with_work(goal, alias_name, frame.goal_cost, budget, exhausted)
                                return false if exhausted
                                continue if not occurs
                                alias_comparable: (complete: bool, matches: bool) = proof_linear_safety_comparison_with_work(alias, conditional, marker_result.witnesses, marker_scale_result.scale, budget, exhausted)
                                return false if not alias_comparable.complete or exhausted
                                continue if not alias_comparable.matches
                                difference_safe: bool = proof_unsigned_conditional_difference_safe_with_work(conditional, marker_result.witnesses, budget, exhausted)
                                return false if exhausted
                                continue if not difference_safe
                                match conditional:
                                    Ast::Expr.If(condition, then_expression, else_expression, _):
                                        alias_width: i64 = proof_unsigned_width_in_expression_with_work(alias, marker_result.witnesses, budget, exhausted)
                                        return false if exhausted
                                        then_width: i64 = proof_unsigned_width_in_expression_with_work(then_expression, marker_result.witnesses, budget, exhausted)
                                        return false if exhausted
                                        continue if alias_width != then_width
                                        then_refuted: mutable bool = false
                                        else_refuted: mutable bool = false
                                        match condition:
                                            Ast::Expr.Binary(a, comparison, b, _):
                                                for fact in facts |fact, facts, a, b, comparison, marker_result, marker_scale_result, frame, then_refuted, else_refuted, budget, exhausted|:
                                                    readable: (complete: bool, known: bool, left: Ast::Expr, operator: TokenKind, right: Ast::Expr) = proof_conditional_alias_readable_order_with_work(fact, facts, marker_result.witnesses, marker_scale_result.scale, frame.cost, budget, exhausted)
                                                    if not readable.complete or exhausted:
                                                        exhausted <- true
                                                        return false
                                                    continue if not readable.known
                                                    left_equal: (complete: bool, matches: bool) = proof_linear_search_expr_equal_with_work(readable.left, a, budget, PROOF_LINEAR_SAFETY_WORK_LIMIT, true)
                                                    if not left_equal.complete:
                                                        exhausted <- true
                                                        return false
                                                    continue if not left_equal.matches
                                                    right_equal: (complete: bool, matches: bool) = proof_linear_search_expr_equal_with_work(readable.right, b, budget, PROOF_LINEAR_SAFETY_WORK_LIMIT, true)
                                                    if not right_equal.complete:
                                                        exhausted <- true
                                                        return false
                                                    continue if not right_equal.matches
                                                    then_refuted <- true if readable.operator == proof_comparison_negation(comparison)
                                                    else_refuted <- true if readable.operator == comparison
                                                    break if then_refuted and else_refuted
                                            _:
                                                pass
                                        if budget >= PROOF_LINEAR_MAX_ENUMERATED_ELEMENTS:
                                            exhausted <- true
                                            return false
                                        budget <- budget + 1
                                        return false if not proof_linear_safety_work_charge_scaled(budget, exhausted, facts.count, 2) or not proof_linear_safety_work_charge(budget, exhausted, 2)
                                        then_facts: mutable darray[Ast::Expr] = []
                                        else_facts: mutable darray[Ast::Expr] = []
                                        then_facts.extend(facts)
                                        else_facts.extend(facts)
                                        then_facts[index] <- Ast::Expr.Binary(alias, TokenKind.EqEq, then_expression, position)
                                        else_facts[index] <- Ast::Expr.Binary(alias, TokenKind.EqEq, else_expression, position)
                                        then_facts.push(condition)
                                        else_facts.push(Ast::Expr.Unary(TokenKind.Not, condition, position))
                                        return (then_refuted or (proof_goal_depth(then_facts, goal, annotations, operator_mask, depth + 1, budget, split_depth + 1, exhausted) can Global{Read,Write})) and (else_refuted or (proof_goal_depth(else_facts, goal, annotations, operator_mask, depth + 1, budget, split_depth + 1, exhausted) can Global{Read,Write}))
                                    _:
                                        pass
                            _:
                                pass
                _:
                    pass
            return false
