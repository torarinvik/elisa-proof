extend ElisaProof:
    public:
        # Eliminate a relevant immutable conditional equality by cases. Replacing
        # the premise prevents repeated splitting; both arms keep original budgets.
        def proof_unsigned_conditional_alias_goal(facts: darray[Ast::Expr]&, goal: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, operator_mask: usize, depth: usize, budget: mutable usize&, split_depth: usize, exhausted: mutable bool&) -> bool:
            return false if split_depth >= PROOF_LINEAR_CASE_SPLIT_DEPTH_LIMIT
            match proof_strip_parens(goal):
                Ast::Expr.Binary(goal_left, operator, goal_right, _):
                    return false if not proof_is_comparison(operator)
                    for index in 0..<facts.count |index, facts, goal, goal_left, goal_right, annotations, operator_mask, depth, budget, split_depth, exhausted|:
                        match proof_strip_parens(facts[index]):
                            Ast::Expr.Binary(left, TokenKind.EqEq, right, position):
                                alias: Ast::Expr = left if proof_ident_name(left) != "" else right
                                conditional: Ast::Expr = right if proof_ident_name(left) != "" else left
                                continue if proof_ident_name(alias) == "" or (not proof_expr_equal(alias, goal_left) and not proof_expr_equal(alias, goal_right))
                                continue if not proof_primitive_comparison(alias, conditional, facts) or not proof_unsigned_conditional_difference_safe(conditional, facts)
                                match conditional:
                                    Ast::Expr.If(condition, then_expression, else_expression, _):
                                        continue if proof_peer_unsigned_width(alias, facts) != proof_unsigned_width_in_expression(then_expression, facts)
                                        then_refuted: mutable bool = false
                                        else_refuted: mutable bool = false
                                        match condition:
                                            Ast::Expr.Binary(a, comparison, b, _):
                                                for fact in facts |fact, facts, a, b, comparison, then_refuted, else_refuted|:
                                                    order = proof_readable_order(fact, facts)
                                                    continue if not order.known or not proof_expr_equal(order.left, a) or not proof_expr_equal(order.right, b)
                                                    then_refuted <- true if order.operator == proof_comparison_negation(comparison)
                                                    else_refuted <- true if order.operator == comparison
                                            _:
                                                pass
                                        if budget >= PROOF_LINEAR_MAX_ENUMERATED_ELEMENTS:
                                            exhausted <- true
                                            return false
                                        budget <- budget + 1
                                        then_facts: mutable darray[Ast::Expr] = []
                                        else_facts: mutable darray[Ast::Expr] = []
                                        then_facts.extend(facts)
                                        else_facts.extend(facts)
                                        then_facts[index] <- Ast::Expr.Binary(alias, TokenKind.EqEq, then_expression, position)
                                        else_facts[index] <- Ast::Expr.Binary(alias, TokenKind.EqEq, else_expression, position)
                                        then_facts.push(condition)
                                        else_facts.push(Ast::Expr.Unary(TokenKind.Not, condition, position))
                                        return (then_refuted or proof_goal_depth(then_facts, goal, annotations, operator_mask, depth, budget, split_depth + 1, exhausted)) and (else_refuted or proof_goal_depth(else_facts, goal, annotations, operator_mask, depth, budget, split_depth + 1, exhausted))
                                    _:
                                        pass
                            _:
                                pass
                _:
                    pass
            return false
