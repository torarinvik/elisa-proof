extend ElisaProof:
    private:
        # Reuse only same-snapshot primitive reads at independently equal indices.
        def proof_index_read_equality_goal(facts: darray[Ast::Expr]&, goal: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, operator_mask: usize, depth: usize, budget: mutable usize&, split_depth: usize, exhausted: mutable bool&) -> bool can[Global.Read, Global.Write]:
            match proof_strip_parens(goal):
                Ast::Expr.Binary(left, TokenKind.EqEq, right, position):
                    return false if not proof_primitive_comparison(left, right, facts)
                    for orientation in 0..<2 |orientation, left, right, position, facts, annotations, operator_mask, depth, budget, split_depth, exhausted|:
                        read: Ast::Expr = left if orientation == 0 else right
                        value: Ast::Expr = right if orientation == 0 else left
                        match proof_strip_parens(read):
                            Ast::Expr.Index(base, index, _):
                                for fact in facts |base, index, value, position, facts, annotations, operator_mask, depth, budget, split_depth, exhausted|:
                                    equality: mutable Ast::Expr = proof_strip_parens(fact)
                                    match equality:
                                        Ast::Expr.Unary(TokenKind.Not, operand, _):
                                            match proof_strip_parens(operand):
                                                Ast::Expr.Binary(a, TokenKind.BangEq, b, p):
                                                    equality <- Ast::Expr.Binary(a, TokenKind.EqEq, b, p)
                                                _:
                                                    continue
                                        _:
                                            pass
                                    match equality:
                                        Ast::Expr.Binary(a, TokenKind.EqEq, b, _):
                                            continue if not proof_primitive_comparison(a, b, facts)
                                            continue if not proof_expr_equal(b, value) and not proof_expr_equal(a, value)
                                            other: Ast::Expr = a if proof_expr_equal(b, value) else b
                                            match proof_strip_parens(other):
                                                Ast::Expr.Index(other_base, other_index, _):
                                                    continue if not proof_expr_equal(base, other_base) or proof_expr_equal(index, other_index)
                                                    index_goal: Ast::Expr = Ast::Expr.Binary(index, TokenKind.EqEq, other_index, position)
                                                    return true if (proof_goal_depth(facts, index_goal, annotations, operator_mask, depth + 1, budget, split_depth, exhausted) can Global{Read,Write})
                                                _:
                                                    pass
                                        _:
                                            pass
                            _:
                                pass
                _:
                    pass
            return false
