# Exact integer pins for identifier and namespace-qualified terms. A scoped
# constant is not interchangeable with another constant until the premises
# establish each one's literal value.
extend ElisaProof:
    private:
        def proof_constant_pin_of_fact(fact: Ast::Expr, term: Ast::Expr) -> (known: bool, value: i64):
            match fact:
                Ast::Expr.Binary(pin_left, TokenKind.EqEq, pin_right, _):
                    match pin_left:
                        Ast::Expr.Ident(_, _) | Ast::Expr.Scope(_, _, _):
                            return (false, 0) if not proof_expr_equal(pin_left, term)
                            match pin_right:
                                Ast::Expr.IntLit(pinned_value, _):
                                    return (true, pinned_value)
                                _:
                                    return (false, 0)
                        _:
                            return (false, 0)
                _:
                    return (false, 0)

        def proof_pinned_constant_value(expression: Ast::Expr, facts: darray[Ast::Expr]&) -> (known: bool, value: i64):
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_pinned_constant_value(inner, facts)
                Ast::Expr.IntLit(literal_value, _):
                    return (true, literal_value)
                Ast::Expr.Ident(_, _) | Ast::Expr.Scope(_, _, _):
                    for fact in facts:
                        pinned: (known: bool, value: i64) = proof_constant_pin_of_fact(fact, expression)
                        return pinned if pinned.known
                    return (false, 0)
                _:
                    return (false, 0)

        # A comparison fact and goal may use different terms when source-backed equality pins
        # establish that both terms denote the same integer.
        def proof_operand_matches_through_pins(fact_operand: Ast::Expr, goal_operand: Ast::Expr, facts: darray[Ast::Expr]&) -> bool:
            return true if proof_expr_equal(fact_operand, goal_operand)
            fact_constant: (known: bool, value: i64) = proof_pinned_constant_value(fact_operand, facts)
            return false if not fact_constant.known
            goal_constant: (known: bool, value: i64) = proof_pinned_constant_value(goal_operand, facts)
            return goal_constant.known and goal_constant.value == fact_constant.value
