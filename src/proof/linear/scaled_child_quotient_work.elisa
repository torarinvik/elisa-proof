# Metered form of the fixed-width `(root * k) + 1` quotient rule.
extend ElisaProof:
    private:
        def proof_scaled_child_literal_sort_with_work(annotations: darray[Ast::EnumAnnotation]&, position: Ast::Pos, payload: i64, width: i64, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, compatible: bool):
            return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
            return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, annotations.count)
            literal: (known: bool, bits: u64, unsigned: bool, width: i64) = proof_replay_numeric_literal_sort(annotations, position.line, position.column, payload)
            return (true, not literal.known or (literal.unsigned and literal.width == width))

        def proof_unsigned_scaled_child_quotient_shape_with_work(facts: darray[Ast::Expr]&, goal: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, proven: bool):
            can Abort.Panic:
                goal_view: (complete: bool, expression: Ast::Expr) = proof_unsigned_strip_parens_with_work(goal, budget, exhausted)
                return (false, false) if not goal_view.complete
                match goal_view.expression:
                    Ast::Expr.Binary(child, goal_operator, target, _):
                        return (true, false) if goal_operator != TokenKind.Gt and goal_operator != TokenKind.Lt
                        child_view: (complete: bool, expression: Ast::Expr) = proof_unsigned_strip_parens_with_work(child, budget, exhausted)
                        return (false, false) if not child_view.complete
                        match child_view.expression:
                            Ast::Expr.Binary(child_left, TokenKind.Plus, child_right, _):
                                right_one: (complete: bool, expression: Ast::Expr) = proof_unsigned_strip_parens_with_work(child_right, budget, exhausted)
                                return (false, false) if not right_one.complete
                                product: mutable Ast::Expr = child_left
                                one_value: mutable i64 = 0
                                one_position: mutable Ast::Pos = Ast::expr_pos(child_right)
                                match right_one.expression:
                                    Ast::Expr.IntLit(value, position):
                                        return (true, false) if value != 1
                                        one_value <- value
                                        one_position <- position
                                    _:
                                        left_one: (complete: bool, expression: Ast::Expr) = proof_unsigned_strip_parens_with_work(child_left, budget, exhausted)
                                        return (false, false) if not left_one.complete
                                        match left_one.expression:
                                            Ast::Expr.IntLit(value, position):
                                                return (true, false) if value != 1
                                                product <- child_right
                                                one_value <- value
                                                one_position <- position
                                            _:
                                                return (true, false)
                                product_view: (complete: bool, expression: Ast::Expr) = proof_unsigned_strip_parens_with_work(product, budget, exhausted)
                                return (false, false) if not product_view.complete
                                match product_view.expression:
                                    Ast::Expr.Binary(product_left, TokenKind.Star, product_right, _):
                                        root: mutable Ast::Expr = product_right
                                        factor_value: mutable i64 = 0
                                        factor_position: mutable Ast::Pos = Ast::expr_pos(product_left)
                                        left_factor: (complete: bool, expression: Ast::Expr) = proof_unsigned_strip_parens_with_work(product_left, budget, exhausted)
                                        return (false, false) if not left_factor.complete
                                        match left_factor.expression:
                                            Ast::Expr.IntLit(value, position):
                                                return (true, false) if value < 2
                                                factor_value <- value
                                                factor_position <- position
                                            _:
                                                right_factor: (complete: bool, expression: Ast::Expr) = proof_unsigned_strip_parens_with_work(product_right, budget, exhausted)
                                                return (false, false) if not right_factor.complete
                                                match right_factor.expression:
                                                    Ast::Expr.IntLit(value, position):
                                                        return (true, false) if value < 2
                                                        root <- product_left
                                                        factor_value <- value
                                                        factor_position <- position
                                                    _:
                                                        return (true, false)
                                        shape_cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(goal, budget, exhausted)
                                        return (false, false) if not shape_cost.complete
                                        marker_result: (complete: bool, witnesses: ProofScalarWitnesses) = proof_scalar_witness_markers_with_work(facts, false, budget, exhausted)
                                        return (false, false) if not marker_result.complete or proof_goal_bool_ref_value(exhausted)
                                        root_width: i64 = proof_unsigned_width_in_expression_with_work(root, marker_result.witnesses, budget, exhausted)
                                        return (false, false) if proof_goal_bool_ref_value(exhausted)
                                        return (true, false) if root_width == 0
                                        child_width: i64 = proof_unsigned_width_in_expression_with_work(child, marker_result.witnesses, budget, exhausted)
                                        return (false, false) if proof_goal_bool_ref_value(exhausted)
                                        one_sort: (complete: bool, compatible: bool) = proof_scaled_child_literal_sort_with_work(annotations, one_position, one_value, child_width, budget, exhausted)
                                        return (false, false) if not one_sort.complete
                                        return (true, false) if not one_sort.compatible
                                        factor_sort: (complete: bool, compatible: bool) = proof_scaled_child_literal_sort_with_work(annotations, factor_position, factor_value, root_width, budget, exhausted)
                                        return (false, false) if not factor_sort.complete
                                        return (true, false) if not factor_sort.compatible
                                        witness: (complete: bool, known: bool, base: Ast::Expr, bound: Ast::Expr, factor: i64) = proof_unsigned_scaled_product_witness_with_work(product, facts, marker_result.witnesses, true, budget, exhausted)
                                        return (false, false) if not witness.complete or proof_goal_bool_ref_value(exhausted)
                                        return (true, false) if not witness.known or witness.factor < 2 or witness.factor != factor_value
                                        same_root: bool = proof_unsigned_witness_terms_equal_with_work(witness.base, root, budget, exhausted)
                                        return (false, false) if proof_goal_bool_ref_value(exhausted)
                                        return (true, false) if not same_root
                                        product_width: i64 = proof_unsigned_width_in_expression_with_work(product, marker_result.witnesses, budget, exhausted)
                                        return (false, false) if proof_goal_bool_ref_value(exhausted)
                                        return (true, false) if product_width != root_width or child_width != root_width
                                        bound_width: i64 = proof_unsigned_width_in_expression_with_work(witness.bound, marker_result.witnesses, budget, exhausted)
                                        return (false, false) if proof_goal_bool_ref_value(exhausted)
                                        return (true, false) if bound_width != root_width
                                        constants_fit: bool = proof_unsigned_constants_fit_with_work(child, root_width, 0, budget, exhausted)
                                        return (false, false) if proof_goal_bool_ref_value(exhausted)
                                        return (true, false) if not constants_fit
                                        marker_scale: (complete: bool, scale: usize) = proof_linear_safety_marker_scale_with_work(marker_result.witnesses, budget, exhausted)
                                        return (false, false) if not marker_scale.complete or proof_goal_bool_ref_value(exhausted)
                                        conjuncts: mutable darray[Ast::Expr] = []
                                        for fact in facts |fact, conjuncts, budget, exhausted|:
                                            return (false, false) if not proof_linear_push_conjuncts_with_work(fact, &conjuncts, 0, budget, exhausted)
                                        fact_scan_cost: mutable usize = 0
                                        fact_scan_cost_valid: mutable bool = false
                                        for fact in conjuncts |fact, facts, marker_result, marker_scale, fact_scan_cost, fact_scan_cost_valid, root, witness, root_width, annotations, factor_value, goal_operator, target, budget, exhausted|:
                                            order: (complete: bool, known: bool, left: Ast::Expr, operator: TokenKind, right: Ast::Expr) = proof_unsigned_scaled_product_order_with_work(fact, facts, marker_result.witnesses, marker_scale.scale, &fact_scan_cost, &fact_scan_cost_valid, 0, budget, exhausted)
                                            return (false, false) if not order.complete or proof_goal_bool_ref_value(exhausted)
                                            continue if not order.known or order.operator != TokenKind.Lt
                                            same_left: bool = proof_unsigned_witness_terms_equal_with_work(order.left, root, budget, exhausted)
                                            return (false, false) if proof_goal_bool_ref_value(exhausted)
                                            continue if not same_left
                                            quotient_view: (complete: bool, expression: Ast::Expr) = proof_unsigned_strip_parens_with_work(order.right, budget, exhausted)
                                            return (false, false) if not quotient_view.complete
                                            match quotient_view.expression:
                                                Ast::Expr.Binary(ceiling, TokenKind.Slash, divisor, _):
                                                    same_ceiling: bool = proof_unsigned_witness_terms_equal_with_work(ceiling, witness.bound, budget, exhausted)
                                                    return (false, false) if proof_goal_bool_ref_value(exhausted)
                                                    continue if not same_ceiling
                                                    left_width: i64 = proof_unsigned_width_in_expression_with_work(order.left, marker_result.witnesses, budget, exhausted)
                                                    return (false, false) if proof_goal_bool_ref_value(exhausted)
                                                    right_width: i64 = proof_unsigned_width_in_expression_with_work(order.right, marker_result.witnesses, budget, exhausted)
                                                    return (false, false) if proof_goal_bool_ref_value(exhausted)
                                                    ceiling_width: i64 = proof_unsigned_width_in_expression_with_work(ceiling, marker_result.witnesses, budget, exhausted)
                                                    return (false, false) if proof_goal_bool_ref_value(exhausted)
                                                    continue if left_width != root_width or right_width != root_width or ceiling_width != root_width
                                                    divisor_view: (complete: bool, expression: Ast::Expr) = proof_unsigned_strip_parens_with_work(divisor, budget, exhausted)
                                                    return (false, false) if not divisor_view.complete
                                                    match divisor_view.expression:
                                                        Ast::Expr.IntLit(divisor_value, divisor_position):
                                                            continue if divisor_value != factor_value
                                                            divisor_sort: (complete: bool, compatible: bool) = proof_scaled_child_literal_sort_with_work(annotations, divisor_position, divisor_value, root_width, budget, exhausted)
                                                            return (false, false) if not divisor_sort.complete
                                                            continue if not divisor_sort.compatible
                                                            same_target: bool = proof_unsigned_witness_terms_equal_with_work(target, root, budget, exhausted) if goal_operator == TokenKind.Gt else proof_unsigned_witness_terms_equal_with_work(target, witness.bound, budget, exhausted)
                                                            return (false, false) if proof_goal_bool_ref_value(exhausted)
                                                            return (true, same_target)
                                                        _:
                                                            pass
                                                _:
                                                    pass
                                        return (true, false)
                                    _:
                                        return (true, false)
                            _:
                                return (true, false)
                    _:
                        return (true, false)

        def proof_unsigned_scaled_product_upper_shape_with_work(facts: darray[Ast::Expr]&, goal: Ast::Expr, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, proven: bool):
            can Abort.Panic:
                goal_view: (complete: bool, expression: Ast::Expr) = proof_unsigned_strip_parens_with_work(goal, budget, exhausted)
                return (false, false) if not goal_view.complete
                match goal_view.expression:
                    Ast::Expr.Binary(product, operator, bound, _):
                        return (true, false) if operator != TokenKind.LtEq and operator != TokenKind.Lt
                        shape_cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(goal, budget, exhausted)
                        return (false, false) if not shape_cost.complete
                        marker_result: (complete: bool, witnesses: ProofScalarWitnesses) = proof_scalar_witness_markers_with_work(facts, false, budget, exhausted)
                        return (false, false) if not marker_result.complete or proof_goal_bool_ref_value(exhausted)
                        witness: (complete: bool, known: bool, base: Ast::Expr, bound: Ast::Expr, factor: i64) = proof_unsigned_scaled_product_witness_with_work(product, facts, marker_result.witnesses, operator == TokenKind.Lt, budget, exhausted)
                        return (false, false) if not witness.complete or proof_goal_bool_ref_value(exhausted)
                        return (true, false) if not witness.known
                        same_bound: bool = proof_unsigned_witness_terms_equal_with_work(witness.bound, bound, budget, exhausted)
                        return (false, false) if proof_goal_bool_ref_value(exhausted)
                        return (true, same_bound)
                    _:
                        return (true, false)
