# Collision-safe vertex and sort indexes used by name-equality closure.
extend ElisaProof:
    private:
        struct ProofNameEqualityVertexIndex:
            hashes: mutable darray[u32]
            values: mutable darray[usize]
            capacity: usize

        struct ProofNameEqualitySortIndex:
            names: mutable darray[sview]
            hashes: mutable darray[u32]
            slots: mutable darray[usize]
            signed_widths: mutable darray[i64]
            unsigned_widths: mutable darray[i64]
            signed_conflicts: mutable darray[bool]
            unsigned_conflicts: mutable darray[bool]
            capacity: usize

        def proof_name_equality_vertex_index_build(edge_count: usize, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, index: ProofNameEqualityVertexIndex):
            index: mutable ProofNameEqualityVertexIndex = ProofNameEqualityVertexIndex{hashes: [], values: [], capacity: 0}
            return (true, index) if edge_count == 0
            return (false, index) if edge_count > PROOF_LINEAR_SAFETY_WORK_LIMIT / 2
            capacity: mutable usize = 1
            target: usize = edge_count * 2
            while capacity < target |capacity, target, budget, exhausted|:
                return (false, index) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                capacity <- capacity * 2
            return (false, index) if not proof_linear_safety_work_charge(budget, exhausted, capacity * 2)
            index.capacity <- capacity
            index.hashes.resize(capacity)
            index.values.resize(capacity)
            for slot in 0..<capacity |slot, index, capacity, budget, exhausted|:
                return (false, index) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                index.values[slot] <- capacity
            return (true, index)

        def proof_name_equality_vertex_index_insert(index: mutable ProofNameEqualityVertexIndex&, names: mutable darray[sview]&, name: sview, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, row: usize):
            return (false, names.count) if name == "" or index.capacity == 0 or index.hashes.count != index.capacity or index.values.count != index.capacity
            return (false, names.count) if not proof_linear_safety_work_charge(budget, exhausted, 1) or not proof_linear_safety_work_charge(budget, exhausted, sview_len(name))
            hash: u32 = proof_name_hash(name)
            slot: mutable usize = (hash.i64() % index.capacity.i64()).usize()
            probes: mutable usize = 0
            while probes < index.capacity |probes, slot, hash, index, names, name, budget, exhausted|:
                return (false, names.count) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                current: usize = index.values[slot]
                if current == index.capacity:
                    return (false, names.count) if names.count >= index.capacity or not proof_linear_safety_work_charge(budget, exhausted, 1) or not proof_linear_safety_work_charge(budget, exhausted, sview_len(name))
                    index.hashes[slot] <- hash
                    index.values[slot] <- names.count
                    names.push(name)
                    return (true, names.count - 1)
                return (false, names.count) if current >= names.count
                if index.hashes[slot] == hash:
                    return (false, names.count) if not proof_linear_safety_work_charge(budget, exhausted, sview_len(names[current]))
                    return (true, current) if names[current] == name
                slot <- (slot + 1) % index.capacity
                probes <- probes + 1
            exhausted <- true
            return (false, names.count)

        def proof_name_equality_vertex_index_find(index: ProofNameEqualityVertexIndex, names: darray[sview]&, name: sview, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, found: bool, row: usize):
            return (false, false, names.count) if name == "" or index.capacity == 0 or index.hashes.count != index.capacity or index.values.count != index.capacity
            return (false, false, names.count) if not proof_linear_safety_work_charge(budget, exhausted, sview_len(name))
            hash: u32 = proof_name_hash(name)
            slot: mutable usize = (hash.i64() % index.capacity.i64()).usize()
            probes: mutable usize = 0
            while probes < index.capacity |probes, slot, hash, index, names, name, budget, exhausted|:
                return (false, false, names.count) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                current: usize = index.values[slot]
                return (true, false, names.count) if current == index.capacity
                return (false, false, names.count) if current >= names.count
                if index.hashes[slot] == hash:
                    return (false, false, names.count) if not proof_linear_safety_work_charge(budget, exhausted, sview_len(names[current]))
                    return (true, true, current) if names[current] == name
                slot <- (slot + 1) % index.capacity
                probes <- probes + 1
            return (true, false, names.count)

        def proof_name_equality_sort_index_add(index: mutable ProofNameEqualitySortIndex&, name: sview, signed: bool, width: i64, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            return false if name == "" or width <= 0 or index.capacity == 0
            return false if not proof_linear_safety_work_charge(budget, exhausted, 1) or not proof_linear_safety_work_charge(budget, exhausted, sview_len(name))
            hash: u32 = proof_name_hash(name)
            slot: mutable usize = (hash.i64() % index.capacity.i64()).usize()
            probes: mutable usize = 0
            while probes < index.capacity |slot, probes, index, hash, name, signed, width, budget, exhausted|:
                return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                row: mutable usize = index.slots[slot]
                if row == index.capacity:
                    row <- index.names.count
                    return false if row >= index.capacity or not proof_linear_safety_work_charge(budget, exhausted, 5)
                    index.names.push(name)
                    index.hashes.push(hash)
                    index.signed_widths.push(0)
                    index.unsigned_widths.push(0)
                    index.signed_conflicts.push(false)
                    index.unsigned_conflicts.push(false)
                    index.slots[slot] <- row
                return false if row >= index.names.count or row >= index.hashes.count or row >= index.signed_widths.count or row >= index.unsigned_widths.count or row >= index.signed_conflicts.count or row >= index.unsigned_conflicts.count
                if index.hashes[row] == hash:
                    return false if not proof_linear_safety_work_charge(budget, exhausted, sview_len(index.names[row]))
                    if index.names[row] == name:
                        if signed:
                            index.signed_conflicts[row] <- index.signed_conflicts[row] or (index.signed_widths[row] != 0 and index.signed_widths[row] != width)
                            index.signed_widths[row] <- width if index.signed_widths[row] == 0
                        else:
                            index.unsigned_conflicts[row] <- index.unsigned_conflicts[row] or (index.unsigned_widths[row] != 0 and index.unsigned_widths[row] != width)
                            index.unsigned_widths[row] <- width if index.unsigned_widths[row] == 0
                        return true
                slot <- (slot + 1) % index.capacity
                probes <- probes + 1
            exhausted <- true
            return false

        def proof_name_equality_sort_index_build(facts: darray[Ast::Expr]&, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, index: ProofNameEqualitySortIndex):
            index: mutable ProofNameEqualitySortIndex = ProofNameEqualitySortIndex{names: [], hashes: [], slots: [], signed_widths: [], unsigned_widths: [], signed_conflicts: [], unsigned_conflicts: [], capacity: 0}
            if facts.count == 0:
                return (true, index)
            relevant: mutable usize = 0
            for fact in facts |fact, relevant, budget, exhausted|:
                return (false, index) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                callee: sview = proof_marker_callee_name(fact)
                return (false, index) if not proof_linear_safety_work_charge(budget, exhausted, sview_len(callee))
                relevant <- relevant + 1 if callee == "__elisa_signed_type_bound" or callee == "__elisa_signed_place_type_bound" or callee == "__elisa_unsigned_type_bound"
            return (true, index) if relevant == 0
            return (false, index) if relevant > PROOF_LINEAR_SAFETY_WORK_LIMIT / 2
            capacity: mutable usize = 1
            target: usize = relevant * 2
            while capacity < target |capacity, target, budget, exhausted|:
                return (false, index) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                capacity <- capacity * 2
            return (false, index) if not proof_linear_safety_work_charge(budget, exhausted, capacity)
            index.capacity <- capacity
            index.slots.resize(capacity)
            for slot in 0..<capacity |slot, index, capacity, budget, exhausted|:
                return (false, index) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                index.slots[slot] <- capacity
            for fact in facts |fact, index, capacity, budget, exhausted|:
                cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(fact, &budget, &exhausted)
                return (false, index) if not cost.complete
                callee: sview = proof_marker_callee_name(fact)
                return (false, index) if not proof_linear_safety_work_charge(budget, exhausted, 1) or not proof_linear_safety_work_charge(budget, exhausted, sview_len(callee))
                match callee:
                    "__elisa_signed_type_bound":
                        marker: (known: bool, term: Ast::Expr, width: i64) = proof_signed_marker_info(fact)
                        if marker.known:
                            match marker.term:
                                Ast::Expr.Ident(name, _):
                                    return (false, index) if not proof_name_equality_sort_index_add(&index, name, true, marker.width, budget, exhausted)
                                _:
                                    pass
                    "__elisa_signed_place_type_bound":
                        marker: (known: bool, term: Ast::Expr, width: i64) = proof_signed_place_marker_info(fact)
                        if marker.known:
                            match marker.term:
                                Ast::Expr.Ident(name, _):
                                    return (false, index) if not proof_name_equality_sort_index_add(&index, name, true, marker.width, budget, exhausted)
                                _:
                                    pass
                    "__elisa_unsigned_type_bound":
                        marker: (known: bool, name: sview, width: i64) = proof_unsigned_marker_info(fact)
                        return (false, index) if marker.known and not proof_name_equality_sort_index_add(&index, marker.name, false, marker.width, budget, exhausted)
                    _:
                        pass
            return (true, index)

        def proof_name_equality_sort_index_lookup(index: ProofNameEqualitySortIndex&, name: sview, budget: mutable usize&, exhausted: mutable bool&) -> i64:
            return 0 if name == "" or index.capacity == 0
            return 0 if index.slots.count != index.capacity or index.names.count != index.hashes.count or index.names.count != index.signed_widths.count or index.names.count != index.unsigned_widths.count or index.names.count != index.signed_conflicts.count or index.names.count != index.unsigned_conflicts.count
            return 0 if not proof_linear_safety_work_charge(budget, exhausted, 1) or not proof_linear_safety_work_charge(budget, exhausted, sview_len(name))
            hash: u32 = proof_name_hash(name)
            slot: mutable usize = (hash.i64() % index.capacity.i64()).usize()
            probes: mutable usize = 0
            while probes < index.capacity |slot, probes, index, hash, name, budget, exhausted|:
                return 0 if not proof_linear_safety_work_charge(budget, exhausted, 1)
                row: usize = index.slots[slot]
                return 0 if row == index.capacity
                return 0 if row >= index.names.count
                if index.hashes[row] == hash:
                    return 0 if not proof_linear_safety_work_charge(budget, exhausted, sview_len(index.names[row]))
                    if index.names[row] == name:
                        return index.signed_widths[row] if index.signed_widths[row] > 0 and index.unsigned_widths[row] == 0 and not index.signed_conflicts[row]
                        return 0 - index.unsigned_widths[row] if index.unsigned_widths[row] > 0 and index.signed_widths[row] == 0 and not index.unsigned_conflicts[row]
                        return 0
                slot <- (slot + 1) % index.capacity
                probes <- probes + 1
            exhausted <- true
            return 0
