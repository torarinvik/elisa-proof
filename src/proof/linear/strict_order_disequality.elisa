extend ElisaProof:
    private:
        # A primitive strict order fact entails that its two witnessed operands
        # are distinct. Keep the operands structurally identical (or exactly
        # reversed) and reject overloaded comparisons at the source guard; this
        # does not interpret arbitrary user-defined `<`/`>` protocols.
        def proof_strict_order_fact_implies_disequality(goal: Ast::Expr, facts: darray[Ast::Expr]&) -> bool:
            match proof_strip_parens(goal):
                Ast::Expr.Binary(left, TokenKind.BangEq, right, _):
                    return false if not proof_primitive_comparison(left, right, facts)
                    for fact in facts |fact, left, right|:
                        match proof_strip_parens(fact):
                            Ast::Expr.Binary(ordered_left, operator, ordered_right, _):
                                continue if operator != TokenKind.Lt and operator != TokenKind.Gt
                                continue if not proof_primitive_comparison(ordered_left, ordered_right, facts)
                                return true if proof_expr_equal(left, ordered_left) and proof_expr_equal(right, ordered_right)
                                return true if proof_expr_equal(left, ordered_right) and proof_expr_equal(right, ordered_left)
                            _:
                                pass
                _:
                    pass
            return false
