# Metered producer rule for signed `(base * scale) + addend` bounds derived from a quotient.
extend ElisaProof:
    private:
        def proof_scaled_quotient_orders_with_work(facts: darray[Ast::Expr]&, markers: ProofScalarWitnesses&, marker_scale: usize, fact_scan_cost: usize, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, lefts: darray[Ast::Expr], operators: darray[TokenKind], rights: darray[Ast::Expr]):
            conjuncts: mutable darray[Ast::Expr] = []
            for fact in facts |fact, conjuncts, budget, exhausted|:
                return (false, [], [], []) if not proof_linear_push_conjuncts_with_work(fact, &conjuncts, 0, budget, exhausted)
            lefts: mutable darray[Ast::Expr] = []
            operators: mutable darray[TokenKind] = []
            rights: mutable darray[Ast::Expr] = []
            for fact in conjuncts |fact, facts, markers, marker_scale, fact_scan_cost, lefts, operators, rights, budget, exhausted|:
                readable: (complete: bool, known: bool, left: Ast::Expr, operator: TokenKind, right: Ast::Expr) = proof_scaled_quotient_read_order_with_work(fact, facts, markers, marker_scale, fact_scan_cost, budget, exhausted)
                return (false, [], [], []) if not readable.complete
                if readable.known:
                    return (false, [], [], []) if not proof_linear_safety_work_charge(budget, exhausted, 3)
                    lefts.push(readable.left)
                    operators.push(readable.operator)
                    rights.push(readable.right)
            return (true, lefts, operators, rights)

        def proof_scaled_quotient_read_order_with_work(fact: Ast::Expr, facts: darray[Ast::Expr]&, markers: ProofScalarWitnesses&, marker_scale: usize, fact_scan_cost: usize, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, known: bool, left: Ast::Expr, operator: TokenKind, right: Ast::Expr):
            match fact:
                Ast::Expr.Binary(left, operator, right, _):
                    return (true, false, fact, TokenKind.Eof, fact) if not proof_is_order_operator(operator)
                    left_witness: (complete: bool, matches: bool) = proof_linear_safety_scalar_witness_with_work(left, markers, marker_scale, budget, exhausted)
                    return (false, false, fact, TokenKind.Eof, fact) if not left_witness.complete
                    return (true, false, fact, TokenKind.Eof, fact) if not left_witness.matches
                    right_witness: (complete: bool, matches: bool) = proof_linear_safety_scalar_witness_with_work(right, markers, marker_scale, budget, exhausted)
                    return (false, false, fact, TokenKind.Eof, fact) if not right_witness.complete
                    return (true, left_witness.matches and right_witness.matches, left, operator, right)
                Ast::Expr.Unary(TokenKind.Not, Ast::Expr.Binary(left, original_operator, right, _), _):
                    operator: TokenKind = proof_comparison_negation(original_operator)
                    return (true, false, fact, TokenKind.Eof, fact) if not proof_is_order_operator(operator)
                    left_witness: (complete: bool, matches: bool) = proof_linear_safety_scalar_witness_with_work(left, markers, marker_scale, budget, exhausted)
                    return (false, false, fact, TokenKind.Eof, fact) if not left_witness.complete
                    return (true, false, fact, TokenKind.Eof, fact) if not left_witness.matches
                    right_witness: (complete: bool, matches: bool) = proof_linear_safety_scalar_witness_with_work(right, markers, marker_scale, budget, exhausted)
                    return (false, false, fact, TokenKind.Eof, fact) if not right_witness.complete
                    return (true, false, fact, TokenKind.Eof, fact) if not right_witness.matches
                    left_integer: (complete: bool, integer: bool) = proof_disjunction_denial_integer_term_with_work(left, facts, markers, marker_scale, fact_scan_cost, 0, budget, exhausted)
                    return (false, false, fact, TokenKind.Eof, fact) if not left_integer.complete
                    return (true, false, fact, TokenKind.Eof, fact) if not left_integer.integer
                    right_integer: (complete: bool, integer: bool) = proof_disjunction_denial_integer_term_with_work(right, facts, markers, marker_scale, fact_scan_cost, 0, budget, exhausted)
                    return (false, false, fact, TokenKind.Eof, fact) if not right_integer.complete
                    return (true, false, fact, TokenKind.Eof, fact) if not right_integer.integer
                    return (true, true, left, operator, right)
                _:
                    return (true, false, fact, TokenKind.Eof, fact)

        def proof_scaled_quotient_has_order_with_work(lefts: darray[Ast::Expr]&, operators: darray[TokenKind]&, rights: darray[Ast::Expr]&, term: Ast::Expr, bound: Ast::Expr, strict_only: bool, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, found: bool):
            return (false, false) if lefts.count != operators.count or lefts.count != rights.count
            for index in 0..<lefts.count |index, lefts, operators, rights, term, bound, strict_only, budget, exhausted|:
                direct_operator: bool = operators[index] == TokenKind.Lt or (not strict_only and operators[index] == TokenKind.LtEq)
                reverse_operator: bool = operators[index] == TokenKind.Gt or (not strict_only and operators[index] == TokenKind.GtEq)
                if direct_operator:
                    exact_left: (complete: bool, equal: bool) = proof_linear_search_expr_equal_with_work(lefts[index], term, budget, PROOF_LINEAR_SAFETY_WORK_LIMIT, true)
                    return (false, false) if not exact_left.complete
                    if exact_left.equal:
                        exact_right: (complete: bool, equal: bool) = proof_linear_search_expr_equal_with_work(rights[index], bound, budget, PROOF_LINEAR_SAFETY_WORK_LIMIT, true)
                        return (false, false) if not exact_right.complete
                        return (true, true) if exact_right.equal
                if reverse_operator:
                    reverse_right: (complete: bool, equal: bool) = proof_linear_search_expr_equal_with_work(rights[index], term, budget, PROOF_LINEAR_SAFETY_WORK_LIMIT, true)
                    return (false, false) if not reverse_right.complete
                    if reverse_right.equal:
                        reverse_left: (complete: bool, equal: bool) = proof_linear_search_expr_equal_with_work(lefts[index], bound, budget, PROOF_LINEAR_SAFETY_WORK_LIMIT, true)
                        return (false, false) if not reverse_left.complete
                        return (true, true) if reverse_left.equal
            return (true, false)

        def proof_linear_arithmetic_goal_with_work(left: Ast::Expr, operator: TokenKind, right: Ast::Expr, facts: darray[Ast::Expr]&, markers: ProofScalarWitnesses&, marker_scale: usize, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, proven: bool):
            can Abort.Panic:
                if operator == TokenKind.EqEq:
                    less_equal: (complete: bool, proven: bool) = proof_linear_arithmetic_goal_with_work(left, TokenKind.LtEq, right, facts, markers, marker_scale, budget, exhausted)
                    return (false, false) if not less_equal.complete
                    return (true, false) if not less_equal.proven
                    greater_equal: (complete: bool, proven: bool) = proof_linear_arithmetic_goal_with_work(left, TokenKind.GtEq, right, facts, markers, marker_scale, budget, exhausted)
                    return (greater_equal.complete, greater_equal.proven)
                for fact in facts |fact, budget, exhausted|:
                    return (false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                    return (true, false) if proof_linear_certificate_marker(fact)
                negated: TokenKind = proof_comparison_negation(operator)
                return (true, false) if negated != TokenKind.Lt and negated != TokenKind.LtEq and negated != TokenKind.Gt and negated != TokenKind.GtEq
                terms: mutable darray[ProofNormalTerm] = []
                spans: mutable darray[ProofLinearSpan] = []
                bounds_ready: mutable bool = false
                base_bounds: mutable darray[ProofBound] = []
                signed_bounds: mutable darray[ProofBound] = []
                if not proof_linear_fact_constraints_with_work(facts, false, 1, markers, marker_scale, &bounds_ready, &base_bounds, &signed_bounds, &terms, &spans, budget, exhausted):
                    return (false, false)
                pushed: bool = proof_linear_push_comparison_with_work(left, negated, right, false, facts, markers, marker_scale, &terms, &spans, budget, exhausted)
                return (false, false) if proof_goal_bool_ref_value(exhausted)
                return (true, false) if not pushed
                refutes: (complete: bool, refutes: bool) = proof_linear_refutes_with_work(terms, spans, budget, exhausted)
                return (refutes.complete and not proof_goal_bool_ref_value(exhausted), refutes.refutes)

        def proof_linear_arithmetic_goal_from_facts_with_work(left: Ast::Expr, operator: TokenKind, right: Ast::Expr, facts: darray[Ast::Expr]&, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, proven: bool):
            can Abort.Panic:
                marker_result: (complete: bool, witnesses: ProofScalarWitnesses) = proof_scalar_witness_markers_with_work(facts, true, budget, exhausted)
                return (false, false) if not marker_result.complete or proof_goal_bool_ref_value(exhausted)
                marker_scale: (complete: bool, scale: usize) = proof_linear_safety_marker_scale_with_work(marker_result.witnesses, budget, exhausted)
                return (false, false) if not marker_scale.complete or proof_goal_bool_ref_value(exhausted)
                return proof_linear_arithmetic_goal_with_work(left, operator, right, facts, marker_result.witnesses, marker_scale.scale, budget, exhausted)

        def proof_signed_scaled_quotient_sum_goal_with_work(facts: darray[Ast::Expr]&, goal: Ast::Expr, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, proven: bool):
            can Abort.Panic:
                goal_result: (complete: bool, stripped: Ast::Expr) = proof_linear_strip_parens_with_work(goal, budget, exhausted)
                return (false, false) if not goal_result.complete
                match goal_result.stripped:
                    Ast::Expr.Binary(expression, operator, right, _):
                        return (true, false) if operator != TokenKind.GtEq and operator != TokenKind.LtEq
                        expression_result: (complete: bool, stripped: Ast::Expr) = proof_linear_strip_parens_with_work(expression, budget, exhausted)
                        return (false, false) if not expression_result.complete
                        match expression_result.stripped:
                            Ast::Expr.Binary(product, TokenKind.Plus, addend, _):
                                product_result: (complete: bool, stripped: Ast::Expr) = proof_linear_strip_parens_with_work(product, budget, exhausted)
                                return (false, false) if not product_result.complete
                                match product_result.stripped:
                                    Ast::Expr.Binary(base, TokenKind.Star, multiplier, _):
                                        scale_constant: (known: bool, value: i64) = proof_constant_int_with_work(multiplier, 0, budget, exhausted)
                                        return (false, false) if proof_goal_bool_ref_value(exhausted)
                                        return (true, false) if not scale_constant.known or scale_constant.value <= 0
                                        zero: Ast::Expr = Ast::Expr.IntLit(0, Ast::expr_pos(expression))
                                        right_result: (complete: bool, stripped: Ast::Expr) = proof_linear_strip_parens_with_work(right, budget, exhausted)
                                        return (false, false) if not right_result.complete
                                        lower_goal: mutable bool = false
                                        match right_result.stripped:
                                            Ast::Expr.IntLit(value, _):
                                                lower_goal <- operator == TokenKind.GtEq and value == 0
                                            _:
                                                pass
                                        return (true, false) if not lower_goal and operator != TokenKind.LtEq
                                        markers_result: (complete: bool, witnesses: ProofScalarWitnesses) = proof_scalar_witness_markers_with_work(facts, true, budget, exhausted)
                                        return (false, false) if not markers_result.complete or proof_goal_bool_ref_value(exhausted)
                                        scale_result: (complete: bool, scale: usize) = proof_linear_safety_marker_scale_with_work(markers_result.witnesses, budget, exhausted)
                                        return (false, false) if not scale_result.complete or proof_goal_bool_ref_value(exhausted)
                                        fact_scan_cost: mutable usize = 0
                                        for fact in facts |fact, fact_scan_cost, budget, exhausted|:
                                            return (false, false) if fact_scan_cost >= PROOF_LINEAR_SAFETY_WORK_LIMIT
                                            cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(fact, budget, exhausted)
                                            remaining: usize = PROOF_LINEAR_SAFETY_WORK_LIMIT - fact_scan_cost - 1
                                            return (false, false) if not cost.complete or cost.cost > remaining
                                            fact_scan_cost <- fact_scan_cost + cost.cost + 1
                                        orders: (complete: bool, lefts: darray[Ast::Expr], operators: darray[TokenKind], rights: darray[Ast::Expr]) = proof_scaled_quotient_orders_with_work(facts, markers_result.witnesses, scale_result.scale, fact_scan_cost, budget, exhausted)
                                        return (false, false) if not orders.complete or proof_goal_bool_ref_value(exhausted)
                                        lower_bound: (complete: bool, found: bool) = proof_scaled_quotient_has_order_with_work(orders.lefts, orders.operators, orders.rights, zero, base, false, budget, exhausted)
                                        return (false, false) if not lower_bound.complete
                                        return (true, false) if not lower_bound.found
                                        addend_bound: (complete: bool, found: bool) = proof_scaled_quotient_has_order_with_work(orders.lefts, orders.operators, orders.rights, zero, addend, false, budget, exhausted)
                                        return (false, false) if not addend_bound.complete
                                        return (true, false) if not addend_bound.found
                                        numerator: mutable Ast::Expr = Ast::Expr.Invalid
                                        found: mutable bool = false
                                        for index in 0..<orders.lefts.count |index, orders, base, scale_constant, numerator, found, budget, exhausted|:
                                            continue if orders.operators[index] != TokenKind.LtEq
                                            same_base: (complete: bool, equal: bool) = proof_linear_search_expr_equal_with_work(orders.lefts[index], base, budget, PROOF_LINEAR_SAFETY_WORK_LIMIT, true)
                                            return (false, false) if not same_base.complete
                                            continue if not same_base.equal
                                            quotient_result: (complete: bool, stripped: Ast::Expr) = proof_linear_strip_parens_with_work(orders.rights[index], budget, exhausted)
                                            return (false, false) if not quotient_result.complete
                                            match quotient_result.stripped:
                                                Ast::Expr.Binary(top, TokenKind.Slash, bottom, _):
                                                    denominator: (known: bool, value: i64) = proof_constant_int_with_work(bottom, 0, budget, exhausted)
                                                    return (false, false) if proof_goal_bool_ref_value(exhausted)
                                                    continue if not denominator.known or denominator.value != scale_constant.value
                                                    numerator <- top
                                                    found <- true
                                                    break
                                                _:
                                                    continue
                                        return (true, false) if not found
                                        expression_width: i64 = proof_signed_width_in_expression_with_scale_work(expression, markers_result.witnesses, 0, scale_result.scale, budget, exhausted)
                                        base_width: i64 = proof_signed_width_in_expression_with_scale_work(base, markers_result.witnesses, 0, scale_result.scale, budget, exhausted)
                                        addend_width: i64 = proof_signed_width_in_expression_with_scale_work(addend, markers_result.witnesses, 0, scale_result.scale, budget, exhausted)
                                        return (false, false) if proof_goal_bool_ref_value(exhausted)
                                        return (true, false) if expression_width <= 0 or base_width != expression_width or addend_width != expression_width
                                        zero_ceiling: Ast::Expr = Ast::Expr.IntLit(ElisaProofKernelCore::proof_kernel_signed_width_max(expression_width), Ast::expr_pos(expression))
                                        numerator_nonnegative: (complete: bool, proven: bool) = proof_linear_arithmetic_goal_with_work(numerator, TokenKind.GtEq, zero, facts, markers_result.witnesses, scale_result.scale, budget, exhausted)
                                        return (false, false) if not numerator_nonnegative.complete
                                        return (true, false) if not numerator_nonnegative.proven
                                        sum: Ast::Expr = Ast::Expr.Binary(numerator, TokenKind.Plus, addend, Ast::expr_pos(expression))
                                        sum_in_range: (complete: bool, proven: bool) = proof_linear_arithmetic_goal_with_work(sum, TokenKind.LtEq, zero_ceiling, facts, markers_result.witnesses, scale_result.scale, budget, exhausted)
                                        return (false, false) if not sum_in_range.complete
                                        return (true, false) if not sum_in_range.proven
                                        if lower_goal:
                                            return (true, true)
                                        return proof_linear_arithmetic_goal_with_work(sum, TokenKind.LtEq, right, facts, markers_result.witnesses, scale_result.scale, budget, exhausted)
                                    _:
                                        return (true, false)
                            _:
                                return (true, false)
                    _:
                        return (true, false)
