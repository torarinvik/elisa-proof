# Bounded exact fact and quantified-premise checks for congruence goal search.
extend ElisaProof:
    private:
        def proof_goal_bool_ref_value(value: mutable bool&) -> bool:
            can Abort.Panic:
                return value

        def proof_goal_fact_projection_candidate(expression: Ast::Expr, depth: usize) -> bool:
            return true if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_goal_fact_projection_candidate(inner, depth + 1)
                Ast::Expr.Binary(_, TokenKind.And, _, _):
                    return true
                Ast::Expr.Unary(TokenKind.Not, inner, _):
                    match inner:
                        Ast::Expr.Unary(TokenKind.Not, nested, _):
                            return proof_goal_fact_projection_candidate(nested, depth + 1)
                        _:
                            pass
                _:
                    pass
            return false

        def proof_goal_quantifier_candidate(expression: Ast::Expr, depth: usize) -> bool:
            return true if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_goal_quantifier_candidate(inner, depth + 1)
                Ast::Expr.Block(_, _, _, _):
                    return true
                _:
                    return false
            return false

        def proof_goal_annotation_cost_with_work(annotations: darray[Ast::EnumAnnotation]&, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, cost: usize):
            cost: mutable usize = 0
            for annotation in annotations |annotation, cost, budget, exhausted|:
                owner_cost: usize = 1 + sview_len(annotation.owner)
                name_cost: usize = sview_len(annotation.name)
                return (false, 0) if:
                    not proof_linear_safety_work_charge(budget, exhausted, owner_cost)
                    not proof_linear_safety_work_charge(budget, exhausted, name_cost)
                cost <- cost + owner_cost + name_cost
            return (true, cost)

        def proof_goal_quantifier_kind_with_work(expression: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, budget: mutable usize&, exhausted: mutable bool&) -> sview:
            shape_cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(expression, budget, exhausted)
            return "" if not shape_cost.complete
            return "" if not proof_goal_quantifier_candidate(expression, 0)
            annotation_cost: (complete: bool, cost: usize) = proof_goal_annotation_cost_with_work(annotations, budget, exhausted)
            return "" if not annotation_cost.complete
            return "" if not proof_linear_safety_work_charge_scaled(budget, exhausted, annotation_cost.cost, 1)
            proof_quantifier_kind(expression, annotations)

        def proof_goal_fact_cost_total_with_work(facts: darray[Ast::Expr]&, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, cost: usize):
            total: mutable usize = 0
            for fact in facts |fact, total, budget, exhausted|:
                fact_cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(fact, budget, exhausted)
                return (false, 0) if not fact_cost.complete
                total <- total + fact_cost.cost + 1
            return (true, total)

        # Legacy width classification repeatedly inspects every fact marker at each expression
        # node. Reserve all goal and premise queries together before running the pure traversal.
        def proof_goal_unsigned_widths_free_with_work(goal: Ast::Expr, facts: darray[Ast::Expr]&, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, free: bool):
            goal_cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(goal, budget, exhausted)
            return (false, false) if not goal_cost.complete
            fact_cost: (complete: bool, cost: usize) = proof_goal_fact_cost_total_with_work(facts, budget, exhausted)
            return (false, false) if not fact_cost.complete
            query_cost: usize = goal_cost.cost + fact_cost.cost
            repeated_factor: usize = fact_cost.cost * 2
            return (false, false) if not proof_linear_safety_work_charge_scaled(budget, exhausted, query_cost, repeated_factor)
            return (true, false) if proof_unsigned_width_in_expression(goal, facts) != 0
            for fact in facts |fact, facts|:
                return (true, false) if proof_unsigned_width_in_expression(fact, facts) != 0
            return (true, true)

        def proof_goal_ambiguous_integer_constant_with_work(expression: Ast::Expr, facts: darray[Ast::Expr]&, budget: mutable usize&, exhausted: mutable bool&) -> (complete: bool, ambiguous: bool):
            markers: mutable ProofScalarWitnesses = ProofScalarWitnesses{untrusted_terms: [], scalar_terms: [], names: [], name_unsigned_widths: [], signed_terms: [], signed_widths: [], element_terms: [], element_depths: [], element_widths: [], unsigned_terms: [], unsigned_widths: [], name_hashes: [], name_slots: [], sorted_name_indices: [], signed_hashes: [], signed_slots: [], unsigned_hashes: [], unsigned_slots: []}
            markers_ready: mutable bool = false
            marker_scale: mutable usize = 0
            marker_scale_ready: mutable bool = false
            result: (complete: bool, ambiguous: bool) = proof_goal_ambiguous_integer_in_with_work(expression, facts, &markers, &markers_ready, &marker_scale, &marker_scale_ready, budget, exhausted, 0)
            return result if result.complete and not exhausted
            return (false, false)

        # Build the fact-derived witness index only when a typed comparison needs it. Reuse
        # that validated index for every strict-width and scalar-witness query in this check.
        def proof_goal_ambiguous_markers_with_work(facts: darray[Ast::Expr]&, markers: mutable ProofScalarWitnesses&, markers_ready: mutable bool&, marker_scale: mutable usize&, marker_scale_ready: mutable bool&, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            if not proof_goal_bool_ref_value(markers_ready):
                built: (complete: bool, witnesses: ProofScalarWitnesses) = proof_scalar_witness_markers_with_work(facts, true, budget, exhausted)
                return false if not built.complete
                markers <- built.witnesses
                markers_ready <- true
            if not proof_goal_bool_ref_value(marker_scale_ready):
                scale: (complete: bool, scale: usize) = proof_linear_safety_marker_scale_with_work(markers, budget, exhausted)
                return false if not scale.complete
                marker_scale <- scale.scale
                marker_scale_ready <- true
            return not exhausted

        def proof_goal_closed_integer_arithmetic_with_work(expression: Ast::Expr, depth: usize, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT:
                exhausted <- true
                return true
            return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
            match expression:
                Ast::Expr.IntLit(_, _):
                    return true
                Ast::Expr.Paren(inner, _):
                    return proof_goal_closed_integer_arithmetic_with_work(inner, depth + 1, budget, exhausted)
                Ast::Expr.Unary(operator, operand, _):
                    return (operator == TokenKind.Plus or operator == TokenKind.Minus) and proof_goal_closed_integer_arithmetic_with_work(operand, depth + 1, budget, exhausted)
                Ast::Expr.Binary(left, operator, right, _):
                    arithmetic: bool = operator == TokenKind.Plus or operator == TokenKind.Minus or operator == TokenKind.Star or operator == TokenKind.Slash or operator == TokenKind.Percent or operator == TokenKind.Ampersand or operator == TokenKind.Pipe or operator == TokenKind.Caret or operator == TokenKind.LShift or operator == TokenKind.RShift
                    return arithmetic and proof_goal_closed_integer_arithmetic_with_work(left, depth + 1, budget, exhausted) and proof_goal_closed_integer_arithmetic_with_work(right, depth + 1, budget, exhausted)
                _:
                    return false
            return false

        def proof_goal_signed_call_marker_width_with_work(term: Ast::Expr, facts: darray[Ast::Expr]&, budget: mutable usize&, exhausted: mutable bool&) -> i64:
            for fact in facts |fact, term, budget, exhausted|:
                fact_cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(fact, budget, exhausted)
                return 0 if not fact_cost.complete
                continue if proof_marker_callee_name(fact) != "__elisa_signed_place_type_bound"
                return 0 if not proof_linear_safety_work_charge_scaled(budget, exhausted, fact_cost.cost, 1)
                marker: (known: bool, term: Ast::Expr, width: i64) = proof_signed_place_marker_info(fact)
                continue if not marker.known
                return marker.width if proof_unsigned_witness_terms_equal_with_work(marker.term, term, budget, exhausted)
                return 0 if exhausted
            return 0

        def proof_goal_strict_joined_width_with_work(left: Ast::Expr, right: Ast::Expr, facts: darray[Ast::Expr]&, markers: ProofScalarWitnesses&, marker_scale: usize, budget: mutable usize&, exhausted: mutable bool&, depth: usize) -> i64:
            return 0 if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            left_closed: bool = proof_goal_closed_integer_arithmetic_with_work(left, depth, budget, exhausted)
            return 0 if exhausted
            right_closed: bool = proof_goal_closed_integer_arithmetic_with_work(right, depth, budget, exhausted)
            return 0 if exhausted or (left_closed and right_closed)
            left_width: mutable i64 = 0
            left_width <- proof_goal_strict_signed_width_with_work(left, facts, markers, marker_scale, budget, exhausted, depth) if not left_closed
            return 0 if exhausted
            right_width: mutable i64 = 0
            right_width <- proof_goal_strict_signed_width_with_work(right, facts, markers, marker_scale, budget, exhausted, depth) if not right_closed
            return 0 if exhausted or (not left_closed and left_width == 0) or (not right_closed and right_width == 0) or (left_width != 0 and right_width != 0 and left_width != right_width)
            return left_width if left_width != 0
            return right_width

        def proof_goal_strict_signed_width_with_work(expression: Ast::Expr, facts: darray[Ast::Expr]&, markers: ProofScalarWitnesses&, marker_scale: usize, budget: mutable usize&, exhausted: mutable bool&, depth: usize) -> i64:
            return 0 if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            return 0 if not proof_linear_safety_work_charge(budget, exhausted, 1)
            match expression:
                Ast::Expr.Ident(_, _) | Ast::Expr.Field(_, _, _) | Ast::Expr.Index(_, _, _) | Ast::Expr.IndexN(_, _, _):
                    unsigned_width: i64 = proof_scalar_witness_unsigned_width_with_work(markers, proof_ident_name(expression), budget, exhausted)
                    return 0 if exhausted
                    signed_width: i64 = proof_signed_marker_width_for_term_with_work(expression, markers, budget, exhausted)
                    return 0 if exhausted
                    return 0 - unsigned_width if unsigned_width > 0 and signed_width == 0
                    scalar: (complete: bool, matches: bool) = proof_linear_safety_scalar_witness_with_work(expression, markers, marker_scale, budget, exhausted)
                    return 0 if not scalar.complete or exhausted or not scalar.matches
                    return signed_width
                Ast::Expr.Call(_, _, _, _):
                    scalar: (complete: bool, matches: bool) = proof_linear_safety_scalar_witness_with_work(expression, markers, marker_scale, budget, exhausted)
                    return 0 if not scalar.complete or exhausted or not scalar.matches
                    return proof_goal_signed_call_marker_width_with_work(expression, facts, budget, exhausted)
                Ast::Expr.Paren(inner, _):
                    return proof_goal_strict_signed_width_with_work(inner, facts, markers, marker_scale, budget, exhausted, depth + 1)
                Ast::Expr.Unary(operator, operand, _):
                    return 0 if operator != TokenKind.Minus and operator != TokenKind.Plus
                    return proof_goal_strict_signed_width_with_work(operand, facts, markers, marker_scale, budget, exhausted, depth + 1)
                Ast::Expr.Binary(left, operator, right, _):
                    return 0 if operator != TokenKind.Plus and operator != TokenKind.Minus and operator != TokenKind.Star and operator != TokenKind.Slash and operator != TokenKind.Percent
                    return proof_goal_strict_joined_width_with_work(left, right, facts, markers, marker_scale, budget, exhausted, depth + 1)
                Ast::Expr.If(_, then_expression, else_expression, _):
                    return proof_goal_strict_joined_width_with_work(then_expression, else_expression, facts, markers, marker_scale, budget, exhausted, depth + 1)
                _:
                    return 0
            return 0

        def proof_goal_has_ambiguous_integer_constant_with_work(expression: Ast::Expr, depth: usize, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT:
                exhausted <- true
                return true
            return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
            match expression:
                Ast::Expr.Invalid | Ast::Expr.Absent:
                    return true
                Ast::Expr.IntLit(value, _):
                    return value < 0
                Ast::Expr.FloatLit(_, _) | Ast::Expr.StringLit(_, _) | Ast::Expr.CharLit(_, _) | Ast::Expr.BoolLit(_, _) | Ast::Expr.Ident(_, _) | Ast::Expr.ShorthandMember(_, _):
                    return false
                Ast::Expr.Paren(inner, _):
                    return proof_goal_has_ambiguous_integer_constant_with_work(inner, depth + 1, budget, exhausted)
                Ast::Expr.Unary(operator, operand, _):
                    if operator == TokenKind.Plus or operator == TokenKind.Minus:
                        safe: (known: bool, value: i64) = proof_small_nonnegative_constant_with_work(expression, 0, budget, exhausted)
                        return false if exhausted
                        closed: bool = proof_goal_closed_integer_arithmetic_with_work(expression, depth, budget, exhausted)
                        return false if exhausted
                        return not safe.known if closed
                    return proof_goal_has_ambiguous_integer_constant_with_work(operand, depth + 1, budget, exhausted)
                Ast::Expr.Binary(left, operator, right, _):
                    arithmetic: bool = operator == TokenKind.Plus or operator == TokenKind.Minus or operator == TokenKind.Star or operator == TokenKind.Slash or operator == TokenKind.Percent or operator == TokenKind.Ampersand or operator == TokenKind.Pipe or operator == TokenKind.Caret or operator == TokenKind.LShift or operator == TokenKind.RShift
                    if arithmetic:
                        safe: (known: bool, value: i64) = proof_small_nonnegative_constant_with_work(expression, 0, budget, exhausted)
                        return false if exhausted
                        closed: bool = proof_goal_closed_integer_arithmetic_with_work(expression, depth, budget, exhausted)
                        return false if exhausted
                        return not safe.known if closed
                    left_ambiguous: bool = proof_goal_has_ambiguous_integer_constant_with_work(left, depth + 1, budget, exhausted)
                    return false if exhausted
                    return true if left_ambiguous
                    return proof_goal_has_ambiguous_integer_constant_with_work(right, depth + 1, budget, exhausted)
                Ast::Expr.Call(callee, arguments, _, _):
                    callee_ambiguous: bool = proof_goal_has_ambiguous_integer_constant_with_work(callee, depth + 1, budget, exhausted)
                    return false if exhausted
                    return true if callee_ambiguous
                    for argument in arguments |depth, budget, exhausted|:
                        return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                        return true if proof_goal_has_ambiguous_integer_constant_with_work(argument, depth + 1, budget, exhausted)
                        return false if exhausted
                    return false
                Ast::Expr.Field(object, _, _) | Ast::Expr.Scope(object, _, _) | Ast::Expr.Move(object, _) | Ast::Expr.RegionNew(object, _, _):
                    return proof_goal_has_ambiguous_integer_constant_with_work(object, depth + 1, budget, exhausted)
                Ast::Expr.Index(object, index, _):
                    object_ambiguous: bool = proof_goal_has_ambiguous_integer_constant_with_work(object, depth + 1, budget, exhausted)
                    return false if exhausted
                    return true if object_ambiguous
                    return proof_goal_has_ambiguous_integer_constant_with_work(index, depth + 1, budget, exhausted)
                Ast::Expr.Slice(object, low, high, _):
                    object_ambiguous: bool = proof_goal_has_ambiguous_integer_constant_with_work(object, depth + 1, budget, exhausted)
                    return false if exhausted
                    return true if object_ambiguous
                    low_ambiguous: bool = proof_goal_has_ambiguous_integer_constant_with_work(low, depth + 1, budget, exhausted)
                    return false if exhausted
                    return true if low_ambiguous
                    return proof_goal_has_ambiguous_integer_constant_with_work(high, depth + 1, budget, exhausted)
                Ast::Expr.IndexN(object, arguments, _):
                    object_ambiguous: bool = proof_goal_has_ambiguous_integer_constant_with_work(object, depth + 1, budget, exhausted)
                    return false if exhausted
                    return true if object_ambiguous
                    for argument in arguments |depth, budget, exhausted|:
                        return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                        return true if proof_goal_has_ambiguous_integer_constant_with_work(argument, depth + 1, budget, exhausted)
                        return false if exhausted
                    return false
                Ast::Expr.StaticEffectCall(_, _, _, _, _, _):
                    return true
                Ast::Expr.Array(elements, _) | Ast::Expr.Tuple(elements, _) | Ast::Expr.SetLit(elements, _):
                    for element in elements |depth, budget, exhausted|:
                        return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                        return true if proof_goal_has_ambiguous_integer_constant_with_work(element, depth + 1, budget, exhausted)
                        return false if exhausted
                    return false
                Ast::Expr.DictLit(entries, _):
                    for entry in entries |depth, budget, exhausted|:
                        return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                        key_ambiguous: bool = proof_goal_has_ambiguous_integer_constant_with_work(entry.key, depth + 1, budget, exhausted)
                        return false if exhausted
                        return true if key_ambiguous
                        value_ambiguous: bool = proof_goal_has_ambiguous_integer_constant_with_work(entry.value, depth + 1, budget, exhausted)
                        return false if exhausted
                        return true if value_ambiguous
                    return false
                Ast::Expr.Construct(type_expression, fields, _):
                    type_ambiguous: bool = proof_goal_has_ambiguous_integer_constant_with_work(type_expression, depth + 1, budget, exhausted)
                    return false if exhausted
                    return true if type_ambiguous
                    for field in fields |depth, budget, exhausted|:
                        return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                        return true if proof_goal_has_ambiguous_integer_constant_with_work(field.value, depth + 1, budget, exhausted)
                        return false if exhausted
                    return false
                Ast::Expr.RecordUpdate(base, fields, _):
                    base_ambiguous: bool = proof_goal_has_ambiguous_integer_constant_with_work(base, depth + 1, budget, exhausted)
                    return false if exhausted
                    return true if base_ambiguous
                    for field in fields |depth, budget, exhausted|:
                        return false if not proof_linear_safety_work_charge(budget, exhausted, 1)
                        return true if proof_goal_has_ambiguous_integer_constant_with_work(field.value, depth + 1, budget, exhausted)
                        return false if exhausted
                    return false
                Ast::Expr.If(condition, then_expression, else_expression, _):
                    condition_ambiguous: bool = proof_goal_has_ambiguous_integer_constant_with_work(condition, depth + 1, budget, exhausted)
                    return false if exhausted
                    return true if condition_ambiguous
                    then_ambiguous: bool = proof_goal_has_ambiguous_integer_constant_with_work(then_expression, depth + 1, budget, exhausted)
                    return false if exhausted
                    return true if then_ambiguous
                    return proof_goal_has_ambiguous_integer_constant_with_work(else_expression, depth + 1, budget, exhausted)
                Ast::Expr.Comprehension(_, iterable, condition, body, _):
                    iterable_ambiguous: bool = proof_goal_has_ambiguous_integer_constant_with_work(iterable, depth + 1, budget, exhausted)
                    return false if exhausted
                    return true if iterable_ambiguous
                    condition_ambiguous: bool = proof_goal_has_ambiguous_integer_constant_with_work(condition, depth + 1, budget, exhausted)
                    return false if exhausted
                    return true if condition_ambiguous
                    return proof_goal_has_ambiguous_integer_constant_with_work(body, depth + 1, budget, exhausted)
                Ast::Expr.Refinement(base, predicate, _):
                    base_ambiguous: bool = proof_goal_has_ambiguous_integer_constant_with_work(base, depth + 1, budget, exhausted)
                    return false if exhausted
                    return true if base_ambiguous
                    return proof_goal_has_ambiguous_integer_constant_with_work(predicate, depth + 1, budget, exhausted)
                Ast::Expr.Match(_, _, _) | Ast::Expr.Catch(_, _, _) | Ast::Expr.GetElse(_, _, _) | Ast::Expr.Lambda(_, _, _) | Ast::Expr.Block(_, _, _, _):
                    return true
                _:
                    return true
            return true

        def proof_goal_ambiguous_constant_at_width_with_work(expression: Ast::Expr, facts: darray[Ast::Expr]&, markers: mutable ProofScalarWitnesses&, markers_ready: mutable bool&, marker_scale: mutable usize&, marker_scale_ready: mutable bool&, width: i64, depth: usize, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT:
                exhausted <- true
                return true
            closed: bool = proof_goal_closed_integer_arithmetic_with_work(expression, depth, budget, exhausted)
            return false if exhausted
            if closed:
                cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(expression, budget, exhausted)
                return false if not cost.complete or not proof_linear_safety_work_charge_scaled(budget, exhausted, cost.cost, 1)
                constant: (known: bool, value: i64) = proof_signed_constant_at_width(expression, width, 0)
                return false if constant.known
                return proof_goal_has_ambiguous_integer_constant_with_work(expression, depth, budget, exhausted)
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_goal_ambiguous_constant_at_width_with_work(inner, facts, markers, markers_ready, marker_scale, marker_scale_ready, width, depth + 1, budget, exhausted)
                Ast::Expr.Unary(operator, operand, _):
                    return proof_goal_ambiguous_constant_at_width_with_work(operand, facts, markers, markers_ready, marker_scale, marker_scale_ready, width, depth + 1, budget, exhausted) if operator == TokenKind.Minus or operator == TokenKind.Plus
                Ast::Expr.Binary(left, operator, right, _):
                    if operator == TokenKind.Plus or operator == TokenKind.Minus or operator == TokenKind.Star or operator == TokenKind.Slash or operator == TokenKind.Percent:
                        left_ambiguous: bool = proof_goal_ambiguous_constant_at_width_with_work(left, facts, markers, markers_ready, marker_scale, marker_scale_ready, width, depth + 1, budget, exhausted)
                        return true if exhausted or left_ambiguous
                        return proof_goal_ambiguous_constant_at_width_with_work(right, facts, markers, markers_ready, marker_scale, marker_scale_ready, width, depth + 1, budget, exhausted)
                Ast::Expr.If(condition, then_expression, else_expression, _):
                    condition_ambiguous: (complete: bool, ambiguous: bool) = proof_goal_ambiguous_integer_in_with_work(condition, facts, markers, markers_ready, marker_scale, marker_scale_ready, budget, exhausted, depth + 1)
                    exhausted <- true if not condition_ambiguous.complete
                    return true if exhausted or condition_ambiguous.ambiguous
                    left_ambiguous: bool = proof_goal_ambiguous_constant_at_width_with_work(then_expression, facts, markers, markers_ready, marker_scale, marker_scale_ready, width, depth + 1, budget, exhausted)
                    return true if exhausted or left_ambiguous
                    return proof_goal_ambiguous_constant_at_width_with_work(else_expression, facts, markers, markers_ready, marker_scale, marker_scale_ready, width, depth + 1, budget, exhausted)
                _:
                    pass
            return proof_goal_has_ambiguous_integer_constant_with_work(expression, depth, budget, exhausted)

        def proof_goal_ambiguous_integer_in_with_work(expression: Ast::Expr, facts: darray[Ast::Expr]&, markers: mutable ProofScalarWitnesses&, markers_ready: mutable bool&, marker_scale: mutable usize&, marker_scale_ready: mutable bool&, budget: mutable usize&, exhausted: mutable bool&, depth: usize) -> (complete: bool, ambiguous: bool):
            if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT:
                exhausted <- true
                return (false, false)
            uniform: bool = proof_closed_formula_width_uniform_with_work(expression, budget, exhausted)
            return (false, false) if exhausted
            return (true, false) if uniform
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_goal_ambiguous_integer_in_with_work(inner, facts, markers, markers_ready, marker_scale, marker_scale_ready, budget, exhausted, depth + 1)
                Ast::Expr.Unary(TokenKind.Not, operand, _):
                    return proof_goal_ambiguous_integer_in_with_work(operand, facts, markers, markers_ready, marker_scale, marker_scale_ready, budget, exhausted, depth + 1)
                Ast::Expr.Binary(left, operator, right, _):
                    if operator == TokenKind.And or operator == TokenKind.Or or operator == TokenKind.FatArrow:
                        left_result: (complete: bool, ambiguous: bool) = proof_goal_ambiguous_integer_in_with_work(left, facts, markers, markers_ready, marker_scale, marker_scale_ready, budget, exhausted, depth + 1)
                        return left_result if not left_result.complete or left_result.ambiguous
                        return proof_goal_ambiguous_integer_in_with_work(right, facts, markers, markers_ready, marker_scale, marker_scale_ready, budget, exhausted, depth + 1)
                    if proof_is_comparison(operator):
                        left_closed: bool = proof_goal_closed_integer_arithmetic_with_work(left, depth + 1, budget, exhausted)
                        return (false, false) if exhausted
                        right_closed: bool = proof_goal_closed_integer_arithmetic_with_work(right, depth + 1, budget, exhausted)
                        return (false, false) if exhausted
                        left_width: mutable i64 = 0
                        right_width: mutable i64 = 0
                        if not left_closed or not right_closed:
                            return (false, false) if not proof_goal_ambiguous_markers_with_work(facts, markers, markers_ready, marker_scale, marker_scale_ready, budget, exhausted)
                            left_width <- proof_goal_strict_signed_width_with_work(left, facts, markers, marker_scale, budget, exhausted, depth + 1) if not left_closed
                            return (false, false) if exhausted
                            right_width <- proof_goal_strict_signed_width_with_work(right, facts, markers, marker_scale, budget, exhausted, depth + 1) if not right_closed
                            return (false, false) if exhausted
                        typed: bool = (left_closed or left_width != 0) and (right_closed or right_width != 0) and not (left_closed and right_closed)
                        typed <- false if left_width != 0 and right_width != 0 and left_width != right_width
                        width: i64 = left_width if left_width != 0 else right_width
                        if typed:
                            left_ambiguous: bool = proof_goal_ambiguous_constant_at_width_with_work(left, facts, markers, markers_ready, marker_scale, marker_scale_ready, width, depth + 1, budget, exhausted)
                            return (false, false) if exhausted
                            return (true, true) if left_ambiguous
                            right_ambiguous: bool = proof_goal_ambiguous_constant_at_width_with_work(right, facts, markers, markers_ready, marker_scale, marker_scale_ready, width, depth + 1, budget, exhausted)
                            return (false, false) if exhausted
                            return (true, right_ambiguous)
                _:
                    pass
            fallback: bool = proof_goal_has_ambiguous_integer_constant_with_work(expression, depth, budget, exhausted)
            return (false, false) if exhausted
            return (true, fallback)

        # Fact projection compares each conjunction node with the whole goal, so reserve a
        # quadratic bound before calling the legacy structural matcher. Quantifier equality also
        # scans annotation rows and both expression shapes; reserve those repeated reads here.
        # A direct exact match uses proof_expr_equal, which quick-filters both terms, validates
        # both complete terms, and then compares them structurally. Charge five full expression
        # costs before entering that unmetered helper. Annotation scans are charged only when
        # both sides can be quantifiers.
        def proof_goal_explicit_fact_with_work(facts: darray[Ast::Expr]&, goal: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, budget: mutable usize&, exhausted: mutable bool&) -> bool:
            return false if facts.count == 0
            goal_cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(goal, budget, exhausted)
            return false if not goal_cost.complete
            goal_quantifier: bool = proof_goal_quantifier_candidate(goal, 0)
            annotations_ready: mutable bool = false
            annotation_cost: mutable usize = 0
            for fact in facts |fact, goal, annotations, goal_cost, goal_quantifier, annotation_cost, annotations_ready, budget, exhausted|:
                fact_cost: (complete: bool, cost: usize) = proof_linear_safety_expr_cost_with_work(fact, budget, exhausted)
                return false if not fact_cost.complete
                comparison_cost: usize = fact_cost.cost + goal_cost.cost
                return false if not proof_linear_safety_work_charge_scaled(budget, exhausted, comparison_cost, 5)
                return true if proof_expr_equal(fact, goal)
                if proof_goal_fact_projection_candidate(fact, 0):
                    return false if not proof_linear_safety_work_charge_scaled(budget, exhausted, comparison_cost, fact_cost.cost)
                    return true if proof_fact_contains(fact, goal)
                fact_quantifier: bool = proof_goal_quantifier_candidate(fact, 0)
                if goal_quantifier and fact_quantifier:
                    if not annotations_ready:
                        annotation_scan: (complete: bool, cost: usize) = proof_goal_annotation_cost_with_work(annotations, budget, exhausted)
                        return false if not annotation_scan.complete
                        annotation_cost <- annotation_scan.cost
                        annotations_ready <- true
                    return false if not proof_linear_safety_work_charge_scaled(budget, exhausted, comparison_cost, 3)
                    return false if not proof_linear_safety_work_charge_scaled(budget, exhausted, annotation_cost, 2)
                    return true if proof_quantifier_equal(fact, goal, annotations)
            return false
