# Bounded fact-list construction for the producer's disjunctive goal search.
extend ElisaProof:
    private:
        def proof_goal_relevant_disjunction_split_with_work(facts: darray[Ast::Expr]&, disjunction_index: usize, disjunction_left: Ast::Expr, disjunction_right: Ast::Expr, goal: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, operator_mask: usize, depth: usize, budget: mutable usize&, split_depth: usize, exhausted: mutable bool&) -> (complete: bool, handled: bool, proven: bool) can[Global{Read,Write}]:
            can Abort.Panic:
                return (false, false, false) if disjunction_index >= facts.count or split_depth >= PROOF_LINEAR_CASE_SPLIT_DEPTH_LIMIT
                return (false, false, false) if not proof_linear_safety_work_charge_scaled(budget, exhausted, facts.count, 2)
                left_facts: mutable darray[Ast::Expr] = []
                right_facts: mutable darray[Ast::Expr] = []
                for index in 0..<facts.count |index, facts, left_facts, right_facts, disjunction_index|:
                    return (false, false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                    if index != disjunction_index:
                        left_facts.push(facts[index])
                        right_facts.push(facts[index])
                # Modus ponens can discharge the split from a refuted alternative. Charge its
                # bounded side dispatch before inspecting either candidate.
                for side in 0..<(2 if split_depth == 0 else 0) |side, left_facts, disjunction_left, disjunction_right, goal, annotations, operator_mask, depth, budget, split_depth, exhausted|:
                    return (false, false, false) if not proof_linear_safety_work_charge(budget, exhausted, 1)
                    refuted: Ast::Expr = disjunction_left if side == 0 else disjunction_right
                    survivor: Ast::Expr = disjunction_right if side == 0 else disjunction_left
                    step: (refuted: bool, proven: bool) = (proof_disjunct_modus_ponens(left_facts, refuted, survivor, goal, annotations, operator_mask, depth, budget, split_depth, exhausted) can Global{Read,Write})
                    return (not proof_goal_bool_ref_value(exhausted), true, step.proven) if step.refuted
                return (false, false, false) if not proof_linear_safety_work_charge(budget, exhausted, 2)
                left_facts.push(disjunction_left)
                right_facts.push(disjunction_right)
                left_proven: bool = (proof_goal_depth(left_facts, goal, annotations, operator_mask, depth + 1, budget, split_depth + 1, exhausted) can Global{Read,Write})
                return (false, false, false) if proof_goal_bool_ref_value(exhausted)
                return (true, false, false) if not left_proven
                right_proven: bool = (proof_goal_depth(right_facts, goal, annotations, operator_mask, depth + 1, budget, split_depth + 1, exhausted) can Global{Read,Write})
                return (false, false, false) if proof_goal_bool_ref_value(exhausted)
                (true, false, right_proven)
