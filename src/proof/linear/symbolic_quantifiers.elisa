# Symbolic-range quantifiers (BACKLOG W-02). A `forall i in a..<b: P(i)` whose bounds are not
# constants cannot be enumerated, but it follows from seven sound rules:
#   empty   b <= a;
#   cover   a fact `forall j in c..<d: Q(j)` with Q alpha-equal to P, c <= a and b <= d;
#   extend  the same fact with c <= a, b <= d + 1 and P(d) -- the range grew by one element;
#   weaken  a fact over a covering range whose body Q, at a binder absent from every fact,
#           proves P there: `forall i in 0..<k: xs[i] <= m` with `m <= w` gives `... <= w`;
#   weaken and extend  weaken over c..<d, with b <= d + 1 and P(d);
#   lower   the same fact with c <= a + 1, b <= d and P(a) -- the range starts one earlier;
#   vacuous a body `(not g) or q` with g free of the binder and refuted by the facts.
# A fact `forall i in c..<d: Q(i)` also proves a non-quantified goal Q(t) for a subscript t
# of the goal with c <= t < d (the instance rule).
# Bodies are compared after both binders become one reserved marker, so a free variable of
# either body can never be confused with a binder. Every side condition is an ordinary goal,
# and the kernel replays the same rules (kernel_replay/symbolic_quantifiers.elisa).
const PROOF_SYMBOLIC_QUANTIFIER_MARKER: sview = "__elisa_symbolic_quantifier_binder"
const PROOF_SYMBOLIC_QUANTIFIER_MAX_FACTS: usize = 256
const PROOF_SYMBOLIC_INSTANCE_CANDIDATES: usize = 8
const PROOF_SYMBOLIC_RENAME_PAIRS: usize = 8
const PROOF_SYMBOLIC_ALIAS_CANDIDATES: usize = 4

extend ElisaProof:
    public:
        # Split `forall binder in lower..<upper: body` (RangeLt only).
        def proof_symbolic_range(expression: Ast::Expr) -> (known: bool, binder: sview, lower: Ast::Expr, upper: Ast::Expr, body: Ast::Expr):
            invalid: Ast::Expr = Ast::Expr.BoolLit(false, Ast::pos_at_line(0))
            match expression:
                Ast::Expr.Paren(inner, _):
                    return proof_symbolic_range(inner)
                Ast::Expr.Block(statements, body, _, _):
                    return (false, "", invalid, invalid, invalid) if statements.count != 1
                    match statements[0]:
                        Ast::Stmt.VarDecl(binder, _, range_expression, _):
                            match range_expression:
                                Ast::Expr.Binary(lower, range_operator, upper, _):
                                    return (true, binder, lower, upper, body) if range_operator == TokenKind.RangeLt
                                _:
                                    pass
                        _:
                            pass
                _:
                    pass
            return (false, "", invalid, invalid, invalid)

        def proof_symbolic_side_goal(facts: darray[Ast::Expr]&, goal: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, operator_mask: usize, depth: usize, budget: mutable usize&, split_depth: usize, exhausted: mutable bool&) -> bool:
            if budget >= PROOF_LINEAR_MAX_ENUMERATED_ELEMENTS:
                exhausted <- true
                return false
            budget <- budget + 1
            # A side goal opens no case splits: the quantifier rules issue many of them per
            # goal, and each split tier multiplies that count rather than adding to it.
            side_split_depth: usize = split_depth if split_depth >= PROOF_LINEAR_CASE_SPLIT_DEPTH_LIMIT else PROOF_LINEAR_CASE_SPLIT_DEPTH_LIMIT
            return proof_goal_depth(facts, goal, annotations, operator_mask, depth + 1, budget, side_split_depth, exhausted)

        def proof_symbolic_quantifier_goal(facts: darray[Ast::Expr]&, expression: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, operator_mask: usize, depth: usize, budget: mutable usize&, split_depth: usize, exhausted: mutable bool&) -> bool:
            return false if proof_quantifier_kind(expression, annotations) != "forall"
            goal: (known: bool, binder: sview, lower: Ast::Expr, upper: Ast::Expr, body: Ast::Expr) = proof_symbolic_range(expression)
            return false if not goal.known
            position: Ast::Pos = Ast::pos_at_line(0)
            empty: Ast::Expr = Ast::Expr.Binary(goal.upper, TokenKind.LtEq, goal.lower, position)
            return true if proof_symbolic_side_goal(facts, empty, annotations, operator_mask, depth, budget, split_depth, exhausted)
            refuted: (known: bool, goal: Ast::Expr) = proof_symbolic_refuted_guard(goal.body, goal.binder)
            return true if refuted.known and proof_symbolic_side_goal(facts, refuted.goal, annotations, operator_mask, depth, budget, split_depth, exhausted)
            marker: Ast::Expr = Ast::Expr.Ident(PROOF_SYMBOLIC_QUANTIFIER_MARKER, position)
            goal_names: darray[sview] = [goal.binder]
            marker_values: darray[Ast::Expr] = [marker]
            goal_marked: Ast::Expr = proof_substitute(goal.body, goal_names, marker_values)
            scanned: mutable usize = 0
            for fact in facts |fact, facts, goal, goal_marked, marker_values, annotations, operator_mask, depth, budget, split_depth, exhausted, scanned, position|:
                return false if scanned >= PROOF_SYMBOLIC_QUANTIFIER_MAX_FACTS
                scanned <- scanned + 1
                if proof_quantifier_kind(fact, annotations) == "forall":
                    known: (known: bool, binder: sview, lower: Ast::Expr, upper: Ast::Expr, body: Ast::Expr) = proof_symbolic_range(fact)
                    fact_names: darray[sview] = [known.binder]
                    fact_marked: Ast::Expr = proof_substitute(known.body, fact_names, marker_values)
                    if known.known and not proof_expr_equal(fact_marked, goal_marked):
                        return true if proof_symbolic_weakened(facts, fact_marked, goal_marked, known.lower, known.upper, goal.lower, goal.upper, annotations, operator_mask, depth, budget, split_depth, exhausted)
                        return true if proof_symbolic_weakened_grown(facts, fact_marked, goal_marked, known.lower, known.upper, goal.lower, goal.upper, goal.binder, goal.body, annotations, operator_mask, depth, budget, split_depth, exhausted)
                    if known.known and proof_expr_equal(fact_marked, goal_marked):
                        starts: Ast::Expr = Ast::Expr.Binary(known.lower, TokenKind.LtEq, goal.lower, position)
                        if proof_symbolic_side_goal(facts, starts, annotations, operator_mask, depth, budget, split_depth, exhausted):
                            covered: Ast::Expr = Ast::Expr.Binary(goal.upper, TokenKind.LtEq, known.upper, position)
                            return true if proof_symbolic_side_goal(facts, covered, annotations, operator_mask, depth, budget, split_depth, exhausted)
                            grown: Ast::Expr = Ast::Expr.Binary(goal.upper, TokenKind.LtEq, Ast::Expr.Binary(known.upper, TokenKind.Plus, Ast::Expr.IntLit(1, position), position), position)
                            if proof_symbolic_side_goal(facts, grown, annotations, operator_mask, depth, budget, split_depth, exhausted):
                                upper_values: darray[Ast::Expr] = [known.upper]
                                goal_binder: darray[sview] = [goal.binder]
                                return true if proof_symbolic_side_goal(facts, proof_substitute(goal.body, goal_binder, upper_values), annotations, operator_mask, depth, budget, split_depth, exhausted)
                        else:
                            return true if proof_symbolic_lowered(facts, known.lower, known.upper, goal.lower, goal.upper, goal.binder, goal.body, annotations, operator_mask, depth, budget, split_depth, exhausted)
            return false

        # The lower rule: the fact covers `a + 1..<b`, so the goal over `a..<b` needs only P(a).
        def proof_symbolic_lowered(facts: darray[Ast::Expr]&, fact_lower: Ast::Expr, fact_upper: Ast::Expr, goal_lower: Ast::Expr, goal_upper: Ast::Expr, goal_binder: sview, goal_body: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, operator_mask: usize, depth: usize, budget: mutable usize&, split_depth: usize, exhausted: mutable bool&) -> bool:
            position: Ast::Pos = Ast::pos_at_line(0)
            return false if not proof_symbolic_side_goal(facts, Ast::Expr.Binary(goal_upper, TokenKind.LtEq, fact_upper, position), annotations, operator_mask, depth, budget, split_depth, exhausted)
            next: Ast::Expr = Ast::Expr.Binary(goal_lower, TokenKind.Plus, Ast::Expr.IntLit(1, position), position)
            return false if not proof_symbolic_side_goal(facts, Ast::Expr.Binary(fact_lower, TokenKind.LtEq, next, position), annotations, operator_mask, depth, budget, split_depth, exhausted)
            binder: darray[sview] = [goal_binder]
            lower_values: darray[Ast::Expr] = [goal_lower]
            return proof_symbolic_side_goal(facts, proof_substitute(goal_body, binder, lower_values), annotations, operator_mask, depth, budget, split_depth, exhausted)

        # The vacuous rule: a body `(not g) or q` whose guard g is a comparison free of the binder
        # holds at every index once the facts prove g false, read as the flipped comparison.
        def proof_symbolic_refuted_guard(body: Ast::Expr, binder: sview) -> (known: bool, goal: Ast::Expr):
            match body:
                Ast::Expr.Paren(inner, _):
                    return proof_symbolic_refuted_guard(inner, binder)
                Ast::Expr.Binary(left, operator, _, _):
                    return (false, Ast::Expr.Invalid) if operator != TokenKind.Or
                    return proof_symbolic_negated_operand(left, binder)
                _:
                    return (false, Ast::Expr.Invalid)

        def proof_symbolic_negated_operand(operand: Ast::Expr, binder: sview) -> (known: bool, goal: Ast::Expr):
            match operand:
                Ast::Expr.Paren(inner, _):
                    return proof_symbolic_negated_operand(inner, binder)
                Ast::Expr.Unary(operator, inner, _):
                    return (false, Ast::Expr.Invalid) if operator != TokenKind.Not or proof_expr_mentions_name(inner, binder)
                    return proof_symbolic_flipped_comparison(inner)
                _:
                    return (false, Ast::Expr.Invalid)

        def proof_symbolic_flipped_comparison(guard: Ast::Expr) -> (known: bool, goal: Ast::Expr):
            match guard:
                Ast::Expr.Paren(inner, _):
                    return proof_symbolic_flipped_comparison(inner)
                Ast::Expr.Binary(left, operator, right, position):
                    return (true, Ast::Expr.Binary(right, TokenKind.LtEq, left, position)) if operator == TokenKind.Lt
                    return (true, Ast::Expr.Binary(right, TokenKind.Lt, left, position)) if operator == TokenKind.LtEq
                    return (true, Ast::Expr.Binary(left, TokenKind.LtEq, right, position)) if operator == TokenKind.Gt
                    return (true, Ast::Expr.Binary(left, TokenKind.Lt, right, position)) if operator == TokenKind.GtEq
                    return (false, Ast::Expr.Invalid)
                _:
                    return (false, Ast::Expr.Invalid)

        # The weaken rule: the fact's range covers the goal's and its body, at the marker, proves
        # the goal's body there. The marker must be absent from every fact, so it stands for an
        # arbitrary index of the range.
        def proof_symbolic_weakened(facts: darray[Ast::Expr]&, fact_marked: Ast::Expr, goal_marked: Ast::Expr, fact_lower: Ast::Expr, fact_upper: Ast::Expr, goal_lower: Ast::Expr, goal_upper: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, operator_mask: usize, depth: usize, budget: mutable usize&, split_depth: usize, exhausted: mutable bool&) -> bool:
            return false if any fact in facts where proof_expr_mentions_name(fact, PROOF_SYMBOLIC_QUANTIFIER_MARKER)
            position: Ast::Pos = Ast::pos_at_line(0)
            return false if not proof_symbolic_side_goal(facts, Ast::Expr.Binary(fact_lower, TokenKind.LtEq, goal_lower, position), annotations, operator_mask, depth, budget, split_depth, exhausted)
            return false if not proof_symbolic_side_goal(facts, Ast::Expr.Binary(goal_upper, TokenKind.LtEq, fact_upper, position), annotations, operator_mask, depth, budget, split_depth, exhausted)
            instance_facts: mutable darray[Ast::Expr] = proof_copy_exprs(facts)
            marker: Ast::Expr = Ast::Expr.Ident(PROOF_SYMBOLIC_QUANTIFIER_MARKER, position)
            proof_symbolic_type_marker(facts, goal_upper, marker, instance_facts)
            instance_facts.push(Ast::Expr.Binary(goal_lower, TokenKind.LtEq, marker, position))
            instance_facts.push(Ast::Expr.Binary(marker, TokenKind.Lt, goal_upper, position))
            instance_facts.push(fact_marked)
            return proof_symbolic_side_goal(instance_facts, goal_marked, annotations, operator_mask, depth, budget, split_depth, exhausted)

        # Extend and weaken at once: the fact covers `goal_lower..<d` with a body that, at the
        # marker, proves the goal's, the goal's range ends by `d + 1`, and P(d) holds. A swap step
        # of a bubble pass turns `forall i in 0..<k: xs[i] <= m0` into `... 0..<k + 1: xs[i] <= m`.
        def proof_symbolic_weakened_grown(facts: darray[Ast::Expr]&, fact_marked: Ast::Expr, goal_marked: Ast::Expr, fact_lower: Ast::Expr, fact_upper: Ast::Expr, goal_lower: Ast::Expr, goal_upper: Ast::Expr, goal_binder: sview, goal_body: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, operator_mask: usize, depth: usize, budget: mutable usize&, split_depth: usize, exhausted: mutable bool&) -> bool:
            position: Ast::Pos = Ast::pos_at_line(0)
            grown: Ast::Expr = Ast::Expr.Binary(goal_upper, TokenKind.LtEq, Ast::Expr.Binary(fact_upper, TokenKind.Plus, Ast::Expr.IntLit(1, position), position), position)
            return false if not proof_symbolic_side_goal(facts, grown, annotations, operator_mask, depth, budget, split_depth, exhausted)
            return false if not proof_symbolic_weakened(facts, fact_marked, goal_marked, fact_lower, fact_upper, goal_lower, fact_upper, annotations, operator_mask, depth, budget, split_depth, exhausted)
            goal_names: darray[sview] = [goal_binder]
            upper_values: darray[Ast::Expr] = [fact_upper]
            return proof_symbolic_side_goal(facts, proof_substitute(goal_body, goal_names, upper_values), annotations, operator_mask, depth, budget, split_depth, exhausted)

        # The marker lies in `lower..<upper`, so it has the upper bound's type: each type marker
        # over the upper bound is copied onto it, and without one the instance stays untyped.
        def proof_symbolic_type_marker(facts: darray[Ast::Expr]&, upper: Ast::Expr, marker: Ast::Expr, instance_facts: mutable darray[Ast::Expr]&) -> void:
            for fact in facts |fact, upper, marker, instance_facts|:
                match fact:
                    Ast::Expr.Call(Ast::Expr.Ident(callee, callee_position), arguments, argument_names, position):
                        continue if callee != "__elisa_unsigned_type_bound" and callee != "__elisa_signed_type_bound" and callee != "__elisa_primitive_scalar_type"
                        continue if arguments.count == 0 or not proof_expr_equal(arguments[0], upper)
                        typed: mutable darray[Ast::Expr] = proof_copy_exprs(arguments)
                        typed[0] <- marker
                        instance_facts.push(Ast::Expr.Call(Ast::Expr.Ident(callee, callee_position), typed, argument_names, position))
                    _:
                        continue

        # The instance rule: a fact `forall i in c..<d: B` proves B[t/i] for a subscript t of the
        # goal with `c <= t` and `t < d`. Only the goal's own subscripts are tried, at most
        # PROOF_SYMBOLIC_INSTANCE_CANDIDATES of them, against at most
        # PROOF_SYMBOLIC_QUANTIFIER_MAX_FACTS facts.
        def proof_symbolic_instance_goal(facts: darray[Ast::Expr]&, goal: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, operator_mask: usize, depth: usize, budget: mutable usize&, split_depth: usize, exhausted: mutable bool&) -> bool:
            return false if proof_quantifier_kind(goal, annotations) != ""
            candidates: mutable darray[Ast::Expr] = []
            proof_symbolic_subscripts(goal, &candidates, 0)
            position: Ast::Pos = Ast::pos_at_line(0)
            scanned: mutable usize = 0
            for fact in facts |fact, facts, goal, candidates, annotations, operator_mask, depth, budget, split_depth, exhausted, scanned, position|:
                return false if scanned >= PROOF_SYMBOLIC_QUANTIFIER_MAX_FACTS
                scanned <- scanned + 1
                continue if proof_quantifier_kind(fact, annotations) != "forall"
                known: (known: bool, binder: sview, lower: Ast::Expr, upper: Ast::Expr, body: Ast::Expr) = proof_symbolic_range(fact)
                continue if not known.known
                # A scalar body such as `i <= limit` supplies its trigger from the matching
                # goal shape (`n - 1 <= limit`). This selects one term from the goal; it never
                # enumerates the symbolic range. Replay reconstructs this same substitution and
                # checks both range bounds before admitting the instance.
                trigger: (matches: bool, found: bool, candidate: Ast::Expr) = proof_symbolic_trigger_match(known.body, known.binder, goal, 0)
                if trigger.matches and trigger.found:
                    trigger_values: darray[Ast::Expr] = [trigger.candidate]
                    trigger_names: darray[sview] = [known.binder]
                    trigger_instance: Ast::Expr = proof_substitute(known.body, trigger_names, trigger_values)
                    if proof_expr_equal(trigger_instance, goal):
                        trigger_start: Ast::Expr = Ast::Expr.Binary(known.lower, TokenKind.LtEq, trigger.candidate, position)
                        trigger_end: Ast::Expr = Ast::Expr.Binary(trigger.candidate, TokenKind.Lt, known.upper, position)
                        if proof_symbolic_side_goal(facts, trigger_start, annotations, operator_mask, depth, budget, split_depth, exhausted):
                            return true if proof_symbolic_side_goal(facts, trigger_end, annotations, operator_mask, depth, budget, split_depth, exhausted)
                names: darray[sview] = [known.binder]
                for candidate in candidates |candidate, names, known, facts, goal, annotations, operator_mask, depth, budget, split_depth, exhausted, position|:
                    values: darray[Ast::Expr] = [candidate]
                    continue if not proof_expr_equal(proof_substitute(known.body, names, values), goal)
                    starts: Ast::Expr = Ast::Expr.Binary(known.lower, TokenKind.LtEq, candidate, position)
                    continue if not proof_symbolic_side_goal(facts, starts, annotations, operator_mask, depth, budget, split_depth, exhausted)
                    return true if proof_symbolic_side_goal(facts, Ast::Expr.Binary(candidate, TokenKind.Lt, known.upper, position), annotations, operator_mask, depth, budget, split_depth, exhausted)
            return false

        # Match a bounded trigger pattern against the target. Only a binder occurrence may
        # vary; every other subtree and every operator must match exactly. Reject a candidate
        # containing the binder name because alpha-renaming is unavailable in this AST.
        def proof_symbolic_trigger_match(pattern: Ast::Expr, binder: sview, target: Ast::Expr, depth: usize) -> (matches: bool, found: bool, candidate: Ast::Expr):
            invalid: Ast::Expr = Ast::Expr.Invalid
            return (false, false, invalid) if depth >= PROOF_ANALYSIS_RECURSION_DEPTH_LIMIT
            match pattern:
                Ast::Expr.Ident(name, _):
                    if name == binder:
                        return (false, false, invalid) if proof_expr_is_invalid(target) or proof_expr_mentions_name(target, binder)
                        return (true, true, target)
                    return (proof_expr_equal(pattern, target), false, invalid)
                Ast::Expr.Paren(inner, _):
                    match target:
                        Ast::Expr.Paren(target_inner, _):
                            return proof_symbolic_trigger_match(inner, binder, target_inner, depth + 1)
                        _:
                            return (false, false, invalid)
                Ast::Expr.Unary(operator, operand, _):
                    match target:
                        Ast::Expr.Unary(target_operator, target_operand, _):
                            return (false, false, invalid) if operator != target_operator
                            return proof_symbolic_trigger_match(operand, binder, target_operand, depth + 1)
                        _:
                            return (false, false, invalid)
                Ast::Expr.Binary(left, operator, right, _):
                    match target:
                        Ast::Expr.Binary(target_left, target_operator, target_right, _):
                            return (false, false, invalid) if operator != target_operator
                            matched_left: (matches: bool, found: bool, candidate: Ast::Expr) = proof_symbolic_trigger_match(left, binder, target_left, depth + 1)
                            return (false, false, invalid) if not matched_left.matches
                            matched_right: (matches: bool, found: bool, candidate: Ast::Expr) = proof_symbolic_trigger_match(right, binder, target_right, depth + 1)
                            return (false, false, invalid) if not matched_right.matches
                            return (false, false, invalid) if matched_left.found and matched_right.found and not proof_expr_equal(matched_left.candidate, matched_right.candidate)
                            return matched_left if matched_left.found
                            return matched_right if matched_right.found
                            return (true, false, invalid)
                        _:
                            return (false, false, invalid)
                _:
                    return (proof_expr_equal(pattern, target), false, invalid)

        def proof_symbolic_subscripts(expression: Ast::Expr, candidates: mutable darray[Ast::Expr]&, depth: usize) -> void:
            return if depth > 16 or candidates.count >= PROOF_SYMBOLIC_INSTANCE_CANDIDATES
            match expression:
                Ast::Expr.Paren(inner, _):
                    proof_symbolic_subscripts(inner, candidates, depth + 1)
                Ast::Expr.Unary(_, operand, _):
                    proof_symbolic_subscripts(operand, candidates, depth + 1)
                Ast::Expr.Binary(left, _, right, _):
                    proof_symbolic_subscripts(left, candidates, depth + 1)
                    proof_symbolic_subscripts(right, candidates, depth + 1)
                Ast::Expr.Index(_, index, _):
                    candidates.push(index) if not (any existing in candidates where proof_expr_equal(existing, index))
                _:
                    return

        # The subscript rule: reading one container is a function of the subscript, so a goal over
        # `xs[e]` with `e == f` provable holds iff it holds with every `e` read as `f`. Only a
        # subscript of the goal that no fact subscripts is replaced, by a subscript of some fact,
        # so the rewrite never runs back; at most PROOF_SYMBOLIC_RENAME_PAIRS pairs are tried.
        def proof_symbolic_renamed_goal(facts: darray[Ast::Expr]&, goal: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, operator_mask: usize, depth: usize, budget: mutable usize&, split_depth: usize, exhausted: mutable bool&) -> bool:
            return false if proof_quantifier_kind(goal, annotations) != ""
            goal_subscripts: mutable darray[Ast::Expr] = []
            proof_symbolic_subscripts(goal, &goal_subscripts, 0)
            return false if goal_subscripts.count == 0
            fact_subscripts: mutable darray[Ast::Expr] = []
            scanned: mutable usize = 0
            for fact in facts |fact, annotations, fact_subscripts, scanned|:
                break if scanned >= PROOF_SYMBOLIC_QUANTIFIER_MAX_FACTS or fact_subscripts.count >= PROOF_SYMBOLIC_INSTANCE_CANDIDATES
                scanned <- scanned + 1
                continue if proof_quantifier_kind(fact, annotations) != ""
                proof_symbolic_subscripts(fact, &fact_subscripts, 0)
            position: Ast::Pos = Ast::pos_at_line(0)
            tried: mutable usize = 0
            for source in goal_subscripts |source, fact_subscripts, facts, goal, annotations, operator_mask, depth, budget, split_depth, exhausted, position, tried|:
                continue if any existing in fact_subscripts where proof_expr_equal(existing, source)
                # Both sides must be witnessed scalars: `==` on anything else may be a user `__eq__`.
                continue if not proof_scalar_term_witnessed(source, facts, 0)
                for target in fact_subscripts |target, source, facts, goal, annotations, operator_mask, depth, budget, split_depth, exhausted, position, tried|:
                    return false if tried >= PROOF_SYMBOLIC_RENAME_PAIRS
                    tried <- tried + 1
                    continue if not proof_scalar_term_witnessed(target, facts, 0)
                    continue if not proof_symbolic_side_goal(facts, Ast::Expr.Binary(source, TokenKind.EqEq, target, position), annotations, operator_mask, depth, budget, split_depth, exhausted)
                    replaced: (changed: bool, value: Ast::Expr) = proof_symbolic_replace(goal, source, target, 0)
                    return true if replaced.changed and proof_symbolic_side_goal(facts, replaced.value, annotations, operator_mask, depth, budget, split_depth, exhausted)
            return false

        def proof_symbolic_replace(expression: Ast::Expr, source: Ast::Expr, target: Ast::Expr, depth: usize) -> (changed: bool, value: Ast::Expr):
            return (false, expression) if depth > 16
            return (true, target) if proof_expr_equal(expression, source)
            match expression:
                Ast::Expr.Paren(inner, position):
                    replaced: (changed: bool, value: Ast::Expr) = proof_symbolic_replace(inner, source, target, depth + 1)
                    return (replaced.changed, Ast::Expr.Paren(replaced.value, position))
                Ast::Expr.Unary(operator, operand, position):
                    replaced: (changed: bool, value: Ast::Expr) = proof_symbolic_replace(operand, source, target, depth + 1)
                    return (replaced.changed, Ast::Expr.Unary(operator, replaced.value, position))
                Ast::Expr.Binary(left, operator, right, position):
                    left_replaced: (changed: bool, value: Ast::Expr) = proof_symbolic_replace(left, source, target, depth + 1)
                    right_replaced: (changed: bool, value: Ast::Expr) = proof_symbolic_replace(right, source, target, depth + 1)
                    return (left_replaced.changed or right_replaced.changed, Ast::Expr.Binary(left_replaced.value, operator, right_replaced.value, position))
                Ast::Expr.Index(object, index, position):
                    object_replaced: (changed: bool, value: Ast::Expr) = proof_symbolic_replace(object, source, target, depth + 1)
                    index_replaced: (changed: bool, value: Ast::Expr) = proof_symbolic_replace(index, source, target, depth + 1)
                    return (object_replaced.changed or index_replaced.changed, Ast::Expr.Index(object_replaced.value, index_replaced.value, position))
                _:
                    return (false, expression)

        # The alias instance rule: a fact `t == xs[e]` (t a witnessed scalar name) lets the goal
        # be read with `t` unfolded to the cell, `p <= t` as `p <= xs[e]`, which the instance rule
        # can then take at e. At most PROOF_SYMBOLIC_ALIAS_CANDIDATES aliases are tried.
        def proof_symbolic_alias_instance_goal(facts: darray[Ast::Expr]&, goal: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, operator_mask: usize, depth: usize, budget: mutable usize&, split_depth: usize, exhausted: mutable bool&) -> bool:
            return false if proof_quantifier_kind(goal, annotations) != ""
            return false if not (any fact in facts where proof_quantifier_kind(fact, annotations) == "forall")
            tried: mutable usize = 0
            scanned: mutable usize = 0
            for fact in facts |fact, facts, goal, annotations, operator_mask, depth, budget, split_depth, exhausted, tried, scanned|:
                return false if scanned >= PROOF_SYMBOLIC_QUANTIFIER_MAX_FACTS or tried >= PROOF_SYMBOLIC_ALIAS_CANDIDATES
                scanned <- scanned + 1
                alias: (known: bool, name: Ast::Expr, cell: Ast::Expr) = proof_symbolic_cell_alias(fact)
                continue if not alias.known
                unfolded: (changed: bool, value: Ast::Expr) = proof_symbolic_replace(goal, alias.name, alias.cell, 0)
                continue if not unfolded.changed
                tried <- tried + 1
                continue if not proof_scalar_term_witnessed(alias.name, facts, 0)
                return true if proof_symbolic_instance_goal(facts, unfolded.value, annotations, operator_mask, depth, budget, split_depth, exhausted)
            return false

        def proof_symbolic_cell_alias(fact: Ast::Expr) -> (known: bool, name: Ast::Expr, cell: Ast::Expr):
            match fact:
                Ast::Expr.Binary(left, TokenKind.EqEq, right, _):
                    match left:
                        Ast::Expr.Ident(_, _):
                            match right:
                                Ast::Expr.Index(_, _, _):
                                    return (true, left, right)
                                _:
                                    pass
                        Ast::Expr.Index(_, _, _):
                            match right:
                                Ast::Expr.Ident(_, _):
                                    return (true, right, left)
                                _:
                                    pass
                        _:
                            pass
                _:
                    pass
            return (false, Ast::Expr.Invalid, Ast::Expr.Invalid)
