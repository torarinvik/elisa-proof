extend ElisaProof:
    private:
        def proof_tactic_prepare(state: mutable ProofTacticState&, argument: Ast::Expr, secondary: Ast::Expr, argument_index: usize, has_argument_index: bool, has_secondary: bool) -> void:
            state.pending_argument <- argument
            state.pending_secondary <- secondary
            state.pending_has_argument <- true
            state.pending_has_secondary <- has_secondary
            state.pending_argument_index <- argument_index
            state.pending_has_argument_index <- has_argument_index
            state.pending_detail <- ""

        # Source-bound rewrites inspect the source operator index while walking terms. Keep
        # these scans inside the state's source-work ledger; exhaustion must refuse the action.
        def proof_tactic_state_overloaded_operator_with_work(state: mutable ProofTacticState&, expression: Ast::Expr, operator_mask: usize) -> (complete: bool, overloaded: bool):
            return (false, false) if state.source_quota > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT or state.source_work_used > state.source_quota
            remaining: usize = state.source_quota - state.source_work_used
            allowance: usize = PROOF_LINEAR_SAFETY_WORK_LIMIT if remaining > PROOF_LINEAR_SAFETY_WORK_LIMIT else remaining
            if allowance == 0:
                state.source_work_used <- state.source_quota
                return (false, false)
            start: usize = PROOF_LINEAR_SAFETY_WORK_LIMIT - allowance
            work: mutable usize = start
            exhausted: mutable bool = false
            overloaded: bool = proof_source_expression_has_overloaded_operator_with_work(expression, operator_mask, &work, &exhausted)
            if work < start or work > PROOF_LINEAR_SAFETY_WORK_LIMIT or exhausted:
                state.source_work_used <- state.source_quota
                return (false, false)
            spent: usize = work - start
            return (false, false) if spent > remaining
            state.source_work_used <- state.source_work_used + spent
            return (true, overloaded)

        # `proof_quantifier_equal` may scan the complete annotation list twice per candidate.
        # Charge the one-pass reservation itself, then reserve every possible candidate scan
        # before an assumption/apply loop starts. This keeps work bounded even when the goal is
        # not a quantifier and the checks all return false.
        def proof_tactic_state_quantifier_annotation_work(state: mutable ProofTacticState&, annotations: darray[Ast::EnumAnnotation]&, candidate_count: usize) -> bool:
            annotation_work: mutable usize = 0
            for annotation in annotations |annotation, state, annotation_work|:
                owner_length: usize = sview_len(annotation.owner)
                name_length: usize = sview_len(annotation.name)
                if owner_length >= PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT:
                    state.source_work_used <- state.source_quota
                    return false
                row_work: usize = owner_length + 1
                if name_length > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - row_work:
                    state.source_work_used <- state.source_quota
                    return false
                row_work <- row_work + name_length
                if annotation_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT - row_work:
                    state.source_work_used <- state.source_quota
                    return false
                annotation_work <- annotation_work + row_work
                return false if not proof_tactic_state_charge_source_work(state, row_work)
            return true if candidate_count == 0 or annotation_work == 0
            if candidate_count > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / 2:
                state.source_work_used <- state.source_quota
                return false
            repetitions: usize = candidate_count * 2
            if annotation_work > PROOF_REPLAY_SUMMARY_SOURCE_WORK_LIMIT / repetitions:
                state.source_work_used <- state.source_quota
                return false
            return proof_tactic_state_charge_source_work(state, annotation_work * repetitions)

    public:
        def proof_tactic_assumption(state: mutable ProofTacticState&, annotations: darray[Ast::EnumAnnotation]&) -> bool:
            return false if not proof_tactic_state_action_available(state)
            return proof_tactic_record(state, "assumption", false, "a solved goal cannot accept another action") if state.solved
            return proof_tactic_record(state, "assumption", false, "quantifier annotation checks exhausted the source-work budget") if not proof_tactic_state_quantifier_annotation_work(state, annotations, state.facts.count)
            return proof_tactic_record(state, "assumption", false, "expression comparisons exhausted the source-work budget") if not proof_tactic_state_quantifier_match_work(state, 0, false, false)
            matched: mutable bool = false
            for fact in state.facts |fact, state, annotations, matched|:
                if proof_expr_equal(fact, state.goal) or proof_quantifier_equal(fact, state.goal, annotations):
                    matched <- true
                    break
            # End the facts iteration before mutably borrowing its owner to record
            # the action. Recording may grow arrays within the same state object.
            if matched:
                state.solved <- true
                return proof_tactic_record(state, "assumption", true, "the goal is an explicit hypothesis")
            return proof_tactic_record(state, "assumption", false, "the goal is not an explicit hypothesis")

        # `exact` and `decide` are deliberately backed by the same bounded, overflow-aware
        # prover used by the source checker. This is a tactic API, not a second acceptance
        # path, so a successful state still has the same proof fragment and limits.
        def proof_tactic_decision(state: mutable ProofTacticState&, annotations: darray[Ast::EnumAnnotation]&, action: sview) -> bool can[Global.Read, Global.Write]:
            return false if not proof_tactic_state_action_available(state)
            return proof_tactic_record(state, action, false, "a solved goal cannot accept another action") if state.solved
            solver_work: mutable usize = 0
            preflight_work: mutable usize = 0
            proven: bool = (proof_tactic_state_goal_with_work(state, state.goal, annotations, 0, &solver_work, &preflight_work) can Global{Read,Write})
            if proven:
                state.solved <- true
                return proof_tactic_record(state, action, true, "the existing proof kernel entailed the goal")
            return proof_tactic_record(state, action, false, "the existing proof kernel could not entail the goal")

        def proof_tactic_decision_with_shared_work(state: mutable ProofTacticState&, annotations: darray[Ast::EnumAnnotation]&, action: sview, operator_mask: usize, solver_work: mutable usize&, preflight_work: mutable usize&) -> bool can[Global.Read, Global.Write]:
            return false if not proof_tactic_state_action_available(state)
            return proof_tactic_record(state, action, false, "a solved goal cannot accept another action") if state.solved
            proven: bool = (proof_tactic_state_goal_with_work(state, state.goal, annotations, operator_mask, &solver_work, &preflight_work) can Global{Read,Write})
            if proven:
                state.solved <- true
                return proof_tactic_record(state, action, true, "the existing proof kernel entailed the goal")
            return proof_tactic_record(state, action, false, "the existing proof kernel could not entail the goal")

        def proof_tactic_exact(state: mutable ProofTacticState&, annotations: darray[Ast::EnumAnnotation]&) -> bool:
            return (proof_tactic_decision(state, annotations, "exact") can Global{Read,Write})

        def proof_tactic_decide(state: mutable ProofTacticState&, annotations: darray[Ast::EnumAnnotation]&) -> bool:
            return (proof_tactic_decision(state, annotations, "decide") can Global{Read,Write})

        # The imported tactic term has no integer width/signedness metadata. Constant arithmetic
        # folds only when every intermediate fits even the narrowest signed integer type.
        def proof_tactic_simplify_expression_mode(expression: Ast::Expr, source_bound: bool) -> (changed: bool, value: Ast::Expr):
            match expression:
                Ast::Expr.Paren(inner, position):
                    rewritten: (changed: bool, value: Ast::Expr) = proof_tactic_simplify_expression_mode(inner, source_bound)
                    return (true, Ast::Expr.Paren(rewritten.value, position)) if rewritten.changed
                    return (false, expression)
                Ast::Expr.Unary(operator, operand, position):
                    rewritten: (changed: bool, value: Ast::Expr) = proof_tactic_simplify_expression_mode(operand, source_bound)
                    if operator == TokenKind.Not:
                        match rewritten.value:
                            Ast::Expr.BoolLit(value, _):
                                return (true, Ast::Expr.BoolLit(not value, Ast::pos_at_line(0)))
                            Ast::Expr.Unary(TokenKind.Not, inner, _):
                                return (true, inner)
                            _:
                                pass
                    candidate: Ast::Expr = Ast::Expr.Unary(operator, rewritten.value, position)
                    if not source_bound and (operator == TokenKind.Plus or operator == TokenKind.Minus):
                        constant: (known: bool, value: i64) = proof_small_nonnegative_constant(candidate)
                        return (true, Ast::Expr.IntLit(constant.value, Ast::pos_at_line(0))) if constant.known
                    return (rewritten.changed, candidate)
                Ast::Expr.Binary(left, operator, right, position):
                    rewritten_left: (changed: bool, value: Ast::Expr) = proof_tactic_simplify_expression_mode(left, source_bound)
                    rewritten_right: (changed: bool, value: Ast::Expr) = proof_tactic_simplify_expression_mode(right, source_bound)
                    candidate: Ast::Expr = Ast::Expr.Binary(rewritten_left.value, operator, rewritten_right.value, position)
                    if not source_bound and proof_is_comparison(operator):
                        left_constant: (known: bool, value: i64) = proof_safe_comparison_constant(rewritten_left.value)
                        right_constant: (known: bool, value: i64) = proof_safe_comparison_constant(rewritten_right.value)
                        if left_constant.known and right_constant.known:
                            result: mutable bool = false
                            result <- left_constant.value == right_constant.value if operator == TokenKind.EqEq
                            result <- left_constant.value != right_constant.value if operator == TokenKind.BangEq
                            result <- left_constant.value < right_constant.value if operator == TokenKind.Lt
                            result <- left_constant.value <= right_constant.value if operator == TokenKind.LtEq
                            result <- left_constant.value > right_constant.value if operator == TokenKind.Gt
                            result <- left_constant.value >= right_constant.value if operator == TokenKind.GtEq
                            return (true, Ast::Expr.BoolLit(result, Ast::pos_at_line(0)))
                        match rewritten_left.value:
                            Ast::Expr.BoolLit(left_bool, _):
                                match rewritten_right.value:
                                    Ast::Expr.BoolLit(right_bool, _):
                                        return (true, Ast::Expr.BoolLit(left_bool == right_bool, Ast::pos_at_line(0))) if operator == TokenKind.EqEq
                                        return (true, Ast::Expr.BoolLit(left_bool != right_bool, Ast::pos_at_line(0))) if operator == TokenKind.BangEq
                                    _:
                                        pass
                            _:
                                pass
                    if operator == TokenKind.And or operator == TokenKind.Or or operator == TokenKind.FatArrow:
                        match rewritten_left.value:
                            Ast::Expr.BoolLit(left_bool, _):
                                match rewritten_right.value:
                                    Ast::Expr.BoolLit(right_bool, _):
                                        result: mutable bool = false
                                        result <- left_bool and right_bool if operator == TokenKind.And
                                        result <- left_bool or right_bool if operator == TokenKind.Or
                                        result <- (not left_bool) or right_bool if operator == TokenKind.FatArrow
                                        return (true, Ast::Expr.BoolLit(result, Ast::pos_at_line(0)))
                                    _:
                                        pass
                            _:
                                pass
                    constant: (known: bool, value: i64) = proof_small_nonnegative_constant(candidate) if not source_bound else (false, 0)
                    if not source_bound and constant.known:
                        return (true, Ast::Expr.IntLit(constant.value, Ast::pos_at_line(0))) if operator == TokenKind.Plus or operator == TokenKind.Minus or operator == TokenKind.Star or operator == TokenKind.Slash or operator == TokenKind.Percent or operator == TokenKind.Ampersand or operator == TokenKind.Pipe or operator == TokenKind.Caret or operator == TokenKind.LShift or operator == TokenKind.RShift
                    return (rewritten_left.changed or rewritten_right.changed, candidate)
                _:
                    return (false, expression)

        def proof_tactic_simplify_expression(expression: Ast::Expr) -> (changed: bool, value: Ast::Expr):
            return proof_tactic_simplify_expression_mode(expression, false)

        # Simplification is a state transformation, not an unchecked proof shortcut. It may
        # close the resulting goal only through the same bounded kernel used by `exact`; if no
        # supported rewrite exists, the original goal and solved bit remain unchanged.
        def proof_tactic_simplify(state: mutable ProofTacticState&, annotations: darray[Ast::EnumAnnotation]&) -> bool can[Global.Read, Global.Write]:
            return false if not proof_tactic_state_action_available(state)
            return proof_tactic_record(state, "simp", false, "a solved goal cannot accept another action") if state.solved
            rewritten: (changed: bool, value: Ast::Expr) = proof_tactic_simplify_expression(state.goal)
            return proof_tactic_record(state, "simp", false, "the goal has no supported safe simplification") if not rewritten.changed
            state.goal <- rewritten.value
            solver_work: mutable usize = 0
            preflight_work: mutable usize = 0
            if (proof_tactic_state_goal_with_work(state, state.goal, annotations, 0, &solver_work, &preflight_work) can Global{Read,Write}):
                state.solved <- true
                return proof_tactic_record(state, "simp", true, "the goal was simplified and discharged by the existing proof kernel")
            return proof_tactic_record(state, "simp", true, "the goal was simplified; it remains to be discharged")

        def proof_tactic_simplify_with_shared_work(state: mutable ProofTacticState&, annotations: darray[Ast::EnumAnnotation]&, operator_mask: usize, solver_work: mutable usize&, preflight_work: mutable usize&) -> bool can[Global.Read, Global.Write]:
            return false if not proof_tactic_state_action_available(state)
            return proof_tactic_record(state, "simp", false, "a solved goal cannot accept another action") if state.solved
            rewritten: (changed: bool, value: Ast::Expr) = proof_tactic_simplify_expression(state.goal)
            return proof_tactic_record(state, "simp", false, "the goal has no supported safe simplification") if not rewritten.changed
            state.goal <- rewritten.value
            if (proof_tactic_state_goal_with_work(state, state.goal, annotations, operator_mask, &solver_work, &preflight_work) can Global{Read,Write}):
                state.solved <- true
                return proof_tactic_record(state, "simp", true, "the goal was simplified and discharged by the existing proof kernel")
            return proof_tactic_record(state, "simp", true, "the goal was simplified; it remains to be discharged")

        # Source-bound simplification may normalize proposition constructors, but it must not
        # evaluate value-level operators. Elisa permits source implementations of primitive
        # protocols, while this tactic's constant folder has only built-in semantics.
        def proof_tactic_simplify_source_bound(state: mutable ProofTacticState&, annotations: darray[Ast::EnumAnnotation]&) -> bool can[Global.Read, Global.Write]:
            return false if not proof_tactic_state_action_available(state)
            return proof_tactic_record(state, "simp", false, "a solved goal cannot accept another action") if state.solved
            source_operator_mask: (complete: bool, mask: usize) = proof_tactic_state_operator_mask(state, annotations)
            return proof_tactic_record(state, "simp", false, "source-bound simplification could not validate the primitive operator index") if not source_operator_mask.complete
            rewritten: (changed: bool, value: Ast::Expr) = proof_tactic_simplify_expression_mode(state.goal, true)
            return proof_tactic_record(state, "simp", false, "source-bound simplification does not evaluate value-level operators") if not rewritten.changed
            state.goal <- rewritten.value
            solver_work: mutable usize = 0
            preflight_work: mutable usize = 0
            if (proof_tactic_state_goal_with_work(state, state.goal, annotations, source_operator_mask.mask, &solver_work, &preflight_work) can Global{Read,Write}):
                state.solved <- true
                return proof_tactic_record(state, "simp", true, "the source-safe logical simplification discharged the goal")
            return proof_tactic_record(state, "simp", true, "the source-safe logical simplification changed the goal")

        def proof_tactic_simplify_source_bound_with_shared_work(state: mutable ProofTacticState&, annotations: darray[Ast::EnumAnnotation]&, operator_mask: usize, solver_work: mutable usize&, preflight_work: mutable usize&) -> bool can[Global.Read, Global.Write]:
            return false if not proof_tactic_state_action_available(state)
            return proof_tactic_record(state, "simp", false, "a solved goal cannot accept another action") if state.solved
            rewritten: (changed: bool, value: Ast::Expr) = proof_tactic_simplify_expression_mode(state.goal, true)
            return proof_tactic_record(state, "simp", false, "source-bound simplification does not evaluate value-level operators") if not rewritten.changed
            state.goal <- rewritten.value
            if (proof_tactic_state_goal_with_work(state, state.goal, annotations, operator_mask, &solver_work, &preflight_work) can Global{Read,Write}):
                state.solved <- true
                return proof_tactic_record(state, "simp", true, "the source-safe logical simplification discharged the goal")
            return proof_tactic_record(state, "simp", true, "the source-safe logical simplification changed the goal")

        # Implication introduction is a structural proof rule. It only changes the state when
        # the goal is syntactically an implication; no arbitrary expression is promoted to a
        # hypothesis.
        def proof_tactic_intro(state: mutable ProofTacticState&) -> bool:
            return false if not proof_tactic_state_action_available_with_growth(state, 1)
            return proof_tactic_record(state, "intro", false, "a solved goal cannot accept another action") if state.solved
            match state.goal:
                Ast::Expr.Binary(antecedent, TokenKind.FatArrow, consequent, _):
                    return false if not proof_tactic_state_snapshot_reserve(state, state.facts.count + 1)
                    state.facts.push(antecedent)
                    state.goal <- consequent
                    return proof_tactic_record(state, "intro", true, "introduced the implication antecedent as a hypothesis")
                _:
                    return proof_tactic_record(state, "intro", false, "the goal is not an implication")

        # Apply an explicit implication in the context backwards. This is the useful
        # interactive counterpart to `intro`: a fact A => B changes a goal B into A, but only
        # when B is the current goal. It never treats an arbitrary caller-supplied implication
        # as an axiom and leaves the state untouched when no matching theorem is present.
        def proof_tactic_apply(state: mutable ProofTacticState&, annotations: darray[Ast::EnumAnnotation]&) -> bool:
            return false if not proof_tactic_state_action_available(state)
            return proof_tactic_record(state, "apply", false, "a solved goal cannot accept another action") if state.solved
            return proof_tactic_record(state, "apply", false, "quantifier annotation checks exhausted the source-work budget") if not proof_tactic_state_quantifier_annotation_work(state, annotations, state.facts.count)
            return proof_tactic_record(state, "apply", false, "expression comparisons exhausted the source-work budget") if not proof_tactic_state_quantifier_match_work(state, 0, false, true)
            found: mutable bool = false
            premise: mutable Ast::Expr = Ast::Expr.Absent
            for fact in state.facts |fact, state, annotations, found, premise|:
                match fact:
                    Ast::Expr.Binary(antecedent, TokenKind.FatArrow, consequent, _):
                        if not proof_expr_has_call(fact) and not proof_expr_has_move(fact) and (proof_expr_equal(consequent, state.goal) or proof_quantifier_equal(consequent, state.goal, annotations)):
                            found <- true
                            premise <- antecedent
                            break
                    Ast::Expr.Paren(inner, _):
                        match inner:
                            Ast::Expr.Binary(antecedent, TokenKind.FatArrow, consequent, _):
                                if not proof_expr_has_call(inner) and not proof_expr_has_move(inner) and (proof_expr_equal(consequent, state.goal) or proof_quantifier_equal(consequent, state.goal, annotations)):
                                    found <- true
                                    premise <- antecedent
                                    break
                            _:
                                pass
                    _:
                        pass
            return proof_tactic_record(state, "apply", false, "no explicit implication concludes the current goal") if not found
            state.goal <- premise
            return proof_tactic_record(state, "apply", true, "reduced the goal using an explicit implication hypothesis")

        # The indexed form makes the selected implication part of the action trace. It is useful
        # when more than one hypothesis concludes the current goal: callers can try each bounded
        # candidate without relying on context order or silently skipping a later usable premise.
        def proof_tactic_apply_from_fact(state: mutable ProofTacticState&, fact_index: usize, annotations: darray[Ast::EnumAnnotation]&) -> bool:
            return false if not proof_tactic_state_action_available(state)
            state.pending_argument <- Ast::Expr.Absent
            state.pending_secondary <- Ast::Expr.Absent
            state.pending_has_argument <- false
            state.pending_has_secondary <- false
            state.pending_argument_index <- fact_index
            state.pending_has_argument_index <- true
            state.pending_detail <- ""
            return proof_tactic_record(state, "apply", false, "a solved goal cannot accept another action") if state.solved
            return proof_tactic_record(state, "apply", false, "the implication fact index is out of range") if fact_index >= state.facts.count
            return proof_tactic_record(state, "apply", false, "quantifier annotation checks exhausted the source-work budget") if not proof_tactic_state_quantifier_annotation_work(state, annotations, 1)
            return proof_tactic_record(state, "apply", false, "expression comparisons exhausted the source-work budget") if not proof_tactic_state_quantifier_match_work(state, fact_index, true, true)
            selected_fact: Ast::Expr = state.facts[fact_index]
            return proof_tactic_record(state, "apply", false, "effectful implications cannot be applied") if proof_expr_has_call(selected_fact) or proof_expr_has_move(selected_fact)
            implication: Ast::Expr = proof_strip_parens(selected_fact)
            match implication:
                Ast::Expr.Binary(antecedent, TokenKind.FatArrow, consequent, _):
                    return proof_tactic_record(state, "apply", false, "the selected implication does not conclude the current goal") if not (proof_expr_equal(consequent, state.goal) or proof_quantifier_equal(consequent, state.goal, annotations))
                    state.goal <- antecedent
                    return proof_tactic_record(state, "apply", true, "reduced the goal using the selected implication hypothesis")
                _:
                    return proof_tactic_record(state, "apply", false, "the selected fact is not an implication")

        def proof_tactic_collection_instance(body: Ast::Expr, binder: sview, value: Ast::Expr, elements: darray[Ast::Expr]&) -> (known: bool, instance: Ast::Expr):
            return (false, Ast::Expr.Invalid) if proof_expr_has_call(body) or proof_expr_has_move(body) or proof_expr_has_call(value) or proof_expr_has_move(value)
            for element in elements:
                return (false, Ast::Expr.Invalid) if proof_expr_has_call(element) or proof_expr_has_move(element)
                if proof_expr_equal(value, element):
                    binder_names: mutable darray[sview] = [binder]
                    binder_values: mutable darray[Ast::Expr] = [value]
                    instance: Ast::Expr = proof_substitute(body, binder_names, binder_values)
                    match instance:
                        Ast::Expr.Invalid:
                            return (false, Ast::Expr.Invalid)
                        _:
                            return (true, instance)
            return (false, Ast::Expr.Invalid)

        # Instantiate a universal fact at a checked integer-range or finite literal-collection
        # member. Dynamic collections and existential instantiation stay outside this action:
        # selecting from either would require assumptions not represented in this proof state.
        def proof_tactic_instantiate(state: mutable ProofTacticState&, fact_index: usize, value: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&) -> bool:
            return false if not proof_tactic_state_action_available_with_terms(state, 1, value, true, Ast::Expr.Absent, false)
            return proof_tactic_record(state, "instantiate", false, "a solved goal cannot accept another action") if state.solved
            proof_tactic_prepare(state, value, Ast::Expr.Absent, fact_index, true, false)
            state.pending_detail <- "forall"
            return proof_tactic_record(state, "instantiate", false, "the quantified fact index is out of range") if fact_index >= state.facts.count
            return proof_tactic_record(state, "instantiate", false, "quantifier annotation checks exhausted the source-work budget") if not proof_tactic_state_quantifier_annotation_work(state, annotations, 0)
            remaining_source_work: usize = state.source_quota - state.source_work_used
            quantifier_work: mutable usize = 0
            kind: sview = proof_quantifier_kind_with_work_limit(state.facts[fact_index], annotations, &quantifier_work, remaining_source_work, 0)
            if quantifier_work > remaining_source_work:
                state.source_work_used <- state.source_quota
                return proof_tactic_record(state, "instantiate", false, "quantifier annotation checks exhausted the source-work budget")
            state.source_work_used <- state.source_work_used + quantifier_work
            return proof_tactic_record(state, "instantiate", false, "only a universal quantified fact can be instantiated") if kind != "forall"
            quantifier: mutable Ast::Expr = state.facts[fact_index]
            match quantifier:
                Ast::Expr.Paren(inner, _):
                    quantifier <- inner
                _:
                    pass
            match quantifier:
                Ast::Expr.Block(statements, body, _, _):
                    return proof_tactic_record(state, "instantiate", false, "the quantified fact must have one integer range binder") if statements.count != 1
                    return proof_tactic_record(state, "instantiate", false, "effectful quantified bodies are not admissible proof facts") if proof_expr_has_call(body) or proof_expr_has_move(body)
                    match statements[0]:
                        Ast::Stmt.VarDecl(binder, _, range_expression, _):
                            return proof_tactic_record(state, "instantiate", false, "the quantified binder has no name") if binder == ""
                            match range_expression:
                                Ast::Expr.Binary(lower_expression, range_operator, upper_expression, _):
                                    return proof_tactic_record(state, "instantiate", false, "the quantified binder is not an integer range") if range_operator != TokenKind.RangeLt and range_operator != TokenKind.RangeLe
                                    selected: (known: bool, value: i64) = proof_constant_int(value)
                                    lower: (known: bool, value: i64) = proof_exact_int_from_facts(lower_expression, state.facts)
                                    upper: (known: bool, value: i64) = proof_exact_int_from_facts(upper_expression, state.facts)
                                    return proof_tactic_record(state, "instantiate", false, "the instance or quantified bounds are not exact integers") if not selected.known or not lower.known or not upper.known
                                    return proof_tactic_record(state, "instantiate", false, "the selected value is outside the quantified range") if selected.value < lower.value or (range_operator == TokenKind.RangeLt and selected.value >= upper.value) or (range_operator == TokenKind.RangeLe and selected.value > upper.value)
                                    binder_names: mutable darray[sview] = [binder]
                                    binder_values: mutable darray[Ast::Expr] = [value]
                                    instance: Ast::Expr = proof_substitute(body, binder_names, binder_values)
                                    match instance:
                                        Ast::Expr.Invalid:
                                            return proof_tactic_record(state, "instantiate", false, "the quantified body could not be represented after substitution")
                                        _:
                                            pass
                                    return false if not proof_tactic_state_snapshot_reserve(state, state.facts.count + 1)
                                    state.facts.push(instance)
                                    return proof_tactic_record(state, "instantiate", true, "added a universally quantified instance after checking range membership")
                                _:
                                    pass
                            match range_expression:
                                Ast::Expr.Array(elements, _):
                                    candidate: (known: bool, instance: Ast::Expr) = proof_tactic_collection_instance(body, binder, value, elements)
                                    if candidate.known:
                                        return false if not proof_tactic_state_snapshot_reserve(state, state.facts.count + 1)
                                        state.facts.push(candidate.instance)
                                        return proof_tactic_record(state, "instantiate", true, "added a universally quantified instance after checking literal-array membership")
                                Ast::Expr.Tuple(elements, _):
                                    candidate: (known: bool, instance: Ast::Expr) = proof_tactic_collection_instance(body, binder, value, elements)
                                    if candidate.known:
                                        return false if not proof_tactic_state_snapshot_reserve(state, state.facts.count + 1)
                                        state.facts.push(candidate.instance)
                                        return proof_tactic_record(state, "instantiate", true, "added a universally quantified instance after checking literal-tuple membership")
                                Ast::Expr.SetLit(elements, _):
                                    candidate: (known: bool, instance: Ast::Expr) = proof_tactic_collection_instance(body, binder, value, elements)
                                    if candidate.known:
                                        return false if not proof_tactic_state_snapshot_reserve(state, state.facts.count + 1)
                                        state.facts.push(candidate.instance)
                                        return proof_tactic_record(state, "instantiate", true, "added a universally quantified instance after checking literal-set membership")
                                _:
                                    pass
                        _:
                            pass
                _:
                    pass
            return proof_tactic_record(state, "instantiate", false, "the quantified fact shape is unsupported")

        # Add a local derived fact only after the current proof kernel has established it.
        # This is the tactic analogue of an asserted proof step; it never acts as an axiom.
        def proof_tactic_have(state: mutable ProofTacticState&, fact: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&) -> bool can[Global.Read, Global.Write]:
            return false if not proof_tactic_state_action_available_with_terms(state, 1, fact, true, Ast::Expr.Absent, false)
            return proof_tactic_record(state, "have", false, "a solved goal cannot accept another action") if state.solved
            proof_tactic_prepare(state, fact, Ast::Expr.Absent, 0, false, false)
            return proof_tactic_record(state, "have", false, "effectful expressions cannot enter a tactic proof context") if proof_expr_has_call(fact) or proof_expr_has_move(fact)
            solver_work: mutable usize = 0
            preflight_work: mutable usize = 0
            proven: bool = (proof_tactic_state_goal_with_work(state, fact, annotations, 0, &solver_work, &preflight_work) can Global{Read,Write})
            if proven:
                return false if not proof_tactic_state_snapshot_reserve(state, state.facts.count + 1)
                state.facts.push(fact)
                return proof_tactic_record(state, "have", true, "the derived fact was entailed by the current hypotheses")
            return proof_tactic_record(state, "have", false, "the proposed fact is not entailed by the current hypotheses")

        def proof_tactic_have_with_shared_work(state: mutable ProofTacticState&, fact: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, operator_mask: usize, solver_work: mutable usize&, preflight_work: mutable usize&) -> bool can[Global.Read, Global.Write]:
            return false if not proof_tactic_state_action_available_with_terms(state, 1, fact, true, Ast::Expr.Absent, false)
            return proof_tactic_record(state, "have", false, "a solved goal cannot accept another action") if state.solved
            proof_tactic_prepare(state, fact, Ast::Expr.Absent, 0, false, false)
            return proof_tactic_record(state, "have", false, "effectful expressions cannot enter a tactic proof context") if proof_expr_has_call(fact) or proof_expr_has_move(fact)
            proven: bool = (proof_tactic_state_goal_with_work(state, fact, annotations, operator_mask, &solver_work, &preflight_work) can Global{Read,Write})
            if proven:
                return false if not proof_tactic_state_snapshot_reserve(state, state.facts.count + 1)
                state.facts.push(fact)
                return proof_tactic_record(state, "have", true, "the derived fact was entailed by the current hypotheses")
            return proof_tactic_record(state, "have", false, "the proposed fact is not entailed by the current hypotheses")

    private:
        def proof_tactic_rewrite_after_preflight(state: mutable ProofTacticState&, from: Ast::Expr, replacement: Ast::Expr) -> bool can[Global.Read]:
            proof_tactic_prepare(state, from, replacement, 0, false, true)
            # +0 == -0 and NaN make equality rewriting unsound over floats.
            return proof_tactic_record(state, "rewrite", false, "floating-point equality is not a rewrite witness") if (proof_float_mode can Global.Read)
            return proof_tactic_record(state, "rewrite", false, "a solved goal cannot accept another action") if state.solved
            return proof_tactic_record(state, "rewrite", false, "effectful goals cannot be rewritten without a purity certificate") if proof_expr_has_call(state.goal) or proof_expr_has_move(state.goal)
            equality_found: mutable bool = false
            for fact in state.facts |fact, from, replacement, equality_found|:
                match fact:
                    Ast::Expr.Binary(left, TokenKind.EqEq, right, _):
                        equality_found <- true if not proof_expr_has_call(fact) and not proof_expr_has_move(fact) and ((proof_expr_equal(left, from) and proof_expr_equal(right, replacement)) or (proof_expr_equal(left, replacement) and proof_expr_equal(right, from)))
                    _:
                        pass
            return proof_tactic_record(state, "rewrite", false, "no explicit equality fact supports this rewrite") if not equality_found
            rewritten: (changed: bool, value: Ast::Expr) = proof_tactic_replace(state.goal, from, replacement)
            return proof_tactic_record(state, "rewrite", false, "the target expression does not contain the rewrite source") if not rewritten.changed
            state.goal <- rewritten.value
            return proof_tactic_record(state, "rewrite", true, "rewrote the goal using an explicit equality hypothesis")

    public:
        def proof_tactic_rewrite(state: mutable ProofTacticState&, from: Ast::Expr, replacement: Ast::Expr) -> bool can[Global.Read]:
            return false if not proof_tactic_state_action_available_with_terms(state, 0, from, true, replacement, true)
            return (proof_tactic_rewrite_after_preflight(state, from, replacement) can Global.Read) if state.solved
            proof_tactic_prepare(state, from, replacement, 0, false, true)
            return proof_tactic_record(state, "rewrite", false, "rewrite requires matching witnessed integer widths") if not proof_tactic_rewrite_integer_witnesses_match(from, replacement, state.facts)
            return proof_tactic_rewrite_after_preflight(state, from, replacement)

    private:
        # Replay an indexed rewrite against the exact equality selected by the script. Keeping
        # the index in the trace lets the independent kernel transition validate that same witness.
        def proof_tactic_rewrite_selected_fact_after_preflight(state: mutable ProofTacticState&, from: Ast::Expr, replacement: Ast::Expr, fact_index: usize) -> bool can[Global.Read]:
            proof_tactic_prepare(state, from, replacement, fact_index, true, true)
            return proof_tactic_record(state, "rewrite", false, "a solved goal cannot accept another action") if state.solved
            return proof_tactic_record(state, "rewrite", false, "rewrite requires matching witnessed integer widths") if not proof_tactic_rewrite_integer_witnesses_match(from, replacement, state.facts)
            return proof_tactic_record(state, "rewrite", false, "floating-point equality is not a rewrite witness") if (proof_float_mode can Global.Read)
            return proof_tactic_record(state, "rewrite", false, "effectful goals cannot be rewritten without a purity certificate") if proof_expr_has_call(state.goal) or proof_expr_has_move(state.goal)
            return proof_tactic_record(state, "rewrite", false, "the equality fact index is out of range") if fact_index >= state.facts.count
            equality: Ast::Expr = proof_strip_parens(state.facts[fact_index])
            match equality:
                Ast::Expr.Binary(left, TokenKind.EqEq, right, _):
                    return proof_tactic_record(state, "rewrite", false, "the selected equality does not support this rewrite") if proof_expr_has_call(equality) or proof_expr_has_move(equality) or not ((proof_expr_equal(left, from) and proof_expr_equal(right, replacement)) or (proof_expr_equal(left, replacement) and proof_expr_equal(right, from)))
                _:
                    return proof_tactic_record(state, "rewrite", false, "the selected fact is not an equality")
            rewritten: (changed: bool, value: Ast::Expr) = proof_tactic_replace(state.goal, from, replacement)
            return proof_tactic_record(state, "rewrite", false, "the target expression does not contain the rewrite source") if not rewritten.changed
            state.goal <- rewritten.value
            return proof_tactic_record(state, "rewrite", true, "rewrote the goal using an explicit equality hypothesis")

    public:
        def proof_tactic_rewrite_selected_fact(state: mutable ProofTacticState&, from: Ast::Expr, replacement: Ast::Expr, fact_index: usize) -> bool can[Global.Read]:
            return false if not proof_tactic_state_action_available_with_terms(state, 0, from, true, replacement, true)
            return proof_tactic_rewrite_selected_fact_after_preflight(state, from, replacement, fact_index)

        # Source-bound rewrite is stricter than the source-neutral tactic language. Elisa's
        # equality operator may be a user protocol on a named value, so an equality hypothesis
        # over that value is not a Leibniz equality and cannot rewrite a field, index, call, or
        # any other context. The scalar witness relation is the same conservative boundary used
        # by the congruence kernel: it admits only primitive values and language-owned former
        # expressions, never a struct receiver or an overloaded operator result.
        def proof_tactic_rewrite_source_bound(state: mutable ProofTacticState&, from: Ast::Expr, replacement: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&) -> bool can[Global.Read]:
            return false if not proof_tactic_state_action_available_with_terms(state, 0, from, true, replacement, true)
            proof_tactic_prepare(state, from, replacement, 0, false, true)
            # +0 == -0 and NaN make equality rewriting unsound over floats.
            return proof_tactic_record(state, "rewrite", false, "floating-point equality is not a rewrite witness") if (proof_float_mode can Global.Read)
            return (proof_tactic_rewrite_after_preflight(state, from, replacement) can Global.Read) if state.solved
            return proof_tactic_record(state, "rewrite", false, "source-bound rewrite requires matching witnessed integer widths") if not proof_tactic_rewrite_integer_witnesses_match(from, replacement, state.facts)
            # A primitive literal is structurally scalar, but its source `==` may still be a
            # user-defined protocol implementation. Refusing the whole rewrite when any source
            # operator is overloaded keeps a custom equality from being used as Leibniz equality
            # merely because both endpoints happen to be closed literals.
            source_mask: (complete: bool, mask: usize) = proof_tactic_state_operator_mask(state, annotations)
            return proof_tactic_record(state, "rewrite", false, "source-bound rewrite could not validate the primitive operator index") if not source_mask.complete
            source_operator_mask: usize = source_mask.mask
            goal_operator: (complete: bool, overloaded: bool) = proof_tactic_state_overloaded_operator_with_work(state, state.goal, source_operator_mask)
            from_operator: (complete: bool, overloaded: bool) = proof_tactic_state_overloaded_operator_with_work(state, from, source_operator_mask)
            replacement_operator: (complete: bool, overloaded: bool) = proof_tactic_state_overloaded_operator_with_work(state, replacement, source_operator_mask)
            return proof_tactic_record(state, "rewrite", false, "source-bound rewrite could not validate the primitive operator index") if not goal_operator.complete or not from_operator.complete or not replacement_operator.complete
            return proof_tactic_record(state, "rewrite", false, "source-bound rewrite cannot use source-overloaded equality") if goal_operator.overloaded or from_operator.overloaded or replacement_operator.overloaded
            unsafe_match: mutable bool = false
            safe_match: mutable bool = false
            for fact in state.facts |fact, from, replacement, state, unsafe_match, safe_match|:
                return proof_tactic_record(state, "rewrite", false, "source-bound rewrite exhausted its source-work budget") if not proof_tactic_state_charge_source_work(state, 1)
                match fact:
                    Ast::Expr.Binary(left, TokenKind.EqEq, right, _):
                        matches: bool = not proof_expr_has_call(fact) and not proof_expr_has_move(fact) and ((proof_expr_equal(left, from) and proof_expr_equal(right, replacement)) or (proof_expr_equal(left, replacement) and proof_expr_equal(right, from)))
                        if matches:
                            fact_operator: (complete: bool, overloaded: bool) = proof_tactic_state_overloaded_operator_with_work(state, fact, source_operator_mask)
                            return proof_tactic_record(state, "rewrite", false, "source-bound rewrite could not validate the primitive operator index") if not fact_operator.complete
                            if not fact_operator.overloaded and proof_scalar_term_witnessed(left, state.facts, 0) and proof_scalar_term_witnessed(right, state.facts, 0):
                                safe_match <- true
                            else:
                                unsafe_match <- true
                    _:
                        pass
            if unsafe_match and not safe_match:
                proof_tactic_prepare(state, from, replacement, 0, false, true)
                return proof_tactic_record(state, "rewrite", false, "source-bound rewrite requires a primitive-scalar equality witness")
            return (proof_tactic_rewrite_after_preflight(state, from, replacement) can Global.Read)

        # Repair scripts may name an equality fact instead of serializing both terms. The selected
        # fact and orientation remain in the tactic trace and are independently replayed.
        def proof_tactic_rewrite_from_fact(state: mutable ProofTacticState&, fact_index: usize, reverse: bool, annotations: darray[Ast::EnumAnnotation]&) -> bool can[Global.Read]:
            proof_tactic_prepare(state, Ast::Expr.Absent, Ast::Expr.Absent, fact_index, true, true)
            if fact_index >= state.facts.count:
                return false if not proof_tactic_state_action_available(state)
                return proof_tactic_record(state, "rewrite", false, "the equality fact index is out of range")
            # Charge the selected source expression before unwrapping it. Its full shape is an
            # upper bound for both rewrite terms later copied into the trace.
            return false if not proof_tactic_state_action_available_with_terms(state, 0, state.facts[fact_index], true, Ast::Expr.Absent, false)
            match proof_strip_parens(state.facts[fact_index]):
                Ast::Expr.Binary(left, TokenKind.EqEq, right, _):
                    from: Ast::Expr = right if reverse else left
                    replacement: Ast::Expr = left if reverse else right
                    return (proof_tactic_rewrite_selected_fact_after_preflight(state, from, replacement, fact_index) can Global.Read) if state.solved
                    proof_tactic_prepare(state, from, replacement, fact_index, true, true)
                    return proof_tactic_record(state, "rewrite", false, "source-bound rewrite requires matching witnessed integer widths") if not proof_tactic_rewrite_integer_witnesses_match(from, replacement, state.facts)
                    return proof_tactic_record(state, "rewrite", false, "effectful goals cannot be rewritten without a purity certificate") if proof_expr_has_call(state.goal) or proof_expr_has_move(state.goal)
                    source_mask: (complete: bool, mask: usize) = proof_tactic_state_operator_mask(state, annotations)
                    return proof_tactic_record(state, "rewrite", false, "source-bound rewrite could not validate the primitive operator index") if not source_mask.complete
                    source_operator_mask: usize = source_mask.mask
                    goal_operator: (complete: bool, overloaded: bool) = proof_tactic_state_overloaded_operator_with_work(state, state.goal, source_operator_mask)
                    from_operator: (complete: bool, overloaded: bool) = proof_tactic_state_overloaded_operator_with_work(state, from, source_operator_mask)
                    replacement_operator: (complete: bool, overloaded: bool) = proof_tactic_state_overloaded_operator_with_work(state, replacement, source_operator_mask)
                    fact_operator: (complete: bool, overloaded: bool) = proof_tactic_state_overloaded_operator_with_work(state, state.facts[fact_index], source_operator_mask)
                    return proof_tactic_record(state, "rewrite", false, "source-bound rewrite could not validate the primitive operator index") if not goal_operator.complete or not from_operator.complete or not replacement_operator.complete or not fact_operator.complete
                    return proof_tactic_record(state, "rewrite", false, "source-bound rewrite cannot use source-overloaded equality") if goal_operator.overloaded or from_operator.overloaded or replacement_operator.overloaded or fact_operator.overloaded
                    return proof_tactic_record(state, "rewrite", false, "source-bound rewrite requires a primitive-scalar equality witness") if proof_expr_has_call(state.facts[fact_index]) or proof_expr_has_move(state.facts[fact_index]) or not proof_scalar_term_witnessed(left, state.facts, 0) or not proof_scalar_term_witnessed(right, state.facts, 0)
                    return (proof_tactic_rewrite_selected_fact_after_preflight(state, from, replacement, fact_index) can Global.Read)
                _:
                    return proof_tactic_record(state, "rewrite", false, "the selected fact is not an equality")
