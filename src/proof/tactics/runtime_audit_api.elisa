# Public, deliberately narrow entry points for the executable dogfood harness.
# The implementation remains private; this facade lets an external runtime test
# exercise the same checked transitions without reaching across module boundaries.
extend ElisaProof:
    private:
        const PROOF_RUNTIME_AUDIT_REGION_SIZE: usize = 65536

    public:
        # Exercise exact source-state admission using fixed audit data. Keep the report producer
        # private; the external runtime harness can observe only whether these controls hold.
        def proof_runtime_source_state_binding_controls(position: Ast::Pos) -> bool:
            report: mutable ProofReport = proof_empty_report()
            facts: mutable darray[Ast::Expr] = []
            goal: Ast::Expr = Ast::Expr.BoolLit(false, position)
            fact: Ast::Expr = Ast::Expr.Binary(Ast::Expr.IntLit(1, position), TokenKind.EqEq, Ast::Expr.IntLit(0, position), position)
            proof_add_traced_fact(&facts, &report, fact, "precondition", 1, "binding")
            proof_add_goal_attempt(&report, facts, goal, 1, "binding", "goal", false)
            return false if not proof_tactic_source_state_matches(report, 0, facts, goal)
            return false if proof_tactic_source_state_matches(report, 0, facts, Ast::Expr.BoolLit(true, position))
            forged_facts: darray[Ast::Expr] = [goal]
            return false if proof_tactic_source_state_matches(report, 0, forged_facts, goal)
            report.goal_attempts.clear()
            report.goal_attempts.push(ProofGoalAttempt{goal: goal, budget_exhausted: false, facts_start: report.certificate_facts.count + 1, facts_count: 1, kernel_goal: 0, kernel_facts_start: 0, kernel_facts_count: 1, line: 1, name: "binding", rule: "goal", proven: false, has_certificate: false, certificate_index: 0})
            return proof_tactic_source_state_matches(report, 0, facts, goal) == false

        def proof_runtime_quantifier_source_state_controls(expression: Ast::Expr, forged: Ast::Expr, annotations: darray[Ast::EnumAnnotation]) -> bool:
            report: mutable ProofReport = proof_empty_report()
            report.source_annotations.extend(annotations)
            facts: mutable darray[Ast::Expr] = []
            proof_add_goal_attempt(&report, facts, expression, 1, "quantifier-binding", "quantifier-forall", false)
            return false if not proof_tactic_source_state_matches(report, 0, facts, expression)
            return proof_tactic_source_state_matches(report, 0, facts, forged) == false

        def proof_runtime_add_traced_fact(facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, expression: Ast::Expr, kind: sview, line: u32, name: sview) -> void:
            proof_add_traced_fact(facts, report, expression, kind, line, name)

        def proof_runtime_substitute(expression: Ast::Expr, name: sview, value: Ast::Expr) -> Ast::Expr:
            return proof_replay_substitute(expression, name, value)

        def proof_runtime_ast_matches_kernel(report: ProofReport&, expression: Ast::Expr, root: usize, depth: usize) -> bool:
            return proof_replay_ast_matches_kernel(report, expression, root, depth)

        # Keep the dogfood encoder tied to one report owner. The earlier three-buffer generic
        # wrapper exposed independent region parameters to stage0, even though every caller was
        # already passing fields from the same report. Stage1 can infer that accidental API, but
        # stage0 correctly refuses the ambiguous call. The report boundary is also the honest
        # ownership model: these arrays are one certificate arena, not unrelated buffers.
        def proof_runtime_kernel_encode_annotated(expression: Ast::Expr, report: mutable ProofReport&) -> usize:
            return proof_kernel_encode_annotated(expression, &report.kernel.nodes, &report.kernel.children, report.source_annotations)

        # Adversarial reports may carry a damaged fact-trace index. Rebuild the index, inject a
        # self-link at the selected owner's head, and verify that the lookup terminates without
        # treating an absent fact as proven. This keeps the regression at the public dogfood
        # boundary instead of exposing the index implementation itself.
        def proof_runtime_replay_fact_trace_cycle_safe(report: mutable ProofReport&, fact: Ast::Expr, owner: sview) -> bool can[Global.Read, Global.Write]:
            proof_replay_build_fact_trace_index(report)
            head: usize = proof_replay_fact_trace_head(report, owner)
            return false if head >= report.traces.records.count or head >= report.traces.next_indices.count
            report.traces.next_indices[head] <- head
            return not proof_replay_fact_is_traced(report, fact, owner)

        # The source-neutral encoder has a bounded term depth. Exercise the producer-side gate
        # with a term just beyond that limit so an imported AST is rejected before a recursive
        # support walk can consume the host stack.
        def proof_runtime_kernel_depth_rejected(position: Ast::Pos) -> bool:
            expression: mutable Ast::Expr = Ast::Expr.IntLit(1, position)
            for _ in 0..<ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT |expression, position|:
                expression <- Ast::Expr.Paren(expression, position)
            return not proof_kernel_expression_supported(expression) and not proof_expr_equal(expression, expression) and proof_expr_has_call(expression) and proof_expr_has_move(expression) and proof_expr_has_old(expression) and proof_expr_has_executable_call(expression)

        # `Invalid` is the verifier's internal failure sentinel, not an AST proposition. It must
        # never compare equal to itself, or a malformed substitution can be accepted as a fact.
        def proof_runtime_invalid_equality_rejected() -> bool:
            invalid: Ast::Expr = Ast::Expr.Invalid
            return not proof_expr_equal(invalid, invalid)

        # The checked-get arena erases recovery statements, so admission must reject an invalid
        # recovery before that erasure. This exercises the same producer-side gate used by report
        # certificate creation.
        def proof_runtime_invalid_getelse_rejected(position: Ast::Pos) -> bool can[Memory.Allocate, Abort.Panic]:
            result: mutable bool = false
            region audit_region(PROOF_RUNTIME_AUDIT_REGION_SIZE):
                store: Ast::Node.Store[Local] = Ast::Node.Store(audit_region)
                in store:
                    object: Ast::Expr = new[store] Ast::Expr.Ident("values", position)
                    index: Ast::Expr = new[store] Ast::Expr.IntLit(0, position)
                    guarded: Ast::Expr = new[store] Ast::Expr.Index(object, index, position)
                    recovery: darray[Ast::Stmt] = [Ast::Stmt.Invalid]
                    malformed: Ast::Expr = new[store] Ast::Expr.GetElse(guarded, recovery, position)
                    valid_recovery: darray[Ast::Stmt] = [Ast::Stmt.Return(new[store] Ast::Expr.IntLit(0, position), position)]
                    valid: Ast::Expr = new[store] Ast::Expr.GetElse(guarded, valid_recovery, position)
                    forged_report: mutable ProofReport = proof_empty_report()
                    valid_root: usize = proof_runtime_kernel_encode_annotated(valid, &forged_report)
                    result <- not proof_kernel_expression_supported(malformed) and not proof_runtime_ast_matches_kernel(forged_report, malformed, valid_root, 0)
            return result

        # Quantifier binder type metadata is erased from the source-neutral term, but it still
        # must be a well-formed imported AST before erasure. Pair a valid arena root with an
        # Invalid binder type and require the mirror matcher to reject it.
        def proof_runtime_invalid_quantifier_type_rejected(position: Ast::Pos) -> bool can[Memory.Allocate, Abort.Panic]:
            result: mutable bool = false
            region audit_region(PROOF_RUNTIME_AUDIT_REGION_SIZE):
                store: Ast::Node.Store[Local] = Ast::Node.Store(audit_region)
                in store:
                    range_expression: Ast::Expr = new[store] Ast::Expr.Binary(new[store] Ast::Expr.IntLit(0, position), TokenKind.RangeLt, new[store] Ast::Expr.IntLit(1, position), position)
                    body: Ast::Expr = new[store] Ast::Expr.Binary(new[store] Ast::Expr.Ident("i", position), TokenKind.EqEq, new[store] Ast::Expr.IntLit(0, position), position)
                    valid_statements: darray[Ast::Stmt] = [Ast::Stmt.VarDecl("i", new[store] Ast::Expr.Ident("i64", position), range_expression, position)]
                    valid: Ast::Expr = new[store] Ast::Expr.Block(valid_statements, body, [], position)
                    invalid_statements: darray[Ast::Stmt] = [Ast::Stmt.VarDecl("i", Ast::Expr.Invalid, range_expression, position)]
                    malformed: Ast::Expr = new[store] Ast::Expr.Block(invalid_statements, body, [], position)
                    annotations: mutable darray[Ast::EnumAnnotation] = [Ast::EnumAnnotation{owner: "__contract_quantifier", name: "forall", line: 1}]
                    forged_report: mutable ProofReport = proof_empty_report()
                    forged_report.source_annotations.extend(annotations)
                    valid_root: usize = proof_runtime_kernel_encode_annotated(valid, &forged_report)
                    result <- not proof_kernel_expression_supported(malformed) and not proof_runtime_ast_matches_kernel(forged_report, malformed, valid_root, 0)
            return result

        # Quantifier captures are not serialized into the source-neutral node. A nonempty capture
        # list therefore must be rejected before erasure rather than ignored by replay.
        def proof_runtime_captured_quantifier_rejected(position: Ast::Pos) -> bool can[Memory.Allocate, Abort.Panic]:
            result: mutable bool = false
            region audit_region(PROOF_RUNTIME_AUDIT_REGION_SIZE):
                store: Ast::Node.Store[Local] = Ast::Node.Store(audit_region)
                in store:
                    range_expression: Ast::Expr = new[store] Ast::Expr.Binary(new[store] Ast::Expr.IntLit(0, position), TokenKind.RangeLt, new[store] Ast::Expr.IntLit(1, position), position)
                    body: Ast::Expr = new[store] Ast::Expr.Binary(new[store] Ast::Expr.Ident("i", position), TokenKind.EqEq, new[store] Ast::Expr.IntLit(0, position), position)
                    statements: darray[Ast::Stmt] = [Ast::Stmt.VarDecl("i", new[store] Ast::Expr.Ident("i64", position), range_expression, position)]
                    captured: Ast::Expr = new[store] Ast::Expr.Block(statements, body, ["captured"], position)
                    result <- not proof_kernel_expression_supported(captured)
            return result

        # Identifiers and selectors are serialized into mandatory arena name fields. Empty
        # names, including positional construction fields, must therefore fail before an AST can
        # become a certificate premise or goal.
        def proof_runtime_empty_kernel_names_rejected(position: Ast::Pos) -> bool can[Memory.Allocate, Abort.Panic]:
            result: mutable bool = false
            region audit_region(PROOF_RUNTIME_AUDIT_REGION_SIZE):
                store: Ast::Node.Store[Local] = Ast::Node.Store(audit_region)
                in store:
                    empty_ident: Ast::Expr = new[store] Ast::Expr.Ident("", position)
                    empty_field: Ast::Expr = new[store] Ast::Expr.Field(new[store] Ast::Expr.Ident("value", position), "", position)
                    empty_scope: Ast::Expr = new[store] Ast::Expr.Scope(new[store] Ast::Expr.Ident("Type", position), "", position)
                    empty_fields: darray[Ast::FieldInit] = [Ast::FieldInit{name: "", value: new[store] Ast::Expr.IntLit(0, position)}]
                    empty_construct: Ast::Expr = new[store] Ast::Expr.Construct(new[store] Ast::Expr.Ident("Type", position), empty_fields, position)
                    result <- not proof_kernel_expression_supported(empty_ident) and not proof_kernel_expression_supported(empty_field) and not proof_kernel_expression_supported(empty_scope) and not proof_kernel_expression_supported(empty_construct)
            return result
