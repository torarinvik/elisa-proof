# Public, deliberately narrow entry points for the executable dogfood harness.
# The implementation remains private; this facade lets an external runtime test
# exercise the same checked transitions without reaching across module boundaries.
extend ElisaProof:
    public:
        def proof_runtime_add_traced_fact(facts: mutable darray[Ast::Expr]&, report: mutable ProofReport&, expression: Ast::Expr, kind: sview, line: u32, name: sview) -> void:
            proof_add_traced_fact(facts, report, expression, kind, line, name)

        def proof_runtime_substitute(expression: Ast::Expr, name: sview, value: Ast::Expr) -> Ast::Expr:
            return proof_replay_substitute(expression, name, value)

        def proof_runtime_ast_matches_kernel(report: ProofReport&, expression: Ast::Expr, root: usize, depth: usize) -> bool:
            return proof_replay_ast_matches_kernel(report, expression, root, depth)

        def proof_runtime_kernel_encode_annotated[@r](expression: Ast::Expr, annotations: darray[Ast::EnumAnnotation]& @r, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]& @r, children: mutable darray[usize]& @r) -> usize:
            return proof_kernel_encode_annotated(expression, nodes, children, annotations)

        # Adversarial reports may carry a damaged fact-trace index. Rebuild the index, inject a
        # self-link at the selected owner's head, and verify that the lookup terminates without
        # treating an absent fact as proven. This keeps the regression at the public dogfood
        # boundary instead of exposing the index implementation itself.
        def proof_runtime_replay_fact_trace_cycle_safe(report: mutable ProofReport&, fact: Ast::Expr, owner: sview) -> bool:
            proof_replay_build_fact_trace_index(report)
            head: usize = proof_replay_fact_trace_head(report, owner)
            return false if head >= report.fact_traces.count or head >= report.fact_trace_next_indices.count
            report.fact_trace_next_indices[head] <- head
            return not proof_replay_fact_is_traced(report, fact, owner)

        # The source-neutral encoder has a bounded term depth. Exercise the producer-side gate
        # with a term just beyond that limit so an imported AST is rejected before a recursive
        # support walk can consume the host stack.
        def proof_runtime_kernel_depth_rejected(position: Ast::Pos) -> bool:
            expression: mutable Ast::Expr = Ast::Expr.IntLit(1, position)
            for _ in 0..<128 |expression, position|:
                expression <- Ast::Expr.Paren(expression, position)
            return not proof_kernel_expression_supported(expression) and not proof_expr_equal(expression, expression) and proof_expr_has_call(expression) and proof_expr_has_move(expression) and proof_expr_has_old(expression) and proof_expr_has_executable_call(expression)

        # `Invalid` is the verifier's internal failure sentinel, not an AST proposition. It must
        # never compare equal to itself, or a malformed substitution can be accepted as a fact.
        def proof_runtime_invalid_equality_rejected() -> bool:
            invalid: Ast::Expr = Ast::Expr.Invalid
            return not proof_expr_equal(invalid, invalid)

        # The checked-get arena erases recovery statements, so admission must reject an invalid
        # recovery before that erasure. This exercises the same producer-side gate used by report
        # certificate creation.
        def proof_runtime_invalid_getelse_rejected(position: Ast::Pos) -> bool:
            object: Ast::Expr = Ast::Expr.Ident("values", position)
            index: Ast::Expr = Ast::Expr.IntLit(0, position)
            guarded: Ast::Expr = Ast::Expr.Index(object, index, position)
            recovery: darray[Ast::Stmt] = [Ast::Stmt.Invalid]
            malformed: Ast::Expr = Ast::Expr.GetElse(guarded, recovery, position)
            return false if proof_kernel_expression_supported(malformed)
            valid_recovery: darray[Ast::Stmt] = [Ast::Stmt.Return(Ast::Expr.IntLit(0, position), position)]
            valid: Ast::Expr = Ast::Expr.GetElse(guarded, valid_recovery, position)
            forged_report: mutable ProofReport = proof_empty_report()
            valid_root: usize = proof_runtime_kernel_encode_annotated(valid, forged_report.source_annotations, &forged_report.kernel_nodes, &forged_report.kernel_children)
            return not proof_runtime_ast_matches_kernel(forged_report, malformed, valid_root, 0)

        # Quantifier binder type metadata is erased from the source-neutral term, but it still
        # must be a well-formed imported AST before erasure. Pair a valid arena root with an
        # Invalid binder type and require the mirror matcher to reject it.
        def proof_runtime_invalid_quantifier_type_rejected(position: Ast::Pos) -> bool:
            range_expression: Ast::Expr = Ast::Expr.Binary(Ast::Expr.IntLit(0, position), TokenKind.RangeLt, Ast::Expr.IntLit(1, position), position)
            body: Ast::Expr = Ast::Expr.Binary(Ast::Expr.Ident("i", position), TokenKind.EqEq, Ast::Expr.IntLit(0, position), position)
            valid_statements: darray[Ast::Stmt] = [Ast::Stmt.VarDecl("i", Ast::Expr.Ident("i64", position), range_expression, position)]
            valid: Ast::Expr = Ast::Expr.Block(valid_statements, body, [], position)
            invalid_statements: darray[Ast::Stmt] = [Ast::Stmt.VarDecl("i", Ast::Expr.Invalid, range_expression, position)]
            malformed: Ast::Expr = Ast::Expr.Block(invalid_statements, body, [], position)
            annotations: mutable darray[Ast::EnumAnnotation] = [Ast::EnumAnnotation{owner: "__contract_quantifier", name: "forall", line: 1}]
            return false if proof_kernel_expression_supported(malformed)
            forged_report: mutable ProofReport = proof_empty_report()
            forged_report.source_annotations.extend(annotations)
            valid_root: usize = proof_runtime_kernel_encode_annotated(valid, forged_report.source_annotations, &forged_report.kernel_nodes, &forged_report.kernel_children)
            return not proof_runtime_ast_matches_kernel(forged_report, malformed, valid_root, 0)
