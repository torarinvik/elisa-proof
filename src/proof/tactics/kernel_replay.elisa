extend ElisaProof:
    public:
        def proof_tactic_split[@r](state: mutable ProofTacticState& @r, left_state: mutable ProofTacticState& @r, right_state: mutable ProofTacticState& @r) -> bool:
            return false if not proof_tactic_state_action_available(state)
            match state.goal:
                Ast::Expr.Binary(left, TokenKind.And, right, _):
                    quota: ProofTacticBranchQuota = proof_tactic_branch_quota(state, state.facts.count, state.facts.count, state.action_count, state.trace_facts.count)
                    if not quota.valid:
                        return proof_tactic_record(state, "split", false, quota.reason)
                    left_shape: ProofTacticChildShapeBudget = proof_tactic_child_shape_budget(state, left, state.facts.count, Ast::Expr.Absent, quota.left_action_ast_quota)
                    right_shape: ProofTacticChildShapeBudget = proof_tactic_child_shape_budget(state, right, state.facts.count, Ast::Expr.Absent, quota.right_action_ast_quota)
                    if not left_shape.valid or not right_shape.valid:
                        return proof_tactic_record(state, "split", false, "branch child AST copies exceed the remaining direct tactic budget")
                    return false if not proof_tactic_initialize_child(state, left, state.facts.count, Ast::Expr.Absent, quota, true, left_shape, left_state)
                    return false if not proof_tactic_initialize_child(state, right, state.facts.count, Ast::Expr.Absent, quota, false, right_shape, right_state)
                    accepted: bool = proof_tactic_record(state, "split", true, "created independent states for both conjunction branches")
                    state.branch_terminal <- true if accepted
                    return accepted
                _:
                    return proof_tactic_record(state, "split", false, "the goal is not a conjunction")

        # Select one side of a disjunctive goal. The selected goal is still unsolved; the
        # operation only performs the constructive introduction rule and cannot manufacture a
        # proof of either branch.
        def proof_tactic_left(state: mutable ProofTacticState&) -> bool:
            return false if not proof_tactic_state_action_available(state)
            return proof_tactic_record(state, "left", false, "a solved goal cannot accept another action") if state.solved
            match state.goal:
                Ast::Expr.Binary(left, TokenKind.Or, _, _):
                    state.goal <- left
                    return proof_tactic_record(state, "left", true, "selected the left disjunct")
                _:
                    return proof_tactic_record(state, "left", false, "the goal is not a disjunction")

        def proof_tactic_right(state: mutable ProofTacticState&) -> bool:
            return false if not proof_tactic_state_action_available(state)
            return proof_tactic_record(state, "right", false, "a solved goal cannot accept another action") if state.solved
            match state.goal:
                Ast::Expr.Binary(_, TokenKind.Or, right, _):
                    state.goal <- right
                    return proof_tactic_record(state, "right", true, "selected the right disjunct")
                _:
                    return proof_tactic_record(state, "right", false, "the goal is not a disjunction")

        # Disjunction case analysis is similarly explicit. The selected disjunct is removed
        # from each child context and replaced by one branch hypothesis.
        def proof_tactic_cases[@r](state: mutable ProofTacticState& @r, left_state: mutable ProofTacticState& @r, right_state: mutable ProofTacticState& @r) -> bool:
            return false if not proof_tactic_state_action_available(state)
            for index in 0..<state.facts.count |index, state, left_state, right_state|:
                match state.facts[index]:
                    Ast::Expr.Binary(left, TokenKind.Or, right, _):
                        quota: ProofTacticBranchQuota = proof_tactic_branch_quota(state, state.facts.count, state.facts.count, state.action_count, state.trace_facts.count)
                        if not quota.valid:
                            return proof_tactic_record(state, "cases", false, quota.reason)
                        left_shape: ProofTacticChildShapeBudget = proof_tactic_child_shape_budget(state, state.goal, index, left, quota.left_action_ast_quota)
                        right_shape: ProofTacticChildShapeBudget = proof_tactic_child_shape_budget(state, state.goal, index, right, quota.right_action_ast_quota)
                        if not left_shape.valid or not right_shape.valid:
                            return proof_tactic_record(state, "cases", false, "branch child AST copies exceed the remaining direct tactic budget")
                        return false if not proof_tactic_initialize_child(state, state.goal, index, left, quota, true, left_shape, left_state)
                        return false if not proof_tactic_initialize_child(state, state.goal, index, right, quota, false, right_shape, right_state)
                        accepted: bool = proof_tactic_record(state, "cases", true, "created independent states for both disjunction branches")
                        state.branch_terminal <- true if accepted
                        return accepted
                    _:
                        pass
            return proof_tactic_record(state, "cases", false, "no disjunction hypothesis is available")

        # Compare the observable part of one recorded action. The trace includes the post-state
        # snapshot and all explicit arguments, so a client can distinguish an accepted action
        # from a merely attempted one without scraping prose diagnostics.
        def proof_tactic_step_equal(left: ProofTacticStep, right: ProofTacticStep) -> bool:
            return false if:
                left.action != right.action or left.accepted != right.accepted or left.facts_start != right.facts_start or left.facts_count != right.facts_count or left.solved != right.solved or left.reason != right.reason or left.has_argument != right.has_argument or left.has_secondary != right.has_secondary or left.argument_index != right.argument_index or left.has_argument_index != right.has_argument_index or left.detail != right.detail
                not proof_expr_equal(left.goal, right.goal)
                (left.has_argument and not proof_expr_equal(left.argument, right.argument))
                (left.has_secondary and not proof_expr_equal(left.secondary, right.secondary))
            return true

        def proof_tactic_state_equal(left: ProofTacticState&, right: ProofTacticState&) -> bool:
            return false if:
                left.solved != right.solved or left.action_count != right.action_count or left.last_action != right.last_action or left.last_reason != right.last_reason or left.budget_exhausted != right.budget_exhausted or left.branch_terminal != right.branch_terminal
                left.action_quota != right.action_quota or left.snapshot_quota != right.snapshot_quota or left.solver_quota != right.solver_quota or left.preflight_quota != right.preflight_quota or left.source_quota != right.source_quota or left.action_ast_quota != right.action_ast_quota
                left.solver_work_used != right.solver_work_used or left.preflight_work_used != right.preflight_work_used or left.source_work_used != right.source_work_used or left.action_ast_work_used != right.action_ast_work_used
                not proof_expr_equal(left.initial_goal, right.initial_goal)
                not proof_expr_array_equal(left.initial_facts, right.initial_facts)
                not proof_expr_equal(left.goal, right.goal)
                not proof_expr_array_equal(left.facts, right.facts)
                left.trace.count != right.trace.count
                not proof_expr_array_equal(left.trace_facts, right.trace_facts)
            for index in 0..<left.trace.count |index, left, right|:
                return false if not proof_tactic_step_equal(left.trace[index], right.trace[index])
            return true

        # Deterministically replay the complete action history from the state snapshot. This is
        # intentionally separate from mutation: a failed or partial proof remains inspectable,
        # and replay returns false if any accepted/rejected transition or post-state diverges.
        # The proposition-closing actions still delegate to the existing proof kernel, while the
        # trace itself records structural and derived-fact transitions for later independent
        # certificate work.
        def proof_tactic_replay(state: ProofTacticState&, annotations: darray[Ast::EnumAnnotation]&) -> bool can[Global.Read, Global.Write]:
            solver_work: mutable usize = 0
            preflight_work: mutable usize = 0
            # The public standalone entry point also shares solver and preflight ceilings across the
            # entire trace. Resetting those counters for each replayed action would let a bounded
            # tactic step be repeated up to the action quota.
            return (proof_tactic_replay_impl(state, annotations, 0, false, &solver_work, &preflight_work, true) can Global{Read,Write})

        def proof_tactic_replay_with_shared_work(state: ProofTacticState&, annotations: darray[Ast::EnumAnnotation]&, operator_mask: usize, source_bound: bool, solver_work: mutable usize&, preflight_work: mutable usize&) -> bool can[Global.Read, Global.Write]:
            return (proof_tactic_replay_impl(state, annotations, operator_mask, source_bound, &solver_work, &preflight_work, true) can Global{Read,Write})

        def proof_tactic_replay_impl(state: ProofTacticState&, annotations: darray[Ast::EnumAnnotation]&, operator_mask: usize, source_bound: bool, solver_work: mutable usize&, preflight_work: mutable usize&, shared_work: bool) -> bool can[Global.Read, Global.Write]:
            shape_cost: mutable usize = 0
            return false if not proof_tactic_state_budget_well_formed(state)
            return false if not proof_tactic_state_replay_ast_shape_reserve(state, &shape_cost, &preflight_work, PROOF_LINEAR_TACTIC_PREFLIGHT_WORK_LIMIT)
            return false if not proof_tactic_state_replay_comparison_reserve(state, shape_cost, &preflight_work, PROOF_LINEAR_TACTIC_PREFLIGHT_WORK_LIMIT)
            replay_state: mutable ProofTacticState = proof_tactic_state(state.initial_facts, state.initial_goal)
            replay_state.action_quota <- state.action_quota
            replay_state.snapshot_quota <- state.snapshot_quota
            replay_state.solver_quota <- state.solver_quota
            replay_state.preflight_quota <- state.preflight_quota
            replay_state.source_quota <- state.source_quota
            replay_state.action_ast_quota <- state.action_ast_quota
            empty: mutable darray[Ast::Expr] = []
            for expected in state.trace |expected, replay_state, annotations, empty|:
                before_count: usize = replay_state.trace.count
                accepted: mutable bool = false
                if expected.action == "assumption":
                    accepted <- proof_tactic_assumption(&replay_state, annotations)
                elif expected.action == "exact":
                    accepted <- (proof_tactic_decision_with_shared_work(&replay_state, annotations, "exact", operator_mask, &solver_work, &preflight_work) can Global{Read,Write}) if shared_work
                    accepted <- (proof_tactic_exact(&replay_state, annotations) can Global{Read,Write}) if not shared_work
                elif expected.action == "decide":
                    accepted <- (proof_tactic_decision_with_shared_work(&replay_state, annotations, "decide", operator_mask, &solver_work, &preflight_work) can Global{Read,Write}) if shared_work
                    accepted <- (proof_tactic_decide(&replay_state, annotations) can Global{Read,Write}) if not shared_work
                elif expected.action == "intro":
                    accepted <- proof_tactic_intro(&replay_state)
                elif expected.action == "apply":
                    return false if expected.has_argument or expected.has_secondary
                    if expected.has_argument_index:
                        accepted <- proof_tactic_apply_from_fact(&replay_state, expected.argument_index, annotations)
                    else:
                        accepted <- proof_tactic_apply(&replay_state, annotations)
                elif expected.action == "simp":
                    accepted <- (proof_tactic_simplify_source_bound_with_shared_work(&replay_state, annotations, operator_mask, &solver_work, &preflight_work) can Global{Read,Write}) if shared_work and source_bound
                    accepted <- (proof_tactic_simplify_with_shared_work(&replay_state, annotations, operator_mask, &solver_work, &preflight_work) can Global{Read,Write}) if shared_work and not source_bound
                    accepted <- (proof_tactic_simplify(&replay_state, annotations) can Global{Read,Write}) if not shared_work
                elif expected.action == "have":
                    accepted <- (proof_tactic_have_with_shared_work(&replay_state, expected.argument, annotations, operator_mask, &solver_work, &preflight_work) can Global{Read,Write}) if shared_work
                    accepted <- (proof_tactic_have(&replay_state, expected.argument, annotations) can Global{Read,Write}) if not shared_work
                elif expected.action == "instantiate":
                    accepted <- proof_tactic_instantiate(&replay_state, expected.argument_index, expected.argument, annotations)
                elif expected.action == "rewrite":
                    if expected.has_argument_index:
                        reverse: mutable bool = false
                        if expected.argument_index < replay_state.facts.count:
                            match proof_strip_parens(replay_state.facts[expected.argument_index]):
                                Ast::Expr.Binary(left, TokenKind.EqEq, right, _):
                                    is_forward: bool = proof_expr_equal(expected.argument, left) and proof_expr_equal(expected.secondary, right)
                                    reverse <- not is_forward and proof_expr_equal(expected.argument, right) and proof_expr_equal(expected.secondary, left)
                                _:
                                    pass
                        accepted <- (proof_tactic_rewrite_from_fact(&replay_state, expected.argument_index, reverse, annotations) can Global.Read)
                    else:
                        accepted <- (proof_tactic_rewrite(&replay_state, expected.argument, expected.secondary) can Global.Read)
                elif expected.action == "split":
                    split_left: mutable ProofTacticState = proof_tactic_state(&empty, Ast::Expr.BoolLit(false, Ast::pos_at_line(0)))
                    split_right: mutable ProofTacticState = proof_tactic_state(&empty, Ast::Expr.BoolLit(false, Ast::pos_at_line(0)))
                    accepted <- proof_tactic_split(&replay_state, &split_left, &split_right)
                elif expected.action == "left":
                    accepted <- proof_tactic_left(&replay_state)
                elif expected.action == "right":
                    accepted <- proof_tactic_right(&replay_state)
                elif expected.action == "cases":
                    cases_left: mutable ProofTacticState = proof_tactic_state(&empty, Ast::Expr.BoolLit(false, Ast::pos_at_line(0)))
                    cases_right: mutable ProofTacticState = proof_tactic_state(&empty, Ast::Expr.BoolLit(false, Ast::pos_at_line(0)))
                    accepted <- proof_tactic_cases(&replay_state, &cases_left, &cases_right)
                else:
                    return false
                return false if:
                    replay_state.trace.count != before_count + 1
                    accepted != expected.accepted
                    not proof_tactic_step_equal(replay_state.trace[before_count], expected)
            return proof_tactic_state_equal(replay_state, state)

        # Independently replay a solved tactic state through the source-neutral kernel. This
        # deliberately does not call `proof_goal` or any tactic implementation: AST expressions
        # are lowered into the canonical arena, then the independent replay module decides the
        # final proposition from those roots. Unsupported AST terms return false and can never
        # become a successful tactic certificate by accident.
        def proof_tactic_kernel_encode_annotated(expression: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&) -> usize:
            return proof_kernel_encode_annotated(expression, nodes, children, annotations)

        # Reserve source cost, support checking, encoding, emitted arena storage, and possible
        # quantifier annotation scans before either recursive kernel walk starts.
        def proof_tactic_kernel_trace_encode(expression: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, trace_work: mutable usize&) -> (known: bool, root: usize):
            node_start: usize = nodes.count
            return (false, node_start) if ElisaProofKernelReplay::proof_kernel_replay_tactic_trace_remaining_work(trace_work) == 0
            annotation_scan_work: mutable usize = 0
            for annotation in annotations |annotation, trace_work, annotation_scan_work|:
                return (false, node_start) if not ElisaProofKernelReplay::proof_kernel_replay_tactic_trace_charge_work(trace_work, 1)
                annotation_scan_work <- annotation_scan_work + 1
                owner_bytes: usize = sview_len(annotation.owner)
                return (false, node_start) if annotation_scan_work > PROOF_TACTIC_KERNEL_TRACE_AST_WORK_LIMIT - 4
                return (false, node_start) if owner_bytes > PROOF_TACTIC_KERNEL_TRACE_AST_WORK_LIMIT - 4 - annotation_scan_work
                return (false, node_start) if not ElisaProofKernelReplay::proof_kernel_replay_tactic_trace_charge_work(trace_work, owner_bytes)
                annotation_scan_work <- annotation_scan_work + owner_bytes
                name_bytes: usize = sview_len(annotation.name)
                return (false, node_start) if name_bytes > PROOF_TACTIC_KERNEL_TRACE_AST_WORK_LIMIT - 4 - annotation_scan_work
                return (false, node_start) if not ElisaProofKernelReplay::proof_kernel_replay_tactic_trace_charge_work(trace_work, name_bytes)
                annotation_scan_work <- annotation_scan_work + name_bytes
            remaining: usize = ElisaProofKernelReplay::proof_kernel_replay_tactic_trace_remaining_work(trace_work)
            if annotation_scan_work > PROOF_TACTIC_KERNEL_TRACE_AST_WORK_LIMIT - 4:
                return (false, node_start) if not ElisaProofKernelReplay::proof_kernel_replay_tactic_trace_charge_work(trace_work, remaining)
                return (false, node_start)
            passes: usize = annotation_scan_work + 4
            cost_limit: usize = remaining / passes
            if cost_limit == 0:
                return (false, node_start) if not ElisaProofKernelReplay::proof_kernel_replay_tactic_trace_charge_work(trace_work, remaining)
                return (false, node_start)
            ast_cost: mutable usize = 0
            if not proof_tactic_kernel_trace_ast_expr_cost_with_limit(expression, &ast_cost, cost_limit):
                return (false, node_start) if not ElisaProofKernelReplay::proof_kernel_replay_tactic_trace_charge_work(trace_work, remaining)
                return (false, node_start)
            if ast_cost > remaining / passes:
                return (false, node_start) if not ElisaProofKernelReplay::proof_kernel_replay_tactic_trace_charge_work(trace_work, remaining)
                return (false, node_start)
            reserved_work: usize = ast_cost * passes
            return (false, node_start) if not ElisaProofKernelReplay::proof_kernel_replay_tactic_trace_charge_work(trace_work, reserved_work)
            return (false, node_start) if not proof_kernel_expression_supported(expression)
            root: usize = proof_tactic_kernel_encode_annotated(expression, annotations, nodes, children)
            return (false, nodes.count) if root >= nodes.count
            return (true, root)

        # Imported AST handles may belong to a different store. Compare their canonical
        # arena terms with the reparsed state, preserving the ordered hypotheses as well as
        # the goal. A matching fact count alone does not bind a proof to a source obligation.
        # The CLI uses this kernel-only relation after reparsing the source state in a fresh store.
        # Cross-store source-state binding for JSON import shares the tree's kernel meter. Charge
        # the report arena copy before allocation, encode imported AST under the metered trace
        # encoder, and compare every ordered fact and the goal with the kernel's work-aware API.
        def proof_tactic_source_state_kernel_matches_with_trace_work(report: ProofReport&, goal_id: usize, facts: darray[Ast::Expr]&, goal: Ast::Expr, annotations: darray[Ast::EnumAnnotation]&, trace_work: mutable usize&) -> bool:
            return false if goal_id >= report.results.goal_attempts.count
            attempt: ProofGoalAttempt = report.results.goal_attempts[goal_id]
            match attempt.rule:
                "resource-safety":
                    return false
                "structural-safety":
                    return false
                _:
                    pass
            return false if:
                facts.count != attempt.facts_count or facts.count != attempt.kernel_facts_count
                attempt.facts_start > report.analysis_1.certificate_facts.count or attempt.facts_count > report.analysis_1.certificate_facts.count - attempt.facts_start
                attempt.kernel_facts_start > report.analysis_1.kernel.certificate_facts.count or attempt.kernel_facts_count > report.analysis_1.kernel.certificate_facts.count - attempt.kernel_facts_start
                attempt.kernel_goal >= report.analysis_1.kernel.nodes.count
            # Bound the temporary duplicate arena before allocating it. Charge conservative
            # storage units (256 per fixed-size node record, 8 per child index) alongside the
            # subsequent encoder/comparison work, so large imported source states fail closed.
            node_count: usize = report.analysis_1.kernel.nodes.count
            child_count: usize = report.analysis_1.kernel.children.count
            if node_count > ElisaProofKernelReplay::PROOF_KERNEL_REPLAY_TACTIC_TRACE_WORK_LIMIT / 256:
                trace_work <- ElisaProofKernelReplay::PROOF_KERNEL_REPLAY_TACTIC_TRACE_WORK_LIMIT + 1
                return false
            node_storage_work: usize = node_count * 256
            if child_count > (ElisaProofKernelReplay::PROOF_KERNEL_REPLAY_TACTIC_TRACE_WORK_LIMIT - node_storage_work) / 8:
                trace_work <- ElisaProofKernelReplay::PROOF_KERNEL_REPLAY_TACTIC_TRACE_WORK_LIMIT + 1
                return false
            storage_work: usize = node_storage_work + child_count * 8
            return false if:
                not ElisaProofKernelReplay::proof_kernel_replay_tactic_trace_charge_work(&trace_work, storage_work)
            nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
            children: mutable darray[usize] = []
            nodes.extend(report.analysis_1.kernel.nodes)
            children.extend(report.analysis_1.kernel.children)
            goal_root: (known: bool, root: usize) = proof_tactic_kernel_trace_encode(goal, annotations, &nodes, &children, trace_work)
            return false if not goal_root.known
            return false if not ElisaProofKernelReplay::proof_kernel_replay_tactic_trace_expr_equal(&nodes, &children, attempt.kernel_goal, goal_root.root, 0, &trace_work)
            for index in 0..<facts.count |index, report, attempt, facts, nodes, children, annotations, trace_work|:
                expected: usize = report.analysis_1.kernel.certificate_facts[attempt.kernel_facts_start + index]
                return false if expected >= report.analysis_1.kernel.nodes.count
                actual: (known: bool, root: usize) = proof_tactic_kernel_trace_encode(facts[index], annotations, &nodes, &children, trace_work)
                return false if not actual.known
                return false if not ElisaProofKernelReplay::proof_kernel_replay_tactic_trace_charge_work(&trace_work, 1)
                return false if not ElisaProofKernelReplay::proof_kernel_replay_tactic_trace_expr_equal(&nodes, &children, expected, actual.root, 0, &trace_work)
            return true

        def proof_tactic_source_state_kernel_matches(report: ProofReport&, goal_id: usize, facts: darray[Ast::Expr]&, goal: Ast::Expr) -> bool:
            trace_work: mutable usize = 0
            return proof_tactic_source_state_kernel_matches_with_trace_work(report, goal_id, facts, goal, report.source.source_annotations, &trace_work)

        # Same-store clients bind the exact source AST in addition to its kernel encoding. Reuse
        # the same meter for both relations so this stronger check stays within one call budget.
        def proof_tactic_source_state_matches(report: ProofReport&, goal_id: usize, facts: darray[Ast::Expr]&, goal: Ast::Expr) -> bool:
            trace_work: mutable usize = 0
            return false if not proof_tactic_source_state_kernel_matches_with_trace_work(report, goal_id, facts, goal, report.source.source_annotations, &trace_work)
            attempt: ProofGoalAttempt = report.results.goal_attempts[goal_id]
            return false if not proof_tactic_source_ast_comparison_reserve(facts, report.analysis_1.certificate_facts, attempt.facts_start, attempt.facts_count, goal, attempt.goal, &trace_work, ElisaProofKernelReplay::PROOF_KERNEL_REPLAY_TACTIC_TRACE_WORK_LIMIT)
            return false if not proof_expr_equal(goal, attempt.goal)
            for index in 0..<facts.count |index, facts, attempt, report|:
                return false if not proof_expr_equal(facts[index], report.analysis_1.certificate_facts[attempt.facts_start + index])
            return true

        def proof_tactic_kernel_replay(state: ProofTacticState&, annotations: darray[Ast::EnumAnnotation]&) -> bool can[Global.Read, Global.Write]:
            trace_work: mutable usize = 0
            return (proof_tactic_kernel_replay_with_trace_work(state, annotations, &trace_work) can Global{Read,Write})

        def proof_tactic_kernel_replay_with_trace_work(state: ProofTacticState&, annotations: darray[Ast::EnumAnnotation]&, trace_work: mutable usize&) -> bool can[Global.Read, Global.Write]:
            shape_cost: mutable usize = 0
            return false if not proof_tactic_state_budget_well_formed(state) or not state.solved
            return false if not proof_tactic_state_replay_ast_shape_reserve(state, &shape_cost, &trace_work, ElisaProofKernelReplay::PROOF_KERNEL_REPLAY_TACTIC_TRACE_WORK_LIMIT)
            nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
            children: mutable darray[usize] = []
            facts: mutable darray[usize] = []
            return false if not proof_tactic_kernel_encode_facts_with_trace_work(state.facts, annotations, &nodes, &children, &facts, trace_work)
            encoded_goal: (known: bool, root: usize) = proof_tactic_kernel_trace_encode(state.goal, annotations, nodes, children, trace_work)
            return false if not encoded_goal.known
            return (ElisaProofKernelReplay::proof_kernel_replay_goal_report_with_trace_work(&nodes, &children, facts, encoded_goal.root, &trace_work) can Global{Read,Write})

        # Lower and replay the complete tactic trace through the source-neutral transition
        # checker. Unlike `proof_tactic_replay`, this path never invokes a tactic implementation
        # or compares compiler AST values. Every snapshot and explicit argument is encoded into
        # one arena, then the independent kernel validates the action rule and the final mutable
        # state against the last certificate snapshot.
        def proof_tactic_kernel_encode_facts(source: darray[Ast::Expr]&, annotations: darray[Ast::EnumAnnotation]&, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, roots: mutable darray[usize]&) -> bool:
            for fact in source |fact, nodes, children, roots, annotations|:
                return false if not proof_kernel_expression_supported(fact)
                roots.push(proof_tactic_kernel_encode_annotated(fact, annotations, nodes, children))
            return true

        def proof_tactic_kernel_kernel_trace_work_admitted(trace_work: usize) -> bool:
            return ElisaProofKernelReplay::proof_kernel_replay_tactic_trace_remaining_work(trace_work) > 0

        def proof_tactic_kernel_encode_facts_with_trace_work(source: darray[Ast::Expr]&, annotations: darray[Ast::EnumAnnotation]&, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, roots: mutable darray[usize]&, trace_work: mutable usize&) -> bool:
            for fact in source |fact, nodes, children, roots, annotations, trace_work|:
                return false if not ElisaProofKernelReplay::proof_kernel_replay_tactic_trace_charge_work(trace_work, 1)
                encoded: (known: bool, root: usize) = proof_tactic_kernel_trace_encode(fact, annotations, nodes, children, trace_work)
                return false if not encoded.known
                roots.push(encoded.root)
            return true

        def proof_tactic_kernel_trace_replay(state: ProofTacticState&, annotations: darray[Ast::EnumAnnotation]&) -> bool can[Global.Read, Global.Write]:
            trace_work: mutable usize = 0
            return (proof_tactic_kernel_trace_replay_with_work(state, annotations, &trace_work) can Global{Read,Write})

        def proof_tactic_kernel_trace_replay_with_work(state: ProofTacticState&, annotations: darray[Ast::EnumAnnotation]&, trace_work: mutable usize&) -> bool can[Global.Read, Global.Write]:
            shape_cost: mutable usize = 0
            return false if not proof_tactic_state_budget_well_formed(state)
            return false if not proof_tactic_state_replay_ast_shape_reserve(state, &shape_cost, &trace_work, ElisaProofKernelReplay::PROOF_KERNEL_REPLAY_TACTIC_TRACE_WORK_LIMIT)
            nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
            children: mutable darray[usize] = []
            before_facts: mutable darray[usize] = []
            return false if not proof_tactic_kernel_kernel_trace_work_admitted(trace_work)
            return false if not proof_tactic_kernel_encode_facts_with_trace_work(state.initial_facts, annotations, &nodes, &children, &before_facts, trace_work)
            initial_goal: (known: bool, root: usize) = proof_tactic_kernel_trace_encode(state.initial_goal, annotations, nodes, children, trace_work)
            return false if not initial_goal.known
            before_goal: mutable usize = initial_goal.root
            before_solved: mutable bool = false
            snapshot_cursor: mutable usize = 0
            for expected in state.trace |expected, state, nodes, children, before_facts, before_goal, before_solved, snapshot_cursor, trace_work|:
                return false if:
                    not ElisaProofKernelReplay::proof_kernel_replay_tactic_trace_charge_work(trace_work, 1)
                    not ElisaProofKernelReplay::proof_kernel_replay_tactic_trace_charge_work(trace_work, sview_len(expected.action))
                    not ElisaProofKernelReplay::proof_kernel_replay_tactic_trace_charge_work(trace_work, sview_len(expected.detail))
                    not ElisaProofKernelReplay::proof_kernel_replay_tactic_trace_charge_work(trace_work, sview_len(expected.reason))
                return false if:
                    expected.facts_start != snapshot_cursor
                    expected.facts_start > state.trace_facts.count
                    expected.facts_count > state.trace_facts.count - expected.facts_start
                after_facts: mutable darray[usize] = []
                for index in 0..<expected.facts_count |index, expected, state, nodes, children, after_facts, annotations, trace_work|:
                    fact: Ast::Expr = state.trace_facts[expected.facts_start + index]
                    encoded_fact: (known: bool, root: usize) = proof_tactic_kernel_trace_encode(fact, annotations, nodes, children, trace_work)
                    return false if not encoded_fact.known
                    return false if not ElisaProofKernelReplay::proof_kernel_replay_tactic_trace_charge_work(trace_work, 1)
                    after_facts.push(encoded_fact.root)
                encoded_goal: (known: bool, root: usize) = proof_tactic_kernel_trace_encode(expected.goal, annotations, nodes, children, trace_work)
                return false if not encoded_goal.known
                after_goal: usize = encoded_goal.root
                argument: mutable usize = 0
                secondary: mutable usize = 0
                if expected.has_argument:
                    encoded_argument: (known: bool, root: usize) = proof_tactic_kernel_trace_encode(expected.argument, annotations, nodes, children, trace_work)
                    return false if not encoded_argument.known
                    argument <- encoded_argument.root
                if expected.has_secondary:
                    encoded_secondary: (known: bool, root: usize) = proof_tactic_kernel_trace_encode(expected.secondary, annotations, nodes, children, trace_work)
                    return false if not encoded_secondary.known
                    secondary <- encoded_secondary.root
                return false if not (ElisaProofKernelReplay::proof_kernel_replay_tactic_step_with_trace_work(&nodes, &children, expected.action, expected.accepted, before_solved, expected.solved, before_facts, before_goal, after_facts, after_goal, argument, expected.has_argument, secondary, expected.has_secondary, expected.argument_index, expected.has_argument_index, expected.detail, &trace_work) can Global{Read,Write})
                return false if not ElisaProofKernelReplay::proof_kernel_replay_tactic_trace_charge_work(trace_work, after_facts.count)
                before_facts <- []
                before_facts.extend(after_facts)
                before_goal <- after_goal
                before_solved <- expected.solved
                snapshot_cursor <- snapshot_cursor + expected.facts_count
            return false if snapshot_cursor != state.trace_facts.count
            final_facts: mutable darray[usize] = []
            return false if:
                not proof_tactic_kernel_encode_facts_with_trace_work(state.facts, annotations, nodes, children, final_facts, trace_work)
                final_facts.count != before_facts.count
            for index in 0..<final_facts.count |index, final_facts, before_facts, nodes, children, trace_work|:
                return false if not ElisaProofKernelReplay::proof_kernel_replay_tactic_trace_expr_equal(&nodes, &children, final_facts[index], before_facts[index], 0, &trace_work)
            encoded_final_goal: (known: bool, root: usize) = proof_tactic_kernel_trace_encode(state.goal, annotations, nodes, children, trace_work)
            return false if not encoded_final_goal.known
            final_goal: usize = encoded_final_goal.root
            return false if not ElisaProofKernelReplay::proof_kernel_replay_tactic_trace_expr_equal(&nodes, &children, final_goal, before_goal, 0, &trace_work)
            return state.solved == before_solved

        # Complete certificate admission for clients that require both dimensions at once:
        # source-neutral validation of every transition and independent proof of the solved
        # proposition. Partial/unsolved tactic states remain useful through the trace API but
        # cannot pass this final certificate boundary.
        def proof_tactic_kernel_certificate_replay(state: ProofTacticState&, annotations: darray[Ast::EnumAnnotation]&) -> bool:
            return (proof_tactic_kernel_trace_replay(state, annotations) can Global{Read,Write}) and (proof_tactic_kernel_replay(state, annotations) can Global{Read,Write})

        # Replay only the parent-to-child part of a branching proof. Keeping this relation separate
        # from child closure lets serialized proof trees compose branches recursively without
        # making the parent verifier trust the tactic interpreter's in-memory child references.
        def proof_tactic_kernel_branch_transition_replay(parent: ProofTacticState&, left: ProofTacticState&, right: ProofTacticState&, annotations: darray[Ast::EnumAnnotation]&) -> bool can[Global.Read, Global.Write]:
            trace_work: mutable usize = 0
            return (proof_tactic_kernel_branch_transition_replay_with_work(parent, left, right, annotations, &trace_work) can Global{Read,Write})

        def proof_tactic_kernel_branch_transition_replay_with_work(parent: ProofTacticState&, left: ProofTacticState&, right: ProofTacticState&, annotations: darray[Ast::EnumAnnotation]&, trace_work: mutable usize&) -> bool can[Global.Read, Global.Write]:
            return false if parent.trace.count == 0
            branch: ProofTacticStep = parent.trace[parent.trace.count - 1]
            left_shape_cost: mutable usize = 0
            right_shape_cost: mutable usize = 0
            return false if:
                not branch.accepted or (branch.action != "split" and branch.action != "cases")
                not proof_tactic_state_replay_ast_shape_reserve(left, &left_shape_cost, &trace_work, ElisaProofKernelReplay::PROOF_KERNEL_REPLAY_TACTIC_TRACE_WORK_LIMIT)
                not proof_tactic_state_replay_ast_shape_reserve(right, &right_shape_cost, &trace_work, ElisaProofKernelReplay::PROOF_KERNEL_REPLAY_TACTIC_TRACE_WORK_LIMIT)
                not (proof_tactic_kernel_trace_replay_with_work(parent, annotations, trace_work) can Global{Read,Write})
                not proof_tactic_branch_quota_matches(parent, branch, left, right)
            nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
            children: mutable darray[usize] = []
            parent_facts: mutable darray[usize] = []
            left_facts: mutable darray[usize] = []
            right_facts: mutable darray[usize] = []
            return false if:
                not proof_tactic_kernel_encode_facts_with_trace_work(parent.facts, annotations, &nodes, &children, &parent_facts, trace_work)
                not proof_tactic_kernel_encode_facts_with_trace_work(left.initial_facts, annotations, &nodes, &children, &left_facts, trace_work)
                not proof_tactic_kernel_encode_facts_with_trace_work(right.initial_facts, annotations, &nodes, &children, &right_facts, trace_work)
            parent_goal_encoded: (known: bool, root: usize) = proof_tactic_kernel_trace_encode(parent.goal, annotations, nodes, children, trace_work)
            left_goal_encoded: (known: bool, root: usize) = proof_tactic_kernel_trace_encode(left.initial_goal, annotations, nodes, children, trace_work)
            right_goal_encoded: (known: bool, root: usize) = proof_tactic_kernel_trace_encode(right.initial_goal, annotations, nodes, children, trace_work)
            return false if not parent_goal_encoded.known or not left_goal_encoded.known or not right_goal_encoded.known
            return (ElisaProofKernelReplay::proof_kernel_replay_tactic_branch_with_trace_work(&nodes, &children, branch.action, parent_facts, parent_goal_encoded.root, left_facts, left_goal_encoded.root, right_facts, right_goal_encoded.root, &trace_work) can Global{Read,Write})

        # Compose a completed branching proof. The parent trace proves that the branch action was
        # a valid state transition; the independent branch kernel below additionally binds both
        # child initial contexts to the parent's proposition and requires each child certificate
        # to close. This prevents separately valid child proofs from being attached to the wrong
        # conjunction or disjunction.
        def proof_tactic_kernel_branch_certificate_replay(parent: ProofTacticState&, left: ProofTacticState&, right: ProofTacticState&, annotations: darray[Ast::EnumAnnotation]&) -> bool:
            return false if not (proof_tactic_kernel_branch_transition_replay(parent, left, right, annotations) can Global{Read,Write})
            return (proof_tactic_kernel_certificate_replay(left, annotations) can Global{Read,Write}) and (proof_tactic_kernel_certificate_replay(right, annotations) can Global{Read,Write})
