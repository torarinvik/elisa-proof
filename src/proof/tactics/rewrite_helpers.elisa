# Recursive expression replacement used by the checked rewrite transitions.
extend ElisaProof:
    private:
        # Mirror the source-neutral kernel rewrite width rule. Integer literals are closed
        # constants, but the encoder currently emits them without a resolved width, so they
        # contribute no standalone key. Calls, conditionals, and non-arithmetic operators also
        # stay unknown here, matching strict_signed_width in kernel replay.
        def proof_tactic_rewrite_width_scan(expression: Ast::Expr, facts: darray[Ast::Expr]&, depth: usize) -> (width: i64, constant: bool, value: i64):
            empty: (width: i64, constant: bool, value: i64) = (0, false, 0)
            return empty if depth >= ElisaProofKernelCore::PROOF_KERNEL_REPLAY_DEPTH_LIMIT
            match expression:
                Ast::Expr.IntLit(value, _):
                    return (0, true, value)
                Ast::Expr.Paren(inner, _):
                    return proof_tactic_rewrite_width_scan(inner, facts, depth + 1)
                Ast::Expr.Unary(operator, operand, _):
                    inner: (width: i64, constant: bool, value: i64) = proof_tactic_rewrite_width_scan(operand, facts, depth + 1)
                    folded: (known: bool, value: i64) = proof_constant_unary(operator, inner.constant, inner.value)
                    width: i64 = inner.width if operator == TokenKind.Plus or operator == TokenKind.Minus else 0
                    return (width, folded.known, folded.value)
                Ast::Expr.Binary(left, operator, right, _):
                    left_scan: (width: i64, constant: bool, value: i64) = proof_tactic_rewrite_width_scan(left, facts, depth + 1)
                    right_scan: (width: i64, constant: bool, value: i64) = proof_tactic_rewrite_width_scan(right, facts, depth + 1)
                    folded: (known: bool, value: i64) = proof_constant_binary(operator, left_scan.constant, left_scan.value, right_scan.constant, right_scan.value)
                    arithmetic: bool = operator == TokenKind.Plus or operator == TokenKind.Minus or operator == TokenKind.Star or operator == TokenKind.Slash or operator == TokenKind.Percent
                    return (0, folded.known, folded.value) if not arithmetic or (left_scan.constant and right_scan.constant)
                    left_width: i64 = 0 if left_scan.constant else left_scan.width
                    right_width: i64 = 0 if right_scan.constant else right_scan.width
                    return (0, folded.known, folded.value) if:
                        (not left_scan.constant and left_width == 0) or (not right_scan.constant and right_width == 0)
                        left_width != 0 and right_width != 0 and left_width != right_width
                    width: i64 = left_width if left_width != 0 else right_width
                    return (width, folded.known, folded.value)
                Ast::Expr.Ident(_, _) or Ast::Expr.Field(_, _, _) or Ast::Expr.Index(_, _, _) or Ast::Expr.IndexN(_, _, _):
                    constant: (known: bool, value: i64) = proof_constant_int(expression)
                    return (proof_strict_signed_width(expression, facts, depth), constant.known, constant.value)
                _:
                    return empty

        def proof_tactic_rewrite_integer_width_key(expression: Ast::Expr, facts: darray[Ast::Expr]&) -> i64:
            proof_tactic_rewrite_width_scan(expression, facts, 0).width

        # Replace one exact subexpression at every supported expression node. The equality
        # itself must be an explicit fact; this keeps rewrite provenance visible and avoids
        # treating an arbitrary caller-supplied pair as a theorem.
        def proof_tactic_replace(expression: Ast::Expr, from: Ast::Expr, replacement: Ast::Expr) -> (changed: bool, value: Ast::Expr):
            return (true, replacement) if proof_expr_equal(expression, from)
            match expression:
                Ast::Expr.Paren(inner, position):
                    rewritten: (changed: bool, value: Ast::Expr) = proof_tactic_replace(inner, from, replacement)
                    return (true, Ast::Expr.Paren(rewritten.value, position)) if rewritten.changed
                Ast::Expr.Unary(operator, operand, position):
                    rewritten: (changed: bool, value: Ast::Expr) = proof_tactic_replace(operand, from, replacement)
                    return (true, Ast::Expr.Unary(operator, rewritten.value, position)) if rewritten.changed
                Ast::Expr.Binary(left, operator, right, position):
                    rewritten_left: (changed: bool, value: Ast::Expr) = proof_tactic_replace(left, from, replacement)
                    return (true, Ast::Expr.Binary(rewritten_left.value, operator, right, position)) if rewritten_left.changed
                    rewritten_right: (changed: bool, value: Ast::Expr) = proof_tactic_replace(right, from, replacement)
                    return (true, Ast::Expr.Binary(left, operator, rewritten_right.value, position)) if rewritten_right.changed
                Ast::Expr.Call(callee, arguments, argument_names, position):
                    rewritten_callee: (changed: bool, value: Ast::Expr) = proof_tactic_replace(callee, from, replacement)
                    return (true, Ast::Expr.Call(rewritten_callee.value, arguments, argument_names, position)) if rewritten_callee.changed
                    rewritten_arguments: mutable darray[Ast::Expr] = []
                    for argument in arguments |argument, rewritten_arguments, from, replacement|:
                        rewritten_argument: (changed: bool, value: Ast::Expr) = proof_tactic_replace(argument, from, replacement)
                        rewritten_arguments.push(rewritten_argument.value)
                        return (true, Ast::Expr.Call(callee, rewritten_arguments, argument_names, position)) if rewritten_argument.changed
                    return (false, expression)
                Ast::Expr.Field(object, field, position):
                    rewritten: (changed: bool, value: Ast::Expr) = proof_tactic_replace(object, from, replacement)
                    return (true, Ast::Expr.Field(rewritten.value, field, position)) if rewritten.changed
                Ast::Expr.Scope(base, field, position):
                    rewritten: (changed: bool, value: Ast::Expr) = proof_tactic_replace(base, from, replacement)
                    return (true, Ast::Expr.Scope(rewritten.value, field, position)) if rewritten.changed
                Ast::Expr.Index(object, index, position):
                    rewritten_object: (changed: bool, value: Ast::Expr) = proof_tactic_replace(object, from, replacement)
                    return (true, Ast::Expr.Index(rewritten_object.value, index, position)) if rewritten_object.changed
                    rewritten_index: (changed: bool, value: Ast::Expr) = proof_tactic_replace(index, from, replacement)
                    return (true, Ast::Expr.Index(object, rewritten_index.value, position)) if rewritten_index.changed
                Ast::Expr.Slice(object, low, high, position):
                    rewritten_object: (changed: bool, value: Ast::Expr) = proof_tactic_replace(object, from, replacement)
                    return (true, Ast::Expr.Slice(rewritten_object.value, low, high, position)) if rewritten_object.changed
                    rewritten_low: (changed: bool, value: Ast::Expr) = proof_tactic_replace(low, from, replacement)
                    return (true, Ast::Expr.Slice(object, rewritten_low.value, high, position)) if rewritten_low.changed
                    rewritten_high: (changed: bool, value: Ast::Expr) = proof_tactic_replace(high, from, replacement)
                    return (true, Ast::Expr.Slice(object, low, rewritten_high.value, position)) if rewritten_high.changed
                Ast::Expr.IndexN(object, arguments, position):
                    rewritten_object: (changed: bool, value: Ast::Expr) = proof_tactic_replace(object, from, replacement)
                    return (true, Ast::Expr.IndexN(rewritten_object.value, arguments, position)) if rewritten_object.changed
                    rewritten_arguments: mutable darray[Ast::Expr] = []
                    for argument in arguments |argument, rewritten_arguments, from, replacement|:
                        rewritten_argument: (changed: bool, value: Ast::Expr) = proof_tactic_replace(argument, from, replacement)
                        rewritten_arguments.push(rewritten_argument.value)
                        return (true, Ast::Expr.IndexN(object, rewritten_arguments, position)) if rewritten_argument.changed
                Ast::Expr.If(condition, then_expression, else_expression, position):
                    rewritten_condition: (changed: bool, value: Ast::Expr) = proof_tactic_replace(condition, from, replacement)
                    return (true, Ast::Expr.If(rewritten_condition.value, then_expression, else_expression, position)) if rewritten_condition.changed
                    rewritten_then: (changed: bool, value: Ast::Expr) = proof_tactic_replace(then_expression, from, replacement)
                    return (true, Ast::Expr.If(condition, rewritten_then.value, else_expression, position)) if rewritten_then.changed
                    rewritten_else: (changed: bool, value: Ast::Expr) = proof_tactic_replace(else_expression, from, replacement)
                    return (true, Ast::Expr.If(condition, then_expression, rewritten_else.value, position)) if rewritten_else.changed
                _:
                    pass
            return (false, expression)
