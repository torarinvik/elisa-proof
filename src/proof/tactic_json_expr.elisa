# JSON-to-AST reconstruction for expressions imported by tactic scripts.
# This module owns the wire-format-to-AST boundary, separate from tactic replay.
extend ElisaProof:
    public:
        const PROOF_JSON_MAX_ACTIONS: i64 = 65536
        const PROOF_JSON_EXPRESSION_WORK_LIMIT: usize = 16777216

        def proof_tactic_json_expression_charge(work_used: mutable usize&, amount: usize) -> bool:
            return false if work_used > PROOF_JSON_EXPRESSION_WORK_LIMIT
            if amount > PROOF_JSON_EXPRESSION_WORK_LIMIT - work_used:
                # Keep an explicit exhausted sentinel so optional missing fields cannot turn a
                # failed member-scan reservation into a successful partial decode.
                work_used <- PROOF_JSON_EXPRESSION_WORK_LIMIT + 1
                return false
            work_used <- work_used + amount
            return true

        # The JSON boundary checks key presence and then retrieves the value. Charge for both
        # possible member scans so duplicate and unknown object fields stay inside the same cap.
        def proof_tactic_json_field_with_work[@r](value: JsonValueHandle[r], key: sview, work_used: mutable usize&) -> (known: bool, value: JsonValueHandle[r]):
            missing: JsonValueHandle[r] = ElisaProofJson::null_value(value)
            return (false, missing) if not ElisaProofJson::is_object(value)
            member_count: i64 = ElisaProofJson::object_len(value)
            # Keep the signed-to-unsigned narrowing below within both the work cap and the
            # target usize range before converting the parser's i64 length.
            if member_count < 0 or member_count > PROOF_JSON_EXPRESSION_WORK_LIMIT:
                work_used <- PROOF_JSON_EXPRESSION_WORK_LIMIT + 1
                return (false, missing)
            return (false, missing) if not proof_tactic_json_member_scan_charge(value, member_count.usize(), 2, work_used)
            return proof_tactic_json_field(value, key)

        def proof_tactic_json_has_with_work[@r](value: JsonValueHandle[r], key: sview, work_used: mutable usize&) -> bool:
            return false if not ElisaProofJson::is_object(value)
            member_count: i64 = ElisaProofJson::object_len(value)
            if member_count < 0 or member_count > PROOF_JSON_EXPRESSION_WORK_LIMIT:
                work_used <- PROOF_JSON_EXPRESSION_WORK_LIMIT + 1
                return false
            return false if not proof_tactic_json_member_scan_charge(value, member_count.usize(), 1, work_used)
            return ElisaProofJson::has(value, key)

        # Runtime lookup compares each candidate key against the requested field name. Charge
        # every key's bytes as well as its member slot, including unknown and duplicate keys. This
        # pass measures key lengths once, then reserves them for `field`'s has+get scans or `has`.
        def proof_tactic_json_member_scan_charge[@r](value: JsonValueHandle[r], member_count: usize, runtime_scans: usize, work_used: mutable usize&) -> bool:
            scan_cost: mutable usize = 0
            for index in 0..<member_count |index, value, work_used, scan_cost|:
                key: sview = try ElisaProofJson::key_at(value, index.i64()) else:
                    work_used <- PROOF_JSON_EXPRESSION_WORK_LIMIT + 1
                    return false
                key_length: usize = sview_len(key)
                if key_length >= PROOF_JSON_EXPRESSION_WORK_LIMIT:
                    work_used <- PROOF_JSON_EXPRESSION_WORK_LIMIT + 1
                    return false
                member_cost: usize = key_length + 1
                if member_cost > PROOF_JSON_EXPRESSION_WORK_LIMIT - scan_cost:
                    work_used <- PROOF_JSON_EXPRESSION_WORK_LIMIT + 1
                    return false
                scan_cost <- scan_cost + member_cost
                return false if not proof_tactic_json_expression_charge(work_used, member_cost)
            for repetition in 0..<runtime_scans |repetition, scan_cost, work_used|:
                return false if not proof_tactic_json_expression_charge(work_used, scan_cost)
            return true

        def proof_tactic_json_expr_list[@r](value: JsonValueHandle[r], key: sview, line: u32, output: mutable darray[Ast::Expr]& @r) -> bool:
            work_used: mutable usize = 0
            return proof_tactic_json_expr_list_with_work(value, key, line, output, &work_used, 0)

        def proof_tactic_json_expr_list_with_work[@r](value: JsonValueHandle[r], key: sview, line: u32, output: mutable darray[Ast::Expr]& @r, work_used: mutable usize&, depth: usize) -> bool:
            field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(value, key, work_used)
            return false if not field.known or not ElisaProofJson::is_array(field.value)
            count: i64 = ElisaProofJson::array_len(field.value)
            return false if count < 0 or count > PROOF_JSON_MAX_ACTIONS
            for index in 0..<count |index, field, line, output, work_used, depth|:
                item: JsonValueHandle[r] = try ElisaProofJson::at(field.value, index) else ElisaProofJson::null_value(field.value)
                return false if not proof_tactic_json_expression_charge(work_used, 1)
                parsed: (known: bool, value: Ast::Expr) = proof_tactic_json_expr_with_work(item, work_used, depth)
                return false if not parsed.known
                output.push(parsed.value)
            return true

        def proof_tactic_json_text_list[@r](value: JsonValueHandle[r], key: sview, output: mutable darray[sview]& @r) -> bool:
            work_used: mutable usize = 0
            return proof_tactic_json_text_list_with_work(value, key, output, &work_used)

        def proof_tactic_json_text_list_with_work[@r](value: JsonValueHandle[r], key: sview, output: mutable darray[sview]& @r, work_used: mutable usize&) -> bool:
            field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(value, key, work_used)
            return false if not field.known or not ElisaProofJson::is_array(field.value)
            count: i64 = ElisaProofJson::array_len(field.value)
            return false if count < 0 or count > PROOF_JSON_MAX_ACTIONS
            for index in 0..<count |index, field, output, work_used|:
                item: JsonValueHandle[r] = try ElisaProofJson::at(field.value, index) else ElisaProofJson::null_value(field.value)
                parsed: (known: bool, value: sview) @r = proof_tactic_json_text(item)
                return false if not parsed.known or not proof_tactic_json_expression_charge(work_used, 1)
                output.push(parsed.value)
            return true

        def proof_tactic_json_fields[@r](value: JsonValueHandle[r], key: sview, line: u32, output: mutable darray[Ast::FieldInit]& @r) -> bool:
            work_used: mutable usize = 0
            return proof_tactic_json_fields_with_work(value, key, line, output, &work_used, 0)

        def proof_tactic_json_fields_with_work[@r](value: JsonValueHandle[r], key: sview, line: u32, output: mutable darray[Ast::FieldInit]& @r, work_used: mutable usize&, depth: usize) -> bool:
            field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(value, key, work_used)
            return false if not field.known or not ElisaProofJson::is_array(field.value)
            count: i64 = ElisaProofJson::array_len(field.value)
            return false if count < 0 or count > PROOF_JSON_MAX_ACTIONS
            for index in 0..<count |index, field, line, output, work_used, depth|:
                item: JsonValueHandle[r] = try ElisaProofJson::at(field.value, index) else ElisaProofJson::null_value(field.value)
                name_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(item, "name", work_used)
                value_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(item, "value", work_used)
                name: (known: bool, text: sview) @r = proof_tactic_json_text(name_field.value)
                return false if not proof_tactic_json_expression_charge(work_used, 1)
                parsed: (known: bool, value: Ast::Expr) = proof_tactic_json_expr_with_work(value_field.value, work_used, depth)
                return false if not name_field.known or not value_field.known or not name.known or not parsed.known
                output.push(Ast::FieldInit{name: name.text, value: parsed.value})
            return true

        def proof_tactic_json_entries[@r](value: JsonValueHandle[r], key: sview, output: mutable darray[Ast::DictEntry]& @r) -> bool:
            work_used: mutable usize = 0
            return proof_tactic_json_entries_with_work(value, key, output, &work_used, 0)

        def proof_tactic_json_entries_with_work[@r](value: JsonValueHandle[r], key: sview, output: mutable darray[Ast::DictEntry]& @r, work_used: mutable usize&, depth: usize) -> bool:
            field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(value, key, work_used)
            return false if not field.known or not ElisaProofJson::is_array(field.value)
            count: i64 = ElisaProofJson::array_len(field.value)
            return false if count < 0 or count > PROOF_JSON_MAX_ACTIONS
            for index in 0..<count |index, field, output, work_used, depth|:
                item: JsonValueHandle[r] = try ElisaProofJson::at(field.value, index) else ElisaProofJson::null_value(field.value)
                key_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(item, "key", work_used)
                value_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(item, "value", work_used)
                return false if not proof_tactic_json_expression_charge(work_used, 1)
                parsed_key: (known: bool, value: Ast::Expr) = proof_tactic_json_expr_with_work(key_field.value, work_used, depth)
                parsed_value: (known: bool, value: Ast::Expr) = proof_tactic_json_expr_with_work(value_field.value, work_used, depth)
                return false if not key_field.known or not value_field.known or not parsed_key.known or not parsed_value.known
                output.push(Ast::DictEntry{key: parsed_key.value, value: parsed_value.value})
            return true

        # Reconstruct the expression forms that the source-neutral kernel can consume. The
        # schema mirrors `proof_push_json_expr`; numeric literals retain line/column
        # keys for authoritative imported sort annotations. Other spans stay line-only.
        def proof_tactic_json_expr[@r](value: JsonValueHandle[r]) -> (known: bool, value: Ast::Expr):
            work_used: mutable usize = 0
            return proof_tactic_json_expr_with_work(value, &work_used, 0)

        # Treat exhausted work as an invalid decode even when it happened on an optional field
        # that the wire format permits to be absent.
        def proof_tactic_json_expr_with_work[@r](value: JsonValueHandle[r], work_used: mutable usize&, depth: usize) -> (known: bool, value: Ast::Expr):
            parsed: (known: bool, value: Ast::Expr) = proof_tactic_json_expr_with_work_impl(value, work_used, depth)
            return (false, Ast::Expr.Invalid) if work_used > PROOF_JSON_EXPRESSION_WORK_LIMIT
            return parsed

        def proof_tactic_json_expr_with_work_impl[@r](value: JsonValueHandle[r], work_used: mutable usize&, depth: usize) -> (known: bool, value: Ast::Expr):
            return (false, Ast::Expr.Invalid) if not ElisaProofKernelCore::depth_valid(depth) or not proof_tactic_json_expression_charge(work_used, 1)
            return (false, Ast::Expr.Invalid) if not ElisaProofJson::is_object(value)
            kind_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(value, "kind", work_used)
            kind: (known: bool, text: sview) @r = proof_tactic_json_text(kind_field.value)
            return (false, Ast::Expr.Invalid) if not kind_field.known or not kind.known
            return (false, Ast::Expr.Invalid) if not proof_tactic_json_expression_charge(work_used, sview_len(kind.text))
            line_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(value, "line", work_used)
            line: mutable u32 = 0
            if line_field.known:
                parsed_line: (known: bool, value: u32) = proof_tactic_json_line(line_field.value)
                return (false, Ast::Expr.Invalid) if not parsed_line.known
                line <- parsed_line.value
            position: Ast::Pos = Ast::pos_at_line(line)
            return (true, Ast::Expr.Invalid) if kind.text == "invalid"
            return (true, Ast::Expr.Absent) if kind.text == "absent"
            if kind.text == "int":
                column_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(value, "column", work_used)
                column: mutable u32 = 0
                if column_field.known:
                    parsed_column: (known: bool, value: u32) = proof_tactic_json_line(column_field.value)
                    return (false, Ast::Expr.Invalid) if not parsed_column.known
                    column <- parsed_column.value
                literal_position: Ast::Pos = Ast::Pos{line: line, column: column, offset: 0, end_line: line, end_column: column, end_offset: 0}
                number_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(value, "value", work_used)
                number: (known: bool, value: i64) = proof_tactic_json_integer(number_field.value)
                # An optional source offset names the literal whose recorded type (if any) the
                # source table supplies; the script itself can never state a type.
                offset_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(value, "offset", work_used)
                if offset_field.known:
                    offset: (known: bool, value: u32) = proof_tactic_json_line(offset_field.value)
                    return (false, Ast::Expr.Invalid) if not offset.known
                    located: Ast::Pos = Ast::Pos{line: line, column: column, offset: offset.value, end_line: line, end_column: column, end_offset: offset.value}
                    return (number_field.known and number.known, Ast::Expr.IntLit(number.value, located))
                return (number_field.known and number.known, Ast::Expr.IntLit(number.value, literal_position))
            if kind.text in {"float", "string", "char"}:
                text_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(value, "text", work_used)
                text: (known: bool, value: sview) @r = proof_tactic_json_text(text_field.value)
                return (false, Ast::Expr.Invalid) if not text_field.known or not text.known
                return (true, Ast::Expr.FloatLit(text.value, position)) if kind.text == "float"
                return (true, Ast::Expr.StringLit(text.value, position)) if kind.text == "string"
                return (true, Ast::Expr.CharLit(text.value, position))
            if kind.text == "bool":
                bool_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(value, "value", work_used)
                flag: (known: bool, value: bool) = proof_tactic_json_bool(bool_field.value)
                return (bool_field.known and flag.known, Ast::Expr.BoolLit(flag.value, position))
            if kind.text == "ident":
                name_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(value, "name", work_used)
                name: (known: bool, value: sview) @r = proof_tactic_json_text(name_field.value)
                return (name_field.known and name.known, Ast::Expr.Ident(name.value, position))
            if kind.text == "paren":
                inner_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(value, "inner", work_used)
                inner: (known: bool, value: Ast::Expr) = proof_tactic_json_expr_with_work(inner_field.value, work_used, depth + 1)
                return (inner_field.known and inner.known, Ast::Expr.Paren(inner.value, position))
            if kind.text == "unary":
                operator_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(value, "operator", work_used)
                operand_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(value, "operand", work_used)
                operator: (known: bool, value: TokenKind) = proof_tactic_json_operator(operator_field.value, work_used)
                operand: (known: bool, value: Ast::Expr) = proof_tactic_json_expr_with_work(operand_field.value, work_used, depth + 1)
                return (false, Ast::Expr.Invalid) if not operator_field.known or not operand_field.known or not operator.known or not operand.known
                return (true, Ast::Expr.Unary(operator.value, operand.value, position))
            if kind.text == "binary":
                operator_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(value, "operator", work_used)
                left_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(value, "left", work_used)
                right_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(value, "right", work_used)
                operator: (known: bool, value: TokenKind) = proof_tactic_json_operator(operator_field.value, work_used)
                left: (known: bool, value: Ast::Expr) = proof_tactic_json_expr_with_work(left_field.value, work_used, depth + 1)
                right: (known: bool, value: Ast::Expr) = proof_tactic_json_expr_with_work(right_field.value, work_used, depth + 1)
                return (false, Ast::Expr.Invalid) if not operator_field.known or not left_field.known or not right_field.known or not operator.known or not left.known or not right.known
                return (true, Ast::Expr.Binary(left.value, operator.value, right.value, position))
            if kind.text in {"field", "scope"}:
                object_key: sview = "object" if kind.text == "field" else "base"
                name_key: sview = "field" if kind.text == "field" else "name"
                object_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(value, object_key, work_used)
                name_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(value, name_key, work_used)
                object: (known: bool, value: Ast::Expr) = proof_tactic_json_expr_with_work(object_field.value, work_used, depth + 1)
                name: (known: bool, value: sview) @r = proof_tactic_json_text(name_field.value)
                return (false, Ast::Expr.Invalid) if not object_field.known or not name_field.known or not object.known or not name.known
                return (true, Ast::Expr.Field(object.value, name.value, position)) if kind.text == "field"
                return (true, Ast::Expr.Scope(object.value, name.value, position))
            if kind.text == "shorthand_member":
                parts: mutable darray[sview] = []
                return (false, Ast::Expr.Invalid) if not proof_tactic_json_text_list_with_work(value, "parts", &parts, work_used)
                return (true, Ast::Expr.ShorthandMember(parts, position))
            if kind.text in {"index", "slice"}:
                object_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(value, "object", work_used)
                object: (known: bool, value: Ast::Expr) = proof_tactic_json_expr_with_work(object_field.value, work_used, depth + 1)
                return (false, Ast::Expr.Invalid) if not object_field.known or not object.known
                if kind.text == "index":
                    index_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(value, "index", work_used)
                    index: (known: bool, value: Ast::Expr) = proof_tactic_json_expr_with_work(index_field.value, work_used, depth + 1)
                    return (index_field.known and index.known, Ast::Expr.Index(object.value, index.value, position))
                low_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(value, "low", work_used)
                high_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(value, "high", work_used)
                low: (known: bool, value: Ast::Expr) = proof_tactic_json_expr_with_work(low_field.value, work_used, depth + 1)
                high: (known: bool, value: Ast::Expr) = proof_tactic_json_expr_with_work(high_field.value, work_used, depth + 1)
                return (low_field.known and high_field.known and low.known and high.known, Ast::Expr.Slice(object.value, low.value, high.value, position))
            if kind.text == "index_n":
                object_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(value, "object", work_used)
                object: (known: bool, value: Ast::Expr) = proof_tactic_json_expr_with_work(object_field.value, work_used, depth + 1)
                arguments: mutable darray[Ast::Expr] = []
                return (false, Ast::Expr.Invalid) if not object_field.known or not object.known or not proof_tactic_json_expr_list_with_work(value, "arguments", line, &arguments, work_used, depth + 1)
                return (true, Ast::Expr.IndexN(object.value, arguments, position))
            if kind.text in {"move", "region_new"}:
                operand_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(value, "operand", work_used)
                operand: (known: bool, value: Ast::Expr) = proof_tactic_json_expr_with_work(operand_field.value, work_used, depth + 1)
                return (false, Ast::Expr.Invalid) if not operand_field.known or not operand.known
                if kind.text == "move":
                    return (true, Ast::Expr.Move(operand.value, position))
                region_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(value, "region", work_used)
                region: (known: bool, value: sview) @r = proof_tactic_json_text(region_field.value)
                return (false, Ast::Expr.Invalid) if not region_field.known or not region.known
                return (true, Ast::Expr.RegionNew(operand.value, region.value, position))
            if kind.text in {"array", "tuple", "set"}:
                elements: mutable darray[Ast::Expr] = []
                return (false, Ast::Expr.Invalid) if not proof_tactic_json_expr_list_with_work(value, "elements", line, &elements, work_used, depth + 1)
                return (true, Ast::Expr.Array(elements, position)) if kind.text == "array"
                return (true, Ast::Expr.Tuple(elements, position)) if kind.text == "tuple"
                return (true, Ast::Expr.SetLit(elements, position))
            if kind.text == "dict":
                entries: mutable darray[Ast::DictEntry] = []
                return (false, Ast::Expr.Invalid) if not proof_tactic_json_entries_with_work(value, "entries", &entries, work_used, depth + 1)
                return (true, Ast::Expr.DictLit(entries, position))
            if kind.text in {"construct", "record_update"}:
                type_key: sview = "type" if kind.text == "construct" else "base"
                type_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(value, type_key, work_used)
                base: (known: bool, value: Ast::Expr) = proof_tactic_json_expr_with_work(type_field.value, work_used, depth + 1)
                fields: mutable darray[Ast::FieldInit] = []
                return (false, Ast::Expr.Invalid) if not type_field.known or not base.known or not proof_tactic_json_fields_with_work(value, "fields", line, &fields, work_used, depth + 1)
                return (true, Ast::Expr.Construct(base.value, fields, position)) if kind.text == "construct"
                return (true, Ast::Expr.RecordUpdate(base.value, fields, position))
            if kind.text == "if":
                condition_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(value, "condition", work_used)
                then_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(value, "then", work_used)
                else_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(value, "else", work_used)
                condition: (known: bool, value: Ast::Expr) = proof_tactic_json_expr_with_work(condition_field.value, work_used, depth + 1)
                then_expr: (known: bool, value: Ast::Expr) = proof_tactic_json_expr_with_work(then_field.value, work_used, depth + 1)
                else_expr: (known: bool, value: Ast::Expr) = proof_tactic_json_expr_with_work(else_field.value, work_used, depth + 1)
                return (condition_field.known and then_field.known and else_field.known and condition.known and then_expr.known and else_expr.known, Ast::Expr.If(condition.value, then_expr.value, else_expr.value, position))
            if kind.text in {"comprehension", "refinement"}:
                if kind.text == "refinement":
                    base_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(value, "base", work_used)
                    predicate_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(value, "predicate", work_used)
                    base: (known: bool, value: Ast::Expr) = proof_tactic_json_expr_with_work(base_field.value, work_used, depth + 1)
                    predicate: (known: bool, value: Ast::Expr) = proof_tactic_json_expr_with_work(predicate_field.value, work_used, depth + 1)
                    return (base_field.known and predicate_field.known and base.known and predicate.known, Ast::Expr.Refinement(base.value, predicate.value, position))
                variable_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(value, "variable", work_used)
                iterable_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(value, "iterable", work_used)
                condition_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(value, "condition", work_used)
                body_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(value, "body", work_used)
                variable: (known: bool, value: sview) @r = proof_tactic_json_text(variable_field.value)
                iterable: (known: bool, value: Ast::Expr) = proof_tactic_json_expr_with_work(iterable_field.value, work_used, depth + 1)
                condition: (known: bool, value: Ast::Expr) = proof_tactic_json_expr_with_work(condition_field.value, work_used, depth + 1)
                body: (known: bool, value: Ast::Expr) = proof_tactic_json_expr_with_work(body_field.value, work_used, depth + 1)
                return (variable_field.known and iterable_field.known and condition_field.known and body_field.known and variable.known and iterable.known and condition.known and body.known, Ast::Expr.Comprehension(variable.value, iterable.value, condition.value, body.value, position))
            if kind.text == "block":
                # Quantifier propositions are represented by the compiler as a block containing
                # one or two binder declarations. Reconstruct only the exact declaration shape
                # emitted by proof_push_json_expr; unknown statements must not be silently
                # converted into a binder or an empty proposition.
                statements_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(value, "statements", work_used)
                value_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(value, "value", work_used)
                return (false, Ast::Expr.Invalid) if not statements_field.known or not value_field.known or not ElisaProofJson::is_array(statements_field.value)
                statement_count: i64 = ElisaProofJson::array_len(statements_field.value)
                return (false, Ast::Expr.Invalid) if statement_count < 0 or statement_count > ElisaProofKernelCore::PROOF_KERNEL_QUANTIFIER_MAX_STATEMENTS
                statements: mutable darray[Ast::Stmt] = []
                for statement_index in 0..<statement_count |statement_index, statements_field, statements, position, work_used, depth|:
                    return (false, Ast::Expr.Invalid) if not proof_tactic_json_expression_charge(work_used, 1)
                    statement_value: JsonValueHandle[r] = try ElisaProofJson::at(statements_field.value, statement_index) else ElisaProofJson::null_value(statements_field.value)
                    statement_kind_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(statement_value, "kind", work_used)
                    statement_kind: (known: bool, value: sview) @r = proof_tactic_json_text(statement_kind_field.value)
                    name_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(statement_value, "name", work_used)
                    type_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(statement_value, "type", work_used)
                    initializer_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(statement_value, "initializer", work_used)
                    name: (known: bool, value: sview) @r = proof_tactic_json_text(name_field.value)
                    type_expression: (known: bool, value: Ast::Expr) = proof_tactic_json_expr_with_work(type_field.value, work_used, depth + 1)
                    initializer: (known: bool, value: Ast::Expr) = proof_tactic_json_expr_with_work(initializer_field.value, work_used, depth + 1)
                    return (false, Ast::Expr.Invalid) if not statement_kind_field.known or not statement_kind.known or statement_kind.value != "var_decl" or not name_field.known or not type_field.known or not initializer_field.known or not name.known or not type_expression.known or not initializer.known
                    statements.push(Ast::Stmt.VarDecl(name.value, type_expression.value, initializer.value, position))
                body: (known: bool, value: Ast::Expr) = proof_tactic_json_expr_with_work(value_field.value, work_used, depth + 1)
                return (false, Ast::Expr.Invalid) if not body.known
                captures: mutable darray[sview] = []
                return (true, Ast::Expr.Block(statements, body.value, captures, position))
            if kind.text == "call":
                callee_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field_with_work(value, "callee", work_used)
                callee: (known: bool, value: Ast::Expr) = proof_tactic_json_expr_with_work(callee_field.value, work_used, depth + 1)
                arguments: mutable darray[Ast::Expr] = []
                names: mutable darray[sview] = []
                return (false, Ast::Expr.Invalid) if not callee_field.known or not callee.known or not proof_tactic_json_expr_list_with_work(value, "arguments", line, &arguments, work_used, depth + 1)
                has_names: bool = proof_tactic_json_has_with_work(value, "argument_names", work_used)
                return (false, Ast::Expr.Invalid) if work_used > PROOF_JSON_EXPRESSION_WORK_LIMIT
                names_ok: bool = proof_tactic_json_text_list_with_work(value, "argument_names", &names, work_used) if has_names else true
                # The compiler AST uses either an empty name vector for an all-positional call or
                # one slot aligned with every argument. Requiring a full vector rejected every
                # positional call, including the compiler type markers that carry declared widths
                # and primitive scalar types into a goal's hypotheses, so a source-bound script
                # could not import such a state at all. A partial vector stays rejected: it would
                # attach names to the wrong arguments.
                return (false, Ast::Expr.Invalid) if not names_ok or (names.count != 0 and names.count != arguments.count)
                return (true, Ast::Expr.Call(callee.value, arguments, names, position))
            return (false, Ast::Expr.Invalid)
