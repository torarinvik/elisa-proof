# JSON-to-AST reconstruction for expressions imported by tactic scripts.
# This module owns the wire-format-to-AST boundary, separate from tactic replay.
extend ElisaProof:
    public:
        const PROOF_JSON_MAX_ACTIONS: i64 = 65536

        def proof_tactic_json_expr_list[@r](value: JsonValueHandle[r], key: sview, line: u32, output: mutable darray[Ast::Expr]& @r) -> bool:
            field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(value, key)
            return false if not field.known or not ElisaProofJson::is_array(field.value)
            count: i64 = ElisaProofJson::array_len(field.value)
            return false if count < 0 or count > PROOF_JSON_MAX_ACTIONS
            for index in 0..<count |index, field, line, output|:
                item: JsonValueHandle[r] = try ElisaProofJson::at(field.value, index) else ElisaProofJson::null_value(field.value)
                parsed: (known: bool, value: Ast::Expr) = proof_tactic_json_expr(item)
                return false if not parsed.known
                output.push(parsed.value)
            return true

        def proof_tactic_json_text_list[@r](value: JsonValueHandle[r], key: sview, output: mutable darray[sview]& @r) -> bool:
            field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(value, key)
            return false if not field.known or not ElisaProofJson::is_array(field.value)
            count: i64 = ElisaProofJson::array_len(field.value)
            return false if count < 0 or count > PROOF_JSON_MAX_ACTIONS
            for index in 0..<count |index, field, output|:
                item: JsonValueHandle[r] = try ElisaProofJson::at(field.value, index) else ElisaProofJson::null_value(field.value)
                parsed: (known: bool, value: sview) @r = proof_tactic_json_text(item)
                return false if not parsed.known
                output.push(parsed.value)
            return true

        def proof_tactic_json_fields[@r](value: JsonValueHandle[r], key: sview, line: u32, output: mutable darray[Ast::FieldInit]& @r) -> bool:
            field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(value, key)
            return false if not field.known or not ElisaProofJson::is_array(field.value)
            count: i64 = ElisaProofJson::array_len(field.value)
            return false if count < 0 or count > PROOF_JSON_MAX_ACTIONS
            for index in 0..<count |index, field, line, output|:
                item: JsonValueHandle[r] = try ElisaProofJson::at(field.value, index) else ElisaProofJson::null_value(field.value)
                name_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(item, "name")
                value_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(item, "value")
                name: (known: bool, text: sview) @r = proof_tactic_json_text(name_field.value)
                parsed: (known: bool, value: Ast::Expr) = proof_tactic_json_expr(value_field.value)
                return false if not name_field.known or not value_field.known or not name.known or not parsed.known
                output.push(Ast::FieldInit{name: name.text, value: parsed.value})
            return true

        def proof_tactic_json_entries[@r](value: JsonValueHandle[r], key: sview, output: mutable darray[Ast::DictEntry]& @r) -> bool:
            field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(value, key)
            return false if not field.known or not ElisaProofJson::is_array(field.value)
            count: i64 = ElisaProofJson::array_len(field.value)
            return false if count < 0 or count > PROOF_JSON_MAX_ACTIONS
            for index in 0..<count |index, field, output|:
                item: JsonValueHandle[r] = try ElisaProofJson::at(field.value, index) else ElisaProofJson::null_value(field.value)
                key_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(item, "key")
                value_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(item, "value")
                parsed_key: (known: bool, value: Ast::Expr) = proof_tactic_json_expr(key_field.value)
                parsed_value: (known: bool, value: Ast::Expr) = proof_tactic_json_expr(value_field.value)
                return false if not key_field.known or not value_field.known or not parsed_key.known or not parsed_value.known
                output.push(Ast::DictEntry{key: parsed_key.value, value: parsed_value.value})
            return true

        # Reconstruct the expression forms that the source-neutral kernel can consume. The
        # schema mirrors `proof_push_json_expr`; numeric literals retain line/column
        # keys for authoritative imported sort annotations. Other spans stay line-only.
        def proof_tactic_json_expr[@r](value: JsonValueHandle[r]) -> (known: bool, value: Ast::Expr):
            return (false, Ast::Expr.Invalid) if not ElisaProofJson::is_object(value)
            kind_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(value, "kind")
            kind: (known: bool, text: sview) @r = proof_tactic_json_text(kind_field.value)
            return (false, Ast::Expr.Invalid) if not kind_field.known or not kind.known
            line_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(value, "line")
            line: mutable u32 = 0
            if line_field.known:
                parsed_line: (known: bool, value: u32) = proof_tactic_json_line(line_field.value)
                return (false, Ast::Expr.Invalid) if not parsed_line.known
                line <- parsed_line.value
            position: Ast::Pos = Ast::pos_at_line(line)
            return (true, Ast::Expr.Invalid) if kind.text == "invalid"
            return (true, Ast::Expr.Absent) if kind.text == "absent"
            if kind.text == "int":
                column_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(value, "column")
                column: mutable u32 = 0
                if column_field.known:
                    parsed_column: (known: bool, value: u32) = proof_tactic_json_line(column_field.value)
                    return (false, Ast::Expr.Invalid) if not parsed_column.known
                    column <- parsed_column.value
                literal_position: Ast::Pos = Ast::Pos{line: line, column: column, offset: 0, end_line: line, end_column: column, end_offset: 0}
                number_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(value, "value")
                number: (known: bool, value: i64) = proof_tactic_json_integer(number_field.value)
                return (number_field.known and number.known, Ast::Expr.IntLit(number.value, literal_position))
            if kind.text == "float" or kind.text == "string" or kind.text == "char":
                text_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(value, "text")
                text: (known: bool, value: sview) @r = proof_tactic_json_text(text_field.value)
                return (false, Ast::Expr.Invalid) if not text_field.known or not text.known
                return (true, Ast::Expr.FloatLit(text.value, position)) if kind.text == "float"
                return (true, Ast::Expr.StringLit(text.value, position)) if kind.text == "string"
                return (true, Ast::Expr.CharLit(text.value, position))
            if kind.text == "bool":
                bool_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(value, "value")
                flag: (known: bool, value: bool) = proof_tactic_json_bool(bool_field.value)
                return (bool_field.known and flag.known, Ast::Expr.BoolLit(flag.value, position))
            if kind.text == "ident":
                name_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(value, "name")
                name: (known: bool, value: sview) @r = proof_tactic_json_text(name_field.value)
                return (name_field.known and name.known, Ast::Expr.Ident(name.value, position))
            if kind.text == "paren":
                inner_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(value, "inner")
                inner: (known: bool, value: Ast::Expr) = proof_tactic_json_expr(inner_field.value)
                return (inner_field.known and inner.known, Ast::Expr.Paren(inner.value, position))
            if kind.text == "unary":
                operator_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(value, "operator")
                operand_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(value, "operand")
                operator: (known: bool, value: TokenKind) = proof_tactic_json_operator(operator_field.value)
                operand: (known: bool, value: Ast::Expr) = proof_tactic_json_expr(operand_field.value)
                return (false, Ast::Expr.Invalid) if not operator_field.known or not operand_field.known or not operator.known or not operand.known
                return (true, Ast::Expr.Unary(operator.value, operand.value, position))
            if kind.text == "binary":
                operator_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(value, "operator")
                left_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(value, "left")
                right_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(value, "right")
                operator: (known: bool, value: TokenKind) = proof_tactic_json_operator(operator_field.value)
                left: (known: bool, value: Ast::Expr) = proof_tactic_json_expr(left_field.value)
                right: (known: bool, value: Ast::Expr) = proof_tactic_json_expr(right_field.value)
                return (false, Ast::Expr.Invalid) if not operator_field.known or not left_field.known or not right_field.known or not operator.known or not left.known or not right.known
                return (true, Ast::Expr.Binary(left.value, operator.value, right.value, position))
            if kind.text == "field" or kind.text == "scope":
                object_key: sview = "object" if kind.text == "field" else "base"
                name_key: sview = "field" if kind.text == "field" else "name"
                object_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(value, object_key)
                name_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(value, name_key)
                object: (known: bool, value: Ast::Expr) = proof_tactic_json_expr(object_field.value)
                name: (known: bool, value: sview) @r = proof_tactic_json_text(name_field.value)
                return (false, Ast::Expr.Invalid) if not object_field.known or not name_field.known or not object.known or not name.known
                return (true, Ast::Expr.Field(object.value, name.value, position)) if kind.text == "field"
                return (true, Ast::Expr.Scope(object.value, name.value, position))
            if kind.text == "shorthand_member":
                parts: mutable darray[sview] = []
                return (false, Ast::Expr.Invalid) if not proof_tactic_json_text_list(value, "parts", &parts)
                return (true, Ast::Expr.ShorthandMember(parts, position))
            if kind.text == "index" or kind.text == "slice":
                object_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(value, "object")
                object: (known: bool, value: Ast::Expr) = proof_tactic_json_expr(object_field.value)
                return (false, Ast::Expr.Invalid) if not object_field.known or not object.known
                if kind.text == "index":
                    index_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(value, "index")
                    index: (known: bool, value: Ast::Expr) = proof_tactic_json_expr(index_field.value)
                    return (index_field.known and index.known, Ast::Expr.Index(object.value, index.value, position))
                low_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(value, "low")
                high_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(value, "high")
                low: (known: bool, value: Ast::Expr) = proof_tactic_json_expr(low_field.value)
                high: (known: bool, value: Ast::Expr) = proof_tactic_json_expr(high_field.value)
                return (low_field.known and high_field.known and low.known and high.known, Ast::Expr.Slice(object.value, low.value, high.value, position))
            if kind.text == "index_n":
                object_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(value, "object")
                object: (known: bool, value: Ast::Expr) = proof_tactic_json_expr(object_field.value)
                arguments: mutable darray[Ast::Expr] = []
                return (false, Ast::Expr.Invalid) if not object_field.known or not object.known or not proof_tactic_json_expr_list(value, "arguments", line, &arguments)
                return (true, Ast::Expr.IndexN(object.value, arguments, position))
            if kind.text == "move" or kind.text == "region_new":
                operand_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(value, "operand")
                operand: (known: bool, value: Ast::Expr) = proof_tactic_json_expr(operand_field.value)
                return (false, Ast::Expr.Invalid) if not operand_field.known or not operand.known
                if kind.text == "move":
                    return (true, Ast::Expr.Move(operand.value, position))
                region_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(value, "region")
                region: (known: bool, value: sview) @r = proof_tactic_json_text(region_field.value)
                return (false, Ast::Expr.Invalid) if not region_field.known or not region.known
                return (true, Ast::Expr.RegionNew(operand.value, region.value, position))
            if kind.text == "array" or kind.text == "tuple" or kind.text == "set":
                elements: mutable darray[Ast::Expr] = []
                return (false, Ast::Expr.Invalid) if not proof_tactic_json_expr_list(value, "elements", line, &elements)
                return (true, Ast::Expr.Array(elements, position)) if kind.text == "array"
                return (true, Ast::Expr.Tuple(elements, position)) if kind.text == "tuple"
                return (true, Ast::Expr.SetLit(elements, position))
            if kind.text == "dict":
                entries: mutable darray[Ast::DictEntry] = []
                return (false, Ast::Expr.Invalid) if not proof_tactic_json_entries(value, "entries", &entries)
                return (true, Ast::Expr.DictLit(entries, position))
            if kind.text == "construct" or kind.text == "record_update":
                type_key: sview = "type" if kind.text == "construct" else "base"
                type_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(value, type_key)
                base: (known: bool, value: Ast::Expr) = proof_tactic_json_expr(type_field.value)
                fields: mutable darray[Ast::FieldInit] = []
                return (false, Ast::Expr.Invalid) if not type_field.known or not base.known or not proof_tactic_json_fields(value, "fields", line, &fields)
                return (true, Ast::Expr.Construct(base.value, fields, position)) if kind.text == "construct"
                return (true, Ast::Expr.RecordUpdate(base.value, fields, position))
            if kind.text == "if":
                condition_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(value, "condition")
                then_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(value, "then")
                else_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(value, "else")
                condition: (known: bool, value: Ast::Expr) = proof_tactic_json_expr(condition_field.value)
                then_expr: (known: bool, value: Ast::Expr) = proof_tactic_json_expr(then_field.value)
                else_expr: (known: bool, value: Ast::Expr) = proof_tactic_json_expr(else_field.value)
                return (condition_field.known and then_field.known and else_field.known and condition.known and then_expr.known and else_expr.known, Ast::Expr.If(condition.value, then_expr.value, else_expr.value, position))
            if kind.text == "comprehension" or kind.text == "refinement":
                if kind.text == "refinement":
                    base_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(value, "base")
                    predicate_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(value, "predicate")
                    base: (known: bool, value: Ast::Expr) = proof_tactic_json_expr(base_field.value)
                    predicate: (known: bool, value: Ast::Expr) = proof_tactic_json_expr(predicate_field.value)
                    return (base_field.known and predicate_field.known and base.known and predicate.known, Ast::Expr.Refinement(base.value, predicate.value, position))
                variable_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(value, "variable")
                iterable_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(value, "iterable")
                condition_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(value, "condition")
                body_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(value, "body")
                variable: (known: bool, value: sview) @r = proof_tactic_json_text(variable_field.value)
                iterable: (known: bool, value: Ast::Expr) = proof_tactic_json_expr(iterable_field.value)
                condition: (known: bool, value: Ast::Expr) = proof_tactic_json_expr(condition_field.value)
                body: (known: bool, value: Ast::Expr) = proof_tactic_json_expr(body_field.value)
                return (variable_field.known and iterable_field.known and condition_field.known and body_field.known and variable.known and iterable.known and condition.known and body.known, Ast::Expr.Comprehension(variable.value, iterable.value, condition.value, body.value, position))
            if kind.text == "block":
                # Quantifier propositions are represented by the compiler as a block containing
                # one or two binder declarations. Reconstruct only the exact declaration shape
                # emitted by proof_push_json_expr; unknown statements must not be silently
                # converted into a binder or an empty proposition.
                statements_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(value, "statements")
                value_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(value, "value")
                return (false, Ast::Expr.Invalid) if not statements_field.known or not value_field.known or not ElisaProofJson::is_array(statements_field.value)
                statement_count: i64 = ElisaProofJson::array_len(statements_field.value)
                return (false, Ast::Expr.Invalid) if statement_count < 0 or statement_count > ElisaProofKernelCore::PROOF_KERNEL_QUANTIFIER_MAX_STATEMENTS
                statements: mutable darray[Ast::Stmt] = []
                for statement_index in 0..<statement_count |statement_index, statements_field, statements, position|:
                    statement_value: JsonValueHandle[r] = try ElisaProofJson::at(statements_field.value, statement_index) else ElisaProofJson::null_value(statements_field.value)
                    statement_kind_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(statement_value, "kind")
                    statement_kind: (known: bool, value: sview) @r = proof_tactic_json_text(statement_kind_field.value)
                    name_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(statement_value, "name")
                    type_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(statement_value, "type")
                    initializer_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(statement_value, "initializer")
                    name: (known: bool, value: sview) @r = proof_tactic_json_text(name_field.value)
                    type_expression: (known: bool, value: Ast::Expr) = proof_tactic_json_expr(type_field.value)
                    initializer: (known: bool, value: Ast::Expr) = proof_tactic_json_expr(initializer_field.value)
                    return (false, Ast::Expr.Invalid) if not statement_kind_field.known or not statement_kind.known or statement_kind.value != "var_decl" or not name_field.known or not type_field.known or not initializer_field.known or not name.known or not type_expression.known or not initializer.known
                    statements.push(Ast::Stmt.VarDecl(name.value, type_expression.value, initializer.value, position))
                body: (known: bool, value: Ast::Expr) = proof_tactic_json_expr(value_field.value)
                return (false, Ast::Expr.Invalid) if not body.known
                captures: mutable darray[sview] = []
                return (true, Ast::Expr.Block(statements, body.value, captures, position))
            if kind.text == "call":
                callee_field: (known: bool, value: JsonValueHandle[r]) = proof_tactic_json_field(value, "callee")
                callee: (known: bool, value: Ast::Expr) = proof_tactic_json_expr(callee_field.value)
                arguments: mutable darray[Ast::Expr] = []
                names: mutable darray[sview] = []
                return (false, Ast::Expr.Invalid) if not callee_field.known or not callee.known or not proof_tactic_json_expr_list(value, "arguments", line, &arguments)
                names_ok: bool = proof_tactic_json_text_list(value, "argument_names", &names) if ElisaProofJson::has(value, "argument_names") else true
                # The compiler AST uses either an empty name vector for an all-positional call or
                # one slot aligned with every argument. Requiring a full vector rejected every
                # positional call, including the compiler type markers that carry declared widths
                # and primitive scalar types into a goal's hypotheses, so a source-bound script
                # could not import such a state at all. A partial vector stays rejected: it would
                # attach names to the wrong arguments.
                return (false, Ast::Expr.Invalid) if not names_ok or (names.count != 0 and names.count != arguments.count)
                return (true, Ast::Expr.Call(callee.value, arguments, names, position))
            return (false, Ast::Expr.Invalid)
