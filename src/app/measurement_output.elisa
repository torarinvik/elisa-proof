# Compact, named resource measurements for a proof report.
#
# A report on a large source is tens of megabytes, which makes it a poor first stop when a run
# grows. This fixed-size object comes last and summarizes where the size went. Every value is
# derived from the finished report or from counters that no proof decision reads, so the section
# can only describe a verdict, never change one.

# How many certificate facts reuse a kernel root already listed earlier in the same certificate.
# Shared kernel terms make a repeated root a repeated proposition. The converse can fail: a term
# the producer does not share (one containing a quantifier) repeats under distinct roots.
def proof_measured_repeated_fact_roots(report: ProofReport&) -> (repeated: usize, largest: usize):
    repeated: mutable usize = 0
    largest: mutable usize = 0
    for certificate in report.certificates |report, repeated, largest|:
        largest <- certificate.kernel_facts_count if certificate.kernel_facts_count > largest
        continue if certificate.kernel_facts_count < 2
        start: usize = certificate.kernel_facts_start
        for offset in 1..<certificate.kernel_facts_count |offset, start, report, repeated|:
            root: usize = report.kernel_certificate_facts[start + offset]
            for earlier in 0..<offset |earlier, start, root, report, repeated|:
                if report.kernel_certificate_facts[start + earlier] == root:
                    repeated <- repeated + 1
                    break
    return (repeated, largest)

def proof_push_measurement(buffer: mutable darray[u8]&, name: sview, value: usize) -> void can[Memory.Allocate, Abort.Panic]:
    proof_push(buffer, ",\"")
    proof_push(buffer, name)
    proof_push(buffer, "\":")
    proof_push_number(buffer, value.u32())

# `report_start` is the buffer length where this report's object began, so `report_bytes`
# counts every byte serialized before this section.
def proof_push_json_measurements(buffer: mutable darray[u8]&, report: ProofReport&, report_start: usize) -> void can[Memory.Allocate, Abort.Panic]:
    report_bytes: usize = buffer.count - report_start
    facts: (repeated: usize, largest: usize) = proof_measured_repeated_fact_roots(report)
    proof_push(buffer, ",\"measurements\":{\"format\":\"elisa-proof-measurements-v1\"")
    proof_push_measurement(buffer, "declarations", report.declarations.usize())
    proof_push_measurement(buffer, "obligations", report.obligations.usize())
    proof_push_measurement(buffer, "goal_attempts", report.goal_attempts.count)
    proof_push_measurement(buffer, "certificates", report.certificates.count)
    proof_push_measurement(buffer, "certificate_facts", report.kernel_certificate_facts.count)
    proof_push_measurement(buffer, "largest_certificate_facts", facts.largest)
    proof_push_measurement(buffer, "repeated_certificate_fact_roots", facts.repeated)
    proof_push_measurement(buffer, "fact_traces", report.fact_traces.count)
    proof_push_measurement(buffer, "control_flow_steps", report.measured_control_flow_steps)
    proof_push_measurement(buffer, "live_facts_peak", report.measured_live_facts_peak)
    proof_push_measurement(buffer, "kernel_nodes", report.kernel_nodes.count)
    proof_push_measurement(buffer, "kernel_nodes_shared", report.kernel_interned_nodes)
    proof_push_measurement(buffer, "kernel_children", report.kernel_children.count)
    proof_push_measurement(buffer, "report_bytes", report_bytes)
    proof_push(buffer, "}")
