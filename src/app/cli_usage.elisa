def proof_print_usage() -> void can[Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast, Console]:
    usage: mutable darray[u8] = []
    proof_push(&usage, "usage: elisa-proof [--json|--summary-json|--theorems] <file.elisa> | --function-json <name> <file.elisa> | --goal <id> <file.elisa> | --proof <id> <file.elisa> | --check-proof <proof.txt> <file.elisa> | --script <proof.txt> <file.elisa> | --repair <id> <file.elisa> | --repair-all <file.elisa> | --suggest <id> <file.elisa> | --tactics <proof.json> <file.elisa> | --package <file.elisa> | --correspondence <package.json> <file.elisa>\n")
    proof_write(usage)
