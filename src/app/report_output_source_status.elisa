def proof_push_json_source_admission_status(buffer: mutable darray[u8]&, complete: bool, goal_admissions_complete: bool, admissible: bool) -> void:
    proof_push(buffer, "},\"complete\":")
    proof_push(buffer, "true" if complete else "false")
    proof_push(buffer, ",\"goal_admissions_complete\":")
    proof_push(buffer, "true" if goal_admissions_complete else "false")
    proof_push(buffer, ",\"admissible\":")
    proof_push(buffer, "true" if admissible else "false")
    proof_push(buffer, "}")
