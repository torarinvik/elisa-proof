const PROOF_REPAIR_JSON_NODE_BYTES: usize = 128
const PROOF_REPAIR_JSON_STATEMENT_BYTES: usize = 96
const PROOF_REPAIR_JSON_STRING_BYTES: usize = 6
const PROOF_REPAIR_JSON_DEPTH_LIMIT: usize = 64
const PROOF_REPAIR_JSON_WORK_LIMIT: usize = 32768

# Charge every AST node, collection item and string before the corresponding serializer visits it.
# The byte charge is deliberately larger than the JSON shape emitted for one node or statement;
# string bytes use the JSON worst case of six output bytes per input byte.
def proof_repair_json_budget_charge(work_left: mutable usize&, bytes_left: mutable usize&, bytes: usize) -> bool:
    return false if work_left == 0 or bytes > bytes_left
    work_left <- work_left - 1
    bytes_left <- bytes_left - bytes
    return true

def proof_repair_json_budget_string(value: sview, work_left: mutable usize&, bytes_left: mutable usize&) -> bool:
    return false if not proof_repair_json_budget_charge(work_left, bytes_left, 8)
    length: usize = sview_len(value)
    return false if length > bytes_left / PROOF_REPAIR_JSON_STRING_BYTES
    bytes_left <- bytes_left - length * PROOF_REPAIR_JSON_STRING_BYTES
    return true

def proof_repair_json_operator_supported(operator: TokenKind) -> bool:
    return operator == TokenKind.Plus or operator == TokenKind.Minus or operator == TokenKind.Star or operator == TokenKind.Slash or operator == TokenKind.Percent or operator == TokenKind.EqEq or operator == TokenKind.BangEq or operator == TokenKind.Lt or operator == TokenKind.Gt or operator == TokenKind.LtEq or operator == TokenKind.GtEq or operator == TokenKind.And or operator == TokenKind.Or or operator == TokenKind.FatArrow or operator == TokenKind.Not or operator == TokenKind.In or operator == TokenKind.Is or operator == TokenKind.As or operator == TokenKind.Pipe or operator == TokenKind.Caret or operator == TokenKind.Ampersand or operator == TokenKind.LShift or operator == TokenKind.RShift or operator == TokenKind.RangeLt or operator == TokenKind.RangeLe

def proof_repair_json_budget_expr(expression: Ast::Expr, depth: usize, work_left: mutable usize&, bytes_left: mutable usize&) -> bool:
    return false if depth >= PROOF_REPAIR_JSON_DEPTH_LIMIT
    return false if not proof_repair_json_budget_charge(work_left, bytes_left, PROOF_REPAIR_JSON_NODE_BYTES)
    match expression:
        Ast::Expr.Invalid | Ast::Expr.Absent | Ast::Expr.BoolLit(_, _):
            return true
        Ast::Expr.IntLit(value, _):
            return value >= -9007199254740991 and value <= 9007199254740991
        Ast::Expr.FloatLit(value, _):
            return proof_repair_json_budget_string(value, work_left, bytes_left)
        Ast::Expr.StringLit(value, _):
            return proof_repair_json_budget_string(value, work_left, bytes_left)
        Ast::Expr.CharLit(value, _):
            return proof_repair_json_budget_string(value, work_left, bytes_left)
        Ast::Expr.Ident(name, _):
            return proof_repair_json_budget_string(name, work_left, bytes_left)
        Ast::Expr.Paren(inner, _):
            return proof_repair_json_budget_expr(inner, depth + 1, work_left, bytes_left)
        Ast::Expr.Unary(operator, operand, _):
            return false if not proof_repair_json_operator_supported(operator)
            return proof_repair_json_budget_expr(operand, depth + 1, work_left, bytes_left)
        Ast::Expr.Binary(left, operator, right, _):
            return false if not proof_repair_json_operator_supported(operator)
            return false if not proof_repair_json_budget_expr(left, depth + 1, work_left, bytes_left)
            return proof_repair_json_budget_expr(right, depth + 1, work_left, bytes_left)
        Ast::Expr.Call(callee, arguments, argument_names, _):
            return false if argument_names.count != 0 and argument_names.count != arguments.count
            return false if not proof_repair_json_budget_expr(callee, depth + 1, work_left, bytes_left)
            for argument in arguments |depth, work_left, bytes_left|:
                return false if not proof_repair_json_budget_expr(argument, depth + 1, work_left, bytes_left)
            for name in argument_names |work_left, bytes_left|:
                return false if not proof_repair_json_budget_string(name, work_left, bytes_left)
            return true
        Ast::Expr.Field(object, field, _):
            return false if not proof_repair_json_budget_expr(object, depth + 1, work_left, bytes_left)
            return proof_repair_json_budget_string(field, work_left, bytes_left)
        Ast::Expr.Scope(base, field, _):
            return false if not proof_repair_json_budget_expr(base, depth + 1, work_left, bytes_left)
            return proof_repair_json_budget_string(field, work_left, bytes_left)
        Ast::Expr.ShorthandMember(parts, _):
            for part in parts |work_left, bytes_left|:
                return false if not proof_repair_json_budget_string(part, work_left, bytes_left)
            return true
        Ast::Expr.Index(object, index, _):
            return false if not proof_repair_json_budget_expr(object, depth + 1, work_left, bytes_left)
            return proof_repair_json_budget_expr(index, depth + 1, work_left, bytes_left)
        Ast::Expr.Slice(object, low, high, _):
            return false if not proof_repair_json_budget_expr(object, depth + 1, work_left, bytes_left)
            return false if not proof_repair_json_budget_expr(low, depth + 1, work_left, bytes_left)
            return proof_repair_json_budget_expr(high, depth + 1, work_left, bytes_left)
        Ast::Expr.IndexN(object, arguments, _):
            return false if not proof_repair_json_budget_expr(object, depth + 1, work_left, bytes_left)
            for argument in arguments |depth, work_left, bytes_left|:
                return false if not proof_repair_json_budget_expr(argument, depth + 1, work_left, bytes_left)
            return true
        Ast::Expr.Move(operand, _):
            return proof_repair_json_budget_expr(operand, depth + 1, work_left, bytes_left)
        Ast::Expr.RegionNew(operand, region, _):
            return false if not proof_repair_json_budget_expr(operand, depth + 1, work_left, bytes_left)
            return proof_repair_json_budget_string(region, work_left, bytes_left)
        Ast::Expr.Array(elements, _):
            for element in elements |depth, work_left, bytes_left|:
                return false if not proof_repair_json_budget_expr(element, depth + 1, work_left, bytes_left)
            return true
        Ast::Expr.Tuple(elements, _):
            for element in elements |depth, work_left, bytes_left|:
                return false if not proof_repair_json_budget_expr(element, depth + 1, work_left, bytes_left)
            return true
        Ast::Expr.SetLit(elements, _):
            for element in elements |depth, work_left, bytes_left|:
                return false if not proof_repair_json_budget_expr(element, depth + 1, work_left, bytes_left)
            return true
        Ast::Expr.DictLit(entries, _):
            for entry in entries |depth, work_left, bytes_left|:
                return false if not proof_repair_json_budget_expr(entry.key, depth + 1, work_left, bytes_left)
                return false if not proof_repair_json_budget_expr(entry.value, depth + 1, work_left, bytes_left)
            return true
        Ast::Expr.Construct(type_expression, fields, _):
            return false if not proof_repair_json_budget_expr(type_expression, depth + 1, work_left, bytes_left)
            for field in fields |depth, work_left, bytes_left|:
                return false if not proof_repair_json_budget_string(field.name, work_left, bytes_left)
                return false if not proof_repair_json_budget_expr(field.value, depth + 1, work_left, bytes_left)
            return true
        Ast::Expr.RecordUpdate(base, fields, _):
            return false if not proof_repair_json_budget_expr(base, depth + 1, work_left, bytes_left)
            for field in fields |depth, work_left, bytes_left|:
                return false if not proof_repair_json_budget_string(field.name, work_left, bytes_left)
                return false if not proof_repair_json_budget_expr(field.value, depth + 1, work_left, bytes_left)
            return true
        Ast::Expr.If(condition, then_expr, else_expr, _):
            return false if not proof_repair_json_budget_expr(condition, depth + 1, work_left, bytes_left)
            return false if not proof_repair_json_budget_expr(then_expr, depth + 1, work_left, bytes_left)
            return proof_repair_json_budget_expr(else_expr, depth + 1, work_left, bytes_left)
        Ast::Expr.Comprehension(variable, iterable, condition, body, _):
            return false if not proof_repair_json_budget_string(variable, work_left, bytes_left)
            return false if not proof_repair_json_budget_expr(iterable, depth + 1, work_left, bytes_left)
            return false if not proof_repair_json_budget_expr(condition, depth + 1, work_left, bytes_left)
            return proof_repair_json_budget_expr(body, depth + 1, work_left, bytes_left)
        Ast::Expr.Refinement(base, predicate, _):
            return false if not proof_repair_json_budget_expr(base, depth + 1, work_left, bytes_left)
            return proof_repair_json_budget_expr(predicate, depth + 1, work_left, bytes_left)
        Ast::Expr.Block(statements, value, _, _):
            return false if statements.count > ElisaProofKernelCore::PROOF_KERNEL_QUANTIFIER_MAX_STATEMENTS
            for statement in statements |depth, work_left, bytes_left|:
                return false if not proof_repair_json_budget_charge(work_left, bytes_left, PROOF_REPAIR_JSON_STATEMENT_BYTES)
                match statement:
                    Ast::Stmt.VarDecl(name, type_expression, initializer, _):
                        return false if not proof_repair_json_budget_string(name, work_left, bytes_left)
                        return false if not proof_repair_json_budget_expr(type_expression, depth + 1, work_left, bytes_left)
                        return false if not proof_repair_json_budget_expr(initializer, depth + 1, work_left, bytes_left)
                    _:
                        return false
            return proof_repair_json_budget_expr(value, depth + 1, work_left, bytes_left)
        _:
            return false

def proof_repair_json_expr_fits(expression: Ast::Expr, bytes_left: mutable usize&, work_left: mutable usize&) -> bool:
    return proof_repair_json_budget_expr(expression, 0, work_left, bytes_left)
