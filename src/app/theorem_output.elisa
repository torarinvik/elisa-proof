module ElisaProofTheoremOutput:
    private:
        const PROOF_THEOREM_OUTPUT_DEPTH_LIMIT: usize = 128

        def proof_declaration_name_is_unique(report: ProofReport&, name: sview, replay_work: mutable usize&) -> bool:
            matching_declarations: mutable usize = 0
            for declaration in report.analysis_1.declaration_details |report, name, matching_declarations, replay_work|:
                return false if not proof_replay_source_work_charge(1, replay_work)
                continue if declaration.kind != "function" and declaration.kind != "lemma"
                same_name: (complete: bool, equal: bool) = proof_output_text_equal_with_work(declaration.name, name, replay_work)
                return false if not same_name.complete
                matching_declarations <- matching_declarations + 1 if same_name.equal
                return false if matching_declarations > 1
            matching_declarations == 1

        def proof_declaration_gaps[@view](checked_view: ProofCheckedView[view]& @view, report: ProofReport&, name: sview, declaration_identity_unambiguous: bool, replay_work: mutable usize&) -> (complete: bool, replay_gap: bool, source_gap: bool):
            # Attempts currently carry a simple name, so ownership must be uniquely established.
            # Fail closed on duplicates or when the bounded lookup cannot finish.
            return (true, true, false) if not declaration_identity_unambiguous
            replay_gap: mutable bool = false
            source_gap: mutable bool = false
            for goal_id in 0..<report.results.goal_attempts.count |goal_id, checked_view, report, name, replay_gap, source_gap, replay_work|:
                attempt: ProofGoalAttempt = report.results.goal_attempts[goal_id]
                return (false, true, true) if not proof_output_reserve_status_snapshot_work(replay_work, 1)
                if attempt.proven:
                    same_name: (complete: bool, equal: bool) = proof_output_text_equal_with_work(attempt.name, name, replay_work)
                    return (false, true, true) if not same_name.complete
                    if same_name.equal:
                        # Match the two checked-view receipt reads to the reservation made by the
                        # bulk status snapshot, without rebuilding that per-goal snapshot here.
                        return (false, true, true) if not proof_output_reserve_status_snapshot_work(replay_work, 2)
                        replay_gap <- true if not proof_checked_view_attempt_status(checked_view, goal_id)
                        source_gap <- true if not proof_checked_view_goal_source_admissible(checked_view, goal_id)
            (true, replay_gap, source_gap)

        def proof_theorem_has_replay_gap(report: ProofReport&, theorem: ProofTheoremSummary, replayed_goals: darray[bool]&, source_admitted_goals: darray[bool]&, replay_work: mutable usize&) -> bool:
            return true if theorem.proof_goals_count == 0 or theorem.proof_goals_start > report.analysis_1.theorems.proof_goal_ids.count or theorem.proof_goals_count > report.analysis_1.theorems.proof_goal_ids.count - theorem.proof_goals_start
            for index in 0..<theorem.proof_goals_count |index, theorem, report, replayed_goals, source_admitted_goals, replay_work|:
                return true if not proof_replay_source_work_charge(1, replay_work)
                goal_id: usize = report.analysis_1.theorems.proof_goal_ids[theorem.proof_goals_start + index]
                return true if goal_id >= report.results.goal_attempts.count
                attempt: ProofGoalAttempt = report.results.goal_attempts[goal_id]
                same_name: (complete: bool, equal: bool) = proof_output_text_equal_with_work(attempt.name, theorem.name, replay_work)
                return true if:
                    not same_name.complete or not same_name.equal
                    attempt.proven and (not proof_output_cached_replay_status(replayed_goals, goal_id) or not proof_output_cached_source_admission_status(source_admitted_goals, goal_id))
            return false

        def proof_push_json_declaration[@view](buffer: mutable darray[u8]&, checked_view: ProofCheckedView[view]& @view, report: ProofReport&, declaration: ProofDeclarationSummary, source_clean: bool, declaration_identity_unambiguous: bool, source_admissions_complete: bool, replay_work: mutable usize&) -> bool can[Memory.Allocate, Abort.Panic]:
            proof_push(buffer, "{\"kind\":")
            proof_push_json_string(buffer, declaration.kind)
            proof_push(buffer, ",\"name\":")
            proof_push_json_string(buffer, declaration.name)
            proof_push(buffer, ",\"line\":")
            proof_push_number(buffer, declaration.line)
            proof_push(buffer, ",\"parameters\":[")
            valid_parameter_range: bool = declaration.parameters_start <= report.analysis_1.declaration_parameters.count and declaration.parameters_count <= report.analysis_1.declaration_parameters.count - declaration.parameters_start
            if valid_parameter_range:
                for index in 0..<declaration.parameters_count |index, declaration, report, buffer|:
                    proof_push(buffer, ",") if index > 0
                    proof_push_json_string(buffer, report.analysis_1.declaration_parameters[declaration.parameters_start + index])
            proof_push(buffer, "],\"effects\":")
            if declaration.effects_declared:
                proof_push(buffer, "[")
                valid_effect_range: bool = declaration.effects_start <= report.analysis_1.declaration_effects.count and declaration.effects_count <= report.analysis_1.declaration_effects.count - declaration.effects_start
                if valid_effect_range:
                    for index in 0..<declaration.effects_count |index, declaration, report, buffer|:
                        proof_push(buffer, ",") if index > 0
                        proof_push_json_string(buffer, report.analysis_1.declaration_effects[declaration.effects_start + index])
                proof_push(buffer, "]")
            else:
                proof_push(buffer, "null")
            proof_push(buffer, ",\"requires\":")
            proof_push_number(buffer, declaration.requires_count.u32())
            proof_push(buffer, ",\"ensures\":")
            proof_push_number(buffer, declaration.ensures_count.u32())
            proof_push(buffer, ",\"changes\":")
            proof_push_number(buffer, declaration.changes_count.u32())
            proof_push(buffer, ",\"preserves\":")
            proof_push_number(buffer, declaration.preserves_count.u32())
            proof_push(buffer, ",\"decreases\":")
            proof_push_number(buffer, declaration.decreases_count.u32())
            proof_push(buffer, ",\"lemma\":")
            proof_push(buffer, "true" if declaration.lemma else "false")
            proof_push(buffer, ",\"recursive\":")
            proof_push(buffer, "true" if declaration.recursive else "false")
            proof_push(buffer, ",\"pure\":")
            proof_push(buffer, "true" if declaration.pure else "false")
            proof_push(buffer, ",\"verified\":")
            source_refused: bool = declaration.verified and not source_clean
            declaration_gaps: (complete: bool, replay_gap: bool, source_gap: bool) = proof_declaration_gaps(checked_view, report, declaration.name, declaration_identity_unambiguous, replay_work)
            replay_gap: bool = declaration.verified and source_clean and declaration_gaps.replay_gap
            source_gap: bool = declaration.verified and source_clean and declaration_gaps.source_gap
            proof_push(buffer, "true" if declaration.verified and source_clean and source_admissions_complete and declaration_gaps.complete and not replay_gap and not source_gap else "false")
            proof_push(buffer, ",\"verification_reason\":")
            proof_push_json_string(buffer, "source-error" if source_refused else ("source-admission-incomplete" if declaration.verified and source_clean and not source_admissions_complete else ("output-work-limit" if declaration.verified and source_clean and not declaration_gaps.complete else ("source-unbound" if source_gap else ("replay-gap" if replay_gap else declaration.verification_reason)))))
            proof_push(buffer, ",\"structural\":")
            proof_push(buffer, "true" if declaration.structural else "false")
            proof_push(buffer, "}")
            return declaration_gaps.complete

        def proof_push_json_theorem(buffer: mutable darray[u8]&, report: ProofReport&, theorem: ProofTheoremSummary, declaration_identity_unambiguous: bool, theorem_source_admissible: bool, source_input_error: bool, replayed_goals: darray[bool]&, source_admitted_goals: darray[bool]&, source_admissions_complete: bool, replay_work: mutable usize&) -> void can[Memory.Allocate, Abort.Panic]:
            valid_parameters: bool = theorem.parameters_start <= report.analysis_1.theorems.parameters.count and theorem.parameters_count <= report.analysis_1.theorems.parameters.count - theorem.parameters_start and theorem.parameters_start <= report.analysis_1.theorems.parameter_types.count and theorem.parameters_count <= report.analysis_1.theorems.parameter_types.count - theorem.parameters_start and theorem.parameters_start <= report.analysis_1.theorems.parameter_has_defaults.count and theorem.parameters_count <= report.analysis_1.theorems.parameter_has_defaults.count - theorem.parameters_start and theorem.parameters_start <= report.analysis_1.theorems.parameter_defaults.count and theorem.parameters_count <= report.analysis_1.theorems.parameter_defaults.count - theorem.parameters_start
            valid_requires: bool = theorem.requires_start <= report.analysis_1.theorems.requires.count and theorem.requires_count <= report.analysis_1.theorems.requires.count - theorem.requires_start
            valid_ensures: bool = theorem.ensures_start <= report.analysis_1.theorems.ensures.count and theorem.ensures_count <= report.analysis_1.theorems.ensures.count - theorem.ensures_start
            valid_decreases: bool = theorem.decreases_start <= report.analysis_1.theorems.decreases.count and theorem.decreases_count <= report.analysis_1.theorems.decreases.count - theorem.decreases_start
            valid_proof_goals: bool = declaration_identity_unambiguous and theorem.proof_goals_start <= report.analysis_1.theorems.proof_goal_ids.count and theorem.proof_goals_count <= report.analysis_1.theorems.proof_goal_ids.count - theorem.proof_goals_start
            signature_valid: bool = valid_parameters and valid_requires and valid_ensures and valid_decreases
            proof_replay_complete: mutable bool = theorem.verified and valid_proof_goals and theorem.proof_goals_count > 0
            theorem_replayed_goals: mutable darray[bool] = []
            if valid_proof_goals:
                for index in 0..<theorem.proof_goals_count |index, theorem, report, proof_replay_complete, theorem_replayed_goals, replayed_goals, source_admitted_goals, replay_work|:
                    goal_id: usize = report.analysis_1.theorems.proof_goal_ids[theorem.proof_goals_start + index]
                    if goal_id >= report.results.goal_attempts.count:
                        proof_replay_complete <- false
                        theorem_replayed_goals.push(false)
                    else:
                        attempt: ProofGoalAttempt = report.results.goal_attempts[goal_id]
                        lookup_within_budget: bool = proof_replay_source_work_charge(1, replay_work)
                        replayed: bool = attempt.proven and lookup_within_budget and proof_output_cached_replay_status(replayed_goals, goal_id)
                        theorem_replayed_goals.push(replayed)
                        proof_replay_complete <- false if not replayed
            proof_push(buffer, "{\"name\":")
            proof_push_json_string(buffer, theorem.name)
            proof_push(buffer, ",\"theorem_fingerprint\":")
            theorem_fingerprint: (valid: bool, value: u32) = proof_theorem_fingerprint(report, theorem)
            if theorem_fingerprint.valid:
                proof_push(buffer, "{\"algorithm\":\"fnv1a32-kernel-theorem-v2\",\"value\":")
                proof_push_number(buffer, theorem_fingerprint.value)
                proof_push(buffer, "}")
            else:
                proof_push(buffer, "null")
            proof_push(buffer, ",\"line\":")
            proof_push_number(buffer, theorem.line)
            kernel_verified: bool = theorem.verified and proof_replay_complete
            proof_push(buffer, ",\"verified\":")
            source_claim_admissible: bool = theorem_source_admissible and source_admissions_complete and declaration_identity_unambiguous and valid_proof_goals
            proof_push(buffer, "true" if kernel_verified and source_claim_admissible else "false")
            proof_push(buffer, ",\"verification_reason\":")
            verification_reason: sview = "source-error" if theorem.verified and source_input_error else ("source-admission-incomplete" if theorem.verified and not source_admissions_complete else ("declaration-identity-unavailable" if theorem.verified and not declaration_identity_unambiguous else ("source-unbound" if theorem.verified and declaration_identity_unambiguous and not source_claim_admissible else ("replay-gap" if theorem.verified and not proof_replay_complete else theorem.verification_reason))))
            proof_push_json_string(buffer, verification_reason)
            proof_push(buffer, ",\"recursive\":")
            proof_push(buffer, "true" if theorem.recursive else "false")
            proof_push(buffer, ",\"signature_valid\":")
            proof_push(buffer, "true" if signature_valid else "false")
            proof_push(buffer, ",\"proof_replay_complete\":")
            proof_push(buffer, "true" if proof_replay_complete else "false")
            proof_push(buffer, ",\"kernel_verified\":")
            proof_push(buffer, "true" if kernel_verified else "false")
            proof_push(buffer, ",\"source_claim_admissible\":")
            proof_push(buffer, "true" if source_claim_admissible else "false")
            proof_push(buffer, ",\"proof_goals_valid\":")
            proof_push(buffer, "true" if valid_proof_goals else "false")
            proof_push(buffer, ",\"parameters\":[")
            if valid_parameters:
                for index in 0..<theorem.parameters_count |index, theorem, report, buffer|:
                    proof_push(buffer, ",") if index > 0
                    proof_push_json_string(buffer, report.analysis_1.theorems.parameters[theorem.parameters_start + index])
            proof_push(buffer, "],\"parameter_defaults\":[")
            if valid_parameters:
                for index in 0..<theorem.parameters_count |index, theorem, report, buffer|:
                    proof_push(buffer, ",") if index > 0
                    parameter_index: usize = theorem.parameters_start + index
                    if report.analysis_1.theorems.parameter_has_defaults[parameter_index]:
                        proof_push_json_expr(buffer, report.analysis_1.theorems.parameter_defaults[parameter_index])
                    else:
                        proof_push(buffer, "null")
            proof_push(buffer, "],\"parameter_types\":[")
            if valid_parameters:
                for index in 0..<theorem.parameters_count |index, theorem, report, buffer|:
                    proof_push(buffer, ",") if index > 0
                    proof_push_json_expr(buffer, report.analysis_1.theorems.parameter_types[theorem.parameters_start + index])
            proof_push(buffer, "],\"requires\":[")
            if valid_requires:
                for index in 0..<theorem.requires_count |index, theorem, report, buffer|:
                    proof_push(buffer, ",") if index > 0
                    proof_push_json_expr(buffer, report.analysis_1.theorems.requires[theorem.requires_start + index])
            proof_push(buffer, "],\"ensures\":[")
            if valid_ensures:
                for index in 0..<theorem.ensures_count |index, theorem, report, buffer|:
                    proof_push(buffer, ",") if index > 0
                    proof_push_json_expr(buffer, report.analysis_1.theorems.ensures[theorem.ensures_start + index])
            proof_push(buffer, "],\"decreases\":[")
            if valid_decreases:
                for index in 0..<theorem.decreases_count |index, theorem, report, buffer|:
                    proof_push(buffer, ",") if index > 0
                    proof_push_json_expr(buffer, report.analysis_1.theorems.decreases[theorem.decreases_start + index])
            proof_push(buffer, "],\"proof_goals\":[")
            if valid_proof_goals:
                for index in 0..<theorem.proof_goals_count |index, theorem, report, buffer, theorem_replayed_goals, source_admitted_goals, source_admissions_complete|:
                    proof_push(buffer, ",") if index > 0
                    goal_id: usize = report.analysis_1.theorems.proof_goal_ids[theorem.proof_goals_start + index]
                    proof_push(buffer, "{\"goal_id\":")
                    proof_push_number(buffer, goal_id.u32())
                    if goal_id < report.results.goal_attempts.count:
                        attempt: ProofGoalAttempt = report.results.goal_attempts[goal_id]
                        replayed: bool = theorem_replayed_goals[index]
                        proof_push(buffer, ",\"rule\":")
                        proof_push_json_string(buffer, attempt.rule)
                        proof_push(buffer, ",\"proven\":")
                        proof_push(buffer, "true" if attempt.proven and replayed and proof_output_cached_source_admission_status(source_admitted_goals, goal_id) else "false")
                        proof_push(buffer, ",\"certificate_id\":")
                        proof_push_number(buffer, attempt.certificate_index.u32()) if attempt.has_certificate and attempt.certificate_index < report.analysis_1.certificates.count else proof_push(buffer, "null")
                        proof_push(buffer, ",\"replayed\":")
                        proof_push(buffer, "true" if replayed else "false")
                        proof_push(buffer, ",\"source_admission\":")
                        proof_push_json_string(buffer, "unknown" if not source_admissions_complete else ("admitted" if proof_output_cached_source_admission_status(source_admitted_goals, goal_id) else "source-unbound"))
                    proof_push(buffer, "}")
            proof_push(buffer, "]}")

    public:
        # Declaration details have one checked-view entrypoint. It derives replay and
        # source status from the capability and keeps raw report emitters private.
        def proof_push_json_declaration_details_with_replayed[@view](buffer: mutable darray[u8]&, checked_view: ProofCheckedView[view]& @view, replay_work: mutable usize&) -> bool can[Memory.Allocate, Abort.Panic]:
            report: ProofReport& = proof_checked_view_report(checked_view)
            source_clean: bool = not proof_checked_view_import_failed(checked_view) and proof_checked_view_semantic_errors(checked_view) == 0
            identity_snapshot: (complete: bool, statuses: darray[bool]) = proof_report_declaration_identity_statuses(report, replay_work)
            source_admissions_complete: bool = proof_checked_view_source_admissions_complete(checked_view) and identity_snapshot.complete
            declaration_identity_statuses: darray[bool] = identity_snapshot.statuses
            declaration_details_complete: mutable bool = identity_snapshot.complete
            proof_push(buffer, "[")
            for index in 0..<report.analysis_1.declaration_details.count |index, checked_view, report, buffer, source_clean, source_admissions_complete, declaration_identity_statuses, declaration_details_complete, replay_work|:
                proof_push(buffer, ",") if index > 0
                declaration_identity_unambiguous: bool = index < declaration_identity_statuses.count and declaration_identity_statuses[index]
                details_complete: bool = proof_push_json_declaration(buffer, checked_view, report, report.analysis_1.declaration_details[index], source_clean, declaration_identity_unambiguous, source_admissions_complete, replay_work)
                declaration_details_complete <- false if not details_complete
            proof_push(buffer, "]")
            return declaration_details_complete

        def proof_push_json_theorem_catalog_with_replayed[@view, @buffer](buffer: mutable darray[u8]& @buffer, checked_view: ProofCheckedView[view]& @view, replay_work: mutable usize&) -> bool can[Memory.Allocate, Abort.Panic]:
            report: ProofReport& = proof_checked_view_report(checked_view)
            source_bytes: usize = proof_checked_view_source_bytes(checked_view)
            source_fingerprint: u32 = proof_checked_view_source_fingerprint(checked_view)
            source_complete: bool = proof_checked_view_source_complete(checked_view)
            source_admissible: bool = proof_checked_view_source_admissible(checked_view)
            goal_status_snapshot: (complete: bool, replayed_goals: darray[bool], source_admitted_goals: darray[bool]) = proof_output_checked_view_goal_statuses_with_work(checked_view, replay_work)
            source_goal_statuses: darray[bool] = goal_status_snapshot.source_admitted_goals
            replayed_goals: darray[bool] = goal_status_snapshot.replayed_goals
            source_admissions_complete: bool = proof_checked_view_source_admissions_complete(checked_view) and goal_status_snapshot.complete
            source_input_error: bool = proof_checked_view_import_failed(checked_view) or proof_checked_view_semantic_errors(checked_view) != 0
            proof_push(buffer, "{\"format\":\"elisa-proof-theorems-v1\",\"source\":{\"bytes\":")
            proof_push_number(buffer, source_bytes.u32())
            proof_push(buffer, ",\"fingerprint\":{\"algorithm\":\"fnv1a32\",\"value\":")
            proof_push_number(buffer, source_fingerprint)
            proof_push(buffer, "},\"complete\":")
            proof_push(buffer, "true" if source_complete else "false")
            proof_push(buffer, ",\"goal_admissions_complete\":")
            proof_push(buffer, "true" if source_admissions_complete else "false")
            proof_push(buffer, ",\"admissible\":")
            proof_push(buffer, "true" if source_admissible and source_admissions_complete else "false")
            proof_push(buffer, "},\"theorems\":[")
            for index in 0..<report.analysis_1.theorems.summaries.count |index, report, checked_view, buffer, replayed_goals, source_goal_statuses, source_admissions_complete, source_input_error, replay_work|:
                proof_push(buffer, ",") if index > 0
                theorem: ProofTheoremSummary = report.analysis_1.theorems.summaries[index]
                theorem_source_status: (source_admissible: bool, declaration_identity_unambiguous: bool) = proof_checked_view_theorem_source_admission(checked_view, index)
                declaration_identity_unambiguous: bool = theorem_source_status.declaration_identity_unambiguous
                theorem_source_admissible: bool = theorem_source_status.source_admissible
                proof_push_json_theorem(buffer, report, theorem, declaration_identity_unambiguous, theorem_source_admissible, source_input_error, replayed_goals, source_goal_statuses, source_admissions_complete, replay_work)
            proof_push(buffer, "]}\n")
            return goal_status_snapshot.complete

    private:
        # First-order conclusion matching for theorem discovery. Only declared theorem parameters are
        # metavariables; every other identifier remains rigid. This is deliberately an advisory search
        # operation, not a kernel rule, and therefore favors a small auditable matching language.
        def proof_suggestion_parameter_index(report: ProofReport&, theorem: ProofTheoremSummary, name: sview) -> usize:
            for index in 0..<theorem.parameters_count |index, theorem, report, name|:
                return index if report.analysis_1.theorems.parameters[theorem.parameters_start + index] == name
            return theorem.parameters_count

        def proof_suggestion_match(pattern: Ast::Expr, target: Ast::Expr, report: ProofReport&, theorem: ProofTheoremSummary, bound: mutable darray[bool]&, values: mutable darray[Ast::Expr]&, depth: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            requires depth <= PROOF_THEOREM_OUTPUT_DEPTH_LIMIT
            decreases PROOF_THEOREM_OUTPUT_DEPTH_LIMIT - depth
            return false if depth >= PROOF_THEOREM_OUTPUT_DEPTH_LIMIT
            match pattern:
                Ast::Expr.Paren(inner, _):
                    return proof_suggestion_match(inner, target, report, theorem, bound, values, depth + 1)
                Ast::Expr.Ident(name, _):
                    parameter_index: usize = proof_suggestion_parameter_index(report, theorem, name)
                    if parameter_index < theorem.parameters_count:
                        return false if parameter_index >= bound.count or parameter_index >= values.count
                        if bound[parameter_index]:
                            return proof_expr_equal(values[parameter_index], target)
                        bound[parameter_index] <- true
                        values[parameter_index] <- target
                        return true
                _:
                    pass
            match target:
                Ast::Expr.Paren(inner, _):
                    return proof_suggestion_match(pattern, inner, report, theorem, bound, values, depth + 1)
                _:
                    pass
            match pattern:
                Ast::Expr.Unary(operator, operand, _):
                    match target:
                        Ast::Expr.Unary(other_operator, other_operand, _):
                            return operator == other_operator and proof_suggestion_match(operand, other_operand, report, theorem, bound, values, depth + 1)
                        _:
                            return false
                Ast::Expr.Binary(left, operator, right, _):
                    match target:
                        Ast::Expr.Binary(other_left, other_operator, other_right, _):
                            return operator == other_operator and proof_suggestion_match(left, other_left, report, theorem, bound, values, depth + 1) and proof_suggestion_match(right, other_right, report, theorem, bound, values, depth + 1)
                        _:
                            return false
                Ast::Expr.Field(object, field, _):
                    match target:
                        Ast::Expr.Field(other_object, other_field, _):
                            return field == other_field and proof_suggestion_match(object, other_object, report, theorem, bound, values, depth + 1)
                        _:
                            return false
                Ast::Expr.Scope(base, name, _):
                    match target:
                        Ast::Expr.Scope(other_base, other_name, _):
                            return name == other_name and proof_suggestion_match(base, other_base, report, theorem, bound, values, depth + 1)
                        _:
                            return false
                Ast::Expr.Index(object, index, _):
                    match target:
                        Ast::Expr.Index(other_object, other_index, _):
                            return proof_suggestion_match(object, other_object, report, theorem, bound, values, depth + 1) and proof_suggestion_match(index, other_index, report, theorem, bound, values, depth + 1)
                        _:
                            return false
                Ast::Expr.Slice(object, low, high, _):
                    match target:
                        Ast::Expr.Slice(other_object, other_low, other_high, _):
                            return proof_suggestion_match(object, other_object, report, theorem, bound, values, depth + 1) and proof_suggestion_match(low, other_low, report, theorem, bound, values, depth + 1) and proof_suggestion_match(high, other_high, report, theorem, bound, values, depth + 1)
                        _:
                            return false
                Ast::Expr.Call(callee, arguments, argument_names, _):
                    match target:
                        Ast::Expr.Call(other_callee, other_arguments, other_argument_names, _):
                            return false if:
                                arguments.count != other_arguments.count or not proof_sview_array_equal(argument_names, other_argument_names)
                                not proof_suggestion_match(callee, other_callee, report, theorem, bound, values, depth + 1)
                            for index in 0..<arguments.count |index, arguments, other_arguments, report, theorem, bound, values, depth|:
                                return false if not proof_suggestion_match(arguments[index], other_arguments[index], report, theorem, bound, values, depth + 1)
                            return true
                        _:
                            return false
                Ast::Expr.IndexN(object, arguments, _):
                    match target:
                        Ast::Expr.IndexN(other_object, other_arguments, _):
                            return false if:
                                arguments.count != other_arguments.count
                                not proof_suggestion_match(object, other_object, report, theorem, bound, values, depth + 1)
                            for index in 0..<arguments.count |index, arguments, other_arguments, report, theorem, bound, values, depth|:
                                return false if not proof_suggestion_match(arguments[index], other_arguments[index], report, theorem, bound, values, depth + 1)
                            return true
                        _:
                            return false
                Ast::Expr.Array(elements, _):
                    match target:
                        Ast::Expr.Array(other_elements, _):
                            return false if elements.count != other_elements.count
                            for index in 0..<elements.count |index, elements, other_elements, report, theorem, bound, values, depth|:
                                return false if not proof_suggestion_match(elements[index], other_elements[index], report, theorem, bound, values, depth + 1)
                            return true
                        _:
                            return false
                Ast::Expr.Tuple(elements, _):
                    match target:
                        Ast::Expr.Tuple(other_elements, _):
                            return false if elements.count != other_elements.count
                            for index in 0..<elements.count |index, elements, other_elements, report, theorem, bound, values, depth|:
                                return false if not proof_suggestion_match(elements[index], other_elements[index], report, theorem, bound, values, depth + 1)
                            return true
                        _:
                            return false
                Ast::Expr.SetLit(elements, _):
                    match target:
                        Ast::Expr.SetLit(other_elements, _):
                            return false if elements.count != other_elements.count
                            for index in 0..<elements.count |index, elements, other_elements, report, theorem, bound, values, depth|:
                                return false if not proof_suggestion_match(elements[index], other_elements[index], report, theorem, bound, values, depth + 1)
                            return true
                        _:
                            return false
                Ast::Expr.If(condition, then_expression, else_expression, _):
                    match target:
                        Ast::Expr.If(other_condition, other_then, other_else, _):
                            return proof_suggestion_match(condition, other_condition, report, theorem, bound, values, depth + 1) and proof_suggestion_match(then_expression, other_then, report, theorem, bound, values, depth + 1) and proof_suggestion_match(else_expression, other_else, report, theorem, bound, values, depth + 1)
                        _:
                            return false
                _:
                    return proof_expr_equal(pattern, target)

    public:
        def proof_push_json_suggestions_with_replayed[@view, @buffer](buffer: mutable darray[u8]& @buffer, checked_view: ProofCheckedView[view]& @view, goal_id: usize, replay_work: mutable usize&) -> bool can[Memory.Allocate, Abort.Panic, Global.Read, Global.Write]:
            report: ProofReport& = proof_checked_view_report(checked_view)
            annotations: darray[Ast::EnumAnnotation]& = proof_checked_view_enum_annotations(checked_view)
            source_bytes: usize = proof_checked_view_source_bytes(checked_view)
            source_fingerprint: u32 = proof_checked_view_source_fingerprint(checked_view)
            source_complete: bool = proof_checked_view_source_complete(checked_view)
            source_admissible: bool = proof_checked_view_source_admissible(checked_view)
            snapshot: (complete: bool, replayed_goals: darray[bool], source_admitted_goals: darray[bool]) = proof_output_checked_view_goal_statuses_with_work(checked_view, replay_work)
            replayed_goals: darray[bool] = snapshot.replayed_goals
            source_admitted_goals: darray[bool] = snapshot.source_admitted_goals
            goal_source_admissible: bool = goal_id < report.results.goal_attempts.count and proof_output_cached_source_admission_status(source_admitted_goals, goal_id)
            proof_push(buffer, "{\"format\":\"elisa-proof-suggestions-v1\",\"status\":")
            proof_push_json_string(buffer, "incomplete" if not snapshot.complete else ("ok" if goal_id < report.results.goal_attempts.count else "not_found"))
            proof_push(buffer, ",\"goal_status_snapshot_complete\":")
            proof_push(buffer, "true" if snapshot.complete else "false")
            proof_push(buffer, ",\"source\":{\"bytes\":")
            proof_push_number(buffer, source_bytes.u32())
            proof_push(buffer, ",\"fingerprint\":{\"algorithm\":\"fnv1a32\",\"value\":")
            proof_push_number(buffer, source_fingerprint)
            proof_push(buffer, "},\"complete\":")
            proof_push(buffer, "true" if source_complete else "false")
            proof_push(buffer, ",\"admissible\":")
            proof_push(buffer, "true" if source_admissible else "false")
            proof_push(buffer, "},\"goal_id\":")
            proof_push_number(buffer, goal_id.u32())
            proof_push(buffer, ",\"goal_admissible\":")
            proof_push(buffer, "true" if goal_source_admissible else "false")
            proof_push(buffer, ",\"goal_fingerprint\":")
            if snapshot.complete and goal_id < report.results.goal_attempts.count:
                fingerprint: (valid: bool, value: u32) = proof_goal_fingerprint(report, report.results.goal_attempts[goal_id])
                if fingerprint.valid:
                    proof_push(buffer, "{\"algorithm\":\"fnv1a32-kernel-goal-v2\",\"value\":")
                    proof_push_number(buffer, fingerprint.value)
                    proof_push(buffer, "}")
                else:
                    proof_push(buffer, "null")
            else:
                proof_push(buffer, "null")
            proof_push(buffer, ",\"candidates\":[")
            emitted: mutable usize = 0
            if goal_id < report.results.goal_attempts.count:
                attempt: ProofGoalAttempt = report.results.goal_attempts[goal_id]
                valid_facts: bool = attempt.facts_start <= report.analysis_1.certificate_facts.count and attempt.facts_count <= report.analysis_1.certificate_facts.count - attempt.facts_start
                for theorem in report.analysis_1.theorems.summaries |report, annotations, attempt, valid_facts, buffer, emitted, replayed_goals, source_admitted_goals, replay_work|:
                    valid_parameters: bool = theorem.parameters_start <= report.analysis_1.theorems.parameters.count and theorem.parameters_count <= report.analysis_1.theorems.parameters.count - theorem.parameters_start and theorem.parameters_start <= report.analysis_1.theorems.parameter_types.count and theorem.parameters_count <= report.analysis_1.theorems.parameter_types.count - theorem.parameters_start and theorem.parameters_start <= report.analysis_1.theorems.parameter_has_defaults.count and theorem.parameters_count <= report.analysis_1.theorems.parameter_has_defaults.count - theorem.parameters_start and theorem.parameters_start <= report.analysis_1.theorems.parameter_defaults.count and theorem.parameters_count <= report.analysis_1.theorems.parameter_defaults.count - theorem.parameters_start
                    valid_requires: bool = theorem.requires_start <= report.analysis_1.theorems.requires.count and theorem.requires_count <= report.analysis_1.theorems.requires.count - theorem.requires_start
                    valid_ensures: bool = theorem.ensures_start <= report.analysis_1.theorems.ensures.count and theorem.ensures_count <= report.analysis_1.theorems.ensures.count - theorem.ensures_start
                    if theorem.verified and proof_declaration_name_is_unique(report, theorem.name, replay_work) and not proof_theorem_has_replay_gap(report, theorem, replayed_goals, source_admitted_goals, replay_work) and valid_parameters and valid_requires and valid_ensures and valid_facts:
                        for ensure_index in 0..<theorem.ensures_count |ensure_index, theorem, report, annotations, attempt, buffer, emitted|:
                            bound: mutable darray[bool] = []
                            values: mutable darray[Ast::Expr] = []
                            names: mutable darray[sview] = []
                            for parameter_index in 0..<theorem.parameters_count |parameter_index, theorem, report, bound, values, names|:
                                bound.push(false)
                                values.push(Ast::Expr.Absent)
                                names.push(report.analysis_1.theorems.parameters[theorem.parameters_start + parameter_index])
                            conclusion: Ast::Expr = report.analysis_1.theorems.ensures[theorem.ensures_start + ensure_index]
                            matched: bool = proof_suggestion_match(conclusion, attempt.goal, report, theorem, &bound, &values, 0)
                            all_bound: mutable bool = matched
                            for parameter_index in 0..<theorem.parameters_count |parameter_index, theorem, report, bound, values, names, all_bound|:
                                if not bound[parameter_index] and report.analysis_1.theorems.parameter_has_defaults[theorem.parameters_start + parameter_index]:
                                    # Keep discovery identical to checked lemma-call argument mapping:
                                    # executable defaults and unresolved formal dependencies are not
                                    # theorem arguments. A suggestion must never promise an application
                                    # that the verifier itself will conservatively decline.
                                    default_expression: Ast::Expr = report.analysis_1.theorems.parameter_defaults[theorem.parameters_start + parameter_index]
                                    default_safe: mutable bool = not proof_expr_has_call(default_expression) and not proof_expr_has_old(default_expression)
                                    if parameter_index + 1 < theorem.parameters_count:
                                        for later_index in parameter_index + 1..<theorem.parameters_count |later_index, theorem, report, default_expression, default_safe|:
                                            default_safe <- false if proof_expr_mentions_name(default_expression, report.analysis_1.theorems.parameters[theorem.parameters_start + later_index])
                                    if default_safe:
                                        resolved_default: Ast::Expr = proof_substitute(default_expression, names, values)
                                        default_safe <- false if proof_expr_has_call(resolved_default) or proof_expr_has_old(resolved_default)
                                        for formal_name in names |formal_name, resolved_default, default_safe|:
                                            default_safe <- false if proof_expr_mentions_name(resolved_default, formal_name)
                                        if default_safe:
                                            values[parameter_index] <- resolved_default
                                            bound[parameter_index] <- true
                                all_bound <- false if not bound[parameter_index]
                            if matched and all_bound:
                                proof_push(buffer, ",") if emitted > 0
                                emitted <- emitted + 1
                                proof_push(buffer, "{\"theorem\":")
                                proof_push_json_string(buffer, theorem.name)
                                proof_push(buffer, ",\"theorem_fingerprint\":")
                                theorem_fingerprint: (valid: bool, value: u32) = proof_theorem_fingerprint(report, theorem)
                                if theorem_fingerprint.valid:
                                    proof_push(buffer, "{\"algorithm\":\"fnv1a32-kernel-theorem-v2\",\"value\":")
                                    proof_push_number(buffer, theorem_fingerprint.value)
                                    proof_push(buffer, "}")
                                else:
                                    proof_push(buffer, "null")
                                proof_push(buffer, ",\"line\":")
                                proof_push_number(buffer, theorem.line)
                                proof_push(buffer, ",\"ensure_index\":")
                                proof_push_number(buffer, ensure_index.u32())
                                proof_push(buffer, ",\"bindings\":[")
                                for parameter_index in 0..<theorem.parameters_count |parameter_index, theorem, report, values, buffer|:
                                    proof_push(buffer, ",") if parameter_index > 0
                                    proof_push(buffer, "{\"parameter\":")
                                    proof_push_json_string(buffer, report.analysis_1.theorems.parameters[theorem.parameters_start + parameter_index])
                                    proof_push(buffer, ",\"value\":")
                                    proof_push_json_expr(buffer, values[parameter_index])
                                    proof_push(buffer, "}")
                                proof_push(buffer, "],\"premises\":[")
                                applicable: mutable bool = true
                                facts: mutable darray[Ast::Expr] = []
                                for fact_index in 0..<attempt.facts_count |fact_index, attempt, report, facts|:
                                    facts.push(report.analysis_1.certificate_facts[attempt.facts_start + fact_index])
                                for require_index in 0..<theorem.requires_count |require_index, theorem, report, names, values, facts, annotations, buffer, applicable|:
                                    proof_push(buffer, ",") if require_index > 0
                                    premise: Ast::Expr = proof_substitute(report.analysis_1.theorems.requires[theorem.requires_start + require_index], names, values)
                                    satisfied: bool = (proof_goal(facts, premise, annotations) can Global{Read,Write})
                                    applicable <- false if not satisfied
                                    proof_push(buffer, "{\"proposition\":")
                                    proof_push_json_expr(buffer, premise)
                                    proof_push(buffer, ",\"satisfied\":")
                                    proof_push(buffer, "true" if satisfied else "false")
                                    proof_push(buffer, "}")
                                proof_push(buffer, "],\"premises_satisfied\":")
                                proof_push(buffer, "true" if applicable else "false")
                                proof_push(buffer, ",\"applicable\":")
                                proof_push(buffer, "true" if applicable and source_admissible and goal_source_admissible else "false")
                                proof_push(buffer, "}")
            proof_push(buffer, "]}\n")
            return snapshot.complete
