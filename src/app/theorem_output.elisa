def proof_push_json_declaration(buffer: mutable darray[u8]&, report: ProofReport&, declaration: ProofDeclarationSummary) -> void can[Memory.Allocate, Abort.Panic]:
    proof_push(buffer, "{\"kind\":")
    proof_push_json_string(buffer, declaration.kind)
    proof_push(buffer, ",\"name\":")
    proof_push_json_string(buffer, declaration.name)
    proof_push(buffer, ",\"line\":")
    proof_push_number(buffer, declaration.line)
    proof_push(buffer, ",\"parameters\":[")
    valid_parameter_range: bool = declaration.parameters_start <= report.declaration_parameters.count and declaration.parameters_count <= report.declaration_parameters.count - declaration.parameters_start
    if valid_parameter_range:
        for index in 0..<declaration.parameters_count |index, declaration, report, buffer|:
            proof_push(buffer, ",") if index > 0
            proof_push_json_string(buffer, report.declaration_parameters[declaration.parameters_start + index])
    proof_push(buffer, "],\"effects\":")
    if declaration.effects_declared:
        proof_push(buffer, "[")
        valid_effect_range: bool = declaration.effects_start <= report.declaration_effects.count and declaration.effects_count <= report.declaration_effects.count - declaration.effects_start
        if valid_effect_range:
            for index in 0..<declaration.effects_count |index, declaration, report, buffer|:
                proof_push(buffer, ",") if index > 0
                proof_push_json_string(buffer, report.declaration_effects[declaration.effects_start + index])
        proof_push(buffer, "]")
    else:
        proof_push(buffer, "null")
    proof_push(buffer, ",\"requires\":")
    proof_push_number(buffer, declaration.requires_count.u32())
    proof_push(buffer, ",\"ensures\":")
    proof_push_number(buffer, declaration.ensures_count.u32())
    proof_push(buffer, ",\"changes\":")
    proof_push_number(buffer, declaration.changes_count.u32())
    proof_push(buffer, ",\"preserves\":")
    proof_push_number(buffer, declaration.preserves_count.u32())
    proof_push(buffer, ",\"decreases\":")
    proof_push_number(buffer, declaration.decreases_count.u32())
    proof_push(buffer, ",\"lemma\":")
    proof_push(buffer, "true" if declaration.lemma else "false")
    proof_push(buffer, ",\"recursive\":")
    proof_push(buffer, "true" if declaration.recursive else "false")
    proof_push(buffer, ",\"pure\":")
    proof_push(buffer, "true" if declaration.pure else "false")
    proof_push(buffer, ",\"verified\":")
    proof_push(buffer, "true" if declaration.verified else "false")
    proof_push(buffer, ",\"verification_reason\":")
    proof_push_json_string(buffer, declaration.verification_reason)
    proof_push(buffer, ",\"structural\":")
    proof_push(buffer, "true" if declaration.structural else "false")
    proof_push(buffer, "}")

def proof_push_json_theorem(buffer: mutable darray[u8]&, report: ProofReport&, theorem: ProofTheoremSummary) -> void can[Memory.Allocate, Abort.Panic]:
    valid_parameters: bool = theorem.parameters_start <= report.theorem_parameters.count and theorem.parameters_count <= report.theorem_parameters.count - theorem.parameters_start and theorem.parameters_start <= report.theorem_parameter_types.count and theorem.parameters_count <= report.theorem_parameter_types.count - theorem.parameters_start and theorem.parameters_start <= report.theorem_parameter_has_defaults.count and theorem.parameters_count <= report.theorem_parameter_has_defaults.count - theorem.parameters_start and theorem.parameters_start <= report.theorem_parameter_defaults.count and theorem.parameters_count <= report.theorem_parameter_defaults.count - theorem.parameters_start
    valid_requires: bool = theorem.requires_start <= report.theorem_requires.count and theorem.requires_count <= report.theorem_requires.count - theorem.requires_start
    valid_ensures: bool = theorem.ensures_start <= report.theorem_ensures.count and theorem.ensures_count <= report.theorem_ensures.count - theorem.ensures_start
    valid_decreases: bool = theorem.decreases_start <= report.theorem_decreases.count and theorem.decreases_count <= report.theorem_decreases.count - theorem.decreases_start
    valid_proof_goals: bool = theorem.proof_goals_start <= report.theorem_proof_goal_ids.count and theorem.proof_goals_count <= report.theorem_proof_goal_ids.count - theorem.proof_goals_start
    signature_valid: bool = valid_parameters and valid_requires and valid_ensures and valid_decreases
    proof_replay_complete: mutable bool = theorem.verified and valid_proof_goals and theorem.proof_goals_count > 0
    if valid_proof_goals:
        for index in 0..<theorem.proof_goals_count |index, theorem, report, proof_replay_complete|:
            goal_id: usize = report.theorem_proof_goal_ids[theorem.proof_goals_start + index]
            if goal_id >= report.goal_attempts.count:
                proof_replay_complete <- false
            else:
                attempt: ProofGoalAttempt = report.goal_attempts[goal_id]
                proof_replay_complete <- false if not attempt.proven or not attempt.has_certificate or attempt.certificate_index >= report.certificates.count or not report.certificates[attempt.certificate_index].replayed
    proof_push(buffer, "{\"name\":")
    proof_push_json_string(buffer, theorem.name)
    proof_push(buffer, ",\"theorem_fingerprint\":")
    theorem_fingerprint: (valid: bool, value: u32) = proof_theorem_fingerprint(report, theorem)
    if theorem_fingerprint.valid:
        proof_push(buffer, "{\"algorithm\":\"fnv1a32-kernel-theorem-v1\",\"value\":")
        proof_push_number(buffer, theorem_fingerprint.value)
        proof_push(buffer, "}")
    else:
        proof_push(buffer, "null")
    proof_push(buffer, ",\"line\":")
    proof_push_number(buffer, theorem.line)
    proof_push(buffer, ",\"verified\":")
    proof_push(buffer, "true" if theorem.verified else "false")
    proof_push(buffer, ",\"verification_reason\":")
    proof_push_json_string(buffer, theorem.verification_reason)
    proof_push(buffer, ",\"recursive\":")
    proof_push(buffer, "true" if theorem.recursive else "false")
    proof_push(buffer, ",\"signature_valid\":")
    proof_push(buffer, "true" if signature_valid else "false")
    proof_push(buffer, ",\"proof_replay_complete\":")
    proof_push(buffer, "true" if proof_replay_complete else "false")
    proof_push(buffer, ",\"proof_goals_valid\":")
    proof_push(buffer, "true" if valid_proof_goals else "false")
    proof_push(buffer, ",\"parameters\":[")
    if valid_parameters:
        for index in 0..<theorem.parameters_count |index, theorem, report, buffer|:
            proof_push(buffer, ",") if index > 0
            proof_push_json_string(buffer, report.theorem_parameters[theorem.parameters_start + index])
    proof_push(buffer, "],\"parameter_defaults\":[")
    if valid_parameters:
        for index in 0..<theorem.parameters_count |index, theorem, report, buffer|:
            proof_push(buffer, ",") if index > 0
            parameter_index: usize = theorem.parameters_start + index
            if report.theorem_parameter_has_defaults[parameter_index]:
                proof_push_json_expr(buffer, report.theorem_parameter_defaults[parameter_index])
            else:
                proof_push(buffer, "null")
    proof_push(buffer, "],\"parameter_types\":[")
    if valid_parameters:
        for index in 0..<theorem.parameters_count |index, theorem, report, buffer|:
            proof_push(buffer, ",") if index > 0
            proof_push_json_expr(buffer, report.theorem_parameter_types[theorem.parameters_start + index])
    proof_push(buffer, "],\"requires\":[")
    if valid_requires:
        for index in 0..<theorem.requires_count |index, theorem, report, buffer|:
            proof_push(buffer, ",") if index > 0
            proof_push_json_expr(buffer, report.theorem_requires[theorem.requires_start + index])
    proof_push(buffer, "],\"ensures\":[")
    if valid_ensures:
        for index in 0..<theorem.ensures_count |index, theorem, report, buffer|:
            proof_push(buffer, ",") if index > 0
            proof_push_json_expr(buffer, report.theorem_ensures[theorem.ensures_start + index])
    proof_push(buffer, "],\"decreases\":[")
    if valid_decreases:
        for index in 0..<theorem.decreases_count |index, theorem, report, buffer|:
            proof_push(buffer, ",") if index > 0
            proof_push_json_expr(buffer, report.theorem_decreases[theorem.decreases_start + index])
    proof_push(buffer, "],\"proof_goals\":[")
    if valid_proof_goals:
        for index in 0..<theorem.proof_goals_count |index, theorem, report, buffer|:
            proof_push(buffer, ",") if index > 0
            goal_id: usize = report.theorem_proof_goal_ids[theorem.proof_goals_start + index]
            proof_push(buffer, "{\"goal_id\":")
            proof_push_number(buffer, goal_id.u32())
            if goal_id < report.goal_attempts.count:
                attempt: ProofGoalAttempt = report.goal_attempts[goal_id]
                proof_push(buffer, ",\"rule\":")
                proof_push_json_string(buffer, attempt.rule)
                proof_push(buffer, ",\"proven\":")
                proof_push(buffer, "true" if attempt.proven else "false")
                proof_push(buffer, ",\"certificate_id\":")
                proof_push_number(buffer, attempt.certificate_index.u32()) if attempt.has_certificate and attempt.certificate_index < report.certificates.count else proof_push(buffer, "null")
                proof_push(buffer, ",\"replayed\":")
                proof_push(buffer, "true" if attempt.has_certificate and attempt.certificate_index < report.certificates.count and report.certificates[attempt.certificate_index].replayed else "false")
            proof_push(buffer, "}")
    proof_push(buffer, "]}")

def proof_push_json_theorem_catalog(buffer: mutable darray[u8]&, report: ProofReport&, source_bytes: usize, source_fingerprint: u32, source_complete: bool, source_admissible: bool) -> void can[Memory.Allocate, Abort.Panic]:
    proof_push(buffer, "{\"format\":\"elisa-proof-theorems-v1\",\"source\":{\"bytes\":")
    proof_push_number(buffer, source_bytes.u32())
    proof_push(buffer, ",\"fingerprint\":{\"algorithm\":\"fnv1a32\",\"value\":")
    proof_push_number(buffer, source_fingerprint)
    proof_push(buffer, "},\"complete\":")
    proof_push(buffer, "true" if source_complete else "false")
    proof_push(buffer, ",\"admissible\":")
    proof_push(buffer, "true" if source_admissible else "false")
    proof_push(buffer, "},\"theorems\":[")
    for index in 0..<report.theorem_summaries.count |index, report, buffer|:
        proof_push(buffer, ",") if index > 0
        proof_push_json_theorem(buffer, report, report.theorem_summaries[index])
    proof_push(buffer, "]}\n")

# First-order conclusion matching for theorem discovery. Only declared theorem parameters are
# metavariables; every other identifier remains rigid. This is deliberately an advisory search
# operation, not a kernel rule, and therefore favors a small auditable matching language.
def proof_suggestion_parameter_index(report: ProofReport&, theorem: ProofTheoremSummary, name: sview) -> usize:
    for index in 0..<theorem.parameters_count |index, theorem, report, name|:
        return index if report.theorem_parameters[theorem.parameters_start + index] == name
    return theorem.parameters_count

def proof_suggestion_match(pattern: Ast::Expr, target: Ast::Expr, report: ProofReport&, theorem: ProofTheoremSummary, bound: mutable darray[bool]&, values: mutable darray[Ast::Expr]&, depth: usize) -> bool can[Memory.Allocate, Abort.Panic]:
    requires depth <= 128
    decreases 128 - depth
    return false if depth >= 128
    match pattern:
        Ast::Expr.Paren(inner, _):
            return proof_suggestion_match(inner, target, report, theorem, bound, values, depth + 1)
        Ast::Expr.Ident(name, _):
            parameter_index: usize = proof_suggestion_parameter_index(report, theorem, name)
            if parameter_index < theorem.parameters_count:
                return false if parameter_index >= bound.count or parameter_index >= values.count
                if bound[parameter_index]:
                    return proof_expr_equal(values[parameter_index], target)
                bound[parameter_index] <- true
                values[parameter_index] <- target
                return true
        _:
            pass
    match target:
        Ast::Expr.Paren(inner, _):
            return proof_suggestion_match(pattern, inner, report, theorem, bound, values, depth + 1)
        _:
            pass
    match pattern:
        Ast::Expr.Unary(operator, operand, _):
            match target:
                Ast::Expr.Unary(other_operator, other_operand, _):
                    return operator == other_operator and proof_suggestion_match(operand, other_operand, report, theorem, bound, values, depth + 1)
                _:
                    return false
        Ast::Expr.Binary(left, operator, right, _):
            match target:
                Ast::Expr.Binary(other_left, other_operator, other_right, _):
                    return operator == other_operator and proof_suggestion_match(left, other_left, report, theorem, bound, values, depth + 1) and proof_suggestion_match(right, other_right, report, theorem, bound, values, depth + 1)
                _:
                    return false
        Ast::Expr.Field(object, field, _):
            match target:
                Ast::Expr.Field(other_object, other_field, _):
                    return field == other_field and proof_suggestion_match(object, other_object, report, theorem, bound, values, depth + 1)
                _:
                    return false
        Ast::Expr.Scope(base, name, _):
            match target:
                Ast::Expr.Scope(other_base, other_name, _):
                    return name == other_name and proof_suggestion_match(base, other_base, report, theorem, bound, values, depth + 1)
                _:
                    return false
        Ast::Expr.Index(object, index, _):
            match target:
                Ast::Expr.Index(other_object, other_index, _):
                    return proof_suggestion_match(object, other_object, report, theorem, bound, values, depth + 1) and proof_suggestion_match(index, other_index, report, theorem, bound, values, depth + 1)
                _:
                    return false
        Ast::Expr.Slice(object, low, high, _):
            match target:
                Ast::Expr.Slice(other_object, other_low, other_high, _):
                    return proof_suggestion_match(object, other_object, report, theorem, bound, values, depth + 1) and proof_suggestion_match(low, other_low, report, theorem, bound, values, depth + 1) and proof_suggestion_match(high, other_high, report, theorem, bound, values, depth + 1)
                _:
                    return false
        Ast::Expr.Call(callee, arguments, argument_names, _):
            match target:
                Ast::Expr.Call(other_callee, other_arguments, other_argument_names, _):
                    return false if arguments.count != other_arguments.count or not proof_sview_array_equal(argument_names, other_argument_names)
                    return false if not proof_suggestion_match(callee, other_callee, report, theorem, bound, values, depth + 1)
                    for index in 0..<arguments.count |index, arguments, other_arguments, report, theorem, bound, values, depth|:
                        return false if not proof_suggestion_match(arguments[index], other_arguments[index], report, theorem, bound, values, depth + 1)
                    return true
                _:
                    return false
        Ast::Expr.IndexN(object, arguments, _):
            match target:
                Ast::Expr.IndexN(other_object, other_arguments, _):
                    return false if arguments.count != other_arguments.count
                    return false if not proof_suggestion_match(object, other_object, report, theorem, bound, values, depth + 1)
                    for index in 0..<arguments.count |index, arguments, other_arguments, report, theorem, bound, values, depth|:
                        return false if not proof_suggestion_match(arguments[index], other_arguments[index], report, theorem, bound, values, depth + 1)
                    return true
                _:
                    return false
        Ast::Expr.Array(elements, _):
            match target:
                Ast::Expr.Array(other_elements, _):
                    return false if elements.count != other_elements.count
                    for index in 0..<elements.count |index, elements, other_elements, report, theorem, bound, values, depth|:
                        return false if not proof_suggestion_match(elements[index], other_elements[index], report, theorem, bound, values, depth + 1)
                    return true
                _:
                    return false
        Ast::Expr.Tuple(elements, _):
            match target:
                Ast::Expr.Tuple(other_elements, _):
                    return false if elements.count != other_elements.count
                    for index in 0..<elements.count |index, elements, other_elements, report, theorem, bound, values, depth|:
                        return false if not proof_suggestion_match(elements[index], other_elements[index], report, theorem, bound, values, depth + 1)
                    return true
                _:
                    return false
        Ast::Expr.SetLit(elements, _):
            match target:
                Ast::Expr.SetLit(other_elements, _):
                    return false if elements.count != other_elements.count
                    for index in 0..<elements.count |index, elements, other_elements, report, theorem, bound, values, depth|:
                        return false if not proof_suggestion_match(elements[index], other_elements[index], report, theorem, bound, values, depth + 1)
                    return true
                _:
                    return false
        Ast::Expr.If(condition, then_expression, else_expression, _):
            match target:
                Ast::Expr.If(other_condition, other_then, other_else, _):
                    return proof_suggestion_match(condition, other_condition, report, theorem, bound, values, depth + 1) and proof_suggestion_match(then_expression, other_then, report, theorem, bound, values, depth + 1) and proof_suggestion_match(else_expression, other_else, report, theorem, bound, values, depth + 1)
                _:
                    return false
        _:
            return proof_expr_equal(pattern, target)

def proof_push_json_suggestions(buffer: mutable darray[u8]&, report: ProofReport&, annotations: darray[Ast::EnumAnnotation]&, goal_id: usize, source_bytes: usize, source_fingerprint: u32, source_complete: bool, source_admissible: bool) -> void can[Memory.Allocate, Abort.Panic]:
    proof_push(buffer, "{\"format\":\"elisa-proof-suggestions-v1\",\"status\":")
    proof_push_json_string(buffer, "ok" if goal_id < report.goal_attempts.count else "not_found")
    proof_push(buffer, ",\"source\":{\"bytes\":")
    proof_push_number(buffer, source_bytes.u32())
    proof_push(buffer, ",\"fingerprint\":{\"algorithm\":\"fnv1a32\",\"value\":")
    proof_push_number(buffer, source_fingerprint)
    proof_push(buffer, "},\"complete\":")
    proof_push(buffer, "true" if source_complete else "false")
    proof_push(buffer, ",\"admissible\":")
    proof_push(buffer, "true" if source_admissible else "false")
    proof_push(buffer, "},\"goal_id\":")
    proof_push_number(buffer, goal_id.u32())
    proof_push(buffer, ",\"goal_fingerprint\":")
    if goal_id < report.goal_attempts.count:
        fingerprint: (valid: bool, value: u32) = proof_goal_fingerprint(report, report.goal_attempts[goal_id])
        if fingerprint.valid:
            proof_push(buffer, "{\"algorithm\":\"fnv1a32-kernel-goal-v1\",\"value\":")
            proof_push_number(buffer, fingerprint.value)
            proof_push(buffer, "}")
        else:
            proof_push(buffer, "null")
    else:
        proof_push(buffer, "null")
    proof_push(buffer, ",\"candidates\":[")
    emitted: mutable usize = 0
    if goal_id < report.goal_attempts.count:
        attempt: ProofGoalAttempt = report.goal_attempts[goal_id]
        valid_facts: bool = attempt.facts_start <= report.certificate_facts.count and attempt.facts_count <= report.certificate_facts.count - attempt.facts_start
        for theorem in report.theorem_summaries |report, annotations, attempt, valid_facts, buffer, emitted|:
            valid_parameters: bool = theorem.parameters_start <= report.theorem_parameters.count and theorem.parameters_count <= report.theorem_parameters.count - theorem.parameters_start and theorem.parameters_start <= report.theorem_parameter_types.count and theorem.parameters_count <= report.theorem_parameter_types.count - theorem.parameters_start and theorem.parameters_start <= report.theorem_parameter_has_defaults.count and theorem.parameters_count <= report.theorem_parameter_has_defaults.count - theorem.parameters_start and theorem.parameters_start <= report.theorem_parameter_defaults.count and theorem.parameters_count <= report.theorem_parameter_defaults.count - theorem.parameters_start
            valid_requires: bool = theorem.requires_start <= report.theorem_requires.count and theorem.requires_count <= report.theorem_requires.count - theorem.requires_start
            valid_ensures: bool = theorem.ensures_start <= report.theorem_ensures.count and theorem.ensures_count <= report.theorem_ensures.count - theorem.ensures_start
            if theorem.verified and valid_parameters and valid_requires and valid_ensures and valid_facts:
                for ensure_index in 0..<theorem.ensures_count |ensure_index, theorem, report, annotations, attempt, buffer, emitted|:
                    bound: mutable darray[bool] = []
                    values: mutable darray[Ast::Expr] = []
                    names: mutable darray[sview] = []
                    for parameter_index in 0..<theorem.parameters_count |parameter_index, theorem, report, bound, values, names|:
                        bound.push(false)
                        values.push(Ast::Expr.Absent)
                        names.push(report.theorem_parameters[theorem.parameters_start + parameter_index])
                    conclusion: Ast::Expr = report.theorem_ensures[theorem.ensures_start + ensure_index]
                    matched: bool = proof_suggestion_match(conclusion, attempt.goal, report, theorem, &bound, &values, 0)
                    all_bound: mutable bool = matched
                    for parameter_index in 0..<theorem.parameters_count |parameter_index, theorem, report, bound, values, names, all_bound|:
                        if not bound[parameter_index] and report.theorem_parameter_has_defaults[theorem.parameters_start + parameter_index]:
                            # Keep discovery identical to checked lemma-call argument mapping:
                            # executable defaults and unresolved formal dependencies are not
                            # theorem arguments. A suggestion must never promise an application
                            # that the verifier itself will conservatively decline.
                            default_expression: Ast::Expr = report.theorem_parameter_defaults[theorem.parameters_start + parameter_index]
                            default_safe: mutable bool = not proof_expr_has_call(default_expression) and not proof_expr_has_old(default_expression)
                            if parameter_index + 1 < theorem.parameters_count:
                                for later_index in parameter_index + 1..<theorem.parameters_count |later_index, theorem, report, default_expression, default_safe|:
                                    default_safe <- false if proof_expr_mentions_name(default_expression, report.theorem_parameters[theorem.parameters_start + later_index])
                            if default_safe:
                                resolved_default: Ast::Expr = proof_substitute(default_expression, names, values)
                                default_safe <- false if proof_expr_has_call(resolved_default) or proof_expr_has_old(resolved_default)
                                for formal_name in names |formal_name, resolved_default, default_safe|:
                                    default_safe <- false if proof_expr_mentions_name(resolved_default, formal_name)
                                if default_safe:
                                    values[parameter_index] <- resolved_default
                                    bound[parameter_index] <- true
                        all_bound <- false if not bound[parameter_index]
                    if matched and all_bound:
                        proof_push(buffer, ",") if emitted > 0
                        emitted <- emitted + 1
                        proof_push(buffer, "{\"theorem\":")
                        proof_push_json_string(buffer, theorem.name)
                        proof_push(buffer, ",\"theorem_fingerprint\":")
                        theorem_fingerprint: (valid: bool, value: u32) = proof_theorem_fingerprint(report, theorem)
                        if theorem_fingerprint.valid:
                            proof_push(buffer, "{\"algorithm\":\"fnv1a32-kernel-theorem-v1\",\"value\":")
                            proof_push_number(buffer, theorem_fingerprint.value)
                            proof_push(buffer, "}")
                        else:
                            proof_push(buffer, "null")
                        proof_push(buffer, ",\"line\":")
                        proof_push_number(buffer, theorem.line)
                        proof_push(buffer, ",\"ensure_index\":")
                        proof_push_number(buffer, ensure_index.u32())
                        proof_push(buffer, ",\"bindings\":[")
                        for parameter_index in 0..<theorem.parameters_count |parameter_index, theorem, report, values, buffer|:
                            proof_push(buffer, ",") if parameter_index > 0
                            proof_push(buffer, "{\"parameter\":")
                            proof_push_json_string(buffer, report.theorem_parameters[theorem.parameters_start + parameter_index])
                            proof_push(buffer, ",\"value\":")
                            proof_push_json_expr(buffer, values[parameter_index])
                            proof_push(buffer, "}")
                        proof_push(buffer, "],\"premises\":[")
                        applicable: mutable bool = true
                        facts: mutable darray[Ast::Expr] = []
                        for fact_index in 0..<attempt.facts_count |fact_index, attempt, report, facts|:
                            facts.push(report.certificate_facts[attempt.facts_start + fact_index])
                        for require_index in 0..<theorem.requires_count |require_index, theorem, report, names, values, facts, annotations, buffer, applicable|:
                            proof_push(buffer, ",") if require_index > 0
                            premise: Ast::Expr = proof_substitute(report.theorem_requires[theorem.requires_start + require_index], names, values)
                            satisfied: bool = proof_goal(facts, premise, annotations)
                            applicable <- false if not satisfied
                            proof_push(buffer, "{\"proposition\":")
                            proof_push_json_expr(buffer, premise)
                            proof_push(buffer, ",\"satisfied\":")
                            proof_push(buffer, "true" if satisfied else "false")
                            proof_push(buffer, "}")
                        proof_push(buffer, "],\"premises_satisfied\":")
                        proof_push(buffer, "true" if applicable else "false")
                        proof_push(buffer, ",\"applicable\":")
                        proof_push(buffer, "true" if applicable and source_admissible else "false")
                        proof_push(buffer, "}")
