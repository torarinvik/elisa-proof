# Source bytes the reference compiler rejects but the stage1 lexer passes over.
#
# The stage0 compiler lexes a NUL byte in code as an identifier and fails to parse the file. The
# stage1 lexer the proof tool links does not, so `def name_\0tail() -> i64:` reached the checker
# as a well-formed declaration named `name_` and could be proved. A NUL is harmless only where
# both compilers skip it, inside a `#` comment, so any other NUL makes the source unparsed.

# The 1-based line of the first NUL byte outside a comment, or 0 when there is none. A comment
# starts at a `#` that no token covers (comments never enter the token stream) and runs to the
# end of its line; a `#` inside a string or other token starts nothing.
def proof_source_stray_nul_line(tokens: darray[Token]&, source: darray[u8]&, source_bytes: usize) -> u32 can[Memory.Allocate, Abort.Panic]:
    covered: mutable darray[bool] = []
    for offset in 0..<source_bytes |offset, covered|:
        covered.push(false)
    for token in tokens |covered, source_bytes|:
        start: usize = token.start.usize()
        continue if start >= source_bytes
        end: mutable usize = start + token.length.usize()
        end <- source_bytes if end > source_bytes
        for offset in start..<end |offset, covered|:
            covered[offset] <- true
    line: mutable u32 = 1
    in_comment: mutable bool = false
    offset: mutable usize = 0
    while offset < source_bytes:
        byte: u8 = source[offset]
        if byte == 10:
            line <- line + 1
            in_comment <- false
        else:
            in_comment <- true if byte == 35 and not covered[offset]
            return line if byte == 0 and not in_comment
        offset <- offset + 1
    return 0
