def proof_goal_fingerprint(report: ProofReport&, attempt: ProofGoalAttempt) -> (valid: bool, value: u32) can[Memory.Allocate, Abort.Panic]:
    identity: mutable darray[u8] = []
    return (false, 0) if not proof_portable_sequent_identity(&identity, report.kernel.nodes, report.kernel.children, report.kernel.certificate_facts, attempt.kernel_facts_start, attempt.kernel_facts_count, attempt.kernel_goal)
    return (true, proof_source_fingerprint(identity))

def proof_push_theorem_expression_identity(buffer: mutable darray[u8]&, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, expression: Ast::Expr) -> bool can[Memory.Allocate, Abort.Panic]:
    return false if not proof_kernel_expression_supported(expression)
    root: usize = proof_kernel_encode_expression(expression, nodes, children)
    return proof_push_kernel_identity(buffer, nodes, children, root, 0)

# Canonical identity of a theorem statement and invocation signature. Source positions, report
# indices, proof scripts, and certificate arena offsets are excluded: changing the proof without
# changing the checked theorem does not invalidate consumers. Verification and replay remain
# separate admission gates and are never implied by this observational FNV identity.
def proof_theorem_fingerprint(report: ProofReport&, theorem: ProofTheoremSummary) -> (valid: bool, value: u32) can[Memory.Allocate, Abort.Panic]:
    valid_parameters: bool = theorem.parameters_start <= report.theorems.parameters.count and theorem.parameters_count <= report.theorems.parameters.count - theorem.parameters_start and theorem.parameters_start <= report.theorems.parameter_types.count and theorem.parameters_count <= report.theorems.parameter_types.count - theorem.parameters_start and theorem.parameters_start <= report.theorems.parameter_has_defaults.count and theorem.parameters_count <= report.theorems.parameter_has_defaults.count - theorem.parameters_start and theorem.parameters_start <= report.theorems.parameter_defaults.count and theorem.parameters_count <= report.theorems.parameter_defaults.count - theorem.parameters_start
    valid_requires: bool = theorem.requires_start <= report.theorems.requires.count and theorem.requires_count <= report.theorems.requires.count - theorem.requires_start
    valid_ensures: bool = theorem.ensures_start <= report.theorems.ensures.count and theorem.ensures_count <= report.theorems.ensures.count - theorem.ensures_start
    valid_decreases: bool = theorem.decreases_start <= report.theorems.decreases.count and theorem.decreases_count <= report.theorems.decreases.count - theorem.decreases_start
    return (false, 0) if not valid_parameters or not valid_requires or not valid_ensures or not valid_decreases
    identity: mutable darray[u8] = []
    nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
    children: mutable darray[usize] = []
    proof_push(&identity, "elisa-proof-theorem-v1:")
    proof_push_json_string(&identity, theorem.name)
    proof_push(&identity, ":recursive:" if theorem.recursive else ":nonrecursive:")
    valid: mutable bool = true
    for index in 0..<theorem.parameters_count |index, theorem, report, identity, nodes, children, valid|:
        parameter_index: usize = theorem.parameters_start + index
        proof_push(&identity, "P")
        proof_push_json_string(&identity, report.theorems.parameters[parameter_index])
        valid <- proof_push_theorem_expression_identity(&identity, &nodes, &children, report.theorems.parameter_types[parameter_index]) and valid
        if report.theorems.parameter_has_defaults[parameter_index]:
            proof_push(&identity, "D")
            valid <- proof_push_theorem_expression_identity(&identity, &nodes, &children, report.theorems.parameter_defaults[parameter_index]) and valid
        else:
            proof_push(&identity, "N")
    for index in 0..<theorem.requires_count |index, theorem, report, identity, nodes, children, valid|:
        proof_push(&identity, "R")
        valid <- proof_push_theorem_expression_identity(&identity, &nodes, &children, report.theorems.requires[theorem.requires_start + index]) and valid
    for index in 0..<theorem.ensures_count |index, theorem, report, identity, nodes, children, valid|:
        proof_push(&identity, "E")
        valid <- proof_push_theorem_expression_identity(&identity, &nodes, &children, report.theorems.ensures[theorem.ensures_start + index]) and valid
    for index in 0..<theorem.decreases_count |index, theorem, report, identity, nodes, children, valid|:
        proof_push(&identity, "M")
        valid <- proof_push_theorem_expression_identity(&identity, &nodes, &children, report.theorems.decreases[theorem.decreases_start + index]) and valid
    return (false, 0) if not valid
    return (true, proof_source_fingerprint(identity))
