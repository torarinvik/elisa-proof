# Keep the compiler's private JSON DOM behind a small, proof-owned public boundary.
module ElisaProofJson:
    public:
        def from_result[@r](result: JsonParseResult[r]) -> JsonValueHandle[r]:
            return Json::json_handle_from_result(result)

        def null_value[@r](value: JsonValueHandle[r]) -> JsonValueHandle[r]:
            return Json::json_handle_null(value)

        def kind[@r](value: JsonValueHandle[r]) -> JsonKind:
            return Json::json_handle_kind(value)

        def is_object[@r](value: JsonValueHandle[r]) -> bool:
            return Json::json_handle_is_object(value)

        def is_array[@r](value: JsonValueHandle[r]) -> bool:
            return Json::json_handle_is_array(value)

        def has[@r](value: JsonValueHandle[r], key: sview) -> bool:
            return Json::json_handle_has(value, key)

        def field[@r](value: JsonValueHandle[r], key: sview) -> (known: bool, value: JsonValueHandle[r]):
            missing: JsonValueHandle[r] = Json::json_handle_null(value)
            return (false, missing) if not Json::json_handle_is_object(value) or not Json::json_handle_has(value, key)
            found: JsonValueHandle[r] = try Json::json_handle_get(value, key) else missing
            return (true, found)

        def at[@r](value: JsonValueHandle[r], index: i64) -> JsonValueHandle[r] error[JsonAccessError]:
            return Json::json_handle_at(value, index)

        def array_len[@r](value: JsonValueHandle[r]) -> i64:
            return Json::json_handle_array_len(value)

        # Every member, duplicates included: the parser keeps repeated keys.
        def object_len[@r](value: JsonValueHandle[r]) -> i64:
            return Json::json_handle_object_len(value)

        def as_bool[@r](value: JsonValueHandle[r]) -> bool error[JsonAccessError]:
            return Json::json_handle_as_bool(value)

        def as_number[@r](value: JsonValueHandle[r]) -> f64 error[JsonAccessError]:
            return Json::json_handle_as_number(value)

        def as_string[@r](value: JsonValueHandle[r]) -> sview @r error[JsonAccessError]:
            return Json::json_handle_as_string(value)

        def bytes_range_ref(buffer: darray[u8]&, start: usize, count: usize) -> sview:
            return bytes_view_range_ref(buffer, start, count)
