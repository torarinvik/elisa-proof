def proof_push_proof_check(buffer: mutable darray[u8]&, report: ProofReport&, contents: darray[u8]&, source_fingerprint: u32, source_complete: bool, source_admissible: bool) -> i64 can[Memory.Allocate, Abort.Panic]:
    claimed: (known: bool, goal_id: usize) = proof_rendered_goal_id(contents)
    # This compatibility entrypoint has no frozen source inventories, so report-wide
    # admissibility cannot authorize the selected goal.
    # It also has no replay receipt, so it cannot authorize the selected attempt.
    return proof_push_proof_check_claimed(buffer, report, contents, source_fingerprint, source_complete, source_admissible, false, claimed, false)

def proof_push_proof_check_with_replayed(buffer: mutable darray[u8]&, report: ProofReport&, contents: darray[u8]&, source_fingerprint: u32, source_complete: bool, source_admissible: bool, import_failed: bool, semantic_errors: u32, literal_ensure_inventory: darray[(name: sview, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool)]&, assert_by_inventory: darray[(name: sview, attempt_line: u32, goal_line: u32, goal_offset: u32, expected_value: bool, source_goal: Ast::Expr, supported: bool)]&, replayed_goals: darray[bool]&) -> i64 can[Memory.Allocate, Abort.Panic]:
    claimed: (known: bool, goal_id: usize) = proof_rendered_goal_id(contents)
    attempt_replayed: bool = claimed.known and claimed.goal_id < report.goal_attempts.count and proof_output_cached_replay_status(replayed_goals, claimed.goal_id)
    goal_source_admissible: bool = claimed.known and proof_report_goal_source_admissible(report, claimed.goal_id, import_failed, semantic_errors, literal_ensure_inventory, assert_by_inventory)
    return proof_push_proof_check_claimed(buffer, report, contents, source_fingerprint, source_complete, source_admissible, goal_source_admissible, claimed, attempt_replayed)

def proof_push_proof_check_claimed(buffer: mutable darray[u8]&, report: ProofReport&, contents: darray[u8]&, source_fingerprint: u32, source_complete: bool, source_admissible: bool, goal_source_admissible: bool, claimed: (known: bool, goal_id: usize), attempt_replayed: bool) -> i64 can[Memory.Allocate, Abort.Panic]:
    if not claimed.known:
        proof_push(buffer, "{\"format\":\"elisa-proof-proof-check-v1\",\"status\":\"unreadable\",\"verification_state\":\"unknown\",\"goal_id\":null,\"differences\":[]}\n")
        return 2
    if claimed.goal_id >= report.goal_attempts.count:
        proof_push(buffer, "{\"format\":\"elisa-proof-proof-check-v1\",\"status\":\"not_found\",\"goal_id\":")
        proof_push_number(buffer, claimed.goal_id.u32())
        proof_push(buffer, ",\"verification_state\":\"unknown\",\"differences\":[]}\n")
        return 2
    canonical: mutable darray[u8] = []
    proof_push_elisa_proof_with_replayed(&canonical, report, claimed.goal_id, source_fingerprint, source_complete, source_admissible, goal_source_admissible, attempt_replayed)
    differences: mutable darray[u8] = []
    difference_count: mutable usize = 0
    file_cursor: mutable usize = 0
    canonical_cursor: mutable usize = 0
    line_number: mutable usize = 0
    while file_cursor < contents.count or canonical_cursor < canonical.count |file_cursor, canonical_cursor, line_number, contents, canonical, differences, difference_count|:
        line_number <- line_number + 1
        file_line: (end: usize, next: usize) = proof_rendered_line(contents, file_cursor)
        canonical_line: (end: usize, next: usize) = proof_rendered_line(canonical, canonical_cursor)
        file_present: bool = file_cursor < contents.count
        canonical_present: bool = canonical_cursor < canonical.count
        equal: bool = file_present and canonical_present and proof_rendered_lines_equal(contents, file_cursor, file_line.end, canonical, canonical_cursor, canonical_line.end)
        if not equal and difference_count < 32:
            proof_push(&differences, ",") if difference_count > 0
            proof_push(&differences, "{\"line\":")
            proof_push_number(&differences, line_number.u32())
            proof_push(&differences, ",\"expected\":")
            if canonical_present:
                proof_push_json_byte_range(&differences, canonical, canonical_cursor, canonical_line.end)
            else:
                proof_push(&differences, "null")
            proof_push(&differences, ",\"found\":")
            if file_present:
                proof_push_json_byte_range(&differences, contents, file_cursor, file_line.end)
            else:
                proof_push(&differences, "null")
            proof_push(&differences, "}")
        difference_count <- difference_count + 1 if not equal
        file_cursor <- file_line.next if file_present else file_cursor + 1
        canonical_cursor <- canonical_line.next if canonical_present else canonical_cursor + 1
    goal_state: sview = proof_output_goal_state_with_source_admissibility(report, claimed.goal_id, goal_source_admissible, attempt_replayed)
    verification_state: mutable sview = "unknown"
    verification_state <- goal_state if difference_count == 0
    proof_push(buffer, "{\"format\":\"elisa-proof-proof-check-v1\",\"status\":")
    proof_push(buffer, "\"matches\"" if difference_count == 0 else "\"diverges\"")
    proof_push(buffer, ",\"verification_state\":")
    proof_push_json_string(buffer, verification_state)
    proof_push(buffer, ",\"goal_id\":")
    proof_push_number(buffer, claimed.goal_id.u32())
    # A faithful rendering of a goal in an inadmissible source still matches; the caller learns
    # here, and from exit status 1, that the match certifies nothing about the source.
    proof_push(buffer, ",\"admissible\":")
    proof_push(buffer, "true" if source_admissible else "false")
    proof_push(buffer, ",\"goal_admissible\":")
    proof_push(buffer, "true" if goal_source_admissible else "false")
    proof_push(buffer, ",\"difference_count\":")
    proof_push_number(buffer, difference_count.u32())
    proof_push(buffer, ",\"differences\":[")
    for index in 0..<differences.count |index, buffer, differences|:
        buffer.push(differences[index])
    proof_push(buffer, "]}\n")
    return 0 if difference_count == 0 and verification_state == "proved" else 1

def proof_push_elisa_proof(buffer: mutable darray[u8]&, report: ProofReport&, goal_id: usize, source_fingerprint: u32, source_complete: bool, source_admissible: bool) -> void can[Memory.Allocate, Abort.Panic]:
    if goal_id >= report.goal_attempts.count:
        proof_push_elisa_proof_with_replayed(buffer, report, goal_id, source_fingerprint, source_complete, source_admissible, false, false)
        return
    # This compatibility entrypoint has no frozen source inventories, so report-wide
    # admissibility cannot authorize the selected goal.
    # It also has no replay receipt, so it cannot authorize the selected certificate.
    proof_push_elisa_proof_with_replayed(buffer, report, goal_id, source_fingerprint, source_complete, source_admissible, false, false)

def proof_push_elisa_proof_with_replayed(buffer: mutable darray[u8]&, report: ProofReport&, goal_id: usize, source_fingerprint: u32, source_complete: bool, source_admissible: bool, goal_source_admissible: bool, certificate_replayed: bool) -> void can[Memory.Allocate, Abort.Panic]:
    proof_push(buffer, "# elisa-proof-proof-v1\n")
    if goal_id >= report.goal_attempts.count:
        proof_push(buffer, "# goal ")
        proof_push_number(buffer, goal_id.u32())
        proof_push(buffer, " does not exist in this source\n")
        return
    attempt: ProofGoalAttempt = report.goal_attempts[goal_id]
    origin_work: mutable usize = report.traces.lookup_work_used
    goal_verified: bool = proof_output_goal_state_with_source_admissibility(report, goal_id, goal_source_admissible, certificate_replayed) == "proved"
    proof_push(buffer, "# source: fingerprint fnv1a32=")
    proof_push_number(buffer, source_fingerprint)
    proof_push(buffer, ", complete=")
    proof_push(buffer, "true" if source_complete else "false")
    proof_push(buffer, ", admissible=")
    proof_push(buffer, "true" if source_admissible else "false")
    proof_push(buffer, ", goal_admissible=")
    proof_push(buffer, "true" if goal_source_admissible else "false")
    proof_push(buffer, "\n# goal ")
    proof_push_number(buffer, goal_id.u32())
    proof_push(buffer, " of ")
    proof_push_number(buffer, report.goal_attempts.count.u32())
    proof_push(buffer, ", rule ")
    proof_push(buffer, attempt.rule)
    proof_push(buffer, ", in ")
    proof_push(buffer, attempt.name)
    proof_push(buffer, " at line ")
    proof_push_number(buffer, attempt.line)
    proof_push(buffer, "\n")
    keyword: mutable sview = "open"
    keyword <- "unchecked" if attempt.proven or attempt.has_certificate
    keyword <- "proof" if goal_verified and certificate_replayed
    if not goal_verified and (attempt.proven or attempt.has_certificate):
        proof_push(buffer, "# the selected goal was not fully admitted as proved; this block is not a proof\n")
    proof_push(buffer, keyword)
    proof_push(buffer, " ")
    proof_push(buffer, attempt.name)
    proof_push(buffer, "_")
    proof_push_number(buffer, goal_id.u32())
    proof_push(buffer, ":\n")
    for fact_index in 0..<attempt.facts_count |fact_index, attempt, report, buffer, origin_work|:
        fact: Ast::Expr = report.certificate_facts[attempt.facts_start + fact_index]
        proof_push(buffer, "    given ")
        proof_push_elisa_expr(buffer, fact, false, 0)
        origin: (known: bool, kind: sview, line: u32, name: sview, dependency: sview, premises_count: usize) = proof_replay_fact_origin_at_with_work(report, attempt.facts_start + fact_index, attempt.name, origin_work)
        if origin.known:
            proof_push(buffer, "    # ")
            proof_push(buffer, origin.kind)
            proof_push(buffer, ", line ")
            proof_push_number(buffer, origin.line)
            if origin.dependency != "":
                proof_push(buffer, ", via ")
                proof_push(buffer, origin.dependency)
        else:
            proof_push(buffer, "    # unknown origin")
        proof_push(buffer, "\n")
    if proof_replay_fact_origin_work_exhausted(origin_work):
        proof_push(buffer, "# fact origin metadata incomplete: replay lookup work limit reached\n")
    proof_push(buffer, "    show ")
    proof_push_elisa_expr(buffer, attempt.goal, false, 0)
    proof_push(buffer, "\n")
    if goal_verified and certificate_replayed:
        proof_push(buffer, "    by kernel certificate ")
        proof_push_number(buffer, attempt.certificate_index.u32())
        proof_push(buffer, ", arena root ")
        proof_push_number(buffer, attempt.kernel_goal.u32())
        proof_push(buffer, "\nqed\n")
        return
    if attempt.proven and not certificate_replayed:
        proof_push(buffer, "    by producer only\n")
        return
    if certificate_replayed:
        proof_push(buffer, "    by kernel replay; selected-goal admission was not established\n")
        return
    if attempt.has_certificate:
        proof_push(buffer, "    by certificate not replayed\n")
        return
    selected: (known: bool, index: usize, ambiguous: bool) = proof_repair_finding_index(report, attempt, goal_id)
    proof_push(buffer, "    unproved: ")
    if selected.known:
        proof_push(buffer, report.findings[selected.index].kind)
        proof_push(buffer, " (")
        proof_push(buffer, report.findings[selected.index].status)
        proof_push(buffer, ") - ")
        proof_push(buffer, report.findings[selected.index].message)
    else:
        proof_push(buffer, "unknown")
    proof_push(buffer, "\n")

def proof_push_json_focused_goal(buffer: mutable darray[u8]&, report: ProofReport&, goal_id: usize, source_bytes: usize, source_fingerprint: u32, source_complete: bool, source_admissible: bool) -> void can[Memory.Allocate, Abort.Panic]:
    # This compatibility entrypoint has no frozen source inventories, so report-wide
    # admissibility cannot authorize the selected goal.
    # It also has no replay receipt, so it cannot authorize the selected attempt.
    proof_push_json_focused_goal_with_replayed(buffer, report, goal_id, source_bytes, source_fingerprint, source_complete, source_admissible, false, false)

def proof_push_json_focused_goal_with_replayed(buffer: mutable darray[u8]&, report: ProofReport&, goal_id: usize, source_bytes: usize, source_fingerprint: u32, source_complete: bool, source_admissible: bool, goal_source_admissible: bool, attempt_replayed: bool) -> void can[Memory.Allocate, Abort.Panic]:
    origin_work: mutable usize = report.traces.lookup_work_used
    found: bool = goal_id < report.goal_attempts.count
    proof_push(buffer, "{\"format\":\"elisa-proof-goal-v1\",\"status\":")
    if not found:
        proof_push_json_string(buffer, "not_found")
    else:
        attempt_status: mutable sview = proof_output_goal_state_with_source_admissibility(report, goal_id, goal_source_admissible, attempt_replayed)
        proof_push_json_string(buffer, attempt_status)
    proof_push(buffer, ",\"source\":{\"bytes\":")
    proof_push_number(buffer, source_bytes.u32())
    proof_push(buffer, ",\"fingerprint\":{\"algorithm\":\"fnv1a32\",\"value\":")
    proof_push_number(buffer, source_fingerprint)
    proof_push(buffer, "},\"complete\":")
    proof_push(buffer, "true" if source_complete else "false")
    proof_push(buffer, ",\"admissible\":")
    proof_push(buffer, "true" if source_admissible else "false")
    proof_push(buffer, "},\"goal_admissible\":")
    proof_push(buffer, "true" if goal_source_admissible else "false")
    proof_push(buffer, ",\"goal_id\":")
    proof_push_number(buffer, goal_id.u32())
    proof_push(buffer, ",\"goal_fingerprint\":")
    if found:
        fingerprint: (valid: bool, value: u32) = proof_goal_fingerprint(report, report.goal_attempts[goal_id])
        if fingerprint.valid:
            proof_push(buffer, "{\"algorithm\":\"fnv1a32-kernel-goal-v2\",\"value\":")
            proof_push_number(buffer, fingerprint.value)
            proof_push(buffer, "}")
        else:
            proof_push(buffer, "null")
    else:
        proof_push(buffer, "null")
    proof_push(buffer, ",\"goal\":")
    if not found:
        proof_push(buffer, "null,\"failure\":null}\n")
        return
    attempt: ProofGoalAttempt = report.goal_attempts[goal_id]
    replay_status: mutable sview = "not_certified"
    replay_status <- "gap" if attempt.has_certificate
    replay_status <- "replayed" if attempt_replayed
    proof_push(buffer, "{\"line\":")
    proof_push_number(buffer, attempt.line)
    proof_push(buffer, ",\"name\":")
    proof_push_json_string(buffer, attempt.name)
    proof_push(buffer, ",\"rule\":")
    proof_push_json_string(buffer, attempt.rule)
    proof_push(buffer, ",\"proven\":")
    replay_proven: bool = proof_output_goal_state_with_source_admissibility(report, goal_id, goal_source_admissible, attempt_replayed) == "proved"
    proof_push(buffer, "true" if replay_proven else "false")
    proof_push(buffer, ",\"replay_status\":")
    proof_push_json_string(buffer, replay_status)
    proof_push(buffer, ",\"certificate_id\":")
    if attempt.has_certificate and attempt.certificate_index < report.certificates.count:
        proof_push_number(buffer, attempt.certificate_index.u32())
    else:
        proof_push(buffer, "null")
    proof_push(buffer, ",\"kernel_goal\":")
    proof_push_number(buffer, attempt.kernel_goal.u32())
    proof_push(buffer, ",\"facts\":[")
    for fact_index in 0..<attempt.facts_count |fact_index, attempt, report, buffer|:
        proof_push(buffer, ",") if fact_index > 0
        proof_push_json_expr(buffer, report.certificate_facts[attempt.facts_start + fact_index])
    proof_push(buffer, "],\"fact_origins\":[")
    for fact_index in 0..<attempt.facts_count |fact_index, attempt, report, buffer, origin_work|:
        proof_push(buffer, ",") if fact_index > 0
        proof_push_json_fact_origin(buffer, report, attempt.facts_start + fact_index, attempt.name, origin_work)
    proof_push(buffer, "],\"fact_origins_complete\":true" if not proof_replay_fact_origin_work_exhausted(origin_work) else "],\"fact_origins_complete\":false")
    proof_push(buffer, ",\"dependencies\":")
    dependencies_complete: bool = proof_push_json_goal_dependencies(buffer, report, attempt.facts_start, attempt.facts_count, attempt.name, origin_work)
    proof_push(buffer, ",\"dependencies_complete\":true" if dependencies_complete else ",\"dependencies_complete\":false")
    proof_push(buffer, ",\"proposition\":")
    proof_push_json_expr(buffer, attempt.goal)
    proof_push(buffer, "},\"failure\":")
    if replay_proven:
        proof_push(buffer, "null")
    else:
        proof_push_json_repair_failure(buffer, report, attempt, goal_id)
    proof_push(buffer, "}\n")
