def proof_tactic_output_text_reserve(value: sview, work: mutable usize&) -> bool:
    limit: usize = ElisaProof::proof_replay_summary_source_work_limit()
    length: usize = sview_len(value)
    if length > limit / 6:
        work <- limit + 1
        return false
    proof_output_reserve_status_snapshot_work(work, length * 6)

def proof_push_json_tactic_step_with_work(buffer: mutable darray[u8]&, step: ProofTacticStep, work: mutable usize&) -> bool can[Memory.Allocate, Abort.Panic]:
    complete: mutable bool = true
    proof_push(buffer, "{\"action\":")
    if proof_tactic_output_text_reserve(step.action, work):
        proof_push_json_string(buffer, step.action)
    else:
        proof_push(buffer, "\"\"")
        complete <- false
    proof_push(buffer, ",\"accepted\":")
    proof_push(buffer, "true" if step.accepted else "false")
    proof_push(buffer, ",\"solved\":")
    proof_push(buffer, "true" if step.solved else "false")
    proof_push(buffer, ",\"facts_start\":")
    proof_push_number(buffer, step.facts_start.u32())
    proof_push(buffer, ",\"facts_count\":")
    proof_push_number(buffer, step.facts_count.u32())
    proof_push(buffer, ",\"goal\":")
    if proof_output_json_expr_reserve(step.goal, work):
        proof_push_json_expr(buffer, step.goal)
    else:
        proof_push(buffer, "null")
        complete <- false
    proof_push(buffer, ",\"reason\":")
    if proof_tactic_output_text_reserve(step.reason, work):
        proof_push_json_string(buffer, step.reason)
    else:
        proof_push(buffer, "\"\"")
        complete <- false
    proof_push(buffer, ",\"has_argument\":")
    proof_push(buffer, "true" if step.has_argument else "false")
    proof_push(buffer, ",\"argument\":")
    if step.has_argument:
        if proof_output_json_expr_reserve(step.argument, work):
            proof_push_json_expr(buffer, step.argument)
        else:
            proof_push(buffer, "null")
            complete <- false
    else:
        proof_push(buffer, "null")
    proof_push(buffer, ",\"has_secondary\":")
    proof_push(buffer, "true" if step.has_secondary else "false")
    proof_push(buffer, ",\"secondary\":")
    if step.has_secondary:
        if proof_output_json_expr_reserve(step.secondary, work):
            proof_push_json_expr(buffer, step.secondary)
        else:
            proof_push(buffer, "null")
            complete <- false
    else:
        proof_push(buffer, "null")
    proof_push(buffer, ",\"has_argument_index\":")
    proof_push(buffer, "true" if step.has_argument_index else "false")
    proof_push(buffer, ",\"argument_index\":")
    proof_push_number(buffer, step.argument_index.u32())
    proof_push(buffer, ",\"detail\":")
    if proof_tactic_output_text_reserve(step.detail, work):
        proof_push_json_string(buffer, step.detail)
    else:
        proof_push(buffer, "\"\"")
        complete <- false
    proof_push(buffer, "}")
    complete

def proof_push_json_tactic_state_prefix_with_work(buffer: mutable darray[u8]&, state: ProofTacticState&, work: mutable usize&) -> bool can[Memory.Allocate, Abort.Panic]:
    complete: mutable bool = proof_output_reserve_status_snapshot_work(work, 256)
    proof_push(buffer, "{\"solved\":")
    proof_push(buffer, "true" if state.solved else "false")
    proof_push(buffer, ",\"action_count\":")
    proof_push_number(buffer, state.action_count.u32())
    proof_push(buffer, ",\"initial_facts\":[")
    for index in 0..<state.initial_facts.count |index, state, buffer, work, complete|:
        if not proof_output_reserve_status_snapshot_work(work, 1):
            complete <- false
            break
        proof_push(buffer, ",") if index > 0
        if proof_output_json_expr_reserve(state.initial_facts[index], work):
            proof_push_json_expr(buffer, state.initial_facts[index])
        else:
            proof_push(buffer, "null")
            complete <- false
            break
    proof_push(buffer, "],\"initial_goal\":")
    if proof_output_json_expr_reserve(state.initial_goal, work):
        proof_push_json_expr(buffer, state.initial_goal)
    else:
        proof_push(buffer, "null")
        complete <- false
    proof_push(buffer, ",\"facts\":[")
    for index in 0..<state.facts.count |index, state, buffer, work, complete|:
        if not proof_output_reserve_status_snapshot_work(work, 1):
            complete <- false
            break
        proof_push(buffer, ",") if index > 0
        if proof_output_json_expr_reserve(state.facts[index], work):
            proof_push_json_expr(buffer, state.facts[index])
        else:
            proof_push(buffer, "null")
            complete <- false
            break
    proof_push(buffer, "],\"goal\":")
    if proof_output_json_expr_reserve(state.goal, work):
        proof_push_json_expr(buffer, state.goal)
    else:
        proof_push(buffer, "null")
        complete <- false
    proof_push(buffer, ",\"trace\":[")
    for index in 0..<state.trace.count |index, state, buffer, work, complete|:
        # Fixed keys and scalar fields dominate the minimum one-node expression's charge.
        if not proof_output_reserve_status_snapshot_work(work, 256):
            complete <- false
            break
        proof_push(buffer, ",") if index > 0
        complete <- false if not proof_push_json_tactic_step_with_work(buffer, state.trace[index], work)
    proof_push(buffer, "]")
    proof_push(buffer, ",\"detail_complete\":true" if complete and work <= ElisaProof::proof_replay_summary_source_work_limit() else ",\"detail_complete\":false")
    complete and work <= ElisaProof::proof_replay_summary_source_work_limit()

def proof_push_json_tactic_state_with_work(buffer: mutable darray[u8]&, state: ProofTacticState&, work: mutable usize&) -> bool can[Memory.Allocate, Abort.Panic]:
    complete: bool = proof_push_json_tactic_state_prefix_with_work(buffer, state, work)
    proof_push(buffer, "}")
    complete

def proof_push_json_tactic_tree_state_with_work(buffer: mutable darray[u8]&, tree: ProofTacticJsonTree&, node: usize, depth: usize, work: mutable usize&) -> bool can[Memory.Allocate, Abort.Panic]:
    requires depth <= ElisaProof::PROOF_JSON_BRANCH_DEPTH_LIMIT
    decreases ElisaProof::PROOF_JSON_BRANCH_DEPTH_LIMIT - depth
    if node >= tree.states.count or tree.has_branch.count != tree.states.count or tree.left.count != tree.states.count or tree.right.count != tree.states.count or not proof_output_reserve_status_snapshot_work(work, 32):
        proof_push(buffer, "null")
        return false
    complete: mutable bool = proof_push_json_tactic_state_prefix_with_work(buffer, tree.states[node], work)
    if tree.has_branch[node] and depth >= ElisaProof::PROOF_JSON_BRANCH_DEPTH_LIMIT:
        complete <- false
    elif tree.has_branch[node]:
        left: usize = tree.left[node]
        right: usize = tree.right[node]
        if left < node and right < node:
            proof_push(buffer, ",\"branches\":{\"left\":")
            complete <- proof_push_json_tactic_tree_state_with_work(buffer, tree, left, depth + 1, work) and complete
            proof_push(buffer, ",\"right\":")
            complete <- proof_push_json_tactic_tree_state_with_work(buffer, tree, right, depth + 1, work) and complete
            proof_push(buffer, "}")
        else:
            complete <- false
    proof_push(buffer, "}")
    complete and work <= ElisaProof::proof_replay_summary_source_work_limit()

def proof_attempt_refusal_gate_with_work(report: ProofReport&, attempt: ProofGoalAttempt, work: mutable usize&, refusal_work: mutable usize&) -> sview:
    return "budget" if attempt.budget_exhausted
    if attempt.facts_start > report.analysis_1.certificate_facts.count or attempt.facts_count > report.analysis_1.certificate_facts.count - attempt.facts_start:
        work <- ElisaProof::proof_replay_summary_source_work_limit() + 1
        return "unknown"
    if refusal_work == 0:
        if not proof_output_reserve_status_snapshot_work(work, ElisaProof::proof_refusal_gate_work_limit()):
            return "unknown"
    if not proof_output_reserve_status_snapshot_work(work, attempt.facts_count):
        return "unknown"
    facts: mutable darray[Ast::Expr] = []
    for fact_index in 0..<attempt.facts_count |fact_index, attempt, report, facts|:
        facts.push(report.analysis_1.certificate_facts[attempt.facts_start + fact_index])
    result: (gate: sview, complete: bool) = ElisaProof::proof_refusal_gate_with_work(facts, attempt.goal, report.source.source_annotations, false, refusal_work)
    work <- ElisaProof::proof_replay_summary_source_work_limit() + 1 if not result.complete
    return result.gate

include "./report_output_source_status.elisa"
include "./report_output_serialization_helpers.elisa"
include "./report_output_integrated_helpers.elisa"
