def proof_tactic_output_text_reserve(value: sview, work: mutable usize&) -> bool:
    limit: usize = ElisaProof::proof_replay_summary_source_work_limit()
    length: usize = sview_len(value)
    if length > limit / 6:
        work <- limit + 1
        return false
    proof_output_reserve_status_snapshot_work(work, length * 6)

def proof_push_json_tactic_step_with_work(buffer: mutable darray[u8]&, step: ProofTacticStep, work: mutable usize&) -> bool can[Memory.Allocate, Abort.Panic]:
    complete: mutable bool = true
    proof_push(buffer, "{\"action\":")
    if proof_tactic_output_text_reserve(step.action, work):
        proof_push_json_string(buffer, step.action)
    else:
        proof_push(buffer, "\"\"")
        complete <- false
    proof_push(buffer, ",\"accepted\":")
    proof_push(buffer, "true" if step.accepted else "false")
    proof_push(buffer, ",\"solved\":")
    proof_push(buffer, "true" if step.solved else "false")
    proof_push(buffer, ",\"facts_start\":")
    proof_push_number(buffer, step.facts_start.u32())
    proof_push(buffer, ",\"facts_count\":")
    proof_push_number(buffer, step.facts_count.u32())
    proof_push(buffer, ",\"goal\":")
    if proof_output_json_expr_reserve(step.goal, work):
        proof_push_json_expr(buffer, step.goal)
    else:
        proof_push(buffer, "null")
        complete <- false
    proof_push(buffer, ",\"reason\":")
    if proof_tactic_output_text_reserve(step.reason, work):
        proof_push_json_string(buffer, step.reason)
    else:
        proof_push(buffer, "\"\"")
        complete <- false
    proof_push(buffer, ",\"has_argument\":")
    proof_push(buffer, "true" if step.has_argument else "false")
    proof_push(buffer, ",\"argument\":")
    if step.has_argument:
        if proof_output_json_expr_reserve(step.argument, work):
            proof_push_json_expr(buffer, step.argument)
        else:
            proof_push(buffer, "null")
            complete <- false
    else:
        proof_push(buffer, "null")
    proof_push(buffer, ",\"has_secondary\":")
    proof_push(buffer, "true" if step.has_secondary else "false")
    proof_push(buffer, ",\"secondary\":")
    if step.has_secondary:
        if proof_output_json_expr_reserve(step.secondary, work):
            proof_push_json_expr(buffer, step.secondary)
        else:
            proof_push(buffer, "null")
            complete <- false
    else:
        proof_push(buffer, "null")
    proof_push(buffer, ",\"has_argument_index\":")
    proof_push(buffer, "true" if step.has_argument_index else "false")
    proof_push(buffer, ",\"argument_index\":")
    proof_push_number(buffer, step.argument_index.u32())
    proof_push(buffer, ",\"detail\":")
    if proof_tactic_output_text_reserve(step.detail, work):
        proof_push_json_string(buffer, step.detail)
    else:
        proof_push(buffer, "\"\"")
        complete <- false
    proof_push(buffer, "}")
    complete

def proof_push_json_tactic_state_prefix_with_work(buffer: mutable darray[u8]&, state: ProofTacticState&, work: mutable usize&) -> bool can[Memory.Allocate, Abort.Panic]:
    complete: mutable bool = proof_output_reserve_status_snapshot_work(work, 256)
    proof_push(buffer, "{\"solved\":")
    proof_push(buffer, "true" if state.solved else "false")
    proof_push(buffer, ",\"action_count\":")
    proof_push_number(buffer, state.action_count.u32())
    proof_push(buffer, ",\"initial_facts\":[")
    for index in 0..<state.initial_facts.count |index, state, buffer, work, complete|:
        if not proof_output_reserve_status_snapshot_work(work, 1):
            complete <- false
            break
        proof_push(buffer, ",") if index > 0
        if proof_output_json_expr_reserve(state.initial_facts[index], work):
            proof_push_json_expr(buffer, state.initial_facts[index])
        else:
            proof_push(buffer, "null")
            complete <- false
            break
    proof_push(buffer, "],\"initial_goal\":")
    if proof_output_json_expr_reserve(state.initial_goal, work):
        proof_push_json_expr(buffer, state.initial_goal)
    else:
        proof_push(buffer, "null")
        complete <- false
    proof_push(buffer, ",\"facts\":[")
    for index in 0..<state.facts.count |index, state, buffer, work, complete|:
        if not proof_output_reserve_status_snapshot_work(work, 1):
            complete <- false
            break
        proof_push(buffer, ",") if index > 0
        if proof_output_json_expr_reserve(state.facts[index], work):
            proof_push_json_expr(buffer, state.facts[index])
        else:
            proof_push(buffer, "null")
            complete <- false
            break
    proof_push(buffer, "],\"goal\":")
    if proof_output_json_expr_reserve(state.goal, work):
        proof_push_json_expr(buffer, state.goal)
    else:
        proof_push(buffer, "null")
        complete <- false
    proof_push(buffer, ",\"trace\":[")
    for index in 0..<state.trace.count |index, state, buffer, work, complete|:
        # Fixed keys and scalar fields dominate the minimum one-node expression's charge.
        if not proof_output_reserve_status_snapshot_work(work, 256):
            complete <- false
            break
        proof_push(buffer, ",") if index > 0
        complete <- false if not proof_push_json_tactic_step_with_work(buffer, state.trace[index], work)
    proof_push(buffer, "]")
    proof_push(buffer, ",\"detail_complete\":true" if complete and work <= ElisaProof::proof_replay_summary_source_work_limit() else ",\"detail_complete\":false")
    complete and work <= ElisaProof::proof_replay_summary_source_work_limit()

def proof_push_json_tactic_state_with_work(buffer: mutable darray[u8]&, state: ProofTacticState&, work: mutable usize&) -> bool can[Memory.Allocate, Abort.Panic]:
    complete: bool = proof_push_json_tactic_state_prefix_with_work(buffer, state, work)
    proof_push(buffer, "}")
    complete

def proof_push_json_tactic_tree_state_with_work(buffer: mutable darray[u8]&, tree: ProofTacticJsonTree&, node: usize, depth: usize, work: mutable usize&) -> bool can[Memory.Allocate, Abort.Panic]:
    requires depth <= ElisaProof::PROOF_JSON_BRANCH_DEPTH_LIMIT
    decreases ElisaProof::PROOF_JSON_BRANCH_DEPTH_LIMIT - depth
    if node >= tree.states.count or tree.has_branch.count != tree.states.count or tree.left.count != tree.states.count or tree.right.count != tree.states.count or not proof_output_reserve_status_snapshot_work(work, 32):
        proof_push(buffer, "null")
        return false
    complete: mutable bool = proof_push_json_tactic_state_prefix_with_work(buffer, tree.states[node], work)
    if tree.has_branch[node] and depth >= ElisaProof::PROOF_JSON_BRANCH_DEPTH_LIMIT:
        complete <- false
    elif tree.has_branch[node]:
        left: usize = tree.left[node]
        right: usize = tree.right[node]
        if left < node and right < node:
            proof_push(buffer, ",\"branches\":{\"left\":")
            complete <- proof_push_json_tactic_tree_state_with_work(buffer, tree, left, depth + 1, work) and complete
            proof_push(buffer, ",\"right\":")
            complete <- proof_push_json_tactic_tree_state_with_work(buffer, tree, right, depth + 1, work) and complete
            proof_push(buffer, "}")
        else:
            complete <- false
    proof_push(buffer, "}")
    complete and work <= ElisaProof::proof_replay_summary_source_work_limit()

def proof_tactic_result_admitted[@view](result: ProofTacticJsonResult, checked_view: ProofCheckedView[view]& @view, source_match: bool, target_bound: bool, target_goal_id: usize, target_fingerprint_match: bool) -> bool:
    tactic_admitted: bool = result.valid and result.certificate_replayed and source_match
    source_status: sview = "proved" if proof_checked_view_source_complete(checked_view) else "failed"
    target_admission_base: bool = proof_checked_view_target_admission_base(checked_view)
    target_source_admitted: bool = target_bound and proof_checked_view_goal_source_admissible(checked_view, target_goal_id) and proof_checked_view_goal_facts_source_admissible(checked_view, target_goal_id)
    # The CLI sets this true only when no target fingerprint was declared or when the declared
    # value exactly matches the checked-view goal. A stale/malformed binding cannot be metadata-only.
    return tactic_admitted and target_fingerprint_match and (target_bound and target_admission_base and target_source_admitted or not target_bound and source_status == "proved")

def proof_push_json_tactic_result[@view](buffer: mutable darray[u8]&, result: ProofTacticJsonResult, state: ProofTacticState&, tree: ProofTacticJsonTree&, checked_view: ProofCheckedView[view]& @view, source_match: bool, target_bound: bool, target_goal_id: usize, target_goal_fingerprint: u32, target_fingerprint_valid: bool, target_fingerprint_match: bool, target_previously_proven: bool) -> bool can[Memory.Allocate, Abort.Panic]:
    tactic_admitted: bool = result.valid and result.certificate_replayed and source_match
    source_bytes: usize = proof_checked_view_source_bytes(checked_view)
    source_fingerprint: u32 = proof_checked_view_source_fingerprint(checked_view)
    source_status: sview = "proved" if proof_checked_view_source_complete(checked_view) else "failed"
    source_admissible: bool = proof_checked_view_target_admission_base(checked_view) if target_bound else proof_checked_view_source_admissible(checked_view)
    target_source_admitted: bool = target_bound and proof_checked_view_goal_source_admissible(checked_view, target_goal_id) and proof_checked_view_goal_facts_source_admissible(checked_view, target_goal_id)
    serialization_work: mutable usize = 0
    result_text_complete: bool = proof_tactic_output_text_reserve(result.reason, &serialization_work)
    # A source-bound script proves exactly one imported obligation. It may therefore repair that
    # obligation while other logical goals remain open, but parse/import failures, semantic errors,
    # and replay gaps still poison the source boundary. An unbound portable script retains the
    # stricter whole-source gate because it has no proposition-level link to the imported program.
    admitted: bool = proof_tactic_result_admitted(result, checked_view, source_match, target_bound, target_goal_id, target_fingerprint_match)
    proof_push(buffer, "{\"format\":\"elisa-proof-tactic-result-v1\",\"status\":")
    proof_push_json_string(buffer, "proved" if admitted else "failed")
    proof_push(buffer, ",\"admission_scope\":")
    proof_push_json_string(buffer, "target" if target_bound else "portable")
    proof_push(buffer, ",\"source\":{\"bytes\":")
    proof_push_number(buffer, source_bytes.u32())
    proof_push(buffer, ",\"fingerprint\":")
    proof_push_number(buffer, source_fingerprint)
    proof_push(buffer, ",\"status\":")
    proof_push_json_string(buffer, source_status)
    proof_push(buffer, ",\"complete\":")
    proof_push(buffer, "true" if source_status == "proved" else "false")
    proof_push(buffer, ",\"admissible\":")
    proof_push(buffer, "true" if source_admissible else "false")
    proof_push(buffer, ",\"fingerprint_match\":")
    proof_push(buffer, "true" if source_match else "false")
    proof_push(buffer, "},\"source_goal_binding\":{\"bound\":")
    proof_push(buffer, "true" if target_bound else "false")
    proof_push(buffer, ",\"source_admissible\":")
    proof_push(buffer, "true" if target_source_admitted else "false")
    proof_push(buffer, ",\"goal_id\":")
    if target_bound:
        proof_push_number(buffer, target_goal_id.u32())
    else:
        proof_push(buffer, "null")
    proof_push(buffer, ",\"goal_fingerprint\":")
    if target_bound and target_fingerprint_valid:
        proof_push(buffer, "{\"algorithm\":\"fnv1a32-kernel-goal-v2\",\"value\":")
        proof_push_number(buffer, target_goal_fingerprint)
        proof_push(buffer, "}")
    else:
        proof_push(buffer, "null")
    proof_push(buffer, ",\"fingerprint_match\":")
    proof_push(buffer, "true" if target_fingerprint_match else "false")
    proof_push(buffer, ",\"previously_proven\":")
    proof_push(buffer, "true" if target_previously_proven else "false")
    proof_push(buffer, "},\"tactic\":{\"status\":")
    proof_push_json_string(buffer, "proved" if tactic_admitted else "failed")
    proof_push(buffer, ",\"valid\":")
    proof_push(buffer, "true" if result.valid else "false")
    proof_push(buffer, ",\"solved\":")
    proof_push(buffer, "true" if result.solved else "false")
    proof_push(buffer, ",\"action_count\":")
    proof_push_number(buffer, result.action_count.u32())
    proof_push(buffer, ",\"accepted_count\":")
    proof_push_number(buffer, result.accepted_count.u32())
    proof_push(buffer, ",\"trace_replayed\":")
    proof_push(buffer, "true" if result.trace_replayed else "false")
    proof_push(buffer, ",\"kernel_trace_replayed\":")
    proof_push(buffer, "true" if result.kernel_trace_replayed else "false")
    proof_push(buffer, ",\"kernel_replayed\":")
    proof_push(buffer, "true" if result.kernel_replayed else "false")
    proof_push(buffer, ",\"certificate_replayed\":")
    proof_push(buffer, "true" if result.certificate_replayed else "false")
    proof_push(buffer, ",\"branch_present\":")
    proof_push(buffer, "true" if result.branch_present else "false")
    proof_push(buffer, ",\"branch_certificate_replayed\":")
    proof_push(buffer, "true" if result.branch_certificate_replayed else "false")
    proof_push(buffer, ",\"reason\":")
    proof_push_json_string(buffer, result.reason) if result_text_complete else proof_push(buffer, "\"\"")
    proof_push(buffer, "},\"state\":")
    detail_start: usize = buffer.count
    state_complete: bool = proof_push_json_tactic_state_with_work(buffer, state, &serialization_work)
    branch_details_complete: mutable bool = true
    if result.branch_present:
        if result.tree_node < tree.states.count and tree.has_branch.count == tree.states.count and tree.left.count == tree.states.count and tree.right.count == tree.states.count and tree.has_branch[result.tree_node] and tree.left[result.tree_node] < result.tree_node and tree.right[result.tree_node] < result.tree_node:
            proof_push(buffer, ",\"branches\":{\"left\":")
            branch_details_complete <- proof_push_json_tactic_tree_state_with_work(buffer, tree, tree.left[result.tree_node], 0, &serialization_work)
            proof_push(buffer, ",\"right\":")
            branch_details_complete <- proof_push_json_tactic_tree_state_with_work(buffer, tree, tree.right[result.tree_node], 0, &serialization_work) and branch_details_complete
            proof_push(buffer, "}")
        else:
            branch_details_complete <- false
    details_complete: bool = result_text_complete and state_complete and branch_details_complete and serialization_work <= ElisaProof::proof_replay_summary_source_work_limit()
    proof_push(buffer, ",\"detail_complete\":true" if details_complete else ",\"detail_complete\":false")
    proof_push(buffer, "}\n")
    if not details_complete:
        buffer.count <- detail_start
        proof_push(buffer, "null")
        proof_push(buffer, ",\"branches\":null") if result.branch_present
        proof_push(buffer, ",\"detail_complete\":false}\n")
    details_complete

def proof_attempt_refusal_gate_with_work(report: ProofReport&, attempt: ProofGoalAttempt, work: mutable usize&) -> sview:
    return "unknown" if attempt.facts_start > report.analysis_1.certificate_facts.count or attempt.facts_count > report.analysis_1.certificate_facts.count - attempt.facts_start
    return "unknown" if not proof_output_reserve_status_snapshot_work(work, attempt.facts_count)
    facts: mutable darray[Ast::Expr] = []
    for fact_index in 0..<attempt.facts_count |fact_index, attempt, report, facts, work|:
        facts.push(report.analysis_1.certificate_facts[attempt.facts_start + fact_index])
    return ElisaProof::proof_refusal_gate_with_work(facts, attempt.goal, report.source.source_annotations, attempt.budget_exhausted, work)

include "./report_output_source_status.elisa"
include "./report_output_serialization_helpers.elisa"
include "./report_output_integrated_helpers.elisa"
