# Tactic/script CLI route. The dispatcher owns option parsing and source checking; this module
# owns the independent script parse, source-bound state reconstruction, tactic replay, and result.
module ElisaProofCliTactics:
    private:
        const SCRATCH_SLOT_COUNT: usize = PROOF_JSON_BRANCH_DEPTH_LIMIT

    public:
        def run(slots: mutable cstr&&, script_slot: usize, script_is_text: bool, report: mutable ProofReport&, source_bytes: usize, source_fingerprint: u32, import_failed: bool, semantic_errors: u32) -> i64:
            source_status: mutable sview = "proved"
            # The tactic boundary must reject incomplete imports even if the importer later
            # changes how it records its `import-error` finding.
            source_status <- "failed" if not proof_report_source_complete(report, import_failed, semantic_errors)
            source_admissible: bool = proof_report_source_admissible(report, import_failed, semantic_errors)
            script_source: mutable darray[u8] = proof_read_file(slots[script_slot].cast[cstr])
            # Human scripts lower to the JSON interchange and gain no independent trust path.
            script_source <- proof_tactic_text_to_json(script_source) if script_is_text

            # AST handles belong to the imported parser store. Export only the selected checked
            # sequent and reparse it in the tactic arena before running a source-bound script.
            source_target_state: mutable darray[u8] = []
            source_script_arena: mutable Arena = zeroed
            tactic_exit_status: mutable i64 = 1
            if script_source.count > 0:
                source_script: JsonParseResult[source_script_arena] = json_parse_checked(&source_script_arena, ElisaProofJson::bytes_range_ref(&script_source, 0, script_source.count))
                if source_script.code == JsonErrorCode.OK:
                    source_target: (present: bool, valid: bool, goal_id: usize) = proof_tactic_json_target(ElisaProofJson::from_result(source_script))
                    if source_target.present and source_target.valid and source_target.goal_id < report.goal_attempts.count:
                        source_attempt: ProofGoalAttempt = report.goal_attempts[source_target.goal_id]
                        if source_attempt.facts_start <= report.certificate_facts.count and source_attempt.facts_count <= report.certificate_facts.count - source_attempt.facts_start:
                            proof_push(&source_target_state, "{\"facts\":[")
                            for fact_index in 0..<source_attempt.facts_count |fact_index, source_attempt, report, source_target_state|:
                                proof_push(&source_target_state, ",") if fact_index > 0
                                proof_push_json_expr(&source_target_state, report.certificate_facts[source_attempt.facts_start + fact_index])
                            proof_push(&source_target_state, "],\"goal\":")
                            proof_push_json_expr(&source_target_state, source_attempt.goal)
                            proof_push(&source_target_state, "}")
            region tactic_region(PROOF_TACTIC_WORKSPACE_ARENA_BYTES):
                store: Ast::Node.Store[Local] = Ast::Node.Store(tactic_region)
                in store:
                    tactic_state: mutable ProofTacticState& @source_script_arena = proof_tactic_state_in_arena(&source_script_arena)
                    tactic_result: mutable ProofTacticJsonResult = ProofTacticJsonResult{reason: "proof script could not be read"}
                    source_match: mutable bool = false
                    target_bound: mutable bool = false
                    target_goal_id: mutable usize = 0
                    target_goal_fingerprint: mutable u32 = 0
                    target_fingerprint_valid: mutable bool = false
                    target_fingerprint_match: mutable bool = true
                    target_previously_proven: mutable bool = false
                    scratch_empty: mutable darray[Ast::Expr] @source_script_arena = []
                    scratch_states: mutable darray[ProofTacticJsonBranchScratch] @source_script_arena = []
                    for scratch_index in 0..<SCRATCH_SLOT_COUNT |scratch_index, scratch_empty, scratch_states|:
                        scratch_states.push(ProofTacticJsonBranchScratch{left: proof_tactic_state(&scratch_empty, Ast::Expr.Invalid), right: proof_tactic_state(&scratch_empty, Ast::Expr.Invalid)})
                    tactic_tree: mutable ProofTacticJsonTree& @source_script_arena = proof_tactic_tree_in_arena(&source_script_arena)
                    if script_source.count > 0:
                        parsed_script: JsonParseResult[source_script_arena] = json_parse_checked(&source_script_arena, ElisaProofJson::bytes_range_ref(&script_source, 0, script_source.count))
                        if parsed_script.code == JsonErrorCode.OK:
                            annotations: mutable darray[Ast::EnumAnnotation] @source_script_arena = []
                            target: (present: bool, valid: bool, goal_id: usize) = proof_tactic_json_target(ElisaProofJson::from_result(parsed_script))
                            target_bound <- target.present
                            target_goal_id <- target.goal_id
                            target_previously_proven <- report.goal_attempts[target.goal_id].proven if target.present and target.valid and target.goal_id < report.goal_attempts.count
                            if target.present and target.valid and target.goal_id < report.goal_attempts.count:
                                computed_target_fingerprint: (valid: bool, value: u32) = proof_goal_fingerprint(report, report.goal_attempts[target.goal_id])
                                target_fingerprint_valid <- computed_target_fingerprint.valid
                                target_goal_fingerprint <- computed_target_fingerprint.value
                            if target.present:
                                if target.valid:
                                    if source_target_state.count > 0:
                                        parsed_source_state: JsonParseResult[source_script_arena] = json_parse_checked(&source_script_arena, ElisaProofJson::bytes_range_ref(&source_target_state, 0, source_target_state.count))
                                        tactic_result <- proof_tactic_json_run_source(ElisaProofJson::from_result(parsed_script), ElisaProofJson::from_result(parsed_source_state), &annotations, tactic_state, tactic_tree, &scratch_states, report, target.goal_id) if parsed_source_state.code == JsonErrorCode.OK
                                else:
                                    tactic_result.valid <- false
                                    tactic_result.reason <- "target.goal_id must be an exact nonnegative integer"
                            else:
                                tactic_result <- proof_tactic_json_run(ElisaProofJson::from_result(parsed_script), &annotations, tactic_state, tactic_tree, &scratch_states)
                            declared_target_fingerprint: (present: bool, valid: bool, value: u32) = proof_tactic_json_target_fingerprint(ElisaProofJson::from_result(parsed_script))
                            if declared_target_fingerprint.present:
                                target_fingerprint_match <- declared_target_fingerprint.valid and target.present and target.valid and target_fingerprint_valid and declared_target_fingerprint.value == target_goal_fingerprint
                                if not declared_target_fingerprint.valid:
                                    tactic_result.valid <- false
                                    tactic_result.reason <- "target.goal_fingerprint must be an exact unsigned 32-bit integer"
                                elif not target_fingerprint_match:
                                    tactic_result.valid <- false
                                    tactic_result.reason <- "target.goal_fingerprint does not match the imported kernel goal and hypotheses"
                            declared: (present: bool, valid: bool, value: u32) = proof_tactic_json_source_fingerprint(ElisaProofJson::from_result(parsed_script))
                            source_match <- not declared.present or declared.valid and declared.value == source_fingerprint
                            if declared.present and not declared.valid:
                                source_match <- false
                                tactic_result.valid <- false
                                tactic_result.reason <- "source_fingerprint must be an exact unsigned 32-bit integer"
                            elif declared.present and declared.value != source_fingerprint:
                                source_match <- false
                                tactic_result.valid <- false
                                tactic_result.reason <- "proof script source_fingerprint does not match imported Elisa"
                        else:
                            source_match <- false
                            tactic_result.reason <- "proof script is not valid JSON"
                    output: mutable darray[u8] = []
                    proof_push_json_tactic_result(&output, tactic_result, tactic_state, tactic_tree, source_bytes, source_fingerprint, source_status, source_admissible, source_match, target_bound, target_goal_id, target_goal_fingerprint, target_fingerprint_valid, target_fingerprint_match, target_previously_proven)
                    proof_write(output)
                    admitted: bool = proof_tactic_result_admitted(tactic_result, source_status, source_admissible, source_match, target_bound)
                    tactic_exit_status <- 0 if admitted else 1
            arena_free(&source_script_arena)
            return tactic_exit_status
