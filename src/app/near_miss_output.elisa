# A diagnostic explanation for an unproven goal (BACKLOG H-03). It never affects acceptance:
# `relevant_facts` lists the indices of the goal's facts that share a name with the goal (the
# facts that came closest to proving it), and `missing_fact` is the goal itself, the weakest
# single extra fact that would close it. An agent repairs the goal by establishing that fact
# from the relevant ones, usually as a `requires` or a loop guard.
def proof_push_json_near_miss(buffer: mutable darray[u8]&, report: ProofReport&, attempt: ProofGoalAttempt) -> void can[Memory.Allocate, Abort.Panic]:
    names: mutable darray[sview] = []
    proof_counterexample_collect_names(attempt.goal, &names)
    proof_push(buffer, "{\"goal_names\":[")
    for name_index in 0..<names.count |name_index, names, buffer|:
        proof_push(buffer, ",") if name_index > 0
        proof_push_json_string(buffer, names[name_index])
    proof_push(buffer, "],\"relevant_facts\":[")
    written: mutable usize = 0
    for fact_index in 0..<attempt.facts_count |fact_index, attempt, report, buffer, names, written|:
        fact: Ast::Expr = report.certificate_facts[attempt.facts_start + fact_index]
        shared: mutable bool = false
        for name_index in 0..<names.count |name_index, names, fact, shared|:
            shared <- true if proof_expr_mentions_name(fact, names[name_index])
        if shared:
            proof_push(buffer, ",") if written > 0
            proof_push_number(buffer, fact_index.u32())
            written <- written + 1
    proof_push(buffer, "],\"missing_fact\":")
    proof_push_json_expr(buffer, attempt.goal)
    proof_push(buffer, ",\"linear_rows\":")
    proof_push_json_linear_rows(buffer, report, attempt)
    proof_push(buffer, "}")
