def proof_main(argc: i64, argv: mutable void&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
    if argc < 2:
        usage: mutable darray[u8] = []
        proof_push(&usage, "usage: elisa-proof [--json|--theorems] <file.elisa> | --goal <id> <file.elisa> | --proof <id> <file.elisa> | --check-proof <proof.txt> <file.elisa> | --script <proof.txt> <file.elisa> | --repair <id> <file.elisa> | --repair-all <file.elisa> | --suggest <id> <file.elisa> | --tactics <proof.json> <file.elisa>\n")
        proof_write(usage)
        return 2
    slots: mutable cstr&& = argv.cast[mutable cstr&&]
    json_output: mutable bool = false
    goal_json_output: mutable bool = false
    suggestion_json_output: mutable bool = false
    theorem_json_output: mutable bool = false
    proof_text_output: mutable bool = false
    proof_check_output: mutable bool = false
    script_is_text: mutable bool = false
    repair_output: mutable bool = false
    repair_all_output: mutable bool = false
    focused_goal_id: mutable usize = 0
    tactic_json_output: mutable bool = false
    script_slot: mutable usize = 0
    path_slot: mutable usize = 1
    first_argument: cstr = slots[1].cast[cstr]
    if proof_cstr_equals(first_argument, "--tactics"):
        tactic_json_output <- true
        script_slot <- 2
        path_slot <- 3
        if argc < 4:
            usage: mutable darray[u8] = []
            proof_push(&usage, "usage: elisa-proof --tactics <proof.json> <file.elisa>\n")
            proof_write(usage)
            return 2
    elif proof_cstr_equals(first_argument, "--json"):
        json_output <- true
        if argc < 3:
            usage: mutable darray[u8] = []
            proof_push(&usage, "usage: elisa-proof --json <file.elisa>\n")
            proof_write(usage)
            return 2
        path_slot <- 2
    elif proof_cstr_equals(first_argument, "--goal"):
        goal_json_output <- true
        if argc < 4:
            usage: mutable darray[u8] = []
            proof_push(&usage, "usage: elisa-proof --goal <id> <file.elisa>\n")
            proof_write(usage)
            return 2
        parsed_goal: (valid: bool, parsed: u32) = proof_cstr_u32(slots[2].cast[cstr])
        if not parsed_goal.valid:
            message: mutable darray[u8] = []
            proof_push(&message, "elisa-proof: goal id must be an unsigned 32-bit integer\n")
            proof_write(message)
            return 2
        focused_goal_id <- parsed_goal.parsed.usize()
        path_slot <- 3
    elif proof_cstr_equals(first_argument, "--proof"):
        proof_text_output <- true
        if argc < 4:
            usage: mutable darray[u8] = []
            proof_push(&usage, "usage: elisa-proof --proof <id> <file.elisa>\n")
            proof_write(usage)
            return 2
        parsed_goal: (valid: bool, parsed: u32) = proof_cstr_u32(slots[2].cast[cstr])
        if not parsed_goal.valid:
            message: mutable darray[u8] = []
            proof_push(&message, "elisa-proof: goal id must be an unsigned 32-bit integer\n")
            proof_write(message)
            return 2
        focused_goal_id <- parsed_goal.parsed.usize()
        path_slot <- 3
    elif proof_cstr_equals(first_argument, "--repair-all"):
        repair_all_output <- true
        if argc < 3:
            usage: mutable darray[u8] = []
            proof_push(&usage, "usage: elisa-proof --repair-all <file.elisa>\n")
            proof_write(usage)
            return 2
        path_slot <- 2
    elif proof_cstr_equals(first_argument, "--repair"):
        repair_output <- true
        if argc < 4:
            usage: mutable darray[u8] = []
            proof_push(&usage, "usage: elisa-proof --repair <id> <file.elisa>\n")
            proof_write(usage)
            return 2
        parsed_goal: (valid: bool, parsed: u32) = proof_cstr_u32(slots[2].cast[cstr])
        if not parsed_goal.valid:
            message: mutable darray[u8] = []
            proof_push(&message, "elisa-proof: goal id must be an unsigned 32-bit integer\n")
            proof_write(message)
            return 2
        focused_goal_id <- parsed_goal.parsed.usize()
        path_slot <- 3
    elif proof_cstr_equals(first_argument, "--script"):
        tactic_json_output <- true
        script_is_text <- true
        script_slot <- 2
        path_slot <- 3
        if argc < 4:
            usage: mutable darray[u8] = []
            proof_push(&usage, "usage: elisa-proof --script <proof.txt> <file.elisa>\n")
            proof_write(usage)
            return 2
    elif proof_cstr_equals(first_argument, "--check-proof"):
        proof_check_output <- true
        script_slot <- 2
        path_slot <- 3
        if argc < 4:
            usage: mutable darray[u8] = []
            proof_push(&usage, "usage: elisa-proof --check-proof <proof.txt> <file.elisa>\n")
            proof_write(usage)
            return 2
    elif proof_cstr_equals(first_argument, "--theorems"):
        theorem_json_output <- true
        if argc < 3:
            usage: mutable darray[u8] = []
            proof_push(&usage, "usage: elisa-proof --theorems <file.elisa>\n")
            proof_write(usage)
            return 2
        path_slot <- 2
    elif proof_cstr_equals(first_argument, "--suggest"):
        suggestion_json_output <- true
        if argc < 4:
            usage: mutable darray[u8] = []
            proof_push(&usage, "usage: elisa-proof --suggest <id> <file.elisa>\n")
            proof_write(usage)
            return 2
        parsed_goal: (valid: bool, parsed: u32) = proof_cstr_u32(slots[2].cast[cstr])
        if not parsed_goal.valid:
            message: mutable darray[u8] = []
            proof_push(&message, "elisa-proof: goal id must be an unsigned 32-bit integer\n")
            proof_write(message)
            return 2
        focused_goal_id <- parsed_goal.parsed.usize()
        path_slot <- 3
    path: cstr = slots[path_slot].cast[cstr]
    root_path: mutable darray[u8] = []
    path_index: mutable usize = 0
    while path[path_index] != 0 |path_index, root_path, path|:
        root_path.push(path[path_index])
        path_index <- path_index + 1
    root_read: (ok: bool, contents: darray[u8]) = proof_read_file_checked(path)
    source: mutable darray[u8] = root_read.contents
    if not root_read.ok:
        message: mutable darray[u8] = []
        proof_push(&message, "elisa-proof: could not read source\n")
        proof_write(message)
        return 2
    import_failed: mutable bool = false
    imported_source: mutable darray[u8] = proof_import_source(root_path, &import_failed)
    if imported_source.count > 0 or import_failed:
        source <- imported_source
    source_bytes: usize = source.count
    source_fingerprint: u32 = proof_source_fingerprint(source)
    source.push(0)
    file: Ast::File = frontend_parse(&source[0])
    report: mutable ProofReport = proof_empty_report()
    proof_check(file, &report)
    proof_replay_certificates(&report)
    proof_add_finding(&report, "import-error", 0, "", "one or more Elisa include files could not be read") if import_failed
    semantic_diagnostics: mutable darray[Semantic::Diagnostic] = []
    # Run the compiler's strongest built-in semantic mode as a second defense layer. The
    # custom proof kernel remains the verdict for proof obligations; this flag only enables
    # additional compiler-side refinement/invariant diagnostics.
    Semantic::check_full_diagnostics(file, &semantic_diagnostics, false, false, false, false, true, false, false, false, false, false, 64, false)
    semantic_errors: mutable u32 = 0
    semantic_visible: mutable u32 = 0
    # `assert … by:` is the compiler's legacy proof-block hook. The custom kernel below
    # owns this obligation now, including bounded arithmetic and recursive rules that the
    # compiler's general semantic pass does not know about. Keep every other compiler
    # diagnostic as an independent defense layer, but do not apply the weaker legacy
    # proof result a second time after the kernel has accepted the same AST.
    # The compiler's mutual-decreases pass predates structural SCC certificates and cannot
    # recognize a mutual call that receives a matched strict subterm. Suppress only that one
    # diagnostic when the custom kernel recorded a verified same-type structural SCC member;
    # all unrelated compiler diagnostics remain visible and fatal as before.
    for diagnostic in semantic_diagnostics |semantic_visible, report|:
        continue if not proof_semantic_diagnostic_visible(diagnostic, report)
        semantic_visible <- semantic_visible + 1
    for diagnostic in semantic_diagnostics |semantic_errors, report|:
        continue if not proof_semantic_diagnostic_visible(diagnostic, report)
        semantic_errors <- semantic_errors + 1 if Semantic::diagnostic_severity(diagnostic) == 1
    if goal_json_output:
        source_complete: bool = report.failed == 0 and not proof_report_has_open_goals(report) and report.replay_gaps == 0 and semantic_errors == 0 and not import_failed
        source_admissible: bool = not import_failed and semantic_errors == 0 and report.replay_gaps == 0
        focused: mutable darray[u8] = []
        proof_push_json_focused_goal(&focused, report, focused_goal_id, source_bytes, source_fingerprint, source_complete, source_admissible)
        proof_write(focused)
        return 0 if focused_goal_id < report.goal_attempts.count else 2
    if proof_check_output:
        source_complete: bool = report.failed == 0 and not proof_report_has_open_goals(report) and report.replay_gaps == 0 and semantic_errors == 0 and not import_failed
        source_admissible: bool = not import_failed and semantic_errors == 0 and report.replay_gaps == 0
        script_read: (ok: bool, contents: darray[u8]) = proof_read_file_checked(slots[script_slot].cast[cstr])
        if not script_read.ok:
            message: mutable darray[u8] = []
            proof_push(&message, "{\"format\":\"elisa-proof-proof-check-v1\",\"status\":\"unreadable\",\"goal_id\":null,\"differences\":[]}\n")
            proof_write(message)
            return 2
        checked: mutable darray[u8] = []
        check_status: i64 = proof_push_proof_check(&checked, report, script_read.contents, source_fingerprint, source_complete, source_admissible)
        proof_write(checked)
        return check_status
    if proof_text_output:
        source_complete: bool = report.failed == 0 and not proof_report_has_open_goals(report) and report.replay_gaps == 0 and semantic_errors == 0 and not import_failed
        source_admissible: bool = not import_failed and semantic_errors == 0 and report.replay_gaps == 0
        rendered: mutable darray[u8] = []
        proof_push_elisa_proof(&rendered, report, focused_goal_id, source_fingerprint, source_complete, source_admissible)
        proof_write(rendered)
        return 0 if focused_goal_id < report.goal_attempts.count else 2
    if theorem_json_output:
        source_complete: bool = report.failed == 0 and not proof_report_has_open_goals(report) and report.replay_gaps == 0 and semantic_errors == 0 and not import_failed
        source_admissible: bool = not import_failed and semantic_errors == 0 and report.replay_gaps == 0
        catalog: mutable darray[u8] = []
        proof_push_json_theorem_catalog(&catalog, report, source_bytes, source_fingerprint, source_complete, source_admissible)
        proof_write(catalog)
        return 0
    if suggestion_json_output:
        source_complete: bool = report.failed == 0 and not proof_report_has_open_goals(report) and report.replay_gaps == 0 and semantic_errors == 0 and not import_failed
        source_admissible: bool = not import_failed and semantic_errors == 0 and report.replay_gaps == 0
        suggestions: mutable darray[u8] = []
        proof_push_json_suggestions(&suggestions, report, file.enum_annotations, focused_goal_id, source_bytes, source_fingerprint, source_complete, source_admissible)
        proof_write(suggestions)
        return 0 if focused_goal_id < report.goal_attempts.count else 2
    if repair_output or repair_all_output:
        source_admissible: bool = not import_failed and semantic_errors == 0 and report.replay_gaps == 0
        response: mutable darray[u8] = []
        if repair_all_output:
            # The whole unresolved queue in one pass, in goal order. A goal the checker already
            # proved is not a repair target: only what the report still reports as open is tried.
            repaired_count: mutable usize = 0
            unresolved_count: mutable usize = 0
            entries: mutable darray[u8] = []
            for goal_index in 0..<report.goal_attempts.count |goal_index, report, entries, repaired_count, unresolved_count|:
                continue if report.goal_attempts[goal_index].proven
                unresolved_count <- unresolved_count + 1
                batch_found: (repaired: bool, searched: usize, actions: sview) = proof_repair_search(report, goal_index)
                repaired_count <- repaired_count + 1 if batch_found.repaired
                proof_push(&entries, ",") if unresolved_count > 1
                proof_push_repair_goal(&entries, report, goal_index, batch_found)
            proof_push(&response, "{\"format\":\"elisa-proof-repair-batch-v1\",\"status\":")
            if unresolved_count == 0:
                proof_push(&response, "\"nothing_to_repair\"")
            else:
                proof_push(&response, "\"repaired\"" if repaired_count == unresolved_count else "\"partial\"")
            proof_push(&response, ",\"source\":{\"fingerprint\":")
            proof_push_number(&response, source_fingerprint)
            proof_push(&response, ",\"admissible\":")
            proof_push(&response, "true" if source_admissible else "false")
            proof_push(&response, "},\"summary\":{\"unresolved\":")
            proof_push_number(&response, unresolved_count.u32())
            proof_push(&response, ",\"repaired\":")
            proof_push_number(&response, repaired_count.u32())
            proof_push(&response, ",\"candidates\":")
            proof_push_number(&response, proof_repair_candidates().count.u32())
            proof_push(&response, "},\"goals\":[")
            for entry_index in 0..<entries.count |entry_index, response, entries|:
                response.push(entries[entry_index])
            proof_push(&response, "]}\n")
            proof_write(response)
            return 0 if repaired_count == unresolved_count else 1
        found: (repaired: bool, searched: usize, actions: sview) = proof_repair_search(report, focused_goal_id)
        proof_push(&response, "{\"format\":\"elisa-proof-repair-v1\",\"status\":")
        if focused_goal_id >= report.goal_attempts.count:
            proof_push(&response, "\"not_found\"")
        else:
            proof_push(&response, "\"repaired\"" if found.repaired else "\"unrepaired\"")
        proof_push(&response, ",\"goal_id\":")
        proof_push_number(&response, focused_goal_id.u32())
        proof_push(&response, ",\"source\":{\"fingerprint\":")
        proof_push_number(&response, source_fingerprint)
        proof_push(&response, ",\"admissible\":")
        proof_push(&response, "true" if source_admissible else "false")
        proof_push(&response, "},\"search\":{\"candidates\":")
        proof_push_number(&response, proof_repair_candidates().count.u32())
        proof_push(&response, ",\"tried\":")
        proof_push_number(&response, found.searched.u32())
        proof_push(&response, ",\"exhaustive\":")
        proof_push(&response, "false" if found.repaired else "true")
        proof_push(&response, "},\"script\":")
        if found.repaired:
            script_body: mutable darray[u8] = []
            proof_repair_push_script_text(&script_body, report, focused_goal_id, found.actions)
            proof_push_json_bytes(&response, script_body)
        else:
            proof_push(&response, "null")
        proof_push(&response, "}\n")
        proof_write(response)
        return 2 if focused_goal_id >= report.goal_attempts.count else (0 if found.repaired else 1)
    if tactic_json_output:
        source_status: mutable sview = "proved"
        source_status <- "failed" if report.failed > 0 or proof_report_has_open_goals(report) or report.replay_gaps > 0 or semantic_errors > 0
        source_admissible: bool = not import_failed and semantic_errors == 0 and report.replay_gaps == 0
        script_source: mutable darray[u8] = proof_read_file(slots[script_slot].cast[cstr])
        # A human-written script is translated into the same interchange a JSON script uses, so it
        # runs through exactly the checked engine and gains no path of its own.
        script_source <- proof_tactic_text_to_json(script_source) if script_is_text
        # A source-bound tactic state must be rebuilt in the tactic store. AST values are opaque
        # handles tied to the imported parser store, so export the selected attempt to the same
        # JSON expression interchange used by --json and reparse it below in the fresh store.
        source_target_state: mutable darray[u8] = []
        source_script_arena: mutable Arena = zeroed
        if script_source.count > 0:
            source_script: JsonParseResult = json_parse_checked(&source_script_arena, sview(&script_source[0], 0, script_source.count.i64()))
            if source_script.code == JsonErrorCode.OK:
                source_target: (present: bool, valid: bool, goal_id: usize) = proof_tactic_json_target(source_script.value)
                if source_target.present and source_target.valid and source_target.goal_id < report.goal_attempts.count:
                    source_attempt: ProofGoalAttempt = report.goal_attempts[source_target.goal_id]
                    if source_attempt.facts_start <= report.certificate_facts.count and source_attempt.facts_count <= report.certificate_facts.count - source_attempt.facts_start:
                        proof_push(&source_target_state, "{\"facts\":[")
                        for fact_index in 0..<source_attempt.facts_count |fact_index, source_attempt, report, source_target_state|:
                            proof_push(&source_target_state, ",") if fact_index > 0
                            proof_push_json_expr(&source_target_state, report.certificate_facts[source_attempt.facts_start + fact_index])
                        proof_push(&source_target_state, "],\"goal\":")
                        proof_push_json_expr(&source_target_state, source_attempt.goal)
                        proof_push(&source_target_state, "}")
        region tactic_region(1048576):
            store: Ast::Node.Store[Local] = Ast::Node.Store(tactic_region)
            in store:
                empty: mutable darray[Ast::Expr] = []
                tactic_state: mutable ProofTacticState = proof_tactic_state(&empty, Ast::Expr.Invalid)
                tactic_result: mutable ProofTacticJsonResult = ProofTacticJsonResult{valid: false, solved: false, trace_replayed: false, kernel_trace_replayed: false, kernel_replayed: false, certificate_replayed: false, branch_present: false, branch_certificate_replayed: false, action_count: 0, accepted_count: 0, reason: "proof script could not be read", tree_node: 0}
                source_match: mutable bool = false
                target_bound: mutable bool = false
                target_goal_id: mutable usize = 0
                target_goal_fingerprint: mutable u32 = 0
                target_fingerprint_valid: mutable bool = false
                target_fingerprint_match: mutable bool = true
                target_previously_proven: mutable bool = false
                script_arena: mutable Arena = zeroed
                scratch_empty: mutable darray[Ast::Expr] = []
                scratch_states: mutable darray[ProofTacticState] = []
                for scratch_index in 0..<64 |scratch_index, scratch_empty, scratch_states|:
                    scratch_states.push(proof_tactic_state(&scratch_empty, Ast::Expr.Invalid))
                tactic_tree: mutable ProofTacticJsonTree = ProofTacticJsonTree{states: [], left: [], right: [], has_branch: []}
                if script_source.count > 0:
                    parsed_script: JsonParseResult = json_parse_checked(&script_arena, sview(&script_source[0], 0, script_source.count.i64()))
                    if parsed_script.code == JsonErrorCode.OK:
                        annotations: mutable darray[Ast::EnumAnnotation] = []
                        target: (present: bool, valid: bool, goal_id: usize) = proof_tactic_json_target(parsed_script.value)
                        target_bound <- target.present
                        target_goal_id <- target.goal_id
                        target_previously_proven <- report.goal_attempts[target.goal_id].proven if target.present and target.valid and target.goal_id < report.goal_attempts.count
                        if target.present and target.valid and target.goal_id < report.goal_attempts.count:
                            computed_target_fingerprint: (valid: bool, value: u32) = proof_goal_fingerprint(report, report.goal_attempts[target.goal_id])
                            target_fingerprint_valid <- computed_target_fingerprint.valid
                            target_goal_fingerprint <- computed_target_fingerprint.value
                        if target.present:
                            if target.valid:
                                if source_target_state.count > 0:
                                    parsed_source_state: JsonParseResult = json_parse_checked(&script_arena, sview(&source_target_state[0], 0, source_target_state.count.i64()))
                                    tactic_result <- proof_tactic_json_run_source(parsed_script.value, parsed_source_state.value, &annotations, &tactic_state, &tactic_tree, &scratch_states, report, target.goal_id) if parsed_source_state.code == JsonErrorCode.OK
                            else:
                                tactic_result.valid <- false
                                tactic_result.reason <- "target.goal_id must be an exact nonnegative integer"
                        else:
                            tactic_result <- proof_tactic_json_run(parsed_script.value, &annotations, &tactic_state, &tactic_tree, &scratch_states)
                        declared_target_fingerprint: (present: bool, valid: bool, value: u32) = proof_tactic_json_target_fingerprint(parsed_script.value)
                        if declared_target_fingerprint.present:
                            target_fingerprint_match <- declared_target_fingerprint.valid and target.present and target.valid and target_fingerprint_valid and declared_target_fingerprint.value == target_goal_fingerprint
                            if not declared_target_fingerprint.valid:
                                tactic_result.valid <- false
                                tactic_result.reason <- "target.goal_fingerprint must be an exact unsigned 32-bit integer"
                            elif not target_fingerprint_match:
                                tactic_result.valid <- false
                                tactic_result.reason <- "target.goal_fingerprint does not match the imported kernel goal and hypotheses"
                        declared: (present: bool, valid: bool, value: u32) = proof_tactic_json_source_fingerprint(parsed_script.value)
                        source_match <- not declared.present or declared.valid and declared.value == source_fingerprint
                        if declared.present and not declared.valid:
                            source_match <- false
                            tactic_result.valid <- false
                            tactic_result.reason <- "source_fingerprint must be an exact unsigned 32-bit integer"
                        elif declared.present and declared.value != source_fingerprint:
                            source_match <- false
                            tactic_result.valid <- false
                            tactic_result.reason <- "proof script source_fingerprint does not match imported Elisa"
                    else:
                        source_match <- false
                        tactic_result.reason <- "proof script is not valid JSON"
                output: mutable darray[u8] = []
                proof_push_json_tactic_result(&output, tactic_result, &tactic_state, &tactic_tree, source_bytes, source_fingerprint, source_status, source_admissible, source_match, target_bound, target_goal_id, target_goal_fingerprint, target_fingerprint_valid, target_fingerprint_match, target_previously_proven)
                proof_write(output)
                admitted: bool = proof_tactic_result_admitted(tactic_result, source_status, source_admissible, source_match, target_bound)
                return 0 if admitted else 1
    if json_output:
        json: mutable darray[u8] = []
        proof_push_json_report(&json, report, semantic_diagnostics, semantic_visible, semantic_errors, source_bytes, source_fingerprint)
        proof_write(json)
        return 1 if report.failed > 0 or proof_report_has_open_goals(report) or report.replay_gaps > 0 or semantic_errors > 0 else 0
    output: mutable darray[u8] = []
    proof_push(&output, "Elisa Proof\n")
    proof_push(&output, "  verification state: ")
    proof_push(&output, proof_report_verification_state(report, semantic_errors))
    proof_push(&output, "\n")
    proof_push(&output, "  declarations: ")
    proof_push_number(&output, report.declarations)
    proof_push(&output, "\n  obligations: ")
    proof_push_number(&output, report.obligations)
    proof_push(&output, "\n  proven: ")
    proof_push_number(&output, report.proven)
    proof_push(&output, "\n  failed: ")
    proof_push_number(&output, report.failed)
    proof_push(&output, "\n")
    for finding in report.findings |output|:
        proof_push(&output, "  ")
        proof_push(&output, finding.kind)
        proof_push(&output, " [")
        proof_push(&output, finding.status)
        proof_push(&output, "]")
        proof_push(&output, " line ")
        proof_push_number(&output, finding.line)
        proof_push(&output, ": ")
        proof_push(&output, finding.message)
        proof_push(&output, "\n")
    proof_push(&output, "  semantic diagnostics: ")
    proof_push_number(&output, semantic_visible)
    proof_push(&output, "\n")
    proof_push(&output, "  certificate replay: ")
    proof_push_number(&output, report.replayed)
    proof_push(&output, " replayed, ")
    proof_push_number(&output, report.replay_gaps)
    proof_push(&output, " gaps\n")
    proof_push(&output, "  source-neutral kernel: ")
    proof_push_number(&output, report.kernel_nodes.count.u32())
    proof_push(&output, " nodes, format elisa-proof-kernel-v1\n")
    for diagnostic in semantic_diagnostics |output, report|:
        continue if diagnostic.kind == Semantic::DiagnosticKind.AssertByUnproven
        continue if diagnostic.kind == Semantic::DiagnosticKind.MutualDecreasesCycle and any verified_name in report.structural_verified_names where verified_name == diagnostic.name
        proof_push(&output, "  semantic line ")
        proof_push_number(&output, diagnostic.line)
        proof_push(&output, ": ")
        message: darray[u8] = Semantic::diagnostic_message(diagnostic)
        output.extend(message)
        proof_push(&output, "\n")
    proof_write(output)
    return 1 if report.failed > 0 or proof_report_has_open_goals(report) or report.replay_gaps > 0 or semantic_errors > 0 else 0

