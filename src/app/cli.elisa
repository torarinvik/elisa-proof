include "./cli_usage.elisa"
include "./cli_tactics.elisa"

def proof_source_file_count(files: darray[u8]&) -> usize:
    count: mutable usize = 0
    for byte in files |count|:
        count <- count + 1 if byte == 0
    return count

def proof_cli_semantic_diagnostics_in_arena[@r](arena: mutable Arena& @r) -> mutable darray[Semantic::Diagnostic]& @r:
    in arena:
        empty: mutable darray[Semantic::Diagnostic] = []
        return new[r] empty

def proof_main(argc: i64, argv: mutable void&) -> i64 can[Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast, Console, Global.Read, Global.Write]:
    source_arena: mutable Arena = zeroed
    status: i64 = (proof_main_with_source_arena(argc, argv, &source_arena) can Global{Read,Write})
    (arena_free(&source_arena) can Global{Read,Write})
    status

def proof_main_with_source_arena[@r](argc: i64, argv: mutable void&, source_arena: mutable Arena& @r) -> i64 can[Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast, Console, Global.Read, Global.Write]:
    if argc < 2:
        proof_print_usage()
        return 2
    slots: mutable cstr&& = argv.cast[mutable cstr&&]
    json_output: mutable bool = false
    summary_json_output: mutable bool = false
    function_json_output: mutable bool = false
    goal_json_output: mutable bool = false
    suggestion_json_output: mutable bool = false
    theorem_json_output: mutable bool = false
    package_output: mutable bool = false
    proof_text_output: mutable bool = false
    explain_output: mutable bool = false
    proof_check_output: mutable bool = false
    correspondence_output: mutable bool = false
    script_is_text: mutable bool = false
    repair_output: mutable bool = false
    repair_all_output: mutable bool = false
    focused_goal_id: mutable usize = 0
    tactic_json_output: mutable bool = false
    script_slot: mutable usize = 0
    path_slot: mutable usize = 1
    first_argument: cstr = slots[1].cast[cstr]
    if proof_cstr_equals(first_argument, "--tactics"):
        tactic_json_output <- true
        script_slot <- 2
        path_slot <- 3
        if argc < 4:
            usage: mutable darray[u8] = []
            proof_push(&usage, "usage: elisa-proof --tactics <proof.json> <file.elisa>\n")
            proof_write(usage)
            return 2
    elif proof_cstr_equals(first_argument, "--json"):
        json_output <- true
        if argc < 3:
            usage: mutable darray[u8] = []
            proof_push(&usage, "usage: elisa-proof --json <file.elisa>\n")
            proof_write(usage)
            return 2
        path_slot <- 2
    elif proof_cstr_equals(first_argument, "--summary-json"):
        summary_json_output <- true
        if argc < 3:
            usage: mutable darray[u8] = []
            proof_push(&usage, "usage: elisa-proof --summary-json <file.elisa> (full evidence: --json)\n")
            proof_write(usage)
            return 2
        path_slot <- 2
    elif proof_cstr_equals(first_argument, "--linear-hints"):
        return proof_usage_exit("usage: elisa-proof --linear-hints <hints.txt> <file.elisa>\n") if argc < 4
        json_output <- true
        script_slot <- 2
        path_slot <- 3
    elif proof_cstr_equals(first_argument, "--function-json"):
        json_output <- true
        function_json_output <- true
        if argc < 4:
            usage: mutable darray[u8] = []
            proof_push(&usage, "usage: elisa-proof --function-json <name|module::...::name> <file.elisa>\n")
            proof_write(usage)
            return 2
        path_slot <- 3
    elif proof_cstr_equals(first_argument, "--goal"):
        goal_json_output <- true
        if argc < 4:
            usage: mutable darray[u8] = []
            proof_push(&usage, "usage: elisa-proof --goal <id> <file.elisa>\n")
            proof_write(usage)
            return 2
        parsed_goal: (valid: bool, parsed: u32) = proof_cstr_u32(slots[2].cast[cstr])
        if not parsed_goal.valid:
            message: mutable darray[u8] = []
            proof_push(&message, "elisa-proof: goal id must be an unsigned 32-bit integer\n")
            proof_write(message)
            return 2
        focused_goal_id <- parsed_goal.parsed.usize()
        path_slot <- 3
    elif proof_cstr_equals(first_argument, "--explain"):
        explain_output <- true
        if argc < 4:
            usage: mutable darray[u8] = []
            proof_push(&usage, "usage: elisa-proof --explain <goal_id> <file.elisa>\n")
            proof_write(usage)
            return 2
        parsed_goal: (valid: bool, parsed: u32) = proof_cstr_u32(slots[2].cast[cstr])
        if not parsed_goal.valid:
            message: mutable darray[u8] = []
            proof_push(&message, "elisa-proof: goal id must be an unsigned 32-bit integer\n")
            proof_write(message)
            return 2
        focused_goal_id <- parsed_goal.parsed.usize()
        path_slot <- 3
    elif proof_cstr_equals(first_argument, "--proof"):
        proof_text_output <- true
        if argc < 4:
            usage: mutable darray[u8] = []
            proof_push(&usage, "usage: elisa-proof --proof <id> <file.elisa>\n")
            proof_write(usage)
            return 2
        parsed_goal: (valid: bool, parsed: u32) = proof_cstr_u32(slots[2].cast[cstr])
        if not parsed_goal.valid:
            message: mutable darray[u8] = []
            proof_push(&message, "elisa-proof: goal id must be an unsigned 32-bit integer\n")
            proof_write(message)
            return 2
        focused_goal_id <- parsed_goal.parsed.usize()
        path_slot <- 3
    elif proof_cstr_equals(first_argument, "--repair-all"):
        repair_all_output <- true
        if argc < 3:
            usage: mutable darray[u8] = []
            proof_push(&usage, "usage: elisa-proof --repair-all <file.elisa>\n")
            proof_write(usage)
            return 2
        path_slot <- 2
    elif proof_cstr_equals(first_argument, "--repair"):
        repair_output <- true
        if argc < 4:
            usage: mutable darray[u8] = []
            proof_push(&usage, "usage: elisa-proof --repair <id> <file.elisa>\n")
            proof_write(usage)
            return 2
        parsed_goal: (valid: bool, parsed: u32) = proof_cstr_u32(slots[2].cast[cstr])
        if not parsed_goal.valid:
            message: mutable darray[u8] = []
            proof_push(&message, "elisa-proof: goal id must be an unsigned 32-bit integer\n")
            proof_write(message)
            return 2
        focused_goal_id <- parsed_goal.parsed.usize()
        path_slot <- 3
    elif proof_cstr_equals(first_argument, "--script"):
        tactic_json_output <- true
        script_is_text <- true
        script_slot <- 2
        path_slot <- 3
        if argc < 4:
            usage: mutable darray[u8] = []
            proof_push(&usage, "usage: elisa-proof --script <proof.txt> <file.elisa>\n")
            proof_write(usage)
            return 2
    elif proof_cstr_equals(first_argument, "--check-proof"):
        proof_check_output <- true
        script_slot <- 2
        path_slot <- 3
        if argc < 4:
            usage: mutable darray[u8] = []
            proof_push(&usage, "usage: elisa-proof --check-proof <proof.txt> <file.elisa>\n")
            proof_write(usage)
            return 2
    elif proof_cstr_equals(first_argument, "--correspondence"):
        correspondence_output <- true
        script_slot <- 2
        path_slot <- 3
        if argc < 4:
            usage: mutable darray[u8] = []
            proof_push(&usage, "usage: elisa-proof --correspondence <package.json> <file.elisa>\n")
            proof_write(usage)
            return 2
    elif proof_cstr_equals(first_argument, "--theorems"):
        theorem_json_output <- true
        if argc < 3:
            usage: mutable darray[u8] = []
            proof_push(&usage, "usage: elisa-proof --theorems <file.elisa>\n")
            proof_write(usage)
            return 2
        path_slot <- 2
    elif proof_cstr_equals(first_argument, "--package"):
        package_output <- true
        if argc < 3:
            usage: mutable darray[u8] = []
            proof_push(&usage, "usage: elisa-proof --package <file.elisa>\n")
            proof_write(usage)
            return 2
        path_slot <- 2
    elif proof_cstr_equals(first_argument, "--suggest"):
        suggestion_json_output <- true
        if argc < 4:
            usage: mutable darray[u8] = []
            proof_push(&usage, "usage: elisa-proof --suggest <id> <file.elisa>\n")
            proof_write(usage)
            return 2
        parsed_goal: (valid: bool, parsed: u32) = proof_cstr_u32(slots[2].cast[cstr])
        if not parsed_goal.valid:
            message: mutable darray[u8] = []
            proof_push(&message, "elisa-proof: goal id must be an unsigned 32-bit integer\n")
            proof_write(message)
            return 2
        focused_goal_id <- parsed_goal.parsed.usize()
        path_slot <- 3
    elif first_argument[0] != '-':
        # Keep the one-argument CLI; option-looking and trailing arguments still
        # take the rejecting paths below.
        path_slot <- 1
    else:
        message: mutable darray[u8] = []
        proof_push(&message, "elisa-proof: unknown option\n")
        proof_write(message)
        return 2
    return 2 if argc > path_slot + 1
    path: cstr = slots[path_slot].cast[cstr]
    focused_function_name: mutable sview = ""
    if function_json_output:
        function_name: cstr = slots[2].cast[cstr]
        function_name_length: mutable usize = 0
        while function_name[function_name_length] != 0 |function_name, function_name_length|:
            function_name_length <- function_name_length + 1
        if function_name_length == 0:
            message: mutable darray[u8] = []
            proof_push(&message, "elisa-proof: focused function name must not be empty\n")
            proof_write(message)
            return 2
        focused_function_name <- sview(function_name, 0, function_name_length)
    root_path: mutable darray[u8] = []
    path_index: mutable usize = 0
    while path[path_index] != 0 |path_index, root_path, path|:
        root_path.push(path[path_index])
        path_index <- path_index + 1
    source_map: mutable ProofSourceMap& @r = ProofSourceMap{files: [], line_files: [], line_numbers: []}
    capture_source_map: bool = correspondence_output or package_output or json_output
    root_read_failed: mutable bool = false
    source_analysis: ProofSourceAnalysis[r] = (proof_source_analysis_import_parse(source_arena, root_path, &root_read_failed, &source_map.files, &source_map.line_files, &source_map.line_numbers, capture_source_map) can Global{Read,Write})
    if root_read_failed:
        message: mutable darray[u8] = []
        proof_push(&message, "elisa-proof: could not read source\n")
        proof_write(message)
        return 2
    (ElisaProof::proof_disjunction_reset_work_measurements() can Global.Write)
    linear_hints: mutable darray[i64] = []
    if json_output and script_slot > 0:
        hints: (ok: bool, values: darray[i64]) = (proof_read_linear_hints(slots[script_slot].cast[cstr]) can Global{Read,Write})
        return proof_usage_exit("elisa-proof: linear hints could not be read or are malformed\n") if not hints.ok
        linear_hints <- hints.values
    semantic_diagnostics: mutable darray[Semantic::Diagnostic]& @r = proof_cli_semantic_diagnostics_in_arena(source_arena)
    replay_work: mutable usize = 0
    replay_gap_snapshot_available: mutable bool = false
    replay_gap_count: mutable u32 = 0
    checked_view: ProofCheckedView[r] = (proof_check_and_replay_with_source(source_arena, semantic_diagnostics, source_analysis, focused_function_name, linear_hints) can Global{Read,Write})
    report: ProofReport& = proof_checked_view_diagnostic_report(checked_view)
    source: darray[u8]& = proof_checked_view_source(checked_view)
    file: Ast::File& = proof_checked_view_file(checked_view)
    source_bytes: usize = proof_checked_view_source_bytes(checked_view)
    source_fingerprint: u32 = proof_checked_view_source_fingerprint(checked_view)
    source_literal_ensures: darray[(name: sview, function_offset: u32, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool)]& = proof_checked_view_literal_inventory(checked_view)
    source_assert_by_goals: darray[(name: sview, function_offset: u32, attempt_line: u32, goal_line: u32, goal_offset: u32, expected_value: bool, source_goal: Ast::Expr, supported: bool)]& = proof_checked_view_assert_by_inventory(checked_view)
    replay_gap: (available: bool, count: u32) = proof_checked_view_replay_gap_count(checked_view)
    replay_gap_snapshot_available <- replay_gap.available
    replay_gap_count <- replay_gap.count
    semantic_visible: u32 = proof_checked_view_semantic_visible(checked_view)
    source_complete: bool = proof_checked_view_source_complete(checked_view)
    source_admissible: bool = proof_checked_view_source_admissible(checked_view)
    source_goal_admissions_complete: mutable bool = proof_checked_view_goal_source_admissions_complete(checked_view)
    source_admissions_complete: bool = proof_checked_view_source_admissions_complete(checked_view)
    source_admission_failure: sview = proof_checked_view_source_admission_failure(checked_view)
    if goal_json_output:
        focused: mutable darray[u8] = []
        goal_output: (complete: bool, state: sview) = proof_push_json_focused_goal_with_replayed(&focused, checked_view, focused_goal_id, replay_work)
        proof_write(focused)
        return proof_goal_route_exit_with_state(checked_view, focused_goal_id, goal_output)
    if proof_check_output:
        script_read: (ok: bool, contents: darray[u8]) = (proof_read_file_checked(slots[script_slot].cast[cstr]) can Global{Read,Write})
        if not script_read.ok:
            message: mutable darray[u8] = []
            proof_push(&message, "{\"format\":\"elisa-proof-proof-check-v1\",\"status\":\"unreadable\",\"verification_state\":\"unknown\",\"goal_id\":null,\"differences\":[]}\n")
            proof_write(message)
            return 2
        checked: mutable darray[u8] = []
        check_status: i64 = proof_push_proof_check_with_replayed(&checked, checked_view, script_read.contents, replay_work)
        proof_write(checked)
        return check_status
    if correspondence_output:
        package_read: (ok: bool, contents: darray[u8]) = (proof_read_file_checked(slots[script_slot].cast[cstr]) can Global{Read,Write})
        if not package_read.ok:
            message: mutable darray[u8] = []
            proof_push(&message, "{\"format\":\"elisa-proof-correspondence-v1\",\"package\":{\"status\":\"unreadable\"}}\n")
            proof_write(message)
            return 2
        package_bytes: darray[u8] = package_read.contents
        correspondence_admissible: bool = source_admissible
        correspondence: mutable darray[u8] = []
        source_snapshot: sview = ElisaProofJson::bytes_range_ref(source, 0, source_bytes)
        correspondence_status: i64 = (corr_replay_and_check(&package_bytes, file, source_snapshot, root_path, source_map, source_fingerprint, correspondence_admissible, &correspondence) can Global{Read,Write})
        proof_write(correspondence)
        return correspondence_status
    if explain_output:
        explanation: mutable darray[u8] = []
        explanation_result: (complete: bool, found: bool, state: sview) = proof_push_goal_explanation_with_replayed(&explanation, checked_view, focused_goal_id, replay_work)
        proof_write(explanation)
        return proof_goal_route_exit_with_state(checked_view, focused_goal_id, (explanation_result.complete, explanation_result.state)) if explanation_result.found
        return 1
    if proof_text_output:
        rendered: mutable darray[u8] = []
        goal_output: (complete: bool, state: sview, replayed: bool, source_admitted: bool) = proof_push_elisa_proof_with_replayed(&rendered, checked_view, focused_goal_id, replay_work)
        proof_write(rendered)
        return proof_goal_route_exit_with_state(checked_view, focused_goal_id, (goal_output.complete, goal_output.state))
    if theorem_json_output:
        catalog: mutable darray[u8] = []
        catalog_complete: bool = ElisaProofTheoremOutput::proof_push_json_theorem_catalog_with_replayed(&catalog, checked_view, &replay_work)
        proof_write(catalog)
        return proof_route_exit(true, source_admissible and proof_checked_view_theorem_source_admissions_complete(checked_view) and catalog_complete)
    if package_output:
        package: mutable darray[u8] = []
        package_result: (snapshot_complete: bool, source_admissible: bool) = proof_push_json_package_with_replayed(&package, checked_view, root_path, source_map)
        proof_write(package)
        return proof_route_exit(true, package_result.snapshot_complete and package_result.source_admissible and source_goal_admissions_complete)
    if suggestion_json_output:
        suggestions: mutable darray[u8] = []
        suggestions_complete: bool = (ElisaProofTheoremOutput::proof_push_json_suggestions_with_replayed(&suggestions, checked_view, focused_goal_id, &replay_work) can Global{Read,Write})
        proof_write(suggestions)
        return proof_route_exit(focused_goal_id < report.results.goal_attempts.count, source_admissible and suggestions_complete)
    if repair_output or repair_all_output:
        repair_snapshot: (complete: bool, replayed_goals: darray[bool], source_admitted_goals: darray[bool]) = proof_output_checked_view_goal_statuses_with_work(checked_view, replay_work)
        producer_claim_snapshot: (complete: bool, producer_claimed_goals: darray[bool]) = proof_output_checked_view_producer_claims_with_work(checked_view, replay_work)
        replayed_goals: darray[bool] = repair_snapshot.replayed_goals
        source_admitted_goals: darray[bool] = repair_snapshot.source_admitted_goals
        producer_claimed_goals: darray[bool] = producer_claim_snapshot.producer_claimed_goals
        source_goal_admissions_complete <- source_goal_admissions_complete and repair_snapshot.complete and producer_claim_snapshot.complete
        response: mutable darray[u8] = []
        if repair_all_output:
            # The whole unresolved queue in one pass, in goal order. Producer status alone does
            # not discharge a repair target; the exact certificate must replay and its source
            # obligation must be admitted by the checked view.
            repaired_count: mutable usize = 0
            unresolved_count: mutable usize = 0
            candidate_count_total: mutable usize = 0
            entries: mutable darray[u8] = []
            for goal_index in 0..<report.results.goal_attempts.count |goal_index, report, entries, repaired_count, unresolved_count, candidate_count_total, producer_claimed_goals, replayed_goals, source_admitted_goals, source_admissible, source_goal_admissions_complete|:
                continue if proof_output_cached_producer_claim_status(producer_claimed_goals, goal_index) and proof_output_cached_replay_status(replayed_goals, goal_index) and proof_output_cached_source_admission_status(source_admitted_goals, goal_index)
                unresolved_count <- unresolved_count + 1
                goal_source_admissible: bool = proof_output_cached_source_admission_status(source_admitted_goals, goal_index)
                # A script found against an inadmissible source would be refused by --script, so
                # the search is not run and the goal is listed as unrepaired with nothing tried.
                batch_found: mutable (repaired: bool, searched: usize, candidates: usize, exhaustive: bool, actions: sview, rewrite_fact_index: usize, rewrite_reverse: bool, has_rewrite: bool, has_apply: bool) = (false, 0, 0, false, "", 0, false, false, false)
                batch_found <- (proof_repair_search(checked_view, goal_index) can Global{Read,Write}) if source_admissible and source_goal_admissions_complete and goal_source_admissible
                repaired_count <- repaired_count + 1 if batch_found.repaired
                candidate_count_total <- candidate_count_total + batch_found.candidates
                proof_push(&entries, ",") if unresolved_count > 1
                proof_push_repair_goal(&entries, checked_view, goal_index, batch_found, goal_source_admissible, source_goal_admissions_complete)
            proof_push(&response, "{\"format\":\"elisa-proof-repair-batch-v1\",\"status\":")
            if not source_goal_admissions_complete:
                proof_push(&response, "\"source-admission-incomplete\"")
            elif not source_admissible:
                proof_push(&response, "\"inadmissible\"")
            elif unresolved_count == 0:
                proof_push(&response, "\"nothing_to_repair\"")
            else:
                proof_push(&response, "\"repaired\"" if repaired_count == unresolved_count else "\"partial\"")
            proof_push(&response, ",\"source\":{\"fingerprint\":")
            proof_push_number(&response, source_fingerprint)
            proof_push(&response, ",\"admissible\":")
            proof_push(&response, "true" if source_admissible else "false")
            proof_push(&response, "},\"summary\":{\"unresolved\":")
            proof_push_number(&response, unresolved_count.u32())
            proof_push(&response, ",\"repaired\":")
            proof_push_number(&response, repaired_count.u32())
            proof_push(&response, ",\"candidates\":")
            proof_push_number(&response, candidate_count_total.u32())
            proof_push(&response, "},\"goals\":[")
            for entry_index in 0..<entries.count |entry_index, response, entries|:
                response.push(entries[entry_index])
            proof_push(&response, "]}\n")
            proof_write(response)
            return proof_route_exit(true, source_admissible and source_goal_admissions_complete and repaired_count == unresolved_count)
        found: mutable (repaired: bool, searched: usize, candidates: usize, exhaustive: bool, actions: sview, rewrite_fact_index: usize, rewrite_reverse: bool, has_rewrite: bool, has_apply: bool) = (false, 0, 0, false, "", 0, false, false, false)
        focused_goal_source_admissible: bool = proof_output_cached_source_admission_status(source_admitted_goals, focused_goal_id)
        focused_repair_admissible: bool = source_admissible and source_goal_admissions_complete and focused_goal_source_admissible
        found <- (proof_repair_search(checked_view, focused_goal_id) can Global{Read,Write}) if focused_repair_admissible
        proof_push(&response, "{\"format\":\"elisa-proof-repair-v1\",\"status\":")
        if focused_goal_id >= report.results.goal_attempts.count:
            proof_push(&response, "\"not_found\"")
        elif not source_goal_admissions_complete:
            proof_push(&response, "\"source-admission-incomplete\"")
        elif not focused_goal_source_admissible:
            proof_push(&response, "\"source-unbound\"")
        elif not source_admissible:
            proof_push(&response, "\"inadmissible\"")
        else:
            proof_push(&response, "\"repaired\"" if found.repaired else "\"unrepaired\"")
        proof_push(&response, ",\"goal_id\":")
        proof_push_number(&response, focused_goal_id.u32())
        proof_push(&response, ",\"source\":{\"fingerprint\":")
        proof_push_number(&response, source_fingerprint)
        proof_push(&response, ",\"admissible\":")
        proof_push(&response, "true" if source_admissible else "false")
        proof_push(&response, "},\"search\":{\"candidates\":")
        proof_push_number(&response, found.candidates.u32())
        proof_push(&response, ",\"tried\":")
        proof_push_number(&response, found.searched.u32())
        proof_push(&response, ",\"exhaustive\":")
        proof_push(&response, "true" if found.exhaustive and focused_repair_admissible else "false")
        proof_push(&response, "},\"script\":")
        if found.repaired:
            script_body: mutable darray[u8] = []
            proof_repair_push_script_text(&script_body, report, focused_goal_id, found.actions, found.has_rewrite, found.has_apply, found.rewrite_fact_index, found.rewrite_reverse)
            proof_push_json_bytes(&response, script_body)
        else:
            proof_push(&response, "null")
        proof_push(&response, "}\n")
        proof_write(response)
        return proof_route_exit(focused_goal_id < report.results.goal_attempts.count, focused_repair_admissible and found.repaired)
    if tactic_json_output:
        return (ElisaProofCliTactics::run(slots, script_slot, script_is_text, checked_view) can Global{Read,Write})
    if summary_json_output:
        summary: mutable darray[u8] = []
        summary_complete: bool = proof_push_json_report_summary_with_replay(&summary, checked_view, &replay_work)
        proof_write(summary)
        return 1 if not source_complete or not source_admissible or not source_admissions_complete or not summary_complete else 0
    if json_output:
        json: mutable darray[u8] = []
        json_complete: bool = (proof_push_json_report_with_replay(&json, checked_view, semantic_diagnostics, source_map, &replay_work) can Global.Read)
        proof_write(json)
        return 1 if not source_complete or not source_admissible or not source_admissions_complete or not json_complete else 0
    text_goal_snapshot: (complete: bool, replayed_goals: darray[bool], source_admitted_goals: darray[bool]) = proof_output_checked_view_goal_statuses_with_work(checked_view, replay_work)
    semantic_visibility_snapshot: (complete: bool, visible: darray[bool]) = proof_semantic_diagnostic_visibility_snapshot_with_work(semantic_diagnostics, report, replay_work)
    semantic_visibility: darray[bool] = semantic_visibility_snapshot.visible
    text_certificate_snapshot: (complete: bool, count: u32) = proof_output_checked_view_replayed_certificate_count_with_work(checked_view, replay_work)
    confirmation: (known: bool, replay_confirmed: u32, frame_checks: u32) = ElisaProofOutputReplayStatus::proof_output_checked_view_confirmation_counts_with_work(checked_view, replay_work)
    text_finding_counts: (complete: bool, disproved: u32, unsupported: u32, unknown: u32, verification_state: sview) = ElisaProofOutputReplayStatus::proof_output_checked_view_finding_summary_with_work(checked_view, source_admitted_goals, replay_work)
    text_findings_work_reserved: bool = proof_output_reserve_status_snapshot_work(replay_work, report.results.findings.count)
    text_status_snapshot_complete: bool = text_goal_snapshot.complete and text_certificate_snapshot.complete and confirmation.known and text_finding_counts.complete and text_findings_work_reserved and semantic_visibility_snapshot.complete and source_admissions_complete
    certificate_status_snapshot_complete: bool = proof_checked_view_source_validated(checked_view) and text_certificate_snapshot.complete
    output: mutable darray[u8] = []
    proof_push(&output, "Elisa Proof\n")
    proof_push(&output, "  verification state: ")
    proof_push(&output, "unknown" if not source_complete or not source_admissible or not source_admissions_complete or not text_status_snapshot_complete else text_finding_counts.verification_state)
    proof_push(&output, "\n  engine state: ")
    proof_push(&output, "unknown" if not text_status_snapshot_complete else ElisaProofOutputReplayStatus::proof_report_engine_state(checked_view))
    proof_push(&output, "\n")
    proof_push(&output, "  declarations: ")
    proof_push_number(&output, report.results.declarations)
    proof_push(&output, "\n  obligations: ")
    proof_push_number(&output, report.results.obligations)
    proof_push(&output, "\n  proven: ")
    if confirmation.known:
        proof_push_number(&output, confirmation.replay_confirmed)
    else:
        proof_push(&output, "unknown (inconsistent replay accounting)")
    proof_push(&output, "\n  frame checks: ")
    if confirmation.known:
        proof_push_number(&output, confirmation.frame_checks)
    else:
        proof_push(&output, "unknown (inconsistent replay accounting)")
    proof_push(&output, "\n  unproven: ")
    if confirmation.known and confirmation.replay_confirmed <= report.results.obligations and confirmation.frame_checks <= report.results.obligations - confirmation.replay_confirmed:
        proof_push_number(&output, report.results.obligations - confirmation.replay_confirmed - confirmation.frame_checks)
    else:
        proof_push(&output, "unknown (inconsistent obligation counters)")
    proof_push(&output, "\n  findings: ")
    proof_push_number(&output, report.results.failed)
    proof_push(&output, "\n")
    if text_findings_work_reserved:
        for finding in report.results.findings |__cli_finding_loop_unit = false, output, source_admitted_goals| -> __cli_finding_loop_unit:
            finding_source_admitted: bool = finding.has_goal and finding.goal_id < source_admitted_goals.count and proof_output_cached_source_admission_status(source_admitted_goals, finding.goal_id)
            finding_status: sview = proof_output_finding_source_status(finding, finding_source_admitted)
            proof_push(&output, "  ")
            proof_push(&output, finding.kind)
            proof_push(&output, " [")
            proof_push(&output, finding_status)
            proof_push(&output, "]")
            proof_push(&output, " line ")
            proof_push_number(&output, finding.line)
            proof_push(&output, ": ")
            proof_push(&output, finding.message)
            proof_push(&output, "\n")
    else:
        proof_push(&output, "  finding details: omitted (output work limit)\n")
    proof_push(&output, "  semantic diagnostics: ")
    if semantic_visibility_snapshot.complete:
        proof_push_number(&output, semantic_visible)
    else:
        proof_push(&output, "unknown (visibility work limit)")
    proof_push(&output, "\n")
    proof_push(&output, "  certificate replay: ")
    if certificate_status_snapshot_complete and replay_gap_snapshot_available:
        proof_push_number(&output, text_certificate_snapshot.count)
        proof_push(&output, " replayed, ")
        proof_push_number(&output, replay_gap_count)
        proof_push(&output, " gaps\n")
    else:
        proof_push(&output, "unknown\n")
    proof_push(&output, "  source-neutral kernel: ")
    proof_push_number(&output, report.analysis_1.kernel.nodes.count.u32())
    proof_push(&output, " nodes, format elisa-proof-kernel-v1\n")
    for diagnostic_index in 0..<semantic_diagnostics.count |diagnostic_index, semantic_diagnostics, semantic_visibility, semantic_visibility_snapshot, output|:
        continue if semantic_visibility_snapshot.complete and not semantic_visibility[diagnostic_index]
        diagnostic: Semantic::Diagnostic = semantic_diagnostics[diagnostic_index]
        proof_push(&output, "  semantic line ")
        proof_push_number(&output, diagnostic.line)
        proof_push(&output, ": ")
        message: darray[u8] = Semantic::diagnostic_message(diagnostic)
        output.extend(message)
        proof_push(&output, "\n")
    proof_write(output)
    return 1 if not source_complete or not source_admissible or not source_admissions_complete or not text_status_snapshot_complete else 0
