include "./cli_usage.elisa"
include "./cli_tactics.elisa"
def proof_main(argc: i64, argv: mutable void&) -> i64 can[Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast, Console]:
    if argc < 2:
        proof_print_usage()
        return 2
    slots: mutable cstr&& = argv.cast[mutable cstr&&]
    json_output: mutable bool = false
    summary_json_output: mutable bool = false
    function_json_output: mutable bool = false
    goal_json_output: mutable bool = false
    suggestion_json_output: mutable bool = false
    theorem_json_output: mutable bool = false
    package_output: mutable bool = false
    proof_text_output: mutable bool = false
    explain_output: mutable bool = false
    proof_check_output: mutable bool = false
    correspondence_output: mutable bool = false
    script_is_text: mutable bool = false
    repair_output: mutable bool = false
    repair_all_output: mutable bool = false
    focused_goal_id: mutable usize = 0
    tactic_json_output: mutable bool = false
    script_slot: mutable usize = 0
    path_slot: mutable usize = 1
    first_argument: cstr = slots[1].cast[cstr]
    if proof_cstr_equals(first_argument, "--tactics"):
        tactic_json_output <- true
        script_slot <- 2
        path_slot <- 3
        if argc < 4:
            usage: mutable darray[u8] = []
            proof_push(&usage, "usage: elisa-proof --tactics <proof.json> <file.elisa>\n")
            proof_write(usage)
            return 2
    elif proof_cstr_equals(first_argument, "--json"):
        json_output <- true
        if argc < 3:
            usage: mutable darray[u8] = []
            proof_push(&usage, "usage: elisa-proof --json <file.elisa>\n")
            proof_write(usage)
            return 2
        path_slot <- 2
    elif proof_cstr_equals(first_argument, "--summary-json"):
        summary_json_output <- true
        if argc < 3:
            usage: mutable darray[u8] = []
            proof_push(&usage, "usage: elisa-proof --summary-json <file.elisa> (full evidence: --json)\n")
            proof_write(usage)
            return 2
        path_slot <- 2
    elif proof_cstr_equals(first_argument, "--linear-hints"):
        return proof_usage_exit("usage: elisa-proof --linear-hints <hints.txt> <file.elisa>\n") if argc < 4
        json_output <- true
        script_slot <- 2
        path_slot <- 3
    elif proof_cstr_equals(first_argument, "--function-json"):
        json_output <- true
        function_json_output <- true
        if argc < 4:
            usage: mutable darray[u8] = []
            proof_push(&usage, "usage: elisa-proof --function-json <name> <file.elisa>\n")
            proof_write(usage)
            return 2
        path_slot <- 3
    elif proof_cstr_equals(first_argument, "--goal"):
        goal_json_output <- true
        if argc < 4:
            usage: mutable darray[u8] = []
            proof_push(&usage, "usage: elisa-proof --goal <id> <file.elisa>\n")
            proof_write(usage)
            return 2
        parsed_goal: (valid: bool, parsed: u32) = proof_cstr_u32(slots[2].cast[cstr])
        if not parsed_goal.valid:
            message: mutable darray[u8] = []
            proof_push(&message, "elisa-proof: goal id must be an unsigned 32-bit integer\n")
            proof_write(message)
            return 2
        focused_goal_id <- parsed_goal.parsed.usize()
        path_slot <- 3
    elif proof_cstr_equals(first_argument, "--explain"):
        explain_output <- true
        if argc < 4:
            usage: mutable darray[u8] = []
            proof_push(&usage, "usage: elisa-proof --explain <goal_id> <file.elisa>\n")
            proof_write(usage)
            return 2
        parsed_goal: (valid: bool, parsed: u32) = proof_cstr_u32(slots[2].cast[cstr])
        if not parsed_goal.valid:
            message: mutable darray[u8] = []
            proof_push(&message, "elisa-proof: goal id must be an unsigned 32-bit integer\n")
            proof_write(message)
            return 2
        focused_goal_id <- parsed_goal.parsed.usize()
        path_slot <- 3
    elif proof_cstr_equals(first_argument, "--proof"):
        proof_text_output <- true
        if argc < 4:
            usage: mutable darray[u8] = []
            proof_push(&usage, "usage: elisa-proof --proof <id> <file.elisa>\n")
            proof_write(usage)
            return 2
        parsed_goal: (valid: bool, parsed: u32) = proof_cstr_u32(slots[2].cast[cstr])
        if not parsed_goal.valid:
            message: mutable darray[u8] = []
            proof_push(&message, "elisa-proof: goal id must be an unsigned 32-bit integer\n")
            proof_write(message)
            return 2
        focused_goal_id <- parsed_goal.parsed.usize()
        path_slot <- 3
    elif proof_cstr_equals(first_argument, "--repair-all"):
        repair_all_output <- true
        if argc < 3:
            usage: mutable darray[u8] = []
            proof_push(&usage, "usage: elisa-proof --repair-all <file.elisa>\n")
            proof_write(usage)
            return 2
        path_slot <- 2
    elif proof_cstr_equals(first_argument, "--repair"):
        repair_output <- true
        if argc < 4:
            usage: mutable darray[u8] = []
            proof_push(&usage, "usage: elisa-proof --repair <id> <file.elisa>\n")
            proof_write(usage)
            return 2
        parsed_goal: (valid: bool, parsed: u32) = proof_cstr_u32(slots[2].cast[cstr])
        if not parsed_goal.valid:
            message: mutable darray[u8] = []
            proof_push(&message, "elisa-proof: goal id must be an unsigned 32-bit integer\n")
            proof_write(message)
            return 2
        focused_goal_id <- parsed_goal.parsed.usize()
        path_slot <- 3
    elif proof_cstr_equals(first_argument, "--script"):
        tactic_json_output <- true
        script_is_text <- true
        script_slot <- 2
        path_slot <- 3
        if argc < 4:
            usage: mutable darray[u8] = []
            proof_push(&usage, "usage: elisa-proof --script <proof.txt> <file.elisa>\n")
            proof_write(usage)
            return 2
    elif proof_cstr_equals(first_argument, "--check-proof"):
        proof_check_output <- true
        script_slot <- 2
        path_slot <- 3
        if argc < 4:
            usage: mutable darray[u8] = []
            proof_push(&usage, "usage: elisa-proof --check-proof <proof.txt> <file.elisa>\n")
            proof_write(usage)
            return 2
    elif proof_cstr_equals(first_argument, "--correspondence"):
        correspondence_output <- true
        script_slot <- 2
        path_slot <- 3
        if argc < 4:
            usage: mutable darray[u8] = []
            proof_push(&usage, "usage: elisa-proof --correspondence <package.json> <file.elisa>\n")
            proof_write(usage)
            return 2
    elif proof_cstr_equals(first_argument, "--theorems"):
        theorem_json_output <- true
        if argc < 3:
            usage: mutable darray[u8] = []
            proof_push(&usage, "usage: elisa-proof --theorems <file.elisa>\n")
            proof_write(usage)
            return 2
        path_slot <- 2
    elif proof_cstr_equals(first_argument, "--package"):
        package_output <- true
        if argc < 3:
            usage: mutable darray[u8] = []
            proof_push(&usage, "usage: elisa-proof --package <file.elisa>\n")
            proof_write(usage)
            return 2
        path_slot <- 2
    elif proof_cstr_equals(first_argument, "--suggest"):
        suggestion_json_output <- true
        if argc < 4:
            usage: mutable darray[u8] = []
            proof_push(&usage, "usage: elisa-proof --suggest <id> <file.elisa>\n")
            proof_write(usage)
            return 2
        parsed_goal: (valid: bool, parsed: u32) = proof_cstr_u32(slots[2].cast[cstr])
        if not parsed_goal.valid:
            message: mutable darray[u8] = []
            proof_push(&message, "elisa-proof: goal id must be an unsigned 32-bit integer\n")
            proof_write(message)
            return 2
        focused_goal_id <- parsed_goal.parsed.usize()
        path_slot <- 3
    elif first_argument[0] != '-':
        # Keep the one-argument CLI; option-looking and trailing arguments still
        # take the rejecting paths below.
        path_slot <- 1
    else:
        message: mutable darray[u8] = []
        proof_push(&message, "elisa-proof: unknown option\n")
        proof_write(message)
        return 2
    return 2 if argc > path_slot + 1
    path: cstr = slots[path_slot].cast[cstr]
    focused_function_name: mutable sview = ""
    if function_json_output:
        function_name: cstr = slots[2].cast[cstr]
        function_name_length: mutable usize = 0
        while function_name[function_name_length] != 0 |function_name, function_name_length|:
            function_name_length <- function_name_length + 1
        if function_name_length == 0:
            message: mutable darray[u8] = []
            proof_push(&message, "elisa-proof: focused function name must not be empty\n")
            proof_write(message)
            return 2
        focused_function_name <- sview(function_name, 0, function_name_length)
    root_path: mutable darray[u8] = []
    path_index: mutable usize = 0
    while path[path_index] != 0 |path_index, root_path, path|:
        root_path.push(path[path_index])
        path_index <- path_index + 1
    root_read: (ok: bool, contents: darray[u8]) = proof_read_file_checked(path)
    source: mutable darray[u8] = root_read.contents
    if not root_read.ok:
        message: mutable darray[u8] = []
        proof_push(&message, "elisa-proof: could not read source\n")
        proof_write(message)
        return 2
    import_failed: mutable bool = false
    source_map: mutable ProofSourceMap = ProofSourceMap{files: [], line_files: [], line_numbers: []}
    # An include graph can validly expand to zero bytes (for example a root that includes an
    # empty file). Testing non-empty bytes would feed the original include directive back to the
    # parser and make successful empty expansions fail spuriously.
    # Move the importer's result straight into `source`. Binding it to a named local first makes
    # stage1 treat that local as a view of the importer's reference arguments, so the NUL push
    # below would invalidate every later use of `source`.
    source <- proof_import_source_mapped(root_path, &import_failed, &source_map.files, &source_map.line_files, &source_map.line_numbers)
    source_bytes: usize = source.count
    source_fingerprint: u32 = proof_source_fingerprint(source)
    source.push(0)
    # The source came from length-aware file reads and may contain arbitrary bytes. Preserve
    # that exact extent through lexing: frontend_parse uses C-string length and would silently
    # truncate at an embedded NUL, unlike the compiler's length-aware driver path.
    # Tokens are temporary parser input; the AST owns its own nodes and borrows text only from
    # `source`. Match the compiler's one-shot frontend lifetime while retaining length-aware
    # tokenization so embedded NUL bytes cannot truncate the imported source.
    token_arena: mutable Arena = zeroed
    tokens: mutable darray[Token] = []
    in token_arena:
        tokens <- frontend_tokenize_with_length(&source[0], &source[0], source_bytes)
    file: mutable Ast::File = frontend_parser_parse_file(&source[0], tokens)
    # Freeze the small supported obligation inventory before typed-source augmentation or
    # refinement-contract rewriting can mutate the parser-owned AST.
    source_literal_ensures: darray[(name: sview, contract_line: u32, contract_value: i64, returned_value: i64, result_on_left: bool, equality_postcondition: bool)] = proof_source_literal_ensure_inventory(file.top_decls)
    source_assert_by_goals: darray[(name: sview, attempt_line: u32, goal_line: u32, goal_offset: u32, expected_value: bool, supported: bool)] = proof_source_assert_by_inventory(file.top_decls)
    proof_push_source_int_types(&file, tokens, source, source_bytes)
    # `pass` reaches the AST as the same invalid statement that error recovery leaves for a
    # dropped construct. Keep the lexer's `pass` offsets so the checker can tell them apart.
    pass_offsets: mutable darray[u32] = []
    for token in tokens |pass_offsets|:
        pass_offsets.push(token.start) if token.kind == TokenKind.Pass
    stray_nul_line: u32 = proof_source_stray_nul_line(tokens, source, source_bytes)
    arena_free(&token_arena)
    report: mutable ProofReport = proof_empty_report()
    ElisaProof::proof_disjunction_reset_work_measurements()
    report.pass_statement_offsets <- pass_offsets
    if json_output and script_slot > 0:
        hints: (ok: bool, values: darray[i64]) = proof_read_linear_hints(slots[script_slot].cast[cstr])
        return proof_usage_exit("elisa-proof: linear hints could not be read or are malformed\n") if not hints.ok
        report.linear_hints <- hints.values
    semantic_diagnostics: mutable darray[Semantic::Diagnostic] = []
    parse_failed: bool = file.errors.count > 0 or stray_nul_line > 0
    if parse_failed:
        for parse_error in file.errors |report|:
            proof_add_finding(&report, "parse-error", parse_error.line, "", "source could not be parsed; verification was not attempted")
        proof_add_finding(&report, "parse-error", stray_nul_line, "", "source has a NUL byte outside a comment; verification was not attempted") if stray_nul_line > 0
    else:
        # Refinement refusals are recorded apart and re-added after checking, which starts
        # from a fresh report.
        refinement_refusals: mutable ProofReport = proof_empty_report()
        refined_functions: mutable darray[sview] = []
        proof_add_refinement_signature_contracts(&file, &refinement_refusals, &refined_functions)
        if function_json_output:
            proof_check_focused_with_semantic_diagnostics(file, &report, &semantic_diagnostics, focused_function_name)
        else:
            proof_check_with_semantic_diagnostics(file, &report, &semantic_diagnostics)
        for refusal in refinement_refusals.findings |report|:
            report.proof_obligation(false)
            proof_add_finding(&report, refusal.kind, refusal.line, refusal.name, refusal.message)
        proof_replay_certificates(&report)
        # R-004 bounded source-derived admission. This reads the parser-owned AST directly;
        # unlike source_declarations/declaration_details/obligation_inventory, it cannot be
        # co-edited by the proof scheduler. Focused runs have an explicitly narrower scope.
        if not function_json_output and not proof_source_literal_ensure_coverage(source_literal_ensures, report):
            proof_add_finding(&report, "source-obligation-inventory", 0, "", "a supported source postcondition has no distinct proof attempt")
        if not function_json_output and not proof_source_assert_by_coverage(source_assert_by_goals, report):
            proof_add_finding(&report, "source-obligation-inventory", 0, "", "a tracked Boolean-literal assert-by target or proof step is unsupported, omitted, duplicated, falsely claimed, or unreplayed")
            if proof_source_assert_by_inventory_has_unsupported(source_assert_by_goals) and report.findings.count > 0:
                report.findings[report.findings.count - 1].status <- "unsupported"
        # The compiler's ensure check does not read signature contracts, so a refinement-typed
        # parameter's predicate is invisible to it. In a function that has one, an "unproven"
        # (never "violated") ensure at a return the engine discharged with kernel-replayed goals
        # and no finding is superseded. Every other function keeps the diagnostic.
        kept: mutable darray[Semantic::Diagnostic] = []
        for diagnostic in semantic_diagnostics |kept, refined_functions, report|:
            superseded: bool = diagnostic.kind == Semantic::DiagnosticKind.EnsureNotProven and diagnostic.detail != "violated" and (any refined_name in refined_functions where refined_name == diagnostic.name) and proof_report_discharges_return(report, diagnostic.name, diagnostic.line)
            kept.push(diagnostic) if not superseded
        semantic_diagnostics <- kept
    proof_add_finding(&report, "import-error", 0, "", "one or more Elisa include files could not be read") if import_failed
    # The compiler's strongest built-in semantic mode is shared with proof checking above. The
    # custom proof kernel remains the verdict for proof obligations; this flag only enables
    # additional compiler-side refinement/invariant diagnostics.
    semantic_errors: mutable u32 = 0
    semantic_visible: mutable u32 = 0
    # `assert … by:` is the compiler's legacy proof-block hook. The custom kernel below
    # owns this obligation now, including bounded arithmetic and recursive rules that the
    # compiler's general semantic pass does not know about. Keep every other compiler
    # diagnostic as an independent defense layer, but do not apply the weaker legacy
    # proof result a second time after the kernel has accepted the same AST.
    # The compiler's mutual-decreases pass predates structural SCC certificates and cannot
    # recognize a mutual call that receives a matched strict subterm. Suppress only that one
    # diagnostic when the custom kernel recorded a verified same-type structural SCC member;
    # all unrelated compiler diagnostics remain visible and fatal as before.
    for diagnostic in semantic_diagnostics |semantic_visible, report|:
        continue if not proof_semantic_diagnostic_visible(diagnostic, report)
        semantic_visible <- semantic_visible + 1
    for diagnostic in semantic_diagnostics |semantic_errors, report|:
        continue if not proof_semantic_diagnostic_visible(diagnostic, report)
        semantic_errors <- semantic_errors + 1 if Semantic::diagnostic_severity(diagnostic) == 1
    if goal_json_output:
        source_complete: bool = proof_report_source_complete(report, import_failed, semantic_errors)
        source_admissible: bool = proof_report_source_admissible(report, import_failed, semantic_errors)
        focused: mutable darray[u8] = []
        proof_push_json_focused_goal(&focused, report, focused_goal_id, source_bytes, source_fingerprint, source_complete, source_admissible)
        proof_write(focused)
        return proof_route_exit(focused_goal_id < report.goal_attempts.count, source_admissible)
    if proof_check_output:
        source_complete: bool = proof_report_source_complete(report, import_failed, semantic_errors)
        source_admissible: bool = proof_report_source_admissible(report, import_failed, semantic_errors)
        script_read: (ok: bool, contents: darray[u8]) = proof_read_file_checked(slots[script_slot].cast[cstr])
        if not script_read.ok:
            message: mutable darray[u8] = []
            proof_push(&message, "{\"format\":\"elisa-proof-proof-check-v1\",\"status\":\"unreadable\",\"goal_id\":null,\"differences\":[]}\n")
            proof_write(message)
            return 2
        checked: mutable darray[u8] = []
        check_status: i64 = proof_push_proof_check(&checked, report, script_read.contents, source_fingerprint, source_complete, source_admissible)
        proof_write(checked)
        return 1 if check_status == 0 and not source_admissible else check_status
    if correspondence_output:
        package_read: (ok: bool, contents: darray[u8]) = proof_read_file_checked(slots[script_slot].cast[cstr])
        if not package_read.ok:
            message: mutable darray[u8] = []
            proof_push(&message, "{\"format\":\"elisa-proof-correspondence-v1\",\"package\":{\"status\":\"unreadable\"}}\n")
            proof_write(message)
            return 2
        package_bytes: darray[u8] = package_read.contents
        correspondence_admissible: bool = proof_report_source_admissible(report, import_failed, semantic_errors)
        correspondence: mutable darray[u8] = []
        correspondence_status: i64 = corr_replay_and_check(&package_bytes, &file, correspondence_admissible, &correspondence)
        proof_write(correspondence)
        return correspondence_status
    if explain_output:
        explanation: mutable darray[u8] = []
        found: bool = proof_push_goal_explanation(&explanation, report, focused_goal_id)
        proof_write(explanation)
        return proof_route_exit(found, proof_report_source_admissible(report, import_failed, semantic_errors))
    if proof_text_output:
        source_complete: bool = proof_report_source_complete(report, import_failed, semantic_errors)
        source_admissible: bool = proof_report_source_admissible(report, import_failed, semantic_errors)
        rendered: mutable darray[u8] = []
        proof_push_elisa_proof(&rendered, report, focused_goal_id, source_fingerprint, source_complete, source_admissible)
        proof_write(rendered)
        return proof_route_exit(focused_goal_id < report.goal_attempts.count, source_admissible)
    if theorem_json_output:
        source_complete: bool = proof_report_source_complete(report, import_failed, semantic_errors)
        source_admissible: bool = proof_report_source_admissible(report, import_failed, semantic_errors)
        catalog: mutable darray[u8] = []
        proof_push_json_theorem_catalog(&catalog, report, source_bytes, source_fingerprint, source_complete, source_admissible)
        proof_write(catalog)
        return proof_route_exit(true, source_admissible)
    if package_output:
        source_admissible: bool = proof_report_source_admissible(report, import_failed, semantic_errors)
        package: mutable darray[u8] = []
        _ = proof_push_json_package(&package, report, root_path, source_bytes, source_fingerprint, source_admissible)
        proof_write(package)
        return proof_route_exit(true, source_admissible)
    if suggestion_json_output:
        source_complete: bool = proof_report_source_complete(report, import_failed, semantic_errors)
        source_admissible: bool = proof_report_source_admissible(report, import_failed, semantic_errors)
        suggestions: mutable darray[u8] = []
        proof_push_json_suggestions(&suggestions, report, file.enum_annotations, focused_goal_id, source_bytes, source_fingerprint, source_complete, source_admissible)
        proof_write(suggestions)
        return proof_route_exit(focused_goal_id < report.goal_attempts.count, source_admissible)
    if repair_output or repair_all_output:
        source_admissible: bool = proof_report_source_admissible(report, import_failed, semantic_errors)
        response: mutable darray[u8] = []
        if repair_all_output:
            # The whole unresolved queue in one pass, in goal order. A goal the checker already
            # proved is not a repair target: only what the report still reports as open is tried.
            repaired_count: mutable usize = 0
            unresolved_count: mutable usize = 0
            entries: mutable darray[u8] = []
            for goal_index in 0..<report.goal_attempts.count |goal_index, report, entries, repaired_count, unresolved_count|:
                continue if report.goal_attempts[goal_index].proven
                unresolved_count <- unresolved_count + 1
                # A script found against an inadmissible source would be refused by --script, so
                # the search is not run and the goal is listed as unrepaired with nothing tried.
                batch_found: mutable (repaired: bool, searched: usize, actions: sview) = (false, 0, "")
                batch_found <- proof_repair_search(report, goal_index) if source_admissible
                repaired_count <- repaired_count + 1 if batch_found.repaired
                proof_push(&entries, ",") if unresolved_count > 1
                proof_push_repair_goal(&entries, report, goal_index, batch_found)
            proof_push(&response, "{\"format\":\"elisa-proof-repair-batch-v1\",\"status\":")
            if not source_admissible:
                proof_push(&response, "\"inadmissible\"")
            elif unresolved_count == 0:
                proof_push(&response, "\"nothing_to_repair\"")
            else:
                proof_push(&response, "\"repaired\"" if repaired_count == unresolved_count else "\"partial\"")
            proof_push(&response, ",\"source\":{\"fingerprint\":")
            proof_push_number(&response, source_fingerprint)
            proof_push(&response, ",\"admissible\":")
            proof_push(&response, "true" if source_admissible else "false")
            proof_push(&response, "},\"summary\":{\"unresolved\":")
            proof_push_number(&response, unresolved_count.u32())
            proof_push(&response, ",\"repaired\":")
            proof_push_number(&response, repaired_count.u32())
            proof_push(&response, ",\"candidates\":")
            proof_push_number(&response, proof_repair_candidates().count.u32())
            proof_push(&response, "},\"goals\":[")
            for entry_index in 0..<entries.count |entry_index, response, entries|:
                response.push(entries[entry_index])
            proof_push(&response, "]}\n")
            proof_write(response)
            return proof_route_exit(true, source_admissible and repaired_count == unresolved_count)
        found: mutable (repaired: bool, searched: usize, actions: sview) = (false, 0, "")
        found <- proof_repair_search(report, focused_goal_id) if source_admissible
        proof_push(&response, "{\"format\":\"elisa-proof-repair-v1\",\"status\":")
        if focused_goal_id >= report.goal_attempts.count:
            proof_push(&response, "\"not_found\"")
        elif not source_admissible:
            proof_push(&response, "\"inadmissible\"")
        else:
            proof_push(&response, "\"repaired\"" if found.repaired else "\"unrepaired\"")
        proof_push(&response, ",\"goal_id\":")
        proof_push_number(&response, focused_goal_id.u32())
        proof_push(&response, ",\"source\":{\"fingerprint\":")
        proof_push_number(&response, source_fingerprint)
        proof_push(&response, ",\"admissible\":")
        proof_push(&response, "true" if source_admissible else "false")
        proof_push(&response, "},\"search\":{\"candidates\":")
        proof_push_number(&response, proof_repair_candidates().count.u32())
        proof_push(&response, ",\"tried\":")
        proof_push_number(&response, found.searched.u32())
        proof_push(&response, ",\"exhaustive\":")
        proof_push(&response, "false" if found.repaired or not source_admissible else "true")
        proof_push(&response, "},\"script\":")
        if found.repaired:
            script_body: mutable darray[u8] = []
            proof_repair_push_script_text(&script_body, report, focused_goal_id, found.actions)
            proof_push_json_bytes(&response, script_body)
        else:
            proof_push(&response, "null")
        proof_push(&response, "}\n")
        proof_write(response)
        return proof_route_exit(focused_goal_id < report.goal_attempts.count, source_admissible and found.repaired)
    if tactic_json_output:
        return ElisaProofCliTactics::run(slots, script_slot, script_is_text, report, source_bytes, source_fingerprint, import_failed, semantic_errors)
    if summary_json_output:
        summary: mutable darray[u8] = []
        proof_push_json_report_summary(&summary, report, import_failed, semantic_errors, semantic_visible, source_bytes, source_fingerprint)
        proof_write(summary)
        return 1 if not proof_report_source_complete(report, import_failed, semantic_errors) else 0
    if json_output:
        json: mutable darray[u8] = []
        proof_push_json_report(&json, report, semantic_diagnostics, semantic_visible, import_failed, semantic_errors, source_bytes, source_fingerprint, source_map, focused_function_name)
        proof_write(json)
        return 1 if not proof_report_source_complete(report, import_failed, semantic_errors) else 0
    output: mutable darray[u8] = []
    proof_push(&output, "Elisa Proof\n")
    proof_push(&output, "  verification state: ")
    proof_push(&output, proof_report_verification_state(report, import_failed, semantic_errors))
    proof_push(&output, "\n")
    if (semantic_errors > 0 or import_failed) and proof_report_engine_state(report) == "proved":
        proof_push(&output, "  front end diagnostic, engine: proved\n")
    proof_push(&output, "  declarations: ")
    proof_push_number(&output, report.declarations)
    proof_push(&output, "\n  obligations: ")
    proof_push_number(&output, report.obligations)
    proof_push(&output, "\n  proven: ")
    proof_push_number(&output, report.proven)
    proof_push(&output, "\n  unproven: ")
    if report.proven <= report.obligations:
        proof_push_number(&output, report.obligations - report.proven)
    else:
        proof_push(&output, "unknown (inconsistent obligation counters)")
    proof_push(&output, "\n  findings: ")
    proof_push_number(&output, report.failed)
    proof_push(&output, "\n")
    for finding in report.findings |output|:
        proof_push(&output, "  ")
        proof_push(&output, finding.kind)
        proof_push(&output, " [")
        proof_push(&output, finding.status)
        proof_push(&output, "]")
        proof_push(&output, " line ")
        proof_push_number(&output, finding.line)
        proof_push(&output, ": ")
        proof_push(&output, finding.message)
        proof_push(&output, "\n")
    proof_push(&output, "  semantic diagnostics: ")
    proof_push_number(&output, semantic_visible)
    proof_push(&output, "\n")
    proof_push(&output, "  certificate replay: ")
    proof_push_number(&output, report.replayed)
    proof_push(&output, " replayed, ")
    proof_push_number(&output, report.replay_gaps)
    proof_push(&output, " gaps\n")
    proof_push(&output, "  source-neutral kernel: ")
    proof_push_number(&output, report.kernel_nodes.count.u32())
    proof_push(&output, " nodes, format elisa-proof-kernel-v1\n")
    for diagnostic in semantic_diagnostics |output, report|:
        continue if not proof_semantic_diagnostic_visible(diagnostic, report)
        proof_push(&output, "  semantic line ")
        proof_push_number(&output, diagnostic.line)
        proof_push(&output, ": ")
        message: darray[u8] = Semantic::diagnostic_message(diagnostic)
        output.extend(message)
        proof_push(&output, "\n")
    proof_write(output)
    return 1 if not proof_report_source_complete(report, import_failed, semantic_errors) else 0
