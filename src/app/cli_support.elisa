# Exit status 0 is the one verdict a caller can act on without reading the output, so every
# route reserves it for a result that stands on an admissible source. A found goal in a source
# that failed to parse, import, type-check, or form its propositions exits 1, whatever the
# route's own status field says about that goal; a missing goal exits 2.
def proof_route_exit(found: bool, source_admissible: bool) -> i64:
    return 2 if not found
    return 0 if source_admissible else 1

def proof_goal_route_exit_with_state[@view](checked_view: ProofCheckedView[view]& @view, goal_id: usize, state: (complete: bool, state: sview)) -> i64:
    report: ProofReport& = proof_checked_view_diagnostic_report(checked_view)
    return 2 if goal_id >= report.results.goal_attempts.count
    source_admissions_complete: bool = proof_checked_view_goal_source_admissions_complete(checked_view)
    return 0 if state.complete and state.state == "proved" and proof_checked_view_source_admissible(checked_view) and source_admissions_complete else 1

def proof_goal_route_exit[@view](checked_view: ProofCheckedView[view]& @view, goal_id: usize, work_used: mutable usize&) -> i64:
    state: (complete: bool, state: sview) = ElisaProofOutputReplayStatus::proof_goal_state_with_work(checked_view, goal_id, work_used)
    proof_goal_route_exit_with_state(checked_view, goal_id, state)
