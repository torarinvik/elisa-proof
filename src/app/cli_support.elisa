# The compiler AST keeps an integer literal's payload but drops its type suffix. Recover the
# type of every `u64`/`usize`-suffixed literal from the lexer tokens, keyed by the token's exact
# line and byte offset (the same offset the parser stores in the literal's `Pos`). Only these
# two widths can produce a payload whose i64 reading differs from the value the source wrote.
def proof_int_suffix_is(source: darray[u8]&, start: usize, length: usize, expected: sview) -> bool:
    return false if length != sview_len(expected)
    index: mutable usize = 0
    while index < length:
        return false if source[start + index] != sview_at(expected, index)
        index <- index + 1
    return true

def proof_push_int_type_annotations(annotations: mutable darray[Ast::EnumAnnotation]&, tokens: darray[Token]&, source: darray[u8]&, source_bytes: usize) -> void:
    for token in tokens |annotations, source, source_bytes|:
        continue if token.kind != TokenKind.IntLit and token.kind != TokenKind.HexLit
        continue if not token.flags.has_suffix
        start: usize = token.start.usize() + token.length.usize()
        length: usize = token.suffix_length.usize()
        continue if start > source_bytes or length > source_bytes - start
        if proof_int_suffix_is(source, start, length, "u64"):
            annotations.push(Ast::EnumAnnotation{owner: PROOF_INT_TYPE_ANNOTATION_OWNER, name: "u64", line: token.line, offset: token.start})
        elif proof_int_suffix_is(source, start, length, "usize"):
            annotations.push(Ast::EnumAnnotation{owner: PROOF_INT_TYPE_ANNOTATION_OWNER, name: "usize", line: token.line, offset: token.start})

# Exit status 0 is the one verdict a caller can act on without reading the output, so every
# route reserves it for a result that stands on an admissible source. A found goal in a source
# that failed to parse, import, type-check, or form its propositions exits 1, whatever the
# route's own status field says about that goal; a missing goal exits 2.
def proof_route_exit(found: bool, source_admissible: bool) -> i64:
    return 2 if not found
    return 0 if source_admissible else 1
