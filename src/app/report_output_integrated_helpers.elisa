def proof_trace_is_trusted_boundary(trace: ProofFactTrace) -> bool:
    return trace.kind != "proof-step" and trace.kind != "lemma-step" and trace.kind != "loop-invariant-step" and trace.kind != "unit-resolution" and trace.kind != "branch-conjunct" and trace.kind != "branch-join" and trace.kind != "lemma-summary" and trace.kind != "function-summary"

def proof_report_trusted_boundary_count_with_work(report: ProofReport&, work_used: mutable usize&) -> (complete: bool, count: u32):
    return (false, 0) if not proof_output_reserve_status_snapshot_work(work_used, report.analysis_1.traces.records.count)
    # Source/runtime transitions remain explicit semantic boundaries. Summary facts are excluded:
    # replay reconstructs both lemma and executable postconditions from their exact verified
    # contracts, bindings, result value, and independently replayed preconditions.
    count: mutable u32 = 0
    for trace in report.analysis_1.traces.records |count, work_used|:
        return (false, 0) if not proof_output_reserve_status_snapshot_work(work_used, sview_len(trace.kind))
        count <- count + 1 if proof_trace_is_trusted_boundary(trace)
    return (true, count)

def proof_push_json_report_summary_with_replay[@view, @buffer](buffer: mutable darray[u8]& @buffer, checked_view: ProofCheckedView[view]& @view, replay_work: mutable usize&) -> bool can[Memory.Allocate, Abort.Panic]:
    report: ProofReport& = proof_checked_view_diagnostic_report(checked_view)
    semantic_errors: u32 = proof_checked_view_semantic_errors(checked_view)
    semantic_visible: u32 = proof_checked_view_semantic_visible(checked_view)
    source_bytes: usize = proof_checked_view_source_bytes(checked_view)
    source_fingerprint: u32 = proof_checked_view_source_fingerprint(checked_view)
    snapshot: (complete: bool, replayed_goals: darray[bool], source_admitted_goals: darray[bool]) = proof_output_checked_view_goal_statuses_with_work(checked_view, replay_work)
    replayed_goals: darray[bool] = snapshot.replayed_goals
    source_admitted_goals: darray[bool] = snapshot.source_admitted_goals
    certificate_count: (complete: bool, count: u32) = proof_output_checked_view_replayed_certificate_count_with_work(checked_view, replay_work)
    replayed_certificate_count: u32 = certificate_count.count
    confirmation: (known: bool, replay_confirmed: u32, frame_checks: u32) = ElisaProofOutputReplayStatus::proof_output_checked_view_confirmation_counts_with_work(checked_view, replay_work)
    finding_counts: (complete: bool, disproved: u32, unsupported: u32, unknown: u32, verification_state: sview) = ElisaProofOutputReplayStatus::proof_output_checked_view_finding_summary_with_work(checked_view, source_admitted_goals, replay_work)
    trusted_boundary_snapshot: (complete: bool, count: u32) = proof_report_trusted_boundary_count_with_work(report, replay_work)
    all_source_admissions_complete: bool = proof_checked_view_source_admissions_complete(checked_view)
    status_snapshot_complete: bool = snapshot.complete and certificate_count.complete and confirmation.known and finding_counts.complete and trusted_boundary_snapshot.complete and all_source_admissions_complete
    certificate_status_snapshot_complete: bool = proof_checked_view_source_validated(checked_view) and certificate_count.complete
    replay_complete: bool = proof_checked_view_replay_complete(checked_view)
    source_complete: bool = proof_checked_view_source_complete(checked_view)
    source_admissions_complete: bool = proof_checked_view_goal_source_admissions_complete(checked_view) and snapshot.complete
    source_admissible: bool = proof_checked_view_source_admissible(checked_view) and source_admissions_complete
    source_checks_complete: bool = proof_checked_view_source_checks_complete(checked_view)
    admission_invariant_failure: sview = proof_checked_view_source_admission_failure(checked_view)
    effective_source_admissible: bool = source_admissible and source_admissions_complete and all_source_admissions_complete
    verdict: mutable sview = "proved"
    verdict <- "failed" if not source_checks_complete
    verdict <- "proved_with_replay_gaps" if verdict == "proved" and not replay_complete
    verdict <- "failed" if verdict == "proved" and not source_complete
    verdict <- "failed" if not effective_source_admissible
    verdict <- "failed" if not status_snapshot_complete
    verification_state: mutable sview = finding_counts.verification_state
    verification_state <- "unknown" if not status_snapshot_complete
    proof_push(buffer, "{\"protocol_version\":2,\"report_kind\":\"summary\",\"status\":")
    proof_push_json_string(buffer, verdict)
    proof_push(buffer, ",\"verification_state\":")
    proof_push_json_string(buffer, verification_state)
    proof_push(buffer, ",\"engine_state\":")
    proof_push_json_string(buffer, "unknown" if not status_snapshot_complete else ElisaProofOutputReplayStatus::proof_report_engine_state(checked_view))
    proof_push(buffer, ",\"admission_invariant_failure\":")
    proof_push_json_string(buffer, admission_invariant_failure)
    proof_push(buffer, ",\"source\":{\"bytes\":")
    proof_push_number(buffer, source_bytes.u32())
    proof_push(buffer, ",\"fingerprint\":{\"algorithm\":\"fnv1a32\",\"value\":")
    proof_push_number(buffer, source_fingerprint)
    proof_push_json_source_admission_status(buffer, source_complete, source_admissions_complete, effective_source_admissible)
    proof_push(buffer, ",\"source_obligation_inventory\":{\"coverage\":\"partial\",\"supported_subset\":\"source-wide-unique literal ensure/return cases plus Boolean-literal assert-by targets and proof steps, plus nonliteral assert-by targets and proof steps whose checked term is structurally identical to source, in top-level function bodies, direct if/match branches, and direct while/for loop bodies, matched by exact source span and owner name; alias-changing substitutions, nested loop/branch paths and scoped assert-by/proof steps are unsupported\",\"whole_program\":false},\"trust\":{\"trusted_boundary_facts\":")
    if trusted_boundary_snapshot.complete:
        proof_push_number(buffer, trusted_boundary_snapshot.count)
    else:
        proof_push(buffer, "null")
    proof_push(buffer, ",\"trusted_assumptions\":[],\"kernel_replayed_certificates\":")
    if certificate_status_snapshot_complete:
        proof_push_number(buffer, replayed_certificate_count)
    else:
        proof_push(buffer, "null")
    proof_push(buffer, "},\"summary\":{\"declarations\":")
    proof_push_number(buffer, report.results.declarations)
    proof_push(buffer, ",\"obligations\":")
    proof_push_number(buffer, report.results.obligations)
    ElisaProofOutputReplayStatus::proof_push_json_checked_view_confirmation_counts(buffer, confirmation, report.results.obligations)
    proof_push(buffer, ",\"failed\":")
    proof_push_number(buffer, report.results.failed)
    proof_push(buffer, ",\"finding_count\":")
    proof_push_number(buffer, report.results.findings.count.u32())
    proof_push(buffer, ",\"disproved_findings\":")
    proof_push_number(buffer, finding_counts.disproved)
    proof_push(buffer, ",\"unsupported_findings\":")
    proof_push_number(buffer, finding_counts.unsupported)
    proof_push(buffer, ",\"unknown_findings\":")
    proof_push_number(buffer, finding_counts.unknown)
    proof_push(buffer, ",\"semantic_diagnostics\":")
    proof_push_number(buffer, semantic_visible)
    proof_push(buffer, ",\"semantic_errors\":")
    proof_push_number(buffer, semantic_errors)
    proof_push(buffer, "},\"details\":{\"omitted\":true,\"authoritative_route\":\"elisa-proof --json <file.elisa>\"}}")
    return status_snapshot_complete

def proof_semantic_diagnostic_visibility_snapshot_with_work(diagnostics: darray[Semantic::Diagnostic]&, report: ProofReport&, source_work: mutable usize&) -> (complete: bool, visible: darray[bool]):
    visible: mutable darray[bool] = []
    return (false, visible) if not proof_output_reserve_status_snapshot_work(source_work, diagnostics.count)
    for diagnostic in diagnostics |diagnostic, report, visible, source_work|:
        if diagnostic.kind == Semantic::DiagnosticKind.AssertByUnproven:
            visible.push(false)
        elif diagnostic.kind == Semantic::DiagnosticKind.MutualDecreasesCycle:
            verified_member: (complete: bool, verified: bool) = proof_structural_verified_member_lookup_with_work(report, diagnostic.name, source_work)
            return (false, []) if not verified_member.complete
            visible.push(not verified_member.verified)
        else:
            visible.push(true)
    return (true, visible)

def proof_report_discharges_return(report: ProofReport&, name: sview, line: u32) -> bool:
    # This compatibility API has no receipt, so report fields cannot establish a discharge.
    false

def proof_report_discharges_return_with_replayed(report: ProofReport&, name: sview, line: u32, replayed_goals: darray[bool]&, replay_work: mutable usize&) -> bool:
    # Compatibility entry point: caller-supplied status arrays are not source-bound receipts.
    false

def proof_push_json_report_with_replay[@view, @buffer](buffer: mutable darray[u8]& @buffer, checked_view: ProofCheckedView[view]& @view, semantic_diagnostics: darray[Semantic::Diagnostic]&, source_map: ProofSourceMap&, replay_work: mutable usize&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Global.Read]:
    report: ProofReport& = proof_checked_view_diagnostic_report(checked_view)
    semantic_visibility_snapshot: (complete: bool, visible: darray[bool]) = proof_semantic_diagnostic_visibility_snapshot_with_work(semantic_diagnostics, report, replay_work)
    semantic_visibility: darray[bool] = semantic_visibility_snapshot.visible
    semantic_visible: u32 = proof_checked_view_semantic_visible(checked_view)
    import_failed: bool = proof_checked_view_import_failed(checked_view)
    semantic_errors: u32 = proof_checked_view_semantic_errors(checked_view)
    source_bytes: usize = proof_checked_view_source_bytes(checked_view)
    source_fingerprint: u32 = proof_checked_view_source_fingerprint(checked_view)
    source_files_work_reserved: bool = proof_output_reserve_status_snapshot_work(replay_work, source_map.files.count)
    snapshot: (complete: bool, replayed_goals: darray[bool], source_admitted_goals: darray[bool]) = proof_output_checked_view_goal_statuses_with_work(checked_view, replay_work)
    certificate_snapshot: (complete: bool, replayed_certificates: darray[bool], replayed_certificate_count: u32) = proof_output_checked_view_certificate_statuses_with_work(checked_view, replay_work)
    producer_claim_snapshot: (complete: bool, producer_claimed_goals: darray[bool]) = proof_output_checked_view_producer_claims_with_work(checked_view, replay_work)
    replayed_goals: darray[bool] = snapshot.replayed_goals
    source_admitted_goals: darray[bool] = snapshot.source_admitted_goals
    producer_claimed_goals: darray[bool] = producer_claim_snapshot.producer_claimed_goals
    replayed_certificates: darray[bool] = certificate_snapshot.replayed_certificates
    replayed_certificate_count: u32 = certificate_snapshot.replayed_certificate_count
    focus_function: sview = report.context.focused_function
    confirmation: (known: bool, replay_confirmed: u32, frame_checks: u32) = ElisaProofOutputReplayStatus::proof_output_checked_view_confirmation_counts_with_work(checked_view, replay_work)
    finding_counts: (complete: bool, disproved: u32, unsupported: u32, unknown: u32, verification_state: sview) = ElisaProofOutputReplayStatus::proof_output_checked_view_finding_summary_with_work(checked_view, source_admitted_goals, replay_work)
    finding_details_work_reserved: bool = proof_output_reserve_status_snapshot_work(replay_work, report.results.findings.count)
    finding_details_complete: mutable bool = finding_details_work_reserved
    trusted_boundary_snapshot: (complete: bool, count: u32) = proof_report_trusted_boundary_count_with_work(report, replay_work)
    boundary_facts_work_reserved: bool = proof_output_reserve_status_snapshot_work(replay_work, report.analysis_1.traces.records.count)
    fact_traces_work_reserved: bool = proof_output_reserve_status_snapshot_work(replay_work, report.analysis_1.traces.records.count)
    fact_traces_complete: mutable bool = fact_traces_work_reserved
    all_source_admissions_complete: bool = proof_checked_view_source_admissions_complete(checked_view)
    status_snapshot_complete: bool = snapshot.complete and producer_claim_snapshot.complete and certificate_snapshot.complete and confirmation.known and source_files_work_reserved and finding_counts.complete and finding_details_work_reserved and trusted_boundary_snapshot.complete and boundary_facts_work_reserved and fact_traces_work_reserved and semantic_visibility_snapshot.complete and all_source_admissions_complete
    certificate_status_snapshot_complete: bool = proof_checked_view_source_validated(checked_view) and certificate_snapshot.complete
    replay_complete: bool = proof_checked_view_replay_complete(checked_view)
    replay_gap: (available: bool, count: u32) = proof_checked_view_replay_gap_count(checked_view)
    replay_gap_count: u32 = replay_gap.count
    replay_gap_snapshot_available: bool = replay_gap.available
    source_complete: bool = proof_checked_view_source_complete(checked_view)
    source_admissions_complete: bool = proof_checked_view_goal_source_admissions_complete(checked_view) and snapshot.complete
    source_admissible: bool = proof_checked_view_source_admissible(checked_view) and source_admissions_complete
    source_checks_complete: bool = proof_checked_view_source_checks_complete(checked_view)
    admission_invariant_failure: sview = proof_checked_view_source_admission_failure(checked_view)
    report_start: usize = buffer.count
    origin_work: mutable usize = report.analysis_1.traces.lookup_work_used
    effective_source_admissible: bool = source_admissible and source_admissions_complete and all_source_admissions_complete
    verdict: mutable sview = "proved"
    verdict <- "failed" if not source_checks_complete
    verdict <- "proved_with_replay_gaps" if verdict == "proved" and not replay_complete
    verdict <- "failed" if verdict == "proved" and not source_complete
    verdict <- "failed" if not effective_source_admissible
    verdict <- "failed" if not status_snapshot_complete
    verification_state: mutable sview = finding_counts.verification_state
    verification_state <- "unknown" if not status_snapshot_complete
    proof_push(buffer, "{\"protocol_version\":2,\"status\":")
    proof_push_json_string(buffer, verdict)
    proof_push(buffer, ",\"verification_state\":")
    proof_push_json_string(buffer, verification_state)
    proof_push(buffer, ",\"engine_state\":")
    proof_push_json_string(buffer, "unknown" if not status_snapshot_complete else ElisaProofOutputReplayStatus::proof_report_engine_state(checked_view))
    proof_push(buffer, ",\"admission_invariant_failure\":")
    proof_push_json_string(buffer, admission_invariant_failure)
    proof_push(buffer, ",\"source\":{\"bytes\":")
    proof_push_number(buffer, source_bytes.u32())
    proof_push(buffer, ",\"fingerprint\":{\"algorithm\":\"fnv1a32\",\"value\":")
    proof_push_number(buffer, source_fingerprint)
    proof_push_json_source_admission_status(buffer, source_complete, source_admissions_complete, effective_source_admissible)
    proof_push(buffer, ",\"source_obligation_inventory\":{\"coverage\":\"partial\",\"supported_subset\":\"source-wide-unique literal ensure/return cases plus Boolean-literal assert-by targets and proof steps, plus nonliteral assert-by targets and proof steps whose checked term is structurally identical to source, in top-level function bodies, direct if/match branches, and direct while/for loop bodies, matched by exact source span and owner name; alias-changing substitutions, nested loop/branch paths and scoped assert-by/proof steps are unsupported\",\"whole_program\":false}")
    focused_findings_work_reserved: bool = focus_function == "" or proof_output_reserve_status_snapshot_work(replay_work, report.results.focused_unrequested_findings.count)
    finding_details_complete <- false if focus_function != "" and not focused_findings_work_reserved
    if focus_function != "":
        proof_push(buffer, ",\"focus\":{\"kind\":\"function-and-transitive-callees\",\"name\":")
        finding_details_complete <- false if not proof_output_json_string_with_work(buffer, focus_function, replay_work)
        proof_push(buffer, ",\"unrequested_proposition_findings\":[")
        if focused_findings_work_reserved:
            for index in 0..<report.results.focused_unrequested_findings.count |index, report, buffer, replay_work, finding_details_complete|:
                finding: ProofFinding = report.results.focused_unrequested_findings[index]
                finding_status: sview = proof_output_finding_source_status(finding, false)
                proof_push(buffer, ",") if index > 0
                proof_push(buffer, "{\"kind\":")
                finding_details_complete <- false if not proof_output_json_string_with_work(buffer, finding.kind, replay_work)
                proof_push(buffer, ",\"status\":")
                finding_details_complete <- false if not proof_output_json_string_with_work(buffer, finding_status, replay_work)
                proof_push(buffer, ",\"line\":")
                proof_push_number(buffer, finding.line)
                proof_push(buffer, ",\"name\":")
                finding_details_complete <- false if not proof_output_json_string_with_work(buffer, finding.name, replay_work)
                proof_push(buffer, ",\"message\":")
                finding_details_complete <- false if not proof_output_json_string_with_work(buffer, finding.message, replay_work)
                proof_push(buffer, "}")
        proof_push(buffer, "]}")
    # The action list is a stable capability declaration for proof-state clients. The
    # implementation lives in tactics.elisa, and every state-changing operation is still
    # required to pass the existing kernel's soundness boundary.
    proof_push(buffer, ",\"action_protocol\":{\"format\":\"elisa-proof-tactics-v1\",\"admission\":\"kernel-backed\",\"operations\":[\"assumption\",\"exact\",\"decide\",\"intro\",\"apply\",\"simp\",\"have\",\"instantiate\",\"rewrite\",\"rewriteback\",\"split\",\"left\",\"right\",\"cases\"],\"trace\":{\"initial_state\":true,\"post_state\":true,\"facts_snapshot\":\"flat-arena-independent\",\"replay\":\"proof_tactic_replay\",\"kernel_step_replay\":\"proof_kernel_replay_tactic_step\",\"kernel_trace_replay\":\"proof_tactic_kernel_trace_replay\",\"replays_rejected_actions\":true},\"final_state_replay\":\"proof_tactic_kernel_replay\",\"certificate_replay\":\"proof_tactic_kernel_certificate_replay\",\"branch_transition_replay\":\"proof_tactic_kernel_branch_transition_replay\",\"branch_certificate_replay\":\"proof_tactic_json_tree_certificate_replay\",\"script_import\":\"elisa-proof-tactics-v1\",\"script_result\":\"elisa-proof-tactic-result-v1\",\"source_binding\":\"optional-fnv1a32\",\"source_goal_binding\":\"target.goal_id\",\"branch_script\":{\"final_parent_action\":true,\"children\":\"branches[2]\",\"nested\":true,\"max_branch_depth\":32,\"child_state_injection\":false}}")
    proof_push(buffer, ",\"trust\":{\"trusted_boundary_facts\":")
    if trusted_boundary_snapshot.complete:
        proof_push_number(buffer, trusted_boundary_snapshot.count)
    else:
        proof_push(buffer, "null")
    proof_push(buffer, ",\"kernel_replayed_certificates\":")
    if certificate_status_snapshot_complete:
        proof_push_number(buffer, replayed_certificate_count)
    else:
        proof_push(buffer, "null")
    proof_push(buffer, ",\"boundary_facts\":[")
    boundary_index: mutable usize = 0
    if boundary_facts_work_reserved:
        for trace in report.analysis_1.traces.records |__trace_summary_loop_unit = false, buffer, boundary_index| -> __trace_summary_loop_unit:
            if proof_trace_is_trusted_boundary(trace):
                proof_push(buffer, ",") if boundary_index > 0
                proof_push(buffer, "{\"kind\":")
                proof_push_json_string(buffer, trace.kind)
                proof_push(buffer, ",\"owner\":")
                proof_push_json_string(buffer, trace.name)
                proof_push(buffer, ",\"line\":")
                proof_push_number(buffer, trace.line)
                proof_push(buffer, ",\"kernel_root\":")
                proof_push_number(buffer, trace.kernel_expression.u32())
                proof_push(buffer, "}")
                boundary_index <- boundary_index + 1
    proof_push(buffer, "],\"boundary_facts_complete\":true" if boundary_facts_work_reserved else "],\"boundary_facts_complete\":false")
    proof_push(buffer, ",\"trusted_assumptions\":[]")
    proof_push(buffer, "},\"summary\":{\"declarations\":")
    proof_push_number(buffer, report.results.declarations)
    proof_push(buffer, ",\"obligations\":")
    proof_push_number(buffer, report.results.obligations)
    ElisaProofOutputReplayStatus::proof_push_json_checked_view_confirmation_counts(buffer, confirmation, report.results.obligations)
    # `failed` is a legacy count of finding records, not the number of unproven obligations.
    proof_push(buffer, ",\"failed\":")
    proof_push_number(buffer, report.results.failed)
    proof_push(buffer, ",\"finding_count\":")
    proof_push_number(buffer, report.results.findings.count.u32())
    proof_push(buffer, ",\"semantic_diagnostics\":")
    proof_push_number(buffer, semantic_visible)
    proof_push(buffer, ",\"semantic_errors\":")
    proof_push_number(buffer, semantic_errors)
    proof_push(buffer, "},\"declaration_details\":")
    declaration_details_complete: bool = ElisaProofTheoremOutput::proof_push_json_declaration_details_with_replayed(buffer, checked_view, replay_work)
    proof_push(buffer, ",\"declaration_details_complete\":true" if declaration_details_complete else ",\"declaration_details_complete\":false")
    proof_push(buffer, ",\"semantic_diagnostics\":[")
    semantic_index: mutable usize = 0
    for diagnostic_index in 0..<semantic_diagnostics.count |diagnostic_index, semantic_diagnostics, semantic_visibility, semantic_visibility_snapshot, buffer, semantic_index|:
        diagnostic: Semantic::Diagnostic = semantic_diagnostics[diagnostic_index]
        continue if semantic_visibility_snapshot.complete and not semantic_visibility[diagnostic_index]
        proof_push(buffer, ",") if semantic_index > 0
        proof_push_json_semantic_diagnostic(buffer, diagnostic)
        semantic_index <- semantic_index + 1
    proof_push(buffer, "],\"semantic_diagnostics_complete\":true" if semantic_visibility_snapshot.complete else "],\"semantic_diagnostics_complete\":false")
    proof_push(buffer, ",\"replay\":{\"certificates\":")
    proof_push_number(buffer, report.analysis_1.certificates.count.u32())
    proof_push(buffer, ",\"status_snapshot_complete\":")
    proof_push(buffer, "true" if status_snapshot_complete else "false")
    proof_push(buffer, ",\"replayed\":")
    if certificate_status_snapshot_complete:
        proof_push_number(buffer, replayed_certificate_count)
    else:
        proof_push(buffer, "null")
    proof_push(buffer, ",\"gaps\":")
    if replay_gap_snapshot_available:
        proof_push_number(buffer, replay_gap_count)
    else:
        proof_push(buffer, "null")
    proof_push(buffer, "},\"kernel\":{\"format\":\"elisa-proof-kernel-v1\",\"independent_replay\":true,\"nodes\":[")
    for index in 0..<report.analysis_1.kernel.nodes.count |index, report, buffer|:
        proof_push(buffer, ",") if index > 0
        proof_push_json_kernel_node(buffer, report.analysis_1.kernel.nodes[index])
    proof_push(buffer, "],\"children\":[")
    for index in 0..<report.analysis_1.kernel.children.count |index, report, buffer|:
        proof_push(buffer, ",") if index > 0
        proof_push_number(buffer, report.analysis_1.kernel.children[index].u32())
    proof_push(buffer, "],\"certificate_facts\":[")
    for index in 0..<report.analysis_1.kernel.certificate_facts.count |index, report, buffer|:
        proof_push(buffer, ",") if index > 0
        proof_push_number(buffer, report.analysis_1.kernel.certificate_facts[index].u32())
    proof_push(buffer, "],\"fact_trace_premises\":[")
    for index in 0..<report.analysis_1.kernel.fact_trace_premises.count |index, report, buffer|:
        proof_push(buffer, ",") if index > 0
        proof_push_number(buffer, report.analysis_1.kernel.fact_trace_premises[index].u32())
    proof_push(buffer, "],\"fact_traces\":[")
    if fact_traces_work_reserved:
        for index in 0..<report.analysis_1.traces.records.count |__trace_output_loop_unit = false, index, report, buffer, replay_work| -> __trace_output_loop_unit:
            trace: ProofFactTrace = report.analysis_1.traces.records[index]
            proof_push(buffer, ",") if index > 0
            proof_push(buffer, "{\"expression\":")
            proof_push_number(buffer, trace.kernel_expression.u32())
            proof_push(buffer, ",\"kind\":")
            fact_traces_complete <- false if not proof_output_json_string_with_work(buffer, trace.kind, replay_work)
            proof_push(buffer, ",\"line\":")
            proof_push_number(buffer, trace.line)
            proof_push(buffer, ",\"name\":")
            fact_traces_complete <- false if not proof_output_json_string_with_work(buffer, trace.name, replay_work)
            proof_push(buffer, ",\"dependency\":")
            fact_traces_complete <- false if not proof_output_json_string_with_work(buffer, trace.dependency, replay_work)
            proof_push(buffer, ",\"premises_start\":")
            proof_push_number(buffer, trace.kernel_premises_start.u32())
            proof_push(buffer, ",\"premises_count\":")
            proof_push_number(buffer, trace.kernel_premises_count.u32())
            proof_push(buffer, ",\"summary_bindings\":[")
            valid_summary_bindings: mutable bool = trace.summary_bindings_start <= report.analysis_1.traces.summary_names.count and trace.summary_bindings_count <= report.analysis_1.traces.summary_names.count - trace.summary_bindings_start and trace.summary_bindings_start <= report.analysis_1.traces.summary_values.count and trace.summary_bindings_count <= report.analysis_1.traces.summary_values.count - trace.summary_bindings_start
            valid_summary_bindings <- false if not valid_summary_bindings or not proof_output_reserve_status_snapshot_work(replay_work, trace.summary_bindings_count)
            fact_traces_complete <- false if not valid_summary_bindings
            if valid_summary_bindings:
                for binding_index in 0..<trace.summary_bindings_count |__trace_binding_loop_unit = false, binding_index, trace, report, buffer, replay_work, fact_traces_complete| -> __trace_binding_loop_unit:
                    break if replay_work > ElisaProof::proof_replay_summary_source_work_limit()
                    proof_push(buffer, ",") if binding_index > 0
                    summary_index: usize = trace.summary_bindings_start + binding_index
                    proof_push(buffer, "{\"parameter\":")
                    fact_traces_complete <- false if not proof_output_json_string_with_work(buffer, report.analysis_1.traces.summary_names[summary_index], replay_work)
                    proof_push(buffer, ",\"value\":")
                    proof_output_json_expr_with_work(buffer, report.analysis_1.traces.summary_values[summary_index], replay_work)
                    fact_traces_complete <- false if replay_work > ElisaProof::proof_replay_summary_source_work_limit()
                    proof_push(buffer, "}")
            proof_push(buffer, "],\"summary_require_goal_ids\":[")
            valid_summary_requires: mutable bool = trace.summary_requires_start <= report.analysis_1.traces.summary_require_goal_ids.count and trace.summary_requires_count <= report.analysis_1.traces.summary_require_goal_ids.count - trace.summary_requires_start
            valid_summary_requires <- false if not valid_summary_requires or not proof_output_reserve_status_snapshot_work(replay_work, trace.summary_requires_count)
            fact_traces_complete <- false if not valid_summary_requires
            if valid_summary_requires:
                for require_index in 0..<trace.summary_requires_count |__trace_require_loop_unit = false, require_index, trace, report, buffer, replay_work| -> __trace_require_loop_unit:
                    break if replay_work > ElisaProof::proof_replay_summary_source_work_limit()
                    proof_push(buffer, ",") if require_index > 0
                    proof_push_number(buffer, report.analysis_1.traces.summary_require_goal_ids[trace.summary_requires_start + require_index].u32())
            proof_push(buffer, "],\"summary_ensure_index\":")
            proof_push_number(buffer, trace.summary_ensure_index.u32())
            proof_push(buffer, "}")
    fact_traces_complete <- false if replay_work > ElisaProof::proof_replay_summary_source_work_limit()
    proof_push(buffer, "],\"fact_traces_complete\":true" if fact_traces_complete else "],\"fact_traces_complete\":false")
    proof_push(buffer, "},\"findings\":[")
    if finding_details_work_reserved:
        for index in 0..<report.results.findings.count |__finding_output_loop_unit = false, index, report, buffer, replayed_goals, source_admitted_goals, replay_work| -> __finding_output_loop_unit:
            finding: ProofFinding = report.results.findings[index]
            finding_source_admitted: bool = finding.has_goal and finding.goal_id < source_admitted_goals.count and proof_output_cached_source_admission_status(source_admitted_goals, finding.goal_id)
            finding_status: sview = proof_output_finding_source_status(finding, finding_source_admitted)
            counterexample_trusted: mutable bool = finding.counterexample_found and finding_status == "disproved"
            counterexample_range_valid: bool = finding.counterexample_start <= report.results.counterexample_facts.count and finding.counterexample_count <= report.results.counterexample_facts.count - finding.counterexample_start
            if counterexample_trusted:
                counterexample_trusted <- false if not counterexample_range_valid or not proof_output_reserve_status_snapshot_work(replay_work, finding.counterexample_count)
            finding_details_complete <- false if finding.counterexample_found and finding_status == "disproved" and not counterexample_trusted
            proof_push(buffer, ",") if index > 0
            proof_push(buffer, "{\"kind\":")
            finding_details_complete <- false if not proof_output_json_string_with_work(buffer, finding.kind, replay_work)
            proof_push(buffer, ",\"status\":")
            finding_details_complete <- false if not proof_output_json_string_with_work(buffer, finding_status, replay_work)
            proof_push(buffer, ",\"line\":")
            proof_push_number(buffer, finding.line)
            proof_push_json_source_position(buffer, source_map, finding.line)
            proof_push(buffer, ",\"name\":")
            finding_details_complete <- false if not proof_output_json_string_with_work(buffer, finding.name, replay_work)
            proof_push(buffer, ",\"message\":")
            finding_details_complete <- false if not proof_output_json_string_with_work(buffer, finding.message, replay_work)
            if finding.budget_dimension != "":
                proof_push(buffer, ",\"budget\":{\"dimension\":")
                finding_details_complete <- false if not proof_output_json_string_with_work(buffer, finding.budget_dimension, replay_work)
                proof_push(buffer, ",\"observed\":")
                proof_push_number(buffer, finding.budget_observed.u32())
                proof_push(buffer, ",\"limit\":")
                proof_push_number(buffer, finding.budget_limit.u32())
                proof_push(buffer, "}")
            if finding.kind == "ensure-unproven":
                proof_push(buffer, ",\"refusal_gate\":")
                if finding.has_goal and finding.goal_id < report.results.goal_attempts.count:
                    attempt: ProofGoalAttempt = report.results.goal_attempts[finding.goal_id]
                    refusal_gate: mutable sview = "unknown"
                    producer_claim: bool = proof_checked_view_attempt_had_producer_claim(checked_view, finding.goal_id)
                    refusal_gate <- "kernel-replay-gap" if producer_claim and not proof_output_cached_replay_status(replayed_goals, finding.goal_id)
                    refusal_gate <- proof_attempt_refusal_gate_with_work(report, attempt, replay_work) if not producer_claim
                    finding_details_complete <- false if not proof_output_json_string_with_work(buffer, refusal_gate, replay_work)
                else:
                    # Keep the A-02 field present for every failed ensure, even when the front-end
                    # could not bind its diagnostic back to a goal attempt. The unavailable search
                    # trace is explicit rather than guessed.
                    finding_details_complete <- false if not proof_output_json_string_with_work(buffer, "unknown", replay_work)
            elif finding.has_goal and finding.goal_id < report.results.goal_attempts.count and not proof_checked_view_attempt_had_producer_claim(checked_view, finding.goal_id):
                proof_push(buffer, ",\"refusal_gate\":")
                finding_details_complete <- false if not proof_output_json_string_with_work(buffer, proof_attempt_refusal_gate_with_work(report, report.results.goal_attempts[finding.goal_id], replay_work), replay_work)
            proof_push(buffer, ",\"counterexample_found\":")
            proof_push(buffer, "true" if counterexample_trusted else "false")
            proof_push(buffer, ",\"goal_id\":")
            proof_push_number(buffer, finding.goal_id.u32()) if finding.has_goal
            proof_push(buffer, "null") if not finding.has_goal
            proof_push(buffer, ",\"counterexample\":[")
            counterexample_count: usize = finding.counterexample_count if counterexample_trusted else 0
            for counterexample_index in 0..<counterexample_count |counterexample_index, finding, report, buffer, replay_work|:
                break if replay_work > ElisaProof::proof_replay_summary_source_work_limit()
                proof_push(buffer, ",") if counterexample_index > 0
                proof_output_json_expr_with_work(buffer, report.results.counterexample_facts[finding.counterexample_start + counterexample_index], replay_work)
            proof_push(buffer, "]")
            proof_push(buffer, "}")
    proof_push(buffer, "]")
    finding_details_complete <- false if replay_work > ElisaProof::proof_replay_summary_source_work_limit()
    proof_push(buffer, ",\"findings_complete\":true" if finding_details_complete else ",\"findings_complete\":false")
    proof_push(buffer, ",\"goals\":[")
    for index in 0..<report.results.goal_attempts.count |index, report, buffer, origin_work, replay_work, replayed_goals, source_admitted_goals, producer_claimed_goals, source_admissions_complete|:
        attempt: ProofGoalAttempt = report.results.goal_attempts[index]
        replay_status: mutable sview = "not_certified"
        replay_status <- "gap" if attempt.has_certificate
        replay_status <- "replayed" if proof_output_cached_replay_status(replayed_goals, index)
        proof_push(buffer, ",") if index > 0
        proof_push(buffer, "{\"goal_id\":")
        proof_push_number(buffer, index.u32())
        proof_push(buffer, ",\"line\":")
        proof_push_number(buffer, attempt.line)
        proof_push_json_source_position(buffer, source_map, attempt.line)
        proof_push(buffer, ",\"name\":")
        proof_push_json_string(buffer, attempt.name)
        proof_push(buffer, ",\"rule\":")
        proof_push_json_string(buffer, attempt.rule)
        producer_claim: bool = proof_output_cached_producer_claim_status(producer_claimed_goals, index)
        replay_proven: bool = producer_claim and proof_output_cached_replay_status(replayed_goals, index) and proof_output_cached_source_admission_status(source_admitted_goals, index)
        proof_push(buffer, ",\"proven\":")
        proof_push(buffer, "true" if replay_proven else "false")
        proof_push(buffer, ",\"replay_status\":")
        proof_push_json_string(buffer, replay_status)
        if not replay_proven:
            proof_push(buffer, ",\"refusal_gate\":")
            refusal_gate: sview = "source-admission-incomplete" if producer_claim and not source_admissions_complete else ("source-unbound" if producer_claim and not proof_output_cached_source_admission_status(source_admitted_goals, index) else ("kernel-replay-gap" if producer_claim else proof_attempt_refusal_gate_with_work(report, attempt, replay_work)))
            proof_push_json_string(buffer, refusal_gate)
        proof_push(buffer, ",\"certificate_id\":")
        if attempt.has_certificate and attempt.certificate_index < report.analysis_1.certificates.count:
            proof_push_number(buffer, attempt.certificate_index.u32())
        else:
            proof_push(buffer, "null")
        proof_push(buffer, ",\"kernel_goal\":")
        proof_push_number(buffer, attempt.kernel_goal.u32())
        proof_push(buffer, ",\"kernel_facts_start\":")
        proof_push_number(buffer, attempt.kernel_facts_start.u32())
        proof_push(buffer, ",\"kernel_facts_count\":")
        proof_push_number(buffer, attempt.kernel_facts_count.u32())
        proof_push(buffer, ",\"facts\":[")
        for fact_index in 0..<attempt.facts_count |fact_index, attempt, report, buffer, replay_work|:
            break if replay_work > ElisaProof::proof_replay_summary_source_work_limit()
            proof_push(buffer, ",") if fact_index > 0
            proof_output_json_expr_with_work(buffer, report.analysis_1.certificate_facts[attempt.facts_start + fact_index], replay_work)
        proof_push(buffer, "],\"fact_origins\":[")
        for fact_index in 0..<attempt.facts_count |fact_index, attempt, report, buffer, origin_work|:
            break if proof_replay_fact_origin_work_exhausted(origin_work)
            proof_push(buffer, ",") if fact_index > 0
            break if not proof_push_json_fact_origin(buffer, report, attempt.facts_start + fact_index, attempt.name, origin_work, replay_work)
        proof_push(buffer, "],\"fact_origins_complete\":true" if not proof_replay_fact_origin_work_exhausted(origin_work) and replay_work <= ElisaProof::proof_replay_summary_source_work_limit() else "],\"fact_origins_complete\":false")
        proof_push(buffer, ",\"dependencies\":")
        dependencies_complete: bool = not proof_replay_fact_origin_work_exhausted(origin_work) and proof_push_json_goal_dependencies(buffer, report, attempt.facts_start, attempt.facts_count, attempt.name, origin_work, replay_work)
        proof_push(buffer, ",\"dependencies_complete\":true" if dependencies_complete else ",\"dependencies_complete\":false")
        proof_push(buffer, ",\"goal\":")
        proof_output_json_expr_with_work(buffer, attempt.goal, replay_work)
        proof_push(buffer, "}")
    proof_push(buffer, "],\"repair_queue\":[")
    repair_index: mutable usize = 0
    repair_failure_details_complete: mutable bool = true
    finding_index: mutable ProofRepairFindingLookupIndex = ProofRepairFindingLookupIndex{}
    finding_index_ready: mutable bool = false
    for index in 0..<report.results.goal_attempts.count |index, report, buffer, repair_index, origin_work, replay_work, replayed_goals, source_admitted_goals, producer_claimed_goals, source_admissions_complete, repair_failure_details_complete, finding_index, finding_index_ready|:
        attempt: ProofGoalAttempt = report.results.goal_attempts[index]
        producer_claim: bool = proof_output_cached_producer_claim_status(producer_claimed_goals, index)
        continue if producer_claim and proof_output_cached_replay_status(replayed_goals, index) and proof_output_cached_source_admission_status(source_admitted_goals, index)
        if not finding_index_ready:
            finding_index <- proof_repair_finding_index_build(report, report.results.goal_attempts.count, replay_work)
            finding_index_ready <- true
        proof_push(buffer, ",") if repair_index > 0
        proof_push(buffer, "{\"goal_id\":")
        proof_push_number(buffer, index.u32())
        proof_push(buffer, ",\"line\":")
        proof_push_number(buffer, attempt.line)
        proof_push_json_source_position(buffer, source_map, attempt.line)
        proof_push(buffer, ",\"name\":")
        proof_push_json_string(buffer, attempt.name)
        proof_push(buffer, ",\"rule\":")
        proof_push_json_string(buffer, attempt.rule)
        replay_status: mutable sview = "gap" if attempt.has_certificate else "not_certified"
        replay_status <- "replayed" if proof_output_cached_replay_status(replayed_goals, index)
        proof_push(buffer, ",\"replay_status\":")
        proof_push_json_string(buffer, replay_status)
        proof_push(buffer, ",\"refusal_gate\":\"source-admission-incomplete\"") if producer_claim and not source_admissions_complete
        proof_push(buffer, ",\"refusal_gate\":\"source-unbound\"") if producer_claim and source_admissions_complete and not proof_output_cached_source_admission_status(source_admitted_goals, index)
        proof_push(buffer, ",\"failure\":")
        failure_complete: bool = proof_push_json_repair_failure(buffer, report, attempt, index, proof_output_cached_source_admission_status(source_admitted_goals, index), finding_index, replay_work)
        repair_failure_details_complete <- false if not failure_complete
        proof_push(buffer, ",\"failure_complete\":true" if failure_complete else ",\"failure_complete\":false")
        proof_push(buffer, ",\"near_miss\":")
        near_miss_complete: bool = proof_push_json_near_miss(buffer, report, attempt, replay_work)
        repair_failure_details_complete <- false if not near_miss_complete
        proof_push(buffer, ",\"dependencies\":")
        dependencies_complete: bool = proof_push_json_goal_dependencies(buffer, report, attempt.facts_start, attempt.facts_count, attempt.name, origin_work, replay_work)
        proof_push(buffer, ",\"dependencies_complete\":true" if dependencies_complete else ",\"dependencies_complete\":false")
        proof_push(buffer, "}")
        repair_index <- repair_index + 1
    proof_push(buffer, "]")
    proof_push(buffer, ",\"repair_failure_details_complete\":true" if repair_failure_details_complete else ",\"repair_failure_details_complete\":false")
    dependency_names: mutable darray[sview] = []
    dependency_starts: mutable darray[usize] = []
    dependency_counts: mutable darray[usize] = []
    dependency_goal_ids: mutable darray[usize] = []
    dependency_index_complete: mutable bool = true
    for goal_index in 0..<report.results.goal_attempts.count |goal_index, report, dependency_names, dependency_starts, dependency_counts, dependency_goal_ids, origin_work, dependency_index_complete|:
        continue if not dependency_index_complete
        attempt: ProofGoalAttempt = report.results.goal_attempts[goal_index]
        for fact_index in 0..<attempt.facts_count |fact_index, attempt, report, dependency_names, dependency_starts, dependency_counts, dependency_goal_ids, goal_index, origin_work, dependency_index_complete|:
            continue if not dependency_index_complete
            origin: (known: bool, kind: sview, line: u32, name: sview, dependency: sview, premises_count: usize) = proof_replay_fact_origin_at_with_work(report, attempt.facts_start + fact_index, attempt.name, origin_work)
            if proof_replay_fact_origin_work_exhausted(origin_work):
                dependency_index_complete <- false
                continue
            continue if not origin.known or origin.dependency == ""
            found_dependency: (complete: bool, index: usize) = proof_dependency_index_name_find(dependency_names, origin.dependency, origin_work)
            if not found_dependency.complete:
                dependency_index_complete <- false
                continue
            dependency_index: usize = found_dependency.index
            if dependency_index == dependency_names.count:
                dependency_names.push(origin.dependency)
                dependency_starts.push(dependency_goal_ids.count)
                dependency_counts.push(0)
            start: usize = dependency_starts[dependency_index]
            count: usize = dependency_counts[dependency_index]
            already: (complete: bool, contains: bool) = proof_dependency_index_goal_contains(dependency_goal_ids, start, count, goal_index, origin_work)
            if not already.complete:
                dependency_index_complete <- false
                continue
            if not already.contains:
                dependency_goal_ids.push(goal_index)
                dependency_counts[dependency_index] <- count + 1
    if not dependency_index_complete:
        dependency_names.clear()
        dependency_starts.clear()
        dependency_counts.clear()
        dependency_goal_ids.clear()
    proof_push(buffer, ",\"dependency_index_complete\":true" if dependency_index_complete else ",\"dependency_index_complete\":false")
    proof_push(buffer, ",\"dependency_index\":[")
    for dependency_index in 0..<dependency_names.count |dependency_index, dependency_names, dependency_starts, dependency_counts, dependency_goal_ids, buffer|:
        dependency: sview = dependency_names[dependency_index]
        proof_push(buffer, ",") if dependency_index > 0
        proof_push(buffer, "{\"name\":")
        proof_push_json_string(buffer, dependency)
        proof_push(buffer, ",\"goal_ids\":[")
        start: usize = dependency_starts[dependency_index]
        count: usize = dependency_counts[dependency_index]
        for goal_offset in 0..<count |goal_offset, dependency_goal_ids, start, buffer|:
            proof_push(buffer, ",") if goal_offset > 0
            proof_push_number(buffer, dependency_goal_ids[start + goal_offset].u32())
        proof_push(buffer, "]}")
    proof_push(buffer, "],\"certificates\":[")
    for index in 0..<report.analysis_1.certificates.count |index, report, buffer, origin_work, replay_work|:
        certificate: ProofGoalCertificate = report.analysis_1.certificates[index]
        proof_push(buffer, ",") if index > 0
        proof_push(buffer, "{\"certificate_id\":")
        proof_push_number(buffer, index.u32())
        proof_push(buffer, ",\"line\":")
        proof_push_number(buffer, certificate.line)
        proof_push(buffer, ",\"name\":")
        proof_push_json_string(buffer, certificate.name)
        proof_push(buffer, ",\"rule\":")
        proof_push_json_string(buffer, certificate.rule)
        proof_push(buffer, ",\"replayed\":")
        if certificate_status_snapshot_complete and index < replayed_certificates.count:
            if replayed_certificates[index]:
                proof_push(buffer, "true")
            else:
                proof_push(buffer, "false")
        else:
            proof_push(buffer, "null")
        proof_push(buffer, ",\"kernel_goal\":")
        proof_push_number(buffer, certificate.kernel_goal.u32())
        proof_push(buffer, ",\"kernel_facts_start\":")
        proof_push_number(buffer, certificate.kernel_facts_start.u32())
        proof_push(buffer, ",\"kernel_facts_count\":")
        proof_push_number(buffer, certificate.kernel_facts_count.u32())
        proof_push(buffer, ",\"facts\":[")
        for fact_index in 0..<certificate.facts_count |fact_index, certificate, report, buffer, replay_work|:
            break if replay_work > ElisaProof::proof_replay_summary_source_work_limit()
            proof_push(buffer, ",") if fact_index > 0
            proof_output_json_expr_with_work(buffer, report.analysis_1.certificate_facts[certificate.facts_start + fact_index], replay_work)
        proof_push(buffer, "],\"fact_origins\":[")
        for fact_index in 0..<certificate.facts_count |fact_index, certificate, report, buffer, origin_work|:
            break if proof_replay_fact_origin_work_exhausted(origin_work)
            proof_push(buffer, ",") if fact_index > 0
            break if not proof_push_json_fact_origin(buffer, report, certificate.facts_start + fact_index, certificate.name, origin_work, replay_work)
        proof_push(buffer, "],\"fact_origins_complete\":true" if not proof_replay_fact_origin_work_exhausted(origin_work) and replay_work <= ElisaProof::proof_replay_summary_source_work_limit() else "],\"fact_origins_complete\":false")
        proof_push(buffer, ",\"dependencies\":")
        dependencies_complete: bool = not proof_replay_fact_origin_work_exhausted(origin_work) and proof_push_json_goal_dependencies(buffer, report, certificate.facts_start, certificate.facts_count, certificate.name, origin_work, replay_work)
        proof_push(buffer, ",\"dependencies_complete\":true" if dependencies_complete else ",\"dependencies_complete\":false")
        proof_push(buffer, ",\"goal\":")
        proof_output_json_expr_with_work(buffer, certificate.goal, replay_work)
        proof_push(buffer, "}")
    proof_push(buffer, "]")
    source_files_complete: bool = proof_push_json_source_files(buffer, source_map, source_files_work_reserved)
    function_status_complete: bool = proof_push_json_function_status_from_checked_view(buffer, checked_view, replay_work)
    (proof_push_json_measurements(buffer, report, report_start) can Global.Read)
    expression_details_complete: bool = replay_work <= ElisaProof::proof_replay_summary_source_work_limit()
    proof_push(buffer, ",\"expression_details_complete\":")
    proof_push(buffer, "true" if expression_details_complete else "false")
    proof_push(buffer, "}\n")
    return status_snapshot_complete and expression_details_complete and fact_traces_complete and finding_details_complete and source_files_complete and function_status_complete and declaration_details_complete and repair_failure_details_complete
