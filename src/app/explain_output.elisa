# `--explain <goal_id>`: a plain-text account of one goal for a person at a terminal. It prints the
# goal, its verdict, the refusing gate when it is open, and every fact the engine held beside the
# origin the replay driver recorded for it. It reads the same report the JSON output does and
# decides nothing itself (BACKLOG K-08).
def proof_push_goal_explanation(buffer: mutable darray[u8]&, report: ProofReport&, goal_id: usize) -> bool can[Memory.Allocate, Abort.Panic]:
    if goal_id >= report.goal_attempts.count:
        proof_push(buffer, "elisa-proof: no goal ")
        proof_push_number(buffer, goal_id.u32())
        proof_push(buffer, " in this report\n")
        return false
    attempt: ProofGoalAttempt = report.goal_attempts[goal_id]
    proof_push(buffer, "goal ")
    proof_push_number(buffer, goal_id.u32())
    proof_push(buffer, " in ")
    proof_push(buffer, attempt.name)
    proof_push(buffer, " line ")
    proof_push_number(buffer, attempt.line)
    proof_push(buffer, " (")
    proof_push(buffer, attempt.rule)
    proof_push(buffer, ")\n  goal: ")
    proof_push_elisa_expr(buffer, attempt.goal, false, 0)
    proof_push(buffer, "\n  verdict: ")
    if proof_replay_attempt_is_proven(report, attempt):
        proof_push(buffer, "proven, replayed certificate ")
        proof_push_number(buffer, attempt.certificate_index.u32())
        proof_push(buffer, "\n")
    elif attempt.proven:
        proof_push(buffer, "not proven: producer result lacks successful kernel replay\n")
    else:
        proof_push(buffer, "open, refused at gate ")
        proof_push(buffer, proof_attempt_refusal_gate(report, attempt))
        proof_push(buffer, "\n")
    proof_push(buffer, "  facts: ")
    proof_push_number(buffer, attempt.facts_count.u32())
    proof_push(buffer, "\n")
    for fact_index in 0..<attempt.facts_count |fact_index, attempt, report, buffer|:
        proof_push(buffer, "    [")
        proof_push_number(buffer, fact_index.u32())
        proof_push(buffer, "] ")
        proof_push_elisa_expr(buffer, report.certificate_facts[attempt.facts_start + fact_index], false, 0)
        origin: (known: bool, kind: sview, line: u32, name: sview, dependency: sview, premises_count: usize) = proof_replay_fact_origin_at(report, attempt.facts_start + fact_index, attempt.name)
        if origin.known:
            proof_push(buffer, "  <- ")
            proof_push(buffer, origin.kind)
            proof_push(buffer, " line ")
            proof_push_number(buffer, origin.line)
            if origin.dependency != "":
                proof_push(buffer, " via ")
                proof_push(buffer, origin.dependency)
        else:
            proof_push(buffer, "  <- unknown origin")
        proof_push(buffer, "\n")
    return true
