# Source positions and per-function status for the JSON report.
#
# Includes are spliced before parsing and their directive lines dropped, so every `line` in
# the report counts lines of the expanded source. That keeps it consistent with expression
# positions and kernel records, but past the first include it no longer names a line of any
# one file. The importer's line map recovers it: findings, goals and repair entries also
# carry `file` (an index into the top-level `files` list) and `file_line`.
#
# A finding not bound to a goal -- an unsupported contract call, say -- leaves no trace in
# `goals`, so a client that judges functions by their goals alone counts such a function as
# proved. The `functions` list folds both in: a function is proved only when every goal it
# owns is proven and it has no finding.
struct ProofSourceMap:
    files: darray[u8]
    line_files: darray[u32]
    line_numbers: darray[u32]

def proof_push_json_source_position(buffer: mutable darray[u8]&, source_map: ProofSourceMap&, line: u32) -> void can[Memory.Allocate, Abort.Panic]:
    return if line == 0 or line.usize() > source_map.line_files.count or line.usize() > source_map.line_numbers.count
    proof_push(buffer, ",\"file\":")
    proof_push_number(buffer, source_map.line_files[line.usize() - 1])
    proof_push(buffer, ",\"file_line\":")
    proof_push_number(buffer, source_map.line_numbers[line.usize() - 1])

def proof_push_json_source_files(buffer: mutable darray[u8]&, source_map: ProofSourceMap&, work_reserved: bool) -> bool can[Memory.Allocate, Abort.Panic]:
    if not work_reserved:
        proof_push(buffer, ",\"files\":[],\"files_complete\":false")
        return false
    proof_push(buffer, ",\"files\":[")
    path: mutable darray[u8] = []
    first: mutable bool = true
    for byte in source_map.files |path, first, buffer|:
        if byte == 0:
            proof_push(buffer, ",") if not first
            proof_push_json_bytes(buffer, path)
            path <- path.truncate(0)
            first <- false
        else:
            path.push(byte)
    proof_push(buffer, "]")
    proof_push(buffer, ",\"files_complete\":true")
    return true

# The owning function of a goal or finding name: the text before the first `.`.
def proof_function_status_owner(name: sview, work_used: mutable usize&) -> (complete: bool, owner: darray[u8]) can[Memory.Allocate, Abort.Panic]:
    return (false, []) if not proof_output_reserve_status_snapshot_work(work_used, sview_len(name))
    owner: mutable darray[u8] = []
    for index in 0..<sview_len(name) |name, owner|:
        break if sview_at(name, index) == '.'.u8()
        owner.push(sview_at(name, index))
    return (true, owner)

def proof_function_status_same_with_work(left: darray[u8]&, right: darray[u8]&, work_used: mutable usize&) -> (complete: bool, equal: bool):
    return (false, false) if not proof_output_reserve_status_snapshot_work(work_used, 1)
    return (true, false) if left.count != right.count
    for index in 0..<left.count |left, right, work_used|:
        return (false, false) if not proof_output_reserve_status_snapshot_work(work_used, 1)
        return (true, false) if left[index] != right[index]
    return (true, true)

def proof_function_status_slot_with_work(names: mutable darray[darray[u8]]&, goals: mutable darray[u32]&, open_goals: mutable darray[u32]&, findings: mutable darray[u32]&, owner: darray[u8], work_used: mutable usize&) -> (complete: bool, index: usize) can[Memory.Allocate, Abort.Panic]:
        for index in 0..<names.count |__source_map_name_loop_unit = false, index, names, owner, work_used| -> __source_map_name_loop_unit:
        comparison: (complete: bool, equal: bool) = proof_function_status_same_with_work(names[index], owner, work_used)
        return (false, 0) if not comparison.complete
        return (true, index) if comparison.equal
    return (false, 0) if not proof_output_reserve_status_snapshot_work(work_used, 1)
    names.push(move owner)
    goals.push(0)
    open_goals.push(0)
    findings.push(0)
    return (true, names.count - 1)

def proof_push_json_function_status_from_checked_view[@view](buffer: mutable darray[u8]&, checked_view: ProofCheckedView[view]& @view, work_used: mutable usize&) -> bool can[Memory.Allocate, Abort.Panic]:
    report: ProofReport& = proof_checked_view_diagnostic_report(checked_view)
    names: mutable darray[darray[u8]] = []
    goals: mutable darray[u32] = []
    open_goals: mutable darray[u32] = []
    findings: mutable darray[u32] = []
    complete: mutable bool = true
    for goal_id in 0..<report.results.goal_attempts.count |goal_id, checked_view, report, names, goals, open_goals, findings, work_used, complete|:
        break if not complete
        complete <- false if not proof_output_reserve_status_snapshot_work(work_used, 1)
        break if not complete
        attempt: ProofGoalAttempt = report.results.goal_attempts[goal_id]
        # Report-open goals are already disqualified; spend checked-view replay work only on
        # report-proven candidates that could otherwise close this function.
        producer_claim: bool = proof_checked_view_attempt_had_producer_claim(checked_view, goal_id)
        replay_open: mutable bool = not producer_claim
        if producer_claim:
            snapshot: (complete: bool, replayed: bool, source_admitted: bool) = proof_output_checked_view_goal_status_with_work(checked_view, goal_id, work_used)
            complete <- false if not snapshot.complete
            break if not complete
            replay_open <- not snapshot.replayed or not snapshot.source_admitted
        owner_result: (complete: bool, owner: darray[u8]) = proof_function_status_owner(attempt.name, work_used)
        complete <- false if not owner_result.complete
        break if not complete
        owner: darray[u8] = owner_result.owner
        continue if owner.count == 0
        slot_result: (complete: bool, index: usize) = proof_function_status_slot_with_work(&names, &goals, &open_goals, &findings, move owner, work_used)
        complete <- false if not slot_result.complete
        break if not complete
        slot: usize = slot_result.index
        goals[slot] <- goals[slot] + 1
        open_goals[slot] <- open_goals[slot] + 1 if replay_open
    for finding in report.results.findings |names, goals, open_goals, findings, work_used, complete|:
        break if not complete
        complete <- false if not proof_output_reserve_status_snapshot_work(work_used, 1)
        break if not complete
        owner_result: (complete: bool, owner: darray[u8]) = proof_function_status_owner(finding.name, work_used)
        complete <- false if not owner_result.complete
        break if not complete
        owner: darray[u8] = owner_result.owner
        continue if owner.count == 0
        slot_result: (complete: bool, index: usize) = proof_function_status_slot_with_work(&names, &goals, &open_goals, &findings, move owner, work_used)
        complete <- false if not slot_result.complete
        break if not complete
        slot: usize = slot_result.index
        findings[slot] <- findings[slot] + 1
    if complete:
        complete <- false if not proof_output_reserve_status_snapshot_work(work_used, names.count)
        for owner in names |owner, work_used, complete|:
            break if not complete
            complete <- false if not proof_output_reserve_status_snapshot_work(work_used, owner.count)
    if not complete:
        names.clear()
        goals.clear()
        open_goals.clear()
        findings.clear()
    proof_push(buffer, ",\"functions_complete\":true" if complete else ",\"functions_complete\":false")
    proof_push(buffer, ",\"functions\":[")
    source_authority_complete: bool = proof_checked_view_source_admissible(checked_view) and proof_checked_view_source_admissions_complete(checked_view) and complete
    for index in 0..<names.count |index, names, goals, open_goals, findings, buffer|:
        proof_push(buffer, ",") if index > 0
        proof_push(buffer, "{\"name\":")
        proof_push_json_bytes(buffer, names[index])
        proof_push(buffer, ",\"proved\":")
        proof_push(buffer, "true" if source_authority_complete and open_goals[index] == 0 and findings[index] == 0 else "false")
        proof_push(buffer, ",\"goals\":")
        proof_push_number(buffer, goals[index])
        proof_push(buffer, ",\"open_goals\":")
        proof_push_number(buffer, open_goals[index])
        proof_push(buffer, ",\"findings\":")
        proof_push_number(buffer, findings[index])
        proof_push(buffer, "}")
    proof_push(buffer, "]")
    return complete
