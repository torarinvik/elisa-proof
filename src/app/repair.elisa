const PROOF_REPAIR_REWRITE_FACT_LIMIT: usize = 4
const PROOF_REPAIR_REWRITE_FACT_SCAN_LIMIT: usize = 16
const PROOF_REPAIR_REWRITE_CLOSERS: usize = 4
const PROOF_REPAIR_APPLY_FACT_LIMIT: usize = 4
const PROOF_REPAIR_CONTEXT_FACT_LIMIT: usize = 512
const PROOF_REPAIR_STATE_BYTE_LIMIT: usize = 262144

def proof_push_json_kernel_node(buffer: mutable darray[u8]&, node: ElisaProofKernelCore::ProofKernelNode) -> void can[Memory.Allocate, Abort.Panic]:
    proof_push(buffer, "{\"kind\":")
    proof_push_json_string(buffer, node.kind)
    proof_push(buffer, ",\"operator\":")
    proof_push_json_string(buffer, node.operator)
    proof_push(buffer, ",\"left\":")
    proof_push_number(buffer, node.left.u32())
    proof_push(buffer, ",\"right\":")
    proof_push_number(buffer, node.right.u32())
    proof_push(buffer, ",\"auxiliary\":")
    proof_push_number(buffer, node.auxiliary.u32())
    proof_push(buffer, ",\"children_start\":")
    proof_push_number(buffer, node.children_start.u32())
    proof_push(buffer, ",\"children_count\":")
    proof_push_number(buffer, node.children_count.u32())
    proof_push(buffer, ",\"value\":")
    proof_push_json_i64(buffer, node.value)
    proof_push(buffer, ",\"name\":")
    proof_push_json_string(buffer, node.name)
    proof_push(buffer, ",\"secondary_name\":")
    proof_push_json_string(buffer, node.secondary_name)
    proof_push(buffer, "}")

def proof_push_json_fact_origin(buffer: mutable darray[u8]&, report: ProofReport&, fact_index: usize, owner: sview, work: mutable usize&) -> void can[Memory.Allocate, Abort.Panic]:
    origin: (known: bool, kind: sview, line: u32, name: sview, dependency: sview, premises_count: usize) = proof_replay_fact_origin_at_with_work(report, fact_index, owner, work)
    if not origin.known:
        proof_push(buffer, "null")
        return
    proof_push(buffer, "{\"kind\":")
    proof_push_json_string(buffer, origin.kind)
    proof_push(buffer, ",\"line\":")
    proof_push_number(buffer, origin.line)
    proof_push(buffer, ",\"name\":")
    proof_push_json_string(buffer, origin.name)
    proof_push(buffer, ",\"dependency\":")
    proof_push_json_string(buffer, origin.dependency)
    proof_push(buffer, ",\"premises\":")
    proof_push_number(buffer, origin.premises_count.u32())
    proof_push(buffer, "}")

def proof_push_json_goal_dependencies(buffer: mutable darray[u8]&, report: ProofReport&, facts_start: usize, facts_count: usize, owner: sview, work: mutable usize&) -> bool can[Memory.Allocate, Abort.Panic]:
    dependency_start: usize = buffer.count
    proof_push(buffer, "[")
    emitted: mutable usize = 0
    for fact_index in 0..<facts_count |fact_index, facts_start, report, owner, emitted, buffer, work|:
        if proof_replay_fact_origin_work_exhausted(work):
            buffer.count <- dependency_start
            proof_push(buffer, "[]")
            return false
        origin: (known: bool, kind: sview, line: u32, name: sview, dependency: sview, premises_count: usize) = proof_replay_fact_origin_at_with_work(report, facts_start + fact_index, owner, work)
        if proof_replay_fact_origin_work_exhausted(work):
            buffer.count <- dependency_start
            proof_push(buffer, "[]")
            return false
        continue if not origin.known or origin.dependency == ""
        duplicate: mutable bool = false
        for prior_index in 0..<fact_index |prior_index, facts_start, report, owner, origin, duplicate, work|:
            prior: (known: bool, kind: sview, line: u32, name: sview, dependency: sview, premises_count: usize) = proof_replay_fact_origin_at_with_work(report, facts_start + prior_index, owner, work)
            if proof_replay_fact_origin_work_exhausted(work):
                buffer.count <- dependency_start
                proof_push(buffer, "[]")
                return false
            if prior.known:
                if not proof_replay_fact_origin_text_compare_charge(prior.kind, origin.kind, work) or not proof_replay_fact_origin_text_compare_charge(prior.dependency, origin.dependency, work):
                    buffer.count <- dependency_start
                    proof_push(buffer, "[]")
                    return false
                duplicate <- true if prior.kind == origin.kind and prior.dependency == origin.dependency
        continue if duplicate
        proof_push(buffer, ",") if emitted > 0
        proof_push(buffer, "{\"kind\":")
        proof_push_json_string(buffer, origin.kind)
        proof_push(buffer, ",\"name\":")
        proof_push_json_string(buffer, origin.dependency)
        proof_push(buffer, ",\"line\":")
        proof_push_number(buffer, origin.line)
        proof_push(buffer, "}")
        emitted <- emitted + 1
    proof_push(buffer, "]")
    return true

def proof_push_json_repair_finding(buffer: mutable darray[u8]&, report: ProofReport&, finding: ProofFinding) -> void can[Memory.Allocate, Abort.Panic]:
    proof_push(buffer, "{\"kind\":")
    proof_push_json_string(buffer, finding.kind)
    proof_push(buffer, ",\"status\":")
    proof_push_json_string(buffer, finding.status)
    proof_push(buffer, ",\"message\":")
    proof_push_json_string(buffer, finding.message)
    if finding.budget_dimension != "":
        proof_push(buffer, ",\"budget\":{\"dimension\":")
        proof_push_json_string(buffer, finding.budget_dimension)
        proof_push(buffer, ",\"observed\":")
        proof_push_number(buffer, finding.budget_observed.u32())
        proof_push(buffer, ",\"limit\":")
        proof_push_number(buffer, finding.budget_limit.u32())
        proof_push(buffer, "}")
    proof_push(buffer, ",\"counterexample_found\":")
    proof_push(buffer, "true" if finding.counterexample_found else "false")
    proof_push(buffer, ",\"goal_id\":")
    proof_push_number(buffer, finding.goal_id.u32()) if finding.has_goal
    proof_push(buffer, "null") if not finding.has_goal
    proof_push(buffer, ",\"counterexample\":[")
    for index in 0..<finding.counterexample_count |index, finding, report, buffer|:
        proof_push(buffer, ",") if index > 0
        proof_push_json_expr(buffer, report.results.counterexample_facts[finding.counterexample_start + index])
    proof_push(buffer, "]}")

def proof_push_json_repair_failure(buffer: mutable darray[u8]&, report: ProofReport&, attempt: ProofGoalAttempt, goal_id: usize, finding_index: ProofRepairFindingLookupIndex&, work_used: mutable usize&) -> bool can[Memory.Allocate, Abort.Panic]:
    selected: (complete: bool, known: bool, index: usize, ambiguous: bool) = proof_repair_finding_index_lookup(finding_index, attempt, goal_id, work_used)
    proof_push_json_repair_failure_from_selection(buffer, report, selected, work_used)

def proof_push_json_repair_failure_from_selection(buffer: mutable darray[u8]&, report: ProofReport&, selected: (complete: bool, known: bool, index: usize, ambiguous: bool), work_used: mutable usize&) -> bool can[Memory.Allocate, Abort.Panic]:
    if selected.known:
        finding_complete: bool = proof_push_json_repair_finding_with_work(buffer, report, report.results.findings[selected.index], work_used)
        if finding_complete:
            return selected.complete
        proof_push(buffer, "{\"kind\":\"unresolved-goal\",\"status\":\"unknown\",\"message\":\"diagnostic rendering incomplete because the output work limit was reached\",\"counterexample_found\":false,\"goal_id\":null,\"counterexample\":[]}")
        return false
    proof_push(buffer, "{\"kind\":\"unresolved-goal\",\"status\":\"unknown\",\"message\":")
    if not selected.complete:
        proof_push_json_string(buffer, "diagnostic lookup incomplete because a bounded lookup limit was reached")
    elif selected.ambiguous:
        proof_push_json_string(buffer, "multiple unbound diagnostics share this source location")
    else:
        proof_push_json_string(buffer, "no matching diagnostic was recorded")
    proof_push(buffer, ",\"counterexample_found\":false,\"goal_id\":null,\"counterexample\":[]}")
    return selected.complete

def proof_push_json_repair_finding_with_work(buffer: mutable darray[u8]&, report: ProofReport&, finding: ProofFinding, work_used: mutable usize&) -> bool can[Memory.Allocate, Abort.Panic]:
    return false if:
        not proof_output_reserve_status_snapshot_work(work_used, sview_len(finding.kind))
        not proof_output_reserve_status_snapshot_work(work_used, sview_len(finding.status))
        not proof_output_reserve_status_snapshot_work(work_used, sview_len(finding.name))
        not proof_output_reserve_status_snapshot_work(work_used, sview_len(finding.message))
        not proof_output_reserve_status_snapshot_work(work_used, finding.counterexample_count)
    proof_push_json_repair_finding(buffer, report, finding)
    return true

# Render one goal as an Elisa-like proof a person can read and edit. Everything printed comes from
# the recorded attempt: its hypotheses are the exact certificate facts, its conclusion is the exact
# goal proposition, and its justification names the certificate that replayed. Nothing is inferred
# and no step is invented, so this is a view of the evidence rather than a second proof.
#
# The block keyword carries the verdict, and only one of the three means the kernel checked it:
#   `proof ... qed`  the goal is proven and its certificate replayed independently
#   `unchecked ...`  a producer claim/certificate exists, but source admission or replay failed
#   `open ...`       the goal is unproven; the recorded failure is printed instead of a proof
# Read a rendered proof block back and check it against the source it claims to be about. The
# file is untrusted input: nothing in it is believed, and no part of it is used to decide anything.
# The check re-renders the canonical block for the goal the file names and compares the two, so an
# edited `qed`, an invented hypothesis, a swapped conclusion, a renumbered certificate and a stale
# source all show up the same way — as a divergence from what the report actually supports.
# The bounded, deterministic base vocabulary. Source-derived apply and rewrite candidates are
# appended separately from a capped prefix of the selected goal's context.
# Nothing here decides anything: a candidate is only ever a *proposal*, admitted solely if the
# tactic engine accepts it and the kernel replays the certificate it produces.
def proof_repair_candidates() -> darray[sview] can[Memory.Allocate, Abort.Panic]:
    return ["assumption", "exact", "decide", "simp", "intro", "intro,assumption", "intro,exact", "intro,decide", "simp,assumption", "simp,exact", "simp,decide", "intro,simp", "intro,simp,assumption", "intro,simp,exact", "intro,simp,decide", "intro,intro,assumption", "intro,intro,exact", "intro,intro,decide", "decide,assumption", "simp,intro,exact"]

def proof_repair_strip_outer_parens(expression: Ast::Expr) -> (complete: bool, value: Ast::Expr):
    current: mutable Ast::Expr = expression
    depth: mutable usize = 0
    while depth < 64 |current, depth|:
        match current:
            Ast::Expr.Paren(inner, _):
                current <- inner
                depth <- depth + 1
            _:
                return (true, current)
    return (false, current)

def proof_repair_check_candidate[@view](checked_view: ProofCheckedView[view]& @view, goal_id: usize, repair_state: darray[u8]&, script_text: darray[u8]&, context_prevalidated: bool) -> (usable: bool, admitted: bool) can[Memory.Allocate, Memory.Release, Abort.Panic, Global.Read, Global.Write]:
    report: ProofReport& = proof_checked_view_report(checked_view)
    candidate_arena: mutable Arena = zeroed
    usable: mutable bool = false
    admitted: mutable bool = false
    parsed_state: JsonParseResult[candidate_arena] = (json_parse_checked(&candidate_arena, ElisaProofJson::bytes_range_ref(repair_state, 0, repair_state.count)) can Global{Read,Write})
    if parsed_state.code == JsonErrorCode.OK:
        usable <- context_prevalidated
        if not context_prevalidated and goal_id < report.results.goal_attempts.count:
            source_state: JsonValueHandle[candidate_arena] = ElisaProofJson::from_result(parsed_state)
            source_facts: mutable darray[Ast::Expr] = []
            source_facts_known: bool = proof_tactic_json_expr_list(source_state, "facts", 0, &source_facts)
            source_goal_field: (known: bool, value: JsonValueHandle[candidate_arena]) = proof_tactic_json_field(source_state, "goal")
            source_goal: (known: bool, value: Ast::Expr) = proof_tactic_json_expr(source_goal_field.value)
            attempt: ProofGoalAttempt = report.results.goal_attempts[goal_id]
            source_bound: mutable bool = source_facts_known and source_goal_field.known and source_goal.known and source_facts.count == attempt.facts_count
            source_bound <- false if attempt.rule in {"resource-safety", "structural-safety"}
            source_bound <- false if attempt.facts_start > report.analysis_1.certificate_facts.count or attempt.facts_count > report.analysis_1.certificate_facts.count - attempt.facts_start
            if source_bound:
                source_bound <- not proof_source_tactic_expression_has_overloaded_operator(source_goal.value, report.source.source_primitive_operator_mask)
                for fact in source_facts |fact, report, source_bound|:
                    source_bound <- false if proof_source_tactic_expression_has_overloaded_operator(fact, report.source.source_primitive_operator_mask)
                source_bound <- false if not proof_tactic_source_state_kernel_matches(report, goal_id, source_facts, source_goal.value)
            usable <- source_bound
        if usable:
            parsed_candidate: JsonParseResult[candidate_arena] = (json_parse_checked(&candidate_arena, ElisaProofJson::bytes_range_ref(script_text, 0, script_text.count)) can Global{Read,Write})
            if parsed_candidate.code == JsonErrorCode.OK:
                candidate_state: mutable ProofTacticState& @candidate_arena = proof_tactic_state_in_arena(&candidate_arena)
                candidate_scratch: mutable darray[ProofTacticJsonBranchScratch] @candidate_arena = []
                candidate_tree: mutable ProofTacticJsonTree& @candidate_arena = proof_tactic_tree_in_arena(&candidate_arena)
                candidate_annotations: mutable darray[Ast::EnumAnnotation] @candidate_arena = []
                candidate_result: ProofTacticJsonResult = (proof_tactic_json_run_source(ElisaProofJson::from_result(parsed_candidate), ElisaProofJson::from_result(parsed_state), &candidate_annotations, candidate_state, candidate_tree, &candidate_scratch, checked_view, goal_id) can Global{Read,Write})
                admitted <- candidate_result.valid and candidate_result.solved and candidate_result.trace_replayed and candidate_result.kernel_trace_replayed and candidate_result.kernel_replayed and candidate_result.certificate_replayed
    (arena_free(&candidate_arena) can Global{Read,Write})
    return (usable, admitted)

def proof_repair_push_actions(buffer: mutable darray[u8]&, actions: sview, as_json: bool) -> void can[Memory.Allocate, Abort.Panic]:
    start: mutable usize = 0
    emitted: mutable usize = 0
    while start <= sview_len(actions) |start, emitted, actions, buffer, as_json|:
        stop: mutable usize = start
        while stop < sview_len(actions) |stop, actions|:
            break if sview_at(actions, stop) == ','.u8()
            stop <- stop + 1
        if stop > start:
            if as_json:
                proof_push(buffer, ",") if emitted > 0
                proof_push(buffer, "{\"action\":\"")
                for offset in start..<stop |offset, buffer, actions|:
                    buffer.push(sview_at(actions, offset))
                proof_push(buffer, "\"}")
            else:
                proof_push(buffer, "    by ")
                for offset in start..<stop |offset, buffer, actions|:
                    buffer.push(sview_at(actions, offset))
                proof_push(buffer, "\n")
            emitted <- emitted + 1
        break if stop >= sview_len(actions)
        start <- stop + 1

def proof_repair_push_script_json(buffer: mutable darray[u8]&, goal_id: usize, actions: sview) -> void can[Memory.Allocate, Abort.Panic]:
    proof_push(buffer, "{\"format\":\"elisa-proof-tactics-v1\",\"target\":{\"goal_id\":")
    proof_push_number(buffer, goal_id.u32())
    proof_push(buffer, "},\"actions\":[")
    proof_repair_push_actions(buffer, actions, true)
    proof_push(buffer, "]}")

def proof_repair_push_indexed_script_json(buffer: mutable darray[u8]&, goal_id: usize, fact_index: usize, reverse: bool, closer: sview) -> void can[Memory.Allocate, Abort.Panic]:
    proof_push(buffer, "{\"format\":\"elisa-proof-tactics-v1\",\"target\":{\"goal_id\":")
    proof_push_number(buffer, goal_id.u32())
    proof_push(buffer, "},\"actions\":[{\"action\":\"rewriteback\"" if reverse else "},\"actions\":[{\"action\":\"rewrite\"")
    proof_push(buffer, ",\"argument_index\":")
    proof_push_number(buffer, fact_index.u32())
    proof_push(buffer, "},")
    proof_repair_push_actions(buffer, closer, true)
    proof_push(buffer, "]}")

def proof_repair_push_indexed_apply_script_json(buffer: mutable darray[u8]&, goal_id: usize, fact_index: usize, closer: sview) -> void can[Memory.Allocate, Abort.Panic]:
    proof_push(buffer, "{\"format\":\"elisa-proof-tactics-v1\",\"target\":{\"goal_id\":")
    proof_push_number(buffer, goal_id.u32())
    proof_push(buffer, "},\"actions\":[{\"action\":\"apply\",\"argument_index\":")
    proof_push_number(buffer, fact_index.u32())
    proof_push(buffer, "},")
    proof_repair_push_actions(buffer, closer, true)
    proof_push(buffer, "]}")

# The proposal in the same shape `--proof` renders and `--script` runs, so a repair can be read,
# edited and re-run without translation.
def proof_repair_push_script_text(buffer: mutable darray[u8]&, report: ProofReport&, goal_id: usize, actions: sview, has_rewrite: bool, has_apply: bool, fact_index: usize, reverse: bool) -> void can[Memory.Allocate, Abort.Panic]:
    proof_push(buffer, "# goal ")
    proof_push_number(buffer, goal_id.u32())
    proof_push(buffer, "\nproof ")
    proof_push(buffer, report.results.goal_attempts[goal_id].name if goal_id < report.results.goal_attempts.count else "goal")
    proof_push(buffer, "_")
    proof_push_number(buffer, goal_id.u32())
    proof_push(buffer, ":\n")
    if has_apply:
        proof_push(buffer, "    by apply ")
        proof_push_number(buffer, fact_index.u32())
        proof_push(buffer, "\n")
    elif has_rewrite:
        proof_push(buffer, "    by rewriteback " if reverse else "    by rewrite ")
        proof_push_number(buffer, fact_index.u32())
        proof_push(buffer, "\n")
    proof_repair_push_actions(buffer, actions, false)
    proof_push(buffer, "qed\n")

# One goal's bounded search, shared by the single-goal and whole-file repair modes. It reports only
# what was tried and which candidate the *checked engine* accepted; it never reaches a verdict of
# its own. Rewrites are generated only from explicit equalities in this goal's own fact list.
def proof_repair_search[@view](checked_view: ProofCheckedView[view]& @view, goal_id: usize) -> (repaired: bool, searched: usize, candidates: usize, exhaustive: bool, actions: sview, rewrite_fact_index: usize, rewrite_reverse: bool, has_rewrite: bool, has_apply: bool) can[Memory.Allocate, Memory.Release, Abort.Panic, Global.Read, Global.Write]:
    return (false, 0, 0, false, "", 0, false, false, false) if not proof_checked_view_goal_source_admissible(checked_view, goal_id) or not proof_checked_view_goal_facts_source_admissible(checked_view, goal_id)
    report: ProofReport& = proof_checked_view_report(checked_view)
    repair_state: mutable darray[u8] = []
    repair_goal: mutable Ast::Expr = Ast::Expr.Invalid
    repair_fact_start: mutable usize = 0
    repair_fact_count: mutable usize = 0
    repair_state_complete: mutable bool = false
    repair_json_bytes_left: mutable usize = PROOF_REPAIR_STATE_BYTE_LIMIT - 1024
    repair_json_work_left: mutable usize = PROOF_REPAIR_JSON_WORK_LIMIT
    if goal_id < report.results.goal_attempts.count:
        repair_attempt: ProofGoalAttempt = report.results.goal_attempts[goal_id]
        if repair_attempt.facts_start <= report.analysis_1.certificate_facts.count and repair_attempt.facts_count <= report.analysis_1.certificate_facts.count - repair_attempt.facts_start:
            if repair_attempt.facts_count <= PROOF_REPAIR_CONTEXT_FACT_LIMIT:
                repair_goal <- repair_attempt.goal
                repair_fact_start <- repair_attempt.facts_start
                repair_fact_count <- repair_attempt.facts_count
                repair_state_complete <- true
                proof_push(&repair_state, "{\"facts\":[")
                for fact_index in 0..<repair_attempt.facts_count |fact_index, repair_attempt, report, repair_state, repair_state_complete, repair_json_bytes_left, repair_json_work_left|:
                    break if not repair_state_complete
                    repair_state_complete <- proof_repair_json_expr_fits(report.analysis_1.certificate_facts[repair_attempt.facts_start + fact_index], &repair_json_bytes_left, &repair_json_work_left)
                    break if not repair_state_complete
                    proof_push(&repair_state, ",") if fact_index > 0
                    proof_push_json_expr(&repair_state, report.analysis_1.certificate_facts[repair_attempt.facts_start + fact_index])
                    repair_state_complete <- false if repair_state.count > PROOF_REPAIR_STATE_BYTE_LIMIT
                if repair_state_complete:
                    repair_state_complete <- proof_repair_json_expr_fits(repair_attempt.goal, &repair_json_bytes_left, &repair_json_work_left)
                    if repair_state_complete:
                        proof_push(&repair_state, "],\"goal\":")
                        proof_push_json_expr(&repair_state, repair_attempt.goal)
                        proof_push(&repair_state, "}")
                        repair_state_complete <- false if repair_state.count > PROOF_REPAIR_STATE_BYTE_LIMIT
                if not repair_state_complete:
                    repair_state.clear()
                    repair_fact_count <- 0
    base_candidates: darray[sview] = proof_repair_candidates()
    repaired: mutable bool = false
    searched: mutable usize = 0
    winning: mutable sview = ""
    winning_fact_index: mutable usize = 0
    winning_reverse: mutable bool = false
    has_rewrite: mutable bool = false
    has_apply: mutable bool = false
    candidate_context_usable: mutable bool = true
    candidate_context_prevalidated: mutable bool = false
    candidate_count: mutable usize = base_candidates.count if repair_state_complete else 0
    exhaustive: mutable bool = repair_state_complete
    rewrite_closers: darray[sview] = ["decide", "assumption", "simp,decide", "simp,assumption"]
    apply_closers: darray[sview] = ["assumption", "exact", "decide", "simp", "simp,assumption", "simp,exact", "simp,decide"]
    region repair_region(PROOF_TACTIC_WORKSPACE_ARENA_BYTES):
        repair_store: Ast::Node.Store[Local] = Ast::Node.Store(repair_region)
        in repair_store:
            if repair_state.count > 0:
                for candidate_index in 0..<base_candidates.count |candidate_index, base_candidates, repair_state, report, checked_view, repaired, searched, winning, goal_id, candidate_context_usable, candidate_context_prevalidated|:
                    break if repaired or not candidate_context_usable
                    candidate: sview = base_candidates[candidate_index]
                    script_text: mutable darray[u8] = []
                    proof_repair_push_script_json(&script_text, goal_id, candidate)
                    candidate_check: (usable: bool, admitted: bool) = (proof_repair_check_candidate(checked_view, goal_id, repair_state, script_text, candidate_context_prevalidated) can Global{Read,Write})
                    if not candidate_check.usable:
                        exhaustive <- false
                        candidate_context_usable <- false
                        break
                    else:
                        candidate_context_prevalidated <- true
                        searched <- searched + 1
                    # Solved by the engine is not enough: the certificate it produced must also
                    # replay against the kernel, exactly as a hand-written script must.
                    if candidate_check.admitted:
                        repaired <- true
                        winning <- candidate
                        exhaustive <- false
                if not repaired and candidate_context_usable:
                    fact_scan_count: mutable usize = repair_fact_count
                    if fact_scan_count > PROOF_REPAIR_REWRITE_FACT_SCAN_LIMIT:
                        fact_scan_count <- PROOF_REPAIR_REWRITE_FACT_SCAN_LIMIT
                        exhaustive <- false
                    relevant_apply_facts: mutable usize = 0
                    for fact_index in 0..<fact_scan_count |fact_index, repair_fact_start, report, checked_view, repair_state, goal_id, repaired, searched, winning, winning_fact_index, has_apply, candidate_count, exhaustive, relevant_apply_facts, repair_goal, apply_closers, candidate_context_usable, candidate_context_prevalidated|:
                        break if repaired or not candidate_context_usable
                        fact: Ast::Expr = report.analysis_1.certificate_facts[repair_fact_start + fact_index]
                        unwrapped_fact: (complete: bool, value: Ast::Expr) = proof_repair_strip_outer_parens(fact)
                        if not unwrapped_fact.complete:
                            exhaustive <- false
                            continue
                        match unwrapped_fact.value:
                            Ast::Expr.Binary(_, TokenKind.FatArrow, consequent, _):
                                continue if proof_expr_has_call(fact) or proof_expr_has_move(fact)
                                continue if not (proof_expr_equal(consequent, repair_goal) or proof_quantifier_equal(consequent, repair_goal, report.source.source_annotations))
                                if relevant_apply_facts >= PROOF_REPAIR_APPLY_FACT_LIMIT:
                                    exhaustive <- false
                                    break
                                relevant_apply_facts <- relevant_apply_facts + 1
                                candidate_count <- candidate_count + apply_closers.count
                                for closer_index in 0..<apply_closers.count |closer_index, fact_index, apply_closers, repair_state, report, checked_view, goal_id, repaired, searched, winning, winning_fact_index, has_apply, candidate_context_usable, candidate_context_prevalidated|:
                                    break if repaired or not candidate_context_usable
                                    closer: sview = apply_closers[closer_index]
                                    script_text: mutable darray[u8] = []
                                    proof_repair_push_indexed_apply_script_json(&script_text, goal_id, fact_index, closer)
                                    candidate_check: (usable: bool, admitted: bool) = (proof_repair_check_candidate(checked_view, goal_id, repair_state, script_text, candidate_context_prevalidated) can Global{Read,Write})
                                    if not candidate_check.usable:
                                        exhaustive <- false
                                        candidate_context_usable <- false
                                        break
                                    else:
                                        candidate_context_prevalidated <- true
                                        searched <- searched + 1
                                    if candidate_check.admitted:
                                        repaired <- true
                                        winning <- closer
                                        winning_fact_index <- fact_index
                                        has_apply <- true
                                        exhaustive <- false
                            _:
                                pass
                    relevant_rewrite_facts: mutable usize = 0
                    for fact_index in 0..<fact_scan_count |fact_index, repair_fact_start, report, checked_view, rewrite_closers, repair_state, goal_id, repaired, searched, winning, winning_fact_index, winning_reverse, has_rewrite, candidate_count, exhaustive, relevant_rewrite_facts, repair_goal, candidate_context_usable, candidate_context_prevalidated|:
                        break if repaired or not candidate_context_usable
                        fact: Ast::Expr = report.analysis_1.certificate_facts[repair_fact_start + fact_index]
                        unwrapped_fact: (complete: bool, value: Ast::Expr) = proof_repair_strip_outer_parens(fact)
                        if not unwrapped_fact.complete:
                            exhaustive <- false
                            continue
                        match unwrapped_fact.value:
                            Ast::Expr.Binary(left, TokenKind.EqEq, right, _):
                                continue if proof_expr_has_call(fact) or proof_expr_has_move(fact)
                                left_to_right: (changed: bool, value: Ast::Expr) = proof_tactic_replace(repair_goal, left, right)
                                right_to_left: (changed: bool, value: Ast::Expr) = proof_tactic_replace(repair_goal, right, left)
                                continue if not left_to_right.changed and not right_to_left.changed
                                if relevant_rewrite_facts >= PROOF_REPAIR_REWRITE_FACT_LIMIT:
                                    exhaustive <- false
                                    break
                                relevant_rewrite_facts <- relevant_rewrite_facts + 1
                                candidate_count <- candidate_count + rewrite_closers.count if left_to_right.changed
                                candidate_count <- candidate_count + rewrite_closers.count if right_to_left.changed
                                for direction in 0..<2 |direction, fact_index, rewrite_closers, repair_state, report, checked_view, goal_id, repaired, searched, winning, winning_fact_index, winning_reverse, has_rewrite, candidate_count, exhaustive, left_to_right, right_to_left, candidate_context_usable, candidate_context_prevalidated|:
                                    break if not candidate_context_usable
                                    reverse: bool = direction == 1
                                    continue if reverse and not right_to_left.changed
                                    continue if not reverse and not left_to_right.changed
                                    for closer_index in 0..<rewrite_closers.count |closer_index, direction, reverse, fact_index, rewrite_closers, repair_state, report, checked_view, goal_id, repaired, searched, winning, winning_fact_index, winning_reverse, has_rewrite, exhaustive, candidate_context_usable, candidate_context_prevalidated|:
                                        break if repaired or not candidate_context_usable
                                        closer: sview = rewrite_closers[closer_index]
                                        script_text: mutable darray[u8] = []
                                        proof_repair_push_indexed_script_json(&script_text, goal_id, fact_index, reverse, closer)
                                        candidate_check: (usable: bool, admitted: bool) = (proof_repair_check_candidate(checked_view, goal_id, repair_state, script_text, candidate_context_prevalidated) can Global{Read,Write})
                                        if not candidate_check.usable:
                                            exhaustive <- false
                                            candidate_context_usable <- false
                                            break
                                        else:
                                            candidate_context_prevalidated <- true
                                            searched <- searched + 1
                                        if candidate_check.admitted:
                                            repaired <- true
                                            winning <- closer
                                            winning_fact_index <- fact_index
                                            winning_reverse <- reverse
                                            has_rewrite <- true
                                            exhaustive <- false
                            _:
                                pass
    return (repaired, searched, candidate_count, exhaustive, winning, winning_fact_index, winning_reverse, has_rewrite, has_apply)

# One goal's entry in a whole-file repair report: what it is, whether a proposal survived the
# kernel, and the runnable script when one did.
def proof_push_repair_goal[@view, @buffer](buffer: mutable darray[u8]& @buffer, checked_view: ProofCheckedView[view]& @view, goal_id: usize, found: (repaired: bool, searched: usize, candidates: usize, exhaustive: bool, actions: sview, rewrite_fact_index: usize, rewrite_reverse: bool, has_rewrite: bool, has_apply: bool), source_goal_admissible: bool, source_goal_admissions_complete: bool) -> void can[Memory.Allocate, Abort.Panic]:
    report: ProofReport& = proof_checked_view_report(checked_view)
    if goal_id >= report.results.goal_attempts.count:
        proof_push(buffer, "{\"goal_id\":")
        proof_push_number(buffer, goal_id.u32())
        proof_push(buffer, ",\"name\":null,\"rule\":null,\"line\":null,\"source_admission\":\"unknown\",\"status\":\"not_found\",\"tried\":0,\"candidates\":0,\"exhaustive\":false,\"script\":null}")
        return
    source_admissible: bool = proof_checked_view_source_admissible(checked_view)
    proof_push(buffer, "{\"goal_id\":")
    proof_push_number(buffer, goal_id.u32())
    proof_push(buffer, ",\"name\":")
    proof_push_json_string(buffer, report.results.goal_attempts[goal_id].name)
    proof_push(buffer, ",\"rule\":")
    proof_push_json_string(buffer, report.results.goal_attempts[goal_id].rule)
    proof_push(buffer, ",\"line\":")
    proof_push_number(buffer, report.results.goal_attempts[goal_id].line)
    proof_push(buffer, ",\"source_admission\":")
    proof_push_json_string(buffer, "unknown" if not source_goal_admissions_complete else ("admitted" if source_goal_admissible else "source-unbound"))
    proof_push(buffer, ",\"status\":")
    repair_status: sview = "source-admission-incomplete" if not source_goal_admissions_complete else ("inadmissible" if not source_admissible else ("source-unbound" if not source_goal_admissible else ("repaired" if found.repaired else "unrepaired")))
    proof_push_json_string(buffer, repair_status)
    proof_push(buffer, ",\"tried\":")
    proof_push_number(buffer, found.searched.u32())
    proof_push(buffer, ",\"candidates\":")
    proof_push_number(buffer, found.candidates.u32())
    proof_push(buffer, ",\"exhaustive\":")
    proof_push(buffer, "true" if found.exhaustive else "false")
    proof_push(buffer, ",\"script\":")
    if found.repaired:
        script_body: mutable darray[u8] = []
        proof_repair_push_script_text(&script_body, report, goal_id, found.actions, found.has_rewrite, found.has_apply, found.rewrite_fact_index, found.rewrite_reverse)
        proof_push_json_bytes(buffer, script_body)
    else:
        proof_push(buffer, "null")
    proof_push(buffer, "}")

def proof_tactic_text_json_exhausted(work_used: mutable usize&, work_limit: usize) -> (valid: bool, exhausted: bool, output: darray[u8]) can[Memory.Allocate, Abort.Panic]:
    work_used <- work_limit + 1
    return (false, true, [])

def proof_tactic_text_to_json_with_work(contents: darray[u8]&, output_limit: usize, work_used: mutable usize&, work_limit: usize) -> (valid: bool, exhausted: bool, output: darray[u8]) can[Memory.Allocate, Abort.Panic]:
    empty: mutable darray[u8] = []
    return proof_tactic_text_json_exhausted(&work_used, work_limit) if contents.count > PROOF_INPUT_FILE_MAX_BYTES or output_limit > PROOF_INPUT_FILE_MAX_BYTES
    # Count lines before translation and reserve all translation scans, line-dispatch overhead,
    # action writes, and the final copy into the JSON document. The output estimate is
    # input-bytes + 64 per line + fixed wrapper bytes: each accepted action copies its lowercase
    # name and adds at most 32 bytes plus a comma, while all other accepted lines emit nothing.
    return proof_tactic_text_json_exhausted(&work_used, work_limit) if not proof_tactic_text_work_charge(&work_used, contents.count, work_limit)
    line_count: mutable usize = 0
    for byte in contents |contents, line_count|:
        line_count <- line_count + 1 if byte == '\n'.u8()
    line_count <- line_count + 1 if contents.count > 0 and contents[contents.count - 1] != '\n'.u8()
    remaining_work: usize = work_limit - work_used if work_used <= work_limit else 0
    return proof_tactic_text_json_exhausted(&work_used, work_limit) if contents.count > remaining_work / 7
    return proof_tactic_text_json_exhausted(&work_used, work_limit) if not proof_tactic_text_work_charge(&work_used, contents.count * 7, work_limit)
    remaining_work <- work_limit - work_used
    return proof_tactic_text_json_exhausted(&work_used, work_limit) if line_count > remaining_work / 64
    return proof_tactic_text_json_exhausted(&work_used, work_limit) if not proof_tactic_text_work_charge(&work_used, line_count * 64, work_limit)
    return proof_tactic_text_json_exhausted(&work_used, work_limit) if output_limit < 256 or contents.count > output_limit - 256
    output_remaining: usize = output_limit - 256 - contents.count
    return proof_tactic_text_json_exhausted(&work_used, work_limit) if line_count > output_remaining / 64
    output_bound: usize = contents.count + line_count * 64 + 256
    remaining_work <- work_limit - work_used
    return proof_tactic_text_json_exhausted(&work_used, work_limit) if output_bound > remaining_work / 2
    return proof_tactic_text_json_exhausted(&work_used, work_limit) if not proof_tactic_text_work_charge(&work_used, output_bound * 2, work_limit)
    claimed: (known: bool, goal_id: usize) = proof_rendered_goal_id(contents)
    return (false, false, empty) if not claimed.known
    source_fingerprint: (known: bool, valid: bool, value: u32) = proof_rendered_source_fingerprint(contents)
    return (false, false, empty) if not source_fingerprint.valid
    actions: mutable darray[u8] = []
    emitted: mutable usize = 0
    cursor: mutable usize = 0
    while cursor < contents.count |cursor, contents, actions, emitted|:
        line: (end: usize, next: usize) = proof_rendered_line(contents, cursor)
        translated: (ok: bool, emitted: usize) = proof_script_line_to_json(&actions, contents, cursor, line.end, emitted)
        return (false, false, empty) if not translated.ok
        emitted <- translated.emitted
        cursor <- line.next
    return (false, false, empty) if emitted == 0
    script: mutable darray[u8] = []
    proof_push(&script, "{\"format\":\"elisa-proof-tactics-v1\"")
    if source_fingerprint.known:
        proof_push(&script, ",\"source_fingerprint\":")
        proof_push_number(&script, source_fingerprint.value)
    proof_push(&script, ",\"target\":{\"goal_id\":")
    proof_push_number(&script, claimed.goal_id.u32())
    proof_push(&script, "},\"actions\":[")
    for index in 0..<actions.count |index, script, actions|:
        script.push(actions[index])
    proof_push(&script, "]}")
    if script.count > output_bound or script.count > output_limit:
        work_used <- work_limit + 1
        return (false, true, empty)
    return (true, false, script)

def proof_tactic_text_to_json(contents: darray[u8]&) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
    work_used: mutable usize = 0
    translated: (valid: bool, exhausted: bool, output: darray[u8]) = proof_tactic_text_to_json_with_work(contents, ElisaProof::PROOF_JSON_EXPRESSION_WORK_LIMIT, &work_used, ElisaProof::PROOF_JSON_EXPRESSION_WORK_LIMIT)
    return translated.output if translated.valid else []
