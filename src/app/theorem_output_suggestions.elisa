extend ElisaProofTheoremOutput:
    private:
        def proof_suggestion_match(pattern: Ast::Expr, target: Ast::Expr, report: ProofReport&, theorem: ProofTheoremSummary, bound: mutable darray[bool]&, values: mutable darray[Ast::Expr]&, replay_work: mutable usize&, depth: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            requires depth <= PROOF_THEOREM_OUTPUT_DEPTH_LIMIT
            decreases PROOF_THEOREM_OUTPUT_DEPTH_LIMIT - depth
            if depth >= PROOF_THEOREM_OUTPUT_DEPTH_LIMIT:
                replay_work <- ElisaProof::proof_replay_summary_source_work_limit() + 1
                return false
            return false if not proof_suggestion_work_charge(replay_work, 1)
            match pattern:
                Ast::Expr.Paren(inner, _):
                    return proof_suggestion_match(inner, target, report, theorem, bound, values, replay_work, depth + 1)
                Ast::Expr.Ident(name, _):
                    parameter_index: usize = proof_suggestion_parameter_index(report, theorem, name, replay_work)
                    if parameter_index < theorem.parameters_count:
                        return false if parameter_index >= bound.count or parameter_index >= values.count
                        if bound[parameter_index]:
                            return proof_replay_summary_expr_proof_equal_with_limit(values[parameter_index], target, &replay_work, ElisaProof::proof_replay_summary_source_work_limit())
                        bound[parameter_index] <- true
                        values[parameter_index] <- target
                        return true
                _:
                    pass
            match target:
                Ast::Expr.Paren(inner, _):
                    return proof_suggestion_match(pattern, inner, report, theorem, bound, values, replay_work, depth + 1)
                _:
                    pass
            match pattern:
                Ast::Expr.Unary(operator, operand, _):
                    match target:
                        Ast::Expr.Unary(other_operator, other_operand, _):
                            return operator == other_operator and proof_suggestion_match(operand, other_operand, report, theorem, bound, values, replay_work, depth + 1)
                        _:
                            return false
                Ast::Expr.Binary(left, operator, right, _):
                    match target:
                        Ast::Expr.Binary(other_left, other_operator, other_right, _):
                            return operator == other_operator and proof_suggestion_match(left, other_left, report, theorem, bound, values, replay_work, depth + 1) and proof_suggestion_match(right, other_right, report, theorem, bound, values, replay_work, depth + 1)
                        _:
                            return false
                Ast::Expr.Field(object, field, _):
                    match target:
                        Ast::Expr.Field(other_object, other_field, _):
                            return false if not proof_suggestion_work_charge(replay_work, sview_len(field) + sview_len(other_field))
                            return field == other_field and proof_suggestion_match(object, other_object, report, theorem, bound, values, replay_work, depth + 1)
                        _:
                            return false
                Ast::Expr.Scope(base, name, _):
                    match target:
                        Ast::Expr.Scope(other_base, other_name, _):
                            return false if not proof_suggestion_work_charge(replay_work, sview_len(name) + sview_len(other_name))
                            return name == other_name and proof_suggestion_match(base, other_base, report, theorem, bound, values, replay_work, depth + 1)
                        _:
                            return false
                Ast::Expr.Index(object, index, _):
                    match target:
                        Ast::Expr.Index(other_object, other_index, _):
                            return proof_suggestion_match(object, other_object, report, theorem, bound, values, replay_work, depth + 1) and proof_suggestion_match(index, other_index, report, theorem, bound, values, replay_work, depth + 1)
                        _:
                            return false
                Ast::Expr.Slice(object, low, high, _):
                    match target:
                        Ast::Expr.Slice(other_object, other_low, other_high, _):
                            return proof_suggestion_match(object, other_object, report, theorem, bound, values, replay_work, depth + 1) and proof_suggestion_match(low, other_low, report, theorem, bound, values, replay_work, depth + 1) and proof_suggestion_match(high, other_high, report, theorem, bound, values, replay_work, depth + 1)
                        _:
                            return false
                Ast::Expr.Call(callee, arguments, argument_names, _):
                    match target:
                        Ast::Expr.Call(other_callee, other_arguments, other_argument_names, _):
                            return false if:
                                arguments.count != other_arguments.count or not proof_suggestion_text_array_equal(argument_names, other_argument_names, replay_work)
                                not proof_suggestion_match(callee, other_callee, report, theorem, bound, values, replay_work, depth + 1)
                            for index in 0..<arguments.count |index, arguments, other_arguments, report, theorem, bound, values, replay_work, depth|:
                                return false if not proof_suggestion_match(arguments[index], other_arguments[index], report, theorem, bound, values, replay_work, depth + 1)
                            return true
                        _:
                            return false
                Ast::Expr.IndexN(object, arguments, _):
                    match target:
                        Ast::Expr.IndexN(other_object, other_arguments, _):
                            return false if:
                                arguments.count != other_arguments.count
                                not proof_suggestion_match(object, other_object, report, theorem, bound, values, replay_work, depth + 1)
                            for index in 0..<arguments.count |index, arguments, other_arguments, report, theorem, bound, values, replay_work, depth|:
                                return false if not proof_suggestion_match(arguments[index], other_arguments[index], report, theorem, bound, values, replay_work, depth + 1)
                            return true
                        _:
                            return false
                Ast::Expr.Array(elements, _):
                    match target:
                        Ast::Expr.Array(other_elements, _):
                            return false if elements.count != other_elements.count
                            for index in 0..<elements.count |index, elements, other_elements, report, theorem, bound, values, replay_work, depth|:
                                return false if not proof_suggestion_match(elements[index], other_elements[index], report, theorem, bound, values, replay_work, depth + 1)
                            return true
                        _:
                            return false
                Ast::Expr.Tuple(elements, _):
                    match target:
                        Ast::Expr.Tuple(other_elements, _):
                            return false if elements.count != other_elements.count
                            for index in 0..<elements.count |index, elements, other_elements, report, theorem, bound, values, replay_work, depth|:
                                return false if not proof_suggestion_match(elements[index], other_elements[index], report, theorem, bound, values, replay_work, depth + 1)
                            return true
                        _:
                            return false
                Ast::Expr.SetLit(elements, _):
                    match target:
                        Ast::Expr.SetLit(other_elements, _):
                            return false if elements.count != other_elements.count
                            for index in 0..<elements.count |index, elements, other_elements, report, theorem, bound, values, replay_work, depth|:
                                return false if not proof_suggestion_match(elements[index], other_elements[index], report, theorem, bound, values, replay_work, depth + 1)
                            return true
                        _:
                            return false
                Ast::Expr.If(condition, then_expression, else_expression, _):
                    match target:
                        Ast::Expr.If(other_condition, other_then, other_else, _):
                            return proof_suggestion_match(condition, other_condition, report, theorem, bound, values, replay_work, depth + 1) and proof_suggestion_match(then_expression, other_then, report, theorem, bound, values, replay_work, depth + 1) and proof_suggestion_match(else_expression, other_else, report, theorem, bound, values, replay_work, depth + 1)
                        _:
                            return false
                _:
                    return proof_replay_summary_expr_proof_equal_with_limit(pattern, target, &replay_work, ElisaProof::proof_replay_summary_source_work_limit())
    public:
        def proof_push_json_suggestions_with_replayed[@view, @buffer](buffer: mutable darray[u8]& @buffer, checked_view: ProofCheckedView[view]& @view, goal_id: usize, replay_work: mutable usize&) -> bool can[Memory.Allocate, Abort.Panic, Global{Read,Write}]:
            report: ProofReport& = proof_checked_view_diagnostic_report(checked_view)
            annotations: darray[Ast::EnumAnnotation]& = proof_checked_view_enum_annotations(checked_view)
            source_bytes: usize = proof_checked_view_source_bytes(checked_view)
            source_fingerprint: u32 = proof_checked_view_source_fingerprint(checked_view)
            source_complete: bool = proof_checked_view_source_complete(checked_view)
            source_admissible: bool = proof_checked_view_source_admissible(checked_view)
            suggestions_complete: mutable bool = true
            theorem_admissions_complete: bool = proof_checked_view_theorem_source_admissions_complete(checked_view)
            suggestions_complete <- false if not theorem_admissions_complete
            snapshot: (complete: bool, replayed_goals: darray[bool], source_admitted_goals: darray[bool], proven_goals: darray[bool]) = proof_output_checked_view_goal_statuses_with_work(checked_view, replay_work)
            proven_goals: darray[bool] = snapshot.proven_goals
            goal_status_parts_complete: mutable bool = true
            goal_status_parts: mutable (complete: bool, replayed: bool, goal_source_admitted: bool, facts_source_admitted: bool, source_admitted: bool, proven: bool, producer_claim: bool) = (true, false, false, false, false, false, false)
            if goal_id < report.results.goal_attempts.count:
                goal_status_parts <- proof_checked_view_attempt_status_snapshot_with_work(checked_view, goal_id, replay_work)
                goal_status_parts_complete <- goal_status_parts.complete
                suggestions_complete <- false if not goal_status_parts_complete
            goal_source_admissible: bool = goal_status_parts_complete and goal_id < report.results.goal_attempts.count and goal_status_parts.goal_source_admitted
            goal_facts_source_admissible: bool = goal_status_parts_complete and goal_id < report.results.goal_attempts.count and goal_status_parts.facts_source_admitted
            proof_push(buffer, "{\"format\":\"elisa-proof-suggestions-v1\",\"status\":")
            proof_push_json_string(buffer, "incomplete" if not snapshot.complete else ("ok" if goal_id < report.results.goal_attempts.count else "not_found"))
            proof_push(buffer, ",\"goal_status_snapshot_complete\":")
            proof_push(buffer, "true" if snapshot.complete else "false")
            proof_push(buffer, ",\"source\":{\"bytes\":")
            proof_push_number(buffer, source_bytes.u32())
            proof_push(buffer, ",\"fingerprint\":{\"algorithm\":\"fnv1a32\",\"value\":")
            proof_push_number(buffer, source_fingerprint)
            proof_push(buffer, "},\"complete\":")
            proof_push(buffer, "true" if source_complete else "false")
            proof_push(buffer, ",\"admissible\":")
            proof_push(buffer, "true" if source_admissible else "false")
            proof_push(buffer, "},\"goal_id\":")
            proof_push_number(buffer, goal_id.u32())
            proof_push(buffer, ",\"goal_admissible\":")
            proof_push(buffer, "true" if goal_source_admissible else "false")
            proof_push(buffer, ",\"goal_facts_admissible\":")
            proof_push(buffer, "true" if goal_facts_source_admissible else "false")
            proof_push(buffer, ",\"goal_fingerprint\":")
            if snapshot.complete and goal_id < report.results.goal_attempts.count:
                fingerprint: (valid: bool, value: u32) = proof_goal_fingerprint_with_limit(report, report.results.goal_attempts[goal_id], replay_work, ElisaProof::proof_replay_summary_source_work_limit())
                suggestions_complete <- false if replay_work > ElisaProof::proof_replay_summary_source_work_limit()
                if fingerprint.valid:
                    proof_push(buffer, "{\"algorithm\":\"fnv1a32-kernel-goal-v2\",\"value\":")
                    proof_push_number(buffer, fingerprint.value)
                    proof_push(buffer, "}")
                else:
                    proof_push(buffer, "null")
            else:
                proof_push(buffer, "null")
            proof_push(buffer, ",\"candidates\":[")
            emitted: mutable usize = 0
            solver_work: mutable usize = 0
            solver_preflight_work: mutable usize = 0
            operator_mask_result: (complete: bool, mask: usize) = ElisaProof::proof_report_primitive_operator_mask_with_work(report, replay_work)
            suggestions_complete <- suggestions_complete and operator_mask_result.complete
            fingerprint_source_work: mutable usize = 0
            fingerprint_identity_work: mutable usize = 0
            target_cost_cached: mutable bool = false
            target_expression_cost: mutable usize = 0
            if goal_id < report.results.goal_attempts.count and goal_source_admissible and goal_facts_source_admissible:
                attempt: ProofGoalAttempt = report.results.goal_attempts[goal_id]
                valid_facts: bool = attempt.facts_start <= report.analysis_1.certificate_facts.count and attempt.facts_count <= report.analysis_1.certificate_facts.count - attempt.facts_start
                for theorem_index in 0..<report.analysis_1.theorems.summaries.count |__suggestion_theorem_loop_unit = false, theorem_index, report, checked_view, annotations, attempt, valid_facts, buffer, emitted, proven_goals, replay_work, fingerprint_source_work, fingerprint_identity_work, target_cost_cached, target_expression_cost, suggestions_complete| -> __suggestion_theorem_loop_unit:
                    theorem: ProofTheoremSummary = report.analysis_1.theorems.summaries[theorem_index]
                    if not proof_suggestion_work_charge(replay_work, 1):
                        suggestions_complete <- false
                        break
                    valid_parameters: bool = theorem.parameters_start <= report.analysis_1.theorems.parameters.count and theorem.parameters_count <= report.analysis_1.theorems.parameters.count - theorem.parameters_start and theorem.parameters_start <= report.analysis_1.theorems.parameter_types.count and theorem.parameters_count <= report.analysis_1.theorems.parameter_types.count - theorem.parameters_start and theorem.parameters_start <= report.analysis_1.theorems.parameter_has_defaults.count and theorem.parameters_count <= report.analysis_1.theorems.parameter_has_defaults.count - theorem.parameters_start and theorem.parameters_start <= report.analysis_1.theorems.parameter_defaults.count and theorem.parameters_count <= report.analysis_1.theorems.parameter_defaults.count - theorem.parameters_start
                    valid_requires: bool = theorem.requires_start <= report.analysis_1.theorems.requires.count and theorem.requires_count <= report.analysis_1.theorems.requires.count - theorem.requires_start
                    valid_ensures: bool = theorem.ensures_start <= report.analysis_1.theorems.ensures.count and theorem.ensures_count <= report.analysis_1.theorems.ensures.count - theorem.ensures_start
                    theorem_source_status: (source_admissible: bool, declaration_identity_unambiguous: bool) = proof_checked_view_theorem_source_admission_with_work(checked_view, theorem_index, &replay_work)
                    if theorem.verified and theorem_source_status.source_admissible and theorem_source_status.declaration_identity_unambiguous and not proof_theorem_has_replay_gap(checked_view, report, theorem, proven_goals, replay_work) and valid_parameters and valid_requires and valid_ensures and valid_facts and theorem.ensures_count > 0:
                        if not target_cost_cached:
                            target_cost_result: (complete: bool, cost: usize) = proof_suggestion_expr_cost_charge(attempt.goal, replay_work)
                            if not target_cost_result.complete:
                                suggestions_complete <- false
                                break
                            target_expression_cost <- target_cost_result.cost
                            target_cost_cached <- true
                        fingerprint_cached: mutable bool = false
                        fingerprint_valid: mutable bool = false
                        fingerprint_value: mutable u32 = 0
                        for ensure_index in 0..<theorem.ensures_count |__suggestion_ensure_loop_unit = false, ensure_index, theorem, report, annotations, attempt, buffer, emitted, fingerprint_source_work, fingerprint_identity_work, target_expression_cost, fingerprint_cached, fingerprint_valid, fingerprint_value, suggestions_complete, replay_work| -> __suggestion_ensure_loop_unit:
                            if not proof_suggestion_work_charge(replay_work, 1 + theorem.parameters_count * 3):
                                suggestions_complete <- false
                                break
                            bound: mutable darray[bool] = []
                            values: mutable darray[Ast::Expr] = []
                            names: mutable darray[sview] = []
                            for parameter_index in 0..<theorem.parameters_count |__suggestion_parameter_loop_unit = false, parameter_index, theorem, report, bound, values, names| -> __suggestion_parameter_loop_unit:
                                bound.push(false)
                                values.push(Ast::Expr.Absent)
                                names.push(report.analysis_1.theorems.parameters[theorem.parameters_start + parameter_index])
                            conclusion: Ast::Expr = report.analysis_1.theorems.ensures[theorem.ensures_start + ensure_index]
                            conclusion_cost: (complete: bool, cost: usize) = proof_suggestion_expr_cost_charge(conclusion, replay_work)
                            if not conclusion_cost.complete:
                                suggestions_complete <- false
                                break
                            matched: bool = proof_suggestion_match(conclusion, attempt.goal, report, theorem, &bound, &values, replay_work, 0)
                            if replay_work >= ElisaProof::proof_replay_summary_source_work_limit():
                                suggestions_complete <- false
                                break
                            all_bound: mutable bool = matched
                            for parameter_index in 0..<theorem.parameters_count |parameter_index, theorem, report, bound, values, names, all_bound|:
                                if not bound[parameter_index] and report.analysis_1.theorems.parameter_has_defaults[theorem.parameters_start + parameter_index]:
                                    # Match checked-call argument mapping: reject executable defaults and unresolved formals.
                                    default_expression: Ast::Expr = report.analysis_1.theorems.parameter_defaults[theorem.parameters_start + parameter_index]
                                    parameter_name_bytes: mutable usize = 0
                                    for formal_name in names |__suggestion_name_loop_unit = false, formal_name, parameter_name_bytes, replay_work, suggestions_complete| -> __suggestion_name_loop_unit:
                                        if sview_len(formal_name) > ElisaProof::proof_replay_summary_source_work_limit() - parameter_name_bytes:
                                            suggestions_complete <- false
                                            replay_work <- ElisaProof::proof_replay_summary_source_work_limit()
                                            break
                                        parameter_name_bytes <- parameter_name_bytes + sview_len(formal_name)
                                    default_safe: mutable bool = suggestions_complete and proof_suggestion_default_work_reserve(default_expression, target_expression_cost, theorem.parameters_count, parameter_name_bytes, replay_work)
                                    if replay_work >= ElisaProof::proof_replay_summary_source_work_limit():
                                        suggestions_complete <- false
                                        break
                                    default_safe <- not proof_expr_has_call(default_expression) and not proof_expr_has_old(default_expression) if default_safe
                                    if parameter_index + 1 < theorem.parameters_count:
                                        for later_index in parameter_index + 1..<theorem.parameters_count |__suggestion_default_loop_unit = false, later_index, theorem, report, default_expression, default_safe| -> __suggestion_default_loop_unit:
                                            if not proof_suggestion_work_charge(replay_work, 1 + sview_len(report.analysis_1.theorems.parameters[theorem.parameters_start + later_index])):
                                                suggestions_complete <- false
                                                default_safe <- false
                                                break
                                            default_safe <- false if proof_expr_mentions_name(default_expression, report.analysis_1.theorems.parameters[theorem.parameters_start + later_index])
                                    if default_safe:
                                        resolved_default: Ast::Expr = proof_substitute(default_expression, names, values)
                                        default_safe <- false if proof_expr_has_call(resolved_default) or proof_expr_has_old(resolved_default)
                                        for formal_name in names |formal_name, resolved_default, default_safe|:
                                            default_safe <- false if proof_expr_mentions_name(resolved_default, formal_name)
                                        if default_safe:
                                            values[parameter_index] <- resolved_default
                                            bound[parameter_index] <- true
                                all_bound <- false if not bound[parameter_index]
                            if matched and all_bound:
                                if not proof_suggestion_output_text_reserve(theorem.name, replay_work):
                                    suggestions_complete <- false
                                    break
                                for parameter_index in 0..<theorem.parameters_count |__suggestion_binding_loop_unit = false, parameter_index, theorem, report, values, replay_work, suggestions_complete| -> __suggestion_binding_loop_unit:
                                    if not proof_suggestion_output_text_reserve(report.analysis_1.theorems.parameters[theorem.parameters_start + parameter_index], replay_work) or not proof_suggestion_output_expr_reserve(values[parameter_index], replay_work):
                                        suggestions_complete <- false
                                        break
                                if not suggestions_complete:
                                    break
                                premises: mutable darray[Ast::Expr] = []
                                premise_results: mutable darray[bool] = []
                                facts: mutable darray[Ast::Expr] = []
                                if not proof_suggestion_work_charge(replay_work, attempt.facts_count):
                                    suggestions_complete <- false
                                    break
                                for fact_index in 0..<attempt.facts_count |__suggestion_fact_loop_unit = false, fact_index, attempt, report, facts, replay_work, suggestions_complete| -> __suggestion_fact_loop_unit:
                                    fact: Ast::Expr = report.analysis_1.certificate_facts[attempt.facts_start + fact_index]
                                    fact_cost: (complete: bool, cost: usize) = proof_suggestion_expr_cost_charge(fact, replay_work)
                                    if not fact_cost.complete or fact_cost.cost > PROOF_LINEAR_MAX_ENUMERATED_ELEMENTS:
                                        suggestions_complete <- false
                                        break
                                    facts.push(fact)
                                if not suggestions_complete:
                                    break
                                applicable: mutable bool = true
                                for require_index in 0..<theorem.requires_count |__suggestion_premise_loop_unit = false, require_index, theorem, report, names, values, facts, annotations, replay_work, solver_work, solver_preflight_work, operator_mask_result, premises, premise_results, applicable, suggestions_complete| -> __suggestion_premise_loop_unit:
                                    original_premise: Ast::Expr = report.analysis_1.theorems.requires[theorem.requires_start + require_index]
                                    require_cost: (complete: bool, cost: usize) = proof_suggestion_expr_cost_charge(original_premise, replay_work)
                                    if not require_cost.complete or not proof_suggestion_product_charge(replay_work, require_cost.cost, target_expression_cost, 5 + theorem.parameters_count):
                                        suggestions_complete <- false
                                        break
                                    premise: Ast::Expr = proof_substitute(original_premise, names, values)
                                    premise_output: (complete: bool, cost: usize) = proof_suggestion_expr_cost_charge(premise, replay_work)
                                    if not premise_output.complete or premise_output.cost > PROOF_LINEAR_MAX_ENUMERATED_ELEMENTS or not proof_suggestion_output_expr_cost_reserve(premise, premise_output.cost, replay_work):
                                        suggestions_complete <- false
                                        break
                                    satisfied: bool = (proof_goal_with_shared_work(facts, premise, annotations, operator_mask_result.mask, &solver_work, &solver_preflight_work) can Global{Read,Write})
                                    if solver_work >= PROOF_LINEAR_MAX_ENUMERATED_ELEMENTS or solver_preflight_work >= PROOF_LINEAR_TACTIC_PREFLIGHT_WORK_LIMIT:
                                        suggestions_complete <- false
                                        break
                                    premises.push(premise)
                                    premise_results.push(satisfied)
                                    applicable <- false if not satisfied
                                if not suggestions_complete or not proof_suggestion_product_charge(replay_work, theorem.parameters_count, 1, 32) or not proof_suggestion_product_charge(replay_work, premises.count, 1, 48) or not proof_suggestion_work_charge(replay_work, 256):
                                    suggestions_complete <- false
                                    break
                                if not fingerprint_cached:
                                    theorem_fingerprint: (valid: bool, value: u32) = proof_theorem_fingerprint_with_work(report, theorem, &fingerprint_source_work, &fingerprint_identity_work)
                                    fingerprint_valid <- theorem_fingerprint.valid
                                    fingerprint_value <- theorem_fingerprint.value
                                    fingerprint_cached <- true
                                if not fingerprint_valid:
                                    suggestions_complete <- false
                                    break
                                proof_push(buffer, ",") if emitted > 0
                                emitted <- emitted + 1
                                proof_push(buffer, "{\"theorem\":")
                                proof_push_json_string(buffer, theorem.name)
                                proof_push(buffer, ",\"theorem_fingerprint\":")
                                proof_push(buffer, "{\"algorithm\":\"fnv1a32-kernel-theorem-v2\",\"value\":")
                                proof_push_number(buffer, fingerprint_value)
                                proof_push(buffer, "}")
                                proof_push(buffer, ",\"line\":")
                                proof_push_number(buffer, theorem.line)
                                proof_push(buffer, ",\"ensure_index\":")
                                proof_push_number(buffer, ensure_index.u32())
                                proof_push(buffer, ",\"bindings\":[")
                                for parameter_index in 0..<theorem.parameters_count |parameter_index, theorem, report, values, buffer|:
                                    proof_push(buffer, ",") if parameter_index > 0
                                    proof_push(buffer, "{\"parameter\":")
                                    proof_push_json_string(buffer, report.analysis_1.theorems.parameters[theorem.parameters_start + parameter_index])
                                    proof_push(buffer, ",\"value\":")
                                    proof_push_json_expr(buffer, values[parameter_index])
                                    proof_push(buffer, "}")
                                proof_push(buffer, "],\"premises\":[")
                                for require_index in 0..<premises.count |require_index, premises, premise_results, buffer|:
                                    proof_push(buffer, ",") if require_index > 0
                                    premise: Ast::Expr = premises[require_index]
                                    satisfied: bool = premise_results[require_index]
                                    proof_push(buffer, "{\"proposition\":")
                                    proof_push_json_expr(buffer, premise)
                                    proof_push(buffer, ",\"satisfied\":")
                                    proof_push(buffer, "true" if satisfied else "false")
                                    proof_push(buffer, "}")
                                proof_push(buffer, "],\"premises_satisfied\":")
                                proof_push(buffer, "true" if applicable else "false")
                                proof_push(buffer, ",\"applicable\":")
                                proof_push(buffer, "true" if applicable and source_admissible and goal_source_admissible else "false")
                                proof_push(buffer, "}")
            suggestions_complete <- false if replay_work >= ElisaProof::proof_replay_summary_source_work_limit() or solver_work >= PROOF_LINEAR_MAX_ENUMERATED_ELEMENTS or solver_preflight_work >= PROOF_LINEAR_TACTIC_PREFLIGHT_WORK_LIMIT
            proof_push(buffer, "],\"suggestions_complete\":")
            proof_push(buffer, "true" if suggestions_complete else "false")
            proof_push(buffer, "}\n")
            return snapshot.complete and suggestions_complete
