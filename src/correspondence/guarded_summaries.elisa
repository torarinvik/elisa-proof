# A short-circuit join may retain a checked call postcondition only as an implication from the
# exact source guard. The implication is metadata for correspondence, never an unconditional fact.
def corr_checked_summary_equality(pool: mutable CorrPool&, work: CorrWork&, fact: usize) -> bool:
    return false if fact == 0 or fact >= pool.terms.count
    equality: CorrTerm = pool.terms[fact]
    return false if equality.kind != "binary" or equality.operator != "==" or equality.left == 0 or equality.left >= pool.terms.count
    call: CorrTerm = pool.terms[equality.left]
    return false if call.kind != "call" or call.left == 0
    matches: mutable usize = 0
    for index in 0..<work.functions.count |index, pool, work, call, matches|:
        continue if work.functions[index].status != "checked" or not corr_function_identity_is_unique(work, index)
        resolved: usize = corr_resolved_callable_term(pool, work, index)
        matches <- matches + 1 if resolved != 0 and corr_equal(pool, resolved, call.left, 0)
    return matches == 1

def corr_preserve_guarded_summaries(pool: mutable CorrPool&, work: CorrWork&, evaluated: CorrState&, skipped: CorrState&, guard: usize, joined: mutable CorrState&) -> bool:
    return false if guard == 0 or guard >= pool.terms.count
    return true if not evaluated.live or not skipped.live
    return false if not corr_fact_listed(pool, evaluated.facts, guard)
    for fact in evaluated.facts |pool, work, skipped, guard, joined|:
        continue if corr_fact_listed(pool, skipped.facts, fact)
        continue if not corr_checked_summary_equality(pool, work, fact)
        guarded: usize = corr_binary(pool, "=>", guard, fact)
        return false if guarded == 0
        return false if not corr_fact_listed(pool, joined.facts, guarded) and not corr_add_fact(joined, guarded)
    return true
