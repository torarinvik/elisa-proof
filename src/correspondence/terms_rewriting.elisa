def corr_signed_width(type_name: sview) -> i64:
    return 8 if type_name == "i8"
    return 16 if type_name == "i16"
    return 32 if type_name == "i32"
    return 64 if type_name == "i64"
    return 0

def corr_unsigned_width(type_name: sview) -> i64:
    return 8 if type_name == "u8"
    return 16 if type_name == "u16"
    return 32 if type_name == "u32"
    return 64 if type_name in {"u64", "usize"}
    return 0

def corr_scalar_type(type_name: sview) -> bool:
    return type_name == "bool" or corr_signed_width(type_name) > 0 or corr_unsigned_width(type_name) > 0

# The facts the prover states for a value held at a scalar type, spelled as it spells them.
# Returns false when a term could not be built.
def corr_push_type_facts(pool: mutable CorrPool&, term: usize, type_name: sview, facts: mutable darray[usize]&) -> bool:
    return false if term == 0
    signed: i64 = corr_signed_width(type_name)
    unsigned: i64 = corr_unsigned_width(type_name)
    if signed > 0:
        width: usize = corr_int(pool, signed)
        bound: usize = corr_call2(pool, "__elisa_signed_type_bound", term, width)
        scalar: usize = corr_call1(pool, "__elisa_primitive_scalar_type", term)
        return false if bound == 0 or scalar == 0
        facts.push(bound)
        facts.push(scalar)
        return true
    if unsigned > 0:
        zero: usize = corr_int(pool, 0)
        lower: usize = corr_binary(pool, "<=", zero, term)
        width: usize = corr_int(pool, unsigned)
        bound: usize = corr_call2(pool, "__elisa_unsigned_type_bound", term, width)
        return false if lower == 0 or bound == 0
        facts.push(lower)
        facts.push(bound)
        return true if unsigned == 64
        maximum: mutable i64 = CorrTypeWidth::SMALL_UNSIGNED_32
        maximum <- CorrTypeWidth::SMALL_UNSIGNED_8 if unsigned == 8
        maximum <- CorrTypeWidth::SMALL_UNSIGNED_16 if unsigned == 16
        maximum_term: usize = corr_int(pool, maximum)
        upper: usize = corr_binary(pool, "<=", term, maximum_term)
        return false if upper == 0
        facts.push(upper)
        return true
    if type_name == "bool":
        scalar: usize = corr_call1(pool, "__elisa_primitive_scalar_type", term)
        return false if scalar == 0
        facts.push(scalar)
        return true
    return false

# Structural identity of a pool term and a replayed kernel node: every field the encoder would
# write must agree, and every field it leaves empty must be empty. Paren is transparent in both.
def corr_node_leaf(node: ElisaProofKernelCore::ProofKernelNode) -> bool:
    return node.left == 0 and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0

def corr_node_equal(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, pool: CorrPool&, term: usize, depth: usize) -> bool:
    return false if depth > CorrLimit::TERM_DEPTH or root >= nodes.count or term == 0 or term >= pool.terms.count
    node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
    expected: CorrTerm = pool.terms[term]
    return false if:
        expected.args_start > pool.args.count or expected.args_count > pool.args.count - expected.args_start
        node.kind != expected.kind or node.operator != expected.operator or node.secondary_name != ""
    if expected.kind in {"ident", "int", "bool"}:
        return node.value == expected.value and node.name == expected.name and corr_node_leaf(node)
    if expected.kind == "scope":
        return node.value == 0 and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.name == expected.name and corr_node_equal(nodes, children, node.left, pool, expected.left, depth + 1)
    if expected.kind == "field":
        return node.value == 0 and node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and node.name == expected.name and corr_node_equal(nodes, children, node.left, pool, expected.left, depth + 1)
    return false if node.value != 0 or node.name != ""
    if expected.kind == "unary":
        return node.right == 0 and node.auxiliary == 0 and node.children_start == 0 and node.children_count == 0 and corr_node_equal(nodes, children, node.left, pool, expected.left, depth + 1)
    if expected.kind == "binary":
        return false if node.auxiliary != 0 or node.children_start != 0 or node.children_count != 0
        return corr_node_equal(nodes, children, node.left, pool, expected.left, depth + 1) and corr_node_equal(nodes, children, node.right, pool, expected.right, depth + 1)
    if expected.kind == "if":
        return false if node.children_start != 0 or node.children_count != 0 or expected.args_count != 1 or node.auxiliary == 0 or node.auxiliary >= nodes.count
        return corr_node_equal(nodes, children, node.left, pool, expected.left, depth + 1) and corr_node_equal(nodes, children, node.right, pool, expected.right, depth + 1) and corr_node_equal(nodes, children, node.auxiliary, pool, pool.args[expected.args_start], depth + 1)
    return false if node.right != 0 or node.children_count != expected.args_count
    # A call records how many argument labels it was written with; every label is checked empty
    # below, so an all-positional call and one with all-empty labels denote the same term.
    return false if:
        node.auxiliary != 0 and (expected.kind != "call" or node.auxiliary != expected.args_count)
        node.children_start > children.count or node.children_count > children.count - node.children_start
    if expected.kind == "tuple":
        return false if node.left != 0
        for index in 0..<expected.args_count |index, nodes, children, node, pool, expected, depth|:
            return false if not corr_node_equal(nodes, children, children[node.children_start + index], pool, pool.args[expected.args_start + index], depth + 1)
        return true
    return false if:
        expected.kind != "call" or node.left >= nodes.count
        not corr_node_equal(nodes, children, node.left, pool, expected.left, depth + 1)
    for index in 0..<expected.args_count |index, nodes, children, node, pool, expected, depth|:
        slot: usize = children[node.children_start + index]
        return false if slot >= nodes.count
        argument: ElisaProofKernelCore::ProofKernelNode = nodes[slot]
        return false if:
            argument.kind != "call_arg" or argument.operator != "" or argument.value != 0 or argument.name != "" or argument.secondary_name != ""
            argument.right != 0 or argument.auxiliary != 0 or argument.children_start != 0 or argument.children_count != 0
            not corr_node_equal(nodes, children, argument.left, pool, pool.args[expected.args_start + index], depth + 1)
    return true

# Rewrite only from source-derived equalities whose matching replayed theorem hypothesis has
# already been checked. The caller filters `equalities`; this routine preserves argument order,
# refuses conflicting rewrites, and bounds total traversal and term growth.
def corr_rewrite_source_term(pool: mutable CorrPool&, term: usize, equalities: darray[usize]&, depth: usize, budget: mutable usize&, allow_root: bool) -> usize:
    return 0 if depth > CorrLimit::TERM_DEPTH or term == 0 or term >= pool.terms.count or budget >= CorrLimit::REWRITE_STEPS
    budget <- budget + 1
    if allow_root:
        replacement: mutable usize = 0
        for equality in equalities |pool, term, depth, budget, replacement|:
            return 0 if equality == 0 or equality >= pool.terms.count
            fact: CorrTerm = pool.terms[equality]
            continue if fact.kind != "binary" or fact.operator != "==" or fact.left == 0 or fact.right == 0
            if corr_equal(pool, term, fact.left, 0):
                return 0 if replacement != 0 and not corr_equal(pool, replacement, fact.right, 0)
                replacement <- fact.right
        if replacement != 0 and not corr_equal(pool, term, replacement, 0):
            return corr_rewrite_source_term(pool, replacement, equalities, depth + 1, budget, true)
    node: CorrTerm = pool.terms[term]
    left: mutable usize = node.left
    right: mutable usize = node.right
    changed: mutable bool = false
    if node.left != 0:
        left <- corr_rewrite_source_term(pool, node.left, equalities, depth + 1, budget, true)
        return 0 if left == 0
        changed <- true if left != node.left
    if node.right != 0:
        right <- corr_rewrite_source_term(pool, node.right, equalities, depth + 1, budget, true)
        return 0 if right == 0
        changed <- true if right != node.right
    arguments: mutable darray[usize] = []
    for index in 0..<node.args_count |index, pool, node, equalities, depth, budget, arguments, changed|:
        original: usize = pool.args[node.args_start + index]
        argument: usize = corr_rewrite_source_term(pool, original, equalities, depth + 1, budget, true)
        return 0 if argument == 0
        arguments.push(argument)
        changed <- true if argument != original
    return term if not changed
    if node.kind == "unary":
        return corr_unary(pool, node.operator, left)
    if node.kind == "binary":
        return corr_binary(pool, node.operator, left, right)
    if node.kind == "scope":
        return corr_scope(pool, left, node.name)
    if node.kind == "field":
        return corr_field(pool, left, node.name)
    if node.kind == "call":
        return corr_call_term(pool, left, &arguments)
    if node.kind == "tuple":
        return corr_node_with_children(pool, "tuple", node.name, &arguments)
    if node.kind == "if":
        return 0 if arguments.count != 1
        return corr_if(pool, left, right, arguments[0])
    return 0
