# A small independent source summary for pure total scalar and const-enum functions.
# Every generated relation is later recorded as an obligation at every source return.
const module CorrSummaryLimit:
    PATHS: usize = 16

def corr_summary_append(result: mutable darray[Ast::Expr]&, value: Ast::Expr, guard: Ast::Expr?, position: Ast::Pos, bool_result: bool) -> bool:
    subject: Ast::Expr = Ast::Expr.Ident("result", position)
    if guard is path:
        when_false: Ast::Expr = Ast::Expr.Unary(TokenKind.Not, path, position)
        if bool_result:
            result.push(Ast::Expr.Binary(when_false, TokenKind.Or, Ast::Expr.Binary(Ast::Expr.Unary(TokenKind.Not, subject, position), TokenKind.Or, value, position), position))
            result.push(Ast::Expr.Binary(when_false, TokenKind.Or, Ast::Expr.Binary(subject, TokenKind.Or, Ast::Expr.Unary(TokenKind.Not, value, position), position), position))
        else:
            result.push(Ast::Expr.Binary(when_false, TokenKind.Or, Ast::Expr.Binary(subject, TokenKind.EqEq, value, position), position))
        return true
    if bool_result:
        result.push(Ast::Expr.Binary(Ast::Expr.Unary(TokenKind.Not, subject, position), TokenKind.Or, value, position))
        result.push(Ast::Expr.Binary(subject, TokenKind.Or, Ast::Expr.Unary(TokenKind.Not, value, position), position))
    else:
        result.push(Ast::Expr.Binary(subject, TokenKind.EqEq, value, position))
    return true

def corr_summary_collect(body: darray[Ast::Stmt]&, start: usize, result: mutable darray[Ast::Expr]&, prefix: mutable Ast::Expr?, paths: mutable usize, bool_result: bool) -> bool:
    return false if body.count > CorrLimit::NESTING or start > body.count
    for index in start..<body.count |index, body, result, prefix, paths, bool_result|:
        match body[index]:
            Ast::Stmt.If(condition, then_body, else_body, if_position):
                return false if paths >= CorrSummaryLimit::PATHS or then_body.count != 1 or else_body.count != 0
                match then_body[0]:
                    Ast::Stmt.Return(value, position):
                        return false if value is absent
                        guard: mutable Ast::Expr = condition
                        if prefix is previous:
                            guard <- Ast::Expr.Binary(previous, TokenKind.And, condition, if_position)
                        return false if not corr_summary_append(result, value, guard, position, bool_result)
                        paths <- paths + 1
                        when_false: Ast::Expr = Ast::Expr.Unary(TokenKind.Not, condition, if_position)
                        if prefix is previous_prefix:
                            prefix <- Ast::Expr.Binary(previous_prefix, TokenKind.And, when_false, if_position)
                        else:
                            prefix <- when_false
                    _:
                        return false
            Ast::Stmt.Return(value, position):
                return false if index + 1 < body.count or paths >= CorrSummaryLimit::PATHS or value is absent
                return false if not corr_summary_append(result, value, prefix, position, bool_result)
                paths <- paths + 1
            Ast::Stmt.Expr(value, position):
                return false if index + 1 < body.count or paths >= CorrSummaryLimit::PATHS
                return false if not corr_summary_append(result, value, prefix, position, bool_result)
                paths <- paths + 1
            _:
                return false
    return paths > 0

def corr_source_summary_ensures(pool: CorrPool&, return_type: Ast::Expr?, body: darray[Ast::Stmt]&, start: usize) -> darray[Ast::Expr]:
    result: mutable darray[Ast::Expr] = []
    if return_type is declared:
        match declared:
            Ast::Expr.Ident(name, _):
                bool_result: bool = name == "bool"
                enum_index: usize = corr_source_type_index(pool, name)
                const_enum: mutable bool = enum_index < pool.source_types.count
                if const_enum:
                    match pool.source_types[enum_index]:
                        Ast::Decl.Enum(_, _, is_const, _, _):
                            const_enum <- is_const
                        _:
                            const_enum <- false
                return [] if not bool_result and not const_enum
                prefix: mutable Ast::Expr? = null
                paths: mutable usize = 0
                return result if corr_summary_collect(body, start, &result, prefix, paths, bool_result)
            _:
                return []
    return []
