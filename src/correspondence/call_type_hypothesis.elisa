# Match a package scalar-result marker only when its exact call node is also the call proved by
# an independently source-checked guarded summary in this same theorem.
def corr_guarded_summary_returns_bool(pool: mutable CorrPool&, work: CorrWork&, fact_id: usize) -> bool:
    return false if fact_id == 0 or fact_id >= pool.terms.count
    fact: CorrTerm = pool.terms[fact_id]
    return false if fact.kind != "binary" or fact.operator != "=>" or fact.right == 0 or fact.right >= pool.terms.count
    equality: CorrTerm = pool.terms[fact.right]
    return false if equality.kind != "binary" or equality.operator != "==" or equality.left == 0 or equality.left >= pool.terms.count
    call: CorrTerm = pool.terms[equality.left]
    return false if call.kind != "call" or call.left == 0
    matches: mutable usize = 0
    for index in 0..<work.functions.count |index, pool, work, call, matches|:
        function: CorrFunction = work.functions[index]
        continue if function.status != "checked" or not corr_function_identity_is_unique(work, index)
        resolved: usize = corr_resolved_callable_term(pool, work, index)
        continue if resolved == 0 or not corr_equal(pool, resolved, call.left, 0)
        match function.declaration:
            Ast::Decl.Func(_, _, return_type, _, _, _, _):
                if return_type is declared_return_type:
                    match declared_return_type:
                        Ast::Expr.Ident("bool", _):
                            matches <- matches + 1
                        _:
                            pass
            _:
                pass
    return matches == 1

def corr_guarded_scalar_call_node(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize) -> usize:
    return 0 if root == 0 or root >= nodes.count
    marker: ElisaProofKernelCore::ProofKernelNode = nodes[root]
    return 0 if marker.kind != "call" or marker.left >= nodes.count or marker.children_count != 1
    return 0 if marker.right != 0 or marker.auxiliary != 0 or marker.value != 0 or marker.name != "" or marker.secondary_name != ""
    return 0 if marker.children_start > children.count or marker.children_count > children.count - marker.children_start
    callee: ElisaProofKernelCore::ProofKernelNode = nodes[marker.left]
    return 0 if callee.kind != "ident" or callee.name != "__elisa_primitive_scalar_type" or not corr_node_leaf(callee)
    argument_root: usize = children[marker.children_start]
    return 0 if argument_root >= nodes.count
    argument: ElisaProofKernelCore::ProofKernelNode = nodes[argument_root]
    return 0 if argument.kind != "call_arg" or argument.operator != "" or argument.value != 0 or argument.name != "" or argument.secondary_name != ""
    return 0 if argument.right != 0 or argument.auxiliary != 0 or argument.children_start != 0 or argument.children_count != 0
    return argument.left if argument.left < nodes.count and nodes[argument.left].kind == "call"
    return 0

def corr_guarded_call_type_hypothesis(nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, theorem: CorrTheorem, hypotheses: darray[usize]&, goal: usize, pool: mutable CorrPool&, work: mutable CorrWork&, obligation: CorrObligation, root: usize) -> bool:
    call_node: usize = corr_guarded_scalar_call_node(nodes, children, root)
    return false if call_node == 0
    matches: mutable usize = 0
    for index in 0..<theorem.hypotheses_count |index, nodes, children, theorem, hypotheses, goal, pool, work, obligation, root, call_node, matches|:
        summary_root: usize = hypotheses[theorem.hypotheses_start + index]
        continue if summary_root == root or summary_root >= nodes.count
        summary_node: ElisaProofKernelCore::ProofKernelNode = nodes[summary_root]
        continue if summary_node.kind != "binary" or summary_node.operator != "==" or summary_node.left != call_node
        source_fact: mutable usize = 0
        continue if not corr_guarded_summary_hypothesis(nodes, children, goal, pool, work, obligation, summary_root, &source_fact)
        continue if not corr_guarded_summary_returns_bool(pool, work, source_fact)
        matches <- matches + 1
    return matches == 1
