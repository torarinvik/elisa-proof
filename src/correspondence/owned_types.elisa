# Owner-qualified source types accepted by the conservative correspondence walker.
def corr_type_name(taken: darray[sview]&, expression: Ast::Expr, allow_mutable: bool) -> (name: sview, is_mutable: bool):
    match expression:
        Ast::Expr.Ident(name, _):
            return ("", false) if not corr_scalar_type(name) or corr_name_listed(taken, name)
            return (name, false)
        Ast::Expr.Unary(operator, operand, _):
            return ("", false) if not allow_mutable or operator != TokenKind.Mutable
            inner: (name: sview, is_mutable: bool) = corr_type_name(taken, operand, false)
            return (inner.name, true)
        _:
            return ("", false)

def corr_type_name_owned(work: CorrWork&, expression: Ast::Expr, allow_mutable: bool) -> (name: sview, is_mutable: bool):
    primitive: (name: sview, is_mutable: bool) = corr_type_name(work.taken, expression, allow_mutable)
    return primitive if sview_len(primitive.name) > 0
    match expression:
        Ast::Expr.Ident(name, _):
            if corr_source_enum_type_is_lexical(work.source_constants, work.owner_segments, work.active_owner_start, work.active_owner_count, name):
                return (name, false)
            return ("", false)
        _:
            return ("", false)

def corr_declare_owned_type(pool: mutable CorrPool&, work: CorrWork&, state: mutable CorrState&, name: sview, type_name: sview, value: usize, assignable: bool, epoch: usize) -> bool:
    if corr_scalar_type(type_name):
        return corr_declare(pool, state, name, type_name, value, assignable, epoch)
    return false if not corr_source_enum_type_is_lexical(work.source_constants, work.owner_segments, work.active_owner_start, work.active_owner_count, type_name)
    return false if not corr_declare(pool, state, name, "", value, assignable, epoch)
    state.types[state.types.count - 1] <- type_name
    marker: usize = corr_call1(pool, "__elisa_primitive_scalar_type", corr_ident(pool, name))
    return corr_add_fact(state, marker)
