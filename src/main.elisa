# Elisa Proof — self-hosted proof assistant entry point.
#
# The parser and semantic model are the compiler's own Elisa implementation. The proof
# checker is intentionally a separate module: importing Elisa stays compiler-compatible,
# while proof obligations can grow without weakening ordinary compilation.
include "../../Elisa-compiler/src/semantic/semantic.elisa"
include "../../Elisa-compiler/elisacore_std/elisacore_json.elisa"
include "./proof/kernel_core.elisa"
include "./proof/model.elisa"
include "./proof/kernel.elisa"
include "./proof/expr.elisa"
include "./proof/linear.elisa"
include "./proof/resources.elisa"
include "./proof/check.elisa"
include "./proof/kernel_replay.elisa"
include "./proof/replay.elisa"
include "./proof/import.elisa"
include "./proof/tactics.elisa"
include "./proof/tactic_json.elisa"

using Ast
using Semantic
using ElisaProof

extern open(path: cstr, flags: i64, ...) -> i64
extern close(fd: i64) -> i64
extern read(fd: i64, buf: u8&, count: usize) -> i64
extern getcwd(buffer: void&, size: usize) -> void&
extern getcwd(buffer: void&, size: usize) -> void&

def proof_read_file_checked(path: cstr) -> (ok: bool, contents: darray[u8]) can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    contents: mutable darray[u8] = []
    descriptor: i64 = open(path, 0, 0)
    return (false, contents) if descriptor < 0
    chunk: mutable darray[u8] = []
    chunk.resize(65536)
    while true |contents, chunk, descriptor|:
        amount: i64 = read(descriptor, &chunk[0], 65536)
        if amount < 0:
            _ = close(descriptor)
            return (false, [])
        break if amount == 0
        for index in 0..<amount.usize() |contents, chunk|:
            contents.push(chunk[index])
    _ = close(descriptor)
    return (true, contents)

def proof_read_file(path: cstr) -> darray[u8] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    result: (ok: bool, contents: darray[u8]) = proof_read_file_checked(path)
    return result.contents if result.ok
    return []

def proof_write(text: darray[u8]&) -> void can[Console, Unsafe.PointerCast]:
    return if text.count == 0
    raw: void& = (&text[0]).cast[void&] can Unsafe.PointerCast
    _ = write(1, raw, text.count)

def proof_push(buffer: mutable darray[u8]&, text: sview) -> void can[Memory.Allocate, Abort.Panic]:
    for index in 0..<sview_len(text) |buffer|:
        buffer.push(sview_at(text, index))

def proof_push_number(buffer: mutable darray[u8]&, value: u32) -> void can[Memory.Allocate, Abort.Panic]:
    digits: mutable darray[u8] = []
    remaining: mutable u32 = value
    if remaining == 0:
        buffer.push('0'.u8())
        return
    while remaining > 0 |digits, remaining|:
        digits.push(('0'.u8()) + (remaining % 10).u8())
        remaining <- remaining / 10
    index: mutable usize = digits.count
    while index > 0 |buffer, digits, index|:
        index <- index - 1
        buffer.push(digits[index])

def proof_source_fingerprint(source: darray[u8]&) -> u32:
    # FNV-1a over the exact expanded bytes handed to the parser. This is an identity hint for
    # proof caches and AI clients, not a cryptographic digest or a kernel acceptance condition.
    hash: mutable i64 = 2166136261
    for byte in source |hash|:
        hash <- ((hash ^ byte.i64()) * 16777619) % 4294967296
    return hash.u32()

# Canonical identity encoding for one source-neutral kernel term. Arena indices and unrelated
# source positions are deliberately excluded, so inserting an unrelated declaration does not
# invalidate a cached target proof. This fingerprint is an incremental cache/binding guard, not a
# cryptographic proof; the independently replayed term remains the admission authority.
def proof_push_kernel_identity(buffer: mutable darray[u8]&, nodes: darray[ElisaProofKernelCore::ProofKernelNode]&, children: darray[usize]&, root: usize, depth: usize) -> bool can[Memory.Allocate, Abort.Panic]:
    requires depth <= 128
    decreases 128 - depth
    return false if depth >= 128 or root >= nodes.count
    node: ElisaProofKernelCore::ProofKernelNode = nodes[root]
    proof_push(buffer, "(")
    proof_push(buffer, node.kind)
    proof_push(buffer, ":")
    proof_push(buffer, node.operator)
    proof_push(buffer, ":")
    proof_push_json_i64(buffer, node.value)
    proof_push(buffer, ":")
    proof_push_json_string(buffer, node.name)
    proof_push(buffer, ":")
    proof_push_json_string(buffer, node.secondary_name)
    valid: mutable bool = true
    match node.kind:
        "unary" or "move" or "field" or "scope" or "call_arg" or "checked-get":
            valid <- proof_push_kernel_identity(buffer, nodes, children, node.left, depth + 1)
        "binary" or "index" or "checked-index" or "dict_entry":
            valid <- proof_push_kernel_identity(buffer, nodes, children, node.left, depth + 1)
            valid <- proof_push_kernel_identity(buffer, nodes, children, node.right, depth + 1) and valid
        "if" or "slice":
            valid <- proof_push_kernel_identity(buffer, nodes, children, node.left, depth + 1)
            valid <- proof_push_kernel_identity(buffer, nodes, children, node.right, depth + 1) and valid
            valid <- proof_push_kernel_identity(buffer, nodes, children, node.auxiliary, depth + 1) and valid
        "call" or "index-n" or "construct" or "record-update":
            valid <- proof_push_kernel_identity(buffer, nodes, children, node.left, depth + 1)
            valid <- false if node.children_start > children.count or node.children_count > children.count - node.children_start
            if valid:
                for index in 0..<node.children_count |index, node, children, nodes, buffer, depth, valid|:
                    valid <- proof_push_kernel_identity(buffer, nodes, children, children[node.children_start + index], depth + 1) and valid
        "array" or "tuple" or "set" or "dict":
            valid <- false if node.children_start > children.count or node.children_count > children.count - node.children_start
            if valid:
                for index in 0..<node.children_count |index, node, children, nodes, buffer, depth, valid|:
                    valid <- proof_push_kernel_identity(buffer, nodes, children, children[node.children_start + index], depth + 1) and valid
        "quantifier":
            proof_push(buffer, ":")
            proof_push_json_i64(buffer, node.auxiliary.i64())
            valid <- proof_push_kernel_identity(buffer, nodes, children, node.left, depth + 1)
            valid <- proof_push_kernel_identity(buffer, nodes, children, node.right, depth + 1) and valid
        _:
            pass
    proof_push(buffer, ")")
    return valid

def proof_goal_fingerprint(report: ProofReport&, attempt: ProofGoalAttempt) -> (valid: bool, value: u32) can[Memory.Allocate, Abort.Panic]:
    return (false, 0) if attempt.kernel_facts_start > report.kernel_certificate_facts.count or attempt.kernel_facts_count > report.kernel_certificate_facts.count - attempt.kernel_facts_start
    identity: mutable darray[u8] = []
    proof_push(&identity, "elisa-proof-goal-v1:")
    valid: mutable bool = true
    for index in 0..<attempt.kernel_facts_count |index, attempt, report, identity, valid|:
        proof_push(&identity, "F")
        root: usize = report.kernel_certificate_facts[attempt.kernel_facts_start + index]
        valid <- proof_push_kernel_identity(&identity, report.kernel_nodes, report.kernel_children, root, 0) and valid
    proof_push(&identity, "G")
    valid <- proof_push_kernel_identity(&identity, report.kernel_nodes, report.kernel_children, attempt.kernel_goal, 0) and valid
    return (false, 0) if not valid
    return (true, proof_source_fingerprint(identity))

def proof_push_theorem_expression_identity(buffer: mutable darray[u8]&, nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, expression: Ast::Expr) -> bool can[Memory.Allocate, Abort.Panic]:
    return false if not proof_kernel_expression_supported(expression)
    root: usize = proof_kernel_encode_expression(expression, nodes, children)
    return proof_push_kernel_identity(buffer, nodes, children, root, 0)

# Canonical identity of a theorem statement and invocation signature. Source positions, report
# indices, proof scripts, and certificate arena offsets are excluded: changing the proof without
# changing the checked theorem does not invalidate consumers. Verification and replay remain
# separate admission gates and are never implied by this observational FNV identity.
def proof_theorem_fingerprint(report: ProofReport&, theorem: ProofTheoremSummary) -> (valid: bool, value: u32) can[Memory.Allocate, Abort.Panic]:
    valid_parameters: bool = theorem.parameters_start <= report.theorem_parameters.count and theorem.parameters_count <= report.theorem_parameters.count - theorem.parameters_start and theorem.parameters_start <= report.theorem_parameter_types.count and theorem.parameters_count <= report.theorem_parameter_types.count - theorem.parameters_start and theorem.parameters_start <= report.theorem_parameter_has_defaults.count and theorem.parameters_count <= report.theorem_parameter_has_defaults.count - theorem.parameters_start and theorem.parameters_start <= report.theorem_parameter_defaults.count and theorem.parameters_count <= report.theorem_parameter_defaults.count - theorem.parameters_start
    valid_requires: bool = theorem.requires_start <= report.theorem_requires.count and theorem.requires_count <= report.theorem_requires.count - theorem.requires_start
    valid_ensures: bool = theorem.ensures_start <= report.theorem_ensures.count and theorem.ensures_count <= report.theorem_ensures.count - theorem.ensures_start
    valid_decreases: bool = theorem.decreases_start <= report.theorem_decreases.count and theorem.decreases_count <= report.theorem_decreases.count - theorem.decreases_start
    return (false, 0) if not valid_parameters or not valid_requires or not valid_ensures or not valid_decreases
    identity: mutable darray[u8] = []
    nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
    children: mutable darray[usize] = []
    proof_push(&identity, "elisa-proof-theorem-v1:")
    proof_push_json_string(&identity, theorem.name)
    proof_push(&identity, ":recursive:" if theorem.recursive else ":nonrecursive:")
    valid: mutable bool = true
    for index in 0..<theorem.parameters_count |index, theorem, report, identity, nodes, children, valid|:
        parameter_index: usize = theorem.parameters_start + index
        proof_push(&identity, "P")
        proof_push_json_string(&identity, report.theorem_parameters[parameter_index])
        valid <- proof_push_theorem_expression_identity(&identity, &nodes, &children, report.theorem_parameter_types[parameter_index]) and valid
        if report.theorem_parameter_has_defaults[parameter_index]:
            proof_push(&identity, "D")
            valid <- proof_push_theorem_expression_identity(&identity, &nodes, &children, report.theorem_parameter_defaults[parameter_index]) and valid
        else:
            proof_push(&identity, "N")
    for index in 0..<theorem.requires_count |index, theorem, report, identity, nodes, children, valid|:
        proof_push(&identity, "R")
        valid <- proof_push_theorem_expression_identity(&identity, &nodes, &children, report.theorem_requires[theorem.requires_start + index]) and valid
    for index in 0..<theorem.ensures_count |index, theorem, report, identity, nodes, children, valid|:
        proof_push(&identity, "E")
        valid <- proof_push_theorem_expression_identity(&identity, &nodes, &children, report.theorem_ensures[theorem.ensures_start + index]) and valid
    for index in 0..<theorem.decreases_count |index, theorem, report, identity, nodes, children, valid|:
        proof_push(&identity, "M")
        valid <- proof_push_theorem_expression_identity(&identity, &nodes, &children, report.theorem_decreases[theorem.decreases_start + index]) and valid
    return (false, 0) if not valid
    return (true, proof_source_fingerprint(identity))

def proof_cstr_equals(left: cstr, right: sview) -> bool:
    index: mutable usize = 0
    right_length: usize = sview_len(right)
    while index < right_length |index, left, right|:
        return false if left[index] == 0 or left[index] != sview_at(right, index)
        index <- index + 1
    return left[index] == 0

def proof_cstr_u32(value: cstr) -> (valid: bool, parsed: u32):
    return (false, 0) if value[0] == 0
    result: mutable u32 = 0
    index: mutable usize = 0
    while value[index] != 0 |value, result, index|:
        byte: u8 = value[index]
        return (false, 0) if byte < '0'.u8() or byte > '9'.u8()
        digit: u32 = (byte - '0'.u8()).u32()
        return (false, 0) if result > 429496729 or result == 429496729 and digit > 5
        result <- result * 10 + digit
        index <- index + 1
    return (true, result)

def proof_push_json_string(buffer: mutable darray[u8]&, value: sview) -> void can[Memory.Allocate, Abort.Panic]:
    buffer.push('"'.u8())
    for index in 0..<sview_len(value) |index, buffer, value|:
        byte: u8 = sview_at(value, index)
        if byte == '"'.u8() or byte == '\\'.u8():
            buffer.push('\\'.u8())
            buffer.push(byte)
        elif byte == '\n'.u8():
            proof_push(buffer, "\\n")
        elif byte == '\r'.u8():
            proof_push(buffer, "\\r")
        elif byte == '\t'.u8():
            proof_push(buffer, "\\t")
        elif byte < 32:
            proof_push(buffer, "?")
        else:
            buffer.push(byte)
    buffer.push('"'.u8())

def proof_push_json_bytes(buffer: mutable darray[u8]&, value: darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
    # `Semantic::diagnostic_message` returns owned bytes rather than an sview. Keep the JSON
    # encoder's escaping rules identical for compiler diagnostics without manufacturing a view
    # whose lifetime would outlive the temporary message.
    buffer.push('"'.u8())
    for index in 0..<value.count |index, value, buffer|:
        byte: u8 = value[index]
        if byte == '"'.u8() or byte == '\\'.u8():
            buffer.push('\\'.u8())
            buffer.push(byte)
        elif byte == '\n'.u8():
            proof_push(buffer, "\\n")
        elif byte == '\r'.u8():
            proof_push(buffer, "\\r")
        elif byte == '\t'.u8():
            proof_push(buffer, "\\t")
        elif byte < 32:
            proof_push(buffer, "?")
        else:
            buffer.push(byte)
    buffer.push('"'.u8())

def proof_push_json_i64(buffer: mutable darray[u8]&, value: i64) -> void can[Memory.Allocate, Abort.Panic]:
    if value == 0 - 9223372036854775807 - 1:
        proof_push(buffer, "-9223372036854775808")
        return
    working: mutable i64 = value
    if working < 0:
        buffer.push('-'.u8())
        working <- 0 - working
    digits: mutable darray[u8] = []
    remaining: mutable i64 = working
    if remaining == 0:
        buffer.push('0'.u8())
        return
    while remaining > 0 |digits, remaining|:
        digits.push(('0'.u8()) + (remaining % 10).u8())
        remaining <- remaining / 10
    index: mutable usize = digits.count
    while index > 0 |buffer, digits, index|:
        index <- index - 1
        buffer.push(digits[index])

def proof_push_json_operator(buffer: mutable darray[u8]&, operator: TokenKind) -> void can[Memory.Allocate, Abort.Panic]:
    value: mutable sview = "unknown"
    value <- "+" if operator == TokenKind.Plus
    value <- "-" if operator == TokenKind.Minus
    value <- "*" if operator == TokenKind.Star
    value <- "/" if operator == TokenKind.Slash
    value <- "%" if operator == TokenKind.Percent
    value <- "==" if operator == TokenKind.EqEq
    value <- "!=" if operator == TokenKind.BangEq
    value <- "<" if operator == TokenKind.Lt
    value <- ">" if operator == TokenKind.Gt
    value <- "<=" if operator == TokenKind.LtEq
    value <- ">=" if operator == TokenKind.GtEq
    value <- "and" if operator == TokenKind.And
    value <- "or" if operator == TokenKind.Or
    value <- "=>" if operator == TokenKind.FatArrow
    value <- "not" if operator == TokenKind.Not
    value <- "in" if operator == TokenKind.In
    value <- "is" if operator == TokenKind.Is
    value <- "as" if operator == TokenKind.As
    value <- "|" if operator == TokenKind.Pipe
    value <- "^" if operator == TokenKind.Caret
    value <- "&" if operator == TokenKind.Ampersand
    value <- "<<" if operator == TokenKind.LShift
    value <- ">>" if operator == TokenKind.RShift
    value <- "range_lt" if operator == TokenKind.RangeLt
    value <- "range_le" if operator == TokenKind.RangeLe
    proof_push_json_string(buffer, value)

# Render an expression back into Elisa source syntax for a human reader. This is presentation
# only: it never decides anything and is never read back as evidence, so a form it does not know
# how to spell is printed as an explicit `<kind ...>` marker rather than as plausible-looking
# source. A nested binary is always parenthesized, so the printed form is unambiguous without a
# precedence table that could drift from the parser's.
def proof_push_elisa_expr(buffer: mutable darray[u8]&, expression: Ast::Expr, grouped: bool, depth: usize) -> void can[Memory.Allocate, Abort.Panic]:
    requires depth <= 63
    decreases 63 - depth
    if depth >= 63:
        proof_push(buffer, "<depth>")
        return
    # An operand position groups a nested binary or ternary, so the printed form is unambiguous
    # without a precedence table that could drift from the parser's.
    needs_group: mutable bool = false
    match expression:
        Ast::Expr.Binary(_, _, _, _):
            needs_group <- grouped
        Ast::Expr.If(_, _, _, _):
            needs_group <- grouped
        _:
            pass
    proof_push(buffer, "(") if needs_group
    match expression:
        Ast::Expr.Invalid:
            proof_push(buffer, "<invalid>")
        Ast::Expr.Absent:
            proof_push(buffer, "absent")
        Ast::Expr.IntLit(value):
            proof_push_json_i64(buffer, value)
        Ast::Expr.FloatLit(value):
            proof_push(buffer, value)
        Ast::Expr.StringLit(value):
            proof_push_json_string(buffer, value)
        Ast::Expr.CharLit(value):
            proof_push(buffer, "'")
            proof_push(buffer, value)
            proof_push(buffer, "'")
        Ast::Expr.BoolLit(value):
            proof_push(buffer, "true" if value else "false")
        Ast::Expr.Ident(name, _):
            proof_push(buffer, name)
        Ast::Expr.Paren(inner, _):
            proof_push(buffer, "(")
            proof_push_elisa_expr(buffer, inner, false, depth + 1)
            proof_push(buffer, ")")
        Ast::Expr.Unary(operator, operand, _):
            if operator == TokenKind.Not:
                proof_push(buffer, "not ")
            else:
                proof_push_elisa_operator(buffer, operator)
            proof_push_elisa_expr(buffer, operand, true, depth + 1)
        Ast::Expr.Binary(left, operator, right, _):
            proof_push_elisa_expr(buffer, left, true, depth + 1)
            proof_push(buffer, " ")
            proof_push_elisa_operator(buffer, operator)
            proof_push(buffer, " ")
            proof_push_elisa_expr(buffer, right, true, depth + 1)
        Ast::Expr.Call(callee, arguments, argument_names, _):
            proof_push_elisa_expr(buffer, callee, true, depth + 1)
            proof_push(buffer, "(")
            for index in 0..<arguments.count |index, arguments, argument_names, buffer, depth|:
                proof_push(buffer, ", ") if index > 0
                if index < argument_names.count and argument_names[index] != "":
                    proof_push(buffer, argument_names[index])
                    proof_push(buffer, ": ")
                proof_push_elisa_expr(buffer, arguments[index], false, depth + 1)
            proof_push(buffer, ")")
        Ast::Expr.Field(object, field, _):
            proof_push_elisa_expr(buffer, object, true, depth + 1)
            proof_push(buffer, ".")
            proof_push(buffer, field)
        Ast::Expr.Scope(base, field, _):
            proof_push_elisa_expr(buffer, base, true, depth + 1)
            proof_push(buffer, "::")
            proof_push(buffer, field)
        Ast::Expr.ShorthandMember(parts, _):
            for index in 0..<parts.count |index, parts, buffer|:
                proof_push(buffer, ".")
                proof_push(buffer, parts[index])
        Ast::Expr.Index(object, index_expression, _):
            proof_push_elisa_expr(buffer, object, true, depth + 1)
            proof_push(buffer, "[")
            proof_push_elisa_expr(buffer, index_expression, true, depth + 1)
            proof_push(buffer, "]")
        Ast::Expr.Slice(object, low, high, _):
            proof_push_elisa_expr(buffer, object, true, depth + 1)
            proof_push(buffer, "[")
            proof_push_elisa_expr(buffer, low, true, depth + 1)
            proof_push(buffer, "..")
            proof_push_elisa_expr(buffer, high, true, depth + 1)
            proof_push(buffer, "]")
        Ast::Expr.IndexN(object, arguments, _):
            proof_push_elisa_expr(buffer, object, true, depth + 1)
            proof_push(buffer, "[")
            for index in 0..<arguments.count |index, arguments, buffer, depth|:
                proof_push(buffer, ", ") if index > 0
                proof_push_elisa_expr(buffer, arguments[index], false, depth + 1)
            proof_push(buffer, "]")
        Ast::Expr.Move(operand, _):
            proof_push(buffer, "move ")
            proof_push_elisa_expr(buffer, operand, true, depth + 1)
        Ast::Expr.Array(elements, _):
            proof_push(buffer, "[")
            for index in 0..<elements.count |index, elements, buffer, depth|:
                proof_push(buffer, ", ") if index > 0
                proof_push_elisa_expr(buffer, elements[index], false, depth + 1)
            proof_push(buffer, "]")
        Ast::Expr.Tuple(elements, _):
            proof_push(buffer, "(")
            for index in 0..<elements.count |index, elements, buffer, depth|:
                proof_push(buffer, ", ") if index > 0
                proof_push_elisa_expr(buffer, elements[index], false, depth + 1)
            proof_push(buffer, ")")
        Ast::Expr.Construct(type_expression, fields, _):
            proof_push_elisa_expr(buffer, type_expression, true, depth + 1)
            proof_push(buffer, "{")
            for index in 0..<fields.count |index, fields, buffer, depth|:
                proof_push(buffer, ", ") if index > 0
                proof_push(buffer, fields[index].name)
                proof_push(buffer, ": ")
                proof_push_elisa_expr(buffer, fields[index].value, false, depth + 1)
            proof_push(buffer, "}")
        Ast::Expr.RecordUpdate(base, fields, _):
            proof_push_elisa_expr(buffer, base, true, depth + 1)
            proof_push(buffer, "{")
            for index in 0..<fields.count |index, fields, buffer, depth|:
                proof_push(buffer, ", ") if index > 0
                proof_push(buffer, fields[index].name)
                proof_push(buffer, " = ")
                proof_push_elisa_expr(buffer, fields[index].value, false, depth + 1)
            proof_push(buffer, "}")
        Ast::Expr.If(condition, then_expression, else_expression, _):
            proof_push_elisa_expr(buffer, then_expression, true, depth + 1)
            proof_push(buffer, " if ")
            proof_push_elisa_expr(buffer, condition, true, depth + 1)
            proof_push(buffer, " else ")
            proof_push_elisa_expr(buffer, else_expression, true, depth + 1)
        _:
            # Deliberately not spelled out. A reader must not mistake a form this printer does
            # not model for source that says what the proof state actually holds.
            proof_push(buffer, "<unprinted expression>")
    proof_push(buffer, ")") if needs_group

def proof_push_elisa_operator(buffer: mutable darray[u8]&, operator: TokenKind) -> void can[Memory.Allocate, Abort.Panic]:
    value: mutable sview = "<operator>"
    value <- "+" if operator == TokenKind.Plus
    value <- "-" if operator == TokenKind.Minus
    value <- "*" if operator == TokenKind.Star
    value <- "/" if operator == TokenKind.Slash
    value <- "%" if operator == TokenKind.Percent
    value <- "==" if operator == TokenKind.EqEq
    value <- "!=" if operator == TokenKind.BangEq
    value <- "<" if operator == TokenKind.Lt
    value <- ">" if operator == TokenKind.Gt
    value <- "<=" if operator == TokenKind.LtEq
    value <- ">=" if operator == TokenKind.GtEq
    value <- "and" if operator == TokenKind.And
    value <- "or" if operator == TokenKind.Or
    value <- "=>" if operator == TokenKind.FatArrow
    value <- "not" if operator == TokenKind.Not
    value <- "in" if operator == TokenKind.In
    value <- "is" if operator == TokenKind.Is
    value <- "as" if operator == TokenKind.As
    value <- "|" if operator == TokenKind.Pipe
    value <- "^" if operator == TokenKind.Caret
    value <- "&" if operator == TokenKind.Ampersand
    value <- "<<" if operator == TokenKind.LShift
    value <- ">>" if operator == TokenKind.RShift
    proof_push(buffer, value)

def proof_push_json_expr(buffer: mutable darray[u8]&, expression: Ast::Expr) -> void can[Memory.Allocate, Abort.Panic]:
    match expression:
        Ast::Expr.Invalid:
            proof_push(buffer, "{\"kind\":\"invalid\"}")
        Ast::Expr.Absent:
            proof_push(buffer, "{\"kind\":\"absent\"}")
        Ast::Expr.IntLit(value):
            proof_push(buffer, "{\"kind\":\"int\",\"value\":")
            proof_push_json_i64(buffer, value)
            proof_push(buffer, "}")
        Ast::Expr.FloatLit(value):
            proof_push(buffer, "{\"kind\":\"float\",\"text\":")
            proof_push_json_string(buffer, value)
            proof_push(buffer, "}")
        Ast::Expr.StringLit(value):
            proof_push(buffer, "{\"kind\":\"string\",\"text\":")
            proof_push_json_string(buffer, value)
            proof_push(buffer, "}")
        Ast::Expr.CharLit(value):
            proof_push(buffer, "{\"kind\":\"char\",\"text\":")
            proof_push_json_string(buffer, value)
            proof_push(buffer, "}")
        Ast::Expr.BoolLit(value):
            proof_push(buffer, "{\"kind\":\"bool\",\"value\":")
            proof_push(buffer, "true" if value else "false")
            proof_push(buffer, "}")
        Ast::Expr.Ident(name, position):
            proof_push(buffer, "{\"kind\":\"ident\",\"name\":")
            proof_push_json_string(buffer, name)
            proof_push(buffer, ",\"line\":")
            proof_push_number(buffer, position.line)
            proof_push(buffer, "}")

        Ast::Expr.Paren(inner, _):
            proof_push(buffer, "{\"kind\":\"paren\",\"inner\":")
            proof_push_json_expr(buffer, inner)
            proof_push(buffer, "}")
        Ast::Expr.Unary(operator, operand, _):
            proof_push(buffer, "{\"kind\":\"unary\",\"operator\":")
            proof_push_json_operator(buffer, operator)
            proof_push(buffer, ",\"operand\":")
            proof_push_json_expr(buffer, operand)
            proof_push(buffer, "}")
        Ast::Expr.Binary(left, operator, right, _):
            proof_push(buffer, "{\"kind\":\"binary\",\"operator\":")
            proof_push_json_operator(buffer, operator)
            proof_push(buffer, ",\"left\":")
            proof_push_json_expr(buffer, left)
            proof_push(buffer, ",\"right\":")
            proof_push_json_expr(buffer, right)
            proof_push(buffer, "}")
        Ast::Expr.Call(callee, arguments, argument_names, _):
            proof_push(buffer, "{\"kind\":\"call\",\"callee\":")
            proof_push_json_expr(buffer, callee)
            proof_push(buffer, ",\"arguments\":[")
            for index in 0..<arguments.count |index, arguments, buffer|:
                proof_push(buffer, ",") if index > 0
                proof_push_json_expr(buffer, arguments[index])
            proof_push(buffer, "],\"argument_names\":[")
            for index in 0..<argument_names.count |index, argument_names, buffer|:
                proof_push(buffer, ",") if index > 0
                proof_push_json_string(buffer, argument_names[index])
            proof_push(buffer, "]}")
        Ast::Expr.Field(object, field, _):
            proof_push(buffer, "{\"kind\":\"field\",\"object\":")
            proof_push_json_expr(buffer, object)
            proof_push(buffer, ",\"field\":")
            proof_push_json_string(buffer, field)
            proof_push(buffer, "}")
        Ast::Expr.Scope(base, field, _):
            proof_push(buffer, "{\"kind\":\"scope\",\"base\":")
            proof_push_json_expr(buffer, base)
            proof_push(buffer, ",\"name\":")
            proof_push_json_string(buffer, field)
            proof_push(buffer, "}")
        Ast::Expr.ShorthandMember(parts, _):
            proof_push(buffer, "{\"kind\":\"shorthand_member\",\"parts\":[")
            for index in 0..<parts.count |index, parts, buffer|:
                proof_push(buffer, ",") if index > 0
                proof_push_json_string(buffer, parts[index])
            proof_push(buffer, "]}")
        Ast::Expr.Index(object, index, _):
            proof_push(buffer, "{\"kind\":\"index\",\"object\":")
            proof_push_json_expr(buffer, object)
            proof_push(buffer, ",\"index\":")
            proof_push_json_expr(buffer, index)
            proof_push(buffer, "}")
        Ast::Expr.Slice(object, low, high, _):
            proof_push(buffer, "{\"kind\":\"slice\",\"object\":")
            proof_push_json_expr(buffer, object)
            proof_push(buffer, ",\"low\":")
            proof_push_json_expr(buffer, low)
            proof_push(buffer, ",\"high\":")
            proof_push_json_expr(buffer, high)
            proof_push(buffer, "}")
        Ast::Expr.IndexN(object, arguments, _):
            proof_push(buffer, "{\"kind\":\"index_n\",\"object\":")
            proof_push_json_expr(buffer, object)
            proof_push(buffer, ",\"arguments\":[")
            for index in 0..<arguments.count |index, arguments, buffer|:
                proof_push(buffer, ",") if index > 0
                proof_push_json_expr(buffer, arguments[index])
            proof_push(buffer, "]}")
        Ast::Expr.Move(operand, _):
            proof_push(buffer, "{\"kind\":\"move\",\"operand\":")
            proof_push_json_expr(buffer, operand)
            proof_push(buffer, "}")
        Ast::Expr.RegionNew(operand, region, _):
            proof_push(buffer, "{\"kind\":\"region_new\",\"region\":")
            proof_push_json_string(buffer, region)
            proof_push(buffer, ",\"operand\":")
            proof_push_json_expr(buffer, operand)
            proof_push(buffer, "}")
        Ast::Expr.Array(elements, _):
            proof_push(buffer, "{\"kind\":\"array\",\"elements\":[")
            for index in 0..<elements.count |index, elements, buffer|:
                proof_push(buffer, ",") if index > 0
                proof_push_json_expr(buffer, elements[index])
            proof_push(buffer, "]}")
        Ast::Expr.Tuple(elements, _):
            proof_push(buffer, "{\"kind\":\"tuple\",\"elements\":[")
            for index in 0..<elements.count |index, elements, buffer|:
                proof_push(buffer, ",") if index > 0
                proof_push_json_expr(buffer, elements[index])
            proof_push(buffer, "]}")
        Ast::Expr.SetLit(elements, _):
            proof_push(buffer, "{\"kind\":\"set\",\"elements\":[")
            for index in 0..<elements.count |index, elements, buffer|:
                proof_push(buffer, ",") if index > 0
                proof_push_json_expr(buffer, elements[index])
            proof_push(buffer, "]}")
        Ast::Expr.DictLit(entries, _):
            proof_push(buffer, "{\"kind\":\"dict\",\"entries\":[")
            for index in 0..<entries.count |index, entries, buffer|:
                proof_push(buffer, ",") if index > 0
                proof_push(buffer, "{\"key\":")
                proof_push_json_expr(buffer, entries[index].key)
                proof_push(buffer, ",\"value\":")
                proof_push_json_expr(buffer, entries[index].value)
                proof_push(buffer, "}")
            proof_push(buffer, "]}")
        Ast::Expr.Construct(type_expression, fields, _):
            proof_push(buffer, "{\"kind\":\"construct\",\"type\":")
            proof_push_json_expr(buffer, type_expression)
            proof_push(buffer, ",\"fields\":[")
            for index in 0..<fields.count |index, fields, buffer|:
                proof_push(buffer, ",") if index > 0
                proof_push(buffer, "{\"name\":")
                proof_push_json_string(buffer, fields[index].name)
                proof_push(buffer, ",\"value\":")
                proof_push_json_expr(buffer, fields[index].value)
                proof_push(buffer, "}")
            proof_push(buffer, "]}")
        Ast::Expr.RecordUpdate(base, fields, _):
            proof_push(buffer, "{\"kind\":\"record_update\",\"base\":")
            proof_push_json_expr(buffer, base)
            proof_push(buffer, ",\"fields\":[")
            for index in 0..<fields.count |index, fields, buffer|:
                proof_push(buffer, ",") if index > 0
                proof_push(buffer, "{\"name\":")
                proof_push_json_string(buffer, fields[index].name)
                proof_push(buffer, ",\"value\":")
                proof_push_json_expr(buffer, fields[index].value)
                proof_push(buffer, "}")
            proof_push(buffer, "]}")
        Ast::Expr.If(condition, then_expr, else_expr, _):
            proof_push(buffer, "{\"kind\":\"if\",\"condition\":")
            proof_push_json_expr(buffer, condition)
            proof_push(buffer, ",\"then\":")
            proof_push_json_expr(buffer, then_expr)
            proof_push(buffer, ",\"else\":")
            proof_push_json_expr(buffer, else_expr)
            proof_push(buffer, "}")
        Ast::Expr.Comprehension(variable, iterable, condition, body, _):
            proof_push(buffer, "{\"kind\":\"comprehension\",\"variable\":")
            proof_push_json_string(buffer, variable)
            proof_push(buffer, ",\"iterable\":")
            proof_push_json_expr(buffer, iterable)
            proof_push(buffer, ",\"condition\":")
            proof_push_json_expr(buffer, condition)
            proof_push(buffer, ",\"body\":")
            proof_push_json_expr(buffer, body)
            proof_push(buffer, "}")
        Ast::Expr.Refinement(base, predicate, _):
            proof_push(buffer, "{\"kind\":\"refinement\",\"base\":")
            proof_push_json_expr(buffer, base)
            proof_push(buffer, ",\"predicate\":")
            proof_push_json_expr(buffer, predicate)
            proof_push(buffer, "}")
        Ast::Expr.Block(statements, value, _, position):
            proof_push(buffer, "{\"kind\":\"block\",\"line\":")
            proof_push_number(buffer, position.line)
            proof_push(buffer, ",\"statements\":[")
            for index in 0..<statements.count |index, statements, buffer|:
                proof_push(buffer, ",") if index > 0
                match statements[index]:
                    Ast::Stmt.VarDecl(name, type_expression, initializer, _):
                        proof_push(buffer, "{\"kind\":\"var_decl\",\"name\":")
                        proof_push_json_string(buffer, name)
                        proof_push(buffer, ",\"type\":")
                        proof_push_json_expr(buffer, type_expression)
                        proof_push(buffer, ",\"initializer\":")
                        proof_push_json_expr(buffer, initializer)
                        proof_push(buffer, "}")
                    _:
                        proof_push(buffer, "{\"kind\":\"unsupported_statement\"}")
            proof_push(buffer, "],\"value\":")
            proof_push_json_expr(buffer, value)
            proof_push(buffer, "}")
        _:
            position: Ast::Pos = Ast::expr_pos(expression)
            proof_push(buffer, "{\"kind\":\"unsupported\",\"line\":")
            proof_push_number(buffer, position.line)
            proof_push(buffer, "}")

def proof_push_json_kernel_node(buffer: mutable darray[u8]&, node: ElisaProofKernelCore::ProofKernelNode) -> void can[Memory.Allocate, Abort.Panic]:
    proof_push(buffer, "{\"kind\":")
    proof_push_json_string(buffer, node.kind)
    proof_push(buffer, ",\"operator\":")
    proof_push_json_string(buffer, node.operator)
    proof_push(buffer, ",\"left\":")
    proof_push_number(buffer, node.left.u32())
    proof_push(buffer, ",\"right\":")
    proof_push_number(buffer, node.right.u32())
    proof_push(buffer, ",\"auxiliary\":")
    proof_push_number(buffer, node.auxiliary.u32())
    proof_push(buffer, ",\"children_start\":")
    proof_push_number(buffer, node.children_start.u32())
    proof_push(buffer, ",\"children_count\":")
    proof_push_number(buffer, node.children_count.u32())
    proof_push(buffer, ",\"value\":")
    proof_push_json_i64(buffer, node.value)
    proof_push(buffer, ",\"name\":")
    proof_push_json_string(buffer, node.name)
    proof_push(buffer, ",\"secondary_name\":")
    proof_push_json_string(buffer, node.secondary_name)
    proof_push(buffer, "}")

def proof_push_json_fact_origin(buffer: mutable darray[u8]&, report: ProofReport&, fact_index: usize, owner: sview) -> void can[Memory.Allocate, Abort.Panic]:
    origin: (known: bool, kind: sview, line: u32, name: sview, dependency: sview, premises_count: usize) = proof_replay_fact_origin_at(report, fact_index, owner)
    if not origin.known:
        proof_push(buffer, "null")
        return
    proof_push(buffer, "{\"kind\":")
    proof_push_json_string(buffer, origin.kind)
    proof_push(buffer, ",\"line\":")
    proof_push_number(buffer, origin.line)
    proof_push(buffer, ",\"name\":")
    proof_push_json_string(buffer, origin.name)
    proof_push(buffer, ",\"dependency\":")
    proof_push_json_string(buffer, origin.dependency)
    proof_push(buffer, ",\"premises\":")
    proof_push_number(buffer, origin.premises_count.u32())
    proof_push(buffer, "}")

def proof_push_json_goal_dependencies(buffer: mutable darray[u8]&, report: ProofReport&, facts_start: usize, facts_count: usize, owner: sview) -> void can[Memory.Allocate, Abort.Panic]:
    emitted: mutable usize = 0
    for fact_index in 0..<facts_count |fact_index, facts_start, report, owner, emitted, buffer|:
        origin: (known: bool, kind: sview, line: u32, name: sview, dependency: sview, premises_count: usize) = proof_replay_fact_origin_at(report, facts_start + fact_index, owner)
        continue if not origin.known or origin.dependency == ""
        duplicate: mutable bool = false
        for prior_index in 0..<fact_index |prior_index, facts_start, report, owner, origin, duplicate|:
            prior: (known: bool, kind: sview, line: u32, name: sview, dependency: sview, premises_count: usize) = proof_replay_fact_origin_at(report, facts_start + prior_index, owner)
            duplicate <- true if prior.known and prior.kind == origin.kind and prior.dependency == origin.dependency
        continue if duplicate
        proof_push(buffer, ",") if emitted > 0
        proof_push(buffer, "{\"kind\":")
        proof_push_json_string(buffer, origin.kind)
        proof_push(buffer, ",\"name\":")
        proof_push_json_string(buffer, origin.dependency)
        proof_push(buffer, ",\"line\":")
        proof_push_number(buffer, origin.line)
        proof_push(buffer, "}")
        emitted <- emitted + 1

def proof_push_json_repair_finding(buffer: mutable darray[u8]&, report: ProofReport&, finding: ProofFinding) -> void can[Memory.Allocate, Abort.Panic]:
    proof_push(buffer, "{\"kind\":")
    proof_push_json_string(buffer, finding.kind)
    proof_push(buffer, ",\"status\":")
    proof_push_json_string(buffer, finding.status)
    proof_push(buffer, ",\"message\":")
    proof_push_json_string(buffer, finding.message)
    proof_push(buffer, ",\"counterexample_found\":")
    proof_push(buffer, "true" if finding.counterexample_found else "false")
    proof_push(buffer, ",\"goal_id\":")
    proof_push_number(buffer, finding.goal_id.u32()) if finding.has_goal
    proof_push(buffer, "null") if not finding.has_goal
    proof_push(buffer, ",\"counterexample\":[")
    for index in 0..<finding.counterexample_count |index, finding, report, buffer|:
        proof_push(buffer, ",") if index > 0
        proof_push_json_expr(buffer, report.counterexample_facts[finding.counterexample_start + index])
    proof_push(buffer, "]}")

def proof_repair_finding_index(report: ProofReport&, attempt: ProofGoalAttempt, goal_id: usize) -> (known: bool, index: usize, ambiguous: bool):
    # Stable goal provenance wins unconditionally. Never select a different goal's diagnostic
    # merely because the compiler placed both obligations on the same source line.
    index: mutable usize = 0
    for finding in report.findings |finding, report, goal_id, index|:
        if finding.has_goal and finding.goal_id == goal_id:
            return (true, index, false)
        index <- index + 1
    # Legacy non-goal diagnostics can be used only when the line/name pair identifies exactly one
    # candidate. Ambiguity is reported as unknown instead of fabricating a causal association.
    candidate_count: mutable usize = 0
    candidate_index: mutable usize = 0
    for index in 0..<report.findings.count |index, report, attempt, candidate_count, candidate_index|:
        finding: ProofFinding = report.findings[index]
        if not finding.has_goal and finding.line == attempt.line and finding.name == attempt.name:
            candidate_count <- candidate_count + 1
            candidate_index <- index
    return (true, candidate_index, false) if candidate_count == 1
    return (false, 0, candidate_count > 1)

def proof_push_json_repair_failure(buffer: mutable darray[u8]&, report: ProofReport&, attempt: ProofGoalAttempt, goal_id: usize) -> void can[Memory.Allocate, Abort.Panic]:
    selected: (known: bool, index: usize, ambiguous: bool) = proof_repair_finding_index(report, attempt, goal_id)
    if selected.known:
        proof_push_json_repair_finding(buffer, report, report.findings[selected.index])
        return
    proof_push(buffer, "{\"kind\":\"unresolved-goal\",\"status\":\"unknown\",\"message\":")
    proof_push_json_string(buffer, "multiple unbound diagnostics share this source location" if selected.ambiguous else "no matching diagnostic was recorded")
    proof_push(buffer, ",\"counterexample_found\":false,\"goal_id\":null,\"counterexample\":[]}")

# Render one goal as an Elisa-like proof a person can read and edit. Everything printed comes from
# the recorded attempt: its hypotheses are the exact certificate facts, its conclusion is the exact
# goal proposition, and its justification names the certificate that replayed. Nothing is inferred
# and no step is invented, so this is a view of the evidence rather than a second proof.
#
# The block keyword carries the verdict, and only one of the three means the kernel checked it:
#   `proof ... qed`  the goal is proven and its certificate replayed independently
#   `unchecked ...`  the producer proved it but no certificate replayed: not kernel-backed
#   `open ...`       the goal is unproven; the recorded failure is printed instead of a proof
# Read a rendered proof block back and check it against the source it claims to be about. The
# file is untrusted input: nothing in it is believed, and no part of it is used to decide anything.
# The check re-renders the canonical block for the goal the file names and compares the two, so an
# edited `qed`, an invented hypothesis, a swapped conclusion, a renumbered certificate and a stale
# source all show up the same way — as a divergence from what the report actually supports.
def proof_rendered_line(contents: darray[u8]&, start: usize) -> (end: usize, next: usize) can[Memory.Allocate, Abort.Panic]:
    cursor: mutable usize = start
    while cursor < contents.count |cursor, contents|:
        break if contents[cursor] == '\n'.u8()
        cursor <- cursor + 1
    return (cursor, cursor + 1 if cursor < contents.count else cursor)

def proof_rendered_lines_equal(left: darray[u8]&, left_start: usize, left_end: usize, right: darray[u8]&, right_start: usize, right_end: usize) -> bool:
    return false if left_end - left_start != right_end - right_start
    for offset in 0..<(left_end - left_start) |offset, left, right, left_start, right_start|:
        return false if left[left_start + offset] != right[right_start + offset]
    return true

def proof_push_json_byte_range(buffer: mutable darray[u8]&, contents: darray[u8]&, start: usize, end: usize) -> void can[Memory.Allocate, Abort.Panic]:
    buffer.push('"'.u8())
    for index in start..<end |index, buffer, contents|:
        byte: u8 = contents[index]
        if byte == '"'.u8() or byte == '\\'.u8():
            buffer.push('\\'.u8())
            buffer.push(byte)
        elif byte < 32:
            buffer.push('?'.u8())
        else:
            buffer.push(byte)
    buffer.push('"'.u8())

# The goal id the block claims, read from its own header. A block that does not name one cannot be
# checked against anything, which is itself a refusal rather than a pass.
def proof_rendered_goal_id(contents: darray[u8]&) -> (known: bool, goal_id: usize) can[Memory.Allocate, Abort.Panic]:
    marker: sview = "# goal "
    for start in 0..<contents.count |start, contents, marker|:
        continue if start > 0 and contents[start - 1] != '\n'.u8()
        matched: mutable bool = true
        for offset in 0..<sview_len(marker) |offset, start, contents, marker, matched|:
            matched <- false if start + offset >= contents.count or contents[start + offset] != sview_at(marker, offset)
        continue if not matched
        cursor: mutable usize = start + sview_len(marker)
        value: mutable usize = 0
        digits: mutable usize = 0
        while cursor < contents.count |cursor, contents, value, digits|:
            byte: u8 = contents[cursor]
            break if byte < '0'.u8() or byte > '9'.u8()
            break if digits >= 9
            value <- value * 10 + (byte - '0'.u8()).usize()
            digits <- digits + 1
            cursor <- cursor + 1
        return (true, value) if digits > 0
    return (false, 0)

# Returns the process exit code: 0 the block matches what the report supports, 1 it diverges,
# 2 it names no goal of this source and so cannot be checked at all.
# Translate a human-written proof script into the tactic interchange the checked engine already
# consumes. This is untrusted elaboration and nothing more: it produces a script, it never decides
# whether a goal holds, and the `proof`/`qed` words carry no weight here — only the tactic engine
# and the kernel decide that. A line it does not recognize refuses the whole script rather than
# being skipped, so a typo cannot quietly become a shorter proof than the author wrote.
#
# `given` and `show` lines are accepted and carry no effect: in a source-bound script the
# hypotheses and the conclusion come from the goal itself, and the engine reports the state it
# actually started from. Use `--check-proof` to confirm they say what the report supports.
def proof_script_is_space(byte: u8) -> bool:
    return byte == ' '.u8() or byte == '\t'.u8() or byte == '\r'.u8()

def proof_script_starts_with(contents: darray[u8]&, start: usize, end: usize, prefix: sview) -> bool:
    return false if end - start < sview_len(prefix)
    for offset in 0..<sview_len(prefix) |offset, contents, start, prefix|:
        return false if contents[start + offset] != sview_at(prefix, offset)
    return true

def proof_script_line_to_json(buffer: mutable darray[u8]&, contents: darray[u8]&, start: usize, end: usize, emitted: usize) -> (ok: bool, emitted: usize) can[Memory.Allocate, Abort.Panic]:
    cursor: mutable usize = start
    while cursor < end |cursor, contents|:
        break if not proof_script_is_space(contents[cursor])
        cursor <- cursor + 1
    stop: mutable usize = end
    while stop > cursor |stop, contents|:
        break if not proof_script_is_space(contents[stop - 1])
        stop <- stop - 1
    return (true, emitted) if cursor >= stop
    return (true, emitted) if contents[cursor] == '#'.u8()
    return (true, emitted) if proof_script_starts_with(contents, cursor, stop, "proof ")
    return (true, emitted) if proof_script_starts_with(contents, cursor, stop, "open ")
    return (true, emitted) if proof_script_starts_with(contents, cursor, stop, "unchecked ")
    return (true, emitted) if proof_script_starts_with(contents, cursor, stop, "given ")
    return (true, emitted) if proof_script_starts_with(contents, cursor, stop, "show ")
    return (true, emitted) if proof_script_starts_with(contents, cursor, stop, "unproved:")
    return (true, emitted) if stop - cursor == 3 and proof_script_starts_with(contents, cursor, stop, "qed")
    return (false, emitted) if not proof_script_starts_with(contents, cursor, stop, "by ")
    cursor <- cursor + 3
    while cursor < stop |cursor, contents|:
        break if not proof_script_is_space(contents[cursor])
        cursor <- cursor + 1
    name_start: usize = cursor
    while cursor < stop |cursor, contents|:
        byte: u8 = contents[cursor]
        break if byte < 'a'.u8() or byte > 'z'.u8()
        cursor <- cursor + 1
    return (false, emitted) if cursor == name_start
    name_end: usize = cursor
    while cursor < stop |cursor, contents|:
        break if not proof_script_is_space(contents[cursor])
        cursor <- cursor + 1
    argument_value: mutable usize = 0
    argument_digits: mutable usize = 0
    while cursor < stop |cursor, contents, argument_value, argument_digits|:
        byte: u8 = contents[cursor]
        break if byte < '0'.u8() or byte > '9'.u8()
        break if argument_digits >= 9
        argument_value <- argument_value * 10 + (byte - '0'.u8()).usize()
        argument_digits <- argument_digits + 1
        cursor <- cursor + 1
    # Anything after the action name and one optional index is not part of this grammar.
    return (false, emitted) if cursor != stop
    proof_push(buffer, ",") if emitted > 0
    proof_push(buffer, "{\"action\":")
    proof_push_json_byte_range(buffer, contents, name_start, name_end)
    if argument_digits > 0:
        proof_push(buffer, ",\"argument_index\":")
        proof_push_number(buffer, argument_value.u32())
    proof_push(buffer, "}")
    return (true, emitted + 1)

# The bounded, deterministic repair vocabulary. Every candidate is a fixed sequence of the
# argument-free actions the checked engine already implements, tried in this exact order, so a
# repair is reproducible and its search space is a stated constant rather than a heuristic budget.
# Nothing here decides anything: a candidate is only ever a *proposal*, admitted solely if the
# tactic engine accepts it and the kernel replays the certificate it produces.
def proof_repair_candidates() -> darray[sview] can[Memory.Allocate, Abort.Panic]:
    return ["assumption", "exact", "decide", "simp", "intro", "intro,assumption", "intro,exact", "intro,decide", "simp,assumption", "simp,exact", "simp,decide", "intro,simp", "intro,simp,assumption", "intro,simp,exact", "intro,simp,decide", "intro,intro,assumption", "intro,intro,exact", "intro,intro,decide", "decide,assumption", "simp,intro,exact"]

def proof_repair_push_actions(buffer: mutable darray[u8]&, actions: sview, as_json: bool) -> void can[Memory.Allocate, Abort.Panic]:
    start: mutable usize = 0
    emitted: mutable usize = 0
    while start <= sview_len(actions) |start, emitted, actions, buffer, as_json|:
        stop: mutable usize = start
        while stop < sview_len(actions) |stop, actions|:
            break if sview_at(actions, stop) == ','.u8()
            stop <- stop + 1
        if stop > start:
            if as_json:
                proof_push(buffer, ",") if emitted > 0
                proof_push(buffer, "{\"action\":\"")
                for offset in start..<stop |offset, buffer, actions|:
                    buffer.push(sview_at(actions, offset))
                proof_push(buffer, "\"}")
            else:
                proof_push(buffer, "    by ")
                for offset in start..<stop |offset, buffer, actions|:
                    buffer.push(sview_at(actions, offset))
                proof_push(buffer, "\n")
            emitted <- emitted + 1
        break if stop >= sview_len(actions)
        start <- stop + 1

def proof_repair_push_script_json(buffer: mutable darray[u8]&, goal_id: usize, actions: sview) -> void can[Memory.Allocate, Abort.Panic]:
    proof_push(buffer, "{\"format\":\"elisa-proof-tactics-v1\",\"target\":{\"goal_id\":")
    proof_push_number(buffer, goal_id.u32())
    proof_push(buffer, "},\"actions\":[")
    proof_repair_push_actions(buffer, actions, true)
    proof_push(buffer, "]}")

# The proposal in the same shape `--proof` renders and `--script` runs, so a repair can be read,
# edited and re-run without translation.
def proof_repair_push_script_text(buffer: mutable darray[u8]&, report: ProofReport&, goal_id: usize, actions: sview) -> void can[Memory.Allocate, Abort.Panic]:
    proof_push(buffer, "# goal ")
    proof_push_number(buffer, goal_id.u32())
    proof_push(buffer, "\nproof ")
    proof_push(buffer, report.goal_attempts[goal_id].name if goal_id < report.goal_attempts.count else "goal")
    proof_push(buffer, "_")
    proof_push_number(buffer, goal_id.u32())
    proof_push(buffer, ":\n")
    proof_repair_push_actions(buffer, actions, false)
    proof_push(buffer, "qed\n")

# One goal's bounded search, shared by the single-goal and whole-file repair modes. It reports only
# what was tried and which candidate the *checked engine* accepted; it never reaches a verdict of
# its own.
def proof_repair_search(report: ProofReport&, goal_id: usize) -> (repaired: bool, searched: usize, actions: sview) can[Memory.Allocate, Abort.Panic]:
    repair_state: mutable darray[u8] = []
    if goal_id < report.goal_attempts.count:
        repair_attempt: ProofGoalAttempt = report.goal_attempts[goal_id]
        if repair_attempt.facts_start <= report.certificate_facts.count and repair_attempt.facts_count <= report.certificate_facts.count - repair_attempt.facts_start:
            proof_push(&repair_state, "{\"facts\":[")
            for fact_index in 0..<repair_attempt.facts_count |fact_index, repair_attempt, report, repair_state|:
                proof_push(&repair_state, ",") if fact_index > 0
                proof_push_json_expr(&repair_state, report.certificate_facts[repair_attempt.facts_start + fact_index])
            proof_push(&repair_state, "],\"goal\":")
            proof_push_json_expr(&repair_state, repair_attempt.goal)
            proof_push(&repair_state, "}")
    candidates: darray[sview] = proof_repair_candidates()
    repaired: mutable bool = false
    searched: mutable usize = 0
    winning: mutable sview = ""
    region repair_region(1048576):
        repair_store: Ast::Node.Store[Local] = Ast::Node.Store(repair_region)
        in repair_store:
            if repair_state.count > 0:
                for candidate_index in 0..<candidates.count |candidate_index, candidates, repair_state, report, repaired, searched, winning, goal_id|:
                    break if repaired
                    candidate: sview = candidates[candidate_index]
                    script_text: mutable darray[u8] = []
                    proof_repair_push_script_json(&script_text, goal_id, candidate)
                    candidate_arena: mutable Arena = zeroed
                    parsed_candidate: JsonParseResult = json_parse_checked(&candidate_arena, sview(&script_text[0], 0, script_text.count.i64()))
                    continue if parsed_candidate.code != JsonErrorCode.OK
                    parsed_state: JsonParseResult = json_parse_checked(&candidate_arena, sview(&repair_state[0], 0, repair_state.count.i64()))
                    continue if parsed_state.code != JsonErrorCode.OK
                    candidate_empty: mutable darray[Ast::Expr] = []
                    candidate_state: mutable ProofTacticState = proof_tactic_state(&candidate_empty, Ast::Expr.Invalid)
                    candidate_scratch_empty: mutable darray[Ast::Expr] = []
                    candidate_scratch: mutable darray[ProofTacticState] = []
                    for scratch_index in 0..<64 |scratch_index, candidate_scratch_empty, candidate_scratch|:
                        candidate_scratch.push(proof_tactic_state(&candidate_scratch_empty, Ast::Expr.Invalid))
                    candidate_tree: mutable ProofTacticJsonTree = ProofTacticJsonTree{states: [], left: [], right: [], has_branch: []}
                    candidate_annotations: mutable darray[Ast::EnumAnnotation] = []
                    candidate_result: ProofTacticJsonResult = proof_tactic_json_run_source(parsed_candidate.value, parsed_state.value, &candidate_annotations, &candidate_state, &candidate_tree, &candidate_scratch, report, goal_id)
                    searched <- searched + 1
                    # Solved by the engine is not enough: the certificate it produced must also
                    # replay against the kernel, exactly as a hand-written script must.
                    if candidate_result.valid and candidate_result.solved and candidate_result.kernel_replayed and candidate_result.certificate_replayed:
                        repaired <- true
                        winning <- candidate
    return (repaired, searched, winning)

# One goal's entry in a whole-file repair report: what it is, whether a proposal survived the
# kernel, and the runnable script when one did.
def proof_push_repair_goal(buffer: mutable darray[u8]&, report: ProofReport&, goal_id: usize, found: (repaired: bool, searched: usize, actions: sview)) -> void can[Memory.Allocate, Abort.Panic]:
    proof_push(buffer, "{\"goal_id\":")
    proof_push_number(buffer, goal_id.u32())
    proof_push(buffer, ",\"name\":")
    proof_push_json_string(buffer, report.goal_attempts[goal_id].name)
    proof_push(buffer, ",\"rule\":")
    proof_push_json_string(buffer, report.goal_attempts[goal_id].rule)
    proof_push(buffer, ",\"line\":")
    proof_push_number(buffer, report.goal_attempts[goal_id].line)
    proof_push(buffer, ",\"status\":")
    proof_push(buffer, "\"repaired\"" if found.repaired else "\"unrepaired\"")
    proof_push(buffer, ",\"tried\":")
    proof_push_number(buffer, found.searched.u32())
    proof_push(buffer, ",\"script\":")
    if found.repaired:
        script_body: mutable darray[u8] = []
        proof_repair_push_script_text(&script_body, report, goal_id, found.actions)
        proof_push_json_bytes(buffer, script_body)
    else:
        proof_push(buffer, "null")
    proof_push(buffer, "}")

def proof_tactic_text_to_json(contents: darray[u8]&) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
    empty: mutable darray[u8] = []
    claimed: (known: bool, goal_id: usize) = proof_rendered_goal_id(contents)
    return empty if not claimed.known
    actions: mutable darray[u8] = []
    emitted: mutable usize = 0
    cursor: mutable usize = 0
    while cursor < contents.count |cursor, contents, actions, emitted|:
        line: (end: usize, next: usize) = proof_rendered_line(contents, cursor)
        translated: (ok: bool, emitted: usize) = proof_script_line_to_json(&actions, contents, cursor, line.end, emitted)
        return empty if not translated.ok
        emitted <- translated.emitted
        cursor <- line.next
    return empty if emitted == 0
    script: mutable darray[u8] = []
    proof_push(&script, "{\"format\":\"elisa-proof-tactics-v1\",\"target\":{\"goal_id\":")
    proof_push_number(&script, claimed.goal_id.u32())
    proof_push(&script, "},\"actions\":[")
    for index in 0..<actions.count |index, script, actions|:
        script.push(actions[index])
    proof_push(&script, "]}")
    return script

def proof_push_proof_check(buffer: mutable darray[u8]&, report: ProofReport&, contents: darray[u8]&, source_fingerprint: u32, source_complete: bool, source_admissible: bool) -> i64 can[Memory.Allocate, Abort.Panic]:
    claimed: (known: bool, goal_id: usize) = proof_rendered_goal_id(contents)
    if not claimed.known:
        proof_push(buffer, "{\"format\":\"elisa-proof-proof-check-v1\",\"status\":\"unreadable\",\"goal_id\":null,\"differences\":[]}\n")
        return 2
    if claimed.goal_id >= report.goal_attempts.count:
        proof_push(buffer, "{\"format\":\"elisa-proof-proof-check-v1\",\"status\":\"not_found\",\"goal_id\":")
        proof_push_number(buffer, claimed.goal_id.u32())
        proof_push(buffer, ",\"differences\":[]}\n")
        return 2
    canonical: mutable darray[u8] = []
    proof_push_elisa_proof(&canonical, report, claimed.goal_id, source_fingerprint, source_complete, source_admissible)
    differences: mutable darray[u8] = []
    difference_count: mutable usize = 0
    file_cursor: mutable usize = 0
    canonical_cursor: mutable usize = 0
    line_number: mutable usize = 0
    while file_cursor < contents.count or canonical_cursor < canonical.count |file_cursor, canonical_cursor, line_number, contents, canonical, differences, difference_count|:
        line_number <- line_number + 1
        file_line: (end: usize, next: usize) = proof_rendered_line(contents, file_cursor)
        canonical_line: (end: usize, next: usize) = proof_rendered_line(canonical, canonical_cursor)
        file_present: bool = file_cursor < contents.count
        canonical_present: bool = canonical_cursor < canonical.count
        equal: bool = file_present and canonical_present and proof_rendered_lines_equal(contents, file_cursor, file_line.end, canonical, canonical_cursor, canonical_line.end)
        if not equal and difference_count < 32:
            proof_push(&differences, ",") if difference_count > 0
            proof_push(&differences, "{\"line\":")
            proof_push_number(&differences, line_number.u32())
            proof_push(&differences, ",\"expected\":")
            if canonical_present:
                proof_push_json_byte_range(&differences, canonical, canonical_cursor, canonical_line.end)
            else:
                proof_push(&differences, "null")
            proof_push(&differences, ",\"found\":")
            if file_present:
                proof_push_json_byte_range(&differences, contents, file_cursor, file_line.end)
            else:
                proof_push(&differences, "null")
            proof_push(&differences, "}")
        difference_count <- difference_count + 1 if not equal
        file_cursor <- file_line.next if file_present else file_cursor + 1
        canonical_cursor <- canonical_line.next if canonical_present else canonical_cursor + 1
    proof_push(buffer, "{\"format\":\"elisa-proof-proof-check-v1\",\"status\":")
    proof_push(buffer, "\"matches\"" if difference_count == 0 else "\"diverges\"")
    proof_push(buffer, ",\"goal_id\":")
    proof_push_number(buffer, claimed.goal_id.u32())
    proof_push(buffer, ",\"difference_count\":")
    proof_push_number(buffer, difference_count.u32())
    proof_push(buffer, ",\"differences\":[")
    for index in 0..<differences.count |index, buffer, differences|:
        buffer.push(differences[index])
    proof_push(buffer, "]}\n")
    return 0 if difference_count == 0 else 1

def proof_push_elisa_proof(buffer: mutable darray[u8]&, report: ProofReport&, goal_id: usize, source_fingerprint: u32, source_complete: bool, source_admissible: bool) -> void can[Memory.Allocate, Abort.Panic]:
    proof_push(buffer, "# elisa-proof-proof-v1\n")
    if goal_id >= report.goal_attempts.count:
        proof_push(buffer, "# goal ")
        proof_push_number(buffer, goal_id.u32())
        proof_push(buffer, " does not exist in this source\n")
        return
    attempt: ProofGoalAttempt = report.goal_attempts[goal_id]
    certificate_replayed: bool = attempt.has_certificate and attempt.certificate_index < report.certificates.count and report.certificates[attempt.certificate_index].replayed
    proof_push(buffer, "# source: fingerprint fnv1a32=")
    proof_push_number(buffer, source_fingerprint)
    proof_push(buffer, ", complete=")
    proof_push(buffer, "true" if source_complete else "false")
    proof_push(buffer, ", admissible=")
    proof_push(buffer, "true" if source_admissible else "false")
    proof_push(buffer, "\n# goal ")
    proof_push_number(buffer, goal_id.u32())
    proof_push(buffer, " of ")
    proof_push_number(buffer, report.goal_attempts.count.u32())
    proof_push(buffer, ", rule ")
    proof_push(buffer, attempt.rule)
    proof_push(buffer, ", in ")
    proof_push(buffer, attempt.name)
    proof_push(buffer, " at line ")
    proof_push_number(buffer, attempt.line)
    proof_push(buffer, "\n")
    keyword: mutable sview = "open"
    keyword <- "unchecked" if attempt.proven
    keyword <- "proof" if attempt.proven and certificate_replayed
    if attempt.proven and not certificate_replayed:
        proof_push(buffer, "# no certificate replayed for this goal: the block below is not kernel-backed\n")
    proof_push(buffer, keyword)
    proof_push(buffer, " ")
    proof_push(buffer, attempt.name)
    proof_push(buffer, "_")
    proof_push_number(buffer, goal_id.u32())
    proof_push(buffer, ":\n")
    for fact_index in 0..<attempt.facts_count |fact_index, attempt, report, buffer|:
        fact: Ast::Expr = report.certificate_facts[attempt.facts_start + fact_index]
        proof_push(buffer, "    given ")
        proof_push_elisa_expr(buffer, fact, false, 0)
        origin: (known: bool, kind: sview, line: u32, name: sview, dependency: sview, premises_count: usize) = proof_replay_fact_origin_at(report, attempt.facts_start + fact_index, attempt.name)
        if origin.known:
            proof_push(buffer, "    # ")
            proof_push(buffer, origin.kind)
            proof_push(buffer, ", line ")
            proof_push_number(buffer, origin.line)
            if origin.dependency != "":
                proof_push(buffer, ", via ")
                proof_push(buffer, origin.dependency)
        proof_push(buffer, "\n")
    proof_push(buffer, "    show ")
    proof_push_elisa_expr(buffer, attempt.goal, false, 0)
    proof_push(buffer, "\n")
    if attempt.proven and certificate_replayed:
        proof_push(buffer, "    by kernel certificate ")
        proof_push_number(buffer, attempt.certificate_index.u32())
        proof_push(buffer, ", arena root ")
        proof_push_number(buffer, attempt.kernel_goal.u32())
        proof_push(buffer, "\nqed\n")
        return
    if attempt.proven:
        proof_push(buffer, "    by producer only\n")
        return
    selected: (known: bool, index: usize, ambiguous: bool) = proof_repair_finding_index(report, attempt, goal_id)
    proof_push(buffer, "    unproved: ")
    if selected.known:
        proof_push(buffer, report.findings[selected.index].kind)
        proof_push(buffer, " (")
        proof_push(buffer, report.findings[selected.index].status)
        proof_push(buffer, ") - ")
        proof_push(buffer, report.findings[selected.index].message)
    else:
        proof_push(buffer, "unknown")
    proof_push(buffer, "\n")

def proof_push_json_focused_goal(buffer: mutable darray[u8]&, report: ProofReport&, goal_id: usize, source_bytes: usize, source_fingerprint: u32, source_complete: bool, source_admissible: bool) -> void can[Memory.Allocate, Abort.Panic]:
    found: bool = goal_id < report.goal_attempts.count
    proof_push(buffer, "{\"format\":\"elisa-proof-goal-v1\",\"status\":")
    if not found:
        proof_push_json_string(buffer, "not_found")
    else:
        attempt: ProofGoalAttempt = report.goal_attempts[goal_id]
        certificate_replayed: bool = attempt.has_certificate and attempt.certificate_index < report.certificates.count and report.certificates[attempt.certificate_index].replayed
        attempt_status: mutable sview = "proved" if attempt.proven and certificate_replayed else "unknown"
        if not attempt.proven:
            selected: (known: bool, index: usize, ambiguous: bool) = proof_repair_finding_index(report, attempt, goal_id)
            attempt_status <- report.findings[selected.index].status if selected.known else "unknown"
        proof_push_json_string(buffer, attempt_status)
    proof_push(buffer, ",\"source\":{\"bytes\":")
    proof_push_number(buffer, source_bytes.u32())
    proof_push(buffer, ",\"fingerprint\":{\"algorithm\":\"fnv1a32\",\"value\":")
    proof_push_number(buffer, source_fingerprint)
    proof_push(buffer, "},\"complete\":")
    proof_push(buffer, "true" if source_complete else "false")
    proof_push(buffer, ",\"admissible\":")
    proof_push(buffer, "true" if source_admissible else "false")
    proof_push(buffer, "},\"goal_id\":")
    proof_push_number(buffer, goal_id.u32())
    proof_push(buffer, ",\"goal_fingerprint\":")
    if found:
        fingerprint: (valid: bool, value: u32) = proof_goal_fingerprint(report, report.goal_attempts[goal_id])
        if fingerprint.valid:
            proof_push(buffer, "{\"algorithm\":\"fnv1a32-kernel-goal-v1\",\"value\":")
            proof_push_number(buffer, fingerprint.value)
            proof_push(buffer, "}")
        else:
            proof_push(buffer, "null")
    else:
        proof_push(buffer, "null")
    proof_push(buffer, ",\"goal\":")
    if not found:
        proof_push(buffer, "null,\"failure\":null}\n")
        return
    attempt: ProofGoalAttempt = report.goal_attempts[goal_id]
    replay_status: mutable sview = "not_certified"
    if attempt.has_certificate and attempt.certificate_index < report.certificates.count:
        replay_status <- "replayed" if report.certificates[attempt.certificate_index].replayed else "gap"
    proof_push(buffer, "{\"line\":")
    proof_push_number(buffer, attempt.line)
    proof_push(buffer, ",\"name\":")
    proof_push_json_string(buffer, attempt.name)
    proof_push(buffer, ",\"rule\":")
    proof_push_json_string(buffer, attempt.rule)
    proof_push(buffer, ",\"proven\":")
    proof_push(buffer, "true" if attempt.proven else "false")
    proof_push(buffer, ",\"replay_status\":")
    proof_push_json_string(buffer, replay_status)
    proof_push(buffer, ",\"certificate_id\":")
    if attempt.has_certificate and attempt.certificate_index < report.certificates.count:
        proof_push_number(buffer, attempt.certificate_index.u32())
    else:
        proof_push(buffer, "null")
    proof_push(buffer, ",\"kernel_goal\":")
    proof_push_number(buffer, attempt.kernel_goal.u32())
    proof_push(buffer, ",\"facts\":[")
    for fact_index in 0..<attempt.facts_count |fact_index, attempt, report, buffer|:
        proof_push(buffer, ",") if fact_index > 0
        proof_push_json_expr(buffer, report.certificate_facts[attempt.facts_start + fact_index])
    proof_push(buffer, "],\"fact_origins\":[")
    for fact_index in 0..<attempt.facts_count |fact_index, attempt, report, buffer|:
        proof_push(buffer, ",") if fact_index > 0
        proof_push_json_fact_origin(buffer, report, attempt.facts_start + fact_index, attempt.name)
    proof_push(buffer, "],\"dependencies\":[")
    proof_push_json_goal_dependencies(buffer, report, attempt.facts_start, attempt.facts_count, attempt.name)
    proof_push(buffer, "],\"proposition\":")
    proof_push_json_expr(buffer, attempt.goal)
    proof_push(buffer, "},\"failure\":")
    if attempt.proven:
        proof_push(buffer, "null")
    else:
        proof_push_json_repair_failure(buffer, report, attempt, goal_id)
    proof_push(buffer, "}\n")

def proof_push_json_declaration(buffer: mutable darray[u8]&, report: ProofReport&, declaration: ProofDeclarationSummary) -> void can[Memory.Allocate, Abort.Panic]:
    proof_push(buffer, "{\"kind\":")
    proof_push_json_string(buffer, declaration.kind)
    proof_push(buffer, ",\"name\":")
    proof_push_json_string(buffer, declaration.name)
    proof_push(buffer, ",\"line\":")
    proof_push_number(buffer, declaration.line)
    proof_push(buffer, ",\"parameters\":[")
    valid_parameter_range: bool = declaration.parameters_start <= report.declaration_parameters.count and declaration.parameters_count <= report.declaration_parameters.count - declaration.parameters_start
    if valid_parameter_range:
        for index in 0..<declaration.parameters_count |index, declaration, report, buffer|:
            proof_push(buffer, ",") if index > 0
            proof_push_json_string(buffer, report.declaration_parameters[declaration.parameters_start + index])
    proof_push(buffer, "],\"effects\":")
    if declaration.effects_declared:
        proof_push(buffer, "[")
        valid_effect_range: bool = declaration.effects_start <= report.declaration_effects.count and declaration.effects_count <= report.declaration_effects.count - declaration.effects_start
        if valid_effect_range:
            for index in 0..<declaration.effects_count |index, declaration, report, buffer|:
                proof_push(buffer, ",") if index > 0
                proof_push_json_string(buffer, report.declaration_effects[declaration.effects_start + index])
        proof_push(buffer, "]")
    else:
        proof_push(buffer, "null")
    proof_push(buffer, ",\"requires\":")
    proof_push_number(buffer, declaration.requires_count.u32())
    proof_push(buffer, ",\"ensures\":")
    proof_push_number(buffer, declaration.ensures_count.u32())
    proof_push(buffer, ",\"changes\":")
    proof_push_number(buffer, declaration.changes_count.u32())
    proof_push(buffer, ",\"preserves\":")
    proof_push_number(buffer, declaration.preserves_count.u32())
    proof_push(buffer, ",\"decreases\":")
    proof_push_number(buffer, declaration.decreases_count.u32())
    proof_push(buffer, ",\"lemma\":")
    proof_push(buffer, "true" if declaration.lemma else "false")
    proof_push(buffer, ",\"recursive\":")
    proof_push(buffer, "true" if declaration.recursive else "false")
    proof_push(buffer, ",\"pure\":")
    proof_push(buffer, "true" if declaration.pure else "false")
    proof_push(buffer, ",\"verified\":")
    proof_push(buffer, "true" if declaration.verified else "false")
    proof_push(buffer, ",\"verification_reason\":")
    proof_push_json_string(buffer, declaration.verification_reason)
    proof_push(buffer, ",\"structural\":")
    proof_push(buffer, "true" if declaration.structural else "false")
    proof_push(buffer, "}")

def proof_push_json_theorem(buffer: mutable darray[u8]&, report: ProofReport&, theorem: ProofTheoremSummary) -> void can[Memory.Allocate, Abort.Panic]:
    valid_parameters: bool = theorem.parameters_start <= report.theorem_parameters.count and theorem.parameters_count <= report.theorem_parameters.count - theorem.parameters_start and theorem.parameters_start <= report.theorem_parameter_types.count and theorem.parameters_count <= report.theorem_parameter_types.count - theorem.parameters_start and theorem.parameters_start <= report.theorem_parameter_has_defaults.count and theorem.parameters_count <= report.theorem_parameter_has_defaults.count - theorem.parameters_start and theorem.parameters_start <= report.theorem_parameter_defaults.count and theorem.parameters_count <= report.theorem_parameter_defaults.count - theorem.parameters_start
    valid_requires: bool = theorem.requires_start <= report.theorem_requires.count and theorem.requires_count <= report.theorem_requires.count - theorem.requires_start
    valid_ensures: bool = theorem.ensures_start <= report.theorem_ensures.count and theorem.ensures_count <= report.theorem_ensures.count - theorem.ensures_start
    valid_decreases: bool = theorem.decreases_start <= report.theorem_decreases.count and theorem.decreases_count <= report.theorem_decreases.count - theorem.decreases_start
    valid_proof_goals: bool = theorem.proof_goals_start <= report.theorem_proof_goal_ids.count and theorem.proof_goals_count <= report.theorem_proof_goal_ids.count - theorem.proof_goals_start
    signature_valid: bool = valid_parameters and valid_requires and valid_ensures and valid_decreases
    proof_replay_complete: mutable bool = theorem.verified and valid_proof_goals and theorem.proof_goals_count > 0
    if valid_proof_goals:
        for index in 0..<theorem.proof_goals_count |index, theorem, report, proof_replay_complete|:
            goal_id: usize = report.theorem_proof_goal_ids[theorem.proof_goals_start + index]
            if goal_id >= report.goal_attempts.count:
                proof_replay_complete <- false
            else:
                attempt: ProofGoalAttempt = report.goal_attempts[goal_id]
                proof_replay_complete <- false if not attempt.proven or not attempt.has_certificate or attempt.certificate_index >= report.certificates.count or not report.certificates[attempt.certificate_index].replayed
    proof_push(buffer, "{\"name\":")
    proof_push_json_string(buffer, theorem.name)
    proof_push(buffer, ",\"theorem_fingerprint\":")
    theorem_fingerprint: (valid: bool, value: u32) = proof_theorem_fingerprint(report, theorem)
    if theorem_fingerprint.valid:
        proof_push(buffer, "{\"algorithm\":\"fnv1a32-kernel-theorem-v1\",\"value\":")
        proof_push_number(buffer, theorem_fingerprint.value)
        proof_push(buffer, "}")
    else:
        proof_push(buffer, "null")
    proof_push(buffer, ",\"line\":")
    proof_push_number(buffer, theorem.line)
    proof_push(buffer, ",\"verified\":")
    proof_push(buffer, "true" if theorem.verified else "false")
    proof_push(buffer, ",\"verification_reason\":")
    proof_push_json_string(buffer, theorem.verification_reason)
    proof_push(buffer, ",\"recursive\":")
    proof_push(buffer, "true" if theorem.recursive else "false")
    proof_push(buffer, ",\"signature_valid\":")
    proof_push(buffer, "true" if signature_valid else "false")
    proof_push(buffer, ",\"proof_replay_complete\":")
    proof_push(buffer, "true" if proof_replay_complete else "false")
    proof_push(buffer, ",\"proof_goals_valid\":")
    proof_push(buffer, "true" if valid_proof_goals else "false")
    proof_push(buffer, ",\"parameters\":[")
    if valid_parameters:
        for index in 0..<theorem.parameters_count |index, theorem, report, buffer|:
            proof_push(buffer, ",") if index > 0
            proof_push_json_string(buffer, report.theorem_parameters[theorem.parameters_start + index])
    proof_push(buffer, "],\"parameter_defaults\":[")
    if valid_parameters:
        for index in 0..<theorem.parameters_count |index, theorem, report, buffer|:
            proof_push(buffer, ",") if index > 0
            parameter_index: usize = theorem.parameters_start + index
            if report.theorem_parameter_has_defaults[parameter_index]:
                proof_push_json_expr(buffer, report.theorem_parameter_defaults[parameter_index])
            else:
                proof_push(buffer, "null")
    proof_push(buffer, "],\"parameter_types\":[")
    if valid_parameters:
        for index in 0..<theorem.parameters_count |index, theorem, report, buffer|:
            proof_push(buffer, ",") if index > 0
            proof_push_json_expr(buffer, report.theorem_parameter_types[theorem.parameters_start + index])
    proof_push(buffer, "],\"requires\":[")
    if valid_requires:
        for index in 0..<theorem.requires_count |index, theorem, report, buffer|:
            proof_push(buffer, ",") if index > 0
            proof_push_json_expr(buffer, report.theorem_requires[theorem.requires_start + index])
    proof_push(buffer, "],\"ensures\":[")
    if valid_ensures:
        for index in 0..<theorem.ensures_count |index, theorem, report, buffer|:
            proof_push(buffer, ",") if index > 0
            proof_push_json_expr(buffer, report.theorem_ensures[theorem.ensures_start + index])
    proof_push(buffer, "],\"decreases\":[")
    if valid_decreases:
        for index in 0..<theorem.decreases_count |index, theorem, report, buffer|:
            proof_push(buffer, ",") if index > 0
            proof_push_json_expr(buffer, report.theorem_decreases[theorem.decreases_start + index])
    proof_push(buffer, "],\"proof_goals\":[")
    if valid_proof_goals:
        for index in 0..<theorem.proof_goals_count |index, theorem, report, buffer|:
            proof_push(buffer, ",") if index > 0
            goal_id: usize = report.theorem_proof_goal_ids[theorem.proof_goals_start + index]
            proof_push(buffer, "{\"goal_id\":")
            proof_push_number(buffer, goal_id.u32())
            if goal_id < report.goal_attempts.count:
                attempt: ProofGoalAttempt = report.goal_attempts[goal_id]
                proof_push(buffer, ",\"rule\":")
                proof_push_json_string(buffer, attempt.rule)
                proof_push(buffer, ",\"proven\":")
                proof_push(buffer, "true" if attempt.proven else "false")
                proof_push(buffer, ",\"certificate_id\":")
                proof_push_number(buffer, attempt.certificate_index.u32()) if attempt.has_certificate and attempt.certificate_index < report.certificates.count else proof_push(buffer, "null")
                proof_push(buffer, ",\"replayed\":")
                proof_push(buffer, "true" if attempt.has_certificate and attempt.certificate_index < report.certificates.count and report.certificates[attempt.certificate_index].replayed else "false")
            proof_push(buffer, "}")
    proof_push(buffer, "]}")

def proof_push_json_theorem_catalog(buffer: mutable darray[u8]&, report: ProofReport&, source_bytes: usize, source_fingerprint: u32, source_complete: bool, source_admissible: bool) -> void can[Memory.Allocate, Abort.Panic]:
    proof_push(buffer, "{\"format\":\"elisa-proof-theorems-v1\",\"source\":{\"bytes\":")
    proof_push_number(buffer, source_bytes.u32())
    proof_push(buffer, ",\"fingerprint\":{\"algorithm\":\"fnv1a32\",\"value\":")
    proof_push_number(buffer, source_fingerprint)
    proof_push(buffer, "},\"complete\":")
    proof_push(buffer, "true" if source_complete else "false")
    proof_push(buffer, ",\"admissible\":")
    proof_push(buffer, "true" if source_admissible else "false")
    proof_push(buffer, "},\"theorems\":[")
    for index in 0..<report.theorem_summaries.count |index, report, buffer|:
        proof_push(buffer, ",") if index > 0
        proof_push_json_theorem(buffer, report, report.theorem_summaries[index])
    proof_push(buffer, "]}\n")

# First-order conclusion matching for theorem discovery. Only declared theorem parameters are
# metavariables; every other identifier remains rigid. This is deliberately an advisory search
# operation, not a kernel rule, and therefore favors a small auditable matching language.
def proof_suggestion_parameter_index(report: ProofReport&, theorem: ProofTheoremSummary, name: sview) -> usize:
    for index in 0..<theorem.parameters_count |index, theorem, report, name|:
        return index if report.theorem_parameters[theorem.parameters_start + index] == name
    return theorem.parameters_count

def proof_suggestion_match(pattern: Ast::Expr, target: Ast::Expr, report: ProofReport&, theorem: ProofTheoremSummary, bound: mutable darray[bool]&, values: mutable darray[Ast::Expr]&, depth: usize) -> bool can[Memory.Allocate, Abort.Panic]:
    requires depth <= 128
    decreases 128 - depth
    return false if depth >= 128
    match pattern:
        Ast::Expr.Paren(inner, _):
            return proof_suggestion_match(inner, target, report, theorem, bound, values, depth + 1)
        Ast::Expr.Ident(name, _):
            parameter_index: usize = proof_suggestion_parameter_index(report, theorem, name)
            if parameter_index < theorem.parameters_count:
                return false if parameter_index >= bound.count or parameter_index >= values.count
                if bound[parameter_index]:
                    return proof_expr_equal(values[parameter_index], target)
                bound[parameter_index] <- true
                values[parameter_index] <- target
                return true
        _:
            pass
    match target:
        Ast::Expr.Paren(inner, _):
            return proof_suggestion_match(pattern, inner, report, theorem, bound, values, depth + 1)
        _:
            pass
    match pattern:
        Ast::Expr.Unary(operator, operand, _):
            match target:
                Ast::Expr.Unary(other_operator, other_operand, _):
                    return operator == other_operator and proof_suggestion_match(operand, other_operand, report, theorem, bound, values, depth + 1)
                _:
                    return false
        Ast::Expr.Binary(left, operator, right, _):
            match target:
                Ast::Expr.Binary(other_left, other_operator, other_right, _):
                    return operator == other_operator and proof_suggestion_match(left, other_left, report, theorem, bound, values, depth + 1) and proof_suggestion_match(right, other_right, report, theorem, bound, values, depth + 1)
                _:
                    return false
        Ast::Expr.Field(object, field, _):
            match target:
                Ast::Expr.Field(other_object, other_field, _):
                    return field == other_field and proof_suggestion_match(object, other_object, report, theorem, bound, values, depth + 1)
                _:
                    return false
        Ast::Expr.Scope(base, name, _):
            match target:
                Ast::Expr.Scope(other_base, other_name, _):
                    return name == other_name and proof_suggestion_match(base, other_base, report, theorem, bound, values, depth + 1)
                _:
                    return false
        Ast::Expr.Index(object, index, _):
            match target:
                Ast::Expr.Index(other_object, other_index, _):
                    return proof_suggestion_match(object, other_object, report, theorem, bound, values, depth + 1) and proof_suggestion_match(index, other_index, report, theorem, bound, values, depth + 1)
                _:
                    return false
        Ast::Expr.Slice(object, low, high, _):
            match target:
                Ast::Expr.Slice(other_object, other_low, other_high, _):
                    return proof_suggestion_match(object, other_object, report, theorem, bound, values, depth + 1) and proof_suggestion_match(low, other_low, report, theorem, bound, values, depth + 1) and proof_suggestion_match(high, other_high, report, theorem, bound, values, depth + 1)
                _:
                    return false
        Ast::Expr.Call(callee, arguments, argument_names, _):
            match target:
                Ast::Expr.Call(other_callee, other_arguments, other_argument_names, _):
                    return false if arguments.count != other_arguments.count or not proof_sview_array_equal(argument_names, other_argument_names)
                    return false if not proof_suggestion_match(callee, other_callee, report, theorem, bound, values, depth + 1)
                    for index in 0..<arguments.count |index, arguments, other_arguments, report, theorem, bound, values, depth|:
                        return false if not proof_suggestion_match(arguments[index], other_arguments[index], report, theorem, bound, values, depth + 1)
                    return true
                _:
                    return false
        Ast::Expr.IndexN(object, arguments, _):
            match target:
                Ast::Expr.IndexN(other_object, other_arguments, _):
                    return false if arguments.count != other_arguments.count
                    return false if not proof_suggestion_match(object, other_object, report, theorem, bound, values, depth + 1)
                    for index in 0..<arguments.count |index, arguments, other_arguments, report, theorem, bound, values, depth|:
                        return false if not proof_suggestion_match(arguments[index], other_arguments[index], report, theorem, bound, values, depth + 1)
                    return true
                _:
                    return false
        Ast::Expr.Array(elements, _):
            match target:
                Ast::Expr.Array(other_elements, _):
                    return false if elements.count != other_elements.count
                    for index in 0..<elements.count |index, elements, other_elements, report, theorem, bound, values, depth|:
                        return false if not proof_suggestion_match(elements[index], other_elements[index], report, theorem, bound, values, depth + 1)
                    return true
                _:
                    return false
        Ast::Expr.Tuple(elements, _):
            match target:
                Ast::Expr.Tuple(other_elements, _):
                    return false if elements.count != other_elements.count
                    for index in 0..<elements.count |index, elements, other_elements, report, theorem, bound, values, depth|:
                        return false if not proof_suggestion_match(elements[index], other_elements[index], report, theorem, bound, values, depth + 1)
                    return true
                _:
                    return false
        Ast::Expr.SetLit(elements, _):
            match target:
                Ast::Expr.SetLit(other_elements, _):
                    return false if elements.count != other_elements.count
                    for index in 0..<elements.count |index, elements, other_elements, report, theorem, bound, values, depth|:
                        return false if not proof_suggestion_match(elements[index], other_elements[index], report, theorem, bound, values, depth + 1)
                    return true
                _:
                    return false
        Ast::Expr.If(condition, then_expression, else_expression, _):
            match target:
                Ast::Expr.If(other_condition, other_then, other_else, _):
                    return proof_suggestion_match(condition, other_condition, report, theorem, bound, values, depth + 1) and proof_suggestion_match(then_expression, other_then, report, theorem, bound, values, depth + 1) and proof_suggestion_match(else_expression, other_else, report, theorem, bound, values, depth + 1)
                _:
                    return false
        _:
            return proof_expr_equal(pattern, target)

def proof_push_json_suggestions(buffer: mutable darray[u8]&, report: ProofReport&, annotations: darray[Ast::EnumAnnotation]&, goal_id: usize, source_bytes: usize, source_fingerprint: u32, source_complete: bool, source_admissible: bool) -> void can[Memory.Allocate, Abort.Panic]:
    proof_push(buffer, "{\"format\":\"elisa-proof-suggestions-v1\",\"status\":")
    proof_push_json_string(buffer, "ok" if goal_id < report.goal_attempts.count else "not_found")
    proof_push(buffer, ",\"source\":{\"bytes\":")
    proof_push_number(buffer, source_bytes.u32())
    proof_push(buffer, ",\"fingerprint\":{\"algorithm\":\"fnv1a32\",\"value\":")
    proof_push_number(buffer, source_fingerprint)
    proof_push(buffer, "},\"complete\":")
    proof_push(buffer, "true" if source_complete else "false")
    proof_push(buffer, ",\"admissible\":")
    proof_push(buffer, "true" if source_admissible else "false")
    proof_push(buffer, "},\"goal_id\":")
    proof_push_number(buffer, goal_id.u32())
    proof_push(buffer, ",\"goal_fingerprint\":")
    if goal_id < report.goal_attempts.count:
        fingerprint: (valid: bool, value: u32) = proof_goal_fingerprint(report, report.goal_attempts[goal_id])
        if fingerprint.valid:
            proof_push(buffer, "{\"algorithm\":\"fnv1a32-kernel-goal-v1\",\"value\":")
            proof_push_number(buffer, fingerprint.value)
            proof_push(buffer, "}")
        else:
            proof_push(buffer, "null")
    else:
        proof_push(buffer, "null")
    proof_push(buffer, ",\"candidates\":[")
    emitted: mutable usize = 0
    if goal_id < report.goal_attempts.count:
        attempt: ProofGoalAttempt = report.goal_attempts[goal_id]
        valid_facts: bool = attempt.facts_start <= report.certificate_facts.count and attempt.facts_count <= report.certificate_facts.count - attempt.facts_start
        for theorem in report.theorem_summaries |report, annotations, attempt, valid_facts, buffer, emitted|:
            valid_parameters: bool = theorem.parameters_start <= report.theorem_parameters.count and theorem.parameters_count <= report.theorem_parameters.count - theorem.parameters_start and theorem.parameters_start <= report.theorem_parameter_types.count and theorem.parameters_count <= report.theorem_parameter_types.count - theorem.parameters_start and theorem.parameters_start <= report.theorem_parameter_has_defaults.count and theorem.parameters_count <= report.theorem_parameter_has_defaults.count - theorem.parameters_start and theorem.parameters_start <= report.theorem_parameter_defaults.count and theorem.parameters_count <= report.theorem_parameter_defaults.count - theorem.parameters_start
            valid_requires: bool = theorem.requires_start <= report.theorem_requires.count and theorem.requires_count <= report.theorem_requires.count - theorem.requires_start
            valid_ensures: bool = theorem.ensures_start <= report.theorem_ensures.count and theorem.ensures_count <= report.theorem_ensures.count - theorem.ensures_start
            if theorem.verified and valid_parameters and valid_requires and valid_ensures and valid_facts:
                for ensure_index in 0..<theorem.ensures_count |ensure_index, theorem, report, annotations, attempt, buffer, emitted|:
                    bound: mutable darray[bool] = []
                    values: mutable darray[Ast::Expr] = []
                    names: mutable darray[sview] = []
                    for parameter_index in 0..<theorem.parameters_count |parameter_index, theorem, report, bound, values, names|:
                        bound.push(false)
                        values.push(Ast::Expr.Absent)
                        names.push(report.theorem_parameters[theorem.parameters_start + parameter_index])
                    conclusion: Ast::Expr = report.theorem_ensures[theorem.ensures_start + ensure_index]
                    matched: bool = proof_suggestion_match(conclusion, attempt.goal, report, theorem, &bound, &values, 0)
                    all_bound: mutable bool = matched
                    for parameter_index in 0..<theorem.parameters_count |parameter_index, theorem, report, bound, values, names, all_bound|:
                        if not bound[parameter_index] and report.theorem_parameter_has_defaults[theorem.parameters_start + parameter_index]:
                            # Keep discovery identical to checked lemma-call argument mapping:
                            # executable defaults and unresolved formal dependencies are not
                            # theorem arguments. A suggestion must never promise an application
                            # that the verifier itself will conservatively decline.
                            default_expression: Ast::Expr = report.theorem_parameter_defaults[theorem.parameters_start + parameter_index]
                            default_safe: mutable bool = not proof_expr_has_call(default_expression) and not proof_expr_has_old(default_expression)
                            if parameter_index + 1 < theorem.parameters_count:
                                for later_index in parameter_index + 1..<theorem.parameters_count |later_index, theorem, report, default_expression, default_safe|:
                                    default_safe <- false if proof_expr_mentions_name(default_expression, report.theorem_parameters[theorem.parameters_start + later_index])
                            if default_safe:
                                resolved_default: Ast::Expr = proof_substitute(default_expression, names, values)
                                default_safe <- false if proof_expr_has_call(resolved_default) or proof_expr_has_old(resolved_default)
                                for formal_name in names |formal_name, resolved_default, default_safe|:
                                    default_safe <- false if proof_expr_mentions_name(resolved_default, formal_name)
                                if default_safe:
                                    values[parameter_index] <- resolved_default
                                    bound[parameter_index] <- true
                        all_bound <- false if not bound[parameter_index]
                    if matched and all_bound:
                        proof_push(buffer, ",") if emitted > 0
                        emitted <- emitted + 1
                        proof_push(buffer, "{\"theorem\":")
                        proof_push_json_string(buffer, theorem.name)
                        proof_push(buffer, ",\"theorem_fingerprint\":")
                        theorem_fingerprint: (valid: bool, value: u32) = proof_theorem_fingerprint(report, theorem)
                        if theorem_fingerprint.valid:
                            proof_push(buffer, "{\"algorithm\":\"fnv1a32-kernel-theorem-v1\",\"value\":")
                            proof_push_number(buffer, theorem_fingerprint.value)
                            proof_push(buffer, "}")
                        else:
                            proof_push(buffer, "null")
                        proof_push(buffer, ",\"line\":")
                        proof_push_number(buffer, theorem.line)
                        proof_push(buffer, ",\"ensure_index\":")
                        proof_push_number(buffer, ensure_index.u32())
                        proof_push(buffer, ",\"bindings\":[")
                        for parameter_index in 0..<theorem.parameters_count |parameter_index, theorem, report, values, buffer|:
                            proof_push(buffer, ",") if parameter_index > 0
                            proof_push(buffer, "{\"parameter\":")
                            proof_push_json_string(buffer, report.theorem_parameters[theorem.parameters_start + parameter_index])
                            proof_push(buffer, ",\"value\":")
                            proof_push_json_expr(buffer, values[parameter_index])
                            proof_push(buffer, "}")
                        proof_push(buffer, "],\"premises\":[")
                        applicable: mutable bool = true
                        facts: mutable darray[Ast::Expr] = []
                        for fact_index in 0..<attempt.facts_count |fact_index, attempt, report, facts|:
                            facts.push(report.certificate_facts[attempt.facts_start + fact_index])
                        for require_index in 0..<theorem.requires_count |require_index, theorem, report, names, values, facts, annotations, buffer, applicable|:
                            proof_push(buffer, ",") if require_index > 0
                            premise: Ast::Expr = proof_substitute(report.theorem_requires[theorem.requires_start + require_index], names, values)
                            satisfied: bool = proof_goal(facts, premise, annotations)
                            applicable <- false if not satisfied
                            proof_push(buffer, "{\"proposition\":")
                            proof_push_json_expr(buffer, premise)
                            proof_push(buffer, ",\"satisfied\":")
                            proof_push(buffer, "true" if satisfied else "false")
                            proof_push(buffer, "}")
                        proof_push(buffer, "],\"premises_satisfied\":")
                        proof_push(buffer, "true" if applicable else "false")
                        proof_push(buffer, ",\"applicable\":")
                        proof_push(buffer, "true" if applicable and source_admissible else "false")
                        proof_push(buffer, "}")
    proof_push(buffer, "]}\n")

def proof_report_has_open_goals(report: ProofReport&) -> bool:
    for attempt in report.goal_attempts:
        return true if not attempt.proven
    return false

def proof_report_verification_state(report: ProofReport&, semantic_errors: u32) -> sview:
    # `status` remains the compatibility verdict (`proved`, `failed`, or replay-gap aware),
    # while this field gives agents the precise reason a run did not establish a theorem.
    # Disproof has priority over unsupported/unknown because it carries a concrete violated
    # obligation; unsupported has priority over a residual unknown proof hole.
    has_disproved: mutable bool = false
    has_unsupported: mutable bool = false
    has_unknown: mutable bool = false
    for finding in report.findings |has_disproved, has_unsupported, has_unknown|:
        has_disproved <- true if finding.status == "disproved"
        has_unsupported <- true if finding.status == "unsupported"
        has_unknown <- true if finding.status == "unknown"
    return "disproved" if has_disproved
    return "unsupported" if has_unsupported
    return "unknown" if has_unknown or proof_report_has_open_goals(report) or report.replay_gaps > 0 or semantic_errors > 0
    return "proved"

def proof_trace_is_trusted_boundary(trace: ProofFactTrace) -> bool:
    return trace.kind != "proof-step" and trace.kind != "lemma-step" and trace.kind != "loop-invariant-step" and trace.kind != "lemma-summary" and trace.kind != "function-summary"

def proof_report_trusted_boundary_count(report: ProofReport&) -> u32:
    # Source/runtime transitions remain explicit semantic boundaries. Summary facts are excluded:
    # replay reconstructs both lemma and executable postconditions from their exact verified
    # contracts, bindings, result value, and independently replayed preconditions.
    count: mutable u32 = 0
    for trace in report.fact_traces:
        count <- count + 1 if proof_trace_is_trusted_boundary(trace)
    return count

def proof_semantic_diagnostic_visible(diagnostic: Semantic::Diagnostic, report: ProofReport&) -> bool:
    return false if diagnostic.kind == Semantic::DiagnosticKind.AssertByUnproven
    return false if diagnostic.kind == Semantic::DiagnosticKind.MutualDecreasesCycle and any verified_name in report.structural_verified_names where verified_name == diagnostic.name
    return true

def proof_push_json_semantic_diagnostic(buffer: mutable darray[u8]&, diagnostic: Semantic::Diagnostic) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    message: darray[u8] = Semantic::diagnostic_message(diagnostic)
    proof_push(buffer, "{\"kind_code\":")
    # DiagnosticKind is append-only in the compiler and its ordinal is the stable machine code;
    # the rendered message remains present for clients that do not have the compiler enum table.
    proof_push_number(buffer, diagnostic.kind.u32())
    proof_push(buffer, ",\"severity\":")
    proof_push_number(buffer, Semantic::diagnostic_severity(diagnostic).u32())
    proof_push(buffer, ",\"line\":")
    proof_push_number(buffer, diagnostic.line)
    proof_push(buffer, ",\"column\":")
    proof_push_number(buffer, diagnostic.pos.column)
    proof_push(buffer, ",\"end_column\":")
    proof_push_number(buffer, diagnostic.pos.end_column)
    proof_push(buffer, ",\"name\":")
    proof_push_json_string(buffer, diagnostic.name)
    proof_push(buffer, ",\"expected\":")
    proof_push_json_string(buffer, diagnostic.expected)
    proof_push(buffer, ",\"actual\":")
    proof_push_json_string(buffer, diagnostic.actual)
    proof_push(buffer, ",\"detail\":")
    proof_push_json_string(buffer, diagnostic.detail)
    proof_push(buffer, ",\"detail2\":")
    proof_push_json_string(buffer, diagnostic.detail2)
    proof_push(buffer, ",\"detail3\":")
    proof_push_json_string(buffer, diagnostic.detail3)
    proof_push(buffer, ",\"expected_count\":")
    proof_push_number(buffer, diagnostic.expected_count)
    proof_push(buffer, ",\"actual_count\":")
    proof_push_number(buffer, diagnostic.actual_count)
    proof_push(buffer, ",\"effect_refs\":[")
    effect_count: mutable usize = diagnostic.effect_ref_count.usize()
    effect_count <- 8 if effect_count > 8
    for index in 0..<effect_count |index, diagnostic, buffer|:
        proof_push(buffer, ",") if index > 0
        effect_ref: sview = match index:
            0: diagnostic.effect_ref_1
            1: diagnostic.effect_ref_2
            2: diagnostic.effect_ref_3
            3: diagnostic.effect_ref_4
            4: diagnostic.effect_ref_5
            5: diagnostic.effect_ref_6
            6: diagnostic.effect_ref_7
            _: diagnostic.effect_ref_8
        proof_push_json_string(buffer, effect_ref)
    proof_push(buffer, "],\"message\":")
    proof_push_json_bytes(buffer, message)
    proof_push(buffer, "}")

def proof_push_json_report(buffer: mutable darray[u8]&, report: ProofReport&, semantic_diagnostics: darray[Semantic::Diagnostic]&, semantic_visible: u32, semantic_errors: u32, source_bytes: usize, source_fingerprint: u32) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    verdict: mutable sview = "proved"
    verdict <- "failed" if report.failed > 0 or proof_report_has_open_goals(report) or semantic_errors > 0
    verdict <- "proved_with_replay_gaps" if verdict == "proved" and report.replay_gaps > 0
    verification_state: sview = proof_report_verification_state(report, semantic_errors)
    trusted_boundaries: u32 = proof_report_trusted_boundary_count(report)
    proof_push(buffer, "{\"status\":")
    proof_push_json_string(buffer, verdict)
    proof_push(buffer, ",\"verification_state\":")
    proof_push_json_string(buffer, verification_state)
    proof_push(buffer, ",\"source\":{\"bytes\":")
    proof_push_number(buffer, source_bytes.u32())
    proof_push(buffer, ",\"fingerprint\":{\"algorithm\":\"fnv1a32\",\"value\":")
    proof_push_number(buffer, source_fingerprint)
    proof_push(buffer, "}}")
    # The action list is a stable capability declaration for proof-state clients. The
    # implementation lives in tactics.elisa, and every state-changing operation is still
    # required to pass the existing kernel's soundness boundary.
    proof_push(buffer, ",\"action_protocol\":{\"format\":\"elisa-proof-tactics-v1\",\"admission\":\"kernel-backed\",\"operations\":[\"assumption\",\"exact\",\"decide\",\"intro\",\"apply\",\"simp\",\"have\",\"instantiate\",\"rewrite\",\"split\",\"left\",\"right\",\"cases\"],\"trace\":{\"initial_state\":true,\"post_state\":true,\"facts_snapshot\":\"flat-arena-independent\",\"replay\":\"proof_tactic_replay\",\"kernel_step_replay\":\"proof_kernel_replay_tactic_step\",\"kernel_trace_replay\":\"proof_tactic_kernel_trace_replay\",\"replays_rejected_actions\":true},\"final_state_replay\":\"proof_tactic_kernel_replay\",\"certificate_replay\":\"proof_tactic_kernel_certificate_replay\",\"branch_transition_replay\":\"proof_tactic_kernel_branch_transition_replay\",\"branch_certificate_replay\":\"proof_tactic_json_tree_certificate_replay\",\"script_import\":\"elisa-proof-tactics-v1\",\"script_result\":\"elisa-proof-tactic-result-v1\",\"source_binding\":\"optional-fnv1a32\",\"source_goal_binding\":\"target.goal_id\",\"branch_script\":{\"final_parent_action\":true,\"children\":\"branches[2]\",\"nested\":true,\"max_branch_depth\":32,\"child_state_injection\":false}}")
    proof_push(buffer, ",\"trust\":{\"trusted_boundary_facts\":")
    proof_push_number(buffer, trusted_boundaries)
    proof_push(buffer, ",\"kernel_replayed_certificates\":")
    proof_push_number(buffer, report.replayed)
    proof_push(buffer, ",\"boundary_facts\":[")
    boundary_index: mutable usize = 0
    for trace in report.fact_traces |buffer, boundary_index|:
        if proof_trace_is_trusted_boundary(trace):
            proof_push(buffer, ",") if boundary_index > 0
            proof_push(buffer, "{\"kind\":")
            proof_push_json_string(buffer, trace.kind)
            proof_push(buffer, ",\"owner\":")
            proof_push_json_string(buffer, trace.name)
            proof_push(buffer, ",\"line\":")
            proof_push_number(buffer, trace.line)
            proof_push(buffer, ",\"kernel_root\":")
            proof_push_number(buffer, trace.kernel_expression.u32())
            proof_push(buffer, "}")
            boundary_index <- boundary_index + 1
    proof_push(buffer, "]")
    # No trusted assumptions are currently accepted by the proof language. Keep the ledger
    # explicit so future axiom or foreign-proof escape hatches must be named and reviewed.
    proof_push(buffer, ",\"trusted_assumptions\":[]")
    proof_push(buffer, "},\"summary\":{\"declarations\":")
    proof_push_number(buffer, report.declarations)
    proof_push(buffer, ",\"obligations\":")
    proof_push_number(buffer, report.obligations)
    proof_push(buffer, ",\"proven\":")
    proof_push_number(buffer, report.proven)
    proof_push(buffer, ",\"failed\":")
    proof_push_number(buffer, report.failed)
    proof_push(buffer, ",\"semantic_diagnostics\":")
    proof_push_number(buffer, semantic_visible)
    proof_push(buffer, ",\"semantic_errors\":")
    proof_push_number(buffer, semantic_errors)
    proof_push(buffer, "},\"declaration_details\":[")
    for index in 0..<report.declaration_details.count |index, report, buffer|:
        proof_push(buffer, ",") if index > 0
        proof_push_json_declaration(buffer, report, report.declaration_details[index])
    proof_push(buffer, "],\"semantic_diagnostics\":[")
    semantic_index: mutable usize = 0
    for diagnostic in semantic_diagnostics |diagnostic, report, buffer, semantic_index|:
        continue if not proof_semantic_diagnostic_visible(diagnostic, report)
        proof_push(buffer, ",") if semantic_index > 0
        proof_push_json_semantic_diagnostic(buffer, diagnostic)
        semantic_index <- semantic_index + 1
    proof_push(buffer, "],\"replay\":{\"certificates\":")
    proof_push_number(buffer, report.certificates.count.u32())
    proof_push(buffer, ",\"replayed\":")
    proof_push_number(buffer, report.replayed)
    proof_push(buffer, ",\"gaps\":")
    proof_push_number(buffer, report.replay_gaps)
    proof_push(buffer, "},\"kernel\":{\"format\":\"elisa-proof-kernel-v1\",\"independent_replay\":true,\"nodes\":[")
    for index in 0..<report.kernel_nodes.count |index, report, buffer|:
        proof_push(buffer, ",") if index > 0
        proof_push_json_kernel_node(buffer, report.kernel_nodes[index])
    proof_push(buffer, "],\"children\":[")
    for index in 0..<report.kernel_children.count |index, report, buffer|:
        proof_push(buffer, ",") if index > 0
        proof_push_number(buffer, report.kernel_children[index].u32())
    proof_push(buffer, "],\"certificate_facts\":[")
    for index in 0..<report.kernel_certificate_facts.count |index, report, buffer|:
        proof_push(buffer, ",") if index > 0
        proof_push_number(buffer, report.kernel_certificate_facts[index].u32())
    proof_push(buffer, "],\"fact_trace_premises\":[")
    for index in 0..<report.kernel_fact_trace_premises.count |index, report, buffer|:
        proof_push(buffer, ",") if index > 0
        proof_push_number(buffer, report.kernel_fact_trace_premises[index].u32())
    proof_push(buffer, "],\"fact_traces\":[")
    for index in 0..<report.fact_traces.count |index, report, buffer|:
        trace: ProofFactTrace = report.fact_traces[index]
        proof_push(buffer, ",") if index > 0
        proof_push(buffer, "{\"expression\":")
        proof_push_number(buffer, trace.kernel_expression.u32())
        proof_push(buffer, ",\"kind\":")
        proof_push_json_string(buffer, trace.kind)
        proof_push(buffer, ",\"line\":")
        proof_push_number(buffer, trace.line)
        proof_push(buffer, ",\"name\":")
        proof_push_json_string(buffer, trace.name)
        proof_push(buffer, ",\"dependency\":")
        proof_push_json_string(buffer, trace.dependency)
        proof_push(buffer, ",\"premises_start\":")
        proof_push_number(buffer, trace.kernel_premises_start.u32())
        proof_push(buffer, ",\"premises_count\":")
        proof_push_number(buffer, trace.kernel_premises_count.u32())
        proof_push(buffer, ",\"summary_bindings\":[")
        valid_summary_bindings: bool = trace.summary_bindings_start <= report.fact_trace_summary_names.count and trace.summary_bindings_count <= report.fact_trace_summary_names.count - trace.summary_bindings_start and trace.summary_bindings_start <= report.fact_trace_summary_values.count and trace.summary_bindings_count <= report.fact_trace_summary_values.count - trace.summary_bindings_start
        if valid_summary_bindings:
            for binding_index in 0..<trace.summary_bindings_count |binding_index, trace, report, buffer|:
                proof_push(buffer, ",") if binding_index > 0
                summary_index: usize = trace.summary_bindings_start + binding_index
                proof_push(buffer, "{\"parameter\":")
                proof_push_json_string(buffer, report.fact_trace_summary_names[summary_index])
                proof_push(buffer, ",\"value\":")
                proof_push_json_expr(buffer, report.fact_trace_summary_values[summary_index])
                proof_push(buffer, "}")
        proof_push(buffer, "],\"summary_require_goal_ids\":[")
        valid_summary_requires: bool = trace.summary_requires_start <= report.fact_trace_summary_require_goal_ids.count and trace.summary_requires_count <= report.fact_trace_summary_require_goal_ids.count - trace.summary_requires_start
        if valid_summary_requires:
            for require_index in 0..<trace.summary_requires_count |require_index, trace, report, buffer|:
                proof_push(buffer, ",") if require_index > 0
                proof_push_number(buffer, report.fact_trace_summary_require_goal_ids[trace.summary_requires_start + require_index].u32())
        proof_push(buffer, "],\"summary_ensure_index\":")
        proof_push_number(buffer, trace.summary_ensure_index.u32())
        proof_push(buffer, "}")
    proof_push(buffer, "]},\"findings\":[")
    for index in 0..<report.findings.count |index, report, buffer|:
        finding: ProofFinding = report.findings[index]
        proof_push(buffer, ",") if index > 0
        proof_push(buffer, "{\"kind\":")
        proof_push_json_string(buffer, finding.kind)
        proof_push(buffer, ",\"status\":")
        proof_push_json_string(buffer, finding.status)
        proof_push(buffer, ",\"line\":")
        proof_push_number(buffer, finding.line)
        proof_push(buffer, ",\"name\":")
        proof_push_json_string(buffer, finding.name)
        proof_push(buffer, ",\"message\":")
        proof_push_json_string(buffer, finding.message)
        proof_push(buffer, ",\"counterexample_found\":")
        proof_push(buffer, "true" if finding.counterexample_found else "false")
        proof_push(buffer, ",\"goal_id\":")
        proof_push_number(buffer, finding.goal_id.u32()) if finding.has_goal
        proof_push(buffer, "null") if not finding.has_goal
        proof_push(buffer, ",\"counterexample\":[")
        for counterexample_index in 0..<finding.counterexample_count |counterexample_index, finding, report, buffer|:
            proof_push(buffer, ",") if counterexample_index > 0
            proof_push_json_expr(buffer, report.counterexample_facts[finding.counterexample_start + counterexample_index])
        proof_push(buffer, "]")
        proof_push(buffer, "}")
    proof_push(buffer, "],\"goals\":[")
    for index in 0..<report.goal_attempts.count |index, report, buffer|:
        attempt: ProofGoalAttempt = report.goal_attempts[index]
        replay_status: mutable sview = "not_certified"
        if attempt.has_certificate and attempt.certificate_index < report.certificates.count:
            replay_status <- "replayed" if report.certificates[attempt.certificate_index].replayed else "gap"
        proof_push(buffer, ",") if index > 0
        proof_push(buffer, "{\"goal_id\":")
        proof_push_number(buffer, index.u32())
        proof_push(buffer, ",\"line\":")
        proof_push_number(buffer, attempt.line)
        proof_push(buffer, ",\"name\":")
        proof_push_json_string(buffer, attempt.name)
        proof_push(buffer, ",\"rule\":")
        proof_push_json_string(buffer, attempt.rule)
        proof_push(buffer, ",\"proven\":")
        proof_push(buffer, "true" if attempt.proven else "false")
        proof_push(buffer, ",\"replay_status\":")
        proof_push_json_string(buffer, replay_status)
        proof_push(buffer, ",\"certificate_id\":")
        if attempt.has_certificate and attempt.certificate_index < report.certificates.count:
            proof_push_number(buffer, attempt.certificate_index.u32())
        else:
            proof_push(buffer, "null")
        proof_push(buffer, ",\"kernel_goal\":")
        proof_push_number(buffer, attempt.kernel_goal.u32())
        proof_push(buffer, ",\"kernel_facts_start\":")
        proof_push_number(buffer, attempt.kernel_facts_start.u32())
        proof_push(buffer, ",\"kernel_facts_count\":")
        proof_push_number(buffer, attempt.kernel_facts_count.u32())
        proof_push(buffer, ",\"facts\":[")
        for fact_index in 0..<attempt.facts_count |fact_index, attempt, report, buffer|:
            proof_push(buffer, ",") if fact_index > 0
            proof_push_json_expr(buffer, report.certificate_facts[attempt.facts_start + fact_index])
        proof_push(buffer, "],\"fact_origins\":[")
        for fact_index in 0..<attempt.facts_count |fact_index, attempt, report, buffer|:
            proof_push(buffer, ",") if fact_index > 0
            proof_push_json_fact_origin(buffer, report, attempt.facts_start + fact_index, attempt.name)
        proof_push(buffer, "],\"dependencies\":[")
        proof_push_json_goal_dependencies(buffer, report, attempt.facts_start, attempt.facts_count, attempt.name)
        proof_push(buffer, "],\"goal\":")
        proof_push_json_expr(buffer, attempt.goal)
        proof_push(buffer, "}")
    proof_push(buffer, "],\"repair_queue\":[")
    repair_index: mutable usize = 0
    for index in 0..<report.goal_attempts.count |index, report, buffer, repair_index|:
        attempt: ProofGoalAttempt = report.goal_attempts[index]
        continue if attempt.proven
        proof_push(buffer, ",") if repair_index > 0
        proof_push(buffer, "{\"goal_id\":")
        proof_push_number(buffer, index.u32())
        proof_push(buffer, ",\"line\":")
        proof_push_number(buffer, attempt.line)
        proof_push(buffer, ",\"name\":")
        proof_push_json_string(buffer, attempt.name)
        proof_push(buffer, ",\"rule\":")
        proof_push_json_string(buffer, attempt.rule)
        proof_push(buffer, ",\"replay_status\":\"not_certified\",\"failure\":")
        proof_push_json_repair_failure(buffer, report, attempt, index)
        proof_push(buffer, ",\"dependencies\":[")
        proof_push_json_goal_dependencies(buffer, report, attempt.facts_start, attempt.facts_count, attempt.name)
        proof_push(buffer, "]}")
        repair_index <- repair_index + 1
    proof_push(buffer, "],\"dependency_index\":[")
    dependency_names: mutable darray[sview] = []
    dependency_starts: mutable darray[usize] = []
    dependency_counts: mutable darray[usize] = []
    dependency_goal_ids: mutable darray[usize] = []
    for goal_index in 0..<report.goal_attempts.count |goal_index, report, dependency_names, dependency_starts, dependency_counts, dependency_goal_ids|:
        attempt: ProofGoalAttempt = report.goal_attempts[goal_index]
        for fact_index in 0..<attempt.facts_count |fact_index, attempt, report, dependency_names, dependency_starts, dependency_counts, dependency_goal_ids, goal_index|:
            origin: (known: bool, kind: sview, line: u32, name: sview, dependency: sview, premises_count: usize) = proof_replay_fact_origin_at(report, attempt.facts_start + fact_index, attempt.name)
            continue if not origin.known or origin.dependency == ""
            dependency_index: mutable usize = dependency_names.count
            for candidate in 0..<dependency_names.count |candidate, dependency_names, origin, dependency_index|:
                dependency_index <- candidate if dependency_names[candidate] == origin.dependency
            if dependency_index == dependency_names.count:
                dependency_names.push(origin.dependency)
                dependency_starts.push(dependency_goal_ids.count)
                dependency_counts.push(0)
            start: usize = dependency_starts[dependency_index]
            count: usize = dependency_counts[dependency_index]
            already: mutable bool = false
            for prior in 0..<count |prior, dependency_goal_ids, start, goal_index, already|:
                already <- true if dependency_goal_ids[start + prior] == goal_index
            if not already:
                dependency_goal_ids.push(goal_index)
                dependency_counts[dependency_index] <- count + 1
    for dependency_index in 0..<dependency_names.count |dependency_index, dependency_names, dependency_starts, dependency_counts, dependency_goal_ids, buffer|:
        dependency: sview = dependency_names[dependency_index]
        proof_push(buffer, ",") if dependency_index > 0
        proof_push(buffer, "{\"name\":")
        proof_push_json_string(buffer, dependency)
        proof_push(buffer, ",\"goal_ids\":[")
        start: usize = dependency_starts[dependency_index]
        count: usize = dependency_counts[dependency_index]
        for goal_offset in 0..<count |goal_offset, dependency_goal_ids, start, buffer|:
            proof_push(buffer, ",") if goal_offset > 0
            proof_push_number(buffer, dependency_goal_ids[start + goal_offset].u32())
        proof_push(buffer, "]}")
    proof_push(buffer, "],\"certificates\":[")
    for index in 0..<report.certificates.count |index, report, buffer|:
        certificate: ProofGoalCertificate = report.certificates[index]
        proof_push(buffer, ",") if index > 0
        proof_push(buffer, "{\"certificate_id\":")
        proof_push_number(buffer, index.u32())
        proof_push(buffer, ",\"line\":")
        proof_push_number(buffer, certificate.line)
        proof_push(buffer, ",\"name\":")
        proof_push_json_string(buffer, certificate.name)
        proof_push(buffer, ",\"rule\":")
        proof_push_json_string(buffer, certificate.rule)
        proof_push(buffer, ",\"replayed\":")
        proof_push(buffer, "true" if certificate.replayed else "false")
        proof_push(buffer, ",\"kernel_goal\":")
        proof_push_number(buffer, certificate.kernel_goal.u32())
        proof_push(buffer, ",\"kernel_facts_start\":")
        proof_push_number(buffer, certificate.kernel_facts_start.u32())
        proof_push(buffer, ",\"kernel_facts_count\":")
        proof_push_number(buffer, certificate.kernel_facts_count.u32())
        proof_push(buffer, ",\"facts\":[")
        for fact_index in 0..<certificate.facts_count |fact_index, certificate, report, buffer|:
            proof_push(buffer, ",") if fact_index > 0
            proof_push_json_expr(buffer, report.certificate_facts[certificate.facts_start + fact_index])
        proof_push(buffer, "],\"fact_origins\":[")
        for fact_index in 0..<certificate.facts_count |fact_index, certificate, report, buffer|:
            proof_push(buffer, ",") if fact_index > 0
            proof_push_json_fact_origin(buffer, report, certificate.facts_start + fact_index, certificate.name)
        proof_push(buffer, "],\"dependencies\":[")
        proof_push_json_goal_dependencies(buffer, report, certificate.facts_start, certificate.facts_count, certificate.name)
        proof_push(buffer, "],\"goal\":")
        proof_push_json_expr(buffer, certificate.goal)
        proof_push(buffer, "}")
    proof_push(buffer, "]}\n")

def proof_push_json_tactic_step(buffer: mutable darray[u8]&, step: ProofTacticStep) -> void can[Memory.Allocate, Abort.Panic]:
    proof_push(buffer, "{\"action\":")
    proof_push_json_string(buffer, step.action)
    proof_push(buffer, ",\"accepted\":")
    proof_push(buffer, "true" if step.accepted else "false")
    proof_push(buffer, ",\"solved\":")
    proof_push(buffer, "true" if step.solved else "false")
    proof_push(buffer, ",\"facts_start\":")
    proof_push_number(buffer, step.facts_start.u32())
    proof_push(buffer, ",\"facts_count\":")
    proof_push_number(buffer, step.facts_count.u32())
    proof_push(buffer, ",\"goal\":")
    proof_push_json_expr(buffer, step.goal)
    proof_push(buffer, ",\"reason\":")
    proof_push_json_string(buffer, step.reason)
    proof_push(buffer, ",\"has_argument\":")
    proof_push(buffer, "true" if step.has_argument else "false")
    proof_push(buffer, ",\"argument\":")
    proof_push_json_expr(buffer, step.argument) if step.has_argument else proof_push(buffer, "null")
    proof_push(buffer, ",\"has_secondary\":")
    proof_push(buffer, "true" if step.has_secondary else "false")
    proof_push(buffer, ",\"secondary\":")
    proof_push_json_expr(buffer, step.secondary) if step.has_secondary else proof_push(buffer, "null")
    proof_push(buffer, ",\"has_argument_index\":")
    proof_push(buffer, "true" if step.has_argument_index else "false")
    proof_push(buffer, ",\"argument_index\":")
    proof_push_number(buffer, step.argument_index.u32())
    proof_push(buffer, ",\"detail\":")
    proof_push_json_string(buffer, step.detail)
    proof_push(buffer, "}")

def proof_push_json_tactic_state_prefix(buffer: mutable darray[u8]&, state: ProofTacticState&) -> void can[Memory.Allocate, Abort.Panic]:
    proof_push(buffer, "{\"solved\":")
    proof_push(buffer, "true" if state.solved else "false")
    proof_push(buffer, ",\"action_count\":")
    proof_push_number(buffer, state.action_count.u32())
    proof_push(buffer, ",\"initial_facts\":[")
    for index in 0..<state.initial_facts.count |index, state, buffer|:
        proof_push(buffer, ",") if index > 0
        proof_push_json_expr(buffer, state.initial_facts[index])
    proof_push(buffer, "],\"initial_goal\":")
    proof_push_json_expr(buffer, state.initial_goal)
    proof_push(buffer, ",\"facts\":[")
    for index in 0..<state.facts.count |index, state, buffer|:
        proof_push(buffer, ",") if index > 0
        proof_push_json_expr(buffer, state.facts[index])
    proof_push(buffer, "],\"goal\":")
    proof_push_json_expr(buffer, state.goal)
    proof_push(buffer, ",\"trace\":[")
    for index in 0..<state.trace.count |index, state, buffer|:
        proof_push(buffer, ",") if index > 0
        proof_push_json_tactic_step(buffer, state.trace[index])
    proof_push(buffer, "]")

def proof_push_json_tactic_state(buffer: mutable darray[u8]&, state: ProofTacticState&) -> void can[Memory.Allocate, Abort.Panic]:
    proof_push_json_tactic_state_prefix(buffer, state)
    proof_push(buffer, "}")

def proof_push_json_tactic_tree_state(buffer: mutable darray[u8]&, tree: ProofTacticJsonTree&, node: usize, depth: usize) -> void can[Memory.Allocate, Abort.Panic]:
    requires depth <= 32
    decreases 32 - depth
    return if node >= tree.states.count
    proof_push_json_tactic_state_prefix(buffer, tree.states[node])
    if tree.has_branch[node] and depth < 32:
        left: usize = tree.left[node]
        right: usize = tree.right[node]
        if left < node and right < node:
            proof_push(buffer, ",\"branches\":{\"left\":")
            proof_push_json_tactic_tree_state(buffer, tree, left, depth + 1)
            proof_push(buffer, ",\"right\":")
            proof_push_json_tactic_tree_state(buffer, tree, right, depth + 1)
            proof_push(buffer, "}")
    proof_push(buffer, "}")

def proof_tactic_result_admitted(result: ProofTacticJsonResult, source_status: sview, source_admissible: bool, source_match: bool, target_bound: bool) -> bool:
    tactic_admitted: bool = result.valid and result.certificate_replayed and source_match
    return tactic_admitted and (source_status == "proved" or target_bound and source_admissible)

def proof_push_json_tactic_result(buffer: mutable darray[u8]&, result: ProofTacticJsonResult, state: ProofTacticState&, tree: ProofTacticJsonTree&, source_bytes: usize, source_fingerprint: u32, source_status: sview, source_admissible: bool, source_match: bool, target_bound: bool, target_goal_id: usize, target_goal_fingerprint: u32, target_fingerprint_valid: bool, target_fingerprint_match: bool, target_previously_proven: bool) -> void can[Memory.Allocate, Abort.Panic]:
    tactic_admitted: bool = result.valid and result.certificate_replayed and source_match
    # A source-bound script proves exactly one imported obligation. It may therefore repair that
    # obligation while other logical goals remain open, but parse/import failures, semantic errors,
    # and replay gaps still poison the source boundary. An unbound portable script retains the
    # stricter whole-source gate because it has no proposition-level link to the imported program.
    admitted: bool = proof_tactic_result_admitted(result, source_status, source_admissible, source_match, target_bound)
    proof_push(buffer, "{\"format\":\"elisa-proof-tactic-result-v1\",\"status\":")
    proof_push_json_string(buffer, "proved" if admitted else "failed")
    proof_push(buffer, ",\"admission_scope\":")
    proof_push_json_string(buffer, "target" if target_bound else "portable")
    proof_push(buffer, ",\"source\":{\"bytes\":")
    proof_push_number(buffer, source_bytes.u32())
    proof_push(buffer, ",\"fingerprint\":")
    proof_push_number(buffer, source_fingerprint)
    proof_push(buffer, ",\"status\":")
    proof_push_json_string(buffer, source_status)
    proof_push(buffer, ",\"complete\":")
    proof_push(buffer, "true" if source_status == "proved" else "false")
    proof_push(buffer, ",\"admissible\":")
    proof_push(buffer, "true" if source_admissible else "false")
    proof_push(buffer, ",\"fingerprint_match\":")
    proof_push(buffer, "true" if source_match else "false")
    proof_push(buffer, "},\"source_goal_binding\":{\"bound\":")
    proof_push(buffer, "true" if target_bound else "false")
    proof_push(buffer, ",\"goal_id\":")
    if target_bound:
        proof_push_number(buffer, target_goal_id.u32())
    else:
        proof_push(buffer, "null")
    proof_push(buffer, ",\"goal_fingerprint\":")
    if target_bound and target_fingerprint_valid:
        proof_push(buffer, "{\"algorithm\":\"fnv1a32-kernel-goal-v1\",\"value\":")
        proof_push_number(buffer, target_goal_fingerprint)
        proof_push(buffer, "}")
    else:
        proof_push(buffer, "null")
    proof_push(buffer, ",\"fingerprint_match\":")
    proof_push(buffer, "true" if target_fingerprint_match else "false")
    proof_push(buffer, ",\"previously_proven\":")
    proof_push(buffer, "true" if target_previously_proven else "false")
    proof_push(buffer, "},\"tactic\":{\"status\":")
    proof_push_json_string(buffer, "proved" if tactic_admitted else "failed")
    proof_push(buffer, ",\"valid\":")
    proof_push(buffer, "true" if result.valid else "false")
    proof_push(buffer, ",\"solved\":")
    proof_push(buffer, "true" if result.solved else "false")
    proof_push(buffer, ",\"action_count\":")
    proof_push_number(buffer, result.action_count.u32())
    proof_push(buffer, ",\"accepted_count\":")
    proof_push_number(buffer, result.accepted_count.u32())
    proof_push(buffer, ",\"trace_replayed\":")
    proof_push(buffer, "true" if result.trace_replayed else "false")
    proof_push(buffer, ",\"kernel_trace_replayed\":")
    proof_push(buffer, "true" if result.kernel_trace_replayed else "false")
    proof_push(buffer, ",\"kernel_replayed\":")
    proof_push(buffer, "true" if result.kernel_replayed else "false")
    proof_push(buffer, ",\"certificate_replayed\":")
    proof_push(buffer, "true" if result.certificate_replayed else "false")
    proof_push(buffer, ",\"branch_present\":")
    proof_push(buffer, "true" if result.branch_present else "false")
    proof_push(buffer, ",\"branch_certificate_replayed\":")
    proof_push(buffer, "true" if result.branch_certificate_replayed else "false")
    proof_push(buffer, ",\"reason\":")
    proof_push_json_string(buffer, result.reason)
    proof_push(buffer, "},\"state\":")
    proof_push_json_tactic_state(buffer, state)
    if result.branch_present and result.tree_node < tree.states.count:
        proof_push(buffer, ",\"branches\":{\"left\":")
        proof_push_json_tactic_tree_state(buffer, tree, tree.left[result.tree_node], 0)
        proof_push(buffer, ",\"right\":")
        proof_push_json_tactic_tree_state(buffer, tree, tree.right[result.tree_node], 0)
        proof_push(buffer, "}")
    proof_push(buffer, "}\n")

def proof_main(argc: i64, argv: mutable void&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
    if argc < 2:
        usage: mutable darray[u8] = []
        proof_push(&usage, "usage: elisa-proof [--json|--theorems] <file.elisa> | --goal <id> <file.elisa> | --proof <id> <file.elisa> | --check-proof <proof.txt> <file.elisa> | --script <proof.txt> <file.elisa> | --repair <id> <file.elisa> | --repair-all <file.elisa> | --suggest <id> <file.elisa> | --tactics <proof.json> <file.elisa>\n")
        proof_write(usage)
        return 2
    slots: mutable cstr&& = argv.cast[mutable cstr&&]
    json_output: mutable bool = false
    goal_json_output: mutable bool = false
    suggestion_json_output: mutable bool = false
    theorem_json_output: mutable bool = false
    proof_text_output: mutable bool = false
    proof_check_output: mutable bool = false
    script_is_text: mutable bool = false
    repair_output: mutable bool = false
    repair_all_output: mutable bool = false
    focused_goal_id: mutable usize = 0
    tactic_json_output: mutable bool = false
    script_slot: mutable usize = 0
    path_slot: mutable usize = 1
    first_argument: cstr = slots[1].cast[cstr]
    if proof_cstr_equals(first_argument, "--tactics"):
        tactic_json_output <- true
        script_slot <- 2
        path_slot <- 3
        if argc < 4:
            usage: mutable darray[u8] = []
            proof_push(&usage, "usage: elisa-proof --tactics <proof.json> <file.elisa>\n")
            proof_write(usage)
            return 2
    elif proof_cstr_equals(first_argument, "--json"):
        json_output <- true
        if argc < 3:
            usage: mutable darray[u8] = []
            proof_push(&usage, "usage: elisa-proof --json <file.elisa>\n")
            proof_write(usage)
            return 2
        path_slot <- 2
    elif proof_cstr_equals(first_argument, "--goal"):
        goal_json_output <- true
        if argc < 4:
            usage: mutable darray[u8] = []
            proof_push(&usage, "usage: elisa-proof --goal <id> <file.elisa>\n")
            proof_write(usage)
            return 2
        parsed_goal: (valid: bool, parsed: u32) = proof_cstr_u32(slots[2].cast[cstr])
        if not parsed_goal.valid:
            message: mutable darray[u8] = []
            proof_push(&message, "elisa-proof: goal id must be an unsigned 32-bit integer\n")
            proof_write(message)
            return 2
        focused_goal_id <- parsed_goal.parsed.usize()
        path_slot <- 3
    elif proof_cstr_equals(first_argument, "--proof"):
        proof_text_output <- true
        if argc < 4:
            usage: mutable darray[u8] = []
            proof_push(&usage, "usage: elisa-proof --proof <id> <file.elisa>\n")
            proof_write(usage)
            return 2
        parsed_goal: (valid: bool, parsed: u32) = proof_cstr_u32(slots[2].cast[cstr])
        if not parsed_goal.valid:
            message: mutable darray[u8] = []
            proof_push(&message, "elisa-proof: goal id must be an unsigned 32-bit integer\n")
            proof_write(message)
            return 2
        focused_goal_id <- parsed_goal.parsed.usize()
        path_slot <- 3
    elif proof_cstr_equals(first_argument, "--repair-all"):
        repair_all_output <- true
        if argc < 3:
            usage: mutable darray[u8] = []
            proof_push(&usage, "usage: elisa-proof --repair-all <file.elisa>\n")
            proof_write(usage)
            return 2
        path_slot <- 2
    elif proof_cstr_equals(first_argument, "--repair"):
        repair_output <- true
        if argc < 4:
            usage: mutable darray[u8] = []
            proof_push(&usage, "usage: elisa-proof --repair <id> <file.elisa>\n")
            proof_write(usage)
            return 2
        parsed_goal: (valid: bool, parsed: u32) = proof_cstr_u32(slots[2].cast[cstr])
        if not parsed_goal.valid:
            message: mutable darray[u8] = []
            proof_push(&message, "elisa-proof: goal id must be an unsigned 32-bit integer\n")
            proof_write(message)
            return 2
        focused_goal_id <- parsed_goal.parsed.usize()
        path_slot <- 3
    elif proof_cstr_equals(first_argument, "--script"):
        tactic_json_output <- true
        script_is_text <- true
        script_slot <- 2
        path_slot <- 3
        if argc < 4:
            usage: mutable darray[u8] = []
            proof_push(&usage, "usage: elisa-proof --script <proof.txt> <file.elisa>\n")
            proof_write(usage)
            return 2
    elif proof_cstr_equals(first_argument, "--check-proof"):
        proof_check_output <- true
        script_slot <- 2
        path_slot <- 3
        if argc < 4:
            usage: mutable darray[u8] = []
            proof_push(&usage, "usage: elisa-proof --check-proof <proof.txt> <file.elisa>\n")
            proof_write(usage)
            return 2
    elif proof_cstr_equals(first_argument, "--theorems"):
        theorem_json_output <- true
        if argc < 3:
            usage: mutable darray[u8] = []
            proof_push(&usage, "usage: elisa-proof --theorems <file.elisa>\n")
            proof_write(usage)
            return 2
        path_slot <- 2
    elif proof_cstr_equals(first_argument, "--suggest"):
        suggestion_json_output <- true
        if argc < 4:
            usage: mutable darray[u8] = []
            proof_push(&usage, "usage: elisa-proof --suggest <id> <file.elisa>\n")
            proof_write(usage)
            return 2
        parsed_goal: (valid: bool, parsed: u32) = proof_cstr_u32(slots[2].cast[cstr])
        if not parsed_goal.valid:
            message: mutable darray[u8] = []
            proof_push(&message, "elisa-proof: goal id must be an unsigned 32-bit integer\n")
            proof_write(message)
            return 2
        focused_goal_id <- parsed_goal.parsed.usize()
        path_slot <- 3
    path: cstr = slots[path_slot].cast[cstr]
    root_path: mutable darray[u8] = []
    path_index: mutable usize = 0
    while path[path_index] != 0 |path_index, root_path, path|:
        root_path.push(path[path_index])
        path_index <- path_index + 1
    root_read: (ok: bool, contents: darray[u8]) = proof_read_file_checked(path)
    source: mutable darray[u8] = root_read.contents
    if not root_read.ok:
        message: mutable darray[u8] = []
        proof_push(&message, "elisa-proof: could not read source\n")
        proof_write(message)
        return 2
    import_failed: mutable bool = false
    imported_source: mutable darray[u8] = proof_import_source(root_path, &import_failed)
    if imported_source.count > 0 or import_failed:
        source <- imported_source
    source_bytes: usize = source.count
    source_fingerprint: u32 = proof_source_fingerprint(source)
    source.push(0)
    file: Ast::File = frontend_parse(&source[0])
    report: mutable ProofReport = proof_empty_report()
    proof_check(file, &report)
    proof_replay_certificates(&report)
    proof_add_finding(&report, "import-error", 0, "", "one or more Elisa include files could not be read") if import_failed
    semantic_diagnostics: mutable darray[Semantic::Diagnostic] = []
    # Run the compiler's strongest built-in semantic mode as a second defense layer. The
    # custom proof kernel remains the verdict for proof obligations; this flag only enables
    # additional compiler-side refinement/invariant diagnostics.
    Semantic::check_full_diagnostics(file, &semantic_diagnostics, false, false, false, false, true, false, false, false, false, false, 64, false)
    semantic_errors: mutable u32 = 0
    semantic_visible: mutable u32 = 0
    # `assert … by:` is the compiler's legacy proof-block hook. The custom kernel below
    # owns this obligation now, including bounded arithmetic and recursive rules that the
    # compiler's general semantic pass does not know about. Keep every other compiler
    # diagnostic as an independent defense layer, but do not apply the weaker legacy
    # proof result a second time after the kernel has accepted the same AST.
    # The compiler's mutual-decreases pass predates structural SCC certificates and cannot
    # recognize a mutual call that receives a matched strict subterm. Suppress only that one
    # diagnostic when the custom kernel recorded a verified same-type structural SCC member;
    # all unrelated compiler diagnostics remain visible and fatal as before.
    for diagnostic in semantic_diagnostics |semantic_visible, report|:
        continue if not proof_semantic_diagnostic_visible(diagnostic, report)
        semantic_visible <- semantic_visible + 1
    for diagnostic in semantic_diagnostics |semantic_errors, report|:
        continue if not proof_semantic_diagnostic_visible(diagnostic, report)
        semantic_errors <- semantic_errors + 1 if Semantic::diagnostic_severity(diagnostic) == 1
    if goal_json_output:
        source_complete: bool = report.failed == 0 and not proof_report_has_open_goals(report) and report.replay_gaps == 0 and semantic_errors == 0 and not import_failed
        source_admissible: bool = not import_failed and semantic_errors == 0 and report.replay_gaps == 0
        focused: mutable darray[u8] = []
        proof_push_json_focused_goal(&focused, report, focused_goal_id, source_bytes, source_fingerprint, source_complete, source_admissible)
        proof_write(focused)
        return 0 if focused_goal_id < report.goal_attempts.count else 2
    if proof_check_output:
        source_complete: bool = report.failed == 0 and not proof_report_has_open_goals(report) and report.replay_gaps == 0 and semantic_errors == 0 and not import_failed
        source_admissible: bool = not import_failed and semantic_errors == 0 and report.replay_gaps == 0
        script_read: (ok: bool, contents: darray[u8]) = proof_read_file_checked(slots[script_slot].cast[cstr])
        if not script_read.ok:
            message: mutable darray[u8] = []
            proof_push(&message, "{\"format\":\"elisa-proof-proof-check-v1\",\"status\":\"unreadable\",\"goal_id\":null,\"differences\":[]}\n")
            proof_write(message)
            return 2
        checked: mutable darray[u8] = []
        check_status: i64 = proof_push_proof_check(&checked, report, script_read.contents, source_fingerprint, source_complete, source_admissible)
        proof_write(checked)
        return check_status
    if proof_text_output:
        source_complete: bool = report.failed == 0 and not proof_report_has_open_goals(report) and report.replay_gaps == 0 and semantic_errors == 0 and not import_failed
        source_admissible: bool = not import_failed and semantic_errors == 0 and report.replay_gaps == 0
        rendered: mutable darray[u8] = []
        proof_push_elisa_proof(&rendered, report, focused_goal_id, source_fingerprint, source_complete, source_admissible)
        proof_write(rendered)
        return 0 if focused_goal_id < report.goal_attempts.count else 2
    if theorem_json_output:
        source_complete: bool = report.failed == 0 and not proof_report_has_open_goals(report) and report.replay_gaps == 0 and semantic_errors == 0 and not import_failed
        source_admissible: bool = not import_failed and semantic_errors == 0 and report.replay_gaps == 0
        catalog: mutable darray[u8] = []
        proof_push_json_theorem_catalog(&catalog, report, source_bytes, source_fingerprint, source_complete, source_admissible)
        proof_write(catalog)
        return 0
    if suggestion_json_output:
        source_complete: bool = report.failed == 0 and not proof_report_has_open_goals(report) and report.replay_gaps == 0 and semantic_errors == 0 and not import_failed
        source_admissible: bool = not import_failed and semantic_errors == 0 and report.replay_gaps == 0
        suggestions: mutable darray[u8] = []
        proof_push_json_suggestions(&suggestions, report, file.enum_annotations, focused_goal_id, source_bytes, source_fingerprint, source_complete, source_admissible)
        proof_write(suggestions)
        return 0 if focused_goal_id < report.goal_attempts.count else 2
    if repair_output or repair_all_output:
        source_admissible: bool = not import_failed and semantic_errors == 0 and report.replay_gaps == 0
        response: mutable darray[u8] = []
        if repair_all_output:
            # The whole unresolved queue in one pass, in goal order. A goal the checker already
            # proved is not a repair target: only what the report still reports as open is tried.
            repaired_count: mutable usize = 0
            unresolved_count: mutable usize = 0
            entries: mutable darray[u8] = []
            for goal_index in 0..<report.goal_attempts.count |goal_index, report, entries, repaired_count, unresolved_count|:
                continue if report.goal_attempts[goal_index].proven
                unresolved_count <- unresolved_count + 1
                batch_found: (repaired: bool, searched: usize, actions: sview) = proof_repair_search(report, goal_index)
                repaired_count <- repaired_count + 1 if batch_found.repaired
                proof_push(&entries, ",") if unresolved_count > 1
                proof_push_repair_goal(&entries, report, goal_index, batch_found)
            proof_push(&response, "{\"format\":\"elisa-proof-repair-batch-v1\",\"status\":")
            if unresolved_count == 0:
                proof_push(&response, "\"nothing_to_repair\"")
            else:
                proof_push(&response, "\"repaired\"" if repaired_count == unresolved_count else "\"partial\"")
            proof_push(&response, ",\"source\":{\"fingerprint\":")
            proof_push_number(&response, source_fingerprint)
            proof_push(&response, ",\"admissible\":")
            proof_push(&response, "true" if source_admissible else "false")
            proof_push(&response, "},\"summary\":{\"unresolved\":")
            proof_push_number(&response, unresolved_count.u32())
            proof_push(&response, ",\"repaired\":")
            proof_push_number(&response, repaired_count.u32())
            proof_push(&response, ",\"candidates\":")
            proof_push_number(&response, proof_repair_candidates().count.u32())
            proof_push(&response, "},\"goals\":[")
            for entry_index in 0..<entries.count |entry_index, response, entries|:
                response.push(entries[entry_index])
            proof_push(&response, "]}\n")
            proof_write(response)
            return 0 if repaired_count == unresolved_count else 1
        found: (repaired: bool, searched: usize, actions: sview) = proof_repair_search(report, focused_goal_id)
        proof_push(&response, "{\"format\":\"elisa-proof-repair-v1\",\"status\":")
        if focused_goal_id >= report.goal_attempts.count:
            proof_push(&response, "\"not_found\"")
        else:
            proof_push(&response, "\"repaired\"" if found.repaired else "\"unrepaired\"")
        proof_push(&response, ",\"goal_id\":")
        proof_push_number(&response, focused_goal_id.u32())
        proof_push(&response, ",\"source\":{\"fingerprint\":")
        proof_push_number(&response, source_fingerprint)
        proof_push(&response, ",\"admissible\":")
        proof_push(&response, "true" if source_admissible else "false")
        proof_push(&response, "},\"search\":{\"candidates\":")
        proof_push_number(&response, proof_repair_candidates().count.u32())
        proof_push(&response, ",\"tried\":")
        proof_push_number(&response, found.searched.u32())
        proof_push(&response, ",\"exhaustive\":")
        proof_push(&response, "false" if found.repaired else "true")
        proof_push(&response, "},\"script\":")
        if found.repaired:
            script_body: mutable darray[u8] = []
            proof_repair_push_script_text(&script_body, report, focused_goal_id, found.actions)
            proof_push_json_bytes(&response, script_body)
        else:
            proof_push(&response, "null")
        proof_push(&response, "}\n")
        proof_write(response)
        return 2 if focused_goal_id >= report.goal_attempts.count else (0 if found.repaired else 1)
    if tactic_json_output:
        source_status: mutable sview = "proved"
        source_status <- "failed" if report.failed > 0 or proof_report_has_open_goals(report) or report.replay_gaps > 0 or semantic_errors > 0
        source_admissible: bool = not import_failed and semantic_errors == 0 and report.replay_gaps == 0
        script_source: mutable darray[u8] = proof_read_file(slots[script_slot].cast[cstr])
        # A human-written script is translated into the same interchange a JSON script uses, so it
        # runs through exactly the checked engine and gains no path of its own.
        script_source <- proof_tactic_text_to_json(script_source) if script_is_text
        # A source-bound tactic state must be rebuilt in the tactic store. AST values are opaque
        # handles tied to the imported parser store, so export the selected attempt to the same
        # JSON expression interchange used by --json and reparse it below in the fresh store.
        source_target_state: mutable darray[u8] = []
        source_script_arena: mutable Arena = zeroed
        if script_source.count > 0:
            source_script: JsonParseResult = json_parse_checked(&source_script_arena, sview(&script_source[0], 0, script_source.count.i64()))
            if source_script.code == JsonErrorCode.OK:
                source_target: (present: bool, valid: bool, goal_id: usize) = proof_tactic_json_target(source_script.value)
                if source_target.present and source_target.valid and source_target.goal_id < report.goal_attempts.count:
                    source_attempt: ProofGoalAttempt = report.goal_attempts[source_target.goal_id]
                    if source_attempt.facts_start <= report.certificate_facts.count and source_attempt.facts_count <= report.certificate_facts.count - source_attempt.facts_start:
                        proof_push(&source_target_state, "{\"facts\":[")
                        for fact_index in 0..<source_attempt.facts_count |fact_index, source_attempt, report, source_target_state|:
                            proof_push(&source_target_state, ",") if fact_index > 0
                            proof_push_json_expr(&source_target_state, report.certificate_facts[source_attempt.facts_start + fact_index])
                        proof_push(&source_target_state, "],\"goal\":")
                        proof_push_json_expr(&source_target_state, source_attempt.goal)
                        proof_push(&source_target_state, "}")
        region tactic_region(1048576):
            store: Ast::Node.Store[Local] = Ast::Node.Store(tactic_region)
            in store:
                empty: mutable darray[Ast::Expr] = []
                tactic_state: mutable ProofTacticState = proof_tactic_state(&empty, Ast::Expr.Invalid)
                tactic_result: mutable ProofTacticJsonResult = ProofTacticJsonResult{valid: false, solved: false, trace_replayed: false, kernel_trace_replayed: false, kernel_replayed: false, certificate_replayed: false, branch_present: false, branch_certificate_replayed: false, action_count: 0, accepted_count: 0, reason: "proof script could not be read", tree_node: 0}
                source_match: mutable bool = false
                target_bound: mutable bool = false
                target_goal_id: mutable usize = 0
                target_goal_fingerprint: mutable u32 = 0
                target_fingerprint_valid: mutable bool = false
                target_fingerprint_match: mutable bool = true
                target_previously_proven: mutable bool = false
                script_arena: mutable Arena = zeroed
                scratch_empty: mutable darray[Ast::Expr] = []
                scratch_states: mutable darray[ProofTacticState] = []
                for scratch_index in 0..<64 |scratch_index, scratch_empty, scratch_states|:
                    scratch_states.push(proof_tactic_state(&scratch_empty, Ast::Expr.Invalid))
                tactic_tree: mutable ProofTacticJsonTree = ProofTacticJsonTree{states: [], left: [], right: [], has_branch: []}
                if script_source.count > 0:
                    parsed_script: JsonParseResult = json_parse_checked(&script_arena, sview(&script_source[0], 0, script_source.count.i64()))
                    if parsed_script.code == JsonErrorCode.OK:
                        annotations: mutable darray[Ast::EnumAnnotation] = []
                        target: (present: bool, valid: bool, goal_id: usize) = proof_tactic_json_target(parsed_script.value)
                        target_bound <- target.present
                        target_goal_id <- target.goal_id
                        target_previously_proven <- report.goal_attempts[target.goal_id].proven if target.present and target.valid and target.goal_id < report.goal_attempts.count
                        if target.present and target.valid and target.goal_id < report.goal_attempts.count:
                            computed_target_fingerprint: (valid: bool, value: u32) = proof_goal_fingerprint(report, report.goal_attempts[target.goal_id])
                            target_fingerprint_valid <- computed_target_fingerprint.valid
                            target_goal_fingerprint <- computed_target_fingerprint.value
                        if target.present:
                            if target.valid:
                                if source_target_state.count > 0:
                                    parsed_source_state: JsonParseResult = json_parse_checked(&script_arena, sview(&source_target_state[0], 0, source_target_state.count.i64()))
                                    tactic_result <- proof_tactic_json_run_source(parsed_script.value, parsed_source_state.value, &annotations, &tactic_state, &tactic_tree, &scratch_states, report, target.goal_id) if parsed_source_state.code == JsonErrorCode.OK
                            else:
                                tactic_result.valid <- false
                                tactic_result.reason <- "target.goal_id must be an exact nonnegative integer"
                        else:
                            tactic_result <- proof_tactic_json_run(parsed_script.value, &annotations, &tactic_state, &tactic_tree, &scratch_states)
                        declared_target_fingerprint: (present: bool, valid: bool, value: u32) = proof_tactic_json_target_fingerprint(parsed_script.value)
                        if declared_target_fingerprint.present:
                            target_fingerprint_match <- declared_target_fingerprint.valid and target.present and target.valid and target_fingerprint_valid and declared_target_fingerprint.value == target_goal_fingerprint
                            if not declared_target_fingerprint.valid:
                                tactic_result.valid <- false
                                tactic_result.reason <- "target.goal_fingerprint must be an exact unsigned 32-bit integer"
                            elif not target_fingerprint_match:
                                tactic_result.valid <- false
                                tactic_result.reason <- "target.goal_fingerprint does not match the imported kernel goal and hypotheses"
                        declared: (present: bool, valid: bool, value: u32) = proof_tactic_json_source_fingerprint(parsed_script.value)
                        source_match <- not declared.present or declared.valid and declared.value == source_fingerprint
                        if declared.present and not declared.valid:
                            source_match <- false
                            tactic_result.valid <- false
                            tactic_result.reason <- "source_fingerprint must be an exact unsigned 32-bit integer"
                        elif declared.present and declared.value != source_fingerprint:
                            source_match <- false
                            tactic_result.valid <- false
                            tactic_result.reason <- "proof script source_fingerprint does not match imported Elisa"
                    else:
                        source_match <- false
                        tactic_result.reason <- "proof script is not valid JSON"
                output: mutable darray[u8] = []
                proof_push_json_tactic_result(&output, tactic_result, &tactic_state, &tactic_tree, source_bytes, source_fingerprint, source_status, source_admissible, source_match, target_bound, target_goal_id, target_goal_fingerprint, target_fingerprint_valid, target_fingerprint_match, target_previously_proven)
                proof_write(output)
                admitted: bool = proof_tactic_result_admitted(tactic_result, source_status, source_admissible, source_match, target_bound)
                return 0 if admitted else 1
    if json_output:
        json: mutable darray[u8] = []
        proof_push_json_report(&json, report, semantic_diagnostics, semantic_visible, semantic_errors, source_bytes, source_fingerprint)
        proof_write(json)
        return 1 if report.failed > 0 or proof_report_has_open_goals(report) or report.replay_gaps > 0 or semantic_errors > 0 else 0
    output: mutable darray[u8] = []
    proof_push(&output, "Elisa Proof\n")
    proof_push(&output, "  verification state: ")
    proof_push(&output, proof_report_verification_state(report, semantic_errors))
    proof_push(&output, "\n")
    proof_push(&output, "  declarations: ")
    proof_push_number(&output, report.declarations)
    proof_push(&output, "\n  obligations: ")
    proof_push_number(&output, report.obligations)
    proof_push(&output, "\n  proven: ")
    proof_push_number(&output, report.proven)
    proof_push(&output, "\n  failed: ")
    proof_push_number(&output, report.failed)
    proof_push(&output, "\n")
    for finding in report.findings |output|:
        proof_push(&output, "  ")
        proof_push(&output, finding.kind)
        proof_push(&output, " [")
        proof_push(&output, finding.status)
        proof_push(&output, "]")
        proof_push(&output, " line ")
        proof_push_number(&output, finding.line)
        proof_push(&output, ": ")
        proof_push(&output, finding.message)
        proof_push(&output, "\n")
    proof_push(&output, "  semantic diagnostics: ")
    proof_push_number(&output, semantic_visible)
    proof_push(&output, "\n")
    proof_push(&output, "  certificate replay: ")
    proof_push_number(&output, report.replayed)
    proof_push(&output, " replayed, ")
    proof_push_number(&output, report.replay_gaps)
    proof_push(&output, " gaps\n")
    proof_push(&output, "  source-neutral kernel: ")
    proof_push_number(&output, report.kernel_nodes.count.u32())
    proof_push(&output, " nodes, format elisa-proof-kernel-v1\n")
    for diagnostic in semantic_diagnostics |output, report|:
        continue if diagnostic.kind == Semantic::DiagnosticKind.AssertByUnproven
        continue if diagnostic.kind == Semantic::DiagnosticKind.MutualDecreasesCycle and any verified_name in report.structural_verified_names where verified_name == diagnostic.name
        proof_push(&output, "  semantic line ")
        proof_push_number(&output, diagnostic.line)
        proof_push(&output, ": ")
        message: darray[u8] = Semantic::diagnostic_message(diagnostic)
        output.extend(message)
        proof_push(&output, "\n")
    proof_write(output)
    return 1 if report.failed > 0 or proof_report_has_open_goals(report) or report.replay_gaps > 0 or semantic_errors > 0 else 0

def main(argc: i64, argv: mutable void&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
    return proof_main(argc, argv)
