# Elisa Proof command-line facade. Compiler imports and proof modules stay at the boundary;
# application I/O, rendering, repair, and CLI orchestration live in focused source modules.
include "../../Elisa-compiler/src/semantic/semantic.elisa"
include "../../Elisa-compiler/elisacore_std/elisacore_json.elisa"
include "./proof/kernel_core.elisa"
include "./proof/model.elisa"
include "./proof/kernel.elisa"
include "./proof/expr.elisa"
include "./proof/linear.elisa"
include "./proof/resources.elisa"
include "./proof/check.elisa"
include "./proof/kernel_replay.elisa"
include "./proof/replay.elisa"
include "./proof/import.elisa"
include "./proof/tactics.elisa"
include "./proof/tactic_json.elisa"

using Ast
using Semantic
using ElisaProof

extern open(path: cstr, flags: i64, ...) -> i64
extern close(fd: i64) -> i64
extern read(fd: i64, buf: u8&, count: usize) -> i64
extern getcwd(buffer: void&, size: usize) -> void&

include "./app/runtime.elisa"
include "./app/json_core.elisa"
include "./app/repair.elisa"
include "./app/proof_output.elisa"
include "./app/theorem_output.elisa"
include "./app/report_output.elisa"
include "./app/cli.elisa"

def main(argc: i64, argv: mutable void&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Console]:
    return proof_main(argc, argv)
