# `elisa-proof-replay`: the portable package checker. It links the source-neutral kernel, the
# JSON reader, and the package reader, and nothing else: no compiler front end, no search
# engine, no tactic language, no AI client. Everything it trusts is listed in the result.
#
# usage: elisa-proof-replay <package.json>
#   exit 0  every theorem of a nonempty package replayed
#   exit 1  the package is malformed, over budget, empty, or has a theorem that did not replay
#   exit 2  usage error or unreadable package
include "../../Elisa-compiler/elisacore_std/elisacore_runtime_prelude.elisa"
include "../../Elisa-compiler/elisacore_std/collections.elisa"
include "../../Elisa-compiler/elisacore_std/elisacore_runtime_strings.elisa"
include "../../Elisa-compiler/elisacore_std/elisacore_json.elisa"
using Json

include "./app/json_boundary.elisa"
include "./proof/kernel_core.elisa"
include "./proof/kernel_replay.elisa"
# The compiler front end declares `write` for the main tool; this checker links without it.
extern write(fd: i32, buf: void&, count: usize) -> isize can[Console]

include "./app/portable_io.elisa"
include "./portable/package_reader.elisa"
include "./portable/package_checker.elisa"

def main(argc: i64, argv: mutable void&) -> i64 can[Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast, Console]:
    message: mutable darray[u8] = []
    if argc != 2:
        proof_push(&message, "usage: elisa-proof-replay <package.json>\n")
        proof_write(&message)
        return 2
    slots: mutable cstr&& = argv.cast[mutable cstr&&]
    read: (ok: bool, contents: darray[u8]) = proof_read_file_checked(slots[1].cast[cstr])
    if not read.ok:
        proof_push(&message, "{\"format\":\"")
        proof_push(&message, PROOF_PACKAGE_RESULT_FORMAT)
        proof_push(&message, "\",\"status\":\"unreadable\",\"reason\":\"could not read package\"}\n")
        proof_write(&message)
        return 2
    status: i64 = proof_package_replay(&read.contents, &message)
    proof_write(&message)
    return status
