# A wrapper that permutes same-region arguments must preserve the exact returned formal.
# Returning the first argument of choose_sview_first(second, first) borrows `second`, not
# `first`; a summary inferred from the last read of the call arguments can get this wrong.
def choose_sview_first[@r](first: darray[u8]& @r, second: darray[u8]& @r) -> sview @r:
    return first.as_sview()

def swap_sview_arguments[@r](first: darray[u8]& @r, second: darray[u8]& @r) -> sview @r:
    return choose_sview_first(second, first)

def rejected_sview_call_return_wrong_provenance() -> usize can[Memory.Allocate, Abort.Panic]:
    observed_length: mutable usize = 0
    region scratch(64)
    first: mutable darray[u8] @scratch = [65]
    second: mutable darray[u8] @scratch = [66]
    if true:
        view: sview @scratch = swap_sview_arguments(first, second)
        second.push(67)
        observed_length <- view.len
    destroy scratch
    return observed_length

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    return 0
