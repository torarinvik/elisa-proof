# A fixed-array struct field keeps its type's exact count, reached through the parameter
# that holds the record. A qualified extent (`Slots::CAPACITY`) is resolved only when
# exactly one immutable integer constant with a literal value declares it. The index
# proof still needs an ordinary theorem; the type only supplies the count equality.
module Slots:
    public:
        const CAPACITY: usize = 8

        struct Table:
            live: mutable bool[Slots::CAPACITY]
            weight: mutable u32[Slots::CAPACITY]
            grid: mutable array[array[i64, 3], 2]
            total: mutable u64

        struct Shelf:
            table: Table
            spare: u8[4]

        # The guard names the extent bare; the importer unfolds it because it is the
        # extent of an indexed place, although no contract mentions it.
        def live_at(table: Table&, slot: usize) -> bool:
            return slot < CAPACITY and table.live[slot]

        def weight_at(table: Table&, slot: usize) -> u32:
            requires slot < CAPACITY
            return table.weight[slot]

        def set_weight(table: mutable Table&, slot: usize, weight: u32) -> void:
            requires slot < CAPACITY
            table.weight[slot] <- weight

        def cell(table: Table&, row: usize, column: usize) -> i64:
            requires row < 2
            requires column < 3
            return table.grid[row, column]

        def shelf_weight(shelf: Shelf&, slot: usize, spare: usize) -> u32:
            requires slot < CAPACITY
            requires spare < 4
            return table_weight_or_spare(shelf, slot, spare)

        def table_weight_or_spare(shelf: Shelf&, slot: usize, spare: usize) -> u32:
            requires slot < CAPACITY
            requires spare < 4
            return shelf.table.weight[slot] if shelf.spare[spare] == 0 else 0

        # A contract over a `bool[Slots::CAPACITY]` element is typed like one over `bool[8]`.
        def live_flag(table: Table&, slot: usize) -> bool:
            requires slot < CAPACITY
            ensure result == table.live[slot]
            return table.live[slot]
