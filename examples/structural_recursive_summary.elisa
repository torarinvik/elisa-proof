# A structurally recursive call on a variant payload instantiates the callee's own summary. The
# positional payload binder has no source place, so it becomes a fresh opaque symbol that the
# recursive `ensure` can be instantiated at.

enum Nat:
    Zero
    Succ(prev: Nat)

def structural_zero(n: Nat) -> i64:
    decreases n
    ensure result == 0
    match n:
        Nat.Zero:
            return 0
        Nat.Succ(prev):
            return structural_zero(prev)

def uses_structural_zero(n: Nat) -> i64:
    ensure result == 0
    return structural_zero(n)
