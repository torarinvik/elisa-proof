# A named-tuple result over a region handle, bound to a local, keeps each scalar label's
# declared type, so the callee's summaries over those labels are usable after the binding.

def pick_count[@r](value: JsonValueHandle[r]) -> (count: i64, value: JsonValueHandle[r]):
    ensure result.count >= 0
    ensure result.count <= 100
    return (1, value)

def pick_small[@r](value: JsonValueHandle[r]) -> (small: u8, value: JsonValueHandle[r]):
    ensure result.small <= 200
    return (7, value)

def count_positive[@r](value: JsonValueHandle[r]) -> i64:
    ensure result >= 1
    found: (count: i64, value: JsonValueHandle[r]) = pick_count(value)
    return found.count + 1

def small_sum[@r](value: JsonValueHandle[r]) -> u8:
    ensure result <= 250
    found: (small: u8, value: JsonValueHandle[r]) = pick_small(value)
    return found.small + 50
