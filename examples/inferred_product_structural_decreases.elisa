# With no explicit decreases clause, multiple enum parameters use a product ranking.
# The first subject strictly descends while the second is preserved.
enum ProductNat:
    Zero
    Succ(prev: ProductNat)

def inferred_product_size(left: ProductNat, right: ProductNat) -> i64:
    match left:
        ProductNat.Zero:
            return 0
        ProductNat.Succ(prev):
            return inferred_product_size(prev, right)

