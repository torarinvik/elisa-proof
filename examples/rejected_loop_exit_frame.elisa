# The loop writes `a`, so the entry fact `a < 10` does not survive it.
def written_after_loop(a: mutable i64, n: usize) -> i64:
    requires a < 10
    ensures result < 10
    k: mutable usize = 0
    while k < n:
        invariant k <= n
        a <- a + 1
        k <- k + 1
    return a

# An element write changes the cell named by the entry fact.
def element_written_after_loop(xs: mutable darray[i64]&, n: usize) -> i64:
    requires 0 < xs.count
    requires xs[0] == 3
    ensures result == 3
    k: mutable usize = 0
    while k < n:
        invariant k <= n
        xs[0] <- 4
        k <- k + 1
    return xs[0]

def bump(v: mutable i64&) -> void:
    v <- v + 1

# A call through a mutable reference writes `a`.
def call_written_after_loop(n: usize) -> i64:
    ensures result == 0
    a: mutable i64 = 0
    k: mutable usize = 0
    while k < n:
        invariant k <= n
        bump(&a)
        k <- k + 1
    return a
