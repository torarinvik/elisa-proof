# Fixed-array parameters carry an exact count in their type. The proof still
# requires an ordinary index theorem; the type only supplies the count equality.

def fixed_read_shorthand(values: i64[4]&, index: usize) -> i64:
    requires index < 4
    return values[index]

def fixed_read_generic(values: array[i64, 4]&, index: usize) -> i64:
    requires index < 4
    return values[index]
