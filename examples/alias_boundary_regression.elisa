def snapshot_then_write(first: mutable i64&, second: mutable i64&) -> i64:
    requires first == 7
    ensures result == 7
    saved: i64 = first.i64()
    second <- 9
    return saved

def nonalias_call_positive(first: mutable i64&, second: mutable i64&) -> i64:
    requires first == 7
    ensures result == 7
    return snapshot_then_write(first, second)

def unsafe_alias_call_negative(first: mutable i64&) -> i64 can[Unsafe.Alias]:
    requires first == 7
    can Unsafe.Alias:
        return snapshot_then_write(first, first)
