# A borrow may be used during an expression-position catch without escaping when every resulting
# arm is an ordinary value. Resource call summaries and result-specific boundary checks cooperate
# here: temporary capability use is accepted, reference results remain guarded. Expression-match
# calls remain a separate logical-layer limitation and are covered by the negative probe.
error BorrowNestedExpressionError:
    Bad

def borrow_nested_catch_reader(value: i64&) -> i64 error[BorrowNestedExpressionError]:
    return value

def borrow_nested_expression(x: mutable i64) -> i64:
    view: i64& = &x
    return catch borrow_nested_catch_reader(&x):
        value:
            value
        BorrowNestedExpressionError.Bad:
            x
