# Exact pure result summaries compose independently at each fixed-array dimension.

def identity_index(index: usize) -> usize:
    ensure result == index
    return index

def safe_indexn_call(matrix: array[array[i64, 4], 4]&, row: usize, column: usize) -> i64:
    requires row < 4 and column < 4
    return matrix[identity_index(row), identity_index(column)]
