# 10 + 255 = 265: one below that bound is false.

def base(x: i64) -> i64:
    requires x >= 0
    ensure result >= 0
    ensure result <= 10
    return 0 if x > 10
    return x

def too_tight(x: i64, d: u8) -> i64:
    requires x >= 0
    ensure result <= 264
    later: i64 = base(x)
    return later + d.i64()
