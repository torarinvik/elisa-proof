module UnsignedRemainderRange:
    public:
        def remainder_below_positive_divisor(value: u32) -> u32:
            ensure result < 1000
            return value % 1000

        def conditional_rounded_quotient(value: u32, round_up: u8) -> u32:
            requires value < 1000000000
            requires round_up <= 1
            ensure result <= 1000
            if round_up == 1 and value % 1000000 != 0:
                return value / 1000000 + 1
            else:
                return value / 1000000

        def quotient_successor_lower_bound(value: u32) -> u32:
            requires value < 1000000000
            ensure result >= value / 1000000
            return value / 1000000 + 1

        def quotient_successor_upper_bound(value: u32) -> u32:
            requires value < 1000000000
            ensure value / 1000000 <= result
            return value / 1000000 + 1

        def wrapping_successor_control(value: u32) -> u32:
            ensure result >= value
            return value + 1

        def untrue_tighter_remainder_bound(value: u32) -> u32:
            ensure result < 999
            return value % 1000

        def bounded_scaled_product(value: u64, ceiling: u64) -> u64:
            requires value <= ceiling / 1000
            ensure result <= ceiling
            return value * 1000

        def mismatched_scaled_product_control(value: u32, ceiling: u32) -> u32:
            requires value <= ceiling / 1000
            ensure result <= ceiling
            return value * 1001
