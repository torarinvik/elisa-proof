# Void returns still discharge ordinary postconditions.

def checked_void(x: i64) -> void:
    requires x >= 0
    ensure x >= 0
    return

def terminating_decrement(x: i64) -> i64:
    requires x >= 0
    ensure result == 0
    value: mutable i64 = x
    while value > 0:
        invariant value >= 0
        decreases value
        value <- value - 1
    return value
