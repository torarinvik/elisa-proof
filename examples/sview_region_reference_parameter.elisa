# A view made through a region-bound reference borrows the same region, even though the
# reference itself is not the region allocation's owner token.
def read_region_sview[@r](bytes: mutable darray[u8]& @r) -> i64:
    view: sview = bytes.as_sview()
    return view.len.i64()

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    region scratch(64)
    bytes: mutable darray[u8] @scratch = [65]
    observed_length: i64 = read_region_sview(bytes)
    destroy scratch
    return observed_length
