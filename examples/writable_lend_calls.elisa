# A call that lends only references the caller already holds needs no callee body summary. A
# shared lend changes nothing; an exclusive lend can do no more than write through the reference,
# because Elisa forbids moving out of one and the capability ends with the call. The caller can
# therefore over-approximate the whole call by a write to each exclusively lent place — which is
# what makes a recursive component that mutates through a reference parameter checkable at all.
struct Cell:
    value: mutable i64
    tag: mutable i64

# Self-recursion writing through a mutable reference parameter. No summary of this function is
# available while it is being checked, so only the confined-lend rule can admit the call.
def bump(cell: mutable Cell&, depth: usize) -> void:
    requires depth <= 127
    decreases 127 - depth
    return if depth >= 127
    cell.value <- cell.value + 1
    bump(cell, depth + 1)

# An exclusive lend beside a shared one, over places that cannot overlap.
def bump_guarded(cell: mutable Cell&, limit: i64&, depth: usize) -> void:
    requires depth <= 127
    decreases 127 - depth
    return if depth >= 127 or cell.value >= limit
    cell.tag <- cell.tag + 1
    bump_guarded(cell, limit, depth + 1)

# Two exclusive lends at once. Both actuals must be places the caller may write and that do not
# overlap each other, since both capabilities are live while the callee runs.
def shift(first: mutable Cell&, second: mutable Cell&, depth: usize) -> void:
    requires depth <= 127
    decreases 127 - depth
    return if depth >= 127
    first.value <- first.value + 1
    shift(second, first, depth + 1)

def shift_owned() -> i64:
    left: mutable Cell = Cell{value: 0, tag: 0}
    right: mutable Cell = Cell{value: 0, tag: 0}
    shift(&left, &right, 0)
    return left.value + right.value

# The caller owns the value outright, so lending it exclusively is a write it is entitled to make.
def bump_owned() -> i64:
    owned: mutable Cell = Cell{value: 0, tag: 0}
    bump(&owned, 0)
    return owned.value
