struct CustomConversion:
    value: mutable i64

def rejected_custom_conversion_frame(source: mutable CustomConversion&) -> i64:
    preserves source.value
    converted: usize = source.usize()
    return 0

def rejected_integer_method_with_argument(source: i64) -> usize:
    ensure result == 0
    return source.usize(1)
