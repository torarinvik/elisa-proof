# The same body under `exists` and `forall`: only the `exists` holds. Encoded terms are shared
# across goals, and a quantifier's kind is bound after encoding, so a shared quantifier node would
# let the true `exists` be read back as the false `forall`. The `forall` must stay unproven.

def witness_only() -> i64:
    ensure exists i in 0 ..< 3: i == 1
    ensure forall i in 0 ..< 3: i == 1
    return 0

def witness_then_bound() -> i64:
    ensure forall i in 0 ..< 3: i == 1
    ensure exists i in 0 ..< 3: i == 1
    return 0
