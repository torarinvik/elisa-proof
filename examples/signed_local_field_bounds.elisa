extern opaque16() -> i16
extern opaque8() -> i8

struct Pair:
    a: i16
    b: i8

def local() -> i16:
    ensure result >= -32767 - 1
    ensure result <= 32767
    x: i16 = opaque16()
    return x

def field(p: Pair) -> i16:
    ensure result <= 32767
    ensure result >= -32767 - 1
    return p.a

def local_half() -> i16:
    ensure result <= 16383
    x: i16 = opaque16()
    return x / 2

def field_half(p: Pair) -> i16:
    ensure result <= 16383
    return p.a / 2

def narrow_local() -> i8:
    ensure result >= -127 - 1
    ensure result <= 127
    y: i8 = opaque8()
    return y

def narrow_field(p: Pair) -> i8:
    ensure result <= 127
    return p.b
