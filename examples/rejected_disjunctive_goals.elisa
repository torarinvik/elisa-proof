# The negated-premise rule proves `A or B` only when `B` follows from `not A`. Each ensure
# below is false for some input, so each must stay unproven. The last one would pass if the
# rule assumed the left disjunct instead of its negation.
module Pool:
    public:
        def rejected_either(a: bool, b: bool) -> bool:
            ensure not result or a
            a or b

        def rejected_bound(x: i64, y: i64) -> bool:
            ensure not result or x < 4
            x < 5 and y > 0

        def rejected_wrong_side(x: i64) -> bool:
            ensure result or x > 5
            x > 10
