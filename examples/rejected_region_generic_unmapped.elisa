# A generic region allocation with no explicit caller-region witness must not be
# admitted by the verifier. The compiler may lower its ambient arena choice, but
# the proof system cannot manufacture a lifetime map from a scalar argument.
def allocate[@r](value: i64) -> void:
    new[r] value

def main() -> i64:
    region scratch(1024)
    allocate(7)
    destroy scratch
    return 0
