# A binding that holds its value rather than a reference to one is this frame's own storage, so a
# callee has no path to it unless the frame lent it -- which the aliasing record already tracks.
# The by-value scalar case has always used that argument. Its fields deserve the same: a callee
# that cannot reach `node` cannot reach `node.children_start` either.
#
# The rule that decides this returned false for any field but `.count`, and admitted that one only
# for a parameter bound by a shared borrow. So a fact about `node.children_start` was discarded at
# the first call in the body, whatever the call was.

extend ValueRootField:
    struct Node:
        children_start: usize
        children_count: usize

    def grow(values: mutable darray[usize]&) -> usize:
        values.push(1)
        return values.count

    def a_field_of_a_value_parameter_survives_a_call(node: Node, other: mutable darray[usize]&) -> bool:
        requires node.children_start <= 8
        ensure result
        grown: usize = grow(other)
        return node.children_start <= 8

    def a_second_field_survives_it_too(node: Node, other: mutable darray[usize]&) -> bool:
        requires node.children_count <= 8
        ensure result
        grown: usize = grow(other)
        return node.children_count <= 8
