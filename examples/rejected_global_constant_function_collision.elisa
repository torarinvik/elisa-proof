# Two module-local functions share a bare name, and each module has its own LIMIT. Owners are
# keyed by declaration line, so First::check proves from First's LIMIT while Second::check,
# whose LIMIT is 11, must not borrow First's value and stays unproven.
module First:
    const LIMIT: i64 = 10
    def check() -> i64:
        ensure result == 10
        LIMIT

module Second:
    const LIMIT: i64 = 11
    def check() -> i64:
        ensure result == 10
        LIMIT
