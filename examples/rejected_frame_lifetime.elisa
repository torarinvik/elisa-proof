# The boundary of frame-lifetime pinning. The frame satisfies a lifetime only for a place the
# caller holds outright, and only when some actual actually receives that lifetime: a moved binding
# is no longer held, and a lifetime no parameter carries is pinned by nothing at all.
struct Cell:
    value: mutable i64

def visit[@s](cell: mutable Cell& @s, depth: usize) -> usize:
    requires depth <= 127
    decreases 127 - depth
    return 0 if depth >= 127
    return visit(cell, depth + 1)

# The local was moved away before the call, so the caller no longer holds the place its frame
# would have been vouching for.
def lends_moved_local() -> usize:
    local: mutable Cell = Cell{value: 0}
    taken: mutable Cell = move local
    seen: usize = visit(&local, 0)
    return seen

# A lifetime parameter no formal carries. Nothing at the call site says which extent the callee is
# allowed to allocate into, and the caller's frame vouches for no place in particular.
def unreceived_lifetime[@s](count: usize, depth: usize) -> usize:
    requires depth <= 127
    decreases 127 - depth
    return 0 if depth >= 127
    return unreceived_lifetime(count, depth + 1)
