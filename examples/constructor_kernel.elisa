# Record constructions and updates retain their type/base and field structure in the replay arena.
struct Pair:
    left: i64
    right: i64

def constructor_reflexive(x: i64) -> void:
    proof Pair{left: x, right: 0} == Pair{left: x, right: 0}:
        assert Pair{left: x, right: 0} == Pair{left: x, right: 0}

def update_reflexive(pair: Pair, x: i64) -> void:
    proof pair{left = x} == pair{left = x}:
        assert pair{left = x} == pair{left = x}
