# Record constructions and updates retain their type/base and field structure in the replay arena.
# Equality between two constructions is a user `__eq__` (see `rejected_aggregate_equality.elisa`),
# so the obligations here either project a scalar field out of the aggregate, which the producer
# reduces before lowering, or pass the aggregate to a verified pure function, where the exact
# child graph must reach the arena for the hypothesis to contain the goal.
struct Pair:
    left: i64
    right: i64

def take(p: Pair) -> i64:
    return p.left

def constructor_projection(x: i64) -> void:
    proof Pair{left: x, right: 0}.left == x:
        assert Pair{left: x, right: 0}.left == x

def update_projection(pair: Pair, x: i64) -> void:
    proof pair{left = x}.left == x:
        assert pair{left = x}.left == x

def update_preserved_projection(pair: Pair, x: i64) -> void:
    proof pair{left = x}.right == pair.right:
        assert pair{left = x}.right == pair.right

def constructor_argument(x: i64) -> i64:
    requires take(Pair{left: x, right: 0}) == 3
    ensure take(Pair{left: x, right: 0}) == 3
    return 0

def update_argument(pair: Pair, x: i64) -> i64:
    requires take(pair{left = x}) == 3
    ensure take(pair{left = x}) == 3
    return 0
