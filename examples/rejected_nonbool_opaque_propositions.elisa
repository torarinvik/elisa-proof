# These source obligations are deliberately non-Boolean. The source adapter must not turn
# their source-neutral call/field/index encodings into propositions by exact containment.
struct OpaqueValues:
    count: i64

def integer_value() -> i64:
    return 1

def rejected_nonbool_call() -> i64:
    ensure integer_value()
    return 0

def rejected_nonbool_field(value: OpaqueValues&) -> i64:
    ensure value.count
    return 0

def rejected_nonbool_index(values: darray[i64]&) -> i64:
    ensure values[0]
    return 0

def rejected_nested_nonbool_call() -> bool:
    requires integer_value() and true
    ensure true
    return true
