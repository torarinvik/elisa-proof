# A user ordering operator on a float-bearing struct is not a primitive comparison atom:
# its two evaluations need not agree, so excluded middle over it must not be assumed.
protocol Less:
    def __lt__(self: Self, other: Self) -> bool

struct Reading:
    value: f64

impl Less for Reading:
    def __lt__(self: Reading, other: Reading) -> bool:
        return self.value < other.value

def rejected_float_struct_operator(left: Reading, right: Reading) -> bool:
    ensures result
    if left < right:
        return true
    not (left < right)
