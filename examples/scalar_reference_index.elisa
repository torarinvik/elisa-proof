# References to scalar values are one-element places. Only the zero subscript is valid.
module WbRuntime:
    public:
        const RESOURCE_ACCOUNTING_ALLOWED: u8 = 1

def reference_read(value: usize&) -> usize:
    ensure result == value[0]
    return value[0]

def reference_update(value: mutable usize&) -> usize:
    requires value[0] <= 9223372036854775806
    ensure value[0] == old(value[0]) + 1
    value[0] <- value[0] + 1
    return value[0]

# Numeric casts are primitive conversions, so the symbolic post-state of a
# scalar reference write keeps the exact converted expression.
def reference_byte_cast(value: mutable u8&, raw: usize) -> u8:
    ensure value[0] == raw.u8()
    value[0] <- raw.u8()
    return value[0]

def reference_reset(value: mutable usize&) -> void:
    value[0] <- 0
    return

def reference_disjunctive_update(value: mutable usize&, status: u8) -> u8:
    requires value[0] <= 9223372036854775806
    ensure status != WbRuntime::RESOURCE_ACCOUNTING_ALLOWED or value[0] == old(value[0]) + 1
    value[0] <- value[0] + 1
    return status

def reference_observe_entry(value: usize&) -> usize:
    ensure result == old(value[0])
    return value[0]

def reference_observe_through_call(value: usize&) -> usize:
    ensure result == old(value[0])
    return reference_observe_entry(value)

def reference_observe_false(value: usize&) -> usize:
    ensure result == old(value[0]) + 1
    return reference_observe_entry(value)

def reference_observe_after_impure_call(value: usize&, other: mutable usize&) -> usize:
    ensure result == old(value[0])
    reference_reset(other)
    return reference_observe_entry(value)

def reference_update_through_call(value: mutable usize&) -> usize:
    # Mutating callee post-state remains outside the pure-reader call-entry snapshot rule.
    requires value[0] <= 9223372036854775806
    ensure result == old(value[0]) + 1
    return reference_update(value)

# A non-zero offset must fail the one-element extent check, even for a reflexive claim.
def rejected_reference_offset(value: usize&) -> usize:
    ensure value[1] == value[1]
    return value[0]
