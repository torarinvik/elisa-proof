module RejectedDisequalityBounds:
    public:
        # `x != 5` is not at an endpoint of `x >= 0`, so it gives no `x >= 1`.
        def interior(x: u64) -> u64:
            requires x != 5
            ensure result < x
            x - 1

        # `slot != 6` sits below the upper endpoint 7 and cannot tighten it.
        def not_endpoint(slot: usize) -> usize:
            requires slot < 8
            requires slot != 6
            ensure result < 8
            slot + 1
