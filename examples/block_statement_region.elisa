# `for x in xs |captures|:` parses as a block, so in statement position it is an expression
# statement whose expression is a block. The boundary that refuses a discarded region-owned value
# asked whether that block *contains* one, and the predicate answers for a block by scanning its
# statements -- so the question asked of every captured loop was whether any statement in its body
# mentions a region-owned binding, and the answer was reported as a region value thrown away.
#
# A block statement discards its own value and nothing else, and for a loop that value is absent.
# The body is ordinary statements, walked as such before this boundary is reached.
#
# Beside it: the element count of a collection is a scalar copy. Passing one hands a callee no
# capability over the collection, so a call is not resource-carrying on account of it. Treating it
# as one made the call record a transition naming the collection as an actual, which the kernel
# then refused -- a replay gap that only appeared once the block misreading stopped hiding it.

extend BlockStatementRegionCore:
    def fits(start: usize, count: usize, total: usize) -> bool:
        return false if start > total
        return count <= total - start

extend BlockStatementRegion:
    def a_captured_loop_over_a_region_binding(items: darray[usize]&) -> usize:
        seen: mutable usize = 0
        region scratch:
            held: usize& = new[scratch] 7
            for index in 0..<items.count |index, items, seen, held|:
                seen <- seen + items[index] + held
        return seen

    def an_extent_argument_is_a_scalar[@r](values: mutable darray[usize]& @r, start: usize) -> bool:
        return BlockStatementRegionCore::fits(start, 0, values.count)
