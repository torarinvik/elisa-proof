def unguarded_word(a: usize, b: usize) -> usize:
    ensure result <= a
    return a - b

def zero_is_not_strict_decrease(a: usize, b: usize) -> usize:
    requires b <= a
    ensure result < a
    return a - b

def signed_negative_subtrahend(a: i64, b: i64) -> i64:
    requires a == 0
    requires b == -1
    ensure result <= a
    return a - b
