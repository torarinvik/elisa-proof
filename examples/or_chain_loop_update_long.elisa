struct Source:
    bytes: darray[u8]
    length: usize

def token_end(source: Source&, start: usize, stop: usize) -> usize:
    requires start <= stop and stop <= source.length and source.length == source.bytes.count
    ensure start <= result and result <= stop
    for index in start..<stop |found: usize = stop| -> found:
        invariant start <= found and found <= stop
        found <- index if found == stop and (source.bytes[index] == 32 or source.bytes[index] == 9 or source.bytes[index] == 13 or source.bytes[index] == 35 or source.bytes[index] == 10 or source.bytes[index] == 11 or source.bytes[index] == 12 or source.bytes[index] == 44 or source.bytes[index] == 59 or source.bytes[index] == 40 or source.bytes[index] == 41 or source.bytes[index] == 34)
