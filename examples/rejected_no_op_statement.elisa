# The refusal itself, pinned. A `pass` is indistinguishable at this AST layer from a construct the
# frontend dropped, so it is refused, and the refusal reaches every statement after it: the
# precondition that held before the match is gone at the call below it.

extend RejectedNoOpStatement:
    def needs_bound(depth: usize) -> usize:
        requires depth <= 127
        return depth

    def a_pass_arm_is_refused(depth: usize, value: usize) -> usize:
        requires depth <= 127
        match value:
            0:
                return 0
            _:
                pass
        return depth

    def the_refusal_reaches_past_the_match(depth: usize, value: usize) -> usize:
        requires depth <= 127
        match value:
            0:
                return 0
            _:
                pass
        return needs_bound(depth)
