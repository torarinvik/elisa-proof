# The refusal itself, pinned. `pass` is read from the lexer's own tokens and is a no-op, but a
# keyword-shaped prefix form written without its block (`with value` here) is dropped by the parser
# without a diagnostic and reaches the checker as the same invalid statement. It is refused, and the
# refusal reaches every statement after it: the precondition that held before the match is gone at
# the call below it.

module RejectedNoOpStatement:
    def needs_bound(depth: usize) -> usize:
        requires depth <= 127
        return depth

    def a_dropped_arm_is_refused(depth: usize, value: usize) -> usize:
        requires depth <= 127
        match value:
            0:
                return 0
            _:
                with value
        return depth

    def the_refusal_reaches_past_the_match(depth: usize, value: usize) -> usize:
        requires depth <= 127
        match value:
            0:
                return 0
            _:
                with value
        return needs_bound(depth)
