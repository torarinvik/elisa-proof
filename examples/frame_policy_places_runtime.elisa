include "../../Elisa-compiler/elisacore_std/elisacore_runtime_prelude.elisa"
include "../../Elisa-compiler/elisacore_std/collections.elisa"
include "../src/proof/kernel_core.elisa"
include "../src/proof/kernel_replay/frame_policy_model.elisa"
include "../src/proof/kernel_replay/frame_policy_places.elisa"

using ElisaProofKernelCore
using ElisaProofKernelFramePolicy

def main() -> i64:
    leaf: ProofKernelNode = ProofKernelNode{kind: "frame-field", operator: "", left: 0, right: 0, auxiliary: 0, children_start: 0, children_count: 0, value: 0, name: "value", secondary_name: ""}
    place: ProofKernelNode = ProofKernelNode{kind: "frame-place", operator: "frame-place-v1", left: 0, right: 0, auxiliary: 0, children_start: 0, children_count: 1, value: 0, name: "", secondary_name: ""}
    nodes: mutable darray[ProofKernelNode] = [leaf, place]
    children: mutable darray[usize] = [0]
    decoded = decode_place(nodes, children, 1, 1)
    return 1 if not decoded.known or decoded.place.field != "value" or decoded.place.depth != 1 or decoded.place.parameter != 0
    return 2 if decode_place(nodes, children, 2, 1).known
    return 3 if decode_place(nodes, children, 0, 1).known
    return 4 if decode_place(nodes, children, 1, 0).known
    children[0] <- 1
    return 5 if decode_place(nodes, children, 1, 1).known
    children[0] <- 999
    return 6 if decode_place(nodes, children, 1, 1).known
    children.clear()
    return 7 if decode_place(nodes, children, 1, 1).known
    children.push(0)
    nodes[1].auxiliary <- 1
    return 8 if decode_place(nodes, children, 1, 1).known
    nodes[1].auxiliary <- 0
    nodes[0].operator <- "forged"
    return 9 if decode_place(nodes, children, 1, 1).known
    nodes[0].operator <- ""
    nodes[1].secondary_name <- "forged"
    return 10 if decode_place(nodes, children, 1, 1).known
    nodes[1].secondary_name <- ""
    nodes[1].operator <- "frame-place-v2"
    return 11 if decode_place(nodes, children, 1, 1).known
    nodes[1].operator <- "frame-place-v1"
    return 12 if not decode_place(nodes, children, 1, 1).known
    nodes.push(ProofKernelNode{kind: "frame-place", operator: "frame-place-v1", left: 0, right: 0, auxiliary: 0, children_start: 0, children_count: 0, value: 0, name: "", secondary_name: ""})
    whole = decode_place(nodes, children, 2, 1)
    return 13 if not whole.known or whole.place.depth != 0 or whole.place.field != ""
    nodes[2] <- ProofKernelNode{kind: "frame-place", operator: "frame-place-v1", left: 1, right: 0, auxiliary: 0, children_start: 0, children_count: 0, value: 0, name: "", secondary_name: ""}
    return 14 if decode_place(nodes, children, 2, 1).known
    nodes[2] <- ProofKernelNode{kind: "frame-place", operator: "frame-place-v1", left: 0, right: 0, auxiliary: 0, children_start: 1, children_count: 0, value: 0, name: "", secondary_name: ""}
    return 15 if decode_place(nodes, children, 2, 1).known
    nodes[2] <- ProofKernelNode{kind: "frame-place", operator: "frame-place-v1", left: 0, right: 0, auxiliary: 0, children_start: 0, children_count: 4, value: 0, name: "", secondary_name: ""}
    return 16 if decode_place(nodes, children, 2, 1).known
    return 0
