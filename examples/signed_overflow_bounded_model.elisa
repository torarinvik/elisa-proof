# The exhaustive model rule may use mathematical i64 evaluation only after fixed-width
# safety has established that every operation in the finite domain is representable.
def signed_square_bounded_safe(x: i8) -> i8:
    requires x >= -2
    requires x <= 2
    ensure result >= 0
    return x * x

# On i8, 12 * 12 wraps to a negative result. Enumeration must not prove this using i64 math.
def signed_square_wraps_in_model_domain(x: i8) -> i8:
    requires x >= 0
    requires x <= 15
    ensure result >= 0
    return x * x
