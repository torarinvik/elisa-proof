struct FieldNullGuardProbe:
    first: mutable heap void&?

def field_null_guard_direct(store: FieldNullGuardProbe&) -> u8:
    ensure store.first != null or result == 0
    return 0 if store.first == null
    return 1

def field_null_guard_reverse(store: FieldNullGuardProbe&) -> u8:
    ensure null != store.first or result == 0
    return 0 if null == store.first
    return 1

def field_null_guard_null_branch(store: FieldNullGuardProbe&) -> u8:
    ensure result != 0 or store.first == null
    return 1 if store.first != null
    return 0

def field_null_guard_loop(store: FieldNullGuardProbe&, count: usize) -> u8:
    ensure store.first != null or result == 0
    return 0 if store.first == null
    remaining: mutable usize = count
    while remaining > 0:
        invariant store.first != null
        invariant remaining <= count
        decreases remaining
        remaining <- remaining - 1
    return 1
