# A runtime assertion evaluates its proposition before publishing it. A mutating nested call
# must invalidate facts from before that evaluation.

struct Box:
    value: mutable i64

def set_value(box: mutable Box&) -> i64:
    changes box.value
    box.value <- 1
    return 1

def stale_assert_fact(box: mutable Box&) -> i64:
    requires box.value == 0
    changes box.value
    ensure result == 0
    assert set_value(box) == 1
    return box.value
