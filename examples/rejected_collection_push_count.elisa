# Each ensure overstates what the body does to `v.count`.
def bump(x: u32) -> u32:
    return x

def no_growth(v: mutable darray[u32]&, x: u32) -> void can[Memory.Allocate]:
    ensures v.count == old(v.count)
    v.push(x)

def push_then_pop(v: mutable darray[u32]&, x: u32) -> void can[Memory.Allocate]:
    ensures v.count == old(v.count) + 1
    v.push(x)
    v.pop()

def maybe_push(v: mutable darray[u32]&, x: u32, c: bool) -> void can[Memory.Allocate]:
    ensures v.count == old(v.count) + 1
    if c:
        v.push(x)

def computed_argument(v: mutable darray[u32]&, x: u32) -> void can[Memory.Allocate]:
    ensures v.count == old(v.count) + 2
    v.push(bump(x))

def other_collection(v: mutable darray[u32]&, w: mutable darray[u32]&, x: u32) -> void can[Memory.Allocate]:
    ensures v.count == old(v.count) + 1
    w.push(x)

def wrong_element(v: mutable darray[u32]&, x: u32) -> void can[Memory.Allocate]:
    ensures v[v.count - 1] == x + 1
    v.push(x)

def second_push_is_last(v: mutable darray[u32]&, x: u32, y: u32) -> void can[Memory.Allocate]:
    ensures v[v.count - 1] == x
    v.push(x)
    v.push(y)

def reassigned(v: mutable darray[u32]&, x: u32) -> u32 can[Memory.Allocate]:
    ensures result == v[v.count - 1]
    y: mutable u32 = x
    v.push(y)
    y <- y + 1 if y < 100 else 0
    return y

def self_value(v: mutable darray[u32]&) -> void can[Memory.Allocate]:
    requires v.count > 0
    ensures v[v.count - 1] == v[0]
    v.push(v[0])
