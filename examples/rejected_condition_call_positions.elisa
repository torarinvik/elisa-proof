# The boundary of the condition-call rule. A call that may not run cannot be modelled by a branch
# that frames and havocs unconditionally, so it stays refused. And a fact recorded from a guard
# that names an impure call must never discharge an obligation that names the same call again:
# those are two calls, not one term.
struct Pair:
    left: usize

def bump(counter: mutable usize&) -> bool:
    changes counter
    counter <- counter + 1
    return counter > 0

def next(counter: mutable usize&) -> usize:
    changes counter
    counter <- counter + 1
    return counter

# The right operand of `and` runs only when the left is true.
def right_of_and(counter: mutable usize&, flag: bool) -> usize:
    changes counter
    return 1 if flag and bump(counter)
    return 0

# The right operand of `or` runs only when the left is false.
def right_of_or(counter: mutable usize&, flag: bool) -> usize:
    changes counter
    return 1 if flag or bump(counter)
    return 0

# A ternary evaluates one arm or the other.
def conditional_call(counter: mutable usize&, flag: bool) -> usize:
    changes counter
    return 1 if (bump(counter) if flag else false)
    return 0

# The guard and the index name the same call, but the second call returns a larger value.
def bound_after_guard(values: darray[i64]&, counter: mutable usize&) -> i64:
    changes counter
    if next(counter) < values.count:
        index: usize = next(counter)
        return values[index]
    return 0

# The same, with the guard reading a local bound from an earlier call.
def stored_before_guard(values: darray[i64]&, counter: mutable usize&) -> i64:
    changes counter
    n: usize = next(counter)
    if n < values.count:
        m: usize = next(counter)
        return values[m]
    return 0

# A shape the rule does not reason about explicitly. Evaluation here is in fact unconditional, so
# the refusal is pure conservatism — which is the point: an unrecognized form is refused rather
# than assumed to run.
def literal_field_call(counter: mutable usize&) -> usize:
    changes counter
    return 1 if Pair{left: next(counter)}.left > 0
    return 0
