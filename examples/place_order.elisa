# The order an unsigned subtraction needs may be stated between two places. `children.count - start`
# is guarded by `start <= children.count`, and that is what such code writes -- but the collector
# that feeds the subtraction guard admitted only integers and bare names, and the affine tiers name
# one bare identifier, so the guard was stated and unreadable. A field of a bare name is a place,
# not arithmetic: reading it twice in one fact set reads the same value, because any write to it,
# and any call that is not stable for it, discards these facts first.
#
# Three further readings of a fact list follow from the same place. A conjunction asserts both of
# its sides, so a rule scanning for a shape has to see inside one. A proposition and its negation
# are inconsistent, which is how the branch a disjunctive premise refutes closes. And an unsigned
# expression certified not to wrap is nonnegative, because its mathematical value is its machine
# value -- the lower bound on an index the upper bound was already proved for.

def a_place_guards_its_own_subtraction(start: usize, count: usize, children: darray[usize]&) -> usize:
    requires start <= children.count
    requires count <= children.count - start
    total: mutable usize = 0
    for index in 0..<count |index, start, children, total|:
        total <- total + children[start + index]
    return total

def a_conjunction_is_read_as_its_conjuncts(start: usize, count: usize, limit: usize, index: usize) -> bool:
    requires start <= limit and count <= limit - start
    requires index < count
    ensure result
    return start + index < limit

def a_denied_disjunct_leaves_the_other(guard: bool, a: usize, b: usize) -> bool:
    requires not guard or a <= b
    requires guard
    ensure result
    return a <= b

def a_guarded_difference_is_nonnegative(a: usize, b: usize) -> bool:
    requires b <= a
    ensure result
    return 0 <= a - b

def a_callee_range_check(start: usize, count: usize, limit: usize) -> bool:
    ensure not result or start <= limit and count <= limit - start
    return false if start > limit
    return false if count > limit - start
    return true

def a_summary_the_caller_guarded_on(start: usize, count: usize, limit: usize, index: usize) -> bool:
    requires index < count
    ensure result
    return true if not a_callee_range_check(start, count, limit)
    return start + index < limit
