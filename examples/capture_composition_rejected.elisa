include "capture_composition_probe.elisa"

# Success must publish, not report allocation failure.
def capture_composition_false_success(kind: u8, status: u8) -> u8:
    ensure kind > 1 or status != 0 or result == 15
    classified: u8 = capture_classify(kind, status)
    return capture_stage(classified)

# Touch denial must not be confused with pointer denial.
def capture_composition_false_touch(kind: u8, status: u8) -> u8:
    ensure kind != 0 or status < 1 or status > 3 or result == 14
    classified: u8 = capture_classify(kind, status)
    return capture_stage(classified)

# Invalid input must not authorize publication.
def capture_composition_false_invalid(kind: u8, status: u8) -> u8:
    ensure kind <= 1 and status <= 4 or result == 2
    classified: u8 = capture_classify(kind, status)
    return capture_stage(classified)
