module RejectedPlaceAliases:
    public:
        const CAP: usize = 8

        struct Pool:
            frames: mutable u64[RejectedPlaceAliases::CAP]

        # The alias names a different element, so it says nothing of `pool.frames[slot]`.
        def other_element(pool: Pool&, slot: usize, other: usize) -> u64:
            requires slot < CAP
            requires other < CAP
            ensure result == 0 or result < pool.frames[slot]
            length: u64 = pool.frames[other]
            return 0 if length == 0
            length - 1
