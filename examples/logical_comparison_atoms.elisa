def comparison_join(known: bool, left: u32, right: u32) -> bool:
    ensure result == (left == right and known)
    return known and left == right

def comparison_demorgan(known: bool, left: u32, right: u32) -> bool:
    ensure result == (not known and not (left < right))
    return not (known or left < right)

def comparison_idempotence(known: bool, left: u32, right: u32) -> bool:
    ensure result == (known and left != right)
    return known and left != right and left != right
