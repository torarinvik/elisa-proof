# A disjunctive helper summary refuted at the call site: by a literal argument
# (the disjunct `0 > 0` is closed and false) or by the caller's own order fact
# (`e < d` beside the requirement `e >= d`).
module ClosedComplementaryRefutation:
    public:
        def seven_unless_positive(d: i64) -> i64:
            ensure result == 7 or d > 0
            return 7 if d <= 0
            d

        def seven_unless_below(e: i64, d: i64) -> i64:
            ensure result == 7 or e < d
            return 7 if e >= d
            e

        def literal_argument() -> i64:
            ensure result == 7
            seven_unless_positive(0)

        def constant_local() -> i64:
            ensure result == 7
            z: i64 = 0
            seven_unless_positive(z)

        def complementary_requirement(e: i64, d: i64) -> i64:
            requires e >= d
            ensure result == 7
            seven_unless_below(e, d)

        def mirrored_requirement(e: i64, d: i64) -> i64:
            requires d <= e
            ensure result >= 7
            seven_unless_below(e, d)
