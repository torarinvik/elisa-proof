# A high-bit literal arrives from the parser as a negative i64 payload. The compiler retains
# suffixes as diagnostic metadata, not expression types, so a suffix-only comparison stays
# unknown until the importer carries a checked contextual type into the kernel term. `usize` also
# needs a target-width witness. Reflexive equality remains provable without either assumption.

def u64_max_exceeds_zero() -> u64:
    ensure 0xFFFFFFFFFFFFFFFFu64 > 0u64
    return 0u64

def u64_max_equals_itself() -> u64:
    ensure 0xFFFFFFFFFFFFFFFFu64 == 0xFFFFFFFFFFFFFFFFu64
    return 0u64

def u64_max_exceeds_high_bit() -> u64:
    ensure 0xFFFFFFFFFFFFFFFFu64 > 0x8000000000000000u64
    return 0u64

def usize_high_bit_at_least_small() -> usize:
    ensure 0x8000000000000000usize >= 7usize
    return 0usize

def u64_max_is_not_below_zero() -> u64:
    ensure 0xFFFFFFFFFFFFFFFFu64 < 0u64
    return 0u64

def u64_high_bit_is_not_below_max() -> u64:
    ensure 0x8000000000000000u64 > 0xFFFFFFFFFFFFFFFFu64
    return 0u64

def u64_max_is_not_zero() -> u64:
    ensure 0xFFFFFFFFFFFFFFFFu64 == 0u64
    return 0u64

# The wrapped payload of an unsuffixed literal still has no recorded type and stays ambiguous.
def untyped_wrapped_literal_is_not_ordered() -> u64:
    ensure 0xFFFFFFFFFFFFFFFF > 0
    return 0u64
