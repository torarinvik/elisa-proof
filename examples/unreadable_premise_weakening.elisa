# A guard over a term the wrap guard cannot read -- a signed remainder by a variable divisor,
# `(index % n) < 0` -- used to abandon every goal on its path, even `0 < n` under
# `requires n > 0`, which never mentions it. The unreadable premise is now set aside and the
# goal is decided over the rest; fewer premises can only weaken what is provable. Replay drops
# the same premises before it re-decides the goal.
def wrapped(index: i64, n: i64) -> i64:
    requires n > 0
    ensure result >= 0
    ensure result < n
    r: i64 = index % n
    folded: i64 = r + n if r < 0 else r
    return 0 if folded < 0
    return 0 if folded >= n
    folded

def guarded_zero(index: i64, n: i64) -> i64:
    requires n > 0
    ensure result < n
    r: i64 = index % n
    return 0 if r < 0
    0
