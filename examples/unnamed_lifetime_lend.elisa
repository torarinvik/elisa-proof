# A region-owned actual reaching a formal that declares no lifetime is a capability the callee
# cannot name: with no lifetime parameter to bind it to, it can neither allocate into that region
# nor return anything from it, and a lend already requires the callee to return no reference and no
# region. The reference's own liveness is still checked on both sides as an ordinary borrow.
#
# This was refused twice over — once when collecting the call's lifetimes and once in the lend rule
# itself — which is what made a region-allocated value unusable at any callee without a lifetime
# parameter. `opaque_walk` leaves an index obligation unproven on its own account, so it exports no
# resource summary and the lend rule is the only path to its callers.
struct Cell:
    value: mutable i64

def opaque_walk(cell: Cell&, index: usize) -> i64:
    values: darray[i64] = []
    return values[index] + cell.value

def lends_region_value() -> i64 can[Memory.Allocate, Abort.Panic]:
    region r(4096):
        cell: Cell& = new[r] Cell{value: 1}
        return opaque_walk(cell, 0)

def opaque_write(cell: mutable Cell&, index: usize) -> i64:
    values: darray[i64] = []
    cell.value <- 2
    return values[index]

def lends_region_value_exclusively() -> i64 can[Memory.Allocate, Abort.Panic]:
    region r(4096):
        cell: mutable Cell& = new[r] Cell{value: 1}
        return opaque_write(cell, 0)
