module DisequalityBounds:
    public:
        # `x != 0` over an unsigned `x` excludes the lower endpoint, so `x - 1` cannot wrap.
        def predecessor(x: u64) -> u64:
            requires x != 0
            ensure result < x
            x - 1

        # The upper endpoint tightens the same way: `slot < 8` and `slot != 7` give `slot + 1 < 8`.
        def next_below(slot: usize) -> usize:
            requires slot < 8
            requires slot != 7
            ensure result < 8
            slot + 1
