struct ContractOldResourceState:
    value: mutable u8

extern contract_old_resource_effect(state: mutable ContractOldResourceState&) -> u8

def contract_old_nested_effect(state: mutable ContractOldResourceState&) -> u8:
    ensure result == old(contract_old_resource_effect(state))
    return 0

def contract_old_address(state: mutable ContractOldResourceState&) -> u8:
    ensure old(&state) == &state
    return 0
