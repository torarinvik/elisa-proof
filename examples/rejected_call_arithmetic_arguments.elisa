# Control: only the upper bound holds, so `==` must not be claimed, and a
# disjunct whose rewrite does not close must stay unproven.
def g(x: i64) -> i64:
    requires x >= 0
    requires x <= 100
    ensure result <= x
    return 0

def h2(x: i64, y: i64) -> i64:
    requires x >= 0
    requires x <= 50
    requires y >= 0
    requires y <= 50
    requires x + y <= 0
    ensure result == 0
    return g(x + y)

def nearer(a: i64, b: i64) -> i64:
    requires a >= 0
    requires a <= 10000000
    requires b >= 0
    requires b <= 10000000
    ensure result >= 0
    ensure result <= a
    return a

def edge(frame: i64, last: i64) -> i64:
    requires last >= 0
    requires last <= 10000000
    requires frame >= 0
    requires frame <= last
    ensure frame != last or result <= 0
    return nearer(frame, last - frame)
