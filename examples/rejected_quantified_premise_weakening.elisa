def rejected_quantified_premise_scalar(cursor: i64) -> i64:
    requires cursor >= 0 and cursor <= 8
    requires forall index in 0..<8: index >= 0
    ensure cursor < 0
    return cursor

# A true wrapping machine premise must not become an integer contradiction
# inside a quantified goal and thereby prove a false conclusion.
def rejected_quantified_wrapping_premise(value: u8, next: u8) -> u8:
    requires value == 255
    requires next == 0
    requires next == value + 1
    ensure forall index in 0..<2: value == 0
    return value

def rejected_quantified_wrapping_range(value: u8, next: u8) -> u8:
    requires value == 255
    requires next == value + 1
    ensure forall index in next..<1: false
    return value
