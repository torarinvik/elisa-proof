# The shape that cannot be written. A downward scan's index bound is `index <= count`, which holds
# at entry and is preserved by the decrement, and stating it is exactly what a loop invariant is
# for. `elisac-stage1` declines any body carrying one, so this loop keeps both findings: the
# invariant it has no way to state, and the index bound that invariant would have given it.

extend RejectedForwardScan:
    def a_downward_scan_needs_an_invariant(names: darray[usize]&, wanted: usize) -> usize:
        index: mutable usize = names.count
        while index > 0 |index, names, wanted|:
            index <- index - 1
            return index if names[index] == wanted
        return names.count
