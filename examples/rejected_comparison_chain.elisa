# `<` and `<=` are the primitive integer order only for witnessed scalars. On a struct they
# dispatch to a user comparison that is under no transitivity law, so no chain may be built from
# them -- exactly as reflexivity and symmetry are refused for the same reason.
struct Partial:
    tag: i64

def struct_order_is_not_transitive(p: Partial, q: Partial, r: Partial) -> i64:
    requires p < q
    requires q < r
    ensure p < r
    return 0

def struct_non_strict_order_is_not_transitive(p: Partial, q: Partial, r: Partial) -> i64:
    requires p <= q
    requires q <= r
    ensure p <= r
    return 0

# Two non-strict steps compose to a non-strict relation and nothing more.
def non_strict_chain_gives_no_strict_goal(items: darray[i64]&, a: usize, b: usize) -> usize:
    requires a <= b
    requires b <= items.count
    ensure result < items.count
    return a

# Both facts must point the same way through the middle term.
def wrong_direction_chain(items: darray[i64]&, a: usize, b: usize) -> usize:
    requires a < b
    requires items.count < b
    ensure result < items.count
    return a
