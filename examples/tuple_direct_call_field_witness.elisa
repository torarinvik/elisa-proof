protocol Eq:
    def __eq__(self: Self, other: Self) -> bool

impl Eq for i64:
    def __eq__(self: i64, other: i64) -> bool:
        return self != other

def scalar_tuple() -> (count: u8, value: i64):
    return (1, 2)

def direct_tuple_field_bounds() -> u8:
    ensure result >= 0
    return scalar_tuple().count

def overloaded_tuple() -> (count: i64, value: i64):
    return (1, 2)

def rejected_direct_tuple_field_overloaded_reflexivity() -> i64:
    ensure overloaded_tuple().count == overloaded_tuple().count
    return 0
