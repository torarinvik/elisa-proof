# Standalone decoder unit fixture. Reduced annotation records are test inputs,
# not compiler-AST correspondence evidence; the compiler parser suite covers that.
include "../build/snapshot/Elisa-compiler/elisacore_std/elisacore_runtime.elisa"
module Ast:
    public:
        struct EnumAnnotation:
            owner: sview
            name: sview
            line: u32
module ElisaProof:
    public:
        const ROW_TEST_MARKER: u8 = 0
include "../src/proof/check/extern_effect_rows.elisa"

extend ElisaProof:
    public:
        def test_extern_rows() -> i64:
            members: mutable darray[sview] = []
            return 1 if not proof_decode_extern_effect_text(" Unsafe.RawExtern, Abort.Panic,Unsafe.RawExtern ", &members)
            return 2 if members.count != 2 or members[0] != "Unsafe.RawExtern" or members[1] != "Abort.Panic"
            malformed_rows: darray[sview] = [",Unsafe.RawExtern", "Unsafe.RawExtern,", "Unsafe..RawExtern", "Unsafe.", "Effects[T]", "Unsafe.RawExtern;Abort.Panic", "9Invalid"]
            for malformed in malformed_rows:
                before: usize = members.count
                return 3 if proof_decode_extern_effect_text(malformed, &members)
                return 4 if members.count != before
            return 5 if not proof_decode_extern_effect_text(" \t", &members) or members.count != 2
            rows: mutable darray[Ast::EnumAnnotation] = [
                Ast::EnumAnnotation{owner: "audit", name: "__extern_effect_row_complete", line: 1},
                Ast::EnumAnnotation{owner: "__extern_effect_row_text", name: "Unsafe.RawExtern, Abort.Panic", line: 1},
                Ast::EnumAnnotation{owner: "__extern_effect_ref", name: "Unsafe.RawExtern", line: 1}]
            imported: mutable darray[sview] = []
            return 6 if not proof_import_extern_effect_row(&rows, "audit", 1, &imported) or imported.count != 2
            return 7 if proof_import_extern_effect_row(&rows, "other", 1, &imported)
            return 8 if proof_import_extern_effect_row(&rows, "audit", 2, &imported)
            rows.push(Ast::EnumAnnotation{owner: "__extern_effect_ref", name: "Blocking.RawExtern", line: 1})
            return 9 if proof_import_extern_effect_row(&rows, "audit", 1, &imported) or imported.count != 2
            rows.resize(3)
            rows.push(Ast::EnumAnnotation{owner: "audit", name: "__extern_effect_row_complete", line: 1})
            return 10 if proof_import_extern_effect_row(&rows, "audit", 1, &imported)
            rows.resize(3)
            rows.push(Ast::EnumAnnotation{owner: "__extern_effect_row_text", name: "Unsafe.RawExtern", line: 1})
            return 12 if proof_import_extern_effect_row(&rows, "audit", 1, &imported)
            rows.resize(3)
            rows[1] <- Ast::EnumAnnotation{owner: "__extern_effect_row_text", name: "Unsafe.RawExtern, Abort.Panic, Blocking.RawExtern", line: 1}
            rows.push(Ast::EnumAnnotation{owner: "__extern_effect_ref", name: "Blocking.RawExtern", line: 1})
            imported.clear()
            return 13 if not proof_import_extern_effect_row(&rows, "audit", 1, &imported) or imported.count != 3
            legacy: mutable darray[Ast::EnumAnnotation] = [Ast::EnumAnnotation{owner: "__extern_effect_ref", name: "Unsafe.RawExtern", line: 1}]
            return 11 if proof_import_extern_effect_row(&legacy, "audit", 1, &imported)
            return 0

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    return ElisaProof::test_extern_rows()
