# The automatic arithmetic kernel deliberately does not use arbitrary compound equalities as a
# rewrite system. A source-bound tactic can make that explicit and replay the two small steps.

def repair_compound_equality(x: i64) -> void:
    requires x + 1 == 3
    ensure (x + 1) * 2 == 6
    return

# Keep one independent open obligation so the target-scoped tactic cannot inherit whole-file
# admission merely because the target theorem itself is now proved by source analysis.
def unrelated_open_obligation(x: i64) -> i64:
    requires x == 2
    ensure result == x + 1
    return x
