# Expression-level type witnesses. A comparison concluded from two terms denoting the same value
# needs both operands witnessed as primitive scalars; the producer resolves the declared type of
# every place reachable from a binding — struct fields, the `count` of a built-in container,
# and its elements to the declared depth — plus the result of a verified total-pure call, and
# records each as a witness the kernel matches against the exact term.

struct Inner:
    tag: i64

struct Holder:
    inner: Inner
    weight: i64
    values: darray[i64]
    grid: array[array[i64, 4], 4]

const enum Mode of i64:
    Off = 0
    On = 1

def field_reflexive(h: Holder) -> i64:
    ensure h.weight == h.weight
    return 0

def nested_field_reflexive(h: Holder) -> i64:
    ensure h.inner.tag == h.inner.tag
    return 0

def field_through_reference(h: Holder&) -> i64:
    ensure h.weight >= h.weight
    return 0

def element_reflexive(h: Holder, i: usize) -> i64:
    ensure h.values[i] == h.values[i]
    return 0

def count_reflexive(h: Holder) -> i64:
    ensure h.values.count == h.values.count
    return 0

def multi_index_reflexive(h: Holder, r: usize, c: usize) -> i64:
    ensure h.grid[r, c] == h.grid[r, c]
    return 0

def nested_index_reflexive(h: Holder, r: usize, c: usize) -> i64:
    ensure h.grid[r][c] == h.grid[r][c]
    return 0

def field_congruence(h: Holder, x: i64) -> i64:
    requires h.weight == x
    ensure h.weight + 1 == x + 1
    return 0

def element_congruence(h: Holder, i: usize, x: i64) -> i64:
    requires h.values[i] == x
    ensure h.values[i] * 2 == x * 2
    return 0

# A struct-typed local carries the same field witnesses as a parameter.
def local_field_reflexive(h: Holder) -> i64:
    copy: Holder = h
    proof copy.weight == copy.weight:
        assert copy.weight == copy.weight
    return copy.weight

def const_enum_reflexive(m: Mode) -> bool:
    ensure result == (m == .On)
    return m == .On

def pure_square(x: i64) -> i64:
    return x * x

def pure_call_reflexive(x: i64) -> i64:
    ensure result == pure_square(x)
    return pure_square(x)

# A scalar local bound to an opaque call is one value: the binding is witnessed, the call is not.
extern opaque_reading() -> i64

def bound_opaque_call(x: i64) -> i64:
    reading: i64 = opaque_reading()
    proof reading == reading:
        assert reading == reading
    return x

# The same binding after a runtime assertion still denotes the asserted execution's value, so the
# postcondition follows; reusing the call term itself, or the binding after a reassignment, does
# not (see `rejected_unknown_assert_reuse.elisa`).
def asserted_opaque_binding() -> i64:
    ensure result == 0
    value: i64 = opaque_reading()
    assert value == 0
    return value

# A loop binder is its own proof atom, witnessed by that atom: a counting-range binder is an
# integer, and a binder over a container whose elements are scalars inherits their witness.
def range_binder_reflexive(n: i64) -> i64:
    for i in 0 ..< n:
        assert i == i by:
            assert i == i
    return 0

def element_binder_reflexive(values: darray[i64]&) -> i64:
    for v in values:
        assert v == v by:
            assert v == v
    return 0

def field_element_binder_reflexive(h: Holder) -> i64:
    for v in h.values:
        assert v <= v by:
            assert v <= v
    return 0

def element_binder_congruence(values: darray[i64]&, x: i64) -> i64:
    for v in values:
        if v == x:
            assert v + 1 == x + 1 by:
                assert v + 1 == x + 1
    return 0
