# The strict reading needs the disequality over the same two terms. Here it is over another pair,
# and `frame = key = last = 5`, `first = 0` reaches the call with `last - key == 0`.
module RejectedNegatedDisequalityStrictness:
    def need(whole: i64) -> i64:
        requires whole >= 1
        return whole

    def other_pair(frame: i64, first: i64, key: i64, last: i64) -> i64:
        requires first >= 0
        requires first <= key
        requires key <= last
        requires last <= 10000000
        return 0 if frame == first
        return 0 if frame < first or frame > last
        if frame < key:
            return 0
        d: i64 = need(last - key)
        return d
