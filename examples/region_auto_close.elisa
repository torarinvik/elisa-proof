# A flat region owner is also legal when it is released implicitly at function exit.
# The verifier must balance the lifetime in the certificate even without `destroy r`.
def region_auto_close() -> i64 can[Memory.Allocate, Abort.Panic]:
    region r(4096)
    value: i64& @r = new[r] 1
    new[r] 2
    return 1

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    return region_auto_close()
