# The element count of a literal collection is written in the literal. This is not a claim about
# any storage: the term *is* the value, so nothing can alias it, mutate it, or make the count
# something else. It is the one length statement that needs no model of the language's builtins.
#
# A binding initialized to `[]` reaches a goal as `[].count` after substitution, which is exactly
# how a length invariant is established at loop entry. Preservation across a `push` is a different
# question and needs a different argument; nothing here answers it.
#
# Only the empty literal is read. A non-empty one would need its `usize` length as an `i64`, and
# that conversion is outside the expression fragment this checker verifies itself in -- putting one
# in `proof_constant_int` made the kernel's own constant evaluator unverifiable and cost 16
# functions and 65 proofs to the cascade. The empty case needs no conversion at all.

extend LiteralExtent:
    def an_empty_literal_is_empty() -> bool:
        ensure result
        values: mutable darray[usize] = []
        return values.count == 0

    def a_length_invariant_starts_at_zero(limit: usize) -> usize:
        counted: mutable darray[usize] = []
        filled: mutable usize = 0
        while filled < limit |filled, counted, limit|:
            invariant counted.count >= 0
            filled <- filled + 1
        return filled
