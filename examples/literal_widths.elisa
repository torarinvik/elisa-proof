# Literals that fit the width of their arithmetic read the same at that width, so facts and
# goals holding them are proved as usual: the u8 maximum, the i8 minimum written as a negated
# literal, a guarded difference and a small shift.
module LiteralWidths:
    public:
        def unsigned_maximum(a: u8) -> bool:
            requires a + 0 == 255
            ensure a == 255
            true

        def signed_minimum(a: i8) -> bool:
            requires a + 0 == -128
            ensure a + 0 == -128
            true

        def signed_step_down(a: i8) -> bool:
            requires a >= -120 and a <= -90
            ensure a - 5 >= -125
            true

        def exact_difference(a: u8, b: u8) -> bool:
            requires a <= b and b - a == 44
            ensure b == a + 44
            true

        def small_shift(a: u8) -> bool:
            requires a + 0 == 1 << 3
            ensure a == 8
            true
