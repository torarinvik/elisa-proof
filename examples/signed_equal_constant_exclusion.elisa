# A primitive signed equality excludes only a distinct representable literal.
def distinct_constants_from_i64(value: i64) -> bool:
    ensure value != -1 or value != 0
    ensure value != -1 or value != 4
    return true

def equality_excludes_distinct_i64_value(value: i64) -> bool:
    requires value == -1
    ensure value != 4
    return true

def fallthrough_i64_branch_excludes_negative_one(value: i64) -> u8:
    ensure value != -1 or result == 1
    if value == 4:
        return 2
    return 1
