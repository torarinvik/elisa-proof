# A binding both arms of an if/else rebind joins as `a if c else b`, with `c` read before the
# branch (mocap-cleaner G75). Each arm's facts over its own value come along guarded by the
# path, so the join keeps the bounds `return a if c else b` would.

module ConditionalJoin:
    const MAX_TIME: i64 = 1000000

    def step(t: i64) -> i64:
        requires t >= 0
        requires t <= MAX_TIME
        ensure result >= 1
        ensure result <= 100
        return 1

    def finish(t: i64, end: i64) -> i64:
        requires t >= 0
        requires t <= MAX_TIME
        requires end >= 0
        requires end <= MAX_TIME
        ensure result >= 0
        ensure result <= MAX_TIME
        return end if t > end
        return t

    def joined(c: bool, a: i64, b: i64) -> i64:
        requires a >= 0
        requires a <= 100
        requires b >= 0
        requires b <= 100
        ensure result >= 0
        ensure result <= 100
        t: mutable i64 = 0
        if c:
            t <- a
        else:
            t <- b
        return t

    # The loop invariant is re-established through the join: the then arm's call result and
    # the else arm's `end` are both in range.
    def walk(end: i64) -> i64:
        requires end >= 0
        requires end <= MAX_TIME
        t: mutable i64 = 0
        while t < end:
            invariant t >= 0
            invariant t <= MAX_TIME
            d: i64 = step(t)
            n: i64 = t + d
            if n >= 0 and n <= MAX_TIME:
                t <- finish(n, end)
            else:
                t <- end
        return t
