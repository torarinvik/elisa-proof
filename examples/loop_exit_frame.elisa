# A loop's exit keeps the facts over what its body never writes (BACKLOG W-04).

# The inner loop writes only `k`, so `hi <= n` survives it and the outer invariant holds.
def nested_outer_fact(xs: mutable darray[i64]&, n: usize) -> void:
    requires n <= xs.count
    hi: mutable usize = n
    while 1 < hi:
        invariant hi <= n
        k: mutable usize = 0
        while k + 1 < hi:
            invariant k < hi
            k <- k + 1
        hi <- hi - 1

# A fact over an untouched parameter outlives a counting loop.
def untouched_after_loop(a: i64, n: usize) -> i64:
    requires a < 10
    ensures result < 10
    k: mutable usize = 0
    while k < n:
        invariant k <= n
        k <- k + 1
    return a
