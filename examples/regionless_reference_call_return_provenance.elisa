# A region-less reference return is pinned by an exact witness: `pick` returns its formal `a`,
# and `swap_pick` returns whatever `pick` returns for this call, which is its own `b`.
def pick(a: i64&, b: i64&) -> i64&:
    return a

def swap_pick(a: i64&, b: i64&) -> i64&:
    return pick(b, a)

def main() -> i64:
    return 0
