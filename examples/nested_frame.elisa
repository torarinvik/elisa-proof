# Nested frame paths are checked as subtree permissions: changing inner.value does not
# invalidate facts about inner.sibling, while changing inner authorizes its descendants.

struct Inner:
    value: mutable i64
    sibling: mutable i64

struct Box:
    inner: mutable Inner
    other: mutable i64

def set_inner_value(box: mutable Box&) -> void:
    changes box.inner.value
    box.inner.value <- 1

def caller_keeps_sibling(box: mutable Box&) -> i64:
    preserves box.inner.sibling
    set_inner_value(box)
    return 7

def set_inner_subtree(box: mutable Box&) -> void:
    changes box.inner
    box.inner.value <- 2

def caller_grants_subtree(box: mutable Box&) -> i64:
    changes box.inner
    set_inner_value(box)
    return 9

def set_inner_ref(inner: mutable Inner&) -> void:
    changes inner.value
    inner.value <- 3

def caller_passes_nested_reference(box: mutable Box&) -> i64:
    preserves box.other
    set_inner_ref(&box.inner)
    return 11
