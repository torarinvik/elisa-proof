def reassigned_flag(i: usize, n: usize, other: bool) -> usize:
    ensure result <= n
    ok: mutable bool = i < n
    ok <- other
    if ok:
        return i
    return 0

def moved_index(i: usize, n: usize) -> usize:
    ensure result <= n
    j: mutable usize = i
    ok: bool = j < n
    j <- j + 5
    if ok:
        return j
    return 0

def negated_flag(i: usize, n: usize) -> usize:
    ensure result < n
    ok: bool = i < n
    if not ok:
        return i
    return 0
