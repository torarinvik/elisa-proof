# Frame paths deeper than the flat certificate summary bound are rejected instead of
# truncating the selector and accidentally granting a larger write permission.

struct D:
    value: mutable i64

struct C:
    d: mutable D

struct B:
    c: mutable C

struct A:
    b: mutable B

struct Box:
    a: mutable A

def too_deep(box: mutable Box&) -> void:
    changes box.a.b.c.d
    box.a.b.c.d.value <- 1
