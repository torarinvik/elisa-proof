# Qualified module constants retain their exact namespace and declared scalar type.
module North:
    const CAP: usize = 2

    def north_below(count: usize) -> bool:
        ensure result == (count < North::CAP)
        return count < North::CAP

    def north_below_with_shadowed_name(CAP: usize, count: usize) -> bool:
        ensure result == (count < North::CAP)
        return count < North::CAP

module South:
    const CAP: usize = 3

    def south_below(count: usize) -> bool:
        ensure result == (count < South::CAP)
        return count < South::CAP
