# Recursive lemma calls hidden in erased proof steps still need induction evidence.

lemma hidden_recursive_lemma(n: i64):
    requires n >= 0
    ensure n >= 0
    decreases n
    assert n >= 0 by:
        hidden_recursive_lemma(n)

def use_hidden_recursive_lemma(n: i64) -> void:
    requires n >= 0
    assert n >= 0 by:
        hidden_recursive_lemma(n)
