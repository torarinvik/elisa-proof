# Positional payload binders do not carry a stable field identity in the imported AST. They must
# remain outside the value-match lowering instead of being guessed as the whole variant value.
enum PositionalPayload:
    Value(value: i64)

def rejected_value_match_positional_payload(payload: PositionalPayload) -> i64:
    return match payload:
        PositionalPayload.Value(value):
            value
        _:
            0
