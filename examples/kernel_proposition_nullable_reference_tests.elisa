# Nullable pointer equality is admitted only for an exact nullable-reference/null pair. This
# exercises source-neutral kernel replay directly, including the cases that must remain rejected.
def kernel_nullable_reference_comparison_tests() -> i64 can[Memory.Allocate, Abort.Panic]:
    nodes: mutable darray[ProofKernelNode] = []
    children: mutable darray[usize] = []
    nullable_node: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "nullable_node", "")
    same_nullable_node: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "same_nullable_node", "")
    other_nullable_node: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "other_nullable_node", "")
    nonnullable_node: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "nonnullable_node", "")
    opaque_pointer: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "opaque_pointer", "")
    number: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "number", "")
    null_value: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "null", "")

    nullable_eq: usize = add_node(&nodes, "binary", "==", nullable_node, null_value, 0, 0, 0, 0, "", "")
    reversed_nullable_ne: usize = add_node(&nodes, "binary", "!=", null_value, same_nullable_node, 0, 0, 0, 0, "", "")
    nullable_to_nonnullable: usize = add_node(&nodes, "binary", "==", nullable_node, nonnullable_node, 0, 0, 0, 0, "", "")
    integer_to_null: usize = add_node(&nodes, "binary", "==", number, null_value, 0, 0, 0, 0, "", "")
    nullable_to_other_type: usize = add_node(&nodes, "binary", "==", nullable_node, other_nullable_node, 0, 0, 0, 0, "", "")
    nullable_ordering: usize = add_node(&nodes, "binary", "<", nullable_node, null_value, 0, 0, 0, 0, "", "")
    null_to_null: usize = add_node(&nodes, "binary", "==", null_value, null_value, 0, 0, 0, 0, "", "")
    opaque_eq_null: usize = add_node(&nodes, "binary", "==", opaque_pointer, null_value, 0, 0, 0, 0, "", "")
    reversed_opaque_ne: usize = add_node(&nodes, "binary", "!=", null_value, opaque_pointer, 0, 0, 0, 0, "", "")
    opaque_ordering: usize = add_node(&nodes, "binary", "<", opaque_pointer, null_value, 0, 0, 0, 0, "", "")
    opaque_to_named: usize = add_node(&nodes, "binary", "==", opaque_pointer, nullable_node, 0, 0, 0, 0, "", "")

    bindings: mutable darray[ProofKernelTypingBinding] = []
    nullable_added: bool = proof_kernel_add_typing_binding_with_identity(&bindings, "value", "nullable_node", "", "nullable-reference", "Node", "", "", 910, 0, 0)
    same_nullable_added: bool = proof_kernel_add_typing_binding_with_identity(&bindings, "value", "same_nullable_node", "", "nullable-reference", "Node", "", "", 910, 0, 0)
    other_nullable_added: bool = proof_kernel_add_typing_binding_with_identity(&bindings, "value", "other_nullable_node", "", "nullable-reference", "OtherNode", "", "", 911, 0, 0)
    nonnullable_added: bool = proof_kernel_add_typing_binding_with_identity(&bindings, "value", "nonnullable_node", "", "named", "Node", "", "", 910, 0, 0)
    number_added: bool = proof_kernel_add_typing_binding(&bindings, "value", "number", "", "integer", "u8", "", "")
    opaque_added: bool = proof_kernel_add_typing_binding_with_identity(&bindings, "value", "opaque_pointer", "", "nullable-opaque-reference", "void", "", "", 0, 0, 0)
    return 1 if not nullable_added or not same_nullable_added or not other_nullable_added or not nonnullable_added or not number_added or not opaque_added
    environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: bindings}

    return 2 if not proof_kernel_replay_proposition_formation_report(&nodes, &children, environment, [], nullable_eq)
    return 3 if not proof_kernel_replay_proposition_formation_report(&nodes, &children, environment, [], reversed_nullable_ne)
    return 4 if proof_kernel_replay_proposition_formation_report(&nodes, &children, environment, [], nullable_to_nonnullable)
    return 5 if proof_kernel_replay_proposition_formation_report(&nodes, &children, environment, [], integer_to_null)
    return 6 if proof_kernel_replay_proposition_formation_report(&nodes, &children, environment, [], nullable_to_other_type)
    return 7 if proof_kernel_replay_proposition_formation_report(&nodes, &children, environment, [], nullable_ordering)
    return 8 if proof_kernel_replay_proposition_formation_report(&nodes, &children, environment, [], null_to_null)
    return 9 if not proof_kernel_replay_proposition_formation_report(&nodes, &children, environment, [], opaque_eq_null)
    return 10 if not proof_kernel_replay_proposition_formation_report(&nodes, &children, environment, [], reversed_opaque_ne)
    return 11 if proof_kernel_replay_proposition_formation_report(&nodes, &children, environment, [], opaque_ordering)
    return 12 if proof_kernel_replay_proposition_formation_report(&nodes, &children, environment, [], opaque_to_named)
    return 0
