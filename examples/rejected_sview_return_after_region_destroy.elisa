# Returning a non-null sview does not extend its backing allocation past the region.
def borrow_region_view[@r](bytes: darray[u8]& @r) -> sview @r:
    return bytes.as_sview()

def rejected_sview_return_after_region_destroy() -> usize can[Memory.Allocate, Abort.Panic]:
    region scratch(64)
    bytes: mutable darray[u8] @scratch = [65]
    view: sview @scratch = borrow_region_view(bytes)
    destroy scratch
    return view.len

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    return 0
