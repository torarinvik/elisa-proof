struct RequiredReferenceRejectedNode:
    tag: mutable u8
struct RequiredReferenceRejectedStore:
    prepared: mutable heap RequiredReferenceRejectedNode&?

def required_reference_missing_write(store: mutable RequiredReferenceRejectedStore&, node: mutable heap RequiredReferenceRejectedNode&) -> u8:
    ensure result != 0 or store.prepared != null
    return 0

def required_reference_nullable_store(store: mutable RequiredReferenceRejectedStore&, node: mutable heap RequiredReferenceRejectedNode&?) -> u8:
    ensure result != 0 or store.prepared != null
    store.prepared <- node
    return 0

def required_reference_overwritten_store(store: mutable RequiredReferenceRejectedStore&, node: mutable heap RequiredReferenceRejectedNode&) -> u8:
    ensure result != 0 or store.prepared != null
    store.prepared <- node
    store.prepared <- null
    return 0

def required_reference_shadow_store(store: mutable RequiredReferenceRejectedStore&, node: mutable heap RequiredReferenceRejectedNode&) -> u8:
    ensure result != 0 or store.prepared != null
    if store.prepared == null:
        node: mutable heap RequiredReferenceRejectedNode&? = store.prepared
        store.prepared <- node
    return 0
