# The provider-specific resource source facts also hold on every fallthrough path.
const POLICY_LINEAR_MEMORY: u8 = 0
const POLICY_HOST_BUFFERS: u8 = 3
const POLICY_DECODED_ASSETS: u8 = 4
const POLICY_COMPONENT_INSTANCES: u8 = 6
const POLICY_UNAVAILABLE: usize = 18446744073709551615

def resource_source_policy(
    kind: u8, memory_bytes: usize, instances: usize,
    host_buffers: usize, decoded_assets: usize
) -> usize:
    ensure kind != POLICY_LINEAR_MEMORY or result == memory_bytes
    ensure kind != POLICY_HOST_BUFFERS or result == host_buffers
    ensure kind != POLICY_DECODED_ASSETS or result == decoded_assets
    ensure kind != POLICY_COMPONENT_INSTANCES or result == instances
    ensure result == POLICY_UNAVAILABLE or kind == POLICY_LINEAR_MEMORY or kind == POLICY_HOST_BUFFERS or kind == POLICY_DECODED_ASSETS or kind == POLICY_COMPONENT_INSTANCES
    if kind == POLICY_LINEAR_MEMORY:
        return memory_bytes
    if kind == POLICY_HOST_BUFFERS:
        return host_buffers
    if kind == POLICY_DECODED_ASSETS:
        return decoded_assets
    if kind == POLICY_COMPONENT_INSTANCES:
        return instances
    return POLICY_UNAVAILABLE

def resource_source_policy_memory_only(
    kind: u8, memory_bytes: usize, instances: usize,
    host_buffers: usize, decoded_assets: usize
) -> usize:
    ensure kind != POLICY_LINEAR_MEMORY or result == memory_bytes
    if kind == POLICY_LINEAR_MEMORY:
        return memory_bytes
    if kind == POLICY_HOST_BUFFERS:
        return host_buffers
    if kind == POLICY_DECODED_ASSETS:
        return decoded_assets
    if kind == POLICY_COMPONENT_INSTANCES:
        return instances
    return POLICY_UNAVAILABLE
