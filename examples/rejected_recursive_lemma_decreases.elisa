# A recursive lemma may not import its own postcondition at the same measure.

lemma bad_inductive_step(n: i64):
    requires n > 0
    ensure n >= 0
    decreases n
    bad_inductive_step(n)

def use_bad_inductive_step(n: i64) -> void:
    requires n > 0
    assert n >= 0 by:
        bad_inductive_step(n)
