# Qualified record constructors must resolve to the same nearest nominal owner as Elisa.
const module KernelTypePathTestStatus:
    PASSED: i64 = 0
    INSERTION_FAILED: i64 = 1
    NEAREST_RELATIVE_REFUSED: i64 = 2
    ABSOLUTE_QUALIFIED_REFUSED: i64 = 3
    ANCESTOR_RELATIVE_REFUSED: i64 = 4
    WRONG_OWNER_ACCEPTED: i64 = 5
    SIBLING_OWNER_ACCEPTED: i64 = 6

def kernel_test_add_record_path(bindings: mutable darray[ProofKernelTypingBinding]&, module_path: darray[sview]&, field_name: sview, identity: usize) -> bool:
    added_type: bool = proof_kernel_add_typing_binding_with_identity(bindings, "type", "Pair", "", "named", "Pair", "", "", identity, 0, 0)
    return false if not added_type
    if module_path.count > 0:
        segment_count: usize = module_path.count + 1
        for index in 0..<segment_count |index, bindings, module_path, segment_count, identity|:
            segment: sview = "Pair" if index == module_path.count else module_path[index]
            added_segment: bool = proof_kernel_add_typing_binding_with_metadata(bindings, "type-scope-segment", segment, "Pair", "named", "Pair", "", "", identity, 0, 0, 0, index, segment_count)
            return false if not added_segment
    added_field: bool = proof_kernel_add_typing_binding_with_identity(bindings, "field", field_name, "Pair", "integer", "i64", "", "", 0, identity, 0)
    return added_field

def kernel_test_qualified_record_equation(nodes: mutable darray[ProofKernelNode]&, children: mutable darray[usize]&, module_path: darray[sview]&, field_name: sview, value: i64) -> usize:
    path_root: mutable usize = 0
    for segment in module_path |nodes, path_root|:
        path_root <- add_node(nodes, "ident", "", 0, 0, 0, 0, 0, 0, segment, "") if path_root == 0
        path_root <- add_node(nodes, "scope", "", path_root, 0, 0, 0, 0, 0, segment, "") if path_root != 0
    value_root: usize = add_node(nodes, "int", "", 0, 0, 0, 0, 0, value, "", "")
    field_initializer: usize = add_node(nodes, "field-init", "", value_root, 0, 0, 0, 0, 0, field_name, "")
    children.push(field_initializer)
    constructor: usize = add_node(nodes, "construct", "", path_root, 0, 0, 0, 1, 0, "", "")
    projection: usize = add_node(nodes, "field", "", constructor, 0, 0, 0, 0, 0, field_name, "")
    add_node(nodes, "binary", "==", projection, value_root, 0, 0, 0, 0, "", "")

def kernel_test_record_path_positive(nodes: mutable darray[ProofKernelNode]&, children: mutable darray[usize]&, environment: ProofKernelTypeEnvironment, written_path: darray[sview]&, field_name: sview, value: i64) -> bool:
    goal: usize = kernel_test_qualified_record_equation(nodes, children, written_path, field_name, value)
    proof_kernel_replay_proposition_formation_report(nodes, children, environment, [], goal)

def kernel_type_constructor_path_tests() -> i64 can[Memory.Allocate, Abort.Panic]:
    # The nearest `Right::Pair` is in Outer::Worker. Outer::Right and root Right have
    # the same leaf name, so the constructor's field proves which identity was selected.
    bindings: mutable darray[ProofKernelTypingBinding] = []
    root_right: darray[sview] = ["Right"]
    outer_right: darray[sview] = ["Outer", "Right"]
    worker_right: darray[sview] = ["Outer", "Worker", "Right"]
    root_added: bool = kernel_test_add_record_path(&bindings, root_right, "root_value", 93001)
    outer_added: bool = kernel_test_add_record_path(&bindings, outer_right, "outer_value", 93002)
    worker_added: bool = kernel_test_add_record_path(&bindings, worker_right, "worker_value", 93003)
    context_path: darray[sview] = ["Outer", "Worker"]
    context_path_added: bool = kernel_test_add_module_owner(&bindings, context_path, 93004)
    context_added: bool = proof_kernel_add_typing_binding_with_identity(&bindings, "module-context", "", "", "", "", "", "", 0, 93004, 0)
    return KernelTypePathTestStatus::INSERTION_FAILED if not root_added or not outer_added or not worker_added or not context_path_added or not context_added
    environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: bindings}

    nearest_nodes: mutable darray[ProofKernelNode] = []
    nearest_children: mutable darray[usize] = []
    nearest_relative: darray[sview] = ["Right", "Pair"]
    return KernelTypePathTestStatus::NEAREST_RELATIVE_REFUSED if not kernel_test_record_path_positive(&nearest_nodes, &nearest_children, environment, nearest_relative, "worker_value", 7)

    absolute_nodes: mutable darray[ProofKernelNode] = []
    absolute_children: mutable darray[usize] = []
    absolute_path: darray[sview] = ["Outer", "Worker", "Right", "Pair"]
    return KernelTypePathTestStatus::ABSOLUTE_QUALIFIED_REFUSED if not kernel_test_record_path_positive(&absolute_nodes, &absolute_children, environment, absolute_path, "worker_value", 7)

    # With the nearest declaration removed, the same short path resolves to its ancestor.
    ancestor_bindings: mutable darray[ProofKernelTypingBinding] = []
    ancestor_root_added: bool = kernel_test_add_record_path(&ancestor_bindings, root_right, "root_value", 93101)
    ancestor_outer_added: bool = kernel_test_add_record_path(&ancestor_bindings, outer_right, "outer_value", 93102)
    ancestor_context_added: bool = kernel_test_add_module_owner(&ancestor_bindings, context_path, 93103)
    ancestor_module_added: bool = proof_kernel_add_typing_binding_with_identity(&ancestor_bindings, "module-context", "", "", "", "", "", "", 0, 93103, 0)
    return KernelTypePathTestStatus::INSERTION_FAILED if not ancestor_root_added or not ancestor_outer_added or not ancestor_context_added or not ancestor_module_added
    ancestor_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: ancestor_bindings}
    ancestor_nodes: mutable darray[ProofKernelNode] = []
    ancestor_children: mutable darray[usize] = []
    return KernelTypePathTestStatus::ANCESTOR_RELATIVE_REFUSED if not kernel_test_record_path_positive(&ancestor_nodes, &ancestor_children, ancestor_environment, nearest_relative, "outer_value", 8)

    wrong_nodes: mutable darray[ProofKernelNode] = []
    wrong_children: mutable darray[usize] = []
    wrong_path: darray[sview] = ["Wrong", "Pair"]
    return KernelTypePathTestStatus::WRONG_OWNER_ACCEPTED if kernel_test_record_path_positive(&wrong_nodes, &wrong_children, environment, wrong_path, "worker_value", 7)

    sibling_bindings: mutable darray[ProofKernelTypingBinding] = []
    sibling_path: darray[sview] = ["Other", "Worker", "Right"]
    sibling_added: bool = kernel_test_add_record_path(&sibling_bindings, sibling_path, "worker_value", 93201)
    sibling_context_added: bool = kernel_test_add_module_owner(&sibling_bindings, context_path, 93202)
    sibling_module_added: bool = proof_kernel_add_typing_binding_with_identity(&sibling_bindings, "module-context", "", "", "", "", "", "", 0, 93202, 0)
    return KernelTypePathTestStatus::INSERTION_FAILED if not sibling_added or not sibling_context_added or not sibling_module_added
    sibling_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: sibling_bindings}
    sibling_nodes: mutable darray[ProofKernelNode] = []
    sibling_children: mutable darray[usize] = []
    return KernelTypePathTestStatus::SIBLING_OWNER_ACCEPTED if kernel_test_record_path_positive(&sibling_nodes, &sibling_children, sibling_environment, nearest_relative, "worker_value", 7)
    return KernelTypePathTestStatus::PASSED
