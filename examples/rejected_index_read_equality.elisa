def rejected_different_index(rows: array[usize, 8]&, cursor: i64) -> i64:
    requires cursor == 2
    requires rows[cursor] == 64
    ensure rows[3] == 64
    return 0

def rejected_float_arithmetic_totality(value: f64) -> i64:
    ensure value + 1.0 < 0.0 or value + 1.0 >= 0.0
    return 0

def rejected_skipped_prefix_row(rows: array[usize, 8]&, cursor: i64) -> i64:
    requires cursor == 2
    requires 3 >= cursor or rows[3] == 64
    requires rows[cursor] == 64
    ensure 3 >= cursor + 2 or rows[3] == 64
    return 0

def rejected_stale_read_after_write(rows: mutable array[usize, 8]&, cursor: i64) -> i64:
    requires cursor == 3
    requires rows[cursor] == 64
    changes rows
    ensure rows[3] == 64
    rows[cursor] <- 0
    return 0

def rejected_different_array(rows: array[usize, 8]&, other: array[usize, 8]&, cursor: i64) -> i64:
    requires cursor == 3
    requires rows[cursor] == 64
    ensure other[3] == 64
    return 0

def rejected_wrapping_index(rows: array[usize, 256]&, cursor: u8) -> i64:
    requires cursor == 255
    requires rows[cursor] == 64
    ensure rows[cursor + 1] == 64
    return 0
