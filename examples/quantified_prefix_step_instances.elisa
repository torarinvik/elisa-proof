# A prefix-step theorem over the eight checked instances, not a scanner.
def quantified_prefix_step_instances(rows: array[usize, 8]&, cursor: i64) -> i64:
    requires cursor >= 0 and cursor < 8
    requires 0 >= cursor or rows[0] == 64
    requires 1 >= cursor or rows[1] == 64
    requires 2 >= cursor or rows[2] == 64
    requires 3 >= cursor or rows[3] == 64
    requires 4 >= cursor or rows[4] == 64
    requires 5 >= cursor or rows[5] == 64
    requires 6 >= cursor or rows[6] == 64
    requires 7 >= cursor or rows[7] == 64
    requires rows[cursor] == 64
    ensure forall index in 0..<8: index >= cursor + 1 or rows[index] == 64
    return 0

# Separate body search from quantified dispatch while retaining every premise.
def prefix_step_fixed_row(rows: array[usize, 8]&, cursor: i64) -> i64:
    requires cursor >= 0 and cursor < 8
    requires 0 >= cursor or rows[0] == 64
    requires 1 >= cursor or rows[1] == 64
    requires 2 >= cursor or rows[2] == 64
    requires 3 >= cursor or rows[3] == 64
    requires 4 >= cursor or rows[4] == 64
    requires 5 >= cursor or rows[5] == 64
    requires 6 >= cursor or rows[6] == 64
    requires 7 >= cursor or rows[7] == 64
    requires rows[cursor] == 64
    ensure 3 >= cursor + 1 or rows[3] == 64
    return 0
