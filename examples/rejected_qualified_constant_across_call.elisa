# Controls: the survived constant does not prove an off-by-one value, and a same-named
# constant of another module is not confused with it.
module Full:
    public:
        const TOP: i64 = 1000
module Other:
    public:
        const TOP: i64 = 999
module Pull:
    public:
        def pull(frame: i64, last: i64) -> i64:
            requires frame >= 0
            requires frame <= last
            requires last <= 1000
            ensure result >= 0
            ensure result <= Full::TOP
            ensure frame != last or result == Full::TOP
            return Full::TOP if frame == last
            return frame

module Uses:
    public:
        def closes_off_by_one(last: i64) -> i64:
            requires last >= 1
            requires last <= 1000
            ensure result == Full::TOP - 1
            return Pull::pull(last, last)

        def other_module(last: i64) -> i64:
            requires last >= 1
            requires last <= 1000
            ensure result == Other::TOP
            return Pull::pull(last, last)
