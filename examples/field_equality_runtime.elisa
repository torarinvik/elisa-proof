# Differential admission test for allocation-free hypothetical-field comparison.
include "../../Elisa-compiler/src/semantic/semantic.elisa"
include "../src/proof/kernel_core.elisa"
include "../src/proof/operator_impl_model.elisa"
include "../src/proof/model/enum_index.elisa"
include "../src/proof/model/findings.elisa"
include "../src/proof/model.elisa"
include "../src/proof/model/lemma_table.elisa"
include "../src/proof/kernel.elisa"
include "../src/proof/expr.elisa"
include "../src/proof/linear.elisa"
include "../src/proof/resources.elisa"
include "../src/proof/check.elisa"
include "../src/proof/kernel_replay.elisa"
include "../src/proof/replay.elisa"

using ElisaProof

extend ElisaProof:
    public:
        def test_untrusted_marker_known(expression: Ast::Expr) -> bool:
            marker = proof_untrusted_operator_marker_info(expression)
            return marker.known

const FIELD_COMPARISON_MISMATCH: i64 = 1
const MARKER_FILTER_MISMATCH: i64 = 2
const FIELD_TEST_REGION_BYTES: usize = 65536

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    region r(FIELD_TEST_REGION_BYTES):
        store: Ast::Node.Store[Local] = Ast::Node.Store(r)
        in store:
            position: Ast::Pos = Ast::pos_at_line(1)
            object: Ast::Expr = Ast::Expr.Ident("items", position)
            other: Ast::Expr = Ast::Expr.Ident("other", position)
            indexed: Ast::Expr = Ast::Expr.Index(object, Ast::Expr.IntLit(0, position), position)
            field: Ast::Expr = Ast::Expr.Field(object, "value", position)
            objects: mutable darray[Ast::Expr] = [object, other, indexed, Ast::Expr.Paren(object, position), Ast::Expr.Invalid, Ast::Expr.Absent]
            candidates: mutable darray[Ast::Expr] = [field, Ast::Expr.Paren(field, position), Ast::Expr.Field(other, "value", position), Ast::Expr.Field(indexed, "value", position), Ast::Expr.Field(object, "", position), Ast::Expr.Field(Ast::Expr.Invalid, "value", position), object, Ast::Expr.Invalid]
            deep: mutable Ast::Expr = object
            for depth in 0..<ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT |depth, deep, position, objects, candidates|:
                deep <- Ast::Expr.Paren(deep, position)
                if depth + 2 >= ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT:
                    objects.push(deep)
                    candidates.push(Ast::Expr.Field(deep, "value", position))
            names: mutable darray[sview] = ["value", "other", ""]
            for candidate in candidates |candidate, objects, names, position|:
                for base in objects |candidate, base, names, position|:
                    for name in names |candidate, base, name, position|:
                        expected: bool = proof_expr_equal(candidate, Ast::Expr.Field(base, name, position))
                        actual: bool = proof_expr_equal_field(candidate, base, name)
                        return FIELD_COMPARISON_MISMATCH if actual != expected
            scalar_name: sview = "__elisa_primitive_scalar_type"
            element_name: sview = "__elisa_primitive_scalar_element"
            untrusted_name: sview = "__elisa_untrusted_operator_type"
            marker_facts: mutable darray[Ast::Expr] = [object, Ast::Expr.Invalid, Ast::Expr.Call(object, [], [], position)]
            marker_facts.push(Ast::Expr.Call(Ast::Expr.Ident(scalar_name, position), [object], [], position))
            marker_facts.push(Ast::Expr.Call(Ast::Expr.Ident(scalar_name, position), [], [], position))
            marker_facts.push(Ast::Expr.Call(Ast::Expr.Ident(element_name, position), [object, Ast::Expr.IntLit(1, position)], [], position))
            marker_facts.push(Ast::Expr.Call(Ast::Expr.Ident(element_name, position), [object, Ast::Expr.IntLit(0, position)], [], position))
            marker_facts.push(Ast::Expr.Call(Ast::Expr.Ident(untrusted_name, position), [object, Ast::Expr.StringLit("Eq", position)], [], position))
            marker_facts.push(Ast::Expr.Call(Ast::Expr.Ident(untrusted_name, position), [object, Ast::Expr.StringLit("", position)], [], position))
            for fact in marker_facts |fact, scalar_name, element_name, untrusted_name|:
                scalar = proof_marker_argument(fact, scalar_name)
                element = proof_element_marker_info(fact)
                untrusted: bool = test_untrusted_marker_known(fact)
                return MARKER_FILTER_MISMATCH if scalar.known and not proof_marker_has_callee(fact, scalar_name)
                return MARKER_FILTER_MISMATCH if element.known and not proof_marker_has_callee(fact, element_name)
                return MARKER_FILTER_MISMATCH if untrusted and not proof_marker_has_callee(fact, untrusted_name)
    return 0
