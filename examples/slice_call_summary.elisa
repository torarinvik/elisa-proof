# Exact pure result summaries also compose at slice endpoints.

def identity_endpoint(endpoint: usize) -> usize:
    ensure result == endpoint
    return endpoint

def safe_slice_call(values: darray[i64]&, start: usize, end: usize) -> void:
    requires start <= end and end <= values.count
    window: view[i64] = values[identity_endpoint(start):identity_endpoint(end)]
