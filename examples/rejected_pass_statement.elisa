# `pass` is a no-op, not evidence: a false ensure after it stays rejected. An `assert ?` hole is
# an open obligation wherever it appears. A construct the parser dropped without a diagnostic
# reaches the prover as the same invalid statement, and it is still refused rather than read as
# `pass`.
struct Table:
    total: mutable usize

def clear(table: mutable Table&) -> usize:
    table.total <- 0
    0

def false_after_pass(table: mutable Table&) -> usize:
    requires table.total == 3
    ensure result == 3
    match clear(table):
        0:
            pass
        _:
            pass
    table.total

def hole_in_body(x: usize) -> usize:
    ensure result == x
    assert ?
    x

def hole_in_branch(x: usize) -> usize:
    ensure result == x
    if x > 2:
        assert ?
    x

lemma hole_in_lemma(x: i64):
    requires x >= 0
    ensure x >= 0
    assert ?

def hole_in_proof_block(x: i64) -> i64:
    requires x >= 0
    ensure result >= 0
    assert x >= 0 by:
        assert ?
    return x

def dropped_prefix_block(x: usize) -> usize:
    ensure result == x
    with x
    x
