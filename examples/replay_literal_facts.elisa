# A local bound to a collection literal has that literal as its recorded value, so every fact the
# body takes over `name.count` is recorded over `[...].count`. The replay driver compares a
# certificate's facts against the recorded trace to find each fact's origin, and its expression
# equality had no arm for a collection literal: the fact never matched its own trace, its origin
# came back unknown, and the certificate that carried it could not be replayed. The producer had
# proved the goal; the kernel refused it for want of an equality, not for want of a justification.
#
# The index *upper* bound over a literal-bound local is a separate, still-open limitation -- the
# scalar-term witness is recorded for `name.count` and not for the substituted `[...].count` -- so
# these bodies stay unverified. What this fixture pins is that every certificate the producer does
# issue replays.

def range_valid(start: usize, count: usize, total: usize) -> bool:
    ensure not result or start <= total and count <= total - start
    return false if start > total
    return false if count > total - start
    return true

# The guard's summary and branch condition both mention `[1, 2, 3].count`, and the lower bound is
# proven from them.
def a_literal_local_under_a_summary_guard(start: usize) -> usize:
    children: mutable darray[usize] = [1, 2, 3]
    return 0 if not range_valid(start, 1, children.count)
    return children[start]

# A literal of a different length, in the same frame, so the two traces must be told apart by
# their elements rather than by their shape.
def two_literals_of_different_lengths(start: usize) -> usize:
    children: mutable darray[usize] = [1, 2, 3]
    others: mutable darray[usize] = [4, 5]
    return 0 if not range_valid(start, 1, children.count)
    return 0 if not range_valid(start, 1, others.count)
    return children[start] + others[start]

# Two literals of the same length and different elements, which an equality that compared only
# lengths would confuse.
def two_literals_of_the_same_length(start: usize) -> usize:
    children: mutable darray[usize] = [1, 2, 3]
    others: mutable darray[usize] = [4, 5, 6]
    return 0 if not range_valid(start, 1, children.count)
    return 0 if not range_valid(start, 1, others.count)
    return children[start] + others[start]
