# `0 <= x` is the one claim that does not care whether a fixed-width term wrapped: an unsigned
# machine value is nonnegative, and the mathematical value of a subtraction-free combination of
# nonnegative leaves is nonnegative too. The engine used to demand a wrap-safety proof for it, and
# to refuse the whole goal before any rule ran whenever a *premise* mentioned the same sum -- which
# is exactly what a guard written over that sum leaves behind. So `values[start + index]` lost its
# own lower bound to the guard that was there to establish it.
#
# The second half is retention. A width witness whose subject is a place -- `node.children_start`
# rather than a bare name -- was invisible to the retention rule, so it was discarded at the first
# call while the scalar-type witness beside it survived. Its subject's root binding is what it
# depends on, exactly as for the witness beside it.

struct Node:
    children_start: usize
    children_count: usize

def grow(values: mutable darray[usize]&) -> usize:
    values.push(1)
    return 0

# The claim on its own, with no index around it: two unbounded unsigned terms, added. The sum may
# wrap, and the answer is the same either way -- a wrapped unsigned value is still an unsigned
# value. The wrap guard used to refuse the goal before any rule saw it.
def a_sum_is_never_negative(start: usize, index: usize) -> usize:
    ensure 0 <= result
    return start + index

# Multiplication, remainder and a shift carry nonnegativity forward for the same reason.
def a_product_is_never_negative(a: usize, b: usize, c: usize) -> usize:
    ensure 0 <= result
    return a * b + (c << 1)

# The upper bound comes from the difference form, which is the one an unsigned type supports. The
# lower bound is what used to be lost: the premises name a subtraction the goal-level wrap guard
# refuses, so the goal was abandoned before any rule saw it.
def a_guarded_sum_is_nonnegative(values: darray[usize]&, start: usize, index: usize) -> usize:
    return values[start + index] if start <= values.count and index < values.count - start
    return 0

# A field of a by-value struct is a leaf like any other.
def a_field_and_a_binder(node: Node, values: darray[usize]&, index: usize) -> usize:
    return values[node.children_start + index] if node.children_start <= values.count and index < values.count - node.children_start
    return 0

# The only leaf is the place, so the place's own width witness is what carries the claim, and it
# has to survive the call above the index.
def a_place_width_survives_a_call(node: Node, values: mutable darray[usize]&) -> usize:
    ignored: usize = grow(values)
    return 0 if node.children_start >= values.count
    return values[node.children_start] + ignored
