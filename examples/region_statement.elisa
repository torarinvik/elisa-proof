# The compiler's canonical region form is a declaration followed by statements. `new[r]` names
# the arena selected by the `@r` type qualifier; the region remains active until `destroy r`.
def region_statement() -> i64 can[Memory.Allocate, Abort.Panic]:
    region r(4096)
    value: i64& @r = new[r] 1
    alias: mutable i64& @r = value
    new[r] 2
    destroy r
    return 1

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    return region_statement()
