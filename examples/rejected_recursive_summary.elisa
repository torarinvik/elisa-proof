# Executable postconditions may not be discharged through a recursive summary.

def circular_claim(n: i64) -> i64:
    requires n >= 0
    ensure result == 0
    return circular_claim(n)

def mutual_a(n: i64) -> i64:
    requires n >= 0
    ensure result == 0
    return mutual_b(n)

def mutual_b(n: i64) -> i64:
    requires n >= 0
    ensure result == 0
    return mutual_a(n)
