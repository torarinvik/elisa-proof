# First direct dogfood target: this imports the actual AST-free kernel core implementation.
include "../src/proof/kernel_core.elisa"
using ElisaProofKernelCore

def direct_root_contract(root: usize, node_count: usize) -> bool:
    requires root < node_count
    ensure result == true
    checked: bool = root_valid(node_count, root)
    assert checked == (root < node_count) by:
        assert checked == (root < node_count)
    return true

def direct_range_contract(start: usize, count: usize, total: usize) -> bool:
    requires start <= total and count <= total - start
    ensure result == true
    checked: bool = range_valid(start, count, total)
    assert checked == (start <= total and count <= total - start) by:
        assert checked == (start <= total and count <= total - start)
    return true
