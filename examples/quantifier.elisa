# Finite contract quantifiers are checked by bounded instantiation in the Elisa kernel.

def bounded_forall() -> i64:
    ensure forall i in 0 ..< 3: i >= 0
    ensure true
    return 0

def bounded_exists() -> i64:
    ensure exists i in 0 ..< 3: i == 1
    ensure true
    return 0

def bounded_from_fact(n: i64) -> i64:
    requires n == 3
    ensure forall i in 0 ..< n: i >= 0
    return 0

def bounded_inclusive() -> i64:
    ensure forall i in 0 ..= 2: i <= 2
    return 0
