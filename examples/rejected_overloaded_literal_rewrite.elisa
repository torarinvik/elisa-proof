# A literal equality hypothesis is still a source-level protocol proposition. It must not be
# accepted as a Leibniz rewrite merely because both endpoints are primitive literals.
protocol Eq:
    def __eq__(self: Self, other: Self) -> bool

impl Eq for i64:
    def __eq__(self: i64, other: i64) -> bool:
        return true

def overloaded_literal_rewrite() -> i64:
    requires 1 == 2
    ensure 1 + 2 == 4
    return 0
