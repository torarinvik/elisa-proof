# A literal arithmetic equality is still a source-level protocol proposition. It must not be
# accepted as a built-in proposition merely because its operands are primitive literals. The
# source implementation reverses equality, so source execution accepts this postcondition while
# the independent kernel must not reinterpret it with built-in equality at `value == 2`.
protocol Eq:
    def __eq__(self: Self, other: Self) -> bool

impl Eq for i64:
    def __eq__(self: i64, other: i64) -> bool:
        return true

def overloaded_literal_rewrite(value: i64) -> i64:
    requires value == 2
    ensure value + 1 == 4
    return 0
