# A binding lent by `&` anywhere in a frame was treated as reachable by every callee for the rest
# of that frame, so a loop entered afterwards forgot it and lost its own range fact. That is right
# only when the lend can outlive the call it was passed to.
#
# It cannot when nothing the callee can store into, that its caller still sees, has a type able to
# hold a reference: its other parameters' storage, and its return. Three compiled probes fix the
# boundary rather than an argument about it. A callee with a second parameter of type
# `mutable darray[darray[usize]&]&` does store the lend into it, and one that returns a by-value
# `darray[darray[usize]&]` holding it does too; the compiler accepts both. Storing into an ordinary
# field is what its region checker refuses. So neither "returns no reference" nor "has one
# reference parameter" is enough on its own, and a test over the declared types is.
#
# The lend is still a write *during* its own call: `aliased_names` is unchanged and every call-site
# rule still reads it. What is new is a second set, of the lends that outlive their call, and only
# loop entry reads that one.

def fill(values: mutable darray[usize]&) -> void:
    values.push(1)
    values.push(2)

def read_only(values: darray[usize]&) -> usize:
    return values.count

# The lend is before the loop and cannot outlive it, so the loop keeps its own range.
def a_confined_lend_before_a_loop() -> usize:
    names: mutable darray[usize] = []
    fill(&names)
    total: mutable usize = 0
    for index in 0..<names.count |index, names, total|:
        total <- total + names[index]
    return total

# A shared lend is confined for the same reason, and its callee could not write through it anyway.
def a_shared_lend_before_a_loop() -> usize:
    names: mutable darray[usize] = []
    fill(&names)
    seen: usize = read_only(names)
    total: mutable usize = 0
    for index in 0..<names.count |index, names, total|:
        total <- total + names[index]
    return total + seen

# Two bindings lent to the same callee, each confined on its own account.
def two_confined_lends() -> usize:
    names: mutable darray[usize] = []
    others: mutable darray[usize] = []
    fill(&names)
    fill(&others)
    total: mutable usize = 0
    for index in 0..<names.count |index, names, total|:
        total <- total + names[index]
    for index in 0..<others.count |index, others, total|:
        total <- total + others[index]
    return total
