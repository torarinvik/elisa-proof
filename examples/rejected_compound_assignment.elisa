# Compound assignment is not a plain rebind; the old value must not be discarded by the model.

def stale_compound_value(x: i64) -> i64:
    requires x == 0
    ensure result == 0
    value: mutable i64 = 1
    value += x
    return value

struct Box:
    value: mutable i64
    other: mutable i64

def writes_value(box: mutable Box&) -> i64:
    changes box.value
    box.value <- 1
    return 0

def compound_call_outside_frame(box: mutable Box&) -> i64:
    changes box.other
    value: mutable i64 = 0
    value += writes_value(box)
    return value

def pass_value(value: i64) -> i64:
    return value

def nested_call_outside_frame(box: mutable Box&) -> i64:
    changes box.other
    return pass_value(writes_value(box))
