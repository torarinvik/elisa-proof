# The exemption is for a capture the body only reads. A capture the body assigns is forgotten, an
# outer binding the body assigns without capturing it is forgotten, and a capture handed to a
# callee that can write it is forgotten.

extend RejectedCapturedScalar:
    def needs_bound(depth: usize) -> usize:
        requires depth <= 127
        return depth

    def rewrite(slot: mutable usize&) -> bool:
        slot <- 200
        return true

    def a_capture_the_body_assigns_is_forgotten(start: usize, values: darray[usize]&) -> usize:
        requires start <= 127
        depth: mutable usize = start
        for value in values |value, depth|:
            depth <- value
        return needs_bound(depth)

    def a_capture_handed_to_a_writer_is_forgotten(start: usize, values: darray[usize]&) -> usize:
        requires start <= 127
        depth: mutable usize = start
        seen: mutable usize = 0
        for value in values |value, seen, depth|:
            seen <- seen + 1 if rewrite(depth)
        return needs_bound(depth)

    def an_uncaptured_binding_the_body_assigns_is_forgotten(start: usize, values: darray[usize]&) -> usize:
        requires start <= 127
        depth: mutable usize = start
        for value in values |value|:
            depth <- value
        return needs_bound(depth)
