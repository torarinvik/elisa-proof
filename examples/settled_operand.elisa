# `or` and `and` short-circuit, so an operand the left one settles is never evaluated and its
# arithmetic never happens. The unsigned range gate walked the whole expression anyway, and so
# refused goals whose own structure makes the out-of-range operand unreachable.
#
# The shape is the one a range predicate writes: `ensure not result or count <= total - start`.
# On the path that returns false the goal reads `not false or count <= total - start`, whose left
# operand is already true. The subtraction is never performed there -- and the guard it would
# need, `start <= total`, is exactly the thing the early return was rejecting.
#
# Nothing is skipped once the left operand stops settling the answer. `not true or X` still owes
# X, and X still owes its guard.

def empty_range_is_valid(start: usize, count: usize, total: usize) -> bool:
    ensure not result or count <= total - start
    return false

def a_settled_conjunct(start: usize, count: usize, total: usize) -> bool:
    ensure result and count <= total - start or not result
    return false

def the_live_operand_is_still_owed(start: usize, count: usize, total: usize) -> bool:
    requires start <= total
    ensure not result or count <= total - start
    return false if count > total - start
    return true
