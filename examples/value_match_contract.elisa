# A closed value match in a postcondition is encoded as the same checked conditional terms as
# a value match in the function body. This exercises pattern lowering at kernel proposition entry.
def value_match_contract_is_proved(value: i64) -> bool:
    ensure result == (
        when value:
            0 -> true
            _ -> false
    )
    return when value:
        0 -> true
        _ -> false
