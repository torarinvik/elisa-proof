# The loop binder shadows the parameter. The inner value is 1 while the parameter is required
# to be 2, so the inner proof step must not be proved from the outer parameter's fact.
def rejected_match_shadow_fact(x: i64) -> i64:
    requires x == 2
    for x in [1]:
        assert x == 2 by:
            assert x == 2
        return x
    return x
