# A user method named like a builtin numeric conversion is still a real call in an
# if-expression. Its summary must not be replaced by conversion semantics.
struct Meter:
    reading: u8

protocol SignedCastName:
    def i64(self: Self) -> i64

impl SignedCastName for Meter:
    def i64(self: Meter) -> i64:
        ensure result == -1
        return -1

def shadowed_method_is_not_a_conversion(meter: Meter, choose_method: bool) -> i64:
    ensure result >= 0
    return meter.i64() if choose_method else 0
