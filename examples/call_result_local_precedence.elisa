# A same-named peer overload with a different arity must not hide the caller module's local
# declaration or its i64 result bound.
module Peer:
    public:
        def cap(value: u32) -> u32:
            ensure result <= 255
            return 5

module Client:
    public:
        def local_cap_wins() -> bool:
            ensure result
            cap() > 255

        def cap() -> i64:
            ensure result >= 256
            return 300
