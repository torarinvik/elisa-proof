# None of these may be proved. Each claim is false for some admitted input, except two refused
# on purpose: an ensure past a loop whose measure failed, and a sum past the term budget.

# The measure runs the wrong way. The ensure holds, but no loop exit is credited past it.
def flipped_descent(x: i64) -> i64:
    requires x >= 0
    ensure result == x
    count: mutable i64 = 0
    while count < x:
        invariant 0 <= count
        invariant count <= x
        decreases count - x
        count <- count + 1
    count

# Cancellation does not stand in for the wrap guard: at x == 0 and y == 1 the u8 subtraction
# wraps to 255, which is not at most x.
def unguarded_cancellation(x: u8, y: u8) -> void:
    ensure x - y <= x
    return

# `count + count <= x` fails at count == x == 1. A doubled name is outside difference logic.
def doubled_name(x: i64, count: i64) -> void:
    requires 0 <= count and count <= x and x <= 1000
    ensure count + count <= x
    return

# One more step leaves the measure one smaller, not at least as large.
def wrong_step(x: i64, count: i64) -> void:
    requires 0 <= count and count < x and x <= 1000
    ensure x - (count + 1) >= x - count
    return

# At x == 255 the rebind `y == x + 1` wraps to zero. With no strict peer bounding x, it is
# no order between the two.
def rebind_without_peer(x: u8, y: u8) -> void:
    requires y == x + 1
    ensure x < y
    return

# True, since every added group cancels, but its sixty-six occurrences are past the normal
# form's budget, so it is refused rather than read.
def past_the_term_budget(x: i64, count: i64, y: i64, z: i64) -> void:
    requires 0 <= count and count <= x and x <= 1000
    requires 0 <= y and y <= 1000 and 0 <= z and z <= 1000
    ensure x - count + (y - z + z - y) + (y - z + z - y) + (y - z + z - y) + (y - z + z - y) + (y - z + z - y) + (y - z + z - y) + (y - z + z - y) + (y - z + z - y) + (y - z + z - y) + (y - z + z - y) + (y - z + z - y) + (y - z + z - y) + (y - z + z - y) + (y - z + z - y) + (y - z + z - y) + (y - z + z - y) >= 0
    return
