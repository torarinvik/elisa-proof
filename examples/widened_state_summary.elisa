# A finding that only records a construct whose effect was *over-approximated* is not a gap in the
# function's own contract derivation: the checker went on to reason from the havocked state, which
# is weaker than any real execution. Suppressing such a function's summary cost every caller its
# own summary in turn, which is the single largest amplifier of `function-summary-unverified` in
# this codebase -- one unmodelled loop anywhere disqualified a whole call tree above it.
#
# The summary is usable and the function is still not fully verified. Both are reported: the
# declaration's `verification_reason` is `contract-verified-widened-state` rather than `verified`,
# the loop keeps its own `unknown` finding, and the file's verification state stays `unknown`.
def loop_is_havocked_but_the_contract_holds(values: darray[i64]&) -> i64:
    ensure result == 3
    total: mutable i64 = 0
    for v in values |v, total|:
        total <- total + v
    settled: i64 = 3
    return settled

def caller_may_use_that_summary(values: darray[i64]&) -> i64:
    ensure result == 3
    return loop_is_havocked_but_the_contract_holds(values)

# The same for a `while` loop with no invariant: its post-state is havocked, so what follows was
# derived from strictly less than the truth.
def missing_invariant_is_havocked_too(limit: usize) -> i64:
    ensure result == 3
    counter: mutable usize = 0
    while counter < limit |counter, limit|:
        counter <- counter + 1
    settled: i64 = 3
    return settled

def caller_may_use_that_one_too(limit: usize) -> i64:
    ensure result == 3
    return missing_invariant_is_havocked_too(limit)

# The marking travels the call graph rather than one edge: a caller two levels above the widened
# callee is in exactly the same position and says so.
def two_levels_above(limit: usize) -> i64:
    ensure result == 3
    return caller_may_use_that_one_too(limit)

# And it travels no further than the graph. A function whose callees are all fully verified keeps
# `verified`, so the two reasons still separate a checked contract from an over-approximated one.
def untouched_leaf(x: i64) -> i64:
    requires x >= 0
    ensure result == x
    return x

def untouched_caller(x: i64) -> i64:
    requires x >= 0
    ensure result == x
    return untouched_leaf(x)
