# An unverified callee leaves an opaque placeholder as the value of the binding it produces. A
# branch condition mentioning that binding then cannot be represented in the kernel, so it never
# enters a certificate -- and a conjunct derived from it as a premise certified at the producer
# and gapped at replay. Each conjunct the kernel can represent is still true on the path for the
# same reason the condition is, so it is recorded as a branch fact in its own right.

def locate(nodes: darray[usize]&, index: usize) -> (known: bool, value: i64, root: usize):
    ensure result.value == 1
    return (index < nodes.count, 0, index)

def constant(nodes: darray[usize]&, root: usize, depth: usize) -> usize:
    requires depth <= 127
    return 0

# `component.value` is a placeholder, so the whole condition is inadmissible; `root < count` is
# not, and it is the only fact that bounds the depth passed to the guarded call. The goal must
# prove, and its certificate must replay.
#
# The placeholder is produced by a rebinding rather than by the declaration. A local declared from
# a call now keeps its own symbol, so `component.value` after a declaration alone is an ordinary
# place and the whole condition is admissible -- which the last function here records. An
# assignment still leaves the call as the value, and that is the shape this case needs.
def conjunct_beside_a_placeholder(nodes: darray[usize]&, count: usize, root: usize) -> usize:
    requires count <= 127
    component: mutable (known: bool, value: i64, root: usize) = locate(nodes, root)
    component <- locate(nodes, root)
    if root < count and component.value == 1:
        first: usize = constant(nodes, root, root)
        return first
    return 0

# The companion: declared and not rebound, the same field is a place, the whole condition is
# admissible, and the goal proves from it directly.
def a_declaration_from_a_call_is_a_place(nodes: darray[usize]&, count: usize, root: usize) -> usize:
    requires count <= 127
    component: (known: bool, value: i64, root: usize) = locate(nodes, root)
    if root < count and component.value == 1:
        first: usize = constant(nodes, root, root)
        return first
    return 0
