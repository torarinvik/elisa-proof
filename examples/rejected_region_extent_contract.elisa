# The boundary of the extent rule in logical contracts. Only the element count of a binding whose
# *declared type* is a collection is admitted; every other reading of a region-owned binding stays
# refused, and the marker is driven by the declared type rather than by the field's spelling.
struct Node:
    left: usize

# A struct that happens to have a field called `count`. Nothing about it is a collection extent,
# so a contract over it is still a contract over a region-owned value.
struct Holder:
    count: usize

def struct_count_is_not_an_extent[@r](h: Holder& @r) -> usize:
    requires h.count < 10
    return 0

# An element of the collection is region-owned however it is read.
def an_element_in_a_contract[@r](nodes: darray[Node]& @r) -> usize:
    requires nodes[0].left == 1
    return 0

# The binding itself is region-owned.
def the_binding_itself[@r](nodes: darray[Node]& @r, other: darray[Node]& @r) -> usize:
    requires nodes == other
    return 0

# A field of an element is no more admissible than the element.
def a_field_of_an_element[@r](nodes: darray[Node]& @r, index: usize) -> usize:
    requires nodes[index].left < 10
    return 0
