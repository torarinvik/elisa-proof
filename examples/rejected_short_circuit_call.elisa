# A call on the right of a short-circuit may not have run. The checker records no path on which it
# did, so nothing the run alone establishes may be used; its precondition is still an obligation;
# and the state after it is the havoc of a run, never the pre-call state.

def reset(counter: mutable usize&) -> bool:
    changes counter
    ensure result
    counter <- 0
    return true

def needs_small(value: usize) -> bool:
    requires value <= 10
    return true

# With `flag` false the call never ran and the counter is still 5: `result == 0` is false, and
# neither the callee's summary nor its frame may be used to derive it.
def skipped_call_must_not_establish_and(counter: mutable usize&, flag: bool) -> usize:
    requires counter == 5
    ensure result == 0
    written: bool = flag and reset(counter)
    return counter

def skipped_call_must_not_establish_or(counter: mutable usize&, flag: bool) -> usize:
    requires counter == 5
    ensure result == 0
    written: bool = flag or reset(counter)
    return counter

# The same through a branch condition: on the path where `flag` holds the call was skipped.
def skipped_call_must_not_establish_a_guard(counter: mutable usize&, flag: bool) -> usize:
    requires counter == 5
    ensure result == 0
    return 1 if not (flag or reset(counter))
    return counter

# The havoc is applied as if the call ran: with `flag` true the counter is zero, so the pre-call
# value must not be carried across.
def pre_call_value_must_not_survive(counter: mutable usize&, flag: bool) -> usize:
    requires counter == 5
    ensure result == 5
    written: bool = flag and reset(counter)
    return counter

# The precondition of a call that may be skipped is still an obligation.
def skipped_requires_is_still_checked(flag: bool, big: usize) -> bool:
    requires big >= 100
    written: bool = flag and needs_small(big)
    return written
