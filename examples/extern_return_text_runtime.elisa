# Reduced annotation unit controls, not actual-parser correspondence evidence.
include "../build/snapshot/Elisa-compiler/elisacore_std/elisacore_runtime.elisa"
module Ast:
    public:
        struct EnumAnnotation:
            owner: sview
            name: sview
            line: u32
module ElisaProof:
    public:
        const RETURN_TEXT_UNIT_MARKER: u8 = 0
include "../src/proof/replay/extern_return_text.elisa"

extend ElisaProof:
    public:
        def test_return_text_metadata() -> i64:
            rows: mutable darray[Ast::EnumAnnotation] = [
                Ast::EnumAnnotation{owner: "audit", name: "__extern_return_text_complete", line: 1},
                Ast::EnumAnnotation{owner: "__extern_return_text", name: "u8", line: 1}]
            return 1 if not proof_replay_extern_return_text_matches(&rows, "audit", 1, "u8")
            return 2 if proof_replay_extern_return_text_matches(&rows, "other", 1, "u8")
            return 3 if proof_replay_extern_return_text_matches(&rows, "audit", 2, "u8")
            return 4 if proof_replay_extern_return_text_matches(&rows, "audit", 1, "")
            shapes: darray[sview] = ["u8&", "u8?", "mutable heap u8&?", "u8[4]", "Box::u8", "fn(value: u8) -> u8", "u8 error[E]"]
            for shape in shapes:
                rows[1] <- Ast::EnumAnnotation{owner: "__extern_return_text", name: shape, line: 1}
                return 5 if proof_replay_extern_return_text_matches(&rows, "audit", 1, "u8")
                return 6 if not proof_replay_extern_return_text_matches(&rows, "audit", 1, shape)
            rows[1] <- Ast::EnumAnnotation{owner: "__extern_return_text", name: "u8", line: 1}
            rows.push(rows[1])
            return 7 if proof_replay_extern_return_text_matches(&rows, "audit", 1, "u8")
            rows.resize(2)
            rows.push(rows[0])
            return 8 if proof_replay_extern_return_text_matches(&rows, "audit", 1, "u8")
            rows.resize(2)
            rows[0] <- Ast::EnumAnnotation{owner: "other", name: "__extern_return_text_complete", line: 1}
            return 9 if proof_replay_extern_return_text_matches(&rows, "audit", 1, "u8")
            rows[0] <- Ast::EnumAnnotation{owner: "audit", name: "__extern_return_text_complete", line: 2}
            return 10 if proof_replay_extern_return_text_matches(&rows, "audit", 1, "u8")
            rows[0] <- Ast::EnumAnnotation{owner: "__extern_return_text", name: "u8", line: 1}
            rows[1] <- Ast::EnumAnnotation{owner: "audit", name: "__extern_return_text_complete", line: 1}
            return 11 if proof_replay_extern_return_text_matches(&rows, "audit", 1, "u8")
            rows.resize(1)
            return 12 if proof_replay_extern_return_text_matches(&rows, "audit", 1, "u8")
            rows[0] <- Ast::EnumAnnotation{owner: "audit", name: "__extern_return_text_complete", line: 1}
            return 13 if proof_replay_extern_return_text_matches(&rows, "audit", 1, "u8")
            rows.push(Ast::EnumAnnotation{owner: "unrelated", name: "tag", line: 1})
            rows.push(Ast::EnumAnnotation{owner: "__extern_return_text", name: "u8", line: 1})
            return 14 if proof_replay_extern_return_text_matches(&rows, "audit", 1, "u8")
            return 0

def main() -> i64:
    return ElisaProof::test_return_text_metadata()
