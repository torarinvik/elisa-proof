def indexed_read_at_equal_index(rows: array[usize, 8]&, cursor: i64) -> i64:
    requires cursor == 3
    requires rows[cursor] == 64
    ensure rows[3] == 64
    return 0

# One concrete prefix instance isolates index transport from forall elimination.
def indexed_prefix_step(rows: array[usize, 8]&, cursor: i64) -> i64:
    requires cursor >= 0 and cursor < 8
    requires 3 >= cursor or rows[3] == 64
    requires not (rows[cursor] != 64)
    ensure 3 >= cursor + 1 or rows[3] == 64
    return 0

def indexed_read_from_negated_inequality(rows: array[usize, 8]&, cursor: i64) -> i64:
    requires cursor == 3
    requires not (rows[cursor] != 64)
    ensure rows[3] == 64
    return 0
