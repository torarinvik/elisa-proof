# Controls for signed `-literal` bounds: a bound one past what the facts give, and an
# unsigned comparison, where `-literal` wraps and must stay declined.
module Gap:
    public:
        def off_by_one(x: i64, y: i64) -> i64:
            requires x >= 0
            requires x <= 100
            requires y >= x - 5
            ensure y - x >= -4
            return x

        def unsigned_side(x: u32, y: u32) -> u32:
            requires x <= 100
            requires y <= x
            ensure y - x >= -1
            return x
