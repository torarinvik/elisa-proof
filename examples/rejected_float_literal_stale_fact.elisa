# A comparison fact about a mutable float stops applying after assignment.
def requires_nonnegative(value: f32) -> void:
    requires value >= 0.0
    return

def rejected_float_literal_stale_fact(initial: f32, replacement: f32) -> i64:
    value: mutable f32 = initial
    if value < 0.0:
        value <- replacement
        requires_nonnegative(value)
    0
