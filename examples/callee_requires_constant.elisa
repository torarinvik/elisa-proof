# A callee's precondition may name a constant the caller never spells. The caller still
# discharges `fade <= Fade::FULL` because the constant's value is imported for it.
module Fade:
    public:
        const FULL: i64 = 1000

module Gate:
    public:
        def weight(fade: i64) -> i64:
            requires fade >= 0
            requires fade <= Fade::FULL
            ensure result == fade
            return fade

module Uses:
    public:
        def literal_full() -> i64:
            ensure result == 1000
            return Gate::weight(1000)

        def bounded_by_parameter(x: i64) -> i64:
            requires x >= 0
            requires x <= 1000
            ensure result == x
            return Gate::weight(x)
