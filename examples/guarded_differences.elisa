# A guarded unsigned subtraction, `stop - start == 4` beside `start <= stop`, is an exact
# integer difference, and plain orders such as `start < stop` and `stop <= 16` bound a name
# without arithmetic. Both feed the difference graph, and the wrap guard of a goal like
# `start + 3 < 16` may use them to show that the goal's own sum stays in range.
module GuardedDifferences:
    public:
        const CAP: usize = 16

        struct Text:
            bytes: mutable u8[GuardedDifferences::CAP]
            length: mutable usize

        def exact_width(start: usize, stop: usize) -> bool:
            requires start <= stop
            requires stop - start == 4
            requires stop <= 16
            ensure start <= 12
            true

        def last_of_four(start: usize, stop: usize) -> bool:
            requires start <= stop
            requires stop - start == 4
            requires stop <= 16
            ensure start + 3 < 16
            true

        def at_least_four(start: usize, stop: usize) -> bool:
            requires start <= stop
            requires stop - start >= 4
            requires stop <= 16
            ensure start + 3 < 16
            true

        def inside_the_span(start: usize, stop: usize) -> bool:
            requires start <= stop
            requires stop - start == 4
            requires stop <= 16
            ensure start + 3 < stop
            true

        def strict_chain_sum(start: usize, stop: usize) -> bool:
            requires start < stop
            requires stop <= 16
            ensure start + 3 <= 18
            true

        def strict_chain_relative(start: usize, stop: usize) -> bool:
            requires start < stop
            requires stop <= 16
            ensure start + 3 <= stop + 2
            true

        # The record shape the sound asset reader checks: four bytes in a text's range.
        def fourth_byte(text: Text&, start: usize, stop: usize) -> bool:
            requires start <= stop and stop <= text.length and text.length <= CAP
            stop - start == 4 and text.bytes[start + 3] == 1
