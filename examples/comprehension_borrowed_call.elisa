# A comprehension's variable is a scoped value binding: a call inside `any ... where` that takes a
# borrowed reference and the variable must leave a replayable resource certificate.
def same(xs: darray[usize]&, a: usize, b: usize) -> bool:
    return a == b

def any_matches(xs: darray[usize]&, ys: darray[usize]) -> bool:
    return any z in ys where same(xs, z, 0)

def first_unmatched(xs: mutable darray[usize]&, ys: darray[usize]) -> bool:
    found: mutable bool = false
    for y in ys |y, xs, ys, found|:
        continue if any z in ys where same(xs, z, y)
        found <- true
    return found

def shadowing_variable(xs: darray[usize]&, ys: darray[usize]) -> bool:
    return any xs in ys where xs == 0
