module BranchJoin:
    public:
        const CAP: usize = 8

        struct Pool:
            live: mutable bool[BranchJoin::CAP]

        # The untouched arm states the invariant; the arm that assigns derives it from
        # `best == slot` and `slot < CAP`. The join keeps it.
        def pick_if(flag: bool) -> usize:
            ensure result <= CAP
            for slot in 0..<CAP |best: usize = CAP| -> best:
                invariant best <= CAP
                if flag:
                    best <- slot

        def pick_live(pool: Pool&) -> usize:
            ensure result <= CAP
            for slot in 0..<CAP |best: usize = CAP| -> best:
                invariant best <= CAP
                best <- slot if pool.live[slot]

        # `b` is recorded as `best` in one arm and as `slot` in the other; the join reads the
        # arms' facts back over `b`.
        def keep_or_replace(flag: bool, slot: usize, best: usize) -> usize:
            requires best <= 8
            requires slot < 8
            ensure result <= 8
            b: mutable usize = best
            if flag:
                b <- slot
            b
