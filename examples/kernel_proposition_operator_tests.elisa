# Typed proposition formation must distinguish arithmetic from bitwise, shift, range, cast, and
# fallback operators. The raw replay API remains abstract; these checks cover the typed boundary.
def kernel_operator_shape_tests() -> i64 can[Memory.Allocate, Abort.Panic]:
    nodes: mutable darray[ProofKernelNode] = []
    children: mutable darray[usize] = []
    integer_left: usize = add_node(&nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
    integer_right: usize = add_node(&nodes, "int", "", 0, 0, 0, 0, 0, 2, "", "")
    integer_bitwise: usize = add_node(&nodes, "binary", "|", integer_left, integer_right, 0, 0, 0, 0, "", "")
    integer_equality: usize = add_node(&nodes, "binary", "==", integer_bitwise, integer_left, 0, 0, 0, 0, "", "")
    empty_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: []}
    return 1 if not proof_kernel_replay_proposition_formation_report(&nodes, &children, empty_environment, [], integer_equality)

    float_bindings: mutable darray[ProofKernelTypingBinding] = []
    first_float_added: bool = proof_kernel_add_typing_binding(&float_bindings, "value", "first_float", "", "floating", "f64", "", "")
    second_float_added: bool = proof_kernel_add_typing_binding(&float_bindings, "value", "second_float", "", "floating", "f64", "", "")
    return 2 if not first_float_added or not second_float_added
    float_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: float_bindings}
    first_float: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "first_float", "")
    second_float: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "second_float", "")
    float_bitwise: usize = add_node(&nodes, "binary", "&", first_float, second_float, 0, 0, 0, 0, "", "")
    float_bitwise_equality: usize = add_node(&nodes, "binary", "==", float_bitwise, first_float, 0, 0, 0, 0, "", "")
    return 3 if proof_kernel_replay_proposition_formation_report(&nodes, &children, float_environment, [], float_bitwise_equality)
    float_shift: usize = add_node(&nodes, "binary", ">>", first_float, second_float, 0, 0, 0, 0, "", "")
    float_shift_equality: usize = add_node(&nodes, "binary", "==", float_shift, first_float, 0, 0, 0, 0, "", "")
    return 4 if proof_kernel_replay_proposition_formation_report(&nodes, &children, float_environment, [], float_shift_equality)

    integer_range: usize = add_node(&nodes, "binary", "range_lt", integer_left, integer_right, 0, 0, 0, 0, "", "")
    range_equality: usize = add_node(&nodes, "binary", "==", integer_range, integer_left, 0, 0, 0, 0, "", "")
    return 5 if proof_kernel_replay_proposition_formation_report(&nodes, &children, empty_environment, [], range_equality)
    integer_else: usize = add_node(&nodes, "binary", "else", integer_left, integer_right, 0, 0, 0, 0, "", "")
    else_equality: usize = add_node(&nodes, "binary", "==", integer_else, integer_left, 0, 0, 0, 0, "", "")
    return 6 if proof_kernel_replay_proposition_formation_report(&nodes, &children, empty_environment, [], else_equality)
    return 0
