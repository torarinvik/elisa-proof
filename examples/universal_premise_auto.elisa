def signed_universal_instance(value: i64) -> i64:
    requires forall index in -2..<2: value >= index
    ensure value >= -1
    return value

def inclusive_universal_instance(rows: array[usize, 8]&) -> i64:
    requires forall index in 0 ..= 7: rows[index] == 64
    ensure rows[7] == 64
    return 0

def universal_prefix_preservation(rows: array[usize, 8]&, cursor: i64) -> i64:
    requires cursor >= 0 and cursor < 8
    requires forall index in 0..<8: index >= cursor or rows[index] == 64
    requires rows[cursor] == 64
    ensure forall index in 0..<8: index >= cursor + 1 or rows[index] == 64
    return 0
