# `index < xs.count and xs[index] > 0` is how a bounds check is written when the answer is a
# single expression, and it is how every accessor over a parallel state array in this codebase is
# written. It did not discharge the bound. The same guard as an `if` did, and so did an early
# return, so the guard was understood -- just not in the one position that needs no statement.
#
# The right operand of `and` is evaluated only when the left is true, and the right of `or` only
# when the left is false, so an obligation inside it is discharged under that condition exactly as
# the body of a branch is. `examples/rejected_short_circuit_guard.elisa` pins the five ways a guard
# can fail to be one.
def guarded_and(xs: darray[i64]&, index: usize) -> bool:
    return index < xs.count and xs[index] > 0

def guarded_or(xs: darray[i64]&, index: usize) -> bool:
    return index >= xs.count or xs[index] > 0

# The spellings that already worked, so the fixture shows all four agreeing.
def guarded_if(xs: darray[i64]&, index: usize) -> bool:
    if index < xs.count:
        return xs[index] > 0
    return false

def guarded_early_return(xs: darray[i64]&, index: usize) -> bool:
    return false if index >= xs.count
    return xs[index] > 0

# The shape the kernel's own state accessors use: a guard over one collection and a read of
# another, chained through the conjunction.
def guards_two_reads(xs: darray[i64]&, ys: darray[i64]&, index: usize) -> bool:
    requires ys.count == xs.count
    return index < xs.count and xs[index] > 0 and ys[index] > 0
