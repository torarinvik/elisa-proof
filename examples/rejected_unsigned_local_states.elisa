type Byte = u8
type RefinedByte = Byte where true

def rebound_overflow() -> void:
    x: mutable Byte = 0
    x <- 255
    proof x + 1 > x:
        assert x + 1 > x

def compound_overflow() -> void:
    x: mutable u8 = 255
    x += 1
    proof x > 255:
        assert x > 255

def branch_local(flag: bool) -> void:
    if flag:
        x: RefinedByte = 255
        proof x + 1 > x:
            assert x + 1 > x

def shadowed_local(x: i64) -> void:
    if true:
        x: u8 = 255
        proof x + 1 > x:
            assert x + 1 > x

def loop_local(flag: bool) -> void:
    while flag:
        x: u8 = 255
        proof x + 1 > x:
            assert x + 1 > x

# Even a safe unsigned local currently needs typed symbolic binding support.
# This regression documents the temporary conservative loss of expressiveness.
def bounded_local() -> void:
    x: u8 = 254
    proof x + 1 > x:
        assert x + 1 > x
