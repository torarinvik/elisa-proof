type Byte = u8
type RefinedByte = Byte where true

def rebound_overflow() -> void:
    x: mutable Byte = 0
    x <- 255
    proof x + 1 > x:
        assert x + 1 > x

def compound_overflow() -> void:
    x: mutable u8 = 255
    x += 1
    proof x > 255:
        assert x > 255

def branch_local(flag: bool) -> void:
    if flag:
        x: RefinedByte = 255
        proof x + 1 > x:
            assert x + 1 > x

def shadowed_local(x: i64) -> void:
    if true:
        x: u8 = 255
        proof x + 1 > x:
            assert x + 1 > x

def loop_local(flag: bool) -> void:
    while flag:
        x: u8 = 255
        proof x + 1 > x:
            assert x + 1 > x

# A wrapping initializer leaves the local opaque within its type range; it must not be
# folded into signed arithmetic that would make the value exceed the range.
def wrapped_initializer() -> void:
    x: u8 = 255
    y: u8 = x + 1
    proof y > x:
        assert y > x

# A local that reuses a parameter spelling must not inherit the parameter's facts.
def shadow_parameter(x: i64) -> void:
    requires x == 5
    if true:
        x: u8 = 255
        assert x == 5 by:
            assert x == 5

# A binding recorded in terms of an unsigned symbol must be forgotten when that symbol
# is rebound; otherwise the stale value would describe the new one.
def stale_dependent(flag: bool) -> void:
    x: mutable u8 = 5
    y: i64 = x
    x <- 7
    assert y == x by:
        assert y == x
