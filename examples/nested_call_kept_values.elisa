# A call nested in a local's initializer keeps every value the callee cannot reach, under
# the rule a call statement applies. A loop binder nothing lends is such a value, so it
# still denotes the loop's range atom after `marks[slot] and open(board, slot)`, and each
# index below is proved from the loop's range facts, before or after the call.
module Tally:
    public:
        const SIZE: usize = 4

        struct Board:
            marks: bool[Tally::SIZE]
            locked: bool[Tally::SIZE]

        def open(board: Board&, slot: usize) -> bool:
            return false if slot >= SIZE
            not board.locked[slot]

        def small(slot: usize) -> bool:
            slot < 2

        def index_then_call(board: Board&) -> usize:
            for slot in 0..<SIZE |best: usize = SIZE| -> best:
                candidate: bool = board.marks[slot] and open(board, slot)
                best <- slot if candidate

        def call_then_index(board: Board&) -> usize:
            for slot in 0..<SIZE |best: usize = SIZE| -> best:
                candidate: bool = open(board, slot) and board.marks[slot]
                best <- slot if candidate

        def scalar_call(board: Board&) -> usize:
            for slot in 0..<SIZE |count: usize = 0| -> count:
                counted: bool = board.marks[slot] and small(slot)
                count <- count + 1 if counted and count < SIZE

        def plain_loop(board: Board&) -> bool:
            for slot in 0..<SIZE:
                candidate: bool = board.marks[slot] and not board.locked[slot] and open(board, slot)
                return true if candidate
            false
