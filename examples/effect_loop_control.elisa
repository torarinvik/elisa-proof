# Control transfers do not introduce opaque callees or imply loop exhaustion.
def effect_break_keeps_value(n: i64) -> i64 can[Unsafe.RawExtern]:
    requires n >= 0
    ensure result == n
    while n > 0:
        invariant n >= 0
        decreases n
        break
    return n

def effect_continue_keeps_value(n: i64) -> i64 can[Unsafe.RawExtern]:
    requires n >= 0
    ensure result == n
    cursor: mutable i64 = n
    while cursor > 0 |cursor|:
        invariant cursor >= 0
        decreases cursor
        cursor <- cursor - 1
        continue
    return n
