# Minimized sound-asset preservation gap; search closes, independent replay remains open.
def digit_loop(byte: u64) -> u64:
    ensure result <= 1000000
    for index in 0..<1 |value: u64 = 0| -> value:
        invariant value <= 1000000
        digit: u64 = byte - 48 if byte >= 48 and byte <= 57 else 0
        value <- 1000000 if value >= 1000000 / 10 else value * 10 + digit
