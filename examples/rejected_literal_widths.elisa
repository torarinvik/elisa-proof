# The boundary of literal widths. The source type checker refuses a literal that does not
# fit only when its peer is a bare name, so each fact below compiles with its literal wrapped
# to the operand width: `a + 0 == 256` is `a + 0 == 0` at u8. Read exactly, every such fact is
# unsatisfiable and would close any goal, so a state holding one proves nothing.
module RejectedLiteralWidths:
    public:
        # 256 wraps to 0 at u8, so `a` is 0, not 7.
        def plus_zero(a: u8) -> bool:
            requires a + 0 == 256
            ensure a == 7
            true

        # 300 wraps to 44 at u8.
        def times_one(a: u8) -> bool:
            requires a * 1 == 300
            ensure a == 7
            true

        # A guarded difference of 256 is a difference of 0 at u8.
        def wide_difference(a: u8, b: u8) -> bool:
            requires a <= b and b - a == 256
            ensure a == 7
            true

        # 300 wraps to 44 at u8, which `a + b` reaches.
        def wide_sum(a: u8, b: u8) -> bool:
            requires a + b == 300
            ensure a == 7
            true

        # -1 wraps to 255 at u8, which `a + b` reaches.
        def negative_unsigned(a: u8, b: u8) -> bool:
            requires a + b == -1
            ensure a == 7
            true

        # 200 wraps to -56 at i8.
        def wide_signed(a: i8, b: i8) -> bool:
            requires a + b == 200
            ensure a == 7
            true

        # -129 wraps to 127 at i8.
        def below_signed_minimum(a: i8) -> bool:
            requires a + 0 == -129
            ensure a == 7
            true

        # In a goal as well: 128 wraps to -128 at i8, which `a + 0` reaches.
        def wide_goal(a: i8) -> bool:
            ensure a + 0 != 128
            true
