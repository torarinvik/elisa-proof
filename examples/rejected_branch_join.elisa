module RejectedBranchJoin:
    public:
        # One arm may leave `b` at 9.
        def replace_too_far(flag: bool, slot: usize, best: usize) -> usize:
            requires best <= 8
            requires slot < 10
            ensure result <= 8
            b: mutable usize = best
            if flag:
                b <- slot
            b

        # The join value is not always `best`.
        def not_always_kept(flag: bool, slot: usize, best: usize) -> usize:
            requires best <= 8
            requires slot < 8
            ensure result == best
            b: mutable usize = best
            if flag:
                b <- slot
            b

        # `b <- b + 1` rebinds `b` to a fresh symbol; the arm's `b == best` speaks of the old
        # value and must not cross the join as a fact about the new one.
        def stale_rebind(flag: bool, best: usize) -> usize:
            requires best <= 8
            ensure result <= 8
            b: mutable usize = best
            if flag:
                b <- b + 1
            b
