struct RequiredReferenceNode:
    tag: mutable u8
struct RequiredReferenceStore:
    prepared: mutable heap RequiredReferenceNode&?

def required_reference_store(store: mutable RequiredReferenceStore&, node: mutable heap RequiredReferenceNode&) -> u8:
    ensure result != 0 or store.prepared != null
    store.prepared <- node
    return 0

def required_reference_branch_store(store: mutable RequiredReferenceStore&, node: mutable heap RequiredReferenceNode&, action: u8) -> u8:
    ensure result != 0 or action != 1 or store.prepared != null
    if action == 1:
        store.prepared <- node
    return 0
