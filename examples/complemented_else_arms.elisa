# The else arm of an if-expression runs only when its condition fails, so the complement
# bounds it: a multiply the failed condition keeps small does not wrap.
module ComplementedElseArms:
    def scaled(v: u64) -> u64:
        requires v <= 1000000000000000000
        ensure result <= 1000000000000000000
        5 if v >= 100000000000000000 else v * 10 + 9

    def saturated(v: u64) -> u64:
        requires v <= 1000000000000000000
        ensure result <= 1000000000000000000
        1000000000000000000 if v >= 100000000000000000 else v * 10 + 9

    def saturated_loop(start: usize, stop: usize) -> u64:
        ensure result <= 1000000000000000000
        for index in start..<stop |value: u64 = 0| -> value:
            invariant value <= 1000000000000000000
            value <- 1000000000000000000 if value >= 100000000000000000 else value * 10 + 9

    def below(byte: u64) -> u64:
        ensure result <= 9
        9 if byte < 48 or byte > 57 else byte - 48
