module LoopStateJoins:
    const MAX: usize = 4096
    const FIELDS: usize = 9
    const CAP: u64 = 1000000
    error ParseError:
        Count
        Syntax
    struct Source:
        bytes: mutable u8[LoopStateJoins::MAX]
        length: mutable usize
    struct Fields:
        values: u64[LoopStateJoins::FIELDS]
        count: usize

    def skip(source: Source&, start: usize, stop: usize) -> usize:
        requires start <= stop and stop <= source.length and source.length <= MAX
        ensure start <= result and result <= stop
        start

    def decimal(source: Source&, start: usize, stop: usize) -> u64 error[ParseError]:
        requires start <= stop and stop <= source.length and source.length <= MAX
        ensure result < CAP
        raise ParseError.Syntax if start == stop
        value: u64 =
            for index in start..<stop |value: u64 = 0| -> value:
                invariant value <= CAP
                byte: u64 = source.bytes[index].u64()
                digit: u64 = byte - 48 if byte >= 48 and byte <= 57 else 0
                value <- CAP if value >= CAP / 10 else value * 10 + digit
        raise ParseError.Syntax if value >= CAP
        value

    # A conditional binding bounds the sum it feeds.
    def digit_step(value: u64, byte: u64) -> u64:
        requires value <= 1000
        ensure result <= 10009
        digit: u64 = byte - 48 if byte >= 48 and byte <= 57 else 0
        value * 10 + digit

    # A fixed-array local has the count its type states.
    def local_extent(slot: usize) -> u64:
        requires slot < FIELDS
        values: mutable u64[LoopStateJoins::FIELDS] = zeroed
        values[slot] <- 3
        values[slot]

    # A captured loop's invariant may name a module constant.
    def constant_invariant() -> usize:
        count: mutable usize = 0
        for slot in 0..<FIELDS |count|:
            invariant count <= FIELDS
            count <- count
        count

    # A rebind to an alias of the old value keeps what held of it.
    def alias_rebind(start: usize, stop: usize) -> usize:
        requires start <= stop
        cursor: mutable usize = start
        for slot in 0..<9 |cursor|:
            invariant cursor <= stop
            begin: usize = cursor
            cursor <- begin
        cursor

    # A negated order is proved from its converse.
    def negated_order(b: usize, s: usize, c: usize) -> usize:
        requires b < s and c == b
        ensure not (b < result)
        c

    # Both arms rebind the counters; the invariants hold again at the join.
    def rebound_arms(source: Source&, start: usize, stop: usize) -> usize:
        requires start <= stop and stop <= source.length and source.length <= MAX
        ensure result <= FIELDS
        cursor: mutable usize = start
        count: mutable usize = 0
        for slot in 0..<FIELDS + 1 |cursor, count|:
            invariant count <= FIELDS
            invariant cursor <= stop
            begin: usize = skip(source, cursor, stop)
            if begin < stop and source.bytes[begin] != 35:
                count <- count + 1 if count < FIELDS else count
                cursor <- begin
            else:
                cursor <- stop
        count

    # An arm that declares a local still joins; no joined fact names the local.
    def arm_local(source: Source&, start: usize, stop: usize) -> Fields error[ParseError]:
        requires start <= stop and stop <= source.length and source.length <= MAX
        ensure result.count <= FIELDS
        fields: mutable u64[LoopStateJoins::FIELDS] = zeroed
        cursor: mutable usize = start
        count: mutable usize = 0
        for slot in 0..<FIELDS + 1 |cursor, count, fields|:
            invariant count <= FIELDS
            invariant cursor <= stop
            begin: usize = skip(source, cursor, stop)
            if begin < stop and source.bytes[begin] != 35:
                raise ParseError.Count if count >= FIELDS
                value: u64 = try decimal(source, begin, stop)
                fields[count] <- value
                count <- count + 1
                cursor <- begin
            else:
                cursor <- stop
        Fields{values: fields, count: count}

    # An aggregate local carries its call's summary over its fields.
    def aggregate_summary(source: Source&, start: usize, stop: usize) -> usize error[ParseError]:
        requires start <= stop and stop <= source.length and source.length <= MAX
        ensure result <= FIELDS
        record: Fields = try arm_local(source, start, stop)
        record.count
