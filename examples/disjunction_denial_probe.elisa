struct DisjunctionDenialNode:
    value: u8

def disjunction_denial_boolean(choose: bool) -> u8:
    ensure choose or not choose
    return 0

def disjunction_denial_nullable(node: heap DisjunctionDenialNode&?) -> u8:
    ensure node != null or node == null
    return 0

def disjunction_denial_conditional(choose: bool) -> u8:
    ensure not choose or result == 1
    ensure choose or result == 2
    return 1 if choose else 2
