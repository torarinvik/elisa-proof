# A guard fact about a float variable is stale after a loop that may write it.
def requires_nan(value: f32) -> void:
    requires value != value
    return

def rejected_float_stale_after_loop(initial: f32, replacement: f32, count: i64) -> i64:
    value: mutable f32 = initial
    if value != value:
        for index in 0..<count:
            value <- replacement
        requires_nan(value)
    0
