# The conversion does not excuse the bounds. A possibly negative or too-large value is refused,
# and a signed-target conversion is not read through.
module RejectedConvertedIndexBounds:
    def unchecked_low(values: darray[i64]&, frame: i64) -> i64:
        count: i64 = values.count.i64()
        return 0 if frame >= count
        return values[frame.usize()]

    def unchecked_high(values: darray[i64]&, frame: i64) -> i64:
        return 0 if frame < 0
        return values[frame.usize()]

    def signed_target(values: darray[i64]&, frame: i64) -> i64:
        return 0 if frame < 0 or frame >= values.count.i64()
        return values[frame.i32()]
