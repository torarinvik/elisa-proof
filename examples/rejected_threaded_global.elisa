# A global is not a local of the calling frame: any later call may write it, so a lend of one
# is never read as a value update.

global mutable counter: usize = 0

def bump(value: mutable usize&) -> void:
    requires value[0] < 1000
    ensure value[0] == old(value[0]) + 1
    value[0] <- value[0] + 1
    return

def global_threaded() -> usize:
    ensure result == 1
    counter <- 0
    bump(&counter)
    return counter

