def rejected_negated_order_strict_increment(cursor: i64, limit: i64, flag: bool) -> i64:
    requires cursor >= 0
    requires limit > 0 and limit <= 8
    requires not (cursor >= limit)
    ensure result < limit
    return cursor + 1 if flag
    return cursor + 1

def rejected_boolean_as_order(flag: bool) -> i64:
    requires flag
    ensure result <= 0
    return 1
