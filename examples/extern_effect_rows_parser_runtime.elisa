# Correspondence control: actual pinned parser output, not reduced annotation records.
include "../build/snapshot/Elisa-compiler/elisacore_std/elisacore_runtime.elisa"
include "../build/snapshot/Elisa-compiler/src/parser/parser.elisa"
using Ast
module ElisaProof:
    public:
        const PARSER_ROW_TEST_MARKER: u8 = 0
include "../src/proof/check/extern_effect_rows.elisa"

extend ElisaProof:
    public:
        def test_parser_extern_row(source: u8&, expected_complete: bool, expected_count: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            tokens: darray[Token] = frontend_tokenize(source, source)
            file: Ast::File = frontend_parser_parse_file(source, tokens)
            members: mutable darray[sview] = []
            complete: bool = proof_import_extern_effect_row(&file.enum_annotations, "audit", 1, &members)
            return false if complete != expected_complete or members.count != expected_count
            if expected_count == 2:
                return false if members[0] != "Unsafe.RawExtern" or members[1] != "Abort.Panic"
            return true

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    return 1 if not ElisaProof::test_parser_extern_row("extern audit(x: u8) -> u8 can[Unsafe.RawExtern, Abort.Panic]\n", true, 2)
    return 2 if not ElisaProof::test_parser_extern_row("extern audit(x: u8) -> u8 can[]\n", true, 0)
    return 3 if not ElisaProof::test_parser_extern_row("extern audit(x: u8) -> u8\n", false, 0)
    return 4 if not ElisaProof::test_parser_extern_row("extern audit(x: u8) -> u8 can[Unsafe.RawExtern, Abort.Panic\n", false, 0)
    return 0
