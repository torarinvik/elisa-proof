# Dispatching a quantifier must not bypass machine arithmetic in each instance.
def quantified_unsigned_wrap(code: u8) -> u8:
    requires code == 255
    ensure forall i in 0 ..< 2: code + 1 > code
    return 0

def quantified_signed_wrap(code: i8) -> u8:
    requires code == 127
    ensure forall i in 0 ..< 2: code + 1 > code
    return 0
