# The place marker answers one question and is refused for every other. It says the term has an
# unsigned type; it does not say the value is positive, it is not carried by a signed field, and a
# term with no unsigned atom in it has no type argument at all.

extend AmbiguousLeafOne:
    struct Shared:
        value: usize

extend AmbiguousLeafTwo:
    struct Shared:
        value: usize

extend RejectedUnsignedPlace:
    struct Signed:
        offset: i64
        span: i64

    struct Node:
        children_start: usize
        children_count: usize

    def other(value: usize) -> i64:
        return 0

    # A signed field carries no unsigned marker, and a signed sum of nonnegative parts overflows.
    def a_signed_field_is_not_nonnegative(value: Signed, index: i64) -> bool:
        requires 0 <= index
        ensure result
        return 0 <= value.offset + index

    # Nonnegative is not positive.
    def a_field_is_not_positive(node: Node) -> bool:
        ensure result
        return 0 < node.children_start

    # A call result has no marker of its own, and the argument's does not travel through it.
    def a_call_result_carries_no_marker(node: Node) -> bool:
        ensure result
        return 0 <= other(node.children_start)

    # The type argument gives no upper bound.
    def an_unsigned_field_has_no_upper_bound(node: Node, children: darray[usize]&) -> bool:
        ensure result
        return node.children_start < children.count

    # A qualified spelling resolves to its leaf, and an ambiguous leaf names no struct. The
    # witness is lost rather than guessed.
    def an_ambiguous_leaf_names_no_struct(value: AmbiguousLeafOne::Shared) -> bool:
        ensure result
        return 0 <= value.value
