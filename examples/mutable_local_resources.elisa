module MutableLocalResources:
    public:
        def direct_write() -> i64:
            ensures result == 2
            mutable value: i64 = 1
            value <- value + 1
            return value

        def captured_write(values: darray[i64]&) -> i64:
            mutable total: i64 = 0
            for value in values |total|:
                total <- total + value
            return total
