# A counter that climbs to its bound. The measure `x - count` names two variables, so the
# affine tiers cannot read it; cancellation reduces each claim about it to one difference
# between `x` and `count`, which the invariants and the loop guard decide.
def count_up_signed(x: i64) -> i64:
    requires x >= 0
    ensure result == x
    count: mutable i64 = 0
    while count < x:
        invariant 0 <= count
        invariant count <= x
        decreases x - count
        count <- count + 1
    count

# The same loop over a machine word. The next measure, `x - (count + 1)`, is read through the
# rebind `next == count + 1`, which the strict guard `count < x` keeps from wrapping.
def count_up_unsigned(x: usize) -> usize:
    ensure result == x
    count: mutable usize = 0
    while count < x:
        invariant count <= x
        decreases x - count
        count <- count + 1
    count

# A difference with its constant moved across the comparison.
def transposed_difference(x: i64, y: i64) -> void:
    requires 0 <= y and y <= 1000
    requires y + 3 <= x and x <= 2000
    ensure x - y >= 3
    return

def unsigned_gap(x: u32, y: u32) -> void:
    requires y < x
    ensure x - y >= 1
    return

# Names on both sides cancel, leaving a constant comparison.
def shared_names_cancel(a: i64, b: i64) -> void:
    requires 0 <= a and a <= 1000
    requires 0 <= b and b <= 1000
    ensure (a + b) - b == a
    ensure a - (b + 1) < a - b
    return

# A rebind beside its strict peer orders the two counters, which licenses both subtractions.
def rebind_beside_peer(count: usize, x: usize, next: usize) -> void:
    requires count < x
    requires next == count + 1
    ensure x - next < x - count
    return

# Sixty-two occurrences, all but two of which cancel: inside the normal form's budget.
def within_the_term_budget(x: i64, count: i64, y: i64, z: i64) -> void:
    requires 0 <= count and count <= x and x <= 1000
    requires 0 <= y and y <= 1000 and 0 <= z and z <= 1000
    ensure x - count + (y - z + z - y) + (y - z + z - y) + (y - z + z - y) + (y - z + z - y) + (y - z + z - y) + (y - z + z - y) + (y - z + z - y) + (y - z + z - y) + (y - z + z - y) + (y - z + z - y) + (y - z + z - y) + (y - z + z - y) + (y - z + z - y) + (y - z + z - y) + (y - z + z - y) >= 0
    return
