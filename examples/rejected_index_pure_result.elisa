# Purity is not an index bound. The exact pure result is one greater than the caller's proven
# position, so the caller's `index < values.count` precondition is insufficient.

def successor_index(index: usize) -> usize:
    ensure result == index + 1
    return index + 1

def rejected_index_pure_result(values: darray[i64]&, index: usize) -> i64:
    requires index < values.count
    return values[successor_index(index)]
