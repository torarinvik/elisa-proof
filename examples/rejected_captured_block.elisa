# The write-back is the whole reason a captured block cannot be treated as a pure expression. It is
# modelled by havocking the outer symbolic values and facts, so nothing established before the loop
# may be used after it: not a fact about a captured binding, not its symbolic value, and not a fact
# about anything else the block might have reached.
def fact_must_not_survive(values: darray[i64]&) -> i64:
    ensure result == 0
    total: mutable i64 = 0
    for value in values |value, total|:
        total <- total + value
    return total

def value_must_not_survive(values: darray[i64]&) -> i64:
    ensure result == 7
    total: mutable i64 = 7
    for value in values |value, total|:
        total <- total + value
    return total


# An obligation inside the body is checked rather than skipped, and an unprovable one stays
# unproven instead of disappearing with the invalidated path.
def obligation_inside_is_not_skipped(values: darray[i64]&, index: usize) -> i64:
    total: mutable i64 = 0
    for value in values |value, total, values, index|:
        total <- total + values[index]
    return total
