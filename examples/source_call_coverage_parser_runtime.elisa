# Actual-parser controls for independent executable coverage and lexical binding.
include "../build/snapshot/Elisa-compiler/elisacore_std/elisacore_runtime.elisa"
include "../build/snapshot/Elisa-compiler/src/parser/parser.elisa"
using Ast
module ElisaProof:
    public:
        const SOURCE_CALL_TEST_MARKER: u8 = 0
include "../src/proof/replay/source_call_coverage.elisa"

extend ElisaProof:
    public:
        def test_source_calls(source: u8&, expected: bool, wanted: darray[sview]&) -> bool can[Memory.Allocate, Abort.Panic]:
            tokens: darray[Token] = frontend_tokenize(source, source)
            file: Ast::File = frontend_parser_parse_file(source, tokens)
            return false if file.errors.count != 0 or file.top_decls.count != 1
            match file.top_decls[0]:
                Ast::Decl.Func(_, parameters, _, body, _, _, _):
                    calls: mutable darray[sview] = ["stale"]
                    valid: bool = proof_replay_source_calls(&parameters, &body, &calls)
                    return false if valid != expected
                    return false if proof_replay_source_call_set_matches(&parameters, &body, wanted) != expected
                    return calls.count == 0 if not expected
                    return false if calls.count != wanted.count
                    for name in wanted |calls|:
                        return false if not (any called in calls where called == name)
                    forged: darray[sview] = ["forged"]
                    return false if proof_replay_source_call_set_matches(&parameters, &body, &forged)
                    if calls.count == 2:
                        omitted: darray[sview] = [calls[0]]
                        duplicate: darray[sview] = [calls[0], calls[0]]
                        extra: darray[sview] = [calls[0], calls[1], "forged"]
                        return false if proof_replay_source_call_set_matches(&parameters, &body, &omitted) or proof_replay_source_call_set_matches(&parameters, &body, &duplicate) or proof_replay_source_call_set_matches(&parameters, &body, &extra)
                    return true
                _:
                    return false

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    audit: darray[sview] = ["audit"]
    both: darray[sview] = ["audit", "other"]
    none: darray[sview] = []
    return 1 if not ElisaProof::test_source_calls("def run(x: u8) -> u8:\n    return audit(x)\n", true, &audit)
    return 2 if not ElisaProof::test_source_calls("def run(x: u8) -> u8:\n    value: u8 = audit(other(x))\n    return audit(value)\n", true, &both)
    return 3 if not ElisaProof::test_source_calls("def run(audit: u8) -> u8:\n    return audit(0)\n", false, &none)
    return 4 if not ElisaProof::test_source_calls("def run(x: u8) -> u8:\n    audit: u8 = 0\n    return audit(x)\n", false, &none)
    return 5 if not ElisaProof::test_source_calls("def run(x: u8) -> u8:\n    audit = 0\n    return audit(x)\n", false, &none)
    return 6 if not ElisaProof::test_source_calls("def run(x: u8) -> u8:\n    if x == 0:\n        audit: u8 = 0\n    return audit(x)\n", true, &audit)
    return 7 if not ElisaProof::test_source_calls("def run(x: u8) -> u8:\n    for audit in 0..<2:\n        audit(x)\n    return 0\n", false, &none)
    return 8 if not ElisaProof::test_source_calls("def run(x: u8) -> u8:\n    for audit in 0..<2:\n        other(audit)\n    return audit(x)\n", true, &both)
    return 9 if not ElisaProof::test_source_calls("def run(x: u8) -> u8:\n    match x:\n        audit:\n            return audit(0)\n", false, &none)
    return 10 if not ElisaProof::test_source_calls("def run(x: u8 = audit(0)) -> u8:\n    return other(x)\n", true, &both)
    return 11 if not ElisaProof::test_source_calls("def run(x: u8) -> u8:\n    requires other(x) == 0\n    ensure other(result) == 0\n    assert audit(x) == 0\n    return x\n", true, &audit)
    return 12 if not ElisaProof::test_source_calls("def run(x: u8) -> u8:\n    return Box::audit(x)\n", false, &none)
    return 13 if not ElisaProof::test_source_calls("def run(x: u8) -> u8:\n    return x.audit()\n", false, &none)
    return 14 if not ElisaProof::test_source_calls("def run(x: u8) -> u8:\n    if x == 0:\n        return audit(x)\n    else:\n        return other(x)\n", true, &both)
    return 15 if not ElisaProof::test_source_calls("def run(x: u8) -> u8:\n    audit: u8 = audit(x)\n    return audit\n", true, &audit)
    return 16 if not ElisaProof::test_source_calls("def run(x: u8) -> u8:\n    other(x)\n    audit: u8 = 0\n    return audit(x)\n", false, &none)
    return 17 if not ElisaProof::test_source_calls("def run(x: u8) -> u8:\n    match x:\n        audit:\n            other(audit)\n    return audit(x)\n", true, &both)
    return 18 if not ElisaProof::test_source_calls("def run(x: u8) -> u8:\n    for audit in 0..<2 |audit|:\n        audit(x)\n    return 0\n", false, &none)
    return 19 if not ElisaProof::test_source_calls("def run(x: u8) -> u8:\n    assert audit(x) == 0 by:\n        requires other(x) == 0\n    return x\n", true, &audit)
    return 20 if not ElisaProof::test_source_calls("def run(x: u8, audit: u8 = audit(0)) -> u8:\n    return x\n", false, &none)
    return 21 if not ElisaProof::test_source_calls("def run(x: u8) -> bool:\n    return any audit in 0..<2 where audit(x) == 0\n", false, &none)
    return 0
