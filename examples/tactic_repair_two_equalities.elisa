# The first equality rewrites the target; the second is a valid but irrelevant context fact.
def repair_from_the_selected_equality(x: i64, y: i64) -> void:
    requires (x + 1 == 3)
    requires y == 5
    ensure (x + 1) * 2 == 6
    return

# Keep the imported source partial so tactic admission stays scoped to the selected goal.
def separate_open_goal(x: i64) -> i64:
    requires x == 2
    ensure result == x + 1
    return x
