protocol Eq:
    def __eq__(self: Self, other: Self) -> bool

const enum ShorthandOverloadedOwner of i64:
    On = 1

impl Eq for ShorthandOverloadedOwner:
    def __eq__(self: ShorthandOverloadedOwner, other: ShorthandOverloadedOwner) -> bool:
        return false

def sourceoverloadedEq(value: ShorthandOverloadedOwner) -> bool:
    ensure result == false
    return value == .On
