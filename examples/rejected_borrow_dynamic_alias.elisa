# A dynamic borrow conservatively owns the whole root, so a later mutable element borrow must
# conflict even though the runtime indexes might happen to differ.
def rejected_borrow_dynamic_alias(values: mutable i64[2], index: usize) -> i64:
    requires index < 2
    shared: i64& = &values[index]
    exclusive: mutable i64& = &values[0]
    return values[0]
