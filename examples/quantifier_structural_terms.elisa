# Quantifier replay must preserve structured bodies while instantiating binders.

struct Pair:
    left: i64
    right: i64

def forall_array_structural() -> i64:
    ensure forall value in [1, 2, 3]: [value] == [value]
    return 0

# Nested side-table owners exercise canonical arena slicing both during source lowering and when
# the quantifier binder is substituted by the independent replay kernel.
def forall_nested_array_structural() -> i64:
    ensure forall value in [1, 2, 3]: [[value], [value]] == [[value], [value]]
    return 0

def forall_nested_tuple_structural() -> i64:
    ensure forall value in [1, 2, 3]: ([value], [value]) == ([value], [value])
    return 0

def forall_nested_dictionary_structural() -> i64:
    ensure forall value in [1, 2, 3]: {1: (value, 0), 2: (value, 0)} == {1: (value, 0), 2: (value, 0)}
    return 0

def forall_conditional_structural() -> i64:
    ensure forall value in [1, 2, 3]: (value if value >= 0 else 0) == (value if value >= 0 else 0)
    return 0

def forall_construct_structural() -> i64:
    ensure forall value in [1, 2, 3]: Pair{left: value, right: 0} == Pair{left: value, right: 0}
    return 0
