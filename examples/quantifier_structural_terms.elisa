# Quantifier replay must preserve structured bodies while instantiating binders. Every body here
# compares primitive scalars: an aggregate has no `==` of its own, so the aggregate forms are
# entered through a projection, and the refused aggregate comparisons live in
# `rejected_aggregate_equality.elisa`.

struct Pair:
    left: i64
    right: i64

def forall_conditional_structural() -> i64:
    ensure forall value in [1, 2, 3]: (value if value >= 0 else 0) == (value if value >= 0 else 0)
    return 0

# Field initializers retain their child graphs under substitution and the projection reduces.
def forall_construct_structural() -> i64:
    ensure forall value in [1, 2, 3]: Pair{left: value, right: 0}.left == value
    return 0

def forall_nested_construct_structural() -> i64:
    ensure forall value in [1, 2, 3]: Pair{left: Pair{left: value, right: 0}.left, right: 0}.left == value
    return 0
