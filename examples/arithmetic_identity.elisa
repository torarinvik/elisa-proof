# Fixed-width identities are accepted only when their rewrite is total for every i64 value.

def zero_product(x: i64) -> i64:
    ensure result == 0
    return x * 0

def one_product(x: i64) -> i64:
    ensure result == x
    return 1 * x

def zero_offset(x: i64) -> i64:
    ensure result == x
    return x + 0

def bounded_increment(x: i64) -> i64:
    requires x <= 9223372036854775806
    ensure result > x
    return x + 1

def bounded_decrement(x: i64) -> i64:
    requires x >= -9223372036854775807
    ensure result < x
    return x - 1
