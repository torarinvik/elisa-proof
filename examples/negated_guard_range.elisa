# `return 0 if start > total` is how a guard is written, and it reaches the statements after it as
# `not (start > total)`. Every rule built on the order query read only the positive spelling: the
# affine tiers normalize a negation, but they name one bare identifier, so an order stated between
# a place and a name -- `start <= values.count` -- was stated and unreadable. The same range check
# written as an `if` condition proved; written as two early returns it did not.
#
# Reading `not (start > total)` as `start <= total` is the totality of the primitive order. `>`
# dispatches to a user comparison method whenever an operand is a struct, and that method need not
# be total, so both operands must carry a primitive scalar witness. A positive fact needs none: it
# is used as itself, with no inference over its operator.

# The difference form, which is the range check an unsigned type supports, written with early
# returns. The upper bound needs `start <= values.count` from the first guard.
def a_negated_range_check(values: darray[usize]&, start: usize, index: usize) -> usize:
    return 0 if start > values.count
    return 0 if index >= values.count - start
    return values[start + index]

# The same check as an `if` condition, which was always readable, kept here so the pair is one
# fixture: the two spellings must agree.
def the_same_check_as_a_condition(values: darray[usize]&, start: usize, index: usize) -> usize:
    return values[start + index] if start <= values.count and index < values.count - start
    return 0

# A guard over two places on both sides.
struct Span:
    start: usize
    count: usize

def two_places(span: Span, values: darray[usize]&, index: usize) -> usize:
    return 0 if span.start > values.count
    return 0 if index >= values.count - span.start
    return values[span.start + index]
