def arithmetic_with_boolean_path(cursor: i64, flag: bool) -> i64:
    requires cursor >= 0 and cursor < 8
    ensure result > 0 and result <= 8
    return cursor + 1 if flag
    return cursor + 1

# Weakening may fail; the original Boolean premise must remain usable.
def retain_required_boolean(flag: bool) -> bool:
    requires flag
    ensure result
    return flag

def retain_negated_boolean(flag: bool) -> bool:
    requires not flag
    ensure not result
    return flag
