# Summary instantiation must substitute all callee parameters simultaneously. The caller uses
# the same names as the callee and swaps them, so sequential replay would reconstruct first-first
# instead of the required second-first postcondition.

def pair_difference(first: i64, second: i64) -> i64:
    ensure result == first - second
    return first - second

def swapped_difference(first: i64, second: i64) -> i64:
    ensure result == second - first
    return pair_difference(first: second, second: first)

def main() -> i64:
    return swapped_difference(9, 4)
