# `name is Enum.Variant` is the builtin tag test, one bool per named value, so a bool
# postcondition over it is closed by equality (BACKLOG B-05).

enum Color:
    Red
    Green

def is_red(c: Color) -> bool:
    ensure result == (c is Color.Red)
    return c is Color.Red

def both(c: Color, d: Color) -> bool:
    ensure result == ((c is Color.Red) and (d is Color.Green))
    return (c is Color.Red) and (d is Color.Green)
