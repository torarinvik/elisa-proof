# Recursive lemma induction also supports an explicit lexicographic tuple.

lemma lexicographic_step(outer: i64, inner: i64):
    requires outer >= 0
    requires inner >= 0
    ensure outer >= 0
    ensure inner >= 0
    decreases (outer, inner)
    if inner > 0:
        lexicographic_step(outer, inner - 1)

def use_lexicographic_lemma(outer: i64, inner: i64) -> void:
    requires outer >= 0
    requires inner >= 0
    assert inner >= 0 by:
        lexicographic_step(outer, inner)
