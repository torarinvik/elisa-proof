# Nested arithmetic conjunctions produce several replay goals under the same bounded premises.
# Each child must retain those premises and independently pass the fixed-width safety checks.
def prove_bounded_arithmetic_conjunction(x: i64, y: i64) -> bool:
    requires x >= 0
    requires y >= 0
    requires x <= 100
    requires y <= 100
    ensure x + y >= x and x + y >= y and x + y + 1 > x and x + y + 1 > y and x + y <= 200 and x * 2 >= x and y * 2 >= y and (x + y) * 2 <= 400
    return true
