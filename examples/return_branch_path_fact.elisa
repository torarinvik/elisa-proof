module ReturnBranchPathFact:
    public:
        const U64_MAX: u64 = 18446744073709551615

        def else_path_le(x: u64) -> u8:
            ensure result == 1 or x <= 5
            if x > 5:
                return 1
            else:
                return 0

        def else_path_negative_control(x: u64) -> u8:
            ensure result == 1 or x < 5
            if x > 5:
                return 1
            else:
                return 0

        def scalar_store(x: u64, y: u64, deadline: mutable u64&) -> u8:
            ensure result == 0 or deadline[0] == old(deadline[0])
            ensure result == 1 or deadline[0] == x + y
            ensure result == 0 or result == 1
            if y > U64_MAX - x:
                return 1
            else:
                deadline[0] <- x + y
                return 0

        def subtraction_path_bound(now: u8, delay: u8) -> u8:
            requires now <= 15
            ensure result == 1 or delay <= 15 - now
            if delay > 15 - now:
                return 1
            else:
                return 0

        def subtraction_path_bound_u64(now: u64, delay: u64) -> u8:
            ensure result == 1 or delay <= U64_MAX - now
            if delay > U64_MAX - now:
                return 1
            else:
                return 0

        def subtraction_path_strict_negative(now: u8, delay: u8) -> u8:
            requires now <= 15
            ensure result == 1 or delay < 15 - now
            if delay > 15 - now:
                return 1
            else:
                return 0

        def floating_nan_negative_control(x: f64, y: f64) -> u8:
            ensure result == 1 or x <= y
            if x > y:
                return 1
            else:
                return 0
