# Splitting an if-expression into its arms must not lend one arm's facts to the other, or
# discharge a callee precondition the arm's condition does not establish.
module RejectedConditionalCallArms:
    def halve(x: i64) -> i64:
        requires x >= 0
        requires x <= 1000
        ensure result >= 0
        ensure result <= 500
        return x / 2

    # `x <= 0` does not give `halve`'s `x >= 0` on the arm that calls it.
    def wrong_guard(x: i64) -> i64:
        requires x <= 1000
        ensure result >= 0
        h: i64 = halve(x) if x <= 0 else 0
        return h

    # The arm that skips the call learns nothing from its summary: `x` may be negative there.
    def skipped_arm(x: i64) -> i64:
        requires x <= 1000
        ensure result >= 0
        return halve(x) if x >= 0 else x

    # Only a whole declaration, rebind or return value is split. An if-expression nested in a
    # call argument still cannot enter the proof state.
    def nested_arm(x: i64) -> i64:
        requires x <= 1000
        ensure result >= 0
        h: i64 = halve(halve(x) if x >= 0 else 0)
        return h
