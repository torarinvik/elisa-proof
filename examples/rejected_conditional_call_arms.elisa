# Splitting an if-expression into its arms must not lend one arm's facts to the other, or
# discharge a callee precondition the arm's condition does not establish.
module RejectedConditionalCallArms:
    def halve(x: i64) -> i64:
        requires x >= 0
        requires x <= 1000
        ensure result >= 0
        ensure result <= 500
        return x / 2

    # `x <= 0` does not give `halve`'s `x >= 0` on the arm that calls it.
    def wrong_guard(x: i64) -> i64:
        requires x <= 1000
        ensure result >= 0
        h: i64 = halve(x) if x <= 0 else 0
        return h

    # The arm that skips the call learns nothing from its summary: `x` may be negative there.
    def skipped_arm(x: i64) -> i64:
        requires x <= 1000
        ensure result >= 0
        return halve(x) if x >= 0 else x

    # A nested split moves the condition ahead of the rest of the value, so the condition must be
    # call-free; this one is not, and the statement still cannot enter the proof state.
    def called_nested_condition(x: i64) -> i64:
        requires x >= 0
        requires x <= 1000
        h: i64 = 1 + (halve(x) if halve(x) > 0 else 0)
        return h

    # A call evaluated before the if-expression could change what its condition reads.
    def call_before_arm(x: i64) -> i64:
        requires x >= 0
        requires x <= 1000
        h: i64 = halve(x) + (halve(x) if x > 0 else 0)
        return h

    # Under `and` the if-expression may not be evaluated at all, so it is not split.
    def short_circuit_path(x: i64, flag: bool) -> bool:
        requires x >= 0
        requires x <= 1000
        b: bool = flag and (halve(x) if x > 0 else 0) > 1
        return b

    # The arms of a nested split keep the callee's precondition: `x <= 0` does not give it.
    def nested_wrong_guard(x: i64) -> i64:
        requires x <= 1000
        h: i64 = 1 + (halve(x) if x <= 0 else 0)
        return h
