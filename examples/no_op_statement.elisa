# `pass` parses to an expression statement carrying `Expr.Invalid`, and so do four of the parser's
# empty-body placeholders and one recovery node for a keyword-shaped form the frontend drops
# without recording an error. At this AST layer they are the same statement, so the checker refuses
# all of them -- and a refused statement invalidates the path and havocs the state for everything
# after it in the body.
#
# That is the safe side of the choice and this file does not ask for it to change. What it pins is
# the cost and the way around it: a `match` whose arms agree is one condition, and written that way
# the facts before it survive.

extend NoOpStatement:
    def needs_bound(depth: usize) -> usize:
        requires depth <= 127
        return depth

    def a_condition_keeps_the_state(depth: usize, kind: sview) -> usize:
        requires depth <= 127
        reflexive: bool = kind == "==" or kind == "<=" or kind == ">="
        if reflexive:
            return 0
        return needs_bound(depth)

    def every_arm_returning_keeps_it_too(depth: usize, value: usize) -> usize:
        requires depth <= 127
        match value:
            0:
                return 0
            _:
                return needs_bound(depth)
