# `pass` parses to an expression statement carrying `Expr.Invalid`, and so do four of the parser's
# empty-body placeholders and one recovery node for a keyword-shaped form the frontend drops
# without recording an error. The CLI records where the lexer saw each `pass` token, and only a
# statement spanning exactly one of those is read as `pass`; every other invalid statement is still
# refused and havocs the state after it.
#
# This file pins the readable side: a `pass` arm keeps the facts before the match, and so do the
# two ways of writing the same branch without one.

module NoOpStatement:
    def needs_bound(depth: usize) -> usize:
        requires depth <= 127
        return depth

    def a_condition_keeps_the_state(depth: usize, kind: sview) -> usize:
        requires depth <= 127
        reflexive: bool = kind == "==" or kind == "<=" or kind == ">="
        if reflexive:
            return 0
        return needs_bound(depth)

    def every_arm_returning_keeps_it_too(depth: usize, value: usize) -> usize:
        requires depth <= 127
        match value:
            0:
                return 0
            _:
                return needs_bound(depth)

    def a_pass_arm_keeps_the_state(depth: usize, value: usize) -> usize:
        requires depth <= 127
        match value:
            0:
                return 0
            _:
                pass
        return needs_bound(depth)
