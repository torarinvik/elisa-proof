# choose_first(second, first) maps the callee's @r to this function's @s, so the result lives
# in @s. Declaring it @r would let a caller keep it past the destruction of @s.
def choose_first[@r, @s](first: mutable i64& @r, second: mutable i64& @s) -> mutable i64& @r:
    return first

def wrong_region[@r, @s](first: mutable i64& @r, second: mutable i64& @s) -> mutable i64& @r:
    return choose_first(second, first)

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    return 0
