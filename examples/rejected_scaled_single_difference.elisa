# Controls for the scaled single-name tier: a floor quotient rounded the wrong
# way, an equality whose constant the coefficient does not divide, and a bound
# the name's own interval does not give.
module Steps:
    public:
        def off_by_one(value: i64) -> i64:
            requires value >= 0
            requires value <= 1000
            requires value + value <= 5
            ensure value <= 1
            return value

        def indivisible(value: i64) -> i64:
            requires value >= 0
            requires value <= 1000
            ensure value + value == 7
            return value

        def unbounded_cap(origin: i64, cap: i64) -> i64:
            requires cap >= -1
            requires cap <= 1000000000
            requires origin >= -1000000000
            requires origin <= 1000000000
            ensure origin - result <= cap
            return origin + cap
