# `not (a < b)` is `a >= b`; beside `not (a == b)` it is `a > b`. The producer and the replay kernel
# must both read it that way (mocap-cleaner KeyWeight::weight), or the certificate is a replay gap.
module NegatedDisequalityStrictness:
    def need(whole: i64) -> i64:
        requires whole >= 1
        return whole

    def after_key(frame: i64, first: i64, key: i64, last: i64) -> i64:
        requires first >= 0
        requires first <= key
        requires key <= last
        requires last <= 10000000
        return 0 if frame == key
        return 0 if frame < first or frame > last
        if frame < key:
            return 0
        d: i64 = need(last - key)
        return d

    def before_key(frame: i64, first: i64, key: i64, last: i64) -> i64:
        requires first >= 0
        requires first <= key
        requires key <= last
        requires last <= 10000000
        return 0 if frame == key
        return 0 if frame < first or frame > last
        if frame > key:
            return 0
        d: i64 = need(key - first)
        return d
