struct LocalRecordFieldNode:
    next: mutable heap LocalRecordFieldNode&?
struct LocalRecordFieldStore:
    first: mutable heap LocalRecordFieldNode&?
struct LocalRecordFieldCursor:
    next: mutable heap LocalRecordFieldNode&?

def local_record_field_keeps_store(store: LocalRecordFieldStore&) -> u8:
    ensure store.first != null or result == 0
    return 0 if store.first == null
    cursor: mutable LocalRecordFieldCursor = LocalRecordFieldCursor{next: store.first}
    cursor.next <- null
    return 1

def local_record_field_loop_keeps_store(store: LocalRecordFieldStore&) -> u8:
    ensure store.first != null or result == 0
    return 0 if store.first == null
    cursor: mutable LocalRecordFieldCursor = LocalRecordFieldCursor{next: store.first}
    while cursor.next != null:
        invariant store.first != null
        return 1 if cursor.next.next == null
        cursor.next <- cursor.next.next
    return 0
