# The payload binder intentionally shadows the recursive parameter. Its lexical identity is
# still a proper subterm, so the certificate must prove and independently replay the descent.
enum Tree:
    Leaf
    Node(value: Tree)

def structural_shadowed_subterm(value: Tree) -> i64:
    match value:
        Tree.Leaf:
            return 0
        Tree.Node(value):
            return structural_shadowed_subterm(value)
