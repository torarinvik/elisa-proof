# A verified call's scalar result is snapshotted under a compiler-owned rebind symbol. An
# unrelated opaque call may retain its summary facts only when the source local that owns the
# snapshot cannot be reached. Passing that local by mutable reference must still invalidate them.
extern opaque_signal() -> u8 can[Unsafe.RawExtern]
extern opaque_write(value: mutable u64&) -> u8 can[Unsafe.RawExtern]

def strict_child(root: u64, limit: u64) -> u64:
    requires root < limit / 2
    ensure result > root
    ensure result < limit
    return root * 2 + 1

def accept_child(child: u64, limit: u64) -> bool:
    requires child < limit
    ensure result
    return true

def result_bound_survives_unrelated_call(root: u64, limit: u64) -> u8:
    requires root < limit / 2
    ensure result == 1
    child: u64 = strict_child(root, limit)
    opaque_signal()
    accepted: bool = accept_child(child, limit)
    return 1 if accepted
    return 0

def result_bound_does_not_survive_mutable_lend(root: u64, limit: u64) -> u8:
    requires root < limit / 2
    ensure result == 1
    child: mutable u64 = strict_child(root, limit)
    opaque_write(child)
    return 1 if child < limit
    return 0
