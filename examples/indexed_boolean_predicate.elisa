def byte_nonzero(value: u8) -> bool:
    ensure result == (value != 0)
    return value != 0

def positive_only(value: u8) -> bool:
    requires value > 0
    ensure result == true
    return true

def checked_predicate_precondition(value: u8) -> bool:
    requires value > 0
    ensure result
    return positive_only(value)

def indexed_boolean_predicate(rows: array[u8, 8]&, cursor: i64) -> i64:
    requires cursor == 3
    ensure result == 0 or byte_nonzero(rows[3])
    byte: u8 = rows[cursor]
    checked: bool = byte_nonzero(byte)
    return 0 if not checked
    return 1

def indexed_boolean_comparison_same_read(rows: array[u8, 8]&) -> i64:
    ensure result == 0 or rows[3] != 0
    byte: u8 = rows[3]
    checked: bool = byte_nonzero(byte)
    return 0 if not checked
    return 1

def indexed_boolean_predicate_same_read(rows: array[u8, 8]&) -> i64:
    ensure result == 0 or byte_nonzero(rows[3])
    byte: u8 = rows[3]
    checked: bool = byte_nonzero(byte)
    return 0 if not checked
    return 1
