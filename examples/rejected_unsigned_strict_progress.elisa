def zero_step_can_stall(base: u64, step: u64) -> u64:
    requires base <= 4
    requires step <= 4 - base
    ensure result > base
    return base + step

def positive_step_can_wrap(base: u64, step: u64) -> u64:
    requires step > 0
    ensure result > base
    return base + step

def remainder_without_cap_can_wrap(base: u64, step: u64) -> u64:
    requires base < 4
    requires step > 0
    ensure 4 - result < 4 - base
    return base + step
