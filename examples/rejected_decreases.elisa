# A termination measure must be nonnegative and strictly decrease on every fall-through path.

def non_decreasing_measure(x: i64) -> i64:
    requires x >= 0
    ensure result == 0
    value: mutable i64 = x
    while value > 0:
        invariant value >= 0
        decreases value
        value <- value + 1
    return 0
