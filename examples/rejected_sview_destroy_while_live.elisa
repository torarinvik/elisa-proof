# Explicit destruction is invalid even when the stale view is never read afterward: its
# binding remains live until its lexical scope ends.
def rejected_sview_destroy_while_live() -> i64 can[Memory.Allocate, Abort.Panic]:
    region scratch(64)
    bytes: mutable darray[u8] @scratch = [65]
    view: sview = bytes.as_sview()
    destroy scratch
    return 0

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    return 0
