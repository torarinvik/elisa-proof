extern audit(value: u8) -> u8 can[Unsafe.RawExtern, Abort.Panic]
extern missing_row(value: u8) -> u8

def rejected_narrow_native_row(value: u8) -> u8 can[Unsafe.RawExtern]:
    trusted Unsafe.RawExtern:
        audit(value)
    return 0

def rejected_missing_native_row(value: u8) -> u8 can[Unsafe.RawExtern]:
    trusted Unsafe.RawExtern:
        missing_row(value)
    return 0

def rejected_native_result_is_zero(value: u8) -> u8 can[Unsafe.RawExtern, Abort.Panic]:
    ensure result == 0
    trusted Unsafe.RawExtern:
        return audit(value)
