# Slices have a source-neutral representation when they occur in proof terms. A slice is an
# aggregate, and Elisa admits no `==` between aggregates, so none of these reflexive goals may
# prove or certify; what is checked is that every slice form still lowers into the arena.

def slice_reflexive(values: darray[i64]&, start: i64, end: i64) -> void:
    requires start >= 0 and start <= end and end <= values.count
    proof values[start:end] == values[start:end]:
        assert values[start:end] == values[start:end]
    proof values[:end] == values[:end]:
        assert values[:end] == values[:end]
    proof values[start:] == values[start:]:
        assert values[start:] == values[start:]
    proof values[:] == values[:]:
        assert values[:] == values[:]
