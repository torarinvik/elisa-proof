# A same-width subtraction witness justifies an unsigned addition's upper bound.

def bounded_unsigned_sum(base: u64, extra: u64) -> bool:
    maximum: u64 = 18446744073709551615
    if base <= maximum:
        if extra <= maximum - base:
            assert base + extra <= maximum by:
                assert extra <= maximum - base
            return true
    return true

# Without the subtraction witness, the modular sum cannot be treated as an
# unbounded integer sum, even when the desired upper bound looks plausible.
def unbounded_unsigned_sum_control(base: u64, extra: u64) -> bool:
    maximum: u64 = 18446744073709551615
    proof base + extra <= maximum:
        assert true
    return true
