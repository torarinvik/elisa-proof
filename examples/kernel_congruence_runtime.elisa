# Exercise ground congruence closure directly against the replay kernel: source proof search
# must not be able to mask a kernel bug, and every excluded term former is checked here rather
# than only through Elisa source fixtures.
#
# The rule is admitted only over the primitive scalar fragment, because Elisa dispatches `==`,
# arithmetic, and ordering to a user `__eq__`/`__add__`/`__cmp__` for struct operands. An
# identifier therefore enters the relation only with a producer-emitted scalar type witness.
include "../src/proof/kernel_core.elisa"
include "../src/proof/kernel_replay.elisa"
using ElisaProofKernelCore
using ElisaProofKernelReplay

const CONGRUENT_SUM_REJECTED: i64 = 1
const CONGRUENT_NESTED_REJECTED: i64 = 2
const CONGRUENT_PRODUCT_REJECTED: i64 = 3
const CONGRUENT_CHAIN_REJECTED: i64 = 4
const CONGRUENT_NEGATED_DISEQUALITY_REJECTED: i64 = 5
const CONGRUENT_CONDITIONAL_REJECTED: i64 = 6
const CONGRUENT_COMPARISON_REJECTED: i64 = 7
const CONGRUENT_BITWISE_REJECTED: i64 = 8
const CONGRUENT_UNSIGNED_WITNESS_REJECTED: i64 = 9
const UNWITNESSED_IDENT_MERGED: i64 = 20
const UNWITNESSED_PREMISE_SEEDED: i64 = 21
const FIELD_CONGRUENCE_ADMITTED: i64 = 22
const INDEX_CONGRUENCE_ADMITTED: i64 = 23
const ARRAY_CONGRUENCE_ADMITTED: i64 = 24
const CONSTRUCT_CONGRUENCE_ADMITTED: i64 = 25
const CALL_CONGRUENCE_ADMITTED: i64 = 26
const MOVE_CONGRUENCE_ADMITTED: i64 = 27
const ADDRESS_CONGRUENCE_ADMITTED: i64 = 28
const SCOPE_CONGRUENCE_ADMITTED: i64 = 29
const CHECKED_INDEX_CONGRUENCE_ADMITTED: i64 = 30
const QUANTIFIER_CONGRUENCE_ADMITTED: i64 = 31
const STRING_CONGRUENCE_ADMITTED: i64 = 32
const DISEQUALITY_SEEDED: i64 = 33
const DISJUNCTION_SEEDED: i64 = 34
const ORDER_SEEDED: i64 = 35
const PREMISE_FREE_CONGRUENCE_ADMITTED: i64 = 36
const DISTINCT_OPERATOR_MERGED: i64 = 37

# The producer's scalar type witness, built directly so this harness never depends on the AST
# tier having emitted it.
def scalar_witness(nodes: mutable darray[ProofKernelNode]&, children: mutable darray[usize]&, name: sview) -> usize can[Memory.Allocate, Abort.Panic]:
    callee: usize = add_node(nodes, "ident", "", 0, 0, 0, 0, 0, 0, "__elisa_primitive_scalar_type", "")
    subject: usize = add_node(nodes, "ident", "", 0, 0, 0, 0, 0, 0, name, "")
    argument: usize = add_node(nodes, "call_arg", "", subject, 0, 0, 0, 0, 0, "", "")
    start: usize = children.count
    children.push(argument)
    return add_node(nodes, "call", "", callee, 0, 0, start, 1, 0, "", "")

# A congruence claim is admissible only when both the dedicated rule and the full goal replay
# accept it; a rejection must hold on both paths so no other tier can launder the same claim.
def congruence_admitted(nodes: mutable darray[ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], goal: usize) -> bool can[Memory.Allocate, Abort.Panic]:
    return proof_kernel_replay_congruence_report(nodes, children, facts, goal)

def goal_admitted(nodes: mutable darray[ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], goal: usize) -> bool can[Memory.Allocate, Abort.Panic]:
    return proof_kernel_replay_goal_report(nodes, children, facts, goal)

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    nodes: mutable darray[ProofKernelNode] = []
    children: mutable darray[usize] = []

    a: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "a", "")
    b: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "b", "")
    c: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "c", "")
    d: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "d", "")
    e: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "e", "")
    p: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "p", "")
    q: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "q", "")
    v: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "v", "")
    f: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "f", "")
    point: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "Point", "")
    one: usize = add_node(&nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
    two: usize = add_node(&nodes, "int", "", 0, 0, 0, 0, 0, 2, "", "")

    witness_a: usize = scalar_witness(&nodes, &children, "a")
    witness_b: usize = scalar_witness(&nodes, &children, "b")
    witness_c: usize = scalar_witness(&nodes, &children, "c")
    witness_d: usize = scalar_witness(&nodes, &children, "d")
    witness_e: usize = scalar_witness(&nodes, &children, "e")
    witness_p: usize = scalar_witness(&nodes, &children, "p")
    witness_q: usize = scalar_witness(&nodes, &children, "q")

    a_equals_b: usize = add_node(&nodes, "binary", "==", a, b, 0, 0, 0, 0, "", "")
    c_equals_d: usize = add_node(&nodes, "binary", "==", c, d, 0, 0, 0, 0, "", "")
    scalars: darray[usize] = [a_equals_b, witness_a, witness_b, witness_c, witness_d, witness_e]

    # Congruence over arithmetic: equal operands travel through a primitive former.
    a_plus_c: usize = add_node(&nodes, "binary", "+", a, c, 0, 0, 0, 0, "", "")
    b_plus_c: usize = add_node(&nodes, "binary", "+", b, c, 0, 0, 0, 0, "", "")
    sum_goal: usize = add_node(&nodes, "binary", "==", a_plus_c, b_plus_c, 0, 0, 0, 0, "", "")
    return CONGRUENT_SUM_REJECTED if not congruence_admitted(&nodes, &children, scalars, sum_goal)
    return CONGRUENT_SUM_REJECTED if not goal_admitted(&nodes, &children, scalars, sum_goal)

    # An identifier with no scalar type witness may not enter the relation: its `==` and its
    # arithmetic could be a user protocol implementation rather than the language's operators.
    unwitnessed: darray[usize] = [a_equals_b, witness_a, witness_b]
    return UNWITNESSED_IDENT_MERGED if congruence_admitted(&nodes, &children, unwitnessed, sum_goal)
    return UNWITNESSED_IDENT_MERGED if goal_admitted(&nodes, &children, unwitnessed, sum_goal)
    unwitnessed_premise: darray[usize] = [a_equals_b, witness_c]
    return UNWITNESSED_PREMISE_SEEDED if congruence_admitted(&nodes, &children, unwitnessed_premise, sum_goal)

    # A premise that is not a positive equality must not seed the relation.
    a_differs_b: usize = add_node(&nodes, "binary", "!=", a, b, 0, 0, 0, 0, "", "")
    disequality: darray[usize] = [a_differs_b, witness_a, witness_b, witness_c]
    return DISEQUALITY_SEEDED if congruence_admitted(&nodes, &children, disequality, sum_goal)
    return DISEQUALITY_SEEDED if goal_admitted(&nodes, &children, disequality, sum_goal)
    a_below_b: usize = add_node(&nodes, "binary", "<", a, b, 0, 0, 0, 0, "", "")
    order: darray[usize] = [a_below_b, witness_a, witness_b, witness_c]
    return ORDER_SEEDED if congruence_admitted(&nodes, &children, order, sum_goal)
    return ORDER_SEEDED if goal_admitted(&nodes, &children, order, sum_goal)
    equality_disjunction: usize = add_node(&nodes, "binary", "or", a_equals_b, c_equals_d, 0, 0, 0, 0, "", "")
    disjunction: darray[usize] = [equality_disjunction, witness_a, witness_b, witness_c, witness_d]
    return DISJUNCTION_SEEDED if congruence_admitted(&nodes, &children, disjunction, sum_goal)
    witnesses_only: darray[usize] = [witness_a, witness_b, witness_c]
    return PREMISE_FREE_CONGRUENCE_ADMITTED if congruence_admitted(&nodes, &children, witnesses_only, sum_goal)

    # `not (a != b)` is the same premise as `a == b`.
    not_a_differs_b: usize = add_node(&nodes, "unary", "not", a_differs_b, 0, 0, 0, 0, 0, "", "")
    negated: darray[usize] = [not_a_differs_b, witness_a, witness_b, witness_c]
    return CONGRUENT_NEGATED_DISEQUALITY_REJECTED if not congruence_admitted(&nodes, &children, negated, sum_goal)

    # A different former on one side is not congruent, even with an equality premise.
    b_minus_c: usize = add_node(&nodes, "binary", "-", b, c, 0, 0, 0, 0, "", "")
    operator_goal: usize = add_node(&nodes, "binary", "==", a_plus_c, b_minus_c, 0, 0, 0, 0, "", "")
    return DISTINCT_OPERATOR_MERGED if congruence_admitted(&nodes, &children, scalars, operator_goal)
    return DISTINCT_OPERATOR_MERGED if goal_admitted(&nodes, &children, scalars, operator_goal)

    # Nested formers saturate, and two independent premises combine.
    a_plus_one: usize = add_node(&nodes, "binary", "+", a, one, 0, 0, 0, 0, "", "")
    b_plus_one: usize = add_node(&nodes, "binary", "+", b, one, 0, 0, 0, 0, "", "")
    a_scaled: usize = add_node(&nodes, "binary", "*", a_plus_one, two, 0, 0, 0, 0, "", "")
    b_scaled: usize = add_node(&nodes, "binary", "*", b_plus_one, two, 0, 0, 0, 0, "", "")
    nested_goal: usize = add_node(&nodes, "binary", "==", a_scaled, b_scaled, 0, 0, 0, 0, "", "")
    return CONGRUENT_NESTED_REJECTED if not congruence_admitted(&nodes, &children, scalars, nested_goal)
    a_times_c: usize = add_node(&nodes, "binary", "*", a, c, 0, 0, 0, 0, "", "")
    b_times_d: usize = add_node(&nodes, "binary", "*", b, d, 0, 0, 0, 0, "", "")
    product_goal: usize = add_node(&nodes, "binary", "==", a_times_c, b_times_d, 0, 0, 0, 0, "", "")
    product_facts: darray[usize] = [a_equals_b, c_equals_d, witness_a, witness_b, witness_c, witness_d]
    return CONGRUENT_PRODUCT_REJECTED if not congruence_admitted(&nodes, &children, product_facts, product_goal)

    # A derived class may be equated to a further term by a second premise.
    b_plus_one_equals_e: usize = add_node(&nodes, "binary", "==", b_plus_one, e, 0, 0, 0, 0, "", "")
    chain_goal: usize = add_node(&nodes, "binary", "==", a_plus_one, e, 0, 0, 0, 0, "", "")
    chain_facts: darray[usize] = [a_equals_b, b_plus_one_equals_e, witness_a, witness_b, witness_e]
    return CONGRUENT_CHAIN_REJECTED if not congruence_admitted(&nodes, &children, chain_facts, chain_goal)

    # Comparison, bitwise, and conditional formers are primitive over scalars.
    a_below_one: usize = add_node(&nodes, "binary", "<", a, one, 0, 0, 0, 0, "", "")
    b_below_one: usize = add_node(&nodes, "binary", "<", b, one, 0, 0, 0, 0, "", "")
    comparison_goal: usize = add_node(&nodes, "binary", "==", a_below_one, b_below_one, 0, 0, 0, 0, "", "")
    return CONGRUENT_COMPARISON_REJECTED if not congruence_admitted(&nodes, &children, scalars, comparison_goal)
    a_and_c: usize = add_node(&nodes, "binary", "&", a, c, 0, 0, 0, 0, "", "")
    b_and_c: usize = add_node(&nodes, "binary", "&", b, c, 0, 0, 0, 0, "", "")
    bitwise_goal: usize = add_node(&nodes, "binary", "==", a_and_c, b_and_c, 0, 0, 0, 0, "", "")
    return CONGRUENT_BITWISE_REJECTED if not congruence_admitted(&nodes, &children, scalars, bitwise_goal)
    left_conditional: usize = add_node(&nodes, "if", "", a_below_one, c, d, 0, 0, 0, "", "")
    right_conditional: usize = add_node(&nodes, "if", "", b_below_one, c, d, 0, 0, 0, "", "")
    conditional_goal: usize = add_node(&nodes, "binary", "==", left_conditional, right_conditional, 0, 0, 0, 0, "", "")
    return CONGRUENT_CONDITIONAL_REJECTED if not congruence_admitted(&nodes, &children, scalars, conditional_goal)

    # An unsigned width marker is a scalar type witness too. The goal here is comparison-only:
    # mixing a fixed-width operand into arithmetic is rejected earlier by the wrapping guard,
    # which is a separate rule from this one.
    unsigned_callee: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "__elisa_unsigned_type_bound", "")
    unsigned_width: usize = add_node(&nodes, "int", "", 0, 0, 0, 0, 0, 8, "", "")
    unsigned_left_subject: usize = add_node(&nodes, "call_arg", "", a, 0, 0, 0, 0, 0, "", "")
    unsigned_left_amount: usize = add_node(&nodes, "call_arg", "", unsigned_width, 0, 0, 0, 0, 0, "", "")
    unsigned_left_start: usize = children.count
    children.push(unsigned_left_subject)
    children.push(unsigned_left_amount)
    unsigned_left_marker: usize = add_node(&nodes, "call", "", unsigned_callee, 0, 0, unsigned_left_start, 2, 0, "", "")
    unsigned_right_subject: usize = add_node(&nodes, "call_arg", "", b, 0, 0, 0, 0, 0, "", "")
    unsigned_right_amount: usize = add_node(&nodes, "call_arg", "", unsigned_width, 0, 0, 0, 0, 0, "", "")
    unsigned_right_start: usize = children.count
    children.push(unsigned_right_subject)
    children.push(unsigned_right_amount)
    unsigned_right_marker: usize = add_node(&nodes, "call", "", unsigned_callee, 0, 0, unsigned_right_start, 2, 0, "", "")
    a_equals_one: usize = add_node(&nodes, "binary", "==", a, one, 0, 0, 0, 0, "", "")
    b_equals_one: usize = add_node(&nodes, "binary", "==", b, one, 0, 0, 0, 0, "", "")
    unsigned_goal: usize = add_node(&nodes, "binary", "==", a_equals_one, b_equals_one, 0, 0, 0, 0, "", "")
    unsigned_facts: darray[usize] = [a_equals_b, unsigned_left_marker, unsigned_right_marker]
    return CONGRUENT_UNSIGNED_WITNESS_REJECTED if not congruence_admitted(&nodes, &children, unsigned_facts, unsigned_goal)

    # `==` on a struct operand is Elisa's `Eq` protocol: a user `__eq__` need not be Leibniz
    # equality, so neither the aggregate formers nor the premises over them may be used.
    p_equals_q: usize = add_node(&nodes, "binary", "==", p, q, 0, 0, 0, 0, "", "")
    aggregate_facts: darray[usize] = [p_equals_q, a_equals_b, witness_a, witness_b, witness_c, witness_p, witness_q]
    p_x: usize = add_node(&nodes, "field", "", p, 0, 0, 0, 0, 0, "x", "")
    q_x: usize = add_node(&nodes, "field", "", q, 0, 0, 0, 0, 0, "x", "")
    field_goal: usize = add_node(&nodes, "binary", "==", p_x, q_x, 0, 0, 0, 0, "", "")
    return FIELD_CONGRUENCE_ADMITTED if congruence_admitted(&nodes, &children, aggregate_facts, field_goal)
    return FIELD_CONGRUENCE_ADMITTED if goal_admitted(&nodes, &children, aggregate_facts, field_goal)

    v_a: usize = add_node(&nodes, "index", "", v, a, 0, 0, 0, 0, "", "")
    v_b: usize = add_node(&nodes, "index", "", v, b, 0, 0, 0, 0, "", "")
    index_goal: usize = add_node(&nodes, "binary", "==", v_a, v_b, 0, 0, 0, 0, "", "")
    return INDEX_CONGRUENCE_ADMITTED if congruence_admitted(&nodes, &children, aggregate_facts, index_goal)
    return INDEX_CONGRUENCE_ADMITTED if goal_admitted(&nodes, &children, aggregate_facts, index_goal)

    left_array_start: usize = children.count
    children.push(a)
    children.push(c)
    left_array: usize = add_node(&nodes, "array", "", 0, 0, 0, left_array_start, 2, 0, "", "")
    right_array_start: usize = children.count
    children.push(b)
    children.push(c)
    right_array: usize = add_node(&nodes, "array", "", 0, 0, 0, right_array_start, 2, 0, "", "")
    array_goal: usize = add_node(&nodes, "binary", "==", left_array, right_array, 0, 0, 0, 0, "", "")
    return ARRAY_CONGRUENCE_ADMITTED if congruence_admitted(&nodes, &children, aggregate_facts, array_goal)

    left_field_init: usize = add_node(&nodes, "field-init", "", a, 0, 0, 0, 0, 0, "x", "")
    right_field_init: usize = add_node(&nodes, "field-init", "", b, 0, 0, 0, 0, 0, "x", "")
    left_construct_start: usize = children.count
    children.push(left_field_init)
    left_construct: usize = add_node(&nodes, "construct", "", point, 0, 0, left_construct_start, 1, 0, "", "")
    right_construct_start: usize = children.count
    children.push(right_field_init)
    right_construct: usize = add_node(&nodes, "construct", "", point, 0, 0, right_construct_start, 1, 0, "", "")
    construct_goal: usize = add_node(&nodes, "binary", "==", left_construct, right_construct, 0, 0, 0, 0, "", "")
    return CONSTRUCT_CONGRUENCE_ADMITTED if congruence_admitted(&nodes, &children, aggregate_facts, construct_goal)

    # A call has no determinism witness and no known result type in this term language.
    left_call_argument: usize = add_node(&nodes, "call_arg", "", a, 0, 0, 0, 0, 0, "", "")
    left_call_start: usize = children.count
    children.push(left_call_argument)
    left_call: usize = add_node(&nodes, "call", "", f, 0, 0, left_call_start, 1, 0, "", "")
    right_call_argument: usize = add_node(&nodes, "call_arg", "", b, 0, 0, 0, 0, 0, "", "")
    right_call_start: usize = children.count
    children.push(right_call_argument)
    right_call: usize = add_node(&nodes, "call", "", f, 0, 0, right_call_start, 1, 0, "", "")
    call_goal: usize = add_node(&nodes, "binary", "==", left_call, right_call, 0, 0, 0, 0, "", "")
    return CALL_CONGRUENCE_ADMITTED if congruence_admitted(&nodes, &children, scalars, call_goal)
    return CALL_CONGRUENCE_ADMITTED if goal_admitted(&nodes, &children, scalars, call_goal)
    left_call_plus_c: usize = add_node(&nodes, "binary", "+", left_call, c, 0, 0, 0, 0, "", "")
    right_call_plus_c: usize = add_node(&nodes, "binary", "+", right_call, c, 0, 0, 0, 0, "", "")
    call_operand_goal: usize = add_node(&nodes, "binary", "==", left_call_plus_c, right_call_plus_c, 0, 0, 0, 0, "", "")
    call_facts: darray[usize] = [call_goal, witness_a, witness_b, witness_c]
    return CALL_CONGRUENCE_ADMITTED if congruence_admitted(&nodes, &children, call_facts, call_operand_goal)

    # Ownership transfer, address-of, namespace paths, and guarded access are not value formers.
    left_move: usize = add_node(&nodes, "move", "", a, 0, 0, 0, 0, 0, "", "")
    right_move: usize = add_node(&nodes, "move", "", b, 0, 0, 0, 0, 0, "", "")
    move_goal: usize = add_node(&nodes, "binary", "==", left_move, right_move, 0, 0, 0, 0, "", "")
    return MOVE_CONGRUENCE_ADMITTED if congruence_admitted(&nodes, &children, scalars, move_goal)
    return MOVE_CONGRUENCE_ADMITTED if goal_admitted(&nodes, &children, scalars, move_goal)

    left_address: usize = add_node(&nodes, "unary", "&", a, 0, 0, 0, 0, 0, "", "")
    right_address: usize = add_node(&nodes, "unary", "&", b, 0, 0, 0, 0, 0, "", "")
    address_goal: usize = add_node(&nodes, "binary", "==", left_address, right_address, 0, 0, 0, 0, "", "")
    return ADDRESS_CONGRUENCE_ADMITTED if congruence_admitted(&nodes, &children, scalars, address_goal)
    return ADDRESS_CONGRUENCE_ADMITTED if goal_admitted(&nodes, &children, scalars, address_goal)

    left_scope: usize = add_node(&nodes, "scope", "", a, 0, 0, 0, 0, 0, "member", "")
    right_scope: usize = add_node(&nodes, "scope", "", b, 0, 0, 0, 0, 0, "member", "")
    scope_goal: usize = add_node(&nodes, "binary", "==", left_scope, right_scope, 0, 0, 0, 0, "", "")
    return SCOPE_CONGRUENCE_ADMITTED if congruence_admitted(&nodes, &children, scalars, scope_goal)
    return SCOPE_CONGRUENCE_ADMITTED if goal_admitted(&nodes, &children, scalars, scope_goal)

    left_checked: usize = add_node(&nodes, "checked-index", "", v_a, c, 0, 0, 0, 0, "", "")
    right_checked: usize = add_node(&nodes, "checked-index", "", v_b, c, 0, 0, 0, 0, "", "")
    checked_goal: usize = add_node(&nodes, "binary", "==", left_checked, right_checked, 0, 0, 0, 0, "", "")
    return CHECKED_INDEX_CONGRUENCE_ADMITTED if congruence_admitted(&nodes, &children, scalars, checked_goal)
    return CHECKED_INDEX_CONGRUENCE_ADMITTED if goal_admitted(&nodes, &children, scalars, checked_goal)

    # A string is not a primitive scalar: its equality is not known to be the language's own.
    left_string: usize = add_node(&nodes, "string", "", 0, 0, 0, 0, 0, 0, "left", "")
    right_string: usize = add_node(&nodes, "string", "", 0, 0, 0, 0, 0, 0, "right", "")
    string_left: usize = add_node(&nodes, "binary", "==", left_string, a, 0, 0, 0, 0, "", "")
    string_right: usize = add_node(&nodes, "binary", "==", right_string, b, 0, 0, 0, 0, "", "")
    string_goal: usize = add_node(&nodes, "binary", "==", string_left, string_right, 0, 0, 0, 0, "", "")
    return STRING_CONGRUENCE_ADMITTED if congruence_admitted(&nodes, &children, scalars, string_goal)

    # A quantifier binds names. It is never a congruent former, so two quantifiers whose bodies
    # differ only by an equated free term stay distinct.
    binder_range: usize = add_node(&nodes, "binary", "range_lt", one, two, 0, 0, 0, 0, "", "")
    left_quantifier: usize = add_node(&nodes, "quantifier", "forall", binder_range, a_below_one, 1, 0, 0, 0, "i", "")
    right_quantifier: usize = add_node(&nodes, "quantifier", "forall", binder_range, b_below_one, 1, 0, 0, 0, "i", "")
    quantifier_goal: usize = add_node(&nodes, "binary", "==", left_quantifier, right_quantifier, 0, 0, 0, 0, "", "")
    return QUANTIFIER_CONGRUENCE_ADMITTED if congruence_admitted(&nodes, &children, scalars, quantifier_goal)
    return 0
