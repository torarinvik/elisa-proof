extern foreign_tick() -> u8 can[Memory.Allocate]

def rejected_effect_break_implies_exhaustion(n: i64) -> i64 can[Unsafe.RawExtern]:
    requires n >= 0
    ensure result == 0
    while n > 0:
        invariant n >= 0
        decreases n
        break
    return n

def rejected_effect_call_before_break() -> u8 can[Unsafe.RawExtern]:
    ensure result == 0
    while true:
        invariant true
        trusted Memory.Allocate:
            observed: u8 = foreign_tick()
        break
    return 0

def rejected_effect_call_in_captured_loop() -> u8 can[Unsafe.RawExtern]:
    ensure result == 0
    cursor: mutable i64 = 1
    while cursor > 0 |cursor|:
        invariant cursor >= 0
        decreases cursor
        trusted Memory.Allocate:
            observed: u8 = foreign_tick()
        cursor <- cursor - 1
        continue
    return 0
