# Scalar-only reproduction of the production two-call capture policy.
# Keep exact case contracts; no heap, allocator, or trusted assumptions.
def capture_classify(kind: u8, status: u8) -> u8:
    ensure result == 0 or result == 1 or result == 2 or result == 3 or result == 4
    ensure kind > 1 or status != 0 or result == 0
    ensure kind != 0 or status == 0 or status > 3 or result == 1
    ensure kind != 1 or status == 0 or status > 3 or result == 2
    ensure kind > 1 or status != 4 or result == 3
    ensure kind <= 1 and status <= 4 or result == 4
    return 4 if kind > 1 or status > 4
    return 0 if status == 0
    return 3 if status == 4
    return 1 if kind == 0
    return 2

def capture_stage(status: u8) -> u8:
    ensure result <= 19
    ensure result == 0 or result == 2 or result == 13 or result == 14 or result == 15
    ensure status != 0 or result == 2
    ensure status != 1 or result == 13
    ensure status != 2 or result == 14
    ensure status != 3 or result == 15
    ensure status <= 3 or result == 0
    return 2 if status == 0
    return 13 if status == 1
    return 14 if status == 2
    return 15 if status == 3
    return 0

def capture_composition(kind: u8, status: u8) -> u8:
    ensure result == 0 or result == 2 or result == 13 or result == 14 or result == 15
    ensure kind > 1 or status != 0 or result == 2
    ensure kind > 1 or status != 4 or result == 15
    ensure kind != 0 or status < 1 or status > 3 or result == 13
    ensure kind != 1 or status < 1 or status > 3 or result == 14
    ensure kind <= 1 and status <= 4 or result == 0
    classified: u8 = capture_classify(kind, status)
    return capture_stage(classified)
