# Same-named functions in different modules each import their own module's constants.
module Gate:
    public:
        const FULL: i64 = 1000
        def weight(x: i64) -> i64:
            requires x >= 0
            requires x <= FULL
            ensure result <= 1000
            return x

module Fade:
    public:
        const FULL: i64 = 500
        def weight(x: i64) -> i64:
            requires x >= 0
            requires x <= FULL
            ensure result <= 500
            return x

        def qualified_weight(x: i64) -> i64:
            requires x >= 0
            requires x <= Gate::FULL
            ensure result <= 1000
            return x
