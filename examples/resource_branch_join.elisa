# A move in a conditional branch is safe when the moved root is not used afterward.
def resource_branch_join(x: i64) -> i64:
    if x > 0:
        moved: i64 = move x
    else:
        value: i64 = 0
    return 0

def resource_branch_move_use_alternative(flag: bool, x: i64) -> i64:
    if flag:
        moved: i64 = move x
    else:
        read: i64 = x
    return 0

def resource_branch_move_both_alternatives(flag: bool, x: i64) -> i64:
    if flag:
        left: i64 = move x
    else:
        right: i64 = move x
    return 0
