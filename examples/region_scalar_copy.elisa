# A scalar read out of a region-owned reference is a copied value, not a view into the
# region. The binding must not inherit the region and must stay usable after rebinding.
struct Store:
    names: mutable darray[sview]

def scalar_copy[@s](store: mutable Store& @s) -> bool:
    count: mutable usize = store.names.count
    count <- store.names.count
    return count == store.names.count
