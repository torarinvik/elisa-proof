# Composed call-return summaries must keep the selected argument through a permutation.
def choose_sview_first[@r](first: darray[u8]& @r, second: darray[u8]& @r) -> sview @r:
    return first.as_sview()

def swap_sview_arguments[@r](first: darray[u8]& @r, second: darray[u8]& @r) -> sview @r:
    return choose_sview_first(second, first)

def sview_call_return_provenance() -> usize can[Memory.Allocate, Abort.Panic]:
    observed_length: mutable usize = 0
    region scratch(64)
    first: mutable darray[u8] @scratch = [65]
    second: mutable darray[u8] @scratch = [66]
    if true:
        view: sview @scratch = swap_sview_arguments(first, second)
        first.push(67)
        observed_length <- view.len
    destroy scratch
    return observed_length

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    return 0
