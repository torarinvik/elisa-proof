# Focused direct-kernel controls for the primitive-comparison witness filter.
include "../src/proof/kernel_core.elisa"
include "../src/proof/kernel_replay.elisa"
using ElisaProofKernelCore
using ElisaProofKernelReplay

const MALFORMED_MARKER_ADMITTED: i64 = 1
const UNTRUSTED_OPERATOR_ADMITTED: i64 = 2
const VALID_SCALAR_WITNESS_REJECTED: i64 = 3
const DEEP_UNWITNESSED_COMPARISON_ADMITTED: i64 = 4

def scalar_marker(nodes: mutable darray[ProofKernelNode]&, children: mutable darray[usize]&, term: usize) -> usize can[Memory.Allocate, Abort.Panic]:
    callee: usize = add_node(nodes, "ident", "", 0, 0, 0, 0, 0, 0, "__elisa_primitive_scalar_type", "")
    argument: usize = add_node(nodes, "call_arg", "", term, 0, 0, 0, 0, 0, "", "")
    start: usize = children.count
    children.push(argument)
    return add_node(nodes, "call", "", callee, 0, 0, start, 1, 0, "", "")

def malformed_scalar_marker(nodes: mutable darray[ProofKernelNode]&) -> usize can[Memory.Allocate, Abort.Panic]:
    callee: usize = add_node(nodes, "ident", "", 0, 0, 0, 0, 0, 0, "__elisa_primitive_scalar_type", "")
    return add_node(nodes, "call", "", callee, 0, 0, 0, 0, 0, "", "")

def untrusted_operator_marker(nodes: mutable darray[ProofKernelNode]&, children: mutable darray[usize]&, term: usize) -> usize can[Memory.Allocate, Abort.Panic]:
    callee: usize = add_node(nodes, "ident", "", 0, 0, 0, 0, 0, 0, "__elisa_untrusted_operator_type", "")
    term_argument: usize = add_node(nodes, "call_arg", "", term, 0, 0, 0, 0, 0, "", "")
    protocol: usize = add_node(nodes, "string", "", 0, 0, 0, 0, 0, 0, "Eq", "")
    protocol_argument: usize = add_node(nodes, "call_arg", "", protocol, 0, 0, 0, 0, 0, "", "")
    start: usize = children.count
    children.push(term_argument)
    children.push(protocol_argument)
    return add_node(nodes, "call", "", callee, 0, 0, start, 2, 0, "", "")

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    nodes: mutable darray[ProofKernelNode] = []
    children: mutable darray[usize] = []
    x: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "x", "")
    y: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "y", "")
    x_reflexive: usize = add_node(&nodes, "binary", "==", x, x, 0, 0, 0, 0, "", "")
    y_reflexive: usize = add_node(&nodes, "binary", "==", y, y, 0, 0, 0, 0, "", "")

    malformed_y: darray[usize] = [malformed_scalar_marker(&nodes)]
    return MALFORMED_MARKER_ADMITTED if proof_kernel_replay_goal_report(&nodes, &children, malformed_y, y_reflexive)

    witnessed_x: darray[usize] = [scalar_marker(&nodes, &children, x)]
    return VALID_SCALAR_WITNESS_REJECTED if not proof_kernel_replay_goal_report(&nodes, &children, witnessed_x, x_reflexive)

    untrusted_x: darray[usize] = [scalar_marker(&nodes, &children, x), untrusted_operator_marker(&nodes, &children, x)]
    return UNTRUSTED_OPERATOR_ADMITTED if proof_kernel_replay_goal_report(&nodes, &children, untrusted_x, x_reflexive)

    # A deep unary expression cannot bypass the scalar-witness recursion's fixed depth budget.
    deep: mutable usize = x
    for _ in 0..<ElisaProofKernelCore::PROOF_KERNEL_AST_DEPTH_LIMIT:
        deep <- add_node(&nodes, "unary", "-", deep, 0, 0, 0, 0, 0, "", "")
    deep_comparison: usize = add_node(&nodes, "binary", "<", deep, deep, 0, 0, 0, 0, "", "")
    return DEEP_UNWITNESSED_COMPARISON_ADMITTED if proof_kernel_replay_goal_report(&nodes, &children, witnessed_x, deep_comparison)
    return 0
