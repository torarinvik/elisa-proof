# A returned closed constant keeps its function's signed return type, so an ensure comparing
# `result` with a negative or wide constant is decided at that width.
module TypedReturnConstants:
    public:
        def above_negative() -> i64:
            ensure result >= -5
            return 0

        def spelled_as_subtraction() -> i64:
            ensure 0 - 5 <= result
            return 0

        def negative_result() -> i64:
            ensure result <= -5
            return -6

        def guarded_offset(step: i64) -> i64:
            ensure result + 50000 >= 0
            return 0 if step <= 0
            return 0 if step > 50
            step * 1000

        def narrow_floor() -> i8:
            ensure result >= -128
            ensure result < 0 - 100
            return -101

        def literal_or_above(x: i32) -> i32:
            ensure result == -7 or result > x
            return -7

        def signed_minimum() -> i64:
            ensure result < -9000000000
            return -9223372036854775807 - 1
