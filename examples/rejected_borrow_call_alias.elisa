# A checked mutable callee summary cannot override a live overlapping shared borrow at the
# caller. The call-site capability check must reject the alias rather than trust the summary.
struct Inner:
    value: mutable i64

def set_inner_ref(inner: mutable Inner&) -> void:
    inner.value <- 3

def rejected_borrow_call_alias(box: mutable Inner&) -> i64:
    view: i64& = &box.value
    set_inner_ref(&box)
    return view
