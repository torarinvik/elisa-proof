# An index in an if-expression arm is in bounds only under that arm's condition. The statement is
# checked as the `if` it denotes, so the guard bounds the index (mocap-cleaner Track::pin).
module GuardedArmIndexes:
    def keep(planted: bool, height: i64) -> i64:
        return height

    def flag_at(flags: darray[bool]&, i: usize) -> bool:
        planted: bool = flags[i] if i < flags.count else false
        return planted

    def pinned(heights: darray[i64]&, flags: darray[bool]&) -> darray[i64]:
        out: mutable darray[i64] = []
        for i in 0..<heights.count |i, heights, flags, out|:
            planted: bool = flags[i] if i < flags.count else false
            out.push(keep(planted, heights[i]))
        return out
