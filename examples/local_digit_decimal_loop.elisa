const CAP: u64 = 1000000000000000000
struct Source:
    bytes: u8[8]
def checked(source: Source&, stop: usize) -> u64:
    requires stop <= 8
    ensure result <= CAP
    value: u64 =
        for index in 0..<stop |value: u64 = 0| -> value:
            invariant value <= CAP
            byte: u64 = source.bytes[index].u64()
            digit: u64 = byte - 48 if byte >= 48 and byte <= 57 else 0
            value <- CAP if value >= CAP / 10 else value * 10 + digit
    value
