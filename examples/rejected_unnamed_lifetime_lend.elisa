# The boundary of the lend admission, on the path where the callee also exports a summary. What
# makes lending a region-owned actual to a formal with no lifetime safe is that the callee cannot
# keep it: with no lifetime parameter to bind the capability to it can neither allocate into that
# region nor return anything from it. A callee that returns a reference can keep it, and is refused
# however it is reached -- a summary does not buy it the lend, and the lend does not buy it the
# summary.
struct Cell:
    value: mutable i64

def verified_keeper(cell: Cell&) -> Cell&:
    return cell

def lends_region_value_to_a_keeper() -> i64 can[Memory.Allocate, Abort.Panic]:
    region r(4096):
        cell: Cell& = new[r] Cell{value: 1}
        held: Cell& = verified_keeper(cell)
        return held.value
