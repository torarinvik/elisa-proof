# The relaxation is for the lend rule only. On the summary path the callee's own trace is what
# places a region-owned actual, so handing one to a formal that declares no lifetime is still
# refused there: `verified_walk` proves its own obligations and therefore exports a summary, which
# is exactly the path that must keep demanding a declared lifetime.
struct Cell:
    value: mutable i64

def verified_walk(cell: Cell&, depth: usize) -> i64:
    requires depth <= 127
    decreases 127 - depth
    return 0 if depth >= 127
    return verified_walk(cell, depth + 1)

def lends_region_value_to_summary() -> i64 can[Memory.Allocate, Abort.Panic]:
    region r(4096):
        cell: Cell& = new[r] Cell{value: 1}
        return verified_walk(cell, 0)
