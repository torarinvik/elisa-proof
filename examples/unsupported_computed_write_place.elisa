# A nested indexed selector is not a directly tracked resource-place index.
# Failure to resolve it is not evidence that a second borrow overlaps it.
def write_selected(values: mutable darray[i64]&, indices: darray[usize]&) -> void:
    requires indices.count > 0
    requires indices[0] < values.count
    values[indices[0]] <- 1

def main() -> i64:
    return 0
