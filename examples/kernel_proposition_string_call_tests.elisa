# String literals adopt the declared string-view family at a call boundary. The source-neutral
# kernel checks this narrow conversion without making unrelated string values interchangeable.
def kernel_literal_target_cstr(value: cstr) -> bool:
    return true

def kernel_literal_target_dstr(value: dstr) -> bool:
    return true

def kernel_literal_target_sview(value: sview) -> bool:
    return true

def kernel_source_string_literal_call_tests() -> bool can[Memory.Allocate, Abort.Panic]:
    return kernel_literal_target_cstr("text") and kernel_literal_target_dstr("text") and kernel_literal_target_sview("text")

def kernel_string_literal_call_argument_tests() -> i64 can[Memory.Allocate, Abort.Panic]:
    nodes: mutable darray[ProofKernelNode] = []
    children: mutable darray[usize] = []
    bindings: mutable darray[ProofKernelTypingBinding] = []

    cstr_added: bool = proof_kernel_add_function_signature(&bindings, "accept_cstr", "boolean", "bool", "", "", 0, 0, 1100, 1)
    cstr_parameter_added: bool = proof_kernel_add_function_parameter(&bindings, "accept_cstr", "value", "string", "cstr", "", "", 0, 0, 1100, 0, false, false)
    dstr_added: bool = proof_kernel_add_function_signature(&bindings, "accept_dstr", "boolean", "bool", "", "", 0, 0, 1101, 1)
    dstr_parameter_added: bool = proof_kernel_add_function_parameter(&bindings, "accept_dstr", "value", "string", "dstr", "", "", 0, 0, 1101, 0, false, false)
    sview_added: bool = proof_kernel_add_function_signature(&bindings, "accept_sview", "boolean", "bool", "", "", 0, 0, 1102, 1)
    sview_parameter_added: bool = proof_kernel_add_function_parameter(&bindings, "accept_sview", "value", "string", "sview", "", "", 0, 0, 1102, 0, false, false)
    reference_added: bool = proof_kernel_add_function_signature(&bindings, "accept_sview_reference", "boolean", "bool", "", "", 0, 0, 1103, 1)
    reference_parameter_added: bool = proof_kernel_add_function_parameter(&bindings, "accept_sview_reference", "value", "string", "sview", "", "", 0, 0, 1103, 0, false, true)
    dstr_value_added: bool = proof_kernel_add_typing_binding(&bindings, "value", "owned_text", "", "string", "dstr", "", "")
    return 1 if not cstr_added or not cstr_parameter_added or not dstr_added or not dstr_parameter_added or not sview_added or not sview_parameter_added or not reference_added or not reference_parameter_added or not dstr_value_added
    environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: bindings}

    cstr_callee: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "accept_cstr", "")
    cstr_text: usize = add_node(&nodes, "string", "", 0, 0, 0, 0, 0, 0, "text", "")
    cstr_argument: usize = add_node(&nodes, "call_arg", "", cstr_text, 0, 0, 0, 0, 0, "", "")
    cstr_start: usize = children.count
    children.push(cstr_argument)
    cstr_call: usize = add_node(&nodes, "call", "", cstr_callee, 0, 1, cstr_start, 1, 0, "", "")
    return 2 if not proof_kernel_replay_proposition_formation_report(&nodes, &children, environment, [], cstr_call)

    dstr_callee: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "accept_dstr", "")
    dstr_text: usize = add_node(&nodes, "string", "", 0, 0, 0, 0, 0, 0, "text", "")
    dstr_argument: usize = add_node(&nodes, "call_arg", "", dstr_text, 0, 0, 0, 0, 0, "", "")
    dstr_start: usize = children.count
    children.push(dstr_argument)
    dstr_call: usize = add_node(&nodes, "call", "", dstr_callee, 0, 1, dstr_start, 1, 0, "", "")
    return 3 if not proof_kernel_replay_proposition_formation_report(&nodes, &children, environment, [], dstr_call)

    sview_callee: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "accept_sview", "")
    sview_text: usize = add_node(&nodes, "string", "", 0, 0, 0, 0, 0, 0, "text", "")
    sview_argument: usize = add_node(&nodes, "call_arg", "", sview_text, 0, 0, 0, 0, 0, "", "")
    sview_start: usize = children.count
    children.push(sview_argument)
    sview_call: usize = add_node(&nodes, "call", "", sview_callee, 0, 1, sview_start, 1, 0, "", "")
    return 4 if not proof_kernel_replay_proposition_formation_report(&nodes, &children, environment, [], sview_call)

    integer_callee: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "accept_sview", "")
    integer_text: usize = add_node(&nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
    integer_argument: usize = add_node(&nodes, "call_arg", "", integer_text, 0, 0, 0, 0, 0, "", "")
    integer_start: usize = children.count
    children.push(integer_argument)
    integer_call: usize = add_node(&nodes, "call", "", integer_callee, 0, 1, integer_start, 1, 0, "", "")
    return 5 if proof_kernel_replay_proposition_formation_report(&nodes, &children, environment, [], integer_call)

    owned_text_callee: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "accept_sview", "")
    owned_text: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "owned_text", "")
    owned_text_argument: usize = add_node(&nodes, "call_arg", "", owned_text, 0, 0, 0, 0, 0, "", "")
    owned_text_start: usize = children.count
    children.push(owned_text_argument)
    owned_text_call: usize = add_node(&nodes, "call", "", owned_text_callee, 0, 1, owned_text_start, 1, 0, "", "")
    return 6 if proof_kernel_replay_proposition_formation_report(&nodes, &children, environment, [], owned_text_call)

    reference_callee: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "accept_sview_reference", "")
    reference_text: usize = add_node(&nodes, "string", "", 0, 0, 0, 0, 0, 0, "text", "")
    reference_argument: usize = add_node(&nodes, "call_arg", "", reference_text, 0, 0, 0, 0, 0, "", "")
    reference_start: usize = children.count
    children.push(reference_argument)
    reference_call: usize = add_node(&nodes, "call", "", reference_callee, 0, 1, reference_start, 1, 0, "", "")
    return 7 if proof_kernel_replay_proposition_formation_report(&nodes, &children, environment, [], reference_call)
    return 0
