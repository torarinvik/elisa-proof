# Minimized K-05 compiler experiment. The pinned compiler accepts the same
# character subtraction in both integer and character return contexts; this
# source alone does not establish the arithmetic model used by proof replay.

def char_difference_as_integer(c: char) -> i64:
    return c - '0'

def char_difference_as_character(c: char) -> char:
    return c - '0'
