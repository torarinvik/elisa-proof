# Replay positive full-width comparisons and fail closed on malformed tagged arenas.
include "../src/proof/kernel_core.elisa"
include "../src/proof/kernel_replay.elisa"
using ElisaProofKernelCore
using ElisaProofKernelReplay

extend ElisaProofKernelReplay:
    public:
        # The decoder is private and is only called beneath goal replay, but still
        # fail closed if a future internal caller supplies an unvalidated arena node.
        def tagged_decoder_refuses_malformed(nodes: darray[ProofKernelNode]&, root: usize) -> bool:
            decoded: (known: bool, tag: sview, value: i64) = proof_kernel_replay_tagged_comparison_constant(nodes, root)
            return not decoded.known

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    nodes: mutable darray[ProofKernelNode] = []
    children: mutable darray[usize] = []
    u64_max: usize = add_node(&nodes, "int", "u64", 0, 0, 0, 0, 0, -1, "", "")
    u64_high_bit: usize = add_node(&nodes, "int", "u64", 0, 0, 0, 0, 0, -9223372036854775807 - 1, "", "")
    usize_max: usize = add_node(&nodes, "int", "usize", 0, 0, 0, 0, 0, -1, "", "")
    zero: usize = add_node(&nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
    return 1 if not proof_kernel_replay_goal_report(&nodes, &children, [], add_node(&nodes, "binary", ">", u64_max, u64_high_bit, 0, 0, 0, 0, "", ""))
    return 2 if proof_kernel_replay_goal_report(&nodes, &children, [], add_node(&nodes, "binary", ">", u64_high_bit, u64_max, 0, 0, 0, 0, "", ""))
    return 3 if proof_kernel_replay_goal_report(&nodes, &children, [], add_node(&nodes, "binary", "==", u64_max, usize_max, 0, 0, 0, 0, "", ""))
    return 21 if proof_kernel_replay_goal_report(&nodes, &children, [], add_node(&nodes, "binary", "!=", u64_max, usize_max, 0, 0, 0, 0, "", ""))
    return 22 if proof_kernel_replay_goal_report(&nodes, &children, [], add_node(&nodes, "binary", "<", u64_max, usize_max, 0, 0, 0, 0, "", ""))
    bad_tag: usize = add_node(&nodes, "int", "u8", 0, 0, 0, 0, 0, -1, "", "")
    return 4 if proof_kernel_replay_goal_report(&nodes, &children, [], add_node(&nodes, "binary", ">", bad_tag, zero, 0, 0, 0, 0, "", ""))
    nonnegative_tag: usize = add_node(&nodes, "int", "u64", 0, 0, 0, 0, 0, 5, "", "")
    return 5 if proof_kernel_replay_goal_report(&nodes, &children, [], add_node(&nodes, "binary", ">", nonnegative_tag, zero, 0, 0, 0, 0, "", ""))
    return 6 if proof_kernel_replay_goal_report(&nodes, &children, [], add_node(&nodes, "binary", "**", u64_max, zero, 0, 0, 0, 0, "", ""))

    bad_name: usize = add_node(&nodes, "int", "u64", 0, 0, 0, 0, 0, -1, "hidden", "")
    return 7 if proof_kernel_replay_goal_report(&nodes, &children, [], add_node(&nodes, "binary", ">", bad_name, zero, 0, 0, 0, 0, "", ""))
    return 14 if not ElisaProofKernelReplay::tagged_decoder_refuses_malformed(&nodes, bad_name)
    bad_secondary: usize = add_node(&nodes, "int", "u64", 0, 0, 0, 0, 0, -1, "", "hidden")
    return 8 if proof_kernel_replay_goal_report(&nodes, &children, [], add_node(&nodes, "binary", ">", bad_secondary, zero, 0, 0, 0, 0, "", ""))
    return 15 if not ElisaProofKernelReplay::tagged_decoder_refuses_malformed(&nodes, bad_secondary)
    bad_left: usize = add_node(&nodes, "int", "u64", nodes.count + 10, 0, 0, 0, 0, -1, "", "")
    return 9 if proof_kernel_replay_goal_report(&nodes, &children, [], add_node(&nodes, "binary", ">", bad_left, zero, 0, 0, 0, 0, "", ""))
    return 16 if not ElisaProofKernelReplay::tagged_decoder_refuses_malformed(&nodes, bad_left)
    bad_right: usize = add_node(&nodes, "int", "u64", 0, nodes.count + 10, 0, 0, 0, -1, "", "")
    return 10 if proof_kernel_replay_goal_report(&nodes, &children, [], add_node(&nodes, "binary", ">", bad_right, zero, 0, 0, 0, 0, "", ""))
    return 17 if not ElisaProofKernelReplay::tagged_decoder_refuses_malformed(&nodes, bad_right)
    bad_auxiliary: usize = add_node(&nodes, "int", "u64", 0, 0, nodes.count + 10, 0, 0, -1, "", "")
    return 11 if proof_kernel_replay_goal_report(&nodes, &children, [], add_node(&nodes, "binary", ">", bad_auxiliary, zero, 0, 0, 0, 0, "", ""))
    return 18 if not ElisaProofKernelReplay::tagged_decoder_refuses_malformed(&nodes, bad_auxiliary)
    bad_children_count: usize = add_node(&nodes, "int", "u64", 0, 0, 0, 0, 1, -1, "", "")
    return 12 if proof_kernel_replay_goal_report(&nodes, &children, [], add_node(&nodes, "binary", ">", bad_children_count, zero, 0, 0, 0, 0, "", ""))
    return 19 if not ElisaProofKernelReplay::tagged_decoder_refuses_malformed(&nodes, bad_children_count)
    bad_children_start: usize = add_node(&nodes, "int", "u64", 0, 0, 0, 1, 0, -1, "", "")
    return 13 if proof_kernel_replay_goal_report(&nodes, &children, [], add_node(&nodes, "binary", ">", bad_children_start, zero, 0, 0, 0, 0, "", ""))
    return 20 if not ElisaProofKernelReplay::tagged_decoder_refuses_malformed(&nodes, bad_children_start)
    return 0
