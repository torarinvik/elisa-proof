# Qualified lookups prefer an exact module declaration and fall back to scalar
# resolution only when the selected module has no declaration for that leaf.
type RootWidth = u32

module QualifiedWidth:
    public:
        type u64 = u8

def qualified_builtin_missing_i64() -> QualifiedWidth::i64:
    ensure result == 9223372036854775807i64
    return 9223372036854775807i64

def qualified_builtin_missing_i64_wraps() -> bool:
    ensure result
    return qualified_builtin_missing_i64() + 1 < 0i64

def qualified_owner_alias_shadows_builtin() -> QualifiedWidth::u64:
    ensure result == 255u8
    return 255u8

def qualified_owner_alias_shadows_builtin_wraps() -> bool:
    ensure result
    return qualified_owner_alias_shadows_builtin() + 1 == 0u8

def qualified_module_root_alias() -> QualifiedWidth::RootWidth:
    ensure result == 4294967295u32
    return 4294967295u32

def qualified_module_root_alias_wraps() -> bool:
    ensure result
    return qualified_module_root_alias() + 1 == 0u32
