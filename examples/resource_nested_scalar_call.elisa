struct Bound:
    name: sview
    lower: mutable i64
    upper: mutable i64
    has_lower: mutable bool
    has_upper: mutable bool

def add_lower(bounds: mutable darray[Bound]&, name: sview, value: i64) -> void:
    return if name == ""
    for mutable bound in bounds:
        if bound.name == name:
            old_has: bool = bound.has_lower
            old_value: i64 = bound.lower
            bound.has_lower <- true
            bound.lower <- value if not old_has or value > old_value
            return
    bounds <- bounds.push(Bound{name: name, has_lower: true, lower: value, has_upper: false, upper: 0})

def add_upper(bounds: mutable darray[Bound]&, name: sview, value: i64) -> void:
    return if name == ""
    for mutable bound in bounds:
        if bound.name == name:
            old_has: bool = bound.has_upper
            old_value: i64 = bound.upper
            bound.has_upper <- true
            bound.upper <- value if not old_has or value < old_value
            return
    bounds <- bounds.push(Bound{name: name, has_lower: false, lower: 0, has_upper: true, upper: value})

def valid(nodes: darray[u8]&, fact: usize) -> bool:
    return fact < nodes.count

def lower_value(value: i64) -> i64:
    return value - 1

def upper_value(value: i64) -> i64:
    return value + 1

def collect(nodes: darray[u8]&, facts: darray[usize], bounds: mutable darray[Bound]&) -> void:
    for fact in facts:
        continue if not valid(nodes, fact)
        add_lower(bounds, "x", lower_value(fact.i64()))
        add_upper(bounds, "x", upper_value(fact.i64()))
