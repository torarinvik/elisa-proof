# The refusal itself: a call in the loop condition makes the condition opaque, and the loop then
# carries no claim about the state after it.

extend RejectedBoundLoopCondition:
    def limit() -> usize:
        return 8

    def a_call_in_the_condition_is_opaque(start: usize) -> usize:
        steps: mutable usize = start
        while steps < limit() |steps|:
            steps <- steps + 1
        return steps
