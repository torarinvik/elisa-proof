# Four named field segments must remain distinct resources. A borrow of value does not overlap
# the sibling field at the same depth, even though both paths share the same deep root.
struct DeepLeaf:
    value: mutable i64
    sibling: mutable i64

struct DeepC:
    leaf: mutable DeepLeaf

struct DeepB:
    child: mutable DeepC

struct DeepA:
    branch: mutable DeepB

def borrow_four_nested_fields(root: mutable DeepA) -> i64:
    value_view: i64& = &root.branch.child.leaf.value
    root.branch.child.leaf.sibling <- 1
    return root.branch.child.leaf.sibling
