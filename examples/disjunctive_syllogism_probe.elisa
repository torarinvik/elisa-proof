# Six forced implications exceed the four-level branching budget, but require
# no branches: each excluded alternative is explicitly refuted by a prior fact.
def forced_boolean_chain(a: bool, b: bool, c: bool, d: bool, e: bool, f: bool, g: bool) -> bool:
    requires a
    requires not a or b
    requires not b or c
    requires not c or d
    requires not d or e
    requires not e or f
    requires not f or g
    ensure result
    return g

def forced_integer_alternative(code: u8, accepted: bool) -> bool:
    requires code >= 3
    requires code < 3 or accepted
    ensure result
    return accepted

def forced_right_alternative(accepted: bool, denied: bool) -> bool:
    requires not denied
    requires accepted or denied
    ensure result
    return accepted
