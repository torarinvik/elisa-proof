# A conditional nested inside a comparison, `(a if c else b) + 1 <= k`, is split on its
# condition, and each branch rewrites every occurrence in the goal and in the facts.
enum Tree:
    Leaf
    Node(left: Tree, value: i64, right: Tree)

const HEIGHT_CAP: i64 = 1000000

# The branch bound comes from the conditional's own guard, a fact about the conditional.
def tree_height(tree: Tree) -> i64:
    decreases tree
    ensure result >= 0
    ensure result <= HEIGHT_CAP
    match tree:
        Tree.Leaf:
            return 0
        Tree.Node(left, _, right):
            l: i64 = tree_height(left)
            r: i64 = tree_height(right)
            deeper: i64 = l if l >= r else r
            return deeper + 1 if deeper < HEIGHT_CAP
            return deeper

def successor_of_max(a: i64, b: i64) -> i64:
    requires a >= 0 and a < 1000
    requires b >= 0 and b < 1000
    ensure result >= 1
    ensure result <= 1000
    return (a if a >= b else b) + 1

# Two conditionals under one sum: the first split leaves the second nested, and both
# branches of each must close.
def min_plus_max_is_sum(a: i64, b: i64) -> bool:
    requires a >= 0 and a <= 1000
    requires b >= 0 and b <= 1000
    ensure result
    return (a if a <= b else b) + (a if a >= b else b) == a + b
