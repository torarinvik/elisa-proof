# `elisac-stage1` declines any function body that carries a loop `invariant` -- `while` or `for`,
# with captures or without. The previous entry guessed the restriction was the `return` inside the
# loop; it is not, and the corrected fact is that a loop invariant cannot appear in a compiled
# source of this project at all.
#
# So a loop whose index bound needs an invariant cannot be given one, and must be written not to
# need one. A downward `while index > 0` scan needs `index <= count` stated; a forward scan over
# `0..<count` has that from the loop range. Keeping the last match returns the same slot the
# downward scan returned -- the highest matching index, which is the innermost binding under
# shadowing -- so the rewrite preserves the answer and gives up only the early exit.

extend ForwardScan:
    def a_forward_scan_keeps_the_last_match(names: darray[usize]&, wanted: usize) -> usize:
        found: mutable usize = names.count
        for index in 0..<names.count |index, names, wanted, found|:
            found <- index if names[index] == wanted
        return found

    def an_existence_check_does_not_depend_on_order(regions: darray[usize]&, wanted: usize) -> bool:
        found: mutable bool = false
        for index in 0..<regions.count |index, regions, wanted, found|:
            found <- true if regions[index] == wanted
        return found
