# Exact place-width witnesses keep a useful relational proof: x < y at the same width makes x+1 safe.
struct ByteBounds:
    value: u8
    limit: u8

def bounded_field_increment(bounds: ByteBounds) -> void:
    requires bounds.value < bounds.limit
    ensure bounds.value + 1 <= bounds.limit
    return

def main() -> u8:
    return 0
