# The literal's length is the literal's length and nothing else. It says nothing about a binding
# after the collection is written, nothing about a collection that is not a literal, and it is not
# a length for a field named `count` on something that is not a collection literal.

extend RejectedLiteralExtent:
    struct Counter:
        count: usize

    def a_push_is_not_modelled(seed: usize) -> bool:
        ensure result
        values: mutable darray[usize] = []
        values.push(seed)
        return values.count == 1

    def a_parameter_has_no_literal(values: darray[usize]&) -> bool:
        ensure result
        return values.count == 0

    # A struct field spelled `count` is a field, not a collection length.
    def a_field_named_count_is_not_a_length(counter: Counter) -> bool:
        ensure result
        return counter.count == 0

    def a_literal_length_is_not_an_element_bound(values: darray[usize]&) -> bool:
        requires values.count == 3
        ensure result
        return values[3] == 0

    # A completeness boundary, not a soundness one: a non-empty literal does carry its length, but
    # reading it needs a conversion this checker does not verify itself in, so it is not read.
    def a_non_empty_literal_length_is_not_read() -> bool:
        ensure result
        values: darray[usize] = [3, 5, 7]
        return values.count == 3
