module GlobalConstantLoopExit:
    public:
        const CAP: usize = 8

        # The loop exit forgets loop-local facts but keeps `CAP == 8`, so the invariant over
        # `CAP` still meets an ensure over the literal.
        def last_slot() -> usize:
            ensure result <= 8
            for slot in 0..<CAP |best: usize = CAP| -> best:
                invariant best <= CAP
                best <- slot
