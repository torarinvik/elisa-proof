# Controls for the linear tier: a bound one short of what the premises give, a goal that
# needs integer-only reasoning (`2 * x == 1` has rational solutions), and a disjunctive
# summary whose alternatives the premises do not refute.
module Linear:
    public:
        const L: i64 = 1000

        def accel_short(prev: i64, now: i64, next: i64) -> i64:
            requires prev >= -L
            requires prev <= L
            requires now >= -L
            requires now <= L
            requires next >= -L
            requires next <= L
            ensure prev - 2 * now + next <= 4 * L - 1
            return 0

        def parity(x: i64, y: i64) -> i64:
            requires x >= 0
            requires x <= 100
            requires y == 2 * x
            ensure y != 1
            ensure 2 * x <= 0 or 2 * x >= 2
            return x

        def clamp(deviation: i64, limit: i64) -> i64:
            requires deviation >= -L
            requires deviation <= L
            requires limit >= 0
            requires limit <= L
            ensure deviation > limit or deviation < -limit or result == deviation
            if deviation > limit:
                return limit
            if deviation < -limit:
                return -limit
            return deviation

        def clamp_any(value: i64, limit: i64) -> i64:
            requires value >= -L
            requires value <= L
            requires limit >= 0
            requires limit <= L
            ensure result == value
            return Linear::clamp(value, limit)
