# A foreach binder inherits the declared unsigned type of each collection element.

def read_at_nonnegative_foreach_index(values: darray[i64]&, indexes: darray[usize]&) -> i64:
    for index in indexes:
        return values[index]
    return 0

# The loop element comes from a signed collection, so this must not gain a zero lower bound.
def keep_signed_foreach_index_unproven(values: darray[i64]&, indexes: darray[i64]&, unrelated_unsigned_indexes: darray[usize]&) -> i64:
    for index in indexes:
        return values[index]
    return 0

# An unsigned foreach element must not lend its lower bound to a different outer binder.
def keep_other_index_unproven(values: darray[i64]&, indexes: darray[usize]&, index: i64) -> i64:
    for value in indexes:
        return values[index]
    return 0
