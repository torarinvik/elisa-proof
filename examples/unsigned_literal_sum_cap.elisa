def bounded_prefix_sum(first: u64, second: u64) -> u64:
    requires first <= 4
    requires second <= 4 - first
    ensure result <= 4
    return first + second

def bounded_byte_sum(first: u8, second: u8) -> u8:
    requires first <= 255
    requires second <= 255 - first
    ensure result <= 255
    return first + second
