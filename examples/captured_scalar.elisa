# A capture list is not a bound on what a block writes -- `elisac-stage1` compiles a captured block
# whose body assigns an outer binding the list omits, and the program observes the assignment --
# which is why the write-back set takes everything the body assigns or references. It is also not
# *evidence* of a write. A block writes an outer binding by assigning it or by handing it to
# something, and both of those are in the body's own sets; a capture the body only reads cannot be
# written by it.
#
# Forgetting one discarded a precondition the loop never touched, so `requires depth <= 127` beside
# a captured loop was gone after it. The exemption is limited to a witnessed scalar, so an owning
# value a capture could move out of keeps the conservative treatment.

extend CapturedScalar:
    def needs_bound(depth: usize) -> usize:
        requires depth <= 127
        return depth

    def touch(nodes: mutable darray[usize]&, value: usize) -> bool:
        nodes.push(value)
        return value == 0

    def a_read_only_capture_keeps_its_precondition(depth: usize, values: darray[usize]&) -> usize:
        requires depth <= 127
        seen: mutable usize = 0
        for value in values |value, seen, depth|:
            seen <- seen + 1 if value + depth == 0
        return needs_bound(depth)

    def a_read_only_capture_survives_a_mutating_body(depth: usize, values: darray[usize]&, nodes: mutable darray[usize]&) -> usize:
        requires depth <= 127
        seen: mutable usize = 0
        for value in values |value, seen, nodes, depth|:
            seen <- seen + 1 if touch(nodes, value + depth)
        return needs_bound(depth)
