# Only what the loop checked survives it.
module RejectedCapturedBlockExit:
    # The loop never states an upper bound, so none holds after it.
    def unchecked(start: usize, stop: usize) -> usize:
        requires start <= stop
        ensure result <= stop
        cursor: mutable usize = start
        for slot in 0..<8 |cursor|:
            invariant start <= cursor
            cursor <- cursor + 1 if cursor < stop
        cursor

    # An invariant the body breaks is not kept either.
    def broken(start: usize, stop: usize) -> usize:
        requires start <= stop
        ensure result <= stop
        cursor: mutable usize = start
        for slot in 0..<8 |cursor|:
            invariant cursor <= stop
            cursor <- cursor + 2 if cursor < stop
        cursor
