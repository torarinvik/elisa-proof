# Constructs that differ must not stand in for each other, and a summary
# does not promise more than the callee ensures.
module RejectedReplayConstructArguments:
    public:
        struct Pair:
            a: u64
            b: u64

        def cap(p: Pair) -> u64:
            ensure result <= 10
            p.a if p.a < 10 else 10

        def first(p: Pair) -> u64:
            ensure result == p.a
            p.a

        def untrue_tighter_cap(x: u64, y: u64) -> u64:
            ensure result <= 9
            cap(Pair{a: x, b: y})

        def untrue_swapped_fields(x: u64, y: u64) -> u64:
            ensure result == y
            first(Pair{a: x, b: y})

        def untrue_other_construct(x: u64, y: u64) -> bool:
            ensure result
            first(Pair{a: x, b: y}) == first(Pair{a: y, b: x})
