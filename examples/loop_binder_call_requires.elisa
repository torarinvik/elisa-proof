# A range-loop binder carries its bound into a callee's precondition in every position a call
# can take: a conditional assignment, a block `if`, a declaration initializer and a short-circuit
# operand. The binder's versioned value is resolved once, so the instantiated `requires` meets
# the loop's facts about it.
module Pick:
    public:
        const CAP: usize = 4

        struct Pool:
            live: bool[Pick::CAP]
            rank: u32[Pick::CAP]

        def better(pool: Pool&, slot: usize, best: usize) -> bool:
            requires slot < CAP
            return true if best >= CAP
            pool.rank[slot] > pool.rank[best]

        def pick_suffix(pool: Pool&) -> usize:
            for slot in 0..<CAP |best: usize = CAP| -> best:
                best <- slot if better(pool, slot, best)

        def pick_block_if(pool: Pool&) -> usize:
            for slot in 0..<CAP |best: usize = CAP| -> best:
                if better(pool, slot, best):
                    best <- slot

        def pick_bound(pool: Pool&) -> usize:
            for slot in 0..<CAP |best: usize = CAP| -> best:
                good: bool = better(pool, slot, best)
                best <- slot if good

        def pick_guarded(pool: Pool&) -> usize:
            for slot in 0..<CAP |best: usize = CAP| -> best:
                candidate: bool = pool.live[slot]
                best <- slot if candidate and better(pool, slot, best)
