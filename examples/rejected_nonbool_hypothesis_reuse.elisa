# A malformed source value must not become a proposition merely because the same expression
# appears in both the hypothesis and conclusion. This targets the source-adapter bridge, not just
# the direct source-neutral kernel API.
struct OpaqueValues:
    count: i64

def integer_value() -> i64:
    return 1

def rejected_call_hypothesis() -> i64:
    requires integer_value()
    ensure integer_value()
    return 0

def rejected_field_hypothesis(value: OpaqueValues&) -> i64:
    requires value.count
    ensure value.count
    return 0

def rejected_index_hypothesis(values: darray[i64]&) -> i64:
    requires values[0]
    ensure values[0]
    return 0

def rejected_shadowed_boolean(flag: bool) -> bool:
    requires flag
    ensure forall flag in [0, 1]: flag
    return flag
