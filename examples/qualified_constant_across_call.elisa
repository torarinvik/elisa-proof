# A callee ensure over a qualified constant, `result == Full::TOP`, reaches the caller over
# the path, while the caller's own contract has the path unfolded to its value. The imported
# `Full::TOP == 1000` fact names an immutable declaration, so it survives the call.
module Full:
    public:
        const TOP: i64 = 1000
module Other:
    public:
        const TOP: i64 = 999
module Pull:
    public:
        def pull(frame: i64, last: i64) -> i64:
            requires frame >= 0
            requires frame <= last
            requires last <= 1000
            ensure result >= 0
            ensure result <= Full::TOP
            ensure frame != last or result == Full::TOP
            return Full::TOP if frame == last
            return frame

module Uses:
    public:
        def closes(last: i64) -> i64:
            requires last >= 1
            requires last <= 1000
            ensure result == Full::TOP
            return Pull::pull(last, last)

        def in_permille(frame: i64, last: i64) -> i64:
            requires frame >= 0
            requires frame <= last
            requires last <= 1000
            ensure result <= Full::TOP
            ensure result <= 1000
            return Pull::pull(frame, last)
