# None of these may be proved. A closed constant is read at its peer's width only when that
# width is a signed width the constant fits.

def tiny() -> i8:
    ensure result >= 0
    return 1

def byte() -> u8:
    ensure result >= 100
    return 100

def big() -> i64:
    ensure result >= 0
    return 7

def limited(x: i64) -> i64:
    requires x >= 0
    ensure result >= 0
    return x

# False: at i8, `100 + 100` wraps to -56.
def signed_wraps() -> bool:
    ensure result
    tiny() < 100 + 100

# False: at u8, `200 + 100` wraps to 44.
def unsigned_wraps() -> bool:
    ensure result
    byte() < 200 + 100

# False at big() = 999745.
def off_by_one() -> i64:
    ensure result <= 999745
    later: i64 = big()
    return later if later > 1000000 - 255
    return later + 1

# False at big() = 0: the typed constant does not turn a lower bound into an upper one.
def direct_call_off_by_one() -> bool:
    ensure result
    big() > 1000000 - 255

# False at x = 2000000: nothing bounds the result above, and a callee with a precondition is not
# pure, so its result has no witness and no width either.
def impure_call_untyped(x: i64) -> bool:
    requires x >= 0
    ensure result
    limited(x) <= 999999 + 1
