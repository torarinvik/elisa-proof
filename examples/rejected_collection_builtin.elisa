# The write the model records is an ordinary write, so the borrow rules apply to it, and the
# admission is withdrawn where the model would be answering a question it does not answer.

extend RejectedCollectionBuiltin:
    def read(values: darray[usize]&) -> usize:
        return values.count

    # The previous commit verified this: the push recorded nothing, so nothing conflicted with the
    # live shared borrow.
    def a_push_while_a_borrow_is_live(seed: usize) -> usize:
        values: mutable darray[usize] = []
        view: darray[usize]& = &values
        values.push(seed)
        return read(view)

    # A region value entering a collection is an escape question, so the admission is withdrawn
    # and the call is opaque again.
    def a_region_argument_withdraws_the_admission(values: mutable darray[usize]&) -> usize:
        region scratch:
            values.push(new[scratch] 1)
        return values.count

    # A builtin whose effect this model does not name is refused, not passed over. Before the
    # model existed every builtin call was in this position and none of them were refused for it.
    def an_unmodelled_builtin_is_refused(values: mutable darray[usize]&) -> usize:
        values.sort()
        return values.count
