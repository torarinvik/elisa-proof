# The premise is usable, and it bounds the sum by 1000000, not by anything tighter.
def bounded_size(seed: i64) -> i64:
    ensure result >= 1
    ensure result <= 1000000
    return 1

def capped_pair(a: i64, b: i64) -> i64:
    ensure result <= 999999
    l: i64 = bounded_size(a)
    r: i64 = bounded_size(b)
    return 999999 if l + r >= 1000000
    return l + r + 1
