# Every function here is wrong in one way the M6 slice names: an induction hypothesis that
# does not survive the step, recursion that does not descend, a claim that holds for one
# constructor only, or a bound that the recursion breaks. Replay refuses a function's own
# summary while any of its goals is unproven, so a false hypothesis never supports a proof.

enum IntList:
    Nil
    Cons(head: i64, others: IntList)

enum Tree:
    Leaf
    Node(left: Tree, value: i64, right: Tree)

const ADT_CAP: i64 = 1000000

# The hypothesis `rest == 0` is the claim itself, and it does not survive the step.
def count_is_zero(list: IntList) -> i64:
    decreases list
    ensure result == 0
    match list:
        IntList.Nil:
            return 0
        IntList.Cons(_, others):
            rest: i64 = count_is_zero(others)
            return rest + 1

# Recursion on the value itself does not decrease it.
def spin(list: IntList) -> i64:
    decreases list
    ensure result >= 0
    match list:
        IntList.Nil:
            return 0
        IntList.Cons(_, _):
            return spin(list)

# Recursion on the whole tree from inside its own match does not decrease it.
def tree_spin(tree: Tree) -> i64:
    decreases tree
    ensure result >= 0
    match tree:
        Tree.Leaf:
            return 0
        Tree.Node(left, _, _):
            return tree_spin(tree)

# The Nil arm's value is claimed for every list.
def wrong_constructor(list: IntList) -> i64:
    ensure result == 0
    match list:
        IntList.Nil:
            return 0
        IntList.Cons(head, _):
            return head

# A height bounded by one holds for the children, but one more level breaks it.
def shallow(tree: Tree) -> i64:
    decreases tree
    ensure result >= 0
    ensure result <= 1
    match tree:
        Tree.Leaf:
            return 0
        Tree.Node(left, _, right):
            l: i64 = shallow(left)
            r: i64 = shallow(right)
            deeper: i64 = l if l >= r else r
            return deeper + 1

# The maximum is only bounded below by the floor, never above by it.
def max_below_floor(tree: Tree, floor: i64) -> i64:
    decreases tree
    ensure result >= floor
    ensure result <= floor
    match tree:
        Tree.Leaf:
            return floor
        Tree.Node(left, value, right):
            l: i64 = max_below_floor(left, floor)
            r: i64 = max_below_floor(right, l)
            return value if value > r
            return r

# The capped count reaches the cap, so it is not always below it.
def length_below_cap(list: IntList) -> i64:
    decreases list
    ensure result >= 0
    ensure result < ADT_CAP
    match list:
        IntList.Nil:
            return 0
        IntList.Cons(_, others):
            rest: i64 = length_below_cap(others)
            return rest + 1 if rest < ADT_CAP
            return rest
