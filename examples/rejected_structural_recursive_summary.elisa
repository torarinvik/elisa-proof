# A fresh payload symbol is opaque: it carries no fact about a shadowed outer variable, and a
# recursive summary still has to establish the caller's own postcondition.

enum Nat:
    Zero
    Succ(prev: Nat)

enum Box:
    Val(v: i64)
    Empty

def rejected_structural_depth(n: Nat) -> i64:
    decreases n
    ensure result == 0
    match n:
        Nat.Zero:
            return 1
        Nat.Succ(prev):
            return rejected_structural_depth(prev)

def rejected_shadowed_payload(b: Box, v: i64) -> i64:
    requires v == 5
    ensure result == 5
    match b:
        Box.Val(v):
            return v
        Box.Empty:
            return 5
