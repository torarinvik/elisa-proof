# Guarded returns leave the negation of their complete guard on the fall-through path.
# The selector contracts exercise both the disjunctive postcondition and exact fallback.
def guarded_selector(kind: u8, present: u8, source: usize, fallback: usize) -> usize:
    ensure kind != 6 or present == 0 or result == source
    ensure kind != 6 or present != 0 or result == fallback
    return source if kind == 6 and present != 0
    return fallback

def de_morgan_case(left: bool, right: bool) -> void:
    requires not (left and right)
    ensure not left or not right
    return

# Negative control: not (left and right) does not establish not left by itself.
def false_negated_conjunction_control(left: bool, right: bool) -> usize:
    ensure not left
    return 0 if not (left and right)
    return 0
