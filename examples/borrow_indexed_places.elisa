# Closed literal indexes are tracked as exact resource places. Distinct elements may be
# borrowed simultaneously, and an indexed borrow can cross a checked resource summary.
def read_index_ref(value: i64&) -> i64:
    return value

def borrow_indexed_places(values: i64[2]) -> i64:
    first: i64& = &values[0]
    second: i64& = &values[1]
    result: i64 = read_index_ref(&values[0])
    return result
