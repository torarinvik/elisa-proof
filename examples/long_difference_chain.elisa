# A bound reaches the first name of a chain through every link, however long: the interval pass
# runs to a fixed point instead of stopping after four rounds (BACKLOG C-01). `v0 * 4` needs an
# upper bound on `v0` itself, which is stated only at the far end of the chain, and the facts are
# listed in the order that makes each round carry it a single link. Before the change the six-,
# twelve- and twenty-link bodies were refused. `thirty_two_names` is the budget case: the
# difference graph's widest chain the limit is sized for.

def three_links(v0: u32, v1: u32, v2: u32) -> u32:
    requires v0 < v1
    requires v1 < v2
    requires v2 <= 1000
    ensure result <= 4000
    return v0 * 4

def six_links(v0: u32, v1: u32, v2: u32, v3: u32, v4: u32, v5: u32) -> u32:
    requires v0 < v1
    requires v1 < v2
    requires v2 < v3
    requires v3 < v4
    requires v4 < v5
    requires v5 <= 1000
    ensure result <= 4000
    return v0 * 4

def twelve_links(v0: u32, v1: u32, v2: u32, v3: u32, v4: u32, v5: u32, v6: u32, v7: u32, v8: u32, v9: u32, v10: u32, v11: u32) -> u32:
    requires v0 < v1
    requires v1 < v2
    requires v2 < v3
    requires v3 < v4
    requires v4 < v5
    requires v5 < v6
    requires v6 < v7
    requires v7 < v8
    requires v8 < v9
    requires v9 < v10
    requires v10 < v11
    requires v11 <= 1000
    ensure result <= 4000
    return v0 * 4

def twenty_links_signed(v0: i32, v1: i32, v2: i32, v3: i32, v4: i32, v5: i32, v6: i32, v7: i32, v8: i32, v9: i32, v10: i32, v11: i32, v12: i32, v13: i32, v14: i32, v15: i32, v16: i32, v17: i32, v18: i32, v19: i32) -> i32:
    requires v0 < v1
    requires v1 < v2
    requires v2 < v3
    requires v3 < v4
    requires v4 < v5
    requires v5 < v6
    requires v6 < v7
    requires v7 < v8
    requires v8 < v9
    requires v9 < v10
    requires v10 < v11
    requires v11 < v12
    requires v12 < v13
    requires v13 < v14
    requires v14 < v15
    requires v15 < v16
    requires v16 < v17
    requires v17 < v18
    requires v18 < v19
    requires v19 <= 1000
    requires v0 >= 0
    ensure result <= 4000
    return v0 * 4

def thirty_two_names(v0: u32, v1: u32, v2: u32, v3: u32, v4: u32, v5: u32, v6: u32, v7: u32, v8: u32, v9: u32, v10: u32, v11: u32, v12: u32, v13: u32, v14: u32, v15: u32, v16: u32, v17: u32, v18: u32, v19: u32, v20: u32, v21: u32, v22: u32, v23: u32, v24: u32, v25: u32, v26: u32, v27: u32, v28: u32, v29: u32, v30: u32, v31: u32) -> u32:
    requires v0 < v1
    requires v1 < v2
    requires v2 < v3
    requires v3 < v4
    requires v4 < v5
    requires v5 < v6
    requires v6 < v7
    requires v7 < v8
    requires v8 < v9
    requires v9 < v10
    requires v10 < v11
    requires v11 < v12
    requires v12 < v13
    requires v13 < v14
    requires v14 < v15
    requires v15 < v16
    requires v16 < v17
    requires v17 < v18
    requires v18 < v19
    requires v19 < v20
    requires v20 < v21
    requires v21 < v22
    requires v22 < v23
    requires v23 < v24
    requires v24 < v25
    requires v25 < v26
    requires v26 < v27
    requires v27 < v28
    requires v28 < v29
    requires v29 < v30
    requires v30 < v31
    requires v31 <= 1000
    ensure result <= 4000
    return v0 * 4
