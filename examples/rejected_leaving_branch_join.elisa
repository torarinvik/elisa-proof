# Leaving branches no longer weaken a join, but everything that reaches it still does. Each
# claim below is false for some input: the guard is inverted, the branch that falls through
# calls a mutator, or the mutator runs in the condition or scrutinee on every path.
module Guard:
    public:
        const CAPACITY: usize = 4

        error GuardError:
            Dead

        struct Table:
            live: bool[Guard::CAPACITY]
            total: mutable usize

        def live(table: Table&, slot: usize) -> bool:
            ensure not result or slot < CAPACITY
            slot < CAPACITY and table.live[slot]

        def clear(table: mutable Table&) -> usize:
            table.total <- 0
            0

        def inverted_guard(table: Table&, slot: usize) -> bool error[GuardError]:
            raise GuardError.Dead if live(table, slot)
            table.live[slot]

        def falling_branch_call(table: mutable Table&, flag: bool) -> usize error[GuardError]:
            requires table.total == 3
            ensure result == 3
            if flag:
                clear(table)
            else:
                raise GuardError.Dead
            table.total

        def condition_call(table: mutable Table&) -> usize error[GuardError]:
            requires table.total == 3
            ensure result == 3
            raise GuardError.Dead if clear(table) != 0
            table.total

        def scrutinee_call(table: mutable Table&) -> usize error[GuardError]:
            requires table.total == 3
            ensure result == 3
            match clear(table):
                0:
                    assert table.total == 0
                _:
                    raise GuardError.Dead
            table.total

        def match_falling_arm_call(table: mutable Table&, mode: u8) -> usize error[GuardError]:
            requires table.total == 3
            ensure result == 3
            match mode:
                0:
                    raise GuardError.Dead
                _:
                    clear(table)
            table.total
