# Unary unsigned negation wraps; it is not a small signed ghost endpoint.
def rejected_unsigned_negative_lower() -> bool:
    ensure exists index in -1u8..<1u8: index == 0
    return true

def rejected_unsigned_negative_upper() -> bool:
    ensure forall index in 0u8..<(-1u8): index < 2
    return true

# A high-bit source token is not syntactic signed negation.
def rejected_wrapped_payload_endpoint() -> bool:
    ensure exists index in 18446744073709551615..<0: true
    return true
