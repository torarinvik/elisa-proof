# First dogfood slice: executable specifications for the source-neutral certificate kernel.
#
# These are intentionally small and independent of the checker implementation. They model the
# invariants that the eventual self-verification pass must establish about arena ranges and
# certificate roots. Keeping them as ordinary Elisa contracts lets the same proof/replay pipeline
# validate the specification before we attach it to the actual kernel implementation.

def kernel_child_range_end(start: i64, count: i64, capacity: i64) -> i64:
    requires start >= 0 and count >= 0 and capacity >= 0
    requires start <= capacity and count <= capacity - start
    # The first dogfood slice is finite by design: it exercises the complete model-checking
    # path while the general heap/arena proof rules are still being extracted.
    requires start <= 16 and count <= 16 and capacity <= 32
    ensure result >= start
    ensure result <= capacity
    return start + count


def kernel_root_is_valid(root: i64, node_count: i64) -> bool:
    requires root >= 0 and node_count > 0 and root < node_count
    requires root <= 16 and node_count <= 16
    ensure result == true
    return root < node_count


def kernel_certificate_range_is_valid(start: i64, count: i64, capacity: i64) -> bool:
    requires start >= 0 and count >= 0 and capacity >= 0
    requires start <= capacity and count <= capacity - start
    requires start <= 16 and count <= 16 and capacity <= 32
    ensure result == true
    return start + count <= capacity


def kernel_certificate_rules() -> void:
    proof 1 + 1 == 2:
        assert 1 + 1 == 2
