module UnsignedDivisionBounds:
    public:
        def quotient_below_dividend(value: u32, divisor: u32) -> u32:
            requires divisor >= 1
            ensure result <= value
            return value / divisor

        def quotient_by_positive_literal_below_dividend(value: u16) -> u16:
            ensure result <= value
            return value / 7

        def high_bit_u64_quotient_below_dividend(value: u64, divisor: u64) -> u64:
            requires divisor > 0
            ensure result <= value
            return value / divisor

        def zero_divisor_not_assumed_positive(value: u32, divisor: u32) -> u32:
            ensure result <= value
            return value / divisor

        # A positive divisor of a different width cannot borrow the dividend's width witness.
        def mismatched_divisor_width_not_inferred(value: u32, divisor: u16) -> u32:
            requires divisor >= 1
            ensure result <= value
            return value / divisor

        # The quotient bound does not establish that a later addition avoids unsigned wrap.
        def quotient_plus_dividend_does_not_wrap(value: u32, divisor: u32) -> u32:
            requires divisor >= 1
            ensure result + value >= value
            return value / divisor

        # The theorem is specifically about this quotient's dividend, not an unrelated ceiling.
        def quotient_below_unrelated_ceiling_is_not_inferred(value: u32, divisor: u32, ceiling: u16) -> u32:
            requires divisor >= 1
            ensure result <= ceiling
            return value / divisor
