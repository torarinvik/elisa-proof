# A method call's receiver is not among its arguments, so the frame records it by name as a place a
# call can reach. That made a collection this frame only ever *pushed to* count as escaping, and a
# loop entered afterwards forgot it and lost its own `index < xs.count` range fact -- so a program
# that builds a list and then walks it, the commonest shape there is, could not index it.
#
# A collection builtin is the case the confinement rule already covers by another route. `xs.push(v)`
# writes `xs` during its own call and leaves nothing behind that a later call could reach, exactly
# as a confined lend does. It is still a write *during* the call: `aliased_names` is unchanged, so a
# `count` fact taken before it does not survive it, and a push inside a loop body still reaches the
# collection on every iteration. Only the escaping set -- read at loop entry -- drops the receiver.
#
# The arguments are untouched by this: a builtin is not a known function, so every named argument is
# still recorded as escaping, which is what keeps `sink.push(values)` from laundering a lend.

# Build a list, then walk it. The range fact survives the pushes.
def push_then_loop(count: usize) -> i64:
    items: mutable darray[i64] = []
    for index in 0..<count |index, count, items|:
        items.push(1)
    total: mutable i64 = 0
    for index in 0..<items.count |index, items, total|:
        total <- total + items[index]
    return total

# The other builtins that write their receiver in place carry the same reasoning.
def shrink_then_loop() -> i64:
    items: mutable darray[i64] = []
    items.push(1)
    items.push(2)
    items.push(3)
    items.pop()
    total: mutable i64 = 0
    for index in 0..<items.count |index, items, total|:
        total <- total + items[index]
    return total

# Two collections, each confined on its own account, walked one after the other.
def two_collections() -> i64:
    left: mutable darray[i64] = []
    right: mutable darray[i64] = []
    left.push(1)
    right.push(2)
    total: mutable i64 = 0
    for index in 0..<left.count |index, left, total|:
        total <- total + left[index]
    for index in 0..<right.count |index, right, total|:
        total <- total + right[index]
    return total
