# Mutually recursive functions may share one structural enum ranking.
enum Nat:
    Zero
    Succ(prev: Nat)

def structural_even(n: Nat) -> i64:
    decreases n
    match n:
        Nat.Zero:
            return 0
        Nat.Succ(prev):
            return structural_odd(prev)

def structural_odd(n: Nat) -> i64:
    decreases n
    match n:
        Nat.Zero:
            return 1
        Nat.Succ(prev):
            return structural_even(prev)
