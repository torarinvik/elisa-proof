# A by-value struct is still an alias when one of its fields is a reference. A call can
# mutate the referenced global through another path, so the nested count fact must not
# survive merely because the outer Holder binding itself is passed by value.
struct Holder:
    values: darray[i64]&

global mutable ambient_values: darray[i64] = []

def clear_ambient_values() -> void:
    ambient_values.resize(0)

def nested_shared_extent_must_not_survive(holder: Holder, index: usize) -> i64:
    requires index < holder.values.count
    clear_ambient_values()
    return holder.values[index]

def caller(index: usize) -> i64:
    ambient_values.resize(1)
    return nested_shared_extent_must_not_survive(Holder{values: ambient_values}, index)
