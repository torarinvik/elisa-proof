# An inferred first assignment also preserves the source-local identity of a value aggregate.
struct ResourceProjectionE144InferredLeaf:
    left: usize
    right: usize

struct ResourceProjectionE144InferredNode:
    leaf: ResourceProjectionE144InferredLeaf

def resource_projection_e144_inferred_sum(left: usize, right: usize) -> usize:
    return left + right

def resource_projection_e144_inferred_copy(nodes: darray[ResourceProjectionE144InferredNode]&, index: usize) -> usize:
    requires index < nodes.count
    copied = nodes[index]
    return resource_projection_e144_inferred_sum(copied.leaf.left, copied.leaf.right)
