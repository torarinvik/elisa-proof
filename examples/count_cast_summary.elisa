def terminated(bytes: darray[u8]&, maximum: i64) -> bool:
    requires maximum > 0
    ensure result implies bytes.count > 1 and bytes.count.i64() <= maximum
    return false if bytes.count <= 1 or bytes.count.i64() > maximum
    true

def missing_upper_guard(bytes: darray[u8]&, maximum: i64) -> bool:
    requires maximum > 0
    ensure result implies bytes.count > 1 and bytes.count.i64() <= maximum
    return false if bytes.count <= 1
    true

def cast_value_is_not_its_receiver(bytes: darray[u8]&) -> bool:
    ensure result implies bytes.count.i64() == bytes.count
    true

def cast_range_is_not_its_receiver_range(bytes: darray[u8]&) -> bool:
    ensure result implies bytes.count.i64() < 100
    true
