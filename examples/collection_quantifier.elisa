# Finite literal collections can be instantiated without a heap model.

def finite_array_forall() -> i64:
    ensure forall value in [1, 2, 3]: value > 0
    return 0

def finite_tuple_exists() -> i64:
    ensure exists value in (0, 7): value == 7
    return 0

def finite_set_forall() -> i64:
    ensure forall value in {1, 2, 3}: value >= 1
    return 0

def finite_dictionary_forall() -> i64:
    ensure forall (key, value) in {1: 1, 2: 2}: value > 0
    return 0
