# Work-budget boundary regression, not representative contract style. These tautological
# preconditions deliberately create two nearby per-function workloads. Keep their exact counts:
# the 12-copy case proves and replays, while the 20-copy case is refused at the model-work budget.
module ModelBudgetConstants:
    const C: i64 = 1

def bounded_model_under_work_budget(x: i64) -> i64:
    requires x >= -2
    requires x <= 2
    requires ModelBudgetConstants::C == ModelBudgetConstants::C
    requires ModelBudgetConstants::C == ModelBudgetConstants::C
    requires ModelBudgetConstants::C == ModelBudgetConstants::C
    requires ModelBudgetConstants::C == ModelBudgetConstants::C
    requires ModelBudgetConstants::C == ModelBudgetConstants::C
    requires ModelBudgetConstants::C == ModelBudgetConstants::C
    requires ModelBudgetConstants::C == ModelBudgetConstants::C
    requires ModelBudgetConstants::C == ModelBudgetConstants::C
    requires ModelBudgetConstants::C == ModelBudgetConstants::C
    requires ModelBudgetConstants::C == ModelBudgetConstants::C
    requires ModelBudgetConstants::C == ModelBudgetConstants::C
    requires ModelBudgetConstants::C == ModelBudgetConstants::C
    ensure result >= 0
    return x * x

def bounded_model_over_work_budget(x: i64) -> i64:
    requires x >= -2
    requires x <= 2
    requires ModelBudgetConstants::C == ModelBudgetConstants::C
    requires ModelBudgetConstants::C == ModelBudgetConstants::C
    requires ModelBudgetConstants::C == ModelBudgetConstants::C
    requires ModelBudgetConstants::C == ModelBudgetConstants::C
    requires ModelBudgetConstants::C == ModelBudgetConstants::C
    requires ModelBudgetConstants::C == ModelBudgetConstants::C
    requires ModelBudgetConstants::C == ModelBudgetConstants::C
    requires ModelBudgetConstants::C == ModelBudgetConstants::C
    requires ModelBudgetConstants::C == ModelBudgetConstants::C
    requires ModelBudgetConstants::C == ModelBudgetConstants::C
    requires ModelBudgetConstants::C == ModelBudgetConstants::C
    requires ModelBudgetConstants::C == ModelBudgetConstants::C
    requires ModelBudgetConstants::C == ModelBudgetConstants::C
    requires ModelBudgetConstants::C == ModelBudgetConstants::C
    requires ModelBudgetConstants::C == ModelBudgetConstants::C
    requires ModelBudgetConstants::C == ModelBudgetConstants::C
    requires ModelBudgetConstants::C == ModelBudgetConstants::C
    requires ModelBudgetConstants::C == ModelBudgetConstants::C
    requires ModelBudgetConstants::C == ModelBudgetConstants::C
    requires ModelBudgetConstants::C == ModelBudgetConstants::C
    ensure result >= 0
    return x * x
