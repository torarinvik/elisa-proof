# Built-in storage identity is independent of scalar-leaf traversal budgets.
struct Store:
    buffer0: i64[4]
    buffer1: i64[4]
    buffer2: i64[4]
    buffer3: i64[4]
    buffer4: i64[4]
    buffer5: i64[4]
    buffer6: i64[4]
    buffer7: i64[4]
    flags: mutable bool[3]
def checked(store: mutable Store&, index: usize) -> void:
    return if index >= 3
    store.flags[index] <- true
