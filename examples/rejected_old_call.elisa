# Pre-state expressions are not exported through an executable summary yet.

def increment(x: mutable i64) -> i64:
    requires x >= 0
    ensure result == old(x) + 1
    x <- x + 1
    return x

def caller(x: mutable i64) -> i64:
    requires x >= 0
    ensure result == x + 1
    return increment(x)
