# A single enum-typed parameter gets an implicit structural ranking. Every recursive call
# must still pass a binder from the matched strict subterm.
enum Nat:
    Zero
    Succ(prev: Nat)

def implicit_structural_size(n: Nat) -> i64:
    match n:
        Nat.Zero:
            return 0
        Nat.Succ(prev):
            return implicit_structural_size(prev)
