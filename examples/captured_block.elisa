# `for x in xs |a, b|:` reaches the statement walker as an expression statement holding a block
# with a capture list, not as an ordinary `for`. The shape gate refuses such a block on purpose: a
# captured block writes back into its outer bindings, and accepting it as a pure expression would
# let an outer fact survive a hidden mutation.
#
# In *statement* position the block's result is discarded, so the write-back can be modelled
# instead of refused — check the body in a private state, then havoc the outer symbolic values and
# facts exactly as an opaque call boundary does. Refusing instead invalidated the whole enclosing
# path, which cost every obligation after the loop, the function's own summary, and — worst — it
# skipped the loop body entirely, so obligations inside it were never checked at all.
def obligations_after_the_loop_are_checked(values: darray[i64]&) -> i64:
    total: mutable i64 = 0
    for value in values |value, total|:
        total <- total + value
    index: usize = 0
    return values[index] if index < values.count
    return 0

def obligations_inside_the_loop_are_checked(values: darray[i64]&) -> i64:
    total: mutable i64 = 0
    for index in 0..<values.count |index, total, values|:
        total <- total + values[index]
    return total

# The path stays valid, so the function still establishes its postcondition from facts it
# re-establishes after the loop.
def postcondition_after_the_loop(values: darray[i64]&) -> i64:
    total: mutable i64 = 0
    for value in values |value, total|:
        total <- total + value
    settled: i64 = 3
    return settled
