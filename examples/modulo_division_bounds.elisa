# Fixed-width interval rules prove bounded remainder and quotient results.

def remainder_bounds(x: i64) -> i64:
    ensure result >= -1
    ensure result <= 1
    return x % 2

def quotient_bounds(x: i64) -> i64:
    requires x >= -10
    requires x <= 10
    ensure result >= -5
    ensure result <= 5
    return x / 2
