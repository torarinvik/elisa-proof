struct LocalRecordFieldRejectedStore:
    first: mutable heap void&?
struct LocalRecordFieldRejectedValue:
    value: mutable u8

def local_record_field_reject_stale_value() -> u8:
    ensure result == 1
    cursor: mutable LocalRecordFieldRejectedValue = LocalRecordFieldRejectedValue{value: 1}
    cursor.value <- 2
    return cursor.value

def local_record_field_reject_reference_alias(store: mutable LocalRecordFieldRejectedStore&) -> u8:
    requires store.first != null
    ensure store.first != null
    cursor: mutable LocalRecordFieldRejectedStore& = store
    cursor.first <- null
    return 0

def local_record_field_reject_shadow(store: mutable LocalRecordFieldRejectedStore&, enter: bool) -> u8:
    requires store.first != null
    ensure store.first != null
    cursor: mutable LocalRecordFieldRejectedValue = LocalRecordFieldRejectedValue{value: 1}
    if enter:
        cursor: mutable LocalRecordFieldRejectedStore& = store
        cursor.first <- null
    return 0
