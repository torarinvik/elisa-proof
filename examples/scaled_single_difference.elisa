# A comparison whose names cancel down to one name with a coefficient of two or
# more, `origin - (origin + cap) <= cap` reading as `-2 * cap <= 0`, is decided
# over the integers as a unit bound on that name with floor and ceiling quotients.
module Steps:
    public:
        def step_up(origin: i64, cap: i64) -> i64:
            requires cap >= 0
            requires cap <= 1000000000
            requires origin >= -1000000000
            requires origin <= 1000000000
            ensure origin - result <= cap
            return origin + cap

        def step_down(origin: i64, cap: i64) -> i64:
            requires cap >= 0
            requires cap <= 1000000000
            requires origin >= -1000000000
            requires origin <= 1000000000
            ensure result - origin >= -cap
            return origin - cap

        def odd_gap(value: i64) -> i64:
            requires value >= 1
            requires value <= 1000
            ensure value + value + value > 2
            ensure 3 * 0 + value + value < value + value + value
            return value

        def doubled_balance(value: i64) -> i64:
            requires value >= 0
            requires value <= 1000
            requires value + value == 6
            ensure value == 3
            return value
