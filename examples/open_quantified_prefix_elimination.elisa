# Requirements for bounded forall-premise elimination, not admitted axioms.
def prefix_implies_completed_row(lengths: array[usize, 8]&, cursor: i64) -> usize:
    requires cursor >= 4 and cursor <= 8
    requires forall index in 0..<8: index >= cursor or lengths[index] == 64
    ensure lengths[3] == 64
    return lengths[3]

def whole_implies_fixed_row(lengths: array[usize, 8]&) -> usize:
    requires forall index in 0..<8: lengths[index] == 64
    ensure result == 64
    return lengths[3]
