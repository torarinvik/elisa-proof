# Elisa Proof command-line facade. Compiler imports and proof modules stay at the boundary;
# application I/O, rendering, repair, and CLI orchestration live in focused source modules.
include "../../Elisa-compiler/elisacore_std/elisacore_runtime_prelude.elisa"
include "../../Elisa-compiler/elisacore_std/collections.elisa"
include "../../Elisa-compiler/elisacore_std/elisacore_runtime_strings.elisa"
include "../../Elisa-compiler/src/semantic/semantic.elisa"
include "../../Elisa-compiler/elisacore_std/elisacore_json.elisa"
using Json

include "../src/app/json_boundary.elisa"

include "../src/proof/kernel_core.elisa"
include "../src/proof/operator_impl_model.elisa"
include "../src/proof/model/enum_index.elisa"
include "../src/proof/model/findings.elisa"
include "../src/proof/model.elisa"
include "../src/proof/model/lemma_table.elisa"
include "../src/proof/model/report_invariants.elisa"
include "../src/proof/certificate_admission.elisa"
include "../src/proof/kernel.elisa"
include "../src/proof/kernel_intern.elisa"
include "../src/proof/expr.elisa"
include "../src/proof/linear.elisa"
include "../src/proof/resources.elisa"
include "../src/proof/kernel_replay.elisa"
include "../src/proof/check.elisa"
include "../src/proof/replay.elisa"

include "../src/proof/tactics.elisa"

using Ast
using Semantic
using ElisaProof

extend ElisaProof:
    public:
        def recording_control(source: u8&, expected_count: usize, expected_proven: usize, mode: u8) -> bool can[Memory.Allocate, Abort.Panic]:
            tokens: darray[Lexer::Token] = frontend_tokenize(source, source)
            file: Ast::File = frontend_parser_parse_file(source, tokens)
            return false if file.errors.count != 0
            report: mutable ProofReport = proof_empty_report()
            return false if not proof_record_direct_frame_events(&report, &file.top_decls, "run", 4, &tokens, source, tokens[tokens.count - 1].start.usize())
            return false if report.goal_attempts.count != expected_count or report.obligation_inventory.count != expected_count or report.certificates.count != expected_proven
            return false if report.proven.usize() != expected_proven or report.findings.count != expected_count - expected_proven
            for index in 0..<expected_count |index, report|:
                entry = report.obligation_inventory[index]
                return false if entry.attempts_start != index or entry.attempts_count != 1 or entry.source_obligation_index != index or entry.source_name != "run" or entry.source_line != 4
                attempt = report.goal_attempts[index]
                return false if attempt.proven != entry.proven or attempt.has_certificate != entry.proven
                return false if attempt.facts_count != 0 or attempt.kernel_facts_count != 0
                if entry.proven:
                    return false if attempt.certificate_index >= report.certificates.count or report.certificates[attempt.certificate_index].replayed
            if expected_count != expected_proven:
                return false if not report.findings[0].has_goal or report.findings[0].goal_id != expected_count - 1
            report.obligation_inventory[0].source_obligation_index <- 99 if mode == 1
            report.obligation_inventory[0].source_name <- "wrong" if mode == 2
            report.goal_attempts[0] <- report.goal_attempts[1] if mode == 3
            report.certificates[0] <- report.certificates[1] if mode == 4
            report.obligation_inventory.resize(expected_count - 1) if mode == 5
            report.goal_attempts.push(report.goal_attempts[0]) if mode == 6
            report.certificates.push(report.certificates[0]) if mode == 7
            matches: bool = proof_direct_frame_report_matches_source(&report, &file.top_decls, "run", 4, &tokens, source, tokens[tokens.count - 1].start.usize())
            return matches == (mode == 0)

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    return 1 if not ElisaProof::recording_control("struct Box:\n    value: mutable i64\n    other: mutable i64\ndef run(box: mutable Box&) -> void changes box.value preserves box.other:\n    box.value <- 1\n", 4, 4, 0)
    return 2 if not ElisaProof::recording_control("struct Box:\n    value: mutable i64\n    other: mutable i64\ndef run(box: mutable Box&) -> void changes box.value preserves box.other, box.value:\n    box.value <- 1\n", 6, 5, 0)
    for mode in 1u8..<8u8 |mode|:
        return 3 if not ElisaProof::recording_control("struct Box:\n    value: mutable i64\n    other: mutable i64\ndef run(box: mutable Box&) -> void changes box.value preserves box.other:\n    box.value <- 1\n", 4, 4, mode)
    return 0
