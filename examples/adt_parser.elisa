# A recursive-descent parser over a token stream, returning named tuples. Every recursive
# function carries `decreases` over the stream it matches and recurses on a binder from that
# match, which is the totality evidence. Each ensure reads a label of the result, `result.value`
# or `result.consumed`, and is proved by induction with the recursive call's labeled summary.
# Counters saturate at ADT_CAP so that no step overflows.

enum Token:
    End
    Number(value: u8, rest: Token)
    Plus(rest: Token)

const ADT_CAP: i64 = 1000000

# One number literal, or nothing.
def parse_number(tokens: Token) -> (value: i64, consumed: i64):
    ensure result.consumed >= 0
    ensure result.consumed <= 1
    ensure result.value >= 0
    ensure result.value <= 255
    match tokens:
        Token.Number(value, _):
            return (value.i64(), 1)
        _:
            return (0, 0)

# The sum of every literal in the stream, and how many tokens that read.
def parse_sum(tokens: Token) -> (value: i64, consumed: i64):
    decreases tokens
    ensure result.consumed >= 0
    ensure result.consumed <= ADT_CAP
    ensure result.value >= 0
    ensure result.value <= ADT_CAP
    match tokens:
        Token.End:
            return (0, 0)
        Token.Number(value, rest):
            later: (value: i64, consumed: i64) = parse_sum(rest)
            if later.value < ADT_CAP - 255 and later.consumed < ADT_CAP:
                return (later.value + value.i64(), later.consumed + 1)
            return (later.value, later.consumed)
        Token.Plus(rest):
            skipped: (value: i64, consumed: i64) = parse_sum(rest)
            if skipped.consumed < ADT_CAP:
                return (skipped.value, skipped.consumed + 1)
            return skipped

# A label read straight off a call result.
def parsed_length(tokens: Token) -> i64:
    ensure result >= 0
    ensure result <= ADT_CAP
    return parse_sum(tokens).consumed
