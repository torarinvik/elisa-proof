# Elisa integer operations use fixed-width machine semantics. At the maximum i8 value,
# adding one wraps, so the mathematical-integer property below is false.
def signed_increment_is_strict(x: i8) -> i8:
    requires x == 127
    ensure x + 1 > x
    return x

# When the premises establish a representable result, retain the useful proof.
def signed_increment_is_strict_when_safe(x: i8) -> i8:
    requires x == 126
    ensure x + 1 > x
    return x
