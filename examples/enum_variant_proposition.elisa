# Source-bound enum-tag formation admits only a declared variant of the scrutinee type.
enum ProofOption:
    None
    Some(value: i64)

def variant_tag_is_proposition(option: ProofOption) -> bool:
    requires option is ProofOption.Some
    ensure result == true
    return true

def shorthand_payload_tag_is_proposition(option: ProofOption) -> bool:
    requires option is .Some
    ensure result == true
    return true
