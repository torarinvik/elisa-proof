# The bound for `nodes[index]` must not authenticate an access through a different container.
struct ResourceProjectionE144CrossNode:
    value: usize

def rejected_resource_projection_e144_cross_container(nodes: darray[ResourceProjectionE144CrossNode]&, other: darray[ResourceProjectionE144CrossNode]&, index: usize) -> usize:
    requires index < nodes.count
    copied: ResourceProjectionE144CrossNode = other[index]
    return copied.value
