# Without an upper bound on the call results the premise `l + r < 1000000` may be a wrapped
# sum, so it must not bound `l + r + 1` from above.
def unbounded_size(seed: i64) -> i64:
    ensure result >= 1
    return 1

def capped_pair(a: i64, b: i64) -> i64:
    ensure result <= 1000000
    l: i64 = unbounded_size(a)
    r: i64 = unbounded_size(b)
    return 1000000 if l + r >= 1000000
    return l + r + 1
