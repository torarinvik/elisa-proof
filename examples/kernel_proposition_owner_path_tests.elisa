# Owner-aware lookup must select complete module paths and reject duplicate or colliding paths.
const module OwnerPathTestStatus:
    public:
        INSERTION_FAILED: i64 = 1
        QUALIFIED_CALL_REFUSED: i64 = 2
        UNQUALIFIED_CONTEXT_REFUSED: i64 = 3
        IDENTITY_COLLISION_ACCEPTED: i64 = 4
        DUPLICATE_PATH_ACCEPTED: i64 = 5
        DISTINCT_OWNER_REFUSED: i64 = 6
        SORT_MISMATCH_ACCEPTED: i64 = 7
        EXTRA_SEGMENT_ACCEPTED: i64 = 8
        INCONSISTENT_COUNT_ACCEPTED: i64 = 9
        MALFORMED_CONTEXT_ACCEPTED: i64 = 10

def kernel_test_add_module_owner(bindings: mutable darray[ProofKernelTypingBinding]&, segments: darray[sview]&, identity: usize) -> bool:
    for index in 0..<segments.count |index, bindings, segments, identity|:
        bindings.push(ProofKernelTypingBinding{kind: "module-owner-segment", name: segments[index], owner: "", sort: "", type_name: "", element_sort: "", element_type_name: "", type_identity: 0, owner_type_identity: identity, element_type_identity: 0, signature_identity: 0, parameter_index: index, parameter_count: segments.count, parameter_has_default: false, parameter_by_reference: false})
    return true

def kernel_test_owner_path_identity_cases() -> i64 can[Memory.Allocate, Abort.Panic]:
    module_a: darray[sview] = ["ModuleA"]
    module_b: darray[sview] = ["ModuleB"]
    owner_a: usize = 91001
    owner_b: usize = 91002

    nodes: mutable darray[ProofKernelNode] = []
    children: mutable darray[usize] = []
    module_root: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "ModuleA", "")
    qualified_callee: usize = add_node(&nodes, "scope", "", module_root, 0, 0, 0, 0, 0, "valid", "")
    qualified_call: usize = add_node(&nodes, "call", "", qualified_callee, 0, 0, 0, 0, 0, "", "")
    bindings: mutable darray[ProofKernelTypingBinding] = []
    path_a_added: bool = kernel_test_add_module_owner(&bindings, module_a, owner_a)
    path_b_added: bool = kernel_test_add_module_owner(&bindings, module_b, owner_b)
    signature_a_added: bool = proof_kernel_add_owned_function_signature(&bindings, "valid", "", owner_a, "boolean", "bool", "", "", 0, 0, 9101, 0)
    signature_b_added: bool = proof_kernel_add_owned_function_signature(&bindings, "valid", "", owner_b, "boolean", "bool", "", "", 0, 0, 9102, 0)
    return OwnerPathTestStatus::INSERTION_FAILED if not path_a_added or not path_b_added or not signature_a_added or not signature_b_added
    environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: bindings}
    return OwnerPathTestStatus::QUALIFIED_CALL_REFUSED if not proof_kernel_replay_proposition_formation_report(&nodes, &children, environment, [], qualified_call)
    module_b_nodes: mutable darray[ProofKernelNode] = []
    module_b_children: mutable darray[usize] = []
    module_b_root: usize = add_node(&module_b_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "ModuleB", "")
    module_b_callee: usize = add_node(&module_b_nodes, "scope", "", module_b_root, 0, 0, 0, 0, 0, "valid", "")
    module_b_call: usize = add_node(&module_b_nodes, "call", "", module_b_callee, 0, 0, 0, 0, 0, "", "")
    return OwnerPathTestStatus::QUALIFIED_CALL_REFUSED if not proof_kernel_replay_proposition_formation_report(&module_b_nodes, &module_b_children, environment, [], module_b_call)

    # A lexical context resolves an unqualified call only in its exact declared module.
    unqualified: mutable darray[ProofKernelNode] = []
    unqualified_callee: usize = add_node(&unqualified, "ident", "", 0, 0, 0, 0, 0, 0, "valid", "")
    unqualified_call: usize = add_node(&unqualified, "call", "", unqualified_callee, 0, 0, 0, 0, 0, "", "")
    local_bindings: mutable darray[ProofKernelTypingBinding] = []
    local_bindings.push(ProofKernelTypingBinding{kind: "module-context", name: "", owner: "", sort: "", type_name: "", element_sort: "", element_type_name: "", type_identity: 0, owner_type_identity: owner_a, element_type_identity: 0, signature_identity: 0, parameter_index: 0, parameter_count: 0, parameter_has_default: false, parameter_by_reference: false})
    local_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: bindings, bindings: local_bindings}
    return OwnerPathTestStatus::UNQUALIFIED_CONTEXT_REFUSED if not proof_kernel_replay_proposition_formation_report(&unqualified, &children, local_environment, [], unqualified_call)

    # Two different exact paths forced to the same numeric identity must refuse lookup.
    collision_bindings: mutable darray[ProofKernelTypingBinding] = []
    collision_identity: usize = 9191
    collision_a: bool = kernel_test_add_module_owner(&collision_bindings, module_a, collision_identity)
    collision_b: bool = kernel_test_add_module_owner(&collision_bindings, module_b, collision_identity)
    collision_signature: bool = proof_kernel_add_owned_function_signature(&collision_bindings, "valid", "", collision_identity, "boolean", "bool", "", "", 0, 0, 9103, 0)
    collision_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: collision_bindings}
    return OwnerPathTestStatus::IDENTITY_COLLISION_ACCEPTED if not collision_a or not collision_b or not collision_signature or proof_kernel_replay_proposition_formation_report(&nodes, &children, collision_environment, [], qualified_call)

    # Duplicate records for the same path are treated as malformed and ambiguous.
    duplicate_bindings: mutable darray[ProofKernelTypingBinding] = []
    duplicate_a: bool = kernel_test_add_module_owner(&duplicate_bindings, module_a, owner_a)
    duplicate_again: bool = kernel_test_add_module_owner(&duplicate_bindings, module_a, owner_a)
    duplicate_signature: bool = proof_kernel_add_owned_function_signature(&duplicate_bindings, "valid", "", owner_a, "boolean", "bool", "", "", 0, 0, 9104, 0)
    duplicate_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: duplicate_bindings}
    return OwnerPathTestStatus::DUPLICATE_PATH_ACCEPTED if not duplicate_a or not duplicate_again or not duplicate_signature or proof_kernel_replay_proposition_formation_report(&nodes, &children, duplicate_environment, [], qualified_call)

    extra_bindings: mutable darray[ProofKernelTypingBinding] = []
    extra_path: bool = kernel_test_add_module_owner(&extra_bindings, module_a, owner_a)
    extra_signature: bool = proof_kernel_add_owned_function_signature(&extra_bindings, "valid", "", owner_a, "boolean", "bool", "", "", 0, 0, 9105, 0)
    extra_bindings.push(ProofKernelTypingBinding{kind: "module-owner-segment", name: "Unexpected", owner: "", sort: "", type_name: "", element_sort: "", element_type_name: "", type_identity: 0, owner_type_identity: owner_a, element_type_identity: 0, signature_identity: 0, parameter_index: 1, parameter_count: 1, parameter_has_default: false, parameter_by_reference: false})
    extra_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: extra_bindings}
    return OwnerPathTestStatus::EXTRA_SEGMENT_ACCEPTED if not extra_path or not extra_signature or proof_kernel_replay_proposition_formation_report(&nodes, &children, extra_environment, [], qualified_call)
    malformed_context_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: extra_bindings, bindings: local_bindings}
    return OwnerPathTestStatus::MALFORMED_CONTEXT_ACCEPTED if proof_kernel_replay_proposition_formation_report(&unqualified, &children, malformed_context_environment, [], unqualified_call)

    inconsistent_bindings: mutable darray[ProofKernelTypingBinding] = []
    inconsistent_bindings.push(ProofKernelTypingBinding{kind: "module-owner-segment", name: "ModuleA", owner: "", sort: "", type_name: "", element_sort: "", element_type_name: "", type_identity: 0, owner_type_identity: owner_a, element_type_identity: 0, signature_identity: 0, parameter_index: 0, parameter_count: 2, parameter_has_default: false, parameter_by_reference: false})
    inconsistent_signature: bool = proof_kernel_add_owned_function_signature(&inconsistent_bindings, "valid", "", owner_a, "boolean", "bool", "", "", 0, 0, 9106, 0)
    inconsistent_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: inconsistent_bindings}
    return OwnerPathTestStatus::INCONSISTENT_COUNT_ACCEPTED if not inconsistent_signature or proof_kernel_replay_proposition_formation_report(&nodes, &children, inconsistent_environment, [], qualified_call)
    return 0

def kernel_test_nested_owner_sort_cases() -> i64 can[Memory.Allocate, Abort.Panic]:
    path_a: darray[sview] = ["PolicyA", "Limit"]
    path_b: darray[sview] = ["PolicyB", "Limit"]
    owner_a: usize = 92001
    owner_b: usize = 92002
    nodes: mutable darray[ProofKernelNode] = []
    children: mutable darray[usize] = []
    a_root: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "PolicyA", "")
    a_limit: usize = add_node(&nodes, "scope", "", a_root, 0, 0, 0, 0, 0, "Limit", "")
    a_value: usize = add_node(&nodes, "scope", "", a_limit, 0, 0, 0, 0, 0, "PATH_BYTES", "")
    integer: usize = add_node(&nodes, "int", "", 0, 0, 0, 0, 0, 4096, "", "")
    equality_good: usize = add_node(&nodes, "binary", "==", a_value, integer, 0, 0, 0, 0, "", "")
    bindings: mutable darray[ProofKernelTypingBinding] = []
    a_path_added: bool = kernel_test_add_module_owner(&bindings, path_a, owner_a)
    b_path_added: bool = kernel_test_add_module_owner(&bindings, path_b, owner_b)
    a_value_added: bool = proof_kernel_add_typing_binding_with_identity(&bindings, "value", "PATH_BYTES", "Limit", "integer", "i64", "", "", 0, owner_a, 0)
    b_value_added: bool = proof_kernel_add_typing_binding_with_identity(&bindings, "value", "PATH_BYTES", "Limit", "integer", "usize", "", "", 0, owner_b, 0)
    environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: bindings}
    return OwnerPathTestStatus::DISTINCT_OWNER_REFUSED if not a_path_added or not b_path_added or not a_value_added or not b_value_added or not proof_kernel_replay_proposition_formation_report(&nodes, &children, environment, [], equality_good)

    bool_value: usize = add_node(&nodes, "bool", "", 0, 0, 0, 0, 0, 1, "", "")
    equality_bad_sort: usize = add_node(&nodes, "binary", "==", a_value, bool_value, 0, 0, 0, 0, "", "")
    return OwnerPathTestStatus::SORT_MISMATCH_ACCEPTED if proof_kernel_replay_proposition_formation_report(&nodes, &children, environment, [], equality_bad_sort)
    return 0

def kernel_owner_path_source_identity_tests() -> i64 can[Memory.Allocate, Abort.Panic]:
    function_status: i64 = kernel_test_owner_path_identity_cases()
    return function_status if function_status != 0
    return kernel_test_nested_owner_sort_cases()
