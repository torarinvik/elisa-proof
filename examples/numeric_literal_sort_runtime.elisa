# Reduced metadata inputs: not parser correspondence or typed-kernel admission.
include "../build/snapshot/Elisa-compiler/elisacore_std/elisacore_runtime.elisa"
module Ast:
    public:
        struct EnumAnnotation:
            owner: sview
            name: sview
            line: u32
module ElisaProof:
    public:
        const NUMERIC_LITERAL_UNIT_MARKER: u8 = 0
include "../src/proof/replay/numeric_literal_sort.elisa"
extend ElisaProof:
    public:
        def test_numeric_literal_sort() -> i64:
            sorts: darray[sview] = ["u8", "i8", "u16", "i16", "u32", "i32", "u64", "i64"]
            maxima: darray[sview] = ["255", "127", "65535", "32767", "4294967295", "2147483647", "18446744073709551615", "9223372036854775807"]
            overflow: darray[sview] = ["256", "128", "65536", "32768", "4294967296", "2147483648", "18446744073709551616", "9223372036854775808"]
            maximum_bits: darray[u64] = [255, 127, 65535, 32767, 4294967295, 2147483647, 18446744073709551615u64, 9223372036854775807u64]
            widths: darray[i64] = [8, 8, 16, 16, 32, 32, 64, 64]
            hexadecimal: darray[sview] = ["0xff", "0x7f", "0xffff", "0x7fff", "0xffffffff", "0x7fffffff", "0xffffffffffffffff", "0x7fffffffffffffff"]
            hexadecimal_overflow: darray[sview] = ["0x100", "0x80", "0x10000", "0x8000", "0x100000000", "0x80000000", "0x10000000000000000", "0x8000000000000000"]
            for index in 0..<sorts.count |index, sorts, maxima, overflow|:
                valid = proof_decode_numeric_literal_sort(maxima[index], sorts[index])
                return 1 if not valid.known
                return 2 if valid.unsigned != (index % 2 == 0)
                return 3 if proof_decode_numeric_literal_sort(overflow[index], sorts[index]).known
            for index in 0..<sorts.count |index, sorts, maxima, maximum_bits, widths, hexadecimal, hexadecimal_overflow|:
                decimal = proof_decode_numeric_literal_sort(maxima[index], sorts[index])
                hex_value = proof_decode_numeric_literal_sort(hexadecimal[index], sorts[index])
                return 15 if decimal.bits != maximum_bits[index] or decimal.width != widths[index]
                return 16 if not hex_value.known or hex_value.bits != decimal.bits or hex_value.width != decimal.width or hex_value.unsigned != decimal.unsigned
                return 17 if proof_decode_numeric_literal_sort(hexadecimal_overflow[index], sorts[index]).known
                zero = proof_decode_numeric_literal_sort("0", sorts[index])
                return 18 if not zero.known or zero.bits != 0 or zero.width != widths[index]
            high_bit = proof_decode_numeric_literal_sort("9223372036854775808", "u64")
            return 19 if not high_bit.known or high_bit.bits != 9223372036854775808u64 or not high_bit.unsigned
            maximum = proof_decode_numeric_literal_sort("0xffff_ffff_ffff_ffff", "u64")
            return 4 if not maximum.known or maximum.bits != 18446744073709551615u64 or maximum.width != 64
            malformed: darray[sview] = ["", "-1", "+1", "1u64", "0x", "0xG", "0x10000000000000000", "_0", " 0", "1.0"]
            for text in malformed:
                return 5 if proof_decode_numeric_literal_sort(text, "u64").known
            return 6 if proof_decode_numeric_literal_sort("1", "usize").known or proof_decode_numeric_literal_sort("1", "Box::u64").known
            rows: mutable darray[Ast::EnumAnnotation] = [
                Ast::EnumAnnotation{owner: "__numeric_literal_sort", name: "u64", line: 2},
                Ast::EnumAnnotation{owner: "__numeric_literal_sort_column", name: "u64", line: 12},
                Ast::EnumAnnotation{owner: "__numeric_literal_sort_text", name: "18446744073709551615", line: 2},
                Ast::EnumAnnotation{owner: "__numeric_literal_sort", name: "i64", line: 2},
                Ast::EnumAnnotation{owner: "__numeric_literal_sort_column", name: "i64", line: 20},
                Ast::EnumAnnotation{owner: "__numeric_literal_sort_text", name: "0", line: 2}]
            first = proof_replay_numeric_literal_sort(&rows, 2, 12, -1)
            second = proof_replay_numeric_literal_sort(&rows, 2, 20, 0)
            return 7 if not first.known or not first.unsigned or first.bits != 18446744073709551615u64
            return 8 if not second.known or second.unsigned or second.width != 64
            return 9 if proof_replay_numeric_literal_sort(&rows, 2, 13, -1).known or proof_replay_numeric_literal_sort(&rows, 3, 12, -1).known
            return 10 if proof_replay_numeric_literal_sort(&rows, 2, 12, 0).known
            rows.push(rows[0])
            rows.push(rows[1])
            rows.push(rows[2])
            return 11 if proof_replay_numeric_literal_sort(&rows, 2, 12, -1).known
            rows.resize(6)
            rows[1] <- Ast::EnumAnnotation{owner: "__numeric_literal_sort_column", name: "i64", line: 12}
            return 12 if proof_replay_numeric_literal_sort(&rows, 2, 12, -1).known
            rows[1] <- Ast::EnumAnnotation{owner: "__numeric_literal_sort_column", name: "u64", line: 12}
            rows[2] <- Ast::EnumAnnotation{owner: "__numeric_literal_sort_text", name: "18446744073709551616", line: 2}
            return 13 if proof_replay_numeric_literal_sort(&rows, 2, 12, -1).known
            rows.resize(1)
            return 14 if proof_replay_numeric_literal_sort(&rows, 2, 12, -1).known
            return 0
def main() -> i64:
    return ElisaProof::test_numeric_literal_sort()
