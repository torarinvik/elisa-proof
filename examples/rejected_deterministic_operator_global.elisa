# A user-defined operator can hide a mutable-global read from a caller's syntactic call graph.
# Calls to `observes` must therefore not be treated as deterministic merely because their body
# contains no explicit Call node.
global mutable operator_mode: i64 = 0
global mutable guard_index: i64 = 0

protocol Eq:
    def __eq__(self: Self, other: Self) -> bool

impl Eq for i64:
    def __eq__(self: i64, other: i64) -> bool:
        guard_index <- 100
        return operator_mode < 1

def observes(value: i64) -> bool:
    ensure true
    return value == 0

def rejected_unverified_nested_call() -> bool:
    ensure not result
    return observes(5)

def operator_result_changes() -> bool:
    ensure not result
    first: bool = observes(5)
    operator_mode <- 1
    second: bool = observes(5)
    return first != second

def hidden_index_mutator(left: i64, right: i64) -> bool:
    ensure true
    return left == right

def rejected_shortcircuit_index(values: darray[i64]) -> i64:
    if guard_index >= 0 and guard_index < values.count and hidden_index_mutator(1, 1):
        return values[guard_index]
    return 0

def rejected_direct_overload_index(values: darray[i64]) -> i64:
    if guard_index >= 0 and guard_index < values.count and guard_index == 0:
        return values[guard_index]
    return 0

def rejected_nested_shortcircuit_operator_index(values: darray[i64]) -> bool:
    return guard_index >= 0 and guard_index < values.count and (guard_index == 0 and values[guard_index] >= 0)

def rejected_operator_assert_index(values: darray[i64]) -> i64:
    if guard_index >= 0 and guard_index < values.count:
        assert guard_index == guard_index
        return values[guard_index]
    return 0

enum OperatorGate:
    Closed
    Open

def rejected_operator_match_guard_index(values: darray[i64], gate: OperatorGate) -> i64:
    ensure result == 0
    match gate:
        OperatorGate.Open if guard_index == 0:
            return guard_index
        _:
            return 0

def rejected_value_match_operator_guard(gate: OperatorGate) -> i64:
    ensure result == 0
    return match gate:
        OperatorGate.Open if guard_index == 0:
            guard_index
        _:
            0

def rejected_value_match_operator_scrutinee() -> i64:
    ensure result == 0
    return match (guard_index == 0).i64():
        1:
            guard_index
        _:
            0

def rejected_operator_loop_index(values: darray[i64]) -> void:
    while guard_index >= 0 and guard_index < values.count and guard_index == 0:
        invariant true
        accessed: i64 = values[guard_index]
