# The boundary of the call-stable and branch-conjunct rules. A fact survives a call only while the
# callee provably cannot reach the place it is about, and a guard only entails the parts of an
# actual conjunction. Every goal here is unproven; each one would be admitted by a rule that
# dropped one of those conditions.
struct Node:
    kind: sview
    left: usize

def node_valid(nodes: darray[Node]&, root: usize) -> bool:
    return root < nodes.count

def overwrite(value: mutable usize&) -> void:
    value <- 200

# The scalar is handed to the callee by reference, so the callee can write it. Its bound is not
# call-stable however narrow the caller's own use of the name is.
def aliased_scalar(depth: usize) -> usize:
    requires depth <= 127
    ensure result <= 127
    local: mutable usize = depth
    overwrite(&local)
    return local

# A direct write inside a branch is not a call at all, and the join must not restore a fact the
# surviving path falsified.
def assigned_in_branch(nodes: darray[Node]&, root: usize, depth: usize) -> usize:
    requires depth <= 127
    ensure result <= 127
    local: mutable usize = depth
    if not node_valid(nodes, root):
        local <- 200
    return local

# A disjunction entails neither disjunct. On the taken arm of `depth <= 127 or valid(root)` all
# that is known is the disjunction itself, and taking its first half would be a fabrication.
def disjunctive_branch(nodes: darray[Node]&, root: usize, depth: usize) -> usize:
    requires depth <= 200
    ensure result <= 127
    if depth <= 127 or node_valid(nodes, root):
        return 0 if not node_valid(nodes, root)
        return depth
    return 0

# The negation of a conjunction is a disjunction, so the same refusal applies to the arm that
# skips a conjunctive guard.
def negated_conjunctive_guard(nodes: darray[Node]&, root: usize, depth: usize) -> usize:
    requires depth <= 200
    ensure result <= 127
    return 0 if depth < 127 and node_valid(nodes, root)
    return 0 if not node_valid(nodes, root)
    return depth

# A rebinding after the guard replaces the symbol the guard spoke about.
def rebound_after_guard(nodes: darray[Node]&, root: usize, depth: usize) -> usize:
    requires depth <= 200
    ensure result <= 127
    local: mutable usize = depth
    return 0 if local >= 127
    return 0 if not node_valid(nodes, root)
    local <- depth + 1
    return local
