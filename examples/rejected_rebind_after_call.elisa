# A self-update names x's new value by a fresh symbol while x's own name keeps the facts about
# the value before it. A call that may rewrite x must not put x back on its own name: every
# ensure below claims the stale value and must stay unproven.
global mutable counter: usize = 0

def touch() -> void:
    counter <- 1

def hazard() -> usize:
    ensure result == 0
    x: mutable usize = 0
    x <- x + 1
    touch()
    return x

def hazard2(start: usize) -> usize:
    requires start < 10
    ensure result == start
    x: mutable usize = start
    x <- x + 1
    touch()
    return x

def hazard_join(flag: bool) -> usize:
    ensure result == 0
    x: mutable usize = 0
    if flag:
        x <- x + 1
    return x

def hazard_loop(n: usize) -> usize:
    requires n < 10
    ensure result == 0
    x: mutable usize = 0
    i: mutable usize = 0
    while i < n:
        invariant i <= n
        x <- x + 1
        i <- i + 1
    return x

def hazard_join_call(flag: bool) -> usize:
    ensure result == 0
    x: mutable usize = 0
    if flag:
        x <- x + 1
        touch()
    return x

def bump(p: mutable usize&) -> void:
    p <- p + 1 if p < 100

def hazard_aliased() -> usize:
    ensure result == 0
    x: mutable usize = 0
    x <- x + 1
    bump(&x)
    return x
