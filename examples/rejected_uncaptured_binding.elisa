# A binding the capture list does name is written by the block as far as the checker knows, so
# nothing about it may survive: not a value the loop overwrites, and not a fact that only the
# loop's own body establishes. A loop that runs zero times must not export either.
def overwritten_binding_must_not_survive(count: usize) -> i64:
    ensure result == 5
    total: mutable i64 = 5
    for index in 0..<count |index, total|:
        total <- 9
    return total

def zero_iteration_fact_must_not_escape(count: usize) -> i64:
    ensure result == 7
    flag: mutable i64 = 0
    for index in 0..<count |index, flag|:
        flag <- 7
    return flag
