# Fixed-width subtraction and negation at MIN_I64 are not mathematical-integer identities.
# Neither claim may be certified unless the runtime overflow behavior is modeled explicitly.

def underflow_claim(x: i64) -> void:
    requires x == -9223372036854775807 - 1
    assert x - 1 < x by:
        assert x == -9223372036854775807 - 1


def negate_min_claim(x: i64) -> void:
    requires x == -9223372036854775807 - 1
    assert 0 - x > 0 by:
        assert x == -9223372036854775807 - 1
