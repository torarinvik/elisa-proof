def disjunction_is_not_a_conjunction(first: bool, second: bool) -> i64:
    requires first or second
    requires not first
    ensures result == 0
    return 1

def unrelated_negation_is_not_a_denial(first: bool, second: bool, third: bool) -> i64:
    requires first and second
    requires not third
    ensures result == 0
    return 1
