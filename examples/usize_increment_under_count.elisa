def next_index(i: usize, n: usize) -> usize:
    requires i < n
    ensure result == i + 1
    return i + 1

def bump(values: darray[i64]&, i: usize) -> usize:
    requires i < values.count
    ensure result <= values.count
    return i + 1

def local_bump(values: darray[i64]&, i: usize) -> usize:
    requires i < values.count
    j: usize = i + 1
    return j

def wide(i: u64, n: u64) -> u64:
    requires i < n
    return i + 1

def grows(values: darray[i64]&, i: usize) -> usize:
    requires i < values.count
    ensure result > i
    return i + 1

def wide_grows(i: u64, n: u64) -> u64:
    requires i < n
    ensure result > i
    return i + 1
