# Negative constants written as `-3` or `0 - 3` inside signed goals. The producer reads every
# constant; the kernel now reads these operation by operation, so the goals replay.
module NegativeConstant:
    public:
        def plus_negative(y: i64) -> i64:
            requires y >= -1000
            requires y <= 1000
            ensure y + -3 <= 997
            return y

        def plus_difference(y: i64) -> i64:
            requires y >= -1000
            requires y <= 1000
            ensure y + (0 - 3) >= -1003
            return y

        def through_fact(y: i64, x: i64) -> i64:
            requires y >= -1000
            requires y <= 1000
            requires x == y + -3
            ensure x <= 997
            return y
