# The extent a loop range is written against may be nested: `state.region.count` is the length of a
# collection held in a field. The rule that keeps such a length across a loop entry required the
# base to be a bare name, so a loop over `state.a.count` whose body writes `state.b[i]` lost its
# own range fact and could not index the collection it was iterating.
#
# A root whose body writes only elements under it cannot have had any count under it changed: an
# element write is an element write whichever collection it lands in, and a write to a whole field
# puts the root in the disqualified set instead. So the base is now the place root, and every
# collection under an element-only-written root keeps its extent.

extend NestedExtent:
    struct State:
        region: mutable darray[usize]
        live: mutable darray[bool]

    def a_loop_over_one_field_writing_another(state: mutable State&, wanted: usize) -> void:
        for index in 0..<state.region.count |index, state, wanted|:
            if index < state.live.count and state.region[index] == wanted:
                state.live[index] <- false

    def the_guard_may_come_first(state: mutable State&, wanted: usize) -> void:
        for index in 0..<state.region.count |index, state, wanted|:
            continue if index >= state.live.count
            state.live[index] <- false if state.region[index] == wanted
