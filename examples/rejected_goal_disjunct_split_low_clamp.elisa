module GoalDisjunctSplit:
    public:
        def speed_ok(speed: i64) -> bool:
            ensure not result or speed >= 100
            ensure not result or speed <= 4000
            ensure result or speed < 100 or speed > 4000
            return false if speed < 100
            return false if speed > 4000
            return true

        def clamp_speed(speed: i64) -> i64:
            ensure result >= 50
            ensure result <= 4000
            ensure speed < 100 or speed > 4000 or result == speed
            return 50 if speed < 100
            return 4000 if speed > 4000
            return speed

        def a(speed: i64) -> bool:
            ensure result
            value: i64 = clamp_speed(speed)
            return speed_ok(value)

        def b(value: i64) -> bool:
            requires value >= 100
            requires value <= 4000
            ensure result
            return speed_ok(value)
