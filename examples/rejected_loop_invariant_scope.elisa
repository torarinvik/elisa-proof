# The body-local x must not rewrite the loop invariant, but the outer x is not changed.
# This postcondition is intentionally false and must remain rejected.

def rejected_loop_invariant_scope(x: i64) -> i64:
    requires x == 0
    ensure result == 1
    while false:
        invariant x == 0
        x: i64 = 1
    return x
