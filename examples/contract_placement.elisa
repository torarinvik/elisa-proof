# Every contract below sits where the checker reads its kind, so each one is checked
# rather than rejected for its position.
struct Box:
    value: mutable i64
    other: mutable i64

def frames_at_top(box: mutable Box&, x: i64) -> i64:
    requires x >= 0
    ensure result == x
    changes box.other
    preserves box.value
    box.other <- 1
    return x

def measure_at_top(depth: i64) -> bool:
    requires depth >= 0
    requires depth <= 127
    decreases 127 - depth
    if depth >= 127:
        return false
    return measure_at_top(depth + 1)

def invariant_and_measure_in_while(limit: i64) -> i64:
    requires limit >= 0
    ensure result == limit
    i: mutable i64 = 0
    while i < limit:
        invariant i >= 0 and i <= limit
        decreases limit - i
        i <- i + 1
    return i

def invariant_in_captured_while(limit: i64) -> i64:
    requires limit >= 0
    i: mutable i64 = 0
    while i < limit |i|:
        invariant i >= 0
        decreases limit - i
        i <- i + 1
    return 0

def invariant_in_for(n: i64) -> i64:
    requires n >= 0
    ensure result >= 0
    total: mutable i64 = 0
    for index in 0..<n:
        invariant total >= 0
        total <- 0
    return total

def assert_in_branch(x: i64) -> i64:
    requires x >= 0 and x < 10
    ensure result == x
    if x > 5:
        assert x > 4
    return x
