protocol Eq:
    def __eq__(self: Self, other: Self) -> bool

impl Eq for i64:
    def __eq__(self: i64, other: i64) -> bool:
        return self != other

def rejected_index_read_through_overloaded_equality(rows: array[usize, 8]&, first: i64, middle: i64, last: i64) -> i64:
    requires first == middle
    requires middle == last
    ensure rows[first] == rows[last]
    return 0
