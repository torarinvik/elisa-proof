protocol Eq:
    def __eq__(self: Self, other: Self) -> bool

impl Eq for i64:
    def __eq__(self: i64, other: i64) -> bool:
        return self != other

def rejected_index_read_through_overloaded_equality(rows: array[usize, 8]&, first: i64, middle: i64, last: i64) -> i64:
    requires first == middle
    requires middle == last
    ensure rows[first] == rows[last]
    return 0

# A scalar reference's implicit value read must carry the same overloaded-operator
# distrust as its explicit zero-index read. The custom equality is deliberately
# irreflexive, so primitive reflexivity must not discharge this postcondition.
def rejected_implicit_scalar_reference_overloaded_reflexivity(value: i64&) -> i64:
    ensure value == value
    return 0

def rejected_explicit_scalar_reference_overloaded_reflexivity(value: i64&) -> i64:
    ensure value[0] == value[0]
    return 0

def rejected_array_element_overloaded_equality(values: array[i64, 8]&, first: usize, second: usize) -> i64:
    requires first == second
    ensure values[first] == values[second]
    return 0

def pure_i64_value(value: i64) -> i64:
    return value

def rejected_pure_call_result_overloaded_reflexivity(value: i64) -> i64:
    ensure pure_i64_value(value) == pure_i64_value(value)
    return 0
