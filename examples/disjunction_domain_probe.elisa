def domain_choice(status: u8) -> u8:
    ensure status > 9 or result == 1 or result >= 3 and result <= 11
    return 1 if status == 0
    return status + 2 if status <= 9
    return 0

def domain_status(value: bool) -> u8:
    ensure result <= 9
    return 9 if value
    return 0

def composed_domain(status: u8) -> u8:
    requires status <= 9
    ensure result == 1 or result >= 3 and result <= 11
    return domain_choice(status)

def refuted_prefix_or(a: bool, b: bool, c: bool) -> bool:
    requires not a
    requires a or b or c
    ensure b or c
    return true
