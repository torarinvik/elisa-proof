# Controls: a nested module named like the path could be its nearer meaning, so nothing is
# imported there; and a resolved constant still refutes a claim its value does not support.
module Limits:
    public:
        const TOP: i64 = 100

module Laws:
    public:
        module Limits:
            public:
                const TOP: i64 = 7

        def shadowed(x: i64) -> i64:
            requires x >= 0
            requires x <= Limits::TOP
            ensure result <= 100
            return x

module Other:
    public:
        def too_tight(x: i64) -> i64:
            requires x >= 0
            requires x <= Limits::TOP
            ensure result <= 99
            return x
