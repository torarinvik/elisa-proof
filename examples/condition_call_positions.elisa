# A branch condition may carry an executable call wherever that call runs whenever the condition
# is evaluated at all. The branch machinery frames every call in the condition, forgets symbolic
# values and clears unstable facts on both arms, which models a call that certainly happened — so
# the restriction to a bare call at the root was conservatism, not a soundness requirement. A call
# that may not run is a different claim and stays refused.
def bump(counter: mutable usize&) -> bool:
    changes counter
    counter <- counter + 1
    return counter > 0

def measure(counter: mutable usize&) -> usize:
    changes counter
    ensure result >= 1
    counter <- counter + 1
    return 1

def pure_flag(limit: usize) -> bool:
    return limit > 0

# The root of the condition is a call, as before.
def bare_call(counter: mutable usize&) -> usize:
    changes counter
    return 1 if bump(counter)
    return 0

# Negation always evaluates its operand.
def negated_call(counter: mutable usize&) -> usize:
    changes counter
    return 1 if not bump(counter)
    return 0

# A comparison evaluates both sides.
def compared_call(counter: mutable usize&, limit: usize) -> usize:
    changes counter
    return 1 if measure(counter) > limit
    return 0

# The left operand of a short-circuit always runs; a pure call on the right cannot be skipped in
# any way that matters, because it has no effect to skip.
def short_circuit_left(counter: mutable usize&, limit: usize) -> usize:
    changes counter
    return 1 if bump(counter) and pure_flag(limit)
    return 0

# A call under arithmetic and an index still runs unconditionally.
def arithmetic_call(counter: mutable usize&, limit: usize) -> usize:
    changes counter
    return 1 if measure(counter) + 1 > limit
    return 0

# A local bound before the guard is the sound way to reuse a call result, and it still works.
def guarded_index(values: darray[i64]&, counter: mutable usize&) -> i64:
    changes counter
    index: usize = measure(counter)
    if index < values.count:
        return values[index]
    return 0
