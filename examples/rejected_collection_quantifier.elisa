# Literal collection quantifiers still require every instance (or a real witness).

def bad_collection_forall() -> i64:
    ensure forall value in [1, -1]: value >= 0
    return 0

def bad_collection_exists() -> i64:
    ensure exists value in [1, 2]: value == 3
    return 0

def empty_collection_exists() -> i64:
    ensure exists value in []: value == 0
    return 0

def dynamic_collection_is_opaque(values: array[i64, 4]) -> i64:
    ensure forall value in values: value >= 0
    return 0
