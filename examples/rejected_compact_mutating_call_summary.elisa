include "compact_mutating_call_summary.elisa"

def rejected_wrapper_status(
    encoded_failure: usize,
    failed_index: mutable usize&, failed_status: mutable u8&
) -> u8:
    ensure encoded_failure != CompactSnapshot::FIRST_VALID or result == CompactSnapshot::INVALID
    CompactSnapshot::decode_status(encoded_failure, failed_index, failed_status)
