# Each claim here would follow if a call term were bounded or identified more loosely than
# its declaration and arguments allow. Every one must stay unproven.

module RejectedCallResultPlaces:
    public:
        def unbounded(n: i64) -> i64:
            ensure result >= 0
            return 0 if n <= 0
            n

        def echo(x: i64) -> i64:
            requires x >= 0 and x < 100
            ensure result == x
            x

        # No upper bound: at i64 max the sum wraps below zero.
        def wraps(n: i64) -> i64:
            ensure result >= 1
            unbounded(n) + 1

        # Different arguments denote different values.
        def other_argument(a: i64, b: i64) -> i64:
            requires a >= 0 and a < 100
            requires b >= 0 and b < 100
            ensure result >= 1
            echo(a) - echo(b) + 1

        # The same text over a rebound name is a different call.
        def stale_argument(x: i64) -> i64:
            requires x >= 0 and x < 50
            ensure result == 0
            v: mutable i64 = x
            a: i64 = echo(v)
            v <- v + 1
            echo(v) - a
