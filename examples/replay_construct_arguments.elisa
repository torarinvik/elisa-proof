# A call whose argument is a struct construct: its summary fact names the
# construct, and replay must find that fact's own trace to validate it.
module ReplayConstructArguments:
    public:
        struct Pair:
            a: u64
            b: u64

        struct Flagged:
            on: bool
            level: u64

        def cap(p: Pair) -> u64:
            ensure result <= 10
            p.a if p.a < 10 else 10

        def level(f: Flagged) -> u64:
            ensure result <= 3
            return 0 if not f.on
            f.level if f.level < 3 else 3

        def from_parameters(x: u64, y: u64) -> u64:
            ensure result <= 10
            cap(Pair{a: x, b: y})

        def from_literals() -> u64:
            ensure result <= 10
            cap(Pair{a: 4, b: 9})

        def from_bool_field(x: u64) -> u64:
            ensure result <= 3
            level(Flagged{on: true, level: x})
