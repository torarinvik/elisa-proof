# A failed early-return guard such as `return 0 if a >= b` leaves the fact
# `not (a >= b)` on the fall-through path. The plain-difference closure reads it
# as `a < b`, so the quotient rule can bound `a * k / b` by `k`.
module NegatedGuardOrders:
    public:
        const LIMIT: u64 = 10000

        def progress(elapsed: u64, span: u64) -> u64:
            requires elapsed <= LIMIT and span <= LIMIT
            ensure result <= 1000
            return 1000 if elapsed >= span
            elapsed * 1000 / span

        def proper_fraction(part: u64, whole: u64) -> u64:
            requires part <= LIMIT and whole <= LIMIT
            ensure result < 1
            return 0 if part >= whole
            part / whole

        def below_after_guard(low: u64, high: u64) -> u64:
            ensure result <= high
            return high if not (low < high)
            low

        def descending_guard(low: u64, high: u64) -> u64:
            requires high <= LIMIT
            ensure result <= 1000
            return 0 if high <= low
            low * 1000 / high
