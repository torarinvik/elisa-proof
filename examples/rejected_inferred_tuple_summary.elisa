def inferred_tuple_source(value: i64) -> (known: bool, value: i64):
    ensures result.known and result.value == value
    return (true, value)

def wrong_inferred_tuple_value(value: i64) -> i64:
    ensures result == 0
    summary = inferred_tuple_source(value)
    return summary.value

def wrong_inferred_tuple_boolean(value: i64) -> bool:
    ensures not result
    summary = inferred_tuple_source(value)
    return summary.known

def unverified_tuple_source(value: i64) -> (known: bool, value: i64):
    ensures result.value == 0
    return (true, value)

def unverified_inferred_tuple_value(value: i64) -> i64:
    ensures result == 0
    summary = unverified_tuple_source(value)
    return summary.value

def stateful_tuple_source(value: mutable i64&) -> (known: bool, value: i64):
    ensures result.value == value
    value <- 9
    return (true, value)

def stale_inferred_tuple_value(value: mutable i64&) -> i64:
    requires value == 7
    ensures result == 7
    summary = stateful_tuple_source(value)
    return summary.value
