# A full swap-based bubble sort (BACKLOG W-04): each pass carries the maximum of the unsorted
# prefix to its end, so the sorted suffix grows down by one cell per outer step.
def bubble_sort(xs: mutable darray[i64]&, n: usize) -> void:
    requires n <= xs.count
    ensures forall i in 0..<n: (i + 1 < n) => xs[i] <= xs[i + 1]
    hi: mutable usize = n
    while 0 < hi:
        invariant hi <= n
        invariant forall i in hi..<n: (i + 1 < n) => xs[i] <= xs[i + 1]
        invariant forall i in 0..<hi: (hi < n) => xs[i] <= xs[hi]
        k: mutable usize = 0
        m: mutable i64 = xs[0]
        while k + 1 < hi:
            invariant k < hi
            invariant m == xs[k]
            invariant forall i in 0..<k: xs[i] <= m
            invariant (hi < n) => m <= xs[hi]
            invariant forall i in (k + 1)..<hi: (hi < n) => xs[i] <= xs[hi]
            invariant forall i in hi..<n: (i + 1 < n) => xs[i] <= xs[i + 1]
            if xs[k + 1] < m:
                xs[k] <- xs[k + 1]
                xs[k + 1] <- m
            else:
                m <- xs[k + 1]
            k <- k + 1
        hi <- hi - 1
