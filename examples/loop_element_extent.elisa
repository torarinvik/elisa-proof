# A loop that writes elements of the collection it is walking still knows how long that
# collection is. Forgetting the loop entry gives every binding the body may rewrite a fresh
# symbol, which is what stops an entry value from standing in for an arbitrary iteration -- but
# `xs[index] <- v` replaces an element of a collection that already had one, so `xs.count` is the
# same at the top of every iteration, and the binder's own range is a fact about exactly that.
#
# The adversarial half is `examples/rejected_loop_element_extent.elisa`: a body that can resize
# the collection keeps nothing.
def fill_in_place(xs: mutable darray[i64]&) -> void:
    changes xs
    for index in 0..<xs.count |index, xs|:
        xs[index] <- 0

# The same through a nested branch, so the classification is not a property of the body's top
# level.
def fill_under_a_branch(xs: mutable darray[i64]&, flag: bool) -> void:
    changes xs
    for index in 0..<xs.count |index, xs, flag|:
        if flag:
            xs[index] <- 1
        else:
            xs[index] <- 2

# A `while` loop reaches the same rule through the same forgetting. It carries no invariant, so
# its own `loop-invariant-missing` stands and the index is bounded by the loop condition -- which
# is itself a fact over `xs.count` and would be gone with the extent.
def fill_with_a_while(xs: mutable darray[i64]&) -> void:
    changes xs
    index: mutable usize = 0
    while index < xs.count |index, xs|:
        xs[index] <- 0
        index <- index + 1

# Every fact that mentions the collection only as `xs.count` survives, not just the binder range.
def a_recorded_count_survives(xs: mutable darray[i64]&, limit: usize) -> void:
    requires xs.count == limit
    requires limit > 0
    changes xs
    for index in 0..<xs.count |index, xs, limit|:
        xs[index] <- 0
