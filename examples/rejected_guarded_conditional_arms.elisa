# The condition guards only its own arm, and only for what it says.
module RejectedGuardedConditionalArms:
    # The else arm runs when the condition fails, which is exactly when this wraps.
    def wrong_arm(byte: u64) -> u64:
        ensure result <= byte
        0 if byte >= 48 else byte - 48

    # A condition weaker than the subtraction needs.
    def weak_guard(byte: u64) -> u64:
        ensure result <= byte
        byte - 48 if byte >= 40 else 0
