# Repeating one constructor does not cover a distinct constructor.
enum MatchCoverageDuplicate:
    First
    Second

def duplicate_case_is_not_exhaustive(value: MatchCoverageDuplicate) -> bool:
    ensure value is MatchCoverageDuplicate.First or value is MatchCoverageDuplicate.Second
    match value:
        MatchCoverageDuplicate.First:
            pass
        MatchCoverageDuplicate.First:
            pass
    return true
