# The boundary of the confined-lend rule. Without the callee's summary the caller knows only that
# the callee may write through each exclusively lent reference, so every exclusive capability must
# be one the caller actually holds alone: no other borrow of the place may be live across the
# call, and two lent places may overlap only when neither is exclusive.
struct Cell:
    value: mutable i64
    tag: mutable i64

# The same place lent exclusively twice. Both capabilities are live while the callee runs, so the
# callee may write through one and read the other; only its own summary could say it does not.
def swap_pair(first: mutable Cell&, second: mutable Cell&, depth: usize) -> void:
    requires depth <= 127
    decreases 127 - depth
    return if depth >= 127
    first.value <- second.tag
    swap_pair(first, first, depth + 1)

# An exclusive lend made while the caller still holds a borrow into the same place. The callee's
# write and the caller's borrow would be live together.
def touch_borrowed(cell: mutable Cell&, depth: usize) -> void:
    requires depth <= 127
    decreases 127 - depth
    return if depth >= 127
    held: mutable i64& = &cell.value
    touch_borrowed(cell, depth + 1)
    held <- held + 1

# A shared lend and an exclusive lend of the same place. The callee may write through one while
# reading the other, which is exactly what a shared capability must exclude.
def read_and_write(target: mutable Cell&, source: Cell&, depth: usize) -> void:
    requires depth <= 127
    decreases 127 - depth
    return if depth >= 127
    target.value <- source.tag
    read_and_write(target, target, depth + 1)
