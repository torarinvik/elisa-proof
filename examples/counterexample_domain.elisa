# Atom-only integer models can provide exact concrete assignments.
def exact_scalar_counterexample(x: i64) -> i64:
    ensure result < 0
    return x

# Narrow LLVM integer addition wraps. An i64 model must not claim x = 127 falsifies
# this i8 postcondition: 127 + 1 is the representable value -128 in Elisa.
def narrow_wrap_is_not_a_counterexample(x: i8) -> i8:
    requires x == 127
    ensure x + 1 == -128
    return x
