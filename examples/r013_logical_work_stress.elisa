# Rich bounded-work cases complement the repeated-tautology stress fixture.

def disjunctive_premises_under_budget(a: i64, b: i64, c: i64, d: i64) -> i64:
    requires a == 1 or a == 2
    requires b == 1 or b == 2
    requires c == 1 or c == 2
    requires d == 1 or d == 2
    ensure a + b + c + d >= 4
    return 0

def disjunctive_premises_over_budget(a: i64, b: i64, c: i64, d: i64, e: i64) -> i64:
    requires a == 1 or a == 2
    requires b == 1 or b == 2
    requires c == 1 or c == 2
    requires d == 1 or d == 2
    requires e == 1 or e == 2
    ensure a + b + c + d + e >= 5
    return 0

def wide_equality_graph_under_budget(x0: i64, x1: i64, x2: i64, x3: i64, x4: i64, x5: i64, x6: i64, x7: i64, x8: i64, x9: i64, x10: i64, x11: i64, x12: i64, x13: i64, x14: i64, x15: i64, x16: i64, x17: i64, x18: i64, x19: i64, x20: i64, x21: i64, x22: i64, x23: i64) -> i64:
    requires x0 >= 0
    requires x0 == x1
    requires x1 == x2
    requires x2 == x3
    requires x3 == x4
    requires x4 == x5
    requires x5 == x6
    requires x6 == x7
    requires x7 == x8
    requires x8 == x9
    requires x9 == x10
    requires x10 == x11
    requires x11 == x12
    requires x12 == x13
    requires x13 == x14
    requires x14 == x15
    requires x15 == x16
    requires x16 == x17
    requires x17 == x18
    requires x18 == x19
    requires x19 == x20
    requires x20 == x21
    requires x21 == x22
    requires x22 == x23
    ensure result >= 0
    return x23

