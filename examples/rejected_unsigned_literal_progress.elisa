def rejected_unbounded_increment(value: u64) -> u64:
    ensure result >= 1
    return value + 1

def rejected_inclusive_maximum_increment(value: u64) -> u64:
    requires value <= 18446744073709551615u64
    ensure result >= 1
    return value + 1

def rejected_zero_lower_bound(value: u64) -> u64:
    requires value >= 0u64
    ensure result >= 1
    return value

def rejected_signed_increment(value: i64) -> i64:
    requires value < 9223372036854775807i64
    ensure result >= 1
    return value + 1

def rejected_larger_step(value: u8) -> u8:
    requires value < 255u8
    ensure result >= 1
    return value + 2
