# Mutual recursive lemmas share the same checked well-founded relation.

lemma even_step(n: i64):
    requires n >= 0
    ensure n >= 0
    decreases n
    if n > 0:
        odd_step(n - 1)

lemma odd_step(n: i64):
    requires n >= 0
    ensure n >= 0
    decreases n
    if n > 0:
        even_step(n - 1)

def use_mutual_recursive_lemma(n: i64) -> void:
    requires n >= 0
    assert n >= 0 by:
        even_step(n)
