struct FlagBox:
    value: mutable bool

def framed_flag(box: mutable FlagBox&) -> bool:
    changes box.value
    box.value <- not box.value
    return box.value

def rejected_opaque_flag_truth(box: mutable FlagBox&) -> bool:
    ensure result
    flag: bool = framed_flag(box)
    return flag

def rejected_repeated_flag_identity(box: mutable FlagBox&) -> bool:
    ensure result
    first: bool = framed_flag(box)
    second: bool = framed_flag(box)
    return first == second
