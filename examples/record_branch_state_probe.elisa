struct RecordBranchState:
    value: mutable u8
    other: mutable u8

def record_branch_scalar(state: mutable RecordBranchState&, choose: bool) -> u8:
    ensure not choose or state.value == 1
    ensure choose or state.value == 2
    ensure state.other == old(state.other)
    if choose:
        state.value <- 1
    else:
        state.value <- 2
    return 0

def record_branch_nested(state: mutable RecordBranchState&, choose: bool, second: bool) -> u8:
    ensure not choose or not second or state.value == 3
    ensure not choose or second or state.value == 4
    ensure choose or state.value == 5
    if choose:
        if second:
            state.value <- 3
        else:
            state.value <- 4
    else:
        state.value <- 5
    return 0

def record_branch_following_write(state: mutable RecordBranchState&, choose: bool) -> u8:
    ensure not choose or state.value == 1
    ensure choose or state.value == 2
    ensure state.other == 8
    if choose:
        state.value <- 1
    else:
        state.value <- 2
    state.other <- 8
    return 0

def record_branch_surviving_arm(state: mutable RecordBranchState&, choose: bool) -> u8:
    ensure result != 0 or state.value == 6
    if choose:
        return 1
    else:
        state.value <- 6
    return 0
