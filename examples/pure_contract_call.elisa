# Contract calls are accepted only when the callee is a verified total pure function.

def pure_identity(x: i64) -> i64:
    ensure result == x
    return x

def pure_absolute_value(x: i64) -> i64:
    if x >= 0:
        return x
    else:
        return 0 - x

def uses_pure_contract_call(x: i64) -> i64:
    ensure result == pure_identity(x)
    return pure_identity(x)

def uses_pure_conditional_call(x: i64) -> i64:
    ensure result == pure_absolute_value(x)
    return pure_absolute_value(x)

def pure_successor(x: i64) -> i64:
    return pure_identity(x)

def uses_transitive_pure_contract_call(x: i64) -> i64:
    ensure result == pure_successor(x)
    return pure_successor(x)
