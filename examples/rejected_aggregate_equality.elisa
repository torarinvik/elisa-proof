# Elisa admits no `==` between aggregate values ("aggregate values do not support ==; compare
# their contents explicitly"), and `==` between two struct values is a user `__eq__` that need
# not be reflexive. None of these obligations may prove or emit a certificate, whether the
# operands are quantified or not. Each form must still lower into the source-neutral arena so a
# goal over it is decided by the kernel and not lost to a replay gap.

struct Pair:
    left: i64
    right: i64

def array_equality(x: i64) -> i64:
    ensure ([x]) == ([x])
    return 0

def nested_array_equality(x: i64) -> i64:
    ensure ([[x], [x]]) == ([[x], [x]])
    return 0

def tuple_equality(x: i64) -> i64:
    ensure ([x], x) == ([x], x)
    return 0

def dictionary_equality(x: i64) -> i64:
    ensure ({1: (x, 0), 2: (x, 0)}) == ({1: (x, 0), 2: (x, 0)})
    return 0

def construct_equality(x: i64) -> i64:
    ensure Pair{left: x, right: 0} == Pair{left: x, right: 0}
    return 0

def update_equality(pair: Pair, x: i64) -> i64:
    ensure pair{left = x} == pair{left = x}
    return 0

def quantified_array_equality() -> i64:
    ensure forall value in [1, 2, 3]: ([value]) == ([value])
    return 0

def quantified_tuple_equality() -> i64:
    ensure forall value in [1, 2, 3]: ([value], [value]) == ([value], [value])
    return 0

def quantified_dictionary_equality() -> i64:
    ensure forall value in [1, 2, 3]: ({1: (value, 0)}) == ({1: (value, 0)})
    return 0

def quantified_construct_equality() -> i64:
    ensure forall value in [1, 2, 3]: Pair{left: value, right: 0} == Pair{left: value, right: 0}
    return 0
