def mix(x: i64, y: i64) -> i64:
    requires x >= -1000
    requires x <= 1000
    requires y >= -1000
    requires y <= 1000
    requires x + y <= 10
    requires x - y <= 4
    ensure result <= 7
    return x

def three(x: i64, y: i64, z: i64) -> i64:
    requires x >= -1000
    requires x <= 1000
    requires y >= -1000
    requires y <= 1000
    requires z >= -1000
    requires z <= 1000
    requires x + y <= z
    requires z - y <= 5
    requires y + y <= x + 3
    ensure result <= 13
    return x

def strict(x: i64, y: i64) -> i64:
    requires x >= -1000
    requires x <= 1000
    requires y >= -1000
    requires y <= 1000
    requires x + y < 10
    requires x - y < 4
    ensure result <= 6
    return x

def wrong(x: i64, y: i64) -> i64:
    requires x >= -1000
    requires x <= 1000
    requires y >= -1000
    requires y <= 1000
    requires x + y <= 10
    requires x - y <= 4
    ensure result <= 6
    return x
