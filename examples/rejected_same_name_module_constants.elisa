# Controls: each same-named function sees only its own module's constant value.
module Gate:
    public:
        const FULL: i64 = 1000
        def weight(x: i64) -> i64:
            requires x >= 0
            requires x <= FULL
            ensure result <= 500
            return x

module Fade:
    public:
        const FULL: i64 = 2000
        def weight(x: i64) -> i64:
            requires x >= 0
            requires x <= FULL
            ensure result <= 1000
            return x
