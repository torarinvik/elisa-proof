# A moved local shadows a same-spelled root constant. Resource qualification must retain the
# local binding rather than rewriting it as static storage, and the later use must be refused.
const SIGNED_DEPTH: i64 = 64

struct Node:
    kind: sview
    left: usize

module MovedQualifiedConstantShadow:
    private:
        def accept_unsigned(nodes: darray[Node]&, value: usize) -> bool:
            return value <= nodes.count

        def moved_shadow_caller(nodes: darray[Node]&) -> bool:
            SIGNED_DEPTH: darray[i64] = []
            moved: darray[i64] = move SIGNED_DEPTH
            return accept_unsigned(nodes, SIGNED_DEPTH.count + 1)
