# A typed by-value aggregate copy retains its declared field paths for resource replay.
struct ResourceProjectionE144Leaf:
    left: usize
    right: usize

struct ResourceProjectionE144Node:
    leaf: ResourceProjectionE144Leaf

def resource_projection_e144_sum(left: usize, right: usize) -> usize:
    return left + right

def resource_projection_e144_typed_copy(nodes: darray[ResourceProjectionE144Node]&, index: usize) -> usize:
    requires index < nodes.count
    copied: ResourceProjectionE144Node = nodes[index]
    return resource_projection_e144_sum(copied.leaf.left, copied.leaf.right)
