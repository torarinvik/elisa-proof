# The general linear tier: Fourier-Motzkin over several names with literal coefficients,
# accepted through a checked Farkas certificate, and used to prune disjunctive premises
# before the case splitter opens them.
module Linear:
    public:
        const L: i64 = 1000

        # A second difference is bounded by four times the input bound.
        def accel(prev: i64, now: i64, next: i64) -> i64:
            requires prev >= -L
            requires prev <= L
            requires now >= -L
            requires now <= L
            requires next >= -L
            requires next <= L
            ensure prev - 2 * now + next <= 4 * L
            ensure prev - 2 * now + next >= -4 * L
            return 0

        # A three-name chain the difference tier cannot read in one step.
        def chain(a: i64, b: i64, c: i64) -> i64:
            requires a >= 0
            requires a <= 100
            requires b >= a + 3
            requires b <= 100
            requires c >= 2 * b - a
            requires c <= 1000
            ensure c >= a + 6
            return a

        def clamp(deviation: i64, limit: i64) -> i64:
            requires deviation >= -L
            requires deviation <= L
            requires limit >= 0
            requires limit <= L
            ensure deviation > limit or deviation < -limit or result == deviation
            ensure deviation <= limit or result >= limit
            ensure deviation >= -limit or result <= -limit
            if deviation > limit:
                return limit
            if deviation < -limit:
                return -limit
            return deviation

        # Every alternative of `clamp`'s summaries except the last is refuted by the premises.
        def clamp_zero(limit: i64) -> i64:
            requires limit >= 0
            requires limit <= L
            ensure result == 0
            return Linear::clamp(0, limit)
