# A witnessed pure call denotes one value for fixed arguments, so the field-place rule
# generalizes it to a fresh name the interval and difference tiers can bound. The callee's
# declared signed width travels with it, which is what lets `g(n) + 1` be shown not to wrap.

module CallResultPlaces:
    public:
        def small(n: i64) -> i64:
            ensure result >= 0
            ensure result < 1000
            return 0 if n <= 0
            1

        def echo(x: i64) -> i64:
            requires x >= 0 and x < 100
            ensure result == x
            x

        def successor(n: i64) -> i64:
            ensure result >= 1
            small(n) + 1

        def bounded(n: i64) -> bool:
            ensure result
            small(n) < 2000

        def pair_sum(x: i64, y: i64) -> i64:
            ensure result >= 0
            ensure result < 2000
            small(x) + small(y)

        def bound_then_summed(n: i64) -> i64:
            requires n > 0
            ensure result >= 0
            a: i64 = small(n)
            b: i64 = small(n - 1)
            a + b

        def kept_across_a_call(x: i64) -> i64:
            ensure result >= 1
            a: i64 = small(x)
            b: i64 = small(0)
            a + 1

        def same_call_cancels(a: i64) -> i64:
            requires a >= 0 and a < 100
            ensure result == 1
            echo(a) - echo(a) + 1
