# Test-only constructors give non-empty darrays an explicit return destination. Keeping these
# helpers separate makes call sites exercise the replay APIs without allocating a darray inside
# an argument expression, which has no destination region.
module KernelPropositionTestSupport:
    public:
        def facts_one(value: usize) -> darray[usize]:
            can Memory.Allocate, Abort.Panic:
                return [value]

        def facts_two(first: usize, second: usize) -> darray[usize]:
            can Memory.Allocate, Abort.Panic:
                return [first, second]
