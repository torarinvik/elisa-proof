module UnsignedOrGoal:
    public:
        def u32_true_literal(value: u32) -> u8:
            ensure true
            return 0

        def u32_true_disjunction(value: u32) -> u8:
            ensure (true or value < 1000)
            return 0

        def u8_true_disjunction(value: u8) -> u8:
            ensure true or value < 100
            return 0

        def u64_true_disjunction(value: u64) -> u8:
            ensure true or value < 1000
            return 0

        def u32_reflexive_disjunction(value: u32) -> u8:
            ensure 1 == 1 or value < 1000
            return 0

        def u32_complemented_guard(value: u32) -> u8:
            ensure result == 1 or value < 1000
            if value >= 1000:
                return 1
            else:
                return 0

        def u32_false_disjunction_control(value: u32) -> u8:
            ensure false or value < 1000
            return 0

        def u8_wrapped_return_control() -> u8:
            ensure result == 0
            return 255 + 1
