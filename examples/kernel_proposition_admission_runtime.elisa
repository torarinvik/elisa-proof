# Native contract test for source-neutral and typed proposition admission. The raw API is an
# abstract propositional calculus: any well-formed opaque atom can be assumed as P and derived
# from itself. Only the typed API claims formation under an explicit declaration environment.
# The source adapter, not this kernel context, must establish correspondence with Elisa types.
include "../src/proof/kernel_core.elisa"
include "../src/proof/kernel_replay.elisa"
include "./kernel_proposition_test_support.elisa"
using ElisaProofKernelCore
using ElisaProofKernelReplay
using KernelPropositionTestSupport
include "./kernel_proposition_binding_tests.elisa"
include "./kernel_proposition_record_update_tests.elisa"
include "./kernel_proposition_numeric_call_tests.elisa"
include "./kernel_proposition_type_environment_tests.elisa"
include "./kernel_proposition_string_call_tests.elisa"
include "./kernel_proposition_function_tests.elisa"
include "./kernel_proposition_operator_tests.elisa"

def named_container_identity_tests() -> i64 can[Memory.Allocate, Abort.Panic]:
    named_container_nodes: mutable darray[ProofKernelNode] = []
    named_container_children: mutable darray[usize] = []
    token_values: usize = add_node(&named_container_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "token_values", "")
    same_token_values: usize = add_node(&named_container_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "same_token_values", "")
    other_values: usize = add_node(&named_container_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "other_values", "")
    element_zero: usize = add_node(&named_container_nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
    token_item: usize = add_node(&named_container_nodes, "index", "", token_values, element_zero, 0, 0, 0, 0, "", "")
    same_token_item: usize = add_node(&named_container_nodes, "index", "", same_token_values, element_zero, 0, 0, 0, 0, "", "")
    other_item: usize = add_node(&named_container_nodes, "index", "", other_values, element_zero, 0, 0, 0, 0, "", "")
    same_named_element: usize = add_node(&named_container_nodes, "binary", "==", token_item, same_token_item, 0, 0, 0, 0, "", "")
    different_named_element: usize = add_node(&named_container_nodes, "binary", "==", token_item, other_item, 0, 0, 0, 0, "", "")
    named_container_bindings: mutable darray[ProofKernelTypingBinding] = []
    token_type_added: bool = proof_kernel_add_typing_binding_with_identity(&named_container_bindings, "type", "Token", "", "named", "Token", "", "", 901, 0, 0)
    distinct_type_added: bool = proof_kernel_add_typing_binding_with_identity(&named_container_bindings, "type", "Other", "", "named", "Other", "", "", 902, 0, 0)
    token_values_added: bool = proof_kernel_add_typing_binding_with_identity(&named_container_bindings, "value", "token_values", "", "container", "darray", "named", "Token", 0, 0, 901)
    same_token_values_added: bool = proof_kernel_add_typing_binding_with_identity(&named_container_bindings, "value", "same_token_values", "", "container", "darray", "named", "Token", 0, 0, 901)
    other_values_added: bool = proof_kernel_add_typing_binding_with_identity(&named_container_bindings, "value", "other_values", "", "container", "darray", "named", "Other", 0, 0, 902)
    return 1 if not token_type_added or not distinct_type_added or not token_values_added or not same_token_values_added or not other_values_added
    named_container_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: named_container_bindings}
    return 2 if not proof_kernel_replay_proposition_formation_report(&named_container_nodes, &named_container_children, named_container_environment, [], same_named_element)
    return 3 if proof_kernel_replay_proposition_formation_report(&named_container_nodes, &named_container_children, named_container_environment, [], different_named_element)
    missing_named_element_identity: mutable darray[ProofKernelTypingBinding] = []
    missing_named_element_added: bool = proof_kernel_add_typing_binding_with_identity(&missing_named_element_identity, "value", "token_values", "", "container", "darray", "named", "Token", 0, 0, 0)
    return 4 if not missing_named_element_added
    missing_named_element_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: missing_named_element_identity}
    return 5 if proof_kernel_replay_proposition_formation_report(&named_container_nodes, &named_container_children, missing_named_element_environment, [], same_named_element)
    return 0

def enum_member_proposition_tests() -> i64 can[Memory.Allocate, Abort.Panic]:
    # A bare enum shorthand is typed only when exactly one declared const-enum member supplies
    # its owner type; missing or ambiguous members are not accepted as propositions or values.
    enum_bindings: mutable darray[ProofKernelTypingBinding] = []
    mode_value_added: bool = proof_kernel_add_typing_binding_with_identity(&enum_bindings, "value", "mode", "", "named", "Mode", "", "", 701, 0, 0)
    on_member_added: bool = proof_kernel_add_typing_binding_with_identity(&enum_bindings, "enum-member", "On", "Mode", "named", "Mode", "", "", 701, 701, 0)
    return 61 if not mode_value_added or not on_member_added
    enum_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: enum_bindings}
    enum_nodes: mutable darray[ProofKernelNode] = []
    enum_children: mutable darray[usize] = []
    mode_root: usize = add_node(&enum_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "mode", "")
    on_root: usize = add_node(&enum_nodes, "shorthand", "", 0, 0, 0, 0, 0, 0, "On", "")
    enum_equality: usize = add_node(&enum_nodes, "binary", "==", mode_root, on_root, 0, 0, 0, 0, "", "")
    return 62 if not proof_kernel_replay_proposition_formation_report(&enum_nodes, &enum_children, enum_environment, [], enum_equality)
    missing_enum_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: [enum_bindings[0]]}
    return 63 if proof_kernel_replay_proposition_formation_report(&enum_nodes, &enum_children, missing_enum_environment, [], enum_equality)
    return 0

def enum_variant_proposition_tests() -> i64 can[Memory.Allocate, Abort.Panic]:
    # Variant tests require a declared tag of the receiver's exact enum type, including the
    # alternate field spelling accepted by Elisa's AST.
    variant_test_bindings: mutable darray[ProofKernelTypingBinding] = []
    option_value_added: bool = proof_kernel_add_typing_binding_with_identity(&variant_test_bindings, "value", "option", "", "named", "Option", "", "", 101, 0, 0)
    option_type_added: bool = proof_kernel_add_typing_binding_with_identity(&variant_test_bindings, "type", "Option", "", "named", "Option", "", "", 101, 0, 0)
    other_type_added: bool = proof_kernel_add_typing_binding_with_identity(&variant_test_bindings, "type", "Other", "", "named", "Other", "", "", 102, 0, 0)
    option_tag_added: bool = proof_kernel_add_typing_binding_with_identity(&variant_test_bindings, "enum-tag", "Some", "Option", "named", "Option", "", "", 101, 101, 0)
    other_tag_added: bool = proof_kernel_add_typing_binding_with_identity(&variant_test_bindings, "enum-tag", "Some", "Other", "named", "Other", "", "", 102, 102, 0)
    return 69 if not option_value_added or not option_type_added or not other_type_added or not option_tag_added or not other_tag_added
    variant_test_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: variant_test_bindings}
    variant_test_nodes: mutable darray[ProofKernelNode] = []
    variant_test_children: mutable darray[usize] = []
    option_value_root: usize = add_node(&variant_test_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "option", "")
    option_type_root: usize = add_node(&variant_test_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "Option", "")
    option_some_tag: usize = add_node(&variant_test_nodes, "scope", "", option_type_root, 0, 0, 0, 0, 0, "Some", "")
    valid_variant_test: usize = add_node(&variant_test_nodes, "binary", "is", option_value_root, option_some_tag, 0, 0, 0, 0, "", "")
    return 70 if not proof_kernel_replay_proposition_formation_report(&variant_test_nodes, &variant_test_children, variant_test_environment, [], valid_variant_test)
    option_some_field: usize = add_node(&variant_test_nodes, "field", "", option_type_root, 0, 0, 0, 0, 0, "Some", "")
    valid_field_variant_test: usize = add_node(&variant_test_nodes, "binary", "is", option_value_root, option_some_field, 0, 0, 0, 0, "", "")
    return 77 if not proof_kernel_replay_proposition_formation_report(&variant_test_nodes, &variant_test_children, variant_test_environment, [], valid_field_variant_test)
    other_type_root: usize = add_node(&variant_test_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "Other", "")
    other_some_tag: usize = add_node(&variant_test_nodes, "scope", "", other_type_root, 0, 0, 0, 0, 0, "Some", "")
    wrong_enum_variant_test: usize = add_node(&variant_test_nodes, "binary", "is", option_value_root, other_some_tag, 0, 0, 0, 0, "", "")
    return 71 if proof_kernel_replay_proposition_formation_report(&variant_test_nodes, &variant_test_children, variant_test_environment, [], wrong_enum_variant_test)
    other_some_field: usize = add_node(&variant_test_nodes, "field", "", other_type_root, 0, 0, 0, 0, 0, "Some", "")
    wrong_field_variant_test: usize = add_node(&variant_test_nodes, "binary", "is", option_value_root, other_some_field, 0, 0, 0, 0, "", "")
    return 78 if proof_kernel_replay_proposition_formation_report(&variant_test_nodes, &variant_test_children, variant_test_environment, [], wrong_field_variant_test)
    boolean_tag_root: usize = add_node(&variant_test_nodes, "bool", "", 0, 0, 0, 0, 0, 1, "", "")
    malformed_variant_test: usize = add_node(&variant_test_nodes, "binary", "is", option_value_root, boolean_tag_root, 0, 0, 0, 0, "", "")
    return 72 if proof_kernel_replay_proposition_formation_report(&variant_test_nodes, &variant_test_children, variant_test_environment, [], malformed_variant_test)
    return 0

def ambiguous_enum_identity_tests() -> i64 can[Memory.Allocate, Abort.Panic]:
    colliding_enum_bindings: mutable darray[ProofKernelTypingBinding] = []
    collision_value_added: bool = proof_kernel_add_typing_binding_with_identity(&colliding_enum_bindings, "value", "option", "", "named", "Option", "", "", 101, 0, 0)
    first_option_type_added: bool = proof_kernel_add_typing_binding_with_identity(&colliding_enum_bindings, "type", "Option", "", "named", "Option", "", "", 101, 0, 0)
    second_option_type_added: bool = proof_kernel_add_typing_binding_with_identity(&colliding_enum_bindings, "type", "Option", "", "named", "Option", "", "", 103, 0, 0)
    first_option_tag_added: bool = proof_kernel_add_typing_binding_with_identity(&colliding_enum_bindings, "enum-tag", "Some", "Option", "named", "Option", "", "", 101, 101, 0)
    second_option_tag_added: bool = proof_kernel_add_typing_binding_with_identity(&colliding_enum_bindings, "enum-tag", "Some", "Option", "named", "Option", "", "", 103, 103, 0)
    return 73 if not collision_value_added or not first_option_type_added or not second_option_type_added or not first_option_tag_added or not second_option_tag_added
    colliding_enum_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: colliding_enum_bindings}
    collision_nodes: mutable darray[ProofKernelNode] = []
    collision_children: mutable darray[usize] = []
    option_value_root: usize = add_node(&collision_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "option", "")
    option_type_root: usize = add_node(&collision_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "Option", "")
    option_some_tag: usize = add_node(&collision_nodes, "scope", "", option_type_root, 0, 0, 0, 0, 0, "Some", "")
    colliding_variant_test: usize = add_node(&collision_nodes, "binary", "is", option_value_root, option_some_tag, 0, 0, 0, 0, "", "")
    return 74 if proof_kernel_replay_proposition_formation_report(&collision_nodes, &collision_children, colliding_enum_environment, [], colliding_variant_test)
    return 0

def lexical_identity_proposition_tests() -> i64 can[Memory.Allocate, Abort.Panic]:
    lexical_nodes: mutable darray[ProofKernelNode] = []
    lexical_children: mutable darray[usize] = []
    left_named_value: usize = add_node(&lexical_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "left_named", "")
    right_named_value: usize = add_node(&lexical_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "right_named", "")
    same_spelling_mismatch: usize = add_node(&lexical_nodes, "binary", "==", left_named_value, right_named_value, 0, 0, 0, 0, "", "")
    lexical_bindings: mutable darray[ProofKernelTypingBinding] = []
    left_lexical_added: bool = proof_kernel_add_typing_binding_with_identity(&lexical_bindings, "value", "left_named", "", "named", "Token", "", "", 801, 0, 0)
    right_lexical_added: bool = proof_kernel_add_typing_binding_with_identity(&lexical_bindings, "value", "right_named", "", "named", "Token", "", "", 802, 0, 0)
    return 75 if not left_lexical_added or not right_lexical_added
    lexical_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: lexical_bindings}
    return 76 if proof_kernel_replay_proposition_formation_report(&lexical_nodes, &lexical_children, lexical_environment, [], same_spelling_mismatch)
    return 0

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    ambiguous_binding_status: i64 = kernel_ambiguous_value_binding_tests()
    return 120 + ambiguous_binding_status if ambiguous_binding_status != 0
    abstract_nodes: mutable darray[ProofKernelNode] = []
    abstract_children: mutable darray[usize] = []
    abstract_proposition: usize = add_node(&abstract_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "P", "")
    abstract_admitted: bool = proof_kernel_replay_goal_report(&abstract_nodes, &abstract_children, facts_one(abstract_proposition), abstract_proposition)
    return 1 if not abstract_admitted

    call_nodes: mutable darray[ProofKernelNode] = []
    call_children: mutable darray[usize] = []
    call_callee: usize = add_node(&call_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "read_integer", "")
    call_term: usize = add_node(&call_nodes, "call", "", call_callee, 0, 0, 0, 0, 0, "", "")
    call_as_abstract_atom: bool = proof_kernel_replay_goal_report(&call_nodes, &call_children, facts_one(call_term), call_term)
    return 2 if not call_as_abstract_atom

    raw_field_nodes: mutable darray[ProofKernelNode] = []
    raw_field_children: mutable darray[usize] = []
    raw_field_object: usize = add_node(&raw_field_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "record", "")
    raw_integer_field: usize = add_node(&raw_field_nodes, "field", "", raw_field_object, 0, 0, 0, 0, 0, "count", "")
    field_as_abstract_atom: bool = proof_kernel_replay_goal_report(&raw_field_nodes, &raw_field_children, facts_one(raw_integer_field), raw_integer_field)
    return 3 if not field_as_abstract_atom

    raw_index_nodes: mutable darray[ProofKernelNode] = []
    raw_index_children: mutable darray[usize] = []
    raw_index_object: usize = add_node(&raw_index_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "values", "")
    raw_zero_index: usize = add_node(&raw_index_nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
    raw_integer_element: usize = add_node(&raw_index_nodes, "index", "", raw_index_object, raw_zero_index, 0, 0, 0, 0, "", "")
    index_as_abstract_atom: bool = proof_kernel_replay_goal_report(&raw_index_nodes, &raw_index_children, facts_one(raw_integer_element), raw_integer_element)
    return 4 if not index_as_abstract_atom

    nested_nodes: mutable darray[ProofKernelNode] = []
    nested_children: mutable darray[usize] = []
    nested_callee: usize = add_node(&nested_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "read_integer", "")
    nested_call: usize = add_node(&nested_nodes, "call", "", nested_callee, 0, 0, 0, 0, 0, "", "")
    true_term: usize = add_node(&nested_nodes, "bool", "", 0, 0, 0, 0, 0, 1, "", "")
    nested_goal: usize = add_node(&nested_nodes, "binary", "and", nested_call, true_term, 0, 0, 0, 0, "", "")
    nested_as_abstract_atom: bool = proof_kernel_replay_goal_report(&nested_nodes, &nested_children, facts_one(nested_goal), nested_goal)
    return 5 if not nested_as_abstract_atom

    # A partial Boolean model must use decisive constants even when its other operand is an
    # opaque proposition. These are valid short-circuit truth-table cases, not assumptions about
    # the unknown atom.
    boolean_nodes: mutable darray[ProofKernelNode] = []
    boolean_children: mutable darray[usize] = []
    boolean_atom: usize = add_node(&boolean_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "P", "")
    boolean_true: usize = add_node(&boolean_nodes, "bool", "", 0, 0, 0, 0, 0, 1, "", "")
    boolean_false: usize = add_node(&boolean_nodes, "bool", "", 0, 0, 0, 0, 0, 0, "", "")
    true_or_opaque: usize = add_node(&boolean_nodes, "binary", "or", boolean_true, boolean_atom, 0, 0, 0, 0, "", "")
    false_and_opaque: usize = add_node(&boolean_nodes, "binary", "and", boolean_false, boolean_atom, 0, 0, 0, 0, "", "")
    false_implies_opaque: usize = add_node(&boolean_nodes, "binary", "=>", boolean_false, boolean_atom, 0, 0, 0, 0, "", "")
    false_or_opaque: usize = add_node(&boolean_nodes, "binary", "or", boolean_false, boolean_atom, 0, 0, 0, 0, "", "")
    return 44 if not proof_kernel_replay_goal_report(&boolean_nodes, &boolean_children, [], true_or_opaque)
    return 45 if proof_kernel_replay_goal_report(&boolean_nodes, &boolean_children, [], false_and_opaque)
    return 46 if not proof_kernel_replay_goal_report(&boolean_nodes, &boolean_children, [], false_implies_opaque)
    return 47 if proof_kernel_replay_goal_report(&boolean_nodes, &boolean_children, [], false_or_opaque)

    # Same i64-returning call, now checked under its declared type. It is rejected as both a
    # conclusion and a hypothesis despite the exact-premise identity proof above.
    integer_call_bindings: mutable darray[ProofKernelTypingBinding] = []
    integer_call_added: bool = proof_kernel_add_typing_binding(&integer_call_bindings, "function", "read_integer", "", "integer", "i64", "", "")
    return 6 if not integer_call_added
    integer_call_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: integer_call_bindings}
    return 7 if proof_kernel_replay_proposition_formation_report(&call_nodes, &call_children, integer_call_environment, facts_one(call_term), call_term)
    true_nodes: mutable darray[ProofKernelNode] = []
    true_children: mutable darray[usize] = []
    true_root: usize = add_node(&true_nodes, "bool", "", 0, 0, 0, 0, 0, 1, "", "")
    return 8 if proof_kernel_replay_proposition_formation_report(&call_nodes, &call_children, integer_call_environment, facts_one(call_term), true_root)

    # A source-checked Boolean-returning function remains usable as an opaque proposition.
    boolean_call_nodes: mutable darray[ProofKernelNode] = []
    boolean_call_children: mutable darray[usize] = []
    boolean_callee: usize = add_node(&boolean_call_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "is_ready", "")
    boolean_call: usize = add_node(&boolean_call_nodes, "call", "", boolean_callee, 0, 0, 0, 0, 0, "", "")
    boolean_call_bindings: mutable darray[ProofKernelTypingBinding] = []
    boolean_call_added: bool = proof_kernel_add_typing_binding(&boolean_call_bindings, "function", "is_ready", "", "boolean", "bool", "", "")
    return 9 if not boolean_call_added
    boolean_call_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: boolean_call_bindings}
    return 10 if not proof_kernel_replay_goal_report_typed(&boolean_call_nodes, &boolean_call_children, boolean_call_environment, facts_one(boolean_call), boolean_call)

    # A Boolean result does not erase the callee's argument types. Both positional and named
    # calls must match the exact declaration signature; an arbitrary known-sort argument is not
    # enough to make the result a proposition.
    signature_nodes: mutable darray[ProofKernelNode] = []
    signature_children: mutable darray[usize] = []
    signature_callee: usize = add_node(&signature_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "accept_integer", "")
    integer_argument: usize = add_node(&signature_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "integer_value", "")
    boolean_argument: usize = add_node(&signature_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "boolean_value", "")
    integer_wrapper: usize = add_node(&signature_nodes, "call_arg", "", integer_argument, 0, 0, 0, 0, 0, "", "")
    boolean_wrapper: usize = add_node(&signature_nodes, "call_arg", "", boolean_argument, 0, 0, 0, 0, 0, "", "")
    signature_children.push(integer_wrapper)
    signature_children.push(boolean_wrapper)
    positional_boolean_call: usize = add_node(&signature_nodes, "call", "", signature_callee, 0, 0, 1, 1, 0, "", "")
    named_integer_wrapper: usize = add_node(&signature_nodes, "call_arg", "", integer_argument, 0, 0, 0, 0, 0, "value", "")
    signature_children.push(named_integer_wrapper)
    named_integer_call: usize = add_node(&signature_nodes, "call", "", signature_callee, 0, 1, 2, 1, 0, "", "")
    integer_call_wrapper: usize = add_node(&signature_nodes, "call_arg", "", integer_argument, 0, 0, 0, 0, 0, "", "")
    signature_children.push(integer_call_wrapper)
    positional_integer_call: usize = add_node(&signature_nodes, "call", "", signature_callee, 0, 0, 3, 1, 0, "", "")
    signature_bindings: mutable darray[ProofKernelTypingBinding] = []
    signature_added: bool = proof_kernel_add_function_signature(&signature_bindings, "accept_integer", "boolean", "bool", "", "", 0, 0, 901, 1)
    parameter_added: bool = proof_kernel_add_function_parameter(&signature_bindings, "accept_integer", "value", "integer", "i64", "", "", 0, 0, 901, 0, false, false)
    integer_value_added: bool = proof_kernel_add_typing_binding(&signature_bindings, "value", "integer_value", "", "integer", "i64", "", "")
    signature_boolean_value_added: bool = proof_kernel_add_typing_binding(&signature_bindings, "value", "boolean_value", "", "boolean", "bool", "", "")
    return 48 if not signature_added or not parameter_added or not integer_value_added or not signature_boolean_value_added
    signature_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: signature_bindings}
    return 49 if proof_kernel_replay_proposition_formation_report(&signature_nodes, &signature_children, signature_environment, [], positional_boolean_call)
    return 50 if not proof_kernel_replay_goal_report_typed(&signature_nodes, &signature_children, signature_environment, facts_one(named_integer_call), named_integer_call)
    return 51 if not proof_kernel_replay_goal_report_typed(&signature_nodes, &signature_children, signature_environment, facts_one(positional_integer_call), positional_integer_call)

    reference_callee: usize = add_node(&signature_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "accept_boolean_reference", "")
    reference_value: usize = add_node(&signature_nodes, "unary", "&", boolean_argument, 0, 0, 0, 0, 0, "", "")
    reference_wrapper: usize = add_node(&signature_nodes, "call_arg", "", reference_value, 0, 0, 0, 0, 0, "", "")
    signature_children.push(reference_wrapper)
    reference_call: usize = add_node(&signature_nodes, "call", "", reference_callee, 0, 0, 4, 1, 0, "", "")
    forwarded_reference_wrapper: usize = add_node(&signature_nodes, "call_arg", "", boolean_argument, 0, 0, 0, 0, 0, "", "")
    signature_children.push(forwarded_reference_wrapper)
    forwarded_reference_call: usize = add_node(&signature_nodes, "call", "", reference_callee, 0, 0, 5, 1, 0, "", "")
    wrong_reference_value: usize = add_node(&signature_nodes, "unary", "&", integer_argument, 0, 0, 0, 0, 0, "", "")
    wrong_reference_wrapper: usize = add_node(&signature_nodes, "call_arg", "", wrong_reference_value, 0, 0, 0, 0, 0, "", "")
    signature_children.push(wrong_reference_wrapper)
    wrong_reference_call: usize = add_node(&signature_nodes, "call", "", reference_callee, 0, 0, 6, 1, 0, "", "")
    reference_signature_added: bool = proof_kernel_add_function_signature(&signature_bindings, "accept_boolean_reference", "boolean", "bool", "", "", 0, 0, 902, 1)
    reference_parameter_added: bool = proof_kernel_add_function_parameter(&signature_bindings, "accept_boolean_reference", "flag", "boolean", "bool", "", "", 0, 0, 902, 0, false, true)
    return 52 if not reference_signature_added or not reference_parameter_added
    reference_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: signature_bindings}
    return 53 if not proof_kernel_replay_proposition_formation_report(&signature_nodes, &signature_children, reference_environment, [], reference_call)
    return 54 if not proof_kernel_replay_proposition_formation_report(&signature_nodes, &signature_children, reference_environment, [], forwarded_reference_call)
    return 55 if proof_kernel_replay_proposition_formation_report(&signature_nodes, &signature_children, reference_environment, [], wrong_reference_call)

    # Field selection is typed by both the receiver's declared named type and the field table.
    field_nodes: mutable darray[ProofKernelNode] = []
    field_children: mutable darray[usize] = []
    record_root: usize = add_node(&field_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "record", "")
    integer_field: usize = add_node(&field_nodes, "field", "", record_root, 0, 0, 0, 0, 0, "count", "")
    boolean_field: usize = add_node(&field_nodes, "field", "", record_root, 0, 0, 0, 0, 0, "enabled", "")
    field_bindings: mutable darray[ProofKernelTypingBinding] = []
    field_receiver_added: bool = proof_kernel_add_typing_binding_with_identity(&field_bindings, "value", "record", "", "named", "Flags", "", "", 501, 0, 0)
    integer_field_added: bool = proof_kernel_add_typing_binding_with_identity(&field_bindings, "field", "count", "Flags", "integer", "i64", "", "", 0, 501, 0)
    boolean_field_added: bool = proof_kernel_add_typing_binding_with_identity(&field_bindings, "field", "enabled", "Flags", "boolean", "bool", "", "", 0, 501, 0)
    return 11 if not field_receiver_added or not integer_field_added or not boolean_field_added
    field_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: field_bindings}
    return 12 if proof_kernel_replay_proposition_formation_report(&field_nodes, &field_children, field_environment, facts_one(integer_field), integer_field)
    return 13 if not proof_kernel_replay_goal_report_typed(&field_nodes, &field_children, field_environment, facts_one(boolean_field), boolean_field)

    # Indexing checks the collection's declared element sort, not the `index` node kind.
    index_nodes: mutable darray[ProofKernelNode] = []
    index_children: mutable darray[usize] = []
    flags_root: usize = add_node(&index_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "flags", "")
    values_root: usize = add_node(&index_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "values", "")
    index_zero: usize = add_node(&index_nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
    boolean_element: usize = add_node(&index_nodes, "index", "", flags_root, index_zero, 0, 0, 0, 0, "", "")
    integer_element: usize = add_node(&index_nodes, "index", "", values_root, index_zero, 0, 0, 0, 0, "", "")
    fractional_index: usize = add_node(&index_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "fractional", "")
    invalid_float_index: usize = add_node(&index_nodes, "index", "", flags_root, fractional_index, 0, 0, 0, 0, "", "")
    index_bindings: mutable darray[ProofKernelTypingBinding] = []
    boolean_array_added: bool = proof_kernel_add_typing_binding(&index_bindings, "value", "flags", "", "container", "darray", "boolean", "bool")
    integer_array_added: bool = proof_kernel_add_typing_binding(&index_bindings, "value", "values", "", "container", "darray", "integer", "i64")
    float_index_added: bool = proof_kernel_add_typing_binding(&index_bindings, "value", "fractional", "", "floating", "f64", "", "")
    return 14 if not boolean_array_added or not integer_array_added or not float_index_added
    index_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: index_bindings}
    return 15 if proof_kernel_replay_proposition_formation_report(&index_nodes, &index_children, index_environment, facts_one(integer_element), integer_element)
    return 16 if not proof_kernel_replay_goal_report_typed(&index_nodes, &index_children, index_environment, facts_one(boolean_element), boolean_element)
    return 40 if proof_kernel_replay_proposition_formation_report(&index_nodes, &index_children, index_environment, [], invalid_float_index)

    # A nested non-Boolean call may not hide below a logical constructor.
    return 17 if proof_kernel_replay_proposition_formation_report(&nested_nodes, &nested_children, integer_call_environment, facts_one(nested_goal), nested_goal)

    # Abstract propositions require explicit proposition declarations, independently of facts.
    proposition_bindings: mutable darray[ProofKernelTypingBinding] = []
    proposition_added: bool = proof_kernel_add_typing_binding(&proposition_bindings, "proposition", "P", "", "proposition", "Prop", "", "")
    return 18 if not proposition_added
    proposition_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: proposition_bindings}
    return 19 if not proof_kernel_replay_goal_report_typed(&abstract_nodes, &abstract_children, proposition_environment, facts_one(abstract_proposition), abstract_proposition)
    abstract_exact: bool = proof_kernel_replay_tactic_step(&abstract_nodes, &abstract_children, "exact", true, false, true, facts_one(abstract_proposition), abstract_proposition, facts_one(abstract_proposition), abstract_proposition, 0, false, 0, false, 0, false, "")
    return 67 if not abstract_exact
    typed_abstract_exact: bool = proof_kernel_replay_tactic_step_typed(&abstract_nodes, &abstract_children, proposition_environment, "exact", true, false, true, facts_one(abstract_proposition), abstract_proposition, facts_one(abstract_proposition), abstract_proposition, 0, false, 0, false, 0, false, "")
    return 68 if not typed_abstract_exact

    boolean_value_nodes: mutable darray[ProofKernelNode] = []
    boolean_value_children: mutable darray[usize] = []
    boolean_value_root: usize = add_node(&boolean_value_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "flag", "")
    boolean_value_bindings: mutable darray[ProofKernelTypingBinding] = []
    boolean_value_added: bool = proof_kernel_add_typing_binding(&boolean_value_bindings, "value", "flag", "", "boolean", "bool", "", "")
    return 20 if not boolean_value_added
    boolean_value_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: boolean_value_bindings}
    return 21 if not proof_kernel_replay_goal_report_typed(&boolean_value_nodes, &boolean_value_children, boolean_value_environment, facts_one(boolean_value_root), boolean_value_root)

    result_shadow_bindings: mutable darray[ProofKernelTypingBinding] = []
    result_flag_added: bool = proof_kernel_add_typing_binding(&result_shadow_bindings, "value", "flag", "", "boolean", "bool", "", "")
    result_added: bool = proof_kernel_add_typing_binding(&result_shadow_bindings, "value", "result", "", "boolean", "bool", "", "")
    return 22 if not result_flag_added or not result_added
    result_shadow_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: result_shadow_bindings}
    return 23 if not proof_kernel_replay_proposition_formation_report(&boolean_value_nodes, &boolean_value_children, result_shadow_environment, [], boolean_value_root)

    numeric_nodes: mutable darray[ProofKernelNode] = []
    numeric_children: mutable darray[usize] = []
    numeric_left: usize = add_node(&numeric_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "left", "")
    numeric_right: usize = add_node(&numeric_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "right", "")
    numeric_comparison: usize = add_node(&numeric_nodes, "binary", "==", numeric_left, numeric_right, 0, 0, 0, 0, "", "")
    numeric_bindings: mutable darray[ProofKernelTypingBinding] = []
    numeric_left_added: bool = proof_kernel_add_typing_binding(&numeric_bindings, "value", "left", "", "integer", "u8", "", "")
    numeric_right_added: bool = proof_kernel_add_typing_binding(&numeric_bindings, "value", "right", "", "integer", "i64", "", "")
    return 24 if not numeric_left_added or not numeric_right_added
    numeric_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: numeric_bindings}
    return 25 if not proof_kernel_replay_proposition_formation_report(&numeric_nodes, &numeric_children, numeric_environment, [], numeric_comparison)

    # Mixed numeric comparisons are a source-language rule, but sort equality used by
    # branch/container/rewrite typing must still retain each exact type spelling.
    width_nodes: mutable darray[ProofKernelNode] = []
    width_children: mutable darray[usize] = []
    narrow_value: usize = add_node(&width_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "narrow", "")
    wide_value: usize = add_node(&width_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "wide", "")
    width_equality: usize = add_node(&width_nodes, "binary", "==", narrow_value, wide_value, 0, 0, 0, 0, "", "")
    width_bindings: mutable darray[ProofKernelTypingBinding] = []
    narrow_added: bool = proof_kernel_add_typing_binding(&width_bindings, "value", "narrow", "", "integer", "u8", "", "")
    wide_added: bool = proof_kernel_add_typing_binding(&width_bindings, "value", "wide", "", "integer", "i64", "", "")
    return 41 if not narrow_added or not wide_added
    width_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: width_bindings}
    return 42 if not proof_kernel_replay_proposition_formation_report(&width_nodes, &width_children, width_environment, [], width_equality)
    mismatched_width_rewrite: bool = proof_kernel_replay_tactic_step_typed(&width_nodes, &width_children, width_environment, "rewrite", true, false, false, facts_one(width_equality), width_equality, facts_one(width_equality), width_equality, narrow_value, true, wide_value, true, 0, false, "")
    return 43 if mismatched_width_rewrite

    # The typed API deliberately trusts its explicit declaration environment. This forged
    # signature demonstrates the boundary: source-bound callers must derive signatures from
    # the compiler-checked Elisa environment, not use this raw API to certify source types.
    forged_boolean_bindings: mutable darray[ProofKernelTypingBinding] = []
    forged_boolean_added: bool = proof_kernel_add_typing_binding(&forged_boolean_bindings, "function", "read_integer", "", "boolean", "bool", "", "")
    return 26 if not forged_boolean_added
    forged_boolean_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: forged_boolean_bindings}
    return 27 if not proof_kernel_replay_proposition_formation_report(&call_nodes, &call_children, forged_boolean_environment, [], call_term)

    # An invalid binding is not a valid substitute for a missing or forged declaration.
    malformed_bindings: mutable darray[ProofKernelTypingBinding] = []
    malformed_added: bool = proof_kernel_add_typing_binding(&malformed_bindings, "field", "enabled", "", "boolean", "bool", "", "")
    return 28 if not malformed_added
    malformed_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: malformed_bindings}
    return 29 if proof_kernel_replay_proposition_formation_report(&boolean_call_nodes, &boolean_call_children, malformed_environment, [], boolean_call)

    # Malformed propositions must be refused through tactic actions too, even when the raw
    # abstract-calculus transition is valid. This exact/assumption-shaped case would otherwise
    # derive an i64 call from the identical opaque fact.
    tactic_true: usize = add_node(&call_nodes, "bool", "", 0, 0, 0, 0, 0, 1, "", "")
    raw_assumption: bool = proof_kernel_replay_tactic_step(&call_nodes, &call_children, "assumption", true, false, true, facts_one(call_term), call_term, facts_one(call_term), call_term, 0, false, 0, false, 0, false, "")
    return 30 if not raw_assumption
    typed_assumption: bool = proof_kernel_replay_tactic_step_typed(&call_nodes, &call_children, integer_call_environment, "assumption", true, false, true, facts_one(call_term), call_term, facts_one(call_term), call_term, 0, false, 0, false, 0, false, "")
    return 31 if typed_assumption
    raw_exact: bool = proof_kernel_replay_tactic_step(&call_nodes, &call_children, "exact", true, false, true, facts_one(call_term), call_term, facts_one(call_term), call_term, 0, false, 0, false, 0, false, "")
    return 64 if not raw_exact
    typed_exact: bool = proof_kernel_replay_tactic_step_typed(&call_nodes, &call_children, integer_call_environment, "exact", true, false, true, facts_one(call_term), call_term, facts_one(call_term), call_term, 0, false, 0, false, 0, false, "")
    return 65 if typed_exact

    # The raw `have` transition is also valid for an opaque integer field atom, but typed replay
    # must not turn that value into a proposition merely by moving it into the fact list.
    raw_have: bool = proof_kernel_replay_tactic_step(&field_nodes, &field_children, "have", true, false, false, facts_one(integer_field), boolean_field, facts_two(integer_field, integer_field), boolean_field, integer_field, true, 0, false, 0, false, "")
    return 32 if not raw_have
    typed_have: bool = proof_kernel_replay_tactic_step_typed(&field_nodes, &field_children, field_environment, "have", true, false, false, facts_one(integer_field), boolean_field, facts_two(integer_field, integer_field), boolean_field, integer_field, true, 0, false, 0, false, "")
    return 33 if typed_have

    # Branch replay must type-check the whole parent/child state, not only the newly exposed
    # branch proposition. The abstract branch transition is valid but carries an i64 fact.
    branch_nodes: mutable darray[ProofKernelNode] = []
    branch_children: mutable darray[usize] = []
    branch_callee: usize = add_node(&branch_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "read_integer", "")
    branch_integer_call: usize = add_node(&branch_nodes, "call", "", branch_callee, 0, 0, 0, 0, 0, "", "")
    branch_p: usize = add_node(&branch_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "P", "")
    branch_q: usize = add_node(&branch_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "Q", "")
    branch_disjunction: usize = add_node(&branch_nodes, "binary", "or", branch_p, branch_q, 0, 0, 0, 0, "", "")
    branch_bindings: mutable darray[ProofKernelTypingBinding] = []
    branch_function_added: bool = proof_kernel_add_typing_binding(&branch_bindings, "function", "read_integer", "", "integer", "i64", "", "")
    branch_p_added: bool = proof_kernel_add_typing_binding(&branch_bindings, "proposition", "P", "", "proposition", "Prop", "", "")
    branch_q_added: bool = proof_kernel_add_typing_binding(&branch_bindings, "proposition", "Q", "", "proposition", "Prop", "", "")
    return 34 if not branch_function_added or not branch_p_added or not branch_q_added
    branch_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: branch_bindings}
    raw_branch: bool = proof_kernel_replay_tactic_branch(&branch_nodes, &branch_children, "cases", facts_two(branch_integer_call, branch_disjunction), branch_p, facts_two(branch_integer_call, branch_p), branch_p, facts_two(branch_integer_call, branch_q), branch_p)
    return 35 if not raw_branch
    typed_branch: bool = proof_kernel_replay_tactic_branch_typed(&branch_nodes, &branch_children, branch_environment, "cases", facts_two(branch_integer_call, branch_disjunction), branch_p, facts_two(branch_integer_call, branch_p), branch_p, facts_two(branch_integer_call, branch_q), branch_p)
    return 36 if typed_branch

    # Rewriting is likewise rejected when an opaque non-Boolean call is smuggled into a
    # proposition equality; the raw calculus still accepts the abstract equality atom.
    rewrite_nodes: mutable darray[ProofKernelNode] = []
    rewrite_children: mutable darray[usize] = []
    rewrite_x: usize = add_node(&rewrite_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "x", "")
    rewrite_p: usize = add_node(&rewrite_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "P", "")
    rewrite_equality: usize = add_node(&rewrite_nodes, "binary", "==", rewrite_x, rewrite_p, 0, 0, 0, 0, "", "")
    raw_rewrite: bool = proof_kernel_replay_tactic_step(&rewrite_nodes, &rewrite_children, "rewrite", true, false, false, facts_one(rewrite_equality), rewrite_x, facts_one(rewrite_equality), rewrite_p, rewrite_x, true, rewrite_p, true, 0, false, "")
    return 37 if not raw_rewrite
    rewrite_bindings: mutable darray[ProofKernelTypingBinding] = []
    rewrite_value_added: bool = proof_kernel_add_typing_binding(&rewrite_bindings, "value", "x", "", "integer", "i64", "", "")
    rewrite_proposition_added: bool = proof_kernel_add_typing_binding(&rewrite_bindings, "proposition", "P", "", "proposition", "Prop", "", "")
    return 38 if not rewrite_value_added or not rewrite_proposition_added
    rewrite_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: rewrite_bindings}
    typed_rewrite: bool = proof_kernel_replay_tactic_step_typed(&rewrite_nodes, &rewrite_children, rewrite_environment, "rewrite", true, false, false, facts_one(rewrite_equality), rewrite_x, facts_one(rewrite_equality), rewrite_p, rewrite_x, true, rewrite_p, true, 0, false, "")
    return 39 if typed_rewrite

    # Quantifier binders get one type from their finite range. Every element must agree; using
    # only the first set/tuple/dictionary element would admit a false typing premise.
    quantifier_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: []}
    quantifier_nodes: mutable darray[ProofKernelNode] = []
    quantifier_children: mutable darray[usize] = []
    quantifier_one: usize = add_node(&quantifier_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
    quantifier_two: usize = add_node(&quantifier_nodes, "int", "", 0, 0, 0, 0, 0, 2, "", "")
    quantifier_children.push(quantifier_one)
    quantifier_children.push(quantifier_two)
    quantifier_set: usize = add_node(&quantifier_nodes, "set", "", 0, 0, 0, 0, 2, 0, "", "")
    quantifier_value: usize = add_node(&quantifier_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "value", "")
    quantifier_threshold: usize = add_node(&quantifier_nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
    quantifier_body: usize = add_node(&quantifier_nodes, "binary", ">=", quantifier_value, quantifier_threshold, 0, 0, 0, 0, "", "")
    valid_set_quantifier: usize = add_node(&quantifier_nodes, "quantifier", "forall", quantifier_set, quantifier_body, 1, 0, 0, 0, "value", "")
    return 40 if not proof_kernel_replay_proposition_formation_report(&quantifier_nodes, &quantifier_children, quantifier_environment, [], valid_set_quantifier)

    heterogeneous_set_nodes: mutable darray[ProofKernelNode] = []
    heterogeneous_set_children: mutable darray[usize] = []
    heterogeneous_integer: usize = add_node(&heterogeneous_set_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
    heterogeneous_boolean: usize = add_node(&heterogeneous_set_nodes, "bool", "", 0, 0, 0, 0, 0, 1, "", "")
    heterogeneous_set_children.push(heterogeneous_integer)
    heterogeneous_set_children.push(heterogeneous_boolean)
    heterogeneous_set: usize = add_node(&heterogeneous_set_nodes, "set", "", 0, 0, 0, 0, 2, 0, "", "")
    heterogeneous_body: usize = add_node(&heterogeneous_set_nodes, "bool", "", 0, 0, 0, 0, 0, 1, "", "")
    heterogeneous_quantifier: usize = add_node(&heterogeneous_set_nodes, "quantifier", "forall", heterogeneous_set, heterogeneous_body, 1, 0, 0, 0, "value", "")
    return 41 if proof_kernel_replay_proposition_formation_report(&heterogeneous_set_nodes, &heterogeneous_set_children, quantifier_environment, [], heterogeneous_quantifier)

    heterogeneous_tuple_nodes: mutable darray[ProofKernelNode] = []
    heterogeneous_tuple_children: mutable darray[usize] = []
    tuple_integer: usize = add_node(&heterogeneous_tuple_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
    tuple_boolean: usize = add_node(&heterogeneous_tuple_nodes, "bool", "", 0, 0, 0, 0, 0, 1, "", "")
    heterogeneous_tuple_children.push(tuple_integer)
    heterogeneous_tuple_children.push(tuple_boolean)
    heterogeneous_tuple: usize = add_node(&heterogeneous_tuple_nodes, "tuple", "", 0, 0, 0, 0, 2, 0, "", "")
    tuple_body: usize = add_node(&heterogeneous_tuple_nodes, "bool", "", 0, 0, 0, 0, 0, 1, "", "")
    heterogeneous_tuple_quantifier: usize = add_node(&heterogeneous_tuple_nodes, "quantifier", "forall", heterogeneous_tuple, tuple_body, 1, 0, 0, 0, "value", "")
    return 42 if proof_kernel_replay_proposition_formation_report(&heterogeneous_tuple_nodes, &heterogeneous_tuple_children, quantifier_environment, [], heterogeneous_tuple_quantifier)

    constructed_bindings: mutable darray[ProofKernelTypingBinding] = []
    constructed_type_added: bool = proof_kernel_add_typing_binding_with_identity(&constructed_bindings, "type", "Pair", "", "named", "Pair", "", "", 601, 0, 0)
    constructed_field_added: bool = proof_kernel_add_typing_binding_with_identity(&constructed_bindings, "field", "left", "Pair", "integer", "i64", "", "", 0, 601, 0)
    return 43 if not constructed_type_added or not constructed_field_added
    constructed_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: constructed_bindings}
    constructed_nodes: mutable darray[ProofKernelNode] = []
    constructed_children: mutable darray[usize] = []
    constructed_type: usize = add_node(&constructed_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "Pair", "")
    constructed_integer: usize = add_node(&constructed_nodes, "int", "", 0, 0, 0, 0, 0, 7, "", "")
    constructed_field: usize = add_node(&constructed_nodes, "field-init", "", constructed_integer, 0, 0, 0, 0, 0, "left", "")
    constructed_children.push(constructed_field)
    constructed_pair: usize = add_node(&constructed_nodes, "construct", "", constructed_type, 0, 0, 0, 1, 0, "", "")
    constructed_projection: usize = add_node(&constructed_nodes, "field", "", constructed_pair, 0, 0, 0, 0, 0, "left", "")
    constructed_equality: usize = add_node(&constructed_nodes, "binary", "==", constructed_projection, constructed_integer, 0, 0, 0, 0, "", "")
    return 44 if not proof_kernel_replay_proposition_formation_report(&constructed_nodes, &constructed_children, constructed_environment, [], constructed_equality)

    wrong_construct_nodes: mutable darray[ProofKernelNode] = []
    wrong_construct_children: mutable darray[usize] = []
    wrong_construct_type: usize = add_node(&wrong_construct_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "Pair", "")
    wrong_construct_value: usize = add_node(&wrong_construct_nodes, "bool", "", 0, 0, 0, 0, 0, 1, "", "")
    wrong_construct_field: usize = add_node(&wrong_construct_nodes, "field-init", "", wrong_construct_value, 0, 0, 0, 0, 0, "left", "")
    wrong_construct_children.push(wrong_construct_field)
    wrong_construct_pair: usize = add_node(&wrong_construct_nodes, "construct", "", wrong_construct_type, 0, 0, 0, 1, 0, "", "")
    wrong_construct_projection: usize = add_node(&wrong_construct_nodes, "field", "", wrong_construct_pair, 0, 0, 0, 0, 0, "left", "")
    wrong_construct_equality: usize = add_node(&wrong_construct_nodes, "binary", "==", wrong_construct_projection, wrong_construct_value, 0, 0, 0, 0, "", "")
    return 45 if proof_kernel_replay_proposition_formation_report(&wrong_construct_nodes, &wrong_construct_children, constructed_environment, [], wrong_construct_equality)

    # Multi-axis indexing walks the declared nested array shape one integral index at a time.
    nested_array_bindings: mutable darray[ProofKernelTypingBinding] = []
    outer_array_type_added: bool = proof_kernel_add_typing_binding_with_identity(&nested_array_bindings, "type", "array", "", "container", "array", "container", "array", 100, 0, 200)
    inner_array_type_added: bool = proof_kernel_add_typing_binding_with_identity(&nested_array_bindings, "type", "array", "", "container", "array", "integer", "i64", 200, 0, 0)
    grid_value_added: bool = proof_kernel_add_typing_binding_with_identity(&nested_array_bindings, "value", "grid", "", "container", "array", "container", "array", 100, 0, 200)
    row_value_added: bool = proof_kernel_add_typing_binding(&nested_array_bindings, "value", "row", "", "integer", "usize", "", "")
    column_value_added: bool = proof_kernel_add_typing_binding(&nested_array_bindings, "value", "column", "", "integer", "usize", "", "")
    return 56 if not outer_array_type_added or not inner_array_type_added or not grid_value_added or not row_value_added or not column_value_added
    nested_array_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: nested_array_bindings}
    nested_array_nodes: mutable darray[ProofKernelNode] = []
    nested_array_children: mutable darray[usize] = []
    grid_root: usize = add_node(&nested_array_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "grid", "")
    row_root: usize = add_node(&nested_array_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "row", "")
    column_root: usize = add_node(&nested_array_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "column", "")
    nested_array_children.push(row_root)
    nested_array_children.push(column_root)
    nested_array_term: usize = add_node(&nested_array_nodes, "index-n", "", grid_root, 0, 0, 0, 2, 0, "", "")
    nested_array_goal: usize = add_node(&nested_array_nodes, "binary", "==", nested_array_term, nested_array_term, 0, 0, 0, 0, "", "")
    return 57 if not proof_kernel_replay_proposition_formation_report(&nested_array_nodes, &nested_array_children, nested_array_environment, [], nested_array_goal)
    fractional_axis: usize = add_node(&nested_array_nodes, "float", "", 0, 0, 0, 0, 0, 0, "", "")
    nested_array_children.push(fractional_axis)
    nested_array_children.push(column_root)
    invalid_nested_array_term: usize = add_node(&nested_array_nodes, "index-n", "", grid_root, 0, 0, 2, 2, 0, "", "")
    invalid_nested_array_goal: usize = add_node(&nested_array_nodes, "binary", "==", invalid_nested_array_term, invalid_nested_array_term, 0, 0, 0, 0, "", "")
    return 58 if proof_kernel_replay_proposition_formation_report(&nested_array_nodes, &nested_array_children, nested_array_environment, [], invalid_nested_array_goal)
    missing_inner_bindings: mutable darray[ProofKernelTypingBinding] = []
    missing_outer_type_added: bool = proof_kernel_add_typing_binding_with_identity(&missing_inner_bindings, "type", "array", "", "container", "array", "container", "array", 100, 0, 200)
    missing_grid_added: bool = proof_kernel_add_typing_binding_with_identity(&missing_inner_bindings, "value", "grid", "", "container", "array", "container", "array", 100, 0, 200)
    missing_row_added: bool = proof_kernel_add_typing_binding(&missing_inner_bindings, "value", "row", "", "integer", "usize", "", "")
    missing_column_added: bool = proof_kernel_add_typing_binding(&missing_inner_bindings, "value", "column", "", "integer", "usize", "", "")
    return 59 if not missing_outer_type_added or not missing_grid_added or not missing_row_added or not missing_column_added
    missing_inner_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: missing_inner_bindings}
    return 60 if proof_kernel_replay_proposition_formation_report(&nested_array_nodes, &nested_array_children, missing_inner_environment, [], nested_array_goal)

    # Conflicting descriptors for the same structural type identity make the lookup ambiguous.
    # Do not let the first declaration silently determine the element sort.
    ambiguous_array_bindings: mutable darray[ProofKernelTypingBinding] = []
    ambiguous_outer_added: bool = proof_kernel_add_typing_binding_with_identity(&ambiguous_array_bindings, "type", "array", "", "container", "array", "container", "array", 100, 0, 200)
    ambiguous_integer_inner_added: bool = proof_kernel_add_typing_binding_with_identity(&ambiguous_array_bindings, "type", "array", "", "container", "array", "integer", "i64", 200, 0, 0)
    ambiguous_boolean_inner_added: bool = proof_kernel_add_typing_binding_with_identity(&ambiguous_array_bindings, "type", "array", "", "container", "array", "boolean", "bool", 200, 0, 0)
    ambiguous_grid_added: bool = proof_kernel_add_typing_binding_with_identity(&ambiguous_array_bindings, "value", "grid", "", "container", "array", "container", "array", 100, 0, 200)
    ambiguous_row_added: bool = proof_kernel_add_typing_binding(&ambiguous_array_bindings, "value", "row", "", "integer", "usize", "", "")
    ambiguous_column_added: bool = proof_kernel_add_typing_binding(&ambiguous_array_bindings, "value", "column", "", "integer", "usize", "", "")
    return 79 if not ambiguous_outer_added or not ambiguous_integer_inner_added or not ambiguous_boolean_inner_added or not ambiguous_grid_added or not ambiguous_row_added or not ambiguous_column_added
    ambiguous_array_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: ambiguous_array_bindings}
    return 80 if proof_kernel_replay_proposition_formation_report(&nested_array_nodes, &nested_array_children, ambiguous_array_environment, [], nested_array_goal)

    # Three levels expose the identity-erasure bug: the innermost integer and Boolean array
    # shapes became indistinguishable after two identity-less container constructors.
    nested_literal_nodes: mutable darray[ProofKernelNode] = []
    nested_literal_children: mutable darray[usize] = []
    nested_literal_integer: usize = add_node(&nested_literal_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
    nested_literal_boolean: usize = add_node(&nested_literal_nodes, "bool", "", 0, 0, 0, 0, 0, 1, "", "")
    nested_literal_children.push(nested_literal_integer)
    nested_literal_integer_array: usize = add_node(&nested_literal_nodes, "array", "", 0, 0, 0, 0, 1, 0, "", "")
    nested_literal_children.push(nested_literal_boolean)
    nested_literal_boolean_array: usize = add_node(&nested_literal_nodes, "array", "", 0, 0, 1, 1, 1, 0, "", "")
    nested_literal_children.push(nested_literal_integer_array)
    nested_literal_integer_matrix: usize = add_node(&nested_literal_nodes, "array", "", 0, 0, 2, 1, 1, 0, "", "")
    nested_literal_children.push(nested_literal_boolean_array)
    nested_literal_boolean_matrix: usize = add_node(&nested_literal_nodes, "array", "", 0, 0, 3, 1, 1, 0, "", "")
    nested_literal_children.push(nested_literal_integer_matrix)
    nested_literal_children.push(nested_literal_boolean_matrix)
    heterogeneous_nested_array: usize = add_node(&nested_literal_nodes, "array", "", 0, 0, 0, 4, 2, 0, "", "")
    nested_literal_equality: usize = add_node(&nested_literal_nodes, "binary", "==", heterogeneous_nested_array, heterogeneous_nested_array, 0, 0, 0, 0, "", "")
    return 66 if proof_kernel_replay_proposition_formation_report(&nested_literal_nodes, &nested_literal_children, quantifier_environment, [], nested_literal_equality)

    enum_member_status: i64 = enum_member_proposition_tests()
    return enum_member_status if enum_member_status != 0
    enum_variant_status: i64 = enum_variant_proposition_tests()
    return enum_variant_status if enum_variant_status != 0
    ambiguous_enum_status: i64 = ambiguous_enum_identity_tests()
    return ambiguous_enum_status if ambiguous_enum_status != 0
    lexical_identity_status: i64 = lexical_identity_proposition_tests()
    return lexical_identity_status if lexical_identity_status != 0
    named_container_status: i64 = named_container_identity_tests()
    return 82 + named_container_status if named_container_status != 0
    split_environment_status: i64 = split_type_environment_tests()
    return 120 + split_environment_status if split_environment_status != 0
    string_call_status: i64 = kernel_string_literal_call_argument_tests()
    return 130 + string_call_status if string_call_status != 0
    return 140 if not kernel_source_string_literal_call_tests()
    record_update_status: i64 = kernel_record_update_proposition_tests()
    return 100 + record_update_status if record_update_status != 0
    numeric_call_status: i64 = kernel_numeric_call_argument_tests()
    return 110 + numeric_call_status if numeric_call_status != 0
    function_name_status: i64 = kernel_ambiguous_function_name_tests()
    return 150 + function_name_status if function_name_status != 0
    operator_shape_status: i64 = kernel_operator_shape_tests()
    return 160 + operator_shape_status if operator_shape_status != 0
    return 0
