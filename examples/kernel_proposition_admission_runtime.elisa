# Native reproducer for proposition formation in the source-neutral kernel. Before typing
# environments are added, the opaque value-shaped atoms below can be admitted as propositions
# merely because an identical fact is present. The abstract identifier case is intentionally
# positive: an explicitly declared proposition P is a legitimate assumption.
include "../src/proof/kernel_core.elisa"
include "../src/proof/kernel_replay.elisa"
using ElisaProofKernelCore
using ElisaProofKernelReplay

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    abstract_nodes: mutable darray[ProofKernelNode] = []
    abstract_children: mutable darray[usize] = []
    abstract_proposition: usize = add_node(&abstract_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "P", "")
    abstract_admitted: bool = proof_kernel_replay_goal_report(&abstract_nodes, &abstract_children, [abstract_proposition], abstract_proposition)
    return 1 if not abstract_admitted

    call_nodes: mutable darray[ProofKernelNode] = []
    call_children: mutable darray[usize] = []
    call_callee: usize = add_node(&call_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "read_integer", "")
    call_term: usize = add_node(&call_nodes, "call", "", call_callee, 0, 0, 0, 0, 0, "", "")
    call_as_proposition: bool = proof_kernel_replay_goal_report(&call_nodes, &call_children, [call_term], call_term)
    return 2 if call_as_proposition

    field_nodes: mutable darray[ProofKernelNode] = []
    field_children: mutable darray[usize] = []
    field_object: usize = add_node(&field_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "record", "")
    integer_field: usize = add_node(&field_nodes, "field", "", field_object, 0, 0, 0, 0, 0, "count", "")
    field_as_proposition: bool = proof_kernel_replay_goal_report(&field_nodes, &field_children, [integer_field], integer_field)
    return 3 if field_as_proposition

    index_nodes: mutable darray[ProofKernelNode] = []
    index_children: mutable darray[usize] = []
    index_object: usize = add_node(&index_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "values", "")
    zero_index: usize = add_node(&index_nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
    integer_element: usize = add_node(&index_nodes, "index", "", index_object, zero_index, 0, 0, 0, 0, "", "")
    index_as_proposition: bool = proof_kernel_replay_goal_report(&index_nodes, &index_children, [integer_element], integer_element)
    return 4 if index_as_proposition

    nested_nodes: mutable darray[ProofKernelNode] = []
    nested_children: mutable darray[usize] = []
    nested_callee: usize = add_node(&nested_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "read_integer", "")
    nested_call: usize = add_node(&nested_nodes, "call", "", nested_callee, 0, 0, 0, 0, 0, "", "")
    true_term: usize = add_node(&nested_nodes, "bool", "", 0, 0, 0, 0, 0, 1, "", "")
    nested_goal: usize = add_node(&nested_nodes, "binary", "and", nested_call, true_term, 0, 0, 0, 0, "", "")
    nested_as_proposition: bool = proof_kernel_replay_goal_report(&nested_nodes, &nested_children, [nested_goal], nested_goal)
    return 5 if nested_as_proposition

    return 0
