# Module constants passed by value to a recursive call that lends a shared collection. Each
# confined-lend certificate must replay: a module constant names static storage, so it carries
# no region lifetime. The qualified spelling says so directly; the producer spells a bare one
# with its module path, including from a block that extends the module, while a local that
# shadows the constant keeps its bare spelling and its binding. A root constant is spelled
# from the root namespace, unless the module declares a constant of the same name.
const ROOT_DEPTH: usize = 16
const LOCAL_DEPTH: usize = 7
const SIGNED_DEPTH: i64 = 64

module Limits:
    public:
        const DEPTH: usize = 64

module QualifiedArgument:
    private:
        const LOCAL_DEPTH: usize = 32

        struct Node:
            kind: sview
            left: usize

        def walk(nodes: darray[Node]&, root: usize, remaining: usize) -> bool:
            decreases remaining
            return false if root >= nodes.count or remaining < 1
            return walk(nodes, nodes[root].left, remaining - 1)

        def caller(nodes: darray[Node]&, root: usize) -> bool:
            return walk(nodes, root, Limits::DEPTH)

        def bare_caller(nodes: darray[Node]&, root: usize) -> bool:
            return walk(nodes, root, LOCAL_DEPTH)

        def root_caller(nodes: darray[Node]&, root: usize) -> bool:
            return walk(nodes, root, ROOT_DEPTH)

        def shadowing_caller(nodes: darray[Node]&, root: usize) -> bool:
            LOCAL_DEPTH: usize = 3
            return walk(nodes, root, LOCAL_DEPTH)

        def accept_signed(nodes: darray[Node]&, value: i64) -> bool:
            return nodes.count >= 0

        def nested_static_caller(nodes: darray[Node]&) -> bool:
            return accept_signed(nodes, -((SIGNED_DEPTH + 1)))

        def nested_shadowing_caller(nodes: darray[Node]&) -> bool:
            SIGNED_DEPTH: i64 = 5
            return accept_signed(nodes, -((SIGNED_DEPTH + 1)))

extend QualifiedArgument:
    private:
        def extended_caller(nodes: darray[Node]&, root: usize) -> bool:
            return walk(nodes, root, LOCAL_DEPTH)
