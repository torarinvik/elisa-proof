include "../src/proof/kernel_core.elisa"
include "../src/proof/kernel_replay.elisa"
using ElisaProofKernelCore
using ElisaProofKernelReplay

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    valid_region_nodes: mutable darray[ProofKernelNode] = []
    valid_region_children: mutable darray[usize] = []
    valid_region_open: usize = add_node(&valid_region_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "r", "")
    valid_region_operand: usize = add_node(&valid_region_nodes, "int", "", 0, 0, 0, 0, 0, 7, "", "")
    valid_region_alloc: usize = add_node(&valid_region_nodes, "resource-region-alloc", "", valid_region_operand, 0, 2, 0, 0, 0, "value", "r")
    valid_region_place: usize = add_node(&valid_region_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "value", "")
    valid_region_use: usize = add_node(&valid_region_nodes, "resource-use", "", valid_region_place, 0, 0, 0, 0, 0, "value", "")
    valid_region_close: usize = add_node(&valid_region_nodes, "resource-region-close", "", 0, 0, 0, 0, 0, 0, "r", "")
    valid_region_children.push(valid_region_open)
    valid_region_children.push(valid_region_alloc)
    valid_region_children.push(valid_region_close)
    valid_region_root: usize = add_node(&valid_region_nodes, "resource-safety", "", 0, 0, 0, 0, 3, 0, "valid-region", "resource-v1")
    valid_region_admitted: bool = proof_kernel_replay_resource_report(&valid_region_nodes, &valid_region_children, [], valid_region_root)
    return 1 if not valid_region_admitted

    # A call that lends only references the caller already holds is admitted from the trace
    # alone: no callee summary root, no region map, every actual a live place, and every declared
    # formal mode one whose caller-side permission replay can re-derive. The claim is exactly
    # that, so a moved place, a capability handed to a by-value formal, a miscounted argument
    # list, a reused event, an unbound place, a permuted mode list and a shared lend across a
    # live exclusive borrow must each be refused.
    shared_nodes: mutable darray[ProofKernelNode] = []
    shared_children: mutable darray[usize] = []
    shared_bind: usize = add_node(&shared_nodes, "resource-bind", "value", 0, 0, 0, 0, 0, 0, "items", "")
    shared_place: usize = add_node(&shared_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "items", "")
    shared_argument: usize = add_node(&shared_nodes, "resource-call-arg", "borrow", shared_place, 0, 0, 0, 0, 0, "values", "")
    shared_formal: usize = add_node(&shared_nodes, "resource-call-formal", "external-shared", 0, 0, 0, 0, 0, 0, "values", "")
    shared_argument_start: usize = shared_children.count
    shared_children.push(shared_argument)
    shared_children.push(shared_formal)
    shared_call: usize = add_node(&shared_nodes, "resource-call-lend", "", 0, 0, 1, shared_argument_start, 2, 0, "peek", "")
    shared_trace_start: usize = shared_children.count
    shared_children.push(shared_bind)
    shared_children.push(shared_call)
    shared_root: usize = add_node(&shared_nodes, "resource-safety", "", 0, 0, 0, shared_trace_start, 2, 0, "shared-read", "resource-v1")
    return 2 if not proof_kernel_replay_resource_report(&shared_nodes, &shared_children, [], shared_root)

    # The same event after the place has been moved away: the callee would be lent a capability
    # the caller no longer holds.
    moved_nodes: mutable darray[ProofKernelNode] = []
    moved_children: mutable darray[usize] = []
    moved_bind: usize = add_node(&moved_nodes, "resource-bind", "value", 0, 0, 0, 0, 0, 0, "items", "")
    moved_place: usize = add_node(&moved_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "items", "")
    moved_move: usize = add_node(&moved_nodes, "resource-move", "", moved_place, 0, 0, 0, 0, 0, "items", "")
    moved_argument: usize = add_node(&moved_nodes, "resource-call-arg", "borrow", moved_place, 0, 0, 0, 0, 0, "values", "")
    moved_formal: usize = add_node(&moved_nodes, "resource-call-formal", "external-shared", 0, 0, 0, 0, 0, 0, "values", "")
    moved_argument_start: usize = moved_children.count
    moved_children.push(moved_argument)
    moved_children.push(moved_formal)
    moved_call: usize = add_node(&moved_nodes, "resource-call-lend", "", 0, 0, 1, moved_argument_start, 2, 0, "peek", "")
    moved_trace_start: usize = moved_children.count
    moved_children.push(moved_bind)
    moved_children.push(moved_move)
    moved_children.push(moved_call)
    moved_root: usize = add_node(&moved_nodes, "resource-safety", "", 0, 0, 0, moved_trace_start, 3, 0, "shared-after-move", "resource-v1")
    return 3 if proof_kernel_replay_resource_report(&moved_nodes, &moved_children, [], moved_root)

    # A capability handed to a by-value formal. A by-value parameter receives a copy or a move,
    # not a lend, so the call would not leave the caller's state untouched. An exclusive formal
    # has no encoding under this event at all, which is what makes the mode list safe to read.
    mode_nodes: mutable darray[ProofKernelNode] = []
    mode_children: mutable darray[usize] = []
    mode_bind: usize = add_node(&mode_nodes, "resource-bind", "value", 0, 0, 0, 0, 0, 0, "items", "")
    mode_place: usize = add_node(&mode_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "items", "")
    mode_argument: usize = add_node(&mode_nodes, "resource-call-arg", "borrow", mode_place, 0, 0, 0, 0, 0, "values", "")
    mode_formal: usize = add_node(&mode_nodes, "resource-call-formal", "value", 0, 0, 0, 0, 0, 0, "values", "")
    mode_argument_start: usize = mode_children.count
    mode_children.push(mode_argument)
    mode_children.push(mode_formal)
    mode_call: usize = add_node(&mode_nodes, "resource-call-lend", "", 0, 0, 1, mode_argument_start, 2, 0, "peek", "")
    mode_trace_start: usize = mode_children.count
    mode_children.push(mode_bind)
    mode_children.push(mode_call)
    mode_root: usize = add_node(&mode_nodes, "resource-safety", "", 0, 0, 0, mode_trace_start, 2, 0, "shared-mode", "resource-v1")
    return 4 if proof_kernel_replay_resource_report(&mode_nodes, &mode_children, [], mode_root)

    # An argument count that does not match the recorded child list would let an argument be
    # hidden from the liveness check, or let a mode stand in for an actual.
    count_nodes: mutable darray[ProofKernelNode] = []
    count_children: mutable darray[usize] = []
    count_bind: usize = add_node(&count_nodes, "resource-bind", "value", 0, 0, 0, 0, 0, 0, "items", "")
    count_place: usize = add_node(&count_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "items", "")
    count_argument: usize = add_node(&count_nodes, "resource-call-arg", "borrow", count_place, 0, 0, 0, 0, 0, "values", "")
    count_formal: usize = add_node(&count_nodes, "resource-call-formal", "external-shared", 0, 0, 0, 0, 0, 0, "values", "")
    count_argument_start: usize = count_children.count
    count_children.push(count_argument)
    count_children.push(count_formal)
    count_call: usize = add_node(&count_nodes, "resource-call-lend", "", 0, 0, 2, count_argument_start, 2, 0, "peek", "")
    count_trace_start: usize = count_children.count
    count_children.push(count_bind)
    count_children.push(count_call)
    count_root: usize = add_node(&count_nodes, "resource-safety", "", 0, 0, 0, count_trace_start, 2, 0, "shared-count", "resource-v1")
    return 5 if proof_kernel_replay_resource_report(&count_nodes, &count_children, [], count_root)

    # One event node may stand for one transition. Replaying the same root twice would let a
    # single recorded call justify an unbounded number of them.
    reuse_nodes: mutable darray[ProofKernelNode] = []
    reuse_children: mutable darray[usize] = []
    reuse_bind: usize = add_node(&reuse_nodes, "resource-bind", "value", 0, 0, 0, 0, 0, 0, "items", "")
    reuse_place: usize = add_node(&reuse_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "items", "")
    reuse_argument: usize = add_node(&reuse_nodes, "resource-call-arg", "borrow", reuse_place, 0, 0, 0, 0, 0, "values", "")
    reuse_formal: usize = add_node(&reuse_nodes, "resource-call-formal", "external-shared", 0, 0, 0, 0, 0, 0, "values", "")
    reuse_argument_start: usize = reuse_children.count
    reuse_children.push(reuse_argument)
    reuse_children.push(reuse_formal)
    reuse_call: usize = add_node(&reuse_nodes, "resource-call-lend", "", 0, 0, 1, reuse_argument_start, 2, 0, "peek", "")
    reuse_trace_start: usize = reuse_children.count
    reuse_children.push(reuse_bind)
    reuse_children.push(reuse_call)
    reuse_children.push(reuse_call)
    reuse_root: usize = add_node(&reuse_nodes, "resource-safety", "", 0, 0, 0, reuse_trace_start, 3, 0, "shared-reuse", "resource-v1")
    return 6 if proof_kernel_replay_resource_report(&reuse_nodes, &reuse_children, [], reuse_root)

    # An unbound place is not a capability the caller can lend.
    unbound_nodes: mutable darray[ProofKernelNode] = []
    unbound_children: mutable darray[usize] = []
    unbound_place: usize = add_node(&unbound_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "items", "")
    unbound_argument: usize = add_node(&unbound_nodes, "resource-call-arg", "borrow", unbound_place, 0, 0, 0, 0, 0, "values", "")
    unbound_formal: usize = add_node(&unbound_nodes, "resource-call-formal", "external-shared", 0, 0, 0, 0, 0, 0, "values", "")
    unbound_argument_start: usize = unbound_children.count
    unbound_children.push(unbound_argument)
    unbound_children.push(unbound_formal)
    unbound_call: usize = add_node(&unbound_nodes, "resource-call-lend", "", 0, 0, 1, unbound_argument_start, 2, 0, "peek", "")
    unbound_trace_start: usize = unbound_children.count
    unbound_children.push(unbound_call)
    unbound_root: usize = add_node(&unbound_nodes, "resource-safety", "", 0, 0, 0, unbound_trace_start, 1, 0, "shared-unbound", "resource-v1")
    return 7 if proof_kernel_replay_resource_report(&unbound_nodes, &unbound_children, [], unbound_root)

    # The mode list is paired with the actuals by formal name. Permuting it would let the harmless
    # mode of a scalar parameter stand in for the mode of the parameter that receives the place.
    pair_nodes: mutable darray[ProofKernelNode] = []
    pair_children: mutable darray[usize] = []
    pair_bind: usize = add_node(&pair_nodes, "resource-bind", "value", 0, 0, 0, 0, 0, 0, "items", "")
    pair_place: usize = add_node(&pair_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "items", "")
    pair_argument: usize = add_node(&pair_nodes, "resource-call-arg", "borrow", pair_place, 0, 0, 0, 0, 0, "values", "")
    pair_formal: usize = add_node(&pair_nodes, "resource-call-formal", "external-shared", 0, 0, 0, 0, 0, 0, "limit", "")
    pair_argument_start: usize = pair_children.count
    pair_children.push(pair_argument)
    pair_children.push(pair_formal)
    pair_call: usize = add_node(&pair_nodes, "resource-call-lend", "", 0, 0, 1, pair_argument_start, 2, 0, "peek", "")
    pair_trace_start: usize = pair_children.count
    pair_children.push(pair_bind)
    pair_children.push(pair_call)
    pair_root: usize = add_node(&pair_nodes, "resource-safety", "", 0, 0, 0, pair_trace_start, 2, 0, "shared-pairing", "resource-v1")
    return 8 if proof_kernel_replay_resource_report(&pair_nodes, &pair_children, [], pair_root)

    # Shared and exclusive access to one place cannot be live at the same time. Without a callee
    # summary nothing says the callee reads only through the reference being lent, so an exclusive
    # borrow of the lent place that is still live across the call refuses the event.
    alias_nodes: mutable darray[ProofKernelNode] = []
    alias_children: mutable darray[usize] = []
    alias_bind: usize = add_node(&alias_nodes, "resource-bind", "value", 0, 0, 0, 0, 0, 0, "items", "")
    alias_place: usize = add_node(&alias_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "items", "")
    alias_borrow: usize = add_node(&alias_nodes, "resource-bind", "mutable", alias_place, 0, 1, 0, 0, 0, "exclusive", "items")
    alias_argument: usize = add_node(&alias_nodes, "resource-call-arg", "borrow", alias_place, 0, 0, 0, 0, 0, "values", "")
    alias_formal: usize = add_node(&alias_nodes, "resource-call-formal", "external-shared", 0, 0, 0, 0, 0, 0, "values", "")
    alias_argument_start: usize = alias_children.count
    alias_children.push(alias_argument)
    alias_children.push(alias_formal)
    alias_call: usize = add_node(&alias_nodes, "resource-call-lend", "", 0, 0, 1, alias_argument_start, 2, 0, "peek", "")
    alias_trace_start: usize = alias_children.count
    alias_children.push(alias_bind)
    alias_children.push(alias_borrow)
    alias_children.push(alias_call)
    alias_root: usize = add_node(&alias_nodes, "resource-safety", "", 0, 0, 0, alias_trace_start, 3, 0, "shared-alias", "resource-v1")
    return 9 if proof_kernel_replay_resource_report(&alias_nodes, &alias_children, [], alias_root)

    # A fresh region allocated for the callee is not a shared lend: its lifetime runs into the
    # callee's body, which is exactly the part no summary is being consulted for here.
    region_nodes: mutable darray[ProofKernelNode] = []
    region_children: mutable darray[usize] = []
    region_open: usize = add_node(&region_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "r", "")
    region_operand: usize = add_node(&region_nodes, "int", "", 0, 0, 0, 0, 0, 7, "", "")
    region_alloc: usize = add_node(&region_nodes, "resource-region-call-alloc", "", region_operand, 0, 2, 0, 0, 0, "values", "r")
    region_argument: usize = add_node(&region_nodes, "resource-call-arg", "region-new", region_alloc, 0, 0, 0, 0, 0, "values", "r")
    region_formal: usize = add_node(&region_nodes, "resource-call-formal", "external-shared", 0, 0, 0, 0, 0, 0, "values", "")
    region_argument_start: usize = region_children.count
    region_children.push(region_argument)
    region_children.push(region_formal)
    region_call: usize = add_node(&region_nodes, "resource-call-lend", "", 0, 0, 1, region_argument_start, 2, 0, "peek", "")
    region_trace_start: usize = region_children.count
    region_children.push(region_open)
    region_children.push(region_call)
    region_root: usize = add_node(&region_nodes, "resource-safety", "", 0, 0, 0, region_trace_start, 2, 0, "shared-region", "resource-v1")
    return 10 if proof_kernel_replay_resource_report(&region_nodes, &region_children, [], region_root)

    # An exclusive lend of a place the caller may not write. The permission comes from the lent
    # binding, never from the callee's declared mode.
    exclusive_nodes: mutable darray[ProofKernelNode] = []
    exclusive_children: mutable darray[usize] = []
    exclusive_bind: usize = add_node(&exclusive_nodes, "resource-bind", "value", 0, 0, 0, 0, 0, 0, "items", "")
    exclusive_place: usize = add_node(&exclusive_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "items", "")
    exclusive_argument: usize = add_node(&exclusive_nodes, "resource-call-arg", "borrow", exclusive_place, 0, 0, 0, 0, 0, "values", "")
    exclusive_formal: usize = add_node(&exclusive_nodes, "resource-call-formal", "external-mutable", 0, 0, 0, 0, 0, 0, "values", "")
    exclusive_argument_start: usize = exclusive_children.count
    exclusive_children.push(exclusive_argument)
    exclusive_children.push(exclusive_formal)
    exclusive_call: usize = add_node(&exclusive_nodes, "resource-call-lend", "", 0, 0, 1, exclusive_argument_start, 2, 0, "peek", "")
    exclusive_trace_start: usize = exclusive_children.count
    exclusive_children.push(exclusive_bind)
    exclusive_children.push(exclusive_call)
    exclusive_root: usize = add_node(&exclusive_nodes, "resource-safety", "", 0, 0, 0, exclusive_trace_start, 2, 0, "shared-exclusive", "resource-v1")
    return 11 if proof_kernel_replay_resource_report(&exclusive_nodes, &exclusive_children, [], exclusive_root)

    # The same lend over a writable binding is admitted, and the caller records a write to the
    # whole lent place: an exclusive lend is over-approximated by the most a callee could do.
    writable_nodes: mutable darray[ProofKernelNode] = []
    writable_children: mutable darray[usize] = []
    writable_bind: usize = add_node(&writable_nodes, "resource-bind", "value", 0, 0, 1, 0, 0, 0, "items", "")
    writable_place: usize = add_node(&writable_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "items", "")
    writable_argument: usize = add_node(&writable_nodes, "resource-call-arg", "borrow", writable_place, 0, 0, 0, 0, 0, "values", "")
    writable_formal: usize = add_node(&writable_nodes, "resource-call-formal", "external-mutable", 0, 0, 0, 0, 0, 0, "values", "")
    writable_argument_start: usize = writable_children.count
    writable_children.push(writable_argument)
    writable_children.push(writable_formal)
    writable_call: usize = add_node(&writable_nodes, "resource-call-lend", "", 0, 0, 1, writable_argument_start, 2, 0, "fill", "")
    writable_trace_start: usize = writable_children.count
    writable_children.push(writable_bind)
    writable_children.push(writable_call)
    writable_root: usize = add_node(&writable_nodes, "resource-safety", "", 0, 0, 0, writable_trace_start, 2, 0, "writable-lend", "resource-v1")
    return 12 if not proof_kernel_replay_resource_report(&writable_nodes, &writable_children, [], writable_root)

    # The same place lent exclusively twice. Both capabilities are live while the callee runs, so
    # the callee may write through one and read the other.
    alias_pair_nodes: mutable darray[ProofKernelNode] = []
    alias_pair_children: mutable darray[usize] = []
    alias_pair_bind: usize = add_node(&alias_pair_nodes, "resource-bind", "value", 0, 0, 1, 0, 0, 0, "items", "")
    alias_pair_place: usize = add_node(&alias_pair_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "items", "")
    alias_pair_first: usize = add_node(&alias_pair_nodes, "resource-call-arg", "borrow", alias_pair_place, 0, 0, 0, 0, 0, "first", "")
    alias_pair_second: usize = add_node(&alias_pair_nodes, "resource-call-arg", "borrow", alias_pair_place, 0, 0, 0, 0, 0, "second", "")
    alias_pair_first_formal: usize = add_node(&alias_pair_nodes, "resource-call-formal", "external-mutable", 0, 0, 0, 0, 0, 0, "first", "")
    alias_pair_second_formal: usize = add_node(&alias_pair_nodes, "resource-call-formal", "external-mutable", 0, 0, 0, 0, 0, 0, "second", "")
    alias_pair_start: usize = alias_pair_children.count
    alias_pair_children.push(alias_pair_first)
    alias_pair_children.push(alias_pair_second)
    alias_pair_children.push(alias_pair_first_formal)
    alias_pair_children.push(alias_pair_second_formal)
    alias_pair_call: usize = add_node(&alias_pair_nodes, "resource-call-lend", "", 0, 0, 2, alias_pair_start, 4, 0, "fill", "")
    alias_pair_trace_start: usize = alias_pair_children.count
    alias_pair_children.push(alias_pair_bind)
    alias_pair_children.push(alias_pair_call)
    alias_pair_root: usize = add_node(&alias_pair_nodes, "resource-safety", "", 0, 0, 0, alias_pair_trace_start, 2, 0, "exclusive-alias", "resource-v1")
    return 13 if proof_kernel_replay_resource_report(&alias_pair_nodes, &alias_pair_children, [], alias_pair_root)

    # A shared lend beside an exclusive lend of the same place. Shared aliasing is harmless only
    # while nothing exclusive is live on the place.
    mixed_nodes: mutable darray[ProofKernelNode] = []
    mixed_children: mutable darray[usize] = []
    mixed_bind: usize = add_node(&mixed_nodes, "resource-bind", "value", 0, 0, 1, 0, 0, 0, "items", "")
    mixed_place: usize = add_node(&mixed_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "items", "")
    mixed_first: usize = add_node(&mixed_nodes, "resource-call-arg", "borrow", mixed_place, 0, 0, 0, 0, 0, "target", "")
    mixed_second: usize = add_node(&mixed_nodes, "resource-call-arg", "borrow", mixed_place, 0, 0, 0, 0, 0, "source", "")
    mixed_first_formal: usize = add_node(&mixed_nodes, "resource-call-formal", "external-mutable", 0, 0, 0, 0, 0, 0, "target", "")
    mixed_second_formal: usize = add_node(&mixed_nodes, "resource-call-formal", "external-shared", 0, 0, 0, 0, 0, 0, "source", "")
    mixed_start: usize = mixed_children.count
    mixed_children.push(mixed_first)
    mixed_children.push(mixed_second)
    mixed_children.push(mixed_first_formal)
    mixed_children.push(mixed_second_formal)
    mixed_call: usize = add_node(&mixed_nodes, "resource-call-lend", "", 0, 0, 2, mixed_start, 4, 0, "copy", "")
    mixed_trace_start: usize = mixed_children.count
    mixed_children.push(mixed_bind)
    mixed_children.push(mixed_call)
    mixed_root: usize = add_node(&mixed_nodes, "resource-safety", "", 0, 0, 0, mixed_trace_start, 2, 0, "mixed-alias", "resource-v1")
    return 14 if proof_kernel_replay_resource_report(&mixed_nodes, &mixed_children, [], mixed_root)

    # An exclusive lend made while the caller still holds a borrow into the same place.
    held_nodes: mutable darray[ProofKernelNode] = []
    held_children: mutable darray[usize] = []
    held_bind: usize = add_node(&held_nodes, "resource-bind", "value", 0, 0, 1, 0, 0, 0, "items", "")
    held_place: usize = add_node(&held_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "items", "")
    held_borrow: usize = add_node(&held_nodes, "resource-bind", "shared", held_place, 0, 0, 0, 0, 0, "view", "items")
    held_argument: usize = add_node(&held_nodes, "resource-call-arg", "borrow", held_place, 0, 0, 0, 0, 0, "values", "")
    held_formal: usize = add_node(&held_nodes, "resource-call-formal", "external-mutable", 0, 0, 0, 0, 0, 0, "values", "")
    held_start: usize = held_children.count
    held_children.push(held_argument)
    held_children.push(held_formal)
    held_call: usize = add_node(&held_nodes, "resource-call-lend", "", 0, 0, 1, held_start, 2, 0, "fill", "")
    held_trace_start: usize = held_children.count
    held_children.push(held_bind)
    held_children.push(held_borrow)
    held_children.push(held_call)
    held_root: usize = add_node(&held_nodes, "resource-safety", "", 0, 0, 0, held_trace_start, 3, 0, "exclusive-across-borrow", "resource-v1")
    return 15 if proof_kernel_replay_resource_report(&held_nodes, &held_children, [], held_root)

    # A region-polymorphic callee is lent the same way. Every formal lifetime must be pinned to a
    # region that is active right here, and the actual's own region must be the one it is pinned
    # to; the callee may allocate into that region but can never close it, because a lifetime
    # parameter is external in its own frame.
    pinned_nodes: mutable darray[ProofKernelNode] = []
    pinned_children: mutable darray[usize] = []
    pinned_open: usize = add_node(&pinned_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "R", "")
    pinned_close: usize = add_node(&pinned_nodes, "resource-region-close", "", 0, 0, 0, 0, 0, 0, "R", "")
    pinned_operand: usize = add_node(&pinned_nodes, "int", "", 0, 0, 0, 0, 0, 5, "", "")
    pinned_bind: usize = add_node(&pinned_nodes, "resource-region-alloc", "", pinned_operand, 0, 2, 0, 0, 0, "items", "R")
    pinned_place: usize = add_node(&pinned_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "items", "")
    pinned_argument: usize = add_node(&pinned_nodes, "resource-call-arg", "reference", pinned_place, 0, 0, 0, 0, 0, "values", "")
    pinned_formal: usize = add_node(&pinned_nodes, "resource-call-formal", "external-shared", 0, 0, 0, 0, 0, 0, "values", "q")
    pinned_region: usize = add_node(&pinned_nodes, "resource-call-region", "param", 0, 0, 0, 0, 0, 0, "q", "R")
    pinned_start: usize = pinned_children.count
    pinned_children.push(pinned_argument)
    pinned_children.push(pinned_formal)
    pinned_children.push(pinned_region)
    pinned_call: usize = add_node(&pinned_nodes, "resource-call-lend", "", 0, 1, 1, pinned_start, 3, 0, "scan", "")
    pinned_trace_start: usize = pinned_children.count
    pinned_children.push(pinned_open)
    pinned_children.push(pinned_bind)
    pinned_children.push(pinned_call)
    pinned_children.push(pinned_close)
    pinned_root: usize = add_node(&pinned_nodes, "resource-safety", "", 0, 0, 0, pinned_trace_start, 4, 0, "pinned-lend", "resource-v1")
    return 16 if not proof_kernel_replay_resource_report(&pinned_nodes, &pinned_children, [], pinned_root)

    # The same lend against a region that is not active here. A lifetime the caller never
    # established is not one it can hand out.
    dead_nodes: mutable darray[ProofKernelNode] = []
    dead_children: mutable darray[usize] = []
    dead_open: usize = add_node(&dead_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "R", "")
    dead_close: usize = add_node(&dead_nodes, "resource-region-close", "", 0, 0, 0, 0, 0, 0, "R", "")
    dead_operand: usize = add_node(&dead_nodes, "int", "", 0, 0, 0, 0, 0, 5, "", "")
    dead_bind: usize = add_node(&dead_nodes, "resource-region-alloc", "", dead_operand, 0, 2, 0, 0, 0, "items", "R")
    dead_place: usize = add_node(&dead_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "items", "")
    dead_argument: usize = add_node(&dead_nodes, "resource-call-arg", "reference", dead_place, 0, 0, 0, 0, 0, "values", "")
    dead_formal: usize = add_node(&dead_nodes, "resource-call-formal", "external-shared", 0, 0, 0, 0, 0, 0, "values", "q")
    dead_region: usize = add_node(&dead_nodes, "resource-call-region", "param", 0, 0, 0, 0, 0, 0, "q", "S")
    dead_start: usize = dead_children.count
    dead_children.push(dead_argument)
    dead_children.push(dead_formal)
    dead_children.push(dead_region)
    dead_call: usize = add_node(&dead_nodes, "resource-call-lend", "", 0, 1, 1, dead_start, 3, 0, "scan", "")
    dead_trace_start: usize = dead_children.count
    dead_children.push(dead_open)
    dead_children.push(dead_bind)
    dead_children.push(dead_call)
    dead_children.push(dead_close)
    dead_root: usize = add_node(&dead_nodes, "resource-safety", "", 0, 0, 0, dead_trace_start, 4, 0, "dead-lifetime", "resource-v1")
    return 17 if proof_kernel_replay_resource_report(&dead_nodes, &dead_children, [], dead_root)

    # A lent place whose own region is not the one its formal lifetime is pinned to. The callee
    # would be told the capability lives as long as a region it does not belong to.
    crossed_nodes: mutable darray[ProofKernelNode] = []
    crossed_children: mutable darray[usize] = []
    crossed_outer: usize = add_node(&crossed_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "S", "")
    crossed_open: usize = add_node(&crossed_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "R", "")
    crossed_close: usize = add_node(&crossed_nodes, "resource-region-close", "", 0, 0, 0, 0, 0, 0, "R", "")
    crossed_outer_close: usize = add_node(&crossed_nodes, "resource-region-close", "", 0, 0, 0, 0, 0, 0, "S", "")
    crossed_operand: usize = add_node(&crossed_nodes, "int", "", 0, 0, 0, 0, 0, 5, "", "")
    crossed_bind: usize = add_node(&crossed_nodes, "resource-region-alloc", "", crossed_operand, 0, 2, 0, 0, 0, "items", "R")
    crossed_place: usize = add_node(&crossed_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "items", "")
    crossed_argument: usize = add_node(&crossed_nodes, "resource-call-arg", "reference", crossed_place, 0, 0, 0, 0, 0, "values", "")
    crossed_formal: usize = add_node(&crossed_nodes, "resource-call-formal", "external-shared", 0, 0, 0, 0, 0, 0, "values", "q")
    crossed_region: usize = add_node(&crossed_nodes, "resource-call-region", "param", 0, 0, 0, 0, 0, 0, "q", "S")
    crossed_start: usize = crossed_children.count
    crossed_children.push(crossed_argument)
    crossed_children.push(crossed_formal)
    crossed_children.push(crossed_region)
    crossed_call: usize = add_node(&crossed_nodes, "resource-call-lend", "", 0, 1, 1, crossed_start, 3, 0, "scan", "")
    crossed_trace_start: usize = crossed_children.count
    crossed_children.push(crossed_outer)
    crossed_children.push(crossed_open)
    crossed_children.push(crossed_bind)
    crossed_children.push(crossed_call)
    crossed_children.push(crossed_close)
    crossed_children.push(crossed_outer_close)
    crossed_root: usize = add_node(&crossed_nodes, "resource-safety", "", 0, 0, 0, crossed_trace_start, 6, 0, "crossed-lifetime", "resource-v1")
    return 18 if proof_kernel_replay_resource_report(&crossed_nodes, &crossed_children, [], crossed_root)

    # One formal lifetime pinned twice. A duplicate entry would let a second mapping override the
    # first after the first has already been checked.
    twice_nodes: mutable darray[ProofKernelNode] = []
    twice_children: mutable darray[usize] = []
    twice_open: usize = add_node(&twice_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "R", "")
    twice_close: usize = add_node(&twice_nodes, "resource-region-close", "", 0, 0, 0, 0, 0, 0, "R", "")
    twice_operand: usize = add_node(&twice_nodes, "int", "", 0, 0, 0, 0, 0, 5, "", "")
    twice_bind: usize = add_node(&twice_nodes, "resource-region-alloc", "", twice_operand, 0, 2, 0, 0, 0, "items", "R")
    twice_place: usize = add_node(&twice_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "items", "")
    twice_argument: usize = add_node(&twice_nodes, "resource-call-arg", "reference", twice_place, 0, 0, 0, 0, 0, "values", "")
    twice_formal: usize = add_node(&twice_nodes, "resource-call-formal", "external-shared", 0, 0, 0, 0, 0, 0, "values", "q")
    twice_region: usize = add_node(&twice_nodes, "resource-call-region", "param", 0, 0, 0, 0, 0, 0, "q", "R")
    twice_start: usize = twice_children.count
    twice_children.push(twice_argument)
    twice_children.push(twice_formal)
    twice_children.push(twice_region)
    twice_children.push(twice_region)
    twice_call: usize = add_node(&twice_nodes, "resource-call-lend", "", 0, 2, 1, twice_start, 4, 0, "scan", "")
    twice_trace_start: usize = twice_children.count
    twice_children.push(twice_open)
    twice_children.push(twice_bind)
    twice_children.push(twice_call)
    twice_children.push(twice_close)
    twice_root: usize = add_node(&twice_nodes, "resource-safety", "", 0, 0, 0, twice_trace_start, 4, 0, "duplicate-lifetime", "resource-v1")
    return 19 if proof_kernel_replay_resource_report(&twice_nodes, &twice_children, [], twice_root)
    return 0
