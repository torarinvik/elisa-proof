# The secondary component cannot compensate for an increase in the leading component.

def bad_lexicographic_count(outer: i64, inner: i64) -> i64:
    requires outer >= 0
    requires inner >= 0
    decreases (outer, inner)
    ensure result == 0
    if outer > 0:
        return bad_lexicographic_count(outer + 1, 0)
    if inner > 0:
        return bad_lexicographic_count(0, inner - 1)
    return 0
