# W-01: a linear goal whose refutation spans eight names, past the Fourier-Motzkin search's
# six-atom limit. It proves only when scripts/smt_oracle.py supplies Z3's multipliers through
# `--linear-hints`.
def chain(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, i: i64) -> i64:
    requires a >= -1000
    requires a <= 1000
    requires b >= -1000
    requires b <= 1000
    requires c >= -1000
    requires c <= 1000
    requires d >= -1000
    requires d <= 1000
    requires e >= -1000
    requires e <= 1000
    requires f >= -1000
    requires f <= 1000
    requires g >= -1000
    requires g <= 1000
    requires i >= -1000
    requires i <= 1000
    requires a + b <= c
    requires c + d <= e
    requires e + f <= g
    requires g <= i
    ensure result + b + d + f <= i
    return a
