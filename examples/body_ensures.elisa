# `ensures` is the plural spelling of the postcondition head. It is checked on every
# return like `ensure`, and a caller reads it as part of the callee's summary.
def plural_on_every_return(flag: bool) -> i32:
    ensures result == 1
    return 1 if flag
    1

def plural_summary() -> i32:
    ensures result == 1
    1

def caller_reads_plural() -> i32:
    ensure result == 2
    plural_summary() + 1

def both_spellings(x: i32) -> i32:
    requires x >= 0 and x < 100
    ensure result >= 1
    ensures result <= 100
    x + 1
