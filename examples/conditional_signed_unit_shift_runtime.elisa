const I64_MAX: i64 = 9223372036854775807

def shifted_guard_value(at: i64, count: i64) -> i64:
    return 1 if at >= 1 and at + 1 < count else 0

def main() -> i32:
    interior = shifted_guard_value(1, 3)
    fallback = shifted_guard_value(0, 1)
    maximum_safe_step = shifted_guard_value(I64_MAX - 1, I64_MAX)
    return 1 if interior != 1 or fallback != 0 or maximum_safe_step != 0
    return 0
