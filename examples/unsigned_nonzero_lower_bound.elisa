def unsigned_nonzero_usize(value: usize) -> usize:
    requires value != 0
    ensure result >= 1
    return value

def unsigned_nonzero_u8(value: u8) -> u8:
    requires value != 0
    ensure 1 <= result
    return value

def unsigned_nonzero_branch(value: usize) -> usize:
    ensure result == 0 or result >= 1
    return 0 if value == 0
    assert 1 <= value
    assert 0 < value
    assert value > 0
    return value

def unsigned_nonzero_reversed(value: usize) -> usize:
    requires 0 != value
    ensure result > 0
    return value

def unsigned_nonzero_negated(value: usize) -> usize:
    requires not (0 == value)
    ensure 0 < result
    return value

def rejected_signed_nonzero_positive(value: i64) -> i64:
    requires value != 0
    ensure result >= 1
    return value

def rejected_unsigned_other_term(value: usize, other: usize) -> usize:
    requires value != 0
    ensure result >= 1
    return other

def rejected_unsigned_zero(value: usize) -> usize:
    requires value == 0
    ensure result >= 1
    return value

def rejected_unsigned_stale(value: usize) -> usize:
    requires value != 0
    ensure result >= 1
    changed: mutable usize = value
    changed <- 0
    return changed
