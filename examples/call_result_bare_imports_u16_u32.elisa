# Call-result replay follows visible selective and wildcard imports to the declared result type.
module SelectiveWidths:
    public:
        def cap() -> u32:
            ensure result >= 0
            ensure result <= 255
            return 5

module WildcardWidths:
    public:
        def small() -> u16:
            ensure result >= 0
            ensure result <= 15
            return 5

module Client:
    from SelectiveWidths import cap
    using WildcardWidths
    public:
        def selective_import_result_is_u32() -> bool:
            ensure result
            cap() <= 255

        def wildcard_import_result_is_u16() -> bool:
            ensure result
            small() <= 15
