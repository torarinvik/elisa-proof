# A function inside a module resolves `Limits::TOP` from the root when no nested module, enum or
# struct could be the nearer meaning of `Limits`, in its own contracts and in the callee's.
module Limits:
    public:
        const TOP: i64 = 100
        const FLOOR: i64 = -5

        def cap(x: i64) -> i64:
            requires x >= FLOOR
            requires x <= TOP
            ensure result >= FLOOR
            ensure result <= TOP
            return x

module Laws:
    public:
        def restates(x: i64) -> i64:
            requires x >= Limits::FLOOR
            requires x <= Limits::TOP
            ensure result <= Limits::TOP
            ensure result >= -5
            return Limits::cap(x)

        def headroom(x: i64) -> i64:
            requires x >= 0
            requires x <= Limits::TOP
            ensure result >= 0
            return Limits::TOP - x
