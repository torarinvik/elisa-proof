# Included by the include_function_scope fixtures. `step` is declared here, in the including
# file's OuterFn module, and in a nested Geometry::Scalar module, each with a different result.
module InnerFn:
    public:
        def step(value: i64) -> i64:
            requires value >= 0 and value <= 1000
            ensure result == value + 1
            return value + 1

        def bump(value: i64) -> i64:
            requires value >= 0 and value <= 1000
            ensure result == value + 1
            return step(value)

module Geometry:
    public:
        module Scalar:
            public:
                def step(value: i64) -> i64:
                    requires value >= 0 and value <= 1000
                    ensure result == value + 3
                    return value + 3

                def lift(value: i64) -> i64:
                    requires value >= 0 and value <= 1000
                    ensure result == value + 3
                    return step(value)
