# The boundary of the element-write rule. A collection keeps its extent across an iteration only
# when every write to it in the body replaces an element that was already there. Each function
# below writes it some other way, so the binder's range must not survive the loop entry and the
# indexed access after it has to be refused.
def grow(values: mutable darray[i64]&) -> void:
    changes values
    values.push(0)

# A method call on the collection can push or pop, so the count at entry says nothing about the
# count on an arbitrary iteration.
def a_push_in_the_body(xs: mutable darray[i64]&) -> void:
    changes xs
    for index in 0..<xs.count |index, xs|:
        xs.push(1)
        xs[index] <- 0

# The same through a callee that takes it by reference.
def a_call_that_may_push(xs: mutable darray[i64]&) -> void:
    changes xs
    for index in 0..<xs.count |index, xs|:
        grow(xs)
        xs[index] <- 0

# A whole assignment replaces the collection, extent and all.
def a_whole_assignment(xs: mutable darray[i64]&, other: darray[i64]) -> void:
    changes xs
    for index in 0..<xs.count |index, xs, other|:
        xs <- other
        xs[index] <- 0

# One whole write anywhere in the body outweighs any number of element writes.
def one_whole_write_among_many(xs: mutable darray[i64]&, other: darray[i64], flag: bool) -> void:
    changes xs
    for index in 0..<xs.count |index, xs, other, flag|:
        xs[index] <- 1
        if flag:
            xs <- other
        xs[index] <- 2

# A reference taken in the body can be handed anywhere, so the extent is not this body's to keep.
def a_reference_taken(xs: mutable darray[i64]&) -> void:
    changes xs
    for index in 0..<xs.count |index, xs|:
        grow(&xs)
        xs[index] <- 0
