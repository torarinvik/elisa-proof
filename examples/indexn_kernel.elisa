# Multi-argument indexing retains its complete receiver/argument structure in the kernel.

def indexn_reflexive(matrix: array[array[i64, 4], 4]&, row: usize, column: usize) -> void:
    proof matrix[row, column] == matrix[row, column]:
        assert matrix[row, column] == matrix[row, column]

# Executable multi-index reads use the same two literal dimensions for heap safety.

def indexn_fixed_read(matrix: array[array[i64, 4], 4]&, row: usize, column: usize) -> i64:
    requires row < 4 and column < 4
    return matrix[row, column]
