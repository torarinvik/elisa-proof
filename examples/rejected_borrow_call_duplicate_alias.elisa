# The same mutable source cannot be passed to two mutable reference formals in one call.
# Each argument is a temporary borrow, so the call boundary must check the arguments
# pairwise rather than only against borrows that existed before the call.
def write_pair(left: mutable i64&, right: mutable i64&) -> void:
    left <- 1
    right <- 2

def rejected_borrow_call_duplicate_alias(x: mutable i64) -> i64:
    write_pair(&x, &x)
    return x

def main() -> i64:
    value: mutable i64 = 0
    return rejected_borrow_call_duplicate_alias(value)
