# Controls: the imported value is the constant's own, so an argument one past it, or one
# bounded only by a larger caller requirement, still fails the callee's precondition.
module Fade:
    public:
        const FULL: i64 = 1000

module Gate:
    public:
        def weight(fade: i64) -> i64:
            requires fade >= 0
            requires fade <= Fade::FULL
            ensure result == fade
            return fade

module Uses:
    public:
        def one_past_full() -> i64:
            ensure result == 1001
            return Gate::weight(1001)

        def loosely_bounded(x: i64) -> i64:
            requires x >= 0
            requires x <= 1001
            ensure result == x
            return Gate::weight(x)
