# Control for call_chain_disjunctive_ensure: `weight` no longer promises
# `distance != 0 or result == 0`, so a zero distance says nothing about the weight and
# `into != 0 or blend_to(...) == value` must not be proved.
module ChainBlend:
    public:
        const FULL: i64 = 1000

        def nearer(a: i64, b: i64) -> i64:
            requires a >= 0
            requires a <= 10000
            requires b >= 0
            requires b <= 10000
            ensure result >= 0
            ensure result <= a
            ensure result <= b
            return a if a <= b
            return b

        def weight(distance: i64, edge: i64) -> i64:
            requires distance >= 0
            requires distance <= 10000
            requires edge >= 1
            requires edge <= 100
            ensure result >= 0
            ensure result <= FULL
            return FULL if distance >= edge
            return 0 if distance == 0
            return distance * FULL / edge

        def blend_to(source: i64, fixed: i64, w: i64) -> i64:
            requires w >= 0
            requires w <= FULL
            requires source >= -1000000
            requires source <= 1000000
            requires fixed >= -1000000
            requires fixed <= 1000000
            ensure w != 0 or result == source
            ensure w != FULL or result == fixed
            return source if w == 0
            return fixed if w == FULL
            return source + (fixed - source) * w / FULL

        def locked(value: i64, anchor: i64, into: i64, left: i64, blend: i64) -> i64:
            requires value >= -1000000
            requires value <= 1000000
            requires anchor >= -1000000
            requires anchor <= 1000000
            requires into >= 0
            requires into <= 10000
            requires left >= 0
            requires left <= 10000
            requires blend >= 1
            requires blend <= 100
            ensure into != 0 or result == value
            distance: i64 = nearer(into, left)
            w: i64 = weight(distance, blend)
            return blend_to(value, anchor, w)
