# Expression-position catch checks success and error results separately. The success arm can
# use the verified callee summary; the error arm must establish the postcondition independently.
error CatchProbeError:
    Bad

def catch_probe_value(x: i64) -> i64 error[CatchProbeError]:
    requires x >= 0
    ensure result == x + 1
    return x + 1

def catch_expression(x: i64) -> i64:
    requires x >= 0
    ensure result == x + 1
    return catch catch_probe_value(x):
        value:
            value
        CatchProbeError.Bad:
            x + 1
