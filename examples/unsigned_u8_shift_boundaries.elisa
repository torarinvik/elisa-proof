# u8 shift boundary checks: small valid shifts replay, while negative and width-sized
# counts and a false high-bit result do not become proofs through i64 reinterpretation.
module UnsignedU8ShiftBoundaries:
    public:
        def small_valid_left_shift() -> u8:
            ensure result == 16
            return 1 << 4

        def negative_shift_count_is_rejected() -> u8:
            ensure result == 0
            return 1 << -1

        def shift_by_exact_width_is_not_assumed_zero() -> u8:
            ensure result == 0
            value: u8 = 1
            return value << 8

        def high_bit_right_shift_is_not_reinterpreted_as_zero() -> u8:
            ensure result == 0
            value: u8 = 128
            return value >> 1
