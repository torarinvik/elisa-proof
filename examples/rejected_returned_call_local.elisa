# A returned local keeps only what its call established. The return no longer clears facts, so
# these check that nothing the call itself discarded comes back, and that a claim beyond the
# summary is still unproven.

def bounded(x: i64) -> i64:
    requires x >= 0
    ensure result >= 0
    ensure result <= 1000000
    return 0

def reset(counter: mutable usize&, floor: usize) -> usize:
    requires floor <= 10
    ensure result == floor
    changes counter
    counter <- 0
    return floor

# Stronger than the summary.
def stronger_than_the_summary(x: i64) -> i64:
    requires x >= 0
    ensure result <= 999999
    y: i64 = bounded(x)
    return y

# `slot` is lent to a callee that zeroes it. The call forgets its recorded 5; the return keeps the
# summary of `kept`, but must not bring the 5 back with it.
def referenced_value_must_not_survive(seed: usize) -> usize:
    ensure result == 5
    slot: mutable usize = 5
    kept: usize = reset(&slot, 3)
    return slot if kept == 3 else 5

# The callee's precondition is not established, so its summary never arrives.
def unproven_precondition(x: i64) -> i64:
    ensure result <= 1000000
    y: i64 = bounded(x)
    return y
