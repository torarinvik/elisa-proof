# Primitive equality transports order; conditional summaries need separate coverage.
def order_transport_identity(value: usize) -> usize:
    ensure result == value
    return value

def automatic_nonzero_call_result(value: usize) -> usize:
    requires value > 0
    ensure result != 0
    return order_transport_identity(value)

# The intermediate assertion is independently proved, never assumed.
def checked_nonzero_call_result(value: usize) -> usize:
    requires value > 0
    ensure result != 0
    assert value != 0
    return order_transport_identity(value)

# A non-strict bound admits zero and must not justify the same consequence.
def rejected_nonstrict_nonzero_call_result(value: usize) -> usize:
    requires value >= 0
    ensure result != 0
    return order_transport_identity(value)

def conditional_order_result(valid: bool, value: usize) -> usize:
    ensure not valid or result == value
    ensure valid or result == 0
    ensure result == 0 or result == value
    return value if valid
    return 0

def automatic_conditional_nonzero_result(valid: bool, value: usize) -> usize:
    requires value > 0
    ensure not valid or result != 0
    if valid:
        return conditional_order_result(true, value)
    return conditional_order_result(false, value)

def automatic_fixed_valid_nonzero_result(value: usize) -> usize:
    requires value > 0
    ensure result != 0
    return conditional_order_result(true, value)

def rejected_invalid_conditional_nonzero_result(value: usize) -> usize:
    requires value > 0
    ensure result != 0
    return conditional_order_result(false, value)

def true_guarded_order_result(valid: bool, value: usize) -> usize:
    ensure valid or result == value
    return 0 if valid
    return value

# A true guard makes the equality vacuous, so it cannot justify nonzero output.
def rejected_true_guard_nonzero_result(value: usize) -> usize:
    requires value > 0
    ensure result != 0
    return true_guarded_order_result(true, value)
