# Primitive equality transports order; conditional summaries need separate coverage.
def order_transport_identity(value: usize) -> usize:
    ensure result == value
    return value

def automatic_nonzero_call_result(value: usize) -> usize:
    requires value > 0
    ensure result != 0
    return order_transport_identity(value)

# The intermediate assertion is independently proved, never assumed.
def checked_nonzero_call_result(value: usize) -> usize:
    requires value > 0
    ensure result != 0
    assert value != 0
    return order_transport_identity(value)

# A non-strict bound admits zero and must not justify the same consequence.
def rejected_nonstrict_nonzero_call_result(value: usize) -> usize:
    requires value >= 0
    ensure result != 0
    return order_transport_identity(value)

def conditional_order_result(valid: bool, value: usize) -> usize:
    ensure not valid or result == value
    ensure valid or result == 0
    ensure result == 0 or result == value
    return value if valid
    return 0

def named_conditional_pair_result(valid: bool, left: usize, right: usize) -> usize:
    ensure not valid or result == left
    ensure valid or result == right
    return left if valid
    return right

# Reverse source argument order, while the two result arms have the same type.
def automatic_named_conditional_result(valid: bool, left: usize, right: usize) -> usize:
    requires left > 0
    ensure not valid or result != 0
    return named_conditional_pair_result(right: right, left: left, valid: valid)

# Actual identifiers deliberately cross the callee's formal names; substitution must be simultaneous.
def automatic_named_shadowed_names(valid: bool, left: usize, right: usize) -> usize:
    requires right > 0
    ensure not valid or result != 0
    return named_conditional_pair_result(right: left, left: right, valid: valid)

def rejected_named_swapped_same_typed(valid: bool, expected: usize, actual: usize) -> usize:
    requires valid
    requires expected > 0
    requires expected != actual
    ensure result == expected
    return named_conditional_pair_result(right: expected, left: actual, valid: valid)

def altered_named_conditional_summary(valid: bool, left: usize, right: usize) -> usize:
    ensure not valid or result == left
    ensure valid or result == right
    return right if valid
    return left

def rejected_named_false_summary(valid: bool, left: usize, right: usize) -> usize:
    requires valid
    requires left != right
    ensure result == left
    return altered_named_conditional_summary(right: right, left: left, valid: valid)

def rejected_named_guard_write(left: usize, right: usize) -> usize:
    requires left != right
    ensure result == left
    valid: mutable bool = false
    value: usize = named_conditional_pair_result(right: right, left: left, valid: valid)
    valid <- true
    return value

def automatic_conditional_nonzero_result(valid: bool, value: usize) -> usize:
    requires value > 0
    ensure not valid or result != 0
    if valid:
        return conditional_order_result(true, value)
    return conditional_order_result(false, value)

def automatic_fixed_valid_nonzero_result(value: usize) -> usize:
    requires value > 0
    ensure result != 0
    return conditional_order_result(true, value)

def automatic_reverse_order_conditional_result(value: usize) -> usize:
    requires 0 < value
    ensure result != 0
    return conditional_order_result(true, value)

def automatic_captured_conditional_result(valid: bool, value: usize) -> usize:
    requires value > 0
    ensure not valid or result != 0
    if valid:
        normalized: usize = conditional_order_result(true, value)
        return normalized
    return conditional_order_result(false, value)

def rejected_mutated_conditional_result(value: usize) -> usize:
    requires value > 0
    ensure result != 0
    normalized: mutable usize = conditional_order_result(true, value)
    normalized <- 0
    return normalized

def rejected_zero_constant_conditional_result() -> usize:
    ensure result != 0
    return conditional_order_result(true, 0)

def rejected_invalid_conditional_nonzero_result(value: usize) -> usize:
    requires value > 0
    ensure result != 0
    return conditional_order_result(false, value)

def true_guarded_order_result(valid: bool, value: usize) -> usize:
    ensure valid or result == value
    return 0 if valid
    return value

# A true guard makes the equality vacuous, so it cannot justify nonzero output.
def rejected_true_guard_nonzero_result(value: usize) -> usize:
    requires value > 0
    ensure result != 0
    return true_guarded_order_result(true, value)
