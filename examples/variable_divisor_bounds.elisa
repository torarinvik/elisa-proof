module VariableDivisorBounds:
    public:
        # `0 <= a % b <= b - 1` for `b >= 1` and `a >= 0`.
        def wrap(frame: i64, count: i64) -> i64:
            requires count >= 1
            requires count <= 10000000
            requires frame >= 0
            requires frame <= 30000000
            ensure result >= 0
            ensure result < count
            return frame % count

        # `a / b <= a` for `b >= 1` and `a >= 0`.
        def shrink(total: i64, parts: i64) -> i64:
            requires parts >= 1
            requires parts <= 1000
            requires total >= 0
            requires total <= 1000000
            ensure result >= 0
            ensure result <= total
            return total / parts

        # `x * K / b <= K` for `b >= 1`, `x <= b` and a literal `K >= 0`.
        def part(d: i64, e: i64) -> i64:
            requires e >= 1
            requires e <= 100000
            requires d >= 0
            requires d <= e
            ensure result >= 0
            ensure result <= 1000
            return d * 1000 / e
