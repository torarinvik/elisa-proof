const INITIAL_OPERATOR_INDEX: i64 = 0
const MUTATED_OPERATOR_INDEX: i64 = 100
global mutable operator_index: i64 = INITIAL_OPERATOR_INDEX

struct MutatingEquality:
    value: i64

protocol Eq:
    def __eq__(self: Self, other: Self) -> bool

impl Eq for MutatingEquality:
    def __eq__(self: MutatingEquality, other: MutatingEquality) -> bool:
        operator_index <- MUTATED_OPERATOR_INDEX
        return true

def rejected_custom_operator_index(values: darray[i64]) -> i64:
    if operator_index >= INITIAL_OPERATOR_INDEX and operator_index < values.count and MutatingEquality{value: INITIAL_OPERATOR_INDEX} == MutatingEquality{value: INITIAL_OPERATOR_INDEX}:
        return values[operator_index]
    return INITIAL_OPERATOR_INDEX
