# A callee requires bounded by another module's constant (into <= F::MAXF)
# resolves the qualified constant to its value, so the caller's literal
# argument is checked against 10000000.
module F:
    public:
        const MAXF: i64 = 10000000

module K:
    public:
        def g(into: i64, left: i64) -> i64:
            requires into >= 0
            requires into <= F::MAXF
            requires left >= 0
            ensure into != 0 or result == left
            return left if into == 0
            return 0

module Laws:
    public:
        def p(left: i64) -> i64:
            requires left >= 0
            ensure result == left
            return K::g(0, left)
