# Symbolic-range forall goals that must stay unproven (BACKLOG W-02).

def off_by_one(values: darray[i64]&, n: usize) -> usize:
    requires n < values.count
    requires forall i in 0..<n: values[i] == 0
    ensure forall i in 0..<n + 1: values[i] == 0
    return n

def wrong_lower(values: darray[i64]&, n: usize, a: usize) -> usize:
    requires a <= n
    requires n <= values.count
    requires forall i in 1..<n: values[i] == 0
    ensure forall i in a..<n: values[i] == 0
    return n

def other_body(values: darray[i64]&, n: usize) -> usize:
    requires forall i in 0..<n: values[i] == 0
    ensure forall i in 0..<n: values[i] == 1
    return n

def shadow(values: darray[i64]&, n: usize, j: usize) -> usize:
    requires forall i in 0..<n: values[j] == 0
    ensure forall j in 0..<n: values[j] == 0
    return n

def weaken_wrong_way(values: darray[i64]&, n: usize, m: i64, w: i64) -> usize:
    requires w <= m
    requires forall i in 0..<n: values[i] <= m
    ensure forall i in 0..<n: values[i] <= w
    return n

def weaken_wider(n: usize, k: usize, m: i64, w: i64) -> usize:
    requires m <= w
    requires forall i in 0..<n: i <= m
    ensure forall i in 0..<k: i <= w
    return n

def weaken_grown_missing_point(xs: darray[i64]&, k: usize, n: usize, m: i64, w: i64) -> usize:
    requires k < n
    requires n <= xs.count
    requires m <= w
    requires forall i in 0..<k: xs[i] <= m
    ensure forall i in 0..<k + 1: xs[i] <= w
    return n

def element_not_strict(xs: darray[i64]&, k: usize, m: i64) -> bool:
    requires k < xs.count
    requires xs[k] <= m
    ensures xs[k] < m
    return true

# The keep arm's step needs the old maximum below the new one; with the strict invariant it is not.
def bubble_pass_strict(xs: mutable darray[i64]&, n: usize) -> i64:
    requires 0 < n and n <= xs.count
    ensures forall i in 0..<n: xs[i] < result
    k: mutable usize = 0
    m: mutable i64 = xs[0]
    while k + 1 < n:
        invariant k < n
        invariant m == xs[k]
        invariant forall i in 0..<k: xs[i] < m
        if xs[k + 1] < m:
            xs[k] <- xs[k + 1]
            xs[k + 1] <- m
        else:
            m <- xs[k + 1]
        k <- k + 1
    return m

def congruence_other_index(xs: darray[i64]&, k: usize, j: usize, m: i64) -> bool:
    requires k < xs.count
    requires j < xs.count
    requires k == j + 1
    requires m == xs[j]
    ensures m == xs[k]
    return true

def congruence_other_container(xs: darray[i64]&, ys: darray[i64]&, k: usize, m: i64) -> bool:
    requires k < xs.count
    requires k < ys.count
    requires m == xs[k]
    ensures m == ys[k]
    return true

def negated_not_strict(xs: darray[i64]&, k: usize, m0: i64, m: i64) -> bool:
    requires k < xs.count
    requires not (xs[k] < m0)
    requires m == xs[k]
    ensures m0 < m
    return true

def negated_wrong_direction(xs: darray[i64]&, k: usize, m0: i64, m: i64) -> bool:
    requires k < xs.count
    requires not (xs[k] < m0)
    requires m == xs[k]
    ensures m <= m0
    return true

# The guard is not refuted: `hi <= n` allows `hi < n`.
def guard_not_refuted(xs: darray[i64]&, hi: usize, n: usize) -> bool:
    requires hi <= n
    requires n < xs.count
    ensures forall i in 0..<hi: (hi < n) => xs[i] <= xs[hi]
    return true

# The guard mentions the binder, so refuting it at one index says nothing about the others.
def guard_mentions_binder(xs: darray[i64]&, hi: usize, n: usize) -> bool:
    requires hi == n
    requires n <= xs.count
    ensures forall i in 0..<hi: (i < n) => xs[i] <= xs[0]
    return true

# A plain disjunction is not a guard: `hi < n` being false leaves the other side to prove.
def guard_not_negated(xs: darray[i64]&, hi: usize, n: usize) -> bool:
    requires hi == n
    requires n <= xs.count
    ensures forall i in 0..<hi: (hi < n) or xs[i] <= xs[0]
    return true

def instance_outside(xs: darray[i64]&, hi: usize) -> bool:
    requires 1 < hi
    requires hi < xs.count
    requires forall i in 0..<hi: xs[i] <= xs[hi]
    ensures xs[hi] <= xs[hi - 1] or xs[hi] <= xs[0] and xs[hi] < xs[hi]
    return true

def lower_missing_point(xs: darray[i64]&, lo: usize, n: usize) -> bool:
    requires n <= xs.count
    requires lo < n
    requires forall i in (lo + 1)..<n: xs[i] <= 5
    ensures forall i in lo..<n: xs[i] <= 5
    return true

def lower_two_short(xs: darray[i64]&, lo: usize, n: usize) -> bool:
    requires n <= xs.count
    requires lo + 1 < n
    requires forall i in (lo + 2)..<n: xs[i] <= 5
    requires xs[lo] <= 5
    ensures forall i in lo..<n: xs[i] <= 5
    return true

def narrow_keeps_write(xs: mutable darray[i64]&, lo: usize, n: usize) -> bool:
    requires n <= xs.count
    requires lo + 1 < n
    requires forall i in lo..<n: xs[i] <= 5
    ensures forall i in lo..<(n - 1): xs[i] <= 5
    xs[lo] <- 9
    return true

# The fact bounds `k + 1`, not the stepped value `k + 2`, so nothing is restated over it.
def binding_other_value(xs: darray[i64]&, n: usize) -> i64:
    requires 0 < n and n <= xs.count
    k: mutable usize = 0
    while k + 1 < n:
        invariant k < n
        k <- k + 2
    return xs[k]

def subscript_unequal(xs: darray[i64]&, k: usize, r: usize, hi: usize, m: i64) -> bool:
    requires 1 < hi and hi <= xs.count
    requires k == hi - 1
    requires r == hi - 2
    requires m == xs[k]
    requires m <= 5
    ensures xs[r] <= 5
    return true

def subscript_other_container(xs: darray[i64]&, ys: darray[i64]&, k: usize, r: usize, m: i64) -> bool:
    requires k < xs.count and r < ys.count
    requires k == r
    requires m == xs[k]
    requires m <= 5
    ensures ys[r] <= 5
    return true

# The read sits at the range's upper bound, outside it.
def alias_outside(xs: darray[i64]&, n: usize, p: i64, i: usize, j: usize, a: i64) -> bool:
    requires n <= xs.count
    requires i < j
    requires j < n
    requires forall t in i..<j: p <= xs[t]
    requires a == xs[j]
    ensures p <= a
    return true

# The read is from another container.
def alias_other_container(xs: darray[i64]&, ys: darray[i64]&, n: usize, p: i64, i: usize, j: usize, a: i64) -> bool:
    requires n <= xs.count
    requires n <= ys.count
    requires i < j
    requires j < n
    requires forall t in i..<j: p <= xs[t]
    requires a == ys[i]
    ensures p <= a
    return true

# A read carried across a write outside the range keeps nothing.
def alias_carried_outside(xs: mutable darray[i64]&, n: usize, p: i64, i: usize, j: usize) -> i64:
    requires n <= xs.count
    requires i < j
    requires j < n
    requires forall t in i..<j: p <= xs[t]
    ensures p <= result
    a: i64 = xs[j]
    xs[j] <- 0
    return a
