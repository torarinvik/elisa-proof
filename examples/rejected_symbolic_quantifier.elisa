# Symbolic-range forall goals that must stay unproven (BACKLOG W-02).

def off_by_one(values: darray[i64]&, n: usize) -> usize:
    requires n < values.count
    requires forall i in 0..<n: values[i] == 0
    ensure forall i in 0..<n + 1: values[i] == 0
    return n

def wrong_lower(values: darray[i64]&, n: usize, a: usize) -> usize:
    requires a <= n
    requires n <= values.count
    requires forall i in 1..<n: values[i] == 0
    ensure forall i in a..<n: values[i] == 0
    return n

def other_body(values: darray[i64]&, n: usize) -> usize:
    requires forall i in 0..<n: values[i] == 0
    ensure forall i in 0..<n: values[i] == 1
    return n

def shadow(values: darray[i64]&, n: usize, j: usize) -> usize:
    requires forall i in 0..<n: values[j] == 0
    ensure forall j in 0..<n: values[j] == 0
    return n

def weaken_wrong_way(values: darray[i64]&, n: usize, m: i64, w: i64) -> usize:
    requires w <= m
    requires forall i in 0..<n: values[i] <= m
    ensure forall i in 0..<n: values[i] <= w
    return n

def weaken_wider(n: usize, k: usize, m: i64, w: i64) -> usize:
    requires m <= w
    requires forall i in 0..<n: i <= m
    ensure forall i in 0..<k: i <= w
    return n

def weaken_grown_missing_point(xs: darray[i64]&, k: usize, n: usize, m: i64, w: i64) -> usize:
    requires k < n
    requires n <= xs.count
    requires m <= w
    requires forall i in 0..<k: xs[i] <= m
    ensure forall i in 0..<k + 1: xs[i] <= w
    return n

def element_not_strict(xs: darray[i64]&, k: usize, m: i64) -> bool:
    requires k < xs.count
    requires xs[k] <= m
    ensures xs[k] < m
    return true

# The keep arm's step needs the old maximum below the new one; with the strict invariant it is not.
def bubble_pass_strict(xs: mutable darray[i64]&, n: usize) -> i64:
    requires 0 < n and n <= xs.count
    ensures forall i in 0..<n: xs[i] < result
    k: mutable usize = 0
    m: mutable i64 = xs[0]
    while k + 1 < n:
        invariant k < n
        invariant m == xs[k]
        invariant forall i in 0..<k: xs[i] < m
        if xs[k + 1] < m:
            xs[k] <- xs[k + 1]
            xs[k + 1] <- m
        else:
            m <- xs[k + 1]
        k <- k + 1
    return m

def congruence_other_index(xs: darray[i64]&, k: usize, j: usize, m: i64) -> bool:
    requires k < xs.count
    requires j < xs.count
    requires k == j + 1
    requires m == xs[j]
    ensures m == xs[k]
    return true

def congruence_other_container(xs: darray[i64]&, ys: darray[i64]&, k: usize, m: i64) -> bool:
    requires k < xs.count
    requires k < ys.count
    requires m == xs[k]
    ensures m == ys[k]
    return true

def negated_not_strict(xs: darray[i64]&, k: usize, m0: i64, m: i64) -> bool:
    requires k < xs.count
    requires not (xs[k] < m0)
    requires m == xs[k]
    ensures m0 < m
    return true

def negated_wrong_direction(xs: darray[i64]&, k: usize, m0: i64, m: i64) -> bool:
    requires k < xs.count
    requires not (xs[k] < m0)
    requires m == xs[k]
    ensures m <= m0
    return true
