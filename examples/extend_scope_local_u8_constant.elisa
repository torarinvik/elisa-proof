# Match production layout: an extension owns both the constant and function.
module WbRuntime:
    const PROOF_SCOPE: u8 = 0

extend WbRuntime:
    public:
        const DUE_INTERVAL: u8 = 2

        def interval_status(value: u32) -> u8:
            ensure result <= 4
            period: u64 = value.u64()
            return WbRuntime::DUE_INTERVAL
