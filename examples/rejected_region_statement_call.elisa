# The boundary: a statement drops its result, so a result that carries a region is a region-owned
# value discarded without being bound or explicitly rejected, and stays refused.
struct Cell:
    value: mutable i64

def borrow_it[@r](cell: Cell& @r) -> Cell& @r:
    return cell

def discards_a_region_reference[@r](cell: Cell& @r) -> void:
    borrow_it(cell)
