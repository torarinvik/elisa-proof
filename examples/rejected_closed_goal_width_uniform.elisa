# Rejected control: (0 - 1) > 0 or (0 - 1) >= 22 is false at signed widths
# but true at unsigned ones, so the closed goal stays width-ambiguous.
module A:
    public:
        def f(role: i64) -> i64:
            ensure result > 0 or result >= 22
            if role == 8:
                return role + 14
            return 0 - 1
