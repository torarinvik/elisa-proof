# The accumulator exemption is for the header binding alone, and a loop's value block is checked,
# not trusted: an index inside it still needs its bound, the value still has to establish the
# ensure, and an ordinary immutable local the loop assigns is still a read-only write.

module RejectedLoopAccumulator:
    def an_accumulator_body_still_checks_its_index(values: darray[usize]&) -> usize:
        for index in 0..<values.count |found: usize = 0| -> found:
            break index if values[index + 1] < 10

    def an_accumulator_value_keeps_its_ensure(values: darray[usize]&) -> usize:
        ensure result == 0
        for value in values |count: usize = 0| -> count:
            count <- count + 1 if value < 10

    def an_ordinary_local_stays_immutable(values: darray[usize]&) -> usize:
        count: usize = 0
        for value in values |count|:
            count <- count + 1 if value < 10
        return count
