global mutable permission_counter: i64 = 0
global mutable permission_values: i64[1] = [0]
global mutable permission_index: usize = 0

def missing_read() -> i64:
    permission_counter

def missing_write() -> void:
    permission_counter <- 1

def write_only_reads() -> i64 can[Global.Write]:
    can Global{Write}:
        return permission_counter

def read_only_writes() -> void can[Global.Read]:
    can Global{Read}:
        permission_counter <- 1

def read_only_update() -> void can[Global.Read]:
    can Global{Read}:
        permission_counter <- permission_counter

def read_before_local_shadow() -> i64:
    observed: i64 = permission_counter
    permission_counter: i64 = 2
    observed

def read_after_block_shadow(flag: bool) -> i64:
    if flag:
        permission_counter: i64 = 2
    permission_counter

def read_counter() -> i64:
    can Global{Read}:
        return permission_counter

def forward_missing_read() -> i64:
    read_counter()

# A declaration row describes the contract; it does not authorize the access.
def signature_only_read() -> i64 can[Global.Read]:
    permission_counter

def signature_only_write() -> void can[Global.Write]:
    permission_counter <- 1

def indexed_read_write_only(index: usize) -> i64 can[Global.Write]:
    requires index < 1
    can Global{Write}:
        return permission_values[index]

def indexed_write_read_only(index: usize) -> void can[Global.Read]:
    requires index < 1
    can Global{Read}:
        permission_values[index] <- 1

def indexed_target_missing_index_read() -> void can[Global.Write]:
    can Global{Write}:
        if permission_index < 1:
            permission_values[permission_index] <- 1

def indexed_target_missing_root_write() -> void can[Global.Read]:
    can Global{Read}:
        if permission_index < 1:
            permission_values[permission_index] <- 1

def mutable_reference_read_only() -> i64 can[Global.Read]:
    can Global{Read}:
        borrowed: mutable i64& = &permission_counter
        return borrowed.i64()

def mutable_reference_write_only() -> i64 can[Global.Write]:
    can Global{Write}:
        borrowed: mutable i64& = &permission_counter
        return borrowed.i64()
