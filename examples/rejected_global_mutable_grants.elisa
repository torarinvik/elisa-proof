global mutable permission_counter: i64 = 0

def missing_read() -> i64:
    permission_counter

def missing_write() -> void:
    permission_counter <- 1

def write_only_reads() -> i64 can[Global.Write]:
    can Global{Write}:
        return permission_counter

def read_only_writes() -> void can[Global.Read]:
    can Global{Read}:
        permission_counter <- 1

def read_only_update() -> void can[Global.Read]:
    can Global{Read}:
        permission_counter <- permission_counter

def read_before_local_shadow() -> i64:
    observed: i64 = permission_counter
    permission_counter: i64 = 2
    observed

def read_after_block_shadow(flag: bool) -> i64:
    if flag:
        permission_counter: i64 = 2
    permission_counter

def read_counter() -> i64:
    can Global{Read}:
        return permission_counter

def forward_missing_read() -> i64:
    read_counter()

# A declaration row describes the contract; it does not authorize the access.
def signature_only_read() -> i64 can[Global.Read]:
    permission_counter

def signature_only_write() -> void can[Global.Write]:
    permission_counter <- 1
