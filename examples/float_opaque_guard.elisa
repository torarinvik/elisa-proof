# Floating-point functions are checked by syntactic fact containment only. The guard
# `not (length > EPSILON)` returns for NaN too, so the fall-through fact is exactly the
# callee's precondition, and no arithmetic about IEEE values is assumed.
module FloatTune:
    public:
        const EPSILON: f64 = 0.000001
        const ZERO: f64 = 0.0

def float_scale(x: f64, length: f64) -> f64:
    requires length > FloatTune::EPSILON
    return x / length

def float_normalize_x(x: f64, length: f64) -> f64:
    return 1.0 if not (length > FloatTune::EPSILON)
    return float_scale(x, length)

def float_guarded_pair(x: f64, length: f64) -> f64:
    if length > FloatTune::EPSILON and x > FloatTune::ZERO:
        return float_scale(x, length)
    return 0.0
