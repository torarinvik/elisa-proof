# The boundary of automated repair. The search proposes tactic scripts and admits one only if the
# checked engine solves the goal and the kernel replays the certificate it produced, so a goal that
# does not follow from its hypotheses has no script to find. `unrepaired` reports that the fixed
# vocabulary contained no proof — it never reports that the goal is false.
def unrelated_hypothesis(x: i64, y: i64) -> i64:
    requires x >= 0
    ensure result == y
    return x

def wrong_direction(x: i64, y: i64) -> i64:
    requires x >= y
    ensure result <= y
    return x

def needs_arithmetic_we_do_not_have(x: i64, y: i64) -> i64:
    requires x >= 0
    requires y >= 0
    ensure result >= x * y
    return x + y
