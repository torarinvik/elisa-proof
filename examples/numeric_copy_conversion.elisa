def copy_by_value(value: i64) -> i64:
    requires value == 7
    ensures result == 7
    saved: i64 = value.i64()
    return saved

def copy_implicit_scalar_reference(value: mutable i64&) -> i64:
    requires value == 7
    ensures result == 7
    saved: i64 = value.i64()
    return saved

def copy_explicit_scalar_reference_element(value: mutable i64&) -> i64:
    requires value[0] == 7
    ensures result == 7
    saved: i64 = value[0].i64()
    return saved

def copy_count_before_pop(values: mutable darray[i64]&) -> i64:
    requires values.count == 1
    ensures result == 1
    saved: i64 = values.count.i64()
    values.pop()
    return saved

def copy_count_without_pop(values: mutable darray[i64]&) -> i64:
    requires values.count == 1
    ensures result == 1
    saved: i64 = values.count.i64()
    return saved

def copy_scalar_before_write(value: mutable i64&) -> i64:
    requires value == 7
    ensures result == 7
    saved: i64 = value.i64()
    value <- 9
    return saved
