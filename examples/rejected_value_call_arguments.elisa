# A call argument is a value only when the enum can hold nothing a second path reaches: a
# container or view payload, a refinement hierarchy, `common:` fields, or a binding lent by
# `&mut` all leave the summary of the first call behind at the second.

module RejectedValueCallArguments:
    public:
        enum Bag:
            Empty
            Full(items: darray[i64])

        enum Label:
            Anon
            Named(text: sview)

        enum Shape:
            Dot
            Line(length: i64)

        enum Circle is Shape:
            Round(radius: i64)

        enum Tagged:
            common:
                tag: i64
            Plain
            Rich(level: i64)

        enum Nat:
            Zero
            Succ(prev: Nat)

        def bag_size(v: Bag) -> i64:
            ensure result >= 0
            0

        def container(v: Bag) -> i64:
            ensure result >= 0
            a: i64 = bag_size(v)
            b: i64 = bag_size(v)
            a if a > b else b

        def label_size(v: Label) -> i64:
            ensure result >= 0
            0

        def view(v: Label) -> i64:
            ensure result >= 0
            a: i64 = label_size(v)
            b: i64 = label_size(v)
            a if a > b else b

        def shape_size(v: Shape) -> i64:
            ensure result >= 0
            0

        def hierarchy(v: Shape) -> i64:
            ensure result >= 0
            a: i64 = shape_size(v)
            b: i64 = shape_size(v)
            a if a > b else b

        def tagged_size(v: Tagged) -> i64:
            ensure result >= 0
            0

        def common_fields(v: Tagged) -> i64:
            ensure result >= 0
            a: i64 = tagged_size(v)
            b: i64 = tagged_size(v)
            a if a > b else b

        def depth(n: Nat) -> i64:
            ensure result >= 0
            0

        def reset(n: mutable Nat&) -> i64:
            ensure result >= 0
            0

        def lent(n: Nat) -> i64:
            ensure result >= 0
            w: mutable Nat = n
            a: i64 = depth(w)
            b: i64 = reset(&w)
            c: i64 = depth(w)
            a if a > c else c
