module DisjunctiveNegationFallback:
    public:
        # `f != l or r == 0`: assume `f == l`, rewrite `r <= l - f` to `r <= 0`.
        def remaining(f: i64, l: i64, r: i64) -> i64:
            requires l >= 0
            requires f >= 0
            requires f <= l
            requires r >= 0
            requires r <= l - f
            ensure f != l or r == 0
            return 0

        # Modus ponens on a callee's disjunctive ensure: `v != v` is refuted.
        def pick(a: i64, b: i64) -> i64:
            ensure a != b or result == b
            return b if a == b
            return 0

        def same(v: i64) -> i64:
            ensure result == v
            return pick(v, v)
