# A pure callee's disjunctive postcondition survives the guard that uses it. After
# `raise ... if not live(t, s)` an element write keeps `s < CAPACITY`, and a short-circuit
# operand guarded by the same call sees the call's summary beside the guard itself.
module Guard:
    public:
        const CAPACITY: usize = 4

        error GuardError:
            Dead

        struct Table:
            live: mutable bool[Guard::CAPACITY]
            real: mutable bool[Guard::CAPACITY]
            stamp: u64[Guard::CAPACITY]

        def live(table: Table&, slot: usize) -> bool:
            ensure not result or slot < CAPACITY
            slot < CAPACITY and table.live[slot]

        def write_after_guard(table: mutable Table&, slot: usize) -> void error[GuardError]:
            raise GuardError.Dead if not live(table, slot)
            table.live[slot] <- false
            table.real[slot] <- false

        def and_guard(table: Table&, slot: usize) -> bool:
            live(table, slot) and table.real[slot]

        def or_guard(table: Table&, slot: usize, now: u64) -> u64:
            return 0 if not live(table, slot) or now < table.stamp[slot]
            now - table.stamp[slot]
