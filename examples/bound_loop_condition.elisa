# A loop condition is evaluated on every iteration, and a call in one has no statement boundary for
# the checker to apply a summary or a havoc at -- the same reason a call inside any larger value
# expression is refused. The consequence is worse for a loop than elsewhere: the condition is
# reported opaque, and an opaque condition leaves the loop with no post-state claim at all.
#
# Binding the call before the loop is the same program whenever the callee is a constant of its
# arguments, which is what a limit function is.

extend BoundLoopCondition:
    def limit() -> usize:
        return 8

    def a_bound_limit_leaves_the_condition_readable(start: usize) -> usize:
        bound: usize = limit()
        steps: mutable usize = start
        while steps < bound |steps, bound|:
            steps <- steps + 1
        return steps
