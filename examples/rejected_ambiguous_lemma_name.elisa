# Two lemmas share a name across modules. Lemma lookup is by name, so the pair is ambiguous:
# neither may be classified as an executable function (that used to crash the checker), the call
# must not contribute either lemma's postcondition, and each declaration reports the ambiguity.
module LeftLemmas:
    public:
        lemma shared_bound(x: i64):
            requires x >= 0
            ensure x >= 0

module RightLemmas:
    public:
        lemma shared_bound(x: i64):
            requires x >= 1
            ensure x >= 1

def use_ambiguous_lemma(x: i64) -> void:
    requires x >= 0
    assert x >= 0 by:
        LeftLemmas::shared_bound(x)
