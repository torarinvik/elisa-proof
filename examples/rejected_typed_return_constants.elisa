# The typed reading decides each comparison by the real value; a false claim stays unproven.
module TypedReturnConstantsRejected:
    public:
        def below_bound(flag: i64) -> i64:
            ensure result >= -5
            return -6 if flag > 0
            0

        def below_subtraction(flag: i64) -> i64:
            ensure 0 - 5 <= result
            return 0 - 6 if flag > 0
            0

        def above_bound(flag: i64) -> i64:
            ensure result <= -5
            return -4 if flag > 0
            -5

        def guarded_too_low(step: i64) -> i64:
            ensure result + 50000 >= 0
            return -50001 if step <= 0
            return 0 if step > 50
            step * 1000
