# A moved collection created in this function's inferred region cannot escape its frame.
def rejected_local_darray_return() -> darray[i64] can[Memory.Allocate, Abort.Panic]:
    local_values: mutable darray[i64] = []
    local_values.push(1)
    return move local_values

def main() -> usize can[Memory.Allocate, Abort.Panic]:
    values: darray[i64] = rejected_local_darray_return()
    return values.count
