# The right operand of `and` / `or` runs only for one value of the left, so an impure call there
# may or may not have happened. Refusing the whole statement -- which is what the value and branch
# gates did -- invalidated the path for the dominant guard shape in the kernel's own source:
# `return false if not a(...) or not b(...)` with `b` writing through a reference.
#
# The call is now checked as if it ran, its havoc is applied as if it ran, and nothing only the
# run could establish survives it. What does survive is what the havoc cannot touch.

def reset(counter: mutable usize&) -> bool:
    changes counter
    counter <- 0
    return true

# The negated guard is `depth < 127 and reset(counter)`; its first conjunct is over a by-value
# scalar the call cannot reach, so it survives the call and closes the goal.
def guard_with_a_skippable_call(counter: mutable usize&, depth: usize) -> usize:
    requires depth <= 200
    ensure result <= 127
    return 0 if depth >= 127 or not reset(counter)
    return depth

# A declaration whose initializer has the same shape keeps the path valid, and a fact over a
# by-value scalar the call cannot reach is still there afterwards.
def declaration_with_a_skippable_call(counter: mutable usize&, depth: usize, flag: bool) -> usize:
    requires depth <= 127
    ensure result <= 127
    written: bool = flag and reset(counter)
    return depth if written
    return 0

# A return value with the same shape keeps its path valid, so the function verifies and exports
# a summary; before this the caller below reported the callee as unverified.
def return_with_a_skippable_call(counter: mutable usize&, depth: usize) -> bool:
    return depth <= 127 and reset(counter)

def caller_of_the_returning_shape(counter: mutable usize&, depth: usize) -> usize:
    requires depth <= 100
    ensure result <= 100
    written: bool = return_with_a_skippable_call(counter, depth)
    return depth if written
    return 0
