# Both source occurrences of the result conditional are the same pure scalar expression.
# The replay kernel must prove each disjunct under the guard and its negation.
def conditional_result_both_arms(value: u64) -> usize:
    ensure result < 128 or result == 255
    return 18usize if value == 1 else 255usize

# The false arm is outside both accepted ranges and must not be hidden by the true arm.
def rejected_conditional_result_bad_arm(value: u64) -> usize:
    ensure result < 128 or result == 255
    return 18usize if value == 1 else 256usize

# A nearby but altered guard must not be treated as the conditional's exact identity.
def rejected_conditional_result_altered_guard(value: u64) -> usize:
    ensure result < 128 or (value == 2 and result == 255) or (value != 2 and result == 254)
    return 18usize if value == 1 else 255usize

# Five nested choices exceed the bounded case-split limit; replay must remain fail-closed.
def rejected_conditional_result_fuel(value: u64) -> usize:
    ensure result < 128 or result == 255
    return 18usize if value == 1 else (20usize if value == 2 else (30usize if value == 3 else (40usize if value == 4 else (50usize if value == 5 else 256usize))))
