# Returning a local runs nothing: the call that bound it already ran at the declaration, and its
# summary is what the checker learned there. A callee with a `requires` is not total, so it is not
# pure and its call havocs the caller's state -- at the call. The return used to treat the call
# text substituted for the local as a second, unsummarized call and cleared the facts again,
# losing the very summary that describes the returned value.

def bounded(x: i64) -> i64:
    requires x >= 0
    ensure result >= 0
    ensure result <= 1000000
    return 0

# The summary of the declaration's call is all that is known about `y`, and it survives `return y`.
def returned_local(x: i64) -> i64:
    requires x >= 0
    ensure result <= 1000000
    y: i64 = bounded(x)
    return y

def returned_literal_argument() -> i64:
    ensure result <= 1000000
    y: i64 = bounded(5)
    return y
