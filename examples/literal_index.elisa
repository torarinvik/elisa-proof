# A local bound to a collection literal is indexed through its recorded value, so the literal is
# the object whose bound is proved. Its count is its own length -- a `usize` whatever its elements
# are, and nothing can alias or resize a value -- and a guard over `name.count` is recorded over
# that same term. Every index below is proved, and every certificate replays.

def range_valid(start: usize, count: usize, total: usize) -> bool:
    ensure not result or start <= total and count <= total - start
    return false if start > total
    return false if count > total - start
    return true

# A direct guard over the local's count.
def guarded_read(start: usize) -> usize:
    children: darray[usize] = [1, 2, 3]
    return 0 if start >= children.count
    children[start]

# A loop over the literal's own range.
def first_above(limit: usize) -> usize:
    values: darray[usize] = [4, 9, 16]
    for slot in 0..<values.count:
        return slot if values[slot] > limit
    values.count

# Two literals in one frame, each read under its own guard.
def same_slot(start: usize) -> bool:
    children: darray[usize] = [1, 2, 3]
    others: darray[usize] = [4, 5]
    return false if start >= children.count or start >= others.count
    children[start] == others[start]

# A one-element range inside an empty literal: no call satisfies this guard, so the read after
# it is unreachable, and the bound is proved from the summary's contradiction.
def unreachable_read(start: usize) -> usize:
    children: darray[usize] = []
    return 0 if not range_valid(start, 1, children.count)
    children[start]
