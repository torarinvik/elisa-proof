# The expression matcher must substitute a named payload binder, not an outer parameter with the
# same spelling. This postcondition is false for the matched payload and must remain rejected.
enum ShadowPayload:
    Value(value: i64)

def rejected_value_match_payload_shadow(payload: ShadowPayload, value: i64) -> i64:
    ensure result == value
    return match payload:
        ShadowPayload.Value(value: value):
            value
        _:
            value
