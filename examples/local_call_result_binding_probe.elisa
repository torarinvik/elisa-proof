# A precondition prevents total-pure classification, but the stored call result
# is still one typed value with the verified postcondition of this invocation.
def checked_zero(code: u8) -> u8:
    requires code == 0
    ensure result == 0
    return code

def stored_checked_zero(code: u8) -> u8:
    requires code == 0
    ensure result == 0
    saved: u8 = checked_zero(code)
    return saved

def stored_checked_zero_wrong(code: u8) -> u8:
    requires code == 0
    ensure result == 1
    saved: u8 = checked_zero(code)
    return saved

def missing_checked_zero_precondition(code: u8) -> u8:
    ensure result == 0
    saved: u8 = checked_zero(code)
    return saved

def shadowed_checked_zero_wrong(code: u8) -> u8:
    requires code == 0
    ensure result == 1
    if code == 0:
        code: u8 = checked_zero(code)
        return code
    return 0
