# Each reading says exactly what it says. A place order guards one direction between one pair; a
# conjunct is not a disjunct; a negation denies only its own proposition; and a nonnegative value
# is not a positive one.

# The guard for `children.count - start` is `start <= children.count`, not its converse.
def a_place_order_in_the_wrong_direction(start: usize, count: usize, children: darray[usize]&) -> usize:
    requires children.count <= start
    requires count <= children.count - start
    total: mutable usize = 0
    for index in 0..<count |index, start, children, total|:
        total <- total + children[start + index]
    return total

# A guard on another place guards nothing here.
def a_place_order_on_another_pair(start: usize, other: darray[usize]&, children: darray[usize]&) -> usize:
    requires start <= other.count
    ensure result <= children.count
    return children.count - start

# A disjunction asserts neither side on its own.
def a_disjunct_is_not_a_conjunct(start: usize, count: usize, limit: usize, index: usize) -> bool:
    requires start <= limit or count <= limit - start
    requires index < count
    ensure result
    return start + index < limit

# `not p` denies `p`, and says nothing about `q`.
def a_negation_denies_only_itself(p: bool, q: bool, a: usize, b: usize) -> bool:
    requires not q or a <= b
    requires p
    ensure result
    return a <= b

# A non-wrapping unsigned value is nonnegative. It is not positive.
def nonnegative_is_not_positive(a: usize, b: usize) -> bool:
    requires b <= a
    ensure result
    return 0 < a - b

# The summary says what it says only where the caller has established its guard. Without the
# call's own result as a fact, the disjunction stands and asserts neither side.
def an_unguarded_summary_asserts_nothing(start: usize, count: usize, limit: usize, index: usize) -> bool:
    requires index < count
    ensure result
    return start + index < limit
