# Rebinding a mutable region reference must transfer, not duplicate, the exclusive
# owner capability. After `target <- source`, using both names as mutable owners
# would otherwise create two writable handles for one region-owned value.
def write_region_owner[@r](value: mutable i64& @r) -> void:
    value <- 9

def rejected_region_assign_duplicate_owner() -> i64 can[Memory.Allocate, Abort.Panic]:
    region r(1024)
    source: mutable i64& @r = new[r] 1
    target: mutable i64& @r = new[r] 2
    target <- source
    write_region_owner(source)
    write_region_owner(target)
    return 0

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    return rejected_region_assign_duplicate_owner()
