# A callee reaches its caller's state only through references and globals. A fact over a by-value
# scalar that the caller's body never lets escape is therefore still true after the call, and a
# conjunctive guard entails each of its parts, so the part over such a scalar survives even when
# the whole condition mentions a call. Together these re-establish a bounded-recursion
# precondition at the second and later calls of a frame, where nothing else in scope does.

# A callee that writes through a reference parameter: not pure, so a call to it havocs the
# caller's state exactly like an unknown one.
def reset(counter: mutable usize&) -> bool:
    changes counter
    counter <- 0
    return true

def bounded(value: usize) -> bool:
    ensure result == (value <= 127)
    return value <= 127

# `not bounded(depth) or depth >= 127` negates to a conjunction whose second part is over `depth`
# alone. The declared precondition is deliberately too weak; only the surviving part closes the
# goal, and it must survive a call that discards the condition it came from.
def survives_state_writing_call(counter: mutable usize&, depth: usize) -> usize:
    requires depth <= 200
    ensure result <= 127
    return 0 if not bounded(depth) or depth >= 127
    written: bool = reset(counter)
    return 0 if not written
    return depth

# Two state-writing calls in a row: without this the second call already has nothing left,
# because the first discarded everything the guard established.
def survives_second_call(counter: mutable usize&, depth: usize) -> usize:
    requires depth <= 200
    ensure result <= 127
    return 0 if not bounded(depth) or depth >= 127
    first: bool = reset(counter)
    second: bool = reset(counter)
    return 0 if not first or not second
    return depth

# A branch that binds a local is a proof-state barrier, but control still arrives here through an
# arm that held the fact at its exit. Only the parts over `depth` come back, so a branch-local
# binding cannot leak out with them.
def survives_branch_join(counter: mutable usize&, depth: usize) -> usize:
    requires depth <= 200
    ensure result <= 127
    return 0 if not bounded(depth) or depth >= 127
    if depth == 0:
        written: bool = reset(counter)
        return 0 if not written
    return depth

# A guard whose whole condition is the state-writing call: the arm that continues is then the
# complete state at the next statement, and only its call-stable parts may be imported.
def survives_call_guard(counter: mutable usize&, depth: usize) -> usize:
    requires depth <= 200
    ensure result <= 127
    return 0 if not bounded(depth) or depth >= 127
    return 0 if reset(counter)
    return depth

# A branch that returns leaves the other arm as the whole state at the next statement.
def survives_returning_branch(counter: mutable usize&, depth: usize) -> usize:
    requires depth <= 200
    ensure result <= 127
    return 0 if not bounded(depth) or depth >= 127
    if depth == 0:
        written: bool = reset(counter)
        return 0 if written
        return 1
    return depth
