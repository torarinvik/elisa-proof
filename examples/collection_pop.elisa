# `v.pop()` on a mutable darray reference parameter removes exactly one element and leaves the
# others alone (BACKLOG W-04).
def shrink(v: mutable darray[u32]&) -> void:
    requires v.count >= 1
    ensures v.count == old(v.count) - 1
    v.pop()

def shrink_twice(v: mutable darray[u32]&) -> void:
    requires v.count >= 2
    ensures v.count == old(v.count) - 2
    v.pop()
    v.pop()

def push_then_pop(v: mutable darray[u32]&, x: u32) -> void can[Memory.Allocate]:
    ensures v.count == old(v.count)
    v.push(x)
    v.pop()

def popped_was_nonempty(v: mutable darray[u32]&) -> void:
    ensures old(v.count) >= 1
    v.pop()

def keeps_prefix(v: mutable darray[u32]&) -> void:
    requires v.count >= 2 and v[0] == 7
    ensures v[0] == 7
    v.pop()

def pushed_survives_pop(v: mutable darray[u32]&, x: u32, y: u32) -> void can[Memory.Allocate]:
    ensures v[old(v.count)] == x
    v.push(x)
    v.push(y)
    v.pop()

# Budget: a long run of pops folds into one `S - k` term.
def shrink_many(v: mutable darray[u32]&) -> void:
    requires v.count >= 40
    ensures v.count == old(v.count) - 40
    v.pop()
    v.pop()
    v.pop()
    v.pop()
    v.pop()
    v.pop()
    v.pop()
    v.pop()
    v.pop()
    v.pop()
    v.pop()
    v.pop()
    v.pop()
    v.pop()
    v.pop()
    v.pop()
    v.pop()
    v.pop()
    v.pop()
    v.pop()
    v.pop()
    v.pop()
    v.pop()
    v.pop()
    v.pop()
    v.pop()
    v.pop()
    v.pop()
    v.pop()
    v.pop()
    v.pop()
    v.pop()
    v.pop()
    v.pop()
    v.pop()
    v.pop()
    v.pop()
    v.pop()
    v.pop()
    v.pop()
