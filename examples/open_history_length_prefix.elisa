# Enabling probe, not a replacement production scanner or admitted summary.
# A stable explicit cursor lets the prefix invariant remain in scope at exit.
def history_length_prefix(lengths: array[usize, 8]&) -> bool:
    ensure not result or (forall index in 0..<8: lengths[index] == 64)
    cursor: mutable i64 = 0
    while cursor < 8 |cursor, lengths|:
        invariant cursor >= 0 and cursor <= 8
        invariant forall index in 0..<8: index >= cursor or lengths[index] == 64
        decreases 8 - cursor
        return false if lengths[cursor] != 64
        cursor <- cursor + 1
    return true

# Distinguish prefix elimination from scalar arithmetic in the presence of a
# quantified premise. The extra premise must not poison unrelated reasoning.
def scalar_with_quantified_prefix(lengths: array[usize, 8]&, cursor: i64) -> i64:
    requires cursor >= 0 and cursor <= 8
    requires forall index in 0..<8: index >= cursor or lengths[index] == 64
    ensure 0 <= cursor
    return cursor
