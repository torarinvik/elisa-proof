# Source proposition formation must restore lexical bindings after each nested scope.
# Reusing a shadowed name with a different sort makes a leaked binding observable.
def source_context_scope(value: bool, branch: bool) -> bool:
    requires value
    if branch:
        value: i64 = 1
        assert value == 1
    else:
        value: i64 = 2
        assert value >= 1
    for value in 0..<1:
        assert value >= 0
    assert value
    return value
