def other_pair(a: i64, b: i64, c: i64) -> i64:
    requires a <= b
    requires a != c
    ensure a < b
    return a

def disequality_alone(a: i64, b: i64) -> i64:
    requires a != b
    ensure a < b
    return a

def two_steps(a: i64, b: i64) -> i64:
    requires a <= b
    requires a != b
    ensure a + 2 <= b
    return a
