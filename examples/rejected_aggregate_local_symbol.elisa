# Binding an aggregate local to its own symbol makes its places readable. It states nothing about
# the value, and every obligation the old spelling owed is still owed.

struct Affine:
    known: bool
    slot: usize

def affine_of(root: usize) -> Affine:
    return Affine{known: root < 4, slot: 0}

def make() -> darray[i64]:
    values: mutable darray[i64] = []
    values.push(1)
    return values

# No guard, so the index is still owed and still unproven -- the symbol says nothing about how many
# elements the callee returned.
def an_unguarded_index_is_still_owed(slot: usize) -> i64:
    matrix: darray[i64] = make()
    return matrix[slot]

# A guard over a different collection licenses nothing.
def a_guard_over_another_collection(slot: usize, other: darray[i64]&) -> i64:
    matrix: darray[i64] = make()
    return 0 if slot >= other.count
    return matrix[slot]

# The symbol is not a claim about the field's value: nothing says the callee returned a known
# affine, so the field cannot be assumed.
def a_field_is_not_a_claim(root: usize) -> bool:
    ensure result
    left: Affine = affine_of(root)
    return left.known

# A rebinding replaces the symbol, so a guard taken before it does not carry.
def a_rebound_local_loses_its_guard(slot: usize) -> i64:
    matrix: mutable darray[i64] = make()
    return 0 if slot >= matrix.count
    matrix <- make()
    return matrix[slot]
