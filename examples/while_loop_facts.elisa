# G75: a reduced `RetimeApply::source_times`. Inside `while t < end` the body may rely on the
# loop condition, the invariants and every fact over a binding it does not write (`end`); after
# the loop, a binding the body never writes keeps its pre-loop facts as well.

module WhileLoopFacts:
    public:
        const MAX_TIME: i64 = 1000000

        def step_at(t: i64) -> i64:
            requires t >= 0
            requires t <= MAX_TIME
            ensure result >= 1
            ensure result <= 1000
            return 1000

        # Clamp `next` to `stop`.
        def land(next: i64, stop: i64) -> i64:
            requires next >= 0
            requires stop >= 0
            ensure result >= 0
            ensure result <= stop
            if next > stop:
                return stop
            return next

        def finish(t: i64) -> i64:
            requires t >= 0
            requires t <= MAX_TIME
            ensure result == t
            return t

        # The source_times shape: an explicit guard just before the calls, the two `t`
        # invariants preserved through a clamp against the untouched `end`, and a call on
        # `end` after the loop that needs `end`'s precondition.
        def source_times(end: i64) -> i64:
            requires end >= 0
            requires end <= MAX_TIME
            t: mutable i64 = 0
            while t < end:
                invariant t >= 0
                invariant t <= MAX_TIME
                if t >= 0 and t <= MAX_TIME:
                    delta: i64 = step_at(t)
                    t <- land(t + delta, end)
                    t <- finish(t)
            return finish(end)
