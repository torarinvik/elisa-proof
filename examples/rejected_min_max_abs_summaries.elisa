def min_strict(a: i64, b: i64) -> i64:
    ensure result < a
    return a if a <= b else b

def max_one_side(a: i64, b: i64) -> i64:
    ensure result == a
    return a if a >= b else b

def min_shifted(a: i64, b: i64) -> i64:
    requires b < 1000
    ensure result == a or result == b
    return a if a <= b else b + 1

def abs_off_by_one(x: i64) -> i64:
    requires x >= -1000 and x <= 1000
    ensure result >= 1
    return -x if x < 0 else x

def min_of_min(a: i64, b: i64) -> i64:
    ensure result <= a
    ensure result == b
    return a if a <= b else b
