# Path-sensitive output-reference writes must be reflected at each return edge.
def reference_branch_output_write(output: mutable u8&, choose: bool) -> void:
    ensure choose or output[0] == 2
    ensure not choose or output[0] == 1
    if choose:
        output[0] <- 1
        return
    output[0] <- 2
    return

def reference_branch_output_write_false(output: mutable u8&, choose: bool) -> void:
    ensure choose or output[0] == 1
    ensure not choose or output[0] == 2
    if choose:
        output[0] <- 1
        return
    output[0] <- 2
    return

# A write made before a sequence of early-return branches must remain available
# along the path that survives each branch, while each returning path sees its
# own final write.
def reference_sequential_early_returns(output: mutable u8&, first: bool, second: bool) -> void:
    ensure first or second or output[0] == 3
    ensure not first or output[0] == 1
    ensure first or not second or output[0] == 2
    output[0] <- 0
    if first:
        output[0] <- 1
        return
    if second:
        output[0] <- 2
        return
    output[0] <- 3
    return

def reference_sequential_early_returns_false(output: mutable u8&, first: bool, second: bool) -> void:
    ensure first or second or output[0] == 4
    ensure not first or output[0] == 1
    ensure first or not second or output[0] == 2
    output[0] <- 0
    if first:
        output[0] <- 1
        return
    if second:
        output[0] <- 2
        return
    output[0] <- 3
    return
