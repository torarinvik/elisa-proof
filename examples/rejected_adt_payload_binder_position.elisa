# A positional binder takes the type of the field at its own position, wildcards included:
# `weight` is an i64 here, so the u8 range of the skipped `tag` field must not bound it.
enum Tagged:
    Plain
    Pair(tag: u8, weight: i64)

def tagged_weight(value: Tagged) -> i64:
    ensure result <= 255
    match value:
        Tagged.Plain:
            return 0
        Tagged.Pair(_, weight):
            return weight
