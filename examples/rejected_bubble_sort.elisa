# Bubble sorts that must not prove (BACKLOG W-04).

# A sort only orders its cells non-strictly; equal elements break a strict claim.
def strict_order(xs: mutable darray[i64]&, n: usize) -> void:
    requires n <= xs.count
    ensures forall i in 0..<n: (i + 1 < n) => xs[i] < xs[i + 1]
    hi: mutable usize = n
    while 0 < hi:
        invariant hi <= n
        invariant forall i in hi..<n: (i + 1 < n) => xs[i] <= xs[i + 1]
        invariant forall i in 0..<hi: (hi < n) => xs[i] <= xs[hi]
        k: mutable usize = 0
        m: mutable i64 = xs[0]
        while k + 1 < hi:
            invariant k < hi
            invariant m == xs[k]
            invariant forall i in 0..<k: xs[i] <= m
            invariant (hi < n) => m <= xs[hi]
            invariant forall i in (k + 1)..<hi: (hi < n) => xs[i] <= xs[hi]
            invariant forall i in hi..<n: (i + 1 < n) => xs[i] <= xs[i + 1]
            if xs[k + 1] < m:
                xs[k] <- xs[k + 1]
                xs[k + 1] <- m
            else:
                m <- xs[k + 1]
            k <- k + 1
        hi <- hi - 1

# Without the pass's suffix invariant the inner loop forgets the sorted tail.
def forgets_suffix(xs: mutable darray[i64]&, n: usize) -> void:
    requires n <= xs.count
    ensures forall i in 0..<n: (i + 1 < n) => xs[i] <= xs[i + 1]
    hi: mutable usize = n
    while 0 < hi:
        invariant hi <= n
        invariant forall i in hi..<n: (i + 1 < n) => xs[i] <= xs[i + 1]
        invariant forall i in 0..<hi: (hi < n) => xs[i] <= xs[hi]
        k: mutable usize = 0
        m: mutable i64 = xs[0]
        while k + 1 < hi:
            invariant k < hi
            invariant m == xs[k]
            invariant forall i in 0..<k: xs[i] <= m
            invariant (hi < n) => m <= xs[hi]
            invariant forall i in (k + 1)..<hi: (hi < n) => xs[i] <= xs[hi]
            if xs[k + 1] < m:
                xs[k] <- xs[k + 1]
                xs[k + 1] <- m
            else:
                m <- xs[k + 1]
            k <- k + 1
        hi <- hi - 1

# One pass short: the outer loop stops with two unsorted cells.
def one_pass_short(xs: mutable darray[i64]&, n: usize) -> void:
    requires n <= xs.count
    ensures forall i in 0..<n: (i + 1 < n) => xs[i] <= xs[i + 1]
    hi: mutable usize = n
    while 2 < hi:
        invariant hi <= n
        invariant forall i in hi..<n: (i + 1 < n) => xs[i] <= xs[i + 1]
        invariant forall i in 0..<hi: (hi < n) => xs[i] <= xs[hi]
        k: mutable usize = 0
        m: mutable i64 = xs[0]
        while k + 1 < hi:
            invariant k < hi
            invariant m == xs[k]
            invariant forall i in 0..<k: xs[i] <= m
            invariant (hi < n) => m <= xs[hi]
            invariant forall i in (k + 1)..<hi: (hi < n) => xs[i] <= xs[hi]
            invariant forall i in hi..<n: (i + 1 < n) => xs[i] <= xs[i + 1]
            if xs[k + 1] < m:
                xs[k] <- xs[k + 1]
                xs[k + 1] <- m
            else:
                m <- xs[k + 1]
            k <- k + 1
        hi <- hi - 1
