# Runtime adversarial control for the source-neutral arena admission API.
include "../src/proof/kernel_core.elisa"
include "../src/proof/kernel_replay.elisa"
using ElisaProofKernelCore
using ElisaProofKernelReplay

def main() -> i32:
    valid_nodes: mutable darray[ProofKernelNode] = []
    valid_children: mutable darray[usize] = []
    leaf: usize = add_node(&valid_nodes, "bool", "", 0, 0, 0, 0, 0, 1, "", "")
    valid_root: usize = add_node(&valid_nodes, "unary", "not", leaf, 0, 0, 0, 0, 0, "", "")
    valid_admitted: bool = proof_kernel_replay_arena_report(&valid_nodes, &valid_children, [], valid_root)
    return 1 if not valid_admitted

    self_nodes: mutable darray[ProofKernelNode] = []
    self_children: mutable darray[usize] = []
    self_root: usize = add_node(&self_nodes, "unary", "not", 0, 0, 0, 0, 0, 0, "", "")
    self_admitted: bool = proof_kernel_replay_arena_report(&self_nodes, &self_children, [], self_root)
    return 2 if self_admitted

    cycle_nodes: mutable darray[ProofKernelNode] = []
    cycle_children: mutable darray[usize] = []
    cycle_root: usize = add_node(&cycle_nodes, "unary", "not", 1, 0, 0, 0, 0, 0, "", "")
    add_node(&cycle_nodes, "unary", "not", cycle_root, 0, 0, 0, 0, 0, "", "")
    cycle_admitted: bool = proof_kernel_replay_arena_report(&cycle_nodes, &cycle_children, [], cycle_root)
    return 3 if cycle_admitted
    return 0
