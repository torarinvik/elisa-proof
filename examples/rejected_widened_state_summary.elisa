# Only a finding that widens the state keeps a summary. Every unproven obligation of the callee
# still disqualifies it, whether or not the callee also contains an unmodelled loop -- an unproven
# `ensure` above all, since that *is* the summary a caller would import.
def unproven_ensure_with_a_loop(values: darray[i64]&) -> i64:
    ensure result == 3
    total: mutable i64 = 0
    for v in values |v, total|:
        total <- total + v
    return total

def caller_gets_no_summary(values: darray[i64]&) -> i64:
    ensure result == 3
    return unproven_ensure_with_a_loop(values)

# An unproven obligation that is not about the contract disqualifies it just the same: the body
# may not reach its return at all.
def unproven_index(values: darray[i64]&, index: usize) -> i64:
    ensure result == result
    return values[index]

def caller_gets_no_summary_from_an_unproven_index(values: darray[i64]&, index: usize) -> i64:
    ensure result == result
    return unproven_index(values, index)

struct Box:
    value: mutable i64
    other: mutable i64

# The summary a caller imports is not only the `ensure`: an explicit, checked `changes` frame is
# what lets the caller's disjoint facts survive the call. So the frame has to be checked *through*
# the very construct the widening rule forgives, or the relaxation would export a false frame.
def writes_outside_its_frame(box: mutable Box&) -> i64:
    changes box.other
    ensure result == 3
    for i in 0..<1 |i, box|:
        box.value <- 99
    box.other <- 1
    return 3

def caller_gets_no_frame(box: mutable Box&) -> i64:
    ensure result == 3
    return writes_outside_its_frame(box)

# The same claim from the other side: a `preserves` the captured block writes over.
def breaks_what_it_preserves(box: mutable Box&) -> i64:
    preserves box.value
    changes box.other
    ensure result == 3
    for i in 0..<1 |i, box|:
        box.value <- 99
    box.other <- 1
    return 3

# A widened callee with no frame at all now *does* export its summary, so the call boundary is the
# only thing between the caller and a stale fact. The callee is accepted here and the caller is
# still refused -- that is the pair this whole change rests on. The loop is a `while` with no
# invariant, which is what widens a state now that a `for` is modelled either way.
def unframed_widened(box: mutable Box&) -> i64:
    ensure result == 3
    step: mutable usize = 0
    while step < 1 |step, box|:
        box.value <- 99
        step <- step + 1
    return 3

def caller_must_lose_the_fact(box: mutable Box&) -> i64:
    requires box.value == 5
    ensure result == 5
    ignored: i64 = unframed_widened(box)
    return box.value
