def step(x: i64) -> i64:
    requires x >= 0
    requires x <= 100
    ensure result >= 0
    ensure result <= 100
    ensure result <= x or result == 0
    return x if x < 50 else 0

# Twelve chained calls to one contracted function. Replay used to revalidate each summary's
# requires-certificates once per path, so this took exponential time; it must stay instant.
def dispatch(x: i64) -> i64:
    requires x >= 0
    requires x <= 100
    ensure result >= 0
    ensure result <= 100
    v0: i64 = step(x)
    v1: i64 = step(v0)
    v2: i64 = step(v1)
    v3: i64 = step(v2)
    v4: i64 = step(v3)
    v5: i64 = step(v4)
    v6: i64 = step(v5)
    v7: i64 = step(v6)
    v8: i64 = step(v7)
    v9: i64 = step(v8)
    v10: i64 = step(v9)
    v11: i64 = step(v10)
    return v11
