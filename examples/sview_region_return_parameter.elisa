# Returning an sview from a region-tied parameter must preserve the caller's backing region.
def borrow_region_view[@r](bytes: darray[u8]& @r) -> sview @r:
    return bytes.as_sview()

def sview_region_return_parameter() -> i64 can[Memory.Allocate, Abort.Panic]:
    observed_length: mutable i64 = 0
    region scratch(64)
    bytes: mutable darray[u8] @scratch = [65]
    if true:
        view: sview @scratch = borrow_region_view(bytes)
        observed_length <- view.len.i64()
    destroy scratch
    return observed_length

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    return sview_region_return_parameter()
