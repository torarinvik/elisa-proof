# A loop-header accumulator, `|count: usize = 0|`, is a local the loop assigns. The parser declares
# it with its bare type, so the declaration alone looks immutable; the header annotation marks the
# one binding the loop may write. A loop whose value is the accumulator, `for ... |count| -> count:`,
# returns that block's value, and the block's statements are checked on the way there.

module LoopAccumulator:
    def count_small(values: darray[usize]&) -> usize:
        for value in values |count: usize = 0| -> count:
            count <- count + 1 if value < 10

    def first_small(values: darray[usize]&) -> usize:
        for index in 0..<values.count |found: usize = 99| -> found:
            break index if values[index] < 10

    def bounded_total(values: darray[usize]&) -> usize:
        ensure result >= 0
        for value in values |total: usize = 0| -> total:
            invariant total >= 0
            total <- total + 1 if value < 10 and total < 1000
