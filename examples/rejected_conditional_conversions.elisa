# Only conversions are admitted in a conditional arm. A call that writes state may not run,
# and a widened value keeps its receiver's whole range: `widened_bound` is false at b = 255.
module RejectedConditionalConversions:
    global mutable ticks: u64 = 0

    def tick() -> u64:
        ticks <- ticks + 1 if ticks < 1000 else ticks
        ticks

    def counted(b: u8) -> u64:
        tick() if b >= 48 else 0

    def widened_bound(b: u8) -> u64:
        ensure result <= 254
        b.u64() if b >= 48 else 0
