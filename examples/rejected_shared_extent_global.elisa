# A shared borrow excludes every borrowed mutable path to the same object, but not a mutable
# global: a caller may lend `ambient_values` into `reads` shared while `clear_ambient` empties it
# directly, and the compiler accepts that. So the shared-extent rule is withdrawn from the whole
# program as soon as one mutable global is declared, and `borrowed.count` is no longer stable.
global mutable ambient_values: darray[i64] = []

def clear_ambient() -> void:
    ambient_values.resize(0)

def borrowed_extent_must_not_survive(borrowed: darray[i64]&, index: usize) -> i64:
    requires index < borrowed.count
    clear_ambient()
    return borrowed[index]

def caller() -> i64:
    ambient_values.resize(4)
    return borrowed_extent_must_not_survive(ambient_values, 2)
