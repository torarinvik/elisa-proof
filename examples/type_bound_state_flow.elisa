# Compiler typing still guarantees that an unsigned index is nonnegative after an unresolved
# call, but the call does not establish the collection's upper bound.

extern opaque_type_flow_step() -> void

def type_bound_after_opaque_call(values: darray[i64]&, index: usize) -> i64:
    opaque_type_flow_step()
    return values[index]
