# A region-polymorphic callee that does have a converged lifetime summary must compose into its
# caller. The value allocated into the region here is a struct literal, whose kernel node carries
# the constructed *type* on its left edge — unlike a record update, whose left edge is the base
# record being copied. Reading that type name as a runtime value looked it up as a binding, found
# none, and refused the allocation, so the caller proved and did not replay.
struct Cell:
    value: mutable i64

def peek[@r](cell: Cell& @r) -> i64:
    return cell.value

def region_reader() -> i64 can[Memory.Allocate, Abort.Panic]:
    region r(4096):
        cell: Cell& = new[r] Cell{value: 3}
        return peek(cell)

# A record update allocated into the same region. Its left edge really is a value — the base
# record being copied — so it must still be checked as one, while the construction above must not.
def region_update() -> i64 can[Memory.Allocate, Abort.Panic]:
    region r(4096):
        base: Cell = Cell{value: 1}
        cell: Cell& = new[r] base{value = 2}
        return peek(cell)
