# A negated guard is admitted only where a positive one would be: a comparison between two atoms,
# complemented. It says what it says about the pair it names, and no more.

# `not (total > start)` is `total <= start`, which is the guard for `start - total`.
def a_negation_of_the_wrong_order(start: usize, total: usize) -> usize:
    ensure result <= total
    return 0 if total > start
    return total - start

# `not (start == total)` is an inequality, and an inequality is not an order.
def an_inequality_is_not_an_order(start: usize, total: usize) -> usize:
    ensure result <= total
    return 0 if start == total
    return total - start

# A guard on another pair guards nothing here.
def a_guard_on_another_pair(start: usize, other: usize, total: usize) -> usize:
    ensure result <= total
    return 0 if other > total
    return total - start

# The guards give `count <= total - start`. They do not give it strictly.
def the_bound_the_guards_give_is_not_strict(start: usize, count: usize, total: usize) -> bool:
    ensure not result or count < total - start
    return false if start > total
    return false if count > total - start
    return true
