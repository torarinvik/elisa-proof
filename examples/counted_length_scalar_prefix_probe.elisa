# Diagnostic only: isolates scalar contracts from byte-helper traversal.
# This is not a replacement for the production scanner.
def counted_length_scalar_prefix_probe(lengths: array[usize, 8]&, count: usize) -> u8:
    ensure result <= 9
    ensure count <= 8 or result == 9
    ensure count != 0 or result == 0
    ensure count > 8 or result <= count
    ensure result != 0 or (forall index in 0..<8: index >= count or lengths[index] == 64)
    return 9 if count > 8
    return 0 if count == 0
    row: mutable i64 = 0
    while row < 8 |row, lengths, count|:
        invariant row >= 0 and row <= 8
        invariant forall index in 0..<8: index >= row or lengths[index] == 64
        decreases 8 - row
        return 0 if row >= count
        return (row + 1).u8() if lengths[row] != 64
        row <- row + 1
    return 0
