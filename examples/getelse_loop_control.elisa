# Get recovery transfers compose with the explicit loop flow model. The success path reaches the
# following statement; the absent path transfers to the nearest loop edge.
def getelse_break(xs: darray[i64]) -> i64:
    requires 0 < xs.count
    ensure result == 0
    while true:
        invariant true
        value: i64 = get xs[0] else break
        break
    return 0


def getelse_continue(xs: darray[i64]) -> i64:
    requires 0 < xs.count
    ensure result == 0
    while true:
        invariant true
        value: i64 = get xs[0] else continue
        break
    return 0
