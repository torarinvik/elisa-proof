def maximum_is_positive(value: u64) -> u64:
    requires value >= 18446744073709551615u64
    ensure result >= 1
    return value

def below_maximum_increment(value: u64) -> u64:
    requires value < 18446744073709551615u64
    ensure result >= 1
    return value + 1

def mirrored_u8_increment(value: u8) -> u8:
    requires 255u8 > value
    ensure result >= 1
    return value + 1

def negated_maximum_increment(value: u64) -> u64:
    requires not (value >= 18446744073709551615u64)
    ensure result >= 1
    return value + 1
