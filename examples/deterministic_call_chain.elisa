# A callee with a precondition is partial, so it is not a pure contract term, but a call that
# has run proved that precondition, and a body with no effects, no global reads and only
# by-value arguments returns a value fixed by those arguments. Its call text keeps denoting
# that value across later calls, so the summary facts of `first` survive the second call.

def bounded(x: i64) -> i64:
    requires x >= 0
    ensure result >= 0
    ensure result <= 1000000
    return x if x <= 1000000 else 1000000

def returned_chain(x: i64) -> i64:
    requires x >= 0
    ensure result <= 2000000
    first: i64 = bounded(x)
    second: i64 = bounded(first)
    return first + second

# A deterministic callee may call another deterministic callee.
def bounded_twice(x: i64) -> i64:
    requires x >= 0
    ensure result >= 0
    ensure result <= 1000000
    return bounded(bounded(x))

def nested_chain(x: i64) -> i64:
    requires x >= 0
    ensure result <= 2000000
    first: i64 = bounded_twice(x)
    second: i64 = bounded(x)
    return first + second
