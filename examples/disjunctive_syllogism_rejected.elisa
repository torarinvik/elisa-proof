def false_boolean_chain(a: bool, b: bool, c: bool, d: bool, e: bool, f: bool, g: bool) -> bool:
    requires a
    requires not a or b
    requires not b or c
    requires not c or d
    requires not d or e
    requires not e or f
    requires not f or g
    ensure not result
    return g

def missing_chain_link(a: bool, b: bool, c: bool) -> bool:
    requires a
    requires not a or b
    requires not c or b
    ensure result
    return c

# Do not treat a float ordering complement as a total-order axiom.
def unordered_float_alternative(code: f64, accepted: bool) -> bool:
    requires not (code < 3)
    requires code >= 3 or accepted
    ensure result
    return accepted
