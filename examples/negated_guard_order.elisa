# An early return leaves its condition negated, and that is the ordinary way a guard reaches the
# statements after it. The collector that feeds plain scalar orders to the subtraction solver read
# only positive comparisons, so `return false if start > total` bounded nothing and the very next
# statement could not subtract. Written as `requires start <= total`, or as a positive `if`, the
# same guard worked. The asymmetry was in the collector, not in the argument.
#
# The negation of a comparison between two atoms is a comparison between the same two atoms, so
# admitting it imports no arithmetic -- which is the invariant that keeps this solver from
# justifying a range question with the modular arithmetic it is deciding. The bound and difference
# collectors downstream already complement a negated comparison; only this one did not.

def a_guard_reaches_past_its_own_return(start: usize, count: usize, total: usize) -> bool:
    ensure not result or start <= total and count <= total - start
    return false if start > total
    return false if count > total - start
    return true

def a_guard_inside_a_disjunction_still_reaches(start: usize, count: usize, total: usize) -> bool:
    ensure not result or count <= total - start
    return false if start > total or count > total
    return false if count > total - start
    return true

def a_bounded_sum_follows_from_the_pair(start: usize, count: usize, total: usize, index: usize) -> bool:
    requires index < count
    requires start <= total
    requires count <= total - start
    ensure result
    return start + index < total
