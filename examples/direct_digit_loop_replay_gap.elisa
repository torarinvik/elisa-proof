# Minimized sound-asset preservation: direct bounded digit now replays completely.
def digit_loop(digit: u64) -> u64:
    requires digit <= 9
    ensure result <= 1000000
    for index in 0..<1 |value: u64 = 0| -> value:
        invariant value <= 1000000
        value <- 1000000 if value >= 1000000 / 10 else value * 10 + digit
