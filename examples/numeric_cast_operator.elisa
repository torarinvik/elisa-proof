# Compiler-provided numeric casts are scalar operations, not user protocol calls.
def numeric_cast_request_status(requested: i64, host_limit: usize) -> u8:
    if requested <= 0:
        return 1
    if requested.u64() > host_limit.u64():
        return 1
    return 0

def numeric_cast_effective(requested: i64, manifest: i64, host_limit: usize) -> i64:
    return 0 if numeric_cast_request_status(requested, host_limit) != 0
    return 0 if manifest < 0
    return requested if manifest == 0 or requested < manifest
    return manifest if manifest.u64() <= host_limit.u64()
    return host_limit.i64()
