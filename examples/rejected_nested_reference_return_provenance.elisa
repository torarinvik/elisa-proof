# pick returns `first` from inside a branch and `second` at top level. Its summary names no
# single formal, so a caller must not treat the result as backed by `second` alone and accept
# the write to `a` while `chosen` (which is `a` here) is live.
def pick[@r](first: mutable i64& @r, second: mutable i64& @r, flag: bool) -> mutable i64& @r:
    if flag:
        return first
    return second

def wrapper[@r](first: mutable i64& @r, second: mutable i64& @r) -> mutable i64& @r:
    return pick(first, second, true)

def rejected_nested_reference_return_provenance() -> i64 can[Memory.Allocate, Abort.Panic]:
    region scratch(1024)
    a: mutable i64& @scratch = new[scratch] 1
    b: mutable i64& @scratch = new[scratch] 2
    chosen: mutable i64& @scratch = wrapper(a, b)
    a <- 5
    chosen <- 6
    return 0

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    return rejected_nested_reference_return_provenance()
