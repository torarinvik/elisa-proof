def function_focus_leaf(value: i64) -> i64:
    ensure result == value + 1
    return value + 1

def function_focus_caller(value: i64) -> i64:
    ensure result == value + 1
    return function_focus_leaf(value)

def function_focus_unrequested_valid(value: i64) -> i64:
    ensure result == value
    return value
