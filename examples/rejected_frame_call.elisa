# A callee's frame must fit inside the caller's declared changes frame.

struct Box:
    value: mutable i64
    other: mutable i64

def set_other(box: mutable Box&) -> void:
    changes box.other
    box.other <- 1

def caller_frame_too_small(box: mutable Box&) -> void:
    changes box.value
    set_other(box)
