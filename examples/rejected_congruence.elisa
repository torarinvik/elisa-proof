# Adversarial companion to `congruence.elisa`. Every declaration here states a goal that ground
# congruence must refuse. None of these obligations may prove, and none may emit a certificate.

struct Point:
    x: i64
    y: i64

def pure_identity(value: i64) -> i64:
    ensure result == value
    return value

# A disequality is not an equality premise and must not seed the relation.
def disequality_premise(a: i64, b: i64, c: i64) -> i64:
    requires a != b
    ensure a + c == b + c
    return 0

# An order premise says nothing about identity.
def order_premise(a: i64, b: i64, c: i64) -> i64:
    requires a < b
    ensure a + c == b + c
    return 0

# An equality under a disjunction is not asserted.
def disjunctive_premise(a: i64, b: i64, c: i64, d: i64) -> i64:
    requires a == b or c == d
    ensure a + c == b + c
    return 0

# Congruence needs the operands to be pairwise equal, not merely one pair.
def unrelated_operand(a: i64, b: i64, c: i64, d: i64) -> i64:
    requires a == b
    ensure a + c == b + d
    return 0

# The former must be the same on both sides.
def distinct_former(a: i64, b: i64, c: i64) -> i64:
    requires a == b
    ensure a + c == b - c
    return 0

# `==` on a struct operand is Elisa's `Eq` protocol, so `p == q` is a call to a user `__eq__`
# that need not be Leibniz equality: it may compare a subset of the fields. Neither the premise
# nor the conclusion is admissible, so no field of an equated pair may be equated.
def struct_equality_premise(p: Point, q: Point) -> i64:
    requires p == q
    ensure p.x == q.x
    return 0

# Indexing is user-implementable through the `Index` protocol, and the selected element's
# equality is not known to be primitive either.
def indexed_element(values: i64[4], i: i64, j: i64) -> i64:
    requires i == j
    ensure values[i] == values[j]
    return 0

# Aggregate construction has the same two problems as struct equality.
def constructed_aggregate(a: i64, b: i64, c: i64) -> i64:
    requires a == b
    ensure Point{x: a, y: c} == Point{x: b, y: c}
    return 0

# A call is never a congruent former: equal arguments must not be carried through it, even when
# the callee is a verified total-pure function, because the kernel holds no functional
# congruence rule. (A verified total-pure call *result* over witnessed arguments is a witnessed
# atom, so an equated pair of such results may travel through arithmetic; see
# `congruence_pure_call_result` in `congruence.elisa`. That is a different claim.)
def call_congruence(a: i64, b: i64) -> i64:
    requires a == b
    ensure pure_identity(a) == pure_identity(b)
    return 0

# Same value, different fixed width: the wrapping former is not shared, so no equality may
# travel through it.
def cross_width(x: u8, y: u16) -> i64:
    requires x.cast[u16] == y
    ensure x.cast[u16] + 200 == y + 200
    return 0

# Same width, but the sum may wrap. The signed tiers are not allowed to interpret it at all.
def wrapping_operand(x: u8, y: u8) -> i64:
    requires x == y
    ensure x + 200 == y + 200
    return 0
