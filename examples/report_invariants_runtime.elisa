# Small executable boundary test for the report invariants. The model is intentionally reduced
# to the report fields consumed by report_invariants.elisa, keeping this fast enough to run
# independently of the full checker and kernel build.
module ElisaProof:
    public:
        struct ProofFinding:
            kind: sview

        struct ProofDeclarationSummary:
            kind: sview

        struct ProofGoalAttempt:
            proven: bool

        struct ProofReport:
            declarations: mutable u32
            obligations: mutable u32
            proven: mutable u32
            failed: mutable u32
            findings: mutable darray[ProofFinding]
            declaration_details: mutable darray[ProofDeclarationSummary]
            goal_attempts: mutable darray[ProofGoalAttempt]

include "../src/proof/model/report_invariants.elisa"

using ElisaProof

const FAILURE_WITHOUT_FINDING_ACCEPTED: i64 = 1
const FINDING_WITHOUT_FAILURE_ACCEPTED: i64 = 2
const OPEN_GOAL_MARKED_COMPLETE: i64 = 3
const EMPTY_REPORT_REJECTED: i64 = 4
const EMPTY_REPORT_MARKED_INCOMPLETE: i64 = 5
const DECLARATION_WITHOUT_SUMMARY_ACCEPTED: i64 = 6
const SINGLE_REPORTED_ITEM: u32 = 1

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    report: mutable ProofReport = ProofReport{declarations: 0, obligations: 0, proven: 0, failed: 0, findings: [], declaration_details: [], goal_attempts: []}
    return EMPTY_REPORT_REJECTED if not proof_report_failure_count_consistent(report)
    return EMPTY_REPORT_MARKED_INCOMPLETE if proof_report_source_has_unresolved_checks(report, false, 0)

    # A report cannot hide a declaration that was present in the source but never represented
    # in the admission inventory, even when no goal happened to be generated for it.
    report.declarations <- SINGLE_REPORTED_ITEM
    return DECLARATION_WITHOUT_SUMMARY_ACCEPTED if not proof_report_source_has_unresolved_checks(report, false, 0)
    report.declarations <- 0

    report.failed <- SINGLE_REPORTED_ITEM
    return FAILURE_WITHOUT_FINDING_ACCEPTED if not proof_report_source_has_unresolved_checks(report, false, 0)

    report.failed <- 0
    report.findings.push(ProofFinding{kind: "proof-unknown"})
    return FINDING_WITHOUT_FAILURE_ACCEPTED if not proof_report_source_has_unresolved_checks(report, false, 0)

    report.findings.clear()
    report.obligations <- SINGLE_REPORTED_ITEM
    report.goal_attempts.push(ProofGoalAttempt{proven: false})
    return OPEN_GOAL_MARKED_COMPLETE if not proof_report_source_has_unresolved_checks(report, false, 0)
    return 0
