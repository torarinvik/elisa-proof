# Small test-only report model shared by the invariant mutation harnesses.
include "report_inventory_test_support.elisa"
using ElisaProof

# Characterize the rejected aggregate proposal, including its dependency on report-owned
# scheduling metadata. This is test-only code; it is deliberately not an admission rule.
def candidate_aggregate_source_gate(report: ProofReport&) -> bool:
    required: mutable usize = 0
    for declaration in report.source_declarations |required, report|:
        match declaration:
            Ast::Decl.Func(name, _, _, body, _, _, position):
                scheduled: mutable bool = false
                for summary in report.declaration_details |name, position, scheduled|:
                    scheduled <- summary.kind == "function" and summary.verification_reason != "not-checked" if summary.name == name and summary.line == position.line
                has_ensure: mutable bool = false
                has_return: mutable bool = false
                for statement in body |has_ensure, has_return|:
                    match statement:
                        Ast::Stmt.Contract(kind, _, _):
                            has_ensure <- true if kind == "ensure" or kind == "ensures"
                        Ast::Stmt.Return(_, _):
                            has_return <- true
                        _:
                            pass
                required <- required + 1 if scheduled and has_ensure and has_return
            _:
                pass
    return report.obligations.usize() >= required

def source_function_with_postcondition_is(report: ProofReport&, index: usize, expected_name: sview) -> bool:
    return false if index >= report.source_declarations.count
    match report.source_declarations[index]:
        Ast::Decl.Func(name, _, _, body, _, _, _):
            has_ensure: mutable bool = false
            has_return: mutable bool = false
            for statement in body |has_ensure, has_return|:
                match statement:
                    Ast::Stmt.Contract(kind, _, _):
                        has_ensure <- true if kind == "ensure" or kind == "ensures"
                    Ast::Stmt.Return(_, _):
                        has_return <- true
                    _:
                        pass
            return name == expected_name and has_ensure and has_return
        _:
            return false

const FAILURE_WITHOUT_FINDING_ACCEPTED: i64 = 1
const FINDING_WITHOUT_FAILURE_ACCEPTED: i64 = 2
const OPEN_GOAL_MARKED_COMPLETE: i64 = 3
const EMPTY_REPORT_REJECTED: i64 = 4
const EMPTY_REPORT_MARKED_INCOMPLETE: i64 = 5
const DECLARATION_WITHOUT_SUMMARY_ACCEPTED: i64 = 6
const DECLARATION_INVENTORY_ADMITTED_FOR_FOCUSED_GOAL: i64 = 7
const PROVEN_WITHOUT_ATTEMPT_ADMITTED: i64 = 8
const REMOVED_PROVEN_ATTEMPT_ADMITTED: i64 = 9
const PROVEN_ATTEMPT_COUNT_REJECTED: i64 = 10
const SINGLE_REPORTED_ITEM: u32 = 1
const COORDINATED_ATTEMPT_AND_TOTAL_DELETION_ADMITTED: i64 = 21
const OBLIGATION_LEDGER_DELETION_ADMITTED: i64 = 22
const OBLIGATION_RESULT_FORGERY_ADMITTED: i64 = 23
const NON_GOAL_OPEN_OBLIGATION_REJECTED: i64 = 24
const DUPLICATED_PROVEN_OBLIGATION_ADMITTED: i64 = 25
const REORDERED_OBLIGATION_LEDGER_ADMITTED: i64 = 27
const FORGED_OBLIGATION_IDENTITY_ADMITTED: i64 = 28
const OMITTED_EVENT_PRE_LEDGER_REJECTED: i64 = 29
const OMITTED_EVENT_ADMITTED: i64 = 30
const DUPLICATED_EVENT_PRE_LEDGER_REJECTED: i64 = 31
const DUPLICATED_EVENT_ADMITTED: i64 = 32
const TWO_EVENT_PRE_LEDGER_REJECTED: i64 = 33
const OMITTED_OPEN_OBLIGATION_WITH_ATTEMPT_ADMITTED: i64 = 34
const SOURCE_REQUIRED_EXECUTABLE_OBLIGATION_OMISSION_ADMITTED: i64 = 35
const SOURCE_REQUIRED_EXECUTABLE_OBLIGATION_CONTROL_REJECTED: i64 = 36
const SOURCE_REQUIRED_EXECUTABLE_OBLIGATION_DUPLICATE_ADMITTED: i64 = 37
const SOURCE_REQUIRED_EXECUTABLE_OBLIGATION_FALSE_CERTIFICATE_CLAIM_ADMITTED: i64 = 38
const SOURCE_PLURAL_ENSURE_INVENTORY_DROPPED: i64 = 39
const SOURCE_MISMATCHED_RETURN_INVENTORY_DROPPED: i64 = 40
const SOURCE_MISMATCHED_RETURN_COVERED_WITHOUT_REPLAY: i64 = 41
const SOURCE_MISMATCHED_RETURN_FALSE_GOAL_ADMITTED: i64 = 42
const SOURCE_REVERSED_MISMATCHED_RETURN_INVENTORY_DROPPED: i64 = 43
const SOURCE_ASSERT_BY_INVENTORY_DROPPED: i64 = 44
const SOURCE_ASSERT_BY_VALID_CONTROL_REJECTED: i64 = 45
const SOURCE_ASSERT_BY_OMISSION_ADMITTED: i64 = 46
const SOURCE_ASSERT_BY_DUPLICATE_ADMITTED: i64 = 47
const SOURCE_ASSERT_BY_FALSE_CLAIM_ADMITTED: i64 = 48
const SOURCE_ASSERT_BY_MALFORMED_ADMITTED: i64 = 49
const SOURCE_ASSERT_BY_FAILED_GOAL_ADMITTED: i64 = 50
const SOURCE_ASSERT_BY_SOURCE_MISMATCH_ADMITTED: i64 = 51
const SOURCE_ASSERT_BY_UNSUPPORTED_SCOPE_NOT_RETAINED: i64 = 52
const SOURCE_LITERAL_NESTED_OBLIGATION_OMITTED: i64 = 53
const SOURCE_ASSERT_BY_POSITION_LINE: u32 = 90
const SOURCE_ASSERT_BY_KEYWORD_LINE: u32 = 89
const SOURCE_ASSERT_BY_STEP_LINE: u32 = 91
const SOURCE_ASSERT_BY_GOAL_OFFSET: u32 = 900
const SOURCE_ASSERT_BY_STEP_OFFSET: u32 = 910

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    report: mutable ProofReport = ProofReport{current_source_postcondition_count: 0, current_source_postcondition_line: 0, current_source_postcondition_name: "", focused_function: "", declarations: 0, obligations: 0, proven: 0, failed: 0, findings: [], source_declarations: [], declaration_details: [], goal_attempts: [], obligation_inventory: [], certificates: [], theorems: ProofTheoremTable{summaries: []}}
    return EMPTY_REPORT_REJECTED if not proof_report_failure_count_consistent(report)
    return EMPTY_REPORT_MARKED_INCOMPLETE if proof_report_source_has_unresolved_checks(report, false, 0)

    plural_position: Ast::Pos = Ast::pos_at_line(70)
    plural_goal: Ast::Expr = Ast::Expr.Binary(Ast::Expr.Ident("result", plural_position), TokenKind.EqEq, Ast::Expr.IntLit(7, plural_position), plural_position)
    plural_contract: Ast::Stmt = Ast::Stmt.Contract("ensures", plural_goal, plural_position)
    plural_return: Ast::Stmt = Ast::Stmt.Return(Ast::Expr.IntLit(7, plural_position), plural_position)
    plural_body: darray[Ast::Stmt] = [plural_contract, plural_return]
    plural_function: Ast::Decl = Ast::Decl.Func("plural_source", [], Ast::Expr.Absent, plural_body, [], [], plural_position)
    plural_declarations: darray[Ast::Decl] = [plural_function]
    plural_inventory: darray[(name: sview, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool)] = proof_source_literal_ensure_inventory(plural_declarations)
    return SOURCE_PLURAL_ENSURE_INVENTORY_DROPPED if plural_inventory.count != 1
    return SOURCE_PLURAL_ENSURE_INVENTORY_DROPPED if plural_inventory[0].name != "plural_source" or plural_inventory[0].contract_value != 7 or plural_inventory[0].returned_value != 7 or not plural_inventory[0].result_on_left or not plural_inventory[0].equality_postcondition

    # A nested implementation scope is visited by proof scheduling, but its bare-name goal
    # identity cannot be authenticated by this source inventory. It must leave an explicit
    # unsupported row; an empty inventory would let the source obligation evade coverage.
    nested_literal_contract: Ast::Stmt = Ast::Stmt.Contract("ensure", plural_goal, plural_position)
    nested_literal_return: Ast::Stmt = Ast::Stmt.Return(Ast::Expr.IntLit(7, plural_position), plural_position)
    nested_literal_body: darray[Ast::Stmt] = [nested_literal_contract, nested_literal_return]
    nested_literal_function: Ast::Decl = Ast::Decl.Func("nested_literal_source", [], Ast::Expr.Absent, nested_literal_body, [], [], plural_position)
    nested_literal_module: Ast::Decl = Ast::Decl.Module("NestedLiteral", [nested_literal_function], plural_position)
    nested_literal_declarations: darray[Ast::Decl] = [nested_literal_module]
    nested_literal_inventory: darray[(name: sview, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool)] = proof_source_literal_ensure_inventory(nested_literal_declarations)
    return SOURCE_LITERAL_NESTED_OBLIGATION_OMITTED if nested_literal_inventory.count != 1 or nested_literal_inventory[0].name != ""
    return SOURCE_LITERAL_NESTED_OBLIGATION_OMITTED if proof_source_literal_ensure_coverage(nested_literal_inventory, report)

    mismatch_position: Ast::Pos = Ast::pos_at_line(80)
    mismatch_goal: Ast::Expr = Ast::Expr.Binary(Ast::Expr.Ident("result", mismatch_position), TokenKind.EqEq, Ast::Expr.IntLit(7, mismatch_position), mismatch_position)
    mismatch_contract: Ast::Stmt = Ast::Stmt.Contract("ensures", mismatch_goal, mismatch_position)
    mismatch_return: Ast::Stmt = Ast::Stmt.Return(Ast::Expr.IntLit(8, mismatch_position), mismatch_position)
    mismatch_body: darray[Ast::Stmt] = [mismatch_contract, mismatch_return]
    mismatch_function: Ast::Decl = Ast::Decl.Func("mismatched_source", [], Ast::Expr.Absent, mismatch_body, [], [], mismatch_position)
    mismatch_declarations: darray[Ast::Decl] = [mismatch_function]
    mismatch_inventory: darray[(name: sview, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool)] = proof_source_literal_ensure_inventory(mismatch_declarations)
    return SOURCE_MISMATCHED_RETURN_INVENTORY_DROPPED if mismatch_inventory.count != 1
    return SOURCE_MISMATCHED_RETURN_INVENTORY_DROPPED if mismatch_inventory[0].name != "mismatched_source" or mismatch_inventory[0].contract_value != 7 or mismatch_inventory[0].returned_value != 8 or not mismatch_inventory[0].result_on_left or not mismatch_inventory[0].equality_postcondition
    return SOURCE_MISMATCHED_RETURN_COVERED_WITHOUT_REPLAY if proof_source_literal_ensure_coverage(mismatch_inventory, report)

    reversed_mismatch_goal: Ast::Expr = Ast::Expr.Binary(Ast::Expr.IntLit(7, mismatch_position), TokenKind.EqEq, Ast::Expr.Ident("result", mismatch_position), mismatch_position)
    reversed_mismatch_contract: Ast::Stmt = Ast::Stmt.Contract("ensures", reversed_mismatch_goal, mismatch_position)
    reversed_mismatch_body: darray[Ast::Stmt] = [reversed_mismatch_contract, mismatch_return]
    reversed_mismatch_function: Ast::Decl = Ast::Decl.Func("reversed_mismatched_source", [], Ast::Expr.Absent, reversed_mismatch_body, [], [], mismatch_position)
    reversed_mismatch_declarations: darray[Ast::Decl] = [reversed_mismatch_function]
    reversed_mismatch_inventory: darray[(name: sview, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool)] = proof_source_literal_ensure_inventory(reversed_mismatch_declarations)
    return SOURCE_REVERSED_MISMATCHED_RETURN_INVENTORY_DROPPED if reversed_mismatch_inventory.count != 1 or reversed_mismatch_inventory[0].contract_value != 7 or reversed_mismatch_inventory[0].returned_value != 8 or reversed_mismatch_inventory[0].result_on_left

    # Even a fabricated replay flag for result==7 cannot discharge the source proposition
    # after the body returns 8; the source inventory expects the substituted 8==7 goal.
    fabricated_contract_goal: Ast::Expr = Ast::Expr.Binary(Ast::Expr.IntLit(7, mismatch_position), TokenKind.EqEq, Ast::Expr.IntLit(7, mismatch_position), mismatch_position)
    fabricated_claim_report: mutable ProofReport = ProofReport{current_source_postcondition_count: 0, current_source_postcondition_line: 0, current_source_postcondition_name: "", focused_function: "", declarations: 0, obligations: 0, proven: 0, failed: 0, findings: [], source_declarations: [], declaration_details: [], goal_attempts: [], obligation_inventory: [], certificates: [], theorems: ProofTheoremTable{summaries: []}}
    fabricated_claim_report.goal_attempts.push(ProofGoalAttempt{goal: fabricated_contract_goal, budget_exhausted: false, facts_start: 0, facts_count: 0, kernel_goal: 0, kernel_facts_start: 0, kernel_facts_count: 0, line: 80, name: "mismatched_source", rule: "goal", proven: true, has_certificate: true, certificate_index: 0})
    fabricated_claim_report.certificates.push(ProofGoalCertificate{goal: fabricated_contract_goal, facts_start: 0, facts_count: 0, kernel_goal: 0, kernel_facts_start: 0, kernel_facts_count: 0, line: 80, name: "mismatched_source", rule: "goal", replayed: true})
    return SOURCE_MISMATCHED_RETURN_FALSE_GOAL_ADMITTED if proof_source_literal_ensure_coverage(mismatch_inventory, fabricated_claim_report)

    assert_by_position: Ast::Pos = Ast::Pos{line: SOURCE_ASSERT_BY_POSITION_LINE, column: 1, offset: SOURCE_ASSERT_BY_GOAL_OFFSET, end_line: SOURCE_ASSERT_BY_POSITION_LINE, end_column: 2, end_offset: SOURCE_ASSERT_BY_GOAL_OFFSET + 1}
    assert_by_keyword_position: Ast::Pos = Ast::pos_at_line(SOURCE_ASSERT_BY_KEYWORD_LINE)
    assert_by_step_position: Ast::Pos = Ast::Pos{line: SOURCE_ASSERT_BY_STEP_LINE, column: 1, offset: SOURCE_ASSERT_BY_STEP_OFFSET, end_line: SOURCE_ASSERT_BY_STEP_LINE, end_column: 2, end_offset: SOURCE_ASSERT_BY_STEP_OFFSET + 1}
    assert_by_goal: Ast::Expr = Ast::Expr.BoolLit(true, assert_by_position)
    assert_by_step_goal: Ast::Expr = Ast::Expr.BoolLit(true, assert_by_step_position)
    assert_by_goal_statement: Ast::Stmt = Ast::Stmt.Contract("assert", assert_by_goal, assert_by_keyword_position)
    assert_by_step_statement: Ast::Stmt = Ast::Stmt.Contract("assert", assert_by_step_goal, assert_by_step_position)
    assert_by_statement: Ast::Stmt = Ast::Stmt.Block("assert_by", [], "", [assert_by_goal_statement, assert_by_step_statement], assert_by_position)
    assert_by_branch_position: Ast::Pos = Ast::pos_at_line(SOURCE_ASSERT_BY_POSITION_LINE)
    assert_by_branch: Ast::Stmt = Ast::Stmt.If(Ast::Expr.BoolLit(true, assert_by_branch_position), [assert_by_statement], [], assert_by_branch_position)
    assert_by_body: darray[Ast::Stmt] = [assert_by_branch]
    assert_by_function: Ast::Decl = Ast::Decl.Func("source_assert_by", [], Ast::Expr.Absent, assert_by_body, [], [], assert_by_position)
    assert_by_declarations: darray[Ast::Decl] = [assert_by_function]
    assert_by_inventory: darray[(name: sview, attempt_line: u32, goal_line: u32, goal_offset: u32, expected_value: bool, supported: bool)] = proof_source_assert_by_inventory(assert_by_declarations)
    return SOURCE_ASSERT_BY_INVENTORY_DROPPED if assert_by_inventory.count != 2 or not assert_by_inventory[0].supported or not assert_by_inventory[1].supported
    return SOURCE_ASSERT_BY_INVENTORY_DROPPED if assert_by_inventory[0].name != "source_assert_by" or assert_by_inventory[0].attempt_line != assert_by_keyword_position.line or assert_by_inventory[0].goal_line != assert_by_position.line or assert_by_inventory[0].goal_offset != assert_by_position.offset or not assert_by_inventory[0].expected_value
    return SOURCE_ASSERT_BY_INVENTORY_DROPPED if assert_by_inventory[1].name != "source_assert_by" or assert_by_inventory[1].attempt_line != assert_by_step_position.line or assert_by_inventory[1].goal_line != assert_by_step_position.line or assert_by_inventory[1].goal_offset != assert_by_step_position.offset or not assert_by_inventory[1].expected_value

    assert_by_report: mutable ProofReport = ProofReport{current_source_postcondition_count: 0, current_source_postcondition_line: 0, current_source_postcondition_name: "", focused_function: "", declarations: 0, obligations: 0, proven: 0, failed: 0, findings: [], source_declarations: [], declaration_details: [], goal_attempts: [], obligation_inventory: [], certificates: [], theorems: ProofTheoremTable{summaries: []}}
    assert_by_report.goal_attempts.push(ProofGoalAttempt{goal: assert_by_goal, budget_exhausted: false, facts_start: 0, facts_count: 0, kernel_goal: 0, kernel_facts_start: 0, kernel_facts_count: 0, line: assert_by_keyword_position.line, name: "source_assert_by", rule: "goal", proven: true, has_certificate: true, certificate_index: 0})
    assert_by_report.certificates.push(ProofGoalCertificate{goal: assert_by_goal, facts_start: 0, facts_count: 0, kernel_goal: 0, kernel_facts_start: 0, kernel_facts_count: 0, line: assert_by_keyword_position.line, name: "source_assert_by", rule: "goal", replayed: true})
    assert_by_report.goal_attempts.push(ProofGoalAttempt{goal: assert_by_step_goal, budget_exhausted: false, facts_start: 0, facts_count: 0, kernel_goal: 1, kernel_facts_start: 0, kernel_facts_count: 0, line: assert_by_step_position.line, name: "source_assert_by", rule: "goal", proven: true, has_certificate: true, certificate_index: 1})
    assert_by_report.certificates.push(ProofGoalCertificate{goal: assert_by_step_goal, facts_start: 0, facts_count: 0, kernel_goal: 1, kernel_facts_start: 0, kernel_facts_count: 0, line: assert_by_step_position.line, name: "source_assert_by", rule: "goal", replayed: true})
    return SOURCE_ASSERT_BY_VALID_CONTROL_REJECTED if not proof_source_assert_by_coverage(assert_by_inventory, assert_by_report)

    # Removing the attempt and replay certificate together still leaves the immutable source
    # expectation, so source coverage rejects the coordinated omission.
    assert_by_report.goal_attempts.clear()
    assert_by_report.certificates.clear()
    return SOURCE_ASSERT_BY_OMISSION_ADMITTED if proof_source_assert_by_coverage(assert_by_inventory, assert_by_report)

    assert_by_report.goal_attempts.push(ProofGoalAttempt{goal: assert_by_goal, budget_exhausted: false, facts_start: 0, facts_count: 0, kernel_goal: 0, kernel_facts_start: 0, kernel_facts_count: 0, line: assert_by_keyword_position.line, name: "source_assert_by", rule: "goal", proven: true, has_certificate: true, certificate_index: 0})
    assert_by_report.certificates.push(ProofGoalCertificate{goal: assert_by_goal, facts_start: 0, facts_count: 0, kernel_goal: 0, kernel_facts_start: 0, kernel_facts_count: 0, line: assert_by_keyword_position.line, name: "source_assert_by", rule: "goal", replayed: true})
    assert_by_report.goal_attempts.push(ProofGoalAttempt{goal: assert_by_goal, budget_exhausted: false, facts_start: 0, facts_count: 0, kernel_goal: 2, kernel_facts_start: 0, kernel_facts_count: 0, line: assert_by_keyword_position.line, name: "source_assert_by", rule: "goal", proven: true, has_certificate: true, certificate_index: 1})
    assert_by_report.certificates.push(ProofGoalCertificate{goal: assert_by_goal, facts_start: 0, facts_count: 0, kernel_goal: 2, kernel_facts_start: 0, kernel_facts_count: 0, line: assert_by_keyword_position.line, name: "source_assert_by", rule: "goal", replayed: true})
    assert_by_report.goal_attempts.push(ProofGoalAttempt{goal: assert_by_step_goal, budget_exhausted: false, facts_start: 0, facts_count: 0, kernel_goal: 3, kernel_facts_start: 0, kernel_facts_count: 0, line: assert_by_step_position.line, name: "source_assert_by", rule: "goal", proven: true, has_certificate: true, certificate_index: 2})
    assert_by_report.certificates.push(ProofGoalCertificate{goal: assert_by_step_goal, facts_start: 0, facts_count: 0, kernel_goal: 3, kernel_facts_start: 0, kernel_facts_count: 0, line: assert_by_step_position.line, name: "source_assert_by", rule: "goal", replayed: true})
    return SOURCE_ASSERT_BY_DUPLICATE_ADMITTED if proof_source_assert_by_coverage(assert_by_inventory, assert_by_report)
    failed_assert_by_report: mutable ProofReport = ProofReport{current_source_postcondition_count: 0, current_source_postcondition_line: 0, current_source_postcondition_name: "", focused_function: "", declarations: 0, obligations: 0, proven: 0, failed: 0, findings: [], source_declarations: [], declaration_details: [], goal_attempts: [], obligation_inventory: [], certificates: [], theorems: ProofTheoremTable{summaries: []}}
    failed_assert_by_report.goal_attempts.push(ProofGoalAttempt{goal: assert_by_goal, budget_exhausted: false, facts_start: 0, facts_count: 0, kernel_goal: 0, kernel_facts_start: 0, kernel_facts_count: 0, line: assert_by_keyword_position.line, name: "source_assert_by", rule: "goal", proven: false, has_certificate: false, certificate_index: 0})
    return SOURCE_ASSERT_BY_FAILED_GOAL_ADMITTED if proof_source_assert_by_coverage(assert_by_inventory, failed_assert_by_report)
    return SOURCE_ASSERT_BY_FAILED_GOAL_ADMITTED if failed_assert_by_report.goal_attempts.count != 1 or failed_assert_by_report.goal_attempts[0].proven

    mismatched_assert_by_position: Ast::Pos = Ast::Pos{line: SOURCE_ASSERT_BY_POSITION_LINE, column: 2, offset: SOURCE_ASSERT_BY_GOAL_OFFSET + 1, end_line: SOURCE_ASSERT_BY_POSITION_LINE, end_column: 3, end_offset: SOURCE_ASSERT_BY_GOAL_OFFSET + 2}
    mismatched_assert_by_goal: Ast::Expr = Ast::Expr.BoolLit(true, mismatched_assert_by_position)
    mismatched_assert_by_report: mutable ProofReport = ProofReport{current_source_postcondition_count: 0, current_source_postcondition_line: 0, current_source_postcondition_name: "", focused_function: "", declarations: 0, obligations: 0, proven: 0, failed: 0, findings: [], source_declarations: [], declaration_details: [], goal_attempts: [], obligation_inventory: [], certificates: [], theorems: ProofTheoremTable{summaries: []}}
    mismatched_assert_by_report.goal_attempts.push(ProofGoalAttempt{goal: mismatched_assert_by_goal, budget_exhausted: false, facts_start: 0, facts_count: 0, kernel_goal: 0, kernel_facts_start: 0, kernel_facts_count: 0, line: assert_by_keyword_position.line, name: "source_assert_by", rule: "goal", proven: true, has_certificate: true, certificate_index: 0})
    mismatched_assert_by_report.certificates.push(ProofGoalCertificate{goal: mismatched_assert_by_goal, facts_start: 0, facts_count: 0, kernel_goal: 0, kernel_facts_start: 0, kernel_facts_count: 0, line: assert_by_keyword_position.line, name: "source_assert_by", rule: "goal", replayed: true})
    return SOURCE_ASSERT_BY_SOURCE_MISMATCH_ADMITTED if proof_source_assert_by_coverage(assert_by_inventory, mismatched_assert_by_report)

    duplicate_source_declarations: darray[Ast::Decl] = [assert_by_function, assert_by_function]
    duplicate_source_inventory: darray[(name: sview, attempt_line: u32, goal_line: u32, goal_offset: u32, expected_value: bool, supported: bool)] = proof_source_assert_by_inventory(duplicate_source_declarations)
    return SOURCE_ASSERT_BY_DUPLICATE_ADMITTED if proof_source_assert_by_coverage(duplicate_source_inventory, assert_by_report)

    false_assert_by_goal: Ast::Expr = Ast::Expr.BoolLit(false, assert_by_position)
    assert_by_report.goal_attempts.clear()
    assert_by_report.certificates.clear()
    assert_by_report.goal_attempts.push(ProofGoalAttempt{goal: false_assert_by_goal, budget_exhausted: false, facts_start: 0, facts_count: 0, kernel_goal: 0, kernel_facts_start: 0, kernel_facts_count: 0, line: assert_by_keyword_position.line, name: "source_assert_by", rule: "goal", proven: true, has_certificate: true, certificate_index: 0})
    assert_by_report.certificates.push(ProofGoalCertificate{goal: false_assert_by_goal, facts_start: 0, facts_count: 0, kernel_goal: 0, kernel_facts_start: 0, kernel_facts_count: 0, line: assert_by_keyword_position.line, name: "source_assert_by", rule: "goal", replayed: true})
    return SOURCE_ASSERT_BY_FALSE_CLAIM_ADMITTED if proof_source_assert_by_coverage(assert_by_inventory, assert_by_report)
    malformed_assert_by: Ast::Stmt = Ast::Stmt.Block("assert_by", [], "", [], assert_by_position)
    malformed_assert_by_body: darray[Ast::Stmt] = [malformed_assert_by]
    malformed_assert_by_function: Ast::Decl = Ast::Decl.Func("malformed_assert_by", [], Ast::Expr.Absent, malformed_assert_by_body, [], [], assert_by_position)
    malformed_assert_by_declarations: darray[Ast::Decl] = [malformed_assert_by_function]
    malformed_assert_by_inventory: darray[(name: sview, attempt_line: u32, goal_line: u32, goal_offset: u32, expected_value: bool, supported: bool)] = proof_source_assert_by_inventory(malformed_assert_by_declarations)
    return SOURCE_ASSERT_BY_MALFORMED_ADMITTED if malformed_assert_by_inventory.count != 1 or malformed_assert_by_inventory[0].supported
    return SOURCE_ASSERT_BY_MALFORMED_ADMITTED if proof_source_assert_by_coverage(malformed_assert_by_inventory, assert_by_report)
    nonliteral_assert_by_goal: Ast::Expr = Ast::Expr.Binary(Ast::Expr.IntLit(1, assert_by_position), TokenKind.EqEq, Ast::Expr.IntLit(1, assert_by_step_position), assert_by_position)
    nonliteral_assert_by_statement: Ast::Stmt = Ast::Stmt.Contract("assert", nonliteral_assert_by_goal, assert_by_position)
    nonliteral_assert_by_block: Ast::Stmt = Ast::Stmt.Block("assert_by", [], "", [nonliteral_assert_by_statement], assert_by_position)
    nonliteral_assert_by_function: Ast::Decl = Ast::Decl.Func("nonliteral_assert_by", [], Ast::Expr.Absent, [nonliteral_assert_by_block], [], [], assert_by_position)
    nonliteral_assert_by_declarations: darray[Ast::Decl] = [nonliteral_assert_by_function]
    nonliteral_assert_by_inventory: darray[(name: sview, attempt_line: u32, goal_line: u32, goal_offset: u32, expected_value: bool, supported: bool)] = proof_source_assert_by_inventory(nonliteral_assert_by_declarations)
    return SOURCE_ASSERT_BY_MALFORMED_ADMITTED if nonliteral_assert_by_inventory.count != 0
    assert_by_report.goal_attempts.clear()
    assert_by_report.certificates.clear()
    return SOURCE_ASSERT_BY_MALFORMED_ADMITTED if not proof_source_assert_by_coverage(nonliteral_assert_by_inventory, assert_by_report)
    nested_assert_by_function: Ast::Decl = Ast::Decl.Func("nested_assert_by", [], Ast::Expr.Absent, [assert_by_statement], [], [], assert_by_position)
    nested_assert_by_module: Ast::Decl = Ast::Decl.Module("Nested", [nested_assert_by_function], assert_by_position)
    nested_module_declarations: darray[Ast::Decl] = [nested_assert_by_module]
    nested_module_inventory: darray[(name: sview, attempt_line: u32, goal_line: u32, goal_offset: u32, expected_value: bool, supported: bool)] = proof_source_assert_by_inventory(nested_module_declarations)
    return SOURCE_ASSERT_BY_MALFORMED_ADMITTED if nested_module_inventory.count != 2 or nested_module_inventory[0].supported or nested_module_inventory[1].supported
    return SOURCE_ASSERT_BY_UNSUPPORTED_SCOPE_NOT_RETAINED if not proof_source_assert_by_inventory_has_unsupported(nested_module_inventory)
    return SOURCE_ASSERT_BY_MALFORMED_ADMITTED if proof_source_assert_by_coverage(nested_module_inventory, assert_by_report)

    nested_assert_by_scope: Ast::Decl = Ast::Decl.Scoped([nested_assert_by_function], assert_by_position)
    nested_scope_declarations: darray[Ast::Decl] = [nested_assert_by_scope]
    nested_scope_inventory: darray[(name: sview, attempt_line: u32, goal_line: u32, goal_offset: u32, expected_value: bool, supported: bool)] = proof_source_assert_by_inventory(nested_scope_declarations)
    return SOURCE_ASSERT_BY_MALFORMED_ADMITTED if nested_scope_inventory.count != 2 or nested_scope_inventory[0].supported or nested_scope_inventory[1].supported
    return SOURCE_ASSERT_BY_UNSUPPORTED_SCOPE_NOT_RETAINED if not proof_source_assert_by_inventory_has_unsupported(nested_scope_inventory)
    return SOURCE_ASSERT_BY_MALFORMED_ADMITTED if proof_source_assert_by_coverage(nested_scope_inventory, assert_by_report)

    nested_block_expression: Ast::Expr = Ast::Expr.Block([assert_by_statement], Ast::Expr.BoolLit(true, assert_by_step_position), [], assert_by_position)
    nested_block_statement: Ast::Stmt = Ast::Stmt.VarDecl("nested_value", Ast::Expr.Ident("bool", assert_by_position), nested_block_expression, assert_by_position)
    nested_block_function: Ast::Decl = Ast::Decl.Func("nested_block_assert_by", [], Ast::Expr.Absent, [nested_block_statement], [], [], assert_by_position)
    nested_block_declarations: darray[Ast::Decl] = [nested_block_function]
    nested_block_inventory: darray[(name: sview, attempt_line: u32, goal_line: u32, goal_offset: u32, expected_value: bool, supported: bool)] = proof_source_assert_by_inventory(nested_block_declarations)
    return SOURCE_ASSERT_BY_MALFORMED_ADMITTED if nested_block_inventory.count != 2 or nested_block_inventory[0].supported or nested_block_inventory[1].supported
    return SOURCE_ASSERT_BY_MALFORMED_ADMITTED if proof_source_assert_by_coverage(nested_block_inventory, assert_by_report)
    # A report cannot hide a declaration that was present in the source but never represented
    # in the admission inventory, even when no goal happened to be generated for it.
    report.declarations <- SINGLE_REPORTED_ITEM
    return DECLARATION_WITHOUT_SUMMARY_ACCEPTED if not proof_report_source_has_unresolved_checks(report, false, 0)
    return DECLARATION_INVENTORY_ADMITTED_FOR_FOCUSED_GOAL if proof_report_source_admission_invariants_consistent(report)
    report.declarations <- 0

    # Establish one real source/summary correspondence, then delete, duplicate and forge its
    # summary while keeping declaration totals aligned. Inventory admission must check identity,
    # not just equal lengths.
    report.declarations <- SINGLE_REPORTED_ITEM
    report.source_declarations.push(Ast::Decl.Invalid)
    valid_invalid_summary: ProofDeclarationSummary = ProofDeclarationSummary{kind: "invalid", name: "", line: 0, verification_reason: "not-checked"}
    report.declaration_details.push(valid_invalid_summary)
    return 11 if not proof_report_source_admission_invariants_consistent(report)
    report.declaration_details.pop()
    return 12 if proof_report_source_admission_invariants_consistent(report)
    report.declaration_details.push(valid_invalid_summary)
    report.declaration_details.push(valid_invalid_summary)
    report.declarations <- report.declarations + 1
    return 13 if proof_report_source_admission_invariants_consistent(report)
    report.declaration_details.clear()
    report.declarations <- SINGLE_REPORTED_ITEM
    report.declaration_details.push(ProofDeclarationSummary{kind: "alias", name: "forged", line: 9, verification_reason: "not-checked"})
    return 14 if proof_report_source_admission_invariants_consistent(report)
    report.source_declarations.clear()
    report.declaration_details.clear()
    report.declarations <- 0

    report.failed <- SINGLE_REPORTED_ITEM
    return FAILURE_WITHOUT_FINDING_ACCEPTED if not proof_report_source_has_unresolved_checks(report, false, 0)

    report.failed <- 0
    report.findings.push(ProofFinding{kind: "proof-unknown"})
    return FINDING_WITHOUT_FAILURE_ACCEPTED if not proof_report_source_has_unresolved_checks(report, false, 0)

    finding: ProofFinding = report.findings[0]
    report.failed <- report.failed + 1
    report.findings.push(finding)
    return 18 if not proof_report_source_has_unresolved_checks(report, false, 0)
    report.findings.pop()
    report.failed <- report.failed - 1
    return 19 if not proof_report_source_has_unresolved_checks(report, false, 0)
    report.findings[0] <- ProofFinding{kind: "forged-finding"}
    return 20 if not proof_report_source_has_unresolved_checks(report, false, 0)

    report.findings.clear()
    # A successful counter without a recorded attempt has no checked root. Mutating the attempt
    # inventory after success must also revoke the report's structural admission.
    report.obligations <- SINGLE_REPORTED_ITEM
    report.proven <- SINGLE_REPORTED_ITEM
    report.obligation_inventory.push(ProofObligationEntry{identity: 0, proven: true, source_line: 0, source_name: "", source_kind: "", source_obligation_index: 0})
    report.declarations <- SINGLE_REPORTED_ITEM
    report.source_declarations.push(Ast::Decl.Invalid)
    report.declaration_details.push(ProofDeclarationSummary{kind: "invalid", name: "", line: 0, verification_reason: "not-checked"})
    return PROVEN_WITHOUT_ATTEMPT_ADMITTED if proof_report_source_admission_invariants_consistent(report)
    goal: Ast::Expr = Ast::Expr.BoolLit(true, Ast::pos_at_line(0))
    report.goal_attempts.push(ProofGoalAttempt{goal: goal, budget_exhausted: false, facts_start: 0, facts_count: 0, kernel_goal: 0, kernel_facts_start: 0, kernel_facts_count: 0, line: 0, name: "", rule: "goal", proven: true, has_certificate: true, certificate_index: 0})
    report.certificates.push(ProofGoalCertificate{goal: goal, facts_start: 0, facts_count: 0, kernel_goal: 0, kernel_facts_start: 0, kernel_facts_count: 0, line: 0, name: "", rule: "goal", replayed: true})
    return PROVEN_ATTEMPT_COUNT_REJECTED if not proof_report_source_admission_invariants_consistent(report)
    original_certificate: ProofGoalCertificate = report.certificates[0]
    report.certificates[0] <- ProofGoalCertificate{goal: original_certificate.goal, facts_start: original_certificate.facts_start, facts_count: original_certificate.facts_count, kernel_goal: 1, kernel_facts_start: original_certificate.kernel_facts_start, kernel_facts_count: original_certificate.kernel_facts_count, line: original_certificate.line, name: original_certificate.name, rule: original_certificate.rule, replayed: original_certificate.replayed}
    return 15 if proof_report_source_admission_invariants_consistent(report)
    report.certificates[0] <- original_certificate
    attempt: ProofGoalAttempt = report.goal_attempts[0]
    report.goal_attempts[0] <- ProofGoalAttempt{goal: attempt.goal, budget_exhausted: attempt.budget_exhausted, facts_start: attempt.facts_start, facts_count: attempt.facts_count, kernel_goal: attempt.kernel_goal, kernel_facts_start: attempt.kernel_facts_start, kernel_facts_count: attempt.kernel_facts_count, line: attempt.line, name: "forged", rule: attempt.rule, proven: attempt.proven, has_certificate: attempt.has_certificate, certificate_index: attempt.certificate_index}
    return 16 if proof_report_source_admission_invariants_consistent(report)
    report.goal_attempts[0] <- attempt
    report.obligation_inventory.clear()
    return OBLIGATION_LEDGER_DELETION_ADMITTED if proof_report_source_admission_invariants_consistent(report)
    report.obligation_inventory.push(ProofObligationEntry{identity: 0, proven: true, source_line: 0, source_name: "", source_kind: "", source_obligation_index: 0})
    report.obligation_inventory[0] <- ProofObligationEntry{identity: 0, proven: false, source_line: 0, source_name: "", source_kind: "", source_obligation_index: 0}
    return OBLIGATION_RESULT_FORGERY_ADMITTED if proof_report_source_admission_invariants_consistent(report)
    report.obligation_inventory[0] <- ProofObligationEntry{identity: 0, proven: true, source_line: 0, source_name: "", source_kind: "", source_obligation_index: 0}

    # A second, still-open source obligation keeps aggregate counts and attempt rows plausible.
    # Replacing its false result with a duplicate proven result must fail the ledger sum check.
    report.obligations <- report.obligations + 1
    report.obligation_inventory.push(ProofObligationEntry{identity: 1, proven: false, source_line: 0, source_name: "", source_kind: "", source_obligation_index: 0})
    report.goal_attempts.push(ProofGoalAttempt{goal: goal, budget_exhausted: false, facts_start: 0, facts_count: 0, kernel_goal: 0, kernel_facts_start: 0, kernel_facts_count: 0, line: 1, name: "open", rule: "goal", proven: false, has_certificate: false, certificate_index: 0})
    return 26 if not proof_report_source_admission_invariants_consistent(report)
    first_obligation: ProofObligationEntry = report.obligation_inventory[0]
    second_obligation: ProofObligationEntry = report.obligation_inventory[1]
    # This is the pre-ledger source-admission predicate from the repository history. Keep the
    # source attempts and aggregate counters valid while independently mutating only event rows,
    # so these controls show the precise gap the ledger invariant closes.
    return TWO_EVENT_PRE_LEDGER_REJECTED if not proof_report_failure_count_consistent(report) or not proof_report_declaration_inventory_consistent(report) or report.goal_attempts.count != report.obligations.usize() or not proof_report_proven_attempts_consistent(report)
    report.obligation_inventory.pop()
    return OMITTED_EVENT_PRE_LEDGER_REJECTED if not proof_report_failure_count_consistent(report) or not proof_report_declaration_inventory_consistent(report) or report.goal_attempts.count != report.obligations.usize() or not proof_report_proven_attempts_consistent(report)
    return OMITTED_EVENT_ADMITTED if proof_report_source_admission_invariants_consistent(report)
    report.obligation_inventory.push(second_obligation)
    # Copy the first event verbatim into the second slot: same ordinal and same outcome.
    report.obligation_inventory[1] <- first_obligation
    return DUPLICATED_EVENT_PRE_LEDGER_REJECTED if not proof_report_failure_count_consistent(report) or not proof_report_declaration_inventory_consistent(report) or report.goal_attempts.count != report.obligations.usize() or not proof_report_proven_attempts_consistent(report)
    return DUPLICATED_EVENT_ADMITTED if proof_report_source_admission_invariants_consistent(report)
    report.obligation_inventory[1] <- second_obligation
    report.obligation_inventory[0] <- second_obligation
    report.obligation_inventory[1] <- first_obligation
    return REORDERED_OBLIGATION_LEDGER_ADMITTED if proof_report_source_admission_invariants_consistent(report)
    report.obligation_inventory[0] <- first_obligation
    report.obligation_inventory[1] <- second_obligation
    report.obligation_inventory[1] <- ProofObligationEntry{identity: 7, proven: false, source_line: 0, source_name: "", source_kind: "", source_obligation_index: 0}
    return FORGED_OBLIGATION_IDENTITY_ADMITTED if proof_report_source_admission_invariants_consistent(report)
    report.obligation_inventory[1] <- second_obligation
    report.obligation_inventory[1] <- ProofObligationEntry{identity: 1, proven: true, source_line: 0, source_name: "", source_kind: "", source_obligation_index: 0}
    return DUPLICATED_PROVEN_OBLIGATION_ADMITTED if proof_report_source_admission_invariants_consistent(report)
    report.obligation_inventory[1] <- ProofObligationEntry{identity: 1, proven: false, source_line: 0, source_name: "", source_kind: "", source_obligation_index: 0}
    report.goal_attempts.pop()
    report.obligations <- report.obligations - 1

    # Deleting a successful attempt, its certificate and both aggregate totals together used
    # to leave a self-consistent empty report. The independent obligation-result row must stop it.
    report.goal_attempts.clear()
    report.certificates.clear()
    report.obligations <- 0
    report.proven <- 0
    return COORDINATED_ATTEMPT_AND_TOTAL_DELETION_ADMITTED if proof_report_source_admission_invariants_consistent(report)
    report.goal_attempts.push(attempt)
    report.certificates.push(original_certificate)
    report.obligations <- SINGLE_REPORTED_ITEM
    report.proven <- SINGLE_REPORTED_ITEM

    report.goal_attempts.push(attempt)
    report.obligations <- report.obligations + 1
    report.proven <- report.proven + 1
    return 17 if proof_report_source_admission_invariants_consistent(report)
    report.goal_attempts.pop()
    report.obligations <- report.obligations - 1
    report.proven <- report.proven - 1
    report.goal_attempts.clear()
    return REMOVED_PROVEN_ATTEMPT_ADMITTED if proof_report_source_admission_invariants_consistent(report)

    report.proven <- 0
    report.obligations <- SINGLE_REPORTED_ITEM
    report.obligation_inventory.clear()
    report.obligation_inventory.push(ProofObligationEntry{identity: 0, proven: false, source_line: 0, source_name: "", source_kind: "", source_obligation_index: 0})
    report.goal_attempts.push(ProofGoalAttempt{goal: Ast::Expr.BoolLit(true, Ast::pos_at_line(0)), budget_exhausted: false, facts_start: 0, facts_count: 0, kernel_goal: 0, kernel_facts_start: 0, kernel_facts_count: 0, line: 0, name: "", rule: "goal", proven: false, has_certificate: false, certificate_index: 0})
    return OPEN_GOAL_MARKED_COMPLETE if not proof_report_source_has_unresolved_checks(report, false, 0)

    # A source obligation can be rejected before goal extraction (for example on an unsupported
    # computed write place). Its result remains in the event ledger without inventing a goal row.
    report.goal_attempts.clear()
    report.certificates.clear()
    return NON_GOAL_OPEN_OBLIGATION_REJECTED if not proof_report_source_admission_invariants_consistent(report)
    return NON_GOAL_OPEN_OBLIGATION_REJECTED if not proof_report_source_has_unresolved_checks(report, false, 0)

    # Removing an open ledger event and its aggregate total must not leave its goal attempt
    # detached. This mutation used to satisfy the event-ledger count and proven-result checks.
    report.obligations <- 0
    report.obligation_inventory.clear()
    report.obligation_inventory.push(ProofObligationEntry{identity: 0, proven: false, source_line: 0, source_name: "", source_kind: "", source_obligation_index: 0})
    report.obligation_inventory.push(ProofObligationEntry{identity: 1, proven: false, source_line: 0, source_name: "", source_kind: "", source_obligation_index: 0})
    report.obligations <- 2
    report.goal_attempts.push(ProofGoalAttempt{goal: goal, budget_exhausted: false, facts_start: 0, facts_count: 0, kernel_goal: 0, kernel_facts_start: 0, kernel_facts_count: 0, line: 1, name: "open", rule: "goal", proven: false, has_certificate: false, certificate_index: 0})
    report.goal_attempts.push(ProofGoalAttempt{goal: goal, budget_exhausted: false, facts_start: 0, facts_count: 0, kernel_goal: 0, kernel_facts_start: 0, kernel_facts_count: 0, line: 2, name: "open", rule: "goal", proven: false, has_certificate: false, certificate_index: 0})
    report.obligation_inventory.pop()
    report.obligations <- report.obligations - 1
    # Since baa2b792 path-specific attempts may outnumber source obligations, so an open
    # attempt left beside a removed open obligation is no longer visible to the counts. A
    # removed obligation whose proven result is still counted remains detectable.
    report.proven <- 2
    return OMITTED_OPEN_OBLIGATION_WITH_ATTEMPT_ADMITTED if proof_report_source_admission_invariants_consistent(report)

    # Candidate-control setup: two source functions each have one required postcondition event.
    report.findings.clear()
    report.declarations <- 2
    report.obligations <- 2
    report.proven <- 2
    report.failed <- 0
    report.source_declarations.clear()
    report.declaration_details.clear()
    report.goal_attempts.clear()
    report.certificates.clear()
    report.obligation_inventory.clear()
    source_position: Ast::Pos = Ast::pos_at_line(10)
    source_contract: Ast::Stmt = Ast::Stmt.Contract("ensure", Ast::Expr.BoolLit(true, source_position), source_position)
    source_return: Ast::Stmt = Ast::Stmt.Return(Ast::Expr.IntLit(1, source_position), source_position)
    source_body: darray[Ast::Stmt] = [source_contract, source_return]
    first_source_function: Ast::Decl = Ast::Decl.Func("source_first", [], Ast::Expr.Absent, source_body, [], [], source_position)
    second_position: Ast::Pos = Ast::pos_at_line(20)
    second_contract_goal: Ast::Expr = Ast::Expr.Binary(Ast::Expr.Ident("result", second_position), TokenKind.EqEq, Ast::Expr.IntLit(2, second_position), second_position)
    second_contract: Ast::Stmt = Ast::Stmt.Contract("ensures", second_contract_goal, second_position)
    second_return: Ast::Stmt = Ast::Stmt.Return(Ast::Expr.IntLit(2, second_position), second_position)
    second_source_body: darray[Ast::Stmt] = [second_contract, second_return]
    second_source_function: Ast::Decl = Ast::Decl.Func("source_second", [], Ast::Expr.Absent, second_source_body, [], [], second_position)
    source_declarations: darray[Ast::Decl] = [first_source_function, second_source_function]
    immutable_source_inventory: darray[(name: sview, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool)] = proof_source_literal_ensure_inventory(source_declarations)
    report.source_declarations.push(first_source_function)
    report.source_declarations.push(second_source_function)
    report.declaration_details.push(ProofDeclarationSummary{kind: "function", name: "source_first", line: 10, verification_reason: "verified"})
    report.declaration_details.push(ProofDeclarationSummary{kind: "function", name: "source_second", line: 20, verification_reason: "verified"})
    report.obligation_inventory.push(ProofObligationEntry{identity: 0, proven: true, source_line: 10, source_name: "source_first", source_kind: "postcondition", source_obligation_index: 0})
    report.obligation_inventory.push(ProofObligationEntry{identity: 1, proven: true, source_line: 20, source_name: "source_second", source_kind: "postcondition", source_obligation_index: 0})
    first_source_goal: Ast::Expr = Ast::Expr.BoolLit(true, source_position)
    second_source_goal: Ast::Expr = Ast::Expr.Binary(Ast::Expr.IntLit(2, second_position), TokenKind.EqEq, Ast::Expr.IntLit(2, second_position), second_position)
    report.goal_attempts.push(ProofGoalAttempt{goal: first_source_goal, budget_exhausted: false, facts_start: 0, facts_count: 0, kernel_goal: 0, kernel_facts_start: 0, kernel_facts_count: 0, line: 10, name: "source_first", rule: "goal", proven: true, has_certificate: true, certificate_index: 0})
    report.goal_attempts.push(ProofGoalAttempt{goal: second_source_goal, budget_exhausted: false, facts_start: 0, facts_count: 0, kernel_goal: 1, kernel_facts_start: 0, kernel_facts_count: 0, line: 20, name: "source_second", rule: "goal", proven: true, has_certificate: true, certificate_index: 1})
    report.certificates.push(ProofGoalCertificate{goal: first_source_goal, facts_start: 0, facts_count: 0, kernel_goal: 0, kernel_facts_start: 0, kernel_facts_count: 0, line: 10, name: "source_first", rule: "goal", replayed: true})
    report.certificates.push(ProofGoalCertificate{goal: second_source_goal, facts_start: 0, facts_count: 0, kernel_goal: 1, kernel_facts_start: 0, kernel_facts_count: 0, line: 20, name: "source_second", rule: "goal", replayed: true})
    return SOURCE_REQUIRED_EXECUTABLE_OBLIGATION_CONTROL_REJECTED if not proof_report_source_admission_invariants_consistent(report)
    return SOURCE_REQUIRED_EXECUTABLE_OBLIGATION_CONTROL_REJECTED if not proof_report_source_postcondition_inventory_consistent(report)
    report.obligation_inventory[1] <- ProofObligationEntry{identity: 1, proven: true, source_line: 20, source_name: "source_second", source_kind: "postcondition", source_obligation_index: 99}
    return 54 if proof_report_source_postcondition_inventory_consistent(report)
    report.obligation_inventory[1] <- ProofObligationEntry{identity: 1, proven: true, source_line: 21, source_name: "source_second", source_kind: "postcondition", source_obligation_index: 0}
    return 55 if proof_report_source_postcondition_inventory_consistent(report)
    report.obligation_inventory[1] <- ProofObligationEntry{identity: 1, proven: true, source_line: 20, source_name: "source_second", source_kind: "postcondition", source_obligation_index: 0}
    return SOURCE_REQUIRED_EXECUTABLE_OBLIGATION_CONTROL_REJECTED if not proof_source_literal_ensure_coverage(immutable_source_inventory, report)

    matched_certificate: ProofGoalCertificate = report.certificates[1]
    second_attempt: ProofGoalAttempt = report.goal_attempts[1]

    # A second internally consistent certificate cannot discharge the same unique source
    # obligation twice. Counts and the event ledger are updated so this is specifically the
    # source-inventory multiplicity check, not an unrelated aggregate inconsistency.
    report.goal_attempts.push(ProofGoalAttempt{goal: second_attempt.goal, budget_exhausted: second_attempt.budget_exhausted, facts_start: second_attempt.facts_start, facts_count: second_attempt.facts_count, kernel_goal: second_attempt.kernel_goal, kernel_facts_start: second_attempt.kernel_facts_start, kernel_facts_count: second_attempt.kernel_facts_count, line: second_attempt.line, name: second_attempt.name, rule: second_attempt.rule, proven: second_attempt.proven, has_certificate: true, certificate_index: 2})
    report.certificates.push(ProofGoalCertificate{goal: matched_certificate.goal, facts_start: matched_certificate.facts_start, facts_count: matched_certificate.facts_count, kernel_goal: matched_certificate.kernel_goal, kernel_facts_start: matched_certificate.kernel_facts_start, kernel_facts_count: matched_certificate.kernel_facts_count, line: matched_certificate.line, name: matched_certificate.name, rule: matched_certificate.rule, replayed: true})
    report.obligation_inventory.push(ProofObligationEntry{identity: 2, proven: true, source_line: 0, source_name: "", source_kind: "", source_obligation_index: 0})
    report.obligations <- report.obligations + 1
    report.proven <- report.proven + 1
    return SOURCE_REQUIRED_EXECUTABLE_OBLIGATION_DUPLICATE_ADMITTED if proof_source_literal_ensure_coverage(immutable_source_inventory, report)
    report.goal_attempts.pop()
    report.certificates.pop()
    report.obligation_inventory.pop()
    report.obligations <- report.obligations - 1
    report.proven <- report.proven - 1

    # A replay flag alone is not a source claim. Its certificate AST must itself represent the
    # source postcondition, not a false neighboring proposition hidden behind a valid attempt row.
    false_certificate_goal: Ast::Expr = Ast::Expr.Binary(Ast::Expr.IntLit(2, second_position), TokenKind.EqEq, Ast::Expr.IntLit(3, second_position), second_position)
    report.certificates[1] <- ProofGoalCertificate{goal: false_certificate_goal, facts_start: matched_certificate.facts_start, facts_count: matched_certificate.facts_count, kernel_goal: matched_certificate.kernel_goal, kernel_facts_start: matched_certificate.kernel_facts_start, kernel_facts_count: matched_certificate.kernel_facts_count, line: matched_certificate.line, name: matched_certificate.name, rule: matched_certificate.rule, replayed: true}
    return SOURCE_REQUIRED_EXECUTABLE_OBLIGATION_FALSE_CERTIFICATE_CLAIM_ADMITTED if proof_source_literal_ensure_coverage(immutable_source_inventory, report)
    report.certificates[1] <- matched_certificate

    report.certificates[1] <- ProofGoalCertificate{goal: matched_certificate.goal, facts_start: matched_certificate.facts_start, facts_count: matched_certificate.facts_count, kernel_goal: matched_certificate.kernel_goal, kernel_facts_start: matched_certificate.kernel_facts_start, kernel_facts_count: matched_certificate.kernel_facts_count, line: matched_certificate.line, name: matched_certificate.name, rule: matched_certificate.rule, replayed: false}
    return SOURCE_REQUIRED_EXECUTABLE_OBLIGATION_OMISSION_ADMITTED if proof_source_literal_ensure_coverage(immutable_source_inventory, report)
    report.certificates[1] <- matched_certificate

    # The source contract location and proposition are both required; a goal whose literal
    # source node comes from another line, or a replayed goal for another literal, cannot fill it.
    wrong_contract_location: Ast::Expr = Ast::Expr.Binary(Ast::Expr.IntLit(2, Ast::pos_at_line(21)), TokenKind.EqEq, Ast::Expr.IntLit(2, Ast::pos_at_line(21)), second_position)
    report.goal_attempts[1] <- ProofGoalAttempt{goal: wrong_contract_location, budget_exhausted: second_attempt.budget_exhausted, facts_start: second_attempt.facts_start, facts_count: second_attempt.facts_count, kernel_goal: second_attempt.kernel_goal, kernel_facts_start: second_attempt.kernel_facts_start, kernel_facts_count: second_attempt.kernel_facts_count, line: second_attempt.line, name: second_attempt.name, rule: second_attempt.rule, proven: second_attempt.proven, has_certificate: second_attempt.has_certificate, certificate_index: second_attempt.certificate_index}
    return SOURCE_REQUIRED_EXECUTABLE_OBLIGATION_OMISSION_ADMITTED if proof_source_literal_ensure_coverage(immutable_source_inventory, report)
    report.goal_attempts[1] <- second_attempt
    wrong_literal_goal: Ast::Expr = Ast::Expr.Binary(Ast::Expr.Ident("result", second_position), TokenKind.EqEq, Ast::Expr.IntLit(3, second_position), second_position)
    report.goal_attempts[1] <- ProofGoalAttempt{goal: wrong_literal_goal, budget_exhausted: second_attempt.budget_exhausted, facts_start: second_attempt.facts_start, facts_count: second_attempt.facts_count, kernel_goal: second_attempt.kernel_goal, kernel_facts_start: second_attempt.kernel_facts_start, kernel_facts_count: second_attempt.kernel_facts_count, line: second_attempt.line, name: second_attempt.name, rule: second_attempt.rule, proven: second_attempt.proven, has_certificate: second_attempt.has_certificate, certificate_index: second_attempt.certificate_index}
    return SOURCE_REQUIRED_EXECUTABLE_OBLIGATION_OMISSION_ADMITTED if proof_source_literal_ensure_coverage(immutable_source_inventory, report)
    report.goal_attempts[1] <- second_attempt

    # Bypass 1: mutate only report-owned scheduling metadata, then omit the second function's
    # attempt, certificate, ledger event, and counts. The proposed gate now derives a minimum
    # of one instead of two, despite both source declarations and contracts remaining present.
    report.declaration_details[1] <- ProofDeclarationSummary{kind: "function", name: "source_second", line: 20, verification_reason: "not-checked"}
    report.goal_attempts.pop()
    report.certificates.pop()
    report.obligation_inventory.pop()
    report.obligations <- report.obligations - 1
    report.proven <- report.proven - 1
    return SOURCE_REQUIRED_EXECUTABLE_OBLIGATION_OMISSION_ADMITTED if report.source_declarations.count != 2 or report.declaration_details.count != 2
    return SOURCE_REQUIRED_EXECUTABLE_OBLIGATION_OMISSION_ADMITTED if not source_function_with_postcondition_is(report, 0, "source_first") or not source_function_with_postcondition_is(report, 1, "source_second")
    return SOURCE_REQUIRED_EXECUTABLE_OBLIGATION_OMISSION_ADMITTED if not candidate_aggregate_source_gate(report)
    return SOURCE_REQUIRED_EXECUTABLE_OBLIGATION_OMISSION_ADMITTED if proof_source_literal_ensure_coverage(immutable_source_inventory, report)
    return SOURCE_REQUIRED_EXECUTABLE_OBLIGATION_OMISSION_ADMITTED if proof_report_source_admission_invariants_consistent(report)
    return SOURCE_REQUIRED_EXECUTABLE_OBLIGATION_OMISSION_ADMITTED if not proof_report_obligation_inventory_consistent(report) or not proof_report_proven_attempts_consistent(report)

    # Bypass 2: leave every source status untouched, but let an unrelated function's valid
    # event compensate for the omitted source_second event in the aggregate lower bound.
    report.declarations <- 3
    report.obligations <- 3
    report.proven <- 3
    report.source_declarations.clear()
    report.declaration_details.clear()
    report.goal_attempts.clear()
    report.certificates.clear()
    report.obligation_inventory.clear()
    unrelated_position: Ast::Pos = Ast::pos_at_line(15)
    unrelated_return: Ast::Stmt = Ast::Stmt.Return(Ast::Expr.IntLit(3, unrelated_position), unrelated_position)
    unrelated_body: darray[Ast::Stmt] = [unrelated_return]
    unrelated_function: Ast::Decl = Ast::Decl.Func("unrelated", [], Ast::Expr.Absent, unrelated_body, [], [], unrelated_position)
    report.source_declarations.push(first_source_function)
    report.source_declarations.push(unrelated_function)
    report.source_declarations.push(second_source_function)
    report.declaration_details.push(ProofDeclarationSummary{kind: "function", name: "source_first", line: 10, verification_reason: "verified"})
    report.declaration_details.push(ProofDeclarationSummary{kind: "function", name: "unrelated", line: 15, verification_reason: "verified"})
    report.declaration_details.push(ProofDeclarationSummary{kind: "function", name: "source_second", line: 20, verification_reason: "verified"})
    report.obligation_inventory.push(ProofObligationEntry{identity: 0, proven: true, source_line: 10, source_name: "source_first", source_kind: "postcondition", source_obligation_index: 0})
    report.obligation_inventory.push(ProofObligationEntry{identity: 1, proven: true, source_line: 0, source_name: "", source_kind: "", source_obligation_index: 0})
    report.obligation_inventory.push(ProofObligationEntry{identity: 2, proven: true, source_line: 20, source_name: "source_second", source_kind: "postcondition", source_obligation_index: 0})
    unrelated_goal: Ast::Expr = Ast::Expr.BoolLit(true, unrelated_position)
    report.goal_attempts.push(ProofGoalAttempt{goal: first_source_goal, budget_exhausted: false, facts_start: 0, facts_count: 0, kernel_goal: 0, kernel_facts_start: 0, kernel_facts_count: 0, line: 10, name: "source_first", rule: "goal", proven: true, has_certificate: true, certificate_index: 0})
    report.goal_attempts.push(ProofGoalAttempt{goal: unrelated_goal, budget_exhausted: false, facts_start: 0, facts_count: 0, kernel_goal: 1, kernel_facts_start: 0, kernel_facts_count: 0, line: 15, name: "unrelated", rule: "goal", proven: true, has_certificate: true, certificate_index: 1})
    report.goal_attempts.push(ProofGoalAttempt{goal: second_source_goal, budget_exhausted: false, facts_start: 0, facts_count: 0, kernel_goal: 2, kernel_facts_start: 0, kernel_facts_count: 0, line: 20, name: "source_second", rule: "goal", proven: true, has_certificate: true, certificate_index: 2})
    report.certificates.push(ProofGoalCertificate{goal: first_source_goal, facts_start: 0, facts_count: 0, kernel_goal: 0, kernel_facts_start: 0, kernel_facts_count: 0, line: 10, name: "source_first", rule: "goal", replayed: true})
    report.certificates.push(ProofGoalCertificate{goal: unrelated_goal, facts_start: 0, facts_count: 0, kernel_goal: 1, kernel_facts_start: 0, kernel_facts_count: 0, line: 15, name: "unrelated", rule: "goal", replayed: true})
    report.certificates.push(ProofGoalCertificate{goal: second_source_goal, facts_start: 0, facts_count: 0, kernel_goal: 2, kernel_facts_start: 0, kernel_facts_count: 0, line: 20, name: "source_second", rule: "goal", replayed: true})
    return SOURCE_REQUIRED_EXECUTABLE_OBLIGATION_CONTROL_REJECTED if not proof_report_source_admission_invariants_consistent(report)
    return SOURCE_REQUIRED_EXECUTABLE_OBLIGATION_CONTROL_REJECTED if not proof_source_literal_ensure_coverage(immutable_source_inventory, report)
    report.goal_attempts.pop()
    report.certificates.pop()
    report.obligation_inventory.pop()
    report.obligations <- report.obligations - 1
    report.proven <- report.proven - 1
    return SOURCE_REQUIRED_EXECUTABLE_OBLIGATION_OMISSION_ADMITTED if report.source_declarations.count != 3 or report.declaration_details.count != 3
    return SOURCE_REQUIRED_EXECUTABLE_OBLIGATION_OMISSION_ADMITTED if not source_function_with_postcondition_is(report, 0, "source_first") or not source_function_with_postcondition_is(report, 2, "source_second")
    return SOURCE_REQUIRED_EXECUTABLE_OBLIGATION_OMISSION_ADMITTED if not candidate_aggregate_source_gate(report)
    return SOURCE_REQUIRED_EXECUTABLE_OBLIGATION_OMISSION_ADMITTED if proof_source_literal_ensure_coverage(immutable_source_inventory, report)
    return SOURCE_REQUIRED_EXECUTABLE_OBLIGATION_OMISSION_ADMITTED if proof_report_source_admission_invariants_consistent(report)
    return SOURCE_REQUIRED_EXECUTABLE_OBLIGATION_OMISSION_ADMITTED if not proof_report_obligation_inventory_consistent(report) or not proof_report_proven_attempts_consistent(report)

    # Two separate source indices in one function must both occur. An extra return-path event
    # for index 0 is valid, but cannot cover index 1.
    indexed_position: Ast::Pos = Ast::pos_at_line(70)
    indexed_first: Ast::Stmt = Ast::Stmt.Contract("ensure", Ast::Expr.BoolLit(true, indexed_position), indexed_position)
    indexed_second_position: Ast::Pos = Ast::pos_at_line(71)
    indexed_second: Ast::Stmt = Ast::Stmt.Contract("ensures", Ast::Expr.BoolLit(true, indexed_second_position), indexed_second_position)
    indexed_return: Ast::Stmt = Ast::Stmt.Return(Ast::Expr.IntLit(1, indexed_position), indexed_position)
    indexed_body: darray[Ast::Stmt] = [indexed_first, indexed_second, indexed_return]
    indexed_function: Ast::Decl = Ast::Decl.Func("indexed_source", [], Ast::Expr.Absent, indexed_body, [], [], indexed_position)
    report.source_declarations.clear()
    report.source_declarations.push(indexed_function)
    report.obligation_inventory.clear()
    report.obligation_inventory.push(ProofObligationEntry{identity: 0, proven: true, source_line: 70, source_name: "indexed_source", source_kind: "postcondition", source_obligation_index: 0})
    report.obligation_inventory.push(ProofObligationEntry{identity: 1, proven: true, source_line: 70, source_name: "indexed_source", source_kind: "postcondition", source_obligation_index: 1})
    report.obligation_inventory.push(ProofObligationEntry{identity: 2, proven: true, source_line: 70, source_name: "indexed_source", source_kind: "postcondition", source_obligation_index: 0})
    return 56 if not proof_report_source_postcondition_inventory_consistent(report)
    report.obligation_inventory[1] <- ProofObligationEntry{identity: 1, proven: true, source_line: 70, source_name: "indexed_source", source_kind: "postcondition", source_obligation_index: 0}
    return 57 if proof_report_source_postcondition_inventory_consistent(report)
    return 0
