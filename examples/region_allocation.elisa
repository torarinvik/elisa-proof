# `new[r] value` allocates into the arena denoted by `@r`. Both a bound reference and a
# discarded allocation are real runtime transitions; the proof kernel tracks the region label
# and replays the allocation without turning the discarded result into a fake binding.
def region_allocation() -> i64 can[Memory.Allocate, Abort.Panic]:
    region r(4096):
        value: i64& = new[r] 1
        alias: mutable i64& = value
        alias <- new[r] 3
        new[r] 2
        return 1

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    return region_allocation()
