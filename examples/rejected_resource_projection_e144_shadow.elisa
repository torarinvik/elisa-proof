# A same-spelled local container shadows the bounded parameter; its index cannot reuse the
# parameter's contract fact.
struct ResourceProjectionE144ShadowNode:
    value: usize

def rejected_resource_projection_e144_shadow(nodes: darray[ResourceProjectionE144ShadowNode]&, index: usize) -> usize:
    requires index < nodes.count
    copied: ResourceProjectionE144ShadowNode = nodes[index]
    if index >= 0:
        nodes: darray[ResourceProjectionE144ShadowNode] = []
        shadowed: ResourceProjectionE144ShadowNode = nodes[index]
        return shadowed.value
    return copied.value
