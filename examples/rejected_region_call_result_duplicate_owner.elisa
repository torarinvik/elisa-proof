# A fresh region allocation returned from a verified call transfers its owner to the result.
# Aliasing that result must consume the original handle rather than leaving two mutable owners.
def make_mut[@r](owner: mutable i64& @r) -> mutable i64& @r:
    return new[r] 7

def return_owner[@r](owner: mutable i64& @r) -> mutable i64& @r:
    return owner

def write_region_owner[@r](value: mutable i64& @r) -> void:
    value <- 9

def rejected_region_call_result_duplicate_owner() -> i64 can[Memory.Allocate, Abort.Panic]:
    region r(1024)
    seed: mutable i64& @r = new[r] 1
    fresh: mutable i64& @r = make_mut(seed)
    fresh_alias: mutable i64& @r = fresh
    write_region_owner(fresh)
    write_region_owner(fresh_alias)
    returned: mutable i64& @r = return_owner(seed)
    returned_alias: mutable i64& @r = returned
    write_region_owner(returned)
    write_region_owner(returned_alias)
    return 0

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    return rejected_region_call_result_duplicate_owner()
