module SharedState:
    public:
        global mutable counter: i64 = 0

def qualified_global_read() -> i64:
    can Global{Read}:
        return SharedState::counter

def qualified_global_write() -> void:
    can Global{Write}:
        SharedState::counter <- 1

def qualified_global_update() -> void:
    can Global{Read,Write}:
        SharedState::counter <- SharedState::counter + 1

def qualified_global_missing_read() -> i64:
    return SharedState::counter

def qualified_global_missing_write() -> void:
    SharedState::counter <- 1

def qualified_global_write_only_read() -> i64 can[Global.Write]:
    can Global{Write}:
        return SharedState::counter

def qualified_global_read_only_write() -> void can[Global.Read]:
    can Global{Read}:
        SharedState::counter <- 1
