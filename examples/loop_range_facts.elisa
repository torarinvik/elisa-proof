# Loop ranges are semantic bounds in the proof state. The indexed read is still ordinary Elisa
# runtime code; the proof block demonstrates that the same range fact can be checked and replayed.

def read_in_range(values: darray[i64]&) -> i64:
    for index in 0..<values.count:
        assert index < values.count by:
            assert index < values.count
        return values[index]
    return 0
