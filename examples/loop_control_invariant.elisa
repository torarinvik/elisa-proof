# Loop transfers are sound when the nearest loop invariant is re-established on the transfer
# path. A break does not imply that the while condition is false, so the post-loop proof uses the
# invariant alone.

def break_with_invariant(n: i64) -> i64:
    requires n >= 0
    ensure result >= 0
    x: i64 = 0
    while x < n:
        invariant x >= 0
        break
    return x


def continue_with_invariant(n: i64) -> i64:
    requires n >= 0
    ensure result >= 0
    x: i64 = 0
    while x < n:
        invariant x >= 0
        if x >= 0:
            continue
    return x
