include "../src/proof/kernel_core.elisa"
include "../src/proof/kernel_replay.elisa"

extend ElisaProofKernelReplay:
    public:
        def literal_comparison_helpers_control() -> i64 can[Memory.Allocate, Abort.Panic]:
            return 1 if not proof_kernel_replay_integer_values_compare(-7, "<", 7)
            return 2 if not proof_kernel_replay_integer_values_compare(-7, "<=", -7)
            return 3 if not proof_kernel_replay_integer_values_compare(7, ">", -7)
            return 4 if not proof_kernel_replay_integer_values_compare(7, ">=", 7)
            return 5 if not proof_kernel_replay_integer_values_compare(-7, "==", -7)
            return 6 if not proof_kernel_replay_integer_values_compare(-7, "!=", 7)
            return 7 if proof_kernel_replay_integer_values_compare(7, "<", -7)
            return 8 if proof_kernel_replay_integer_values_compare(7, "unknown", 7)
            nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
            seven: usize = ElisaProofKernelCore::add_node(&nodes, "int", "", 0, 0, 0, 0, 0, 7, "", "")
            plus: usize = ElisaProofKernelCore::add_node(&nodes, "unary", "+", seven, 0, 0, 0, 0, 0, "", "")
            minus: usize = ElisaProofKernelCore::add_node(&nodes, "unary", "-", plus, 0, 0, 0, 0, 0, "", "")
            positive: ProofKernelReplayInt = proof_kernel_replay_nonnegative_literal_constant(&nodes, plus, 3)
            return 9 if not positive.known or positive.value != 7
            negative: ProofKernelReplayInt = proof_kernel_replay_signed_literal_comparison_constant(&nodes, minus, 4)
            return 10 if not negative.known or negative.value != -7
            return 11 if proof_kernel_replay_nonnegative_literal_constant(&nodes, minus, 4).known
            return 12 if proof_kernel_replay_nonnegative_literal_constant(&nodes, plus, 1).known
            return 13 if proof_kernel_replay_nonnegative_literal_constant(&nodes, nodes.count, 3).known
            return 0

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    return ElisaProofKernelReplay::literal_comparison_helpers_control()
