# Replay keys a callee's goals, findings, and certificates by its declaration row: an
# unproven same-named function elsewhere must neither veto nor vouch for Gate::apply,
# and a bare same-module call to a repeated name (Retime::step) replays its summary.
module Gate:
    public:
        def apply(source: i64, fixed: i64, weight: i64) -> i64:
            requires weight >= 0 and weight <= 1000
            requires source >= -1000 and source <= 1000
            requires fixed >= -1000 and fixed <= 1000
            ensure weight != 0 or result == source
            return source if weight == 0
            return source + (fixed - source) * weight / 1000

module Lock:
    public:
        def locked(value: i64, anchor: i64, w: i64) -> i64:
            requires w >= 0 and w <= 1000
            requires value >= -1000 and value <= 1000
            requires anchor >= -1000 and anchor <= 1000
            ensure w != 0 or result == value
            return Gate::apply(value, anchor, w)

module Zed:
    public:
        def apply(x: i64) -> i64:
            return Gate::apply(x, x, 0)

module Retime:
    public:
        def step(speed: i64, amount: i64) -> i64:
            requires speed >= 1 and speed <= 100
            requires amount >= 0 and amount <= 100
            ensure result >= amount
            return amount * speed

        def range_step(speed: i64, amount: i64) -> i64:
            requires speed >= 1 and speed <= 100
            requires amount >= 0 and amount <= 100
            ensure result >= amount
            return step(speed, amount)

module Contact:
    public:
        def step(x: i64) -> i64:
            ensure result == x
            return x
