def rejected_narrowing(value: u16) -> u8:
    ensure result == value
    return value.u8()

def rejected_signedness(value: i8) -> u16:
    ensure result == value
    return value.u16()

def rejected_float_conversion(value: f64) -> u16:
    ensure result == value
    return value.u16()

def rejected_widening_wrong_bound(value: u8) -> u16:
    ensure result < 255
    return value.u16()

extern widening_native_byte() -> u8 can[Unsafe.RawExtern]
def rejected_opaque_receiver() -> u16 can[Unsafe.RawExtern]:
    ensure result <= 255
    trusted Unsafe.RawExtern:
        return widening_native_byte().u16()
