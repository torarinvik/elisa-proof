# Lemma summaries are proof-only and may not recurse without a termination certificate.

lemma circular_lemma(x: i64):
    requires x >= 0
    ensure x < 0
    circular_lemma(x)

lemma mutual_lemma_a(x: i64):
    requires x >= 0
    ensure x < 0
    mutual_lemma_b(x)

lemma mutual_lemma_b(x: i64):
    requires x >= 0
    ensure x < 0
    mutual_lemma_a(x)

def use_recursive_lemma(x: i64) -> void:
    requires x >= 0
    proof x < 0:
        circular_lemma(x)
