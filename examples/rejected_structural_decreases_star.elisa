# An unbounded termination escape hatch never authorizes a structural recursive summary.

enum Nat:
    Zero
    Succ(prev: Nat)

def unbounded_structural(n: Nat) -> i64:
    decreases n
    decreases* "caller supplied no checked ranking"
    match n:
        Nat.Zero:
            return 0
        Nat.Succ(prev):
            return unbounded_structural(prev)
