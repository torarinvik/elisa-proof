# The then arm of an if-expression runs only when its condition holds, so a subtraction the
# condition guards there does not wrap.
module GuardedConditionalArms:
    def above(byte: u64) -> u64:
        ensure result <= byte
        byte - 48 if byte >= 48 else 0

    def digit(byte: u64) -> u64:
        ensure result <= 9
        byte - 48 if byte >= 48 and byte <= 57 else 0

    def gap(low: usize, high: usize) -> usize:
        ensure result <= high
        high - low if low <= high else 0
