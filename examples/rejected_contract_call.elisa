# Executable calls in logical contracts need an explicit purity model and are rejected.

def effectful_contract_step(x: mutable i64) -> i64:
    changes x
    x <- x + 1
    return x

def rejected_contract_call(x: mutable i64) -> i64:
    ensure result == effectful_contract_step(x)
    return effectful_contract_step(x)
