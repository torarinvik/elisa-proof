# A call result's width marker, `f(x)` typed from its declared return, is a statement about
# the call term, so it survives a later call exactly when the term does. Without it the
# first result is unreadable to the linear tier after the second call.
module Clamp:
    public:
        def clamp(value: i64, lo: i64, hi: i64) -> i64:
            requires lo <= hi
            ensure result >= lo
            ensure result <= hi
            ensure value < lo or value > hi or result == value
            return lo if value < lo
            return hi if value > hi
            return value

module Uses:
    public:
        def idempotent(v: i64, lo: i64, hi: i64) -> bool:
            requires lo <= hi
            ensure result
            once: i64 = Clamp::clamp(v, lo, hi)
            twice: i64 = Clamp::clamp(once, lo, hi)
            return twice == once
