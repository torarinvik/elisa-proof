# Controls: the kept facts prove no more than they say, and a call that may write the weight
# through a mutable reference still drops what was known about it.
module Fade:
    public:
        const FULL: i64 = 1000

module Gate:
    public:
        def weight(enabled: bool, fade: i64) -> i64:
            requires fade >= 0
            requires fade <= Fade::FULL
            ensure result >= 0
            ensure result <= Fade::FULL
            ensure not enabled or result == fade
            return fade if enabled
            return 0

        def apply(source: i64, fixed: i64, weight: i64) -> i64:
            requires weight >= 0
            requires weight <= Fade::FULL
            requires source >= -1000 and source <= 1000
            requires fixed >= -1000 and fixed <= 1000
            ensure weight != Fade::FULL or result == fixed
            return fixed if weight == Fade::FULL
            return source

        def damp(weight: mutable i64&) -> void:
            requires weight >= 0
            weight <- 0

module Uses:
    public:
        def kept_weight_is_no_stronger(source: i64, fixed: i64) -> i64:
            requires source >= -1000 and source <= 1000
            requires fixed >= -1000 and fixed <= 1000
            ensure result == Fade::FULL - 1
            w: i64 = Gate::weight(true, Fade::FULL)
            out: i64 = Gate::apply(source, fixed, w)
            return w

        def written_weight_dropped(source: i64, fixed: i64) -> i64:
            requires source >= -1000 and source <= 1000
            requires fixed >= -1000 and fixed <= 1000
            ensure result == Fade::FULL
            w: mutable i64 = Gate::weight(true, Fade::FULL)
            Gate::damp(&w)
            return w
