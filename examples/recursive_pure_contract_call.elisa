# A terminating self-recursive function with immutable state is eligible as a total pure logical
# function. Its recursive edge is still checked by the ordinary decreases proof.

def pure_countdown(n: i64) -> i64:
    decreases n
    ensure result == 0
    if n > 0:
        return pure_countdown(n - 1)
    return 0

def uses_recursive_pure_contract_call(n: i64) -> i64:
    ensure result == pure_countdown(n)
    return pure_countdown(n)
