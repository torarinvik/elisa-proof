# A function-valued local shadows the global `dispatch` callable. Its body may
# mutate the caller's frame even though the same-named global function is empty.
def dispatch(target: mutable i64&) -> void:
    return

def write_target(target: mutable i64&) -> void changes target:
    target <- target + 1

def caller(target: mutable i64&) -> void changes target:
    dispatch: fn(mutable i64&) -> void = write_target
    dispatch(target)
