# A disequality premise, `not (bx - ax == 0)`, that the other facts contradict closes the goal:
# they entail the equality through the linear tier, so the case has no execution.
module Diseq:
    public:
        def degenerate(ax: i64, bx: i64, ay: i64, by: i64) -> bool:
            requires ax >= -1000
            requires ax <= 1000
            requires bx >= -1000
            requires bx <= 1000
            requires ay >= -1000
            requires ay <= 1000
            requires by >= -1000
            requires by <= 1000
            requires not (bx - ax == 0 and by - ay == 0)
            ensure ax != bx or ay != by
            return true

        def squeezed(x: i64, y: i64) -> bool:
            requires x >= -1000
            requires x <= 1000
            requires y >= x
            requires y <= x
            requires x != y
            ensure false
            return true
