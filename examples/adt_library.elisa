# A small library of list, tree and token-stream proofs. Every recursive function carries
# `decreases` over the enum it matches, and every recursive call passes a binder from that match,
# which is the totality evidence: structural descent on a finite value. Each ensure is proved by
# induction, with the recursive call's summary as the hypothesis for the strict subterm.
# Counters saturate at ADT_CAP so that the step never overflows.

enum IntList:
    Nil
    Cons(head: i64, others: IntList)

enum Tree:
    Leaf
    Node(left: Tree, value: i64, right: Tree)

enum Token:
    End
    Number(value: u8, rest: Token)
    Plus(rest: Token)

const ADT_CAP: i64 = 1000000

def list_length(list: IntList) -> i64:
    decreases list
    ensure result >= 0
    ensure result <= ADT_CAP
    match list:
        IntList.Nil:
            return 0
        IntList.Cons(_, others):
            rest: i64 = list_length(others)
            return rest + 1 if rest < ADT_CAP
            return rest

def list_count_nonnegative(list: IntList) -> i64:
    decreases list
    ensure result >= 0
    ensure result <= ADT_CAP
    match list:
        IntList.Nil:
            return 0
        IntList.Cons(head, others):
            rest: i64 = list_count_nonnegative(others)
            return rest if head < 0 or rest >= ADT_CAP
            return rest + 1

def list_head_or(list: IntList, fallback: i64) -> i64:
    ensure result == fallback or result >= 0
    match list:
        IntList.Nil:
            return fallback
        IntList.Cons(head, _):
            return head if head >= 0
            return fallback

def tree_size(tree: Tree) -> i64:
    decreases tree
    ensure result >= 1
    ensure result <= ADT_CAP
    match tree:
        Tree.Leaf:
            return 1
        Tree.Node(left, _, right):
            l: i64 = tree_size(left)
            r: i64 = tree_size(right)
            return ADT_CAP if l + r >= ADT_CAP
            return l + r + 1

def tree_height(tree: Tree) -> i64:
    decreases tree
    ensure result >= 0
    ensure result <= ADT_CAP
    match tree:
        Tree.Leaf:
            return 0
        Tree.Node(left, _, right):
            l: i64 = tree_height(left)
            r: i64 = tree_height(right)
            deeper: i64 = l if l >= r else r
            return deeper + 1 if deeper < ADT_CAP
            return deeper

def tree_max_or(tree: Tree, floor: i64) -> i64:
    decreases tree
    ensure result >= floor
    match tree:
        Tree.Leaf:
            return floor
        Tree.Node(left, value, right):
            l: i64 = tree_max_or(left, floor)
            r: i64 = tree_max_or(right, l)
            return value if value > r
            return r

# A token stream's sum of number literals, each a u8.
def token_sum(tokens: Token) -> i64:
    decreases tokens
    ensure result >= 0
    ensure result <= ADT_CAP
    match tokens:
        Token.End:
            return 0
        Token.Number(value, rest):
            later: i64 = token_sum(rest)
            return later if later > ADT_CAP - 255
            return later + value.i64()
        Token.Plus(rest):
            return token_sum(rest)

def token_length(tokens: Token) -> i64:
    decreases tokens
    ensure result >= 0
    ensure result <= ADT_CAP
    match tokens:
        Token.End:
            return 0
        Token.Number(_, rest):
            later: i64 = token_length(rest)
            return later + 1 if later < ADT_CAP
            return later
        Token.Plus(rest):
            later: i64 = token_length(rest)
            return later + 1 if later < ADT_CAP
            return later

# Totality alone: the parser step that drops leading operators terminates on every stream.
def skip_plus(tokens: Token) -> Token:
    decreases tokens
    match tokens:
        Token.Plus(rest):
            return skip_plus(rest)
        _:
            return tokens
