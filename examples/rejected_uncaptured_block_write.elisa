# The capture list is not a bound on what a captured block writes. `elisac-stage1` compiles a
# block whose body assigns an outer binding the list omits, and the compiled program observes the
# assignment, so a write-back scoped to the capture list alone restores facts and values the block
# has falsified. Each function below is such a block; none of the obligations after it may be
# discharged from the state that reached it.
def small(x: usize) -> usize:
    requires x < 10
    return x

def bump(counter: mutable usize&) -> void:
    changes counter
    counter <- counter + 1

# The plain case: `total` is assigned in the body and named nowhere in the capture list.
def assigned_without_being_captured(count: usize) -> usize:
    total: mutable usize = 0
    for index in 0..<count |index|:
        total <- total + 1
    return small(total)

# The assignment sits under a branch inside the block, so a walk that only looks at the block's
# own top-level statements would miss it.
def assigned_under_a_branch(count: usize, flag: bool) -> usize:
    total: mutable usize = 0
    for index in 0..<count |index, flag|:
        if flag:
            total <- total + 1
    return small(total)

# The block never assigns `total` itself; it hands a reference to a callee that does.
def written_through_a_reference(count: usize) -> usize:
    total: mutable usize = 0
    for index in 0..<count |index|:
        bump(&total)
    return small(total)

# The assignment is inside a block nested in the block, and its own capture list omits the name
# just as the outer one does.
def assigned_in_a_nested_block(count: usize) -> usize:
    total: mutable usize = 0
    for index in 0..<count |index|:
        for inner in 0..<count |inner|:
            total <- total + 1
    return small(total)

# A fact, rather than a recorded value, over a binding the block writes.
def fact_over_a_written_binding(count: usize, start: usize) -> usize:
    requires start < 10
    total: mutable usize = start
    for index in 0..<count |index|:
        total <- total + 1
    return small(total)
