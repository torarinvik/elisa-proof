# Lexicographic termination supports resetting a secondary counter after the primary
# component decreases, a common pattern for nested recursive algorithms.

def lexicographic_count(outer: i64, inner: i64) -> i64:
    requires outer >= 0
    requires inner >= 0
    decreases (outer, inner)
    ensure result == 0
    if outer > 0:
        return lexicographic_count(outer - 1, 5)
    if outer == 0:
        if inner > 0:
            return lexicographic_count(outer, inner - 1)
        return 0
    return 0

# Repeated clauses are normalized to the same lexicographic component list.

def repeated_lexicographic_count(outer: i64, inner: i64) -> i64:
    requires outer >= 0
    requires inner >= 0
    decreases outer
    decreases inner
    ensure result == 0
    if outer > 0:
        return repeated_lexicographic_count(outer - 1, 5)
    if outer == 0:
        if inner > 0:
            return repeated_lexicographic_count(outer, inner - 1)
        return 0
    return 0
