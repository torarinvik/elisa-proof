# Ground congruence closure over the primitive scalar fragment: a positive equality premise
# travels through every former whose operator is the language's own. The kernel decides this
# rule; the source tier only lowers the premises and the goal into its term language.
#
# Elisa dispatches `==`, arithmetic, and ordering to a user `__eq__`/`__add__`/`__cmp__` when an
# operand's type is a struct, so only identifiers the producer witnessed as having a declared
# primitive scalar type may enter the relation. `rejected_congruence.elisa` pins the refusals.

def congruence_sum(a: i64, b: i64, c: i64) -> i64:
    requires a == b
    ensure a + c == b + c
    return 0

def congruence_difference(a: i64, b: i64, c: i64) -> i64:
    requires a == b
    ensure c - a == c - b
    return 0

def congruence_product(a: i64, b: i64, c: i64, d: i64) -> i64:
    requires a == b
    requires c == d
    ensure a * c == b * d
    return 0

def congruence_nested(a: i64, b: i64) -> i64:
    requires a == b
    ensure (a + 1) * 2 == (b + 1) * 2
    return 0

# A class derived by congruence may be equated further by a second premise.
def congruence_chain(a: i64, b: i64, c: i64) -> i64:
    requires a == b
    requires b + 1 == c
    ensure a + 1 == c
    return 0

def congruence_boolean(a: i64, b: i64) -> i64:
    requires a == b
    ensure (a < 5) == (b < 5)
    return 0

def congruence_bitwise(a: i64, b: i64, c: i64) -> i64:
    requires a == b
    ensure (a & c) == (b & c)
    return 0

def congruence_conditional(a: i64, b: i64, c: i64, d: i64) -> i64:
    requires a == b
    ensure (c if a < 5 else d) == (c if b < 5 else d)
    return 0

def congruence_character(a: char, b: char) -> i64:
    requires a == b
    ensure (a == 'x') == (b == 'x')
    return 0

def congruence_boolean_parameters(a: bool, b: bool) -> i64:
    requires a == b
    ensure (a and b) == (b and a)
    return 0

# An unsigned width marker witnesses a primitive scalar type too, and fixed-width arithmetic
# reaches congruence only when every operand is proven in range.
def congruence_bounded_unsigned(x: u8, y: u8, c: u8) -> i64:
    requires x == y
    requires x <= 10
    requires y <= 10
    requires c <= 10
    ensure x + c == y + c
    return 0

# A verified total-pure function's result over witnessed arguments denotes one primitive scalar
# value, so the producer witnesses that exact call term and it joins the closure as an atom.
def pure_identity(value: i64) -> i64:
    ensure result == value
    return value

def congruence_pure_call_result(a: i64, b: i64, c: i64) -> i64:
    requires pure_identity(a) == pure_identity(b)
    ensure pure_identity(a) + c == pure_identity(b) + c
    return 0

# Premises listed top-down merge one layer per saturation round; two layers fit the budget.
def congruence_layered_premises(a: i64, b: i64, c1: i64, d1: i64, c2: i64, d2: i64) -> i64:
    requires c2 == c1 * 3
    requires d2 == d1 * 3
    requires c1 == a * 3
    requires d1 == b * 3
    requires a == b
    ensure c2 == d2
    return 0
