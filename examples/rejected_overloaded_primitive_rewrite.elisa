# A user protocol implementation on a primitive type must not make equality usable as a
# Leibniz rewrite rule. This is the primitive-type counterpart to rejected_congruence.elisa.
protocol Eq:
    def __eq__(self: Self, other: Self) -> bool

impl Eq for i64:
    def __eq__(self: i64, other: i64) -> bool:
        return self != other

def overloaded_primitive_rewrite(x: i64, y: i64) -> i64:
    requires x == y
    ensure y == x
    return 0
