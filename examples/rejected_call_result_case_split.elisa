# Controls for call_result_case_split: the extra split depth must not prove claims that
# the result contracts do not support.
module CallResultSplitControl:
    public:
        def gap(first: i64, last: i64) -> i64:
            requires first >= -1000000000
            requires first <= 1000000000
            requires last >= -1000000000
            requires last <= 1000000000
            ensure result >= 0
            ensure first != last or result == 0
            ensure result == first - last or result == last - first
            return first - last if first >= last
            return last - first

        # Without the nonnegativity clause, the crossing cases stay open.
        def loose(first: i64, last: i64) -> i64:
            requires first >= -1000000000
            requires first <= 1000000000
            requires last >= -1000000000
            requires last <= 1000000000
            ensure result == first - last or result == last - first
            return first - last

        def gap_is_not_signed(a: i64, b: i64) -> bool:
            requires a >= -1000000000
            requires a <= 1000000000
            requires b >= -1000000000
            requires b <= 1000000000
            ensure result
            return gap(a, b) == a - b

        def loose_is_not_symmetric(a: i64, b: i64) -> bool:
            requires a >= -1000000000
            requires a <= 1000000000
            requires b >= -1000000000
            requires b <= 1000000000
            ensure result
            return loose(a, b) == loose(b, a)
