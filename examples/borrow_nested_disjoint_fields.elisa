# Prefix overlap is path-sensitive: inner.value does not overlap inner.sibling.

struct Inner:
    value: mutable i64
    sibling: mutable i64

struct Box:
    inner: mutable Inner

def borrow_nested_disjoint_fields(box: mutable Box) -> i64:
    value_view: i64& = &box.inner.value
    box.inner.sibling <- 1
    return box.inner.sibling
