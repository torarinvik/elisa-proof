# Fixed-array indexing is also a bounded direct aggregate copy; the exact capacity comes from
# the declared array type rather than a dynamic `.count` field.
struct ResourceProjectionE144FixedLeaf:
    left: usize
    right: usize

struct ResourceProjectionE144FixedNode:
    leaf: ResourceProjectionE144FixedLeaf

def resource_projection_e144_fixed_sum(left: usize, right: usize) -> usize:
    return left + right

def resource_projection_e144_fixed_array_copy(nodes: array[ResourceProjectionE144FixedNode, 4]&, index: usize) -> usize:
    requires index < 4
    copied: ResourceProjectionE144FixedNode = nodes[index]
    return resource_projection_e144_fixed_sum(copied.leaf.left, copied.leaf.right)
