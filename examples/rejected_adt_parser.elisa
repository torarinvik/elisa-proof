# Broken counterparts of `adt_parser.elisa`: each claims something its parser does not do, so
# each ensure named below must be refused.

enum Token:
    End
    Number(value: u8, rest: Token)
    Plus(rest: Token)

const ADT_CAP: i64 = 1000000

# A literal is one token, not none.
def consumes_nothing(tokens: Token) -> (value: i64, consumed: i64):
    ensure result.consumed <= 0
    match tokens:
        Token.Number(value, _):
            return (value.i64(), 1)
        _:
            return (0, 0)

# Labels project by position: `value` is 5 here, not 1.
def swapped_labels(tokens: Token) -> (value: i64, consumed: i64):
    ensure result.value <= 1
    return (5, 1)

# The inductive step adds a token; the hypothesis bounds `consumed` by the cap, not by zero.
def sum_reads_nothing(tokens: Token) -> (value: i64, consumed: i64):
    decreases tokens
    ensure result.consumed >= 0
    ensure result.consumed <= 0
    match tokens:
        Token.End:
            return (0, 0)
        Token.Number(value, rest):
            later: (value: i64, consumed: i64) = sum_reads_nothing(rest)
            if later.consumed < ADT_CAP:
                return (later.value, later.consumed + 1)
            return later
        Token.Plus(rest):
            return sum_reads_nothing(rest)

def parse_sum(tokens: Token) -> (value: i64, consumed: i64):
    decreases tokens
    ensure result.consumed >= 0
    ensure result.consumed <= ADT_CAP
    ensure result.value >= 0
    ensure result.value <= ADT_CAP
    match tokens:
        Token.End:
            return (0, 0)
        Token.Number(value, rest):
            later: (value: i64, consumed: i64) = parse_sum(rest)
            if later.value < ADT_CAP - 255 and later.consumed < ADT_CAP:
                return (later.value + value.i64(), later.consumed + 1)
            return (later.value, later.consumed)
        Token.Plus(rest):
            skipped: (value: i64, consumed: i64) = parse_sum(rest)
            if skipped.consumed < ADT_CAP:
                return (skipped.value, skipped.consumed + 1)
            return skipped

# The summary bounds `value` by the cap; reading it as `consumed`'s bound would be wrong too.
def length_below_ten(tokens: Token) -> i64:
    ensure result <= 10
    return parse_sum(tokens).consumed

# A label's bound is not its sibling's: `consumed` is at most the cap, `value` is not known to be
# below 256.
def value_is_a_byte(tokens: Token) -> i64:
    ensure result <= 255
    return parse_sum(tokens).value

# A repeated label names no single element, so `result.value` is never projected.
def repeated_label() -> (value: i64, value: i64):
    ensure result.value <= 1
    return (5, 1)
