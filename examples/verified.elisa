# A small imported Elisa module checked by the self-hosted proof assistant.

def successor(x: i64) -> i64:
    requires x >= 0
    ensure result == x + 1
    return x + 1


def prove_nonnegative(x: i64) -> void:
    requires x >= 0
    assert x >= 0 by:
        assert x >= 0


def prove_reflexive(x: i64) -> void:
    proof x + 1 == x + 1:
        assert x + 1 == x + 1
