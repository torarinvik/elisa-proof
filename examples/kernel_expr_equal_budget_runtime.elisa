# Direct runtime boundary controls for structural replay equality.
include "../src/proof/kernel_core.elisa"
include "../src/proof/kernel_replay.elisa"
using ElisaProofKernelCore
using ElisaProofKernelReplay

extend ElisaProofKernelReplay:
    public:
        # Exercise the same bounded enqueue primitive used by expr_equal without
        # walking four million synthetic pairs after the accepted boundary.
        def expr_equal_work_cap_boundary_control() -> bool:
            pending: mutable darray[ProofKernelReplayExprPair] = []
            pair: ProofKernelReplayExprPair = ProofKernelReplayExprPair{left: 0, right: 0, depth: 0, call_argument: false}
            for index in 0..<PROOF_KERNEL_REPLAY_MAX_EXPR_EQUALITY_WORK - 2 |index, pending, pair|:
                pending.push(pair)
            scheduled: mutable usize = pending.count
            return false if not proof_kernel_replay_expr_pair_enqueue(&pending, &scheduled, 0, 0, 0)
            return false if pending.count != PROOF_KERNEL_REPLAY_MAX_EXPR_EQUALITY_WORK - 1
            return false if not proof_kernel_replay_expr_call_argument_enqueue(&pending, &scheduled, 0, 0, 0)
            return false if pending.count != PROOF_KERNEL_REPLAY_MAX_EXPR_EQUALITY_WORK
            return false if proof_kernel_replay_expr_pair_enqueue(&pending, &scheduled, 0, 0, 0)
            return false if proof_kernel_replay_expr_call_argument_enqueue(&pending, &scheduled, 0, 0, 0)
            children: darray[usize] = [0]
            return false if proof_kernel_replay_expr_child_span_enqueue(children, &pending, &scheduled, 0, 0, 2, 0, false)
            return false if proof_kernel_replay_expr_child_span_enqueue(children, &pending, &scheduled, 0, 0, 2, 0, true)
            return false if proof_kernel_replay_expr_child_span_enqueue(children, &pending, &scheduled, 1, 0, 1, 0, false)
            return false if proof_kernel_replay_expr_child_span_enqueue(children, &pending, &scheduled, 1, 0, 1, 0, true)
            return false if proof_kernel_replay_expr_child_span_enqueue(children, &pending, &scheduled, 0, 0, 1, 0, false)
            return false if proof_kernel_replay_expr_child_span_enqueue(children, &pending, &scheduled, 0, 0, 1, 0, true)
            return false if pending.count != PROOF_KERNEL_REPLAY_MAX_EXPR_EQUALITY_WORK or scheduled != PROOF_KERNEL_REPLAY_MAX_EXPR_EQUALITY_WORK
            pending.resize(0)
            return false if proof_kernel_replay_expr_pair_enqueue(&pending, &scheduled, 0, 0, 0)
            return false if proof_kernel_replay_expr_call_argument_enqueue(&pending, &scheduled, 0, 0, 0)
            return pending.count == 0 and scheduled == PROOF_KERNEL_REPLAY_MAX_EXPR_EQUALITY_WORK

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    nodes: mutable darray[ProofKernelNode] = []
    children: mutable darray[usize] = []
    zero: usize = add_node(&nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
    one: usize = add_node(&nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
    malformed: usize = add_node(&nodes, "int", "+", 0, 0, 0, 0, 0, 0, "", "")
    invalid_child: usize = add_node(&nodes, "binary", "+", nodes.count + 10, zero, 0, 0, 0, 0, "", "")
    return 1 if not proof_kernel_replay_expr_equal_public(&nodes, &children, zero, zero, PROOF_KERNEL_REPLAY_DEPTH_LIMIT - 1)
    return 2 if proof_kernel_replay_expr_equal_public(&nodes, &children, zero, zero, PROOF_KERNEL_REPLAY_DEPTH_LIMIT)
    return 3 if proof_kernel_replay_expr_equal_public(&nodes, &children, nodes.count, zero, 0)
    return 4 if proof_kernel_replay_expr_equal_public(&nodes, &children, malformed, malformed, 0)
    return 5 if proof_kernel_replay_expr_equal_public(&nodes, &children, invalid_child, invalid_child, 0)
    return 6 if not ElisaProofKernelReplay::expr_equal_work_cap_boundary_control()
    return 0
