# The companion to `examples/confined_lend_extent.elisa`. That one is about loop entry: a lend that
# cannot outlive its call does not make the binding reachable by a later loop. This one is about the
# call inside the loop, which is where the fact actually died.
#
# When a call is opaque the checker clears the state and restores what the callee could not have
# reached. That restore asked the frame's whole aliased set, so a collection lent once anywhere --
# `fill(&names)` before the loop -- was treated as reachable by every later call, and the loop's own
# range fact was gone after the first call in its body. The question the restore is asking is the
# same one loop entry asks: what can *this* call reach. The answer is the lends that outlive their
# own call, together with the lends this call itself performs.

def fill(values: mutable darray[usize]&) -> void:
    values.push(1)
    values.push(2)

def note(sink: mutable darray[usize]&, value: usize) -> void:
    sink.push(value)

# The body calls something on every iteration, and the call lends a different binding. The range
# fact over `names` survives it.
def a_call_in_the_body_keeps_the_range(sink: mutable darray[usize]&) -> usize:
    names: mutable darray[usize] = []
    fill(&names)
    total: mutable usize = 0
    for index in 0..<names.count |index, names, sink, total|:
        note(sink, 0)
        total <- total + names[index]
    return total

# The lent binding is a local of this frame rather than a parameter.
def a_lent_local_in_the_body() -> usize:
    names: mutable darray[usize] = []
    other: mutable darray[usize] = []
    fill(&names)
    total: mutable usize = 0
    for index in 0..<names.count |index, names, other, total|:
        note(&other, names[index])
        total <- total + names[index]
    return total

# The call takes the collection's own element, which is a value and lends nothing.
def an_element_argument(sink: mutable darray[usize]&) -> usize:
    names: mutable darray[usize] = []
    fill(&names)
    total: mutable usize = 0
    for index in 0..<names.count |index, names, sink, total|:
        note(sink, names[index])
        total <- total + names[index]
    return total
