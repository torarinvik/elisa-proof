# An `extend` block is a separate module declaration. Types named in its signatures must still
# resolve against every block of the module: a recursive shared walk whose scalar-only result
# struct is declared in a sibling block is a confined lend, exactly as it is when both live in
# one block.
module ExtendLendProbe:
    public:
        struct Node:
            kind: sview
            left: usize

        struct WalkResult:
            known: bool
            value: i64

extend ExtendLendProbe:
    public:
        def extend_walk(nodes: darray[Node]&, root: usize, remaining: usize) -> WalkResult:
            decreases remaining
            return WalkResult{known: false, value: 0} if root >= nodes.count or remaining < 1
            return extend_walk(nodes, nodes[root].left, remaining - 1)

        def extend_walk_entry(nodes: darray[Node]&, root: usize) -> WalkResult:
            return extend_walk(nodes, root, 64)
