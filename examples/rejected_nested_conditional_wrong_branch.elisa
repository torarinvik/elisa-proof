# The guard bounds one argument, not the maximum: when b is larger it says nothing.
def saturating_successor(a: i64, b: i64) -> i64:
    requires a >= 0 and a <= 1000000
    requires b >= 0 and b <= 1000000
    ensure result <= 1000000
    deeper: i64 = a if a >= b else b
    return deeper + 1 if a < 1000000
    return deeper
