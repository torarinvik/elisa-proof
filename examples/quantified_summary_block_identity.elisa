def quantified_summary_one(lengths: array[usize, 8]&) -> u8:
    ensure result == 1
    ensure result != 0 or (forall index in 0..<8: lengths[index] == 64)
    return 1

def quantified_summary_block_identity(lengths: array[usize, 8]&) -> u8:
    ensure result == 1
    ensure result != 0 or (forall row_index in 0..<8: lengths[row_index] == 64)
    return quantified_summary_one(lengths)
