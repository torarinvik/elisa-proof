# Qualified types resolve by trying the complete written path, including the leaf type,
# from the function's lexical module outward. `Outer::N::M::Sub` has no `Word`, so the
# complete `Outer::M::Sub::Word` path resolves.
# The plain nested `Outer::M::Word` is u8 even though root `M::Word` is u64.
using M as Alias

module M:
    public:
        type Word = u64

module Outer:
    module M:
        public:
            type Word = u8
        module Sub:
            public:
                type Word = u64

    public:
        def local_parameter_scope_collision(value: M::Word) -> bool:
            requires value == 255
            ensure result
            return value + 1 > value

        def call_result_scope_collision() -> bool:
            ensure result
            return maximum_byte() + 1 > 255

        def maximum_byte() -> M::Word:
            ensure result == 255
            return 255

    module N:
        module M:
            public:
                type Word = u16
            module Sub:
                public:
                    type Other = u8

        module PartialWorker:
            public:
                def partial_parent_module_parameter_fallback(value: M::Sub::Word) -> bool:
                    requires value == 18446744073709551615u64
                    ensure result
                    return value + 1 == 0u64

                def partial_parent_module_call_result_fallback() -> bool:
                    ensure result
                    return partial_parent_maximum() + 1 == 0u64

                def partial_parent_maximum() -> M::Sub::Word:
                    ensure result == 18446744073709551615u64
                    return 18446744073709551615u64

        public:
            def deep_local_parameter_scope_collision(value: M::Word) -> bool:
                requires value == 255
                ensure not result
                return value + 1 > value

            def deep_call_result_scope_collision() -> bool:
                ensure not result
                return deep_maximum_byte() + 1 > 255

            def deep_maximum_byte() -> M::Word:
                ensure result == 255
                return 255

            def deep_local_parameter_width_positive(value: M::Word) -> bool:
                requires value == 65535
                ensure result
                return value + 1 == 0u16

            def deep_maximum_word() -> M::Word:
                ensure result == 65535
                return 65535

            def deep_call_result_width_positive() -> bool:
                ensure result
                return deep_maximum_word() + 1 == 0u16

    module Worker:
        public:
            def parent_module_parameter_fallback(value: M::Word) -> bool:
                requires value == 255
                ensure result
                return value + 1 == 0

            def parent_module_call_result_fallback() -> bool:
                ensure result
                return parent_maximum_byte() + 1 == 0

            def parent_maximum_byte() -> M::Word:
                ensure result == 255
                return 255

module Client:
    public:
        def root_maximum() -> M::Word:
            ensure result == 18446744073709551615u64
            return 18446744073709551615u64

        def root_qualified_type_positive() -> bool:
            ensure result
            return root_maximum() + 1 == 0u64

module Alias:
    public:
        type Word = u8

module AliasClient:
    public:
        def alias_maximum() -> Alias::Word:
            ensure result == 18446744073709551615u64
            return 18446744073709551615u64

        def module_alias_type_path_precedence_positive() -> bool:
            ensure result
            return alias_maximum() + 1 == 0u64

        def module_alias_parameter_type_path_precedence_positive(value: Alias::Word) -> bool:
            requires value == 18446744073709551615u64
            ensure result
            return value + 1 == 0u64

# The generic result spelling collides with a primitive. Replay must use the function's
# declaration-line binder table and leave this call result opaque without substitution.
def generic_u32_identity[u32](value: u32) -> u32:
    return value

def generic_result_primitive_name_shadow(value: u64) -> bool:
    ensure result
    return generic_u32_identity(value) <= 4294967295

# An incompatible generic with the same name must not shadow the unique root overload.
def generic_dispatch_probe[T, U](first: T, second: U) -> T:
    return first

def generic_dispatch_probe(value: u64) -> u64:
    ensure result == 18446744073709551615u64
    return 18446744073709551615u64

module GenericDispatchClient:
    public:
        def root_overload_after_incompatible_generic(value: u64) -> bool:
            requires value == 18446744073709551615u64
            ensure result
            return generic_dispatch_probe(value) + 1 == 0u64

# Alias expansion must keep resolving a module-qualified target after consuming the
# qualified alias name itself. The target path ends in a transparent alias too.
module DeepQualifiedAlias:
    public:
        type Word = Outer::M::Sub::Word
        type Byte = Outer::M::Word

module DeepQualifiedAliasClient:
    public:
        def deep_qualified_alias_parameter(value: DeepQualifiedAlias::Word) -> bool:
            requires value == 18446744073709551615u64
            ensure result
            return value + 1 == 0u64

        def deep_qualified_alias_maximum() -> DeepQualifiedAlias::Word:
            ensure result == 18446744073709551615u64
            return 18446744073709551615u64

        def deep_qualified_alias_call_result() -> bool:
            ensure result
            return deep_qualified_alias_maximum() + 1 == 0u64

        def deep_qualified_alias_wrong_width(value: DeepQualifiedAlias::Byte) -> bool:
            requires value == 255
            ensure not result
            return value + 1 > value
