# A parent write overlaps a preserved nested child and must be rejected.

struct Inner:
    value: mutable i64
    sibling: mutable i64

struct Box:
    inner: mutable Inner

def set_inner(box: mutable Box&) -> void:
    changes box.inner
    box.inner.value <- 1

def caller_preserves_child(box: mutable Box&) -> void:
    preserves box.inner.sibling
    set_inner(box)
