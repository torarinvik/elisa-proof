# Enum member identity must include its declared owner, even when several enums reuse a variant
# name. Shorthand is resolved from the other operand's enum type; qualified members retain and
# independently validate their type path.
module WbRuntime:
    public:
        const enum LifecycleState of u8:
            Startup = 0
            Initialized = 1

        const enum LifecycleEvent of u8:
            Startup = 0
            Initialized = 1

def enum_shorthand_context(state: WbRuntime::LifecycleState) -> bool:
    requires state == .Startup
    ensure state == .Startup
    return true

def enum_qualified_context(state: WbRuntime::LifecycleState) -> bool:
    requires state == WbRuntime::LifecycleState.Initialized
    ensure state == WbRuntime::LifecycleState.Initialized
    return true

def enum_variant_tags_are_disjoint(state: WbRuntime::LifecycleState) -> bool:
    requires state is WbRuntime::LifecycleState.Startup
    ensure result
    return not (state is WbRuntime::LifecycleState.Initialized)
