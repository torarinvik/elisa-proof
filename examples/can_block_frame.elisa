# A `can` effect block grants capabilities and nothing else: facts over values
# its body neither writes nor passes mutably survive the block.
def bump(v: mutable darray[u32]&) -> void can[Memory.Allocate]:
    v.push(1)

def keeps_other(a: mutable darray[u32]&, b: darray[u32]&, i: usize) -> u32 can[Memory.Allocate]:
    requires i < b.count
    can Memory.Allocate:
        bump(a)
    return b[i]

def keeps_scalar(a: mutable darray[u32]&, n: u32) -> u32 can[Memory.Allocate]:
    requires n < 100
    ensure result < 101
    can Memory.Allocate:
        a.push(3)
    return n + 1

def keeps_across_local(a: mutable darray[u32]&, n: u32) -> u32 can[Memory.Allocate]:
    requires n < 100
    ensure result < 101
    can Memory.Allocate:
        k: u32 = 7
        a.push(k)
    return n + 1

def learns_inside(a: mutable darray[u32]&, n: u32) -> u32 can[Memory.Allocate]:
    ensure result < 11
    m: mutable u32 = 0
    can Memory.Allocate:
        a.push(n)
        m <- 10
    return m
