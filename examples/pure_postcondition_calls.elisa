# Verified pure helpers may be composed in postconditions and then reused by
# another function's postcondition.

def postcondition_call_base(x: i64) -> i64:
    ensure result == x
    x

def postcondition_call_derived(x: i64) -> i64:
    ensure result == postcondition_call_base(x)
    postcondition_call_base(x)

def postcondition_call_consumer(x: i64) -> i64:
    ensure result == postcondition_call_derived(x)
    postcondition_call_derived(x)
