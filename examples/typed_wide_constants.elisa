# A closed constant beside a strictly typed peer is read at the peer's width, so constants
# past the i8 range, folded through `/` and `%`, or joined by an if-expression still bound.
module TypedWideConstants:
    const CAP: u64 = 1000000000000000000
    const SMALL: u64 = 1000

    def wide_constant() -> u64:
        ensure result <= CAP
        0

    def halved(v: u64) -> u64:
        requires v < 200 / 2
        ensure result <= 99
        v

    def remainder(v: u64) -> u64:
        requires v < 1000 % 300
        ensure result <= 99
        v

    def signed_halved(v: i64) -> i64:
        requires v < 200 / 2
        ensure result <= 99
        v

    def named_tenth(v: u64) -> u64:
        requires v < SMALL / 10
        ensure result <= 999
        v * 10 + 9

    def wide_arms(v: u64) -> u64:
        requires v <= 1000000000000000000
        ensure result <= 1000000000000000000
        1000000000000000000 if v >= 100000000000000000 else 7
