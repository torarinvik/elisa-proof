# Rejected control: the caller passes 20000000, above F::MAXF, so the
# callee requires into <= F::MAXF must fail.
module F:
    public:
        const MAXF: i64 = 10000000

module K:
    public:
        def g(into: i64, left: i64) -> i64:
            requires into >= 0
            requires into <= F::MAXF
            requires left >= 0
            ensure into != 0 or result == left
            return left if into == 0
            return 0

module Laws:
    public:
        def p(left: i64) -> i64:
            requires left >= 0
            ensure result == 0
            return K::g(20000000, left)
