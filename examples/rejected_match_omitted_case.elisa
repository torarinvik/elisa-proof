# A single listed variant must not be mistaken for an exhaustive match.
enum MatchCoverageOmitted:
    First
    Second

def omitted_case_is_not_exhaustive(value: MatchCoverageOmitted) -> bool:
    ensure value is MatchCoverageOmitted.First
    match value:
        MatchCoverageOmitted.First:
            pass
    return true
