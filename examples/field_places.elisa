module FieldPlaces:
    public:
        const CAP: usize = 16

        struct Text:
            bytes: mutable u8[FieldPlaces::CAP]
            length: mutable usize

        # `at < text.length <= CAP` bounds the read, though the middle term is a field.
        def byte_at(text: Text&, at: usize) -> u8:
            requires at < text.length and text.length <= CAP
            text.bytes[at]

        def by_value(text: Text, at: usize) -> u8:
            requires at < text.length and text.length <= 16
            text.bytes[at]

        def two_hops(text: Text&, at: usize, stop: usize) -> u8:
            requires at < stop and stop <= text.length and text.length <= CAP
            text.bytes[at]

        def bounded_position(text: Text&, at: usize) -> usize:
            requires at < text.length and text.length <= CAP
            ensure result < CAP
            at

        # The loop binder and the field are both generalized.
        def all_spaces(text: Text&, start: usize, stop: usize) -> bool:
            requires start <= stop and stop <= text.length and text.length <= CAP
            for index in start..<stop |all: bool = true| -> all:
                all <- all and text.bytes[index] == 32

        # The first non-space position, or `stop`.
        def skip_spaces(text: Text&, start: usize, stop: usize) -> usize:
            requires start <= stop and stop <= text.length and text.length <= CAP
            ensure start <= result and result <= stop
            for index in start..<stop |found: usize = stop| -> found:
                invariant start <= found and found <= stop
                found <- index if found == stop and text.bytes[index] != 32
