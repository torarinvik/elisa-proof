# Contextual constant width dispatch must preserve every recognized integer
# width, reject usize as before, and share one bounded work counter end-to-end.
include "../build/snapshot/Elisa-compiler/elisacore_std/elisacore_runtime.elisa"
include "../src/proof/kernel_core.elisa"
include "../src/proof/kernel_typed_literals.elisa"
include "../src/proof/kernel_contextual_constants.elisa"
using ElisaProofKernelCore

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    nodes: mutable darray[ProofKernelNode] = []
    sorts: darray[sview] = ["u8", "u16", "u32", "u64", "i8", "i16", "i32", "i64"]
    values: darray[i64] = [255, 65535, 4294967295, -1, 127, 32767, 2147483647, 9223372036854775807]
    widths: darray[i64] = [8, 16, 32, 64, 8, 16, 32, 64]
    for index in 0..<sorts.count |index, nodes, sorts, values, widths|:
        root: usize = add_node(nodes, "typed-int", "", 0, 0, 0, 0, 0, values[index], sorts[index], "")
        decoded = typed_literal_value(nodes[root])
        return 1 if not decoded.known or decoded.width != widths[index]
        return 2 if decoded.unsigned != (index < 4)
        expected: i64 = widths[index] if index < 4 else 0
        return 3 if contextual_constant_expression_unsigned_width(nodes, root) != expected

    usize_literal: usize = add_node(nodes, "typed-int", "", 0, 0, 0, 0, 0, 1, "usize", "")
    usize_value = typed_literal_value(nodes[usize_literal])
    return 4 if usize_value.known or usize_value.width != 0
    return 5 if contextual_constant_expression_unsigned_width(nodes, usize_literal) != 0

    overflow_sorts: darray[sview] = ["u8", "u16", "u32", "i8", "i16", "i32"]
    overflow_values: darray[i64] = [256, 65536, 4294967296, 128, 32768, 2147483648]
    for index in 0..<overflow_sorts.count |index, nodes, overflow_sorts, overflow_values|:
        root: usize = add_node(nodes, "typed-int", "", 0, 0, 0, 0, 0, overflow_values[index], overflow_sorts[index], "")
        return 6 if typed_literal_value(nodes[root]).known
        return 7 if contextual_constant_expression_unsigned_width(nodes, root) != 0

    # A shared depth-11 DAG costs 4,095 visits in each traversal. The unchanged
    # 4,096-work budget is shared by sort discovery and value evaluation, so the
    # second traversal must fail closed instead of getting a fresh allowance.
    shared: mutable usize = add_node(nodes, "typed-int", "", 0, 0, 0, 0, 0, 0, "u8", "")
    for _ in 0..<11 |nodes, shared|:
        shared <- add_node(nodes, "binary", "+", shared, shared, 0, 0, 0, 0, "", "")
    return 8 if contextual_constant_expression_unsigned_width(nodes, shared) != 0
    return 0
