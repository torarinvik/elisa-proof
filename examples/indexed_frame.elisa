# Dynamic indexing is opaque at the element level, but a declared container or root frame
# soundly authorizes the write and unrelated fields remain preservable.

struct Box:
    values: mutable darray[i64]
    other: mutable i64

def write_value_at(box: mutable Box&, index: usize) -> void:
    requires index >= 0 and index < box.values.count
    changes box.values
    box.values[index] <- 1

def caller_preserves_other(box: mutable Box&, index: usize) -> i64:
    requires index >= 0 and index < box.values.count
    changes box.values
    preserves box.other
    write_value_at(box, index)
    return 13
