# Partitions that must not prove (BACKLOG W-04).

# The swap moves a small cell down, but nothing says the cells from i are at least the pivot.
def strict_upper(xs: mutable darray[i64]&, n: usize, p: i64) -> usize:
    requires n <= xs.count
    ensures forall t in result..<n: p < xs[t]
    i: mutable usize = 0
    j: mutable usize = 0
    while j < n:
        invariant i <= j
        invariant j <= n
        invariant forall t in 0..<i: xs[t] < p
        invariant forall t in i..<j: p <= xs[t]
        if i < j:
            if xs[j] < p:
                a: i64 = xs[i]
                b: i64 = xs[j]
                xs[i] <- b
                xs[j] <- a
                i <- i + 1
        else:
            if xs[j] < p:
                i <- i + 1
        j <- j + 1
    return i

# Without the upper invariant the loop forgets what it has already passed over.
def forgets_upper(xs: mutable darray[i64]&, n: usize, p: i64) -> usize:
    requires n <= xs.count
    ensures forall t in result..<n: p <= xs[t]
    i: mutable usize = 0
    j: mutable usize = 0
    while j < n:
        invariant i <= j
        invariant j <= n
        invariant forall t in 0..<i: xs[t] < p
        if i < j:
            if xs[j] < p:
                a: i64 = xs[i]
                b: i64 = xs[j]
                xs[i] <- b
                xs[j] <- a
                i <- i + 1
        else:
            if xs[j] < p:
                i <- i + 1
        j <- j + 1
    return i

# Moving i past the swapped cell before writing it leaves the small cell above the split.
def swap_after_step(xs: mutable darray[i64]&, n: usize, p: i64) -> usize:
    requires n <= xs.count
    ensures forall t in 0..<result: xs[t] < p
    i: mutable usize = 0
    j: mutable usize = 0
    while j < n:
        invariant i <= j
        invariant j <= n
        invariant forall t in 0..<i: xs[t] < p
        invariant forall t in i..<j: p <= xs[t]
        if i < j:
            if xs[j] < p:
                i <- i + 1
                a: i64 = xs[i]
                b: i64 = xs[j]
                xs[i] <- b
                xs[j] <- a
        else:
            if xs[j] < p:
                i <- i + 1
        j <- j + 1
    return i
