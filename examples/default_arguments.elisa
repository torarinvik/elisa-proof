# Pure parameter defaults are materialized into executable summaries by the proof kernel.

def add_default(x: i64, amount: i64 = 7) -> i64:
    requires amount == 7
    ensure result == x + amount
    return x + amount

def use_default(x: i64) -> i64:
    requires x >= 0
    ensure result == x + 7
    return add_default(x)

def multiple_defaults(x: i64, amount: i64 = 7, offset: i64 = 1) -> i64:
    requires x >= 0
    requires amount == 7
    requires offset == 1
    ensure result == x + amount + offset
    return x + amount + offset

def use_multiple_defaults(x: i64) -> i64:
    requires x >= 0
    ensure result == x + 7 + 1
    return multiple_defaults(x)
