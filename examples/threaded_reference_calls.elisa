# A call that takes a local through an exclusive `mutable T&` parameter is read as a value update
# of that local: `bump(&x)` is `x <- bump(x)`. The callee's contract speaks of the referent
# before (`old(p[0])`) and after (`p[0]`) the call; the caller learns the local's new value from it
# and keeps every fact about the old one. Both spellings prove the same claims.

def bump(value: mutable usize&) -> void:
    requires value[0] < 1000
    ensure value[0] == old(value[0]) + 1
    value[0] <- value[0] + 1
    return

def lend_spelling() -> usize:
    ensure result == 6
    x: mutable usize = 5
    bump(&x)
    return x

def value_spelling() -> usize:
    ensure result == 6
    x: mutable usize = 5
    x <- bump(x)
    return x

def lend_from_parameter(start: usize) -> usize:
    requires start < 100
    ensure result == start + 1
    x: mutable usize = start
    bump(&x)
    return x

def value_from_parameter(start: usize) -> usize:
    requires start < 100
    ensure result == start + 1
    x: mutable usize = start
    x <- bump(x)
    return x
