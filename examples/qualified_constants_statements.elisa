# Qualified constants in assignments, call arguments, `while` conditions and `for` ranges
# (BACKLOG B-06): each header's fact about the constant reaches the obligations it guards.
# The guarded loop's `decreases` over u8 must also prove without wrapping.

const module Limits:
    const TOP: u8 = 10

def keep(x: u8) -> u8:
    requires x <= 20
    ensure result <= 20
    return x

def assigned(x: u8) -> u8:
    requires x <= 5
    ensure result <= 15
    y: mutable u8 = x
    y <- x + Limits::TOP
    return y

def argument(x: u8) -> u8:
    requires x <= 5
    ensure result <= 20
    return keep(x + Limits::TOP)

def looped(x: u8) -> u8:
    requires x <= 5
    y: mutable u8 = x
    while y < Limits::TOP:
        invariant y <= Limits::TOP
        decreases Limits::TOP - y
        kept: u8 = keep(y + 1)
        y <- y + 1
    return y

def ranged(x: u8) -> void:
    requires x <= 5
    for i in 0..<Limits::TOP:
        kept: u8 = keep(i + x)
