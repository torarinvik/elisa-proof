# A nested call may invalidate a symbolic alias even when it changes a disjoint field.
# The kernel must forget the alias rather than reusing its pre-call expansion for the
# later sibling call.

struct Box:
    value: mutable i64
    other: mutable i64

struct Pair:
    left: i64
    right: i64

def write_other(box: mutable Box&) -> i64:
    changes box.other
    box.other <- 1
    return 0

def require_zero(box: mutable Box&) -> i64:
    requires box.value == 0
    ensure result == 0
    return 0

def nested_symbolic_value(box: mutable Box&) -> void:
    requires box.value == 0
    alias: mutable Box& = box
    pair: Pair = Pair{left: write_other(box), right: require_zero(alias)}
