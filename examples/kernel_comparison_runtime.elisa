# Exercise replay directly: source proof search must not mask a kernel bug.
include "../src/proof/kernel_core.elisa"
include "../src/proof/kernel_replay.elisa"
using ElisaProofKernelCore
using ElisaProofKernelReplay

const FALSE_REFLEXIVE_COMPARISON_ADMITTED: i64 = 1
const TRUE_REFLEXIVE_COMPARISON_REJECTED: i64 = 2
const FALSE_COMPARISON_TACTIC_ADMITTED: i64 = 3
const TRUE_COMPARISON_TACTIC_REJECTED: i64 = 4
const UNWITNESSED_REFLEXIVE_COMPARISON_ADMITTED: i64 = 5
const UNWITNESSED_REFLEXIVE_TACTIC_ADMITTED: i64 = 6

# The producer's primitive-scalar type witness. Reflexivity is only a theorem for an operand
# whose `==`/`<=`/`>=` are the language's own: for a struct operand they are a user
# `__eq__`/`__cmp__`, which is not required to be reflexive.
def scalar_witness(nodes: mutable darray[ProofKernelNode]&, children: mutable darray[usize]&, name: sview) -> usize can[Memory.Allocate, Abort.Panic]:
    callee: usize = add_node(nodes, "ident", "", 0, 0, 0, 0, 0, 0, "__elisa_primitive_scalar_type", "")
    subject: usize = add_node(nodes, "ident", "", 0, 0, 0, 0, 0, 0, name, "")
    argument: usize = add_node(nodes, "call_arg", "", subject, 0, 0, 0, 0, 0, "", "")
    start: usize = children.count
    children.push(argument)
    return add_node(nodes, "call", "", callee, 0, 0, start, 1, 0, "", "")

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    nodes: mutable darray[ProofKernelNode] = []
    children: mutable darray[usize] = []
    x: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "x", "")
    copied_x: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "x", "")
    zero: usize = add_node(&nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
    x_plus_zero: usize = add_node(&nodes, "binary", "+", x, zero, 0, 0, 0, 0, "", "")
    witness_x: usize = scalar_witness(&nodes, &children, "x")
    witnessed: darray[usize] = [witness_x]
    equivalent_operands: darray[usize] = [x, copied_x, x_plus_zero]
    false_operators: darray[sview] = ["<", ">", "!="]
    true_operators: darray[sview] = ["==", "<=", ">="]
    for left in equivalent_operands |nodes, children, x, false_operators, true_operators, witnessed|:
        for operator in false_operators |nodes, children, left, x, witnessed|:
            goal: usize = add_node(&nodes, "binary", operator, left, x, 0, 0, 0, 0, "", "")
            return FALSE_REFLEXIVE_COMPARISON_ADMITTED if proof_kernel_replay_goal_report(&nodes, &children, witnessed, goal)
            return FALSE_COMPARISON_TACTIC_ADMITTED if proof_kernel_replay_tactic_step(&nodes, &children, "decide", true, false, true, witnessed, goal, witnessed, goal, 0, false, 0, false, 0, false, "")
        for operator in true_operators |nodes, children, left, x, witnessed|:
            goal: usize = add_node(&nodes, "binary", operator, left, x, 0, 0, 0, 0, "", "")
            return TRUE_REFLEXIVE_COMPARISON_REJECTED if not proof_kernel_replay_goal_report(&nodes, &children, witnessed, goal)
            return TRUE_COMPARISON_TACTIC_REJECTED if not proof_kernel_replay_tactic_step(&nodes, &children, "decide", true, false, true, witnessed, goal, witnessed, goal, 0, false, 0, false, 0, false, "")

    # Without the witness the operand's type is unknown, so even a reflexive comparison between a
    # term and itself must be refused: `==` and the ordering operators may be user protocol
    # methods with no reflexivity guarantee.
    unwitnessed: darray[usize] = []
    for operator in true_operators |nodes, children, x, unwitnessed|:
        goal: usize = add_node(&nodes, "binary", operator, x, x, 0, 0, 0, 0, "", "")
        return UNWITNESSED_REFLEXIVE_COMPARISON_ADMITTED if proof_kernel_replay_goal_report(&nodes, &children, unwitnessed, goal)
        return UNWITNESSED_REFLEXIVE_TACTIC_ADMITTED if proof_kernel_replay_tactic_step(&nodes, &children, "decide", true, false, true, unwitnessed, goal, unwitnessed, goal, 0, false, 0, false, 0, false, "")
    return 0
