# Exercise replay directly: source proof search must not mask a kernel bug.
include "../src/proof/kernel_core.elisa"
include "../src/proof/kernel_replay.elisa"
using ElisaProofKernelCore
using ElisaProofKernelReplay

const FALSE_REFLEXIVE_COMPARISON_ADMITTED: i64 = 1
const TRUE_REFLEXIVE_COMPARISON_REJECTED: i64 = 2
const FALSE_COMPARISON_TACTIC_ADMITTED: i64 = 3
const TRUE_COMPARISON_TACTIC_REJECTED: i64 = 4
const UNWITNESSED_REFLEXIVE_COMPARISON_ADMITTED: i64 = 5
const UNWITNESSED_REFLEXIVE_TACTIC_ADMITTED: i64 = 6
const UNWITNESSED_FIELD_ADMITTED: i64 = 7
const WITNESSED_FIELD_REJECTED: i64 = 8
const MISMATCHED_FIELD_WITNESS_ADMITTED: i64 = 9
const UNWITNESSED_ELEMENT_ADMITTED: i64 = 10
const WITNESSED_ELEMENT_REJECTED: i64 = 11
const SHALLOW_ELEMENT_WITNESS_ADMITTED: i64 = 12
const DEEP_ELEMENT_WITNESS_REJECTED: i64 = 13
const UNWITNESSED_SUBSCRIPT_ADMITTED: i64 = 14
const CALL_REFLEXIVITY_ADMITTED: i64 = 15
const WITNESSED_CALL_REJECTED: i64 = 16
const UNWITNESSED_FORMER_ADMITTED: i64 = 17
const NESTED_QUANTIFIER_REJECTED: i64 = 18
const DEEP_QUANTIFIER_ADMITTED: i64 = 19

# The producer's primitive-scalar type witness. Reflexivity is only a theorem for an operand
# whose `==`/`<=`/`>=` are the language's own: for a struct operand they are a user
# `__eq__`/`__cmp__`, which is not required to be reflexive.
def scalar_witness(nodes: mutable darray[ProofKernelNode]&, children: mutable darray[usize]&, name: sview) -> usize can[Memory.Allocate, Abort.Panic]:
    callee: usize = add_node(nodes, "ident", "", 0, 0, 0, 0, 0, 0, "__elisa_primitive_scalar_type", "")
    subject: usize = add_node(nodes, "ident", "", 0, 0, 0, 0, 0, 0, name, "")
    argument: usize = add_node(nodes, "call_arg", "", subject, 0, 0, 0, 0, 0, "", "")
    start: usize = children.count
    children.push(argument)
    return add_node(nodes, "call", "", callee, 0, 0, start, 1, 0, "", "")

# A witness keyed by a term rather than a name: the producer resolved a declared type for this
# exact place or call.
def term_witness(nodes: mutable darray[ProofKernelNode]&, children: mutable darray[usize]&, term: usize) -> usize can[Memory.Allocate, Abort.Panic]:
    callee: usize = add_node(nodes, "ident", "", 0, 0, 0, 0, 0, 0, "__elisa_primitive_scalar_type", "")
    argument: usize = add_node(nodes, "call_arg", "", term, 0, 0, 0, 0, 0, "", "")
    start: usize = children.count
    children.push(argument)
    return add_node(nodes, "call", "", callee, 0, 0, start, 1, 0, "", "")

# A container whose elements are primitive scalars `depth` subscripts down.
def element_witness(nodes: mutable darray[ProofKernelNode]&, children: mutable darray[usize]&, term: usize, depth: i64) -> usize can[Memory.Allocate, Abort.Panic]:
    callee: usize = add_node(nodes, "ident", "", 0, 0, 0, 0, 0, 0, "__elisa_primitive_scalar_element", "")
    term_argument: usize = add_node(nodes, "call_arg", "", term, 0, 0, 0, 0, 0, "", "")
    depth_literal: usize = add_node(nodes, "int", "", 0, 0, 0, 0, 0, depth, "", "")
    depth_argument: usize = add_node(nodes, "call_arg", "", depth_literal, 0, 0, 0, 0, 0, "", "")
    start: usize = children.count
    children.push(term_argument)
    children.push(depth_argument)
    return add_node(nodes, "call", "", callee, 0, 0, start, 2, 0, "", "")

def equality(nodes: mutable darray[ProofKernelNode]&, left: usize, right: usize) -> usize can[Memory.Allocate, Abort.Panic]:
    return add_node(nodes, "binary", "==", left, right, 0, 0, 0, 0, "", "")

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    nodes: mutable darray[ProofKernelNode] = []
    children: mutable darray[usize] = []
    x: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "x", "")
    copied_x: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "x", "")
    zero: usize = add_node(&nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
    x_plus_zero: usize = add_node(&nodes, "binary", "+", x, zero, 0, 0, 0, 0, "", "")
    witness_x: usize = scalar_witness(&nodes, &children, "x")
    witnessed: darray[usize] = [witness_x]
    equivalent_operands: darray[usize] = [x, copied_x, x_plus_zero]
    false_operators: darray[sview] = ["<", ">", "!="]
    true_operators: darray[sview] = ["==", "<=", ">="]
    for left in equivalent_operands |nodes, children, x, false_operators, true_operators, witnessed|:
        for operator in false_operators |nodes, children, left, x, witnessed|:
            goal: usize = add_node(&nodes, "binary", operator, left, x, 0, 0, 0, 0, "", "")
            return FALSE_REFLEXIVE_COMPARISON_ADMITTED if proof_kernel_replay_goal_report(&nodes, &children, witnessed, goal)
            return FALSE_COMPARISON_TACTIC_ADMITTED if proof_kernel_replay_tactic_step(&nodes, &children, "decide", true, false, true, witnessed, goal, witnessed, goal, 0, false, 0, false, 0, false, "")
        for operator in true_operators |nodes, children, left, x, witnessed|:
            goal: usize = add_node(&nodes, "binary", operator, left, x, 0, 0, 0, 0, "", "")
            return TRUE_REFLEXIVE_COMPARISON_REJECTED if not proof_kernel_replay_goal_report(&nodes, &children, witnessed, goal)
            return TRUE_COMPARISON_TACTIC_REJECTED if not proof_kernel_replay_tactic_step(&nodes, &children, "decide", true, false, true, witnessed, goal, witnessed, goal, 0, false, 0, false, 0, false, "")

    # Without the witness the operand's type is unknown, so even a reflexive comparison between a
    # term and itself must be refused: `==` and the ordering operators may be user protocol
    # methods with no reflexivity guarantee.
    unwitnessed: darray[usize] = []
    for operator in true_operators |nodes, children, x, unwitnessed|:
        goal: usize = add_node(&nodes, "binary", operator, x, x, 0, 0, 0, 0, "", "")
        return UNWITNESSED_REFLEXIVE_COMPARISON_ADMITTED if proof_kernel_replay_goal_report(&nodes, &children, unwitnessed, goal)
        return UNWITNESSED_REFLEXIVE_TACTIC_ADMITTED if proof_kernel_replay_tactic_step(&nodes, &children, "decide", true, false, true, unwitnessed, goal, unwitnessed, goal, 0, false, 0, false, 0, false, "")

    # A field selection is witnessed only by a marker on that exact term. `h.weight == h.weight`
    # is refused with no witness, admitted with one, and still refused when the witness names a
    # different field of the same root.
    holder: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "h", "")
    weight: usize = add_node(&nodes, "field", "", holder, 0, 0, 0, 0, 0, "weight", "")
    weight_again: usize = add_node(&nodes, "field", "", holder, 0, 0, 0, 0, 0, "weight", "")
    height: usize = add_node(&nodes, "field", "", holder, 0, 0, 0, 0, 0, "height", "")
    field_goal: usize = equality(&nodes, weight, weight_again)
    return UNWITNESSED_FIELD_ADMITTED if proof_kernel_replay_goal_report(&nodes, &children, unwitnessed, field_goal)
    weight_witnessed: darray[usize] = [term_witness(&nodes, &children, weight)]
    return WITNESSED_FIELD_REJECTED if not proof_kernel_replay_goal_report(&nodes, &children, weight_witnessed, field_goal)
    height_witnessed: darray[usize] = [term_witness(&nodes, &children, height)]
    return MISMATCHED_FIELD_WITNESS_ADMITTED if proof_kernel_replay_goal_report(&nodes, &children, height_witnessed, field_goal)

    # An element is witnessed through its container's element marker, exactly as many
    # subscripts down as the marker says, and only over a witnessed subscript term.
    values: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "values", "")
    index: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "i", "")
    element: usize = add_node(&nodes, "index", "", values, index, 0, 0, 0, 0, "", "")
    element_again: usize = add_node(&nodes, "index", "", values, index, 0, 0, 0, 0, "", "")
    element_goal: usize = equality(&nodes, element, element_again)
    index_only: darray[usize] = [scalar_witness(&nodes, &children, "i")]
    return UNWITNESSED_ELEMENT_ADMITTED if proof_kernel_replay_goal_report(&nodes, &children, index_only, element_goal)
    element_witnessed: darray[usize] = [scalar_witness(&nodes, &children, "i"), element_witness(&nodes, &children, values, 1)]
    return WITNESSED_ELEMENT_REJECTED if not proof_kernel_replay_goal_report(&nodes, &children, element_witnessed, element_goal)
    container_only: darray[usize] = [element_witness(&nodes, &children, values, 1)]
    return UNWITNESSED_SUBSCRIPT_ADMITTED if proof_kernel_replay_goal_report(&nodes, &children, container_only, element_goal)
    # `grid[i][i]` over a depth-2 container: a depth-1 marker stops at `grid[i]`, an aggregate.
    grid: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "grid", "")
    row: usize = add_node(&nodes, "index", "", grid, index, 0, 0, 0, 0, "", "")
    cell: usize = add_node(&nodes, "index", "", row, index, 0, 0, 0, 0, "", "")
    row_again: usize = add_node(&nodes, "index", "", grid, index, 0, 0, 0, 0, "", "")
    cell_again: usize = add_node(&nodes, "index", "", row_again, index, 0, 0, 0, 0, "", "")
    cell_goal: usize = equality(&nodes, cell, cell_again)
    row_goal: usize = equality(&nodes, row, row_again)
    shallow: darray[usize] = [scalar_witness(&nodes, &children, "i"), element_witness(&nodes, &children, grid, 1)]
    return SHALLOW_ELEMENT_WITNESS_ADMITTED if proof_kernel_replay_goal_report(&nodes, &children, shallow, cell_goal)
    deep: darray[usize] = [scalar_witness(&nodes, &children, "i"), element_witness(&nodes, &children, grid, 2)]
    return DEEP_ELEMENT_WITNESS_REJECTED if not proof_kernel_replay_goal_report(&nodes, &children, deep, cell_goal)
    return SHALLOW_ELEMENT_WITNESS_ADMITTED if proof_kernel_replay_goal_report(&nodes, &children, deep, row_goal)

    # A call is never witnessed by shape: two occurrences of the same call text are one value only
    # when the producer certified the callee and recorded a witness for that exact call.
    callee: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "reading", "")
    call_start: usize = children.count
    children.push(add_node(&nodes, "call_arg", "", x, 0, 0, 0, 0, 0, "", ""))
    call: usize = add_node(&nodes, "call", "", callee, 0, 0, call_start, 1, 0, "", "")
    call_again_start: usize = children.count
    children.push(add_node(&nodes, "call_arg", "", x, 0, 0, 0, 0, 0, "", ""))
    call_again: usize = add_node(&nodes, "call", "", callee, 0, 0, call_again_start, 1, 0, "", "")
    call_goal: usize = equality(&nodes, call, call_again)
    return CALL_REFLEXIVITY_ADMITTED if proof_kernel_replay_goal_report(&nodes, &children, witnessed, call_goal)
    call_witnessed: darray[usize] = [witness_x, term_witness(&nodes, &children, call)]
    return WITNESSED_CALL_REJECTED if not proof_kernel_replay_goal_report(&nodes, &children, call_witnessed, call_goal)

    # A former is witnessed only through its operands: `h.weight + 1 == h.weight + 1` needs the
    # field witness, not merely the operator being primitive.
    one: usize = add_node(&nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
    sum: usize = add_node(&nodes, "binary", "+", weight, one, 0, 0, 0, 0, "", "")
    sum_again: usize = add_node(&nodes, "binary", "+", weight_again, one, 0, 0, 0, 0, "", "")
    former_goal: usize = equality(&nodes, sum, sum_again)
    return UNWITNESSED_FORMER_ADMITTED if proof_kernel_replay_goal_report(&nodes, &children, unwitnessed, former_goal)
    return WITNESSED_FIELD_REJECTED if not proof_kernel_replay_goal_report(&nodes, &children, weight_witnessed, former_goal)

    # Quantifier replay must carry the goal-depth ranking through every nested body. A small
    # finite nest is valid; a deeper one is refused once the explicit kernel term budget is
    # exhausted instead of resetting the ranking at each quantifier boundary.
    quantifier_value: usize = add_node(&nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
    quantifier_range_start: usize = children.count
    children.push(quantifier_value)
    quantifier_range: usize = add_node(&nodes, "array", "", 0, 0, 0, quantifier_range_start, 1, 0, "", "")
    nested_body: mutable usize = add_node(&nodes, "bool", "", 0, 0, 0, 0, 0, 1, "", "")
    for nesting in 0..<2 |nesting, nodes, nested_body, quantifier_range|:
        nested_body <- add_node(&nodes, "quantifier", "forall", quantifier_range, nested_body, 1, 0, 0, 0, "i", "")
    return NESTED_QUANTIFIER_REJECTED if not proof_kernel_replay_quantifier_report(&nodes, &children, "forall", [], nested_body)
    for nesting in 0..<128 |nesting, nodes, nested_body, quantifier_range|:
        nested_body <- add_node(&nodes, "quantifier", "forall", quantifier_range, nested_body, 1, 0, 0, 0, "i", "")
    return DEEP_QUANTIFIER_ADMITTED if proof_kernel_replay_quantifier_report(&nodes, &children, "forall", [], nested_body)
    return 0
