# The refusal itself, pinned. A call inside a larger value expression has no statement boundary the
# checker can model it at, so it is refused, and the refusal reaches every statement after it.

extend RejectedNestedCallValue:
    def emit(store: mutable darray[usize]&, value: usize) -> usize:
        store.push(value)
        return store.count

    def needs_bound(limit: usize) -> usize:
        requires limit <= 127
        return limit

    def a_call_nested_in_a_tuple_is_refused(store: mutable darray[usize]&, value: usize) -> (changed: bool, value: usize):
        return (true, emit(store, value))

    def the_refusal_reaches_past_the_statement(store: mutable darray[usize]&, value: usize, limit: usize) -> usize:
        requires limit <= 127
        pair: (changed: bool, value: usize) = (true, emit(store, value))
        return needs_bound(limit)
