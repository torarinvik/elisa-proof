module WbRuntime:
    public:
        const WB_PROOF_SCOPE: u8 = 0

extend WbRuntime:
    public:
        def output_zero_survives_widening(value: u32, out: mutable u32&) -> u8:
            ensure result != 0 or out[0] == 0
            out[0] <- 0
            widened: u64 = value.u64()
            return 0
