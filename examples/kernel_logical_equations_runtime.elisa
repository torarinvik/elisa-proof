include "../src/proof/kernel_core.elisa"
include "../src/proof/kernel_replay.elisa"
using ElisaProofKernelCore
using ElisaProofKernelReplay

extend ElisaProofKernelReplay:
    public:
        def logical_equation_controls() -> i32 can[Memory.Allocate, Abort.Panic]:
            nodes: mutable darray[ProofKernelNode] = []
            children: mutable darray[usize] = []
            facts: darray[usize] = []
            yes = add_node(&nodes, "bool", "", 0, 0, 0, 0, 0, 1, "", "")
            no = add_node(&nodes, "bool", "", 0, 0, 0, 0, 0, 0, "", "")
            both = add_node(&nodes, "binary", "and", yes, yes, 0, 0, 0, 0, "", "")
            equal = add_node(&nodes, "binary", "==", both, yes, 0, 0, 0, 0, "", "")
            plan = proof_kernel_replay_comparison_boolean_equation_plan(&nodes, &children, facts, equal)
            return 1 if not plan.known or nodes[plan.goal].kind != "bool" or nodes[plan.goal].value != 1
            false_equal = add_node(&nodes, "binary", "==", both, no, 0, 0, 0, 0, "", "")
            negative = proof_kernel_replay_comparison_boolean_equation_plan(&nodes, &children, facts, false_equal)
            return 2 if not negative.known or nodes[negative.goal].kind != "bool" or nodes[negative.goal].value != 0
            return 3 if not proof_kernel_replay_goal_report(&nodes, &children, facts, equal)
            return 4 if proof_kernel_replay_goal_report(&nodes, &children, facts, false_equal)
            mirrored = add_node(&nodes, "binary", "!=", no, both, 0, 0, 0, 0, "", "")
            mirror_plan = proof_kernel_replay_comparison_boolean_equation_plan(&nodes, &children, facts, mirrored)
            return 5 if not mirror_plan.known or nodes[mirror_plan.goal].kind != "bool" or nodes[mirror_plan.goal].value != 1
            integer = add_node(&nodes, "int", "", 0, 0, 0, 0, 0, 42, "", "")
            malformed = add_node(&nodes, "binary", "or", yes, integer, 0, 0, 0, 0, "", "")
            malformed_equal = add_node(&nodes, "binary", "==", malformed, yes, 0, 0, 0, 0, "", "")
            return 6 if proof_kernel_replay_comparison_boolean_equation_plan(&nodes, &children, facts, malformed_equal).known
            opaque = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "opaque", "")
            unwitnessed = add_node(&nodes, "binary", "and", yes, opaque, 0, 0, 0, 0, "", "")
            unwitnessed_equal = add_node(&nodes, "binary", "==", unwitnessed, yes, 0, 0, 0, 0, "", "")
            return 7 if proof_kernel_replay_comparison_boolean_equation_plan(&nodes, &children, facts, unwitnessed_equal).known
            invalid_literal = add_node(&nodes, "bool", "", 0, 0, 0, 0, 0, 2, "", "")
            invalid_equal = add_node(&nodes, "binary", "==", both, invalid_literal, 0, 0, 0, 0, "", "")
            return 8 if proof_kernel_replay_comparison_boolean_equation_plan(&nodes, &children, facts, invalid_equal).known
            invalid_child = add_node(&nodes, "unary", "not", nodes.count + 100, 0, 0, 0, 0, 0, "", "")
            invalid_child_equal = add_node(&nodes, "binary", "==", invalid_child, yes, 0, 0, 0, 0, "", "")
            return 9 if proof_kernel_replay_comparison_boolean_equation_plan(&nodes, &children, facts, invalid_child_equal).known
            return 10 if proof_kernel_replay_comparison_boolean_equation_plan(&nodes, &children, facts, nodes.count).known
            cycle = add_node(&nodes, "unary", "not", nodes.count, 0, 0, 0, 0, 0, "", "")
            cycle_equal = add_node(&nodes, "binary", "==", cycle, yes, 0, 0, 0, 0, "", "")
            return 11 if proof_kernel_replay_comparison_boolean_equation_plan(&nodes, &children, facts, cycle_equal).known
            callee = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "__elisa_primitive_scalar_type", "")
            argument = add_node(&nodes, "call_arg", "", opaque, 0, 0, 0, 0, 0, "", "")
            start: usize = children.count
            children.push(argument)
            witness = add_node(&nodes, "call", "", callee, 0, 0, start, 1, 0, "", "")
            typed: darray[usize] = [witness]
            never = add_node(&nodes, "unary", "not", yes, 0, 0, 0, 0, 0, "", "")
            blocked = add_node(&nodes, "binary", "and", opaque, never, 0, 0, 0, 0, "", "")
            blocked_equal = add_node(&nodes, "binary", "==", blocked, no, 0, 0, 0, 0, "", "")
            blocked_false = add_node(&nodes, "binary", "==", blocked, yes, 0, 0, 0, 0, "", "")
            return 12 if not proof_kernel_replay_goal_report(&nodes, &children, typed, blocked_equal)
            return 13 if proof_kernel_replay_goal_report(&nodes, &children, typed, blocked_false)
            return 14 if proof_kernel_replay_comparison_boolean_equation_plan(&nodes, &children, facts, blocked_equal).known
            return 15 if proof_kernel_replay_logical_constant_value(&nodes, opaque).known
            return 16 if proof_kernel_replay_goal_report(&nodes, &children, facts, malformed_equal)
            return 17 if proof_kernel_replay_goal_report(&nodes, &children, facts, blocked_equal)
            peer = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "peer", "")
            peer_argument = add_node(&nodes, "call_arg", "", peer, 0, 0, 0, 0, 0, "", "")
            peer_start: usize = children.count
            children.push(peer_argument)
            peer_witness = add_node(&nodes, "call", "", callee, 0, 0, peer_start, 1, 0, "", "")
            both_typed: darray[usize] = [witness, peer_witness]
            ordered = add_node(&nodes, "binary", "and", opaque, peer, 0, 0, 0, 0, "", "")
            reversed = add_node(&nodes, "binary", "and", peer, opaque, 0, 0, 0, 0, "", "")
            commutative = add_node(&nodes, "binary", "==", ordered, reversed, 0, 0, 0, 0, "", "")
            return 18 if not proof_kernel_replay_logical_join_identity(&nodes, &children, both_typed, commutative)
            return 19 if proof_kernel_replay_logical_join_identity(&nodes, &children, typed, commutative)
            duplicate = add_node(&nodes, "binary", "and", opaque, opaque, 0, 0, 0, 0, "", "")
            idempotent = add_node(&nodes, "binary", "==", duplicate, opaque, 0, 0, 0, 0, "", "")
            return 20 if not proof_kernel_replay_logical_join_identity(&nodes, &children, typed, idempotent)
            identity = add_node(&nodes, "binary", "or", opaque, no, 0, 0, 0, 0, "", "")
            identity_equal = add_node(&nodes, "binary", "==", identity, opaque, 0, 0, 0, 0, "", "")
            return 21 if not proof_kernel_replay_logical_join_identity(&nodes, &children, typed, identity_equal)
            mixed = add_node(&nodes, "binary", "or", opaque, peer, 0, 0, 0, 0, "", "")
            mixed_equal = add_node(&nodes, "binary", "==", ordered, mixed, 0, 0, 0, 0, "", "")
            return 22 if proof_kernel_replay_logical_join_identity(&nodes, &children, both_typed, mixed_equal)
            missing_atom = add_node(&nodes, "binary", "==", ordered, opaque, 0, 0, 0, 0, "", "")
            return 23 if proof_kernel_replay_logical_join_identity(&nodes, &children, both_typed, missing_atom)
            repeated: mutable usize = opaque
            for index in 0..<8 |repeated, nodes|:
                repeated <- add_node(&nodes, "binary", "and", repeated, repeated, 0, 0, 0, 0, "", "")
            oversized = add_node(&nodes, "binary", "==", repeated, opaque, 0, 0, 0, 0, "", "")
            return 24 if proof_kernel_replay_logical_join_identity(&nodes, &children, typed, oversized)
            parenthesized = add_node(&nodes, "paren", "", duplicate, 0, 0, 0, 0, 0, "", "")
            paren_equal = add_node(&nodes, "binary", "==", parenthesized, opaque, 0, 0, 0, 0, "", "")
            # Source parentheses are erased by kernel encoding; a fabricated raw
            # paren arena node is not an admitted serialized shape.
            return 25 if proof_kernel_replay_logical_join_identity(&nodes, &children, typed, paren_equal)
            same = add_node(&nodes, "binary", "==", opaque, peer, 0, 0, 0, 0, "", "")
            distinct = add_node(&nodes, "binary", "!=", opaque, peer, 0, 0, 0, 0, "", "")
            context: darray[usize] = [witness, peer_witness, distinct]
            same_and_true = add_node(&nodes, "binary", "and", yes, same, 0, 0, 0, 0, "", "")
            must_be_false = add_node(&nodes, "binary", "==", same_and_true, no, 0, 0, 0, 0, "", "")
            must_not_be_true = add_node(&nodes, "binary", "==", same_and_true, yes, 0, 0, 0, 0, "", "")
            return 26 if not proof_kernel_replay_goal_report(&nodes, &children, context, must_be_false)
            return 27 if proof_kernel_replay_goal_report(&nodes, &children, context, must_not_be_true)
            # A well-formed equation may normalize without being provable.
            return 28 if proof_kernel_replay_goal_report(&nodes, &children, both_typed, must_be_false)
            untyped_context: darray[usize] = [distinct]
            return 29 if proof_kernel_replay_comparison_boolean_equation_plan(&nodes, &children, untyped_context, must_be_false).known
            true_or_peer = add_node(&nodes, "binary", "or", distinct, peer, 0, 0, 0, 0, "", "")
            must_be_true = add_node(&nodes, "binary", "==", true_or_peer, yes, 0, 0, 0, 0, "", "")
            return 30 if not proof_kernel_replay_goal_report(&nodes, &children, context, must_be_true)
            fuel: mutable usize = 0
            return 31 if proof_kernel_replay_logical_context_value(&nodes, &children, context, same_and_true, fuel).known
            malformed_context = add_node(&nodes, "binary", "and", same, integer, 0, 0, 0, 0, "", "")
            malformed_context_false = add_node(&nodes, "binary", "==", malformed_context, no, 0, 0, 0, 0, "", "")
            return 32 if proof_kernel_replay_comparison_boolean_equation_plan(&nodes, &children, context, malformed_context_false).known
            live_entry = add_node(&nodes, "binary", "and", yes, opaque, 0, 0, 0, 0, "", "")
            dead_back = add_node(&nodes, "binary", "and", no, peer, 0, 0, 0, 0, "", "")
            loop_possible = add_node(&nodes, "binary", "or", live_entry, dead_back, 0, 0, 0, 0, "", "")
            loop_equal = add_node(&nodes, "binary", "==", loop_possible, opaque, 0, 0, 0, 0, "", "")
            return 33 if not proof_kernel_replay_logical_join_identity(&nodes, &children, both_typed, loop_equal)
            return 34 if proof_kernel_replay_logical_join_identity(&nodes, &children, typed, loop_equal)
            wrong_loop_equal = add_node(&nodes, "binary", "==", loop_possible, peer, 0, 0, 0, 0, "", "")
            return 35 if proof_kernel_replay_logical_join_identity(&nodes, &children, both_typed, wrong_loop_equal)
            malformed_dead = add_node(&nodes, "binary", "and", no, integer, 0, 0, 0, 0, "", "")
            malformed_absorption = add_node(&nodes, "binary", "==", malformed_dead, no, 0, 0, 0, 0, "", "")
            return 36 if proof_kernel_replay_logical_join_identity(&nodes, &children, both_typed, malformed_absorption)
            not_yes = add_node(&nodes, "unary", "not", yes, 0, 0, 0, 0, 0, "", "")
            not_no = add_node(&nodes, "unary", "not", no, 0, 0, 0, 0, 0, "", "")
            left_knowledge = add_node(&nodes, "binary", "or", not_yes, opaque, 0, 0, 0, 0, "", "")
            right_knowledge = add_node(&nodes, "binary", "or", not_no, peer, 0, 0, 0, 0, "", "")
            loop_knowledge = add_node(&nodes, "binary", "and", left_knowledge, right_knowledge, 0, 0, 0, 0, "", "")
            knowledge_equal = add_node(&nodes, "binary", "==", loop_knowledge, opaque, 0, 0, 0, 0, "", "")
            return 37 if not proof_kernel_replay_logical_join_identity(&nodes, &children, both_typed, knowledge_equal)
            exhausted: mutable usize = 0
            return 38 if proof_kernel_replay_logical_constant(&nodes, &children, both_typed, loop_knowledge, exhausted).valid
            cyclic_absorption = add_node(&nodes, "binary", "and", no, cycle, 0, 0, 0, 0, "", "")
            cyclic_equal = add_node(&nodes, "binary", "==", cyclic_absorption, no, 0, 0, 0, 0, "", "")
            return 39 if proof_kernel_replay_logical_join_identity(&nodes, &children, both_typed, cyclic_equal)
            invalid_absorption = add_node(&nodes, "binary", "or", yes, invalid_literal, 0, 0, 0, 0, "", "")
            invalid_absorption_equal = add_node(&nodes, "binary", "==", invalid_absorption, yes, 0, 0, 0, 0, "", "")
            return 40 if proof_kernel_replay_logical_join_identity(&nodes, &children, both_typed, invalid_absorption_equal)
            not_opaque = add_node(&nodes, "unary", "not", opaque, 0, 0, 0, 0, 0, "", "")
            not_peer = add_node(&nodes, "unary", "not", peer, 0, 0, 0, 0, 0, "", "")
            not_union = add_node(&nodes, "unary", "not", mixed, 0, 0, 0, 0, 0, "", "")
            negated_meet = add_node(&nodes, "binary", "and", not_peer, not_opaque, 0, 0, 0, 0, "", "")
            demorgan_meet = add_node(&nodes, "binary", "==", not_union, negated_meet, 0, 0, 0, 0, "", "")
            return 41 if not proof_kernel_replay_logical_join_identity(&nodes, &children, both_typed, demorgan_meet)
            return 42 if proof_kernel_replay_logical_join_identity(&nodes, &children, typed, demorgan_meet)
            negated_join = add_node(&nodes, "binary", "or", not_opaque, not_peer, 0, 0, 0, 0, "", "")
            not_meet = add_node(&nodes, "unary", "not", ordered, 0, 0, 0, 0, 0, "", "")
            demorgan_join = add_node(&nodes, "binary", "==", negated_join, not_meet, 0, 0, 0, 0, "", "")
            return 43 if not proof_kernel_replay_logical_join_identity(&nodes, &children, both_typed, demorgan_join)
            wrong_dual = add_node(&nodes, "binary", "==", not_union, negated_join, 0, 0, 0, 0, "", "")
            return 44 if proof_kernel_replay_logical_join_identity(&nodes, &children, both_typed, wrong_dual)
            double_not = add_node(&nodes, "unary", "not", not_opaque, 0, 0, 0, 0, 0, "", "")
            double_equal = add_node(&nodes, "binary", "==", opaque, double_not, 0, 0, 0, 0, "", "")
            return 45 if not proof_kernel_replay_logical_join_identity(&nodes, &children, typed, double_equal)
            wrong_polarity = add_node(&nodes, "binary", "==", opaque, not_opaque, 0, 0, 0, 0, "", "")
            return 46 if proof_kernel_replay_logical_join_identity(&nodes, &children, typed, wrong_polarity)
            bad_negated = add_node(&nodes, "unary", "not", invalid_absorption, 0, 0, 0, 0, 0, "", "")
            bad_negated_equal = add_node(&nodes, "binary", "==", bad_negated, no, 0, 0, 0, 0, "", "")
            return 47 if proof_kernel_replay_logical_join_identity(&nodes, &children, both_typed, bad_negated_equal)
            cyclic_negated = add_node(&nodes, "unary", "not", cyclic_absorption, 0, 0, 0, 0, 0, "", "")
            cyclic_negated_equal = add_node(&nodes, "binary", "==", cyclic_negated, yes, 0, 0, 0, 0, "", "")
            return 48 if proof_kernel_replay_logical_join_identity(&nodes, &children, both_typed, cyclic_negated_equal)
            signed_atoms: mutable darray[ProofKernelLogicalSignedAtom] = []
            empty_fuel: mutable usize = 0
            return 49 if proof_kernel_logical_signed_atoms(&nodes, &children, both_typed, not_union, "and", false, signed_atoms, empty_fuel)
            limited_fuel: mutable usize = 1024
            return 50 if proof_kernel_logical_signed_atoms(&nodes, &children, both_typed, not_union, "and", false, signed_atoms, limited_fuel, 64)
            compared_join = add_node(&nodes, "binary", "and", same, opaque, 0, 0, 0, 0, "", "")
            compared_reversed = add_node(&nodes, "binary", "and", opaque, same, 0, 0, 0, 0, "", "")
            compared_equal = add_node(&nodes, "binary", "==", compared_join, compared_reversed, 0, 0, 0, 0, "", "")
            return 51 if not proof_kernel_replay_logical_join_identity(&nodes, &children, both_typed, compared_equal)
            return 52 if proof_kernel_replay_logical_join_identity(&nodes, &children, facts, compared_equal)
            bad_comparison = add_node(&nodes, "binary", "==", invalid_literal, yes, 0, 0, 0, 0, "", "")
            return 53 if proof_kernel_logical_comparison_atom(&nodes, &children, facts, bad_comparison)
            cyclic_comparison = add_node(&nodes, "binary", "==", nodes.count, integer, 0, 0, 0, 0, "", "")
            return 54 if proof_kernel_logical_comparison_atom(&nodes, &children, facts, cyclic_comparison)
            arithmetic_operand = add_node(&nodes, "binary", "+", integer, integer, 0, 0, 0, 0, "", "")
            arithmetic_comparison = add_node(&nodes, "binary", "==", arithmetic_operand, integer, 0, 0, 0, 0, "", "")
            return 55 if proof_kernel_logical_comparison_atom(&nodes, &children, facts, arithmetic_comparison)
            return 0

def main() -> i32 can[Memory.Allocate, Abort.Panic]:
    return logical_equation_controls()
