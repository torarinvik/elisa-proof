include "../src/proof/kernel_core.elisa"
include "../src/proof/kernel_replay.elisa"
using ElisaProofKernelCore
using ElisaProofKernelReplay

extend ElisaProofKernelReplay:
    public:
        def logical_equation_controls() -> i32 can[Memory.Allocate, Abort.Panic]:
            nodes: mutable darray[ProofKernelNode] = []
            children: mutable darray[usize] = []
            facts: darray[usize] = []
            yes = add_node(&nodes, "bool", "", 0, 0, 0, 0, 0, 1, "", "")
            no = add_node(&nodes, "bool", "", 0, 0, 0, 0, 0, 0, "", "")
            both = add_node(&nodes, "binary", "and", yes, yes, 0, 0, 0, 0, "", "")
            equal = add_node(&nodes, "binary", "==", both, yes, 0, 0, 0, 0, "", "")
            plan = proof_kernel_replay_comparison_boolean_equation_plan(&nodes, &children, facts, equal)
            return 1 if not plan.known or nodes[plan.goal].kind != "bool" or nodes[plan.goal].value != 1
            false_equal = add_node(&nodes, "binary", "==", both, no, 0, 0, 0, 0, "", "")
            negative = proof_kernel_replay_comparison_boolean_equation_plan(&nodes, &children, facts, false_equal)
            return 2 if not negative.known or nodes[negative.goal].kind != "bool" or nodes[negative.goal].value != 0
            return 3 if not proof_kernel_replay_goal_report(&nodes, &children, facts, equal)
            return 4 if proof_kernel_replay_goal_report(&nodes, &children, facts, false_equal)
            mirrored = add_node(&nodes, "binary", "!=", no, both, 0, 0, 0, 0, "", "")
            mirror_plan = proof_kernel_replay_comparison_boolean_equation_plan(&nodes, &children, facts, mirrored)
            return 5 if not mirror_plan.known or nodes[mirror_plan.goal].kind != "bool" or nodes[mirror_plan.goal].value != 1
            integer = add_node(&nodes, "int", "", 0, 0, 0, 0, 0, 42, "", "")
            malformed = add_node(&nodes, "binary", "or", yes, integer, 0, 0, 0, 0, "", "")
            malformed_equal = add_node(&nodes, "binary", "==", malformed, yes, 0, 0, 0, 0, "", "")
            return 6 if proof_kernel_replay_comparison_boolean_equation_plan(&nodes, &children, facts, malformed_equal).known
            opaque = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "opaque", "")
            unwitnessed = add_node(&nodes, "binary", "and", yes, opaque, 0, 0, 0, 0, "", "")
            unwitnessed_equal = add_node(&nodes, "binary", "==", unwitnessed, yes, 0, 0, 0, 0, "", "")
            return 7 if proof_kernel_replay_comparison_boolean_equation_plan(&nodes, &children, facts, unwitnessed_equal).known
            invalid_literal = add_node(&nodes, "bool", "", 0, 0, 0, 0, 0, 2, "", "")
            invalid_equal = add_node(&nodes, "binary", "==", both, invalid_literal, 0, 0, 0, 0, "", "")
            return 8 if proof_kernel_replay_comparison_boolean_equation_plan(&nodes, &children, facts, invalid_equal).known
            invalid_child = add_node(&nodes, "unary", "not", nodes.count + 100, 0, 0, 0, 0, 0, "", "")
            invalid_child_equal = add_node(&nodes, "binary", "==", invalid_child, yes, 0, 0, 0, 0, "", "")
            return 9 if proof_kernel_replay_comparison_boolean_equation_plan(&nodes, &children, facts, invalid_child_equal).known
            return 10 if proof_kernel_replay_comparison_boolean_equation_plan(&nodes, &children, facts, nodes.count).known
            cycle = add_node(&nodes, "unary", "not", nodes.count, 0, 0, 0, 0, 0, "", "")
            cycle_equal = add_node(&nodes, "binary", "==", cycle, yes, 0, 0, 0, 0, "", "")
            return 11 if proof_kernel_replay_comparison_boolean_equation_plan(&nodes, &children, facts, cycle_equal).known
            callee = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "__elisa_primitive_scalar_type", "")
            argument = add_node(&nodes, "call_arg", "", opaque, 0, 0, 0, 0, 0, "", "")
            start: usize = children.count
            children.push(argument)
            witness = add_node(&nodes, "call", "", callee, 0, 0, start, 1, 0, "", "")
            typed: darray[usize] = [witness]
            never = add_node(&nodes, "unary", "not", yes, 0, 0, 0, 0, 0, "", "")
            blocked = add_node(&nodes, "binary", "and", opaque, never, 0, 0, 0, 0, "", "")
            blocked_equal = add_node(&nodes, "binary", "==", blocked, no, 0, 0, 0, 0, "", "")
            blocked_false = add_node(&nodes, "binary", "==", blocked, yes, 0, 0, 0, 0, "", "")
            return 12 if not proof_kernel_replay_goal_report(&nodes, &children, typed, blocked_equal)
            return 13 if proof_kernel_replay_goal_report(&nodes, &children, typed, blocked_false)
            return 14 if proof_kernel_replay_comparison_boolean_equation_plan(&nodes, &children, facts, blocked_equal).known
            return 15 if proof_kernel_replay_logical_constant_value(&nodes, opaque).known
            return 16 if proof_kernel_replay_goal_report(&nodes, &children, facts, malformed_equal)
            return 17 if proof_kernel_replay_goal_report(&nodes, &children, facts, blocked_equal)
            peer = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "peer", "")
            peer_argument = add_node(&nodes, "call_arg", "", peer, 0, 0, 0, 0, 0, "", "")
            peer_start: usize = children.count
            children.push(peer_argument)
            peer_witness = add_node(&nodes, "call", "", callee, 0, 0, peer_start, 1, 0, "", "")
            both_typed: darray[usize] = [witness, peer_witness]
            ordered = add_node(&nodes, "binary", "and", opaque, peer, 0, 0, 0, 0, "", "")
            reversed = add_node(&nodes, "binary", "and", peer, opaque, 0, 0, 0, 0, "", "")
            commutative = add_node(&nodes, "binary", "==", ordered, reversed, 0, 0, 0, 0, "", "")
            return 18 if not proof_kernel_replay_logical_join_identity(&nodes, &children, both_typed, commutative)
            return 19 if proof_kernel_replay_logical_join_identity(&nodes, &children, typed, commutative)
            duplicate = add_node(&nodes, "binary", "and", opaque, opaque, 0, 0, 0, 0, "", "")
            idempotent = add_node(&nodes, "binary", "==", duplicate, opaque, 0, 0, 0, 0, "", "")
            return 20 if not proof_kernel_replay_logical_join_identity(&nodes, &children, typed, idempotent)
            identity = add_node(&nodes, "binary", "or", opaque, no, 0, 0, 0, 0, "", "")
            identity_equal = add_node(&nodes, "binary", "==", identity, opaque, 0, 0, 0, 0, "", "")
            return 21 if not proof_kernel_replay_logical_join_identity(&nodes, &children, typed, identity_equal)
            mixed = add_node(&nodes, "binary", "or", opaque, peer, 0, 0, 0, 0, "", "")
            mixed_equal = add_node(&nodes, "binary", "==", ordered, mixed, 0, 0, 0, 0, "", "")
            return 22 if proof_kernel_replay_logical_join_identity(&nodes, &children, both_typed, mixed_equal)
            missing_atom = add_node(&nodes, "binary", "==", ordered, opaque, 0, 0, 0, 0, "", "")
            return 23 if proof_kernel_replay_logical_join_identity(&nodes, &children, both_typed, missing_atom)
            repeated: mutable usize = opaque
            for index in 0..<8 |repeated, nodes|:
                repeated <- add_node(&nodes, "binary", "and", repeated, repeated, 0, 0, 0, 0, "", "")
            oversized = add_node(&nodes, "binary", "==", repeated, opaque, 0, 0, 0, 0, "", "")
            return 24 if proof_kernel_replay_logical_join_identity(&nodes, &children, typed, oversized)
            parenthesized = add_node(&nodes, "paren", "", duplicate, 0, 0, 0, 0, 0, "", "")
            paren_equal = add_node(&nodes, "binary", "==", parenthesized, opaque, 0, 0, 0, 0, "", "")
            # Source parentheses are erased by kernel encoding; a fabricated raw
            # paren arena node is not an admitted serialized shape.
            return 25 if proof_kernel_replay_logical_join_identity(&nodes, &children, typed, paren_equal)
            return 0

def main() -> i32 can[Memory.Allocate, Abort.Panic]:
    return logical_equation_controls()
