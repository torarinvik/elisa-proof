include "../src/proof/kernel_core.elisa"
include "../src/proof/kernel_replay.elisa"
using ElisaProofKernelCore
using ElisaProofKernelReplay

extend ElisaProofKernelReplay:
    public:
        def logical_equation_controls() -> i32 can[Memory.Allocate, Abort.Panic]:
            nodes: mutable darray[ProofKernelNode] = []
            children: mutable darray[usize] = []
            facts: darray[usize] = []
            yes = add_node(&nodes, "bool", "", 0, 0, 0, 0, 0, 1, "", "")
            no = add_node(&nodes, "bool", "", 0, 0, 0, 0, 0, 0, "", "")
            both = add_node(&nodes, "binary", "and", yes, yes, 0, 0, 0, 0, "", "")
            equal = add_node(&nodes, "binary", "==", both, yes, 0, 0, 0, 0, "", "")
            plan = proof_kernel_replay_comparison_boolean_equation_plan(&nodes, &children, facts, equal)
            return 1 if not plan.known or plan.goal != both
            false_equal = add_node(&nodes, "binary", "==", both, no, 0, 0, 0, 0, "", "")
            negative = proof_kernel_replay_comparison_boolean_equation_plan(&nodes, &children, facts, false_equal)
            return 2 if not negative.known or nodes[negative.goal].kind != "unary" or nodes[negative.goal].operator != "not" or nodes[negative.goal].left != both
            return 3 if not proof_kernel_replay_goal_report(&nodes, &children, facts, equal)
            return 4 if proof_kernel_replay_goal_report(&nodes, &children, facts, false_equal)
            mirrored = add_node(&nodes, "binary", "!=", no, both, 0, 0, 0, 0, "", "")
            mirror_plan = proof_kernel_replay_comparison_boolean_equation_plan(&nodes, &children, facts, mirrored)
            return 5 if not mirror_plan.known or mirror_plan.goal != both
            integer = add_node(&nodes, "int", "", 0, 0, 0, 0, 0, 42, "", "")
            malformed = add_node(&nodes, "binary", "or", yes, integer, 0, 0, 0, 0, "", "")
            malformed_equal = add_node(&nodes, "binary", "==", malformed, yes, 0, 0, 0, 0, "", "")
            return 6 if proof_kernel_replay_comparison_boolean_equation_plan(&nodes, &children, facts, malformed_equal).known
            opaque = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "opaque", "")
            unwitnessed = add_node(&nodes, "binary", "and", yes, opaque, 0, 0, 0, 0, "", "")
            unwitnessed_equal = add_node(&nodes, "binary", "==", unwitnessed, yes, 0, 0, 0, 0, "", "")
            return 7 if proof_kernel_replay_comparison_boolean_equation_plan(&nodes, &children, facts, unwitnessed_equal).known
            invalid_literal = add_node(&nodes, "bool", "", 0, 0, 0, 0, 0, 2, "", "")
            invalid_equal = add_node(&nodes, "binary", "==", both, invalid_literal, 0, 0, 0, 0, "", "")
            return 8 if proof_kernel_replay_comparison_boolean_equation_plan(&nodes, &children, facts, invalid_equal).known
            invalid_child = add_node(&nodes, "unary", "not", nodes.count + 100, 0, 0, 0, 0, 0, "", "")
            invalid_child_equal = add_node(&nodes, "binary", "==", invalid_child, yes, 0, 0, 0, 0, "", "")
            return 9 if proof_kernel_replay_comparison_boolean_equation_plan(&nodes, &children, facts, invalid_child_equal).known
            return 10 if proof_kernel_replay_comparison_boolean_equation_plan(&nodes, &children, facts, nodes.count).known
            cycle = add_node(&nodes, "unary", "not", nodes.count, 0, 0, 0, 0, 0, "", "")
            cycle_equal = add_node(&nodes, "binary", "==", cycle, yes, 0, 0, 0, 0, "", "")
            return 11 if proof_kernel_replay_comparison_boolean_equation_plan(&nodes, &children, facts, cycle_equal).known
            return 0

def main() -> i32 can[Memory.Allocate, Abort.Panic]:
    return logical_equation_controls()
