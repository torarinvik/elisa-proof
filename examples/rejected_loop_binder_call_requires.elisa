# Each call passes a slot the loop does not bound below CAP.
module Pick:
    public:
        const CAP: usize = 4

        struct Pool:
            rank: u32[Pick::CAP]

        def better(pool: Pool&, slot: usize, best: usize) -> bool:
            requires slot < CAP
            return true if best >= CAP
            pool.rank[slot] > pool.rank[best]

        # The range runs one past the last slot.
        def one_past(pool: Pool&) -> usize:
            for slot in 0..<CAP + 1 |best: usize = CAP| -> best:
                best <- slot if better(pool, slot, best)

        # The binder is bounded, its successor is not.
        def successor(pool: Pool&) -> usize:
            for slot in 0..<CAP |best: usize = CAP| -> best:
                good: bool = better(pool, slot + 1, best)
                best <- slot if good
