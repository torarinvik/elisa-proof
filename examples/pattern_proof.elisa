# Match patterns contribute checked branch facts and definitional field projections.

struct Pair:
    left: i64
    right: i64

enum Option:
    None
    Some(value: i64)

def destructure_pair(pair: Pair) -> i64:
    ensure result == pair.left
    match pair:
        Pair{left: value, right: _}:
            assert value == pair.left
    return pair.left

def prove_variant_tag(option: Option) -> bool:
    match option:
        Option.Some(value: _):
            assert option is Option.Some by:
                assert option is Option.Some
            return true
        Option.None:
            return true

def prove_literal_pattern(x: i64) -> i64:
    ensure result >= 0
    match x:
        0:
            assert x == 0 by:
                assert x == 0
            return 0
        _:
            return 1

def prove_range_pattern(x: i64) -> i64:
    ensure result >= 0
    match x:
        0..=10:
            assert x >= 0 by:
                assert x >= 0
            return 0
        _:
            return 1
