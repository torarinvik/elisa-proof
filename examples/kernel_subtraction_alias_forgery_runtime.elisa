# Exercise the subtraction-alias replay rule directly. These calls intentionally bypass source
# proof search so malformed or forged arena nodes cannot be hidden by another replay tier.
include "../src/proof/kernel_core.elisa"
include "../src/proof/kernel_replay.elisa"
using ElisaProofKernelCore
using ElisaProofKernelReplay

extend ElisaProofKernelReplay:
    public:
        def subtraction_alias_probe(nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode]&, children: mutable darray[usize]&, facts: darray[usize], goal: usize) -> (known: bool, rewritten: usize):
            return proof_kernel_replay_subtraction_alias_plan(nodes, children, facts, goal)

def scalar_witness(nodes: mutable darray[ProofKernelNode]&, children: mutable darray[usize]&, name: sview) -> usize can[Memory.Allocate, Abort.Panic]:
    callee: usize = add_node(nodes, "ident", "", 0, 0, 0, 0, 0, 0, "__elisa_primitive_scalar_type", "")
    subject: usize = add_node(nodes, "ident", "", 0, 0, 0, 0, 0, 0, name, "")
    argument: usize = add_node(nodes, "call_arg", "", subject, 0, 0, 0, 0, 0, "", "")
    start: usize = children.count
    children.push(argument)
    return add_node(nodes, "call", "", callee, 0, 0, start, 1, 0, "", "")

def unsigned_witness(nodes: mutable darray[ProofKernelNode]&, children: mutable darray[usize]&, name: sview, width: usize) -> (marker: usize, width_node: usize) can[Memory.Allocate, Abort.Panic]:
    callee: usize = add_node(nodes, "ident", "", 0, 0, 0, 0, 0, 0, "__elisa_unsigned_type_bound", "")
    subject: usize = add_node(nodes, "ident", "", 0, 0, 0, 0, 0, 0, name, "")
    width_node: usize = add_node(nodes, "int", "", 0, 0, 0, 0, 0, width, "", "")
    first: usize = add_node(nodes, "call_arg", "", subject, 0, 0, 0, 0, 0, "", "")
    second: usize = add_node(nodes, "call_arg", "", width_node, 0, 0, 0, 0, 0, "", "")
    start: usize = children.count
    children.push(first)
    children.push(second)
    marker: usize = add_node(nodes, "call", "", callee, 0, 0, start, 2, 0, "", "")
    return (marker, width_node)

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    nodes: mutable darray[ProofKernelNode] = []
    children: mutable darray[usize] = []
    x: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "x", "")
    y: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "y", "")
    z: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "z", "")
    w: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "w", "")
    other: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "other", "")
    delta: usize = add_node(&nodes, "binary", "-", y, z, 0, 0, 0, 0, "", "")
    fact: usize = add_node(&nodes, "binary", "==", x, delta, 0, 0, 0, 0, "", "")
    goal: usize = add_node(&nodes, "binary", "<", delta, w, 0, 0, 0, 0, "", "")
    witness_x: usize = scalar_witness(&nodes, &children, "x")
    witness_y: usize = scalar_witness(&nodes, &children, "y")
    witness_z: usize = scalar_witness(&nodes, &children, "z")
    witness_w: usize = scalar_witness(&nodes, &children, "w")
    ux: (marker: usize, width_node: usize) = unsigned_witness(&nodes, &children, "x", 8)
    uy: (marker: usize, width_node: usize) = unsigned_witness(&nodes, &children, "y", 8)
    uz: (marker: usize, width_node: usize) = unsigned_witness(&nodes, &children, "z", 8)
    uw: (marker: usize, width_node: usize) = unsigned_witness(&nodes, &children, "w", 8)
    facts: darray[usize] = [fact, witness_x, witness_y, witness_z, witness_w, ux.marker, uy.marker, uz.marker, uw.marker]
    positive: (known: bool, rewritten: usize) = subtraction_alias_probe(&nodes, &children, facts, goal)
    expected: usize = add_node(&nodes, "binary", "<", x, w, 0, 0, 0, 0, "", "")
    return 1 if not positive.known or not proof_kernel_replay_expr_equal_public(&nodes, &children, positive.rewritten, expected, 0)

    nodes[delta].operator <- "+"
    forged_operator: (known: bool, rewritten: usize) = subtraction_alias_probe(&nodes, &children, facts, goal)
    return 2 if forged_operator.known
    nodes[delta].operator <- "-"

    saved_fact: ProofKernelNode = nodes[fact]
    nodes[fact] <- ProofKernelNode{kind: saved_fact.kind, operator: saved_fact.operator, left: saved_fact.left, right: w, auxiliary: saved_fact.auxiliary, children_start: saved_fact.children_start, children_count: saved_fact.children_count, value: saved_fact.value, name: saved_fact.name, secondary_name: saved_fact.secondary_name}
    forged_path: (known: bool, rewritten: usize) = subtraction_alias_probe(&nodes, &children, facts, goal)
    return 3 if forged_path.known
    nodes[fact] <- saved_fact

    saved_width_node: ProofKernelNode = nodes[uz.width_node]
    nodes[uz.width_node] <- ProofKernelNode{kind: saved_width_node.kind, operator: saved_width_node.operator, left: saved_width_node.left, right: saved_width_node.right, auxiliary: saved_width_node.auxiliary, children_start: saved_width_node.children_start, children_count: saved_width_node.children_count, value: 16, name: saved_width_node.name, secondary_name: saved_width_node.secondary_name}
    mismatched_width: (known: bool, rewritten: usize) = subtraction_alias_probe(&nodes, &children, facts, goal)
    return 4 if mismatched_width.known
    nodes[uz.width_node] <- saved_width_node

    wrong_owner_fact: usize = add_node(&nodes, "binary", "==", other, delta, 0, 0, 0, 0, "", "")
    wrong_owner: darray[usize] = [wrong_owner_fact, witness_x, witness_y, witness_z, witness_w, ux.marker, uy.marker, uz.marker, uw.marker]
    return 5 if subtraction_alias_probe(&nodes, &children, wrong_owner, goal).known

    malformed: darray[usize] = [nodes.count, witness_x, witness_y, witness_z, witness_w, ux.marker, uy.marker, uz.marker, uw.marker]
    return 6 if subtraction_alias_probe(&nodes, &children, malformed, goal).known
    return 0
