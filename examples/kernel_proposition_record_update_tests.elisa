# Focused source-neutral formation checks for record updates. A well-typed update preserves its
# receiver's named type; unknown fields, mismatched values, and duplicate fields fail closed.
def kernel_record_update_proposition_tests() -> i64 can[Memory.Allocate, Abort.Panic]:
    bindings: mutable darray[ProofKernelTypingBinding] = []
    type_added: bool = proof_kernel_add_typing_binding_with_identity(&bindings, "type", "Pair", "", "named", "Pair", "", "", 441, 0, 0)
    pair_added: bool = proof_kernel_add_typing_binding_with_identity(&bindings, "value", "pair", "", "named", "Pair", "", "", 441, 0, 0)
    left_added: bool = proof_kernel_add_typing_binding_with_identity(&bindings, "field", "left", "Pair", "integer", "i64", "", "", 0, 441, 0)
    right_added: bool = proof_kernel_add_typing_binding_with_identity(&bindings, "field", "right", "Pair", "integer", "i64", "", "", 0, 441, 0)
    integer_added: bool = proof_kernel_add_typing_binding_with_identity(&bindings, "value", "replacement", "", "integer", "i64", "", "", 0, 0, 0)
    boolean_added: bool = proof_kernel_add_typing_binding_with_identity(&bindings, "value", "wrong_value", "", "boolean", "bool", "", "", 0, 0, 0)
    return 1 if not type_added or not pair_added or not left_added or not right_added or not integer_added or not boolean_added
    environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{bindings: bindings}
    nodes: mutable darray[ProofKernelNode] = []
    children: mutable darray[usize] = []
    pair_root: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "pair", "")
    replacement: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "replacement", "")
    wrong_value: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "wrong_value", "")

    valid_field: usize = add_node(&nodes, "field-init", "", replacement, 0, 0, 0, 0, 0, "left", "")
    children.push(valid_field)
    valid_update: usize = add_node(&nodes, "record-update", "", pair_root, 0, 0, 0, 1, 0, "", "")
    updated_left: usize = add_node(&nodes, "field", "", valid_update, 0, 0, 0, 0, 0, "left", "")
    valid_projection: usize = add_node(&nodes, "binary", "==", updated_left, replacement, 0, 0, 0, 0, "", "")
    return 2 if not proof_kernel_replay_proposition_formation_report(&nodes, &children, environment, [], valid_projection)
    original_right: usize = add_node(&nodes, "field", "", pair_root, 0, 0, 0, 0, 0, "right", "")
    updated_right: usize = add_node(&nodes, "field", "", valid_update, 0, 0, 0, 0, 0, "right", "")
    preserved_projection: usize = add_node(&nodes, "binary", "==", updated_right, original_right, 0, 0, 0, 0, "", "")
    return 3 if not proof_kernel_replay_proposition_formation_report(&nodes, &children, environment, [], preserved_projection)

    wrong_field: usize = add_node(&nodes, "field-init", "", wrong_value, 0, 0, 0, 0, 0, "left", "")
    children.push(wrong_field)
    wrong_update: usize = add_node(&nodes, "record-update", "", pair_root, 0, 0, 1, 1, 0, "", "")
    wrong_projection: usize = add_node(&nodes, "field", "", wrong_update, 0, 0, 0, 0, 0, "left", "")
    wrong_comparison: usize = add_node(&nodes, "binary", "==", wrong_projection, wrong_value, 0, 0, 0, 0, "", "")
    return 4 if proof_kernel_replay_proposition_formation_report(&nodes, &children, environment, [], wrong_comparison)

    unknown_field: usize = add_node(&nodes, "field-init", "", replacement, 0, 0, 0, 0, 0, "missing", "")
    children.push(unknown_field)
    unknown_update: usize = add_node(&nodes, "record-update", "", pair_root, 0, 0, 2, 1, 0, "", "")
    unknown_projection: usize = add_node(&nodes, "field", "", unknown_update, 0, 0, 0, 0, 0, "left", "")
    unknown_comparison: usize = add_node(&nodes, "binary", "==", unknown_projection, replacement, 0, 0, 0, 0, "", "")
    return 5 if proof_kernel_replay_proposition_formation_report(&nodes, &children, environment, [], unknown_comparison)

    duplicate_left: usize = add_node(&nodes, "field-init", "", replacement, 0, 0, 0, 0, 0, "left", "")
    duplicate_right: usize = add_node(&nodes, "field-init", "", replacement, 0, 0, 0, 0, 0, "left", "")
    children.push(duplicate_left)
    children.push(duplicate_right)
    duplicate_update: usize = add_node(&nodes, "record-update", "", pair_root, 0, 0, 3, 2, 0, "", "")
    duplicate_projection: usize = add_node(&nodes, "field", "", duplicate_update, 0, 0, 0, 0, 0, "left", "")
    duplicate_comparison: usize = add_node(&nodes, "binary", "==", duplicate_projection, replacement, 0, 0, 0, 0, "", "")
    return 6 if proof_kernel_replay_proposition_formation_report(&nodes, &children, environment, [], duplicate_comparison)
    return 0
