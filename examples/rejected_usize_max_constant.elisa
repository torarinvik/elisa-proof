# usize::MAX is pinned as a negative i64 bit pattern. None of these may read it as -1.
const HUGE: usize = 18446744073709551615

def huge_is_small() -> bool:
    ensure HUGE < 5
    return true

def huge_below_one(x: usize) -> bool:
    ensure HUGE + 1 == 0
    return true

def huge_returned() -> usize:
    ensure result < 10
    return HUGE
