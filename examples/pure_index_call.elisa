# A verified total-pure call cannot invalidate the compiler-provided lower bound for an unsigned
# index. The indexed read still requires its explicit upper bound.

def pure_index_observe(index: usize) -> void:
    return

def safe_index_after_pure_call(values: darray[i64]&, index: usize) -> i64:
    requires index < values.count
    pure_index_observe(index)
    return values[index]
