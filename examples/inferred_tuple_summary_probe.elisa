# Coverage probe: the explicit consumer proves; the inferred consumer currently
# loses the pure scalar tuple summary. This is not an accepted refusal contract.
def tuple_summary_source(value: i64) -> (known: bool, value: i64):
    ensures result.known and result.value == value
    return (true, value)

def explicit_tuple_summary(value: i64) -> i64:
    ensures result == value
    summary: (known: bool, value: i64) = tuple_summary_source(value)
    return summary.value

def inferred_tuple_summary(value: i64) -> i64:
    ensures result == value
    summary = tuple_summary_source(value)
    return summary.value
