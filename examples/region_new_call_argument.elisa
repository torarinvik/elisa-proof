# A region-qualified allocation may be passed directly to a reference formal. The compiler
# must preserve the allocation into @r and the verifier must not mistake the temporary for an
# untracked borrow.
def read(value: i64&) -> i64:
    return value

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    region r(4096):
        return read(value: new[r] 7)
