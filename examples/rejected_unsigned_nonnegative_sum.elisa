# The nonnegativity relaxation is exactly one claim about exactly one shape. Nothing else may
# follow from a term the wrap guard would otherwise have refused.

# A signed sum really can be negative, so the type is what the rule turns on, not the operator.
def a_signed_sum_may_be_negative(a: i64, b: i64) -> i64:
    ensure 0 <= result
    return a + b

# Subtraction is the operator the wrap guard exists for: for an unsigned pair the machine value is
# nonnegative and the mathematical value is not, so the claim needs the guard the rule keeps.
def an_unguarded_difference_keeps_the_guard(a: usize, b: usize) -> usize:
    ensure 0 <= result
    return a - b

# A subtraction nested under an addition is still a subtraction.
def a_nested_difference_keeps_it_too(a: usize, b: usize, c: usize) -> usize:
    ensure 0 <= result
    return c + (a - b)

# Strictness is not nonnegativity: nothing about a type says a value is not zero.
def a_strict_claim_is_not_admitted(a: usize, b: usize) -> usize:
    ensure 0 < result
    return a + b

# The relaxation admits the nonnegativity claim and nothing else about the same term: a sum that
# may wrap still bounds nothing.
def a_wrapping_sum_bounds_nothing(a: usize, b: usize) -> usize:
    ensure result < 10
    return a + b

# The same, in the direction a range check would use.
def a_wrapping_sum_is_no_index(values: darray[usize]&, a: usize, b: usize) -> usize:
    return 0 if a + b >= values.count
    return values[a + b]
