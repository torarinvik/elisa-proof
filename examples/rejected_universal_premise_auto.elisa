def rejected_existential_instance(rows: array[usize, 8]&) -> i64:
    requires exists index in 0..<8: rows[index] == 64
    ensure rows[3] == 64
    return 0

def rejected_empty_instance(rows: array[usize, 8]&) -> i64:
    requires forall index in 0..<0: rows[index] == 64
    ensure rows[0] == 64
    return 0

def rejected_future_instance(rows: array[usize, 8]&) -> i64:
    requires forall index in 0..<3: rows[index] == 64
    ensure rows[3] == 64
    return 0

def rejected_unsigned_range_wrap(value: u8) -> u8:
    requires value == 255
    requires forall index in 0..<value + 1: index == 0
    ensure false
    return value
