# Symbolic selector separation is allowed only from an explicit logical inequality. The
# resource certificate records that inequality and the replay kernel re-proves it.
def borrow_symbolic_disjoint(values: mutable i64[2], left: usize, right: usize) -> i64:
    requires left < 2
    requires right < 2
    requires left != right
    shared: i64& = &values[left]
    exclusive: mutable i64& = &values[right]
    return values[0]
