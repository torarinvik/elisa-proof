# The "c4 scalar witness" probe: a precondition-only callee's result, bound to a local, keeps
# its summary beside a widened unsigned argument (BACKLOG B-04, closed by B-02).

def base(x: i64) -> i64:
    requires x >= 0
    ensure result >= 0
    ensure result <= 10
    return 0 if x > 10
    return x

def bump(x: i64, d: u8) -> i64:
    requires x >= 0
    ensure result >= 0
    ensure result <= 265
    later: i64 = base(x)
    return later + d.i64()
