def scaled_index_bound(index: usize) -> void:
    requires index < 2
    ensure index * 4 + 3 < 8
    return

def quad(a: usize, b: usize, c: usize, d: usize) -> u8:
    return 1 if a == 0 or b == 0 or c == 0 or d == 0
    return 0

def fixed_scan(
    sources: array[usize, 8]&, failed_index: mutable usize&,
    failed_status: mutable u8&
) -> u8:
    for index in 0..<2:
        status: u8 = quad(
            sources[index * 4], sources[index * 4 + 1],
            sources[index * 4 + 2], sources[index * 4 + 3]
        )
        if status != 0:
            failed_index[0] <- index
            failed_status[0] <- status
            return status
    return 0
