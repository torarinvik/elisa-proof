# A callee reaches caller state through arguments, a method receiver, and globals. The checker
# already records every binding that is referenced, received or handed to an unknown callee, and it
# already uses that to keep a by-value scalar across a call. A collection a local owns outright is
# the same argument applied to the extent instead of the value: no callee can name the binding, so
# no callee can resize it.
#
# The literal is a value, not storage, so a binding recorded as one keeps that record too. Between
# them, a length established before a call is still there after it -- which is what a loop with a
# length invariant and a call in its body needs.
#
# The receiver of a method call is recorded as referenced by its own use, so the collection a
# `push` is called on is excluded by exactly the rule that keeps the others.

extend OwnedExtent:
    def grow(values: mutable darray[usize]&) -> usize:
        values.push(1)
        return values.count

    def an_owned_extent_survives_a_call_that_cannot_reach_it(seed: usize) -> bool:
        ensure result
        a: mutable darray[usize] = []
        b: mutable darray[usize] = []
        a.push(seed)
        return b.count == 0

    def an_owned_extent_survives_another_collection_being_grown() -> bool:
        ensure result
        a: mutable darray[usize] = []
        b: mutable darray[usize] = []
        grown: usize = grow(a)
        return b.count == 0
