    shared_reference_call_children.push(shared_reference_call)
    shared_reference_call_root: usize = add_node(&shared_reference_call_nodes, "resource-safety", "", 0, 0, 0, shared_reference_call_root_start, 2, 0, "shared-reference-mutable-call", "resource-v1")
    shared_reference_call_admitted: bool = proof_kernel_replay_resource_report(&shared_reference_call_nodes, &shared_reference_call_children, [], shared_reference_call_root)
    return 63 if shared_reference_call_admitted

    shared_reference_positive_nodes: mutable darray[ProofKernelNode] = []
    shared_reference_positive_children: mutable darray[usize] = []
    shared_reference_positive_formal: usize = add_node(&shared_reference_positive_nodes, "resource-bind", "external-mutable", 0, 0, 1, 0, 0, 0, "arg", "")
    shared_reference_positive_children.push(shared_reference_positive_formal)
    shared_reference_positive_callee: usize = add_node(&shared_reference_positive_nodes, "resource-safety", "", 0, 0, 1, 0, 1, 0, "needs-mutable", "resource-v1")
    shared_reference_positive_source: usize = add_node(&shared_reference_positive_nodes, "resource-bind", "external-mutable", 0, 0, 1, 0, 0, 0, "source", "")
    shared_reference_positive_source_place: usize = add_node(&shared_reference_positive_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "source", "")
    shared_reference_positive_argument: usize = add_node(&shared_reference_positive_nodes, "resource-call-arg", "borrow", shared_reference_positive_source_place, 0, 0, 0, 0, 0, "arg", "")
    shared_reference_positive_children.push(shared_reference_positive_argument)
    shared_reference_positive_call: usize = add_node(&shared_reference_positive_nodes, "resource-call", "", shared_reference_positive_callee, 0, 1, 1, 1, 0, "needs-mutable", "")
    shared_reference_positive_root_start: usize = shared_reference_positive_children.count
    shared_reference_positive_children.push(shared_reference_positive_source)
    shared_reference_positive_children.push(shared_reference_positive_call)
    shared_reference_positive_root: usize = add_node(&shared_reference_positive_nodes, "resource-safety", "", 0, 0, 0, shared_reference_positive_root_start, 2, 0, "mutable-reference-mutable-call", "resource-v1")
    shared_reference_positive_admitted: bool = proof_kernel_replay_resource_report(&shared_reference_positive_nodes, &shared_reference_positive_children, [], shared_reference_positive_root)
    return 64 if not shared_reference_positive_admitted

    hidden_literal_nodes: mutable darray[ProofKernelNode] = []
    hidden_literal_children: mutable darray[usize] = []
    hidden_literal_root: usize = add_node(&hidden_literal_nodes, "int", "", 0, 0, 0, 0, 0, 7, "ignored-name", "")
    return 37 if proof_kernel_replay_arena_report(&hidden_literal_nodes, &hidden_literal_children, [], hidden_literal_root)

    hidden_identifier_nodes: mutable darray[ProofKernelNode] = []
    hidden_identifier_children: mutable darray[usize] = []
    hidden_identifier_root: usize = add_node(&hidden_identifier_nodes, "ident", "", 0, 0, 0, 0, 0, 99, "value", "")
    return 38 if proof_kernel_replay_arena_report(&hidden_identifier_nodes, &hidden_identifier_children, [], hidden_identifier_root)

    # A region allocation operand must have an explicit resource binding. Treating an omitted
    # identifier as an unknown scalar would let a forged trace hide region ownership from replay.
    unbound_region_operand_nodes: mutable darray[ProofKernelNode] = []
    unbound_region_operand_children: mutable darray[usize] = []
    unbound_region_param: usize = add_node(&unbound_region_operand_nodes, "resource-region-param", "external", 0, 0, 0, 0, 0, 0, "r", "")
    unbound_region_operand: usize = add_node(&unbound_region_operand_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "foreign", "")
    unbound_region_alloc: usize = add_node(&unbound_region_operand_nodes, "resource-region-return-alloc", "", unbound_region_operand, 0, 0, 0, 0, 0, "", "r")
    unbound_region_return: usize = add_node(&unbound_region_operand_nodes, "resource-region-return", "param", unbound_region_alloc, 0, 0, 0, 0, 0, "r", "")
    unbound_region_operand_children.push(unbound_region_param)
    unbound_region_operand_children.push(unbound_region_alloc)
    unbound_region_operand_children.push(unbound_region_return)
    unbound_region_operand_root: usize = add_node(&unbound_region_operand_nodes, "resource-safety", "", 0, 0, 0, 0, 3, 0, "unbound-region-operand", "resource-v1")
    unbound_region_operand_admitted: bool = proof_kernel_replay_resource_report(&unbound_region_operand_nodes, &unbound_region_operand_children, [], unbound_region_operand_root)
    return 71 if unbound_region_operand_admitted

    # A reference capability is not a scalar value even if it has no region label. A forged
    # value-formal call must not erase that distinction at the independent replay boundary.
    reference_value_call_nodes: mutable darray[ProofKernelNode] = []
    reference_value_call_children: mutable darray[usize] = []
    reference_value_call_formal: usize = add_node(&reference_value_call_nodes, "resource-bind", "value", 0, 0, 0, 0, 0, 0, "value", "")
    reference_value_call_children.push(reference_value_call_formal)
    reference_value_call_callee: usize = add_node(&reference_value_call_nodes, "resource-safety", "", 0, 0, 1, 0, 1, 0, "scalar-only", "resource-v1")
    reference_value_call_source: usize = add_node(&reference_value_call_nodes, "resource-bind", "external-shared", 0, 0, 0, 0, 0, 0, "source", "")
    reference_value_call_source_place: usize = add_node(&reference_value_call_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "source", "")
    reference_value_call_argument: usize = add_node(&reference_value_call_nodes, "resource-call-arg", "value", reference_value_call_source_place, 0, 0, 0, 0, 0, "value", "")
    reference_value_call_children.push(reference_value_call_argument)
    reference_value_call: usize = add_node(&reference_value_call_nodes, "resource-call", "", reference_value_call_callee, 0, 1, 1, 1, 0, "scalar-only", "")
    reference_value_call_root_start: usize = reference_value_call_children.count
    reference_value_call_children.push(reference_value_call_source)
    reference_value_call_children.push(reference_value_call)
    reference_value_call_root: usize = add_node(&reference_value_call_nodes, "resource-safety", "", 0, 0, 0, reference_value_call_root_start, 2, 0, "reference-as-value", "resource-v1")
    reference_value_call_admitted: bool = proof_kernel_replay_resource_report(&reference_value_call_nodes, &reference_value_call_children, [], reference_value_call_root)
    return 73 if reference_value_call_admitted

    # A value argument must not smuggle a caller region-owned binding into a scalar formal. The
    # source checker rejects this at the call boundary; this standalone trace checks that replay
    # enforces the same provenance rule without relying on the frontend.
    region_value_call_nodes: mutable darray[ProofKernelNode] = []
    region_value_call_children: mutable darray[usize] = []
    region_value_call_open: usize = add_node(&region_value_call_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "scratch", "")
    region_value_call_seed_value: usize = add_node(&region_value_call_nodes, "int", "", 0, 0, 0, 0, 0, 3, "", "")
    region_value_call_seed: usize = add_node(&region_value_call_nodes, "resource-region-alloc", "", region_value_call_seed_value, 0, 2, 0, 0, 0, "region_value", "scratch")
    region_value_call_owner_value: usize = add_node(&region_value_call_nodes, "int", "", 0, 0, 0, 0, 0, 4, "", "")
    region_value_call_owner: usize = add_node(&region_value_call_nodes, "resource-region-alloc", "", region_value_call_owner_value, 0, 2, 0, 0, 0, "owner_value", "scratch")
    region_value_call_owner_place: usize = add_node(&region_value_call_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "owner_value", "")
    region_value_call_arg_owner: usize = add_node(&region_value_call_nodes, "resource-call-arg", "reference", region_value_call_owner_place, 0, 0, 0, 0, 0, "owner", "")
    region_value_call_value_place: usize = add_node(&region_value_call_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "region_value", "")
    region_value_call_arg_value: usize = add_node(&region_value_call_nodes, "resource-call-arg", "value", region_value_call_value_place, 0, 0, 0, 0, 0, "value", "")
    region_value_call_region: usize = add_node(&region_value_call_nodes, "resource-call-region", "param", 0, 0, 0, 0, 0, 0, "r", "scratch")
    region_value_call_start: usize = region_value_call_children.count
    region_value_call_children.push(region_value_call_arg_owner)
    region_value_call_children.push(region_value_call_arg_value)
    region_value_call_children.push(region_value_call_region)
    region_value_call: usize = add_node(&region_value_call_nodes, "resource-call", "", generic_callee, 1, 2, region_value_call_start, 3, 0, "make", "")
    region_value_call_result: usize = add_node(&region_value_call_nodes, "resource-call-result", "", region_value_call, 0, 2, 0, 0, 0, "result", "scratch")
    region_value_call_close: usize = add_node(&region_value_call_nodes, "resource-region-close", "", 0, 0, 0, 0, 0, 0, "scratch", "")
    region_value_call_report_start: usize = region_value_call_children.count
    region_value_call_children.push(region_value_call_open)
    region_value_call_children.push(region_value_call_seed)
    region_value_call_children.push(region_value_call_owner)
    region_value_call_children.push(region_value_call)
    region_value_call_children.push(region_value_call_result)
    region_value_call_children.push(region_value_call_close)
    region_value_call_report: usize = add_node(&region_value_call_nodes, "resource-safety", "", 0, 0, 0, region_value_call_report_start, 6, 0, "region-value-call", "resource-v1")
    region_value_call_admitted: bool = proof_kernel_replay_resource_report(&region_value_call_nodes, &region_value_call_children, [], region_value_call_report)
    return 72 if region_value_call_admitted

    # Quantifier substitution must stage a call's child roots after recursively rewriting a
    # nested collection argument. Otherwise the nested array's internal edge becomes a fake call
    # argument and changes the certificate's meaning.
    nested_call_nodes: mutable darray[ProofKernelNode] = []
    nested_call_children: mutable darray[usize] = []
    nested_call_binder: usize = add_node(&nested_call_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "item", "")
    nested_array_start: usize = nested_call_children.count
    nested_call_children.push(nested_call_binder)
    nested_array: usize = add_node(&nested_call_nodes, "array", "", 0, 0, 0, nested_array_start, 1, 0, "", "")
    nested_callee: usize = add_node(&nested_call_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "consume", "")
    nested_argument: usize = add_node(&nested_call_nodes, "call_arg", "", nested_array, 0, 0, 0, 0, 0, "", "")
    nested_arguments_start: usize = nested_call_children.count
    nested_call_children.push(nested_argument)
    nested_call: usize = add_node(&nested_call_nodes, "call", "", nested_callee, 0, 1, nested_arguments_start, 1, 0, "", "")
    nested_goal: usize = add_node(&nested_call_nodes, "binary", "==", nested_call, nested_call, 0, 0, 0, 0, "", "")
    nested_value: usize = add_node(&nested_call_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
    nested_range_start: usize = nested_call_children.count
    nested_call_children.push(nested_value)
    nested_range: usize = add_node(&nested_call_nodes, "array", "", 0, 0, 0, nested_range_start, 1, 0, "", "")
    nested_quantifier: usize = add_node(&nested_call_nodes, "quantifier", "", nested_range, nested_goal, 1, 0, 0, 0, "item", "")
    return 39 if not proof_kernel_replay_quantifier_report(&nested_call_nodes, &nested_call_children, "forall", [], nested_quantifier)

    # Structural termination certificates must carry every product subject and at least one
    # strict descent. The standalone kernel accepts a well-formed trace and rejects forged
    # all-preserved, duplicate-subject, and mismatched-preservation traces.
    structural_nodes: mutable darray[ProofKernelNode] = []
    structural_children: mutable darray[usize] = []
    structural_same: usize = add_node(&structural_nodes, "structural-argument", "same", 0, 0, 0, 0, 0, 0, "left", "left")
    structural_strict: usize = add_node(&structural_nodes, "structural-argument", "strict", 0, 0, 0, 0, 0, 0, "right", "prev")
    structural_children.push(structural_same)
    structural_children.push(structural_strict)
    structural_edge: usize = add_node(&structural_nodes, "structural-edge", "", 0, 0, 2, 0, 2, 0, "product", "product")
    structural_children.push(structural_edge)
    structural_root: usize = add_node(&structural_nodes, "structural-safety", "", 0, 0, 0, 2, 1, 0, "product", "structural-v1")
    return 65 if not proof_kernel_replay_structural_report(&structural_nodes, &structural_children, [], structural_root)

    structural_no_strict_nodes: mutable darray[ProofKernelNode] = []
    structural_no_strict_children: mutable darray[usize] = []
    structural_no_strict_same: usize = add_node(&structural_no_strict_nodes, "structural-argument", "same", 0, 0, 0, 0, 0, 0, "n", "n")
    structural_no_strict_children.push(structural_no_strict_same)
    structural_no_strict_edge: usize = add_node(&structural_no_strict_nodes, "structural-edge", "", 0, 0, 1, 0, 1, 0, "loop", "loop")
    structural_no_strict_children.push(structural_no_strict_edge)
    structural_no_strict_root: usize = add_node(&structural_no_strict_nodes, "structural-safety", "", 0, 0, 0, 1, 1, 0, "loop", "structural-v1")
    return 66 if proof_kernel_replay_structural_report(&structural_no_strict_nodes, &structural_no_strict_children, [], structural_no_strict_root)

    structural_duplicate_nodes: mutable darray[ProofKernelNode] = []
    structural_duplicate_children: mutable darray[usize] = []
    structural_duplicate_first: usize = add_node(&structural_duplicate_nodes, "structural-argument", "strict", 0, 0, 0, 0, 0, 0, "n", "prev")
    structural_duplicate_second: usize = add_node(&structural_duplicate_nodes, "structural-argument", "strict", 0, 0, 0, 0, 0, 0, "n", "tail")
    structural_duplicate_children.push(structural_duplicate_first)
    structural_duplicate_children.push(structural_duplicate_second)
    structural_duplicate_edge: usize = add_node(&structural_duplicate_nodes, "structural-edge", "", 0, 0, 2, 0, 2, 0, "loop", "loop")
    structural_duplicate_children.push(structural_duplicate_edge)
    structural_duplicate_root: usize = add_node(&structural_duplicate_nodes, "structural-safety", "", 0, 0, 0, 2, 1, 0, "loop", "structural-v1")
    return 67 if proof_kernel_replay_structural_report(&structural_duplicate_nodes, &structural_duplicate_children, [], structural_duplicate_root)

    structural_mismatch_nodes: mutable darray[ProofKernelNode] = []
    structural_mismatch_children: mutable darray[usize] = []
    structural_mismatch_same: usize = add_node(&structural_mismatch_nodes, "structural-argument", "same", 0, 0, 0, 0, 0, 0, "n", "other")
    structural_mismatch_children.push(structural_mismatch_same)
    structural_mismatch_strict: usize = add_node(&structural_mismatch_nodes, "structural-argument", "strict", 0, 0, 0, 0, 0, 0, "m", "prev")
    structural_mismatch_children.push(structural_mismatch_strict)
    structural_mismatch_edge: usize = add_node(&structural_mismatch_nodes, "structural-edge", "", 0, 0, 2, 0, 2, 0, "loop", "loop")
    structural_mismatch_children.push(structural_mismatch_edge)
    structural_mismatch_root: usize = add_node(&structural_mismatch_nodes, "structural-safety", "", 0, 0, 0, 2, 1, 0, "loop", "structural-v1")
    return 68 if proof_kernel_replay_structural_report(&structural_mismatch_nodes, &structural_mismatch_children, [], structural_mismatch_root)

    return 0
