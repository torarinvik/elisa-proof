    scalar_region_return_children.push(scalar_region_return_marker)
    scalar_region_return_root: usize = add_node(&scalar_region_return_nodes, "resource-safety", "", 0, 0, 0, 0, 4, 0, "scalar-region-return", "resource-v1")
    scalar_region_return_admitted: bool = proof_kernel_replay_resource_report(&scalar_region_return_nodes, &scalar_region_return_children, [], scalar_region_return_root)
    return 75 if scalar_region_return_admitted

    # A shared reference cannot be upgraded to a mutable reference at the return marker.
    shared_mutable_return_nodes: mutable darray[ProofKernelNode] = []
    shared_mutable_return_children: mutable darray[usize] = []
    shared_mutable_return_param: usize = add_node(&shared_mutable_return_nodes, "resource-region-param", "external", 0, 0, 0, 0, 0, 0, "r", "")
    shared_mutable_return_bind: usize = add_node(&shared_mutable_return_nodes, "resource-bind", "external-shared", 0, 0, 0, 0, 0, 0, "owner", "r")
    shared_mutable_return_place: usize = add_node(&shared_mutable_return_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "owner", "")
    shared_mutable_return_use: usize = add_node(&shared_mutable_return_nodes, "resource-use", "", shared_mutable_return_place, 0, 0, 0, 0, 0, "owner", "")
    shared_mutable_return_marker: usize = add_node(&shared_mutable_return_nodes, "resource-region-return", "param", shared_mutable_return_use, 0, 1, 0, 0, 0, "r", "")
    shared_mutable_return_children.push(shared_mutable_return_param)
    shared_mutable_return_children.push(shared_mutable_return_bind)
    shared_mutable_return_children.push(shared_mutable_return_use)
    shared_mutable_return_children.push(shared_mutable_return_marker)
    shared_mutable_return_root: usize = add_node(&shared_mutable_return_nodes, "resource-safety", "", 0, 0, 0, 0, 4, 0, "shared-mutable-return", "resource-v1")
    shared_mutable_return_admitted: bool = proof_kernel_replay_resource_report(&shared_mutable_return_nodes, &shared_mutable_return_children, [], shared_mutable_return_root)
    return 76 if shared_mutable_return_admitted

    # A reference capability is not a scalar value even if it has no region label. A forged
    # value-formal call must not erase that distinction at the independent replay boundary.
    reference_value_call_nodes: mutable darray[ProofKernelNode] = []
    reference_value_call_children: mutable darray[usize] = []
    reference_value_call_formal: usize = add_node(&reference_value_call_nodes, "resource-bind", "value", 0, 0, 0, 0, 0, 0, "value", "")
    reference_value_call_children.push(reference_value_call_formal)
    reference_value_call_callee: usize = add_node(&reference_value_call_nodes, "resource-safety", "", 0, 0, 1, 0, 1, 0, "scalar-only", "resource-v1")
    reference_value_call_source: usize = add_node(&reference_value_call_nodes, "resource-bind", "external-shared", 0, 0, 0, 0, 0, 0, "source", "")
    reference_value_call_source_place: usize = add_node(&reference_value_call_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "source", "")
    reference_value_call_argument: usize = add_node(&reference_value_call_nodes, "resource-call-arg", "value", reference_value_call_source_place, 0, 0, 0, 0, 0, "value", "")
    reference_value_call_children.push(reference_value_call_argument)
    reference_value_call: usize = add_node(&reference_value_call_nodes, "resource-call", "", reference_value_call_callee, 0, 1, 1, 1, 0, "scalar-only", "")
    reference_value_call_root_start: usize = reference_value_call_children.count
    reference_value_call_children.push(reference_value_call_source)
    reference_value_call_children.push(reference_value_call)
    reference_value_call_root: usize = add_node(&reference_value_call_nodes, "resource-safety", "", 0, 0, 0, reference_value_call_root_start, 2, 0, "reference-as-value", "resource-v1")
    reference_value_call_admitted: bool = proof_kernel_replay_resource_report(&reference_value_call_nodes, &reference_value_call_children, [], reference_value_call_root)
    return 73 if reference_value_call_admitted

    # A value argument must not smuggle a caller region-owned binding into a scalar formal. The
    # source checker rejects this at the call boundary; this standalone trace checks that replay
    # enforces the same provenance rule without relying on the frontend.
    region_value_call_nodes: mutable darray[ProofKernelNode] = []
    region_value_call_children: mutable darray[usize] = []
    region_value_call_open: usize = add_node(&region_value_call_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "scratch", "")
    region_value_call_seed_value: usize = add_node(&region_value_call_nodes, "int", "", 0, 0, 0, 0, 0, 3, "", "")
    region_value_call_seed: usize = add_node(&region_value_call_nodes, "resource-region-alloc", "", region_value_call_seed_value, 0, 2, 0, 0, 0, "region_value", "scratch")
    region_value_call_owner_value: usize = add_node(&region_value_call_nodes, "int", "", 0, 0, 0, 0, 0, 4, "", "")
    region_value_call_owner: usize = add_node(&region_value_call_nodes, "resource-region-alloc", "", region_value_call_owner_value, 0, 2, 0, 0, 0, "owner_value", "scratch")
    region_value_call_owner_place: usize = add_node(&region_value_call_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "owner_value", "")
    region_value_call_arg_owner: usize = add_node(&region_value_call_nodes, "resource-call-arg", "reference", region_value_call_owner_place, 0, 0, 0, 0, 0, "owner", "")
    region_value_call_value_place: usize = add_node(&region_value_call_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "region_value", "")
    region_value_call_arg_value: usize = add_node(&region_value_call_nodes, "resource-call-arg", "value", region_value_call_value_place, 0, 0, 0, 0, 0, "value", "")
    region_value_call_region: usize = add_node(&region_value_call_nodes, "resource-call-region", "param", 0, 0, 0, 0, 0, 0, "r", "scratch")
    region_value_call_start: usize = region_value_call_children.count
    region_value_call_children.push(region_value_call_arg_owner)
    region_value_call_children.push(region_value_call_arg_value)
    region_value_call_children.push(region_value_call_region)
    region_value_call: usize = add_node(&region_value_call_nodes, "resource-call", "", generic_callee, 1, 2, region_value_call_start, 3, 0, "make", "")
    region_value_call_result: usize = add_node(&region_value_call_nodes, "resource-call-result", "", region_value_call, 0, 2, 0, 0, 0, "result", "scratch")
    region_value_call_close: usize = add_node(&region_value_call_nodes, "resource-region-close", "", 0, 0, 0, 0, 0, 0, "scratch", "")
    region_value_call_report_start: usize = region_value_call_children.count
    region_value_call_children.push(region_value_call_open)
    region_value_call_children.push(region_value_call_seed)
    region_value_call_children.push(region_value_call_owner)
    region_value_call_children.push(region_value_call)
    region_value_call_children.push(region_value_call_result)
    region_value_call_children.push(region_value_call_close)
    region_value_call_report: usize = add_node(&region_value_call_nodes, "resource-safety", "", 0, 0, 0, region_value_call_report_start, 6, 0, "region-value-call", "resource-v1")
    region_value_call_admitted: bool = proof_kernel_replay_resource_report(&region_value_call_nodes, &region_value_call_children, [], region_value_call_report)
    return 72 if region_value_call_admitted

    # Quantifier substitution must stage a call's child roots after recursively rewriting a
    # nested collection argument. Otherwise the nested array's internal edge becomes a fake call
    # argument and changes the certificate's meaning.
    nested_call_nodes: mutable darray[ProofKernelNode] = []
    nested_call_children: mutable darray[usize] = []
    nested_call_binder: usize = add_node(&nested_call_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "item", "")
    nested_array_start: usize = nested_call_children.count
    nested_call_children.push(nested_call_binder)
    nested_array: usize = add_node(&nested_call_nodes, "array", "", 0, 0, 0, nested_array_start, 1, 0, "", "")
    nested_callee: usize = add_node(&nested_call_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "consume", "")
    nested_argument: usize = add_node(&nested_call_nodes, "call_arg", "", nested_array, 0, 0, 0, 0, 0, "", "")
    nested_arguments_start: usize = nested_call_children.count
    nested_call_children.push(nested_argument)
    nested_call: usize = add_node(&nested_call_nodes, "call", "", nested_callee, 0, 1, nested_arguments_start, 1, 0, "", "")
    # A call result is not a witnessed scalar, so the instance is decided by containment: the
    # hypothesis states the same call over the instantiated array, and only an exact child graph
    # can match it. A hypothesis over a different element must not.
    nested_seven: usize = add_node(&nested_call_nodes, "int", "", 0, 0, 0, 0, 0, 7, "", "")
    nested_goal: usize = add_node(&nested_call_nodes, "binary", "==", nested_call, nested_seven, 0, 0, 0, 0, "", "")
    nested_value: usize = add_node(&nested_call_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
    nested_range_start: usize = nested_call_children.count
    nested_call_children.push(nested_value)
    nested_range: usize = add_node(&nested_call_nodes, "array", "", 0, 0, 0, nested_range_start, 1, 0, "", "")
    nested_quantifier: usize = add_node(&nested_call_nodes, "quantifier", "forall", nested_range, nested_goal, 1, 0, 0, 0, "item", "")
    nested_fact_element: usize = add_node(&nested_call_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
    nested_fact_array_start: usize = nested_call_children.count
    nested_call_children.push(nested_fact_element)
    nested_fact_array: usize = add_node(&nested_call_nodes, "array", "", 0, 0, 0, nested_fact_array_start, 1, 0, "", "")
    nested_fact_argument: usize = add_node(&nested_call_nodes, "call_arg", "", nested_fact_array, 0, 0, 0, 0, 0, "", "")
    nested_fact_arguments_start: usize = nested_call_children.count
    nested_call_children.push(nested_fact_argument)
    nested_fact_call: usize = add_node(&nested_call_nodes, "call", "", nested_callee, 0, 1, nested_fact_arguments_start, 1, 0, "", "")
    nested_fact: usize = add_node(&nested_call_nodes, "binary", "==", nested_fact_call, nested_seven, 0, 0, 0, 0, "", "")
    return 39 if not proof_kernel_replay_quantifier_report(&nested_call_nodes, &nested_call_children, "forall", [nested_fact], nested_quantifier)
    nested_other_element: usize = add_node(&nested_call_nodes, "int", "", 0, 0, 0, 0, 0, 2, "", "")
    nested_other_array_start: usize = nested_call_children.count
    nested_call_children.push(nested_other_element)
    nested_other_array: usize = add_node(&nested_call_nodes, "array", "", 0, 0, 0, nested_other_array_start, 1, 0, "", "")
    nested_other_argument: usize = add_node(&nested_call_nodes, "call_arg", "", nested_other_array, 0, 0, 0, 0, 0, "", "")
    nested_other_arguments_start: usize = nested_call_children.count
    nested_call_children.push(nested_other_argument)
    nested_other_call: usize = add_node(&nested_call_nodes, "call", "", nested_callee, 0, 1, nested_other_arguments_start, 1, 0, "", "")
    nested_other_fact: usize = add_node(&nested_call_nodes, "binary", "==", nested_other_call, nested_seven, 0, 0, 0, 0, "", "")
    return 120 if proof_kernel_replay_quantifier_report(&nested_call_nodes, &nested_call_children, "forall", [nested_other_fact], nested_quantifier)
    return 39 if proof_kernel_replay_quantifier_report(&nested_call_nodes, &nested_call_children, "forall", [], nested_quantifier)

    # Record construction and update retain their type/base, field names and field values under
    # binder substitution. Each instance is decided by containment against a hypothesis over the
    # instantiated aggregate, so a dropped field name, a wrong field value, or a wrong update base
    # must each make the match fail.
    construct_nodes: mutable darray[ProofKernelNode] = []
    construct_children: mutable darray[usize] = []
    construct_callee: usize = add_node(&construct_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "take", "")
    construct_three: usize = add_node(&construct_nodes, "int", "", 0, 0, 0, 0, 0, 3, "", "")
    construct_zero: usize = add_node(&construct_nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
    construct_one: usize = add_node(&construct_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
    construct_two: usize = add_node(&construct_nodes, "int", "", 0, 0, 0, 0, 0, 2, "", "")
    construct_binder: usize = add_node(&construct_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "item", "")
    construct_type: usize = add_node(&construct_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "Pair", "")
    construct_base: usize = add_node(&construct_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "base", "")
    construct_other_base: usize = add_node(&construct_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "other", "")
    # `take(Pair{left: item, right: 0}) == 3`, quantified over `[1]`.
    goal_left_init: usize = add_node(&construct_nodes, "field-init", "", construct_binder, 0, 0, 0, 0, 0, "left", "")
    goal_right_init: usize = add_node(&construct_nodes, "field-init", "", construct_zero, 0, 0, 0, 0, 0, "right", "")
    goal_fields_start: usize = construct_children.count
    construct_children.push(goal_left_init)
    construct_children.push(goal_right_init)
    goal_construct: usize = add_node(&construct_nodes, "construct", "", construct_type, 0, 0, goal_fields_start, 2, 0, "", "")
    goal_construct_argument: usize = add_node(&construct_nodes, "call_arg", "", goal_construct, 0, 0, 0, 0, 0, "", "")
    goal_construct_arguments_start: usize = construct_children.count
    construct_children.push(goal_construct_argument)
    goal_construct_call: usize = add_node(&construct_nodes, "call", "", construct_callee, 0, 1, goal_construct_arguments_start, 1, 0, "", "")
    goal_construct_body: usize = add_node(&construct_nodes, "binary", "==", goal_construct_call, construct_three, 0, 0, 0, 0, "", "")
    construct_range_start: usize = construct_children.count
    construct_children.push(construct_one)
    construct_range: usize = add_node(&construct_nodes, "array", "", 0, 0, 0, construct_range_start, 1, 0, "", "")
    construct_quantifier: usize = add_node(&construct_nodes, "quantifier", "forall", construct_range, goal_construct_body, 1, 0, 0, 0, "item", "")
    # Hypotheses: the exact instance, a wrong field value, and a wrong field name.
    exact_left_init: usize = add_node(&construct_nodes, "field-init", "", construct_one, 0, 0, 0, 0, 0, "left", "")
    exact_right_init: usize = add_node(&construct_nodes, "field-init", "", construct_zero, 0, 0, 0, 0, 0, "right", "")
    exact_fields_start: usize = construct_children.count
    construct_children.push(exact_left_init)
    construct_children.push(exact_right_init)
    exact_construct: usize = add_node(&construct_nodes, "construct", "", construct_type, 0, 0, exact_fields_start, 2, 0, "", "")
    exact_argument: usize = add_node(&construct_nodes, "call_arg", "", exact_construct, 0, 0, 0, 0, 0, "", "")
    exact_arguments_start: usize = construct_children.count
    construct_children.push(exact_argument)
    exact_call: usize = add_node(&construct_nodes, "call", "", construct_callee, 0, 1, exact_arguments_start, 1, 0, "", "")
    exact_fact: usize = add_node(&construct_nodes, "binary", "==", exact_call, construct_three, 0, 0, 0, 0, "", "")
    return 121 if not proof_kernel_replay_quantifier_report(&construct_nodes, &construct_children, "forall", [exact_fact], construct_quantifier)
    wrong_value_left_init: usize = add_node(&construct_nodes, "field-init", "", construct_two, 0, 0, 0, 0, 0, "left", "")
    wrong_value_fields_start: usize = construct_children.count
    construct_children.push(wrong_value_left_init)
    construct_children.push(exact_right_init)
    wrong_value_construct: usize = add_node(&construct_nodes, "construct", "", construct_type, 0, 0, wrong_value_fields_start, 2, 0, "", "")
    wrong_value_argument: usize = add_node(&construct_nodes, "call_arg", "", wrong_value_construct, 0, 0, 0, 0, 0, "", "")
    wrong_value_arguments_start: usize = construct_children.count
    construct_children.push(wrong_value_argument)
    wrong_value_call: usize = add_node(&construct_nodes, "call", "", construct_callee, 0, 1, wrong_value_arguments_start, 1, 0, "", "")
    wrong_value_fact: usize = add_node(&construct_nodes, "binary", "==", wrong_value_call, construct_three, 0, 0, 0, 0, "", "")
    return 122 if proof_kernel_replay_quantifier_report(&construct_nodes, &construct_children, "forall", [wrong_value_fact], construct_quantifier)
    wrong_name_left_init: usize = add_node(&construct_nodes, "field-init", "", construct_one, 0, 0, 0, 0, 0, "lower", "")
    wrong_name_fields_start: usize = construct_children.count
    construct_children.push(wrong_name_left_init)
    construct_children.push(exact_right_init)
    wrong_name_construct: usize = add_node(&construct_nodes, "construct", "", construct_type, 0, 0, wrong_name_fields_start, 2, 0, "", "")
    wrong_name_argument: usize = add_node(&construct_nodes, "call_arg", "", wrong_name_construct, 0, 0, 0, 0, 0, "", "")
    wrong_name_arguments_start: usize = construct_children.count
    construct_children.push(wrong_name_argument)
    wrong_name_call: usize = add_node(&construct_nodes, "call", "", construct_callee, 0, 1, wrong_name_arguments_start, 1, 0, "", "")
    wrong_name_fact: usize = add_node(&construct_nodes, "binary", "==", wrong_name_call, construct_three, 0, 0, 0, 0, "", "")
    return 123 if proof_kernel_replay_quantifier_report(&construct_nodes, &construct_children, "forall", [wrong_name_fact], construct_quantifier)
    # `take(base{left = item}) == 3`: the update base travels with the instance.
    update_goal_init: usize = add_node(&construct_nodes, "field-init", "", construct_binder, 0, 0, 0, 0, 0, "left", "")
    update_goal_fields_start: usize = construct_children.count
    construct_children.push(update_goal_init)
    update_goal: usize = add_node(&construct_nodes, "record-update", "", construct_base, 0, 0, update_goal_fields_start, 1, 0, "", "")
    update_goal_argument: usize = add_node(&construct_nodes, "call_arg", "", update_goal, 0, 0, 0, 0, 0, "", "")
    update_goal_arguments_start: usize = construct_children.count
    construct_children.push(update_goal_argument)
    update_goal_call: usize = add_node(&construct_nodes, "call", "", construct_callee, 0, 1, update_goal_arguments_start, 1, 0, "", "")
    update_goal_body: usize = add_node(&construct_nodes, "binary", "==", update_goal_call, construct_three, 0, 0, 0, 0, "", "")
    update_quantifier: usize = add_node(&construct_nodes, "quantifier", "forall", construct_range, update_goal_body, 1, 0, 0, 0, "item", "")
    update_exact_init: usize = add_node(&construct_nodes, "field-init", "", construct_one, 0, 0, 0, 0, 0, "left", "")
    update_exact_fields_start: usize = construct_children.count
    construct_children.push(update_exact_init)
    update_exact: usize = add_node(&construct_nodes, "record-update", "", construct_base, 0, 0, update_exact_fields_start, 1, 0, "", "")
    update_exact_argument: usize = add_node(&construct_nodes, "call_arg", "", update_exact, 0, 0, 0, 0, 0, "", "")
    update_exact_arguments_start: usize = construct_children.count
    construct_children.push(update_exact_argument)
    update_exact_call: usize = add_node(&construct_nodes, "call", "", construct_callee, 0, 1, update_exact_arguments_start, 1, 0, "", "")
    update_exact_fact: usize = add_node(&construct_nodes, "binary", "==", update_exact_call, construct_three, 0, 0, 0, 0, "", "")
    return 124 if not proof_kernel_replay_quantifier_report(&construct_nodes, &construct_children, "forall", [update_exact_fact], update_quantifier)
    update_other_fields_start: usize = construct_children.count
    construct_children.push(update_exact_init)
    update_other: usize = add_node(&construct_nodes, "record-update", "", construct_other_base, 0, 0, update_other_fields_start, 1, 0, "", "")
    update_other_argument: usize = add_node(&construct_nodes, "call_arg", "", update_other, 0, 0, 0, 0, 0, "", "")
    update_other_arguments_start: usize = construct_children.count
    construct_children.push(update_other_argument)
    update_other_call: usize = add_node(&construct_nodes, "call", "", construct_callee, 0, 1, update_other_arguments_start, 1, 0, "", "")
    update_other_fact: usize = add_node(&construct_nodes, "binary", "==", update_other_call, construct_three, 0, 0, 0, 0, "", "")
    return 125 if proof_kernel_replay_quantifier_report(&construct_nodes, &construct_children, "forall", [update_other_fact], update_quantifier)

    # The semantic quantifier kind is part of the replayed node, not an unchecked caller hint.
    # A forged existential replay of a universal arena must fail even when its finite body is
    # otherwise satisfiable.
    quantifier_kind_nodes: mutable darray[ProofKernelNode] = []
    quantifier_kind_children: mutable darray[usize] = []
    quantifier_kind_value: usize = add_node(&quantifier_kind_nodes, "int", "", 0, 0, 0, 0, 0, 7, "", "")
    quantifier_kind_children.push(quantifier_kind_value)
    quantifier_kind_range: usize = add_node(&quantifier_kind_nodes, "array", "", 0, 0, 0, 0, 1, 0, "", "")
    quantifier_kind_body: usize = add_node(&quantifier_kind_nodes, "binary", "==", quantifier_kind_value, quantifier_kind_value, 0, 0, 0, 0, "", "")
    quantifier_kind_root: usize = add_node(&quantifier_kind_nodes, "quantifier", "forall", quantifier_kind_range, quantifier_kind_body, 1, 0, 0, 0, "x", "")
    return 75 if proof_kernel_replay_quantifier_report(&quantifier_kind_nodes, &quantifier_kind_children, "exists", [], quantifier_kind_root)
    return 76 if not proof_kernel_replay_quantifier_report(&quantifier_kind_nodes, &quantifier_kind_children, "forall", [], quantifier_kind_root)

    # Structural termination certificates must carry every product subject and at least one
    # strict descent. The standalone kernel accepts a well-formed trace and rejects forged
    # all-preserved, duplicate-subject, and mismatched-preservation traces.
    structural_nodes: mutable darray[ProofKernelNode] = []
    structural_children: mutable darray[usize] = []
    structural_same: usize = add_node(&structural_nodes, "structural-argument", "same", 0, 0, 0, 0, 0, 0, "left", "left")
    structural_strict: usize = add_node(&structural_nodes, "structural-argument", "strict", 0, 0, 0, 0, 0, 0, "right", "prev")
    structural_children.push(structural_same)
    structural_children.push(structural_strict)
    structural_edge: usize = add_node(&structural_nodes, "structural-edge", "", 0, 0, 2, 0, 2, 0, "product", "product")
    structural_children.push(structural_edge)
    structural_root: usize = add_node(&structural_nodes, "structural-safety", "", 0, 0, 0, 2, 1, 0, "product", "structural-v1")
    return 65 if not proof_kernel_replay_structural_report(&structural_nodes, &structural_children, [], structural_root)

    structural_no_strict_nodes: mutable darray[ProofKernelNode] = []
    structural_no_strict_children: mutable darray[usize] = []
    structural_no_strict_same: usize = add_node(&structural_no_strict_nodes, "structural-argument", "same", 0, 0, 0, 0, 0, 0, "n", "n")
    structural_no_strict_children.push(structural_no_strict_same)
    structural_no_strict_edge: usize = add_node(&structural_no_strict_nodes, "structural-edge", "", 0, 0, 1, 0, 1, 0, "loop", "loop")
    structural_no_strict_children.push(structural_no_strict_edge)
    structural_no_strict_root: usize = add_node(&structural_no_strict_nodes, "structural-safety", "", 0, 0, 0, 1, 1, 0, "loop", "structural-v1")
    return 66 if proof_kernel_replay_structural_report(&structural_no_strict_nodes, &structural_no_strict_children, [], structural_no_strict_root)

    structural_duplicate_nodes: mutable darray[ProofKernelNode] = []
    structural_duplicate_children: mutable darray[usize] = []
    structural_duplicate_first: usize = add_node(&structural_duplicate_nodes, "structural-argument", "strict", 0, 0, 0, 0, 0, 0, "n", "prev")
    structural_duplicate_second: usize = add_node(&structural_duplicate_nodes, "structural-argument", "strict", 0, 0, 0, 0, 0, 0, "n", "tail")
    structural_duplicate_children.push(structural_duplicate_first)
    structural_duplicate_children.push(structural_duplicate_second)
    structural_duplicate_edge: usize = add_node(&structural_duplicate_nodes, "structural-edge", "", 0, 0, 2, 0, 2, 0, "loop", "loop")
    structural_duplicate_children.push(structural_duplicate_edge)
    structural_duplicate_root: usize = add_node(&structural_duplicate_nodes, "structural-safety", "", 0, 0, 0, 2, 1, 0, "loop", "structural-v1")
    return 67 if proof_kernel_replay_structural_report(&structural_duplicate_nodes, &structural_duplicate_children, [], structural_duplicate_root)

    structural_mismatch_nodes: mutable darray[ProofKernelNode] = []
    structural_mismatch_children: mutable darray[usize] = []
    structural_mismatch_same: usize = add_node(&structural_mismatch_nodes, "structural-argument", "same", 0, 0, 0, 0, 0, 0, "n", "other")
    structural_mismatch_children.push(structural_mismatch_same)
    structural_mismatch_strict: usize = add_node(&structural_mismatch_nodes, "structural-argument", "strict", 0, 0, 0, 0, 0, 0, "m", "prev")
    structural_mismatch_children.push(structural_mismatch_strict)
    structural_mismatch_edge: usize = add_node(&structural_mismatch_nodes, "structural-edge", "", 0, 0, 2, 0, 2, 0, "loop", "loop")
    structural_mismatch_children.push(structural_mismatch_edge)
    structural_mismatch_root: usize = add_node(&structural_mismatch_nodes, "structural-safety", "", 0, 0, 0, 2, 1, 0, "loop", "structural-v1")
    return 68 if proof_kernel_replay_structural_report(&structural_mismatch_nodes, &structural_mismatch_children, [], structural_mismatch_root)

    # A negative affine fact and goal keep their sign in the difference graph: `0 - x <= 0`
    # means `x >= 0`, so it must not prove the false converse `x <= 0`. The bounded facts make negation safe at
    # fixed-width endpoints, ensuring this exercises difference normalization rather than an
    # overflow conservatism fallback.
    negative_difference_nodes: mutable darray[ProofKernelNode] = []
    negative_difference_children: mutable darray[usize] = []
    negative_difference_x: usize = add_node(&negative_difference_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "x", "")
    negative_difference_ten: usize = add_node(&negative_difference_nodes, "int", "", 0, 0, 0, 0, 0, 10, "", "")
    negative_difference_minus_ten: usize = add_node(&negative_difference_nodes, "int", "", 0, 0, 0, 0, 0, -10, "", "")
    negative_difference_zero: usize = add_node(&negative_difference_nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
    negative_difference_lower: usize = add_node(&negative_difference_nodes, "binary", ">=", negative_difference_x, negative_difference_minus_ten, 0, 0, 0, 0, "", "")
    negative_difference_upper: usize = add_node(&negative_difference_nodes, "binary", "<=", negative_difference_x, negative_difference_ten, 0, 0, 0, 0, "", "")
    negative_difference_negated_x: usize = add_node(&negative_difference_nodes, "binary", "-", negative_difference_zero, negative_difference_x, 0, 0, 0, 0, "", "")
    negative_difference_fact: usize = add_node(&negative_difference_nodes, "binary", "<=", negative_difference_negated_x, negative_difference_zero, 0, 0, 0, 0, "", "")
    negative_difference_goal: usize = add_node(&negative_difference_nodes, "binary", "<=", negative_difference_x, negative_difference_zero, 0, 0, 0, 0, "", "")
    negative_difference_admitted: bool = proof_kernel_replay_goal_report(&negative_difference_nodes, &negative_difference_children, [negative_difference_lower, negative_difference_upper, negative_difference_fact], negative_difference_goal)
    return 94 if negative_difference_admitted
    negative_difference_reverse_goal: usize = add_node(&negative_difference_nodes, "binary", "<=", negative_difference_negated_x, negative_difference_zero, 0, 0, 0, 0, "", "")
    negative_difference_reverse_admitted: bool = proof_kernel_replay_goal_report(&negative_difference_nodes, &negative_difference_children, [negative_difference_lower, negative_difference_upper, negative_difference_upper], negative_difference_reverse_goal)
    return 96 if negative_difference_reverse_admitted
    negative_difference_positive_goal: usize = add_node(&negative_difference_nodes, "binary", ">=", negative_difference_x, negative_difference_zero, 0, 0, 0, 0, "", "")
    negative_difference_positive_admitted: bool = proof_kernel_replay_goal_report(&negative_difference_nodes, &negative_difference_children, [negative_difference_lower, negative_difference_upper, negative_difference_fact], negative_difference_positive_goal)
    return 95 if not negative_difference_positive_admitted

    # Fixed-width unsigned arithmetic must not fall through to the signed interval model. This
    # hostile certificate supplies a valid u8 marker and the exact endpoint x == 255, then claims
    # that x + 1 > x. The runtime wraps that addition to zero, so independent kernel replay must
    # reject the goal even though its signed model would otherwise see 256 > 255.
    unsigned_nodes: mutable darray[ProofKernelNode] = []
    unsigned_children: mutable darray[usize] = []
    unsigned_zero: usize = add_node(&unsigned_nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
    unsigned_one: usize = add_node(&unsigned_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
    unsigned_max: usize = add_node(&unsigned_nodes, "int", "", 0, 0, 0, 0, 0, 255, "", "")
    unsigned_x: usize = add_node(&unsigned_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "x", "")
    unsigned_lower: usize = add_node(&unsigned_nodes, "binary", "<=", unsigned_zero, unsigned_x, 0, 0, 0, 0, "", "")
    unsigned_upper: usize = add_node(&unsigned_nodes, "binary", "<=", unsigned_x, unsigned_max, 0, 0, 0, 0, "", "")
    unsigned_equal: usize = add_node(&unsigned_nodes, "binary", "==", unsigned_x, unsigned_max, 0, 0, 0, 0, "", "")
    unsigned_callee: usize = add_node(&unsigned_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "__elisa_unsigned_type_bound", "")
    unsigned_marker_arg: usize = add_node(&unsigned_nodes, "call_arg", "", unsigned_x, 0, 0, 0, 0, 0, "", "")
    unsigned_marker_width: usize = add_node(&unsigned_nodes, "call_arg", "", add_node(&unsigned_nodes, "int", "", 0, 0, 0, 0, 0, 8, "", ""), 0, 0, 0, 0, 0, "", "")
    unsigned_marker_start: usize = unsigned_children.count
    unsigned_children.push(unsigned_marker_arg)
    unsigned_children.push(unsigned_marker_width)
    unsigned_marker: usize = add_node(&unsigned_nodes, "call", "", unsigned_callee, 0, 0, unsigned_marker_start, 2, 0, "", "")
    unsigned_sum: usize = add_node(&unsigned_nodes, "binary", "+", unsigned_x, unsigned_one, 0, 0, 0, 0, "", "")
    unsigned_goal: usize = add_node(&unsigned_nodes, "binary", ">", unsigned_sum, unsigned_x, 0, 0, 0, 0, "", "")
    unsigned_admitted: bool = proof_kernel_replay_goal_report(&unsigned_nodes, &unsigned_children, [unsigned_lower, unsigned_marker, unsigned_upper, unsigned_equal], unsigned_goal)
    return 97 if unsigned_admitted

    # The unsigned operation can hide in a premise while the goal contains only
    # scalar equality. Its wrapping truth must not become signed inconsistency.
    unsigned_y: usize = add_node(&unsigned_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "y", "")
    unsigned_y_zero: usize = add_node(&unsigned_nodes, "binary", "==", unsigned_y, unsigned_zero, 0, 0, 0, 0, "", "")
    unsigned_y_sum: usize = add_node(&unsigned_nodes, "binary", "==", unsigned_y, unsigned_sum, 0, 0, 0, 0, "", "")
    unsigned_false_goal: usize = add_node(&unsigned_nodes, "binary", "==", unsigned_x, unsigned_zero, 0, 0, 0, 0, "", "")
    unsigned_wrap_facts: darray[usize] = [unsigned_lower, unsigned_marker, unsigned_upper, unsigned_equal, unsigned_y_zero, unsigned_y_sum]
    return 117 if proof_kernel_replay_goal_report(&unsigned_nodes, &unsigned_children, unsigned_wrap_facts, unsigned_false_goal)
    return 118 if not proof_kernel_replay_goal_report(&unsigned_nodes, &unsigned_children, unsigned_wrap_facts, unsigned_y_sum)

    unsigned_safe_max: usize = add_node(&unsigned_nodes, "int", "", 0, 0, 0, 0, 0, 254, "", "")
    unsigned_safe_x: usize = add_node(&unsigned_nodes, "binary", "==", unsigned_x, unsigned_safe_max, 0, 0, 0, 0, "", "")
    unsigned_safe_y: usize = add_node(&unsigned_nodes, "binary", "==", unsigned_y, unsigned_max, 0, 0, 0, 0, "", "")
    unsigned_safe_goal: usize = add_node(&unsigned_nodes, "binary", ">", unsigned_y, unsigned_x, 0, 0, 0, 0, "", "")
    return 119 if not proof_kernel_replay_goal_report(&unsigned_nodes, &unsigned_children, [unsigned_marker, unsigned_safe_x, unsigned_safe_y, unsigned_y_sum], unsigned_safe_goal)

    return 0
