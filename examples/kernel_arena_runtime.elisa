# Executable arena-admission soundness harness. It returns success only when the independent
# validator rejects malformed cycles, out-of-range edges and fact roots, malformed child slices,
# call children, excessive depth, unknown node kinds, and malformed resource places, while
# accepting a valid DAG with shared structure and hidden node metadata.
include "../src/proof/kernel_core.elisa"
include "../src/proof/kernel_replay.elisa"
using ElisaProofKernelCore
using ElisaProofKernelReplay

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    cycle_nodes: mutable darray[ProofKernelNode] = []
    cycle_children: mutable darray[usize] = []
    cycle_root: usize = add_node(&cycle_nodes, "unary", "not", 0, 0, 0, 0, 0, 0, "", "")
    cycle_admitted: bool = proof_kernel_replay_arena_report(&cycle_nodes, &cycle_children, [], cycle_root)
    return 1 if cycle_admitted

    edge_nodes: mutable darray[ProofKernelNode] = []
    edge_children: mutable darray[usize] = []
    edge_root: usize = add_node(&edge_nodes, "unary", "not", 1, 0, 0, 0, 0, 0, "", "")
    edge_admitted: bool = proof_kernel_replay_arena_report(&edge_nodes, &edge_children, [], edge_root)
    return 2 if edge_admitted

    call_nodes: mutable darray[ProofKernelNode] = []
    call_children: mutable darray[usize] = []
    callee: usize = add_node(&call_nodes, "int", "", 0, 0, 0, 0, 0, 7, "", "")
    call_root: usize = add_node(&call_nodes, "call", "", callee, 0, 0, 0, 1, 0, "", "")
    call_children.push(callee)
    call_admitted: bool = proof_kernel_replay_arena_report(&call_nodes, &call_children, [], call_root)
    return 3 if call_admitted

    fact_nodes: mutable darray[ProofKernelNode] = []
    fact_children: mutable darray[usize] = []
    fact_root: usize = add_node(&fact_nodes, "int", "", 0, 0, 0, 0, 0, 7, "", "")
    invalid_fact: darray[usize] = [fact_root + 1]
    fact_admitted: bool = proof_kernel_replay_arena_report(&fact_nodes, &fact_children, invalid_fact, fact_root)
    return 4 if fact_admitted

    slice_nodes: mutable darray[ProofKernelNode] = []
    slice_children: mutable darray[usize] = []
    slice_root: usize = add_node(&slice_nodes, "array", "", 0, 0, 0, 1, 1, 0, "", "")
    slice_admitted: bool = proof_kernel_replay_arena_report(&slice_nodes, &slice_children, [], slice_root)
    return 5 if slice_admitted

    unknown_nodes: mutable darray[ProofKernelNode] = []
    unknown_children: mutable darray[usize] = []
    unknown_root: usize = add_node(&unknown_nodes, "future-node-kind", "", 0, 0, 0, 0, 0, 0, "", "")
    unknown_admitted: bool = proof_kernel_replay_arena_report(&unknown_nodes, &unknown_children, [], unknown_root)
    return 6 if unknown_admitted

    shorthand_nodes: mutable darray[ProofKernelNode] = []
    shorthand_children: mutable darray[usize] = []
    shorthand_root: usize = add_node(&shorthand_nodes, "shorthand", "", 0, 0, 0, 0, 0, 0, "None", "")
    shorthand_admitted: bool = proof_kernel_replay_arena_report(&shorthand_nodes, &shorthand_children, [], shorthand_root)
    return 7 if not shorthand_admitted

    malformed_shorthand_nodes: mutable darray[ProofKernelNode] = []
    malformed_shorthand_children: mutable darray[usize] = []
    malformed_shorthand_root: usize = add_node(&malformed_shorthand_nodes, "shorthand", "", 1, 0, 0, 0, 0, 0, "None", "")
    malformed_shorthand_admitted: bool = proof_kernel_replay_arena_report(&malformed_shorthand_nodes, &malformed_shorthand_children, [], malformed_shorthand_root)
    return 8 if malformed_shorthand_admitted

    valid_slice_nodes: mutable darray[ProofKernelNode] = []
    valid_slice_children: mutable darray[usize] = []
    valid_slice_object: usize = add_node(&valid_slice_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "values", "")
    valid_slice_low: usize = add_node(&valid_slice_nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
    valid_slice_high: usize = add_node(&valid_slice_nodes, "absent", "", 0, 0, 0, 0, 0, 0, "", "")
    valid_slice_root: usize = add_node(&valid_slice_nodes, "slice", "", valid_slice_object, valid_slice_low, valid_slice_high, 0, 0, 0, "", "")
    valid_slice_admitted: bool = proof_kernel_replay_arena_report(&valid_slice_nodes, &valid_slice_children, [], valid_slice_root)
    return 9 if not valid_slice_admitted

    malformed_slice_nodes: mutable darray[ProofKernelNode] = []
    malformed_slice_children: mutable darray[usize] = []
    malformed_slice_object: usize = add_node(&malformed_slice_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "values", "")
    malformed_slice_low: usize = add_node(&malformed_slice_nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
    malformed_slice_high: usize = add_node(&malformed_slice_nodes, "absent", "", 0, 0, 0, 0, 0, 0, "", "")
    malformed_slice_root: usize = add_node(&malformed_slice_nodes, "slice", "", malformed_slice_object, malformed_slice_low, malformed_slice_high, 1, 0, 0, "", "")
    malformed_slice_admitted: bool = proof_kernel_replay_arena_report(&malformed_slice_nodes, &malformed_slice_children, [], malformed_slice_root)
    return 10 if malformed_slice_admitted

    valid_indexn_nodes: mutable darray[ProofKernelNode] = []
    valid_indexn_children: mutable darray[usize] = []
    valid_indexn_object: usize = add_node(&valid_indexn_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "matrix", "")
    valid_indexn_first: usize = add_node(&valid_indexn_nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
    valid_indexn_second: usize = add_node(&valid_indexn_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
    valid_indexn_children.push(valid_indexn_first)
    valid_indexn_children.push(valid_indexn_second)
    valid_indexn_root: usize = add_node(&valid_indexn_nodes, "index-n", "", valid_indexn_object, 0, 0, 0, 2, 0, "", "")
    valid_indexn_admitted: bool = proof_kernel_replay_arena_report(&valid_indexn_nodes, &valid_indexn_children, [], valid_indexn_root)
    return 11 if not valid_indexn_admitted

    malformed_indexn_nodes: mutable darray[ProofKernelNode] = []
    malformed_indexn_children: mutable darray[usize] = []
    malformed_indexn_object: usize = add_node(&malformed_indexn_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "matrix", "")
    malformed_indexn_child: usize = add_node(&malformed_indexn_nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
    malformed_indexn_children.push(malformed_indexn_child)
    malformed_indexn_root: usize = add_node(&malformed_indexn_nodes, "index-n", "", malformed_indexn_object, 0, 0, 0, 2, 0, "", "")
    malformed_indexn_admitted: bool = proof_kernel_replay_arena_report(&malformed_indexn_nodes, &malformed_indexn_children, [], malformed_indexn_root)
    return 12 if malformed_indexn_admitted

    deep_nodes: mutable darray[ProofKernelNode] = []
    deep_children: mutable darray[usize] = []
    deep_root: mutable usize = add_node(&deep_nodes, "int", "", 0, 0, 0, 0, 0, 7, "", "")
    for depth in 0..<128 |depth, deep_nodes, deep_root|:
        deep_root <- add_node(&deep_nodes, "unary", "not", deep_root, 0, 0, 0, 0, 0, "", "")
    deep_admitted: bool = proof_kernel_replay_arena_report(&deep_nodes, &deep_children, [], deep_root)
    return 13 if deep_admitted

    shared_nodes: mutable darray[ProofKernelNode] = []
    shared_children: mutable darray[usize] = []
    shared_leaf: usize = add_node(&shared_nodes, "int", "", 0, 0, 0, 0, 0, 7, "", "")
    shared_root: usize = add_node(&shared_nodes, "binary", "+", shared_leaf, shared_leaf, 0, 0, 0, 0, "", "")
    shared_admitted: bool = proof_kernel_replay_arena_report(&shared_nodes, &shared_children, [], shared_root)
    return 14 if not shared_admitted

    malformed_call_arg_nodes: mutable darray[ProofKernelNode] = []
    malformed_call_arg_children: mutable darray[usize] = []
    malformed_call_arg_callee: usize = add_node(&malformed_call_arg_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "callee", "")
    malformed_call_arg_value: usize = add_node(&malformed_call_arg_nodes, "int", "", 0, 0, 0, 0, 0, 7, "", "")
    malformed_call_arg: usize = add_node(&malformed_call_arg_nodes, "call_arg", "", malformed_call_arg_value, 0, 0, 0, 0, 0, "", "hidden")
    malformed_call_arg_children.push(malformed_call_arg)
    malformed_call_arg_root: usize = add_node(&malformed_call_arg_nodes, "call", "", malformed_call_arg_callee, 0, 0, 0, 1, 0, "", "")
    malformed_call_arg_admitted: bool = proof_kernel_replay_arena_report(&malformed_call_arg_nodes, &malformed_call_arg_children, [], malformed_call_arg_root)
    return 15 if malformed_call_arg_admitted

    malformed_binary_nodes: mutable darray[ProofKernelNode] = []
    malformed_binary_children: mutable darray[usize] = []
    malformed_binary_left: usize = add_node(&malformed_binary_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
    malformed_binary_right: usize = add_node(&malformed_binary_nodes, "int", "", 0, 0, 0, 0, 0, 2, "", "")
    malformed_binary_root: usize = add_node(&malformed_binary_nodes, "binary", "+", malformed_binary_left, malformed_binary_right, 0, 0, 0, 0, "hidden", "")
    malformed_binary_admitted: bool = proof_kernel_replay_arena_report(&malformed_binary_nodes, &malformed_binary_children, [], malformed_binary_root)
    return 16 if malformed_binary_admitted

    malformed_bool_nodes: mutable darray[ProofKernelNode] = []
    malformed_bool_children: mutable darray[usize] = []
    malformed_bool_root: usize = add_node(&malformed_bool_nodes, "bool", "", 0, 0, 0, 0, 0, 2, "", "")
    malformed_bool_admitted: bool = proof_kernel_replay_arena_report(&malformed_bool_nodes, &malformed_bool_children, [], malformed_bool_root)
    return 17 if malformed_bool_admitted

    # A resource trace may contain a structurally valid dynamic index node, but the resource
    # kernel must not mistake that symbolic selector for a closed path component. This is a
    # deliberate hostile certificate: arena admission succeeds, logical resource replay must
    # still reject it because only constant indexes are in the v1 place language.
    dynamic_resource_nodes: mutable darray[ProofKernelNode] = []
    dynamic_resource_children: mutable darray[usize] = []
    dynamic_resource_parameter: usize = add_node(&dynamic_resource_nodes, "resource-bind", "external-mutable", 0, 0, 1, 0, 0, 0, "values", "")
    dynamic_resource_object: usize = add_node(&dynamic_resource_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "values", "")
    dynamic_resource_index: usize = add_node(&dynamic_resource_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "i", "")
    dynamic_resource_place: usize = add_node(&dynamic_resource_nodes, "index", "", dynamic_resource_object, dynamic_resource_index, 0, 0, 0, 0, "", "")
    dynamic_resource_borrow: usize = add_node(&dynamic_resource_nodes, "resource-bind", "shared", dynamic_resource_place, 0, 0, 0, 0, 0, "alias", "values")
    dynamic_resource_children.push(dynamic_resource_parameter)
    dynamic_resource_children.push(dynamic_resource_borrow)
    dynamic_resource_root: usize = add_node(&dynamic_resource_nodes, "resource-safety", "", 0, 0, 1, 0, 2, 0, "dynamic", "resource-v1")
    dynamic_resource_admitted: bool = proof_kernel_replay_resource_report(&dynamic_resource_nodes, &dynamic_resource_children, [], dynamic_resource_root)
    return 18 if dynamic_resource_admitted

    # Conversely, two closed literal paths into an externally mutable root are disjoint, so the
    # same independent rules should accept a shared borrow of values[0] and a mutable borrow of
    # values[1]. This protects the exact-index improvement from regressing to whole-root aliasing.
    indexed_resource_nodes: mutable darray[ProofKernelNode] = []
    indexed_resource_children: mutable darray[usize] = []
    indexed_resource_parameter: usize = add_node(&indexed_resource_nodes, "resource-bind", "external-mutable", 0, 0, 1, 0, 0, 0, "values", "")
    indexed_resource_object_zero: usize = add_node(&indexed_resource_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "values", "")
    indexed_resource_zero: usize = add_node(&indexed_resource_nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
    indexed_resource_place_zero: usize = add_node(&indexed_resource_nodes, "index", "", indexed_resource_object_zero, indexed_resource_zero, 0, 0, 0, 0, "", "")
    indexed_resource_shared: usize = add_node(&indexed_resource_nodes, "resource-bind", "shared", indexed_resource_place_zero, 0, 0, 0, 0, 0, "shared_zero", "values")
    indexed_resource_object_one: usize = add_node(&indexed_resource_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "values", "")
    indexed_resource_one: usize = add_node(&indexed_resource_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
    indexed_resource_place_one: usize = add_node(&indexed_resource_nodes, "index", "", indexed_resource_object_one, indexed_resource_one, 0, 0, 0, 0, "", "")
    indexed_resource_mutable: usize = add_node(&indexed_resource_nodes, "resource-bind", "mutable", indexed_resource_place_one, 0, 1, 0, 0, 0, "mutable_one", "values")
    indexed_resource_children.push(indexed_resource_parameter)
    indexed_resource_children.push(indexed_resource_shared)
    indexed_resource_children.push(indexed_resource_mutable)
    indexed_resource_root: usize = add_node(&indexed_resource_nodes, "resource-safety", "", 0, 0, 1, 0, 3, 0, "indexed", "resource-v1")
    indexed_resource_admitted: bool = proof_kernel_replay_resource_report(&indexed_resource_nodes, &indexed_resource_children, [], indexed_resource_root)
    return 19 if not indexed_resource_admitted
    return 0
