    region_alias_reopened_root: usize = add_node(&region_alias_reopened_nodes, "resource-safety", "", 0, 0, 0, 0, 6, 0, "region-alias-reopened", "resource-v1")
    region_alias_reopened_admitted: bool = proof_kernel_replay_resource_report(&region_alias_reopened_nodes, &region_alias_reopened_children, [], region_alias_reopened_root)
    return 28 if region_alias_reopened_admitted

    # A valid region-polymorphic call carries an explicit formal/actual map. Its returned
    # reference is admitted only when the callee's region-return summary agrees with the mapped
    # live caller region; the following certificate changes only that result label and must fail.
    generic_call_nodes: mutable darray[ProofKernelNode] = []
    generic_call_children: mutable darray[usize] = []
    generic_region_param: usize = add_node(&generic_call_nodes, "resource-region-param", "external", 0, 0, 0, 0, 0, 0, "r", "")
    generic_owner: usize = add_node(&generic_call_nodes, "resource-bind", "external-shared", 0, 0, 0, 0, 0, 0, "owner", "r")
    generic_value: usize = add_node(&generic_call_nodes, "resource-bind", "value", 0, 0, 0, 0, 0, 0, "value", "")
    generic_return_value: usize = add_node(&generic_call_nodes, "int", "", 0, 0, 0, 0, 0, 9, "", "")
    generic_return_alloc: usize = add_node(&generic_call_nodes, "resource-region-return-alloc", "", generic_return_value, 0, 0, 0, 0, 0, "", "r")
    generic_return: usize = add_node(&generic_call_nodes, "resource-region-return", "param", 0, 0, 0, 0, 0, 0, "r", "")
    generic_callee_children_start: usize = generic_call_children.count
    generic_call_children.push(generic_region_param)
    generic_call_children.push(generic_owner)
    generic_call_children.push(generic_value)
    generic_call_children.push(generic_return_alloc)
    generic_call_children.push(generic_return)
    generic_callee: usize = add_node(&generic_call_nodes, "resource-safety", "", 0, 0, 2, generic_callee_children_start, 5, 0, "make", "resource-v1")
    generic_caller_open: usize = add_node(&generic_call_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "scratch", "")
    generic_seed_value: usize = add_node(&generic_call_nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
    generic_seed_alloc: usize = add_node(&generic_call_nodes, "resource-region-alloc", "", generic_seed_value, 0, 2, 0, 0, 0, "seed", "scratch")
    generic_seed_place: usize = add_node(&generic_call_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "seed", "")
    generic_call_arg_owner: usize = add_node(&generic_call_nodes, "resource-call-arg", "reference", generic_seed_place, 0, 0, 0, 0, 0, "owner", "")
    generic_call_arg_value: usize = add_node(&generic_call_nodes, "resource-call-arg", "value", generic_seed_value, 0, 0, 0, 0, 0, "value", "")
    generic_call_region: usize = add_node(&generic_call_nodes, "resource-call-region", "param", 0, 0, 0, 0, 0, 0, "r", "scratch")
    generic_call_children_start: usize = generic_call_children.count
    generic_call_children.push(generic_call_arg_owner)
    generic_call_children.push(generic_call_arg_value)
    generic_call_children.push(generic_call_region)
    generic_call: usize = add_node(&generic_call_nodes, "resource-call", "", generic_callee, 1, 2, generic_call_children_start, 3, 0, "make", "")
    generic_result: usize = add_node(&generic_call_nodes, "resource-call-result", "", generic_call, 0, 2, 0, 0, 0, "value", "scratch")
    generic_close: usize = add_node(&generic_call_nodes, "resource-region-close", "", 0, 0, 0, 0, 0, 0, "scratch", "")
    generic_caller_children_start: usize = generic_call_children.count
    generic_call_children.push(generic_caller_open)
    generic_call_children.push(generic_seed_alloc)
    generic_call_children.push(generic_call)
    generic_call_children.push(generic_result)
    generic_call_children.push(generic_close)
    generic_caller: usize = add_node(&generic_call_nodes, "resource-safety", "", 0, 0, 0, generic_caller_children_start, 5, 0, "caller", "resource-v1")
    generic_callee_admitted: bool = proof_kernel_replay_resource_report(&generic_call_nodes, &generic_call_children, [], generic_callee)
    return 31 if not generic_callee_admitted
    generic_setup: usize = add_node(&generic_call_nodes, "resource-safety", "", 0, 0, 0, generic_caller_children_start, 2, 0, "setup", "resource-v1")
    generic_setup_admitted: bool = proof_kernel_replay_resource_report(&generic_call_nodes, &generic_call_children, [], generic_setup)
    return 34 if not generic_setup_admitted
    generic_call_prefix: usize = add_node(&generic_call_nodes, "resource-safety", "", 0, 0, 0, generic_caller_children_start, 3, 0, "call-prefix", "resource-v1")
    generic_call_prefix_admitted: bool = proof_kernel_replay_resource_report(&generic_call_nodes, &generic_call_children, [], generic_call_prefix)
    return 32 if not generic_call_prefix_admitted
    generic_call_admitted: bool = proof_kernel_replay_resource_report(&generic_call_nodes, &generic_call_children, [], generic_caller)
    return 29 if not generic_call_admitted
    forged_generic_result: usize = add_node(&generic_call_nodes, "resource-call-result", "", generic_call, 0, 2, 0, 0, 0, "value", "wrong-region")
    forged_generic_children_start: usize = generic_call_children.count
    generic_call_children.push(generic_caller_open)
    generic_call_children.push(generic_seed_alloc)
    generic_call_children.push(generic_call)
    generic_call_children.push(forged_generic_result)
    generic_call_children.push(generic_close)
    forged_generic_caller: usize = add_node(&generic_call_nodes, "resource-safety", "", 0, 0, 0, forged_generic_children_start, 5, 0, "forged-caller", "resource-v1")
    forged_generic_result_admitted: bool = proof_kernel_replay_resource_report(&generic_call_nodes, &generic_call_children, [], forged_generic_caller)
    return 30 if forged_generic_result_admitted

    return 0
