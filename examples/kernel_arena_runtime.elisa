    # Region rebinding is a write to the target binding. It may not resurrect a moved target.
    illegal_region_nodes: mutable darray[ProofKernelNode] = []
    illegal_region_children: mutable darray[usize] = []
    illegal_region_open: usize = add_node(&illegal_region_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "r", "")
    illegal_region_source_value: usize = add_node(&illegal_region_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
    illegal_region_source: usize = add_node(&illegal_region_nodes, "resource-region-alloc", "", illegal_region_source_value, 0, 2, 0, 0, 0, "source", "r")
    illegal_region_target_value: usize = add_node(&illegal_region_nodes, "int", "", 0, 0, 0, 0, 0, 2, "", "")
    illegal_region_target: usize = add_node(&illegal_region_nodes, "resource-region-alloc", "", illegal_region_target_value, 0, 2, 0, 0, 0, "target", "r")
    illegal_region_target_place: usize = add_node(&illegal_region_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "target", "")
    illegal_region_move: usize = add_node(&illegal_region_nodes, "resource-move", "", illegal_region_target_place, 0, 0, 0, 0, 0, "target", "")
    illegal_region_source_place: usize = add_node(&illegal_region_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "source", "")
    illegal_region_assign: usize = add_node(&illegal_region_nodes, "resource-region-assign", "", illegal_region_source_place, 0, 0, 0, 0, 0, "target", "r")
    illegal_region_children.push(illegal_region_open)
    illegal_region_children.push(illegal_region_source)
    illegal_region_children.push(illegal_region_target)
    illegal_region_children.push(illegal_region_move)
    illegal_region_children.push(illegal_region_assign)
    illegal_region_root: usize = add_node(&illegal_region_nodes, "resource-safety", "", 0, 0, 0, 0, 5, 0, "illegal-region-rebind", "resource-v1")
    illegal_region_admitted: bool = proof_kernel_replay_resource_report(&illegal_region_nodes, &illegal_region_children, [], illegal_region_root)
    return 47 if illegal_region_admitted

    # A fresh region allocation also cannot overwrite a root while any overlapping borrow is live.
    illegal_borrow_nodes: mutable darray[ProofKernelNode] = []
    illegal_borrow_children: mutable darray[usize] = []
    illegal_borrow_open: usize = add_node(&illegal_borrow_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "r", "")
    illegal_borrow_owner_value: usize = add_node(&illegal_borrow_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
    illegal_borrow_owner: usize = add_node(&illegal_borrow_nodes, "resource-region-alloc", "", illegal_borrow_owner_value, 0, 2, 0, 0, 0, "owner", "r")
    illegal_borrow_place: usize = add_node(&illegal_borrow_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "owner", "")
    illegal_borrow_alias: usize = add_node(&illegal_borrow_nodes, "resource-bind", "shared", illegal_borrow_place, 0, 0, 0, 0, 0, "alias", "owner")
    illegal_borrow_replacement_value: usize = add_node(&illegal_borrow_nodes, "int", "", 0, 0, 0, 0, 0, 2, "", "")
    illegal_borrow_replacement: usize = add_node(&illegal_borrow_nodes, "resource-region-rebind-alloc", "", illegal_borrow_replacement_value, 0, 0, 0, 0, 0, "owner", "r")
    illegal_borrow_children.push(illegal_borrow_open)
    illegal_borrow_children.push(illegal_borrow_owner)
    illegal_borrow_children.push(illegal_borrow_alias)
    illegal_borrow_children.push(illegal_borrow_replacement)
    illegal_borrow_root: usize = add_node(&illegal_borrow_nodes, "resource-safety", "", 0, 0, 0, 0, 4, 0, "illegal-borrow-rebind", "resource-v1")
    illegal_borrow_admitted: bool = proof_kernel_replay_resource_report(&illegal_borrow_nodes, &illegal_borrow_children, [], illegal_borrow_root)
    return 48 if illegal_borrow_admitted

    # A return-region marker must be backed by an exact replayed resource transition. A naked
    # marker, or a marker attached to an ordinary scalar use, cannot manufacture a reference.
    naked_return_nodes: mutable darray[ProofKernelNode] = []
    naked_return_children: mutable darray[usize] = []
    naked_return_param: usize = add_node(&naked_return_nodes, "resource-region-param", "external", 0, 0, 0, 0, 0, 0, "r", "")
    naked_return_marker: usize = add_node(&naked_return_nodes, "resource-region-return", "param", 0, 0, 0, 0, 0, 0, "r", "")
    naked_return_children.push(naked_return_param)
    naked_return_children.push(naked_return_marker)
    naked_return_root: usize = add_node(&naked_return_nodes, "resource-safety", "", 0, 0, 0, 0, 2, 0, "naked-return", "resource-v1")
    naked_return_admitted: bool = proof_kernel_replay_resource_report(&naked_return_nodes, &naked_return_children, [], naked_return_root)
    return 49 if naked_return_admitted

    forged_scalar_return_nodes: mutable darray[ProofKernelNode] = []
    forged_scalar_return_children: mutable darray[usize] = []
    forged_scalar_return_param: usize = add_node(&forged_scalar_return_nodes, "resource-region-param", "external", 0, 0, 0, 0, 0, 0, "r", "")
    forged_scalar_return_owner: usize = add_node(&forged_scalar_return_nodes, "resource-bind", "external-shared", 0, 0, 0, 0, 0, 0, "owner", "r")
    forged_scalar_return_bind: usize = add_node(&forged_scalar_return_nodes, "resource-bind", "value", 0, 0, 0, 0, 0, 0, "scalar", "")
    forged_scalar_return_place: usize = add_node(&forged_scalar_return_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "scalar", "")
    forged_scalar_return_use: usize = add_node(&forged_scalar_return_nodes, "resource-use", "", forged_scalar_return_place, 0, 0, 0, 0, 0, "scalar", "")
    forged_scalar_return_marker: usize = add_node(&forged_scalar_return_nodes, "resource-region-return", "param", forged_scalar_return_use, 0, 0, 0, 0, 0, "r", "")
    forged_scalar_return_children.push(forged_scalar_return_param)
    forged_scalar_return_children.push(forged_scalar_return_owner)
    forged_scalar_return_children.push(forged_scalar_return_bind)
    forged_scalar_return_children.push(forged_scalar_return_use)
    forged_scalar_return_children.push(forged_scalar_return_marker)
    forged_scalar_return_root: usize = add_node(&forged_scalar_return_nodes, "resource-safety", "", 0, 0, 0, 0, 5, 0, "forged-scalar-return", "resource-v1")
    forged_scalar_return_admitted: bool = proof_kernel_replay_resource_report(&forged_scalar_return_nodes, &forged_scalar_return_children, [], forged_scalar_return_root)
    return 50 if forged_scalar_return_admitted

    # A returned allocation cannot hide a region-owned operand behind a valid allocation and
    # return witness. The operand itself must be region-free; otherwise a shorter lifetime could
    # be smuggled into storage owned by the external region.
    nested_return_nodes: mutable darray[ProofKernelNode] = []
    nested_return_children: mutable darray[usize] = []
    nested_return_param: usize = add_node(&nested_return_nodes, "resource-region-param", "external", 0, 0, 0, 0, 0, 0, "r", "")
    nested_return_owner: usize = add_node(&nested_return_nodes, "resource-bind", "external-shared", 0, 0, 0, 0, 0, 0, "owner", "r")
    nested_return_owner_place: usize = add_node(&nested_return_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "owner", "")
    nested_return_alloc: usize = add_node(&nested_return_nodes, "resource-region-return-alloc", "", nested_return_owner_place, 0, 0, 0, 0, 0, "", "r")
    nested_return_marker: usize = add_node(&nested_return_nodes, "resource-region-return", "param", nested_return_alloc, 0, 0, 0, 0, 0, "r", "")
    nested_return_children.push(nested_return_param)
    nested_return_children.push(nested_return_owner)
    nested_return_children.push(nested_return_alloc)
    nested_return_children.push(nested_return_marker)
    nested_return_root: usize = add_node(&nested_return_nodes, "resource-safety", "", 0, 0, 0, 0, 4, 0, "nested-region-return", "resource-v1")
    nested_return_admitted: bool = proof_kernel_replay_resource_report(&nested_return_nodes, &nested_return_children, [], nested_return_root)
    return 51 if nested_return_admitted

    # Rewriting under a quantifier body is rejected until the arena has binding-aware names.
    # Otherwise a free replacement name can be captured by the body's binder (`y == x` under
    # `forall x`), changing the proposition rather than applying a valid equality congruence.
    rewrite_nodes: mutable darray[ProofKernelNode] = []
    rewrite_children: mutable darray[usize] = []
    rewrite_x: usize = add_node(&rewrite_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "x", "")
    rewrite_y: usize = add_node(&rewrite_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "y", "")
    rewrite_zero: usize = add_node(&rewrite_nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
    rewrite_one: usize = add_node(&rewrite_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
    rewrite_children.push(rewrite_zero)
    rewrite_children.push(rewrite_one)
    rewrite_range: usize = add_node(&rewrite_nodes, "array", "", 0, 0, 0, 0, 2, 0, "", "")
    rewrite_fact: usize = add_node(&rewrite_nodes, "binary", "==", rewrite_y, rewrite_x, 0, 0, 0, 0, "", "")
    rewrite_before_body: usize = add_node(&rewrite_nodes, "binary", "==", rewrite_y, rewrite_x, 0, 0, 0, 0, "", "")
    rewrite_after_body: usize = add_node(&rewrite_nodes, "binary", "==", rewrite_x, rewrite_x, 0, 0, 0, 0, "", "")
    rewrite_before_goal: usize = add_node(&rewrite_nodes, "quantifier", "forall", rewrite_range, rewrite_before_body, 1, 0, 0, 0, "x", "")
    rewrite_after_goal: usize = add_node(&rewrite_nodes, "quantifier", "forall", rewrite_range, rewrite_after_body, 1, 0, 0, 0, "x", "")
    rewrite_facts: darray[usize] = [rewrite_fact]
    rewrite_step_admitted: bool = proof_kernel_replay_tactic_step(&rewrite_nodes, &rewrite_children, "rewrite", true, false, false, rewrite_facts, rewrite_before_goal, rewrite_facts, rewrite_after_goal, rewrite_y, true, rewrite_x, true, 0, false, "")
    return 40 if rewrite_step_admitted

    # The affine normalizer must not turn the false fixed-value equality
    # `5 - (3 - x) == x + 8` into a proof when x == 0. Its left side is 2 and its right side is 8.
    affine_nodes: mutable darray[ProofKernelNode] = []
    affine_children: mutable darray[usize] = []
    affine_x: usize = add_node(&affine_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "x", "")
    affine_zero: usize = add_node(&affine_nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
    affine_three: usize = add_node(&affine_nodes, "int", "", 0, 0, 0, 0, 0, 3, "", "")
    affine_five: usize = add_node(&affine_nodes, "int", "", 0, 0, 0, 0, 0, 5, "", "")
    affine_eight: usize = add_node(&affine_nodes, "int", "", 0, 0, 0, 0, 0, 8, "", "")
    affine_fact: usize = add_node(&affine_nodes, "binary", "==", affine_x, affine_zero, 0, 0, 0, 0, "", "")
    affine_inner: usize = add_node(&affine_nodes, "binary", "-", affine_three, affine_x, 0, 0, 0, 0, "", "")
    affine_left: usize = add_node(&affine_nodes, "binary", "-", affine_five, affine_inner, 0, 0, 0, 0, "", "")
    affine_right: usize = add_node(&affine_nodes, "binary", "+", affine_x, affine_eight, 0, 0, 0, 0, "", "")
    affine_goal: usize = add_node(&affine_nodes, "binary", "==", affine_left, affine_right, 0, 0, 0, 0, "", "")
    affine_admitted: bool = proof_kernel_replay_goal_report(&affine_nodes, &affine_children, [affine_fact], affine_goal)
    return 41 if affine_admitted

    # Instantiation must preserve the goal and must reject substitution through a nested binder.
    # Replacing outer x with y under `forall y` would capture the free y from the chosen value.
    instantiate_nodes: mutable darray[ProofKernelNode] = []
    instantiate_children: mutable darray[usize] = []
    instantiate_x: usize = add_node(&instantiate_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "x", "")
    instantiate_y: usize = add_node(&instantiate_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "y", "")
    instantiate_zero: usize = add_node(&instantiate_nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
    instantiate_range_start: usize = instantiate_children.count
    instantiate_children.push(instantiate_y)
    instantiate_range: usize = add_node(&instantiate_nodes, "array", "", 0, 0, 0, instantiate_range_start, 1, 0, "", "")
    instantiate_inner_range_start: usize = instantiate_children.count
    instantiate_children.push(instantiate_zero)
    instantiate_inner_range: usize = add_node(&instantiate_nodes, "array", "", 0, 0, 0, instantiate_inner_range_start, 1, 0, "", "")
    instantiate_body: usize = add_node(&instantiate_nodes, "binary", "==", instantiate_x, instantiate_y, 0, 0, 0, 0, "", "")
    instantiate_nested: usize = add_node(&instantiate_nodes, "quantifier", "forall", instantiate_inner_range, instantiate_body, 1, 0, 0, 0, "y", "")
    instantiate_outer: usize = add_node(&instantiate_nodes, "quantifier", "forall", instantiate_range, instantiate_nested, 1, 0, 0, 0, "x", "")
    instantiate_goal: usize = add_node(&instantiate_nodes, "bool", "", 0, 0, 0, 0, 0, 1, "", "")
    instantiate_facts: darray[usize] = [instantiate_outer]
    instantiate_step_admitted: bool = proof_kernel_replay_tactic_step(&instantiate_nodes, &instantiate_children, "instantiate", true, false, false, instantiate_facts, instantiate_goal, instantiate_facts, instantiate_goal, instantiate_y, true, 0, false, 0, true, "forall")
    return 42 if instantiate_step_admitted

    simple_instantiate_range_start: usize = instantiate_children.count
    instantiate_children.push(instantiate_zero)
    simple_instantiate_range: usize = add_node(&instantiate_nodes, "array", "", 0, 0, 0, simple_instantiate_range_start, 1, 0, "", "")
    simple_instantiate_body: usize = add_node(&instantiate_nodes, "binary", "==", instantiate_zero, instantiate_zero, 0, 0, 0, 0, "", "")
    simple_instantiate_outer: usize = add_node(&instantiate_nodes, "quantifier", "forall", simple_instantiate_range, simple_instantiate_body, 1, 0, 0, 0, "z", "")
    forged_goal: usize = add_node(&instantiate_nodes, "bool", "", 0, 0, 0, 0, 0, 0, "", "")
    simple_instantiate_before_facts: darray[usize] = [simple_instantiate_outer]
    simple_instantiate_after_facts: darray[usize] = [simple_instantiate_outer, simple_instantiate_body]
    forged_goal_step_admitted: bool = proof_kernel_replay_tactic_step(&instantiate_nodes, &instantiate_children, "instantiate", true, false, false, simple_instantiate_before_facts, instantiate_goal, simple_instantiate_after_facts, forged_goal, instantiate_zero, true, 0, false, 0, true, "forall")
    return 43 if forged_goal_step_admitted

    # Auxiliary tactic roots are independently serialized. A numeric root check alone would
    # let an out-of-snapshot malformed scalar act as an instantiation witness.
    malformed_instantiate_argument: usize = add_node(&instantiate_nodes, "int", "hidden", 0, 0, 0, 0, 0, 0, "", "")
    malformed_argument_step_admitted: bool = proof_kernel_replay_tactic_step(&instantiate_nodes, &instantiate_children, "instantiate", true, false, false, simple_instantiate_before_facts, instantiate_goal, simple_instantiate_after_facts, forged_goal, malformed_instantiate_argument, true, 0, false, 0, true, "forall")
    return 74 if malformed_argument_step_admitted

    # The action label cannot promote an existential fact to a universal one. The selected
    # arena node's bound quantifier kind is authoritative for independent tactic replay.
    existential_instantiate_nodes: mutable darray[ProofKernelNode] = []
    existential_instantiate_children: mutable darray[usize] = []
    existential_instantiate_value: usize = add_node(&existential_instantiate_nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
    existential_instantiate_children.push(existential_instantiate_value)
    existential_instantiate_range: usize = add_node(&existential_instantiate_nodes, "array", "", 0, 0, 0, 0, 1, 0, "", "")
    existential_instantiate_body: usize = add_node(&existential_instantiate_nodes, "binary", "==", existential_instantiate_value, existential_instantiate_value, 0, 0, 0, 0, "", "")
    existential_instantiate_fact: usize = add_node(&existential_instantiate_nodes, "quantifier", "exists", existential_instantiate_range, existential_instantiate_body, 1, 0, 0, 0, "x", "")
    existential_instantiate_goal: usize = add_node(&existential_instantiate_nodes, "bool", "", 0, 0, 0, 0, 0, 1, "", "")
    existential_instantiate_facts: darray[usize] = [existential_instantiate_fact]
    existential_instantiate_after: darray[usize] = [existential_instantiate_fact, existential_instantiate_body]
    existential_instantiate_admitted: bool = proof_kernel_replay_tactic_step(&existential_instantiate_nodes, &existential_instantiate_children, "instantiate", true, false, false, existential_instantiate_facts, existential_instantiate_goal, existential_instantiate_after, existential_instantiate_goal, existential_instantiate_value, true, 0, false, 0, true, "forall")
    return 80 if existential_instantiate_admitted

    # A nested scope cannot hide destruction of an inherited region. Without this check, the
    # copied child state would close r and then be discarded, allowing the parent to use value.
    nested_region_nodes: mutable darray[ProofKernelNode] = []
    nested_region_children: mutable darray[usize] = []
    nested_region_open: usize = add_node(&nested_region_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "r", "")
    nested_region_value: usize = add_node(&nested_region_nodes, "int", "", 0, 0, 0, 0, 0, 7, "", "")
    nested_region_alloc: usize = add_node(&nested_region_nodes, "resource-region-alloc", "", nested_region_value, 0, 0, 0, 0, 0, "value", "r")
    nested_region_close: usize = add_node(&nested_region_nodes, "resource-region-close", "", 0, 0, 0, 0, 0, 0, "r", "")
    nested_region_scope_start: usize = nested_region_children.count
    nested_region_children.push(nested_region_close)
    nested_region_scope: usize = add_node(&nested_region_nodes, "resource-scope", "", 0, 0, 0, nested_region_scope_start, 1, 0, "", "")
    nested_region_place: usize = add_node(&nested_region_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "value", "")
    nested_region_use: usize = add_node(&nested_region_nodes, "resource-use", "", nested_region_place, 0, 0, 0, 0, 0, "value", "")
    nested_region_report_start: usize = nested_region_children.count
    nested_region_children.push(nested_region_open)
    nested_region_children.push(nested_region_alloc)
    nested_region_children.push(nested_region_scope)
    nested_region_children.push(nested_region_use)
    nested_region_report: usize = add_node(&nested_region_nodes, "resource-safety", "", 0, 0, 0, nested_region_report_start, 4, 0, "nested-region-close", "resource-v1")
    nested_region_admitted: bool = proof_kernel_replay_resource_report(&nested_region_nodes, &nested_region_children, [], nested_region_report)
    return 44 if nested_region_admitted

    # A moved inherited binding must be joined back into the parent state. Without a pending
    # join obligation, the child snapshot could consume owner and the parent would later reuse it.
    nested_move_nodes: mutable darray[ProofKernelNode] = []
    nested_move_children: mutable darray[usize] = []
    nested_move_owner: usize = add_node(&nested_move_nodes, "resource-bind", "value", 0, 0, 0, 0, 0, 0, "owner", "")
    nested_move_place: usize = add_node(&nested_move_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "owner", "")
    nested_move_event: usize = add_node(&nested_move_nodes, "resource-move", "", nested_move_place, 0, 0, 0, 0, 0, "owner", "")
    nested_move_child_start: usize = nested_move_children.count
    nested_move_children.push(nested_move_event)
    nested_move_scope: usize = add_node(&nested_move_nodes, "resource-scope", "", 0, 0, 0, nested_move_child_start, 1, 0, "", "")
    nested_move_use_place: usize = add_node(&nested_move_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "owner", "")
    nested_move_use: usize = add_node(&nested_move_nodes, "resource-use", "", nested_move_use_place, 0, 0, 0, 0, 0, "owner", "")
    nested_move_report_start: usize = nested_move_children.count
    nested_move_children.push(nested_move_owner)
    nested_move_children.push(nested_move_scope)
    nested_move_children.push(nested_move_use)
    nested_move_report: usize = add_node(&nested_move_nodes, "resource-safety", "", 0, 0, 0, nested_move_report_start, 3, 0, "nested-move-without-join", "resource-v1")
    nested_move_admitted: bool = proof_kernel_replay_resource_report(&nested_move_nodes, &nested_move_children, [], nested_move_report)
    return 45 if nested_move_admitted

    # The producer's slot-qualified join is the valid counterpart and must still replay.
    joined_move_nodes: mutable darray[ProofKernelNode] = []
    joined_move_children: mutable darray[usize] = []
    joined_move_owner: usize = add_node(&joined_move_nodes, "resource-bind", "value", 0, 0, 0, 0, 0, 0, "owner", "")
    joined_move_place: usize = add_node(&joined_move_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "owner", "")
    joined_move_event: usize = add_node(&joined_move_nodes, "resource-move", "", joined_move_place, 0, 0, 0, 0, 0, "owner", "")
    joined_move_child_start: usize = joined_move_children.count
    joined_move_children.push(joined_move_event)
    joined_move_scope: usize = add_node(&joined_move_nodes, "resource-scope", "", 0, 0, 0, joined_move_child_start, 1, 0, "", "")
    joined_move_join: usize = add_node(&joined_move_nodes, "resource-join-move", "", 0, 0, 0, 0, 0, 0, "owner", "")
    joined_move_report_start: usize = joined_move_children.count
    joined_move_children.push(joined_move_owner)
    joined_move_children.push(joined_move_scope)
    joined_move_children.push(joined_move_join)
    joined_move_report: usize = add_node(&joined_move_nodes, "resource-safety", "", 0, 0, 0, joined_move_report_start, 3, 0, "nested-move-with-join", "resource-v1")
    joined_move_admitted: bool = proof_kernel_replay_resource_report(&joined_move_nodes, &joined_move_children, [], joined_move_report)
    return 46 if not joined_move_admitted

    # Whole-binding writes and region replacement/assignment must honor the serialized
    # writability bit independently of the source checker. Otherwise a forged certificate
    # could mutate an immutable binding while still passing resource replay.
    immutable_write_nodes: mutable darray[ProofKernelNode] = []
    immutable_write_children: mutable darray[usize] = []
    immutable_write_owner: usize = add_node(&immutable_write_nodes, "resource-bind", "value", 0, 0, 0, 0, 0, 0, "owner", "")
    immutable_write_place: usize = add_node(&immutable_write_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "owner", "")
    immutable_write_event: usize = add_node(&immutable_write_nodes, "resource-write", "", immutable_write_place, 0, 0, 0, 0, 0, "owner", "")
    immutable_write_children.push(immutable_write_owner)
    immutable_write_children.push(immutable_write_event)
    immutable_write_root: usize = add_node(&immutable_write_nodes, "resource-safety", "", 0, 0, 0, 0, 2, 0, "immutable-write", "resource-v1")
    immutable_write_admitted: bool = proof_kernel_replay_resource_report(&immutable_write_nodes, &immutable_write_children, [], immutable_write_root)
    return 54 if immutable_write_admitted

    mutable_write_nodes: mutable darray[ProofKernelNode] = []
    mutable_write_children: mutable darray[usize] = []
    mutable_write_owner: usize = add_node(&mutable_write_nodes, "resource-bind", "value", 0, 0, 1, 0, 0, 0, "owner", "")
    mutable_write_place: usize = add_node(&mutable_write_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "owner", "")
