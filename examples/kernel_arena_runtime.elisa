    region_reopened_children.push(region_reopened_open)
    region_reopened_children.push(region_reopened_alloc)
    region_reopened_children.push(region_reopened_close)
    region_reopened_children.push(region_reopened_again)
    region_reopened_children.push(region_reopened_use)
    region_reopened_root: usize = add_node(&region_reopened_nodes, "resource-safety", "", 0, 0, 0, 0, 5, 0, "region-reopened", "resource-v1")
    region_reopened_admitted: bool = proof_kernel_replay_resource_report(&region_reopened_nodes, &region_reopened_children, [], region_reopened_root)
    return 27 if region_reopened_admitted

    region_alias_reopened_nodes: mutable darray[ProofKernelNode] = []
    region_alias_reopened_children: mutable darray[usize] = []
    region_alias_reopened_open: usize = add_node(&region_alias_reopened_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "r", "")
    region_alias_reopened_operand: usize = add_node(&region_alias_reopened_nodes, "int", "", 0, 0, 0, 0, 0, 7, "", "")
    region_alias_reopened_alloc: usize = add_node(&region_alias_reopened_nodes, "resource-region-alloc", "", region_alias_reopened_operand, 0, 2, 0, 0, 0, "value", "r")
