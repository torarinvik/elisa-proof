# Executable arena-admission soundness harness. It returns success only when the independent
# validator rejects malformed cycles, out-of-range edges and fact roots, malformed child slices,
# call children, excessive depth, unknown node kinds, malformed resource places, stale region
# transitions, overlapping mutable call arguments, and width-unsafe unsigned arithmetic goals,
# while accepting valid DAGs and a balanced region trace.
include "../src/proof/kernel_core.elisa"
include "../src/proof/kernel_replay.elisa"
using ElisaProofKernelCore
using ElisaProofKernelReplay

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    float_nodes: mutable darray[ProofKernelNode] = []
    float_children: mutable darray[usize] = []
    float_value: usize = add_node(&float_nodes, "float", "", 0, 0, 0, 0, 0, 0, "1e308", "")
    float_infinity: usize = add_node(&float_nodes, "binary", "+", float_value, float_value, 0, 0, 0, 0, "", "")
    float_nan: usize = add_node(&float_nodes, "binary", "-", float_infinity, float_infinity, 0, 0, 0, 0, "", "")
    float_goal: usize = add_node(&float_nodes, "binary", "==", float_nan, float_nan, 0, 0, 0, 0, "", "")
    return 116 if proof_kernel_replay_goal_report(&float_nodes, &float_children, [], float_goal)

    cycle_nodes: mutable darray[ProofKernelNode] = []
    cycle_children: mutable darray[usize] = []
    cycle_root: usize = add_node(&cycle_nodes, "unary", "not", 0, 0, 0, 0, 0, 0, "", "")
    cycle_admitted: bool = proof_kernel_replay_arena_report(&cycle_nodes, &cycle_children, [], cycle_root)
    return 1 if cycle_admitted
    cycle_all_admitted: bool = proof_kernel_replay_arena_all_report(&cycle_nodes, &cycle_children)
    return 126 if cycle_all_admitted

    malformed_resource_nodes: mutable darray[ProofKernelNode] = []
    malformed_resource_children: mutable darray[usize] = []
    malformed_resource_root: usize = add_node(&malformed_resource_nodes, "resource-use", "", 1, 0, 0, 0, 0, 0, "value", "")
    malformed_resource_admitted: bool = proof_kernel_replay_arena_all_report(&malformed_resource_nodes, &malformed_resource_children)
    return 127 if malformed_resource_admitted

    malformed_result_nodes: mutable darray[ProofKernelNode] = []
    malformed_result_children: mutable darray[usize] = []
    malformed_result_root: usize = add_node(&malformed_result_nodes, "resource-call-result", "", 1, 0, 0, 0, 0, 0, "result", "")
    malformed_result_admitted: bool = proof_kernel_replay_arena_report(&malformed_result_nodes, &malformed_result_children, [], malformed_result_root)
    return 128 if malformed_result_admitted

    edge_nodes: mutable darray[ProofKernelNode] = []
    edge_children: mutable darray[usize] = []
    edge_root: usize = add_node(&edge_nodes, "unary", "not", 1, 0, 0, 0, 0, 0, "", "")
    edge_admitted: bool = proof_kernel_replay_arena_report(&edge_nodes, &edge_children, [], edge_root)
    return 2 if edge_admitted

    call_nodes: mutable darray[ProofKernelNode] = []
    call_children: mutable darray[usize] = []
    callee: usize = add_node(&call_nodes, "int", "", 0, 0, 0, 0, 0, 7, "", "")
    call_root: usize = add_node(&call_nodes, "call", "", callee, 0, 0, 0, 1, 0, "", "")
    call_children.push(callee)
    call_admitted: bool = proof_kernel_replay_arena_report(&call_nodes, &call_children, [], call_root)
    return 3 if call_admitted

    fact_nodes: mutable darray[ProofKernelNode] = []
    fact_children: mutable darray[usize] = []
    fact_root: usize = add_node(&fact_nodes, "int", "", 0, 0, 0, 0, 0, 7, "", "")
    invalid_fact: darray[usize] = [fact_root + 1]
    fact_admitted: bool = proof_kernel_replay_arena_report(&fact_nodes, &fact_children, invalid_fact, fact_root)
    return 4 if fact_admitted

    slice_nodes: mutable darray[ProofKernelNode] = []
    slice_children: mutable darray[usize] = []
    slice_root: usize = add_node(&slice_nodes, "array", "", 0, 0, 0, 1, 1, 0, "", "")
    slice_admitted: bool = proof_kernel_replay_arena_report(&slice_nodes, &slice_children, [], slice_root)
    return 5 if slice_admitted

    unknown_nodes: mutable darray[ProofKernelNode] = []
    unknown_children: mutable darray[usize] = []
    unknown_root: usize = add_node(&unknown_nodes, "future-node-kind", "", 0, 0, 0, 0, 0, 0, "", "")
    unknown_admitted: bool = proof_kernel_replay_arena_report(&unknown_nodes, &unknown_children, [], unknown_root)
    return 6 if unknown_admitted

    shorthand_nodes: mutable darray[ProofKernelNode] = []
    shorthand_children: mutable darray[usize] = []
    shorthand_root: usize = add_node(&shorthand_nodes, "shorthand", "", 0, 0, 0, 0, 0, 0, "None", "")
    shorthand_admitted: bool = proof_kernel_replay_arena_report(&shorthand_nodes, &shorthand_children, [], shorthand_root)
    return 7 if not shorthand_admitted

    malformed_shorthand_nodes: mutable darray[ProofKernelNode] = []
    malformed_shorthand_children: mutable darray[usize] = []
    malformed_shorthand_root: usize = add_node(&malformed_shorthand_nodes, "shorthand", "", 1, 0, 0, 0, 0, 0, "None", "")
    malformed_shorthand_admitted: bool = proof_kernel_replay_arena_report(&malformed_shorthand_nodes, &malformed_shorthand_children, [], malformed_shorthand_root)
    return 8 if malformed_shorthand_admitted

    valid_slice_nodes: mutable darray[ProofKernelNode] = []
    valid_slice_children: mutable darray[usize] = []
    valid_slice_object: usize = add_node(&valid_slice_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "values", "")
    valid_slice_low: usize = add_node(&valid_slice_nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
    valid_slice_high: usize = add_node(&valid_slice_nodes, "absent", "", 0, 0, 0, 0, 0, 0, "", "")
    valid_slice_root: usize = add_node(&valid_slice_nodes, "slice", "", valid_slice_object, valid_slice_low, valid_slice_high, 0, 0, 0, "", "")
    valid_slice_admitted: bool = proof_kernel_replay_arena_report(&valid_slice_nodes, &valid_slice_children, [], valid_slice_root)
    return 9 if not valid_slice_admitted

    malformed_slice_nodes: mutable darray[ProofKernelNode] = []
    malformed_slice_children: mutable darray[usize] = []
    malformed_slice_object: usize = add_node(&malformed_slice_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "values", "")
    malformed_slice_low: usize = add_node(&malformed_slice_nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
    malformed_slice_high: usize = add_node(&malformed_slice_nodes, "absent", "", 0, 0, 0, 0, 0, 0, "", "")
    malformed_slice_root: usize = add_node(&malformed_slice_nodes, "slice", "", malformed_slice_object, malformed_slice_low, malformed_slice_high, 1, 0, 0, "", "")
    malformed_slice_admitted: bool = proof_kernel_replay_arena_report(&malformed_slice_nodes, &malformed_slice_children, [], malformed_slice_root)
    return 10 if malformed_slice_admitted

    valid_indexn_nodes: mutable darray[ProofKernelNode] = []
    valid_indexn_children: mutable darray[usize] = []
    valid_indexn_object: usize = add_node(&valid_indexn_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "matrix", "")
    valid_indexn_first: usize = add_node(&valid_indexn_nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
    valid_indexn_second: usize = add_node(&valid_indexn_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
    valid_indexn_children.push(valid_indexn_first)
    valid_indexn_children.push(valid_indexn_second)
    valid_indexn_root: usize = add_node(&valid_indexn_nodes, "index-n", "", valid_indexn_object, 0, 0, 0, 2, 0, "", "")
    valid_indexn_admitted: bool = proof_kernel_replay_arena_report(&valid_indexn_nodes, &valid_indexn_children, [], valid_indexn_root)
    return 11 if not valid_indexn_admitted

    malformed_indexn_nodes: mutable darray[ProofKernelNode] = []
    malformed_indexn_children: mutable darray[usize] = []
    malformed_indexn_object: usize = add_node(&malformed_indexn_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "matrix", "")
    malformed_indexn_child: usize = add_node(&malformed_indexn_nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
    malformed_indexn_children.push(malformed_indexn_child)
    malformed_indexn_root: usize = add_node(&malformed_indexn_nodes, "index-n", "", malformed_indexn_object, 0, 0, 0, 2, 0, "", "")
    malformed_indexn_admitted: bool = proof_kernel_replay_arena_report(&malformed_indexn_nodes, &malformed_indexn_children, [], malformed_indexn_root)
    return 12 if malformed_indexn_admitted

    deep_nodes: mutable darray[ProofKernelNode] = []
    deep_children: mutable darray[usize] = []
    deep_root: mutable usize = add_node(&deep_nodes, "int", "", 0, 0, 0, 0, 0, 7, "", "")
    for depth in 0..<128 |depth, deep_nodes, deep_root|:
        deep_root <- add_node(&deep_nodes, "unary", "not", deep_root, 0, 0, 0, 0, 0, "", "")
    deep_admitted: bool = proof_kernel_replay_arena_report(&deep_nodes, &deep_children, [], deep_root)
    return 13 if deep_admitted

    shared_nodes: mutable darray[ProofKernelNode] = []
    shared_children: mutable darray[usize] = []
    shared_leaf: usize = add_node(&shared_nodes, "int", "", 0, 0, 0, 0, 0, 7, "", "")
    shared_root: usize = add_node(&shared_nodes, "binary", "+", shared_leaf, shared_leaf, 0, 0, 0, 0, "", "")
    shared_admitted: bool = proof_kernel_replay_arena_report(&shared_nodes, &shared_children, [], shared_root)
    return 14 if not shared_admitted

    # A shared node first reached through the right (shallow) branch must not hide the same node
    # behind a 127-edge left branch. This specifically guards depth-aware DAG memoization.
    deep_shared_nodes: mutable darray[ProofKernelNode] = []
    deep_shared_children: mutable darray[usize] = []
    deep_shared_leaf: usize = add_node(&deep_shared_nodes, "int", "", 0, 0, 0, 0, 0, 7, "", "")
    deep_shared_node: usize = add_node(&deep_shared_nodes, "unary", "not", deep_shared_leaf, 0, 0, 0, 0, 0, "", "")
    deep_shared_chain: mutable usize = deep_shared_node
    for depth in 0..<125 |depth, deep_shared_nodes, deep_shared_chain|:
        deep_shared_chain <- add_node(&deep_shared_nodes, "unary", "not", deep_shared_chain, 0, 0, 0, 0, 0, "", "")
    deep_shared_root: usize = add_node(&deep_shared_nodes, "binary", "+", deep_shared_chain, deep_shared_node, 0, 0, 0, 0, "", "")
    deep_shared_admitted: bool = proof_kernel_replay_arena_report(&deep_shared_nodes, &deep_shared_children, [], deep_shared_root)
    return 45 if deep_shared_admitted

    malformed_call_arg_nodes: mutable darray[ProofKernelNode] = []
    malformed_call_arg_children: mutable darray[usize] = []
    malformed_call_arg_callee: usize = add_node(&malformed_call_arg_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "callee", "")
    malformed_call_arg_value: usize = add_node(&malformed_call_arg_nodes, "int", "", 0, 0, 0, 0, 0, 7, "", "")
    malformed_call_arg: usize = add_node(&malformed_call_arg_nodes, "call_arg", "", malformed_call_arg_value, 0, 0, 0, 0, 0, "", "hidden")
    malformed_call_arg_children.push(malformed_call_arg)
    malformed_call_arg_root: usize = add_node(&malformed_call_arg_nodes, "call", "", malformed_call_arg_callee, 0, 0, 0, 1, 0, "", "")
    malformed_call_arg_admitted: bool = proof_kernel_replay_arena_report(&malformed_call_arg_nodes, &malformed_call_arg_children, [], malformed_call_arg_root)
    return 15 if malformed_call_arg_admitted

    malformed_binary_nodes: mutable darray[ProofKernelNode] = []
    malformed_binary_children: mutable darray[usize] = []
    malformed_binary_left: usize = add_node(&malformed_binary_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
    malformed_binary_right: usize = add_node(&malformed_binary_nodes, "int", "", 0, 0, 0, 0, 0, 2, "", "")
    malformed_binary_root: usize = add_node(&malformed_binary_nodes, "binary", "+", malformed_binary_left, malformed_binary_right, 0, 0, 0, 0, "hidden", "")
    malformed_binary_admitted: bool = proof_kernel_replay_arena_report(&malformed_binary_nodes, &malformed_binary_children, [], malformed_binary_root)
    return 16 if malformed_binary_admitted

    # `have` may add a proved fact, but it cannot replace the target. This forged transition
    # starts with false and changes the post-goal to true; the independent tactic kernel must
    # reject it even though the added fact itself is trivially proved.
    forged_have_nodes: mutable darray[ProofKernelNode] = []
    forged_have_children: mutable darray[usize] = []
    forged_have_false: usize = add_node(&forged_have_nodes, "bool", "", 0, 0, 0, 0, 0, 0, "", "")
    forged_have_true: usize = add_node(&forged_have_nodes, "bool", "", 0, 0, 0, 0, 0, 1, "", "")
    forged_have_after_facts: darray[usize] = [forged_have_true]
    forged_have_admitted: bool = proof_kernel_replay_tactic_step(&forged_have_nodes, &forged_have_children, "have", true, false, false, [], forged_have_false, forged_have_after_facts, forged_have_true, forged_have_true, true, 0, false, 0, false, "")
    return 79 if forged_have_admitted

    # `simp` is a closed bottom-up rewrite, not arbitrary entailment. This forged transition
    # changes `p` to `p and true`; the old containment-shaped replay admitted it because the new
    # goal contained the old one as a conjunct. The independent simplifier must reject it.
    forged_simp_nodes: mutable darray[ProofKernelNode] = []
    forged_simp_children: mutable darray[usize] = []
    forged_simp_atom: usize = add_node(&forged_simp_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "p", "")
    forged_simp_true: usize = add_node(&forged_simp_nodes, "bool", "", 0, 0, 0, 0, 0, 1, "", "")
    forged_simp_after: usize = add_node(&forged_simp_nodes, "binary", "and", forged_simp_atom, forged_simp_true, 0, 0, 0, 0, "", "")
    forged_simp_admitted: bool = proof_kernel_replay_tactic_step(&forged_simp_nodes, &forged_simp_children, "simp", true, false, false, [], forged_simp_atom, [], forged_simp_after, 0, false, 0, false, 0, false, "")
    return 82 if forged_simp_admitted

    noncanonical_operator_nodes: mutable darray[ProofKernelNode] = []
    noncanonical_operator_children: mutable darray[usize] = []
    noncanonical_operator_left: usize = add_node(&noncanonical_operator_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
    noncanonical_operator_right: usize = add_node(&noncanonical_operator_nodes, "int", "", 0, 0, 0, 0, 0, 2, "", "")
    noncanonical_operator_root: usize = add_node(&noncanonical_operator_nodes, "binary", "not-a-canonical-operator", noncanonical_operator_left, noncanonical_operator_right, 0, 0, 0, 0, "", "")
    noncanonical_operator_admitted: bool = proof_kernel_replay_arena_report(&noncanonical_operator_nodes, &noncanonical_operator_children, [], noncanonical_operator_root)
    return 78 if noncanonical_operator_admitted

    malformed_call_shape_nodes: mutable darray[ProofKernelNode] = []
    malformed_call_shape_children: mutable darray[usize] = []
    malformed_call_shape_callee: usize = add_node(&malformed_call_shape_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "callee", "")
    malformed_call_shape_value: usize = add_node(&malformed_call_shape_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
    malformed_call_shape_arg: usize = add_node(&malformed_call_shape_nodes, "call_arg", "", malformed_call_shape_value, 0, 0, 0, 0, 0, "", "")
    malformed_call_shape_second_value: usize = add_node(&malformed_call_shape_nodes, "int", "", 0, 0, 0, 0, 0, 2, "", "")
    malformed_call_shape_second_arg: usize = add_node(&malformed_call_shape_nodes, "call_arg", "", malformed_call_shape_second_value, 0, 0, 0, 0, 0, "", "")
    malformed_call_shape_children.push(malformed_call_shape_arg)
    malformed_call_shape_children.push(malformed_call_shape_second_arg)
    malformed_call_shape_root: usize = add_node(&malformed_call_shape_nodes, "call", "", malformed_call_shape_callee, 0, 1, 0, 2, 0, "", "")
    malformed_call_shape_admitted: bool = proof_kernel_replay_arena_report(&malformed_call_shape_nodes, &malformed_call_shape_children, [], malformed_call_shape_root)
    return 80 if malformed_call_shape_admitted

    malformed_bool_nodes: mutable darray[ProofKernelNode] = []
    malformed_bool_children: mutable darray[usize] = []
    malformed_bool_root: usize = add_node(&malformed_bool_nodes, "bool", "", 0, 0, 0, 0, 0, 2, "", "")
    malformed_bool_admitted: bool = proof_kernel_replay_arena_report(&malformed_bool_nodes, &malformed_bool_children, [], malformed_bool_root)
    return 17 if malformed_bool_admitted

    # The logical kernel must not let exact containment turn an integer term into a proposition.
    # This is a direct source-neutral call, so it cannot rely on the compiler's type checker.
    scalar_proposition_nodes: mutable darray[ProofKernelNode] = []
    scalar_proposition_children: mutable darray[usize] = []
    scalar_proposition_root: usize = add_node(&scalar_proposition_nodes, "int", "", 0, 0, 0, 0, 0, 7, "", "")
    scalar_proposition_admitted: bool = proof_kernel_replay_goal_report(&scalar_proposition_nodes, &scalar_proposition_children, [scalar_proposition_root], scalar_proposition_root)
    return 81 if scalar_proposition_admitted

    # A structurally valid symbolic index is admitted as a conservative path. The resource
    # kernel may carry it, but it will report overlap unless a separate resource-disjoint event
    # proves the selectors unequal.
    dynamic_resource_nodes: mutable darray[ProofKernelNode] = []
    dynamic_resource_children: mutable darray[usize] = []
    dynamic_resource_parameter: usize = add_node(&dynamic_resource_nodes, "resource-bind", "external-mutable", 0, 0, 1, 0, 0, 0, "values", "")
    dynamic_resource_object: usize = add_node(&dynamic_resource_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "values", "")
    dynamic_resource_index: usize = add_node(&dynamic_resource_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "i", "")
    dynamic_resource_place: usize = add_node(&dynamic_resource_nodes, "index", "", dynamic_resource_object, dynamic_resource_index, 0, 0, 0, 0, "", "")
    dynamic_resource_borrow: usize = add_node(&dynamic_resource_nodes, "resource-bind", "shared", dynamic_resource_place, 0, 0, 0, 0, 0, "alias", "values")
    dynamic_resource_children.push(dynamic_resource_parameter)
    dynamic_resource_children.push(dynamic_resource_borrow)
    dynamic_resource_root: usize = add_node(&dynamic_resource_nodes, "resource-safety", "", 0, 0, 1, 0, 2, 0, "dynamic", "resource-v1")
    dynamic_resource_admitted: bool = proof_kernel_replay_resource_report(&dynamic_resource_nodes, &dynamic_resource_children, [], dynamic_resource_root)
    return 18 if not dynamic_resource_admitted

    # Conversely, two closed literal paths into an externally mutable root are disjoint, so the
    # same independent rules should accept a shared borrow of values[0] and a mutable borrow of
    # values[1]. This protects the exact-index improvement from regressing to whole-root aliasing.
    indexed_resource_nodes: mutable darray[ProofKernelNode] = []
    indexed_resource_children: mutable darray[usize] = []
    indexed_resource_parameter: usize = add_node(&indexed_resource_nodes, "resource-bind", "external-mutable", 0, 0, 1, 0, 0, 0, "values", "")
    indexed_resource_object_zero: usize = add_node(&indexed_resource_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "values", "")
    indexed_resource_zero: usize = add_node(&indexed_resource_nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
    indexed_resource_place_zero: usize = add_node(&indexed_resource_nodes, "index", "", indexed_resource_object_zero, indexed_resource_zero, 0, 0, 0, 0, "", "")
    indexed_resource_shared: usize = add_node(&indexed_resource_nodes, "resource-bind", "shared", indexed_resource_place_zero, 0, 0, 0, 0, 0, "shared_zero", "values")
    indexed_resource_object_one: usize = add_node(&indexed_resource_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "values", "")
    indexed_resource_one: usize = add_node(&indexed_resource_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
    indexed_resource_place_one: usize = add_node(&indexed_resource_nodes, "index", "", indexed_resource_object_one, indexed_resource_one, 0, 0, 0, 0, "", "")
    indexed_resource_mutable: usize = add_node(&indexed_resource_nodes, "resource-bind", "mutable", indexed_resource_place_one, 0, 1, 0, 0, 0, "mutable_one", "values")
    indexed_resource_children.push(indexed_resource_parameter)
    indexed_resource_children.push(indexed_resource_shared)
    indexed_resource_children.push(indexed_resource_mutable)
    indexed_resource_root: usize = add_node(&indexed_resource_nodes, "resource-safety", "", 0, 0, 1, 0, 3, 0, "indexed", "resource-v1")
    indexed_resource_admitted: bool = proof_kernel_replay_resource_report(&indexed_resource_nodes, &indexed_resource_children, [], indexed_resource_root)
    return 19 if not indexed_resource_admitted

    # The same conservative rule applies to the canonical IndexN form emitted by the compiler:
    # an unresolved component is a valid symbolic identity, but it is not treated as disjoint.
    dynamic_indexn_nodes: mutable darray[ProofKernelNode] = []
    dynamic_indexn_children: mutable darray[usize] = []
    dynamic_indexn_parameter: usize = add_node(&dynamic_indexn_nodes, "resource-bind", "external-mutable", 0, 0, 1, 0, 0, 0, "matrix", "")
    dynamic_indexn_object: usize = add_node(&dynamic_indexn_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "matrix", "")
    dynamic_indexn_index: usize = add_node(&dynamic_indexn_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "i", "")
    dynamic_indexn_children.push(dynamic_indexn_index)
    dynamic_indexn_place: usize = add_node(&dynamic_indexn_nodes, "index-n", "", dynamic_indexn_object, 0, 0, 0, 1, 0, "", "")
    dynamic_indexn_borrow: usize = add_node(&dynamic_indexn_nodes, "resource-bind", "shared", dynamic_indexn_place, 0, 0, 0, 0, 0, "alias", "matrix")
    dynamic_indexn_children.push(dynamic_indexn_parameter)
    dynamic_indexn_children.push(dynamic_indexn_borrow)
    dynamic_indexn_root: usize = add_node(&dynamic_indexn_nodes, "resource-safety", "", 0, 0, 1, 1, 2, 0, "dynamic-indexn", "resource-v1")
    dynamic_indexn_admitted: bool = proof_kernel_replay_resource_report(&dynamic_indexn_nodes, &dynamic_indexn_children, [], dynamic_indexn_root)
    return 20 if not dynamic_indexn_admitted

    # Two literal IndexN paths with different components are disjoint and must retain the same
    # permission behavior as their chained single-index encoding.
    multi_indexed_resource_nodes: mutable darray[ProofKernelNode] = []
    multi_indexed_resource_children: mutable darray[usize] = []
    multi_indexed_resource_parameter: usize = add_node(&multi_indexed_resource_nodes, "resource-bind", "external-mutable", 0, 0, 1, 0, 0, 0, "matrix", "")
    multi_indexed_resource_object_first: usize = add_node(&multi_indexed_resource_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "matrix", "")
    multi_indexed_resource_first_row: usize = add_node(&multi_indexed_resource_nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
    multi_indexed_resource_first_column: usize = add_node(&multi_indexed_resource_nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
    multi_indexed_resource_children.push(multi_indexed_resource_first_row)
    multi_indexed_resource_children.push(multi_indexed_resource_first_column)
    multi_indexed_resource_place_first: usize = add_node(&multi_indexed_resource_nodes, "index-n", "", multi_indexed_resource_object_first, 0, 0, 0, 2, 0, "", "")
    multi_indexed_resource_shared: usize = add_node(&multi_indexed_resource_nodes, "resource-bind", "shared", multi_indexed_resource_place_first, 0, 0, 0, 0, 0, "shared_zero_zero", "matrix")
    multi_indexed_resource_object_second: usize = add_node(&multi_indexed_resource_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "matrix", "")
    multi_indexed_resource_second_row: usize = add_node(&multi_indexed_resource_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
    multi_indexed_resource_second_column: usize = add_node(&multi_indexed_resource_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
    multi_indexed_resource_children.push(multi_indexed_resource_second_row)
    multi_indexed_resource_children.push(multi_indexed_resource_second_column)
    multi_indexed_resource_place_second: usize = add_node(&multi_indexed_resource_nodes, "index-n", "", multi_indexed_resource_object_second, 0, 0, 2, 2, 0, "", "")
    multi_indexed_resource_mutable: usize = add_node(&multi_indexed_resource_nodes, "resource-bind", "mutable", multi_indexed_resource_place_second, 0, 1, 0, 0, 0, "mutable_one_one", "matrix")
    multi_indexed_resource_children.push(multi_indexed_resource_parameter)
    multi_indexed_resource_children.push(multi_indexed_resource_shared)
    multi_indexed_resource_children.push(multi_indexed_resource_mutable)
    multi_indexed_resource_root: usize = add_node(&multi_indexed_resource_nodes, "resource-safety", "", 0, 0, 1, 4, 3, 0, "multi-indexed", "resource-v1")
    multi_indexed_resource_admitted: bool = proof_kernel_replay_resource_report(&multi_indexed_resource_nodes, &multi_indexed_resource_children, [], multi_indexed_resource_root)
    return 21 if not multi_indexed_resource_admitted

    # Shape-valid resource-disjoint events still need a logical proof. This hostile certificate
    # claims that a symbolic index is different from zero without supplying any premise; the
    # resource transition replay must reject it even though arena admission succeeds.
    unproven_disjoint_nodes: mutable darray[ProofKernelNode] = []
    unproven_disjoint_children: mutable darray[usize] = []
    unproven_disjoint_parameter: usize = add_node(&unproven_disjoint_nodes, "resource-bind", "external-mutable", 0, 0, 1, 0, 0, 0, "values", "")
    unproven_disjoint_object: usize = add_node(&unproven_disjoint_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "values", "")
    unproven_disjoint_index: usize = add_node(&unproven_disjoint_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "i", "")
    unproven_disjoint_symbolic_place: usize = add_node(&unproven_disjoint_nodes, "index", "", unproven_disjoint_object, unproven_disjoint_index, 0, 0, 0, 0, "", "")
    unproven_disjoint_shared: usize = add_node(&unproven_disjoint_nodes, "resource-bind", "shared", unproven_disjoint_symbolic_place, 0, 0, 0, 0, 0, "shared", "values")
    unproven_disjoint_zero: usize = add_node(&unproven_disjoint_nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
    unproven_disjoint_literal_place: usize = add_node(&unproven_disjoint_nodes, "index", "", unproven_disjoint_object, unproven_disjoint_zero, 0, 0, 0, 0, "", "")
    unproven_disjoint_goal: usize = add_node(&unproven_disjoint_nodes, "binary", "!=", unproven_disjoint_index, unproven_disjoint_zero, 0, 0, 0, 0, "", "")
    unproven_disjoint_event: usize = add_node(&unproven_disjoint_nodes, "resource-disjoint", "!=", unproven_disjoint_index, unproven_disjoint_zero, unproven_disjoint_goal, 0, 0, 0, "", "")
    unproven_disjoint_mutable: usize = add_node(&unproven_disjoint_nodes, "resource-bind", "mutable", unproven_disjoint_literal_place, 0, 1, 0, 0, 0, "exclusive", "values")
    unproven_disjoint_children.push(unproven_disjoint_parameter)
    unproven_disjoint_children.push(unproven_disjoint_shared)
    unproven_disjoint_children.push(unproven_disjoint_event)
    unproven_disjoint_children.push(unproven_disjoint_mutable)
    unproven_disjoint_root: usize = add_node(&unproven_disjoint_nodes, "resource-safety", "", 0, 0, 1, 0, 4, 0, "unproven-disjoint", "resource-v1")
    unproven_disjoint_admitted: bool = proof_kernel_replay_resource_report(&unproven_disjoint_nodes, &unproven_disjoint_children, [], unproven_disjoint_root)
    return 22 if unproven_disjoint_admitted

    # A forged resource-call may place two overlapping temporary borrows in separate argument
    # nodes. They are not caller-state borrows, but both are live during the callee and must be
    # rejected whenever either formal is mutable.
    forged_alias_call_nodes: mutable darray[ProofKernelNode] = []
    forged_alias_call_children: mutable darray[usize] = []
    forged_alias_formal_left: usize = add_node(&forged_alias_call_nodes, "resource-bind", "external-mutable", 0, 0, 1, 0, 0, 0, "left", "")
    forged_alias_formal_right: usize = add_node(&forged_alias_call_nodes, "resource-bind", "external-mutable", 0, 0, 1, 0, 0, 0, "right", "")
    forged_alias_call_children.push(forged_alias_formal_left)
    forged_alias_call_children.push(forged_alias_formal_right)
    forged_alias_callee: usize = add_node(&forged_alias_call_nodes, "resource-safety", "", 0, 0, 2, 0, 2, 0, "write-pair", "resource-v1")
    forged_alias_source: usize = add_node(&forged_alias_call_nodes, "resource-bind", "external-mutable", 0, 0, 1, 0, 0, 0, "x", "")
    forged_alias_x_left: usize = add_node(&forged_alias_call_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "x", "")
    forged_alias_x_right: usize = add_node(&forged_alias_call_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "x", "")
    forged_alias_arg_left: usize = add_node(&forged_alias_call_nodes, "resource-call-arg", "borrow", forged_alias_x_left, 0, 0, 0, 0, 0, "left", "")
    forged_alias_arg_right: usize = add_node(&forged_alias_call_nodes, "resource-call-arg", "borrow", forged_alias_x_right, 0, 0, 0, 0, 0, "right", "")
    forged_alias_call_start: usize = forged_alias_call_children.count
    forged_alias_call_children.push(forged_alias_arg_left)
    forged_alias_call_children.push(forged_alias_arg_right)
    forged_alias_call: usize = add_node(&forged_alias_call_nodes, "resource-call", "", forged_alias_callee, 0, 2, forged_alias_call_start, 2, 0, "write-pair", "")
    forged_alias_call_children.push(forged_alias_source)
    forged_alias_call_children.push(forged_alias_call)
    forged_alias_root_start: usize = forged_alias_call_children.count - 2
    forged_alias_root: usize = add_node(&forged_alias_call_nodes, "resource-safety", "", 0, 0, 0, forged_alias_root_start, 2, 0, "duplicate-call", "resource-v1")
    forged_alias_callee_admitted: bool = proof_kernel_replay_resource_report(&forged_alias_call_nodes, &forged_alias_call_children, [], forged_alias_callee)
    return 86 if not forged_alias_callee_admitted
    forged_alias_admitted: bool = proof_kernel_replay_resource_report(&forged_alias_call_nodes, &forged_alias_call_children, [], forged_alias_root)
    return 87 if forged_alias_admitted

    valid_region_nodes: mutable darray[ProofKernelNode] = []
    valid_region_children: mutable darray[usize] = []
    valid_region_open: usize = add_node(&valid_region_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "r", "")
    valid_region_operand: usize = add_node(&valid_region_nodes, "int", "", 0, 0, 0, 0, 0, 7, "", "")
    valid_region_alloc: usize = add_node(&valid_region_nodes, "resource-region-alloc", "", valid_region_operand, 0, 2, 0, 0, 0, "value", "r")
    valid_region_place: usize = add_node(&valid_region_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "value", "")
    valid_region_use: usize = add_node(&valid_region_nodes, "resource-use", "", valid_region_place, 0, 0, 0, 0, 0, "value", "")
    valid_region_close: usize = add_node(&valid_region_nodes, "resource-region-close", "", 0, 0, 0, 0, 0, 0, "r", "")
    valid_region_children.push(valid_region_open)
    valid_region_children.push(valid_region_alloc)
    valid_region_children.push(valid_region_use)
    valid_region_children.push(valid_region_close)
    valid_region_root: usize = add_node(&valid_region_nodes, "resource-safety", "", 0, 0, 0, 0, 4, 0, "valid-region", "resource-v1")
    valid_region_admitted: bool = proof_kernel_replay_resource_report(&valid_region_nodes, &valid_region_children, [], valid_region_root)
    return 23 if not valid_region_admitted

    # A top-level local region must be balanced. The source checker emits the implicit function
    # close, but the independent kernel must reject a forged report that omits it.
    unclosed_region_nodes: mutable darray[ProofKernelNode] = []
    unclosed_region_children: mutable darray[usize] = []
    unclosed_region_open: usize = add_node(&unclosed_region_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "r", "")
    unclosed_region_children.push(unclosed_region_open)
    unclosed_region_root: usize = add_node(&unclosed_region_nodes, "resource-safety", "", 0, 0, 0, 0, 1, 0, "unclosed-region", "resource-v1")
    unclosed_region_admitted: bool = proof_kernel_replay_resource_report(&unclosed_region_nodes, &unclosed_region_children, [], unclosed_region_root)
    return 84 if unclosed_region_admitted

    # A nested scope must not leak a fresh local region when its snapshot is discarded. The
    # parent region remains balanced, so membership-only scope checks would otherwise miss this.
    leaked_scope_nodes: mutable darray[ProofKernelNode] = []
    leaked_scope_children: mutable darray[usize] = []
    leaked_scope_parent_open: usize = add_node(&leaked_scope_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "parent", "")
    leaked_scope_child_open: usize = add_node(&leaked_scope_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "child", "")
    leaked_scope_child_start: usize = leaked_scope_children.count
    leaked_scope_children.push(leaked_scope_child_open)
    leaked_scope: usize = add_node(&leaked_scope_nodes, "resource-scope", "", 0, 0, 0, leaked_scope_child_start, 1, 0, "", "")
    leaked_scope_parent_close: usize = add_node(&leaked_scope_nodes, "resource-region-close", "", 0, 0, 0, 0, 0, 0, "parent", "")
    leaked_scope_root_start: usize = leaked_scope_children.count
    leaked_scope_children.push(leaked_scope_parent_open)
    leaked_scope_children.push(leaked_scope)
    leaked_scope_children.push(leaked_scope_parent_close)
    leaked_scope_root: usize = add_node(&leaked_scope_nodes, "resource-safety", "", 0, 0, 0, leaked_scope_root_start, 3, 0, "leaked-scope-region", "resource-v1")
    leaked_scope_admitted: bool = proof_kernel_replay_resource_report(&leaked_scope_nodes, &leaked_scope_children, [], leaked_scope_root)
    return 85 if leaked_scope_admitted

    # A nested scope cannot destroy an inherited region and reopen the same spelling: the
    # reopened name denotes a fresh lifetime, while the parent snapshot still holds the old one.
    # This case has no binding on purpose, so replay must protect region identity itself.
    nested_reopened_nodes: mutable darray[ProofKernelNode] = []
    nested_reopened_children: mutable darray[usize] = []
    nested_reopened_open: usize = add_node(&nested_reopened_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "r", "")
    nested_reopened_close: usize = add_node(&nested_reopened_nodes, "resource-region-close", "", 0, 0, 0, 0, 0, 0, "r", "")
    nested_reopened_again: usize = add_node(&nested_reopened_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "r", "")
    nested_reopened_scope_children_start: usize = nested_reopened_children.count
    nested_reopened_children.push(nested_reopened_close)
    nested_reopened_children.push(nested_reopened_again)
    nested_reopened_scope: usize = add_node(&nested_reopened_nodes, "resource-scope", "", 0, 0, 0, nested_reopened_scope_children_start, 2, 0, "", "")
    nested_reopened_operand: usize = add_node(&nested_reopened_nodes, "int", "", 0, 0, 0, 0, 0, 7, "", "")
    nested_reopened_alloc: usize = add_node(&nested_reopened_nodes, "resource-region-alloc", "", nested_reopened_operand, 0, 0, 0, 0, 0, "value", "r")
    nested_reopened_final_close: usize = add_node(&nested_reopened_nodes, "resource-region-close", "", 0, 0, 0, 0, 0, 0, "r", "")
    nested_reopened_children.push(nested_reopened_open)
    nested_reopened_children.push(nested_reopened_scope)
    nested_reopened_children.push(nested_reopened_alloc)
    nested_reopened_children.push(nested_reopened_final_close)
    nested_reopened_root: usize = add_node(&nested_reopened_nodes, "resource-safety", "", 0, 0, 0, nested_reopened_scope_children_start + 2, 4, 0, "nested-region-reopened", "resource-v1")
    nested_reopened_admitted: bool = proof_kernel_replay_resource_report(&nested_reopened_nodes, &nested_reopened_children, [], nested_reopened_root)
    return 29 if nested_reopened_admitted

    region_without_open_nodes: mutable darray[ProofKernelNode] = []
    region_without_open_children: mutable darray[usize] = []
    region_without_open_operand: usize = add_node(&region_without_open_nodes, "int", "", 0, 0, 0, 0, 0, 7, "", "")
    region_without_open_alloc: usize = add_node(&region_without_open_nodes, "resource-region-alloc", "", region_without_open_operand, 0, 0, 0, 0, 0, "value", "r")
    region_without_open_children.push(region_without_open_alloc)
    region_without_open_root: usize = add_node(&region_without_open_nodes, "resource-safety", "", 0, 0, 0, 0, 1, 0, "region-without-open", "resource-v1")
    region_without_open_admitted: bool = proof_kernel_replay_resource_report(&region_without_open_nodes, &region_without_open_children, [], region_without_open_root)
    return 24 if region_without_open_admitted

    region_bad_close_nodes: mutable darray[ProofKernelNode] = []
    region_bad_close_children: mutable darray[usize] = []
    region_bad_close: usize = add_node(&region_bad_close_nodes, "resource-region-close", "", 0, 0, 0, 0, 0, 0, "r", "")
    region_bad_close_children.push(region_bad_close)
    region_bad_close_root: usize = add_node(&region_bad_close_nodes, "resource-safety", "", 0, 0, 0, 0, 1, 0, "region-bad-close", "resource-v1")
    region_bad_close_admitted: bool = proof_kernel_replay_resource_report(&region_bad_close_nodes, &region_bad_close_children, [], region_bad_close_root)
    return 25 if region_bad_close_admitted

    region_stale_nodes: mutable darray[ProofKernelNode] = []
    region_stale_children: mutable darray[usize] = []
    region_stale_open: usize = add_node(&region_stale_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "r", "")
    region_stale_operand: usize = add_node(&region_stale_nodes, "int", "", 0, 0, 0, 0, 0, 7, "", "")
    region_stale_alloc: usize = add_node(&region_stale_nodes, "resource-region-alloc", "", region_stale_operand, 0, 2, 0, 0, 0, "value", "r")
    region_stale_close: usize = add_node(&region_stale_nodes, "resource-region-close", "", 0, 0, 0, 0, 0, 0, "r", "")
    region_stale_place: usize = add_node(&region_stale_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "value", "")
    region_stale_use: usize = add_node(&region_stale_nodes, "resource-use", "", region_stale_place, 0, 0, 0, 0, 0, "value", "")
    region_stale_children.push(region_stale_open)
    region_stale_children.push(region_stale_alloc)
    region_stale_children.push(region_stale_close)
    region_stale_children.push(region_stale_use)
    region_stale_root: usize = add_node(&region_stale_nodes, "resource-safety", "", 0, 0, 0, 0, 4, 0, "region-stale", "resource-v1")
    region_stale_admitted: bool = proof_kernel_replay_resource_report(&region_stale_nodes, &region_stale_children, [], region_stale_root)
    return 26 if region_stale_admitted

    region_reopened_nodes: mutable darray[ProofKernelNode] = []
    region_reopened_children: mutable darray[usize] = []
    region_reopened_open: usize = add_node(&region_reopened_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "r", "")
    region_reopened_operand: usize = add_node(&region_reopened_nodes, "int", "", 0, 0, 0, 0, 0, 7, "", "")
    region_reopened_alloc: usize = add_node(&region_reopened_nodes, "resource-region-alloc", "", region_reopened_operand, 0, 2, 0, 0, 0, "value", "r")
    region_reopened_close: usize = add_node(&region_reopened_nodes, "resource-region-close", "", 0, 0, 0, 0, 0, 0, "r", "")
    region_reopened_again: usize = add_node(&region_reopened_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "r", "")
    region_reopened_place: usize = add_node(&region_reopened_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "value", "")
    region_reopened_use: usize = add_node(&region_reopened_nodes, "resource-use", "", region_reopened_place, 0, 0, 0, 0, 0, "value", "")
    region_reopened_children.push(region_reopened_open)
    region_reopened_children.push(region_reopened_alloc)
    region_reopened_children.push(region_reopened_close)
    region_reopened_children.push(region_reopened_again)
    region_reopened_children.push(region_reopened_use)
    region_reopened_root: usize = add_node(&region_reopened_nodes, "resource-safety", "", 0, 0, 0, 0, 5, 0, "region-reopened", "resource-v1")
    region_reopened_admitted: bool = proof_kernel_replay_resource_report(&region_reopened_nodes, &region_reopened_children, [], region_reopened_root)
    return 27 if region_reopened_admitted

    region_alias_reopened_nodes: mutable darray[ProofKernelNode] = []
    region_alias_reopened_children: mutable darray[usize] = []
    region_alias_reopened_open: usize = add_node(&region_alias_reopened_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "r", "")
    region_alias_reopened_operand: usize = add_node(&region_alias_reopened_nodes, "int", "", 0, 0, 0, 0, 0, 7, "", "")
    region_alias_reopened_alloc: usize = add_node(&region_alias_reopened_nodes, "resource-region-alloc", "", region_alias_reopened_operand, 0, 2, 0, 0, 0, "value", "r")
    region_alias_reopened_place: usize = add_node(&region_alias_reopened_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "value", "")
    region_alias_reopened_alias: usize = add_node(&region_alias_reopened_nodes, "resource-bind", "shared", region_alias_reopened_place, 0, 0, 0, 0, 0, "alias", "value")
    region_alias_reopened_close: usize = add_node(&region_alias_reopened_nodes, "resource-region-close", "", 0, 0, 0, 0, 0, 0, "r", "")
    region_alias_reopened_again: usize = add_node(&region_alias_reopened_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "r", "")
    region_alias_reopened_alias_place: usize = add_node(&region_alias_reopened_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "alias", "")
    region_alias_reopened_use: usize = add_node(&region_alias_reopened_nodes, "resource-use", "", region_alias_reopened_alias_place, 0, 0, 0, 0, 0, "alias", "")
    region_alias_reopened_children.push(region_alias_reopened_open)
    region_alias_reopened_children.push(region_alias_reopened_alloc)
    region_alias_reopened_children.push(region_alias_reopened_alias)
    region_alias_reopened_children.push(region_alias_reopened_close)
    region_alias_reopened_children.push(region_alias_reopened_again)
    region_alias_reopened_children.push(region_alias_reopened_use)
    region_alias_reopened_root: usize = add_node(&region_alias_reopened_nodes, "resource-safety", "", 0, 0, 0, 0, 6, 0, "region-alias-reopened", "resource-v1")
    region_alias_reopened_admitted: bool = proof_kernel_replay_resource_report(&region_alias_reopened_nodes, &region_alias_reopened_children, [], region_alias_reopened_root)
    return 28 if region_alias_reopened_admitted

    # A valid region-polymorphic call carries an explicit formal/actual map. Its returned
    # reference is admitted only when the callee's region-return summary agrees with the mapped
    # live caller region; the following certificate changes only that result label and must fail.
    generic_call_nodes: mutable darray[ProofKernelNode] = []
    generic_call_children: mutable darray[usize] = []
    generic_region_param: usize = add_node(&generic_call_nodes, "resource-region-param", "external", 0, 0, 0, 0, 0, 0, "r", "")
    generic_owner: usize = add_node(&generic_call_nodes, "resource-bind", "external-shared", 0, 0, 0, 0, 0, 0, "owner", "r")
    generic_value: usize = add_node(&generic_call_nodes, "resource-bind", "value", 0, 0, 0, 0, 0, 0, "value", "")
    generic_return_value: usize = add_node(&generic_call_nodes, "int", "", 0, 0, 0, 0, 0, 9, "", "")
    generic_return_alloc: usize = add_node(&generic_call_nodes, "resource-region-return-alloc", "", generic_return_value, 0, 0, 0, 0, 0, "", "r")
    generic_return: usize = add_node(&generic_call_nodes, "resource-region-return", "param", generic_return_alloc, 0, 0, 0, 0, 0, "r", "")
    generic_callee_children_start: usize = generic_call_children.count
    generic_call_children.push(generic_region_param)
    generic_call_children.push(generic_owner)
    generic_call_children.push(generic_value)
    generic_call_children.push(generic_return_alloc)
    generic_call_children.push(generic_return)
    generic_callee: usize = add_node(&generic_call_nodes, "resource-safety", "", 0, 0, 2, generic_callee_children_start, 5, 0, "make", "resource-v1")
    generic_caller_open: usize = add_node(&generic_call_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "scratch", "")
    generic_seed_value: usize = add_node(&generic_call_nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
    generic_seed_alloc: usize = add_node(&generic_call_nodes, "resource-region-alloc", "", generic_seed_value, 0, 2, 0, 0, 0, "seed", "scratch")
    generic_seed_place: usize = add_node(&generic_call_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "seed", "")
    generic_call_arg_owner: usize = add_node(&generic_call_nodes, "resource-call-arg", "reference", generic_seed_place, 0, 0, 0, 0, 0, "owner", "")
    generic_call_arg_value: usize = add_node(&generic_call_nodes, "resource-call-arg", "value", generic_seed_value, 0, 0, 0, 0, 0, "value", "")
    generic_call_region: usize = add_node(&generic_call_nodes, "resource-call-region", "param", 0, 0, 0, 0, 0, 0, "r", "scratch")
    generic_call_children_start: usize = generic_call_children.count
    generic_call_children.push(generic_call_arg_owner)
    generic_call_children.push(generic_call_arg_value)
    generic_call_children.push(generic_call_region)
    generic_call: usize = add_node(&generic_call_nodes, "resource-call", "", generic_callee, 1, 2, generic_call_children_start, 3, 0, "make", "")
    generic_result: usize = add_node(&generic_call_nodes, "resource-call-result", "", generic_call, 0, 2, 0, 0, 0, "value", "scratch")
    generic_close: usize = add_node(&generic_call_nodes, "resource-region-close", "", 0, 0, 0, 0, 0, 0, "scratch", "")
    generic_caller_children_start: usize = generic_call_children.count
    generic_call_children.push(generic_caller_open)
    generic_call_children.push(generic_seed_alloc)
    generic_call_children.push(generic_call)
    generic_call_children.push(generic_result)
    generic_call_children.push(generic_close)
