    region_stale_children.push(region_stale_alloc)
    region_stale_children.push(region_stale_close)
    region_stale_children.push(region_stale_use)
    region_stale_root: usize = add_node(&region_stale_nodes, "resource-safety", "", 0, 0, 0, 0, 4, 0, "region-stale", "resource-v1")
    region_stale_admitted: bool = proof_kernel_replay_resource_report(&region_stale_nodes, &region_stale_children, [], region_stale_root)
    return 26 if region_stale_admitted

    region_reopened_nodes: mutable darray[ProofKernelNode] = []
    region_reopened_children: mutable darray[usize] = []
    region_reopened_open: usize = add_node(&region_reopened_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "r", "")
    region_reopened_operand: usize = add_node(&region_reopened_nodes, "int", "", 0, 0, 0, 0, 0, 7, "", "")
    region_reopened_alloc: usize = add_node(&region_reopened_nodes, "resource-region-alloc", "", region_reopened_operand, 0, 2, 0, 0, 0, "value", "r")
    region_reopened_close: usize = add_node(&region_reopened_nodes, "resource-region-close", "", 0, 0, 0, 0, 0, 0, "r", "")
    region_reopened_again: usize = add_node(&region_reopened_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "r", "")
    region_reopened_place: usize = add_node(&region_reopened_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "value", "")
