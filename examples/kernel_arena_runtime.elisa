    forged_region_alias_alias: usize = add_node(&forged_region_alias_nodes, "resource-region-bind", "", forged_region_alias_source_place, 0, 6, 0, 0, 0, "alias", "r")
    forged_region_alias_place: usize = add_node(&forged_region_alias_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "alias", "")
    forged_region_alias_write: usize = add_node(&forged_region_alias_nodes, "resource-write", "", forged_region_alias_place, 0, 0, 0, 0, 0, "alias", "")
    forged_region_alias_start: usize = forged_region_alias_children.count
    forged_region_alias_children.push(forged_region_alias_param)
    forged_region_alias_children.push(forged_region_alias_source)
    forged_region_alias_children.push(forged_region_alias_alias)
    forged_region_alias_children.push(forged_region_alias_write)
    forged_region_alias_report: usize = add_node(&forged_region_alias_nodes, "resource-safety", "", 0, 0, 0, forged_region_alias_start, 4, 0, "forged-region-alias", "resource-v1")
    forged_region_alias_admitted: bool = proof_kernel_replay_resource_report(&forged_region_alias_nodes, &forged_region_alias_children, [], forged_region_alias_report)
    return 67 if forged_region_alias_admitted

    valid_region_alias_nodes: mutable darray[ProofKernelNode] = []
    valid_region_alias_children: mutable darray[usize] = []
    valid_region_alias_open: usize = add_node(&valid_region_alias_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "r", "")
    valid_region_alias_value: usize = add_node(&valid_region_alias_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
    valid_region_alias_source: usize = add_node(&valid_region_alias_nodes, "resource-region-alloc", "", valid_region_alias_value, 0, 6, 0, 0, 0, "source", "r")
    valid_region_alias_source_place: usize = add_node(&valid_region_alias_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "source", "")
    valid_region_alias_alias: usize = add_node(&valid_region_alias_nodes, "resource-region-bind", "", valid_region_alias_source_place, 0, 6, 0, 0, 0, "alias", "r")
    valid_region_alias_place: usize = add_node(&valid_region_alias_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "alias", "")
    valid_region_alias_write: usize = add_node(&valid_region_alias_nodes, "resource-write", "", valid_region_alias_place, 0, 0, 0, 0, 0, "alias", "")
    valid_region_alias_close: usize = add_node(&valid_region_alias_nodes, "resource-region-close", "", 0, 0, 0, 0, 0, 0, "r", "")
    valid_region_alias_start: usize = valid_region_alias_children.count
    valid_region_alias_children.push(valid_region_alias_open)
    valid_region_alias_children.push(valid_region_alias_source)
    valid_region_alias_children.push(valid_region_alias_alias)
    valid_region_alias_children.push(valid_region_alias_write)
    valid_region_alias_children.push(valid_region_alias_close)
    valid_region_alias_report: usize = add_node(&valid_region_alias_nodes, "resource-safety", "", 0, 0, 0, valid_region_alias_start, 5, 0, "valid-region-alias", "resource-v1")
    valid_region_alias_admitted: bool = proof_kernel_replay_resource_report(&valid_region_alias_nodes, &valid_region_alias_children, [], valid_region_alias_report)
    return 68 if not valid_region_alias_admitted

    malformed_region_shape_nodes: mutable darray[ProofKernelNode] = []
    malformed_region_shape_children: mutable darray[usize] = []
    malformed_region_shape_open: usize = add_node(&malformed_region_shape_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "r", "")
    malformed_region_shape_value: usize = add_node(&malformed_region_shape_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
    malformed_region_shape_alloc: usize = add_node(&malformed_region_shape_nodes, "resource-region-alloc", "", malformed_region_shape_value, 0, 4, 0, 0, 0, "value", "r")
    malformed_region_shape_close: usize = add_node(&malformed_region_shape_nodes, "resource-region-close", "", 0, 0, 0, 0, 0, 0, "r", "")
    malformed_region_shape_start: usize = malformed_region_shape_children.count
    malformed_region_shape_children.push(malformed_region_shape_open)
    malformed_region_shape_children.push(malformed_region_shape_alloc)
    malformed_region_shape_children.push(malformed_region_shape_close)
    malformed_region_shape_report: usize = add_node(&malformed_region_shape_nodes, "resource-safety", "", 0, 0, 0, malformed_region_shape_start, 3, 0, "malformed-region-shape", "resource-v1")
    malformed_region_shape_admitted: bool = proof_kernel_replay_resource_report(&malformed_region_shape_nodes, &malformed_region_shape_children, [], malformed_region_shape_report)
    return 69 if malformed_region_shape_admitted

    malformed_summary_nodes: mutable darray[ProofKernelNode] = []
    malformed_summary_children: mutable darray[usize] = []
    malformed_summary_formal: usize = add_node(&malformed_summary_nodes, "resource-bind", "value", 0, 0, 0, 0, 0, 0, "argument", "")
    malformed_summary_late_region: usize = add_node(&malformed_summary_nodes, "resource-region-param", "external", 0, 0, 0, 0, 0, 0, "r", "")
    malformed_summary_body_source: usize = add_node(&malformed_summary_nodes, "resource-bind", "external-shared", 0, 0, 0, 0, 0, 0, "body_source", "r")
    malformed_summary_return: usize = add_node(&malformed_summary_nodes, "resource-region-return", "param", 0, 0, 0, 0, 0, 0, "r", "")
    malformed_summary_callee_start: usize = malformed_summary_children.count
    malformed_summary_children.push(malformed_summary_formal)
    malformed_summary_children.push(malformed_summary_late_region)
    malformed_summary_children.push(malformed_summary_body_source)
    malformed_summary_children.push(malformed_summary_return)
    malformed_summary_callee: usize = add_node(&malformed_summary_nodes, "resource-safety", "", 0, 0, 1, malformed_summary_callee_start, 4, 0, "malformed-summary", "resource-v1")
    malformed_summary_argument_value: usize = add_node(&malformed_summary_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
    malformed_summary_call_argument: usize = add_node(&malformed_summary_nodes, "resource-call-arg", "value", malformed_summary_argument_value, 0, 0, 0, 0, 0, "argument", "")
    malformed_summary_call_region: usize = add_node(&malformed_summary_nodes, "resource-call-region", "param", 0, 0, 0, 0, 0, 0, "r", "r")
    malformed_summary_children.push(malformed_summary_call_argument)
    malformed_summary_children.push(malformed_summary_call_region)
    malformed_summary_caller_region: usize = add_node(&malformed_summary_nodes, "resource-region-param", "external", 0, 0, 0, 0, 0, 0, "r", "")
    malformed_summary_caller_argument: usize = add_node(&malformed_summary_nodes, "resource-bind", "value", 0, 0, 0, 0, 0, 0, "actual", "")
    malformed_summary_call: usize = add_node(&malformed_summary_nodes, "resource-call", "", malformed_summary_callee, 1, 1, 4, 2, 0, "malformed-summary", "")
    malformed_summary_caller_start: usize = malformed_summary_children.count
    malformed_summary_children.push(malformed_summary_caller_region)
    malformed_summary_children.push(malformed_summary_caller_argument)
    malformed_summary_children.push(malformed_summary_call)
    malformed_summary_caller: usize = add_node(&malformed_summary_nodes, "resource-safety", "", 0, 0, 0, malformed_summary_caller_start, 3, 0, "malformed-summary-caller", "resource-v1")
    malformed_summary_admitted: bool = proof_kernel_replay_resource_report(&malformed_summary_nodes, &malformed_summary_children, [], malformed_summary_caller)
    return 70 if malformed_summary_admitted

    # A region-new call argument is admitted only when it names a live region and points to the
    # exact allocation event. Merely relabelling an arbitrary expression as a fresh allocation
    # must not manufacture a writable temporary in the trusted replay kernel.
    call_temporary_value: usize = add_node(&generic_call_nodes, "int", "", 0, 0, 0, 0, 0, 11, "", "")
    call_temporary_alloc: usize = add_node(&generic_call_nodes, "resource-region-call-alloc", "", call_temporary_value, 0, 0, 0, 0, 0, "", "scratch")
    call_temporary_owner: usize = add_node(&generic_call_nodes, "resource-call-arg", "region-new", call_temporary_alloc, 0, 0, 0, 0, 0, "owner", "scratch")
    call_temporary_children_start: usize = generic_call_children.count
    generic_call_children.push(call_temporary_owner)
    generic_call_children.push(generic_call_arg_value)
    generic_call_children.push(generic_call_region)
    call_temporary_call: usize = add_node(&generic_call_nodes, "resource-call", "", generic_callee, 1, 2, call_temporary_children_start, 3, 0, "make", "")
    call_temporary_result: usize = add_node(&generic_call_nodes, "resource-call-result", "", call_temporary_call, 0, 2, 0, 0, 0, "value", "scratch")
    call_temporary_report_start: usize = generic_call_children.count
    generic_call_children.push(generic_caller_open)
    generic_call_children.push(call_temporary_alloc)
    generic_call_children.push(call_temporary_call)
    generic_call_children.push(call_temporary_result)
    generic_call_children.push(generic_close)
    call_temporary_report: usize = add_node(&generic_call_nodes, "resource-safety", "", 0, 0, 0, call_temporary_report_start, 5, 0, "call-temporary", "resource-v1")
    return 35 if not proof_kernel_replay_resource_report(&generic_call_nodes, &generic_call_children, [], call_temporary_report)

    forged_call_temporary_owner: usize = add_node(&generic_call_nodes, "resource-call-arg", "region-new", call_temporary_value, 0, 0, 0, 0, 0, "owner", "scratch")
    forged_call_temporary_children_start: usize = generic_call_children.count
    generic_call_children.push(forged_call_temporary_owner)
    generic_call_children.push(generic_call_arg_value)
    generic_call_children.push(generic_call_region)
    forged_call_temporary_call: usize = add_node(&generic_call_nodes, "resource-call", "", generic_callee, 1, 2, forged_call_temporary_children_start, 3, 0, "make", "")
    forged_call_temporary_report_start: usize = generic_call_children.count
    generic_call_children.push(generic_caller_open)
    generic_call_children.push(forged_call_temporary_call)
    forged_call_temporary_report: usize = add_node(&generic_call_nodes, "resource-safety", "", 0, 0, 0, forged_call_temporary_report_start, 2, 0, "forged-call-temporary", "resource-v1")
    return 36 if proof_kernel_replay_resource_report(&generic_call_nodes, &generic_call_children, [], forged_call_temporary_report)

    reused_call_children_start: usize = generic_call_children.count
    generic_call_children.push(call_temporary_owner)
    generic_call_children.push(generic_call_arg_value)
    generic_call_children.push(generic_call_region)
    reused_call: usize = add_node(&generic_call_nodes, "resource-call", "", generic_callee, 1, 2, reused_call_children_start, 3, 0, "make", "")
    reused_call_report_start: usize = generic_call_children.count
    generic_call_children.push(generic_caller_open)
    generic_call_children.push(call_temporary_alloc)
    generic_call_children.push(call_temporary_call)
    generic_call_children.push(reused_call)
    reused_call_report: usize = add_node(&generic_call_nodes, "resource-safety", "", 0, 0, 0, reused_call_report_start, 4, 0, "reused-call-allocation", "resource-v1")
    reused_call_admitted: bool = proof_kernel_replay_resource_report(&generic_call_nodes, &generic_call_children, [], reused_call_report)
    return 52 if reused_call_admitted

    # Region rebinding is a write to the target binding. It may not resurrect a moved target.
    illegal_region_nodes: mutable darray[ProofKernelNode] = []
    illegal_region_children: mutable darray[usize] = []
    illegal_region_open: usize = add_node(&illegal_region_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "r", "")
    illegal_region_source_value: usize = add_node(&illegal_region_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
    illegal_region_source: usize = add_node(&illegal_region_nodes, "resource-region-alloc", "", illegal_region_source_value, 0, 2, 0, 0, 0, "source", "r")
    illegal_region_target_value: usize = add_node(&illegal_region_nodes, "int", "", 0, 0, 0, 0, 0, 2, "", "")
    illegal_region_target: usize = add_node(&illegal_region_nodes, "resource-region-alloc", "", illegal_region_target_value, 0, 2, 0, 0, 0, "target", "r")
    illegal_region_target_place: usize = add_node(&illegal_region_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "target", "")
    illegal_region_move: usize = add_node(&illegal_region_nodes, "resource-move", "", illegal_region_target_place, 0, 0, 0, 0, 0, "target", "")
    illegal_region_source_place: usize = add_node(&illegal_region_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "source", "")
    illegal_region_assign: usize = add_node(&illegal_region_nodes, "resource-region-assign", "", illegal_region_source_place, 0, 0, 0, 0, 0, "target", "r")
    illegal_region_children.push(illegal_region_open)
    illegal_region_children.push(illegal_region_source)
    illegal_region_children.push(illegal_region_target)
    illegal_region_children.push(illegal_region_move)
    illegal_region_children.push(illegal_region_assign)
    illegal_region_root: usize = add_node(&illegal_region_nodes, "resource-safety", "", 0, 0, 0, 0, 5, 0, "illegal-region-rebind", "resource-v1")
    illegal_region_admitted: bool = proof_kernel_replay_resource_report(&illegal_region_nodes, &illegal_region_children, [], illegal_region_root)
    return 47 if illegal_region_admitted

    # A fresh region allocation also cannot overwrite a root while any overlapping borrow is live.
    illegal_borrow_nodes: mutable darray[ProofKernelNode] = []
    illegal_borrow_children: mutable darray[usize] = []
    illegal_borrow_open: usize = add_node(&illegal_borrow_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "r", "")
    illegal_borrow_owner_value: usize = add_node(&illegal_borrow_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
    illegal_borrow_owner: usize = add_node(&illegal_borrow_nodes, "resource-region-alloc", "", illegal_borrow_owner_value, 0, 2, 0, 0, 0, "owner", "r")
    illegal_borrow_place: usize = add_node(&illegal_borrow_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "owner", "")
    illegal_borrow_alias: usize = add_node(&illegal_borrow_nodes, "resource-bind", "shared", illegal_borrow_place, 0, 0, 0, 0, 0, "alias", "owner")
    illegal_borrow_replacement_value: usize = add_node(&illegal_borrow_nodes, "int", "", 0, 0, 0, 0, 0, 2, "", "")
    illegal_borrow_replacement: usize = add_node(&illegal_borrow_nodes, "resource-region-rebind-alloc", "", illegal_borrow_replacement_value, 0, 0, 0, 0, 0, "owner", "r")
    illegal_borrow_children.push(illegal_borrow_open)
    illegal_borrow_children.push(illegal_borrow_owner)
    illegal_borrow_children.push(illegal_borrow_alias)
    illegal_borrow_children.push(illegal_borrow_replacement)
    illegal_borrow_root: usize = add_node(&illegal_borrow_nodes, "resource-safety", "", 0, 0, 0, 0, 4, 0, "illegal-borrow-rebind", "resource-v1")
    illegal_borrow_admitted: bool = proof_kernel_replay_resource_report(&illegal_borrow_nodes, &illegal_borrow_children, [], illegal_borrow_root)
    return 48 if illegal_borrow_admitted

    # A return-region marker must be backed by an exact replayed resource transition. A naked
    # marker, or a marker attached to an ordinary scalar use, cannot manufacture a reference.
    naked_return_nodes: mutable darray[ProofKernelNode] = []
    naked_return_children: mutable darray[usize] = []
    naked_return_param: usize = add_node(&naked_return_nodes, "resource-region-param", "external", 0, 0, 0, 0, 0, 0, "r", "")
    naked_return_marker: usize = add_node(&naked_return_nodes, "resource-region-return", "param", 0, 0, 0, 0, 0, 0, "r", "")
    naked_return_children.push(naked_return_param)
    naked_return_children.push(naked_return_marker)
    naked_return_root: usize = add_node(&naked_return_nodes, "resource-safety", "", 0, 0, 0, 0, 2, 0, "naked-return", "resource-v1")
    naked_return_admitted: bool = proof_kernel_replay_resource_report(&naked_return_nodes, &naked_return_children, [], naked_return_root)
    return 49 if naked_return_admitted

    forged_scalar_return_nodes: mutable darray[ProofKernelNode] = []
    forged_scalar_return_children: mutable darray[usize] = []
    forged_scalar_return_param: usize = add_node(&forged_scalar_return_nodes, "resource-region-param", "external", 0, 0, 0, 0, 0, 0, "r", "")
    forged_scalar_return_owner: usize = add_node(&forged_scalar_return_nodes, "resource-bind", "external-shared", 0, 0, 0, 0, 0, 0, "owner", "r")
    forged_scalar_return_bind: usize = add_node(&forged_scalar_return_nodes, "resource-bind", "value", 0, 0, 0, 0, 0, 0, "scalar", "")
    forged_scalar_return_place: usize = add_node(&forged_scalar_return_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "scalar", "")
    forged_scalar_return_use: usize = add_node(&forged_scalar_return_nodes, "resource-use", "", forged_scalar_return_place, 0, 0, 0, 0, 0, "scalar", "")
    forged_scalar_return_marker: usize = add_node(&forged_scalar_return_nodes, "resource-region-return", "param", forged_scalar_return_use, 0, 0, 0, 0, 0, "r", "")
    forged_scalar_return_children.push(forged_scalar_return_param)
    forged_scalar_return_children.push(forged_scalar_return_owner)
    forged_scalar_return_children.push(forged_scalar_return_bind)
    forged_scalar_return_children.push(forged_scalar_return_use)
    forged_scalar_return_children.push(forged_scalar_return_marker)
    forged_scalar_return_root: usize = add_node(&forged_scalar_return_nodes, "resource-safety", "", 0, 0, 0, 0, 5, 0, "forged-scalar-return", "resource-v1")
    forged_scalar_return_admitted: bool = proof_kernel_replay_resource_report(&forged_scalar_return_nodes, &forged_scalar_return_children, [], forged_scalar_return_root)
    return 50 if forged_scalar_return_admitted

    # A returned allocation cannot hide a region-owned operand behind a valid allocation and
    # return witness. The operand itself must be region-free; otherwise a shorter lifetime could
    # be smuggled into storage owned by the external region.
    nested_return_nodes: mutable darray[ProofKernelNode] = []
    nested_return_children: mutable darray[usize] = []
    nested_return_param: usize = add_node(&nested_return_nodes, "resource-region-param", "external", 0, 0, 0, 0, 0, 0, "r", "")
    nested_return_owner: usize = add_node(&nested_return_nodes, "resource-bind", "external-shared", 0, 0, 0, 0, 0, 0, "owner", "r")
    nested_return_owner_place: usize = add_node(&nested_return_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "owner", "")
    nested_return_alloc: usize = add_node(&nested_return_nodes, "resource-region-return-alloc", "", nested_return_owner_place, 0, 0, 0, 0, 0, "", "r")
    nested_return_marker: usize = add_node(&nested_return_nodes, "resource-region-return", "param", nested_return_alloc, 0, 0, 0, 0, 0, "r", "")
    nested_return_children.push(nested_return_param)
    nested_return_children.push(nested_return_owner)
    nested_return_children.push(nested_return_alloc)
    nested_return_children.push(nested_return_marker)
    nested_return_root: usize = add_node(&nested_return_nodes, "resource-safety", "", 0, 0, 0, 0, 4, 0, "nested-region-return", "resource-v1")
    nested_return_admitted: bool = proof_kernel_replay_resource_report(&nested_return_nodes, &nested_return_children, [], nested_return_root)
    return 51 if nested_return_admitted

    # Rewriting under a quantifier body is rejected until the arena has binding-aware names.
    # Otherwise a free replacement name can be captured by the body's binder (`y == x` under
    # `forall x`), changing the proposition rather than applying a valid equality congruence.
    rewrite_nodes: mutable darray[ProofKernelNode] = []
    rewrite_children: mutable darray[usize] = []
    rewrite_x: usize = add_node(&rewrite_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "x", "")
    rewrite_y: usize = add_node(&rewrite_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "y", "")
    rewrite_zero: usize = add_node(&rewrite_nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
    rewrite_one: usize = add_node(&rewrite_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
    rewrite_children.push(rewrite_zero)
    rewrite_children.push(rewrite_one)
    rewrite_range: usize = add_node(&rewrite_nodes, "array", "", 0, 0, 0, 0, 2, 0, "", "")
    rewrite_fact: usize = add_node(&rewrite_nodes, "binary", "==", rewrite_y, rewrite_x, 0, 0, 0, 0, "", "")
    rewrite_before_body: usize = add_node(&rewrite_nodes, "binary", "==", rewrite_y, rewrite_x, 0, 0, 0, 0, "", "")
    rewrite_after_body: usize = add_node(&rewrite_nodes, "binary", "==", rewrite_x, rewrite_x, 0, 0, 0, 0, "", "")
    rewrite_before_goal: usize = add_node(&rewrite_nodes, "quantifier", "", rewrite_range, rewrite_before_body, 1, 0, 0, 0, "x", "")
    rewrite_after_goal: usize = add_node(&rewrite_nodes, "quantifier", "", rewrite_range, rewrite_after_body, 1, 0, 0, 0, "x", "")
    rewrite_facts: darray[usize] = [rewrite_fact]
    rewrite_step_admitted: bool = proof_kernel_replay_tactic_step(&rewrite_nodes, &rewrite_children, "rewrite", true, false, false, rewrite_facts, rewrite_before_goal, rewrite_facts, rewrite_after_goal, rewrite_y, true, rewrite_x, true, 0, false, "")
    return 40 if rewrite_step_admitted

    # The affine normalizer must not turn the false fixed-value equality
    # `5 - (3 - x) == x + 8` into a proof when x == 0. Its left side is 2 and its right side is 8.
    affine_nodes: mutable darray[ProofKernelNode] = []
    affine_children: mutable darray[usize] = []
    affine_x: usize = add_node(&affine_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "x", "")
    affine_zero: usize = add_node(&affine_nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
    affine_three: usize = add_node(&affine_nodes, "int", "", 0, 0, 0, 0, 0, 3, "", "")
    affine_five: usize = add_node(&affine_nodes, "int", "", 0, 0, 0, 0, 0, 5, "", "")
    affine_eight: usize = add_node(&affine_nodes, "int", "", 0, 0, 0, 0, 0, 8, "", "")
    affine_fact: usize = add_node(&affine_nodes, "binary", "==", affine_x, affine_zero, 0, 0, 0, 0, "", "")
    affine_inner: usize = add_node(&affine_nodes, "binary", "-", affine_three, affine_x, 0, 0, 0, 0, "", "")
    affine_left: usize = add_node(&affine_nodes, "binary", "-", affine_five, affine_inner, 0, 0, 0, 0, "", "")
    affine_right: usize = add_node(&affine_nodes, "binary", "+", affine_x, affine_eight, 0, 0, 0, 0, "", "")
    affine_goal: usize = add_node(&affine_nodes, "binary", "==", affine_left, affine_right, 0, 0, 0, 0, "", "")
    affine_admitted: bool = proof_kernel_replay_goal_report(&affine_nodes, &affine_children, [affine_fact], affine_goal)
    return 41 if affine_admitted

    # Instantiation must preserve the goal and must reject substitution through a nested binder.
    # Replacing outer x with y under `forall y` would capture the free y from the chosen value.
    instantiate_nodes: mutable darray[ProofKernelNode] = []
    instantiate_children: mutable darray[usize] = []
