def change_scratch(scratch: mutable array[u8, 8]&) -> void:
    changes scratch
    scratch[0] <- 0

def keep_disjoint_quantified_rows(scratch: mutable array[u8, 8]&, rows: array[usize, 8]&) -> i64:
    requires forall index in 0..<8: rows[index] == 64
    ensure forall index in 0..<8: rows[index] == 64
    change_scratch(scratch)
    return 0

def keep_disjoint_scalar_literal(scratch: mutable array[u8, 8]&, value: i64) -> i64:
    requires value == 64
    ensure result == 64
    change_scratch(scratch)
    return value
