# The boundary of the shared-reference call rule. A capability the callee may write through, one
# that outlives the call, or one whose lifetime the callee controls all still require the callee's
# own converged resource summary, which a recursive component cannot have.
struct Node:
    kind: sview
    left: usize

# The callee may write through a mutable reference, so the caller needs its summary to know what
# it wrote. A recursive component has none.
def recursive_mutate(nodes: mutable darray[Node]&, root: usize, depth: usize) -> usize:
    requires depth <= 127
    decreases 127 - depth
    return 0 if depth >= 127
    nodes.push(Node{kind: "", left: root})
    return recursive_mutate(nodes, root, depth + 1)

# A returned reference is a capability that outlives the call; placing it needs the callee's own
# trace, not just its parameter modes.
def recursive_reference_return(nodes: darray[Node]&, root: usize, depth: usize) -> Node&:
    requires depth <= 127
    decreases 127 - depth
    return nodes[0] if depth >= 127 or root >= nodes.count
    return recursive_reference_return(nodes, root + 1, depth + 1)

# A moved binding is not a capability the caller still holds, whatever the callee's parameter
# modes are.
def shared_walk(nodes: darray[Node]&, root: usize) -> usize:
    return 0 if root >= nodes.count
    return 1

def lends_moved_value(root: usize) -> usize:
    owned: darray[Node] = []
    taken: darray[Node] = move owned
    return shared_walk(owned, root) + taken.count

# Shared and exclusive access to one place cannot be live together. Without the callee's summary
# nothing says its read stays inside the reference being lent, so an exclusive borrow of the lent
# place that is still live across the call keeps the rule from applying.
struct Inner:
    value: mutable i64

def unsummarized_read(inner: Inner&, index: usize) -> i64:
    values: darray[i64] = []
    return values[index] + inner.value

def lends_shared_while_mutably_borrowed(box: mutable Inner&) -> i64:
    exclusive: mutable i64& = &box.value
    result: i64 = unsummarized_read(box, 0)
    return result + exclusive
