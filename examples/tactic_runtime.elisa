# Executable dogfood for the Elisa proof-state action layer. Every positive result here is
# produced by the same proof decision procedure used by the source checker; branch actions
# are required to solve both children, and unsupported actions fail without mutating a goal.
include "../../Elisa-compiler/src/semantic/semantic.elisa"
include "../src/proof/kernel_core.elisa"
include "../src/proof/model.elisa"
include "../src/proof/kernel.elisa"
include "../src/proof/expr.elisa"
include "../src/proof/linear.elisa"
include "../src/proof/resources.elisa"
include "../src/proof/check.elisa"
include "../src/proof/kernel_replay.elisa"
include "../src/proof/replay.elisa"
include "../src/proof/tactics.elisa"

using Ast
using ElisaProof
using ElisaProofKernelReplay

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    region r(65536):
        store: Ast::Node.Store[Local] = Ast::Node.Store(r)
        in store:
            position: Ast::Pos = Ast::pos_at_line(1)
            annotations: mutable darray[Ast::EnumAnnotation] = []
            empty: mutable darray[Ast::Expr] = []
            x: Ast::Expr = Ast::Expr.Ident("x", position)
            zero: Ast::Expr = Ast::Expr.IntLit(0)
            one: Ast::Expr = Ast::Expr.IntLit(1)
            two: Ast::Expr = Ast::Expr.IntLit(2)
            three: Ast::Expr = Ast::Expr.IntLit(3)
            scalar_x_facts: mutable darray[Ast::Expr] = []
            scalar_x_facts.push(Ast::Expr.Call(Ast::Expr.Ident("__elisa_primitive_scalar_type", position), [x], [], position))

            source_binding_report: mutable ProofReport = proof_empty_report()
            source_binding_facts: mutable darray[Ast::Expr] = []
            source_binding_fact: Ast::Expr = Ast::Expr.Binary(x, TokenKind.EqEq, zero, position)
            proof_add_traced_fact(&source_binding_facts, &source_binding_report, source_binding_fact, "precondition", 1, "binding")
            proof_add_goal_attempt(&source_binding_report, source_binding_facts, Ast::Expr.BoolLit(false), 1, "binding", "goal", false)
            return 113 if not proof_tactic_source_state_matches(source_binding_report, 0, source_binding_facts, Ast::Expr.BoolLit(false))
            return 114 if proof_tactic_source_state_matches(source_binding_report, 0, source_binding_facts, Ast::Expr.BoolLit(true))
            forged_source_facts: darray[Ast::Expr] = [Ast::Expr.BoolLit(false)]
            return 115 if proof_tactic_source_state_matches(source_binding_report, 0, forged_source_facts, Ast::Expr.BoolLit(false))
            source_binding_report.goal_attempts.clear()
            source_binding_report.goal_attempts.push(ProofGoalAttempt{goal: Ast::Expr.BoolLit(false), budget_exhausted: false, facts_start: source_binding_report.certificate_facts.count + 1, facts_count: 1, kernel_goal: 0, kernel_facts_start: 0, kernel_facts_count: 1, line: 1, name: "binding", rule: "goal", proven: false, has_certificate: false, certificate_index: 0})
            return 116 if proof_tactic_source_state_matches(source_binding_report, 0, source_binding_facts, Ast::Expr.BoolLit(false))

            implication: Ast::Expr = Ast::Expr.Binary(Ast::Expr.Binary(x, TokenKind.GtEq, zero, position), TokenKind.FatArrow, Ast::Expr.Binary(Ast::Expr.Binary(x, TokenKind.Plus, one, position), TokenKind.GtEq, one, position), position)
            implication_state: mutable ProofTacticState = proof_tactic_state(&scalar_x_facts, implication)
            return 1 if not proof_tactic_intro(&implication_state)
            return 2 if not proof_tactic_exact(&implication_state, &annotations)
            return 3 if not implication_state.solved
            return 34 if not proof_tactic_replay(&implication_state, &annotations)
            return 68 if not proof_tactic_kernel_trace_replay(&implication_state, &annotations)
            return 53 if not proof_tactic_kernel_replay(&implication_state, &annotations)
            return 88 if not proof_tactic_kernel_certificate_replay(&implication_state, &annotations)

            simplify_state: mutable ProofTacticState = proof_tactic_state(&empty, Ast::Expr.Binary(Ast::Expr.Binary(one, TokenKind.Plus, two, position), TokenKind.EqEq, three, position))
            return 16 if not proof_tactic_simplify(&simplify_state, &annotations)
            return 17 if not simplify_state.solved
            return 35 if not proof_tactic_replay(&simplify_state, &annotations)
            return 69 if not proof_tactic_kernel_trace_replay(&simplify_state, &annotations)
            return 54 if not proof_tactic_kernel_replay(&simplify_state, &annotations)
            overflow_state: mutable ProofTacticState = proof_tactic_state(&empty, Ast::Expr.Binary(Ast::Expr.Binary(Ast::Expr.IntLit(9223372036854775807), TokenKind.Plus, one, position), TokenKind.EqEq, Ast::Expr.IntLit(0), position))
            return 18 if proof_tactic_simplify(&overflow_state, &annotations)
            return 19 if overflow_state.solved
            return 36 if not proof_tactic_replay(&overflow_state, &annotations)

            quantifier_statements: mutable darray[Ast::Stmt] = []
            quantifier_range: Ast::Expr = Ast::Expr.Binary(zero, TokenKind.RangeLt, three, position)
            quantifier_statements.push(Ast::Stmt.VarDecl("i", Ast::Expr.Ident("i64", position), quantifier_range, position))
            quantifier_captures: mutable darray[sview] = []
            quantifier: Ast::Expr = Ast::Expr.Block(quantifier_statements, Ast::Expr.Binary(Ast::Expr.Ident("i", position), TokenKind.GtEq, zero, position), quantifier_captures, position)
            quantifier_annotations: mutable darray[Ast::EnumAnnotation] = []
            quantifier_annotations.push(Ast::EnumAnnotation{owner: "__contract_quantifier", name: "forall", line: 1})
            # Source/arena agreement includes the quantifier kind, even when the body is
            # unchanged. Changing only forall to exists must invalidate source binding.
            quantifier_report: mutable ProofReport = proof_empty_report()
            quantifier_report.source_annotations.extend(quantifier_annotations)
            quantifier_root: usize = proof_kernel_encode_annotated(quantifier, &quantifier_report.kernel_nodes, &quantifier_report.kernel_children, quantifier_report.source_annotations)
            return 111 if not proof_replay_ast_matches_kernel(quantifier_report, quantifier, quantifier_root, 0)
            quantifier_report.kernel_nodes[quantifier_root].operator <- "exists"
            return 112 if proof_replay_ast_matches_kernel(quantifier_report, quantifier, quantifier_root, 0)
            source_quantifier_report: mutable ProofReport = proof_empty_report()
            source_quantifier_report.source_annotations.extend(quantifier_annotations)
            source_quantifier_facts: mutable darray[Ast::Expr] = []
            proof_add_goal_attempt(&source_quantifier_report, source_quantifier_facts, quantifier, 1, "quantifier-binding", "quantifier-forall", false)
            return 117 if not proof_tactic_source_state_matches(source_quantifier_report, 0, source_quantifier_facts, quantifier)
            forged_quantifier_statements: mutable darray[Ast::Stmt] = []
            forged_quantifier_statements.push(Ast::Stmt.VarDecl("i", Ast::Expr.Ident("bool", position), quantifier_range, position))
            forged_quantifier: Ast::Expr = Ast::Expr.Block(forged_quantifier_statements, Ast::Expr.Binary(Ast::Expr.Ident("i", position), TokenKind.GtEq, zero, position), quantifier_captures, position)
            return 118 if proof_tactic_source_state_matches(source_quantifier_report, 0, source_quantifier_facts, forged_quantifier)
            quantifier_facts: mutable darray[Ast::Expr] = []
            quantifier_facts.push(quantifier)
            quantifier_state: mutable ProofTacticState = proof_tactic_state(&quantifier_facts, Ast::Expr.Binary(Ast::Expr.IntLit(1), TokenKind.GtEq, zero, position))
            return 20 if not proof_tactic_instantiate(&quantifier_state, 0, one, &quantifier_annotations)
            return 70 if not proof_tactic_kernel_trace_replay(&quantifier_state, &quantifier_annotations)
            return 37 if not proof_tactic_replay(&quantifier_state, &quantifier_annotations)
            return 21 if not proof_tactic_assumption(&quantifier_state, &quantifier_annotations)
            return 52 if not proof_tactic_replay(&quantifier_state, &quantifier_annotations)
            return 55 if not proof_tactic_kernel_replay(&quantifier_state, &quantifier_annotations)

            # Source summary substitution must reject a replacement whose free name would be
            # captured by the quantifier binder. The independent kernel has the same fail-closed
            # rule; this checks the AST-level replay path used to instantiate contracts.
            capture_condition: Ast::Expr = Ast::Expr.BoolLit(true)
            capture_body: Ast::Expr = Ast::Expr.BoolLit(true)
            capture_comprehension: Ast::Expr = Ast::Expr.Comprehension("i", Ast::Expr.Array(empty, position), capture_condition, capture_body, position)
            captured_comprehension: Ast::Expr = proof_replay_substitute(capture_comprehension, "x", Ast::Expr.Ident("i", position))
            match captured_comprehension:
                Ast::Expr.Invalid:
                    pass
                _:
                    return 98
            capture_block_statements: mutable darray[Ast::Stmt] = []
            capture_block_statements.push(Ast::Stmt.VarDecl("i", Ast::Expr.Ident("i64", position), Ast::Expr.Array(empty, position), position))
            capture_block_captures: mutable darray[sview] = []
            capture_block: Ast::Expr = Ast::Expr.Block(capture_block_statements, capture_body, capture_block_captures, position)
            captured_block: Ast::Expr = proof_replay_substitute(capture_block, "x", Ast::Expr.Ident("i", position))
            match captured_block:
                Ast::Expr.Invalid:
                    pass
                _:
                    return 99
            substitution_names: mutable darray[sview] = []
            substitution_values: mutable darray[Ast::Expr] = []
            substitution_names.push("x")
            substitution_values.push(Ast::Expr.Ident("i", position))
            source_captured_comprehension: Ast::Expr = proof_substitute(capture_comprehension, substitution_names, substitution_values)
            match source_captured_comprehension:
                Ast::Expr.Invalid:
                    pass
                _:
                    return 100
            old_names: mutable darray[sview] = []
            old_values: mutable darray[Ast::Expr] = []
            contract_captured_comprehension: Ast::Expr = proof_substitute_contract(capture_comprehension, substitution_names, substitution_values, old_names, old_values)
            match contract_captured_comprehension:
                Ast::Expr.Invalid:
                    pass
                _:
                    return 101
            source_captured_block: Ast::Expr = proof_substitute(capture_block, substitution_names, substitution_values)
            match source_captured_block:
                Ast::Expr.Invalid:
                    pass
                _:
                    return 102
            contract_captured_block: Ast::Expr = proof_substitute_contract(capture_block, substitution_names, substitution_values, old_names, old_values)
            match contract_captured_block:
                Ast::Expr.Invalid:
                    pass
                _:
                    return 103

            collection_position: Ast::Pos = Ast::pos_at_line(2)
            collection_statements: mutable darray[Ast::Stmt] = []
            collection_elements: mutable darray[Ast::Expr] = []
            collection_elements.push(one)
            collection_elements.push(two)
            collection_statements.push(Ast::Stmt.VarDecl("value", Ast::Expr.Ident("i64", collection_position), Ast::Expr.Array(collection_elements, collection_position), collection_position))
            collection_captures: mutable darray[sview] = []
            collection_quantifier: Ast::Expr = Ast::Expr.Block(collection_statements, Ast::Expr.Binary(Ast::Expr.Ident("value", collection_position), TokenKind.EqEq, two, collection_position), collection_captures, collection_position)
            collection_annotations: mutable darray[Ast::EnumAnnotation] = []
            collection_annotations.push(Ast::EnumAnnotation{owner: "__contract_quantifier", name: "forall", line: 2})
            collection_facts: mutable darray[Ast::Expr] = []
            collection_facts.push(collection_quantifier)
            collection_state: mutable ProofTacticState = proof_tactic_state(&collection_facts, Ast::Expr.Binary(two, TokenKind.EqEq, two, collection_position))
            return 30 if proof_tactic_instantiate(&collection_state, 0, three, &collection_annotations)
            return 31 if collection_state.facts.count != 1
            return 32 if not proof_tactic_instantiate(&collection_state, 0, two, &collection_annotations)
            return 33 if not proof_tactic_assumption(&collection_state, &collection_annotations)
            return 38 if not proof_tactic_replay(&collection_state, &collection_annotations)
            return 71 if not proof_tactic_kernel_trace_replay(&collection_state, &collection_annotations)
            return 56 if not proof_tactic_kernel_replay(&collection_state, &collection_annotations)
            return 89 if not proof_tactic_kernel_certificate_replay(&collection_state, &collection_annotations)

            # A dictionary quantifier's second binder is synthetic and its initializer is
            # erased by the source-neutral encoder. An imported AST must not replace that dummy
            # zero with a hidden call and still receive a valid quantifier certificate.
            malformed_dictionary_entries: mutable darray[Ast::DictEntry] = []
            malformed_dictionary_statements: mutable darray[Ast::Stmt] = []
            malformed_dictionary_statements.push(Ast::Stmt.VarDecl("key", Ast::Expr.Ident("i64", collection_position), Ast::Expr.DictLit(malformed_dictionary_entries, collection_position), collection_position))
            malformed_dictionary_call: Ast::Expr = Ast::Expr.Call(Ast::Expr.Ident("hidden", collection_position), empty, empty, collection_position)
            malformed_dictionary_statements.push(Ast::Stmt.VarDecl("value", Ast::Expr.Ident("i64", collection_position), malformed_dictionary_call, collection_position))
            malformed_dictionary: Ast::Expr = Ast::Expr.Block(malformed_dictionary_statements, Ast::Expr.BoolLit(true), collection_captures, collection_position)
            malformed_dictionary_nodes: mutable darray[ProofKernelNode] = []
            malformed_dictionary_children: mutable darray[usize] = []
            malformed_dictionary_root: usize = proof_kernel_encode_expression(malformed_dictionary, &malformed_dictionary_nodes, &malformed_dictionary_children)
            return 104 if proof_kernel_replay_quantifier_report(&malformed_dictionary_nodes, &malformed_dictionary_children, "forall", [], malformed_dictionary_root)

            apply_fact: mutable darray[Ast::Expr] = []
            apply_fact.push(Ast::Expr.Call(Ast::Expr.Ident("__elisa_primitive_scalar_type", position), [x], [], position))
            apply_fact.push(Ast::Expr.Binary(x, TokenKind.EqEq, zero, position))
            apply_fact.push(Ast::Expr.Binary(Ast::Expr.Binary(x, TokenKind.EqEq, zero, position), TokenKind.FatArrow, Ast::Expr.Binary(x, TokenKind.GtEq, zero, position), position))
            apply_state: mutable ProofTacticState = proof_tactic_state(&apply_fact, Ast::Expr.Binary(x, TokenKind.GtEq, zero, position))
            return 22 if not proof_tactic_apply(&apply_state, &annotations)
            return 23 if not proof_tactic_assumption(&apply_state, &annotations)
            return 39 if not proof_tactic_replay(&apply_state, &annotations)
            return 72 if not proof_tactic_kernel_trace_replay(&apply_state, &annotations)
            return 57 if not proof_tactic_kernel_replay(&apply_state, &annotations)

            disjunctive_goal: Ast::Expr = Ast::Expr.Binary(Ast::Expr.Binary(one, TokenKind.EqEq, one, position), TokenKind.Or, Ast::Expr.Binary(two, TokenKind.EqEq, two, position), position)
            left_goal_state: mutable ProofTacticState = proof_tactic_state(&empty, disjunctive_goal)
            return 24 if not proof_tactic_left(&left_goal_state)
            return 25 if not proof_tactic_decide(&left_goal_state, &annotations)
            return 40 if not proof_tactic_replay(&left_goal_state, &annotations)
            return 73 if not proof_tactic_kernel_trace_replay(&left_goal_state, &annotations)
            return 58 if not proof_tactic_kernel_replay(&left_goal_state, &annotations)
            right_goal_state: mutable ProofTacticState = proof_tactic_state(&empty, disjunctive_goal)
            return 26 if not proof_tactic_right(&right_goal_state)
            return 27 if not proof_tactic_decide(&right_goal_state, &annotations)
            return 41 if not proof_tactic_replay(&right_goal_state, &annotations)
            return 74 if not proof_tactic_kernel_trace_replay(&right_goal_state, &annotations)
            return 59 if not proof_tactic_kernel_replay(&right_goal_state, &annotations)

            equality_facts: mutable darray[Ast::Expr] = []
            equality_facts.push(Ast::Expr.Call(Ast::Expr.Ident("__elisa_primitive_scalar_type", position), [x], [], position))
            equality_facts.push(Ast::Expr.Binary(x, TokenKind.EqEq, three, position))
            rewrite_goal: Ast::Expr = Ast::Expr.Binary(Ast::Expr.Binary(x, TokenKind.Plus, one, position), TokenKind.EqEq, Ast::Expr.Binary(three, TokenKind.Plus, one, position), position)
            rewrite_state: mutable ProofTacticState = proof_tactic_state(&equality_facts, rewrite_goal)
            return 4 if not proof_tactic_rewrite(&rewrite_state, x, three)
            return 5 if not proof_tactic_decide(&rewrite_state, &annotations)
            return 42 if not proof_tactic_replay(&rewrite_state, &annotations)
            return 75 if not proof_tactic_kernel_trace_replay(&rewrite_state, &annotations)
            return 60 if not proof_tactic_kernel_replay(&rewrite_state, &annotations)

            compound_source: Ast::Expr = Ast::Expr.Binary(x, TokenKind.Plus, one, position)
            compound_equality_facts: mutable darray[Ast::Expr] = []
            compound_equality_facts.push(Ast::Expr.Call(Ast::Expr.Ident("__elisa_primitive_scalar_type", position), [x], [], position))
            compound_equality_facts.push(Ast::Expr.Binary(compound_source, TokenKind.EqEq, three, position))
            compound_rewrite_goal: Ast::Expr = Ast::Expr.Binary(Ast::Expr.Binary(compound_source, TokenKind.Star, two, position), TokenKind.EqEq, Ast::Expr.Binary(three, TokenKind.Star, two, position), position)
            compound_rewrite_state: mutable ProofTacticState = proof_tactic_state(&compound_equality_facts, compound_rewrite_goal)
            return 93 if not proof_tactic_rewrite(&compound_rewrite_state, compound_source, three)
            return 94 if not proof_tactic_decide(&compound_rewrite_state, &annotations)
            return 95 if not proof_tactic_replay(&compound_rewrite_state, &annotations)
            return 96 if not proof_tactic_kernel_trace_replay(&compound_rewrite_state, &annotations)
            return 97 if not proof_tactic_kernel_certificate_replay(&compound_rewrite_state, &annotations)

            have_state: mutable ProofTacticState = proof_tactic_state(&empty, Ast::Expr.Binary(one, TokenKind.EqEq, one, position))
            return 6 if not proof_tactic_have(&have_state, Ast::Expr.Binary(two, TokenKind.EqEq, two, position), &annotations)
            return 7 if not proof_tactic_exact(&have_state, &annotations)
            return 43 if not proof_tactic_replay(&have_state, &annotations)
            return 76 if not proof_tactic_kernel_trace_replay(&have_state, &annotations)
            return 61 if not proof_tactic_kernel_replay(&have_state, &annotations)

            conjunction: Ast::Expr = Ast::Expr.Binary(Ast::Expr.Binary(one, TokenKind.EqEq, one, position), TokenKind.And, Ast::Expr.Binary(two, TokenKind.EqEq, two, position), position)
            split_state: mutable ProofTacticState = proof_tactic_state(&empty, conjunction)
            left_state: mutable ProofTacticState = proof_tactic_state(&empty, Ast::Expr.BoolLit(false))
            right_state: mutable ProofTacticState = proof_tactic_state(&empty, Ast::Expr.BoolLit(false))
            return 8 if not proof_tactic_split(&split_state, &left_state, &right_state)
            return 9 if not proof_tactic_decide(&left_state, &annotations)
            return 10 if not proof_tactic_decide(&right_state, &annotations)
            return 44 if not proof_tactic_replay(&split_state, &annotations)
            return 77 if not proof_tactic_kernel_trace_replay(&split_state, &annotations)
            return 90 if proof_tactic_kernel_certificate_replay(&split_state, &annotations)
            return 91 if not proof_tactic_kernel_branch_certificate_replay(&split_state, &left_state, &right_state, &annotations)
            return 45 if not proof_tactic_replay(&left_state, &annotations)
            return 78 if not proof_tactic_kernel_trace_replay(&left_state, &annotations)
            return 46 if not proof_tactic_replay(&right_state, &annotations)
            return 79 if not proof_tactic_kernel_trace_replay(&right_state, &annotations)
            return 62 if not proof_tactic_kernel_replay(&left_state, &annotations)
            return 63 if not proof_tactic_kernel_replay(&right_state, &annotations)

            disjunction: Ast::Expr = Ast::Expr.Binary(Ast::Expr.Binary(x, TokenKind.EqEq, zero, position), TokenKind.Or, Ast::Expr.Binary(x, TokenKind.EqEq, three, position), position)
            case_facts: mutable darray[Ast::Expr] = []
            case_facts.push(Ast::Expr.Call(Ast::Expr.Ident("__elisa_primitive_scalar_type", position), [x], [], position))
            case_facts.push(disjunction)
            cases_state: mutable ProofTacticState = proof_tactic_state(&case_facts, Ast::Expr.Binary(x, TokenKind.EqEq, x, position))
            left_case: mutable ProofTacticState = proof_tactic_state(&empty, Ast::Expr.BoolLit(false))
            right_case: mutable ProofTacticState = proof_tactic_state(&empty, Ast::Expr.BoolLit(false))
            return 11 if not proof_tactic_cases(&cases_state, &left_case, &right_case)
            return 12 if not proof_tactic_decide(&left_case, &annotations)
            return 13 if not proof_tactic_decide(&right_case, &annotations)
            return 47 if not proof_tactic_replay(&cases_state, &annotations)
            return 80 if not proof_tactic_kernel_trace_replay(&cases_state, &annotations)
            return 92 if not proof_tactic_kernel_branch_certificate_replay(&cases_state, &left_case, &right_case, &annotations)
            return 48 if not proof_tactic_replay(&left_case, &annotations)
            return 81 if not proof_tactic_kernel_trace_replay(&left_case, &annotations)
            return 49 if not proof_tactic_replay(&right_case, &annotations)
            return 82 if not proof_tactic_kernel_trace_replay(&right_case, &annotations)
            return 64 if not proof_tactic_kernel_replay(&left_case, &annotations)
            return 65 if not proof_tactic_kernel_replay(&right_case, &annotations)

            rejected_state: mutable ProofTacticState = proof_tactic_state(&empty, Ast::Expr.Binary(one, TokenKind.EqEq, two, position))
            return 28 if proof_tactic_rewrite(&rejected_state, one, two)
            return 29 if rejected_state.solved
            return 50 if not proof_tactic_replay(&rejected_state, &annotations)
            return 83 if not proof_tactic_kernel_trace_replay(&rejected_state, &annotations)
            forged_state: mutable ProofTacticState = proof_tactic_state(&empty, Ast::Expr.Binary(one, TokenKind.EqEq, two, position))
            forged_state.solved <- true
            return 66 if proof_tactic_kernel_replay(&forged_state, &annotations)
            return 84 if proof_tactic_kernel_trace_replay(&forged_state, &annotations)
            return 67 if proof_tactic_replay(&forged_state, &annotations)

            # A hostile imported state may claim a snapshot larger than its flat fact arena.
            # Replay must reject the range before subtracting or indexing it; otherwise an
            # underflow can turn malformed proof data into a runtime trap.
            malformed_trace_state: mutable ProofTacticState = proof_tactic_state(&empty, Ast::Expr.BoolLit(false))
            malformed_trace_state.action_count <- 1
            malformed_trace_state.trace.push(ProofTacticStep{action: "assumption", accepted: false, goal: Ast::Expr.BoolLit(false), facts_start: 0, facts_count: 1, solved: false, reason: "malformed", argument: Ast::Expr.Absent, secondary: Ast::Expr.Absent, has_argument: false, has_secondary: false, argument_index: 0, has_argument_index: false, detail: ""})
            return 107 if proof_tactic_kernel_trace_replay(&malformed_trace_state, &annotations)

            # The bounded integer model must not silently assign an i64 meaning to an
            # untyped/struct identifier. In Elisa, `==` may dispatch to a user protocol
            # method, so this proposition is not admissible without a primitive-scalar
            # witness for both operands.
            opaque_left: Ast::Expr = Ast::Expr.Ident("opaque_left", position)
            opaque_right: Ast::Expr = Ast::Expr.Ident("opaque_right", position)
            opaque_facts: mutable darray[Ast::Expr] = []
            opaque_facts.push(Ast::Expr.Binary(opaque_left, TokenKind.EqEq, opaque_right, position))
            opaque_facts.push(Ast::Expr.Binary(opaque_left, TokenKind.GtEq, zero, position))
            opaque_facts.push(Ast::Expr.Binary(opaque_left, TokenKind.LtEq, zero, position))
            opaque_facts.push(Ast::Expr.Binary(opaque_right, TokenKind.GtEq, zero, position))
            opaque_facts.push(Ast::Expr.Binary(opaque_right, TokenKind.LtEq, zero, position))
            opaque_goal: Ast::Expr = Ast::Expr.Binary(Ast::Expr.Binary(opaque_left, TokenKind.EqEq, opaque_right, position), TokenKind.EqEq, Ast::Expr.BoolLit(true), position)
            opaque_state: mutable ProofTacticState = proof_tactic_state(&opaque_facts, opaque_goal)
            return 105 if proof_tactic_decide(&opaque_state, &annotations)
            opaque_state.solved <- true
            return 106 if proof_tactic_kernel_replay(&opaque_state, &annotations)

            # The independent bounded-model kernel must distinguish a known false Boolean from
            # an unsupported term. This is deliberately a manually closed state: the regression
            # targets kernel admission itself, not the tactic producer's ability to discover it.
            bool_model_facts: mutable darray[Ast::Expr] = []
            bool_model_facts.push(Ast::Expr.Call(Ast::Expr.Ident("__elisa_primitive_scalar_type", position), [x], [], position))
            bool_model_facts.push(Ast::Expr.Binary(x, TokenKind.EqEq, one, position))
            bool_model_goal: Ast::Expr = Ast::Expr.Binary(Ast::Expr.Binary(x, TokenKind.EqEq, zero, position), TokenKind.EqEq, Ast::Expr.BoolLit(false), position)
            bool_model_state: mutable ProofTacticState = proof_tactic_state(&bool_model_facts, bool_model_goal)
            bool_model_state.solved <- true
            return 98 if not proof_tactic_kernel_replay(&bool_model_state, &annotations)
            return 0
