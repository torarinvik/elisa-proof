# G68: an included module's bare constant resolves in its own module. `OuterScope::LIMIT` has
# another type (f64) than `InnerScope::LIMIT` (i64); kernel typing used to see both under the bare
# name, call the inner contract ambiguous, and leave every caller of `within` unverified.
include "./include_constant_scope/inner.elisa"

module OuterScope:
    public:
        const LIMIT: f64 = 0.25

extend InnerScope:
    public:
        def narrow(value: i64) -> bool:
            ensure LIMIT == 10
            ensure not result or value <= 10
            return within(value)

module User:
    public:
        def go(value: i64) -> bool:
            ensure InnerScope::LIMIT == 10
            ensure not result or value <= 10
            return InnerScope::within(value)

# A nested module is recorded under its qualified spelling (`User::Bounds`); `Bounds::FLOOR`
# still names its constant.
extend User:
    private:
        module Bounds:
            public:
                const FLOOR: i64 = 0
    public:
        def keep_floor(value: i64) -> i64:
            requires value >= Bounds::FLOOR
            ensure result >= Bounds::FLOOR
            value
