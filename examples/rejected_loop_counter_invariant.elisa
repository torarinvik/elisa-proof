# A fresh symbol for a self-referential rebind records the new value; it must not record more than
# that, and the increment admitted into the difference graph must still be one that cannot wrap.

# `value + 1` over an unbounded `usize` is exactly the term the wrap guard is for: with no strict
# peer of the same width there is nothing to say the increment stays in range, so the equality is
# not imported and the claim is not proved.
def an_increment_without_a_peer(start: usize) -> usize:
    ensure result >= 1
    value: mutable usize = start
    value <- value + 1
    return value

# A peer bounds an increment by one, not by an arbitrary step. A non-unit step is outside the
# argument and stays outside the graph.
def a_non_unit_step(limit: usize, step: usize) -> usize:
    requires step >= 1
    ensure result <= limit
    rounds: mutable usize = 0
    while rounds < limit |rounds, limit, step|:
        invariant rounds <= limit
        rounds <- rounds + step
    return rounds

# The invariant is false on the iteration that reaches the bound: the body may make `rounds` equal
# to `limit`, and a strict inequality does not survive that.
def a_false_invariant(limit: usize) -> usize:
    rounds: mutable usize = 0
    while rounds < limit |rounds, limit|:
        invariant rounds < limit
        rounds <- rounds + 1
    return rounds

# The counter's new symbol says nothing about the values other bindings hold. A total accumulated
# alongside it is not bounded by the counter's own bound.
def a_counter_is_not_a_total(limit: usize) -> usize:
    ensure result <= limit
    total: mutable usize = 0
    rounds: mutable usize = 0
    while rounds < limit |rounds, limit, total|:
        invariant rounds <= limit
        total <- total + 2
        rounds <- rounds + 1
    return total

# The old symbol keeps the old value, and the source name is bound to the new one. A fact taken
# before the update therefore does not describe the binding after it: if `value == 0` were still
# read as current, this would prove.
def a_pre_update_fact_is_not_current(start: usize) -> usize:
    requires start == 0
    ensure result == 0
    value: mutable usize = start
    value <- value + 1
    return value
