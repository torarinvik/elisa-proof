const module Limits:
    const TOP: i64 = 100
    const LOW: i64 = 0

def lower(x: i64) -> i64:
    requires x >= 0
    ensure result >= Limits::LOW
    return x

def upper(x: i64) -> i64:
    requires x <= 50
    ensure result <= Limits::TOP
    return x

def exact() -> i64:
    ensure result == Limits::TOP
    return 100
