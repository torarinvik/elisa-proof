const module Limits:
    const TOP: i64 = 100

const module Other:
    const TOP: i64 = 5

# The bound is Other::TOP = 5, so returning 50 must not prove.
def wrong_module(x: i64) -> i64:
    requires x <= 50
    ensure result <= Other::TOP
    return x

def wrong_value() -> i64:
    ensure result == Limits::TOP
    return 99
