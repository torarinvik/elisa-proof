def context_byte_nonzero(value: u8) -> bool:
    ensure result == (value != 0)
    return value != 0

def rejected_future_predicate_context(rows: array[u8, 64]&, cursor: i64) -> i64:
    requires cursor == 38
    requires forall index in 0..<64: index >= cursor or context_byte_nonzero(rows[index])
    ensure context_byte_nonzero(rows[38])
    return 0

def rejected_other_array_predicate_context(rows: array[u8, 64]&, other: array[u8, 64]&) -> i64:
    requires forall index in 0..<64: context_byte_nonzero(rows[index])
    ensure context_byte_nonzero(other[37])
    return 0

def rejected_existential_predicate_context(rows: array[u8, 64]&) -> i64:
    requires exists index in 0..<64: context_byte_nonzero(rows[index])
    ensure context_byte_nonzero(rows[37])
    return 0
