# Neither refutation may fire when the escape disjunct can hold.
module ClosedComplementaryRefutationRejected:
    public:
        def seven_unless_positive(d: i64) -> i64:
            ensure result == 7 or d > 0
            return 7 if d <= 0
            d

        def seven_unless_below(e: i64, d: i64) -> i64:
            ensure result == 7 or e < d
            return 7 if e >= d
            e

        # `1 > 0` is closed and true, so the escape holds: nothing is refuted.
        def positive_literal() -> i64:
            ensure result == 7
            seven_unless_positive(1)

        # `e <= d` does not complement `e < d`: at e < d the result is e.
        def weak_requirement(e: i64, d: i64) -> i64:
            requires e <= d
            ensure result == 7
            seven_unless_below(e, d)
