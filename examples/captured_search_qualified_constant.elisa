const module Limits:
    MAX: usize = 4
struct Store:
    flags: mutable bool[4]
def checked(store: mutable Store&) -> void:
    slot: usize = for index in 0..<Limits::MAX |slot: usize = Limits::MAX, store| -> slot:
        invariant slot <= Limits::MAX
        break index if not store.flags[index]
    return if slot == 4
    store.flags[slot] <- true
