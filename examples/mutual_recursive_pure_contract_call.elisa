# A mutually recursive terminating pair can be used as a total pure logical summary when every
# edge decreases the shared ranking measure. The pinned frontend admits an integer mutual cycle
# only under a positive precondition, which makes it partial, so the shared ranking is structural.
enum Nat:
    Zero
    Succ(prev: Nat)

def pure_even(n: Nat) -> i64:
    decreases n
    ensure result == 0
    match n:
        Nat.Zero:
            return 0
        Nat.Succ(prev):
            return pure_odd(prev)

def pure_odd(n: Nat) -> i64:
    decreases n
    ensure result == 0
    match n:
        Nat.Zero:
            return 0
        Nat.Succ(prev):
            return pure_even(prev)

def uses_mutual_recursive_pure_contract_call(n: Nat) -> i64:
    ensure result == pure_even(n)
    return pure_even(n)
