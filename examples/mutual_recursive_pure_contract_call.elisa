# A mutually recursive terminating pair can be used as a total pure logical summary when every
# edge decreases the shared ranking measure.

def pure_even(n: i64) -> i64:
    decreases n
    ensure result == 0
    if n > 0:
        return pure_odd(n - 1)
    return 0

def pure_odd(n: i64) -> i64:
    decreases n
    ensure result == 0
    if n > 0:
        return pure_even(n - 1)
    return 0

def uses_mutual_recursive_pure_contract_call(n: i64) -> i64:
    ensure result == pure_even(n)
    return pure_even(n)
