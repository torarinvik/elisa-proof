module FocusDuplicateSelected:
    module Inner:
        public:
            def shared(value: i64) -> i64:
                ensure result == value
                return value

module FocusDuplicateUnselected:
    module Inner:
        public:
            def shared(pointer: mutable heap void&?) -> u8:
                ensure pointer < null or result == 0
                return 0

def focus_duplicate_module_caller(value: i64) -> i64:
    ensure result == value
    return FocusDuplicateSelected::Inner::shared(value)
