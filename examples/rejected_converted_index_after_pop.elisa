# A converted count is a snapshot. Popping the collection must revoke its binding before
# the old count can be used to justify a later index into the shorter collection.
module RejectedConvertedIndexAfterPop:
    def stale_count_after_pop(values: mutable darray[i64]&, frame: i64) -> i64:
        requires values.count >= 1
        count: i64 = values.count.i64()
        values.pop()
        return 0 if frame < 0 or frame >= count
        return values[frame.usize()]
