# Quantifier syntax admission must still require independently verified purity.
def nonnegative(value: i64) -> bool:
    ensure result == (value >= 0)
    return value >= 0

def quantified_call_hypothesis() -> i64:
    requires forall index in 0..<3: nonnegative(index)
    ensure forall index in 0..<3: nonnegative(index)
    return 0

def quantified_call_disjunction() -> i64:
    requires forall index in 0..<3: nonnegative(index)
    ensure result != 0 or (forall index in 0..<3: nonnegative(index))
    return 0
