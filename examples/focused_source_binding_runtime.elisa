include "./report_inventory_test_support.elisa"
using ElisaProof

const FOCUSED_SOURCE_BINDING_NOT_ENFORCED: i64 = 1
const FOCUSED_SOURCE_BINDING_FORGERY_ADMITTED: i64 = 2
const FOCUSED_SOURCE_BINDING_SOURCE_MUTATION_ADMITTED: i64 = 3
const FOCUSED_PARAMETER_RETURN_INVENTORY_DROPPED: i64 = 4
const FOCUSED_PARAMETER_OPEN_GOAL_UNBOUND: i64 = 5
const FOCUSED_PARAMETER_FORGERY_ADMITTED: i64 = 6
const FOCUSED_PARAMETER_REPLAY_CONTROL_REJECTED: i64 = 7

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    report: mutable ProofReport = ProofReport{declarations: 0, obligations: 0, proven: 0, failed: 0, findings: [], source_declarations: [], declaration_details: [], goal_attempts: [], obligation_inventory: [], current_source_postcondition_count: 0, current_source_postcondition_line: 0, current_source_postcondition_name: "", focused_function: "", certificates: [], theorems: ProofTheoremTable{summaries: []}}
    source_position: Ast::Pos = Ast::pos_at_line(10)
    contract_position: Ast::Pos = Ast::pos_at_line(11)
    return_position: Ast::Pos = Ast::pos_at_line(12)
    source_goal: Ast::Expr = Ast::Expr.Binary(Ast::Expr.Ident("result", contract_position), TokenKind.EqEq, Ast::Expr.IntLit(7, contract_position), contract_position)
    source_contract: Ast::Stmt = Ast::Stmt.Contract("ensure", source_goal, contract_position)
    source_return: Ast::Stmt = Ast::Stmt.Return(Ast::Expr.IntLit(7, return_position), return_position)
    source_body: darray[Ast::Stmt] = [source_contract, source_return]
    source_function: Ast::Decl = Ast::Decl.Func("focused_source_binding_target", [], Ast::Expr.Absent, source_body, [], [], source_position)

    unrelated_position: Ast::Pos = Ast::pos_at_line(20)
    unrelated_contract_one: Ast::Stmt = Ast::Stmt.Contract("ensure", Ast::Expr.BoolLit(true, unrelated_position), unrelated_position)
    unrelated_contract_two: Ast::Stmt = Ast::Stmt.Contract("ensures", Ast::Expr.BoolLit(true, unrelated_position), unrelated_position)
    unrelated_return: Ast::Stmt = Ast::Stmt.Return(Ast::Expr.IntLit(5, unrelated_position), unrelated_position)
    unrelated_body: darray[Ast::Stmt] = [unrelated_contract_one, unrelated_contract_two, unrelated_return]
    unrelated_function: Ast::Decl = Ast::Decl.Func("unrequested_unsupported", [], Ast::Expr.Absent, unrelated_body, [], [], unrelated_position)

    report.source_declarations.push(source_function)
    report.source_declarations.push(unrelated_function)
    report.declaration_details.push(ProofDeclarationSummary{kind: "function", name: "focused_source_binding_target", line: 10, verification_reason: "verified"})
    report.declaration_details.push(ProofDeclarationSummary{kind: "function", name: "unrequested_unsupported", line: 20, verification_reason: "not-requested"})
    report.declarations <- 2
    report.focused_function <- "focused_source_binding_target"
    report.obligations <- 1
    report.proven <- 1
    report.obligation_inventory.push(ProofObligationEntry{identity: 0, proven: true, source_line: 10, source_name: "focused_source_binding_target", source_kind: "postcondition", source_obligation_index: 0})

    replayed_goal: Ast::Expr = Ast::Expr.Binary(Ast::Expr.IntLit(7, contract_position), TokenKind.EqEq, Ast::Expr.IntLit(7, contract_position), contract_position)
    report.goal_attempts.push(ProofGoalAttempt{goal: replayed_goal, budget_exhausted: false, facts_start: 0, facts_count: 0, kernel_goal: 0, kernel_facts_start: 0, kernel_facts_count: 0, line: 11, name: "focused_source_binding_target", rule: "goal", proven: true, has_certificate: true, certificate_index: 0})
    report.certificates.push(ProofGoalCertificate{goal: replayed_goal, facts_start: 0, facts_count: 0, kernel_goal: 0, kernel_facts_start: 0, kernel_facts_count: 0, line: 11, name: "focused_source_binding_target", rule: "goal", replayed: true})
    return FOCUSED_SOURCE_BINDING_NOT_ENFORCED if not proof_report_source_admission_invariants_consistent(report)

    # Change the source return while retaining the original attempt and certificate. The
    # report must derive the newly required goal from current source, not its old ledger.
    mutated_return: Ast::Stmt = Ast::Stmt.Return(Ast::Expr.IntLit(8, return_position), return_position)
    mutated_body: darray[Ast::Stmt] = [source_contract, mutated_return]
    mutated_function: Ast::Decl = Ast::Decl.Func("focused_source_binding_target", [], Ast::Expr.Absent, mutated_body, [], [], source_position)
    report.source_declarations[0] <- mutated_function
    return FOCUSED_SOURCE_BINDING_SOURCE_MUTATION_ADMITTED if proof_report_source_admission_invariants_consistent(report)
    report.source_declarations[0] <- source_function

    # Keep the replay bit and report ledgers intact while changing both displayed goals. The
    # focused source-admission boundary must compare the replayed claim with the imported AST.
    forged_goal: Ast::Expr = Ast::Expr.BoolLit(false, contract_position)
    report.goal_attempts[0] <- ProofGoalAttempt{goal: forged_goal, budget_exhausted: false, facts_start: 0, facts_count: 0, kernel_goal: 0, kernel_facts_start: 0, kernel_facts_count: 0, line: 11, name: "focused_source_binding_target", rule: "goal", proven: true, has_certificate: true, certificate_index: 0}
    report.certificates[0] <- ProofGoalCertificate{goal: forged_goal, facts_start: 0, facts_count: 0, kernel_goal: 0, kernel_facts_start: 0, kernel_facts_count: 0, line: 11, name: "focused_source_binding_target", rule: "goal", replayed: true}
    return FOCUSED_SOURCE_BINDING_FORGERY_ADMITTED if proof_report_source_admission_invariants_consistent(report)

    parameter_position: Ast::Pos = Ast::pos_at_line(30)
    precondition_position: Ast::Pos = Ast::pos_at_line(31)
    parameter_contract_position: Ast::Pos = Ast::pos_at_line(32)
    parameter_return_position: Ast::Pos = Ast::pos_at_line(33)
    parameter: Ast::ParamDecl = Ast::ParamDecl{name: "value", type_expression: Ast::Expr.Ident("i64", parameter_position), is_mutable: false, has_default: false, default_value: Ast::Expr.Invalid}
    precondition: Ast::Stmt = Ast::Stmt.Contract("requires", Ast::Expr.BoolLit(true, precondition_position), precondition_position)
    parameter_contract_goal: Ast::Expr = Ast::Expr.Binary(Ast::Expr.Ident("result", parameter_contract_position), TokenKind.EqEq, Ast::Expr.IntLit(7, parameter_contract_position), parameter_contract_position)
    parameter_contract: Ast::Stmt = Ast::Stmt.Contract("ensure", parameter_contract_goal, contract_position)
    parameter_return: Ast::Stmt = Ast::Stmt.Return(Ast::Expr.Ident("value", parameter_return_position), parameter_return_position)
    parameter_body: darray[Ast::Stmt] = [precondition, parameter_contract, parameter_return]
    parameter_function: Ast::Decl = Ast::Decl.Func("focused_parameter_target", [parameter], Ast::Expr.Absent, parameter_body, [], [], parameter_position)
    parameter_declarations: darray[Ast::Decl] = [parameter_function]
    parameter_inventory: darray[(name: sview, contract_line: u32, contract_value: i64, returned_value: i64, returned_parameter: sview, result_on_left: bool, equality_postcondition: bool)] = proof_source_literal_ensure_inventory(parameter_declarations)
    return FOCUSED_PARAMETER_RETURN_INVENTORY_DROPPED if parameter_inventory.count != 1 or parameter_inventory[0].name != "focused_parameter_target" or parameter_inventory[0].returned_parameter != "value" or parameter_inventory[0].contract_value != 7 or not parameter_inventory[0].result_on_left
    return FOCUSED_PARAMETER_RETURN_INVENTORY_DROPPED if parameter_inventory[0].contract_line == 0 or not parameter_inventory[0].equality_postcondition
    source_literal_position: Ast::Pos = Ast::pos_at_line(parameter_inventory[0].contract_line)
    parameter_goal: Ast::Expr = Ast::Expr.Binary(Ast::Expr.Ident("value", parameter_return_position), TokenKind.EqEq, Ast::Expr.IntLit(7, source_literal_position), source_literal_position)
    parameter_report: mutable ProofReport = ProofReport{declarations: 0, obligations: 0, proven: 0, failed: 0, findings: [], source_declarations: [], declaration_details: [], goal_attempts: [], obligation_inventory: [], current_source_postcondition_count: 0, current_source_postcondition_line: 0, current_source_postcondition_name: "", focused_function: "", certificates: [], theorems: ProofTheoremTable{summaries: []}}
    parameter_report.goal_attempts.push(ProofGoalAttempt{goal: parameter_goal, budget_exhausted: false, facts_start: 0, facts_count: 0, kernel_goal: 0, kernel_facts_start: 0, kernel_facts_count: 0, line: 32, name: "focused_parameter_target", rule: "goal", proven: false, has_certificate: false, certificate_index: 0})
    return FOCUSED_PARAMETER_OPEN_GOAL_UNBOUND if not proof_source_literal_ensure_coverage(parameter_inventory, parameter_report)
    forged_parameter_goal: Ast::Expr = Ast::Expr.Binary(Ast::Expr.Ident("other", parameter_return_position), TokenKind.EqEq, Ast::Expr.IntLit(7, parameter_contract_position), parameter_contract_position)
    parameter_report.goal_attempts[0] <- ProofGoalAttempt{goal: forged_parameter_goal, budget_exhausted: false, facts_start: 0, facts_count: 0, kernel_goal: 0, kernel_facts_start: 0, kernel_facts_count: 0, line: 32, name: "focused_parameter_target", rule: "goal", proven: false, has_certificate: false, certificate_index: 0}
    return FOCUSED_PARAMETER_FORGERY_ADMITTED if proof_source_literal_ensure_coverage(parameter_inventory, parameter_report)
    parameter_report.goal_attempts[0] <- ProofGoalAttempt{goal: parameter_goal, budget_exhausted: false, facts_start: 0, facts_count: 0, kernel_goal: 0, kernel_facts_start: 0, kernel_facts_count: 0, line: 32, name: "focused_parameter_target", rule: "goal", proven: true, has_certificate: true, certificate_index: 0}
    parameter_report.certificates.push(ProofGoalCertificate{goal: parameter_goal, facts_start: 0, facts_count: 0, kernel_goal: 0, kernel_facts_start: 0, kernel_facts_count: 0, line: 32, name: "focused_parameter_target", rule: "goal", replayed: true})
    return FOCUSED_PARAMETER_REPLAY_CONTROL_REJECTED if not proof_source_literal_ensure_coverage(parameter_inventory, parameter_report)
    return 0
