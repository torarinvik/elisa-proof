include "./report_inventory_test_support.elisa"

const FOCUSED_SOURCE_BINDING_NOT_ENFORCED: i64 = 1
const FOCUSED_SOURCE_BINDING_FORGERY_ADMITTED: i64 = 2

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    report: mutable ProofReport = ProofReport{declarations: 0, obligations: 0, proven: 0, failed: 0, findings: [], source_declarations: [], declaration_details: [], goal_attempts: [], obligation_inventory: [], current_source_postcondition_count: 0, current_source_postcondition_line: 0, current_source_postcondition_name: "", focused_function: "", certificates: [], theorems: ProofTheoremTable{summaries: []}}
    source_position: Ast::Pos = Ast::pos_at_line(10)
    contract_position: Ast::Pos = Ast::pos_at_line(11)
    return_position: Ast::Pos = Ast::pos_at_line(12)
    source_goal: Ast::Expr = Ast::Expr.Binary(Ast::Expr.Ident("result", contract_position), TokenKind.EqEq, Ast::Expr.IntLit(7, contract_position), contract_position)
    source_contract: Ast::Stmt = Ast::Stmt.Contract("ensure", source_goal, contract_position)
    source_return: Ast::Stmt = Ast::Stmt.Return(Ast::Expr.IntLit(7, return_position), return_position)
    source_body: darray[Ast::Stmt] = [source_contract, source_return]
    source_function: Ast::Decl = Ast::Decl.Func("focused_source_binding_target", [], Ast::Expr.Absent, source_body, [], [], source_position)

    unrelated_position: Ast::Pos = Ast::pos_at_line(20)
    unrelated_contract_one: Ast::Stmt = Ast::Stmt.Contract("ensure", Ast::Expr.BoolLit(true, unrelated_position), unrelated_position)
    unrelated_contract_two: Ast::Stmt = Ast::Stmt.Contract("ensures", Ast::Expr.BoolLit(true, unrelated_position), unrelated_position)
    unrelated_return: Ast::Stmt = Ast::Stmt.Return(Ast::Expr.IntLit(5, unrelated_position), unrelated_position)
    unrelated_body: darray[Ast::Stmt] = [unrelated_contract_one, unrelated_contract_two, unrelated_return]
    unrelated_function: Ast::Decl = Ast::Decl.Func("unrequested_unsupported", [], Ast::Expr.Absent, unrelated_body, [], [], unrelated_position)

    report.source_declarations.push(source_function)
    report.source_declarations.push(unrelated_function)
    report.declaration_details.push(ProofDeclarationSummary{kind: "function", name: "focused_source_binding_target", line: 10, verification_reason: "verified"})
    report.declaration_details.push(ProofDeclarationSummary{kind: "function", name: "unrequested_unsupported", line: 20, verification_reason: "not-requested"})
    report.declarations <- 2
    report.focused_function <- "focused_source_binding_target"
    report.obligations <- 1
    report.proven <- 1
    report.obligation_inventory.push(ProofObligationEntry{identity: 0, proven: true, source_line: 10, source_name: "focused_source_binding_target", source_kind: "postcondition", source_obligation_index: 0})

    replayed_goal: Ast::Expr = Ast::Expr.Binary(Ast::Expr.IntLit(7, contract_position), TokenKind.EqEq, Ast::Expr.IntLit(7, contract_position), contract_position)
    report.goal_attempts.push(ProofGoalAttempt{goal: replayed_goal, budget_exhausted: false, facts_start: 0, facts_count: 0, kernel_goal: 0, kernel_facts_start: 0, kernel_facts_count: 0, line: 11, name: "focused_source_binding_target", rule: "goal", proven: true, has_certificate: true, certificate_index: 0})
    report.certificates.push(ProofGoalCertificate{goal: replayed_goal, facts_start: 0, facts_count: 0, kernel_goal: 0, kernel_facts_start: 0, kernel_facts_count: 0, line: 11, name: "focused_source_binding_target", rule: "goal", replayed: true})
    return FOCUSED_SOURCE_BINDING_NOT_ENFORCED if not proof_report_source_admission_invariants_consistent(report)

    # Keep the replay bit and report ledgers intact while changing both displayed goals. The
    # focused source-admission boundary must compare the replayed claim with the imported AST.
    forged_goal: Ast::Expr = Ast::Expr.BoolLit(false, contract_position)
    report.goal_attempts[0].goal <- forged_goal
    report.certificates[0].goal <- forged_goal
    return FOCUSED_SOURCE_BINDING_FORGERY_ADMITTED if proof_report_source_admission_invariants_consistent(report)
    return 0
