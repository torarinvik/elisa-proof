# Reflexivity, symmetry, and coherence with arithmetic are not universal in Elisa. `==`, `!=` and
# the four ordering operators dispatch to a user `__eq__`/`__cmp__` whenever an operand's type is
# a struct, and neither protocol method is required to have those properties: an `__eq__` that
# models partial equality may answer false for a value compared with itself, exactly as IEEE NaN
# does. None of these obligations may prove or certify.

struct Partial:
    tag: i64

def reflexive_equality(p: Partial) -> i64:
    ensure p == p
    return 0

def reflexive_order(p: Partial) -> i64:
    ensure p <= p
    return 0

def reflexive_reverse_order(p: Partial) -> i64:
    ensure p >= p
    return 0

# Symmetry is a separate property, and a user `__eq__` is not required to have it either.
def symmetric_equality(p: Partial, q: Partial) -> i64:
    requires p == q
    ensure q == p
    return 0

# A struct-typed local is no different from a struct-typed parameter.
def local_reflexive_equality(p: Partial) -> i64:
    local: Partial = p
    proof local == local:
        pass
    return 0

# A field, an element, and a call result have no witness unless the producer resolved their
# declared type to a primitive scalar. These are struct-typed places, and the call is opaque.
struct Holder:
    part: Partial
    parts: darray[Partial]

def field_reflexive_equality(h: Holder) -> i64:
    ensure h.part == h.part
    return 0

def field_reflexive_order(h: Holder) -> i64:
    ensure h.part <= h.part
    return 0

def element_reflexive_equality(h: Holder, i: usize) -> i64:
    ensure h.parts[i] == h.parts[i]
    return 0

# An opaque call need not be deterministic, so two occurrences of the same call text are not
# one value even when the result type is a primitive scalar.
extern opaque_reading() -> i64

def opaque_call_reflexive_equality() -> i64:
    proof opaque_reading() == opaque_reading():
        assert opaque_reading() == opaque_reading()
    return 0
