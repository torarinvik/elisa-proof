using ScopedAlias as SA

enum RootDevice:
    Keyboard
    Mouse

type RootToken = RootDevice

enum RootToken:
    Other

module ScopedAlias:
    public:
        enum Device:
            Keyboard
            Mouse

        type Token = Device
        type RemoteToken = Device

        enum Token:
            Other

        def module_alias_wins(value: Token) -> bool:
            ensure result == (value == Token::Keyboard)
            value == Token::Keyboard

def root_nominal_wins(value: RootToken) -> bool:
    ensure result == (value == RootToken.Other)
    value == RootToken.Other

def root_import_alias_wins(value: SA::Device) -> bool:
    ensure result == (value == SA::Device::Keyboard)
    value == SA::Device::Keyboard

module AliasConsumer:
    public:
        def cross_module_unique_alias(value: RemoteToken) -> bool:
            ensure result == (value == RemoteToken::Keyboard)
            value == RemoteToken::Keyboard
