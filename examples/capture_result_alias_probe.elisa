# Isolate the invalid-input clause without any call or heap boundary.
def capture_result_alias(kind: u8, status: u8, saved: u8, classified: u8, output: u8) -> u8:
    requires kind <= 1 and status <= 4 or saved == 4
    requires classified == saved
    requires classified <= 3 or output == 0
    ensure kind <= 1 and status <= 4 or result == 0
    return output

def capture_result_direct(kind: u8, status: u8, classified: u8, output: u8) -> u8:
    requires kind <= 1 and status <= 4 or classified == 4
    requires classified <= 3 or output == 0
    ensure kind <= 1 and status <= 4 or result == 0
    return output
