# A literal argument is bound to a fresh name of its parameter's type (`fresh == 0`), so the
# callee's preconditions and summary keep the parameter's width instead of comparing bare
# literals such as `0 >= -LIMIT`, which no width gate can type.
module Clamp:
    public:
        const LIMIT: i64 = 1000000000

        def keep(value: i64, limit: i64) -> i64:
            requires value >= -LIMIT
            requires value <= LIMIT
            requires limit >= 0
            requires limit <= LIMIT
            ensure value > limit or result == value
            return value if value <= limit else limit

        def zero(limit: i64) -> i64:
            requires limit >= 0
            requires limit <= LIMIT
            ensure result == 0
            return Clamp::keep(0, limit)

