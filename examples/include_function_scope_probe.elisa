# G68: a bare call inside an included module resolves to that module's own function, and a
# qualified `Mod::f` (also a nested `Geometry::Scalar::f`) only within Mod, never to a
# same-named function of the including module.
include "./include_function_scope/inner.elisa"

module OuterFn:
    public:
        def step(value: i64) -> i64:
            requires value >= 0 and value <= 1000
            ensure result == value + 2
            return value + 2

        def twice(value: i64) -> i64:
            requires value >= 0 and value <= 1000
            ensure result == value + 2
            return step(value)

        def via_inner(value: i64) -> i64:
            requires value >= 0 and value <= 1000
            ensure result == value + 1
            return InnerFn::step(value)

        def via_nested(value: i64) -> i64:
            requires value >= 0 and value <= 1000
            ensure result == value + 3
            return Geometry::Scalar::step(value)
