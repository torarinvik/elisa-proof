# A match tries its arms in order, so an arm is reached only when every earlier unguarded arm's
# pattern failed. When a pattern's condition decides it exactly (a variant whose payload is all
# binders, a plain integer or bool literal, an integer range, or an or-pattern of these), each
# later arm carries the negation of that condition.

enum Token:
    End
    Number(value: u8, rest: Token)
    Plus(rest: Token)

def skip_plus(tokens: Token) -> Token:
    decreases tokens
    ensure not (result is Token.Plus)
    match tokens:
        Token.Plus(rest):
            return skip_plus(rest)
        _:
            return tokens

def classify(tokens: Token) -> i64:
    ensure result == 2 or not (tokens is Token.End)
    match tokens:
        Token.End:
            return 2
        Token.Number(_, _):
            return 1
        _:
            return 0

def nonzero(n: i64) -> i64:
    ensure result != 0
    match n:
        0:
            return 1
        _:
            return n

def outside_digits(n: i64) -> i64:
    ensure result < 0 or result >= 10
    match n:
        0..<10:
            return 10
        _:
            return n

def not_end_or_plus(tokens: Token) -> i64:
    ensure result == 1 or not (tokens is Token.End)
    ensure result == 1 or not (tokens is Token.Plus)
    match tokens:
        Token.End | Token.Plus(_):
            return 1
        _:
            return 0

def plus_as_value(tokens: Token) -> i64:
    ensure result == 7 or not (tokens is Token.Plus)
    return match tokens:
        Token.Plus(_):
            7
        _:
            0

def not_three(n: i64) -> i64:
    ensure result != 3
    return match n:
        3:
            4
        _:
            n
