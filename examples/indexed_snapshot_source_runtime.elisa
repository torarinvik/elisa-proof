include "../build/snapshot/Elisa-compiler/elisacore_std/elisacore_runtime.elisa"
include "../build/snapshot/Elisa-compiler/src/parser/parser.elisa"
using Ast
include "../src/proof/kernel_replay/frame_policy_model.elisa"
include "../src/proof/replay/frame_source_places.elisa"
include "../src/proof/replay/frame_source_owners.elisa"
include "../src/proof/replay/frame_source_types.elisa"
include "../src/proof/replay/frame_source_scalar_contracts.elisa"
include "../src/proof/replay/source_binding_validation/indexed_snapshots.elisa"

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    source: u8& = "struct Samples:\n    frames: mutable u64[32]\ndef bounded(samples: Samples&, slot: usize, value: u64) -> u64:\n    requires slot < 32\n    ensure result == 0 or result < samples.frames[slot]\n    length: u64 = samples.frames[slot]\n    return 0 if length == 0\n    held: u64 = value if value < length else length - 1\n    held\n"
    tokens: darray[Token] = frontend_tokenize(source, source)
    file: Ast::File = frontend_parser_parse_file(source, tokens)
    return 1 if file.errors.count != 0
    context = ElisaProofFrameSource::owner(&file.top_decls, "bounded", 3)
    return 2 if not context.known
    for statement in context.body |file|:
        match statement:
            Ast::Stmt.VarDecl("length", declared_type, initializer, _):
                return 3 if not ElisaProofFrameSource::indexed_snapshot_stable(&file.top_decls, "bounded", 3, "length", declared_type, initializer)
                return 0
            _:
                pass
    return 4
