# A real runtime-hook probe for the profiler. The explicit arena operations below
# have known requested sizes and exercise alloc, reclaim, reuse, and reset. The
# returned sview case reads the borrow only while its source region is alive.
include "../../Elisa-compiler/elisacore_std/arena.elisa"

def return_probe_view[@r](bytes: darray[u8]& @r) -> sview @r:
    return bytes.as_sview()

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    arena: mutable Arena = zeroed
    first: mutable heap void& = arena_alloc(&arena, 32.usize())
    _ = arena_alloc(&arena, 64.usize())
    arena_reclaim_allocation(&arena, first, 4.usize(), 32.usize())
    _ = arena_alloc(&arena, 16.usize())
    arena_reset(&arena)

    observed_length: mutable i64 = 0
    region scratch(256)
    bytes: mutable darray[u8] @scratch = [65, 66]
    returned: sview @scratch = return_probe_view(bytes)
    observed_length <- returned.len.i64()
    destroy scratch

    arena_free(&arena)
    return 0 if observed_length == 2 else 1
