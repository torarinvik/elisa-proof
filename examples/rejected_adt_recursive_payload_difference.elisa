# Both recursive summaries are kept, but they bound each subtree size only from below, so a
# difference of the two is not bounded below and the ensure must be refused.
enum Tree:
    Leaf
    Node(left: Tree, value: i64, right: Tree)

def tree_skew(tree: Tree) -> i64:
    decreases tree
    ensure result >= 1
    match tree:
        Tree.Leaf:
            return 1
        Tree.Node(left, _, right):
            l: i64 = tree_skew(left)
            r: i64 = tree_skew(right)
            return 1 if l > 1000000 or r > 1000000
            return l - r + 1
