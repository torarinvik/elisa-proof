# Controls: a repeated bare name never borrows the other module's summary.
module Gate:
    public:
        def weight(on: bool, fade: i64) -> i64:
            requires fade >= 0
            requires fade <= 1000
            ensure result >= 0
            ensure on or result == 0
            return 0 if not on
            return fade

module Fade:
    public:
        def weight(frame: i64) -> i64:
            requires frame >= 1
            ensure result == frame + 1
            return frame + 1

module Uses:
    public:
        # Gate::weight states nothing like Fade::weight's `result == frame + 1`.
        def borrowed_contract(fade: i64) -> i64:
            requires fade >= 1
            requires fade <= 100
            ensure result == fade + 1
            return Gate::weight(true, fade)

        # Fade::weight requires `frame >= 1`, which `frame >= 0` does not meet.
        def borrowed_requires(frame: i64) -> i64:
            requires frame >= 0
            requires frame <= 100
            ensure result >= 0
            return Fade::weight(frame)
