# Bounds alone do not establish that two symbolic selectors differ. The checker must retain the
# conservative alias conflict instead of guessing from their names.
def rejected_borrow_symbolic_alias(values: mutable i64[2], left: usize, right: usize) -> i64:
    requires left < 2
    requires right < 2
    shared: i64& = &values[left]
    exclusive: mutable i64& = &values[right]
    return values[0]
