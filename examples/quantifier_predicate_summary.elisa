def nonnegative(value: i64) -> bool:
    ensure result == (value >= 0)
    return value >= 0

def quantified_summary() -> i64:
    ensure forall index in 0..<3: nonnegative(index)
    return 0

def quantified_inclusive_summary() -> i64:
    ensure forall index in 0..=2: nonnegative(index)
    return 0

def below(value: i64, limit: i64 = 4) -> bool:
    ensure result == (value < limit)
    return value < limit

def quantified_default_summary() -> i64:
    ensure forall index in 0..<3: below(index)
    return 0

def quantified_conjunction_summary() -> i64:
    ensure forall index in 0..<3: nonnegative(index) and below(index)
    return 0

def is_one(value: i64) -> bool:
    ensure result == (value == 1)
    return value == 1

def quantified_existential_summary() -> i64:
    ensure exists index in 0..<3: is_one(index)
    return 0
def signed_quantified_witness() -> i64:
    ensure exists index in -1..<3: nonnegative(index)
    return 0

def signed_quantified_all() -> i64:
    ensure forall index in -3..<0: not nonnegative(index)
    return 0
