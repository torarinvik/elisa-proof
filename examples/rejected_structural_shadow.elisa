# A loop binder named prev shadows the strict subterm binder from the match arm.
# Passing that loop value (which is the original n) is not structural recursion.

enum Nat:
    Zero
    Succ(prev: Nat)

def rejected_structural_shadow(n: Nat) -> i64:
    decreases n
    match n:
        Nat.Zero:
            return 0
        Nat.Succ(prev):
            for prev in [n]:
                return rejected_structural_shadow(prev)
            return 0
