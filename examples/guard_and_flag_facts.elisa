def k4(i: usize, n: usize) -> usize:
    ensure result <= n
    ok: bool = i < n
    if ok:
        return i
    return 0

def k3(values: darray[i64]&, n: usize) -> i64:
    total: mutable i64 = 0
    for i in 0..<n |total, values|:
        continue if i >= values.count
        total <- values[i]
    return total

def k3b(values: darray[i64]&, n: usize, flag: bool) -> i64:
    if flag:
        return 0 if n >= values.count
        return values[n]
    return 1
