def adjacent_integer_window(cursor: i64) -> i64:
    requires cursor >= 0 and cursor < 8
    requires 3 >= cursor
    requires not (3 >= cursor + 1)
    ensure cursor == 3
    return cursor

def indexed_read_from_window(rows: array[usize, 8]&, cursor: i64) -> i64:
    requires cursor >= 0 and cursor < 8
    requires 3 >= cursor
    requires not (3 >= cursor + 1)
    requires not (rows[cursor] != 64)
    ensure rows[3] == 64
    return cursor
