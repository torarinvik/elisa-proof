# After the role == 8 branch, the fallthrough goal folds to the closed formula
# (0 - 1) < 0 or (0 - 1) >= 22, which holds at every signed and unsigned
# width, so it carries no width ambiguity and proves.
module A:
    public:
        def f(role: i64) -> i64:
            ensure result < 0 or result >= 22
            if role == 8:
                return role + 14
            return 0 - 1
