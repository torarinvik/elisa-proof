# A match-pattern binder may shadow a function parameter. This function returns the matched
# payload, not the parameter named `x`, so its parameter-scoped ensure is intentionally false.

enum Box:
    Value(value: i64)

def rejected_match_shadow(x: i64) -> i64:
    ensure result == x
    match Box.Value(1):
        Box.Value(x):
            return x
