# Dynamic IndexN selectors are admitted at whole-root granularity. Reads remain valid while
# element-level disjointness is deliberately unavailable.
def borrow_dynamic_multi_whole_root(matrix: mutable array[array[i64, 2], 2], row: usize, column: usize) -> i64:
    requires row < 2 and column < 2
    shared: i64& = &matrix[row, column]
    return matrix[0, 0]
