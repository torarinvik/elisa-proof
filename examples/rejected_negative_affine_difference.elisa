# `0 - x <= 0` means `x >= 0`, never `x <= 0`. The bounded facts make the fixed-width
# subtraction safe, so this specifically tests signed affine difference normalization.
def rejected_negative_affine_difference(x: i64) -> i64:
    requires x >= -10
    requires x <= 10
    requires 0 - x <= 0
    ensure x <= 0
    return x

def main() -> i64:
    return rejected_negative_affine_difference(1)
