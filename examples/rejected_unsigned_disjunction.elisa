# Both alternatives can be false; the wrapping comparison must stay undecided.
def wrapping_or_false_identity(x: usize) -> usize:
    proof x + 1 > x or x != x:
        assert x == x
    return x

def false_identity_or_wrapping(x: usize) -> usize:
    proof x != x or x + 1 > x:
        assert x == x
    return x
