# Function signatures inside a module must resolve named container elements against the
# whole imported source, not only against declarations local to that module.
module KernelNamedContainerModel:
    struct Node:
        value: usize

module KernelNamedContainerPredicates:
    def valid_at(values: darray[KernelNamedContainerModel::Node]&, index: usize) -> bool:
        return index < values.count

    def valid_call(values: darray[KernelNamedContainerModel::Node]&, index: usize) -> bool:
        requires valid_at(values, index)
        ensure valid_at(values, index)
        return valid_at(values, index)
