# An sview is always non-null, but it is still borrowed storage: copying it to an
# alias must not erase the lifetime of the region that owns its bytes.
def rejected_sview_after_region_destroy() -> usize can[Memory.Allocate, Abort.Panic]:
    region scratch(64)
    bytes: mutable darray[u8] @scratch = [65]
    view: sview = bytes.as_sview()
    alias: sview = view
    destroy scratch
    return alias.len

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    return 0
