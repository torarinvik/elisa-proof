# A comparison fixes both operands to one type. When one side is a call whose declared result
# is a signed integer, a closed constant on the other side is read at that width.

def cap() -> i64:
    ensure result >= 0
    ensure result <= 1000000
    return 5

def guarded_successor() -> i64:
    ensure result <= 1000000
    later: i64 = cap()
    return later + 1 if later < 1000000 - 254
    return later

def guarded_early_return() -> i64:
    ensure result <= 1000000
    later: i64 = cap()
    return later if later > 1000000 - 255
    return later + 1

def direct_call_guard() -> bool:
    ensure result
    cap() <= 999999 + 1

enum Token:
    End
    Number(value: u8, rest: Token)

def token_sum(tokens: Token) -> i64:
    decreases tokens
    ensure result >= 0
    ensure result <= 1000000
    match tokens:
        Token.End:
            return 0
        Token.Number(value, rest):
            later: i64 = token_sum(rest)
            return later if later > 1000000 - 255
            return later + value.i64()
