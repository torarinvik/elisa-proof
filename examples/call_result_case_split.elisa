# Replacing call results with fresh names opens no case, so it must not spend the case-split
# depth: `gap(a, b) == gap(b, a)` needs the two result disjunctions split after the call
# results are generalized, and the crossing cases close only because both differences are
# nonnegative, which forces `a == b`.
module CallResultSplit:
    public:
        def gap(first: i64, last: i64) -> i64:
            requires first >= -1000000000
            requires first <= 1000000000
            requires last >= -1000000000
            requires last <= 1000000000
            ensure result >= 0
            ensure first != last or result == 0
            ensure result == first - last or result == last - first
            return first - last if first >= last
            return last - first

        def gap_symmetric(a: i64, b: i64) -> bool:
            requires a >= -1000000000
            requires a <= 1000000000
            requires b >= -1000000000
            requires b <= 1000000000
            ensure result
            return gap(a, b) == gap(b, a)
