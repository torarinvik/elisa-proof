# Unsigned constant arithmetic wraps at the declared width. The runtime value of 255 + 1 as u8
# is 0, so a checker that evaluates the expression as an unbounded signed i64 must not prove 256.
def rejected_unsigned_constant_overflow() -> u8:
    ensure result == 256
    return 255 + 1

def main() -> u8:
    return rejected_unsigned_constant_overflow()
