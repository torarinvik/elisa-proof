# A widening integer conversion `name.T()` keeps its receiver's value when the receiver's type
# fits inside `T`: u8 into u16/i64, i8 into i64. These are the shapes a token or byte walker
# needs, including a cast that follows a call whose result the body keeps.

def widen_sum(later: i64, value: u8) -> i64:
    requires later >= 0 and later <= 1000
    ensure result >= 0
    ensure result <= 1255
    return later + value.i64()

def bound_first(later: i64, value: u8) -> i64:
    requires later >= 0 and later <= 1000
    ensure result >= 0
    ensure result <= 1255
    wide: i64 = value.i64()
    return later + wide

def bare(value: u8) -> i64:
    ensure result >= 0
    ensure result <= 255
    return value.i64()

def unsigned_to_unsigned(value: u8) -> u16:
    ensure result <= 255
    return value.u16()

def signed_to_signed(value: i8) -> i64:
    requires value >= 0 and value <= 5
    ensure result >= 0
    ensure result <= 5
    return value.i64()

enum Token:
    End
    Number(value: u8, rest: Token)

def zero(tokens: Token) -> i64:
    ensure result == 0
    return 0

def first_value(tokens: Token) -> i64:
    ensure result >= 0
    match tokens:
        Token.End:
            return 0
        Token.Number(value, _):
            return value.i64()

def first_plus(tokens: Token, later: i64) -> i64:
    requires later >= 0 and later <= 1000
    ensure result >= 0
    match tokens:
        Token.End:
            return 0
        Token.Number(value, _):
            return later + value.i64() + 1

def after_call(tokens: Token) -> i64:
    ensure result >= 0
    match tokens:
        Token.End:
            return 0
        Token.Number(value, rest):
            later: i64 = zero(rest)
            return later + value.i64()

def wide_first(tokens: Token) -> i64:
    ensure result >= 0
    match tokens:
        Token.End:
            return 0
        Token.Number(value, rest):
            wide: i64 = value.i64()
            later: i64 = zero(rest)
            return wide + later

def param_after_call(value: u8, rest: Token) -> i64:
    ensure result >= 0
    later: i64 = zero(rest)
    return later + value.i64()

def first_bounded(tokens: Token) -> i64:
    decreases tokens
    ensure result >= 0
    ensure result <= 255
    match tokens:
        Token.End:
            return 0
        Token.Number(value, rest):
            later: i64 = first_bounded(rest)
            return value.i64()
