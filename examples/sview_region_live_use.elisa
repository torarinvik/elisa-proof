# A view and its aliases are borrowed from the region-backed byte array. Reading the length
# while the region is alive is valid; only the copied scalar survives the explicit destroy.
def sview_region_live_use() -> i64 can[Memory.Allocate, Abort.Panic]:
    observed_length: mutable usize = 0
    region scratch(64)
    bytes: mutable darray[u8] @scratch = [65]
    if true:
        view: sview = bytes.as_sview()
        alias: sview = view
        observed_length <- alias.len
    destroy scratch
    return observed_length.i64()

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    return sview_region_live_use()
