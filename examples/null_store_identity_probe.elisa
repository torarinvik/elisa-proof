struct NullStoreNode:
    next: mutable heap NullStoreNode&?

def clear_next(node: mutable NullStoreNode&) -> u8:
    ensure node.next == null
    node.next <- null
    return 0

def rejected_null_is_nonnull(node: mutable NullStoreNode&) -> u8:
    ensure node.next != null
    node.next <- null
    return 0

def rejected_unwritten_next(node: mutable NullStoreNode&) -> u8:
    ensure node.next == null
    return 0
