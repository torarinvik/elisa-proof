# Nested pure arm expressions are rewritten from exact verified call summaries before the
# enclosing postcondition is checked.

def value_match_nested_pure_leaf() -> i64:
    ensure result == 7
    return 7

def value_match_nested_pure_call(x: i64) -> i64:
    ensure result == 8
    return match x:
        0:
            value_match_nested_pure_leaf() + 1
        _:
            8
