# Control-flow guards are logical facts in the proof engine. A source value of type i64
# must not be treated as a proposition just because the compiler's expression inference
# returns a Boolean result for some operators or the control checker records the guard.
def integer_condition() -> i64:
    return 1

def rejected_nonbool_if_condition() -> bool:
    if integer_condition():
        return true
    else:
        return false

def no_result() -> void:
    return

def rejected_void_comparison_if_condition() -> bool:
    if no_result() == true:
        return true
    else:
        return false
