# A borrow-carrying call is accepted only after the callee resource trace is independently
# replayable. The shared reference has no write effect, so the call ends without changing x.
def read_ref(value: i64&) -> i64:
    return value

def borrow_call_summary(x: i64) -> i64:
    view: i64& = &x
    result: i64 = read_ref(view)
    return result
