# The dictionary key uses the outer `value`; the quantifier binder shadows that name
# only in the body. Sequential name substitution must not capture the key expression.
def dictionary_key_name_must_not_be_captured(value: i64) -> i64:
    ensure forall (key, value) in {value: 0}: key == value
    return 0

def main() -> i64:
    return dictionary_key_name_must_not_be_captured(1)
