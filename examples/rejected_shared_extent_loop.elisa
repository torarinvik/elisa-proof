# The extent rule is about *shared* borrows and nothing else. Every other way the guarded quantity
# can move must still lose the guard at loop entry.

def range_valid(start: usize, count: usize, total: usize) -> bool:
    ensure not result or start <= total and count <= total - start
    return false if start > total
    return false if count > total - start
    return true

def shrink(values: mutable darray[usize]&) -> usize:
    values.clear()
    return 0

def reads(values: darray[usize]&) -> usize:
    return 0

# A mutable borrow may be written through, and the callee here empties it on every iteration.
def a_mutable_borrow_loses_its_extent(start: usize, count: usize, children: mutable darray[usize]&) -> usize:
    return 0 if not range_valid(start, count, children.count)
    total: mutable usize = 0
    for index in 0..<count |index, start, children, total|:
        total <- total + children[start + index]
        emptied: usize = shrink(children)
    return total

# A mutable borrow lent before the loop is no better: the loop reads it, but nothing says the
# holder of the other reference did not resize it in between.
def a_lent_mutable_borrow_loses_it_too(start: usize, count: usize, children: mutable darray[usize]&) -> usize:
    return 0 if not range_valid(start, count, children.count)
    emptied: usize = shrink(children)
    total: mutable usize = 0
    for index in 0..<count |index, start, children, total|:
        total <- total + children[start + index]
    return total

# The extent is only half of the guard. A scalar the guard was taken over, rewritten by the loop,
# makes the guarded call a different call -- the summary says nothing about the new value.
def a_rewritten_argument_loses_the_guard(count: usize, children: darray[usize]&) -> usize:
    start: mutable usize = 0
    return 0 if not range_valid(start, count, children.count)
    total: mutable usize = 0
    for index in 0..<count |index, children, total, start|:
        start <- start + 1
        total <- total + children[start + index]
    return total
