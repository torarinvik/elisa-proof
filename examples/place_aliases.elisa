module PlaceAliases:
    public:
        const CAP: usize = 8

        struct Pool:
            frames: mutable u64[PlaceAliases::CAP]

        # `length` names the element `pool.frames[slot]`; a goal over the element is decided
        # over the local once the alias rewrites it.
        def last_frame(pool: Pool&, slot: usize) -> u64:
            requires slot < CAP
            ensure result == 0 or result < pool.frames[slot]
            length: u64 = pool.frames[slot]
            return 0 if length == 0
            length - 1
