# Differential test of marker dispatch against the original full parser sequence.
include "../../Elisa-compiler/src/semantic/semantic.elisa"
include "../src/proof/kernel_core.elisa"
include "../src/proof/operator_impl_model.elisa"
include "../src/proof/model/enum_index.elisa"
include "../src/proof/model/findings.elisa"
include "../src/proof/model.elisa"
include "../src/proof/model/lemma_table.elisa"
include "../src/proof/kernel.elisa"
include "../src/proof/kernel_intern.elisa"
include "../src/proof/expr.elisa"
include "../src/proof/linear.elisa"
include "../src/proof/resources.elisa"
include "../src/proof/check.elisa"
include "../src/proof/kernel_replay.elisa"
include "../src/proof/replay.elisa"
include "../src/proof/tactics.elisa"


using ElisaProof

extend ElisaProof:
    public:
        def test_original_proof_type_marker_callee(expression: Ast::Expr) -> bool:
            unsigned: (known: bool, name: sview, width: i64) = proof_unsigned_marker_info(expression)
            return true if unsigned.known
            place: (known: bool, term: Ast::Expr, width: i64) = proof_unsigned_place_marker_info(expression)
            return true if place.known
            scalar: (known: bool, term: Ast::Expr) = proof_marker_argument(expression, "__elisa_primitive_scalar_type")
            return true if scalar.known
            signed: (known: bool, term: Ast::Expr, width: i64) = proof_signed_marker_info(expression)
            return true if signed.known
            signed_place: (known: bool, term: Ast::Expr, width: i64) = proof_signed_place_marker_info(expression)
            return true if signed_place.known
            element: (known: bool, term: Ast::Expr, depth: i64, width: i64) = proof_element_marker_info(expression)
            return element.known

        # Keep the old query here as a test oracle, not in the production verifier.
        def test_original_proof_type_marker_root_name(expression: Ast::Expr) -> sview:
            scalar: (known: bool, term: Ast::Expr) = proof_marker_argument(expression, "__elisa_primitive_scalar_type")
            return proof_place_root_name(scalar.term, 0) if scalar.known
            element: (known: bool, term: Ast::Expr, depth: i64, width: i64) = proof_element_marker_info(expression)
            return proof_place_root_name(element.term, 0) if element.known
            place: (known: bool, term: Ast::Expr, width: i64) = proof_unsigned_place_marker_info(expression)
            return proof_place_root_name(place.term, 0) if place.known
            signed: (known: bool, term: Ast::Expr, width: i64) = proof_signed_marker_info(expression)
            return proof_place_root_name(signed.term, 0) if signed.known
            signed_place: (known: bool, term: Ast::Expr, width: i64) = proof_signed_place_marker_info(expression)
            return proof_place_root_name(signed_place.term, 0) if signed_place.known
            return ""

        def test_original_proof_signed_marker_width_for_term(facts: darray[Ast::Expr]&, term: Ast::Expr) -> i64:
            for fact in facts |term|:
                marker: (known: bool, term: Ast::Expr, width: i64) = proof_signed_marker_info(fact)
                return marker.width if marker.known and proof_expr_equal(marker.term, term)
                place: (known: bool, term: Ast::Expr, width: i64) = proof_signed_place_marker_info(fact)
                return place.width if place.known and proof_expr_equal(place.term, term)
            return 0


        def test_original_proof_type_bound_name(expression: Ast::Expr) -> sview:
            marker_name: sview = proof_unsigned_marker_name(expression)
            return marker_name if marker_name != ""
            signed_marker: (known: bool, term: Ast::Expr, width: i64) = proof_signed_marker_info(expression)
            return proof_place_root_name(signed_marker.term, 0) if signed_marker.known
            builtin_marker: (known: bool, term: Ast::Expr, protocol: sview) = proof_builtin_operator_marker_info(expression)
            return proof_place_root_name(builtin_marker.term, 0) if builtin_marker.known
            untrusted_marker: (known: bool, term: Ast::Expr, protocol: sview) = proof_untrusted_operator_marker_info(expression)
            return proof_place_root_name(untrusted_marker.term, 0) if untrusted_marker.known
            index_marker: (known: bool, term: Ast::Expr) = proof_builtin_index_marker_info(expression)
            return proof_place_root_name(index_marker.term, 0) if index_marker.known
            # A type witness may be keyed by a place rather than a name. Retention follows the
            # root symbol of that place, so `h.part`'s witness lives and dies with `h`.
            root_name: sview = proof_type_marker_root_name(expression)
            return root_name if root_name != ""
            match expression:
                Ast::Expr.Binary(left, TokenKind.LtEq, right, _):
                    match left:
                        Ast::Expr.IntLit(value, _):
                            match right:
                                Ast::Expr.Ident(name, _):
                                    return name if value == 0
                                _:
                                    pass
                        _:
                            pass
                    match right:
                        Ast::Expr.IntLit(_, _):
                            match left:
                                Ast::Expr.Ident(name, _):
                                    return name
                                _:
                                    pass
                        _:
                            pass
                _:
                    pass
            return ""

        def test_original_proof_signed_i64_only_context(facts: darray[Ast::Expr]&) -> bool:
            has_i64_type: mutable bool = false
            for fact in facts |fact, has_i64_type|:
                signed: (known: bool, term: Ast::Expr, width: i64) = proof_signed_marker_info(fact)
                return false if signed.known and signed.width != 64
                has_i64_type <- true if signed.known
                unsigned: (known: bool, name: sview, width: i64) = proof_unsigned_marker_info(fact)
                return false if unsigned.known
                place: (known: bool, term: Ast::Expr, width: i64) = proof_unsigned_place_marker_info(fact)
                return false if place.known
                element: (known: bool, term: Ast::Expr, depth: i64, width: i64) = proof_element_marker_info(fact)
                return false if element.known and element.width > 0
                untrusted: (known: bool, term: Ast::Expr, protocol: sview) = proof_untrusted_operator_marker_info(fact)
                return false if untrusted.known
            return has_i64_type

        def test_original_proof_builtin_operator_term_witnessed(expression: Ast::Expr, protocol: sview, facts: darray[Ast::Expr]&) -> bool:
            match expression:
                Ast::Expr.StringLit(_, _):
                    return true
                Ast::Expr.Paren(inner, _):
                    return test_original_proof_builtin_operator_term_witnessed(inner, protocol, facts)
                _:
                    pass
            for fact in facts:
                marker: (known: bool, term: Ast::Expr, protocol: sview) = proof_builtin_operator_marker_info(fact)
                return true if marker.known and marker.protocol == protocol and proof_expr_equal(marker.term, expression)
            return false

        def test_original_proof_index_operator_term_witnessed(expression: Ast::Expr, protocol: sview, facts: darray[Ast::Expr]&, trusted: bool) -> bool:
            object: mutable Ast::Expr = Ast::Expr.Invalid
            match expression:
                Ast::Expr.Index(indexed_object, _, _):
                    object <- indexed_object
                Ast::Expr.IndexN(indexed_object, _, _):
                    object <- indexed_object
                Ast::Expr.Paren(inner, _):
                    return test_original_proof_index_operator_term_witnessed(inner, protocol, facts, trusted)
                _:
                    return false
            wanted_protocol: sview = proof_index_operator_protocol(protocol)
            for fact in facts:
                marker: (known: bool, term: Ast::Expr, protocol: sview) = proof_builtin_operator_marker_info(fact) if trusted else proof_untrusted_operator_marker_info(fact)
                return true if marker.known and marker.protocol == wanted_protocol and proof_expr_equal(marker.term, object)
            return false

        def test_original_proof_scalar_witnessed(facts: darray[Ast::Expr]&, name: sview) -> bool:
            return false if name == ""
            for fact in facts:
                return true if proof_scalar_marker_name(fact) == name
                return true if proof_unsigned_marker_name(fact) == name
            return false

        def test_extra_marker_queries(facts: darray[Ast::Expr]&, terms: darray[Ast::Expr]&) -> bool:
            return false if proof_signed_i64_only_context(facts) != test_original_proof_signed_i64_only_context(facts)
            protocols: mutable darray[sview] = ["Eq", "Ord", ""]
            scalar_names: darray[sview] = ["items", "missing", ""]
            for name in scalar_names |name, facts|:
                return false if proof_scalar_witnessed(facts, name) != test_original_proof_scalar_witnessed(facts, name)
            for fact in facts |fact, terms, protocols, scalar_names|:
                return false if proof_type_bound_name(fact) != test_original_proof_type_bound_name(fact)
                singleton: mutable darray[Ast::Expr] = [fact]
                for name in scalar_names |name, singleton|:
                    return false if proof_scalar_witnessed(singleton, name) != test_original_proof_scalar_witnessed(singleton, name)
                return false if proof_signed_i64_only_context(singleton) != test_original_proof_signed_i64_only_context(singleton)
                for term in terms |term, singleton, protocols|:
                    for protocol in protocols |term, singleton, protocol|:
                        return false if proof_builtin_operator_term_witnessed(term, protocol, singleton) != test_original_proof_builtin_operator_term_witnessed(term, protocol, singleton)
                        return false if proof_index_operator_term_witnessed(term, protocol, singleton, true) != test_original_proof_index_operator_term_witnessed(term, protocol, singleton, true)
                        return false if proof_index_operator_term_witnessed(term, protocol, singleton, false) != test_original_proof_index_operator_term_witnessed(term, protocol, singleton, false)
            return true

const MARKER_CLASSIFICATION_CHANGED: i64 = 1
const MARKER_ROOT_CHANGED: i64 = 2
const MARKER_WIDTH_CHANGED: i64 = 3
const EXTENDED_MARKER_QUERY_CHANGED: i64 = 4
const MARKER_TEST_REGION_BYTES: usize = 65536

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    region r(MARKER_TEST_REGION_BYTES):
        store: Ast::Node.Store[Local] = Ast::Node.Store(r)
        in store:
            position: Ast::Pos = Ast::pos_at_line(1)
            base: Ast::Expr = Ast::Expr.Ident("items", position)
            field: Ast::Expr = Ast::Expr.Field(base, "value", position)
            terms: mutable darray[Ast::Expr] = [base, field, Ast::Expr.Paren(field, position), Ast::Expr.Index(base, Ast::Expr.IntLit(0, position), position), Ast::Expr.IntLit(0, position), Ast::Expr.Invalid]
            names: mutable darray[sview] = ["__elisa_unsigned_type_bound", "__elisa_signed_type_bound", "__elisa_signed_place_type_bound", "__elisa_primitive_scalar_type", "__elisa_primitive_scalar_element", "not_a_marker", ""]
            widths: mutable darray[i64] = [-1, 0, 1, ElisaProofKernelCore::PROOF_KERNEL_FIXED_WIDTH_MIN - 1, ElisaProofKernelCore::PROOF_KERNEL_U8_WIDTH, ElisaProofKernelCore::PROOF_KERNEL_I64_WIDTH, ElisaProofKernelCore::PROOF_KERNEL_MACHINE_WORD_BITS + 1]
            facts: mutable darray[Ast::Expr] = [base, Ast::Expr.Invalid]
            for name in names |name, terms, widths, facts, position|:
                callee: Ast::Expr = Ast::Expr.Ident(name, position)
                facts.push(Ast::Expr.Call(callee, [], [], position))
                for term in terms |term, callee, widths, facts, position|:
                    facts.push(Ast::Expr.Call(callee, [term], [], position))
                    for width in widths |term, callee, width, facts, position|:
                        width_term: Ast::Expr = Ast::Expr.IntLit(width, position)
                        facts.push(Ast::Expr.Call(callee, [term, width_term], [], position))
                        facts.push(Ast::Expr.Call(callee, [term, width_term], ["term"], position))
                        facts.push(Ast::Expr.Call(callee, [term, width_term], ["term", "width"], position))
                        facts.push(Ast::Expr.Call(callee, [term, width_term, width_term], [], position))
                        facts.push(Ast::Expr.Call(Ast::Expr.Paren(callee, position), [term, width_term], [], position))
            operator_names: mutable darray[sview] = ["__elisa_builtin_operator_type", "__elisa_untrusted_operator_type", "__elisa_builtin_index_type"]
            protocols: mutable darray[sview] = ["Eq", "Index.Eq", "", "unknown"]
            for name in operator_names |name, protocols, terms, facts, position|:
                callee: Ast::Expr = Ast::Expr.Ident(name, position)
                for term in terms |callee, term, protocols, facts, position|:
                    facts.push(Ast::Expr.Call(callee, [term], [], position))
                    for protocol in protocols |callee, term, protocol, facts, position|:
                        protocol_term: Ast::Expr = Ast::Expr.StringLit(protocol, position)
                        facts.push(Ast::Expr.Call(callee, [term, protocol_term], [], position))
                        facts.push(Ast::Expr.Call(callee, [term, protocol_term], ["bad-count"], position))
            return EXTENDED_MARKER_QUERY_CHANGED if not test_extra_marker_queries(facts, terms)
            for fact in facts |fact|:
                return MARKER_CLASSIFICATION_CHANGED if proof_type_marker_callee(fact) != test_original_proof_type_marker_callee(fact)
                return MARKER_ROOT_CHANGED if proof_type_marker_root_name(fact) != test_original_proof_type_marker_root_name(fact)
            for term in terms |term, facts|:
                return MARKER_WIDTH_CHANGED if proof_signed_marker_width_for_term(facts, term) != test_original_proof_signed_marker_width_for_term(facts, term)
                # Also check each singleton so an early matching fact cannot mask later cases.
                for fact in facts |term, fact|:
                    singleton: mutable darray[Ast::Expr] = [fact]
                    return MARKER_WIDTH_CHANGED if proof_signed_marker_width_for_term(singleton, term) != test_original_proof_signed_marker_width_for_term(singleton, term)
    return 0
