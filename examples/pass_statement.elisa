# `pass` changes nothing, so the facts and values before it still hold after it: in a branch,
# in match arms beside a call scrutinee, in a loop body, in a pure helper that a contract
# calls, in a lemma body and in a proof block.
struct Table:
    total: mutable usize

def clear(table: mutable Table&) -> usize:
    table.total <- 0
    0

def branch_pass(x: usize) -> usize:
    ensure result == x
    if x > 0:
        pass
    x

def match_arm_pass(x: usize) -> usize:
    ensure result == x
    match x:
        0:
            pass
        _:
            pass
    x

def call_scrutinee_pass(table: mutable Table&, x: usize) -> usize:
    ensure result == x
    match clear(table):
        0:
            pass
        _:
            pass
    x

def call_condition_pass(table: mutable Table&, x: usize) -> usize:
    ensure result == x
    if clear(table) == 0:
        pass
    x

def loop_pass(x: usize) -> usize:
    ensure result == x
    for i in 0..<x:
        pass
    x

def helper(x: usize) -> usize:
    if x > 0:
        pass
    x

def pure_helper_pass(x: usize) -> usize:
    ensure result == helper(x)
    helper(x)

lemma lemma_pass(x: i64):
    requires x >= 0
    ensure x >= 0
    pass

def proof_block_pass(x: i64) -> i64:
    requires x >= 0
    ensure result >= 0
    assert x >= 0 by:
        pass
    return x
