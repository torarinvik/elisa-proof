# The conjunct that carries the placeholder is not a fact of the path in any form the kernel
# can validate, so it must not be recorded, and nothing may be derived from the inadmissible
# condition. A claim that needs it stays unproven, with no certificate issued for it.

def locate(nodes: darray[usize]&, index: usize) -> (known: bool, value: i64, root: usize):
    ensure result.value == 1
    return (index < nodes.count, 0, index)

# The placeholder comes from a rebinding: a local declared from a call keeps its own symbol now, so
# a field of it is an ordinary place. An assignment still leaves the call as the value.
def placeholder_conjunct_must_not_become_a_fact(nodes: darray[usize]&, count: usize, root: usize, flag: bool) -> i64:
    ensure result == 1
    component: mutable (known: bool, value: i64, root: usize) = locate(nodes, root)
    component <- locate(nodes, root)
    if flag and component.value == 1:
        return component.value
    return 1
