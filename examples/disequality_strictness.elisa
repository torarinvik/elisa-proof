def strict_from_pair(a: i64, b: i64) -> i64:
    requires a <= b
    requires a != b
    ensure a < b
    return a

def strict_reversed(a: i64, b: i64) -> i64:
    requires b >= a
    requires b != a
    ensure b > a
    return b

def strict_negated_equality(a: i64, b: i64) -> i64:
    requires a <= b
    requires not (a == b)
    ensure a + 1 <= b
    return a

def strict_index(i: usize, n: usize) -> usize:
    requires i <= n
    requires i != n
    ensure result < n
    return i

def guarded_step(i: i64, n: i64) -> i64:
    requires i <= n
    requires 0 <= i
    requires n <= 1000
    ensure result >= 1
    if i != n:
        return n - i
    return 1
