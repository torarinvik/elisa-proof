# The argument is about storage this frame owns. A binding that holds a reference does not own the
# object behind it, so what it names may be written through another path while a callee runs.

extend RejectedValueRootField:
    struct Node:
        children_start: usize
        children_count: usize

    def grow(values: mutable darray[usize]&) -> usize:
        values.push(1)
        return values.count

    # A mutable reference: the callee may write through it.
    def a_field_of_a_mutable_reference_does_not_survive(node: mutable Node&, other: mutable darray[usize]&) -> bool:
        requires node.children_start <= 8
        ensure result
        grown: usize = grow(other)
        return node.children_start <= 8

    # A shared reference excludes a borrowed mutable path, but not a write reached another way, and
    # this rule is about ownership rather than about the borrow discipline.
    def a_field_of_a_shared_reference_does_not_either(node: Node&, other: mutable darray[usize]&) -> bool:
        requires node.children_count <= 8
        ensure result
        grown: usize = grow(other)
        return node.children_count <= 8
