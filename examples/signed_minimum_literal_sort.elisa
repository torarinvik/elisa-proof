# Source-level boundary regression: signed minimum magnitude tokens must keep
# their exact sort through source checking, certificate export and arena admission.
# A direct private-helper runtime probe alone does not establish portable replay.
def signed_i8_minimum_below_zero() -> i8:
    ensure -128i8 < 0i8
    return 0i8

def signed_i16_minimum_below_zero() -> i16:
    ensure -32768i16 < 0i16
    return 0i16

def signed_i32_minimum_below_zero() -> i32:
    ensure -2147483648i32 < 0i32
    return 0i32

def signed_i64_minimum_below_zero() -> i64:
    ensure -9223372036854775808i64 < 0i64
    return 0i64
