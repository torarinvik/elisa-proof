# A region-owned reference is invalid after its explicit owner is destroyed.
def rejected_region_use_after_destroy() -> i64 can[Memory.Allocate, Abort.Panic]:
    region r(4096)
    value: i64& @r = new[r] 1
    destroy r
    return value[0]

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    return rejected_region_use_after_destroy()
