# An exhaustive, unguarded enum match exposes the complete set of possible tags afterwards.
enum MatchCoverage:
    First
    Second

def exhaustive_case_disjunction(value: MatchCoverage) -> bool:
    ensure value is MatchCoverage.First or value is MatchCoverage.Second
    match value:
        MatchCoverage.First:
            pass
        MatchCoverage.Second:
            pass
    return true
