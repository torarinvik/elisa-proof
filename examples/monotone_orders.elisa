# Orders the difference tier cannot state: a sum against a sum, a quotient by a
# variable divisor against a constant, and a clamp that picks a bound of the
# same order as its condition. The engine's movement triggers need all three.
module MonotoneOrders:
    const STRIDE: u64 = 10000
    const DROP: u64 = 1000000

    # A strict clamp below and an inclusive clamp at the stride sum below two strides.
    def clamped_sum(t: u64, m: u64, s: u64) -> u64:
        requires s >= 100 and s <= STRIDE
        ensure result < s + s
        p: u64 = t if t < s else s - 1
        a: u64 = m if m < s else s
        p + a

    # The pairing may cross the right-hand operands.
    def crossed_sum(p: u64, a: u64, s: u64, r: u64) -> u64:
        requires p <= r and a < s and s <= STRIDE and r <= STRIDE
        ensure result < s + r
        p + a

    def inclusive_sum(p: u64, a: u64, s: u64) -> u64:
        requires p <= s and a <= s and s <= STRIDE
        ensure result <= s + s
        p + a

    def descending_sum(p: u64, a: u64, s: u64) -> bool:
        requires p < s and a <= s and s <= STRIDE
        s + s > p + a

    # A share of a larger whole scaled by k stays below k.
    def strict_share(part: u64, whole: u64) -> u64:
        requires part < whole and whole <= DROP
        ensure result < 750
        part * 750 / whole

    # An inclusive share needs a positive whole.
    def inclusive_share(part: u64, whole: u64) -> u64:
        requires part <= whole and whole <= DROP and whole >= 1
        ensure result <= 750
        part * 750 / whole

    def proper_fraction(a: u64, b: u64) -> u64:
        requires a < b and b <= DROP
        ensure result < 1
        a / b

    # Without a matching factor the dividend is compared with k times the divisor.
    def unscaled_share(part: u64, whole: u64) -> u64:
        requires part < whole and whole <= DROP
        ensure result < 5
        part / whole

    # A term below one operand is below the sum, and below any multiple of a base it is below.
    def below_sum(part: u64, whole: u64) -> u64:
        requires part < whole and whole <= DROP
        ensure result < whole + whole
        part

    def below_multiple(part: u64, whole: u64) -> u64:
        requires part <= whole and whole <= DROP
        ensure result <= 5 * whole and result <= whole * 3
        part
