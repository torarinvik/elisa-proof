# The block keeps only what its body leaves alone.
def bump(v: mutable darray[u32]&) -> void can[Memory.Allocate]:
    v.push(1)

def loses_own_count(a: mutable darray[u32]&, i: usize) -> u32 can[Memory.Allocate]:
    requires i < a.count
    can Memory.Allocate:
        bump(a)
    return a[i]

def loses_assigned(a: mutable darray[u32]&, n: u32) -> u32 can[Memory.Allocate]:
    requires n < 100
    ensure result < 101
    m: mutable u32 = n
    can Memory.Allocate:
        a.push(1)
        m <- 500
    return m

def loses_local_fact(a: mutable darray[u32]&, n: u32) -> u32 can[Memory.Allocate]:
    ensure result < 8
    m: mutable u32 = n
    can Memory.Allocate:
        k: u32 = 7
        a.push(k)
        m <- n
    return m
