# A non-scalar value may be passed directly to a shared-reference formal. The compiler lowers this
# spelling to a temporary shared borrow, and the proof certificate must preserve that capability.
module ImplicitSharedBorrow:
    struct Box:
        value: i64

    def read(box: Box&) -> i64:
        return box.value

    def read_value(box: Box) -> i64:
        return read(box)
