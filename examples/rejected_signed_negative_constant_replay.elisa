# Controls: bounds one past what the premises give, and an unsigned subtraction that wraps.
module NegativeConstant:
    public:
        def plus_negative_short(y: i64) -> i64:
            requires y >= -1000
            requires y <= 1000
            ensure y + -3 <= 996
            return y

        def plus_difference_short(y: i64) -> i64:
            requires y >= -1000
            requires y <= 1000
            ensure y + (0 - 3) >= -1002
            return y

        def unsigned_wrap(y: u64) -> u64:
            requires y <= 1000
            ensure y + (0 - 3) <= 997
            return y
