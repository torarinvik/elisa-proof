# Recursive lemma summaries are admitted only after a checked smaller measure.

lemma inductive_step(n: i64):
    requires n >= 0
    ensure n >= 0
    decreases n
    if n > 0:
        inductive_step(n - 1)

def use_inductive_step(n: i64) -> void:
    requires n >= 0
    assert n >= 0 by:
        inductive_step(n)
