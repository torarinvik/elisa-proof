# A direct region allocation may be exposed as one mutable reference, but that
# capability must not be duplicated into two simultaneously writable aliases.
def rejected_region_duplicate_mutable_alias() -> i64 can[Memory.Allocate, Abort.Panic]:
    region r(4096)
    owner: i64& @r = new[r] 0
    first: mutable i64& @r = owner
    second: mutable i64& @r = owner
    return 0

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    return rejected_region_duplicate_mutable_alias()
