include "disjunction_domain_probe.elisa"

# Historical open-gap reproduction: now requires source-derived call integer widths.
def open_pure_call_domain(value: bool) -> u8:
    ensure result == 1 or result >= 3 and result <= 11
    status: u8 = domain_status(value)
    return domain_choice(status)

# Direct composition remains independently replayable when no unsupported local-binding
# evidence is needed by the call-summary disjunction rule.
def direct_pure_call_domain(value: bool) -> u8:
    ensure result == 1 or result >= 3 and result <= 11
    return domain_choice(domain_status(value))

# Repeated uses of one pure call must not spend distinct witness slots.
def repeated_pure_call_domain(value: bool) -> u8:
    ensure result == 1 or result >= 3 and result <= 11
    first: u8 = domain_status(value)
    second: u8 = domain_status(value)
    third: u8 = domain_status(value)
    fourth: u8 = domain_status(value)
    fifth: u8 = domain_status(value)
    sixth: u8 = domain_status(value)
    seventh: u8 = domain_status(value)
    eighth: u8 = domain_status(value)
    ninth: u8 = domain_status(value)
    tenth: u8 = domain_status(value)
    eleventh: u8 = domain_status(value)
    twelfth: u8 = domain_status(value)
    thirteenth: u8 = domain_status(value)
    fourteenth: u8 = domain_status(value)
    fifteenth: u8 = domain_status(value)
    sixteenth: u8 = domain_status(value)
    seventeenth: u8 = domain_status(value)
    eighteenth: u8 = domain_status(value)
    nineteenth: u8 = domain_status(value)
    twentieth: u8 = domain_status(value)
    return domain_choice(twentieth)
