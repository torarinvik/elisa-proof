# A collection builtin is not a declared function, so it has no summary, and every call of one on a
# reference-rooted place was reported opaque -- which meant the write it performs was never
# recorded at all. A push made while a shared borrow of the same collection was live verified.
#
# The effect of these methods is exactly a write to the receiver and a read of each argument. They
# mutate the receiver's storage, they read what they are given, and they move nothing, because
# Elisa spells a transfer `move` and an argument without one is not consumed. Recording that write
# through the ordinary write path is what gives the borrow rules their say.
#
# The admission is withdrawn wherever it would be answering a different question: a region-carrying
# argument is an escape question, a moved argument is a transfer into the collection, and a leaf
# name any declaration carries is not a builtin at all.
#
# The receiver of a method-shaped call is never among the callee's arguments, so no argument
# mapping can describe what the call does to it. Either the effect is named here or it is not
# modelled, and a call in the second case is refused rather than passed over. A width conversion is
# the one method with no storage to write.

extend CollectionBuiltin:
    def read(values: darray[usize]&) -> usize:
        return values.count

    def a_push_is_a_write_to_its_receiver(values: mutable darray[usize]&, seed: usize) -> usize:
        values.push(seed)
        return values.count

    def a_copy_clears_and_extends(source: darray[usize]&, target: mutable darray[usize]&) -> usize:
        target.clear()
        target.extend(source)
        return target.count

    def a_borrow_taken_after_the_write_is_fine(seed: usize) -> usize:
        values: mutable darray[usize] = []
        values.push(seed)
        view: darray[usize]& = &values
        return read(view)

    def a_truncate_is_a_write(values: mutable darray[usize]&) -> usize:
        return 0 if values.count == 0
        values.truncate(values.count - 1)
        return values.count

    def a_conversion_has_no_receiver_to_write(index: usize) -> i64:
        return index.i64()
