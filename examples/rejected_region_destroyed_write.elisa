# A confirmed close must remain a disproved access, including inside a copied branch state.
def write_after_destroy(flag: bool) -> i64 can[Memory.Allocate, Abort.Panic]:
    region scratch(64)
    values: mutable darray[i64] @scratch = [0]
    destroy scratch
    if flag:
        values[0] <- 1
    return 0

def main() -> i64:
    return 0
