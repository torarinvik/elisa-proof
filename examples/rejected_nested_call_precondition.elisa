# A mutating call in an earlier argument must invalidate facts before a later argument call.

struct Box:
    value: mutable i64

struct Pair:
    left: i64
    right: i64

def write_value(box: mutable Box&) -> i64:
    changes box.value
    box.value <- 1
    return 0

def require_zero(box: mutable Box&) -> i64:
    requires box.value == 0
    ensure result == 0
    return 0

def nested_argument_precondition(box: mutable Box&) -> void:
    requires box.value == 0
    pair: Pair = Pair{left: write_value(box), right: require_zero(box)}
