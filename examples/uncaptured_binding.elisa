# A captured block can name only what its capture list names, so a binding the list does not
# mention cannot be read or written inside it and survives the block unchanged. Havocking the
# whole frame at the block instead — which is what the write-back model did — cost every fact and
# every symbolic value the loop could not possibly have touched.
#
# The import runs under the call-stability rule the opaque call boundary already uses, so a
# binding something references is still forgotten: the block may hold that reference through a
# captured name.
def value_outside_the_capture_list_survives(count: usize) -> i64:
    ensure result == 3
    settled: i64 = 3
    moving: mutable i64 = 0
    for index in 0..<count |index, moving|:
        moving <- moving + 1
    return settled

# The same for a fact rather than a recorded value: `bounded` is not captured, so what was
# proven about it before the loop still holds after it.
def fact_outside_the_capture_list_survives(count: usize, bounded: i64) -> i64:
    requires bounded > 7
    ensure result > 7
    moving: mutable i64 = 0
    for index in 0..<count |index, moving|:
        moving <- moving + 1
    return bounded
