# A binding a captured block neither names in its capture list nor writes in its body survives
# the block unchanged. Havocking the whole frame at the block instead — which is what the
# write-back model did — cost every fact and every symbolic value the loop could not possibly
# have touched.
#
# The capture list on its own is not the bound: a block can assign an outer binding the list
# omits, which `examples/rejected_uncaptured_block_write.elisa` pins. The write-back set is the
# capture list together with every root the body assigns and every place it references, and the
# import runs under the call-stability rule the opaque call boundary already uses, so a binding
# something references is still forgotten: the block may hold that reference through a captured
# name.
def value_outside_the_capture_list_survives(count: usize) -> i64:
    ensure result == 3
    settled: i64 = 3
    moving: mutable i64 = 0
    for index in 0..<count |index, moving|:
        moving <- moving + 1
    return settled

# The same for a fact rather than a recorded value: `bounded` is neither captured nor written, so
# what was proven about it before the loop still holds after it.
def fact_outside_the_capture_list_survives(count: usize, bounded: i64) -> i64:
    requires bounded > 7
    ensure result > 7
    moving: mutable i64 = 0
    for index in 0..<count |index, moving|:
        moving <- moving + 1
    return bounded
