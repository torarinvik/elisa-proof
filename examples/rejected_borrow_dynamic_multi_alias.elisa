# A dynamic multi-index borrow widens to the matrix root, so a later mutable element borrow is
# rejected even though its runtime coordinates could differ.
def rejected_borrow_dynamic_multi_alias(matrix: mutable array[array[i64, 2], 2], row: usize, column: usize) -> i64:
    requires row < 2 and column < 2
    shared: i64& = &matrix[row, column]
    exclusive: mutable i64& = &matrix[0, 0]
    return matrix[0, 0]
