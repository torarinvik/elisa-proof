extern opaque16() -> i16

struct Pair:
    a: i16
    b: i8

def local_too_tight() -> i16:
    ensure result <= 32766
    x: i16 = opaque16()
    return x

def field_too_tight(p: Pair) -> i16:
    ensure result >= -32767
    return p.a

def narrow_field_wide(p: Pair) -> i8:
    ensure result <= 126
    return p.b

def reassigned() -> i16:
    ensure result <= 100
    x: mutable i16 = opaque16()
    x <- opaque16()
    return x
