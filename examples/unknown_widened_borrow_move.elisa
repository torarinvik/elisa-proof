# Widening does not demonstrate that the borrowed and moved elements coincide.
def move_with_dynamic_borrow(values: mutable i64[2], selectors: usize[1]) -> i64:
    requires selectors[0] < 2
    requires selectors[0] == 1
    shared: i64& = &values[selectors[0]]
    moved: i64 = move values[0]
    return moved
