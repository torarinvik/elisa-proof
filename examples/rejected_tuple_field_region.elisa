# A label's witness gives its type, not a bound: each ensure below needs more than the callee says.

def pick_any[@r](value: JsonValueHandle[r]) -> (count: i64, value: JsonValueHandle[r]):
    return (1, value)

def pick_wide[@r](value: JsonValueHandle[r]) -> (small: u8, value: JsonValueHandle[r]):
    ensure result.small <= 250
    return (7, value)

# Tuple values are positional. A caller local must keep these labels in this order before a
# per-field summary can be rebound from the call result.
def pick_pair[@r](value: JsonValueHandle[r]) -> (count: i64, total: i64, value: JsonValueHandle[r]):
    ensure result.count <= 5
    return (3, 10, value)

def unbounded_count[@r](value: JsonValueHandle[r]) -> i64:
    ensure result >= 1
    found: (count: i64, value: JsonValueHandle[r]) = pick_any(value)
    return found.count + 1

def small_overflow[@r](value: JsonValueHandle[r]) -> u8:
    ensure result <= 250
    found: (small: u8, value: JsonValueHandle[r]) = pick_wide(value)
    return found.small + 50

def other_label[@r](value: JsonValueHandle[r]) -> u8:
    ensure result <= 200
    found: (small: u8, value: JsonValueHandle[r]) = pick_wide(value)
    return found.small

def wrong_label[@r](value: JsonValueHandle[r]) -> i64:
    ensure result <= 5
    found: (size: i64, total: i64, value: JsonValueHandle[r]) = pick_pair(value)
    return found.size

def reordered_label[@r](value: JsonValueHandle[r]) -> i64:
    ensure result <= 5
    found: (total: i64, count: i64, value: JsonValueHandle[r]) = pick_pair(value)
    return found.count
