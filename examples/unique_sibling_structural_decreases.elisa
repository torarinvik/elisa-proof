# Bare calls to globally unique function names resolve across sibling modules.
# Replay must preserve the producer's unique-global fallback for structural SCCs.
enum Nat:
    Zero
    Succ(prev: Nat)

module Left:
    public:
        def checked(n: Nat) -> i64:
            decreases n
            match n:
                Nat.Zero:
                    return 0
                Nat.Succ(prev):
                    return sibling_step(prev)

module Right:
    public:
        def sibling_step(n: Nat) -> i64:
            decreases n
            match n:
                Nat.Zero:
                    return 1
                Nat.Succ(prev):
                    return checked(prev)
