# The guarded value of a control-flow get can itself be a summarized executable call. Keep
# both contracts well-typed so the summary is admitted only on the successful path.
def maybe_value(x: i64) -> i64?:
    requires x > 0
    ensure x > 0
    return x


def getelse_call(x: i64) -> i64:
    requires x > 0
    ensure x > 0
    return get maybe_value(x) else return 0
