# The guarded value of a control-flow get can itself be a summarized executable call. The call
# summary must be applied on the successful path; the recovery return is checked independently.
def maybe_value(x: i64) -> i64?:
    ensure result == x
    return x


def getelse_call(x: i64) -> i64:
    requires x == 0
    ensure result == x
    return get maybe_value(x) else return 0
