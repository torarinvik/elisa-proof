# Every claim here is false for some input. Generalizing a nested call must keep calls with
# different arguments apart and must not strengthen any summary.

def lift(x: i64, floor: i64) -> i64:
    ensure result >= floor
    return floor if x < floor else x

def distinct_inner(x: i64, y: i64, floor: i64, other: i64) -> i64:
    ensure result >= other
    l: i64 = lift(x, floor)
    m: i64 = lift(x, other)
    r: i64 = lift(y, l)
    return r

def strict_claim(x: i64, y: i64, v: i64, floor: i64) -> i64:
    ensure result > floor
    l: i64 = lift(x, floor)
    r: i64 = lift(y, l)
    return v if v > r
    return r

def reversed_chain(x: i64, y: i64, floor: i64) -> bool:
    ensure result
    l: i64 = lift(x, floor)
    r: i64 = lift(y, l)
    return l >= r

def swapped_arguments(x: i64, y: i64, floor: i64) -> i64:
    ensure result >= lift(x, floor)
    l: i64 = lift(x, floor)
    r: i64 = lift(l, y)
    return r
