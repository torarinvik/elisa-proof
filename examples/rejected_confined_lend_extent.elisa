# A lend is confined only when nothing the callee can store into, that its caller still sees, has a
# type able to hold a reference. Every way out of that has to keep the old answer.

def fill(values: mutable darray[usize]&) -> void:
    values.push(1)

# The callee's second parameter names storage whose element type is a reference, so it can keep the
# lend past the call. The compiler accepts exactly this, which is why the test is over types.
def keeps_the_lend(values: darray[usize]&, sink: mutable darray[darray[usize]&]&) -> void:
    sink.push(values)

def a_leaked_lend_loses_the_extent(sink: mutable darray[darray[usize]&]&) -> usize:
    names: mutable darray[usize] = []
    fill(&names)
    keeps_the_lend(names, sink)
    total: mutable usize = 0
    for index in 0..<names.count |index, names, total|:
        total <- total + names[index]
    return total

# The same escape through a by-value return that can hold a reference.
def returns_the_lend(values: darray[usize]&, holder: mutable darray[darray[usize]&]) -> darray[darray[usize]&]:
    holder.push(values)
    return holder

def a_returned_lend_loses_it_too(holder: mutable darray[darray[usize]&]) -> usize:
    names: mutable darray[usize] = []
    fill(&names)
    kept: darray[darray[usize]&] = returns_the_lend(names, holder)
    total: mutable usize = kept.count
    for index in 0..<names.count |index, names, total|:
        total <- total + names[index]
    return total

# A confined lend is still a write during its own call, so a fact taken before it does not survive
# it. If the binding's recorded value carried through, this would fold to zero and prove.
def a_confined_lend_still_writes() -> usize:
    ensure result == 0
    names: mutable darray[usize] = []
    fill(&names)
    return names.count

# A lend inside the loop body reaches the binding on every iteration, whatever the callee can keep.
def a_lend_inside_the_loop() -> usize:
    names: mutable darray[usize] = []
    fill(&names)
    total: mutable usize = 0
    for index in 0..<names.count |index, names, total|:
        fill(&names)
        total <- total + names[index]
    return total
