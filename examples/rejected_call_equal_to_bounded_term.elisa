# Controls: the equated term gives the call no interval when the term itself is unbounded,
# and the interval it gives proves nothing past the alternative the contract leaves open.
module Soft:
    public:
        def soft(deviation: i64, limit: i64) -> i64:
            requires limit >= 0
            ensure limit < 0 or result == deviation
            return deviation

module Uses:
    public:
        def unbounded_term(value: i64, guard: i64) -> i64:
            requires value >= 0
            requires guard >= 0
            ensure result == value
            return guard + Soft::soft(value - guard, 0)

        def open_alternative(value: i64, guard: i64, limit: i64) -> i64:
            requires value >= -1000
            requires value <= 1000
            requires guard >= -1000
            requires guard <= 1000
            requires limit >= 0
            ensure result == value + 1
            return guard + Soft::soft(value - guard, limit)
