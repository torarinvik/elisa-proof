struct DisjunctionDenialRejectedNode:
    value: u8

def disjunction_denial_false_boolean(choose: bool) -> u8:
    ensure choose or choose
    return 0

def disjunction_denial_false_nullable(node: heap DisjunctionDenialRejectedNode&?) -> u8:
    ensure node != null or node != null
    return 0

# Neither floating-point comparison holds for NaN. This is not excluded middle.
def disjunction_denial_float_order(value: f32) -> u8:
    ensure value < 0.0 or value >= 0.0
    return 0
