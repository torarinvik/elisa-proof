# Unsigned locals stay symbolic with their compiler width. Bounded-safe arithmetic on
# them proves from the recorded binding equality; the scoped `proof` form sees only the
# type facts, so bounded reasoning uses the unscoped `assert ... by:` form.
def bounded_local() -> void:
    x: u8 = 254
    assert x + 1 > x by:
        assert x + 1 > x

def rebound_local() -> void:
    x: mutable u8 = 0
    x <- 254
    assert x + 1 > x by:
        assert x + 1 > x

def counted_local(items: darray[i64]) -> void:
    n: usize = items.count
    assert n == items.count by:
        assert n == items.count

def next_byte(x: u8) -> u8:
    requires x < 255
    ensure result == x + 1
    y: u8 = x + 1
    return y

def gap(a: usize, b: usize) -> usize:
    requires a <= b
    ensure result == b - a
    d: usize = b - a
    return d

def type_range_in_scoped_proof(x: u8) -> void:
    y: u8 = x
    proof y <= 255:
        assert y <= 255
