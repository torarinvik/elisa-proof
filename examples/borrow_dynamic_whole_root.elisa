# Dynamic selectors widen to the whole receiver root. A shared borrow remains usable for reads,
# but the checker must not infer element-level disjointness from the unknown index.
def borrow_dynamic_whole_root(values: mutable i64[2], index: usize) -> i64:
    requires index < 2
    shared: i64& = &values[index]
    return values[0]
