# The self-hosted driver splices a directive separated by a tab, appending out[0] <- 8 to the
# body; the reference compiler keeps the line as an unused import. Certifying either reading
# certifies a program the other compiler does not build.
def set_seven(out: mutable i64&) -> void:
    ensure out[0] == 7
    out[0] <- 7
include	"spliced_overwrite.elisa"
