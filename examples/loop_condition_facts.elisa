# A `while` loop without an invariant is not verified, but its body still runs only when the
# condition holds. Recording the condition as a fact for the body check is what lets an index
# against the very bound the condition tests discharge. Without it, the dominant loop shape in
# this codebase -- `while index < collection.count |...|:` -- could not prove its own indexing.
def while_condition_bounds_the_body(values: darray[i64]&) -> i64:
    total: mutable i64 = 0
    index: mutable usize = 0
    while index < values.count |index, total, values|:
        total <- total + values[index]
        index <- index + 1
    return total

def observe(source: darray[i64]&) -> i64:
    return 0

# The bound also has to survive a call inside the body. `values` is bound by a shared borrow, so
# nothing may write through it for its lifetime and no callee can resize it; its count is the one
# place expression a call cannot change.
def shared_extent_survives_a_call_in_the_body(values: darray[i64]&) -> i64:
    total: mutable i64 = 0
    index: mutable usize = 0
    while index < values.count |index, total, values|:
        total <- total + observe(values)
        total <- total + values[index]
        index <- index + 1
    return total

def shared_extent_survives_a_call(values: darray[i64]&, index: usize) -> i64:
    requires index < values.count
    spare: i64 = observe(values)
    return values[index]
