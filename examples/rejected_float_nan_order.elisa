# NaN probes: x != x can hold, and neither x < y nor y <= x need hold.
def float_not_self_unequal(x: f64) -> void:
    ensure not (x != x)
    return

def float_trichotomy(x: f64, y: f64) -> void:
    ensure x < y or y <= x
    return

# IEEE comparisons are not total: for NaN, `not (x < y)` holds while `x >= y` does not.
def float_negated_less_implies_greater_equal(x: f64, y: f64) -> void:
    requires x != x
    requires not (x < y)
    ensure x >= y
    return

def float_nan_is_not_nonnegative(x: f64) -> void:
    requires not (x < 0)
    ensure x >= 0
    return
