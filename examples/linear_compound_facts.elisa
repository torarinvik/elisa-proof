# Linear goals over negated and conjunctive premises, with bound facts on every atom.
module CompoundFacts:
    public:
        def still_negated_or(prev: i64, now: i64, next: i64) -> bool:
            requires prev >= -1000
            requires prev <= 1000
            requires now >= -1000
            requires now <= 1000
            requires next >= -1000
            requires next <= 1000
            requires not (prev != now or now != next)
            ensure prev - 2 * now + next == 0
            return true

        def still_equalities(prev: i64, now: i64, next: i64) -> bool:
            requires prev >= -1000
            requires prev <= 1000
            requires now >= -1000
            requires now <= 1000
            requires next >= -1000
            requires next <= 1000
            requires prev == now
            requires now == next
            ensure prev - 2 * now + next == 0
            return true

        def ordered_and(prev: i64, now: i64, next: i64) -> bool:
            requires prev >= -1000
            requires prev <= 1000
            requires now >= -1000
            requires now <= 1000
            requires next >= -1000
            requires next <= 1000
            requires prev <= now and now <= next
            ensure prev <= next
            return true
