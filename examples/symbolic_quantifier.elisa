# Symbolic-range forall (BACKLOG W-02): cover, extend by one, empty range, and a fill loop whose
# invariant forall grows with the counter. `later` is a second certificate in the same arena.

def cover(values: darray[i64]&, n: usize, m: usize) -> usize:
    requires m <= n
    requires n <= values.count
    requires forall i in 0..<n: values[i] == 0
    ensure forall i in 0..<m: values[i] == 0
    return m

def extend(values: darray[i64]&, n: usize) -> usize:
    requires n < values.count
    requires forall i in 0..<n: values[i] == 0
    requires values[n] == 0
    ensure forall i in 0..<n + 1: values[i] == 0
    return n

def empty(values: darray[i64]&, n: usize) -> usize:
    ensure forall i in n..<n: values[i] == 7
    return n

def later(values: darray[i64]&, n: usize, m: usize) -> usize:
    requires n <= values.count
    requires m <= n
    requires forall i in 0..<n: values[i] == 0
    requires values[0] == 0
    ensure forall i in 0..<m: values[i] == 0
    return n

def fill(values: mutable darray[i64]&) -> void:
    ensures forall i in 0..<values.count: values[i] == 0
    k: mutable usize = 0
    while k < values.count:
        invariant k <= values.count
        invariant forall i in 0..<k: values[i] == 0
        values[k] <- 0
        k <- k + 1

def weaken(values: darray[i64]&, n: usize, m: i64, w: i64) -> usize:
    requires m <= w
    requires forall i in 0..<n: values[i] <= m
    ensure forall i in 0..<n: values[i] <= w
    return n

def weaken_narrow(n: usize, k: usize, m: i64, w: i64) -> usize:
    requires k <= n
    requires m <= w
    requires forall i in 0..<n: i <= m
    ensure forall i in 0..<k: i <= w
    return n

def bubble_swap_arm(xs: mutable darray[i64]&, k: usize, n: usize, m: i64) -> i64:
    requires k < n
    requires k + 1 < n
    requires n <= xs.count
    requires m == xs[k]
    requires xs[k + 1] < m
    requires forall i in 0..<k: xs[i] <= m
    ensures forall i in 0..<k + 1: xs[i] <= result
    xs[k] <- xs[k + 1]
    xs[k + 1] <- m
    return m

def bubble_keep_arm(xs: darray[i64]&, k: usize, n: usize, m0: i64) -> i64:
    requires k < n
    requires k + 1 < n
    requires n <= xs.count
    requires m0 <= xs[k + 1]
    requires forall i in 0..<k: xs[i] <= m0
    requires m0 == xs[k]
    ensures forall i in 0..<k + 1: xs[i] <= result
    return xs[k + 1]

# One bubble pass carries the maximum to the end. Each arm reaches the grown invariant its own way:
# the swap arm through the written cells, the keep arm through `not (xs[k + 1] < m)` and the
# equality `m == xs[k + 1]`, one hop past the old maximum.
def bubble_pass(xs: mutable darray[i64]&, n: usize) -> i64:
    requires 0 < n and n <= xs.count
    ensures forall i in 0..<n: xs[i] <= result
    k: mutable usize = 0
    m: mutable i64 = xs[0]
    while k + 1 < n:
        invariant k < n
        invariant m == xs[k]
        invariant forall i in 0..<k: xs[i] <= m
        if xs[k + 1] < m:
            xs[k] <- xs[k + 1]
            xs[k + 1] <- m
        else:
            m <- xs[k + 1]
        k <- k + 1
    return m

# Reading one container is a function of the subscript: `k == j` carries `m == xs[j]` to `xs[k]`.
def index_congruence(xs: darray[i64]&, k: usize, j: usize, m: i64) -> bool:
    requires j < xs.count
    requires k == j
    requires m == xs[j]
    ensures m == xs[k]
    return true

def negated_step(xs: darray[i64]&, k: usize, m0: i64, m: i64) -> bool:
    requires k < xs.count
    requires not (xs[k] <= m0)
    requires m == xs[k]
    ensures m0 < m
    return true

# Vacuous: the guard `hi < n` is free of the binder and refuted by `hi == n`.
def refuted_guard(xs: darray[i64]&, hi: usize, n: usize) -> bool:
    requires hi == n
    requires n <= xs.count
    ensures forall i in 0..<hi: (hi < n) => xs[i] <= xs[hi]
    return true
