include "disjunction_domain_probe.elisa"

module QualifiedMarkers:
    const OK: i64 = -1

module OtherMarkers:
    const OK: i64 = 7

def qualified_constant_domain(value: i64) -> u8:
    ensure result == 1 or result >= 3 and result <= 11
    status: u8 = domain_status(value == QualifiedMarkers::OK)
    return domain_choice(status)

def other_qualified_constant_domain(value: i64) -> u8:
    ensure result == 1 or result >= 3 and result <= 11
    status: u8 = domain_status(value == OtherMarkers::OK)
    return domain_choice(status)
