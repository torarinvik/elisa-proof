# Typing a constant at its peer's width never hides a wrap or a wrong bound.
module RejectedTypedWideConstants:
    # Read at u64 width, `100 - 200` wraps, so it bounds nothing.
    def wrapped_bound(v: u64) -> u64:
        requires v < 100 - 200
        ensure result <= 99
        v

    # The folded quotient is 100, one past what the goal claims.
    def off_by_one(v: u64) -> u64:
        requires v <= 200 / 2
        ensure result <= 99
        v

    # The then arm breaks the bound the else arm keeps.
    def wide_then_arm(v: u64) -> u64:
        requires v <= 1000000000000000000
        ensure result <= 1000000000000000000
        1000000000000000001 if v >= 100000000000000000 else 7
