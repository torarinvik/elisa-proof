# A field of unsigned type has the same modular arithmetic as an unsigned local. The proof
# importer must not let its place-shaped type witness bypass the width/overflow guard.
struct Byte:
    value: u8

def rejected_unsigned_field_overflow(box: Byte) -> u8:
    requires box.value == 255
    ensure box.value + 1 > box.value
    return box.value

def main() -> u8:
    return 0
