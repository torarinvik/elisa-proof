# A guarded step that rebinds the accumulator over itself, `cursor <- cursor + 1`, keeps `cursor`
# for the old value inside the arm. Both arms state `cursor <= stop`, but the stepping arm states it
# of the old value, so the literal intersection drops it; the join decides it over each arm's own
# value instead: `cursor + 1 <= stop` from `cursor < stop`, and the untouched arm as it stands.

module RebindJoin:
    public:
        def scan(start: usize, stop: usize) -> usize:
            requires start <= stop
            ensure result <= stop
            for slot in 0..<4 |cursor: usize = start| -> cursor:
                invariant cursor <= stop
                cursor <- cursor + 1 if cursor < stop

