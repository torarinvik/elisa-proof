def make_pair(input: i16) -> (value: i16, other: i16):
    return (input, input)

def tuple_half_too_low(input: i16) -> i16:
    ensure result >= -16382 - 1
    pair: (value: i16, other: i16) = make_pair(input)
    return pair.value / 2

def tuple_half_too_high(input: i16) -> i16:
    ensure result <= 16382
    pair: (value: i16, other: i16) = make_pair(input)
    return pair.value / 2
