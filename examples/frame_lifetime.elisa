# A lifetime parameter can be pinned to the caller's own frame. A caller local outlives any call
# that borrows it, so a formal `@s` receiving `&local` is satisfied without the actual carrying a
# region of its own — which is what previously made every such call opaque, since the mapping
# demanded an actual that already named an active region.
#
# The frame mapping is not a region with an extent: there is nothing to open or close, because the
# claim is exactly that the caller's frame outlives the call. Both the producer and the replay
# kernel check the same thing in its place — the actual is a place the caller holds outright: a
# live, unmoved binding carrying no region.
struct Cell:
    value: mutable i64

def visit[@s](cell: mutable Cell& @s, depth: usize) -> usize:
    requires depth <= 127
    decreases 127 - depth
    return 0 if depth >= 127
    return visit(cell, depth + 1)

def read_only[@s](cell: Cell& @s) -> i64:
    return cell.value

# A local borrowed into a lifetime parameter.
def drives_exclusive() -> usize:
    local: mutable Cell = Cell{value: 0}
    return visit(&local, 0)

def drives_shared() -> i64:
    local: Cell = Cell{value: 3}
    return read_only(&local)

# Two lifetimes at once, both pinned to the frame by distinct locals.
def pair[@a, @b](left: Cell& @a, right: Cell& @b) -> i64:
    return left.value + right.value

def drives_pair() -> i64:
    first: Cell = Cell{value: 1}
    second: Cell = Cell{value: 2}
    return pair(&first, &second)
