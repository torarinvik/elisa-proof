# The boundary of indexing through a literal. The literal has to be the binding's current value,
# the guard has to bound the literal that is read, and a guard that admits the count itself is
# too weak. Each read below stays unproven.

# No guard at all.
def unguarded(start: usize) -> usize:
    children: darray[usize] = [1, 2, 3]
    children[start]

# `start == children.count` passes this guard.
def off_by_one(start: usize) -> usize:
    children: darray[usize] = [1, 2, 3]
    return 0 if start > children.count
    children[start]

# The guard bounds one literal and the read is from a shorter one.
def other_literal(start: usize) -> usize:
    children: darray[usize] = [1, 2, 3]
    others: darray[usize] = [4]
    return 0 if start >= children.count
    others[start]

# The guard was taken before the binding was rebound to a shorter literal.
def rebound(start: usize) -> usize:
    children: mutable darray[usize] = [1, 2, 3]
    return 0 if start >= children.count
    children <- [4]
    children[start]

# A callee that borrows the binding mutably may change its length, so the literal is forgotten.
def grow(values: mutable darray[usize]&) -> void:
    values.push(0)

def lent_after_guard(start: usize) -> usize:
    children: mutable darray[usize] = [1, 2, 3]
    return 0 if start >= children.count
    grow(&children)
    children[start]
