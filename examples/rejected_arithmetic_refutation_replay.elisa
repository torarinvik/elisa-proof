module ArithmeticRefutationRejected:
    public:
        def capped(current: i64) -> i64:
            ensure result <= 9 or current > 9
            return current if current > 9
            current

        # `current` may be 10, where the escape disjunct holds and the result is 10:
        # nothing is refuted, so the ensure must stay unproven.
        def loose(current: i64) -> i64:
            requires current <= 10
            ensure result <= 9
            capped(current)
