struct ConversionBox:
    value: mutable i64

def integer_conversion_keeps_frame(box: mutable ConversionBox&, row: i64) -> usize:
    requires row >= 0 and row < 8
    ensure row >= 0 and row < 8
    preserves box.value
    converted: usize = row.usize()
    return converted

def arithmetic_conversion_keeps_frame(box: mutable ConversionBox&, row: i64) -> u8:
    requires row >= 0 and row < 8
    ensure row >= 0 and row < 8
    preserves box.value
    converted: u8 = (row + 1).u8()
    return converted

def integer_conversion_with_changes(box: mutable ConversionBox&, row: i64) -> usize:
    requires row >= 0 and row < 8
    ensure row >= 0 and row < 8
    changes box.value
    converted: usize = row.usize()
    return converted
