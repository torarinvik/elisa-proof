# A one-segment leading-dot enum value is a pure, source-neutral kernel atom.
const enum ShorthandOption of i64:
    None = 0
    Some = 1

def shorthand_member_value(option: ShorthandOption) -> bool:
    proof (option == .None) == (option == .None):
        assert (option == .None) == (option == .None)
    return option == .None
