# Controls: a negated conjunction gives no single case, and a negated equality is not decomposed.
module CompoundFacts:
    public:
        def negated_and(prev: i64, now: i64, next: i64) -> bool:
            requires prev >= -1000
            requires prev <= 1000
            requires now >= -1000
            requires now <= 1000
            requires next >= -1000
            requires next <= 1000
            requires not (prev != now and now != next)
            ensure prev - 2 * now + next == 0
            return true

        def negated_equality(prev: i64, now: i64, next: i64) -> bool:
            requires prev >= -1000
            requires prev <= 1000
            requires now >= -1000
            requires now <= 1000
            requires next >= -1000
            requires next <= 1000
            requires not (prev == now)
            ensure prev < now
            return true

        def ordered_off_by_one(prev: i64, now: i64, next: i64) -> bool:
            requires prev >= -1000
            requires prev <= 1000
            requires now >= -1000
            requires now <= 1000
            requires next >= -1000
            requires next <= 1000
            requires prev <= now and now <= next
            ensure prev < next
            return true
