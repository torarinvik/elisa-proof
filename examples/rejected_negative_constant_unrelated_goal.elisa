# Rejected control: with NONE == -1 dropped, the bound itself is false
# (role - 4 reaches 21), so f must still fail.
module A:
    public:
        const NONE: i64 = -1
        def f(role: i64) -> i64:
            requires role >= 0
            requires role < 26
            ensure result < 20
            if role <= 5:
                return role
            if role <= 9:
                return role + 4
            return role - 4
