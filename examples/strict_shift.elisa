# `a < R` gives `a + 1 <= R` over the integers, for any term `R`. The difference engine draws that
# conclusion whenever it can name both sides, but its atom is one bare identifier: a field place is
# not an atom, so `a < box.limit` reached nothing and the increment every bounded walk performs was
# refused wherever the bound lives in a field.
#
# This tier needs no atom. It matches the shifted side structurally against the strict fact's own
# right-hand side, which is the same way the comparison chain works around the same limit. The
# shift is sound only where `a + 1` does not wrap, so it runs behind the overflow guard;
# `examples/rejected_strict_shift.elisa` is the boundary.
struct Box:
    limit: i64

def shift_to_a_field(box: Box&, a: i64) -> i64:
    requires a < box.limit
    ensure result <= box.limit
    return a + 1

def shift_to_a_name(limit: i64, a: i64) -> i64:
    requires a < limit
    ensure result <= limit
    return a + 1

# The fact may be written either way round.
def shift_from_a_reversed_fact(box: Box&, a: i64) -> i64:
    requires box.limit > a
    ensure result <= box.limit
    return a + 1
