# Only a branch that falls through reaches the statement after an `if` or `match`. A branch
# that raises, returns, breaks or continues leaves by its own transfer, which carries its own
# state, so its effects cannot weaken the facts that hold after the join. A guard
# `raise E if not live(table, slot)` therefore leaves `slot < CAPACITY` for the read after it,
# although its raise is call-shaped, and a leaving branch may call a mutator first.
module Guard:
    public:
        const CAPACITY: usize = 4

        error GuardError:
            Dead

        struct Table:
            live: bool[Guard::CAPACITY]
            total: mutable usize

        def live(table: Table&, slot: usize) -> bool:
            ensure not result or slot < CAPACITY
            slot < CAPACITY and table.live[slot]

        def clear(table: mutable Table&) -> usize:
            table.total <- 0
            0

        def postfix_guard(table: Table&, slot: usize) -> bool error[GuardError]:
            raise GuardError.Dead if not live(table, slot)
            table.live[slot]

        def block_guard(table: Table&, slot: usize) -> bool error[GuardError]:
            if not live(table, slot):
                raise GuardError.Dead
            table.live[slot]

        def bound_guard(table: Table&, slot: usize) -> bool error[GuardError]:
            known: bool = live(table, slot)
            raise GuardError.Dead if not known
            table.live[slot]

        def match_leaving_arm(table: Table&, slot: usize, mode: u8) -> bool error[GuardError]:
            raise GuardError.Dead if not live(table, slot)
            match mode:
                0:
                    raise GuardError.Dead
                _:
                    assert slot < CAPACITY
            table.live[slot]

        def leaving_branch_call(table: mutable Table&, flag: bool) -> usize error[GuardError]:
            requires table.total == 3
            ensure result == 3
            if flag:
                clear(table)
                raise GuardError.Dead
            table.total

        def match_leaving_arm_call(table: mutable Table&, mode: u8) -> usize error[GuardError]:
            requires table.total == 3
            ensure result == 3
            match mode:
                0:
                    clear(table)
                    raise GuardError.Dead
                _:
                    assert table.total == 3
            table.total

        def returning_branch_call(table: mutable Table&, flag: bool) -> usize:
            requires table.total == 3
            ensure result == 3 or result == 0
            if flag:
                clear(table)
                return 0
            table.total
