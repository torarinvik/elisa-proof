# A search that ends because a fixed budget ran out is not the same answer as one that ends
# because no rule applies, and neither is the same as a refuted goal. The report must keep the
# three apart: an agent repairing `too_wide_quantifier` should shrink the range or supply a
# lemma, while `false_comparison` needs the specification changed.

# Finite, but wider than the instantiation budget: undecided, not unprovable.
def too_wide_quantifier() -> i64:
    ensure forall i in 0 ..< 100000: i >= 0
    return 0

# Every name has an explicit finite interval, but the product domain exceeds the enumeration
# budget, so bounded model checking never reaches a verdict either.
def too_large_model(x: i64) -> i64:
    requires 0 <= x
    requires x <= 5000
    ensure x * x >= x
    return 0

# No budget is involved here: the kernel has no rule for an opaque product bound.
def unsupported_reasoning(x: i64, y: i64) -> i64:
    ensure x * y == y * x
    return 0

# A concrete counterexample is a stronger answer than either of the above.
def false_comparison(x: i64) -> i64:
    requires 0 <= x
    requires x <= 3
    ensure x < 3
    return 0
