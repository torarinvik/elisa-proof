# A local callable alias can hide same-measure recursive re-entry even when the
# explicit recursive edge descends structurally. Source-bound replay must treat
# the indirect call as unresolved instead of trusting the source-call graph.
enum LocalCallbackNat:
    Zero
    Succ(prev: LocalCallbackNat)

def local_callback_bounce(n: LocalCallbackNat) -> i64:
    decreases n
    ensure result == 0
    match n:
        LocalCallbackNat.Zero:
            return 0
        LocalCallbackNat.Succ(prev):
            callback: fn(LocalCallbackNat) -> i64 = local_callback_bounce
            _ = callback(n)
            return local_callback_bounce(prev)
