def rejected_positive_boolean_path(flag: bool) -> i64:
    requires flag
    ensure result == 0
    return 1 if flag
    return 0

def rejected_negative_boolean_path(flag: bool) -> i64:
    requires not flag
    ensure result == 0
    return 1 if not flag
    return 0

def rejected_nonnegated_arithmetic(cursor: i64, flag: bool) -> i64:
    requires cursor >= 0 and cursor < 8
    ensure result > 1
    return cursor + 1 if flag
    return cursor + 1
