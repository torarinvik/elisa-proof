def rejected_missing_bound(status: u8, value: u8) -> bool:
    requires status > 9 or value == 1 or value >= 3 and value <= 11
    ensure value == 1 or value >= 3 and value <= 11
    return true

def rejected_missing_alternative(a: bool, b: bool, c: bool) -> bool:
    requires a or b or c
    requires not a
    ensure b or not c
    return true

def rejected_float_totality(x: f64, y: f64, value: bool) -> bool:
    requires x < y or value
    requires not (x >= y)
    ensure value or false
    return true
