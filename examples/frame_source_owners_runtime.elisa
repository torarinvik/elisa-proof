include "../build/snapshot/Elisa-compiler/elisacore_std/elisacore_runtime.elisa"
include "../build/snapshot/Elisa-compiler/src/parser/parser.elisa"
using Ast
include "../src/proof/kernel_replay/frame_policy_model.elisa"
include "../src/proof/replay/frame_source_places.elisa"
include "../src/proof/replay/frame_source_owners.elisa"

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    source: u8& = "def run(second: u8, first: u8) -> u8:\n    return first\n"
    tokens: darray[Token] = frontend_tokenize(source, source)
    file: Ast::File = frontend_parser_parse_file(source, tokens)
    return 1 if file.errors.count != 0
    found = ElisaProofFrameSource::owner(&file.top_decls, "run", 1)
    return 2 if not found.known or found.formals.count != 2 or found.formals[0] != "second" or found.formals[1] != "first" or found.body.count != 1
    return 3 if ElisaProofFrameSource::owner(&file.top_decls, "run", 2).known
    return 4 if ElisaProofFrameSource::owner(&file.top_decls, "other", 1).known
    duplicate: mutable darray[Ast::Decl] = []
    for declaration in file.top_decls |duplicate|:
        duplicate.push(declaration)
        duplicate.push(declaration)
    refused = ElisaProofFrameSource::owner(&duplicate, "run", 1)
    return 5 if refused.known or refused.formals.count != 0 or refused.body.count != 0
    nested: mutable darray[Ast::Decl] = file.top_decls
    for index in 0..<64 |nested|:
        nested <- [Ast::Decl.Scoped(nested, Ast::pos_at_line(1))]
    return 6 if ElisaProofFrameSource::owner(&nested, "run", 1).known
    bounded: mutable darray[Ast::Decl] = []
    bounded.push(file.top_decls[0])
    for index in 0..<4095 |bounded|:
        bounded.push(Ast::Decl.Invalid)
    return 7 if not ElisaProofFrameSource::owner(&bounded, "run", 1).known
    bounded.push(Ast::Decl.Invalid)
    exhausted = ElisaProofFrameSource::owner(&bounded, "run", 1)
    return 8 if exhausted.known or exhausted.formals.count != 0 or exhausted.body.count != 0
    return 0
