# The sign of a product is decidable from the operands' signs alone, and needs no reasoning about
# multiplication beyond them. Every other arithmetic tier here is linear, so this was out of reach:
# `x >= 0, y >= 0 |- x * y >= 0` had no rule at all. The producer and the replay kernel state the
# rule identically and syntactically — the required sign facts must be present as facts, never
# re-derived by a second search — because a tier the two sides could only approximate would show up
# as a replay gap rather than as a proof.
def nonnegative_product(x: i64, y: i64) -> i64:
    requires x >= 0
    requires y >= 0
    ensure result >= 0
    return x * y

def negative_operands(x: i64, y: i64) -> i64:
    requires x <= 0
    requires y <= 0
    ensure result >= 0
    return x * y

def mixed_operands(x: i64, y: i64) -> i64:
    requires x >= 0
    requires y <= 0
    ensure result <= 0
    return x * y

def strict_product(x: i64, y: i64) -> i64:
    requires x > 0
    requires y > 0
    ensure result > 0
    return x * y

def strict_negative(x: i64, y: i64) -> i64:
    requires x > 0
    requires y < 0
    ensure result < 0
    return x * y

# `0 <= x` is the same fact as `x >= 0`, and the product may sit on either side of the goal.
def mirrored_forms(x: i64, y: i64) -> i64:
    requires 0 <= x
    requires 0 <= y
    ensure 0 <= result
    return x * y
