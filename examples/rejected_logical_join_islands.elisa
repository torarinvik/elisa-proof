def wrong_island_connective(entry: bool, reachable: bool, back: bool) -> bool:
    ensure result == (entry or (reachable or back))
    return entry or (reachable and back)

def wrong_island_polarity(entry: bool, reachable: bool, back: bool) -> bool:
    ensure result == (entry or not (reachable and back))
    return entry or (reachable and back)
