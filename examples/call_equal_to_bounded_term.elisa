# A call result a contract equates to a bounded term, `soft(v - g, l) == v - g` once the
# other alternatives are refuted, lies in that term's interval, so `g + soft(v - g, l)` is
# in range and the sum reads as integers.
module Soft:
    public:
        def soft(deviation: i64, limit: i64) -> i64:
            requires limit >= 0
            requires limit <= 1000
            requires deviation >= -2000
            requires deviation <= 2000
            ensure deviation > limit or deviation < -limit or result == deviation
            return deviation if deviation <= limit and deviation >= -limit
            return 0

module Uses:
    public:
        def wring(value: i64, guard: i64, limit: i64) -> i64:
            requires value >= -1000
            requires value <= 1000
            requires guard >= -1000
            requires guard <= 1000
            requires limit >= 0
            requires limit <= 1000
            ensure value - guard > limit or guard - value > limit or result == value
            return guard + Soft::soft(value - guard, limit)
