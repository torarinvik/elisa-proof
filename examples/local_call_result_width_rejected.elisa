def checked_wide_result(code: u8) -> u16:
    requires code == 0
    ensure result == 256
    return 256

# A destination-width marker must not be attached to the callee's wide result
# and used to manufacture contradictory facts. A narrowing conversion is not
# part of the same-width stored-result rule.
def wrong_narrowed_result(code: u8) -> u8:
    requires code == 0
    ensure result == 1
    saved: u8 = checked_wide_result(code)
    return saved
