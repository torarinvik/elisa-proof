# A write through a mutable reference local changes its referent. The checker must not
# keep `x == 5` after `r <- 6`: stage1 returns 6 here.
def rejected_write_through_reference_local() -> i64:
    ensure result == 5
    x: mutable i64 = 5
    r: mutable i64& = &x
    r <- 6
    return x

def rejected_stale_fact_after_reference_write() -> i64:
    x: mutable i64 = 5
    r: mutable i64& = &x
    r <- 6
    proof x == 5:
        assert x == 5
    return x

def rejected_branch_write_through_reference(c: bool) -> i64:
    ensure result == 5
    x: mutable i64 = 5
    r: mutable i64& = &x
    if c:
        r <- 6
    return x
