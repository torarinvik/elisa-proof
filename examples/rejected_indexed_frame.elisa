# A container write is not authorized by a disjoint child frame.

struct Box:
    values: mutable darray[i64]
    other: mutable i64

def write_value_at(box: mutable Box&, index: usize) -> void:
    changes box.values
    box.values[index] <- 1

def caller_frame_too_small(box: mutable Box&, index: usize) -> void:
    changes box.other
    write_value_at(box, index)
