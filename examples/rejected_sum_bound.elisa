# The boundary. The premise the rule will not read is the first one: for a fixed-width type
# `start + count <= total` is a claim about a sum that may already have wrapped. At
# `start = MAX, count = 1, total = 0` it holds modulo 2^64 while the mathematical sum does not, so
# reading it as an integer bound would prove `start + 0 < 0`.
def a_modular_premise_is_not_a_bound(total: usize, start: usize, count: usize, index: usize) -> usize:
    requires start + count <= total
    requires index < count
    ensure result < total
    return start + index

# Without `start <= total` the subtraction itself may wrap, so it bounds nothing.
def the_subtraction_needs_its_guard(total: usize, start: usize, count: usize) -> usize:
    requires count <= total - start
    ensure result <= total
    return start + count

# A non-strict step gives a non-strict conclusion, not a strict one.
def a_non_strict_step_gives_no_strict_goal(total: usize, start: usize, count: usize, index: usize) -> usize:
    requires start <= total
    requires count <= total - start
    requires index <= count
    ensure result < total
    return start + index

# The bound found is a different term from the one the goal names.
def a_bound_on_another_term(total: usize, other: usize, start: usize, count: usize) -> usize:
    requires start <= other
    requires count <= other - start
    ensure result <= total
    return start + count
