struct FieldStorePoststateProbe:
    value: mutable u8

struct FieldStoreNodeProbe:
    next: mutable heap FieldStoreNodeProbe&?

struct FieldStoreHeapProbe:
    prepared: mutable heap FieldStoreNodeProbe&?

def scalar_field_store_updates_poststate(
    state: mutable FieldStorePoststateProbe&, value: u8
) -> u8:
    ensure result != 0 or state.value == value
    state.value <- value
    return 0

def nullable_field_store_updates_poststate(
    state: mutable heap FieldStoreHeapProbe&, candidate: heap FieldStoreNodeProbe&?
) -> u8:
    requires candidate != null
    ensure result != 0 or state.prepared != null
    state.prepared <- candidate
    return 0

def rejected_scalar_field_without_write(
    state: mutable FieldStorePoststateProbe&, value: u8
) -> u8:
    ensure result != 0 or state.value == value
    return 0

def rejected_nullable_field_without_write(
    state: mutable heap FieldStoreHeapProbe&, candidate: heap FieldStoreNodeProbe&?
) -> u8:
    requires candidate != null
    ensure result != 0 or state.prepared != null
    return 0

def rejected_branch_write_claims_old_value_preserved(
    state: mutable FieldStorePoststateProbe&, choose: bool, value: u8
) -> u8:
    ensure result != 0 or state.value == old(state.value)
    if choose:
        state.value <- value
    return 0

def rejected_loop_write_claims_old_value_preserved(
    state: mutable FieldStorePoststateProbe&, value: u8
) -> u8:
    ensure result != 0 or state.value == old(state.value)
    rounds: mutable u8 = 0
    while rounds < 1:
        invariant rounds <= 1
        state.value <- value
        rounds <- 1
    return 0
