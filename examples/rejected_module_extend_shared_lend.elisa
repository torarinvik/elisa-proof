# The whole-module type lookup must not erase a capability. The by-value result declared in a
# sibling block can hold a reference into the lent collection, so the recursive call still needs
# the callee's own converged resource summary and is refused without one.
module ExtendLendEscape:
    public:
        struct Node:
            kind: sview
            left: usize

        struct Holder:
            node: Node&

extend ExtendLendEscape:
    public:
        def extend_escape(nodes: darray[Node]&, root: usize, remaining: usize) -> Holder:
            decreases remaining
            return Holder{node: nodes[0]} if root >= nodes.count or remaining < 1
            return extend_escape(nodes, nodes[root].left, remaining - 1)
