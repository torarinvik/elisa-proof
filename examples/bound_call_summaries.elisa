# A call result is not a witnessed scalar term, so `r == need(c, s)` beside `need(c, s) <= s`
# never gave `r <= s`. A scalar bound to the call is that call's result, so the call's summary is
# instantiated again over the bound symbol, and replay checks it against the callee's ensure.

module BoundCallSummaries:
    public:
        def advance(start: usize, stop: usize) -> usize:
            requires start <= stop
            ensure result <= stop
            cursor: mutable usize = start
            cursor <- need(cursor, stop)
            cursor

        def fresh(start: usize, stop: usize) -> usize:
            requires start <= stop
            ensure result <= stop
            next: usize = need(start, stop)
            next

        def need(cursor: usize, stop: usize) -> usize:
            requires cursor <= stop
            ensure result <= stop
            cursor
