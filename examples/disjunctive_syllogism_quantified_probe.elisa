# Premise reductions preserve quantifier depth, and independent replay resolves
# the forced bound before instantiating every member of the finite range.
def forced_chain_quantified(a: bool, b: bool, c: bool, d: bool, e: bool, f: bool, count: i64) -> i64:
    requires a
    requires not a or b
    requires not b or c
    requires not c or d
    requires not d or e
    requires not e or f
    requires not f or count == 2
    ensure forall i in 0 ..< count: i >= 0
    return count
