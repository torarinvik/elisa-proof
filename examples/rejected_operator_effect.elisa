# User-defined operators are method calls in Elisa and may mutate their receiver.
# The proof checker must not carry pre-operation facts through an overloaded operator.
protocol Eq:
    def __eq__(self: Self, other: Self) -> bool

struct Counter:
    value: mutable i64

impl Eq for Counter:
    def __eq__(self: mutable Counter, other: Counter) -> bool:
        self.value <- self.value + 1
        return self.value == other.value

def rejected_operator_effect(c: mutable Counter, d: Counter) -> i64:
    requires c.value == 0
    ensure result == 0
    if c == d:
        return c.value
    return c.value
