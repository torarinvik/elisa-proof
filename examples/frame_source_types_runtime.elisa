include "../build/snapshot/Elisa-compiler/elisacore_std/elisacore_runtime.elisa"
include "../build/snapshot/Elisa-compiler/src/parser/parser.elisa"
using Ast
include "../src/proof/kernel_replay/frame_policy_model.elisa"
include "../src/proof/replay/frame_source_places.elisa"
include "../src/proof/replay/frame_source_owners.elisa"
include "../src/proof/replay/frame_source_types.elisa"

using ElisaProofKernelFramePolicy

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    source: u8& = "struct Inner:\n    value: mutable i64\nstruct Box:\n    child: Inner\n    other: i64\ntype AliasBox = Box\ndef run(other: u8, box: mutable AliasBox&) -> void:\n    pass\n"
    tokens: darray[Token] = frontend_tokenize(source, source)
    file: Ast::File = frontend_parser_parse_file(source, tokens)
    return 1 if file.errors.count != 0
    actual: Place = Place{parameter: 1, depth: 2, field: "child", field2: "value", field3: ""}
    return 2 if not ElisaProofFrameSource::place_typed(&file.top_decls, "run", 7, actual)
    missing: Place = Place{parameter: 1, depth: 2, field: "child", field2: "missing", field3: ""}
    return 3 if ElisaProofFrameSource::place_typed(&file.top_decls, "run", 7, missing)
    scalar: Place = Place{parameter: 0, depth: 1, field: "child", field2: "", field3: ""}
    return 4 if ElisaProofFrameSource::place_typed(&file.top_decls, "run", 7, scalar)
    malformed: Place = Place{parameter: 1, depth: 1, field: "child", field2: "value", field3: ""}
    return 5 if ElisaProofFrameSource::place_typed(&file.top_decls, "run", 7, malformed)
    return 6 if ElisaProofFrameSource::place_typed(&file.top_decls, "run", 8, actual)
    duplicate: mutable darray[Ast::Decl] = []
    for declaration in file.top_decls |duplicate|:
        duplicate.push(declaration)
    duplicate.push(file.top_decls[0])
    return 7 if ElisaProofFrameSource::place_typed(&duplicate, "run", 7, actual)
    cycle_source: u8& = "type A = B\ntype B = A\ndef run(box: A) -> void:\n    pass\n"
    cycle_tokens: darray[Token] = frontend_tokenize(cycle_source, cycle_source)
    cycle_file: Ast::File = frontend_parser_parse_file(cycle_source, cycle_tokens)
    cycle_place: Place = Place{parameter: 0, depth: 1, field: "value", field2: "", field3: ""}
    return 8 if cycle_file.errors.count != 0 or ElisaProofFrameSource::place_typed(&cycle_file.top_decls, "run", 3, cycle_place)
    duplicate_field_source: u8& = "struct Box:\n    value: i64\n    value: i64\ndef run(box: Box) -> void:\n    pass\n"
    duplicate_field_tokens: darray[Token] = frontend_tokenize(duplicate_field_source, duplicate_field_source)
    duplicate_field_file: Ast::File = frontend_parser_parse_file(duplicate_field_source, duplicate_field_tokens)
    return 9 if duplicate_field_file.errors.count != 0 or ElisaProofFrameSource::place_typed(&duplicate_field_file.top_decls, "run", 4, cycle_place)
    budgeted: mutable darray[Ast::Decl] = []
    for declaration in file.top_decls |budgeted|:
        budgeted.push(declaration)
    for index in 0..<3990 |budgeted|:
        budgeted.push(Ast::Decl.Invalid)
    return 10 if ElisaProofFrameSource::place_typed(&budgeted, "run", 7, actual)
    whole: Place = Place{parameter: 1, depth: 0, field: "", field2: "", field3: ""}
    return 11 if not ElisaProofFrameSource::place_typed(&file.top_decls, "run", 7, whole)
    out_of_range: Place = Place{parameter: 2, depth: 0, field: "", field2: "", field3: ""}
    return 12 if ElisaProofFrameSource::place_typed(&file.top_decls, "run", 7, out_of_range)
    return 0
