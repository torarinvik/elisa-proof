def return_same[@r](source: mutable i64& @r) -> mutable i64& @r:
    return source

def alias_sensitive(first: mutable i64&, second: mutable i64&) -> i64:
    requires first == 7
    ensures first == 7
    saved: i64 = first.i64()
    second <- 9
    return saved

def intermediary_alias(source: mutable i64&) -> i64:
    requires source == 7
    ensures source == 7
    alias: mutable i64& = return_same(source)
    saved: i64 = alias_sensitive(source, alias)
    return source
