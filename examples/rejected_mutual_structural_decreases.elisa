# Passing the whole matched value across a mutual structural edge is not a decrease.
enum Nat:
    Zero
    Succ(prev: Nat)

def bad_structural_even(n: Nat) -> i64:
    decreases n
    match n:
        Nat.Zero:
            return 0
        Nat.Succ(prev):
            return bad_structural_odd(n)

def bad_structural_odd(n: Nat) -> i64:
    decreases n
    match n:
        Nat.Zero:
            return 1
        Nat.Succ(prev):
            return bad_structural_even(prev)
