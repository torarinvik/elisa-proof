struct RecordBranchRejectedState:
    value: mutable u8

extern record_branch_opaque(state: mutable RecordBranchRejectedState&) -> void

def record_branch_stale(state: mutable RecordBranchRejectedState&, choose: bool) -> u8:
    ensure state.value == old(state.value)
    if choose:
        state.value <- 1
    return 0

def record_branch_wrong_arm(state: mutable RecordBranchRejectedState&, choose: bool) -> u8:
    ensure choose or state.value == 1
    if choose:
        state.value <- 1
    else:
        state.value <- 2
    return 0

def record_branch_missing_arm(state: mutable RecordBranchRejectedState&, choose: bool) -> u8:
    ensure state.value == 1
    if choose:
        state.value <- 1
    return 0

def record_branch_guard_rebound(state: mutable RecordBranchRejectedState&, choose: mutable bool) -> u8:
    ensure not choose or state.value == 1
    if choose:
        state.value <- 1
    else:
        state.value <- 2
        choose <- true
    return 0

def record_branch_alias(state: mutable RecordBranchRejectedState&, choose: bool) -> u8:
    ensure not choose or state.value == 1
    alias: mutable RecordBranchRejectedState& = state
    if choose:
        state.value <- 1
        alias.value <- 2
    return 0

def record_branch_opaque_write(state: mutable RecordBranchRejectedState&, choose: bool) -> u8:
    ensure not choose or state.value == 1
    if choose:
        state.value <- 1
        record_branch_opaque(state)
    return 0
