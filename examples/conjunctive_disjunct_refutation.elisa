def false_left_conjunct(value: i64) -> i64:
    requires (false and true) or value == 7
    ensure result == 7
    return value

def false_right_conjunct(value: i64) -> i64:
    requires (true and false) or value == 7
    ensure result == 7
    return value

def denied_symbolic_conjunct(first: bool, second: bool, value: i64) -> i64:
    requires not second
    requires (first and second) or value == 7
    ensure result == 7
    return value

def rejected_true_conjunction(value: i64) -> i64:
    requires (true and true) or value == 7
    ensure result == 7
    return value

def rejected_partial_disjunction(value: i64) -> i64:
    requires (false or true) or value == 7
    ensure result == 7
    return value
