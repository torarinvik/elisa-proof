# A lemma and an executable function may have the same leaf name in separate modules.
# Reported proof attempts must remain attached to their exact source owner.
module Facts:
    public:
        lemma shared_owner(value: i64):
            requires value >= 0
            ensure value >= 0

module Values:
    def shared_owner(value: i64) -> i64:
        ensure result == value + 1
        return value
