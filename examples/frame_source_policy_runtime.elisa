include "../build/snapshot/Elisa-compiler/elisacore_std/elisacore_runtime.elisa"
include "../build/snapshot/Elisa-compiler/src/parser/parser.elisa"
using Ast
include "../src/proof/kernel_replay/frame_policy_model.elisa"
include "../src/proof/replay/frame_source_places.elisa"
include "../src/proof/replay/frame_source_owners.elisa"
include "../src/proof/replay/frame_source_policy.elisa"

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    source: u8& = "def run(other: u8, box: u8) -> u8:\n    changes box.value\n    preserves other\n    return other\n"
    tokens: darray[Token] = frontend_tokenize(source, source)
    file: Ast::File = frontend_parser_parse_file(source, tokens)
    return 1 if file.errors.count != 0
    policy = ElisaProofFrameSource::body_policy(&file.top_decls, "run", 1)
    return 2 if not policy.known or policy.parameter_count != 2 or policy.clauses.count != 2
    return 3 if policy.clauses[0].kind != "changes" or policy.clauses[0].place.parameter != 1 or policy.clauses[0].place.field != "value" or policy.clauses[0].position.line != 2
    return 4 if policy.clauses[1].kind != "preserves" or policy.clauses[1].place.parameter != 0 or policy.clauses[1].place.depth != 0 or policy.clauses[1].position.line != 3
    return 5 if ElisaProofFrameSource::body_policy(&file.top_decls, "run", 2).known
    invalid_source: u8& = "def run(box: u8) -> u8:\n    changes box\n    preserves foreign_box\n    return box\n"
    invalid_tokens: darray[Token] = frontend_tokenize(invalid_source, invalid_source)
    invalid_file: Ast::File = frontend_parser_parse_file(invalid_source, invalid_tokens)
    return 6 if invalid_file.errors.count != 0
    invalid_policy = ElisaProofFrameSource::body_policy(&invalid_file.top_decls, "run", 1)
    return 7 if invalid_policy.known or invalid_policy.clauses.count != 0 or invalid_policy.parameter_count != 0
    match file.top_decls[0]:
        Ast::Decl.Func(name, parameters, result_type, statements, effects, decorators, position):
            bounded: mutable darray[Ast::Stmt] = []
            for index in 0..<64 |bounded, statements|:
                bounded.push(statements[0])
            declarations: mutable darray[Ast::Decl] = [Ast::Decl.Func(name, parameters, result_type, bounded, effects, decorators, position)]
            at_limit = ElisaProofFrameSource::body_policy(&declarations, "run", 1)
            return 8 if not at_limit.known or at_limit.clauses.count != 64
            bounded.push(statements[0])
            declarations <- [Ast::Decl.Func(name, parameters, result_type, bounded, effects, decorators, position)]
            exhausted = ElisaProofFrameSource::body_policy(&declarations, "run", 1)
            return 9 if exhausted.known or exhausted.clauses.count != 0
        _:
            return 10
    return 0
