# Closed fixed-width bitwise evaluation and universal bitwise identities are checked by both
# the source checker and the source-neutral replay kernel.

def closed_bitwise() -> i64:
    ensure result == 42
    return (12 | 34) ^ 4

def closed_shift() -> i64:
    ensure result == 16
    return 1 << 4

def and_identity(x: i64) -> i64:
    ensure result == x
    return x & x

def or_identity(x: i64) -> i64:
    ensure result == x
    return x | 0

def xor_identity(x: i64) -> i64:
    ensure result == 0
    return x ^ x

def shift_identity(x: i64) -> i64:
    ensure result == x
    return x >> 0
