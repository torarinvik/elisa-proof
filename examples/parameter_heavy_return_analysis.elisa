# A bounded control-flow case with a high-arity policy selector. The function
# has enough entry bindings to exceed the ordinary fact snapshot at its final
# branch, but remains within the dedicated parameter-heavy cap.
module WbRuntime:
    public:
        const RESOURCE_KIND_LINEAR_MEMORY: u8 = 0
        const RESOURCE_KIND_COMPILED_CODE: u8 = 1
        const RESOURCE_KIND_GPU_ALLOCATIONS: u8 = 2
        const RESOURCE_KIND_HOST_BUFFERS: u8 = 3
        const RESOURCE_KIND_DECODED_ASSETS: u8 = 4
        const RESOURCE_KIND_DOWNLOADS: u8 = 5
        const RESOURCE_KIND_COMPONENT_INSTANCES: u8 = 6
        const RESOURCE_KIND_INVALID: u8 = 255
        const RESOURCE_BUDGET_SOURCE_UNAVAILABLE: usize = 18446744073709551615
        def parameter_heavy_manifest_route(
            kind: u8, memory_request: usize, instance_request: usize,
            default_request: usize,
            has_compiled_code: u8, compiled_code: usize,
            has_gpu: u8, gpu: usize,
            has_host_buffers: u8, host_buffers: usize,
            has_decoded_assets: u8, decoded_assets: usize,
            has_downloads: u8, downloads: usize,
            has_component_instances: u8, component_instances: usize
        ) -> usize:
            return 0 if kind > WbRuntime::RESOURCE_KIND_COMPONENT_INSTANCES
            return memory_request if kind == WbRuntime::RESOURCE_KIND_LINEAR_MEMORY
            return compiled_code if kind == WbRuntime::RESOURCE_KIND_COMPILED_CODE and has_compiled_code != 0
            return gpu if kind == WbRuntime::RESOURCE_KIND_GPU_ALLOCATIONS and has_gpu != 0
            return host_buffers if kind == WbRuntime::RESOURCE_KIND_HOST_BUFFERS and has_host_buffers != 0
            return decoded_assets if kind == WbRuntime::RESOURCE_KIND_DECODED_ASSETS and has_decoded_assets != 0
            return downloads if kind == WbRuntime::RESOURCE_KIND_DOWNLOADS and has_downloads != 0
            return component_instances if kind == WbRuntime::RESOURCE_KIND_COMPONENT_INSTANCES and has_component_instances != 0
            return instance_request if kind == WbRuntime::RESOURCE_KIND_COMPONENT_INSTANCES
            default_request

def parameter_heavy_manifest_route_contract(
    kind: u8, memory_request: usize, instance_request: usize,
    default_request: usize,
    has_compiled_code: u8, compiled_code: usize,
    has_gpu: u8, gpu: usize,
    has_host_buffers: u8, host_buffers: usize,
    has_decoded_assets: u8, decoded_assets: usize,
    has_downloads: u8, downloads: usize,
    has_component_instances: u8, component_instances: usize
) -> usize:
    ensures kind > WbRuntime::RESOURCE_KIND_COMPONENT_INSTANCES or result == 0
    ensures kind != WbRuntime::RESOURCE_KIND_LINEAR_MEMORY or result == memory_request
    ensures kind != WbRuntime::RESOURCE_KIND_COMPILED_CODE or has_compiled_code == 0 or result == compiled_code
    ensures kind != WbRuntime::RESOURCE_KIND_COMPILED_CODE or has_compiled_code != 0 or result == default_request
    ensures kind != WbRuntime::RESOURCE_KIND_GPU_ALLOCATIONS or has_gpu == 0 or result == gpu
    ensures kind != WbRuntime::RESOURCE_KIND_GPU_ALLOCATIONS or has_gpu != 0 or result == default_request
    ensures kind != WbRuntime::RESOURCE_KIND_HOST_BUFFERS or has_host_buffers == 0 or result == host_buffers
    ensures kind != WbRuntime::RESOURCE_KIND_HOST_BUFFERS or has_host_buffers != 0 or result == default_request
    ensures kind != WbRuntime::RESOURCE_KIND_DECODED_ASSETS or has_decoded_assets == 0 or result == decoded_assets
    ensures kind != WbRuntime::RESOURCE_KIND_DECODED_ASSETS or has_decoded_assets != 0 or result == default_request
    ensures kind != WbRuntime::RESOURCE_KIND_DOWNLOADS or has_downloads == 0 or result == downloads
    ensures kind != WbRuntime::RESOURCE_KIND_DOWNLOADS or has_downloads != 0 or result == default_request
    ensures kind != WbRuntime::RESOURCE_KIND_COMPONENT_INSTANCES or has_component_instances == 0 or result == component_instances
    ensures kind != WbRuntime::RESOURCE_KIND_COMPONENT_INSTANCES or has_component_instances != 0 or result == instance_request
    WbRuntime::parameter_heavy_manifest_route(
        kind, memory_request, instance_request, default_request,
        has_compiled_code, compiled_code,
        has_gpu, gpu,
        has_host_buffers, host_buffers,
        has_decoded_assets, decoded_assets,
        has_downloads, downloads,
        has_component_instances, component_instances
    )
