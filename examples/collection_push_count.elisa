# `v.push(x)` on a mutable darray reference parameter grows its count by exactly one, and
# `old(v.count)` names the count at entry (BACKLOG D-02).
def after_push(v: mutable darray[u32]&, x: u32) -> usize can[Memory.Allocate]:
    ensures result >= 1
    v.push(x)
    return v.count

def grow(v: mutable darray[u32]&, x: u32) -> void can[Memory.Allocate]:
    ensures v.count == old(v.count) + 1
    v.push(x)

def grow_twice(v: mutable darray[u32]&, x: u32) -> void can[Memory.Allocate]:
    ensures v.count == old(v.count) + 2
    v.push(x)
    v.push(x)

def unchanged(v: mutable darray[u32]&) -> usize:
    ensures result == old(v.count)
    return v.count

def grow_dozen(v: mutable darray[u32]&, x: u32) -> void can[Memory.Allocate]:
    ensures v.count == old(v.count) + 12
    v.push(x)
    v.push(x)
    v.push(x)
    v.push(x)
    v.push(x)
    v.push(x)
    v.push(x)
    v.push(x)
    v.push(x)
    v.push(x)
    v.push(x)
    v.push(x)
