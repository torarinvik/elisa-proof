# A wrapper that permutes same-region reference arguments returns exactly the formal the
# callee summary names for this call. swap_ref(a, b) returns choose_first(b, a), which is `b`;
# `a` stays writable while the result is live.
def choose_first[@r](first: mutable i64& @r, second: mutable i64& @r) -> mutable i64& @r:
    return first

def swap_ref[@r](first: mutable i64& @r, second: mutable i64& @r) -> mutable i64& @r:
    return choose_first(second, first)

def reference_call_return_provenance() -> i64 can[Memory.Allocate, Abort.Panic]:
    region scratch(1024)
    a: mutable i64& @scratch = new[scratch] 1
    b: mutable i64& @scratch = new[scratch] 2
    chosen: mutable i64& @scratch = swap_ref(a, b)
    a <- 5
    chosen <- 6
    return 0

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    return reference_call_return_provenance()
