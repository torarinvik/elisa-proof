# A whole write to a field is not an element write. It can replace the collection, so every count
# under that root is disqualified -- including the one the loop is iterating.

extend RejectedNestedExtent:
    struct State:
        region: mutable darray[usize]
        live: mutable darray[bool]

    def a_whole_field_write_loses_every_extent(state: mutable State&, replacement: darray[bool]&) -> void:
        for index in 0..<state.region.count |index, state, replacement|:
            state.live <- replacement
            state.live[index] <- false
