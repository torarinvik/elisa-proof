# A whole write to a field is not an element write. It can replace the collection, so every count
# under that root is disqualified -- including the one the loop is iterating. The replacement comes
# from a sibling field, so it lives in the same region as the place it overwrites.

module RejectedNestedExtent:
    struct State:
        region: mutable darray[usize]
        live: mutable darray[bool]
        spare: mutable darray[bool]

    def a_whole_field_write_loses_every_extent(state: mutable State&) -> void:
        for index in 0..<state.region.count |index, state|:
            state.live <- state.spare
            state.live[index] <- false
