# The values a call boundary may keep are exactly the ones no callee can reach. A binding that is
# referenced anywhere in the body may be written by the callee through that reference, and a value
# recorded in terms of such a binding would silently follow it. Neither may survive.

def reset(counter: mutable usize&) -> bool:
    changes counter
    counter <- 0
    return true

# `slot` is passed by reference to a callee that zeroes it: its recorded value 5 must not
# outlive the call.
def referenced_value_must_not_survive(seed: usize) -> usize:
    ensure result == 5
    slot: mutable usize = 5
    written: bool = reset(&slot)
    return slot if written
    return 5

# `mirror` is a copy of `seed`, recorded as the symbol `seed`. The call rewrites `seed` through its
# reference; if the recorded value followed the rewrite the checker would derive `mirror == 0`
# from the callee's summary and certify a false postcondition.
def value_over_a_referenced_binding_must_not_follow_it(seed: mutable usize&) -> usize:
    requires seed == 5
    ensure result == 0
    mirror: usize = seed
    written: bool = reset(seed)
    return mirror if written
    return 0

# The same through a statement call, which has no result binding to exempt: `slot` is referenced,
# so it is forgotten here too.
def referenced_value_must_not_survive_a_statement_call(seed: usize) -> usize:
    ensure result == 5
    slot: mutable usize = 5
    reset(&slot)
    return slot

# At a branch join a value one arm overwrites is not agreed on, so it must not survive from the
# arm that left it alone.
def value_overwritten_in_one_arm_must_not_survive(flag: bool) -> i64:
    ensure result == 3
    settled: mutable i64 = 3
    if flag:
        settled <- 9
    return settled

# Nor may a value the surviving arm rewrote be taken from the pre-branch state when the other arm
# returns.
def value_overwritten_in_the_surviving_arm_must_not_survive(flag: bool) -> i64:
    ensure result == 3
    settled: mutable i64 = 3
    if flag:
        return 3
    else:
        settled <- 9
    return settled
