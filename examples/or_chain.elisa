# Chains of three or more `or` operands, as facts and as goals. Each disjunct of a chained
# precondition is a case, whatever the nesting; a chained goal needs one provable disjunct.

def three_case_fact(x: i64) -> void:
    requires x == 1 or x == 2 or x == 3
    ensure x >= 1 and x <= 3
    return

def left_nested_fact(x: i64) -> void:
    requires (x == 1 or x == 2) or x == 3
    ensure x >= 1 and x <= 3
    return

def right_nested_fact(x: i64) -> void:
    requires x == 1 or (x == 2 or x == 3)
    ensure x >= 1 and x <= 3
    return

def mixed_relation_fact(x: i64) -> void:
    requires x < 0 or x == 5 or x > 10
    ensure x != 3
    return

def last_disjunct_goal() -> i64:
    ensure result == 0 or result == 1 or result == 2
    return 2

def middle_disjunct_goal(x: i64) -> i64:
    requires x >= 0 and x <= 10
    ensure result < 0 or result == x + 1 or result > 100
    return x + 1

# The chain is unrelated to the goal; the range alone proves it, so the retry without the
# top-level disjunction must find what the case split did not need.
def chain_beside_range(c: usize, index: usize, stop: usize) -> usize:
    requires c == 32 or c == 9 or c == 13 or c == 10
    requires index < stop
    ensure result <= stop
    return index + 1

def eight_case_fact(x: i64) -> void:
    requires x == 1 or x == 2 or x == 3 or x == 4 or x == 5 or x == 6 or x == 7 or x == 8
    ensure x >= 1 and x <= 8
    return
