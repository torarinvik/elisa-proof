include "../../Elisa-compiler/elisacore_std/elisacore_runtime_prelude.elisa"
include "../../Elisa-compiler/elisacore_std/collections.elisa"
include "../src/proof/kernel_replay/frame_policy_model.elisa"

using ElisaProofKernelFramePolicy

def main() -> i64:
    root: Place = Place{parameter: 0, depth: 0, field: "", field2: "", field3: ""}
    value: Place = Place{parameter: 0, depth: 1, field: "value", field2: "", field3: ""}
    other: Place = Place{parameter: 0, depth: 1, field: "other", field2: "", field3: ""}
    nested: Place = Place{parameter: 0, depth: 2, field: "value", field2: "x", field3: ""}
    foreign: Place = Place{parameter: 1, depth: 1, field: "value", field2: "", field3: ""}
    malformed: Place = Place{parameter: 0, depth: 0, field: "value", field2: "", field3: ""}
    whole: darray[Place] = [root]
    exact: darray[Place] = [value]
    sibling: darray[Place] = [other]
    child: darray[Place] = [nested]
    empty: darray[Place] = []
    trailing: darray[Place] = [root, malformed]
    preserved_trailing: darray[Place] = [other, malformed]
    return 1 if not write_allowed(value, exact, empty, 1)
    return 2 if not write_allowed(nested, exact, sibling, 1)
    return 3 if not write_allowed(value, whole, sibling, 1)
    return 4 if write_allowed(other, exact, empty, 1)
    return 5 if write_allowed(value, whole, exact, 1)
    return 6 if write_allowed(root, whole, exact, 1)
    return 7 if write_allowed(value, whole, child, 1)
    return 8 if write_allowed(foreign, exact, empty, 2)
    return 9 if write_allowed(foreign, whole, empty, 1)
    return 10 if write_allowed(value, trailing, empty, 1)
    return 11 if write_allowed(value, whole, preserved_trailing, 1)
    return 12 if write_allowed(value, empty, empty, 1)
    return 13 if write_allowed(value, whole, empty, 65)
    return 0
