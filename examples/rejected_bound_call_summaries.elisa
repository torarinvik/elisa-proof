# A binding learns only what its call's summary says, and a call whose precondition fails
# contributes nothing.

module RejectedBoundCallSummaries:
    public:
        def stronger_than_the_summary(bound: usize) -> usize:
            ensure result < bound
            first: usize = roll(bound)
            first

        def unproven_precondition(start: usize, stop: usize) -> usize:
            ensure result <= stop
            cursor: usize = need(start, stop)
            cursor

        def roll(bound: usize) -> usize:
            ensure result <= bound
            bound

        def need(cursor: usize, stop: usize) -> usize:
            requires cursor <= stop
            ensure result <= stop
            cursor
