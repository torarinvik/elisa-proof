# Element writes keep what they cannot change (BACKLOG W-03).

def records_write(xs: mutable darray[i64], k: usize) -> i64:
    requires k < xs.count
    ensure result == 5
    xs[k] <- 5
    return xs[k]

def keeps_other_index(xs: mutable darray[i64], j: usize, k: usize) -> i64:
    requires j < xs.count and k < xs.count and j < k and xs[j] == 3
    ensure result == 3
    xs[k] <- 5
    return xs[j]

def keeps_count(xs: mutable darray[i64], k: usize, n: usize) -> usize:
    requires k < xs.count and xs.count == n
    ensure result == n
    xs[k] <- 5
    return xs.count

def keeps_bound_beside_overwritten_read(xs: mutable darray[i64], k: usize) -> i64:
    requires k < xs.count and xs[k] == 3
    ensure result == 7
    xs[k] <- 7
    return xs[k]
