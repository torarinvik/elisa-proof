# A mutable parameter prevents a function from being a logical pure summary, even when its
# current body happens not to write. The mutability is part of the callable contract.

def mutable_identity_contract(x: mutable i64) -> i64:
    ensure result == x
    return x

def rejected_mutable_pure_contract(x: i64) -> i64:
    ensure result == mutable_identity_contract(x)
    return mutable_identity_contract(x)
