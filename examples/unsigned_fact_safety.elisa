# Non-wrapping arithmetic assumptions remain available to ordinary reasoning.
def bounded_unsigned_fact(x: u8, y: u8) -> void:
    requires x == 254
    requires y == 255
    requires y == x + 1
    ensure y > x
    return

# Repeating an assumption is logical, not a signed reinterpretation of it.
def wrapping_assumption(x: u8, y: u8) -> void:
    requires x == 255
    requires y == 0
    requires y == x + 1
    ensure y == x + 1
    return
