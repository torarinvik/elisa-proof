# Catch arms may evaluate verified total-pure values after the guarded call selects a branch.
# The guard summary and the arm summary are both consumed in their own checked state.
error CatchPureArmError:
    Bad

def catch_pure_arm_guard() -> i64 error[CatchPureArmError]:
    ensure result == 1
    return 1

def catch_pure_arm_value() -> i64:
    ensure result == 7
    return 7

def catch_pure_arm_call() -> i64:
    ensure result == 7
    return catch catch_pure_arm_guard():
        value:
            catch_pure_arm_value()
        CatchPureArmError.Bad:
            7
