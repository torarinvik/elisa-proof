# A product ranking must also reject cross-subject descent. `prev` is a strict subterm of `left`,
# but passing it as the new `right` argument while preserving `left` can increase the sum height.
enum RejectedProductNat:
    Zero
    Succ(prev: RejectedProductNat)

def rejected_inferred_product(left: RejectedProductNat, right: RejectedProductNat) -> i64:
    match left:
        RejectedProductNat.Zero:
            return 0
        RejectedProductNat.Succ(prev):
            return rejected_inferred_product(left, prev)
