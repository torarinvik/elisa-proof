include "../../Elisa-compiler/elisacore_std/elisacore_runtime_prelude.elisa"
include "../../Elisa-compiler/elisacore_std/collections.elisa"
include "../src/proof/kernel_core.elisa"
include "../src/proof/kernel_replay.elisa"

using ElisaProofKernelCore
using ElisaProofKernelFramePolicy

def policy(op: sview, actual: usize, split: usize, count: usize) -> ProofKernelNode:
    ProofKernelNode{kind: "frame-policy", operator: op, left: actual, right: split, auxiliary: 1, children_start: 2 if count > 0 else 0, children_count: count, value: 0, name: "owner", secondary_name: "frame-policy-v1"}

def main() -> i64:
    value: ProofKernelNode = ProofKernelNode{kind: "frame-field", operator: "", left: 0, right: 0, auxiliary: 0, children_start: 0, children_count: 0, value: 0, name: "value", secondary_name: ""}
    other: ProofKernelNode = ProofKernelNode{kind: "frame-field", operator: "", left: 0, right: 0, auxiliary: 0, children_start: 0, children_count: 0, value: 0, name: "other", secondary_name: ""}
    a: ProofKernelNode = ProofKernelNode{kind: "frame-place", operator: "frame-place-v1", left: 0, right: 0, auxiliary: 0, children_start: 0, children_count: 1, value: 0, name: "", secondary_name: ""}
    b: ProofKernelNode = ProofKernelNode{kind: "frame-place", operator: "frame-place-v1", left: 0, right: 0, auxiliary: 0, children_start: 1, children_count: 1, value: 0, name: "", secondary_name: ""}
    nodes: mutable darray[ProofKernelNode] = [value, other, a, b, policy("write", 2, 1, 2)]
    children: mutable darray[usize] = [0, 1, 2, 3]
    empty: darray[usize] = []
    return 17 if not ElisaProofKernelReplay::proof_kernel_replay_arena_all_report(&nodes, &children)
    return 18 if ElisaProofKernelReplay::proof_kernel_replay_goal_report_checked_arena(&nodes, &children, empty, 4)
    return 20 if not ElisaProofKernelReplay::proof_kernel_replay_frame_report_checked_arena(&nodes, &children, empty, 4)
    injected: darray[usize] = [4]
    return 21 if ElisaProofKernelReplay::proof_kernel_replay_frame_report_checked_arena(&nodes, &children, injected, 4)
    return 22 if ElisaProofKernelReplay::proof_kernel_replay_goal_report_checked_arena(&nodes, &children, injected, 4)
    return 1 if not policy_replays(nodes, children, 4)
    nodes[4] <- policy("write", 3, 1, 2)
    return 2 if policy_replays(nodes, children, 4)
    return 23 if ElisaProofKernelReplay::proof_kernel_replay_frame_report_checked_arena(&nodes, &children, empty, 4)
    nodes[4] <- policy("write", 2, 1, 2)
    children[3] <- 2
    return 3 if policy_replays(nodes, children, 4)
    children[3] <- 999
    return 4 if policy_replays(nodes, children, 4)
    children[3] <- 4
    return 5 if policy_replays(nodes, children, 4)
    return 19 if ElisaProofKernelReplay::proof_kernel_replay_arena_all_report(&nodes, &children)
    return 24 if ElisaProofKernelReplay::proof_kernel_replay_frame_report_checked_arena(&nodes, &children, empty, 4)
    children[3] <- 3
    nodes[4] <- policy("spec", 2, 0, 0)
    return 6 if not policy_replays(nodes, children, 4)
    nodes[4] <- policy("spec", 2, 1, 1)
    return 7 if policy_replays(nodes, children, 4)
    nodes[4] <- policy("preserve", 3, 0, 1)
    return 8 if not policy_replays(nodes, children, 4)
    nodes[4] <- policy("preserve", 2, 0, 1)
    return 9 if policy_replays(nodes, children, 4)
    nodes[4] <- policy("preserve", 2, 1, 1)
    return 10 if policy_replays(nodes, children, 4)
    nodes[4] <- policy("write", 2, 3, 2)
    return 11 if policy_replays(nodes, children, 4)
    nodes[4] <- policy("unknown", 2, 1, 2)
    return 12 if policy_replays(nodes, children, 4)
    nodes[4] <- policy("write", 2, 1, 2)
    nodes[4].auxiliary <- 65
    return 13 if policy_replays(nodes, children, 4)
    nodes[4].auxiliary <- 1
    nodes[4].secondary_name <- "frame-policy-v2"
    return 14 if policy_replays(nodes, children, 4)
    nodes[4].secondary_name <- "frame-policy-v1"
    children.clear()
    return 15 if policy_replays(nodes, children, 4)
    return 16 if policy_replays(nodes, children, 99)
    children <- [0, 1, 2, 2]
    nodes[4] <- policy("allow", 2, 1, 2)
    return 25 if not ElisaProofKernelReplay::proof_kernel_replay_frame_report_checked_arena(&nodes, &children, empty, 4)
    return 30 if ElisaProofKernelReplay::proof_kernel_replay_goal_report_checked_arena(&nodes, &children, empty, 4)
    return 31 if ElisaProofKernelReplay::proof_kernel_replay_goal_report_checked_arena(&nodes, &children, injected, 4)
    nodes[4] <- policy("write", 2, 1, 2)
    return 26 if policy_replays(nodes, children, 4)
    nodes[4] <- policy("preserve", 2, 0, 1)
    return 27 if policy_replays(nodes, children, 4)
    nodes[4] <- policy("allow", 3, 1, 2)
    return 28 if policy_replays(nodes, children, 4)
    nodes[4] <- policy("allow", 2, 1, 2)
    children[3] <- 99
    return 29 if policy_replays(nodes, children, 4)
    return 0
