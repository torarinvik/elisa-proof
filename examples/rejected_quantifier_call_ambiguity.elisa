def nonnegative(value: i64) -> bool:
    ensure result == (value >= 0)
    return value >= 0

# The parser's line-only quantifier marker cannot distinguish these heads.
def rejected_ambiguous_quantified_calls() -> i64:
    ensure (forall index in 0..<3: nonnegative(index)) or (exists index in 0..<3: nonnegative(index))
    return 0
