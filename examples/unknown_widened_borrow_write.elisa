# This selector is outside the resource-place fragment. Widening its borrow to
# the array denies the write conservatively, but does not demonstrate overlap.
def write_with_dynamic_borrow(values: mutable i64[2], selectors: usize[1]) -> i64:
    requires selectors[0] < 2
    shared: i64& = &values[selectors[0]]
    values[0] <- 1
    return shared
