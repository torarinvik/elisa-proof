# Closed small literal comparisons remain decidable when unrelated usize facts are in scope.
# Fixed-array indexing depends on this after guards have introduced facts for those parameters.
def fixed_literal_index_after_unsigned_facts(
    values: array[usize, 28]&, value_count: usize, expected_categories: usize
) -> usize:
    requires value_count % 4 == 0
    requires expected_categories == 7
    return values[1]
