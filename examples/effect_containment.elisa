# A declared `can[...]` row is imported and checked against every direct call in the body: each
# resolved callee's declared row must be contained in the caller's. The certificate records both
# rows so the kernel re-derives the containment rather than trusting the producer.
#
# The claim is about declared rows only. Whether a row faithfully describes what a body performs
# without calling anything stays the compiler's effect checker's obligation, which runs as the
# second defence layer over the same file.

def allocates(size: i64) -> i64 can[Memory.Allocate]:
    return size

def panics_only(value: i64) -> i64 can[Abort.Panic]:
    return value

# A caller may declare a wider row than any of its callees need.
def wider_row(size: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
    return allocates(size)

# Two callees with disjoint rows are both covered by their union.
def union_row(size: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
    allocated: i64 = allocates(size)
    checked: i64 = panics_only(size)
    return allocated

# An exactly matching row is the common case.
def exact_row(size: i64) -> i64 can[Memory.Allocate]:
    return allocates(size)

# A function with an effect row and no calls has nothing to contain.
def no_calls(value: i64) -> i64 can[Abort.Panic]:
    return value

# A callee with no declared row contributes an empty row.
def pure_callee(value: i64) -> i64:
    return value

def calls_rowless(value: i64) -> i64 can[Memory.Allocate]:
    return pure_callee(value)
