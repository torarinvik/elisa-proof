# Structural recursion over payload enums. A tree node's two subtrees are separate payload
# binders, so the summary of the first recursive call must survive the second one; a scalar
# payload binder carries the facts of its declared field type, matched by position.
enum IntList:
    Nil
    Cons(head: i64, others: IntList)

enum Tree:
    Leaf
    Node(left: Tree, value: i64, right: Tree)

enum Tagged:
    Plain
    Pair(tag: u8, weight: i64)

def list_length(list: IntList) -> i64:
    decreases list
    ensure result >= 0
    match list:
        IntList.Nil:
            return 0
        IntList.Cons(_, others):
            rest: i64 = list_length(others)
            return rest + 1 if rest < 1000000
            return rest

def tree_size(tree: Tree) -> i64:
    decreases tree
    ensure result >= 1
    match tree:
        Tree.Leaf:
            return 1
        Tree.Node(left, _, right):
            l: i64 = tree_size(left)
            r: i64 = tree_size(right)
            return l if l > 1000000 or r > 1000000
            return l + r + 1

def list_all_nonnegative(list: IntList) -> bool:
    decreases list
    match list:
        IntList.Nil:
            return true
        IntList.Cons(head, others):
            return false if head < 0
            return list_all_nonnegative(others)

def tagged_tag(value: Tagged) -> u8:
    ensure result <= 255
    match value:
        Tagged.Plain:
            return 0
        Tagged.Pair(tag, _):
            return tag
