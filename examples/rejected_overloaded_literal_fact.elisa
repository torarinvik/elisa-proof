# A source-bound `have` must not manufacture a fact by evaluating a primitive literal with
# built-in semantics when Elisa has replaced that primitive operator.
protocol Eq:
    def __eq__(self: Self, other: Self) -> bool

impl Eq for i64:
    def __eq__(self: i64, other: i64) -> bool:
        return false

def overloaded_literal_fact() -> i64:
    ensure 1 == 1
    return 0
