# Exact clauses from the two-call policy, with no calls or heap state.
def exact_capture_success(kind: u8, status: u8, saved: u8, classified: u8, output: u8) -> u8:
    requires kind > 1 or status != 0 or saved == 0
    requires classified == saved
    requires classified != 0 or output == 2
    ensure kind > 1 or status != 0 or result == 2
    return output

# Irrelevant-but-valid domain summaries must not consume the case-split budget.
def exact_capture_success_with_domains(kind: u8, status: u8, saved: u8, classified: u8, output: u8) -> u8:
    requires saved == 0 or saved == 1 or saved == 2 or saved == 3 or saved == 4
    requires output == 0 or output == 2 or output == 13 or output == 14 or output == 15
    requires output <= 19
    requires kind > 1 or status != 0 or saved == 0
    requires classified == saved
    requires classified != 0 or output == 2
    ensure kind > 1 or status != 0 or result == 2
    return output

def exact_capture_allocation(kind: u8, status: u8, saved: u8, classified: u8, output: u8) -> u8:
    requires kind > 1 or status != 4 or saved == 3
    requires classified == saved
    requires classified != 3 or output == 15
    ensure kind > 1 or status != 4 or result == 15
    return output

def exact_capture_touch(kind: u8, status: u8, saved: u8, classified: u8, output: u8) -> u8:
    requires kind != 0 or status == 0 or status > 3 or saved == 1
    requires classified == saved
    requires classified != 1 or output == 13
    ensure kind != 0 or status < 1 or status > 3 or result == 13
    return output

def exact_capture_pointer(kind: u8, status: u8, saved: u8, classified: u8, output: u8) -> u8:
    requires kind != 1 or status == 0 or status > 3 or saved == 2
    requires classified == saved
    requires classified != 2 or output == 14
    ensure kind != 1 or status < 1 or status > 3 or result == 14
    return output
