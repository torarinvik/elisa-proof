# The captured continuation state is checked, not trusted: this edge does not decrease value.
def rejected_continue_decreases_nonprogress(n: i64) -> i64:
    requires n >= 0
    ensure result == 0
    value: mutable i64 = n
    while value > 0:
        invariant value >= 0
        decreases value
        if value > 0:
            continue
    return value
