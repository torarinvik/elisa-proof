# Elisa's compiler permits primitive numeric conversion at call boundaries. The typed kernel keeps
# exact numeric widths in declarations and terms, but formation must not reject a source-valid
# numeric argument solely because its inferred spelling differs from the formal's spelling.
def kernel_numeric_call_argument_tests() -> i64 can[Memory.Allocate, Abort.Panic]:
    nodes: mutable darray[ProofKernelNode] = []
    children: mutable darray[usize] = []
    callee: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "accept_usize", "")
    integer_literal: usize = add_node(&nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
    integer_wrapper: usize = add_node(&nodes, "call_arg", "", integer_literal, 0, 0, 0, 0, 0, "", "")
    children.push(integer_wrapper)
    valid_call: usize = add_node(&nodes, "call", "", callee, 0, 1, 0, 1, 0, "", "")

    boolean_literal: usize = add_node(&nodes, "bool", "", 0, 0, 0, 0, 0, 1, "", "")
    boolean_wrapper: usize = add_node(&nodes, "call_arg", "", boolean_literal, 0, 0, 0, 0, 0, "", "")
    children.push(boolean_wrapper)
    invalid_call: usize = add_node(&nodes, "call", "", callee, 0, 2, 1, 1, 0, "", "")

    bindings: mutable darray[ProofKernelTypingBinding] = []
    signature_added: bool = proof_kernel_add_function_signature(&bindings, "accept_usize", "boolean", "bool", "", "", 0, 0, 990, 1)
    parameter_added: bool = proof_kernel_add_function_parameter(&bindings, "accept_usize", "value", "integer", "usize", "", "", 0, 0, 990, 0, false, false)
    return 1 if not signature_added or not parameter_added
    environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{bindings: bindings}
    return 2 if not proof_kernel_replay_goal_report_typed(&nodes, &children, environment, facts_one(valid_call), valid_call)
    return 3 if proof_kernel_replay_proposition_formation_report(&nodes, &children, environment, [], invalid_call)
    return 0
