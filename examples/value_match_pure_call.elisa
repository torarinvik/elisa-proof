# A verified total-pure call may be the value of a closed match arm. The arm is still checked
# against the caller's branch state, so the callee's postcondition proves the enclosing result.
def value_match_pure_call_leaf() -> i64:
    ensure result == 7
    return 7

def value_match_pure_call(x: i64) -> i64:
    ensure result == 7
    return match x:
        0:
            value_match_pure_call_leaf()
        _:
            7
