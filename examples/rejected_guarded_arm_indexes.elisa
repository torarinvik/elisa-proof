# The guard must bound the index it guards: here it bounds another collection, and the else arm
# is not guarded at all.
module RejectedGuardedArmIndexes:
    def other_guard(flags: darray[bool]&, other: darray[bool]&, i: usize) -> bool:
        planted: bool = flags[i] if i < other.count else false
        return planted

    def else_arm(flags: darray[bool]&, i: usize) -> bool:
        planted: bool = false if i < flags.count else flags[i]
        return planted
