# Defaults may call a verified total-pure function.

def pure_default_wrapper(x: i64, amount: i64 = pure_default_source()) -> i64:
    ensure result == x + amount
    return x + amount

def uses_pure_default_wrapper(x: i64) -> i64:
    ensure result == x + pure_default_source()
    return pure_default_wrapper(x)

def pure_default_source() -> i64:
    ensure result == 7
    return 7
