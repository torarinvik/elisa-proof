# An immutable scalar call result keeps its own bound across later effects,
# mutable global reads, and mutable borrows; it is one captured value.

global mutable ambient_limit: i64 = 0

def effectful(x: i64) -> i64 can[Abort.Panic]:
    requires x >= 0
    ensure result >= 0
    ensure result <= 1000000
    return x if x <= 1000000 else 1000000

def effect_chain(x: i64) -> i64 can[Abort.Panic]:
    requires x >= 0
    ensure result <= 2000000
    first: i64 = effectful(x)
    second: i64 = effectful(first)
    return first + second

def reads_global(x: i64) -> i64:
    requires x >= 0
    ensure result >= 0
    ensure result <= 1000000
    return 0 if ambient_limit < 0 else 1000000 if x > 1000000 else x

def global_chain(x: i64) -> i64:
    requires x >= 0
    ensure result <= 2000000
    first: i64 = reads_global(x)
    second: i64 = reads_global(first)
    return first + second

def through_borrow(x: mutable i64&, y: i64) -> i64:
    requires y >= 0
    ensure result >= 0
    ensure result <= 1000000
    return y if y <= 1000000 else 1000000

def borrow_chain(x: i64) -> i64:
    requires x >= 0
    ensure result <= 2000000
    cell: mutable i64 = x
    first: i64 = through_borrow(&cell, x)
    second: i64 = through_borrow(&cell, first)
    return first + second

def calls_effectful(x: i64) -> i64 can[Abort.Panic]:
    requires x >= 0
    ensure result >= 0
    ensure result <= 1000000
    return effectful(x)

def indirect_chain(x: i64) -> i64 can[Abort.Panic]:
    requires x >= 0
    ensure result <= 2000000
    first: i64 = calls_effectful(x)
    second: i64 = calls_effectful(first)
    return first + second
