# An exact unsigned equality excludes every different literal value.
def distinct_constants_from_u8(value: u8) -> bool:
    ensure value != 0 or value != 3
    ensure value != 255 or value != 254
    return true

def equality_excludes_distinct_u8_value(value: u8) -> bool:
    requires value == 0
    ensure value != 3
    return true

def fallthrough_u8_branch_excludes_zero(value: u8) -> u8:
    ensure result == 1 or value != 0
    if value == 0:
        return 1
    return 2

def fallthrough_u8_four_branch_excludes_zero(value: u8) -> u8:
    ensure result == 1 or value != 0
    if value == 0:
        return 1
    if value == 3:
        return 2
    if value == 4:
        return 2
    if value == 6:
        return 2
    return 2
