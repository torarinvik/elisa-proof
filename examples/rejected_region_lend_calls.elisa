# The boundary of the lend rule for a region-polymorphic callee. Every formal lifetime must be
# pinned to a caller region that is active at the call, and an actual that carries a region must
# land on a formal declared with that same lifetime. A lifetime the caller never established, or
# a region value reaching a formal that declares none, both need the callee's own trace.
struct Cell:
    value: mutable i64

# A region-carrying actual handed to a formal with no declared lifetime. The callee would receive
# a capability whose lifetime nothing in the signature records.
def unpinned_formal[@r](cell: Cell& @r, other: Cell&, depth: usize) -> i64:
    requires depth <= 127
    decreases 127 - depth
    return 0 if depth >= 127
    return unpinned_formal(cell, cell, depth + 1)

# A lifetime parameter with no region-carrying actual to pin it. Nothing at the call site says
# which caller region the callee is allowed to allocate into.
def unmapped_lifetime[@r](count: usize, depth: usize) -> usize:
    requires depth <= 127
    decreases 127 - depth
    return 0 if depth >= 127
    return unmapped_lifetime(count, depth + 1)
