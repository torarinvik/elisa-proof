def nonnegative(value: i64) -> bool:
    ensure result == (value >= 0)
    return value >= 0

def unverified_predicate(value: i64) -> bool:
    ensure false
    return true

def changing_predicate(value: mutable i64) -> bool:
    changes value
    value <- value + 1
    return true

def rejected_false_quantified_call() -> i64:
    ensure forall index in 0..<3: not nonnegative(index)
    return 0

def rejected_unverified_quantified_call() -> i64:
    ensure forall index in 0..<3: unverified_predicate(index)
    return 0

def rejected_impure_quantified_call() -> i64:
    ensure forall index in 0..<3: changing_predicate(index)
    return 0
