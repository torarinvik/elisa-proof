# A false plural postcondition fails on each return that breaks it; it is never
# skipped because of its spelling.
def plural_false(flag: bool) -> i32:
    ensures result == 2
    return 1 if flag
    1

def plural_beside_true(x: i32) -> i32:
    requires x >= 0 and x < 100
    ensure result >= 0
    ensures result > 100
    x
