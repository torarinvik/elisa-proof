# The cancellation tier reads `x - (x + 1)` as the ground constant -1 only after every operator
# has passed its width guard. Replay trusts that ground form; these probe that it is reached
# only when the arithmetic cannot wrap.

# u8 subtraction wraps: `x - (x + 1)` is 255, not -1.
def unsigned_cancellation_wraps(x: u8) -> u8:
    requires x < 200
    ensure x - (x + 1) < 1
    return x

# `x + 1` overflows at i64::MAX, so the step is not decided without a bound.
def unbounded_signed_cancellation(x: i64) -> i64:
    ensure x - (x + 1) < 0
    return x

# Bounded on both sides the sum is exact, and the ground comparison replays.
def bounded_signed_cancellation(x: i64) -> i64:
    requires x < 100
    requires x > 0
    ensure x - (x + 1) < 0
    return x
