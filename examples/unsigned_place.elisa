# An unsigned machine value is nonnegative whatever it holds, so `0 <= e` follows from `e` having
# an unsigned type and needs no bound and no range argument. The type of a field was not something
# this checker could say: unsigned width markers are keyed by bare name, and giving `.count` a
# width from the general width function once cost 39 proofs, because every arithmetic term
# containing a field then fell under the unsigned wrap guard.
#
# The marker here is over the place instead, and only the nonnegativity rule reads it. It answers
# one question -- does this term have an unsigned type -- and one unsigned atom settles a whole
# arithmetic term, because arithmetic mixing an unsigned operand with another type does not
# typecheck. The lower bound on `node.children_start + index` is exactly this and nothing more.

extend UnsignedPlaceCore:
    struct Outer:
        start: usize
        span: usize

extend UnsignedPlace:
    struct Node:
        children_start: usize
        children_count: usize

    def range_valid(start: usize, count: usize, total: usize) -> bool:
        ensure not result or start <= total and count <= total - start
        return false if start > total
        return false if count > total - start
        return true

    def a_guarded_range_over_a_field(node: Node, children: darray[usize]&) -> usize:
        return 0 if not range_valid(node.children_start, node.children_count, children.count)
        total: mutable usize = 0
        for index in 0..<node.children_count |index, node, children, total|:
            total <- total + children[node.children_start + index]
        return total

    def a_field_is_nonnegative(node: Node) -> bool:
        ensure result
        return 0 <= node.children_start

    # Nonnegativity is a statement about the machine value, so it holds even where the term may
    # wrap: an unsigned subtraction lands back in the unsigned range whatever it does. The fact is
    # usable only where the subtraction is separately guarded, because the range guard rejects an
    # unguarded one before any rule may read it.
    def an_unguarded_difference_is_still_nonnegative(node: Node) -> bool:
        ensure result
        return 0 <= node.children_start - 1

    # A qualified struct spelling resolves to its leaf, so a field of one carries the same witness
    # a field of an unqualified struct does. Without that, a binding whose type is written
    # `Module::Type` had no field witnesses at all.
    def a_qualified_struct_field_is_nonnegative(value: UnsignedPlaceCore::Outer) -> bool:
        ensure result
        return 0 <= value.start + value.span
