# An index expression containing a call is not admitted without a modeled call-result boundary.
# The helper has two statements, so pure function unfolding (BACKLOG D-04) leaves it opaque.

def identity_index(index: usize) -> usize:
    copy: usize = index
    return copy

def rejected_index_call(values: darray[i64]&, index: usize) -> i64:
    requires index < values.count
    return values[identity_index(index)]
