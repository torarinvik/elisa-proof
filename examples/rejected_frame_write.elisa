# A direct write must be named by the function's changes frame.

struct Box:
    value: mutable i64
    other: mutable i64

def writes_outside_frame(box: mutable Box&) -> void:
    changes box.value
    box.other <- 1

def writes_through_tracked_alias(box: mutable Box&) -> void:
    changes box.other
    alias: mutable Box& = box
    alias.value <- 1
