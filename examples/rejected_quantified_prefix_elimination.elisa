def prefix_does_not_imply_future_row(lengths: array[usize, 8]&) -> usize:
    requires forall index in 0..<8: index >= 4 or lengths[index] == 64
    ensure result == 64
    return lengths[7]

def existential_is_not_universal(lengths: array[usize, 8]&) -> usize:
    requires exists index in 0..<8: lengths[index] == 64
    ensure result == 64
    return lengths[3]

def empty_universal_has_no_instance(lengths: array[usize, 8]&) -> usize:
    requires forall index in 0..<0: lengths[index] == 64
    ensure result == 64
    return lengths[0]
