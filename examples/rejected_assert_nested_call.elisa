# A runtime assertion with a nested effectful call needs an expression evaluator. The checker
# must not publish the pre-call symbolic expression as a post-call fact.

def effectful_assert_nested_step(x: mutable i64) -> i64:
    changes x
    x <- x + 1
    return x

def rejected_assert_nested_call(x: mutable i64) -> i64:
    ensure result == x
    assert x == effectful_assert_nested_step(x)
    return x
