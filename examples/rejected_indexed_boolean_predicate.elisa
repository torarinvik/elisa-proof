def byte_nonzero(value: u8) -> bool:
    ensure result == (value != 0)
    return value != 0

def rejected_other_byte_predicate(rows: array[u8, 8]&) -> i64:
    ensure result == 0 or byte_nonzero(rows[4])
    byte: u8 = rows[3]
    checked: bool = byte_nonzero(byte)
    return 0 if not checked
    return 1
