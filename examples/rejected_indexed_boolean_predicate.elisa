def byte_nonzero(value: u8) -> bool:
    ensure result == (value != 0)
    return value != 0

def positive_only(value: u8) -> bool:
    requires value > 0
    ensure result == true
    return true

def rejected_missing_predicate_precondition(value: u8) -> i64:
    ensure positive_only(value)
    return 0

def rejected_other_byte_predicate(rows: array[u8, 8]&) -> i64:
    ensure result == 0 or byte_nonzero(rows[4])
    byte: u8 = rows[3]
    checked: bool = byte_nonzero(byte)
    return 0 if not checked
    return 1

def rejected_unequal_index_predicate(rows: array[u8, 8]&, cursor: i64) -> i64:
    requires cursor == 4
    ensure result == 0 or byte_nonzero(rows[cursor])
    byte: u8 = rows[3]
    checked: bool = byte_nonzero(byte)
    return 0 if not checked
    return 1

def rejected_false_byte_predicate(rows: array[u8, 8]&) -> i64:
    ensure result == 0 or byte_nonzero(rows[3])
    byte: u8 = rows[3]
    checked: bool = byte_nonzero(byte)
    return 0 if checked
    return 1

# An equality to a past read cannot justify a predicate after overwriting it.
def rejected_stale_byte_predicate(rows: mutable array[u8, 8]&) -> i64:
    changes rows
    ensure result == 0 or byte_nonzero(rows[3])
    byte: u8 = rows[3]
    checked: bool = byte_nonzero(byte)
    return 0 if not checked
    rows[3] <- 0
    return 1
