def computed_default() -> i64:
    return 7

lemma safe_default(value: i64, amount: i64 = 7):
    requires value == 3
    ensure value * 2 == 6
    assert value * 2 == 6

lemma executable_default(value: i64, amount: i64 = computed_default()):
    requires value == 3
    ensure value * 2 == 6
    assert value * 2 == 6

def theorem_default_target(x: i64) -> i64:
    requires x == 3
    ensure x * 2 == 6
    return 6
