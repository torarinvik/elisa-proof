def nonascii_excludes_ascii_whitespace(first: u8, available: usize) -> bool:
    requires first == 194
    ensure not (available > 0 and (first == 32 or (first >= 9 and first <= 13)))
    return true

def rejected_ascii_whitespace_exclusion(available: usize) -> bool:
    requires available > 0
    ensure not (available > 0 and (32 == 32 or (32 >= 9 and 32 <= 13)))
    return true

def negated_boolean_conjunction(left: bool, right: bool) -> bool:
    requires not left
    ensure not (left and right)
    return true

def negated_boolean_disjunction(left: bool, right: bool) -> bool:
    requires not left
    requires not right
    ensure not (left or right)
    return true

def rejected_half_disjunction_denial(left: bool, right: bool) -> bool:
    requires not left
    ensure not (left or right)
    return true

def rejected_true_conjunction_denial(left: bool, right: bool) -> bool:
    requires left
    requires right
    ensure not (left and right)
    return true
