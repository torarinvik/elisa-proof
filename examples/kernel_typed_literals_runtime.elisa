include "../build/snapshot/Elisa-compiler/elisacore_std/elisacore_runtime.elisa"
include "../src/proof/kernel_core.elisa"
include "../src/proof/kernel_typed_literals.elisa"
using ElisaProofKernelCore

def literal_node(kind: sview, sort: sview, payload: i64) -> ProofKernelNode:
    return ProofKernelNode{kind: kind, operator: "", left: 0, right: 0, auxiliary: 0, children_start: 0, children_count: 0, value: payload, name: sort, secondary_name: ""}

def main() -> i64:
    sorts: darray[sview] = ["u8", "i8", "u16", "i16", "u32", "i32", "u64", "i64"]
    maxima: darray[i64] = [255, 127, 65535, 32767, 4294967295, 2147483647, -1, 9223372036854775807]
    widths: darray[i64] = [8, 8, 16, 16, 32, 32, 64, 64]
    for index in 0..<sorts.count |index, sorts, maxima, widths|:
        decoded = typed_literal_value(literal_node("typed-int", sorts[index], maxima[index]))
        return 1 if not decoded.known or decoded.width != widths[index] or decoded.unsigned != (index % 2 == 0) or decoded.bits != maxima[index].u64()
        return 2 if typed_literal_value(literal_node("int", sorts[index], maxima[index])).known
        return 3 if index != 6 and typed_literal_value(literal_node("typed-int", sorts[index], -1)).known
        return 4 if index < 6 and typed_literal_value(literal_node("typed-int", sorts[index], maxima[index] + 1)).known
    return 5 if typed_literal_value(literal_node("typed-int", "usize", 1)).known
    return 6 if typed_literal_value(literal_node("typed-int", "Box::u64", -1)).known
    malformed: mutable ProofKernelNode = literal_node("typed-int", "u64", -1)
    malformed.operator <- "+"
    return 7 if typed_literal_value(malformed).known
    malformed.operator <- ""
    malformed.auxiliary <- 64
    return 8 if typed_literal_value(malformed).known
    malformed.auxiliary <- 0
    malformed.secondary_name <- "u64"
    return 9 if typed_literal_value(malformed).known
    # Exhaustive byte arithmetic has an independent wider-integer oracle.
    for a in 0..<256:
        for b in 0..<256 |a, b|:
            left: ProofKernelNode = literal_node("typed-int", "u8", a.i64())
            right: ProofKernelNode = literal_node("typed-int", "u8", b.i64())
            sum = typed_unsigned_add_sub(left, "+", right)
            difference = typed_unsigned_add_sub(left, "-", right)
            return 10 if not sum.known or sum.width != 8 or sum.bits != ((a + b) % 256).u64()
            return 11 if not difference.known or difference.width != 8 or difference.bits != ((a + 256 - b) % 256).u64()
    unsigned_sorts: darray[sview] = ["u8", "u16", "u32", "u64"]
    unsigned_maxima: darray[i64] = [255, 65535, 4294967295, -1]
    for index in 0..<unsigned_sorts.count |index, unsigned_sorts, unsigned_maxima|:
        maximum: ProofKernelNode = literal_node("typed-int", unsigned_sorts[index], unsigned_maxima[index])
        one: ProofKernelNode = literal_node("typed-int", unsigned_sorts[index], 1)
        zero: ProofKernelNode = literal_node("typed-int", unsigned_sorts[index], 0)
        wrapped_sum = typed_unsigned_add_sub(maximum, "+", one)
        wrapped_difference = typed_unsigned_add_sub(zero, "-", one)
        return 12 if not wrapped_sum.known or wrapped_sum.bits != 0
        return 13 if not wrapped_difference.known or wrapped_difference.bits != unsigned_maxima[index].u64()
        twice_maximum = typed_unsigned_add_sub(maximum, "+", maximum)
        cancelled = typed_unsigned_add_sub(maximum, "-", maximum)
        return 18 if not twice_maximum.known or twice_maximum.bits != unsigned_maxima[index].u64() - 1
        return 19 if not cancelled.known or cancelled.bits != 0
    high_bit: ProofKernelNode = literal_node("typed-int", "u64", 0 - 9223372036854775807 - 1)
    doubled_high_bit = typed_unsigned_add_sub(high_bit, "+", high_bit)
    return 20 if not doubled_high_bit.known or doubled_high_bit.bits != 0
    predecessor: ProofKernelNode = literal_node("typed-int", "u64", -2)
    last_increment = typed_unsigned_add_sub(predecessor, "+", literal_node("typed-int", "u64", 1))
    return 21 if not last_increment.known or last_increment.bits != 18446744073709551615u64
    reverse_maximum = typed_unsigned_add_sub(literal_node("typed-int", "u64", 0), "-", literal_node("typed-int", "u64", -1))
    return 22 if not reverse_maximum.known or reverse_maximum.bits != 1
    return 14 if typed_unsigned_add_sub(literal_node("typed-int", "u64", -1), "+", literal_node("typed-int", "i64", 1)).known
    return 15 if typed_unsigned_add_sub(literal_node("typed-int", "i64", 1), "+", literal_node("typed-int", "i64", 1)).known
    return 16 if typed_unsigned_add_sub(literal_node("typed-int", "u8", 256), "+", literal_node("typed-int", "u8", 1)).known
    return 17 if typed_unsigned_add_sub(literal_node("typed-int", "u64", -1), "*", literal_node("typed-int", "u64", 1)).known
    return 0
