# A sum of two non-constant terms is not an affine form here -- `ProofAffine.base` is one bare
# identifier -- so `start + index < total` reaches no tier that can name it, and `children[start +
# index]` is the single most common indexed access in the kernel's own replay module.
#
# Both facts that bound such a sum are structural, so the search is too: `m <= total - start` with
# `start <= total` gives `start + m <= total`, and a term under `m` inherits it. The guard on the
# subtraction is what makes it meaningful for an unsigned type, and it is exactly what such code
# already writes. The bound the search finds is also the range argument -- the sum is at most that
# term -- which is the only kind of range argument a 64-bit unsigned value can have.
#
# `examples/rejected_sum_bound.elisa` is the boundary, and the case that matters most there is the
# premise this rule refuses to read.
def transpose_the_subtraction(total: usize, start: usize, count: usize) -> usize:
    requires start <= total
    requires count <= total - start
    ensure result <= total
    return start + count

def a_term_under_the_bound(total: usize, start: usize, count: usize, index: usize) -> usize:
    requires start <= total
    requires count <= total - start
    requires index < count
    ensure result < total
    return start + index

def the_same_for_a_signed_sum(total: i64, start: i64, count: i64) -> i64:
    requires start <= total
    requires count <= total - start
    ensure result <= total
    return start + count

# The operands may be written either way round.
def commuted(total: usize, start: usize, count: usize) -> usize:
    requires start <= total
    requires count <= total - start
    ensure result <= total
    return count + start
