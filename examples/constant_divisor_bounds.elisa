module ConstantDivisorBounds:
    public:
        # Division by a positive literal carries the same relational facts as a variable divisor:
        # a nonnegative dividend bounds its quotient from above, a nonpositive dividend from below,
        # and the remainder stays in [0, K - 1]. A single quotient term is then bounded monotonically.

        def halve(a: i64) -> i64:
            requires a >= 0
            requires a <= 1000000
            ensure result >= 0
            ensure result <= a
            return a / 2

        def halve_negative(a: i64) -> i64:
            requires a <= 0
            requires a >= -1000000
            ensure result <= 0
            ensure result >= a
            return a / 4

        def digit(a: i64) -> i64:
            requires a >= 0
            requires a <= 1000000
            ensure result >= 0
            ensure result <= 9
            return a % 10

        def pull_toward(d: i64, l: i64) -> i64:
            requires l >= 0
            requires l <= 1000
            requires d >= -1000
            requires d <= 1000
            ensure d >= -l or result >= d
            if d < -l:
                return -l - (-l - d) / 2
            return d
