# Signed division and remainder boundaries: safe negative divisors prove, while zero divisors
# and MIN / -1 or MIN % -1 never produce a successful postcondition proof.
module SignedDivisionBoundaries:
    public:
        def safe_division_by_negative_one(value: i64) -> i64:
            requires value >= -10
            requires value <= 10
            ensure result >= -10
            ensure result <= 10
            return value / -1

        def safe_remainder_by_negative_two(value: i64) -> i64:
            requires value >= -10
            requires value <= 10
            ensure result >= -1
            ensure result <= 1
            return value % -2

        def minimum_division_by_negative_one_is_not_assumed_safe(value: i64) -> i64:
            requires value == -9223372036854775807 - 1
            ensure result == 0
            return value / -1

        def minimum_remainder_by_negative_one_is_not_assumed_safe(value: i64) -> i64:
            requires value == -9223372036854775807 - 1
            ensure result == 0
            return value % -1

        def division_by_zero_is_rejected(value: i64) -> i64:
            ensure result == 0
            return value / 0

        def remainder_by_zero_is_rejected(value: i64) -> i64:
            ensure result == 0
            return value % 0
