# G68 control: with each `LIMIT` resolved in its own module, the inner bound is 10, so neither a
# tighter result bound nor a claim that the inner constant is larger may be proved.
include "./include_constant_scope/inner.elisa"

module OuterScope:
    public:
        const LIMIT: f64 = 0.25

extend InnerScope:
    public:
        def too_wide(value: i64) -> bool:
            ensure LIMIT >= 500
            return within(value)

module User:
    public:
        def too_tight(value: i64) -> bool:
            ensure not result or value <= 5
            return InnerScope::within(value)
