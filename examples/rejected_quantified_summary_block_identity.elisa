def existential_summary_zero(lengths: array[usize, 8]&) -> u8:
    requires lengths[0] == 64
    ensure result == 0
    ensure result != 0 or (exists index in 0..<8: lengths[index] == 64)
    return 0

def rejected_existential_as_universal(lengths: array[usize, 8]&) -> u8:
    requires lengths[0] == 64
    ensure result != 0 or (forall row_index in 0..<8: lengths[row_index] == 64)
    return existential_summary_zero(lengths)
