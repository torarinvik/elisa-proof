# Control: hold no longer promises a nonnegative result, so locked must fail.
# Two modules define `weight`, so the function index marks that name with a
# repeated-name sentinel. Lookups of other names whose probe chain passes that
# slot must keep probing; `hold` and its contract must still be found.
module Fade:
    public:
        const FULL: i64 = 1000
        const MAX_FRAMES: i64 = 10000000

        def nearer(a: i64, b: i64) -> i64:
            requires a >= 0
            requires b >= 0
            ensure result >= 0
            return a if a <= b
            return b

        def weight(frame: i64, last: i64) -> i64:
            requires frame >= 0
            requires last >= 0
            ensure result >= 0
            ensure result <= FULL
            return 0

module Gate:
    public:
        # Padding sizes the index so a probe chain crosses the sentinel slot.
        def pad0(a: i64) -> i64:
            return a

        def pad1(a: i64) -> i64:
            return a

        def pad2(a: i64) -> i64:
            return a

        def pad3(a: i64) -> i64:
            return a

        def pad4(a: i64) -> i64:
            return a

        def weight(enabled: bool, fade: i64) -> i64:
            requires fade >= 0
            requires fade <= Fade::FULL
            ensure result >= 0
            ensure result <= Fade::FULL
            return 0 if not enabled
            return fade

module L:
    public:
        const LIMIT: i64 = 5

        def hold(into: i64) -> i64:
            requires into >= 0
            requires into <= Fade::MAX_FRAMES
            ensure result <= Fade::FULL
            return into

        def locked(value: i64, into: i64) -> i64:
            requires value >= -LIMIT
            requires into >= 0
            requires into <= Fade::MAX_FRAMES
            ensure result >= 0
            w: i64 = hold(into)
            return w
