# The receiver of a collection builtin is dropped from the *escaping* set only. Every other way a
# collection can be reached after a call has to keep the old answer.

def grow(values: mutable darray[i64]&, sink: mutable darray[darray[i64]&]&) -> void:
    sink.push(values)

def fill(values: mutable darray[i64]&) -> void:
    values.push(1)

# An explicit lend is not a builtin, and this one escapes through a parameter whose element type can
# hold a reference, so the collection stays reachable and the loop loses its range.
def a_lend_still_escapes(sink: mutable darray[darray[i64]&]&) -> i64:
    items: mutable darray[i64] = []
    items.push(1)
    grow(&items, sink)
    total: mutable i64 = 0
    for index in 0..<items.count |index, items, total|:
        total <- total + items[index]
    return total

# A push inside the body reaches the collection on every iteration, so the bound taken at entry says
# nothing about the later ones.
def a_push_in_the_body_still_writes() -> i64:
    items: mutable darray[i64] = []
    items.push(1)
    total: mutable i64 = 0
    for index in 0..<items.count |index, items, total|:
        items.push(2)
        total <- total + items[index]
    return total

# A push is still a write during its own call: a `count` fact taken before it does not carry across.
# If the receiver's recorded value survived, this would fold to zero and prove.
def a_push_still_changes_the_count() -> usize:
    ensure result == 0
    items: mutable darray[i64] = []
    before: usize = items.count
    items.push(1)
    return items.count - before - 1

# The collection a lend was pushed *into* keeps what it was given, so the lent binding still escapes
# and its own loop is refused.
def a_pushed_lend_still_escapes() -> i64:
    items: mutable darray[i64] = []
    sink: mutable darray[darray[i64]&] = []
    fill(&items)
    sink.push(items)
    total: mutable i64 = 0
    for index in 0..<items.count |index, items, total|:
        total <- total + items[index]
    return total
