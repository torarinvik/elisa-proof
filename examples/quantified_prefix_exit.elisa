def completed_prefix_last_row(lengths: array[usize, 8]&, cursor: i64) -> i64:
    requires cursor >= 8 and cursor <= 8
    requires forall index in 0..<8: index >= cursor or lengths[index] == 64
    ensure lengths[7] == 64
    return 0

def completed_prefix_all_rows(lengths: array[usize, 8]&, cursor: i64) -> bool:
    requires cursor >= 8 and cursor <= 8
    requires forall index in 0..<8: index >= cursor or lengths[index] == 64
    ensure not result or (forall index in 0..<8: lengths[index] == 64)
    return true
