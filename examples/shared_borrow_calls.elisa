# A call that hands over only shared references cannot change the caller's resource state: Elisa's
# type system forbids writing through a non-mutable reference and forbids moving out of one, and
# the capability ends with the call. Such a call therefore needs no callee body summary — which is
# the only way a recursive component can be checked at all, since it can never consume one of its
# own summaries.
struct Node:
    kind: sview
    left: usize

# Self-recursion over a shared collection.
def shared_walk(nodes: darray[Node]&, root: usize, depth: usize) -> usize:
    requires depth <= 127
    decreases 127 - depth
    return 0 if depth >= 127 or root >= nodes.count
    return shared_walk(nodes, root + 1, depth + 1)

# A callee whose own body leaves an unproven obligation emits no resource summary at all. Lending
# it a shared reference is still safe: the claim is about the parameter mode, not about the body.
def unsummarized(nodes: darray[Node]&, root: usize) -> usize:
    ensure result <= 1
    return 1 if root < nodes.count
    return 0

def shared_call_to_unsummarized(nodes: darray[Node]&, root: usize) -> usize:
    return unsummarized(nodes, root)

# Two shared references at once, and a by-value scalar alongside them.
def shared_pair(nodes: darray[Node]&, indices: darray[usize]&, root: usize, depth: usize) -> usize:
    requires depth <= 127
    decreases 127 - depth
    return 0 if depth >= 127 or root >= nodes.count or root >= indices.count
    return shared_pair(nodes, indices, root + 1, depth + 1)

# The caller holds a mutable reference and lends it as a shared one. Reborrowing narrows the
# capability, so the callee still cannot write.
def mutable_source_lends_shared(nodes: mutable darray[Node]&, root: usize) -> usize:
    return shared_walk(nodes, root, 0)

# The same shared place is lent twice in one call. Shared aliasing is not a conflict.
def shared_aliased_arguments(nodes: darray[Node]&, root: usize) -> usize:
    return shared_pair(nodes, nodes, root, 0)
