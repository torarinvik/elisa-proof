# Nested pure arm expressions are rewritten from exact verified call summaries before the
# enclosing postcondition is checked.
error CatchNestedPureError:
    Bad

def catch_nested_pure_guard() -> i64 error[CatchNestedPureError]:
    ensure result == 1
    return 1

def catch_nested_pure_leaf() -> i64:
    ensure result == 7
    return 7

def catch_nested_pure_arm_call() -> i64:
    ensure result == 8
    return catch catch_nested_pure_guard():
        value:
            catch_nested_pure_leaf() + 1
        CatchNestedPureError.Bad:
            8
