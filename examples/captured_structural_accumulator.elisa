# A captured accumulator is unrelated to the structural subject. Its presence
# must not hide the recursive call's matched strict-subterm proof.

enum CaptureTree:
    Leaf
    Node(children: darray[CaptureTree])

def fold_capture_tree(tree: CaptureTree, total: mutable i64) -> i64:
    match tree:
        CaptureTree.Leaf:
            return total
        CaptureTree.Node(children):
            for child in children |total|:
                total <- total + fold_capture_tree(child, total)
            return total
