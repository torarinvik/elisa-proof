# A `-literal` bound in a comparison with a signed side is read at that side's width, where
# negating a non-negative literal is exact, so difference goals such as `y - x >= -5` reach
# the normal-form tier instead of being declined for the literal's missing width.
module Gap:
    public:
        def trailing(x: i64, y: i64) -> i64:
            requires x >= 0
            requires x <= 100
            requires y >= x - 5
            ensure y - x >= -5
            return x

        def leading(x: i32, y: i32) -> i32:
            requires x >= -100
            requires x <= 100
            requires y >= -100
            requires y <= x + 7
            ensure -7 <= x - y
            return x
