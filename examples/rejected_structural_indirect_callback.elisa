# An unknown function-valued callback can re-enter at the same measure even though the
# explicit self-call descends. The structural summary must account for this hidden edge.
enum CallbackNat:
    Zero
    Succ(prev: CallbackNat)

def callback_bounce(n: CallbackNat, callback: fn(CallbackNat) -> i64) -> i64:
    decreases n
    ensure result == 0
    match n:
        CallbackNat.Zero:
            return 0
        CallbackNat.Succ(prev):
            _ = callback(n)
            return callback_bounce(prev, callback)

def reenter_at_same_measure(n: CallbackNat) -> i64:
    ensure result == 0
    return callback_bounce(n, reenter_at_same_measure)
