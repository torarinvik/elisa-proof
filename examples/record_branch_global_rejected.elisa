# Mutable globals may alias a borrowed formal. Do not infer a branch frame.
struct RecordGlobalState:
    value: mutable u8

global mutable ambient_record: RecordGlobalState = RecordGlobalState(value: 0)

def record_branch_global(state: mutable RecordGlobalState&, choose: bool) -> u8:
    ensure not choose or state.value == 1
    if choose:
        state.value <- 1
        ambient_record.value <- 2
    else:
        state.value <- 3
    return 0
