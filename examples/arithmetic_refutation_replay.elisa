module ArithmeticRefutation:
    public:
        # The escape disjunct covers inputs past the limit.
        def capped(current: i64) -> i64:
            ensure result <= 9 or current > 9
            return current if current > 9
            current

        # The caller's bound refutes the escape disjunct, which replay must see
        # as contradictory with `current <= 9`.
        def bounded(current: i64) -> i64:
            requires current <= 9
            ensure result <= 9
            capped(current)

        def bounded_unsigned(current: usize) -> usize:
            requires current <= 9
            ensure result <= 9
            capped_unsigned(current)

        def capped_unsigned(current: usize) -> usize:
            ensure result <= 9 or current > 9
            return current if current > 9
            current
