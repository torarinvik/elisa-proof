# The boundary. The shift needs a strict fact, gives a non-strict conclusion, and moves by one.
struct Box:
    limit: i64

# A non-strict premise leaves `a == box.limit`, where the conclusion is false.
def needs_a_strict_fact(box: Box&, a: i64) -> i64:
    requires a <= box.limit
    ensure result <= box.limit
    return a + 1

# `a < R` does not give `a + 1 < R`.
def gives_no_strict_conclusion(box: Box&, a: i64) -> i64:
    requires a < box.limit
    ensure result < box.limit
    return a + 1

# The shift is by one; two needs `a + 2 <= R`, which no strict fact gives.
def moves_by_one_only(box: Box&, a: i64) -> i64:
    requires a < box.limit
    ensure result <= box.limit
    return a + 2

# The fact bounds a different term.
def bounds_another_term(box: Box&, other: Box&, a: i64) -> i64:
    requires a < other.limit
    ensure result <= box.limit
    return a + 1

# The extent of a *different* collection is not the bound the fact gives.
def another_collection_extent(values: darray[i64]&, other: darray[i64]&, index: usize) -> usize:
    requires index < other.count
    ensure result <= values.count
    return index + 1
