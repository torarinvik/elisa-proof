def nonnegative(value: i64) -> bool:
    ensure result == (value >= 0)
    return value >= 0

def positive_only(value: i64) -> bool:
    requires value > 0
    ensure result == true
    return true

def rejected_false_summary() -> i64:
    ensure forall index in 0..<3: not nonnegative(index)
    return 0

def rejected_missing_precondition() -> i64:
    ensure forall index in 0..<3: positive_only(index)
    return 0

def rejected_negative_instance() -> i64:
    ensure forall index in -1..<3: nonnegative(index)
    return 0

# No inferred axiom may replace the explicit summary-expansion work limit.
def rejected_over_budget_summary() -> i64:
    ensure forall index in 0..<1025: nonnegative(index)
    return 0

# A false left alternative cannot suppress an unproved right alternative.
def rejected_false_disjunction_summary() -> i64:
    ensure forall index in 0..<3: index > 0 or not nonnegative(index)
    return 0
