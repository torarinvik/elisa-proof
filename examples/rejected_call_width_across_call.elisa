# Controls: a second clamp into a narrower range need not return the first result, and the
# surviving width proves no bound the callee did not state.
module Clamp:
    public:
        def clamp(value: i64, lo: i64, hi: i64) -> i64:
            requires lo <= hi
            ensure result >= lo
            ensure result <= hi
            ensure value < lo or value > hi or result == value
            return lo if value < lo
            return hi if value > hi
            return value

module Uses:
    public:
        def narrower(v: i64, lo: i64, hi: i64) -> bool:
            requires lo < hi
            ensure result
            once: i64 = Clamp::clamp(v, lo, hi)
            twice: i64 = Clamp::clamp(once, lo, hi - 1)
            return twice == once

        def unstated_bound(v: i64, lo: i64, hi: i64) -> i64:
            requires lo <= hi
            ensure result > lo
            once: i64 = Clamp::clamp(v, lo, hi)
            return Clamp::clamp(once, lo, hi)
