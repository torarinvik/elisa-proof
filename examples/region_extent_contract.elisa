# A region-polymorphic function could not state a contract about its own parameter. Every logical
# contract mentioning a region-owned binding was refused outright, and `requires index <
# nodes.count` is the bounds precondition every such function needs -- so region-polymorphic code
# could be written but never specified, and every index inside it stayed unproven for want of a
# precondition it was not allowed to declare.
#
# The element count of a collection is a machine integer copied out of it. Reading it ties nothing
# to the collection's lifetime, so it is admitted. Everything else about a region-owned binding
# still is not: `examples/rejected_region_extent_contract.elisa` is the other half, and the
# decisive case there is a struct whose own field is called `count`.
struct Node:
    left: usize

def bounded_without_indexing[@r](nodes: darray[Node]& @r, index: usize) -> usize:
    requires index < nodes.count
    ensure result < nodes.count
    return index

def extent_in_an_ensure[@r](nodes: darray[Node]& @r) -> usize:
    ensure result == nodes.count
    return nodes.count

# Two lifetimes, and a contract relating both extents.
def two_lifetimes[@r, @e](nodes: darray[Node]& @r, other: darray[Node]& @e) -> usize:
    requires nodes.count == other.count
    ensure result == other.count
    return nodes.count

# The shape the whole rule is for: the precondition bounds the index, and the indexed read of the
# region-owned collection proves and replays. Before the return witness was chosen by region
# rather than by recency, this verified and then failed to replay -- `nodes[index]` records a use
# of `nodes` and then one of `index`, and only the first is in the region.
def indexes_under_its_own_precondition[@r](nodes: darray[Node]& @r, index: usize) -> usize:
    requires index < nodes.count
    return nodes[index].left
