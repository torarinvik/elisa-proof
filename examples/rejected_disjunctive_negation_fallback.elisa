module RejectedDisjunctiveNegationFallback:
    public:
        # `r <= l - f + 1` leaves `r == 1` open when `f == l`.
        def remaining(f: i64, l: i64, r: i64) -> i64:
            requires l >= 0
            requires f >= 0
            requires f <= l
            requires r >= 0
            requires r <= l - f + 1
            ensure f != l or r == 0
            return 0

        def pick(a: i64, b: i64) -> i64:
            ensure a != b or result == b
            return b if a == b
            return 0

        # `v != w` is not refuted, so the callee's disjunct gives nothing.
        def other(v: i64, w: i64) -> i64:
            ensure result == w
            return pick(v, w)
