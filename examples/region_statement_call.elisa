# A statement that is just a call may name a region-owned binding. `out.push(value)` where `out`
# carries a lifetime is the ordinary way a region-polymorphic function does anything at all, and
# it was refused: the gate asked whether the *callee path* mentioned a region binding rather than
# whether the discarded result carried a region. That is 88 of the 116
# `region-expression-unsupported` findings on the kernel's own source, all of them in functions
# that have a lifetime parameter and push into something.
#
# The receiver's use is recorded as its own transition and replayed either way -- the emitted
# events for the region and the non-region spelling differ only in the lifetime on the bind -- so
# nothing was being checked by the extra refusal. What a statement can still drop is its result,
# and `examples/rejected_region_statement_call.elisa` is that half.
struct Bag:
    items: mutable darray[usize]

def pushes_into_a_region_collection[@e](out: mutable darray[usize]& @e, value: usize) -> void:
    changes out
    out.push(value)

def pushes_through_a_region_struct[@s](bag: mutable Bag& @s, value: usize) -> void:
    changes bag
    bag.items.push(value)

# The same call with no lifetime parameter, which always verified. Both spellings are one program.
def pushes_without_a_lifetime(out: mutable darray[usize]&, value: usize) -> void:
    changes out
    out.push(value)
