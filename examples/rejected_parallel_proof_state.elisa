# Parallel iteration has a separate scheduling and memory model. Until the proof state carries
# worker isolation, reduction ownership, and join semantics, facts may not cross this boundary.

def parallel_fact_barrier(values: darray[i64], total: i64) -> i64 can[Pool.Submit, Pool.WaitAll]:
    requires total == 0
    ensure result == 0
    parallel for value in values:
        pass
    return total
