# A block-form captured loop leaves its own post state: the invariants it checked still hold
# after it, as they do for the accumulator spelling.
module CapturedBlockExit:
    def scan(start: usize, stop: usize) -> usize:
        requires start <= stop
        ensure start <= result and result <= stop
        cursor: mutable usize = start
        for slot in 0..<8 |cursor|:
            invariant start <= cursor and cursor <= stop
            cursor <- cursor + 1 if cursor < stop
        cursor
