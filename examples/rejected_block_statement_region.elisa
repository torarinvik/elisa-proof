# The boundary still refuses a region-owned value that is genuinely discarded. A block statement is
# exempt because it has no value of its own; an expression that does have one is not.

extend RejectedBlockStatementRegion:
    # A region-owned binding as a bare expression statement is a value thrown away.
    def a_discarded_region_value_is_refused() -> usize:
        seen: mutable usize = 0
        region scratch:
            held: usize& = new[scratch] 7
            held
            seen <- 1
        return seen

    # Parenthesising it changes nothing: the boundary looks through parentheses.
    def parentheses_do_not_hide_it() -> usize:
        seen: mutable usize = 0
        region scratch:
            held: usize& = new[scratch] 7
            (held)
            seen <- 2
        return seen
