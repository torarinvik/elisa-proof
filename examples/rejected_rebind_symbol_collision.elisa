# Fresh names in the verifier's rebind pool are not user-level binders. Even an otherwise-unused
# source local may occupy the same spelling and alias another value in the proof state.
def rebind_symbol_collision(seed: i64) -> i64:
    ensure result == seed + 1
    __elisa_rebind_0: i64 = 7
    x: mutable i64 = 0
    x <- x + 1
    return x
