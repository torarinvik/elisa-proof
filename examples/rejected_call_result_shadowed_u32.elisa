# A later function in the caller's module shadows the earlier peer declaration, even when the
# caller appears before the local declaration. Replay must not use the peer's u32 result bound.
module Narrow:
    public:
        def cap(value: bool) -> u32:
            ensure result >= 0
            ensure result <= 255
            return 5

module Client:
    public:
        def uses_local_forward_declaration() -> bool:
            ensure result
            cap() <= 255

        def cap() -> i64:
            ensure result >= 0
            return 1000
