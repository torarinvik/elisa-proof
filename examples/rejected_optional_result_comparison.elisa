# The compiler rejects comparing an optional result directly with its payload type.
# Preserve the original get-else counterexample: this ill-typed contract must not
# authorize a verified executable summary at its caller.
def rejected_optional_result_comparison(x: i64) -> i64?:
    ensure result == x
    return x


def rejected_optional_getelse_summary(x: i64) -> i64:
    requires x == 0
    ensure result == x
    return get rejected_optional_result_comparison(x) else return 0
