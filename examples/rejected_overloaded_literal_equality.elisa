# Literal operands must not be treated as built-in equality when the imported Elisa source
# supplies a concrete primitive Eq implementation. This implementation deliberately reverses
# equality, so the postcondition is false in source semantics.
protocol Eq:
    def __eq__(self: Self, other: Self) -> bool

impl Eq for i64:
    def __eq__(self: i64, other: i64) -> bool:
        return false

def overloaded_literal_equality() -> i64:
    ensure (1 == 1) == true
    return 0
