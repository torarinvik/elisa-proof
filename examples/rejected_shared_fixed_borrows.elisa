# Each frame below could write the shared pointee, or holds a path that might, so a fact about a
# field behind the borrow does not survive the loop that lends it.

module RejectedSharedFixedBorrows:
    public:
        struct Text:
            bytes: u8[16]
            length: mutable usize
        struct Holder:
            text: mutable Text&

        # A mutable reference parameter is a path the frame received; the language does not
        # promise it is disjoint from `text`.
        def with_a_mutable_parameter(text: Text&, other: mutable Text&, stop: usize) -> usize:
            requires stop <= text.length and text.length <= 16
            for slot in 0..<4 |other, cursor: usize = 0| -> cursor:
                invariant cursor <= stop
                seen: usize = look(text)
                touch(other)
                check(stop, text.length)
                cursor <- cursor + 1 if cursor < stop

        # A shared borrow of an aggregate holding a mutable reference is a mutable path too.
        def with_a_reference_field(text: Text&, holder: Holder&, stop: usize) -> usize:
            requires stop <= text.length and text.length <= 16
            for slot in 0..<4 |cursor: usize = 0| -> cursor:
                invariant cursor <= stop
                seen: usize = look(text)
                check(stop, text.length)
                cursor <- cursor + 1 if cursor < stop

        def look(text: Text&) -> usize:
            0
        def touch(text: mutable Text&) -> void:
            text.length <- 0
        def check(stop: usize, length: usize) -> void:
            requires stop <= length
            pass
