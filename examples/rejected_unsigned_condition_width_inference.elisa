# A condition's unsigned operands do not set the result type of an if expression.
struct BranchValues:
    selector: u8
    signed_value: i64

def rejected_unsigned_condition_width_inference(values: BranchValues) -> i64:
    ensure 0 <= result
    return values.signed_value if values.selector == 0 else 0

def main() -> u8:
    return 0
