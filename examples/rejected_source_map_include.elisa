# Findings and goals from an included file name that file and its own line; a function whose
# only problem is a finding without a goal is still reported as not proved.
include "./rejected_effectful_numeric_cast_contract.elisa"

module SourceMapRoot:
    public:
        def kept(value: i64) -> i64:
            requires value >= 0
            requires value <= 100
            ensure result >= value
            return value + 1

        # No goal of its own: the contract call is refused before any goal is formed.
        def only_finding(source: mutable u8) -> u8:
            requires effectful_status(source) > 0
            return 0
