# The boundary. A guard bounds the operand it guards, and only that: the wrong comparison, the
# wrong name, the wrong side of the operator and the wrong order are all still refused, and a
# guard that names a call is not a stable term at all.
def bound(xs: darray[i64]&) -> usize:
    return xs.count

# `<=` admits `index == xs.count`.
def off_by_one(xs: darray[i64]&, index: usize) -> bool:
    return index <= xs.count and xs[index] > 0

# The guard bounds a different name.
def guards_another_name(xs: darray[i64]&, index: usize, other: usize) -> bool:
    return other < xs.count and xs[index] > 0

# The right operand of `or` runs exactly when the guard is false, so this guard bounds nothing.
def or_runs_when_the_guard_fails(xs: darray[i64]&, index: usize) -> bool:
    return index < xs.count or xs[index] > 0

# The guard is on the right, so it has not been evaluated when the index is read.
def guard_comes_after(xs: darray[i64]&, index: usize) -> bool:
    return xs[index] > 0 and index < xs.count

# A call in the guard is a second call when the fact is used, so it records nothing.
def guard_has_a_call(xs: darray[i64]&, index: usize) -> bool:
    return index < bound(xs) and xs[index] > 0
