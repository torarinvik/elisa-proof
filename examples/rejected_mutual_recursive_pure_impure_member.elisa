# A recursive SCC is not pure when any member reaches an unresolved call, even if another member
# would otherwise have a straight-line total body.

extern nondeterministic_mutual_value() -> i64

def impure_mutual_even(n: i64) -> i64:
    decreases n
    if n > 0:
        return impure_mutual_odd(n - 1)
    return nondeterministic_mutual_value()

def impure_mutual_odd(n: i64) -> i64:
    decreases n
    if n > 0:
        return impure_mutual_even(n - 1)
    return 0

def rejected_mutual_recursive_pure_impure_member(n: i64) -> i64:
    ensure result == impure_mutual_odd(n)
    return impure_mutual_odd(n)
