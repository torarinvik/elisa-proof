# A concrete consequence of a 64-element predicate prefix, not a scalar surrogate.
def context_byte_nonzero(value: u8) -> bool:
    ensure result == (value != 0)
    return value != 0

def finite_predicate_context(rows: array[u8, 64]&, cursor: i64) -> i64:
    requires cursor == 38
    requires forall index in 0..<64: index >= cursor or context_byte_nonzero(rows[index])
    ensure context_byte_nonzero(rows[37])
    return 0

def finite_predicate_nonzero_lower(rows: array[u8, 64]&) -> i64:
    requires forall index in 7..<64: context_byte_nonzero(rows[index])
    ensure context_byte_nonzero(rows[37])
    return 0

def finite_predicate_inclusive_upper(rows: array[u8, 64]&) -> i64:
    requires forall index in 7..=37: context_byte_nonzero(rows[index])
    ensure context_byte_nonzero(rows[37])
    return 0
