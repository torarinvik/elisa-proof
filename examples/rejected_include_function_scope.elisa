# G68 must-reject controls: each claim holds only for a wrongly captured `step`.
include "./include_function_scope/inner.elisa"

module OuterFn:
    public:
        def step(value: i64) -> i64:
            requires value >= 0 and value <= 1000
            ensure result == value + 2
            return value + 2

        def wrong_qualified(value: i64) -> i64:
            requires value >= 0 and value <= 1000
            ensure result == value + 2
            return InnerFn::step(value)

        def wrong_nested(value: i64) -> i64:
            requires value >= 0 and value <= 1000
            ensure result == value + 2
            return Geometry::Scalar::step(value)

extend InnerFn:
    public:
        def wrong_bare(value: i64) -> i64:
            requires value >= 0 and value <= 1000
            ensure result == value + 2
            return step(value)
