# Conflicting declarations for one lexical value must not make typed admission depend on
# environment order. Identical repeated evidence and a single Boolean value remain admissible.
def kernel_ambiguous_value_binding_tests() -> i64 can[Memory.Allocate, Abort.Panic]:
    nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
    children: mutable darray[usize] = []
    flag: usize = ElisaProofKernelCore::add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "flag", "")

    boolean_then_integer: mutable darray[ElisaProofKernelCore::ProofKernelTypingBinding] = []
    bool_added: bool = ElisaProofKernelCore::proof_kernel_add_typing_binding(&boolean_then_integer, "value", "flag", "", "boolean", "bool", "", "")
    integer_added: bool = ElisaProofKernelCore::proof_kernel_add_typing_binding(&boolean_then_integer, "value", "flag", "", "integer", "i64", "", "")
    return 1 if not bool_added or not integer_added
    boolean_then_integer_environment: ElisaProofKernelCore::ProofKernelTypeEnvironment = ElisaProofKernelCore::ProofKernelTypeEnvironment{bindings: boolean_then_integer}
    return 2 if ElisaProofKernelReplay::proof_kernel_replay_proposition_formation_report(&nodes, &children, boolean_then_integer_environment, [], flag)

    integer_then_boolean: mutable darray[ElisaProofKernelCore::ProofKernelTypingBinding] = []
    integer_added_first: bool = ElisaProofKernelCore::proof_kernel_add_typing_binding(&integer_then_boolean, "value", "flag", "", "integer", "i64", "", "")
    bool_added_last: bool = ElisaProofKernelCore::proof_kernel_add_typing_binding(&integer_then_boolean, "value", "flag", "", "boolean", "bool", "", "")
    return 3 if not integer_added_first or not bool_added_last
    integer_then_boolean_environment: ElisaProofKernelCore::ProofKernelTypeEnvironment = ElisaProofKernelCore::ProofKernelTypeEnvironment{bindings: integer_then_boolean}
    return 4 if ElisaProofKernelReplay::proof_kernel_replay_proposition_formation_report(&nodes, &children, integer_then_boolean_environment, [], flag)

    single_boolean: mutable darray[ElisaProofKernelCore::ProofKernelTypingBinding] = []
    single_added: bool = ElisaProofKernelCore::proof_kernel_add_typing_binding(&single_boolean, "value", "flag", "", "boolean", "bool", "", "")
    single_boolean_environment: ElisaProofKernelCore::ProofKernelTypeEnvironment = ElisaProofKernelCore::ProofKernelTypeEnvironment{bindings: single_boolean}
    return 5 if not single_added or not ElisaProofKernelReplay::proof_kernel_replay_proposition_formation_report(&nodes, &children, single_boolean_environment, [], flag)

    duplicate_boolean: mutable darray[ElisaProofKernelCore::ProofKernelTypingBinding] = []
    duplicate_first: bool = ElisaProofKernelCore::proof_kernel_add_typing_binding(&duplicate_boolean, "value", "flag", "", "boolean", "bool", "", "")
    duplicate_second: bool = ElisaProofKernelCore::proof_kernel_add_typing_binding(&duplicate_boolean, "value", "flag", "", "boolean", "bool", "", "")
    duplicate_boolean_environment: ElisaProofKernelCore::ProofKernelTypeEnvironment = ElisaProofKernelCore::ProofKernelTypeEnvironment{bindings: duplicate_boolean}
    return 6 if not duplicate_first or not duplicate_second or not ElisaProofKernelReplay::proof_kernel_replay_proposition_formation_report(&nodes, &children, duplicate_boolean_environment, [], flag)
    return 0
