# Minimal caller-region collection return: the returned value must remain a darray,
# allocated in the caller's region, and consumed before that region is destroyed.
def make_values[@r](anchor: i64& @r) -> darray[i64] @r:
    values: mutable darray[i64] @r = []
    values.push(7)
    return move values

def consume_values() -> usize can[Memory.Allocate, Abort.Panic]:
    region caller_region(4096)
    anchor: i64& @caller_region = new[caller_region] 0
    values: mutable darray[i64] @caller_region = make_values(anchor)
    count: usize = values.count
    destroy caller_region
    return count
