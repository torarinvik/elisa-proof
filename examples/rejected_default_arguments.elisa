# Calls with effectful defaults are deliberately opaque until default effects have a proof
# model; they must not be treated as pure summary applications.

def effectful_default() -> i64:
    return 7

def requires_default(x: i64, amount: i64 = effectful_default()) -> i64:
    requires amount == 7
    ensure result == x + amount
    return x + amount

def caller_with_effectful_default(x: i64) -> i64:
    requires x >= 0
    ensure result == x + 7
    return requires_default(x)
