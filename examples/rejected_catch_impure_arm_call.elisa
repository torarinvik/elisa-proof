# An effectful call hidden in a catch value arm must remain rejected. Catch-arm evaluation is
# branch-local, but this kernel does not model effectful expression state there.
error RejectedCatchImpureArmError:
    Bad

def rejected_catch_impure_arm_guard() -> i64 error[RejectedCatchImpureArmError]:
    return 1

def rejected_catch_impure_arm_value(value: mutable i64) -> i64:
    value <- value + 1
    return value

def rejected_catch_impure_arm_call(x: i64) -> i64:
    return catch rejected_catch_impure_arm_guard():
        value:
            rejected_catch_impure_arm_value(x)
        RejectedCatchImpureArmError.Bad:
            0
