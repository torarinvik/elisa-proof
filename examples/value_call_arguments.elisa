# A payload enum is an immutable tree, so a by-value binding of one that nothing references is a
# value no callee can change. A pure call over it denotes one value, and the summary of a call
# made over it survives the next call exactly as it would over a scalar argument.

module ValueCallArguments:
    public:
        enum Nat:
            Zero
            Succ(prev: Nat)

        struct Point:
            x: i64
            y: i64

        enum Path:
            Stop
            Step(at: Point, rest: Path)

        def depth(n: Nat) -> i64:
            ensure result >= 0
            0

        def length(p: Path) -> i64:
            ensure result >= 0
            0

        def declared(n: Nat) -> i64:
            ensure result >= 0
            r: i64 = depth(n)
            r

        def both(n: Nat) -> i64:
            ensure result >= 0
            a: i64 = depth(n)
            b: i64 = depth(n)
            a if a > b else b

        def payload(n: Nat) -> i64:
            ensure result >= 0
            match n:
                Nat.Zero:
                    return 0
                Nat.Succ(prev):
                    a: i64 = depth(prev)
                    b: i64 = depth(n)
                    return a if a > b else b

        def local_copy(n: Nat) -> i64:
            ensure result >= 0
            m: Nat = n
            a: i64 = depth(m)
            b: i64 = depth(n)
            a if a > b else b

        def path_twice(p: Path) -> i64:
            ensure result >= 0
            a: i64 = length(p)
            b: i64 = length(p)
            a if a > b else b
