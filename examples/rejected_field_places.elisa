module RejectedFieldPlaces:
    public:
        const CAP: usize = 16

        struct Text:
            bytes: mutable u8[RejectedFieldPlaces::CAP]
            length: mutable usize
            other: mutable usize

        # `at` may equal the length, which may equal the capacity.
        def non_strict(text: Text&, at: usize) -> u8:
            requires at <= text.length and text.length <= CAP
            text.bytes[at]

        # The bound is on a different field, so nothing links the two.
        def other_field(text: Text&, at: usize) -> u8:
            requires at < text.length and text.other <= CAP
            text.bytes[at]

        # Two different records: the chain does not pass through one value.
        def other_record(text: Text&, spare: Text&, at: usize) -> u8:
            requires at < text.length and spare.length <= CAP
            text.bytes[at]
