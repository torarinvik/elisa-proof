# A call in an arm of an if-expression runs only when its arm is taken. The statement is checked
# as the `if` it denotes, so the callee's `requires` is discharged under the arm's own condition
# and its `ensure`s are used only on the path that runs it. Declarations, plain rebinds and
# returns are all rewritten this way (mocap-cleaner `Track::sample`, `RigOps::*`), and so is an
# if-expression nested in a strict position whose condition is call-free (`Stack::apply`).
module ConditionalCallArms:
    def halve(x: i64) -> i64:
        requires x >= 0
        requires x <= 1000
        ensure result >= 0
        ensure result <= 500
        return x / 2

    def declared(x: i64) -> i64:
        requires x <= 1000
        ensure result >= 0
        ensure result <= 500
        h: i64 = halve(x) if x >= 0 else 0
        return h

    def returned(x: i64) -> i64:
        requires x <= 1000
        ensure result >= 0
        ensure result <= 500
        return halve(x) if x >= 0 else 0

    def rebound(x: i64) -> i64:
        requires x <= 1000
        ensure result >= 0
        ensure result <= 500
        h: mutable i64 = 0
        h <- halve(x) if x >= 0 else 0
        return h

    # The call may sit in the condition too; it runs whenever the statement does.
    def called_condition(x: i64) -> i64:
        requires x >= 0
        requires x <= 1000
        ensure result >= 0
        ensure result <= 500
        h: i64 = 0 if halve(x) == 0 else halve(x)
        return h

    # Nested in a call argument: the condition is call-free and nothing runs before it.
    def nested_argument(x: i64) -> i64:
        requires x <= 1000
        ensure result >= 0
        ensure result <= 500
        h: i64 = halve(halve(x) if x >= 0 else 0)
        return h

    # Pushed: the mocap `out.push(f(...) if guard else v)` shape, also under another call.
    def nested_push(x: i64) -> darray[i64]:
        requires x <= 1000
        out: mutable darray[i64] = []
        out.push(halve(x) if x >= 0 else 0)
        out.push(halve(halve(x) if x >= 0 else 0))
        return out
