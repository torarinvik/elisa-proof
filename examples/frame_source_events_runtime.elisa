include "../build/snapshot/Elisa-compiler/elisacore_std/elisacore_runtime.elisa"
include "../build/snapshot/Elisa-compiler/src/parser/parser.elisa"
using Ast
include "../src/proof/kernel_core.elisa"
include "../src/proof/kernel_replay/frame_policy_model.elisa"
include "../src/proof/kernel_replay/frame_policy_places.elisa"
include "../src/proof/replay/frame_source_places.elisa"
include "../src/proof/replay/frame_source_owners.elisa"
include "../src/proof/replay/frame_source_types.elisa"
include "../src/proof/replay/frame_source_policy.elisa"
include "../src/proof/replay/frame_source_headers.elisa"
include "../src/proof/replay/frame_source_header_policy.elisa"
include "../src/proof/replay/frame_source_writes.elisa"
include "../src/proof/replay/frame_source_scalar_contracts.elisa"
include "../src/proof/replay/frame_source_scalar_values.elisa"
include "../src/proof/replay/frame_source_events.elisa"

def check(source: u8&, expected: bool, count: usize) -> bool can[Memory.Allocate, Abort.Panic]:
    tokens: darray[Token] = frontend_tokenize(source, source)
    file: Ast::File = frontend_parser_parse_file(source, tokens)
    return false if file.errors.count != 0
    inventory = ElisaProofFrameSource::direct_events(&file.top_decls, "run", 4, &tokens, source, tokens[tokens.count - 1].start.usize())
    return inventory.known == expected and inventory.events.count == count

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    return 1 if not check("struct Box:\n    value: mutable i64\n    other: mutable i64\ndef run(box: mutable Box&) -> void changes box.value preserves box.other:\n    box.value <- 1\n", true, 4)
    return 2 if not check("struct Box:\n    value: mutable i64\n    other: mutable i64\ndef run(box: mutable Box&) -> void changes box.value preserves box.other, box.value:\n    box.value <- 1\n", true, 6)
    return 3 if not check("struct Box:\n    value: mutable i64\n    other: mutable i64\ndef run(box: mutable Box&) -> void changes box.value:\n    box.value <- 1\n", true, 2)
    return 4 if not check("struct Box:\n    value: mutable i64\n    other: mutable i64\ndef run(box: mutable Box&) -> void preserves box.other:\n    box.value <- 1\n", true, 2)
    return 5 if not check("struct Box:\n    value: mutable i64\n    other: mutable i64\ndef run(box: mutable Box&) -> void changes box.value:\n    box.value <- helper()\n", false, 0)
    return 6 if not check("struct Box:\n    value: mutable i64\n    other: mutable i64\ndef run(box: mutable Box&) -> void changes box.value:\n    if true:\n        box.value <- 1\n", false, 0)
    return 7 if not check("struct Box:\n    value: mutable i64\n    other: mutable i64\ndef run(box: mutable Box&) -> void changes box.value:\n    alias = box\n    alias.value <- 1\n", false, 0)
    return 8 if not check("struct Box:\n    value: mutable i64\n    other: mutable i64\ndef run(box: mutable Box&) -> void changes box.value:\n    box.value <- 1\n    box.value <- helper()\n", false, 0)
    source: u8& = "struct Box:\n    value: mutable i64\n    other: mutable i64\ndef run(box: mutable Box&) -> void changes box.value preserves box.other, box.value:\n    box.value <- 1\n"
    tokens: darray[Token] = frontend_tokenize(source, source)
    file: Ast::File = frontend_parser_parse_file(source, tokens)
    length: usize = tokens[tokens.count - 1].start.usize()
    inventory = ElisaProofFrameSource::direct_events(&file.top_decls, "run", 4, &tokens, source, length)
    return 9 if not inventory.known or inventory.events.count != 6
    return 10 if inventory.events[3].kind != "allow" or inventory.events[4].kind != "preserve" or inventory.events[5].kind != "preserve" or inventory.events[4].clause_index != 1 or inventory.events[5].clause_index != 2
    return 11 if inventory.events[4].position.line != 5 or inventory.events[4].statement_index != 0 or inventory.events[4].place.field != "value"
    claimed: mutable darray[ElisaProofFrameSource::Event] = inventory.events
    return 12 if not ElisaProofFrameSource::direct_events_match(&file.top_decls, "run", 4, &tokens, source, length, &claimed)
    original = claimed[5]
    claimed[5] <- claimed[4]
    return 13 if ElisaProofFrameSource::direct_events_match(&file.top_decls, "run", 4, &tokens, source, length, &claimed)
    claimed[5] <- original
    claimed[5].position.column <- claimed[5].position.column + 1
    return 14 if ElisaProofFrameSource::direct_events_match(&file.top_decls, "run", 4, &tokens, source, length, &claimed)
    claimed.resize(5)
    return 15 if ElisaProofFrameSource::direct_events_match(&file.top_decls, "run", 4, &tokens, source, length, &claimed)
    return 16 if not check("struct Box:\n    value: mutable i64\n    other: mutable i64\ndef run(box: mutable Box&) -> void changes box.value:\n    box.value += 1\n", false, 0)
    return 17 if not check("struct Box:\n    value: mutable i64\n    other: mutable i64\ndef run(box: mutable Box&, x: i64) -> i64:\n    requires x >= 0\n    ensure result == x\n    changes box.value\n    preserves box.other\n    box.value <- 1\n    return x\n", true, 4)
    return 18 if not check("struct Box:\n    value: mutable i64\n    other: mutable i64\ndef run(box: mutable Box&, x: i64) -> i64 changes box.value:\n    requires x >= 0 and x < 10\n    ensure not (result != x)\n    box.value <- 1\n    return x\n", true, 2)
    return 19 if not check("struct Box:\n    value: mutable i64\n    other: mutable i64\ndef run(box: mutable Box&, x: i64) -> i64 changes box.value:\n    requires helper(x)\n    box.value <- 1\n    return x\n", false, 0)
    return 20 if not check("struct Box:\n    value: mutable i64\n    other: mutable i64\ndef run(box: mutable Box&, x: i64) -> i64 changes box.value:\n    requires x + 1 > 0\n    box.value <- 1\n    return x\n", false, 0)
    return 21 if not check("struct Box:\n    value: mutable i64\n    other: mutable i64\ndef run(box: mutable Box&) -> void changes box.value:\n    requires box == box\n    box.value <- 1\n", false, 0)
    return 22 if not check("struct Box:\n    value: mutable i64\n    other: mutable i64\ndef run(box: mutable Box&, x: i64) -> void changes box.value:\n    ensure result == x\n    box.value <- 1\n", false, 0)
    return 23 if not check("struct Box:\n    value: mutable i64\n    other: mutable i64\ndef run(box: mutable Box&, x: i64) -> i64 changes box.value:\n    requires x >= 0\n    box.value <- 1\n    return x\ntype i64 = Box\n", false, 0)
    return 24 if not check("struct Box:\n    value: mutable i64\n    other: mutable i64\ndef run(box: mutable Box&, x: i64) -> i64 changes box.value:\n    requires x >= 0\n    box.value <- 1\n    return x\nimpl Eq for i64:\n    def __eq__(self: i64, other: i64) -> bool:\n        return true\n", false, 0)
    return 25 if not check("struct Box:\n    value: mutable i64\n    other: mutable i64\ndef run(counter: mutable usize&) -> bool:\n    changes counter\n    counter <- counter + 1\n    return counter > 0\n", true, 2)
    return 26 if not check("struct Box:\n    value: mutable i64\n    other: mutable i64\ndef run(counter: mutable usize&) -> usize:\n    changes counter\n    ensure result >= 1\n    counter <- counter + 1\n    return 1\n", true, 2)
    return 27 if not check("struct Box:\n    value: mutable i64\n    other: mutable i64\ndef run(box: mutable Box&) -> void changes box.value:\n    box.value <- box + 1\n", false, 0)
    return 28 if not check("struct Box:\n    value: mutable i64\n    other: mutable i64\ndef run(counter: mutable usize&) -> bool:\n    changes counter\n    counter <- counter + helper()\n    return counter > 0\n", false, 0)
    return 29 if not check("struct Box:\n    value: mutable i64\n    other: mutable i64\ndef run(counter: mutable usize&) -> bool:\n    changes counter\n    counter <- counter + 1\n    return counter > 0\nimpl Add for usize:\n    def __add__(self: usize, other: usize) -> usize:\n        return 0\n", false, 0)
    return 0
