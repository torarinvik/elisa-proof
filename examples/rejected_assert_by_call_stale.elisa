# The runtime guard of assert-by is still an expression evaluation and may mutate state.

struct Box:
    value: mutable i64

def set_value(box: mutable Box&) -> i64:
    changes box.value
    box.value <- 1
    return 1

def stale_assert_by_fact(box: mutable Box&) -> i64:
    requires box.value == 0
    changes box.value
    ensure result == 0
    assert set_value(box) == set_value(box) by:
    return box.value
