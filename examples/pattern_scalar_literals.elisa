# Character patterns retain their quote boundaries in the compiler AST and contribute exact
# scalar facts. String patterns remain unsupported because their AST text is not type-tagged.

def char_pattern(x: char) -> i64:
    ensure result >= 0
    match x:
        'A':
            assert x == 'A' by:
                assert x == 'A'
            return 0
        _:
            return 1
