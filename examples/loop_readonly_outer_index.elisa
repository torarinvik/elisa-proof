struct Binding:
    value: i64
struct Store:
    bindings: mutable Binding[4]
    flags: mutable bool[4]
def checked(store: mutable Store&, index: usize) -> void:
    return if index >= 4
    current: Binding = store.bindings[index]
    for other in 0..<4:
        existing: Binding = store.bindings[other]
        return if other != index and existing.value == current.value
    store.bindings[index] <- Binding{value: current.value}
    store.flags[index] <- false
