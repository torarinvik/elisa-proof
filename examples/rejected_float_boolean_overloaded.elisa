# Source overloads can make the same comparison expression effectful or state-dependent. They
# must be rejected before the propositional float fragment publishes branch facts.
protocol Eq:
    def __eq__(self: Self, other: Self) -> bool

impl Eq for f32:
    def __eq__(self: f32, other: f32) -> bool:
        return false

def rejected_float_boolean_overloaded(value: f32) -> bool:
    ensures result or value != value
    if value != value:
        return false
    true
