# The subtraction bound alone does not prevent the final sum from wrapping upward when
# `count` is negative. With total = 0, start = -1 and count = i64::MIN, the preconditions
# hold but start + count wraps to i64::MAX, falsifying the postcondition.
def negative_count_can_wrap_above_bound(total: i64, start: i64, count: i64) -> i64:
    requires start <= total
    requires count <= total - start
    ensure result <= total
    return start + count
