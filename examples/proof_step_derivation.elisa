# A proof step is derived from the current context, not accepted as an axiom.
const I64_MAX_BEFORE_INCREMENT: i64 = 9223372036854775806

def proof_step_derivation(x: i64) -> i64:
    requires x >= 0
    requires x <= I64_MAX_BEFORE_INCREMENT
    ensure result >= 1
    assert x + 1 >= 1 by:
        assert x + 1 >= 1
    return x + 1
