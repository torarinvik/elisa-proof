# False neighbours of monotone_orders.elisa; every one has a counterexample.
module RejectedMonotoneOrders:
    const STRIDE: u64 = 10000
    const DROP: u64 = 1000000

    # p = a = s reaches two strides.
    def untrue_strict_sum(p: u64, a: u64, s: u64) -> u64:
        requires p <= s and a <= s and s <= STRIDE
        ensure result < s + s
        p + a

    # An inclusive clamp at the stride: t = m = s reaches two strides.
    def untrue_clamped_sum(t: u64, m: u64, s: u64) -> u64:
        requires s >= 100 and s <= STRIDE
        ensure result < s + s
        p: u64 = t if t <= s else s
        a: u64 = m if m < s else s
        p + a

    # One operand may exceed its bound: p = s + 1, a = 0.
    def untrue_loose_operand(p: u64, a: u64, s: u64) -> u64:
        requires p <= s + 1 and a < s and s <= STRIDE
        ensure result < s + s
        p + a

    # part = whole gives exactly 750.
    def untrue_full_share(part: u64, whole: u64) -> u64:
        requires part <= whole and whole <= DROP and whole >= 1
        ensure result < 750
        part * 750 / whole

    # part = 999, whole = 1000 gives 699.
    def untrue_small_limit(part: u64, whole: u64) -> u64:
        requires part < whole and whole <= DROP
        ensure result < 600
        part * 700 / whole

    # A clamp at the bound is not strictly below it: t = s.
    def untrue_relational_clamp(t: u64, s: u64) -> u64:
        requires s <= STRIDE
        ensure result < s
        t if t <= s else s

    # part = 2 * whole - 1 passes the requires and reaches the double.
    def untrue_below_sum(part: u64, whole: u64) -> u64:
        requires part < whole + whole and whole <= DROP
        ensure result < whole
        part

    # A zero multiple is zero: part = 1, whole = 1.
    def untrue_zero_multiple(part: u64, whole: u64) -> u64:
        requires part <= whole and whole <= DROP
        ensure result <= 0 * whole
        part
