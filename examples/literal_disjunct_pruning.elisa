# A callee's disjunctive ensures instantiated with a literal flag or a repeated argument lose
# their literally decided alternatives before any case split, so adding true ensures to a callee
# never costs its callers a proof.
module Ramp:
    public:
        def weight(frame: i64, last: i64, looping: bool) -> i64:
            requires last >= 0
            requires last <= 1000
            requires frame >= 0
            requires frame <= last
            ensure result >= 0
            ensure result <= 1000
            ensure looping or frame != 0 or result == 0
            ensure looping or frame != last or result == 0
            ensure looping or frame > 0 or frame < 0 or result == 0
            ensure not looping or result == 1000
            ensure looping or frame >= frame
            return 1000 if looping
            return 0 if frame == 0 or frame == last
            return 500

module Laws:
    public:
        def last_is_unfaded(last: i64) -> i64:
            requires last >= 0
            requires last <= 1000
            ensure result == 0
            return Ramp::weight(last, last, false)

        def loop_is_full(frame: i64, last: i64) -> i64:
            requires last >= 0
            requires last <= 1000
            requires frame >= 0
            requires frame <= last
            ensure result == 1000
            return Ramp::weight(frame, last, true)
