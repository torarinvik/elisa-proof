# A call nested in an expression keeps a local's value only when no callee can reach the
# local. A copy of the loop binder lent to a callee that advances it must leave the next
# index unproven, whether the lend sits beside the index or in an earlier statement, and
# a field the callee writes must not keep the guard that held before the call.
module Tally:
    public:
        const SIZE: usize = 4

        struct Board:
            marks: bool[Tally::SIZE]
            cursor: mutable usize

        def advance(value: mutable usize&) -> bool:
            value <- value + 1
            true

        def shift(board: mutable Board&) -> bool:
            board.cursor <- board.cursor + 1
            true

        def rejected_lent_copy(board: Board&) -> usize:
            for slot in 0..<SIZE |best: usize = SIZE| -> best:
                probe: mutable usize = slot
                candidate: bool = advance(&probe) and board.marks[probe]
                best <- slot if candidate

        def rejected_lent_before(board: Board&) -> usize:
            for slot in 0..<SIZE |best: usize = SIZE| -> best:
                probe: mutable usize = slot
                moved: bool = advance(&probe)
                candidate: bool = moved and board.marks[probe]
                best <- slot if candidate

        def rejected_written_field(board: mutable Board&) -> bool:
            return false if board.cursor >= SIZE
            candidate: bool = shift(board) and board.marks[board.cursor]
            candidate
