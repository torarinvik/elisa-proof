# `length <= EPSILON` is false for NaN, so falling through does not establish
# `length > EPSILON`: trichotomy fails over IEEE values and the call must stay unproven.
module FloatTune:
    public:
        const EPSILON: f64 = 0.000001

def float_scale(x: f64, length: f64) -> f64:
    requires length > FloatTune::EPSILON
    return x / length

def float_normalize_le(x: f64, length: f64) -> f64:
    return 1.0 if length <= FloatTune::EPSILON
    return float_scale(x, length)
