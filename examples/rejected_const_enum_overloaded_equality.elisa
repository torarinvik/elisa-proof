# A const-enum shorthand remains subject to the source enum's Eq implementation. The proof
# runtime guard must not mistake `.On` for built-in equality merely because it is integer-backed.
const enum Mode of i64:
    Off = 0
    On = 1

protocol Eq:
    def __eq__(self: Self, other: Self) -> bool

impl Eq for Mode:
    def __eq__(self: Mode, other: Mode) -> bool:
        return false

def reject_overloaded_const_enum_equality(mode: Mode) -> bool:
    ensure result == (mode == .On)
    return mode == .On

def reject_const_enum_shorthand_contract() -> bool:
    ensure .On == .On
    return true
