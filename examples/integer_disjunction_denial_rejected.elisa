def integer_denial_false(code: u8) -> u8:
    ensure code > 3 or code < 3
    return 0

def integer_denial_float(code: f64) -> u8:
    ensure code <= 0 or code > 0
    return 0

struct FloatDenialRecord:
    code: f64

def integer_denial_float_field(record: FloatDenialRecord&) -> u8:
    ensure record.code <= 0 or record.code > 0
    return 0
