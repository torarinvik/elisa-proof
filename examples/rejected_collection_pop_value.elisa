# Each ensure overstates what a value-position pop gives.
def wrong_value(v: mutable darray[u32]&) -> u32:
    ensures result == 9
    x: u32 = v.pop()
    return x

def first_not_last(v: mutable darray[u32]&) -> u32:
    requires v.count >= 2 and v[0] == 4
    ensures result == 4
    x: u32 = v.pop()
    return x

def slot_still_there(v: mutable darray[u32]&) -> u32:
    requires v.count >= 1 and v[v.count - 1] == 9
    ensures v[v.count] == 9
    x: u32 = v.pop()
    return x

def count_kept(v: mutable darray[u32]&) -> u32:
    ensures v.count == old(v.count)
    x: u32 = v.pop()
    return x

def shrink_past_guard(v: mutable darray[u32]&) -> u32:
    requires v.count >= 2
    ensures v.count == old(v.count) - 3 and result == 1
    v.pop()
    v.pop()
    return 1
