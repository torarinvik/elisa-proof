lemma nonnegative(x: i64):
    requires x >= 0
    ensure x >= 0

def use_lemma(x: i64) -> void:
    requires x >= 0
    assert x >= 0 by:
        nonnegative(x)

lemma named_nonnegative(first: i64, second: i64):
    requires first >= 0
    requires second == 7
    ensure second == 7

def use_named_lemma(x: i64) -> void:
    requires x >= 0
    assert 7 == 7 by:
        named_nonnegative(second: 7, first: x)
        assert 7 == 7
