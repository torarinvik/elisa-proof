# The loop condition is a fact about what the condition tests and nothing else: a bound on the
# counter says nothing about the collection.
def unrelated_condition_proves_no_bound(values: darray[i64]&) -> i64:
    requires values.count > 3
    total: mutable i64 = 0
    index: mutable usize = 0
    while index < 100 |index, total, values|:
        total <- total + values[index]
        index <- index + 1
    return total

def shrink(target: mutable darray[i64]&) -> void:
    target.resize(0)

# A mutable borrow is writable, so a callee may resize it and its count is not stable across a
# call. Only a shared borrow earns that.
def mutable_extent_must_not_survive_a_call(values: mutable darray[i64]&, index: usize) -> i64:
    requires index < values.count
    shrink(values)
    return values[index]

def callee(x: i64) -> i64:
    requires x < 10
    ensure result == x
    return x

# The body is checked from an opaque entry state, so the *initial* value of a binding the loop
# rewrites must not be usable inside it.
def entry_value_must_not_reach_the_body(count: i64) -> i64:
    total: mutable i64 = 0
    step: mutable i64 = 0
    while step < count |step, total, count|:
        total <- total + callee(step)
        step <- step + 1
    return total
