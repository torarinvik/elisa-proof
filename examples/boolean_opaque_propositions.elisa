# Boolean-valued opaque roots remain legitimate propositions under the compiler-derived source
# type environment: a parameter, a field, an index, and a verified call.
struct BooleanValues:
    enabled: bool

struct NamedValue:
    value: usize

def boolean_value() -> bool:
    ensure true
    return true

def abstract_boolean_parameter(flag: bool) -> bool:
    requires flag
    ensure flag
    return flag

def boolean_field(value: BooleanValues&) -> bool:
    requires value.enabled
    ensure value.enabled
    return value.enabled

def boolean_index(values: darray[bool]&) -> bool:
    requires values.count > 0
    requires values[0]
    ensure values[0]
    return true

def boolean_call() -> bool:
    requires boolean_value()
    ensure boolean_value()
    assert boolean_value()
    return boolean_value()

def named_container_boolean_call(values: darray[NamedValue]&, index: usize) -> bool:
    requires index < values.count
    requires named_container_has_value(values, index)
    ensure named_container_has_value(values, index)
    return named_container_has_value(values, index)

def named_container_has_value(values: darray[NamedValue]&, index: usize) -> bool:
    return index < values.count

def mixed_integer_width_comparison(left: u8, right: i64) -> bool:
    requires left == right
    ensure left == right
    return true
