module RejectedVariableDivisorBounds:
    public:
        # A negative dividend gives a negative remainder.
        def wrap(frame: i64, count: i64) -> i64:
            requires count >= 1
            requires count <= 10000000
            requires frame >= -5
            requires frame <= 30000000
            ensure result >= 0
            return frame % count

        # The remainder reaches `count - 1`, not only `count - 2`.
        def tight(frame: i64, count: i64) -> i64:
            requires count >= 2
            requires count <= 10000000
            requires frame >= 0
            requires frame <= 30000000
            ensure result < count - 1
            return frame % count

        # Without `d <= e` the ratio exceeds the scale.
        def part(d: i64, e: i64) -> i64:
            requires e >= 1
            requires e <= 100000
            requires d >= 0
            requires d <= 100000
            ensure result <= 1000
            return d * 1000 / e
