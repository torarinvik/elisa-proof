# Refinement aliases as reusable contracts. A refined parameter is assumed like a `requires`, a
# refined return is proved like an `ensure` over `result`, and nested aliases compose.
type Permille = i64 where self >= 0 and self <= 1000
type Weight = Permille where self > 0

def clamp_permille(x: i64) -> Permille:
    return 0 if x < 0
    return 1000 if x > 1000
    return x

def permille_upper(w: Permille) -> i64:
    ensure result <= 1000
    ensure result >= 0
    return w

def weight_positive(w: Weight) -> i64:
    ensure result >= 1
    ensure result <= 1000
    return w

def blend(raw: i64) -> i64:
    ensure result <= 1000
    return permille_upper(clamp_permille(raw))

def complement(w: Permille) -> Permille:
    return 1000 - w
