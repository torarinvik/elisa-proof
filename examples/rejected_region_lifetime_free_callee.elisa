# The boundary. The lend admission rests on the callee being unable to keep what it is lent, so a
# callee that returns a reference is not admitted from its declared modes, and two overlapping
# mutable actuals are refused whatever path admits the call.
struct Cell:
    value: mutable i64

def returns_a_reference(cell: Cell&) -> Cell&:
    return cell

def a_lifetime_free_callee_may_not_return_a_reference[@r](cell: Cell& @r) -> i64:
    holder: Cell& = returns_a_reference(cell)
    return holder.value

def two_arguments(a: mutable Cell&, b: mutable Cell&) -> void:
    changes a.value
    changes b.value
    a.value <- 1
    b.value <- 2

def overlapping_mutable_actuals[@r](cell: mutable Cell& @r) -> i64:
    changes cell
    two_arguments(cell, cell)
    return cell.value
