# `x: T = v.pop()` binds the last element and removes it (BACKLOG W-04, value position).
def take_last(v: mutable darray[u32]&) -> u32:
    requires v.count >= 1 and v[v.count - 1] == 9
    ensures result == 9 and v.count == old(v.count) - 1
    x: u32 = v.pop()
    return x

def take_two(v: mutable darray[u32]&) -> u32:
    requires v.count >= 2 and v[v.count - 1] == 5
    ensures result == 5 and v.count == old(v.count) - 2
    x: u32 = v.pop()
    v.pop()
    return x

def take_keeps_prefix(v: mutable darray[u32]&) -> u32:
    requires v.count >= 2 and v[0] == 4
    ensures v[0] == 4
    x: u32 = v.pop()
    return x

# An `old(v.count)` snapshot already names the count; the requires must still be restated
# over it, or `old(v.count) - 2` has no guard once the pops forget `v`.
def shrink_conjunct(v: mutable darray[u32]&) -> u32:
    requires v.count >= 2
    ensures v.count == old(v.count) - 2 and result == 1
    v.pop()
    v.pop()
    return 1
