include "../build/snapshot/Elisa-compiler/elisacore_std/elisacore_runtime.elisa"
include "../build/snapshot/Elisa-compiler/src/parser/parser.elisa"
using Ast
include "../src/proof/kernel_core.elisa"
using ElisaProofKernelCore
include "../src/proof/kernel_replay/frame_policy_model.elisa"
include "../src/proof/kernel_replay/frame_policy_places.elisa"
include "../src/proof/replay/frame_source_places.elisa"
include "../src/proof/replay/frame_source_owners.elisa"
include "../src/proof/replay/frame_source_writes.elisa"

def check_write(source: u8&, expected: bool) -> bool can[Memory.Allocate, Abort.Panic]:
    tokens: darray[Token] = frontend_tokenize(source, source)
    file: Ast::File = frontend_parser_parse_file(source, tokens)
    return false if file.errors.count != 0
    context = ElisaProofFrameSource::owner(&file.top_decls, "run", 1)
    return false if not context.known
    for statement in context.body |file, expected|:
        match statement:
            Ast::Stmt.Assign(_, operator, _, position):
                if operator != TokenKind.Assign:
                    found = ElisaProofFrameSource::direct_write(&file.top_decls, "run", 1, position)
                    return false if found.known != expected
                    if expected:
                        return false if found.place.parameter != 1 or found.place.depth != 1 or found.place.field != "value"
                    field: ProofKernelNode = ProofKernelNode{kind: "frame-field", operator: "", left: 0, right: 0, auxiliary: 0, children_start: 0, children_count: 0, value: 0, name: "value", secondary_name: ""}
                    target: ProofKernelNode = ProofKernelNode{kind: "frame-place", operator: "frame-place-v1", left: 0, right: 0, auxiliary: 1, children_start: 0, children_count: 1, value: 0, name: "", secondary_name: ""}
                    goal: ProofKernelNode = ProofKernelNode{kind: "frame-policy", operator: "write", left: 1, right: 0, auxiliary: 2, children_start: 0, children_count: 0, value: 0, name: "run", secondary_name: "frame-policy-v1"}
                    nodes: mutable darray[ProofKernelNode] = [field, target, goal]
                    children: darray[usize] = [0]
                    return false if ElisaProofFrameSource::direct_write_matches(&file.top_decls, "run", 1, position, &nodes, &children, 2) != expected
                    nodes[1].auxiliary <- 0
                    return false if ElisaProofFrameSource::direct_write_matches(&file.top_decls, "run", 1, position, &nodes, &children, 2)
                    forged: Ast::Pos = Ast::Pos{line: position.line, column: position.column + 1, offset: position.offset, end_line: position.end_line, end_column: position.end_column, end_offset: position.end_offset}
                    return false if ElisaProofFrameSource::direct_write(&file.top_decls, "run", 1, forged).known
                    return false if ElisaProofFrameSource::direct_write(&file.top_decls, "other", 1, position).known
                    return true
            _:
                pass
    return false

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    return 1 if not check_write("def run(other: u8, box: u8) -> void:\n    box.value <- 1\n", true)
    return 2 if not check_write("def run(other: u8, box: u8) -> void:\n    foreign_box.value <- 1\n", false)
    return 3 if not check_write("def run(other: u8, box: u8) -> void:\n    box: mutable u8 = 0\n    box.value <- 1\n", false)
    return 4 if not check_write("def run(other: u8, box: u8) -> void:\n    box = 0\n    box.value <- 1\n", false)
    return 5 if not check_write("def run(other: u8, box: u8) -> void:\n    box[0].value <- 1\n", false)
    return 6 if not check_write("def run(other: u8, box: u8) -> void:\n    box.value += 1\n", true)
    return 7 if not check_write("def run(other: u8, box: u8) -> void:\n    box.value -= 1\n", true)
    return 8 if not check_write("def run(other: u8, box: u8) -> void:\n    box.value *= 1\n", true)
    return 9 if not check_write("def run(other: u8, box: u8) -> void:\n    box.value /= 1\n", true)
    return 10 if not check_write("def run(other: u8, box: u8) -> void:\n    box.value %= 1\n", true)
    return 11 if not check_write("def run(other: u8, box: u8) -> void:\n    box.value ^= 1\n", true)
    return 12 if not check_write("def run(other: u8, box: u8) -> void:\n    box.value |= 1\n", true)
    return 13 if not check_write("def run(other: u8, box: u8) -> void:\n    box.value &= 1\n", true)
    return 14 if not check_write("def run(other: u8, box: u8) -> void:\n    box.value <<= 1\n", true)
    return 15 if not check_write("def run(other: u8, box: u8) -> void:\n    box.value >>= 1\n", true)
    return 16 if not check_write("def run(other: u8, box: u8) -> void:\n    box.value ?= 1\n", true)
    return 0
