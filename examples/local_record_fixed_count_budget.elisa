struct Item:
    value: i64
struct Store:
    count: mutable usize
    flags: mutable Item[3]
def make() -> Store:
    Store{flags: zeroed, count: 0}
struct Noise:
    f0: i64
    f1: i64
    f2: i64
    f3: i64
    f4: i64
    f5: i64
    f6: i64
    f7: i64
    f8: i64
    f9: i64
    f10: i64
    f11: i64
    f12: i64
    f13: i64
    f14: i64
    f15: i64
def checked(noise: Noise&) -> void:
    store: mutable Store = make()
    for index in 0..<3 |store|:
        store.count <- index.usize()
        slot: usize = store.count
        return if slot >= 3
        store.flags[slot] <- Item{value: 1}
