# Adversarial companion to `effect_containment.elisa`. A declared effect row is only evidence
# when every direct call resolves to a declared callee whose row it contains. None of these
# functions may emit an effect certificate.

def allocates(size: i64) -> i64 can[Memory.Allocate]:
    return size

def panics(value: i64) -> i64 can[Abort.Panic]:
    return value

# The callee needs an effect the caller does not declare.
def narrower_than_callee(size: i64) -> i64 can[Abort.Panic]:
    return allocates(size)

# One covered callee does not excuse an uncovered one.
def one_uncovered_callee(size: i64) -> i64 can[Abort.Panic]:
    checked: i64 = panics(size)
    return allocates(size)

# A callee outside the file has no imported row, so containment cannot be established.
extern host_allocate(size: i64) -> i64

def opaque_callee(size: i64) -> i64 can[Memory.Allocate]:
    return host_allocate(size)
