# The boundary of guarded differences. An unsigned sum in a fact is modular, so
# `stop == start + 4` or `start + 4 <= stop` says nothing about `start` on its own; a
# difference without its order guard may have wrapped; and a true bound is still needed.
module RejectedGuardedDifferences:
    public:
        const CAP: usize = 16

        struct Text:
            bytes: mutable u8[RejectedGuardedDifferences::CAP]
            length: mutable usize

        # `start` may be `usize.max - 3`, where `start + 4` wraps to 0.
        def modular_sum_fact(start: usize, stop: usize, n: usize) -> bool:
            requires stop <= n and n <= 16
            requires stop == start + 4
            ensure start < 16
            true

        def modular_sum_bound(text: Text&, start: usize, stop: usize) -> bool:
            requires stop <= text.length and text.length <= CAP
            requires start + 4 <= stop
            text.bytes[start] == 1

        # Without `start <= stop`, `stop - start == 4` holds for `stop == 0` and a huge `start`.
        def unguarded_difference(start: usize, stop: usize) -> bool:
            requires stop - start == 4
            requires stop <= 16
            ensure start < 16
            true

        # The guard admits the difference, but `start + 4` reaches `stop`, which may be 16.
        def one_past_the_span(start: usize, stop: usize) -> bool:
            requires start <= stop
            requires stop - start == 4
            requires stop <= 16
            ensure start + 4 < 16
            true

        # The same through a field: `start + 4` is `stop`, which may equal the capacity.
        def one_past_in_text(text: Text&, start: usize, stop: usize) -> bool:
            requires start <= stop and stop <= text.length and text.length <= CAP
            stop - start == 4 and text.bytes[start + 4] == 1
