# Closed literal multi-indexes are tracked component-by-component. Distinct coordinates may
# coexist even when they share the same outer collection root.
def borrow_multi_indexed_places(values: mutable array[array[i64, 2], 2]) -> i64:
    first: i64& = &values[0, 0]
    second: mutable i64& = &values[1, 1]
    return values[0, 0]
