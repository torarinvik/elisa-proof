# A region-polymorphic allocator. `new[r]` allocates into the caller's region
# selected by `@r`; the reference is returned with the same lifetime parameter.
def make[@r](owner: i64& @r, value: i64) -> i64& @r:
    return new[r] value

def main() -> i64:
    region scratch(1024)
    seed: i64& @scratch = new[scratch] 0
    value: i64& @scratch = make(seed, 7)
    destroy scratch
    return 7
