# A call result bounded by an earlier call result: `lift(y, lift(x, floor))`. The facts name
# the inner call before the outer one, so generalizing the inner call first must also rewrite
# the outer call it sits inside, or the outer call is never generalized and the chain through
# it never closes.

def lift(x: i64, floor: i64) -> i64:
    ensure result >= floor
    return floor if x < floor else x

def chained(x: i64, y: i64, floor: i64) -> i64:
    ensure result >= floor
    l: i64 = lift(x, floor)
    r: i64 = lift(y, l)
    return r

def chained_max(x: i64, y: i64, v: i64, floor: i64) -> i64:
    ensure result >= floor
    l: i64 = lift(x, floor)
    r: i64 = lift(y, l)
    return v if v > r
    return r

def three_deep(x: i64, y: i64, z: i64, v: i64, floor: i64) -> i64:
    ensure result >= floor
    a: i64 = lift(x, floor)
    b: i64 = lift(y, a)
    c: i64 = lift(z, b)
    return v if v >= c
    return c

def outer_first(x: i64, y: i64, floor: i64) -> bool:
    ensure result
    return lift(y, lift(x, floor)) >= floor
