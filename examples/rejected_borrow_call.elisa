# A callee with an unbounded/dynamic borrow has no resource certificate, and it does not need one
# to be lent a capability the caller already holds: a shared lend changes nothing, and an exclusive
# lend can do no more than write the whole lent place. Both calls are therefore admitted from the
# declared parameter modes alone. What must *not* follow is any claim about the callee itself: its
# own indexed obligation still fails on its own account, and both callers are reported as depending
# on an unverified summary.
def opaque_dynamic_borrow(values: darray[i64]&) -> i64:
    index: usize = 0
    view: i64& = &values[index]
    return 0

def opaque_dynamic_write(values: mutable darray[i64]&) -> i64:
    index: usize = 0
    values[index] <- 1
    return 0

def rejected_borrow_call(values: darray[i64]) -> i64:
    result: i64 = opaque_dynamic_borrow(&values)
    return result

def rejected_writable_borrow_call(values: mutable darray[i64]) -> i64:
    result: i64 = opaque_dynamic_write(&values)
    return result
