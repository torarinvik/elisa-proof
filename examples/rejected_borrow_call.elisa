# A callee with an unbounded/dynamic borrow has no resource certificate. Lending it a *writable*
# capability must remain unsupported until a more expressive indexed-place summary exists: without
# the callee's trace the caller cannot know what it wrote. Lending a shared reference is a
# different claim — the callee cannot write through it or move out of it — so that call is
# admitted from the declared parameter mode alone while the callee's own indexed obligation still
# fails on its own account.
def opaque_dynamic_borrow(values: darray[i64]&) -> i64:
    index: usize = 0
    view: i64& = &values[index]
    return 0

def opaque_dynamic_write(values: mutable darray[i64]&) -> i64:
    index: usize = 0
    values[index] <- 1
    return 0

def rejected_borrow_call(values: darray[i64]) -> i64:
    result: i64 = opaque_dynamic_borrow(&values)
    return result

def rejected_writable_borrow_call(values: mutable darray[i64]) -> i64:
    result: i64 = opaque_dynamic_write(&values)
    return result
