# A callee with an unbounded/dynamic borrow has no resource certificate. Passing a live borrow to
# it must remain unsupported until a more expressive indexed-place summary exists.
def opaque_dynamic_borrow(values: darray[i64]&) -> i64:
    index: usize = 0
    view: i64& = &values[index]
    return 0

def rejected_borrow_call(values: darray[i64]) -> i64:
    result: i64 = opaque_dynamic_borrow(&values)
    return result
