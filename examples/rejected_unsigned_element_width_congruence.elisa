# Scalar element witnesses must carry their unsigned width through indexed-place congruence.
def rejected_unsigned_element_width_congruence(bytes: darray[u8], words: darray[u16], index: usize) -> void:
    requires index < bytes.count
    requires index < words.count
    requires bytes[index] == words[index]
    requires bytes[index] == 255
    ensure bytes[index] + 1 == words[index] + 1
    return

def main() -> u8:
    return 0
