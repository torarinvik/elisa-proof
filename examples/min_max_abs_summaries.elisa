def min_i64(a: i64, b: i64) -> i64:
    ensure result <= a
    ensure result <= b
    ensure result == a or result == b
    return a if a <= b else b

def max_i64(a: i64, b: i64) -> i64:
    ensure result >= a
    ensure result >= b
    ensure result == a or result == b
    return a if a >= b else b

def abs_i32(x: i32) -> i64:
    ensure result >= 0
    ensure result <= 2147483648
    wide: i64 = x.i64()
    return -wide if wide < 0 else wide

def abs_small(x: i64) -> i64:
    requires x >= -1000 and x <= 1000
    ensure result >= 0
    ensure result == x or result == -x
    return -x if x < 0 else x

def clamp(x: i64) -> i64:
    ensure result <= 100
    ensure result >= 0
    return max_i64(0, min_i64(x, 100))

def pick_smaller(i: usize, j: usize, n: usize) -> usize:
    requires i < n
    ensure result < n
    return i if i <= j else j
