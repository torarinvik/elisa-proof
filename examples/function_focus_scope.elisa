def function_focus_scope_valid(value: i64) -> i64:
    ensure result == value
    return value

def function_focus_scope_unsupported(pointer: mutable heap void&?) -> u8:
    ensure pointer < null or result == 0
    return 0

def function_focus_scope_dependent(pointer: mutable heap void&?) -> u8:
    ensure result == 0
    return function_focus_scope_unsupported(pointer)
