# Resource-bearing expressions inside an expression-position catch are checked through the callee
# summary. This negative case returns a reference from a borrow-carrying call; result provenance
# is intentionally conservative until reference-return summaries identify the exact source.
error BorrowCatchError:
    Bad

def borrow_catch_source(value: i64&) -> i64& error[BorrowCatchError]:
    return value

def rejected_borrow_nested_catch(x: mutable i64) -> i64&:
    view: i64& = &x
    return catch borrow_catch_source(view):
        value:
            value
        BorrowCatchError.Bad:
            x
