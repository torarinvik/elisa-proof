# Loops that carry `invariant` and `decreases` clauses compile, link and run, and their invariants
# prove (BACKLOG E-03). scripts/test_loop_invariants_compile.py builds this file with the pinned
# stage1 compiler, runs it, and then mutates each invariant in turn to check that the proof notices.

# A while loop with a counter bounded by a parameter.
def bounded_counter(limit: usize) -> usize:
    ensure result <= limit
    rounds: mutable usize = 0
    while rounds < limit |rounds, limit|:
        invariant rounds <= limit
        rounds <- rounds + 1
    return rounds

# A countdown with a variant.
def countdown(x: i64) -> i64:
    requires x >= 0
    ensure result >= 0
    value: mutable i64 = x
    while value > 0:
        invariant value >= 0
        decreases value
        value <- value - 1
    return value

# A for loop whose invariant carries a bounded total across the iteration join.
def count_up(n: i64) -> i64:
    requires n >= 0
    ensure result >= 0
    total: mutable i64 = 0
    for index in 0..<n |total|:
        invariant total >= 0
        total <- 1
    return total

# A break leaves the loop with only the invariant, not the negated condition.
def stop_early(n: i64) -> i64:
    requires n >= 0
    ensure result >= 0
    x: i64 = 0
    while x < n:
        invariant x >= 0
        break
    return x

def main() -> i64:
    return 1 if bounded_counter(5) != 5
    return 2 if countdown(7) != 0
    return 3 if count_up(4) != 1
    return 4 if stop_early(3) != 0
    return 0
