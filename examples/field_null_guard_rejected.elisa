struct FieldNullGuardRejected:
    first: mutable heap void&?

def field_null_guard_wrong_branch(store: FieldNullGuardRejected&) -> u8:
    ensure store.first != null or result == 0
    return 1 if store.first == null
    return 0

def field_null_guard_stale_write(store: mutable FieldNullGuardRejected&) -> u8:
    ensure store.first != null or result == 0
    return 0 if store.first == null
    store.first <- null
    return 1
