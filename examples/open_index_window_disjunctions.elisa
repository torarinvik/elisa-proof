def index_window_with_row_disjunctions(rows: array[usize, 8]&, cursor: i64) -> i64:
    requires cursor >= 0 and cursor < 8
    requires 3 >= cursor
    requires not (3 >= cursor + 1)
    requires 0 >= cursor or rows[0] == 64
    requires 1 >= cursor or rows[1] == 64
    requires 2 >= cursor or rows[2] == 64
    requires 3 >= cursor or rows[3] == 64
    requires 4 >= cursor or rows[4] == 64
    requires 5 >= cursor or rows[5] == 64
    requires 6 >= cursor or rows[6] == 64
    requires 7 >= cursor or rows[7] == 64
    ensure cursor == 3
    return cursor

# Read transport must not consume case splits on unrelated row premises.
def indexed_read_with_row_disjunctions(rows: array[usize, 8]&, cursor: i64) -> i64:
    requires cursor >= 0 and cursor < 8
    requires 3 >= cursor
    requires not (3 >= cursor + 1)
    requires rows[cursor] == 64
    requires 0 >= cursor or rows[0] == 64
    requires 1 >= cursor or rows[1] == 64
    requires 2 >= cursor or rows[2] == 64
    requires 3 >= cursor or rows[3] == 64
    requires 4 >= cursor or rows[4] == 64
    requires 5 >= cursor or rows[5] == 64
    requires 6 >= cursor or rows[6] == 64
    requires 7 >= cursor or rows[7] == 64
    ensure rows[3] == 64
    return 0
