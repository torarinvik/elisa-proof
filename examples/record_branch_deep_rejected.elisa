struct RecordDeepChild:
    value: mutable u8

struct RecordDeepState:
    child: RecordDeepChild&
    value: mutable u8

def record_branch_deep(state: mutable RecordDeepState&, node: mutable RecordDeepChild&, choose: bool) -> u8:
    ensure state.child.value == old(state.child.value)
    if choose:
        state.value <- 1
        node.value <- 2
    else:
        state.value <- 3
        node.value <- 4
    return 0
