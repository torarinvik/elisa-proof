# Shared reduced report model for standalone source-inventory mutation harnesses.
include "../../Elisa-compiler/src/parser/parser_tokens.elisa"
include "../../Elisa-compiler/src/parser/ast_nodes.elisa"
module ElisaProof:
    public:
        struct ProofFinding:
            kind: sview

        struct ProofDeclarationSummary:
            kind: sview
            name: mutable sview
            line: mutable u32
            verification_reason: sview

        struct ProofGoalAttempt:
            goal: Ast::Expr
            budget_exhausted: mutable bool
            facts_start: usize
            facts_count: usize
            kernel_goal: usize
            kernel_facts_start: usize
            kernel_facts_count: usize
            line: u32
            name: sview
            rule: sview
            proven: bool
            has_certificate: bool
            certificate_index: usize

        struct ProofGoalCertificate:
            goal: Ast::Expr
            facts_start: usize
            facts_count: usize
            kernel_goal: usize
            kernel_facts_start: usize
            kernel_facts_count: usize
            line: u32
            name: sview
            rule: sview
            replayed: mutable bool

        struct ProofTheoremSummary:
            name: sview
            line: u32

        struct ProofObligationEntry:
            identity: usize
            attempts_start: usize
            attempts_count: usize
            proven: bool
            source_line: mutable u32
            source_name: mutable sview
            source_kind: mutable sview
            source_obligation_index: mutable usize

        struct ProofTheoremStore:
            summaries: mutable darray[ProofTheoremSummary]

        struct ProofReport:
            declarations: mutable u32
            obligations: mutable u32
            proven: mutable u32
            failed: mutable u32
            findings: mutable darray[ProofFinding]
            source_declarations: mutable darray[Ast::Decl]
            declaration_details: mutable darray[ProofDeclarationSummary]
            goal_attempts: mutable darray[ProofGoalAttempt]
            obligation_inventory: mutable darray[ProofObligationEntry]
            current_source_postcondition_count: mutable usize
            current_source_postcondition_line: mutable u32
            current_source_postcondition_name: mutable sview
            focused_function: mutable sview
            certificates: mutable darray[ProofGoalCertificate]
            theorems: ProofTheoremStore

include "../src/proof/model/report_invariants.elisa"
