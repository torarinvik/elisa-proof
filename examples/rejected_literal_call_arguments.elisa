# Controls for literal call arguments: a literal outside the callee's precondition, and a
# summary read at the wrong value. Binding the literal must not widen what the call proves.
module Clamp:
    public:
        const LIMIT: i64 = 1000000000

        def keep(value: i64, limit: i64) -> i64:
            requires value >= -LIMIT
            requires value <= LIMIT
            requires limit >= 0
            requires limit <= LIMIT
            ensure value > limit or result == value
            return value if value <= limit else limit

        def outside(limit: i64) -> i64:
            requires limit >= 0
            requires limit <= LIMIT
            return Clamp::keep(-2000000000, limit)

        def wrong_value(limit: i64) -> i64:
            requires limit >= 0
            requires limit <= LIMIT
            ensure result == 1
            return Clamp::keep(0, limit)
