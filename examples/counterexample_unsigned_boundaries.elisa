module Limits:
    const BYTE_EDGE: u8 = 254
    const DELAY_EDGE: u32 = 86400000

    def byte_boundary(value: u8) -> u8:
        ensure value <= Limits::BYTE_EDGE or result == 1
        return 0

    def delay_boundary(value: u32) -> u8:
        ensure value <= Limits::DELAY_EDGE or result == 1
        return 0

    def byte_domain_ceiling(value: u8) -> u8:
        ensure value <= 255
        return 0
