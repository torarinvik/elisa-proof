const TYPE_ENV_TEST_BINDING_INSERTION_FAILURE: i64 = 1
const TYPE_ENV_TEST_BASE_FORMATION_FAILURE: i64 = 2
const TYPE_ENV_TEST_AMBIGUOUS_BINDING_INSERTION_FAILURE: i64 = 3
const TYPE_ENV_TEST_AMBIGUOUS_NAME_ACCEPTED: i64 = 4
const TYPE_ENV_TEST_MALFORMED_BINDING_INSERTION_FAILURE: i64 = 5
const TYPE_ENV_TEST_MALFORMED_BINDING_ACCEPTED: i64 = 6
const TYPE_ENV_TEST_REUSED_WORKSPACE_VALID_REJECTED: i64 = 7
const TYPE_ENV_TEST_REUSED_WORKSPACE_CYCLE_ACCEPTED: i64 = 8
const TYPE_ENV_TEST_REUSED_WORKSPACE_RECOVERY_REJECTED: i64 = 9
const TYPE_ENV_TEST_SHARED_DAG_SMALL_REJECTED: i64 = 10
const TYPE_ENV_TEST_SHARED_DAG_LARGE_ACCEPTED: i64 = 11
const TYPE_ENV_TEST_SHARED_DAG_FACT_REJECTED: i64 = 12
const TYPE_ENV_SHARED_DAG_LEVEL_COUNT: usize = 23
const TYPE_ENV_SHARED_DAG_SMALL_ROOT_LEVEL: usize = 8
const TYPE_ENV_SHARED_DAG_REPEATED_ROOT_LEVEL: usize = 21

def split_type_environment_tests() -> i64 can[Memory.Allocate, Abort.Panic]:
    # Source obligations share immutable declaration signatures. Local values and quantifier
    # binders are searched together with them without copying the global signature array.
    global_bindings: mutable darray[ProofKernelTypingBinding] = []
    local_bindings: mutable darray[ProofKernelTypingBinding] = []
    global_flag_added: bool = proof_kernel_add_typing_binding(&global_bindings, "value", "global_flag", "", "boolean", "bool", "", "")
    local_count_added: bool = proof_kernel_add_typing_binding(&local_bindings, "value", "local_count", "", "integer", "i64", "", "")
    return TYPE_ENV_TEST_BINDING_INSERTION_FAILURE if not global_flag_added or not local_count_added
    environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: global_bindings, bindings: local_bindings}

    nodes: mutable darray[ProofKernelNode] = []
    children: mutable darray[usize] = []
    global_flag: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "global_flag", "")
    true_value: usize = add_node(&nodes, "bool", "", 0, 0, 0, 0, 0, 1, "", "")
    global_fact: usize = add_node(&nodes, "binary", "==", global_flag, true_value, 0, 0, 0, 0, "", "")
    local_count: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "local_count", "")
    quantified_value: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "item", "")
    local_relation: usize = add_node(&nodes, "binary", ">=", local_count, quantified_value, 0, 0, 0, 0, "", "")
    quantified_body: usize = add_node(&nodes, "binary", "and", global_fact, local_relation, 0, 0, 0, 0, "", "")
    range_value: usize = add_node(&nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
    children.push(range_value)
    range_set: usize = add_node(&nodes, "set", "", 0, 0, 0, 0, 1, 0, "", "")
    quantified_goal: usize = add_node(&nodes, "quantifier", "forall", range_set, quantified_body, 1, 0, 0, 0, "item", "")
    return TYPE_ENV_TEST_BASE_FORMATION_FAILURE if not proof_kernel_replay_proposition_formation_report(&nodes, &children, environment, [], quantified_goal)

    # A reusable admission workspace is scratch, never cached authority. Exercise it with a
    # valid arena, a smaller cyclic arena that exits early, then the original valid arena again.
    validation_workspace: mutable ProofKernelReplayValidationWorkspace = proof_kernel_replay_validation_workspace_new()
    workspace_valid: bool = proof_kernel_replay_proposition_formation_report_with_workspace(&nodes, &children, environment, [], quantified_goal, &validation_workspace)
    return TYPE_ENV_TEST_REUSED_WORKSPACE_VALID_REJECTED if not workspace_valid
    cycle_nodes: mutable darray[ProofKernelNode] = []
    cycle_children: mutable darray[usize] = []
    cycle_root: usize = add_node(&cycle_nodes, "unary", "not", 0, 0, 0, 0, 0, 0, "", "")
    workspace_cycle: bool = proof_kernel_replay_proposition_formation_report_with_workspace(&cycle_nodes, &cycle_children, environment, [], cycle_root, &validation_workspace)
    return TYPE_ENV_TEST_REUSED_WORKSPACE_CYCLE_ACCEPTED if workspace_cycle
    workspace_recovered: bool = proof_kernel_replay_proposition_formation_report_with_workspace(&nodes, &children, environment, [], quantified_goal, &validation_workspace)
    return TYPE_ENV_TEST_REUSED_WORKSPACE_RECOVERY_REJECTED if not workspace_recovered

    # Shared binary children form a small DAG but expand exponentially in recursive typing.
    # Ordinary sharing must remain admissible; excessive path work must fail closed.
    shared_nodes: mutable darray[ProofKernelNode] = []
    shared_children: mutable darray[usize] = []
    shared_leaf: usize = add_node(&shared_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
    shared_current: mutable usize = shared_leaf
    shared_small_root: mutable usize = shared_leaf
    shared_repeated_root: mutable usize = shared_leaf
    for level in 0..<TYPE_ENV_SHARED_DAG_LEVEL_COUNT |level, shared_nodes, shared_current, shared_small_root, shared_repeated_root|:
        shared_small_root <- shared_current if level == TYPE_ENV_SHARED_DAG_SMALL_ROOT_LEVEL
        shared_current <- add_node(&shared_nodes, "binary", "+", shared_current, shared_current, 0, 0, 0, 0, "", "")
        shared_repeated_root <- shared_current if level == TYPE_ENV_SHARED_DAG_REPEATED_ROOT_LEVEL
    shared_zero: usize = add_node(&shared_nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
    small_shared_goal: usize = add_node(&shared_nodes, "binary", "==", shared_small_root, shared_zero, 0, 0, 0, 0, "", "")
    shared_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: []}
    return TYPE_ENV_TEST_SHARED_DAG_SMALL_REJECTED if not proof_kernel_replay_proposition_formation_report(&shared_nodes, &shared_children, shared_environment, [], small_shared_goal)
    large_shared_goal: usize = add_node(&shared_nodes, "binary", "==", shared_current, shared_zero, 0, 0, 0, 0, "", "")
    return TYPE_ENV_TEST_SHARED_DAG_LARGE_ACCEPTED if proof_kernel_replay_proposition_formation_report(&shared_nodes, &shared_children, shared_environment, [], large_shared_goal)
    repeated_shared_goal: usize = add_node(&shared_nodes, "binary", "==", shared_repeated_root, shared_zero, 0, 0, 0, 0, "", "")
    repeated_shared_facts: mutable darray[usize] = []
    repeated_shared_facts.push(repeated_shared_goal)
    return TYPE_ENV_TEST_SHARED_DAG_FACT_REJECTED if proof_kernel_replay_proposition_formation_report(&shared_nodes, &shared_children, shared_environment, repeated_shared_facts, repeated_shared_goal)

    # Duplicates across the two segments retain the old conservative ambiguity rejection.
    ambiguous_global: mutable darray[ProofKernelTypingBinding] = []
    ambiguous_local: mutable darray[ProofKernelTypingBinding] = []
    global_value_added: bool = proof_kernel_add_typing_binding(&ambiguous_global, "value", "collision", "", "boolean", "bool", "", "")
    local_value_added: bool = proof_kernel_add_typing_binding(&ambiguous_local, "value", "collision", "", "integer", "i64", "", "")
    return TYPE_ENV_TEST_AMBIGUOUS_BINDING_INSERTION_FAILURE if not global_value_added or not local_value_added
    ambiguous_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: ambiguous_global, bindings: ambiguous_local}
    ambiguous_nodes: mutable darray[ProofKernelNode] = []
    ambiguous_children: mutable darray[usize] = []
    collision: usize = add_node(&ambiguous_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "collision", "")
    collision_value: usize = add_node(&ambiguous_nodes, "bool", "", 0, 0, 0, 0, 0, 1, "", "")
    collision_goal: usize = add_node(&ambiguous_nodes, "binary", "==", collision, collision_value, 0, 0, 0, 0, "", "")
    return TYPE_ENV_TEST_AMBIGUOUS_NAME_ACCEPTED if proof_kernel_replay_proposition_formation_report(&ambiguous_nodes, &ambiguous_children, ambiguous_environment, [], collision_goal)

    malformed_global: mutable darray[ProofKernelTypingBinding] = []
    malformed_global_added: bool = proof_kernel_add_typing_binding(&malformed_global, "field", "forged", "", "boolean", "bool", "", "")
    return TYPE_ENV_TEST_MALFORMED_BINDING_INSERTION_FAILURE if not malformed_global_added
    malformed_global_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: malformed_global, bindings: local_bindings}
    local_count_root: usize = add_node(&ambiguous_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "local_count", "")
    local_zero: usize = add_node(&ambiguous_nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
    local_goal: usize = add_node(&ambiguous_nodes, "binary", ">=", local_count_root, local_zero, 0, 0, 0, 0, "", "")
    return TYPE_ENV_TEST_MALFORMED_BINDING_ACCEPTED if proof_kernel_replay_proposition_formation_report(&ambiguous_nodes, &ambiguous_children, malformed_global_environment, [], local_goal)
    return 0
