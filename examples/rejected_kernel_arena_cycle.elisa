# Adversarial source-neutral arena input: the unary node points to itself. The public admission
# boundary must reject the cycle before replay. The independent `proof true` certificate proves
# that a rejected arena cannot interfere with unrelated certificate replay.
include "../src/proof/kernel_core.elisa"
include "../src/proof/kernel_replay.elisa"
using ElisaProofKernelCore
using ElisaProofKernelReplay

def rejected_cycle_arena() -> bool:
    nodes: mutable darray[ProofKernelNode] = []
    children: mutable darray[usize] = []
    root: usize = add_node(&nodes, "unary", "not", 0, 0, 0, 0, 0, 0, "", "")
    admitted: bool = proof_kernel_replay_arena_report(&nodes, &children, [], root)
    proof true:
        assert 1 == 1
    return not admitted
