# A scalar field selected from a container of records is primitive only when the
# declared record field is primitive and the index is witnessed.
struct Entry:
    key: i64
    payload: i64

def indexed_field_congruence(entries: darray[Entry]&, left: usize, right: usize) -> i64:
    requires entries[left].key == entries[right].key
    ensure entries[left].key + 1 == entries[right].key + 1
    return 0

# A witness for `key` must not leak to the distinct `payload` field.
def distinct_field_not_congruent(entries: darray[Entry]&, left: usize, right: usize) -> i64:
    requires entries[left].key == entries[right].key
    ensure entries[left].payload + 1 == entries[right].payload + 1
    return 0
