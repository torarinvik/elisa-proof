# Source-level field typing must preserve nullable-reference-ness into independent replay.
struct NullableCaptureNode:
    next: mutable heap NullableCaptureNode&?

struct NullableCaptureStore:
    prepared: mutable heap NullableCaptureNode&?

def nullable_capture_is_compared_with_null(store: NullableCaptureStore&) -> u8:
    ensure store.prepared == null or result == 0
    return 0

def null_may_be_the_left_operand(store: NullableCaptureStore&) -> u8:
    ensure null != store.prepared or result == 0
    return 0
