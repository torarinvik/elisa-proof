# An index written as an unsigned conversion of a signed value is bounds-checked on the value
# itself (mocap-cleaner Track::odd_sample, Track::lock).
module ConvertedIndexBounds:
    def at(values: darray[i64]&, frame: i64) -> i64:
        count: i64 = values.count.i64()
        return 0 if frame < 0 or frame >= count
        return values[frame.usize()]

    # The same with the count bound to a local first, as mocap writes it.
    def at_local(values: darray[i64]&, frame: i64) -> i64:
        count: i64 = values.count.i64()
        return 0 if frame < 0 or frame >= count
        return values[frame.usize()]
