module WbRuntime:
    public:
        const WB_PROOF_SCOPE: u8 = 0

extend WbRuntime:
    public:
        const TIMER_KIND_TIMEOUT: u8 = 0
        const TIMER_KIND_INTERVAL: u8 = 1
        const TIMER_ADMISSION_OK: u8 = 0
        const TIMER_ADMISSION_INVALID_DEADLINE: u8 = 1
        const TIMER_ADMISSION_CAPACITY: u8 = 2
        const TIMER_ADMISSION_INACTIVE_SESSION: u8 = 3
        const TIMER_DUE_NOT_YET: u8 = 0
        const TIMER_DUE_TIMEOUT: u8 = 1
        const TIMER_DUE_INTERVAL: u8 = 2
        const TIMER_DUE_INVALID: u8 = 3
        const TIMER_DUE_TIME_EXHAUSTED: u8 = 4
        const TIMER_ERROR_INVALID_DEADLINE: u8 = 0
        const TIMER_ERROR_CAPACITY: u8 = 1
        const TIMER_ERROR_INACTIVE_SESSION: u8 = 2
        const TIMER_ERROR_HANDLE_SPACE_EXHAUSTED: u8 = 3
        const TIMER_ERROR_MONOTONIC_TIME_EXHAUSTED: u8 = 4
        const TIMER_ERROR_POLICY_INVARIANT_VIOLATION: u8 = 5
        const TIMER_WIT_ERROR_INVALID_DEADLINE: u8 = 0
        const TIMER_WIT_ERROR_CAPACITY: u8 = 1
        const TIMER_WIT_ERROR_INACTIVE_SESSION: u8 = 2
        const TIMER_WIT_ERROR_RESOURCE_EXHAUSTED: u8 = 3
        const TIMER_WIT_ERROR_INTERNAL_ERROR: u8 = 4

        def timer_wit_error_tag(error_kind: u8) -> u8:
            ensure result <= 4
            ensure result == WbRuntime::TIMER_WIT_ERROR_INVALID_DEADLINE or result == WbRuntime::TIMER_WIT_ERROR_CAPACITY or result == WbRuntime::TIMER_WIT_ERROR_INACTIVE_SESSION or result == WbRuntime::TIMER_WIT_ERROR_RESOURCE_EXHAUSTED or result == WbRuntime::TIMER_WIT_ERROR_INTERNAL_ERROR
            return WbRuntime::TIMER_WIT_ERROR_INVALID_DEADLINE if error_kind == WbRuntime::TIMER_ERROR_INVALID_DEADLINE
            return WbRuntime::TIMER_WIT_ERROR_CAPACITY if error_kind == WbRuntime::TIMER_ERROR_CAPACITY
            return WbRuntime::TIMER_WIT_ERROR_INACTIVE_SESSION if error_kind == WbRuntime::TIMER_ERROR_INACTIVE_SESSION
            return WbRuntime::TIMER_WIT_ERROR_RESOURCE_EXHAUSTED if error_kind == WbRuntime::TIMER_ERROR_HANDLE_SPACE_EXHAUSTED
            return WbRuntime::TIMER_WIT_ERROR_RESOURCE_EXHAUSTED if error_kind == WbRuntime::TIMER_ERROR_MONOTONIC_TIME_EXHAUSTED
            return WbRuntime::TIMER_WIT_ERROR_INTERNAL_ERROR
