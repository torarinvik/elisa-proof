def rejected_unknown_boolean(flag: bool) -> bool:
    ensure result
    return flag

def rejected_boolean_polarity(flag: bool) -> bool:
    requires not flag
    ensure result
    return flag

def rejected_arithmetic_boolean_path(cursor: i64, flag: bool) -> i64:
    requires cursor >= 0 and cursor < 8
    ensure result > 1
    return cursor + 1 if flag
    return cursor + 1
