# An sview summary whose returns come from different formals in different branches pins no
# single backing formal; the wrapper and its caller must not borrow only `b`.
def pick[@r](first: darray[u8]& @r, second: darray[u8]& @r, flag: bool) -> sview @r:
    if flag:
        return first.as_sview()
    return second.as_sview()

def wrapper[@r](first: darray[u8]& @r, second: darray[u8]& @r) -> sview @r:
    return pick(first, second, true)

def rejected_nested_sview_return_provenance() -> usize can[Memory.Allocate, Abort.Panic]:
    observed: mutable usize = 0
    region scratch(64)
    a: mutable darray[u8] @scratch = [65]
    b: mutable darray[u8] @scratch = [66]
    if true:
        view: sview @scratch = wrapper(a, b)
        a.push(67)
        observed <- view.len
    destroy scratch
    return observed

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    return 0
