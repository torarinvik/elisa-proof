# Unlike a bare i64(value) conversion, this qualified call invokes the function.
module ScalarOwner:
    def i64(value: i64) -> i64:
        ensure result == 7
        return 7

def qualified_scalar_named_function(value: i64) -> i64:
    ensure result == 7
    return ScalarOwner::i64(value)

def main() -> i64:
    return qualified_scalar_named_function(1) - 7
