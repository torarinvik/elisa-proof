# False controls for negated guard orders: each ensure is untrue on some input.
module RejectedNegatedGuardOrders:
    public:
        const LIMIT: u64 = 10000

        def untrue_tight_progress(elapsed: u64, span: u64) -> u64:
            requires elapsed <= LIMIT and span <= LIMIT
            ensure result < 1000
            return 1000 if elapsed >= span
            elapsed * 1000 / span

        # The guard runs the wrong way, so `elapsed` may exceed `span`.
        def untrue_reversed_guard(elapsed: u64, span: u64) -> u64:
            requires elapsed <= LIMIT and span <= LIMIT
            ensure result <= 1000
            return 1000 if elapsed < span
            return 0 if span == 0
            elapsed * 1000 / span

        # A guard excluding equality only leaves `low <= high`.
        def untrue_inclusive_guard(low: u64, high: u64) -> u64:
            ensure result < high
            return 0 if low > high
            low
