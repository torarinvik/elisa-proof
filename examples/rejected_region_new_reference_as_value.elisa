# `new[r]` produces a reference into exactly @r. It must not be silently consumed
# as a plain scalar value by the proof resource model.
def rejected_region_new_reference_as_value() -> i64 can[Memory.Allocate, Abort.Panic]:
    region scratch(64)
    copied: i64 = new[scratch] 7
    return copied

def rejected_region_new_reference_assignment_as_value() -> i64 can[Memory.Allocate, Abort.Panic]:
    region scratch(64)
    copied: mutable i64 = 0
    copied <- new[scratch] 7
    return copied

# A rebind must track the region written on the `new` expression itself, not
# preserve or guess a region from the destination's earlier value.
def rejected_region_new_assignment_after_actual_region_destroy() -> i64 can[Memory.Allocate, Abort.Panic]:
    region original(64)
    value: mutable i64& @original = new[original] 1
    region replacement(64)
    value <- new[replacement] 2
    destroy replacement
    return value[0]

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    return 0
