# Ordinary for-loop transfers must re-establish the invariant on their own paths.

def for_break_with_invariant(n: i64) -> i64:
    requires n >= 0
    ensure result >= 0
    value: mutable i64 = 0
    for index in 0..<n:
        invariant value >= 0
        break
    return value


def for_continue_with_invariant(n: i64) -> i64:
    requires n >= 0
    ensure result >= 0
    value: mutable i64 = 0
    for index in 0..<n:
        invariant value >= 0
        if value >= 0:
            continue
    return value
