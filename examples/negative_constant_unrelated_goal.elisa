# A negative module constant (NONE: i64 = -1) yields the premise NONE == -1,
# which the width guard cannot type. It is dropped as a premise instead of
# refusing every goal in the module, so f's unrelated bound still proves.
module A:
    public:
        const NONE: i64 = -1
        def f(role: i64) -> i64:
            requires role >= 0
            requires role < 26
            ensure result < 26
            if role <= 5:
                return role
            if role <= 9:
                return role + 4
            return role - 4
