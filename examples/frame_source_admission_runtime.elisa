include "../build/snapshot/Elisa-compiler/elisacore_std/elisacore_runtime.elisa"
include "../build/snapshot/Elisa-compiler/src/parser/parser.elisa"
using Ast
include "../src/proof/kernel_core.elisa"
include "../src/proof/kernel_replay.elisa"
using ElisaProofKernelCore
include "../src/proof/replay/frame_source_places.elisa"
include "../src/proof/replay/frame_source_owners.elisa"
include "../src/proof/replay/frame_source_types.elisa"
include "../src/proof/replay/frame_source_policy.elisa"
include "../src/proof/replay/frame_source_headers.elisa"
include "../src/proof/replay/frame_source_header_policy.elisa"
include "../src/proof/replay/frame_source_correspondence.elisa"
include "../src/proof/replay/frame_source_writes.elisa"
include "../src/proof/replay/frame_source_admission.elisa"
include "../src/proof/replay/frame_source_specs.elisa"
include "../src/proof/replay/frame_source_preserve_clause.elisa"

def control(source: u8&, expected: bool, mode: u8) -> bool can[Memory.Allocate, Abort.Panic]:
    tokens: darray[Token] = frontend_tokenize(source, source)
    file: Ast::File = frontend_parser_parse_file(source, tokens)
    return false if file.errors.count != 0
    context = ElisaProofFrameSource::owner(&file.top_decls, "run", 4)
    return false if not context.known
    value: ProofKernelNode = ProofKernelNode{kind: "frame-field", operator: "", left: 0, right: 0, auxiliary: 0, children_start: 0, children_count: 0, value: 0, name: "value", secondary_name: ""}
    other: ProofKernelNode = ProofKernelNode{kind: "frame-field", operator: "", left: 0, right: 0, auxiliary: 0, children_start: 0, children_count: 0, value: 0, name: "other", secondary_name: ""}
    changed: ProofKernelNode = ProofKernelNode{kind: "frame-place", operator: "frame-place-v1", left: 0, right: 0, auxiliary: 0, children_start: 0, children_count: 1, value: 0, name: "", secondary_name: ""}
    preserved: ProofKernelNode = ProofKernelNode{kind: "frame-place", operator: "frame-place-v1", left: 0, right: 0, auxiliary: 0, children_start: 1, children_count: 1, value: 0, name: "", secondary_name: ""}
    goal: ProofKernelNode = ProofKernelNode{kind: "frame-policy", operator: "write", left: 2, right: 1, auxiliary: 1, children_start: 2, children_count: 2, value: 0, name: "run", secondary_name: "frame-policy-v1"}
    nodes: mutable darray[ProofKernelNode] = [value, other, changed, preserved, goal]
    children: mutable darray[usize] = [0, 1, 2, 3]
    if mode == 4:
        nodes[4] <- ProofKernelNode{kind: "frame-policy", operator: "write", left: 2, right: 1, auxiliary: 1, children_start: 2, children_count: 1, value: 0, name: "run", secondary_name: "frame-policy-v1"}
    if mode == 5 or mode == 6:
        children[3] <- 2
        operation: sview = "allow" if mode == 5 else "write"
        nodes[4] <- ProofKernelNode{kind: "frame-policy", operator: operation, left: 2, right: 1, auxiliary: 1, children_start: 2, children_count: 2, value: 0, name: "run", secondary_name: "frame-policy-v1"}
    if mode >= 7:
        children[3] <- 2 if mode == 8 else 3
        nodes[4] <- ProofKernelNode{kind: "frame-policy", operator: "preserve", left: 2, right: 0, auxiliary: 1, children_start: 3, children_count: 1, value: 0, name: "run", secondary_name: "frame-policy-v1"}
    if mode >= 13:
        actual_root: usize = 3 if mode == 16 or mode == 17 else 2
        nodes[4] <- ProofKernelNode{kind: "frame-policy", operator: "spec", left: actual_root, right: 0, auxiliary: 1, children_start: 0, children_count: 0, value: 0, name: "run", secondary_name: "frame-policy-v1"}
    if mode >= 20:
        children[3] <- 2 if mode == 21 else 3
        nodes[4] <- ProofKernelNode{kind: "frame-policy", operator: "preserve", left: 2, right: 0, auxiliary: 1, children_start: 3, children_count: 1, value: 0, name: "run", secondary_name: "frame-policy-v1"}
    facts: mutable darray[usize] = []
    facts.push(4) if mode == 1 or mode == 11 or mode == 19
    for statement in context.body |file, tokens, source, expected, mode, nodes, children, facts|:
        match statement:
            Ast::Stmt.Assign(_, _, _, position):
                location: mutable Ast::Pos = position
                location.column <- location.column + 1 if mode == 2 or mode == 12
                owner: sview = "other_owner" if mode == 3 else "run"
                if mode >= 20:
                    clause_index: usize = 2 if mode == 21 or mode == 22 else 0 if mode == 23 else 99 if mode == 24 else 1
                    return ElisaProofFrameSource::direct_preserve_clause_replays(&file.top_decls, "run", 4, position, clause_index, &tokens, source, tokens[tokens.count - 1].start.usize(), &nodes, &children, facts, 4) == expected
                if mode >= 13:
                    policy = ElisaProofFrameSource::source_policy(&file.top_decls, "run", 4, &tokens, source, tokens[tokens.count - 1].start.usize())
                    return false if not policy.known
                    clause = policy.clauses[1 if mode == 17 else 0]
                    clause_position: mutable Ast::Pos = clause.position
                    clause_position.column <- clause_position.column + 1 if mode == 14
                    clause_kind: sview = "preserves" if mode == 15 else clause.kind
                    return ElisaProofFrameSource::spec_replays(&file.top_decls, "run", 4, clause_kind, clause_position, &tokens, source, tokens[tokens.count - 1].start.usize(), &nodes, &children, facts, 4) == expected
                if mode >= 7:
                    return ElisaProofFrameSource::direct_preservation_replays(&file.top_decls, owner, 4, location, &tokens, source, tokens[tokens.count - 1].start.usize(), &nodes, &children, facts, 4) == expected
                if mode == 5:
                    return ElisaProofFrameSource::direct_allowance_replays(&file.top_decls, owner, 4, location, &tokens, source, tokens[tokens.count - 1].start.usize(), &nodes, &children, facts, 4) == expected
                actual = ElisaProofFrameSource::direct_write_replays(&file.top_decls, owner, 4, location, &tokens, source, tokens[tokens.count - 1].start.usize(), &nodes, &children, facts, 4)
                return actual == expected
            _:
                pass
    return false

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    source: u8& = "struct Box:\n    value: mutable i64\n    other: mutable i64\ndef run(box: mutable Box&) -> void changes box.value preserves box.other:\n    box.value <- 1\n"
    return 1 if not control(source, true, 0)
    return 2 if not control(source, false, 1)
    return 3 if not control(source, false, 2)
    return 4 if not control(source, false, 3)
    return 5 if not control("struct Box:\n    value: mutable i64\n    other: mutable i64\ndef run(box: mutable Box&) -> void changes box.value preserves box.other:\n    box.other <- 1\n", false, 0)
    return 6 if not control("struct Box:\n    value: mutable i64\n    other: mutable i64\ndef run(box: mutable Box&) -> void changes box.other preserves box.value:\n    box.value <- 1\n", false, 0)
    return 7 if not control("struct Box:\n    value: mutable i64\n    other: mutable i64\ndef run(box: mutable Box&) -> void changes box.value:\n    box.value <- 1\n", false, 0)
    return 8 if not control("struct Box:\n    missing: mutable i64\n    other: mutable i64\ndef run(box: mutable Box&) -> void changes box.value preserves box.other:\n    box.value <- 1\n", false, 0)
    return 9 if not control(source, false, 4)
    conflict: u8& = "struct Box:\n    value: mutable i64\n    other: mutable i64\ndef run(box: mutable Box&) -> void changes box.value preserves box.value:\n    box.value <- 1\n"
    return 10 if not control(conflict, true, 5)
    return 11 if not control(conflict, false, 6)
    return 12 if not control(source, true, 7)
    return 13 if not control(conflict, false, 8)
    return 14 if not control("struct Box:\n    value: mutable i64\n    other: mutable i64\ndef run(box: mutable Box&) -> void changes box.value preserves box:\n    box.value <- 1\n", false, 9)
    return 15 if not control(source, false, 11)
    return 16 if not control(source, false, 12)
    return 17 if not control(source, true, 13)
    return 18 if not control(source, false, 14)
    return 19 if not control(source, false, 15)
    return 20 if not control(source, false, 16)
    return 21 if not control("struct Box:\n    value: mutable i64\n    other: mutable i64\ndef run(box: mutable Box&) -> void changes box.value:\n    preserves box.other\n    box.value <- 1\n", true, 17)
    return 22 if not control("struct Box:\n    missing: mutable i64\n    other: mutable i64\ndef run(box: mutable Box&) -> void changes box.value preserves box.other:\n    box.value <- 1\n", false, 18)
    return 23 if not control(source, false, 19)
    two_preserves: u8& = "struct Box:\n    value: mutable i64\n    other: mutable i64\ndef run(box: mutable Box&) -> void changes box.value preserves box.other, box.value:\n    box.value <- 1\n"
    return 24 if not control(two_preserves, true, 20)
    return 25 if not control(two_preserves, false, 21)
    return 26 if not control(two_preserves, false, 22)
    return 27 if not control(two_preserves, false, 23)
    return 28 if not control(two_preserves, false, 24)
    return 0
