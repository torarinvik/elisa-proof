# A view parameter may point anywhere within @r. A write through another parameter
# in the same region must be rejected even without a known alias between their places.
def rejected_sview_parameter_write[@r](view: sview @r, bytes: mutable darray[u8]& @r) -> usize:
    requires bytes.count > 0
    bytes[0] <- bytes[0]
    return view.len

def main() -> i64:
    return 0
