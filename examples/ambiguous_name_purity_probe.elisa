module First:
    def shared(value: i64) -> i64:
        return value

module Second:
    def shared(value: i64) -> i64:
        return value

struct PurityState:
    started: mutable u8

def scalar_after_collision(value: bool) -> u8:
    ensure value or result == 1
    return 1 if not value
    return 0

def effect_after_collision(state: mutable PurityState&) -> u8:
    state.started <- 0
    return 0

def pure_after_effect(value: i64) -> i64:
    ensure result == value
    return value

def caller_keeps_started(state: PurityState&) -> u8:
    ensure state.started != 0 or result == 3
    return 3 if state.started == 0
    status: u8 = scalar_after_collision(true)
    return status
