# Qualified call nodes retain only a function's leaf name in the source-neutral arena. The typed
# kernel must therefore reject every duplicate leaf, including declarations with identical result
# sorts, instead of letting environment order choose a module member.
def kernel_ambiguous_function_name_tests() -> i64 can[Memory.Allocate, Abort.Panic]:
    nodes: mutable darray[ProofKernelNode] = []
    children: mutable darray[usize] = []
    module_root: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "ModuleA", "")
    qualified_callee: usize = add_node(&nodes, "scope", "", module_root, 0, 0, 0, 0, 0, "read_flag", "")
    qualified_call: usize = add_node(&nodes, "call", "", qualified_callee, 0, 0, 0, 0, 0, "", "")

    bindings: mutable darray[ProofKernelTypingBinding] = []
    first_added: bool = proof_kernel_add_function_signature(&bindings, "read_flag", "boolean", "bool", "", "", 0, 0, 2001, 0)
    second_added: bool = proof_kernel_add_function_signature(&bindings, "read_flag", "boolean", "bool", "", "", 0, 0, 2002, 0)
    return 1 if not first_added or not second_added
    ambiguous_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: bindings}
    return 2 if proof_kernel_replay_proposition_formation_report(&nodes, &children, ambiguous_environment, [], qualified_call)

    single_binding: mutable darray[ProofKernelTypingBinding] = []
    single_added: bool = proof_kernel_add_function_signature(&single_binding, "read_flag", "boolean", "bool", "", "", 0, 0, 2003, 0)
    single_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: single_binding}
    return 3 if not single_added or not proof_kernel_replay_proposition_formation_report(&nodes, &children, single_environment, [], qualified_call)
    return 0

# Parameter-row indexing must preserve the former full-scan rule: a repeated slot within one
# signature is ambiguous even if one of the duplicate rows would match the supplied argument.
def kernel_duplicate_function_parameter_index_tests() -> i64 can[Memory.Allocate, Abort.Panic]:
    nodes: mutable darray[ProofKernelNode] = []
    children: mutable darray[usize] = []
    callee: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "predicate", "")
    argument: usize = add_node(&nodes, "int", "", 0, 0, 0, 0, 0, 7, "", "")
    wrapper: usize = add_node(&nodes, "call_arg", "", argument, 0, 0, 0, 0, 0, "", "")
    children.push(wrapper)
    call: usize = add_node(&nodes, "call", "", callee, 0, 0, 0, 1, 0, "", "")

    ambiguous_bindings: mutable darray[ProofKernelTypingBinding] = []
    signature_added: bool = proof_kernel_add_function_signature(&ambiguous_bindings, "predicate", "boolean", "bool", "", "", 0, 0, 3010, 1)
    integer_parameter_added: bool = proof_kernel_add_function_parameter(&ambiguous_bindings, "predicate", "value", "integer", "i64", "", "", 0, 0, 3010, 0, false, false)
    boolean_parameter_added: bool = proof_kernel_add_function_parameter(&ambiguous_bindings, "predicate", "value", "boolean", "bool", "", "", 0, 0, 3010, 0, false, false)
    return 1 if not signature_added or not integer_parameter_added or not boolean_parameter_added
    ambiguous_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: ambiguous_bindings}
    return 2 if proof_kernel_replay_proposition_formation_report(&nodes, &children, ambiguous_environment, [], call)

    unique_bindings: mutable darray[ProofKernelTypingBinding] = []
    unique_signature_added: bool = proof_kernel_add_function_signature(&unique_bindings, "predicate", "boolean", "bool", "", "", 0, 0, 3011, 1)
    unique_parameter_added: bool = proof_kernel_add_function_parameter(&unique_bindings, "predicate", "value", "integer", "i64", "", "", 0, 0, 3011, 0, false, false)
    unique_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: unique_bindings}
    return 3 if not unique_signature_added or not unique_parameter_added or not proof_kernel_replay_proposition_formation_report(&nodes, &children, unique_environment, [], call)
    return 0
