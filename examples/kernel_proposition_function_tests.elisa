# Qualified call nodes retain only a function's leaf name in the source-neutral arena. The typed
# kernel must therefore reject every duplicate leaf, including declarations with identical result
# sorts, instead of letting environment order choose a module member.
const KERNEL_AMBIGUOUS_FUNCTION_NAME_TEST_INSERTION_FAILURE: i64 = 1
const KERNEL_AMBIGUOUS_FUNCTION_NAME_TEST_ACCEPTED: i64 = 2
const KERNEL_AMBIGUOUS_FUNCTION_NAME_TEST_UNIQUE_REJECTED: i64 = 3
const KERNEL_AMBIGUOUS_FUNCTION_FIRST_SIGNATURE_ID: usize = 2001
const KERNEL_AMBIGUOUS_FUNCTION_SECOND_SIGNATURE_ID: usize = 2002
const KERNEL_AMBIGUOUS_FUNCTION_UNIQUE_SIGNATURE_ID: usize = 2003
const KERNEL_FUNCTION_PARAMETER_TEST_INSERTION_FAILURE: i64 = 1
const KERNEL_FUNCTION_PARAMETER_TEST_DUPLICATE_ACCEPTED: i64 = 2
const KERNEL_FUNCTION_PARAMETER_TEST_VALID_SIGNATURE_REJECTED: i64 = 3
const KERNEL_FUNCTION_PARAMETER_TEST_WORKSPACE_DUPLICATE_ACCEPTED: i64 = 4
const KERNEL_FUNCTION_PARAMETER_TEST_WORKSPACE_UNIQUE_REJECTED: i64 = 5
const KERNEL_FUNCTION_PARAMETER_TEST_CACHED_GLOBAL_REJECTED: i64 = 6
const KERNEL_FUNCTION_PARAMETER_TEST_CACHED_LOCAL_REJECTED: i64 = 7
const KERNEL_FUNCTION_PARAMETER_AMBIGUOUS_SIGNATURE_ID: usize = 3010
const KERNEL_FUNCTION_PARAMETER_UNIQUE_SIGNATURE_ID: usize = 3011
const KERNEL_FUNCTION_PARAMETER_COLLIDING_SIGNATURE_ID: usize = 3013
const KERNEL_FUNCTION_PARAMETER_COUNT: usize = 1
const KERNEL_FUNCTION_PARAMETER_FIRST_INDEX: usize = 0

def kernel_ambiguous_function_name_tests() -> i64 can[Memory.Allocate, Abort.Panic]:
    nodes: mutable darray[ProofKernelNode] = []
    children: mutable darray[usize] = []
    module_root: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "ModuleA", "")
    qualified_callee: usize = add_node(&nodes, "scope", "", module_root, 0, 0, 0, 0, 0, "read_flag", "")
    qualified_call: usize = add_node(&nodes, "call", "", qualified_callee, 0, 0, 0, 0, 0, "", "")

    bindings: mutable darray[ProofKernelTypingBinding] = []
    first_added: bool = proof_kernel_add_function_signature(&bindings, "read_flag", "boolean", "bool", "", "", 0, 0, KERNEL_AMBIGUOUS_FUNCTION_FIRST_SIGNATURE_ID, 0)
    second_added: bool = proof_kernel_add_function_signature(&bindings, "read_flag", "boolean", "bool", "", "", 0, 0, KERNEL_AMBIGUOUS_FUNCTION_SECOND_SIGNATURE_ID, 0)
    return KERNEL_AMBIGUOUS_FUNCTION_NAME_TEST_INSERTION_FAILURE if not first_added or not second_added
    ambiguous_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: bindings}
    return KERNEL_AMBIGUOUS_FUNCTION_NAME_TEST_ACCEPTED if proof_kernel_replay_proposition_formation_report(&nodes, &children, ambiguous_environment, [], qualified_call)

    single_binding: mutable darray[ProofKernelTypingBinding] = []
    single_added: bool = proof_kernel_add_function_signature(&single_binding, "read_flag", "boolean", "bool", "", "", 0, 0, KERNEL_AMBIGUOUS_FUNCTION_UNIQUE_SIGNATURE_ID, 0)
    single_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: single_binding}
    return KERNEL_AMBIGUOUS_FUNCTION_NAME_TEST_UNIQUE_REJECTED if not single_added or not proof_kernel_replay_proposition_formation_report(&nodes, &children, single_environment, [], qualified_call)
    return 0

# Parameter-row indexing must preserve the former full-scan rule: a repeated slot within one
# signature is ambiguous even if one of the duplicate rows would match the supplied argument.
# Distinct signatures that collide in the bucket selector must still be separated by exact keys.
def kernel_duplicate_function_parameter_index_tests() -> i64 can[Memory.Allocate, Abort.Panic]:
    nodes: mutable darray[ProofKernelNode] = []
    children: mutable darray[usize] = []
    callee: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "predicate", "")
    argument: usize = add_node(&nodes, "int", "", 0, 0, 0, 0, 0, 7, "", "")
    wrapper: usize = add_node(&nodes, "call_arg", "", argument, 0, 0, 0, 0, 0, "", "")
    children.push(wrapper)
    call: usize = add_node(&nodes, "call", "", callee, 0, 0, 0, 1, 0, "", "")

    ambiguous_bindings: mutable darray[ProofKernelTypingBinding] = []
    signature_added: bool = proof_kernel_add_function_signature(&ambiguous_bindings, "predicate", "boolean", "bool", "", "", 0, 0, KERNEL_FUNCTION_PARAMETER_AMBIGUOUS_SIGNATURE_ID, KERNEL_FUNCTION_PARAMETER_COUNT)
    integer_parameter_added: bool = proof_kernel_add_function_parameter(&ambiguous_bindings, "predicate", "value", "integer", "i64", "", "", 0, 0, KERNEL_FUNCTION_PARAMETER_AMBIGUOUS_SIGNATURE_ID, KERNEL_FUNCTION_PARAMETER_FIRST_INDEX, false, false)
    boolean_parameter_added: bool = proof_kernel_add_function_parameter(&ambiguous_bindings, "predicate", "value", "boolean", "bool", "", "", 0, 0, KERNEL_FUNCTION_PARAMETER_AMBIGUOUS_SIGNATURE_ID, KERNEL_FUNCTION_PARAMETER_FIRST_INDEX, false, false)
    return KERNEL_FUNCTION_PARAMETER_TEST_INSERTION_FAILURE if not signature_added or not integer_parameter_added or not boolean_parameter_added
    ambiguous_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: ambiguous_bindings}
    return KERNEL_FUNCTION_PARAMETER_TEST_DUPLICATE_ACCEPTED if proof_kernel_replay_proposition_formation_report(&nodes, &children, ambiguous_environment, [], call)
    validation_workspace: mutable ProofKernelReplayValidationWorkspace = proof_kernel_replay_validation_workspace_new()
    typing_workspace: mutable ProofKernelReplayTypingWorkspace = proof_kernel_replay_typing_workspace_new()
    ambiguous_workspace_accepted: bool = proof_kernel_replay_proposition_formation_report_with_workspaces(&nodes, &children, ambiguous_environment, [], call, &validation_workspace, &typing_workspace)
    return KERNEL_FUNCTION_PARAMETER_TEST_WORKSPACE_DUPLICATE_ACCEPTED if ambiguous_workspace_accepted

    unique_bindings: mutable darray[ProofKernelTypingBinding] = []
    unique_signature_added: bool = proof_kernel_add_function_signature(&unique_bindings, "predicate", "boolean", "bool", "", "", 0, 0, KERNEL_FUNCTION_PARAMETER_UNIQUE_SIGNATURE_ID, KERNEL_FUNCTION_PARAMETER_COUNT)
    unique_parameter_added: bool = proof_kernel_add_function_parameter(&unique_bindings, "predicate", "value", "integer", "i64", "", "", 0, 0, KERNEL_FUNCTION_PARAMETER_UNIQUE_SIGNATURE_ID, KERNEL_FUNCTION_PARAMETER_FIRST_INDEX, false, false)
    colliding_signature_added: bool = proof_kernel_add_function_signature(&unique_bindings, "other_predicate", "boolean", "bool", "", "", 0, 0, KERNEL_FUNCTION_PARAMETER_COLLIDING_SIGNATURE_ID, KERNEL_FUNCTION_PARAMETER_COUNT)
    colliding_parameter_added: bool = proof_kernel_add_function_parameter(&unique_bindings, "other_predicate", "flag", "boolean", "bool", "", "", 0, 0, KERNEL_FUNCTION_PARAMETER_COLLIDING_SIGNATURE_ID, KERNEL_FUNCTION_PARAMETER_FIRST_INDEX, false, false)
    unique_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: unique_bindings}
    unique_workspace_accepted: bool = proof_kernel_replay_proposition_formation_report_with_workspaces(&nodes, &children, unique_environment, [], call, &validation_workspace, &typing_workspace)
    return KERNEL_FUNCTION_PARAMETER_TEST_VALID_SIGNATURE_REJECTED if not unique_signature_added or not unique_parameter_added or not colliding_signature_added or not colliding_parameter_added or not unique_workspace_accepted or not proof_kernel_replay_proposition_formation_report(&nodes, &children, unique_environment, [], call)

    # Cached source globals reuse their validated parameter hash chain when the local context
    # adds none. The public cached API must still rebuild a merged chain for caller-supplied local
    # parameter rows rather than treating the source fast path as a trust shortcut.
    cached_validation_workspace: mutable ProofKernelReplayValidationWorkspace = proof_kernel_replay_validation_workspace_new()
    cached_global_workspace: mutable ProofKernelReplayTypingWorkspace = proof_kernel_replay_typing_workspace_new()
    cached_global_ready: bool = proof_kernel_replay_typing_workspace_prepare_globals(unique_bindings, &cached_global_workspace)
    cached_global_call: bool = proof_kernel_replay_proposition_formation_report_with_cached_globals(&nodes, &children, [], [], call, &cached_validation_workspace, &cached_global_workspace)
    return KERNEL_FUNCTION_PARAMETER_TEST_CACHED_GLOBAL_REJECTED if not cached_global_ready or not cached_global_call
    empty_global_workspace: mutable ProofKernelReplayTypingWorkspace = proof_kernel_replay_typing_workspace_new()
    empty_globals_ready: bool = proof_kernel_replay_typing_workspace_prepare_globals([], &empty_global_workspace)
    cached_local_call: bool = proof_kernel_replay_proposition_formation_report_with_cached_globals(&nodes, &children, unique_bindings, [], call, &cached_validation_workspace, &empty_global_workspace)
    return KERNEL_FUNCTION_PARAMETER_TEST_CACHED_LOCAL_REJECTED if not empty_globals_ready or not cached_local_call
    return 0
