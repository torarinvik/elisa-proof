# The boundary of the product-sign rule. It concludes a sign from the operands' signs and nothing
# else: a strict conclusion needs strict premises, a mixed pair is not nonnegative, one known sign
# is not two, a bound other than zero is not a sign, and sign facts about other terms say nothing
# about these operands.
def strict_from_nonstrict(x: i64, y: i64) -> i64:
    requires x >= 0
    requires y >= 0
    ensure result > 0
    return x * y

def mixed_claimed_nonnegative(x: i64, y: i64) -> i64:
    requires x >= 0
    requires y <= 0
    ensure result >= 0
    return x * y

def one_operand_known(x: i64, y: i64) -> i64:
    requires x >= 0
    ensure result >= 0
    return x * y

def nonzero_bound(x: i64, y: i64) -> i64:
    requires x >= 0
    requires y >= 0
    ensure result >= 1
    return x * y

def signs_of_other_terms(x: i64, y: i64, a: i64, b: i64) -> i64:
    requires a >= 0
    requires b >= 0
    ensure result >= 0
    return x * y
