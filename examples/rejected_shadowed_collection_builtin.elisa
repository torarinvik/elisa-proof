# A declared function with the same leaf name as a collection method must not be treated as the
# compiler builtin. The user declaration may have arbitrary effects, so the receiver write is not
# safe to model through the builtin shortcut.

def push(values: mutable darray[i64]&, value: i64) -> void:
    values.clear()

def shadowed_push_must_not_be_verified() -> usize:
    items: mutable darray[i64] = []
    before: usize = items.count
    items.push(1)
    return items.count - before

def main() -> usize:
    return shadowed_push_must_not_be_verified()
