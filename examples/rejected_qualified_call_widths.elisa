# Controls for qualified call widths: a bound the summary does not give, and an unsigned
# result, where `-1` has no signed reading and stays refused.
module Clamp:
    public:
        def keep(value: i64) -> i64:
            requires value >= -1000
            requires value <= 1000
            ensure result >= -1000
            return value

        def count(value: u32) -> u32:
            requires value <= 1000
            ensure result == value
            return value

        def too_tight(v: i64) -> i64:
            requires v >= -1000
            requires v <= 1000
            ensure result >= -500
            return Clamp::keep(v)

        def unsigned_result(v: u32) -> u32:
            requires v <= 1000
            ensure result >= -1
            return Clamp::count(v)
