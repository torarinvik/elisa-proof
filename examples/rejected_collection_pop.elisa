# Each ensure overstates what the body does to `v`.
def no_shrink(v: mutable darray[u32]&) -> void:
    ensures v.count == old(v.count)
    v.pop()

def popped_slot(v: mutable darray[u32]&) -> void:
    requires v.count >= 1 and v[v.count - 1] == 3
    ensures v[v.count - 1] == 3
    v.pop()

def maybe_pop(v: mutable darray[u32]&, c: bool) -> void:
    ensures v.count == old(v.count) - 1
    if c:
        v.pop()

def other_collection(v: mutable darray[u32]&, w: mutable darray[u32]&) -> void:
    ensures v.count == old(v.count) - 1
    w.pop()

def pop_then_push(v: mutable darray[u32]&, x: u32) -> void can[Memory.Allocate]:
    requires v.count >= 1 and v[v.count - 1] == 3
    ensures v[v.count - 1] == 3
    v.pop()
    v.push(x)

def value_pop(v: mutable darray[u32]&) -> void:
    ensures v.count == old(v.count) - 1
    _ = v.pop()

# Malformed: a pop with an argument is not the builtin.
def pop_with_argument(v: mutable darray[u32]&) -> void:
    ensures v.count == old(v.count) - 1
    v.pop(1)
