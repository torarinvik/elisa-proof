# Passing an unproven value to a refinement-alias parameter is rejected, like an unproven
# `requires`.
type Permille = i64 where self >= 0 and self <= 1000

def permille_upper(w: Permille) -> i64:
    ensure result <= 1000
    return w

def unchecked(raw: i64) -> i64:
    return permille_upper(raw)
