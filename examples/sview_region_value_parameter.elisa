# A by-value sview formal carries its declared region just like a reference formal.
def forward_region_view[@r](view: sview @r, other: sview @r) -> sview @r:
    return view

def sview_region_value_parameter() -> i64 can[Memory.Allocate, Abort.Panic]:
    observed_length: mutable i64 = 0
    region scratch(64)
    bytes: mutable darray[u8] @scratch = [65]
    if true:
        view: sview @scratch = bytes.as_sview()
        forwarded: sview @scratch = forward_region_view(view, view)
        observed_length <- forwarded.len.i64()
    destroy scratch
    return observed_length

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    return sview_region_value_parameter()
