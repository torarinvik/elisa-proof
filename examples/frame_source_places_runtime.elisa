include "../../Elisa-compiler/elisacore_std/elisacore_runtime_prelude.elisa"
include "../../Elisa-compiler/elisacore_std/collections.elisa"
include "../../Elisa-compiler/src/parser/parser_tokens.elisa"
include "../../Elisa-compiler/src/parser/ast_nodes.elisa"
include "../src/proof/kernel_replay/frame_policy_model.elisa"
include "../src/proof/replay/frame_source_places.elisa"

def main() -> i64:
    pos: Ast::Pos = Ast::pos_at_line(1)
    root: Ast::Expr = Ast::Expr.Ident("box", pos)
    child: Ast::Expr = Ast::Expr.Field(root, "value", pos)
    nested: Ast::Expr = Ast::Expr.Field(child, "x", pos)
    deep: Ast::Expr = Ast::Expr.Field(nested, "y", pos)
    formals: darray[sview] = ["other", "box"]
    decoded = ElisaProofFrameSource::place(deep, formals)
    return 1 if not decoded.known or decoded.place.parameter != 1 or decoded.place.depth != 3 or decoded.place.field != "value" or decoded.place.field2 != "x" or decoded.place.field3 != "y"
    wrapped = ElisaProofFrameSource::place(Ast::Expr.Paren(child, pos), formals)
    return 2 if not wrapped.known or wrapped.place.parameter != 1 or wrapped.place.depth != 1
    whole = ElisaProofFrameSource::place(root, formals)
    return 3 if not whole.known or whole.place.depth != 0
    return 4 if ElisaProofFrameSource::place(Ast::Expr.Field(deep, "z", pos), formals).known
    return 5 if ElisaProofFrameSource::place(Ast::Expr.Ident("global", pos), formals).known
    return 6 if ElisaProofFrameSource::place(Ast::Expr.Field(root, "", pos), formals).known
    return 7 if ElisaProofFrameSource::place(Ast::Expr.Index(root, Ast::Expr.IntLit(0, pos), pos), formals).known
    duplicate: darray[sview] = ["box", "box"]
    return 8 if ElisaProofFrameSource::place(root, duplicate).known
    empty_name: darray[sview] = ["box", ""]
    return 9 if ElisaProofFrameSource::place(root, empty_name).known
    empty: darray[sview] = []
    return 10 if ElisaProofFrameSource::place(root, empty).known
    reordered: darray[sview] = ["box", "other"]
    changed = ElisaProofFrameSource::place(child, reordered)
    return 11 if not changed.known or changed.place.parameter != 0
    wrapped_deep: mutable Ast::Expr = root
    for index in 0..<64 |wrapped_deep|:
        wrapped_deep <- Ast::Expr.Paren(wrapped_deep, pos)
    return 12 if ElisaProofFrameSource::place(wrapped_deep, formals).known
    at_limit: mutable Ast::Expr = root
    for index in 0..<63 |at_limit|:
        at_limit <- Ast::Expr.Paren(at_limit, pos)
    return 13 if not ElisaProofFrameSource::place(at_limit, formals).known
    return 0
