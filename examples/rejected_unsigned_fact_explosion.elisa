# All requirements hold at x == 255, y == 0 under u8 wrapping arithmetic.
# They are not an inconsistent signed-integer context from which false follows.
def unsigned_fact_explosion(x: u8, y: u8) -> void:
    requires x == 255
    requires y == x + 1
    requires y == 0
    ensure x == 0
    return

# A modular inequality must not prove its own subtraction is non-wrapping.
def unsigned_subtraction_explosion(x: u8, y: u8) -> void:
    requires x == 0
    requires y == 1
    requires x - y > 0
    ensure x == 1
    return
