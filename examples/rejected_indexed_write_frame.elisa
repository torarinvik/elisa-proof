# An element write must not keep a fact about the cell it may have changed (BACKLOG W-03).

def stale_same_index(xs: mutable darray[i64], k: usize) -> i64:
    requires k < xs.count and xs[k] == 3
    ensure result == 3
    xs[k] <- 5
    return xs[k]

def maybe_same_index(xs: mutable darray[i64], j: usize, k: usize) -> i64:
    requires j < xs.count and k < xs.count and xs[j] == 3
    ensure result == 3
    xs[k] <- 5
    return xs[j]

def stale_binding(xs: mutable darray[i64], k: usize) -> i64:
    requires k < xs.count and xs[k] == 3
    ensure result == 5
    old: i64 = xs[k]
    xs[k] <- 5
    return old
