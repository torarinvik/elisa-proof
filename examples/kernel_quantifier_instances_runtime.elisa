# Direct kernel checks: bypass producer proof search so a later false instance
# cannot hide behind a producer that already rejects the source obligation.
include "../src/proof/kernel_core.elisa"
include "../src/proof/kernel_replay.elisa"
using ElisaProofKernelCore
using ElisaProofKernelReplay

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    nodes: mutable darray[ProofKernelNode] = []
    children: mutable darray[usize] = []
    facts: darray[usize] = []
    zero: usize = add_node(&nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
    one: usize = add_node(&nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
    three: usize = add_node(&nodes, "int", "", 0, 0, 0, 0, 0, 3, "", "")
    binder: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "i", "")
    range: usize = add_node(&nodes, "binary", "range_lt", zero, three, 0, 0, 0, 0, "", "")
    late_witness: usize = add_node(&nodes, "binary", "==", binder, one, 0, 0, 0, 0, "", "")
    exists_late: usize = add_node(&nodes, "quantifier", "exists", range, late_witness, 1, 0, 0, 0, "i", "")
    return 1 if not proof_kernel_replay_quantifier_report(&nodes, &children, "exists", facts, exists_late)
    first_only: usize = add_node(&nodes, "binary", "==", binder, zero, 0, 0, 0, 0, "", "")
    false_later: usize = add_node(&nodes, "quantifier", "forall", range, first_only, 1, 0, 0, 0, "i", "")
    return 2 if proof_kernel_replay_quantifier_report(&nodes, &children, "forall", facts, false_later)
    all_instances: usize = add_node(&nodes, "binary", "<", binder, three, 0, 0, 0, 0, "", "")
    true_all: usize = add_node(&nodes, "quantifier", "forall", range, all_instances, 1, 0, 0, 0, "i", "")
    return 3 if not proof_kernel_replay_quantifier_report(&nodes, &children, "forall", facts, true_all)
    return 4 if proof_kernel_replay_quantifier_report(&nodes, &children, "forall", facts, exists_late)
    return 0
