module ExactDivisionReconstruction:
    public:
        def unsigned_division_reconstructs_exact_multiple(total: u64, divisor: u64) -> bool:
            requires divisor > 0
            requires total % divisor == 0
            ensure result == true
            return (total / divisor) * divisor == total

        def signed_positive_division_reconstructs_exact_multiple(total: i64, divisor: i64) -> bool:
            requires total > 0
            requires divisor > 0
            requires total % divisor == 0
            ensure result == true
            return (total / divisor) * divisor == total

        def signed_negative_division_reconstructs_exact_multiple(total: i64, divisor: i64) -> bool:
            requires total < 0
            requires divisor > 0
            requires total % divisor == 0
            ensure result == true
            return (total / divisor) * divisor == total

        def missing_zero_remainder_does_not_prove_reconstruction(total: u64, divisor: u64) -> bool:
            requires total > 0
            requires divisor > 0
            ensure result == true
            return (total / divisor) * divisor == total

        def nonzero_remainder_does_not_prove_reconstruction(total: u64, divisor: u64) -> bool:
            requires total > 0
            requires divisor > 1
            requires total % divisor == 1
            ensure result == true
            return (total / divisor) * divisor == total

        def a_different_multiplier_does_not_reconstruct(total: u64, divisor: u64) -> bool:
            requires total > 0
            requires divisor > 0
            requires total % divisor == 0
            ensure result == true
            return (total / divisor) * (divisor / 2) == total
