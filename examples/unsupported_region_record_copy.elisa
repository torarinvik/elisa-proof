# The checker does not yet track borrowed fields through aggregate copies.
# No region is destroyed here: refusing this shape must not claim use-after-destroy.
struct BorrowedRecord:
    label: sview
    value: mutable i64

def read_record[@r](records: darray[BorrowedRecord]& @r, index: usize) -> i64:
    requires index < records.count
    record: BorrowedRecord = records[index]
    return record.value

def write_record[@r](records: darray[BorrowedRecord]& @r, index: usize) -> i64:
    requires index < records.count
    record: mutable BorrowedRecord = records[index]
    record.value <- 1
    return record.value

def main() -> i64:
    return 0
