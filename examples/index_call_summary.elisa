# A verified pure result summary can carry an index through the memory-safety proof when the
# summary is exact. The call itself is not treated as a bound; its result is checked by the
# ordinary lower/upper arithmetic obligations below.

def identity_index(index: usize) -> usize:
    ensure result == index
    return index

def safe_index_call(values: darray[i64]&, index: usize) -> i64:
    requires index < values.count
    return values[identity_index(index)]
