# A different variant is not the same bool, and a call subject is not one named value.

enum Color:
    Red
    Green

extern pick_color() -> Color

def wrong_variant(c: Color) -> bool:
    ensure result == (c is Color.Red)
    return c is Color.Green

def swapped_subject(c: Color, d: Color) -> bool:
    ensure result == (c is Color.Red)
    return d is Color.Red

def call_subject(c: Color) -> bool:
    ensure result == (pick_color() is Color.Red)
    return pick_color() is Color.Red
