# Strict primitive ordering excludes equality, including when the disequality
# is written with the operands reversed.
def strict_less_excludes_equality(left: u64, right: u64) -> bool:
    requires left < right
    ensure left != right
    return true

def strict_greater_excludes_reversed_equality(left: u64, right: u64) -> bool:
    requires left > right
    ensure right != left
    return true

def equality_with_zero_excludes_u64_max(value: u64) -> bool:
    requires value == 0
    ensure value != 18446744073709551615
    return true
