# A bare call spelled like a builtin scalar type is the conversion, not the user function of that
# name: the compiler warns that such a function can never be called, and `i64(x)` below returns
# x at run time. Applying the function's contract there certified a false postcondition.
def i64(value: i64) -> i64:
    ensure result == 7
    return 7

def rejected_cast_is_not_the_shadowing_function(x: i64) -> i64:
    ensure result == 7
    return i64(x)

def isize(value: isize) -> isize:
    ensure result == 5
    return 5

def rejected_isize_cast_through_local(x: isize) -> isize:
    ensure result == 5
    y: isize = isize(x)
    return y
