# Exercise propositional fact projection directly against the replay kernel. The producer splits
# a conjunctive branch condition into the parts it entails so that a part over a by-value scalar
# survives a call that discards the whole; every such part is a derived fact that this kernel must
# re-prove. Only three classical rules are available here — a conjunction entails each conjunct, a
# negated disjunction entails each negated disjunct, and a double negation cancels — and the dual
# forms must stay refused, or the producer could smuggle a disjunction in as a conjunct.
include "../src/proof/kernel_core.elisa"
include "../src/proof/kernel_replay.elisa"
using ElisaProofKernelCore
using ElisaProofKernelReplay

const CONJUNCT_REJECTED: i64 = 1
const SECOND_CONJUNCT_REJECTED: i64 = 2
const NEGATED_DISJUNCT_REJECTED: i64 = 3
const SECOND_NEGATED_DISJUNCT_REJECTED: i64 = 4
const DOUBLE_NEGATION_REJECTED: i64 = 5
const NESTED_NEGATED_DISJUNCT_REJECTED: i64 = 6
const NEGATED_DISJUNCT_DOUBLE_NEGATION_REJECTED: i64 = 7
const DISJUNCT_ADMITTED: i64 = 8
const NEGATED_CONJUNCT_ADMITTED: i64 = 9
const UNNEGATED_DISJUNCT_ADMITTED: i64 = 10
const FOREIGN_CONJUNCT_ADMITTED: i64 = 11
const NEGATED_DOUBLE_NEGATION_ADMITTED: i64 = 12
const NEGATED_CONJUNCT_TACTIC_ADMITTED: i64 = 13
const CONJUNCT_TACTIC_REJECTED: i64 = 14
const NEGATED_CONJUNCT_MEMBER_ADMITTED: i64 = 15
const NEGATED_DISJUNCT_MEMBER_ADMITTED: i64 = 16
const DISJUNCT_NEGATION_ADMITTED: i64 = 17
const CONJUNCT_NEGATION_ADMITTED: i64 = 18

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    nodes: mutable darray[ProofKernelNode] = []
    children: mutable darray[usize] = []
    p: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "p", "")
    q: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "q", "")
    r: usize = add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "r", "")
    not_p: usize = add_node(&nodes, "unary", "not", p, 0, 0, 0, 0, 0, "", "")
    not_q: usize = add_node(&nodes, "unary", "not", q, 0, 0, 0, 0, 0, "", "")

    # A conjunction entails each conjunct.
    p_and_q: usize = add_node(&nodes, "binary", "and", p, q, 0, 0, 0, 0, "", "")
    both: darray[usize] = [p_and_q]
    return CONJUNCT_REJECTED if not proof_kernel_replay_goal_report(&nodes, &children, both, p)
    return SECOND_CONJUNCT_REJECTED if not proof_kernel_replay_goal_report(&nodes, &children, both, q)
    return FOREIGN_CONJUNCT_ADMITTED if proof_kernel_replay_goal_report(&nodes, &children, both, r)

    # A negated disjunction entails each negated disjunct. This is the shape a guarded early
    # return leaves behind: `return if not valid(x) or depth >= 127` negates to a conjunction
    # whose left part is itself a negated disjunction.
    p_or_q: usize = add_node(&nodes, "binary", "or", p, q, 0, 0, 0, 0, "", "")
    not_p_or_q_node: usize = add_node(&nodes, "unary", "not", p_or_q, 0, 0, 0, 0, 0, "", "")
    neither: darray[usize] = [not_p_or_q_node]
    return NEGATED_DISJUNCT_REJECTED if not proof_kernel_replay_goal_report(&nodes, &children, neither, not_p)
    return SECOND_NEGATED_DISJUNCT_REJECTED if not proof_kernel_replay_goal_report(&nodes, &children, neither, not_q)
    return UNNEGATED_DISJUNCT_ADMITTED if proof_kernel_replay_goal_report(&nodes, &children, neither, p)

    # A double negation cancels, in both directions of the sign walk.
    not_not_p: usize = add_node(&nodes, "unary", "not", not_p, 0, 0, 0, 0, 0, "", "")
    doubled: darray[usize] = [not_not_p]
    return DOUBLE_NEGATION_REJECTED if not proof_kernel_replay_goal_report(&nodes, &children, doubled, p)
    return NEGATED_DOUBLE_NEGATION_ADMITTED if proof_kernel_replay_goal_report(&nodes, &children, doubled, not_p)

    # Nesting: `not ((p or q) or r)` reaches every disjunct, and a negated disjunct that is
    # itself a negation cancels on the way.
    p_or_q_or_r: usize = add_node(&nodes, "binary", "or", p_or_q, r, 0, 0, 0, 0, "", "")
    none_of_three: usize = add_node(&nodes, "unary", "not", p_or_q_or_r, 0, 0, 0, 0, 0, "", "")
    nested: darray[usize] = [none_of_three]
    return NESTED_NEGATED_DISJUNCT_REJECTED if not proof_kernel_replay_goal_report(&nodes, &children, nested, not_q)
    not_p_or_q: usize = add_node(&nodes, "binary", "or", not_p, q, 0, 0, 0, 0, "", "")
    neither_disjunct: usize = add_node(&nodes, "unary", "not", not_p_or_q, 0, 0, 0, 0, 0, "", "")
    mixed: darray[usize] = [neither_disjunct]
    return NEGATED_DISJUNCT_DOUBLE_NEGATION_REJECTED if not proof_kernel_replay_goal_report(&nodes, &children, mixed, p)

    # The dual forms are not projections. A disjunction entails neither disjunct, and a negated
    # conjunction entails neither negated conjunct; admitting either would let the producer
    # record a disjunction as though it were a conjunct.
    either: darray[usize] = [p_or_q]
    return DISJUNCT_ADMITTED if proof_kernel_replay_goal_report(&nodes, &children, either, p)
    return DISJUNCT_NEGATION_ADMITTED if proof_kernel_replay_goal_report(&nodes, &children, either, not_p)
    return CONJUNCT_NEGATION_ADMITTED if proof_kernel_replay_goal_report(&nodes, &children, both, not_p)
    p_and_q_again: usize = add_node(&nodes, "binary", "and", p, q, 0, 0, 0, 0, "", "")
    not_p_and_q: usize = add_node(&nodes, "unary", "not", p_and_q_again, 0, 0, 0, 0, 0, "", "")
    not_both: darray[usize] = [not_p_and_q]
    return NEGATED_CONJUNCT_ADMITTED if proof_kernel_replay_goal_report(&nodes, &children, not_both, not_p)
    # Nor does the sign stop mattering once a negation has been walked through: `not (p and q)`
    # says nothing about `p`, and `not (p or q)` says nothing about `q`.
    return NEGATED_CONJUNCT_MEMBER_ADMITTED if proof_kernel_replay_goal_report(&nodes, &children, not_both, p)
    return NEGATED_DISJUNCT_MEMBER_ADMITTED if proof_kernel_replay_goal_report(&nodes, &children, neither, q)

    # The same projection backs the tactic layer's `assumption` action, so the split must be
    # visible there and the dual must stay refused there too.
    return CONJUNCT_TACTIC_REJECTED if not proof_kernel_replay_tactic_step(&nodes, &children, "assumption", true, false, true, both, p, both, p, 0, false, 0, false, 0, false, "")
    return NEGATED_CONJUNCT_TACTIC_ADMITTED if proof_kernel_replay_tactic_step(&nodes, &children, "assumption", true, false, true, not_both, not_p, not_both, not_p, 0, false, 0, false, 0, false, "")
    return 0
