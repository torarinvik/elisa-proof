# Explicit frame contracts let a modular call preserve a disjoint arithmetic fact.

struct Box:
    value: mutable i64
    other: mutable i64

def set_other(box: mutable Box&) -> void:
    changes box.other
    box.other <- 1

def caller_keeps_value_fact(box: mutable Box&, x: i64) -> i64:
    requires x >= 0
    ensure result == x
    preserves box.value
    set_other(box)
    return x
