def tuple_summary_source(value: i64) -> (known: bool, value: i64):
    ensures result.known
    ensures result.value == value
    return (true, value)

def shadowed_tuple_callee(value: i64) -> i64:
    ensures result == value
    tuple_summary_source: i64 = value
    summary = tuple_summary_source(value)
    return summary.value
