# Conditional postconditions are checked by exhaustive semantic case elimination.

def max_value(a: i64, b: i64) -> i64:
    ensure result >= a
    ensure result >= b
    return a if a > b else b

def min_value(a: i64, b: i64) -> i64:
    ensure result <= a
    ensure result <= b
    return a if a < b else b
