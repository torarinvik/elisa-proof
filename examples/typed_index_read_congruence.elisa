def typed_read_equal_at_direct_index(rows: array[usize, 8]&, cursor: i64) -> i64:
    requires cursor == 3
    ensure rows[cursor] == rows[3]
    return 0

def typed_read_equal_at_transitive_index(rows: array[usize, 8]&, first: i64, middle: i64, last: i64) -> i64:
    requires first == middle
    requires middle == last
    ensure rows[first] == rows[last]
    return 0
