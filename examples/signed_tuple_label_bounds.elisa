def make_pair(input: i16) -> (value: i16, other: i16):
    return (input, input)

def local_tuple_half(input: i16) -> i16:
    ensure result >= -16383 - 1
    ensure result <= 16383
    pair: (value: i16, other: i16) = make_pair(input)
    return pair.value / 2

def local_tuple_identity(input: i16) -> i16:
    ensure result >= -32767 - 1
    ensure result <= 32767
    pair: (value: i16, other: i16) = make_pair(input)
    return pair.value
