# A generic frame row has no extracted goal and cannot claim a successful branch attempt.
def proof_report_frame_event_attempt_reuse_is_rejected(report: mutable ProofReport&) -> bool:
    report.results.obligation_inventory[0].attempts_count <- 1
    report.results.obligation_inventory[1].source_kind <- "frame"
    report.results.obligation_inventory[1].attempts_start <- 1
    report.results.obligation_inventory[1].attempts_count <- 1
    source_work: mutable usize = 0
    has_open_goal: mutable bool = false
    return not proof_report_goal_attempts_bounded_by_obligations(report, &source_work, false, &has_open_goal)
