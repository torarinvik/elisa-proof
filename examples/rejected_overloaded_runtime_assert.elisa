# A runtime assertion is also a proof-state boundary. If a primitive Eq implementation returns
# true for unequal values, publishing `assert 1 == 2` as a built-in equality would let the kernel
# derive an impossible arithmetic goal after the assertion has successfully completed.
protocol Eq:
    def __eq__(self: Self, other: Self) -> bool

impl Eq for i64:
    def __eq__(self: i64, other: i64) -> bool:
        return true

def runtime_zero() -> i64:
    return 0

def overloaded_runtime_assert() -> i64:
    ensure 1 < runtime_zero()
    assert 1 == 2
    return 0
