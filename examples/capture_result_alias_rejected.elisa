def capture_result_missing_link(kind: u8, status: u8, saved: u8, classified: u8, output: u8) -> u8:
    requires kind <= 1 and status <= 4 or saved == 4
    requires classified <= 3 or output == 0
    ensure kind <= 1 and status <= 4 or result == 0
    return output

def capture_result_wrong_output(kind: u8, status: u8, classified: u8, output: u8) -> u8:
    requires kind <= 1 and status <= 4 or classified == 4
    requires classified <= 3 or output == 1
    ensure kind <= 1 and status <= 4 or result == 0
    return output

def capture_result_float_interval(code: f64) -> u8:
    requires code > 0
    requires code < 1
    ensure false
    return 0

def capture_result_unsigned_wrap(code: u8) -> u8:
    requires code == 255
    requires code + 1 == 0
    ensure false
    return 0

def capture_result_signed_wrap(code: i8) -> u8:
    requires code == 127
    requires code + 1 < 0
    ensure false
    return 0
