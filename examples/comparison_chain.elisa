# The difference engine chains comparisons only over atoms its affine form can name: one bare
# identifier. A collection's `count` is a field of a referenced binding, so `limit <= items.count`
# is invisible to it and `index < limit` cannot reach `index < items.count` -- the single most
# common bounds shape there is.
#
# Structural transitivity needs no atom at all: the middle term is matched with the same
# structural equality the kernel replays. It runs only for a goal the difference engine could not
# represent, so an ordinary comparison pays nothing for it.
def transitivity_into_a_field(items: darray[i64]&, a: usize, b: usize) -> usize:
    requires a < b
    requires b <= items.count
    ensure result < items.count
    return a

def bound_through_a_named_limit(items: darray[i64]&, limit: usize, index: usize) -> i64:
    requires limit <= items.count
    requires index < limit
    return items[index]

def bound_through_a_field_limit(items: darray[i64]&, span_count: usize, index: usize) -> i64:
    requires span_count <= items.count
    requires index < span_count
    return items[index]

# A `>`/`>=` fact is the same ascending step written backwards.
def mirrored_facts_chain(items: darray[i64]&, a: usize, b: usize) -> usize:
    requires b > a
    requires items.count >= b
    ensure result < items.count
    return a
