# A success summary must not be reused on an error arm: this fallback is not x + 1.
error RejectedCatchError:
    Bad

def rejected_catch_value(x: i64) -> i64 error[RejectedCatchError]:
    requires x >= 0
    ensure result == x + 1
    return x + 1

def rejected_catch_error_postcondition(x: i64) -> i64:
    requires x >= 0
    ensure result == x + 1
    return catch rejected_catch_value(x):
        value:
            value
        RejectedCatchError.Bad:
            0
