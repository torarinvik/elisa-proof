include "../build/snapshot/Elisa-compiler/elisacore_std/elisacore_runtime.elisa"
include "../build/snapshot/Elisa-compiler/src/parser/parser.elisa"
using Ast
include "../src/proof/kernel_replay/frame_policy_model.elisa"
include "../src/proof/replay/frame_source_places.elisa"
include "../src/proof/replay/frame_source_owners.elisa"
include "../src/proof/replay/frame_source_headers.elisa"

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    source: u8& = "def run(box: u8) -> void changes box.value preserves box.other:\n    pass\n"
    length: usize = 73
    tokens: mutable darray[Token] = frontend_tokenize(source, source)
    file: Ast::File = frontend_parser_parse_file(source, tokens)
    return 1 if file.errors.count != 0
    found = ElisaProofFrameSource::header_bounds(&file.top_decls, "run", 1, &tokens, source, length)
    return 2 if not found.known or found.start != 0 or tokens[found.end].kind != TokenKind.Colon
    return 3 if ElisaProofFrameSource::header_bounds(&file.top_decls, "run", 2, &tokens, source, length).known
    return 4 if ElisaProofFrameSource::header_bounds(&file.top_decls, "other", 1, &tokens, source, length).known
    original: Token = tokens[2]
    tokens[2].start <- 9999
    return 5 if ElisaProofFrameSource::header_bounds(&file.top_decls, "run", 1, &tokens, source, length).known
    tokens[2] <- original
    tokens[2].kind <- TokenKind.LBracket
    return 6 if ElisaProofFrameSource::header_bounds(&file.top_decls, "run", 1, &tokens, source, length).known
    tokens[2] <- original
    tokens[found.end].kind <- TokenKind.Newline
    return 7 if ElisaProofFrameSource::header_bounds(&file.top_decls, "run", 1, &tokens, source, length).known
    tokens[found.end].kind <- TokenKind.Colon
    tokens.push(tokens[0])
    return 8 if ElisaProofFrameSource::header_bounds(&file.top_decls, "run", 1, &tokens, source, length).known
    return 0
