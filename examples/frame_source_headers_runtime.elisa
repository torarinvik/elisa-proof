include "../build/snapshot/Elisa-compiler/elisacore_std/elisacore_runtime.elisa"
include "../build/snapshot/Elisa-compiler/src/parser/parser.elisa"
using Ast
include "../src/proof/kernel_replay/frame_policy_model.elisa"
include "../src/proof/replay/frame_source_places.elisa"
include "../src/proof/replay/frame_source_owners.elisa"
include "../src/proof/replay/frame_source_headers.elisa"
include "../src/proof/replay/frame_source_policy.elisa"
include "../src/proof/replay/frame_source_header_policy.elisa"

def check_policy(source: u8&, expected: bool, count: usize) -> bool can[Memory.Allocate, Abort.Panic]:
    tokens: darray[Token] = frontend_tokenize(source, source)
    file: Ast::File = frontend_parser_parse_file(source, tokens)
    return false if file.errors.count != 0
    policy = ElisaProofFrameSource::header_policy(&file.top_decls, "run", 1, &tokens, source, tokens[tokens.count - 1].start.usize())
    combined = ElisaProofFrameSource::source_policy(&file.top_decls, "run", 1, &tokens, source, tokens[tokens.count - 1].start.usize())
    return false if combined.known != expected or combined.clauses.count != count
    return false if policy.known != expected
    return policy.clauses.count == count

def check_combined(source: u8&, expected: bool, count: usize) -> bool can[Memory.Allocate, Abort.Panic]:
    tokens: darray[Token] = frontend_tokenize(source, source)
    file: Ast::File = frontend_parser_parse_file(source, tokens)
    return false if file.errors.count != 0
    result = ElisaProofFrameSource::source_policy(&file.top_decls, "run", 1, &tokens, source, tokens[tokens.count - 1].start.usize())
    return result.known == expected and result.clauses.count == count

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    source: u8& = "def run(box: u8) -> void changes box.value preserves box.other:\n    pass\n"
    length: usize = 73
    tokens: mutable darray[Token] = frontend_tokenize(source, source)
    file: Ast::File = frontend_parser_parse_file(source, tokens)
    return 1 if file.errors.count != 0
    found = ElisaProofFrameSource::header_bounds(&file.top_decls, "run", 1, &tokens, source, length)
    return 2 if not found.known or found.start != 0 or tokens[found.end].kind != TokenKind.Colon
    return 3 if ElisaProofFrameSource::header_bounds(&file.top_decls, "run", 2, &tokens, source, length).known
    return 4 if ElisaProofFrameSource::header_bounds(&file.top_decls, "other", 1, &tokens, source, length).known
    policy = ElisaProofFrameSource::header_policy(&file.top_decls, "run", 1, &tokens, source, length)
    return 9 if not policy.known or policy.parameter_count != 1 or policy.clauses.count != 2
    return 10 if policy.clauses[0].kind != "changes" or policy.clauses[0].place.field != "value" or policy.clauses[1].kind != "preserves" or policy.clauses[1].place.field != "other"
    return 11 if policy.clauses[0].position.offset >= policy.clauses[0].position.end_offset or policy.clauses[0].position.end_offset >= policy.clauses[1].position.offset
    original: Token = tokens[2]
    tokens[2].start <- 9999
    return 5 if ElisaProofFrameSource::header_bounds(&file.top_decls, "run", 1, &tokens, source, length).known
    tokens[2] <- original
    tokens[2].kind <- TokenKind.LBracket
    return 6 if ElisaProofFrameSource::header_bounds(&file.top_decls, "run", 1, &tokens, source, length).known
    tokens[2] <- original
    tokens[found.end].kind <- TokenKind.Newline
    return 7 if ElisaProofFrameSource::header_bounds(&file.top_decls, "run", 1, &tokens, source, length).known
    tokens[found.end].kind <- TokenKind.Colon
    tokens.push(tokens[0])
    return 8 if ElisaProofFrameSource::header_bounds(&file.top_decls, "run", 1, &tokens, source, length).known
    return 12 if not check_policy("def run(box: u8) -> void changes box, box.a.b.c preserves box.other:\n    pass\n", true, 3)
    return 13 if not check_policy("def run(box: u8) -> void changes foreign_box:\n    pass\n", false, 0)
    return 14 if not check_policy("def run(box: u8) -> void changes box preserves foreign_box:\n    pass\n", false, 0)
    return 15 if not check_policy("def run(box: u8) -> void changes box[0]:\n    pass\n", false, 0)
    return 16 if not check_policy("def run(box: u8) -> void changes box.a.b.c.d:\n    pass\n", false, 0)
    return 17 if not check_policy("def run(box: u8) -> void changes box + box:\n    pass\n", false, 0)
    return 18 if not check_policy("def run(box: u8) -> void can[Memory.Allocate] changes box ensure true:\n    pass\n", true, 1)
    return 19 if not check_policy("def run(box: u8) -> void :\n    pass\n", true, 0)
    combined_source: u8& = "def run(box: u8) -> void changes box.value:\n    preserves box.other\n    pass\n"
    combined_tokens: darray[Token] = frontend_tokenize(combined_source, combined_source)
    combined_file: Ast::File = frontend_parser_parse_file(combined_source, combined_tokens)
    return 20 if combined_file.errors.count != 0
    combined = ElisaProofFrameSource::source_policy(&combined_file.top_decls, "run", 1, &combined_tokens, combined_source, combined_tokens[combined_tokens.count - 1].start.usize())
    return 21 if not combined.known or combined.clauses.count != 2 or combined.clauses[0].kind != "changes" or combined.clauses[1].kind != "preserves" or combined.clauses[1].position.line != 2
    return 22 if not check_policy("def run(box: u8) -> u8 = box\n", false, 0)
    return 23 if not check_combined("def run(box: u8) -> void changes box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box:\n    preserves box\n", true, 65)
    return 24 if not check_combined("def run(box: u8) -> void changes box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box:\n    changes box\n", false, 0)
    return 25 if not check_combined("def run(box: u8) -> void changes box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box, box:\n    pass\n", false, 0)
    return 0
