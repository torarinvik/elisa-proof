# The conditional join must not overclaim. One arm leaves `t` negative, so the bound fails on
# that path; and a condition that reads a binding the arms rebind is read before the branch,
# so it cannot vouch for the value after it.

module RejectedConditionalJoin:
    def one_arm_negative(c: bool, a: i64) -> i64:
        requires a >= 0
        ensure result >= 0
        t: mutable i64 = 0
        if c:
            t <- a
        else:
            t <- 0 - 1
        return t

    def condition_on_rebound(x: i64) -> i64:
        requires x >= 0
        requires x <= 10
        ensure result <= 10
        t: mutable i64 = x
        if t <= 5:
            t <- t + 10
        else:
            t <- t - 1
        return t
