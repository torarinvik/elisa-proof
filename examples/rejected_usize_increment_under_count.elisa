def non_strict(values: darray[i64]&, i: usize) -> usize:
    requires i <= values.count
    ensure result > i
    return i + 1

def unguarded(i: u64) -> u64:
    ensure result > i
    return i + 1

def overshoot(values: darray[i64]&, i: usize) -> usize:
    requires i < values.count
    ensure result < values.count
    return i + 1
