def swap_values(xs: mutable darray[i64], i: usize, j: usize, a: i64, b: i64) -> i64:
    requires i < xs.count and j < xs.count and i < j and xs[i] == a and xs[j] == b
    ensure result == b
    t: i64 = xs[i]
    xs[i] <- xs[j]
    xs[j] <- t
    return xs[i]

def swap_second(xs: mutable darray[i64], i: usize, j: usize, a: i64, b: i64) -> i64:
    requires i < xs.count and j < xs.count and i < j and xs[i] == a and xs[j] == b
    ensure result == a
    t: i64 = xs[i]
    xs[i] <- xs[j]
    xs[j] <- t
    return xs[j]

def push_keeps(xs: mutable darray[i64]&, j: usize, x: i64) -> i64 can[Memory.Allocate]:
    requires j < xs.count and xs[j] == 3
    ensure result == 3
    xs.push(x)
    return xs[j]

def push_keeps_after_read(xs: mutable darray[i64]&, j: usize, x: i64) -> i64 can[Memory.Allocate]:
    requires j < xs.count and xs[j] == 3
    ensure result == 3
    y: i64 = xs[j]
    xs.push(x)
    return xs[j]
