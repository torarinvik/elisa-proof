def swap_values(xs: mutable darray[i64], i: usize, j: usize, a: i64, b: i64) -> i64:
    requires i < xs.count and j < xs.count and i < j and xs[i] == a and xs[j] == b
    ensure result == b
    t: i64 = xs[i]
    xs[i] <- xs[j]
    xs[j] <- t
    return xs[i]

def swap_second(xs: mutable darray[i64], i: usize, j: usize, a: i64, b: i64) -> i64:
    requires i < xs.count and j < xs.count and i < j and xs[i] == a and xs[j] == b
    ensure result == a
    t: i64 = xs[i]
    xs[i] <- xs[j]
    xs[j] <- t
    return xs[j]

def push_keeps(xs: mutable darray[i64]&, j: usize, x: i64) -> i64 can[Memory.Allocate]:
    requires j < xs.count and xs[j] == 3
    ensure result == 3
    xs.push(x)
    return xs[j]

def push_keeps_after_read(xs: mutable darray[i64]&, j: usize, x: i64) -> i64 can[Memory.Allocate]:
    requires j < xs.count and xs[j] == 3
    ensure result == 3
    y: i64 = xs[j]
    xs.push(x)
    return xs[j]

def compact(xs: mutable darray[i64]&, p: i64) -> usize:
    ensures result <= xs.count
    ensures forall i in 0..<result: xs[i] < p
    lo: mutable usize = 0
    k: mutable usize = 0
    while k < xs.count:
        invariant lo <= k
        invariant k <= xs.count
        invariant forall i in 0..<lo: xs[i] < p
        if xs[k] < p:
            xs[lo] <- xs[k]
            lo <- lo + 1
        k <- k + 1
    return lo

def step(xs: mutable darray[i64]&, p: i64, lo: usize, k: usize) -> usize:
    requires lo <= k and k < xs.count
    requires forall i in 0..<lo: xs[i] < p
    requires xs[k] < p
    ensures forall i in 0..<lo + 1: xs[i] < p
    xs[lo] <- xs[k]
    return lo

def partition(xs: mutable darray[i64]&, p: i64) -> usize:
    ensures result <= xs.count
    ensures forall i in 0..<result: xs[i] < p
    lo: mutable usize = 0
    k: mutable usize = 0
    while k < xs.count:
        invariant lo <= k
        invariant k <= xs.count
        invariant forall i in 0..<lo: xs[i] < p
        if xs[k] < p:
            t: i64 = xs[k]
            xs[k] <- xs[lo]
            xs[lo] <- t
            lo <- lo + 1
        k <- k + 1
    return lo
