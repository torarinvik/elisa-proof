# `not (x + y > 1000000)` is only `x + y <= 1000000`; it leaves room for `x + y + 1` to
# exceed the cap by one, so the successor bound must be refused.
def plain_capped(x: i64, y: i64) -> i64:
    requires x >= 1 and x <= 1000000 and y >= 1 and y <= 1000000
    ensure result <= 1000000
    return 1000000 if x + y > 1000000
    return x + y + 1
