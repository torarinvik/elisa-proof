global mutable permission_counter: i64 = 0
global mutable permission_values: i64[1] = [0]
global mutable permission_index: usize = 0

def read_counter() -> i64 can[Global.Read]:
    can Global{Read}:
        return permission_counter

def write_counter() -> void can[Global.Write]:
    can Global{Write}:
        permission_counter <- 1

def copy_counter() -> void can[Global.Read, Global.Write]:
    can Global{Read,Write}:
        permission_counter <- permission_counter

def shadow_counter(permission_counter: i64) -> i64:
    permission_counter

def local_shadow() -> i64:
    permission_counter: i64 = 2
    permission_counter

def block_shadow_then_global(flag: bool) -> i64 can[Global.Read]:
    if flag:
        permission_counter: i64 = 2
    can Global{Read}:
        return permission_counter

def forward_read() -> i64:
    can Global{Read}:
        return read_counter()

# The signature row is inferred from the tight local grant.
def inferred_read() -> i64:
    can Global{Read}:
        return permission_counter

# A fixed extent keeps the proof control independent of an unknown runtime bound.
def indexed_read(index: usize) -> i64 can[Global.Read]:
    requires index < 1
    can Global{Read}:
        return permission_values[index]

def indexed_write(index: usize) -> void can[Global.Write]:
    requires index < 1
    can Global{Write}:
        permission_values[index] <- 1

# Evaluating the subscript reads a second mutable global in addition to writing the array.
def indexed_write_reads_mutable_global_index() -> void can[Global.Read, Global.Write]:
    can Global{Read,Write}:
        if permission_index < 1:
            permission_values[permission_index] <- 1

# Acquiring an exclusive reference to global storage needs read and write authority.
def mutable_reference_acquisition() -> i64 can[Global.Read, Global.Write]:
    can Global{Read,Write}:
        borrowed: mutable i64& = &permission_counter
        return borrowed.i64()
