def three() -> usize:
    ensure result == 3
    return [1, 2, 3].count

def eight() -> usize:
    ensure result == 8
    return [1, 2, 3, 4, 5, 6, 7, 8].count

def local_three() -> bool:
    ensure result
    values: darray[i64] = [4, 5, 6]
    return values.count == 3

def table_walk() -> i64:
    table: darray[i64] = [10, 20, 30]
    total: mutable i64 = 0
    for i in 0..<3 |total, table|:
        total <- total + table[i]
    return total

def empty() -> usize:
    ensure result == 0
    return [].count
