# Same-tag identity is not disjoint: a tag cannot be negated merely because it was assumed.
const enum LifecycleState of u8:
    Startup = 0
    Initialized = 1

def rejected_same_enum_variant_negation(state: LifecycleState) -> bool:
    requires state is LifecycleState.Startup
    ensure result
    return not (state is LifecycleState.Startup)
