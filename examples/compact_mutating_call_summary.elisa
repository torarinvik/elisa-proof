# A compact decoder with several global-constant contracts exercises the bounded
# fact-snapshot headroom and the independently replayed summary at a mutating call.
module CompactSnapshot:
    public:
        const FIRST_VALID: usize = 56
        const FIRST_INVALID: usize = 57
        const COUNT_MISMATCH: usize = 58
        const VALID: u8 = 0
        const INVALID: u8 = 2
        const MISMATCH: u8 = 1
        const REJECTED: u8 = 3
        const MAX_STATUS: usize = 4

extend CompactSnapshot:
    def decode_status(
        encoded_failure: usize,
        failed_index: mutable usize&, failed_status: mutable u8&
    ) -> u8:
        ensure encoded_failure != FIRST_VALID or result == VALID
        ensure encoded_failure != FIRST_INVALID or result == INVALID
        ensure encoded_failure != COUNT_MISMATCH or result == MISMATCH
        ensure result != REJECTED or failed_index[0] == encoded_failure / 8
        return VALID if encoded_failure == FIRST_VALID
        return INVALID if encoded_failure == FIRST_INVALID
        return MISMATCH if encoded_failure == COUNT_MISMATCH
        return INVALID if encoded_failure > COUNT_MISMATCH
        status_code: usize = encoded_failure % 8
        return INVALID if status_code == 0 or status_code > MAX_STATUS
        failed_index[0] <- encoded_failure / 8
        failed_status[0] <- status_code.u8()
        REJECTED

    def wrapper_status(
        encoded_failure: usize,
        failed_index: mutable usize&, failed_status: mutable u8&
    ) -> u8:
        ensure encoded_failure != FIRST_VALID or result == VALID
        ensure encoded_failure != FIRST_INVALID or result == INVALID
        ensure encoded_failure != COUNT_MISMATCH or result == MISMATCH
        ensure result != REJECTED or failed_index[0] == encoded_failure / 8
        decode_status(encoded_failure, failed_index, failed_status)
