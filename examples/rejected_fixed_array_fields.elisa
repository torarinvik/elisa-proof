# A fixed-array field does not turn an out-of-range guard into a proof, and an extent
# that is not a literal-valued qualified constant supplies no count at all.
module Rack:
    public:
        const WIDTH: usize = 8
        const DOUBLE: usize = WIDTH * 2

        struct Row:
            cells: u32[Rack::WIDTH]
            flags: bool[Rack::WIDTH]

        struct Wide:
            cells: u32[Rack::DOUBLE]
            flags: bool[Rack::DOUBLE]

        def rejected_off_by_one(row: Row&, slot: usize) -> u32:
            requires slot <= WIDTH
            return row.cells[slot]

        def rejected_derived_extent(wide: Wide&, slot: usize) -> u32:
            requires slot < 1
            return wide.cells[slot]

        # Typing the element of a qualified-extent field does not prove a false contract.
        def rejected_flag(row: Row&, slot: usize) -> bool:
            requires slot < WIDTH
            ensure result == row.flags[slot]
            return not row.flags[slot]

        # A derived extent types no contract element either.
        def rejected_derived_flag(wide: Wide&) -> bool:
            ensure result == wide.flags[0]
            return wide.flags[0]
