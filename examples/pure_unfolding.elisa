# Pure function unfolding (BACKLOG D-04): small call-free helpers prove their callers without
# written contracts.
def is_digit(c: i64) -> bool:
    return c >= 48 and c <= 57

def digit_value(c: i64) -> i64:
    requires is_digit(c)
    ensures result >= 0 and result <= 9
    return c - 48

def twice(x: i64) -> i64:
    requires x >= 0 and x <= 1000
    return x + x

def bounded_twice(x: i64) -> i64:
    requires x >= 0 and x <= 100
    ensures result <= 200
    return twice(x)

def shift(c: i64) -> i64:
    return c - 48

def from_shift(c: i64) -> i64:
    requires c >= 0 and c <= 1000 and shift(c) >= 0 and shift(c) <= 9
    ensures result >= 48 and result <= 57
    return c

def is_space(c: usize) -> bool:
    return c == 32 or c == 9 or c == 13

# A loop guarded by a helper call: the arm that takes it carries the helper's disjunctive
# summary, which must not hide the loop range that proves the invariant.
def first_space(start: usize, stop: usize) -> usize:
    requires start <= stop
    ensures start <= result and result <= stop
    for index in start..<stop |found: usize = stop| -> found:
        invariant start <= found and found <= stop
        found <- index if found == stop and (is_space(index) or index == 3)
