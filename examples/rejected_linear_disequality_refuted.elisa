# Controls: a disequality the facts leave open is no contradiction, and a premise cannot
# refute itself.
module Diseq:
    public:
        def open_gap(x: i64, y: i64) -> bool:
            requires x >= -1000
            requires x <= 1000
            requires y >= x
            requires y <= x + 1
            requires x != y
            ensure false
            return true

        def self_only(x: i64, y: i64) -> bool:
            requires x >= -1000
            requires x <= 1000
            requires y >= -1000
            requires y <= 1000
            requires not (x == y)
            ensure x < y
            return true
