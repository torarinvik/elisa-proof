# The extension-owned constant is 2; this upper bound must remain unproven.
module WbRuntime:
    const PROOF_SCOPE: u8 = 0

extend WbRuntime:
    public:
        const DUE_INTERVAL: u8 = 2

        def interval_status_wrong_bound(value: u32) -> u8:
            ensure result <= 1
            period: u64 = value.u64()
            return WbRuntime::DUE_INTERVAL
