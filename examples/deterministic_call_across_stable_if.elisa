module DeterministicCallStableIf:
    public:
        def nonnegative_identity(value: i64) -> i64:
            requires value >= 0
            ensure result >= 0
            value

        def conditional_call_in_return(value: i64, enabled: bool) -> i64:
            requires value >= 0
            ensure result >= 0
            if enabled:
                return nonnegative_identity(value)
            0

        def call_after_early_return(value: i64, disabled: bool) -> i64:
            requires value >= 0
            ensure result >= 0
            return 0 if disabled
            nonnegative_identity(value)

        def call_after_branch_local(value: i64, enabled: bool) -> i64:
            requires value >= 0
            ensure result >= 0
            if enabled:
                chosen: i64 = value
                return nonnegative_identity(chosen)
            0

        def call_after_scoped_local(value: i64, enabled: bool) -> i64:
            requires value >= 0
            ensure result >= 0
            if enabled:
                ignored: i64 = value
            nonnegative_identity(value)

module DeterministicCallGlobalConstant:
    public:
        const VALUE: i64 = 10

        def identity(value: i64) -> i64:
            ensure result == value
            value

        def constant_argument_call() -> i64:
            ensure result == VALUE
            identity(VALUE)

        def nested_call_in_binary_argument(value: i64) -> i64:
            requires value >= 0
            requires value <= VALUE
            ensure result >= 0
            identity(VALUE - identity(value))

module DeterministicCallQualifiedDuplicate:
    public:
        module Fade:
            const FULL: i64 = 1000

            def weight(frame: i64) -> i64:
                ensure result == frame
                frame

        module Gate:
            def weight(fade: i64) -> i64:
                requires fade >= 0
                ensure result == fade
                fade

        def qualified_constant_call() -> i64:
            ensure result >= 0
            Gate::weight(1000)
