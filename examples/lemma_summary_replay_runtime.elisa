# Adversarial executable replay harness: corrupt the normalized argument bound to a consumed
# lemma summary after checking. Independent replay must reject the caller certificate rather than
# accepting an arbitrary fact merely because the named lemma itself has valid certificates.
include "../../Elisa-compiler/src/semantic/semantic.elisa"
include "../src/proof/kernel_core.elisa"
include "../src/proof/model.elisa"
include "../src/proof/kernel.elisa"
include "../src/proof/expr.elisa"
include "../src/proof/linear.elisa"
include "../src/proof/resources.elisa"
include "../src/proof/check.elisa"
include "../src/proof/kernel_replay.elisa"
include "../src/proof/replay.elisa"

using Ast
using ElisaProof

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    position: Ast::Pos = Ast::pos_at_line(1)
    text: sview = "def identity(x: i64) -> i64:\n    requires x >= 0\n    ensure result == x\n    return x\n\ndef use_identity() -> i64:\n    ensure result == 2\n    return identity(2)\n\nlemma scalar_fact(x: i64):\n    requires x >= 0\n    ensure x + 0 == x\n    assert x + 0 == x\n\ndef use() -> void:\n    assert 2 + 0 == 2 by:\n        scalar_fact(2)\n"
    source: mutable darray[u8] = []
    for index in 0..<sview_len(text) |index, text, source|:
        source.push(sview_at(text, index))
    source.push(0)
    file: Ast::File = frontend_parse(&source[0])
    report: mutable ProofReport = proof_empty_report()
    proof_check(file, &report)
    proof_replay_certificates(&report)
    return 1 if report.replay_gaps != 0 or report.fact_trace_summary_values.count == 0

    summary_trace: mutable usize = report.fact_traces.count
    for index in 0..<report.fact_traces.count |index, report, summary_trace|:
        if report.fact_traces[index].kind == "lemma-summary":
            summary_trace <- index
            break
    return 2 if summary_trace >= report.fact_traces.count
    return 4 if not proof_replay_fact_trace_entry(&report, summary_trace)

    lemma_binding: usize = report.fact_traces[summary_trace].summary_bindings_start
    report.fact_trace_summary_values[lemma_binding] <- Ast::Expr.IntLit(0 - 1, position)
    return 3 if proof_replay_fact_trace_entry(&report, summary_trace)
    report.fact_trace_summary_values[lemma_binding] <- Ast::Expr.IntLit(2, position)
    return 5 if not proof_replay_fact_trace_entry(&report, summary_trace)

    # Keep the source trace intact but replace its kernel root with another well-formed term.
    # Replay must reject the disagreement before either representation can be used as authority.
    kernel_root: usize = report.fact_traces[summary_trace].kernel_expression
    saved_node: ElisaProofKernelCore::ProofKernelNode = report.kernel_nodes[kernel_root]
    report.kernel_nodes[kernel_root] <- ElisaProofKernelCore::ProofKernelNode{kind: "int", operator: "", left: 0, right: 0, auxiliary: 0, children_start: 0, children_count: 0, value: 2, name: "", secondary_name: ""}
    return 6 if proof_replay_fact_trace_entry(&report, summary_trace)
    report.kernel_nodes[kernel_root] <- saved_node
    return 7 if not proof_replay_fact_trace_entry(&report, summary_trace)

    # A hidden payload on an otherwise matching node is malformed canonical encoding. Boundary
    # facts must pass full arena admission too, not just source/kernel shape correspondence.
    report.kernel_nodes[kernel_root] <- ElisaProofKernelCore::ProofKernelNode{kind: saved_node.kind, operator: saved_node.operator, left: saved_node.left, right: saved_node.right, auxiliary: saved_node.auxiliary, children_start: saved_node.children_start, children_count: saved_node.children_count, value: 1, name: saved_node.name, secondary_name: saved_node.secondary_name}
    return 8 if proof_replay_fact_trace_entry(&report, summary_trace)
    report.kernel_nodes[kernel_root] <- saved_node
    return 9 if not proof_replay_fact_trace_entry(&report, summary_trace)

    function_trace: mutable usize = report.fact_traces.count
    for index in 0..<report.fact_traces.count |index, report, function_trace|:
        if report.fact_traces[index].kind == "function-summary":
            function_trace <- index
            break
    return 10 if function_trace >= report.fact_traces.count or not proof_replay_fact_trace_entry(&report, function_trace)
    function_binding: usize = report.fact_traces[function_trace].summary_bindings_start
    report.fact_trace_summary_values[function_binding] <- Ast::Expr.IntLit(0 - 1, position)
    return 11 if proof_replay_fact_trace_entry(&report, function_trace)
    report.fact_trace_summary_values[function_binding] <- Ast::Expr.IntLit(2, position)
    return 12 if not proof_replay_fact_trace_entry(&report, function_trace)
    return 0
