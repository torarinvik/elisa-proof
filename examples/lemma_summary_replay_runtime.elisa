# Adversarial executable replay harness: corrupt the normalized argument bound to a consumed
# lemma summary after checking. Independent replay must reject the caller certificate rather than
# accepting an arbitrary fact merely because the named lemma itself has valid certificates.
include "../../Elisa-compiler/src/semantic/semantic.elisa"
include "../src/proof/kernel_core.elisa"
include "../src/proof/model.elisa"
include "../src/proof/kernel.elisa"
include "../src/proof/expr.elisa"
include "../src/proof/linear.elisa"
include "../src/proof/resources.elisa"
include "../src/proof/check.elisa"
include "../src/proof/kernel_replay.elisa"
include "../src/proof/replay.elisa"

using Ast
using ElisaProof

const MALFORMED_PROVENANCE_INDEX_CRASHED: i64 = 13
const CYCLIC_PROVENANCE_INDEX_HUNG: i64 = 14
const DEEP_REPLAY_INPUT_REJECTED: i64 = 18
const DEEP_REPLAY_INPUT_LIMIT: usize = 128

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    position: Ast::Pos = Ast::pos_at_line(1)
    text: sview = "def identity(x: i64) -> i64:\n    requires x >= 0\n    ensure result == x\n    return x\n\ndef use_identity() -> i64:\n    ensure result == 2\n    return identity(2)\n\nlemma scalar_fact(x: i64):\n    requires x >= 0\n    ensure x + 0 == x\n    assert x + 0 == x\n\ndef use() -> void:\n    assert 2 + 0 == 2 by:\n        scalar_fact(2)\n"
    source: mutable darray[u8] = []
    for index in 0..<sview_len(text) |index, text, source|:
        source.push(sview_at(text, index))
    source.push(0)
    file: Ast::File = frontend_parse(&source[0])
    report: mutable ProofReport = proof_empty_report()
    proof_check(file, &report)
    proof_replay_certificates(&report)
    return 1 if report.replay_gaps != 0 or report.fact_trace_summary_values.count == 0

    # Revalidation must bind a certificate to the exact attempt index that emitted it. Matching
    # some other attempt's goal metadata is insufficient: that can substitute a proof carrying a
    # different local context for the certificate selected by a source summary.
    return 19 if report.certificates.count < 2
    first_certificate_attempt: mutable usize = report.goal_attempts.count
    for index in 0..<report.goal_attempts.count |index, report, first_certificate_attempt|:
        if report.goal_attempts[index].has_certificate and report.goal_attempts[index].certificate_index == 0:
            first_certificate_attempt <- index
            break
    return 20 if first_certificate_attempt >= report.goal_attempts.count
    original_attempt: ProofGoalAttempt = report.goal_attempts[first_certificate_attempt]
    forged_attempt: ProofGoalAttempt = ProofGoalAttempt{goal: original_attempt.goal, budget_exhausted: original_attempt.budget_exhausted, facts_start: original_attempt.facts_start, facts_count: original_attempt.facts_count, kernel_goal: original_attempt.kernel_goal, kernel_facts_start: original_attempt.kernel_facts_start, kernel_facts_count: original_attempt.kernel_facts_count, line: original_attempt.line, name: original_attempt.name, rule: original_attempt.rule, proven: original_attempt.proven, has_certificate: original_attempt.has_certificate, certificate_index: report.certificates.count}
    report.goal_attempts[first_certificate_attempt] <- forged_attempt
    return 25 if proof_replay_attempt_certificate_replayed(report, report.goal_attempts[first_certificate_attempt])
    proof_replay_certificates(&report)
    return 21 if report.certificates[0].replayed
    report.goal_attempts[first_certificate_attempt] <- original_attempt
    proof_replay_certificates(&report)
    return 22 if report.replay_gaps != 0 or report.replayed != report.certificates.count

    # The source AST mirror is presentation data, but it must still denote the kernel root.
    # Replacing only the attempt mirror must not make a valid certificate appear to prove a
    # different displayed goal.
    forged_goal_attempt: ProofGoalAttempt = ProofGoalAttempt{goal: Ast::Expr.IntLit(987654321, position), budget_exhausted: original_attempt.budget_exhausted, facts_start: original_attempt.facts_start, facts_count: original_attempt.facts_count, kernel_goal: original_attempt.kernel_goal, kernel_facts_start: original_attempt.kernel_facts_start, kernel_facts_count: original_attempt.kernel_facts_count, line: original_attempt.line, name: original_attempt.name, rule: original_attempt.rule, proven: original_attempt.proven, has_certificate: original_attempt.has_certificate, certificate_index: original_attempt.certificate_index}
    report.goal_attempts[first_certificate_attempt] <- forged_goal_attempt
    return 26 if proof_replay_attempt_certificate_replayed(report, report.goal_attempts[first_certificate_attempt])
    proof_replay_certificates(&report)
    return 23 if report.certificates[0].replayed
    report.goal_attempts[first_certificate_attempt] <- original_attempt
    proof_replay_certificates(&report)
    return 24 if report.replay_gaps != 0 or report.replayed != report.certificates.count

    summary_trace: mutable usize = report.fact_traces.count
    for index in 0..<report.fact_traces.count |index, report, summary_trace|:
        if report.fact_traces[index].kind == "lemma-summary":
            summary_trace <- index
            break
    return 2 if summary_trace >= report.fact_traces.count
    return 4 if not proof_replay_fact_trace_entry(&report, summary_trace)

    lemma_binding: usize = report.fact_traces[summary_trace].summary_bindings_start
    report.fact_trace_summary_values[lemma_binding] <- Ast::Expr.IntLit(0 - 1, position)
    return 3 if proof_replay_fact_trace_entry(&report, summary_trace)
    report.fact_trace_summary_values[lemma_binding] <- Ast::Expr.IntLit(2, position)
    return 5 if not proof_replay_fact_trace_entry(&report, summary_trace)

    # Keep the source trace intact but replace its kernel root with another well-formed term.
    # Replay must reject the disagreement before either representation can be used as authority.
    kernel_root: usize = report.fact_traces[summary_trace].kernel_expression
    saved_node: ElisaProofKernelCore::ProofKernelNode = report.kernel_nodes[kernel_root]
    report.kernel_nodes[kernel_root] <- ElisaProofKernelCore::ProofKernelNode{kind: "int", operator: "", left: 0, right: 0, auxiliary: 0, children_start: 0, children_count: 0, value: 2, name: "", secondary_name: ""}
    return 6 if proof_replay_fact_trace_entry(&report, summary_trace)
    report.kernel_nodes[kernel_root] <- saved_node
    return 7 if not proof_replay_fact_trace_entry(&report, summary_trace)

    # A hidden payload on an otherwise matching node is malformed canonical encoding. Boundary
    # facts must pass full arena admission too, not just source/kernel shape correspondence.
    report.kernel_nodes[kernel_root] <- ElisaProofKernelCore::ProofKernelNode{kind: saved_node.kind, operator: saved_node.operator, left: saved_node.left, right: saved_node.right, auxiliary: saved_node.auxiliary, children_start: saved_node.children_start, children_count: saved_node.children_count, value: 1, name: saved_node.name, secondary_name: saved_node.secondary_name}
    return 8 if proof_replay_fact_trace_entry(&report, summary_trace)
    report.kernel_nodes[kernel_root] <- saved_node
    return 9 if not proof_replay_fact_trace_entry(&report, summary_trace)

    function_trace: mutable usize = report.fact_traces.count
    for index in 0..<report.fact_traces.count |index, report, function_trace|:
        if report.fact_traces[index].kind == "function-summary":
            function_trace <- index
            break
    return 10 if function_trace >= report.fact_traces.count or not proof_replay_fact_trace_entry(&report, function_trace)
    function_binding: usize = report.fact_traces[function_trace].summary_bindings_start
    report.fact_trace_summary_values[function_binding] <- Ast::Expr.IntLit(0 - 1, position)
    return 11 if proof_replay_fact_trace_entry(&report, function_trace)
    report.fact_trace_summary_values[function_binding] <- Ast::Expr.IntLit(2, position)
    return 12 if not proof_replay_fact_trace_entry(&report, function_trace)

    # The provenance index is an optimization over the authoritative trace. A malformed parallel
    # array must fall back to the trace scan, and a cyclic next-link must terminate conservatively.
    report.fact_trace_index_hashes.clear()
    fallback_origin: (known: bool, kind: sview, line: u32, name: sview, dependency: sview, premises_count: usize) = proof_replay_fact_origin(report, report.fact_traces[summary_trace].expression, report.fact_traces[summary_trace].name)
    return MALFORMED_PROVENANCE_INDEX_CRASHED if not fallback_origin.known
    return MALFORMED_PROVENANCE_INDEX_CRASHED if not proof_replay_fact_trace_entry(&report, summary_trace)
    deep_expression: mutable Ast::Expr = report.fact_traces[summary_trace].expression
    deep_depth: mutable usize = 0
    while deep_depth < DEEP_REPLAY_INPUT_LIMIT |deep_expression, deep_depth, position|:
        deep_expression <- Ast::Expr.Paren(deep_expression, position)
        deep_depth <- deep_depth + 1
    deep_origin: (known: bool, kind: sview, line: u32, name: sview, dependency: sview, premises_count: usize) = proof_replay_fact_origin(report, deep_expression, report.fact_traces[summary_trace].name)
    return DEEP_REPLAY_INPUT_REJECTED if deep_origin.known
    for index in 0..<report.fact_trace_next_indices.count |index, report|:
        report.fact_trace_next_indices[index] <- index
    cyclic_origin: (known: bool, kind: sview, line: u32, name: sview, dependency: sview, premises_count: usize) = proof_replay_fact_origin(report, Ast::Expr.IntLit(987654321, position), report.fact_traces[summary_trace].name)
    return CYCLIC_PROVENANCE_INDEX_HUNG if cyclic_origin.known

    # Rechecking through the public API must start a fresh transaction. Otherwise the second
    # pass would retain the first pass's certificates and replay indexes, producing a report that
    # depends on how many times the caller invoked the checker.
    expected_declarations: u32 = report.declarations
    expected_obligations: u32 = report.obligations
    proof_check(file, &report)
    return 15 if report.declarations != expected_declarations or report.obligations != expected_obligations
    proof_replay_certificates(&report)
    return 16 if report.replay_gaps != 0 or report.replayed != report.certificates.count
    proof_replay_certificates(&report)
    return 17 if report.replay_gaps != 0 or report.replayed != report.certificates.count
    return 0
