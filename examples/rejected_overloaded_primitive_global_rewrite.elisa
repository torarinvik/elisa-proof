# Global scalar constants receive the same operator-dispatch audit as parameters and locals.
# Otherwise a custom primitive Eq implementation could make constant equality look like
# Leibniz equality to the proof kernel.
const left: i64 = 1
const right: i64 = 1

protocol Eq:
    def __eq__(self: Self, other: Self) -> bool

impl Eq for i64:
    def __eq__(self: i64, other: i64) -> bool:
        return self != other

def overloaded_global_rewrite() -> i64:
    requires left == right
    ensure right == left
    return 0
