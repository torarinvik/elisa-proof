# Regression-only extern signatures: no native body or no-retention guarantee.
extern opaque_tick(value: u8) -> u8 can[Unsafe.RawExtern]
extern opaque_mutate(context: mutable void&?) -> u8 can[Unsafe.RawExtern]

def bounded_scalar_extern_result() -> u8 can[Unsafe.RawExtern]:
    ensure result <= 255
    trusted Unsafe.RawExtern:
        return opaque_tick(1)

def nullable_context_after_call(context: mutable void&?) -> u8 can[Unsafe.RawExtern]:
    ensure context != null or result == 0
    return 0 if context == null
    status: mutable u8 = 0
    trusted Unsafe.RawExtern:
        status <- opaque_mutate(context)
    return 1

def rejected_unknown_extern_result_is_zero() -> u8 can[Unsafe.RawExtern]:
    ensure result == 0
    trusted Unsafe.RawExtern:
        return opaque_tick(1)

def rejected_null_context_succeeds(context: mutable void&?) -> u8 can[Unsafe.RawExtern]:
    ensure result == 1
    return 0 if context == null
    trusted Unsafe.RawExtern:
        return opaque_mutate(context)
