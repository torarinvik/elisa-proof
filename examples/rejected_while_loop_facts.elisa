# G75's soundness side: keeping facts over bindings a `while` body leaves alone must not keep
# facts over a binding it writes, inside the body or after the loop.

module RejectedWhileLoopFacts:
    public:
        def at_most_zero(x: i64) -> i64:
            requires x <= 0
            ensure result == x
            return x

        # `last == 0` holds before the loop only; the body rewrites `last`, so after the loop
        # it may be any value `t` took (1 when `end` is 2).
        def written_binding_loses_its_fact_after_the_loop(end: i64) -> i64:
            requires end >= 0
            t: mutable i64 = 0
            last: mutable i64 = 0
            while t < end:
                invariant t >= 0
                last <- t
                t <- t + 1
            return at_most_zero(last)

        # The same fact inside the body: `last` is 0 on the first iteration only.
        def written_binding_loses_its_fact_in_the_body(end: i64) -> i64:
            requires end >= 0
            t: mutable i64 = 0
            last: mutable i64 = 0
            while t < end:
                invariant t >= 0
                seen: i64 = at_most_zero(last)
                last <- t + seen
                t <- t + 1
            return t

        # A push copies its argument without lending it, but it still grows the collection:
        # `out.count == 0` before the loop says nothing about the count after it.
        def pushed_collection_still_grows(end: i64) -> i64:
            requires end >= 0
            out: mutable darray[i64] = []
            t: mutable i64 = 0
            while t < end:
                invariant t >= 0
                out.push(t)
                t <- t + 1
            return at_most_zero(out.count.i64())
