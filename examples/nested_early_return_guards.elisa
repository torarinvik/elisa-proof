def nested_if_guard(values: darray[i64]&, index: usize) -> i64:
    requires index >= 0
    if index >= values.count:
        return 0
    return values[index]

def guard_nested_in_if(values: darray[i64]&, index: usize, enabled: bool) -> i64:
    requires index >= 0
    if enabled:
        return 0 if index >= values.count
        return values[index]
    return 0

def nested_loop_guard(values: darray[i64]&, index: usize) -> i64:
    requires index >= 0
    for slot in 0..<1:
        return 0 if index >= values.count
        return values[index]
    return 0

def nested_loop_guard_false_control(values: darray[i64]&, index: usize) -> i64:
    requires index >= 0
    for slot in 0..<1:
        return values[index]
    return 0
    return 0
