# A constructor belonging to another enum cannot complete this enum's match coverage.
enum MatchCoverageTarget:
    First
    Second

enum MatchCoverageOther:
    Other

def wrong_constructor_is_not_exhaustive(value: MatchCoverageTarget) -> bool:
    ensure value is MatchCoverageTarget.First or value is MatchCoverageTarget.Second
    match value:
        MatchCoverageTarget.First:
            pass
        MatchCoverageOther.Other:
            pass
    return true
