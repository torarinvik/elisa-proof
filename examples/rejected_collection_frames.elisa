def swap_aliased(xs: mutable darray[i64], i: usize, j: usize, k: usize) -> i64:
    requires i < xs.count and j < xs.count and k < xs.count and i < j and xs[k] == 7
    ensure result == 7
    t: i64 = xs[i]
    xs[i] <- xs[j]
    xs[j] <- t
    return xs[k]

def push_count_stale(xs: mutable darray[i64]&, x: i64) -> usize can[Memory.Allocate]:
    requires xs.count == 3
    ensure result == 3
    xs.push(x)
    return xs.count

def compact_unguarded(xs: mutable darray[i64]&, p: i64) -> usize:
    ensures forall i in 0..<result: xs[i] < p
    lo: mutable usize = 0
    k: mutable usize = 0
    while k < xs.count:
        invariant lo <= k
        invariant k <= xs.count
        invariant forall i in 0..<lo: xs[i] < p
        if xs[k] < p:
            xs[lo] <- xs[k]
        lo <- lo + 1
        k <- k + 1
    return lo

def partition_inverted(xs: mutable darray[i64]&, p: i64) -> usize:
    ensures result <= xs.count
    ensures forall i in 0..<result: xs[i] < p
    lo: mutable usize = 0
    k: mutable usize = 0
    while k < xs.count:
        invariant lo <= k
        invariant k <= xs.count
        invariant forall i in 0..<lo: xs[i] < p
        if xs[k] >= p:
            t: i64 = xs[k]
            xs[k] <- xs[lo]
            xs[lo] <- t
            lo <- lo + 1
        k <- k + 1
    return lo
