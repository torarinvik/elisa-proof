def swap_aliased(xs: mutable darray[i64], i: usize, j: usize, k: usize) -> i64:
    requires i < xs.count and j < xs.count and k < xs.count and i < j and xs[k] == 7
    ensure result == 7
    t: i64 = xs[i]
    xs[i] <- xs[j]
    xs[j] <- t
    return xs[k]

def push_count_stale(xs: mutable darray[i64]&, x: i64) -> usize can[Memory.Allocate]:
    requires xs.count == 3
    ensure result == 3
    xs.push(x)
    return xs.count

def compact_unguarded(xs: mutable darray[i64]&, p: i64) -> usize:
    ensures forall i in 0..<result: xs[i] < p
    lo: mutable usize = 0
    k: mutable usize = 0
    while k < xs.count:
        invariant lo <= k
        invariant k <= xs.count
        invariant forall i in 0..<lo: xs[i] < p
        if xs[k] < p:
            xs[lo] <- xs[k]
        lo <- lo + 1
        k <- k + 1
    return lo

def partition_inverted(xs: mutable darray[i64]&, p: i64) -> usize:
    ensures result <= xs.count
    ensures forall i in 0..<result: xs[i] < p
    lo: mutable usize = 0
    k: mutable usize = 0
    while k < xs.count:
        invariant lo <= k
        invariant k <= xs.count
        invariant forall i in 0..<lo: xs[i] < p
        if xs[k] >= p:
            t: i64 = xs[k]
            xs[k] <- xs[lo]
            xs[lo] <- t
            lo <- lo + 1
        k <- k + 1
    return lo

def order_pair_far(xs: mutable darray[i64]&, k: usize) -> i64:
    requires k + 1 < xs.count
    requires xs[k + 1] < xs[k]
    xs[k + 1] <- xs[k]
    return xs[k + 5]

# The shift reaches the write: `xs[i + 1]` for i = lo reads the cell `xs[lo + 1]`.
def shifted_reaches_write(xs: mutable darray[i64]&, lo: usize, n: usize) -> void:
    requires lo + 1 < n
    requires n < xs.count
    requires forall i in lo..<n: xs[i + 1] <= 7
    ensures forall i in lo..<n: xs[i + 1] <= 7
    xs[lo + 1] <- 9

# A shift by a variable is not a literal: `xs[i + j]` may land on `k`.
def shifted_by_variable(xs: mutable darray[i64]&, j: usize, k: usize, hi: usize, n: usize) -> void:
    requires hi <= k
    requires k < xs.count
    requires hi <= n
    requires n + j <= xs.count
    requires forall i in hi..<n: xs[i + j] <= 7
    ensures forall i in hi..<n: xs[i + j] <= 7
    xs[k] <- 9
