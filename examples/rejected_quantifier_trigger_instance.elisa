# The trigger is absent, captured by the quantified binder name, or outside the range.
def trigger_identity(value: i64) -> i64:
    ensure result == value
    return value

def trigger_free_search_is_refused(n: i64, limit: i64) -> i64:
    requires n > 0
    requires forall index in 0..<n: index <= limit
    ensure limit >= 0
    return n

def captured_trigger_is_refused(index: i64, n: i64, limit: i64) -> i64:
    requires index >= 0 and index < n
    requires forall index in 0..<n: index <= limit
    ensure index <= limit
    return index

def nested_call_capture_is_refused(index: i64, n: i64, limit: i64) -> i64:
    requires index >= 0 and index < n
    requires forall index in 0..<n: index <= limit
    requires trigger_identity(index) >= 0 and trigger_identity(index) < n
    ensure trigger_identity(index) <= limit
    return index

def nested_array_capture_is_refused(values: array[i64, 8]&, index: i64, limit: i64) -> i64:
    requires index >= 0 and index < 8
    requires forall index in 0..<8: index <= limit
    requires values[index] >= 0 and values[index] < 8
    ensure values[index] <= limit
    return index

def out_of_range_trigger_is_refused(n: i64, limit: i64) -> i64:
    requires n > 0
    requires forall index in 0..<n: index <= limit
    ensure n <= limit
    return n
