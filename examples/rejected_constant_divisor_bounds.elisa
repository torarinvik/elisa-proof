module RejectedConstantDivisorBounds:
    public:
        # Control: without a sign on the dividend, the quotient is not bounded by it.

        def halve(a: i64) -> i64:
            requires a >= -1000000
            requires a <= 1000000
            ensure result <= a
            return a / 2

        # The remainder by 10 reaches 9, not only 8.
        def digit(a: i64) -> i64:
            requires a >= 0
            requires a <= 1000000
            ensure result <= 8
            return a % 10

        # Pulling halfway toward `-l` does not stay below `d`.
        def pull_toward(d: i64, l: i64) -> i64:
            requires l >= 0
            requires l <= 1000
            requires d >= -1000
            requires d <= 1000
            requires d < -l
            ensure result <= d
            return -l - (-l - d) / 2
