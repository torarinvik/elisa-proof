def unsigned_prefix_cursor(start: usize, end: usize, step: usize) -> usize:
    requires start <= end
    requires step <= end - start
    ensure result >= start
    ensure result <= end
    return start + step

def unsigned_suffix_cursor(start: usize, end: usize, step: usize) -> usize:
    requires start <= end
    requires step <= end - start
    ensure result >= start
    ensure result <= end
    return end - step

def unsigned_byte_prefix(start: u8, end: u8, step: u8) -> u8:
    requires start <= end
    requires step <= end - start
    ensure start <= result
    ensure end >= result
    return start + step

def unsigned_byte_suffix(start: u8, end: u8, step: u8) -> u8:
    requires start <= end
    requires step <= end - start
    ensure start <= result
    ensure end >= result
    return end - step

def rejected_span_missing_step_bound(start: usize, end: usize, step: usize) -> usize:
    requires start <= end
    ensure result <= end
    return start + step

def rejected_span_missing_order(start: u8, end: u8, step: u8) -> u8:
    requires step <= end - start
    ensure result <= end
    return start + step

def rejected_span_other_step(start: usize, end: usize, step: usize, other: usize) -> usize:
    requires start <= end
    requires step <= end - start
    ensure result <= end
    return start + other

def rejected_signed_span(start: i64, end: i64, step: i64) -> i64:
    requires start <= end
    requires step <= end - start
    ensure result >= start
    return start + step

def rejected_span_stale_cursor(start: usize, end: usize, step: usize) -> usize:
    requires start <= end
    requires step <= end - start
    ensure result <= end
    cursor: mutable usize = start
    cursor <- end + 1
    return cursor + step
