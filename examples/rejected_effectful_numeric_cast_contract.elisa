# A primitive cast must not hide an effectful call in its receiver.
def effectful_status(source: mutable u8) -> u8:
    changes source
    source <- source + 1
    return source

def rejected_effectful_status_cast(source: mutable u8) -> usize:
    ensure result == effectful_status(source).usize()
    return effectful_status(source).usize()
