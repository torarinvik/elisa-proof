def step(x: i64) -> i64:
    requires x >= 0
    requires x <= 100
    ensure result >= 0
    ensure result <= 100
    ensure result <= x or result == 0
    return x if x < 50 else 0

# 40 statements is outside the call-summary window: bounded refusal, never a proof.
def dispatch_too_long(x: i64) -> i64:
    requires x >= 0
    requires x <= 100
    ensure result >= 0
    ensure result <= 100
    v0: i64 = step(x)
    v1: i64 = step(v0)
    v2: i64 = step(v1)
    v3: i64 = step(v2)
    v4: i64 = step(v3)
    v5: i64 = step(v4)
    v6: i64 = step(v5)
    v7: i64 = step(v6)
    v8: i64 = step(v7)
    v9: i64 = step(v8)
    v10: i64 = step(v9)
    v11: i64 = step(v10)
    v12: i64 = step(v11)
    v13: i64 = step(v12)
    v14: i64 = step(v13)
    v15: i64 = step(v14)
    v16: i64 = step(v15)
    v17: i64 = step(v16)
    v18: i64 = step(v17)
    v19: i64 = step(v18)
    v20: i64 = step(v19)
    v21: i64 = step(v20)
    v22: i64 = step(v21)
    v23: i64 = step(v22)
    v24: i64 = step(v23)
    v25: i64 = step(v24)
    v26: i64 = step(v25)
    v27: i64 = step(v26)
    v28: i64 = step(v27)
    v29: i64 = step(v28)
    v30: i64 = step(v29)
    v31: i64 = step(v30)
    v32: i64 = step(v31)
    v33: i64 = step(v32)
    v34: i64 = step(v33)
    v35: i64 = step(v34)
    v36: i64 = step(v35)
    v37: i64 = step(v36)
    v38: i64 = step(v37)
    return v38
