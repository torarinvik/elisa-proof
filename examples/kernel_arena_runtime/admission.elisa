# Malformed arena admission and tactic-step certificate refusals.
module ElisaProofArenaAdmissionTests:
    public:
        def run() -> i64 can[Memory.Allocate, Abort.Panic]:
            can Memory.Allocate, Abort.Panic:
                float_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                float_children: mutable darray[usize] = []
                float_value: usize = ElisaProofKernelCore::add_node(&float_nodes, "float", "", 0, 0, 0, 0, 0, 0, "1e308", "")
                float_infinity: usize = ElisaProofKernelCore::add_node(&float_nodes, "binary", "+", float_value, float_value, 0, 0, 0, 0, "", "")
                float_nan: usize = ElisaProofKernelCore::add_node(&float_nodes, "binary", "-", float_infinity, float_infinity, 0, 0, 0, 0, "", "")
                float_goal: usize = ElisaProofKernelCore::add_node(&float_nodes, "binary", "==", float_nan, float_nan, 0, 0, 0, 0, "", "")
                return 116 if ElisaProofKernelReplay::proof_kernel_replay_goal_report(&float_nodes, &float_children, [], float_goal)

                cycle_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                cycle_children: mutable darray[usize] = []
                cycle_root: usize = ElisaProofKernelCore::add_node(&cycle_nodes, "unary", "not", 0, 0, 0, 0, 0, 0, "", "")
                cycle_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_arena_report(&cycle_nodes, &cycle_children, [], cycle_root)
                return 1 if cycle_admitted
                cycle_all_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_arena_all_report(&cycle_nodes, &cycle_children)
                return 126 if cycle_all_admitted

                # Effect-containment carries a variable-length list of effect-call children.
                # It must not be treated as a unary node: accepting an arbitrary child here
                # would let a malformed declaration certificate cross the arena boundary.
                malformed_effect_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                malformed_effect_children: mutable darray[usize] = []
                malformed_effect: usize = ElisaProofKernelCore::add_node(&malformed_effect_nodes, "effect", "", 0, 0, 0, 0, 0, 0, "Memory.Allocate", "")
                malformed_effect_row: usize = ElisaProofKernelCore::add_node(&malformed_effect_nodes, "effect-row", "", 0, 0, 0, 0, 1, 0, "", "")
                malformed_effect_children.push(malformed_effect)
                malformed_effect_child: usize = ElisaProofKernelCore::add_node(&malformed_effect_nodes, "int", "", 0, 0, 0, 0, 0, 7, "", "")
                malformed_effect_children.push(malformed_effect_child)
                malformed_effect_root: usize = ElisaProofKernelCore::add_node(&malformed_effect_nodes, "effect-containment", "", malformed_effect_row, 0, 0, 1, 1, 0, "caller", "")
                malformed_effect_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_arena_report(&malformed_effect_nodes, &malformed_effect_children, [], malformed_effect_root)
                return 131 if malformed_effect_admitted
                malformed_effect_all_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_arena_all_report(&malformed_effect_nodes, &malformed_effect_children)
                return 132 if malformed_effect_all_admitted

                malformed_resource_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                malformed_resource_children: mutable darray[usize] = []
                malformed_resource_root: usize = ElisaProofKernelCore::add_node(&malformed_resource_nodes, "resource-use", "", 1, 0, 0, 0, 0, 0, "value", "")
                malformed_resource_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_arena_all_report(&malformed_resource_nodes, &malformed_resource_children)
                return 127 if malformed_resource_admitted

                malformed_result_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                malformed_result_children: mutable darray[usize] = []
                malformed_result_root: usize = ElisaProofKernelCore::add_node(&malformed_result_nodes, "resource-call-result", "", 1, 0, 0, 0, 0, 0, "result", "")
                malformed_result_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_arena_report(&malformed_result_nodes, &malformed_result_children, [], malformed_result_root)
                return 128 if malformed_result_admitted

                malformed_disjoint_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                malformed_disjoint_children: mutable darray[usize] = []
                malformed_disjoint_left: usize = ElisaProofKernelCore::add_node(&malformed_disjoint_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
                malformed_disjoint_right: usize = ElisaProofKernelCore::add_node(&malformed_disjoint_nodes, "int", "", 0, 0, 0, 0, 0, 2, "", "")
                malformed_disjoint_goal: usize = ElisaProofKernelCore::add_node(&malformed_disjoint_nodes, "binary", "!=", malformed_disjoint_left, malformed_disjoint_right, 0, 0, 0, 0, "", "")
                malformed_disjoint_root: usize = ElisaProofKernelCore::add_node(&malformed_disjoint_nodes, "resource-disjoint", "!=", malformed_disjoint_left, malformed_disjoint_right, malformed_disjoint_goal, 0, 1, 0, "", "")
                malformed_disjoint_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_arena_all_report(&malformed_disjoint_nodes, &malformed_disjoint_children)
                return 130 if malformed_disjoint_admitted

                # A return marker must not reuse a resource-use witness from before that binding was moved.
                # The source checker would reject the returned expression, but the independent kernel must
                # also refuse the forged summary without relying on the AST pass.
                moved_return_witness_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                moved_return_witness_children: mutable darray[usize] = []
                moved_return_witness_param: usize = ElisaProofKernelCore::add_node(&moved_return_witness_nodes, "resource-region-param", "external", 0, 0, 0, 0, 0, 0, "r", "")
                moved_return_witness_value: usize = ElisaProofKernelCore::add_node(&moved_return_witness_nodes, "int", "", 0, 0, 0, 0, 0, 7, "", "")
                moved_return_witness_bind: usize = ElisaProofKernelCore::add_node(&moved_return_witness_nodes, "resource-region-alloc", "", moved_return_witness_value, 0, 2, 0, 0, 0, "ref", "r")
                moved_return_witness_use_place: usize = ElisaProofKernelCore::add_node(&moved_return_witness_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "ref", "")
                moved_return_witness_use: usize = ElisaProofKernelCore::add_node(&moved_return_witness_nodes, "resource-use", "", moved_return_witness_use_place, 0, 0, 0, 0, 0, "ref", "")
                moved_return_witness_move_place: usize = ElisaProofKernelCore::add_node(&moved_return_witness_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "ref", "")
                moved_return_witness_move: usize = ElisaProofKernelCore::add_node(&moved_return_witness_nodes, "resource-move", "", moved_return_witness_move_place, 0, 0, 0, 0, 0, "ref", "")
                moved_return_witness_return: usize = ElisaProofKernelCore::add_node(&moved_return_witness_nodes, "resource-region-return", "param", moved_return_witness_use, 0, 0, 0, 0, 0, "r", "")
                moved_return_witness_children.push(moved_return_witness_param)
                moved_return_witness_children.push(moved_return_witness_bind)
                moved_return_witness_children.push(moved_return_witness_use)
                moved_return_witness_children.push(moved_return_witness_move)
                moved_return_witness_children.push(moved_return_witness_return)
                moved_return_witness_root: usize = ElisaProofKernelCore::add_node(&moved_return_witness_nodes, "resource-safety", "", 0, 0, 0, 0, 5, 0, "moved-return-witness", "resource-v1")
                moved_return_witness_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&moved_return_witness_nodes, &moved_return_witness_children, [], moved_return_witness_root)
                return 129 if moved_return_witness_admitted

                edge_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                edge_children: mutable darray[usize] = []
                edge_root: usize = ElisaProofKernelCore::add_node(&edge_nodes, "unary", "not", 1, 0, 0, 0, 0, 0, "", "")
                edge_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_arena_report(&edge_nodes, &edge_children, [], edge_root)
                return 2 if edge_admitted

                call_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                call_children: mutable darray[usize] = []
                callee: usize = ElisaProofKernelCore::add_node(&call_nodes, "int", "", 0, 0, 0, 0, 0, 7, "", "")
                call_root: usize = ElisaProofKernelCore::add_node(&call_nodes, "call", "", callee, 0, 0, 0, 1, 0, "", "")
                call_children.push(callee)
                call_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_arena_report(&call_nodes, &call_children, [], call_root)
                return 3 if call_admitted

                fact_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                fact_children: mutable darray[usize] = []
                fact_root: usize = ElisaProofKernelCore::add_node(&fact_nodes, "int", "", 0, 0, 0, 0, 0, 7, "", "")
                invalid_fact: darray[usize] = [fact_root + 1]
                fact_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_arena_report(&fact_nodes, &fact_children, invalid_fact, fact_root)
                return 4 if fact_admitted

                slice_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                slice_children: mutable darray[usize] = []
                slice_root: usize = ElisaProofKernelCore::add_node(&slice_nodes, "array", "", 0, 0, 0, 1, 1, 0, "", "")
                slice_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_arena_report(&slice_nodes, &slice_children, [], slice_root)
                return 5 if slice_admitted

                unknown_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                unknown_children: mutable darray[usize] = []
                unknown_root: usize = ElisaProofKernelCore::add_node(&unknown_nodes, "future-node-kind", "", 0, 0, 0, 0, 0, 0, "", "")
                unknown_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_arena_report(&unknown_nodes, &unknown_children, [], unknown_root)
                return 6 if unknown_admitted

                shorthand_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                shorthand_children: mutable darray[usize] = []
                shorthand_root: usize = ElisaProofKernelCore::add_node(&shorthand_nodes, "shorthand", "", 0, 0, 0, 0, 0, 0, "None", "")
                shorthand_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_arena_report(&shorthand_nodes, &shorthand_children, [], shorthand_root)
                return 7 if not shorthand_admitted

                malformed_shorthand_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                malformed_shorthand_children: mutable darray[usize] = []
                malformed_shorthand_root: usize = ElisaProofKernelCore::add_node(&malformed_shorthand_nodes, "shorthand", "", 1, 0, 0, 0, 0, 0, "None", "")
                malformed_shorthand_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_arena_report(&malformed_shorthand_nodes, &malformed_shorthand_children, [], malformed_shorthand_root)
                return 8 if malformed_shorthand_admitted

                valid_slice_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                valid_slice_children: mutable darray[usize] = []
                valid_slice_object: usize = ElisaProofKernelCore::add_node(&valid_slice_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "values", "")
                valid_slice_low: usize = ElisaProofKernelCore::add_node(&valid_slice_nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
                valid_slice_high: usize = ElisaProofKernelCore::add_node(&valid_slice_nodes, "absent", "", 0, 0, 0, 0, 0, 0, "", "")
                valid_slice_root: usize = ElisaProofKernelCore::add_node(&valid_slice_nodes, "slice", "", valid_slice_object, valid_slice_low, valid_slice_high, 0, 0, 0, "", "")
                valid_slice_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_arena_report(&valid_slice_nodes, &valid_slice_children, [], valid_slice_root)
                return 9 if not valid_slice_admitted

                malformed_slice_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                malformed_slice_children: mutable darray[usize] = []
                malformed_slice_object: usize = ElisaProofKernelCore::add_node(&malformed_slice_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "values", "")
                malformed_slice_low: usize = ElisaProofKernelCore::add_node(&malformed_slice_nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
                malformed_slice_high: usize = ElisaProofKernelCore::add_node(&malformed_slice_nodes, "absent", "", 0, 0, 0, 0, 0, 0, "", "")
                malformed_slice_root: usize = ElisaProofKernelCore::add_node(&malformed_slice_nodes, "slice", "", malformed_slice_object, malformed_slice_low, malformed_slice_high, 1, 0, 0, "", "")
                malformed_slice_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_arena_report(&malformed_slice_nodes, &malformed_slice_children, [], malformed_slice_root)
                return 10 if malformed_slice_admitted

                valid_indexn_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                valid_indexn_children: mutable darray[usize] = []
                valid_indexn_object: usize = ElisaProofKernelCore::add_node(&valid_indexn_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "matrix", "")
                valid_indexn_first: usize = ElisaProofKernelCore::add_node(&valid_indexn_nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
                valid_indexn_second: usize = ElisaProofKernelCore::add_node(&valid_indexn_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
                valid_indexn_children.push(valid_indexn_first)
                valid_indexn_children.push(valid_indexn_second)
                valid_indexn_root: usize = ElisaProofKernelCore::add_node(&valid_indexn_nodes, "index-n", "", valid_indexn_object, 0, 0, 0, 2, 0, "", "")
                valid_indexn_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_arena_report(&valid_indexn_nodes, &valid_indexn_children, [], valid_indexn_root)
                return 11 if not valid_indexn_admitted

                malformed_indexn_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                malformed_indexn_children: mutable darray[usize] = []
                malformed_indexn_object: usize = ElisaProofKernelCore::add_node(&malformed_indexn_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "matrix", "")
                malformed_indexn_child: usize = ElisaProofKernelCore::add_node(&malformed_indexn_nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
                malformed_indexn_children.push(malformed_indexn_child)
                malformed_indexn_root: usize = ElisaProofKernelCore::add_node(&malformed_indexn_nodes, "index-n", "", malformed_indexn_object, 0, 0, 0, 2, 0, "", "")
                malformed_indexn_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_arena_report(&malformed_indexn_nodes, &malformed_indexn_children, [], malformed_indexn_root)
                return 12 if malformed_indexn_admitted

                deep_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                deep_children: mutable darray[usize] = []
                deep_root: mutable usize = ElisaProofKernelCore::add_node(&deep_nodes, "int", "", 0, 0, 0, 0, 0, 7, "", "")
                for depth in 0..<128 |depth, deep_nodes, deep_root|:
                    deep_root <- ElisaProofKernelCore::add_node(&deep_nodes, "unary", "not", deep_root, 0, 0, 0, 0, 0, "", "")
                deep_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_arena_report(&deep_nodes, &deep_children, [], deep_root)
                return 13 if deep_admitted

                shared_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                shared_children: mutable darray[usize] = []
                shared_leaf: usize = ElisaProofKernelCore::add_node(&shared_nodes, "int", "", 0, 0, 0, 0, 0, 7, "", "")
                shared_root: usize = ElisaProofKernelCore::add_node(&shared_nodes, "binary", "+", shared_leaf, shared_leaf, 0, 0, 0, 0, "", "")
                shared_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_arena_report(&shared_nodes, &shared_children, [], shared_root)
                return 14 if not shared_admitted

                # A shared node first reached through the right (shallow) branch must not hide the same node
                # behind a 127-edge left branch. This specifically guards depth-aware DAG memoization.
                deep_shared_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                deep_shared_children: mutable darray[usize] = []
                deep_shared_leaf: usize = ElisaProofKernelCore::add_node(&deep_shared_nodes, "int", "", 0, 0, 0, 0, 0, 7, "", "")
                deep_shared_node: usize = ElisaProofKernelCore::add_node(&deep_shared_nodes, "unary", "not", deep_shared_leaf, 0, 0, 0, 0, 0, "", "")
                deep_shared_chain: mutable usize = deep_shared_node
                for depth in 0..<125 |depth, deep_shared_nodes, deep_shared_chain|:
                    deep_shared_chain <- ElisaProofKernelCore::add_node(&deep_shared_nodes, "unary", "not", deep_shared_chain, 0, 0, 0, 0, 0, "", "")
                deep_shared_root: usize = ElisaProofKernelCore::add_node(&deep_shared_nodes, "binary", "+", deep_shared_chain, deep_shared_node, 0, 0, 0, 0, "", "")
                deep_shared_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_arena_report(&deep_shared_nodes, &deep_shared_children, [], deep_shared_root)
                return 45 if deep_shared_admitted

                malformed_call_arg_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                malformed_call_arg_children: mutable darray[usize] = []
                malformed_call_arg_callee: usize = ElisaProofKernelCore::add_node(&malformed_call_arg_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "callee", "")
                malformed_call_arg_value: usize = ElisaProofKernelCore::add_node(&malformed_call_arg_nodes, "int", "", 0, 0, 0, 0, 0, 7, "", "")
                malformed_call_arg: usize = ElisaProofKernelCore::add_node(&malformed_call_arg_nodes, "call_arg", "", malformed_call_arg_value, 0, 0, 0, 0, 0, "", "hidden")
                malformed_call_arg_children.push(malformed_call_arg)
                malformed_call_arg_root: usize = ElisaProofKernelCore::add_node(&malformed_call_arg_nodes, "call", "", malformed_call_arg_callee, 0, 0, 0, 1, 0, "", "")
                malformed_call_arg_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_arena_report(&malformed_call_arg_nodes, &malformed_call_arg_children, [], malformed_call_arg_root)
                return 15 if malformed_call_arg_admitted

                malformed_binary_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                malformed_binary_children: mutable darray[usize] = []
                malformed_binary_left: usize = ElisaProofKernelCore::add_node(&malformed_binary_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
                malformed_binary_right: usize = ElisaProofKernelCore::add_node(&malformed_binary_nodes, "int", "", 0, 0, 0, 0, 0, 2, "", "")
                malformed_binary_root: usize = ElisaProofKernelCore::add_node(&malformed_binary_nodes, "binary", "+", malformed_binary_left, malformed_binary_right, 0, 0, 0, 0, "hidden", "")
                malformed_binary_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_arena_report(&malformed_binary_nodes, &malformed_binary_children, [], malformed_binary_root)
                return 16 if malformed_binary_admitted

                # `have` may add a proved fact, but it cannot replace the target. This forged transition
                # starts with false and changes the post-goal to true; the independent tactic kernel must
                # reject it even though the added fact itself is trivially proved.
                forged_have_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                forged_have_children: mutable darray[usize] = []
                forged_have_false: usize = ElisaProofKernelCore::add_node(&forged_have_nodes, "bool", "", 0, 0, 0, 0, 0, 0, "", "")
                forged_have_true: usize = ElisaProofKernelCore::add_node(&forged_have_nodes, "bool", "", 0, 0, 0, 0, 0, 1, "", "")
                forged_have_after_facts: darray[usize] = [forged_have_true]
                forged_have_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_tactic_step(&forged_have_nodes, &forged_have_children, "have", true, false, false, [], forged_have_false, forged_have_after_facts, forged_have_true, forged_have_true, true, 0, false, 0, false, "")
                return 79 if forged_have_admitted

                # `simp` is a closed bottom-up rewrite, not arbitrary entailment. This forged transition
                # changes `p` to `p and true`; the old containment-shaped replay admitted it because the new
                # goal contained the old one as a conjunct. The independent simplifier must reject it.
                forged_simp_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                forged_simp_children: mutable darray[usize] = []
                forged_simp_atom: usize = ElisaProofKernelCore::add_node(&forged_simp_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "p", "")
                forged_simp_true: usize = ElisaProofKernelCore::add_node(&forged_simp_nodes, "bool", "", 0, 0, 0, 0, 0, 1, "", "")
                forged_simp_after: usize = ElisaProofKernelCore::add_node(&forged_simp_nodes, "binary", "and", forged_simp_atom, forged_simp_true, 0, 0, 0, 0, "", "")
                forged_simp_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_tactic_step(&forged_simp_nodes, &forged_simp_children, "simp", true, false, false, [], forged_simp_atom, [], forged_simp_after, 0, false, 0, false, 0, false, "")
                return 82 if forged_simp_admitted

                noncanonical_operator_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                noncanonical_operator_children: mutable darray[usize] = []
                noncanonical_operator_left: usize = ElisaProofKernelCore::add_node(&noncanonical_operator_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
                noncanonical_operator_right: usize = ElisaProofKernelCore::add_node(&noncanonical_operator_nodes, "int", "", 0, 0, 0, 0, 0, 2, "", "")
                noncanonical_operator_root: usize = ElisaProofKernelCore::add_node(&noncanonical_operator_nodes, "binary", "not-a-canonical-operator", noncanonical_operator_left, noncanonical_operator_right, 0, 0, 0, 0, "", "")
                noncanonical_operator_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_arena_report(&noncanonical_operator_nodes, &noncanonical_operator_children, [], noncanonical_operator_root)
                return 78 if noncanonical_operator_admitted

                malformed_call_shape_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                malformed_call_shape_children: mutable darray[usize] = []
                malformed_call_shape_callee: usize = ElisaProofKernelCore::add_node(&malformed_call_shape_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "callee", "")
                malformed_call_shape_value: usize = ElisaProofKernelCore::add_node(&malformed_call_shape_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
                malformed_call_shape_arg: usize = ElisaProofKernelCore::add_node(&malformed_call_shape_nodes, "call_arg", "", malformed_call_shape_value, 0, 0, 0, 0, 0, "", "")
                malformed_call_shape_second_value: usize = ElisaProofKernelCore::add_node(&malformed_call_shape_nodes, "int", "", 0, 0, 0, 0, 0, 2, "", "")
                malformed_call_shape_second_arg: usize = ElisaProofKernelCore::add_node(&malformed_call_shape_nodes, "call_arg", "", malformed_call_shape_second_value, 0, 0, 0, 0, 0, "", "")
                malformed_call_shape_children.push(malformed_call_shape_arg)
                malformed_call_shape_children.push(malformed_call_shape_second_arg)
                malformed_call_shape_root: usize = ElisaProofKernelCore::add_node(&malformed_call_shape_nodes, "call", "", malformed_call_shape_callee, 0, 1, 0, 2, 0, "", "")
                malformed_call_shape_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_arena_report(&malformed_call_shape_nodes, &malformed_call_shape_children, [], malformed_call_shape_root)
                return 80 if malformed_call_shape_admitted

                # Batch admission is the cached path used by report replay. It must enforce the same
                # call-argument child-kind boundary as single-root admission, rather than only checking that
                # the child index is in postorder.
                malformed_batch_call_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                malformed_batch_call_children: mutable darray[usize] = []
                malformed_batch_call_callee: usize = ElisaProofKernelCore::add_node(&malformed_batch_call_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "callee", "")
                malformed_batch_call_value: usize = ElisaProofKernelCore::add_node(&malformed_batch_call_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
                malformed_batch_call_children.push(malformed_batch_call_value)
                malformed_batch_call_root: usize = ElisaProofKernelCore::add_node(&malformed_batch_call_nodes, "call", "", malformed_batch_call_callee, 0, 0, 0, 1, 0, "", "")
                malformed_batch_call_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_arena_all_report(&malformed_batch_call_nodes, &malformed_batch_call_children)
                return 88 if malformed_batch_call_admitted

                malformed_bool_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                malformed_bool_children: mutable darray[usize] = []
                malformed_bool_root: usize = ElisaProofKernelCore::add_node(&malformed_bool_nodes, "bool", "", 0, 0, 0, 0, 0, 2, "", "")
                malformed_bool_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_arena_report(&malformed_bool_nodes, &malformed_bool_children, [], malformed_bool_root)
                return 17 if malformed_bool_admitted

                # The logical kernel must not let exact containment turn an integer term into a proposition.
                # This is a direct source-neutral call, so it cannot rely on the compiler's type checker.
                scalar_proposition_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                scalar_proposition_children: mutable darray[usize] = []
                scalar_proposition_root: usize = ElisaProofKernelCore::add_node(&scalar_proposition_nodes, "int", "", 0, 0, 0, 0, 0, 7, "", "")
                scalar_proposition_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_goal_report(&scalar_proposition_nodes, &scalar_proposition_children, [scalar_proposition_root], scalar_proposition_root)
                return 81 if scalar_proposition_admitted

                # A type marker is an internal proposition that is always true only in its exact canonical
                # shape. A name-only match would let a malformed marker silently become a model fact.
                malformed_marker_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                malformed_marker_children: mutable darray[usize] = []
                malformed_marker_callee: usize = ElisaProofKernelCore::add_node(&malformed_marker_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "__elisa_primitive_scalar_type", "")
                malformed_marker: usize = ElisaProofKernelCore::add_node(&malformed_marker_nodes, "call", "", malformed_marker_callee, 0, 0, 0, 0, 0, "", "")
                malformed_marker_name: usize = ElisaProofKernelCore::add_node(&malformed_marker_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "x", "")
                malformed_marker_argument: usize = ElisaProofKernelCore::add_node(&malformed_marker_nodes, "call_arg", "", malformed_marker_name, 0, 0, 0, 0, 0, "", "")
                malformed_marker_children.push(malformed_marker_argument)
                valid_marker: usize = ElisaProofKernelCore::add_node(&malformed_marker_nodes, "call", "", malformed_marker_callee, 0, 0, 0, 1, 0, "", "")
                lower_zero: usize = ElisaProofKernelCore::add_node(&malformed_marker_nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
                lower_bound: usize = ElisaProofKernelCore::add_node(&malformed_marker_nodes, "binary", ">=", malformed_marker_name, lower_zero, 0, 0, 0, 0, "", "")
                upper_bound: usize = ElisaProofKernelCore::add_node(&malformed_marker_nodes, "binary", "<=", malformed_marker_name, lower_zero, 0, 0, 0, 0, "", "")
                marker_true: usize = ElisaProofKernelCore::add_node(&malformed_marker_nodes, "bool", "", 0, 0, 0, 0, 0, 1, "", "")
                malformed_marker_goal: usize = ElisaProofKernelCore::add_node(&malformed_marker_nodes, "binary", "and", malformed_marker, marker_true, 0, 0, 0, 0, "", "")
                malformed_marker_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_goal_report(&malformed_marker_nodes, &malformed_marker_children, [valid_marker, lower_bound, upper_bound], malformed_marker_goal)
                return 98 if malformed_marker_admitted

                # Enum shorthand is a value, not a proposition. Matching a fact byte-for-byte must not
                # bypass the proposition-shape boundary and prove a bare enum value as a contract.
                shorthand_proposition_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                shorthand_proposition_children: mutable darray[usize] = []
                shorthand_proposition_root: usize = ElisaProofKernelCore::add_node(&shorthand_proposition_nodes, "shorthand", "", 0, 0, 0, 0, 0, 0, "On", "")
                shorthand_proposition_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_goal_report(&shorthand_proposition_nodes, &shorthand_proposition_children, [shorthand_proposition_root], shorthand_proposition_root)
                return 83 if shorthand_proposition_admitted

                # A structurally valid symbolic index is admitted as a conservative path. The resource
                # kernel may carry it, but it will report overlap unless a separate resource-disjoint event
                # proves the selectors unequal.
                return 0
