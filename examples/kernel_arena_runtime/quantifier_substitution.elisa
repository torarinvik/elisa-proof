# Quantifier substitution across calls, record construction, updates, and enum kinds.
module ElisaProofQuantifierSubstitutionTests:
    public:
        def run() -> i64 can[Memory.Allocate, Abort.Panic]:
            can Memory.Allocate, Abort.Panic:
                # Quantifier substitution must stage a call's child roots after recursively rewriting a
                # nested collection argument. Otherwise the nested array's internal edge becomes a fake call
                # argument and changes the certificate's meaning.
                nested_call_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                nested_call_children: mutable darray[usize] = []
                nested_call_binder: usize = ElisaProofKernelCore::add_node(&nested_call_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "item", "")
                nested_array_start: usize = nested_call_children.count
                nested_call_children.push(nested_call_binder)
                nested_array: usize = ElisaProofKernelCore::add_node(&nested_call_nodes, "array", "", 0, 0, 0, nested_array_start, 1, 0, "", "")
                nested_callee: usize = ElisaProofKernelCore::add_node(&nested_call_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "consume", "")
                nested_argument: usize = ElisaProofKernelCore::add_node(&nested_call_nodes, "call_arg", "", nested_array, 0, 0, 0, 0, 0, "", "")
                nested_arguments_start: usize = nested_call_children.count
                nested_call_children.push(nested_argument)
                nested_call: usize = ElisaProofKernelCore::add_node(&nested_call_nodes, "call", "", nested_callee, 0, 1, nested_arguments_start, 1, 0, "", "")
                # A call result is not a witnessed scalar, so the instance is decided by containment: the
                # hypothesis states the same call over the instantiated array, and only an exact child graph
                # can match it. A hypothesis over a different element must not.
                nested_seven: usize = ElisaProofKernelCore::add_node(&nested_call_nodes, "int", "", 0, 0, 0, 0, 0, 7, "", "")
                nested_goal: usize = ElisaProofKernelCore::add_node(&nested_call_nodes, "binary", "==", nested_call, nested_seven, 0, 0, 0, 0, "", "")
                nested_value: usize = ElisaProofKernelCore::add_node(&nested_call_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
                nested_range_start: usize = nested_call_children.count
                nested_call_children.push(nested_value)
                nested_range: usize = ElisaProofKernelCore::add_node(&nested_call_nodes, "array", "", 0, 0, 0, nested_range_start, 1, 0, "", "")
                nested_quantifier: usize = ElisaProofKernelCore::add_node(&nested_call_nodes, "quantifier", "forall", nested_range, nested_goal, 1, 0, 0, 0, "item", "")
                nested_fact_element: usize = ElisaProofKernelCore::add_node(&nested_call_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
                nested_fact_array_start: usize = nested_call_children.count
                nested_call_children.push(nested_fact_element)
                nested_fact_array: usize = ElisaProofKernelCore::add_node(&nested_call_nodes, "array", "", 0, 0, 0, nested_fact_array_start, 1, 0, "", "")
                nested_fact_argument: usize = ElisaProofKernelCore::add_node(&nested_call_nodes, "call_arg", "", nested_fact_array, 0, 0, 0, 0, 0, "", "")
                nested_fact_arguments_start: usize = nested_call_children.count
                nested_call_children.push(nested_fact_argument)
                nested_fact_call: usize = ElisaProofKernelCore::add_node(&nested_call_nodes, "call", "", nested_callee, 0, 1, nested_fact_arguments_start, 1, 0, "", "")
                nested_fact: usize = ElisaProofKernelCore::add_node(&nested_call_nodes, "binary", "==", nested_fact_call, nested_seven, 0, 0, 0, 0, "", "")
                return 39 if not ElisaProofKernelReplay::proof_kernel_replay_quantifier_report(&nested_call_nodes, &nested_call_children, "forall", [nested_fact], nested_quantifier)
                nested_other_element: usize = ElisaProofKernelCore::add_node(&nested_call_nodes, "int", "", 0, 0, 0, 0, 0, 2, "", "")
                nested_other_array_start: usize = nested_call_children.count
                nested_call_children.push(nested_other_element)
                nested_other_array: usize = ElisaProofKernelCore::add_node(&nested_call_nodes, "array", "", 0, 0, 0, nested_other_array_start, 1, 0, "", "")
                nested_other_argument: usize = ElisaProofKernelCore::add_node(&nested_call_nodes, "call_arg", "", nested_other_array, 0, 0, 0, 0, 0, "", "")
                nested_other_arguments_start: usize = nested_call_children.count
                nested_call_children.push(nested_other_argument)
                nested_other_call: usize = ElisaProofKernelCore::add_node(&nested_call_nodes, "call", "", nested_callee, 0, 1, nested_other_arguments_start, 1, 0, "", "")
                nested_other_fact: usize = ElisaProofKernelCore::add_node(&nested_call_nodes, "binary", "==", nested_other_call, nested_seven, 0, 0, 0, 0, "", "")
                return 120 if ElisaProofKernelReplay::proof_kernel_replay_quantifier_report(&nested_call_nodes, &nested_call_children, "forall", [nested_other_fact], nested_quantifier)
                return 39 if ElisaProofKernelReplay::proof_kernel_replay_quantifier_report(&nested_call_nodes, &nested_call_children, "forall", [], nested_quantifier)

                # Record construction and update retain their type/base, field names and field values under
                # binder substitution. Each instance is decided by containment against a hypothesis over the
                # instantiated aggregate, so a dropped field name, a wrong field value, or a wrong update base
                # must each make the match fail.
                construct_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                construct_children: mutable darray[usize] = []
                construct_callee: usize = ElisaProofKernelCore::add_node(&construct_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "take", "")
                construct_three: usize = ElisaProofKernelCore::add_node(&construct_nodes, "int", "", 0, 0, 0, 0, 0, 3, "", "")
                construct_zero: usize = ElisaProofKernelCore::add_node(&construct_nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
                construct_one: usize = ElisaProofKernelCore::add_node(&construct_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
                construct_two: usize = ElisaProofKernelCore::add_node(&construct_nodes, "int", "", 0, 0, 0, 0, 0, 2, "", "")
                construct_binder: usize = ElisaProofKernelCore::add_node(&construct_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "item", "")
                construct_type: usize = ElisaProofKernelCore::add_node(&construct_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "Pair", "")
                construct_base: usize = ElisaProofKernelCore::add_node(&construct_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "base", "")
                construct_other_base: usize = ElisaProofKernelCore::add_node(&construct_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "other", "")
                # `take(Pair{left: item, right: 0}) == 3`, quantified over `[1]`.
                goal_left_init: usize = ElisaProofKernelCore::add_node(&construct_nodes, "field-init", "", construct_binder, 0, 0, 0, 0, 0, "left", "")
                goal_right_init: usize = ElisaProofKernelCore::add_node(&construct_nodes, "field-init", "", construct_zero, 0, 0, 0, 0, 0, "right", "")
                goal_fields_start: usize = construct_children.count
                construct_children.push(goal_left_init)
                construct_children.push(goal_right_init)
                goal_construct: usize = ElisaProofKernelCore::add_node(&construct_nodes, "construct", "", construct_type, 0, 0, goal_fields_start, 2, 0, "", "")
                goal_construct_argument: usize = ElisaProofKernelCore::add_node(&construct_nodes, "call_arg", "", goal_construct, 0, 0, 0, 0, 0, "", "")
                goal_construct_arguments_start: usize = construct_children.count
                construct_children.push(goal_construct_argument)
                goal_construct_call: usize = ElisaProofKernelCore::add_node(&construct_nodes, "call", "", construct_callee, 0, 1, goal_construct_arguments_start, 1, 0, "", "")
                goal_construct_body: usize = ElisaProofKernelCore::add_node(&construct_nodes, "binary", "==", goal_construct_call, construct_three, 0, 0, 0, 0, "", "")
                construct_range_start: usize = construct_children.count
                construct_children.push(construct_one)
                construct_range: usize = ElisaProofKernelCore::add_node(&construct_nodes, "array", "", 0, 0, 0, construct_range_start, 1, 0, "", "")
                construct_quantifier: usize = ElisaProofKernelCore::add_node(&construct_nodes, "quantifier", "forall", construct_range, goal_construct_body, 1, 0, 0, 0, "item", "")
                # Hypotheses: the exact instance, a wrong field value, and a wrong field name.
                exact_left_init: usize = ElisaProofKernelCore::add_node(&construct_nodes, "field-init", "", construct_one, 0, 0, 0, 0, 0, "left", "")
                exact_right_init: usize = ElisaProofKernelCore::add_node(&construct_nodes, "field-init", "", construct_zero, 0, 0, 0, 0, 0, "right", "")
                exact_fields_start: usize = construct_children.count
                construct_children.push(exact_left_init)
                construct_children.push(exact_right_init)
                exact_construct: usize = ElisaProofKernelCore::add_node(&construct_nodes, "construct", "", construct_type, 0, 0, exact_fields_start, 2, 0, "", "")
                exact_argument: usize = ElisaProofKernelCore::add_node(&construct_nodes, "call_arg", "", exact_construct, 0, 0, 0, 0, 0, "", "")
                exact_arguments_start: usize = construct_children.count
                construct_children.push(exact_argument)
                exact_call: usize = ElisaProofKernelCore::add_node(&construct_nodes, "call", "", construct_callee, 0, 1, exact_arguments_start, 1, 0, "", "")
                exact_fact: usize = ElisaProofKernelCore::add_node(&construct_nodes, "binary", "==", exact_call, construct_three, 0, 0, 0, 0, "", "")
                return 121 if not ElisaProofKernelReplay::proof_kernel_replay_quantifier_report(&construct_nodes, &construct_children, "forall", [exact_fact], construct_quantifier)
                wrong_value_left_init: usize = ElisaProofKernelCore::add_node(&construct_nodes, "field-init", "", construct_two, 0, 0, 0, 0, 0, "left", "")
                wrong_value_fields_start: usize = construct_children.count
                construct_children.push(wrong_value_left_init)
                construct_children.push(exact_right_init)
                wrong_value_construct: usize = ElisaProofKernelCore::add_node(&construct_nodes, "construct", "", construct_type, 0, 0, wrong_value_fields_start, 2, 0, "", "")
                wrong_value_argument: usize = ElisaProofKernelCore::add_node(&construct_nodes, "call_arg", "", wrong_value_construct, 0, 0, 0, 0, 0, "", "")
                wrong_value_arguments_start: usize = construct_children.count
                construct_children.push(wrong_value_argument)
                wrong_value_call: usize = ElisaProofKernelCore::add_node(&construct_nodes, "call", "", construct_callee, 0, 1, wrong_value_arguments_start, 1, 0, "", "")
                wrong_value_fact: usize = ElisaProofKernelCore::add_node(&construct_nodes, "binary", "==", wrong_value_call, construct_three, 0, 0, 0, 0, "", "")
                return 122 if ElisaProofKernelReplay::proof_kernel_replay_quantifier_report(&construct_nodes, &construct_children, "forall", [wrong_value_fact], construct_quantifier)
                wrong_name_left_init: usize = ElisaProofKernelCore::add_node(&construct_nodes, "field-init", "", construct_one, 0, 0, 0, 0, 0, "lower", "")
                wrong_name_fields_start: usize = construct_children.count
                construct_children.push(wrong_name_left_init)
                construct_children.push(exact_right_init)
                wrong_name_construct: usize = ElisaProofKernelCore::add_node(&construct_nodes, "construct", "", construct_type, 0, 0, wrong_name_fields_start, 2, 0, "", "")
                wrong_name_argument: usize = ElisaProofKernelCore::add_node(&construct_nodes, "call_arg", "", wrong_name_construct, 0, 0, 0, 0, 0, "", "")
                wrong_name_arguments_start: usize = construct_children.count
                construct_children.push(wrong_name_argument)
                wrong_name_call: usize = ElisaProofKernelCore::add_node(&construct_nodes, "call", "", construct_callee, 0, 1, wrong_name_arguments_start, 1, 0, "", "")
                wrong_name_fact: usize = ElisaProofKernelCore::add_node(&construct_nodes, "binary", "==", wrong_name_call, construct_three, 0, 0, 0, 0, "", "")
                return 123 if ElisaProofKernelReplay::proof_kernel_replay_quantifier_report(&construct_nodes, &construct_children, "forall", [wrong_name_fact], construct_quantifier)
                # `take(base{left = item}) == 3`: the update base travels with the instance.
                update_goal_init: usize = ElisaProofKernelCore::add_node(&construct_nodes, "field-init", "", construct_binder, 0, 0, 0, 0, 0, "left", "")
                update_goal_fields_start: usize = construct_children.count
                construct_children.push(update_goal_init)
                update_goal: usize = ElisaProofKernelCore::add_node(&construct_nodes, "record-update", "", construct_base, 0, 0, update_goal_fields_start, 1, 0, "", "")
                update_goal_argument: usize = ElisaProofKernelCore::add_node(&construct_nodes, "call_arg", "", update_goal, 0, 0, 0, 0, 0, "", "")
                update_goal_arguments_start: usize = construct_children.count
                construct_children.push(update_goal_argument)
                update_goal_call: usize = ElisaProofKernelCore::add_node(&construct_nodes, "call", "", construct_callee, 0, 1, update_goal_arguments_start, 1, 0, "", "")
                update_goal_body: usize = ElisaProofKernelCore::add_node(&construct_nodes, "binary", "==", update_goal_call, construct_three, 0, 0, 0, 0, "", "")
                update_quantifier: usize = ElisaProofKernelCore::add_node(&construct_nodes, "quantifier", "forall", construct_range, update_goal_body, 1, 0, 0, 0, "item", "")
                update_exact_init: usize = ElisaProofKernelCore::add_node(&construct_nodes, "field-init", "", construct_one, 0, 0, 0, 0, 0, "left", "")
                update_exact_fields_start: usize = construct_children.count
                construct_children.push(update_exact_init)
                update_exact: usize = ElisaProofKernelCore::add_node(&construct_nodes, "record-update", "", construct_base, 0, 0, update_exact_fields_start, 1, 0, "", "")
                update_exact_argument: usize = ElisaProofKernelCore::add_node(&construct_nodes, "call_arg", "", update_exact, 0, 0, 0, 0, 0, "", "")
                update_exact_arguments_start: usize = construct_children.count
                construct_children.push(update_exact_argument)
                update_exact_call: usize = ElisaProofKernelCore::add_node(&construct_nodes, "call", "", construct_callee, 0, 1, update_exact_arguments_start, 1, 0, "", "")
                update_exact_fact: usize = ElisaProofKernelCore::add_node(&construct_nodes, "binary", "==", update_exact_call, construct_three, 0, 0, 0, 0, "", "")
                return 124 if not ElisaProofKernelReplay::proof_kernel_replay_quantifier_report(&construct_nodes, &construct_children, "forall", [update_exact_fact], update_quantifier)
                update_other_fields_start: usize = construct_children.count
                construct_children.push(update_exact_init)
                update_other: usize = ElisaProofKernelCore::add_node(&construct_nodes, "record-update", "", construct_other_base, 0, 0, update_other_fields_start, 1, 0, "", "")
                update_other_argument: usize = ElisaProofKernelCore::add_node(&construct_nodes, "call_arg", "", update_other, 0, 0, 0, 0, 0, "", "")
                update_other_arguments_start: usize = construct_children.count
                construct_children.push(update_other_argument)
                update_other_call: usize = ElisaProofKernelCore::add_node(&construct_nodes, "call", "", construct_callee, 0, 1, update_other_arguments_start, 1, 0, "", "")
                update_other_fact: usize = ElisaProofKernelCore::add_node(&construct_nodes, "binary", "==", update_other_call, construct_three, 0, 0, 0, 0, "", "")
                return 125 if ElisaProofKernelReplay::proof_kernel_replay_quantifier_report(&construct_nodes, &construct_children, "forall", [update_other_fact], update_quantifier)

                # The semantic quantifier kind is part of the replayed node, not an unchecked caller hint.
                # A forged existential replay of a universal arena must fail even when its finite body is
                # otherwise satisfiable.
                quantifier_kind_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                quantifier_kind_children: mutable darray[usize] = []
                quantifier_kind_value: usize = ElisaProofKernelCore::add_node(&quantifier_kind_nodes, "int", "", 0, 0, 0, 0, 0, 7, "", "")
                quantifier_kind_children.push(quantifier_kind_value)
                quantifier_kind_range: usize = ElisaProofKernelCore::add_node(&quantifier_kind_nodes, "array", "", 0, 0, 0, 0, 1, 0, "", "")
                quantifier_kind_body: usize = ElisaProofKernelCore::add_node(&quantifier_kind_nodes, "binary", "==", quantifier_kind_value, quantifier_kind_value, 0, 0, 0, 0, "", "")
                quantifier_kind_root: usize = ElisaProofKernelCore::add_node(&quantifier_kind_nodes, "quantifier", "forall", quantifier_kind_range, quantifier_kind_body, 1, 0, 0, 0, "x", "")
                return 75 if ElisaProofKernelReplay::proof_kernel_replay_quantifier_report(&quantifier_kind_nodes, &quantifier_kind_children, "exists", [], quantifier_kind_root)
                return 76 if not ElisaProofKernelReplay::proof_kernel_replay_quantifier_report(&quantifier_kind_nodes, &quantifier_kind_children, "forall", [], quantifier_kind_root)

                # Structural termination certificates must carry every product subject and at least one
                return 0
