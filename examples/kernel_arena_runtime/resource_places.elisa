# Symbolic and indexed resource-place identity, aliasing, and disjointness.
module ElisaProofResourcePlaceTests:
    public:
        def run() -> i64 can[Memory.Allocate, Abort.Panic]:
            can Memory.Allocate, Abort.Panic:
                dynamic_resource_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                dynamic_resource_children: mutable darray[usize] = []
                dynamic_resource_parameter: usize = ElisaProofKernelCore::add_node(&dynamic_resource_nodes, "resource-bind", "external-mutable", 0, 0, 1, 0, 0, 0, "values", "")
                dynamic_resource_object: usize = ElisaProofKernelCore::add_node(&dynamic_resource_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "values", "")
                dynamic_resource_index: usize = ElisaProofKernelCore::add_node(&dynamic_resource_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "i", "")
                dynamic_resource_place: usize = ElisaProofKernelCore::add_node(&dynamic_resource_nodes, "index", "", dynamic_resource_object, dynamic_resource_index, 0, 0, 0, 0, "", "")
                dynamic_resource_borrow: usize = ElisaProofKernelCore::add_node(&dynamic_resource_nodes, "resource-bind", "shared", dynamic_resource_place, 0, 0, 0, 0, 0, "alias", "values")
                dynamic_resource_children.push(dynamic_resource_parameter)
                dynamic_resource_children.push(dynamic_resource_borrow)
                dynamic_resource_root: usize = ElisaProofKernelCore::add_node(&dynamic_resource_nodes, "resource-safety", "", 0, 0, 1, 0, 2, 0, "dynamic", "resource-v1")
                dynamic_resource_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&dynamic_resource_nodes, &dynamic_resource_children, [], dynamic_resource_root)
                return 18 if not dynamic_resource_admitted

                # Conversely, two closed literal paths into an externally mutable root are disjoint, so the
                # same independent rules should accept a shared borrow of values[0] and a mutable borrow of
                # values[1]. This protects the exact-index improvement from regressing to whole-root aliasing.
                indexed_resource_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                indexed_resource_children: mutable darray[usize] = []
                indexed_resource_parameter: usize = ElisaProofKernelCore::add_node(&indexed_resource_nodes, "resource-bind", "external-mutable", 0, 0, 1, 0, 0, 0, "values", "")
                indexed_resource_object_zero: usize = ElisaProofKernelCore::add_node(&indexed_resource_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "values", "")
                indexed_resource_zero: usize = ElisaProofKernelCore::add_node(&indexed_resource_nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
                indexed_resource_place_zero: usize = ElisaProofKernelCore::add_node(&indexed_resource_nodes, "index", "", indexed_resource_object_zero, indexed_resource_zero, 0, 0, 0, 0, "", "")
                indexed_resource_shared: usize = ElisaProofKernelCore::add_node(&indexed_resource_nodes, "resource-bind", "shared", indexed_resource_place_zero, 0, 0, 0, 0, 0, "shared_zero", "values")
                indexed_resource_object_one: usize = ElisaProofKernelCore::add_node(&indexed_resource_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "values", "")
                indexed_resource_one: usize = ElisaProofKernelCore::add_node(&indexed_resource_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
                indexed_resource_place_one: usize = ElisaProofKernelCore::add_node(&indexed_resource_nodes, "index", "", indexed_resource_object_one, indexed_resource_one, 0, 0, 0, 0, "", "")
                indexed_resource_mutable: usize = ElisaProofKernelCore::add_node(&indexed_resource_nodes, "resource-bind", "mutable", indexed_resource_place_one, 0, 1, 0, 0, 0, "mutable_one", "values")
                indexed_resource_children.push(indexed_resource_parameter)
                indexed_resource_children.push(indexed_resource_shared)
                indexed_resource_children.push(indexed_resource_mutable)
                indexed_resource_root: usize = ElisaProofKernelCore::add_node(&indexed_resource_nodes, "resource-safety", "", 0, 0, 1, 0, 3, 0, "indexed", "resource-v1")
                indexed_resource_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&indexed_resource_nodes, &indexed_resource_children, [], indexed_resource_root)
                return 19 if not indexed_resource_admitted

                # The same conservative rule applies to the canonical IndexN form emitted by the compiler:
                # an unresolved component is a valid symbolic identity, but it is not treated as disjoint.
                dynamic_indexn_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                dynamic_indexn_children: mutable darray[usize] = []
                dynamic_indexn_parameter: usize = ElisaProofKernelCore::add_node(&dynamic_indexn_nodes, "resource-bind", "external-mutable", 0, 0, 1, 0, 0, 0, "matrix", "")
                dynamic_indexn_object: usize = ElisaProofKernelCore::add_node(&dynamic_indexn_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "matrix", "")
                dynamic_indexn_index: usize = ElisaProofKernelCore::add_node(&dynamic_indexn_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "i", "")
                dynamic_indexn_children.push(dynamic_indexn_index)
                dynamic_indexn_place: usize = ElisaProofKernelCore::add_node(&dynamic_indexn_nodes, "index-n", "", dynamic_indexn_object, 0, 0, 0, 1, 0, "", "")
                dynamic_indexn_borrow: usize = ElisaProofKernelCore::add_node(&dynamic_indexn_nodes, "resource-bind", "shared", dynamic_indexn_place, 0, 0, 0, 0, 0, "alias", "matrix")
                dynamic_indexn_children.push(dynamic_indexn_parameter)
                dynamic_indexn_children.push(dynamic_indexn_borrow)
                dynamic_indexn_root: usize = ElisaProofKernelCore::add_node(&dynamic_indexn_nodes, "resource-safety", "", 0, 0, 1, 1, 2, 0, "dynamic-indexn", "resource-v1")
                dynamic_indexn_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&dynamic_indexn_nodes, &dynamic_indexn_children, [], dynamic_indexn_root)
                return 20 if not dynamic_indexn_admitted

                # Two literal IndexN paths with different components are disjoint and must retain the same
                # permission behavior as their chained single-index encoding.
                multi_indexed_resource_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                multi_indexed_resource_children: mutable darray[usize] = []
                multi_indexed_resource_parameter: usize = ElisaProofKernelCore::add_node(&multi_indexed_resource_nodes, "resource-bind", "external-mutable", 0, 0, 1, 0, 0, 0, "matrix", "")
                multi_indexed_resource_object_first: usize = ElisaProofKernelCore::add_node(&multi_indexed_resource_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "matrix", "")
                multi_indexed_resource_first_row: usize = ElisaProofKernelCore::add_node(&multi_indexed_resource_nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
                multi_indexed_resource_first_column: usize = ElisaProofKernelCore::add_node(&multi_indexed_resource_nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
                multi_indexed_resource_children.push(multi_indexed_resource_first_row)
                multi_indexed_resource_children.push(multi_indexed_resource_first_column)
                multi_indexed_resource_place_first: usize = ElisaProofKernelCore::add_node(&multi_indexed_resource_nodes, "index-n", "", multi_indexed_resource_object_first, 0, 0, 0, 2, 0, "", "")
                multi_indexed_resource_shared: usize = ElisaProofKernelCore::add_node(&multi_indexed_resource_nodes, "resource-bind", "shared", multi_indexed_resource_place_first, 0, 0, 0, 0, 0, "shared_zero_zero", "matrix")
                multi_indexed_resource_object_second: usize = ElisaProofKernelCore::add_node(&multi_indexed_resource_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "matrix", "")
                multi_indexed_resource_second_row: usize = ElisaProofKernelCore::add_node(&multi_indexed_resource_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
                multi_indexed_resource_second_column: usize = ElisaProofKernelCore::add_node(&multi_indexed_resource_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
                multi_indexed_resource_children.push(multi_indexed_resource_second_row)
                multi_indexed_resource_children.push(multi_indexed_resource_second_column)
                multi_indexed_resource_place_second: usize = ElisaProofKernelCore::add_node(&multi_indexed_resource_nodes, "index-n", "", multi_indexed_resource_object_second, 0, 0, 2, 2, 0, "", "")
                multi_indexed_resource_mutable: usize = ElisaProofKernelCore::add_node(&multi_indexed_resource_nodes, "resource-bind", "mutable", multi_indexed_resource_place_second, 0, 1, 0, 0, 0, "mutable_one_one", "matrix")
                multi_indexed_resource_children.push(multi_indexed_resource_parameter)
                multi_indexed_resource_children.push(multi_indexed_resource_shared)
                multi_indexed_resource_children.push(multi_indexed_resource_mutable)
                multi_indexed_resource_root: usize = ElisaProofKernelCore::add_node(&multi_indexed_resource_nodes, "resource-safety", "", 0, 0, 1, 4, 3, 0, "multi-indexed", "resource-v1")
                multi_indexed_resource_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&multi_indexed_resource_nodes, &multi_indexed_resource_children, [], multi_indexed_resource_root)
                return 21 if not multi_indexed_resource_admitted

                # Shape-valid resource-disjoint events still need a logical proof. This hostile certificate
                # claims that a symbolic index is different from zero without supplying any premise; the
                # resource transition replay must reject it even though arena admission succeeds.
                unproven_disjoint_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                unproven_disjoint_children: mutable darray[usize] = []
                unproven_disjoint_parameter: usize = ElisaProofKernelCore::add_node(&unproven_disjoint_nodes, "resource-bind", "external-mutable", 0, 0, 1, 0, 0, 0, "values", "")
                unproven_disjoint_object: usize = ElisaProofKernelCore::add_node(&unproven_disjoint_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "values", "")
                unproven_disjoint_index: usize = ElisaProofKernelCore::add_node(&unproven_disjoint_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "i", "")
                unproven_disjoint_symbolic_place: usize = ElisaProofKernelCore::add_node(&unproven_disjoint_nodes, "index", "", unproven_disjoint_object, unproven_disjoint_index, 0, 0, 0, 0, "", "")
                unproven_disjoint_shared: usize = ElisaProofKernelCore::add_node(&unproven_disjoint_nodes, "resource-bind", "shared", unproven_disjoint_symbolic_place, 0, 0, 0, 0, 0, "shared", "values")
                unproven_disjoint_zero: usize = ElisaProofKernelCore::add_node(&unproven_disjoint_nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
                unproven_disjoint_literal_place: usize = ElisaProofKernelCore::add_node(&unproven_disjoint_nodes, "index", "", unproven_disjoint_object, unproven_disjoint_zero, 0, 0, 0, 0, "", "")
                unproven_disjoint_goal: usize = ElisaProofKernelCore::add_node(&unproven_disjoint_nodes, "binary", "!=", unproven_disjoint_index, unproven_disjoint_zero, 0, 0, 0, 0, "", "")
                unproven_disjoint_event: usize = ElisaProofKernelCore::add_node(&unproven_disjoint_nodes, "resource-disjoint", "!=", unproven_disjoint_index, unproven_disjoint_zero, unproven_disjoint_goal, 0, 0, 0, "", "")
                unproven_disjoint_mutable: usize = ElisaProofKernelCore::add_node(&unproven_disjoint_nodes, "resource-bind", "mutable", unproven_disjoint_literal_place, 0, 1, 0, 0, 0, "exclusive", "values")
                unproven_disjoint_children.push(unproven_disjoint_parameter)
                unproven_disjoint_children.push(unproven_disjoint_shared)
                unproven_disjoint_children.push(unproven_disjoint_event)
                unproven_disjoint_children.push(unproven_disjoint_mutable)
                unproven_disjoint_root: usize = ElisaProofKernelCore::add_node(&unproven_disjoint_nodes, "resource-safety", "", 0, 0, 1, 0, 4, 0, "unproven-disjoint", "resource-v1")
                unproven_disjoint_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&unproven_disjoint_nodes, &unproven_disjoint_children, [], unproven_disjoint_root)
                return 22 if unproven_disjoint_admitted

                # A forged resource-call may place two overlapping temporary borrows in separate argument
                # nodes. They are not caller-state borrows, but both are live during the callee and must be
                # rejected whenever either formal is mutable.
                forged_alias_call_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                forged_alias_call_children: mutable darray[usize] = []
                forged_alias_formal_left: usize = ElisaProofKernelCore::add_node(&forged_alias_call_nodes, "resource-bind", "external-mutable", 0, 0, 1, 0, 0, 0, "left", "")
                forged_alias_formal_right: usize = ElisaProofKernelCore::add_node(&forged_alias_call_nodes, "resource-bind", "external-mutable", 0, 0, 1, 0, 0, 0, "right", "")
                forged_alias_call_children.push(forged_alias_formal_left)
                forged_alias_call_children.push(forged_alias_formal_right)
                forged_alias_callee: usize = ElisaProofKernelCore::add_node(&forged_alias_call_nodes, "resource-safety", "", 0, 0, 2, 0, 2, 0, "write-pair", "resource-v1")
                forged_alias_source: usize = ElisaProofKernelCore::add_node(&forged_alias_call_nodes, "resource-bind", "external-mutable", 0, 0, 1, 0, 0, 0, "x", "")
                forged_alias_x_left: usize = ElisaProofKernelCore::add_node(&forged_alias_call_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "x", "")
                forged_alias_x_right: usize = ElisaProofKernelCore::add_node(&forged_alias_call_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "x", "")
                forged_alias_arg_left: usize = ElisaProofKernelCore::add_node(&forged_alias_call_nodes, "resource-call-arg", "borrow", forged_alias_x_left, 0, 0, 0, 0, 0, "left", "")
                forged_alias_arg_right: usize = ElisaProofKernelCore::add_node(&forged_alias_call_nodes, "resource-call-arg", "borrow", forged_alias_x_right, 0, 0, 0, 0, 0, "right", "")
                forged_alias_call_start: usize = forged_alias_call_children.count
                forged_alias_call_children.push(forged_alias_arg_left)
                forged_alias_call_children.push(forged_alias_arg_right)
                forged_alias_call: usize = ElisaProofKernelCore::add_node(&forged_alias_call_nodes, "resource-call", "", forged_alias_callee, 0, 2, forged_alias_call_start, 2, 0, "write-pair", "")
                forged_alias_call_children.push(forged_alias_source)
                forged_alias_call_children.push(forged_alias_call)
                forged_alias_root_start: usize = forged_alias_call_children.count - 2
                forged_alias_root: usize = ElisaProofKernelCore::add_node(&forged_alias_call_nodes, "resource-safety", "", 0, 0, 0, forged_alias_root_start, 2, 0, "duplicate-call", "resource-v1")
                forged_alias_callee_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&forged_alias_call_nodes, &forged_alias_call_children, [], forged_alias_callee)
                return 86 if not forged_alias_callee_admitted
                forged_alias_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&forged_alias_call_nodes, &forged_alias_call_children, [], forged_alias_root)
                return 87 if forged_alias_admitted

                return 0
