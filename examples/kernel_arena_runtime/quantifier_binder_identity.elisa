# Binder identity and capture boundaries in independent kernel replay.
module ElisaProofQuantifierIdentityTests:
    public:
        const NESTED_SHADOW_CONTROL_FAILED: i64 = 130
        const ALPHA_RENAMING_UNSUPPORTED_WAS_ADMITTED: i64 = 131
        const NESTED_CAPTURE_WAS_ADMITTED: i64 = 132
        const FREE_BINDER_ESCAPE_WAS_ADMITTED: i64 = 133

        def run() -> i64 can[Memory.Allocate, Abort.Panic]:
            can Memory.Allocate, Abort.Panic:
                nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                children: mutable darray[usize] = []
                zero: usize = ElisaProofKernelCore::add_node(&nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
                one: usize = ElisaProofKernelCore::add_node(&nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
                # Same-spelled nested binders denote distinct scopes. The inner range and body
                # both use its `x`; instantiating the outer binder must not rewrite either.
                inner_range_start: usize = children.count
                children.push(zero)
                inner_range: usize = ElisaProofKernelCore::add_node(&nodes, "array", "", 0, 0, 0, inner_range_start, 1, 0, "", "")
                inner_x: usize = ElisaProofKernelCore::add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "x", "")
                inner_body: usize = ElisaProofKernelCore::add_node(&nodes, "binary", "==", inner_x, zero, 0, 0, 0, 0, "", "")
                inner_forall: usize = ElisaProofKernelCore::add_node(&nodes, "quantifier", "forall", inner_range, inner_body, 1, 0, 0, 0, "x", "")
                outer_range_start: usize = children.count
                children.push(zero)
                children.push(one)
                outer_range: usize = ElisaProofKernelCore::add_node(&nodes, "array", "", 0, 0, 0, outer_range_start, 2, 0, "", "")
                outer_forall: usize = ElisaProofKernelCore::add_node(&nodes, "quantifier", "forall", outer_range, inner_forall, 1, 0, 0, 0, "x", "")
                return NESTED_SHADOW_CONTROL_FAILED if not ElisaProofKernelReplay::proof_kernel_replay_quantifier_report(&nodes, &children, "forall", [], outer_forall)

                # Alpha-equivalent terms with different source binder spellings are not yet
                # compared modulo alpha-renaming. Refuse the structural equality shortcut.
                alpha_range_start: usize = children.count
                children.push(zero)
                alpha_range: usize = ElisaProofKernelCore::add_node(&nodes, "array", "", 0, 0, 0, alpha_range_start, 1, 0, "", "")
                alpha_x: usize = ElisaProofKernelCore::add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "alpha_x", "")
                alpha_left_body: usize = ElisaProofKernelCore::add_node(&nodes, "binary", "==", alpha_x, zero, 0, 0, 0, 0, "", "")
                alpha_left: usize = ElisaProofKernelCore::add_node(&nodes, "quantifier", "forall", alpha_range, alpha_left_body, 1, 0, 0, 0, "alpha_x", "")
                y: usize = ElisaProofKernelCore::add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "y", "")
                renamed_body: usize = ElisaProofKernelCore::add_node(&nodes, "binary", "==", y, zero, 0, 0, 0, 0, "", "")
                renamed_forall: usize = ElisaProofKernelCore::add_node(&nodes, "quantifier", "forall", alpha_range, renamed_body, 1, 0, 0, 0, "y", "")
                return ALPHA_RENAMING_UNSUPPORTED_WAS_ADMITTED if ElisaProofKernelReplay::proof_kernel_replay_expr_equal_public(&nodes, &children, alpha_left, renamed_forall, 0)
                return NESTED_SHADOW_CONTROL_FAILED if not ElisaProofKernelReplay::proof_kernel_replay_quantifier_report(&nodes, &children, "forall", [], alpha_left)
                return NESTED_SHADOW_CONTROL_FAILED if not ElisaProofKernelReplay::proof_kernel_replay_quantifier_report(&nodes, &children, "forall", [], renamed_forall)

                # This proposition is true, but proving the outer instances requires
                # capture-avoiding substitution through a differently named inner binder.
                # The kernel currently returns false/unknown there and must remain fail-closed.
                capture_inner_range_start: usize = children.count
                children.push(zero)
                capture_inner_range: usize = ElisaProofKernelCore::add_node(&nodes, "array", "", 0, 0, 0, capture_inner_range_start, 1, 0, "", "")
                outer_x: usize = ElisaProofKernelCore::add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "outer_x", "")
                capture_body: usize = ElisaProofKernelCore::add_node(&nodes, "binary", "==", outer_x, zero, 0, 0, 0, 0, "", "")
                capture_inner: usize = ElisaProofKernelCore::add_node(&nodes, "quantifier", "forall", capture_inner_range, capture_body, 1, 0, 0, 0, "y", "")
                capture_outer_range_start: usize = children.count
                children.push(zero)
                capture_outer_range: usize = ElisaProofKernelCore::add_node(&nodes, "array", "", 0, 0, 0, capture_outer_range_start, 1, 0, "", "")
                capture_outer: usize = ElisaProofKernelCore::add_node(&nodes, "quantifier", "forall", capture_outer_range, capture_inner, 1, 0, 0, 0, "outer_x", "")
                return NESTED_CAPTURE_WAS_ADMITTED if ElisaProofKernelReplay::proof_kernel_replay_quantifier_report(&nodes, &children, "forall", [], capture_outer)

                # A bound name from a universal fact cannot escape into the outer context.
                escape_x: usize = ElisaProofKernelCore::add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "escape_x", "")
                escape_body: usize = ElisaProofKernelCore::add_node(&nodes, "binary", "==", escape_x, one, 0, 0, 0, 0, "", "")
                escape_range_start: usize = children.count
                children.push(one)
                escape_range: usize = ElisaProofKernelCore::add_node(&nodes, "array", "", 0, 0, 0, escape_range_start, 1, 0, "", "")
                escape_quantifier: usize = ElisaProofKernelCore::add_node(&nodes, "quantifier", "forall", escape_range, escape_body, 1, 0, 0, 0, "escape_x", "")
                escape_goal: usize = ElisaProofKernelCore::add_node(&nodes, "binary", "==", escape_x, one, 0, 0, 0, 0, "", "")
                return FREE_BINDER_ESCAPE_WAS_ADMITTED if ElisaProofKernelReplay::proof_kernel_replay_goal_report(&nodes, &children, [escape_quantifier], escape_goal)

                return 0
