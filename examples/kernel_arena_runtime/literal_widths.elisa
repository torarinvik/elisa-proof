# Literal-width adversaries. Compiled code evaluates a literal at the width of its arithmetic,
# so `x + 0 == 256` at u8 is `x + 0 == 0`. Read exactly, such a fact is unsatisfiable and closes
# any goal; the kernel must refuse every state holding a literal that its width does not keep.
module ElisaProofLiteralWidthTests:
    public:
        def run() -> i64 can[Memory.Allocate, Abort.Panic]:
            can Memory.Allocate, Abort.Panic:
                nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                children: mutable darray[usize] = []
                zero: usize = ElisaProofKernelCore::add_node(&nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
                seven: usize = ElisaProofKernelCore::add_node(&nodes, "int", "", 0, 0, 0, 0, 0, 7, "", "")
                x: usize = ElisaProofKernelCore::add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "x", "")
                y: usize = ElisaProofKernelCore::add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "y", "")
                eight: usize = ElisaProofKernelCore::add_node(&nodes, "int", "", 0, 0, 0, 0, 0, 8, "", "")
                width: usize = ElisaProofKernelCore::add_node(&nodes, "call_arg", "", eight, 0, 0, 0, 0, 0, "", "")

                # `x: u8` and `y: i8`.
                unsigned_callee: usize = ElisaProofKernelCore::add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "__elisa_unsigned_type_bound", "")
                unsigned_argument: usize = ElisaProofKernelCore::add_node(&nodes, "call_arg", "", x, 0, 0, 0, 0, 0, "", "")
                unsigned_start: usize = children.count
                children.push(unsigned_argument)
                children.push(width)
                unsigned_marker: usize = ElisaProofKernelCore::add_node(&nodes, "call", "", unsigned_callee, 0, 0, unsigned_start, 2, 0, "", "")
                signed_callee: usize = ElisaProofKernelCore::add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "__elisa_signed_type_bound", "")
                signed_argument: usize = ElisaProofKernelCore::add_node(&nodes, "call_arg", "", y, 0, 0, 0, 0, 0, "", "")
                signed_start: usize = children.count
                children.push(signed_argument)
                children.push(width)
                signed_marker: usize = ElisaProofKernelCore::add_node(&nodes, "call", "", signed_callee, 0, 0, signed_start, 2, 0, "", "")
                # A signed comparison also needs its primitive scalar witness.
                scalar_callee: usize = ElisaProofKernelCore::add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "__elisa_primitive_scalar_type", "")
                scalar_argument: usize = ElisaProofKernelCore::add_node(&nodes, "call_arg", "", y, 0, 0, 0, 0, 0, "", "")
                scalar_start: usize = children.count
                children.push(scalar_argument)
                scalar_marker: usize = ElisaProofKernelCore::add_node(&nodes, "call", "", scalar_callee, 0, 0, scalar_start, 1, 0, "", "")

                # The type ranges the producer supplies beside every marker: with them, a wide
                # literal read exactly contradicts the range and would close any goal.
                x_lower: usize = ElisaProofKernelCore::add_node(&nodes, "binary", "<=", zero, x, 0, 0, 0, 0, "", "")
                x_maximum: usize = ElisaProofKernelCore::add_node(&nodes, "int", "", 0, 0, 0, 0, 0, 255, "", "")
                x_upper: usize = ElisaProofKernelCore::add_node(&nodes, "binary", "<=", x, x_maximum, 0, 0, 0, 0, "", "")
                y_minimum: usize = ElisaProofKernelCore::add_node(&nodes, "int", "", 0, 0, 0, 0, 0, -128, "", "")
                y_lower: usize = ElisaProofKernelCore::add_node(&nodes, "binary", "<=", y_minimum, y, 0, 0, 0, 0, "", "")
                y_maximum: usize = ElisaProofKernelCore::add_node(&nodes, "int", "", 0, 0, 0, 0, 0, 127, "", "")
                y_upper: usize = ElisaProofKernelCore::add_node(&nodes, "binary", "<=", y, y_maximum, 0, 0, 0, 0, "", "")

                x_plus_zero: usize = ElisaProofKernelCore::add_node(&nodes, "binary", "+", x, zero, 0, 0, 0, 0, "", "")
                y_plus_zero: usize = ElisaProofKernelCore::add_node(&nodes, "binary", "+", y, zero, 0, 0, 0, 0, "", "")
                x_goal: usize = ElisaProofKernelCore::add_node(&nodes, "binary", "==", x, seven, 0, 0, 0, 0, "", "")
                y_goal: usize = ElisaProofKernelCore::add_node(&nodes, "binary", ">=", y, seven, 0, 0, 0, 0, "", "")

                # 256 is 0 at u8; 255 is kept.
                wide: usize = ElisaProofKernelCore::add_node(&nodes, "int", "", 0, 0, 0, 0, 0, 256, "", "")
                wide_fact: usize = ElisaProofKernelCore::add_node(&nodes, "binary", "==", x_plus_zero, wide, 0, 0, 0, 0, "", "")
                return 230 if ElisaProofKernelReplay::proof_kernel_replay_goal_report(&nodes, &children, [unsigned_marker, x_lower, x_upper, wide_fact], x_goal)
                maximum: usize = ElisaProofKernelCore::add_node(&nodes, "int", "", 0, 0, 0, 0, 0, 255, "", "")
                maximum_fact: usize = ElisaProofKernelCore::add_node(&nodes, "binary", "==", x_plus_zero, maximum, 0, 0, 0, 0, "", "")
                return 231 if not ElisaProofKernelReplay::proof_kernel_replay_goal_report(&nodes, &children, [unsigned_marker, x_lower, x_upper, maximum_fact], maximum_fact)

                # A negative value is 255 at u8, whether a bare payload or a negated literal.
                minus_one: usize = ElisaProofKernelCore::add_node(&nodes, "int", "", 0, 0, 0, 0, 0, -1, "", "")
                minus_one_fact: usize = ElisaProofKernelCore::add_node(&nodes, "binary", "==", x_plus_zero, minus_one, 0, 0, 0, 0, "", "")
                return 232 if ElisaProofKernelReplay::proof_kernel_replay_goal_report(&nodes, &children, [unsigned_marker, x_lower, x_upper, minus_one_fact], x_goal)
                one: usize = ElisaProofKernelCore::add_node(&nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
                negated_one: usize = ElisaProofKernelCore::add_node(&nodes, "unary", "-", one, 0, 0, 0, 0, 0, "", "")
                negated_one_fact: usize = ElisaProofKernelCore::add_node(&nodes, "binary", "==", x_plus_zero, negated_one, 0, 0, 0, 0, "", "")
                return 233 if ElisaProofKernelReplay::proof_kernel_replay_goal_report(&nodes, &children, [unsigned_marker, x_lower, x_upper, negated_one_fact], x_goal)

                # Parentheses do not hide a literal from the width of its arithmetic.
                wide_paren: usize = ElisaProofKernelCore::add_node(&nodes, "paren", "", wide, 0, 0, 0, 0, 0, "", "")
                wide_paren_twice: usize = ElisaProofKernelCore::add_node(&nodes, "paren", "", wide_paren, 0, 0, 0, 0, 0, "", "")
                wide_paren_fact: usize = ElisaProofKernelCore::add_node(&nodes, "binary", "==", x_plus_zero, wide_paren_twice, 0, 0, 0, 0, "", "")
                return 234 if ElisaProofKernelReplay::proof_kernel_replay_goal_report(&nodes, &children, [unsigned_marker, x_lower, x_upper, wide_paren_fact], x_goal)

                # -129 is 127 at i8, as a negated literal or a bare payload; -128 is kept both ways.
                one_twenty_nine: usize = ElisaProofKernelCore::add_node(&nodes, "int", "", 0, 0, 0, 0, 0, 129, "", "")
                below_minimum: usize = ElisaProofKernelCore::add_node(&nodes, "unary", "-", one_twenty_nine, 0, 0, 0, 0, 0, "", "")
                below_minimum_fact: usize = ElisaProofKernelCore::add_node(&nodes, "binary", "==", y_plus_zero, below_minimum, 0, 0, 0, 0, "", "")
                return 235 if ElisaProofKernelReplay::proof_kernel_replay_goal_report(&nodes, &children, [scalar_marker, signed_marker, y_lower, y_upper, below_minimum_fact], y_goal)
                below_minimum_payload: usize = ElisaProofKernelCore::add_node(&nodes, "int", "", 0, 0, 0, 0, 0, -129, "", "")
                below_minimum_payload_fact: usize = ElisaProofKernelCore::add_node(&nodes, "binary", "==", y_plus_zero, below_minimum_payload, 0, 0, 0, 0, "", "")
                return 236 if ElisaProofKernelReplay::proof_kernel_replay_goal_report(&nodes, &children, [scalar_marker, signed_marker, y_lower, y_upper, below_minimum_payload_fact], y_goal)
                one_twenty_eight: usize = ElisaProofKernelCore::add_node(&nodes, "int", "", 0, 0, 0, 0, 0, 128, "", "")
                minimum: usize = ElisaProofKernelCore::add_node(&nodes, "unary", "-", one_twenty_eight, 0, 0, 0, 0, 0, "", "")
                minimum_fact: usize = ElisaProofKernelCore::add_node(&nodes, "binary", "==", y_plus_zero, minimum, 0, 0, 0, 0, "", "")
                return 237 if not ElisaProofKernelReplay::proof_kernel_replay_goal_report(&nodes, &children, [scalar_marker, signed_marker, y_lower, y_upper, minimum_fact], minimum_fact)
                minimum_payload: usize = ElisaProofKernelCore::add_node(&nodes, "int", "", 0, 0, 0, 0, 0, -128, "", "")
                minimum_payload_fact: usize = ElisaProofKernelCore::add_node(&nodes, "binary", "==", y_plus_zero, minimum_payload, 0, 0, 0, 0, "", "")
                return 238 if not ElisaProofKernelReplay::proof_kernel_replay_goal_report(&nodes, &children, [scalar_marker, signed_marker, y_lower, y_upper, minimum_payload_fact], minimum_payload_fact)

                # 128 is -128 at i8, so a goal holding it is refused too, not only a fact.
                wide_goal: usize = ElisaProofKernelCore::add_node(&nodes, "binary", "!=", y_plus_zero, one_twenty_eight, 0, 0, 0, 0, "", "")
                return 239 if ElisaProofKernelReplay::proof_kernel_replay_goal_report(&nodes, &children, [scalar_marker, signed_marker, y_lower, y_upper], wide_goal)
                return 0
