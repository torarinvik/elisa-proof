# Adversarial replay for reference return provenance composed through a verified call.
module ElisaProofReferenceCallReturnTests:
    public:
        def run() -> i64 can[Memory.Allocate, Abort.Panic]:
            can Memory.Allocate, Abort.Panic:
                nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                children: mutable darray[usize] = []
                _ = ElisaProofKernelCore::add_node(&nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
                region_param: usize = ElisaProofKernelCore::add_node(&nodes, "resource-region-param", "external", 0, 0, 0, 0, 0, 0, "r", "")
                other_region_param: usize = ElisaProofKernelCore::add_node(&nodes, "resource-region-param", "external", 0, 0, 0, 0, 0, 0, "s", "")

                # choose_first[@r](first: mutable T& @r, second: mutable T& @r) -> mutable T& @r
                callee_first: usize = ElisaProofKernelCore::add_node(&nodes, "resource-bind", "external-mutable", 0, 0, 1, 0, 0, 0, "first", "r")
                callee_second: usize = ElisaProofKernelCore::add_node(&nodes, "resource-bind", "external-mutable", 0, 0, 1, 0, 0, 0, "second", "r")
                callee_first_place: usize = ElisaProofKernelCore::add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "first", "")
                callee_first_use: usize = ElisaProofKernelCore::add_node(&nodes, "resource-use", "", callee_first_place, 0, 0, 0, 0, 0, "first", "")
                callee_return: usize = ElisaProofKernelCore::add_node(&nodes, "resource-region-return", "param", callee_first_use, 0, 1, 0, 0, 0, "r", "")
                callee_start: usize = children.count
                children.push(region_param)
                children.push(callee_first)
                children.push(callee_second)
                children.push(callee_first_use)
                children.push(callee_return)
                callee: usize = ElisaProofKernelCore::add_node(&nodes, "resource-safety", "", 0, 0, 2, callee_start, 5, 0, "choose_first", "resource-v1")
                return 201 if not ElisaProofKernelReplay::proof_kernel_replay_resource_report(&nodes, &children, [], callee)

                # swap_ref[@r](first, second) -> mutable T& @r: return choose_first(second, first)
                wrapper_first: usize = ElisaProofKernelCore::add_node(&nodes, "resource-bind", "external-mutable", 0, 0, 1, 0, 0, 0, "first", "r")
                wrapper_second: usize = ElisaProofKernelCore::add_node(&nodes, "resource-bind", "external-mutable", 0, 0, 1, 0, 0, 0, "second", "r")
                second_place: usize = ElisaProofKernelCore::add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "second", "")
                first_place: usize = ElisaProofKernelCore::add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "first", "")
                first_argument: usize = ElisaProofKernelCore::add_node(&nodes, "resource-call-arg", "reference", second_place, 0, 0, 0, 0, 0, "first", "")
                second_argument: usize = ElisaProofKernelCore::add_node(&nodes, "resource-call-arg", "reference", first_place, 0, 0, 0, 0, 0, "second", "")
                call_region: usize = ElisaProofKernelCore::add_node(&nodes, "resource-call-region", "param", 0, 0, 0, 0, 0, 0, "r", "r")
                call_start: usize = children.count
                children.push(first_argument)
                children.push(second_argument)
                children.push(call_region)
                call: usize = ElisaProofKernelCore::add_node(&nodes, "resource-call", "", callee, 1, 2, call_start, 3, 0, "choose_first", "")
                returned: usize = ElisaProofKernelCore::add_node(&nodes, "resource-region-return", "param-call", call, 0, 1, 0, 0, 0, "r", "second")
                wrapper_start: usize = children.count
                children.push(region_param)
                children.push(wrapper_first)
                children.push(wrapper_second)
                children.push(call)
                children.push(returned)
                wrapper: usize = ElisaProofKernelCore::add_node(&nodes, "resource-safety", "", 0, 0, 2, wrapper_start, 5, 0, "swap_ref", "resource-v1")
                return 202 if not ElisaProofKernelReplay::proof_kernel_replay_resource_report(&nodes, &children, [], wrapper)

                # Same-region formals are not interchangeable: the callee summary returns its
                # `first`, which this call binds to the wrapper's `second`.
                nodes[returned].secondary_name <- "first"
                return 203 if ElisaProofKernelReplay::proof_kernel_replay_resource_report(&nodes, &children, [], wrapper)
                nodes[returned].secondary_name <- "second"

                # A wrapper may not turn the callee's mutable result into a shared one or back:
                # the marker's mutability must equal the callee summary's.
                nodes[returned].auxiliary <- 0
                return 204 if ElisaProofKernelReplay::proof_kernel_replay_resource_report(&nodes, &children, [], wrapper)
                nodes[returned].auxiliary <- 1

                # A marker naming a region the call did not map is not the call's result region.
                # `name` is immutable in the arena, so the wrong-region markers are separate nodes.
                returned_s: usize = ElisaProofKernelCore::add_node(&nodes, "resource-region-return", "param-call", call, 0, 1, 0, 0, 0, "s", "second")
                wrong_start: usize = children.count
                children.push(region_param)
                children.push(wrapper_first)
                children.push(wrapper_second)
                children.push(call)
                children.push(returned_s)
                wrong_region: usize = ElisaProofKernelCore::add_node(&nodes, "resource-safety", "", 0, 0, 2, wrong_start, 5, 0, "swap_ref", "resource-v1")
                return 205 if ElisaProofKernelReplay::proof_kernel_replay_resource_report(&nodes, &children, [], wrong_region)
                other_start: usize = children.count
                children.push(region_param)
                children.push(other_region_param)
                children.push(wrapper_first)
                children.push(wrapper_second)
                children.push(call)
                children.push(returned)
                two_regions: usize = ElisaProofKernelCore::add_node(&nodes, "resource-safety", "", 0, 0, 2, other_start, 6, 0, "swap_ref_two_regions", "resource-v1")
                return 206 if not ElisaProofKernelReplay::proof_kernel_replay_resource_report(&nodes, &children, [], two_regions)
                wrong_two_start: usize = children.count
                children.push(region_param)
                children.push(other_region_param)
                children.push(wrapper_first)
                children.push(wrapper_second)
                children.push(call)
                children.push(returned_s)
                wrong_two_regions: usize = ElisaProofKernelCore::add_node(&nodes, "resource-safety", "", 0, 0, 2, wrong_two_start, 6, 0, "swap_ref_two_regions", "resource-v1")
                return 207 if ElisaProofKernelReplay::proof_kernel_replay_resource_report(&nodes, &children, [], wrong_two_regions)

                # The call reference must be the immediately preceding event: an unrelated read of
                # the claimed formal in between cannot stand in for the call's own result.
                unrelated_use: usize = ElisaProofKernelCore::add_node(&nodes, "resource-use", "", second_place, 0, 0, 0, 0, 0, "second", "")
                stale_start: usize = children.count
                children.push(region_param)
                children.push(wrapper_first)
                children.push(wrapper_second)
                children.push(call)
                children.push(unrelated_use)
                children.push(returned)
                stale: usize = ElisaProofKernelCore::add_node(&nodes, "resource-safety", "", 0, 0, 2, stale_start, 6, 0, "stale_swap_ref", "resource-v1")
                return 208 if ElisaProofKernelReplay::proof_kernel_replay_resource_report(&nodes, &children, [], stale)

                # A direct `param` marker is not a call-return marker: its witness must be a
                # replayed use, never the call event itself.
                nodes[returned].operator <- "param"
                nodes[returned].secondary_name <- ""
                return 209 if ElisaProofKernelReplay::proof_kernel_replay_resource_report(&nodes, &children, [], wrapper)
                nodes[returned].operator <- "param-call"
                nodes[returned].secondary_name <- "second"

                # A callee summary whose markers disagree about the returned formal pins nothing,
                # so no wrapper may compose through it.
                callee_second_place: usize = ElisaProofKernelCore::add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "second", "")
                callee_second_use: usize = ElisaProofKernelCore::add_node(&nodes, "resource-use", "", callee_second_place, 0, 0, 0, 0, 0, "second", "")
                callee_second_return: usize = ElisaProofKernelCore::add_node(&nodes, "resource-region-return", "param", callee_second_use, 0, 1, 0, 0, 0, "r", "")
                ambiguous_start: usize = children.count
                children.push(region_param)
                children.push(callee_first)
                children.push(callee_second)
                children.push(callee_first_use)
                children.push(callee_return)
                children.push(callee_second_use)
                children.push(callee_second_return)
                ambiguous: usize = ElisaProofKernelCore::add_node(&nodes, "resource-safety", "", 0, 0, 2, ambiguous_start, 7, 0, "choose_first", "resource-v1")
                return 210 if not ElisaProofKernelReplay::proof_kernel_replay_resource_report(&nodes, &children, [], ambiguous)
                ambiguous_call: usize = ElisaProofKernelCore::add_node(&nodes, "resource-call", "", ambiguous, 1, 2, call_start, 3, 0, "choose_first", "")
                ambiguous_returned: usize = ElisaProofKernelCore::add_node(&nodes, "resource-region-return", "param-call", ambiguous_call, 0, 1, 0, 0, 0, "r", "second")
                ambiguous_wrapper_start: usize = children.count
                children.push(region_param)
                children.push(wrapper_first)
                children.push(wrapper_second)
                children.push(ambiguous_call)
                children.push(ambiguous_returned)
                ambiguous_wrapper: usize = ElisaProofKernelCore::add_node(&nodes, "resource-safety", "", 0, 0, 2, ambiguous_wrapper_start, 5, 0, "swap_ref", "resource-v1")
                return 211 if ElisaProofKernelReplay::proof_kernel_replay_resource_report(&nodes, &children, [], ambiguous_wrapper)
                return 212 if not ElisaProofKernelReplay::proof_kernel_replay_resource_report(&nodes, &children, [], wrapper)

                # keep(value: T&) -> T&: a region-less reference return names no lifetime, so its
                # witness must be a use of a region-less reference formal of the same mutability.
                keep_value: usize = ElisaProofKernelCore::add_node(&nodes, "resource-bind", "external-shared", 0, 0, 0, 0, 0, 0, "value", "")
                keep_place: usize = ElisaProofKernelCore::add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "value", "")
                keep_use: usize = ElisaProofKernelCore::add_node(&nodes, "resource-use", "", keep_place, 0, 0, 0, 0, 0, "value", "")
                keep_return: usize = ElisaProofKernelCore::add_node(&nodes, "resource-region-return", "param", keep_use, 0, 0, 0, 0, 0, "", "")
                keep_start: usize = children.count
                children.push(keep_value)
                children.push(keep_use)
                children.push(keep_return)
                keep: usize = ElisaProofKernelCore::add_node(&nodes, "resource-safety", "", 0, 0, 1, keep_start, 3, 0, "keep", "resource-v1")
                return 213 if not ElisaProofKernelReplay::proof_kernel_replay_resource_report(&nodes, &children, [], keep)
                # A shared formal cannot witness a mutable result.
                nodes[keep_return].auxiliary <- 1
                return 214 if ElisaProofKernelReplay::proof_kernel_replay_resource_report(&nodes, &children, [], keep)
                nodes[keep_return].auxiliary <- 0
                # A local, even a shared reborrow of the formal, is not the formal: a caller could
                # not map its name to an argument, so it cannot back a returned reference.
                local_source: usize = ElisaProofKernelCore::add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "value", "")
                local_value: usize = ElisaProofKernelCore::add_node(&nodes, "resource-bind", "shared", local_source, 0, 0, 0, 0, 0, "local", "value")
                local_place: usize = ElisaProofKernelCore::add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "local", "")
                local_use: usize = ElisaProofKernelCore::add_node(&nodes, "resource-use", "", local_place, 0, 0, 0, 0, 0, "local", "")
                local_return: usize = ElisaProofKernelCore::add_node(&nodes, "resource-region-return", "param", local_use, 0, 0, 0, 0, 0, "", "")
                local_start: usize = children.count
                children.push(keep_value)
                children.push(local_value)
                children.push(local_use)
                children.push(local_return)
                local_keep: usize = ElisaProofKernelCore::add_node(&nodes, "resource-safety", "", 0, 0, 1, local_start, 4, 0, "keep_local", "resource-v1")
                return 215 if ElisaProofKernelReplay::proof_kernel_replay_resource_report(&nodes, &children, [], local_keep)
                # A region-carrying formal cannot witness a region-less marker either.
                region_use: usize = ElisaProofKernelCore::add_node(&nodes, "resource-use", "", first_place, 0, 0, 0, 0, 0, "first", "")
                region_return: usize = ElisaProofKernelCore::add_node(&nodes, "resource-region-return", "param", region_use, 0, 1, 0, 0, 0, "", "")
                region_start: usize = children.count
                children.push(region_param)
                children.push(wrapper_first)
                children.push(region_use)
                children.push(region_return)
                regioned: usize = ElisaProofKernelCore::add_node(&nodes, "resource-safety", "", 0, 0, 1, region_start, 4, 0, "keep_regioned", "resource-v1")
                return 216 if ElisaProofKernelReplay::proof_kernel_replay_resource_report(&nodes, &children, [], regioned)

                # wrap(value: T&) -> T&: return keep(value), composed through the exact summary.
                wrap_value: usize = ElisaProofKernelCore::add_node(&nodes, "resource-bind", "external-shared", 0, 0, 0, 0, 0, 0, "value", "")
                wrap_place: usize = ElisaProofKernelCore::add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "value", "")
                wrap_argument: usize = ElisaProofKernelCore::add_node(&nodes, "resource-call-arg", "reference", wrap_place, 0, 0, 0, 0, 0, "value", "")
                wrap_call_start: usize = children.count
                children.push(wrap_argument)
                wrap_call: usize = ElisaProofKernelCore::add_node(&nodes, "resource-call", "", keep, 0, 1, wrap_call_start, 1, 0, "keep", "")
                wrap_return: usize = ElisaProofKernelCore::add_node(&nodes, "resource-region-return", "param-call", wrap_call, 0, 0, 0, 0, 0, "", "value")
                wrap_start: usize = children.count
                children.push(wrap_value)
                children.push(wrap_call)
                children.push(wrap_return)
                wrap: usize = ElisaProofKernelCore::add_node(&nodes, "resource-safety", "", 0, 0, 1, wrap_start, 3, 0, "wrap", "resource-v1")
                return 217 if not ElisaProofKernelReplay::proof_kernel_replay_resource_report(&nodes, &children, [], wrap)
                nodes[wrap_return].secondary_name <- "other"
                return 218 if ElisaProofKernelReplay::proof_kernel_replay_resource_report(&nodes, &children, [], wrap)
                nodes[wrap_return].secondary_name <- "value"
                # A region-less summary result cannot be claimed in a named region.
                wrap_return_r: usize = ElisaProofKernelCore::add_node(&nodes, "resource-region-return", "param-call", wrap_call, 0, 0, 0, 0, 0, "r", "value")
                wrap_r_start: usize = children.count
                children.push(wrap_value)
                children.push(wrap_call)
                children.push(wrap_return_r)
                wrap_r: usize = ElisaProofKernelCore::add_node(&nodes, "resource-safety", "", 0, 0, 1, wrap_r_start, 3, 0, "wrap", "resource-v1")
                return 219 if ElisaProofKernelReplay::proof_kernel_replay_resource_report(&nodes, &children, [], wrap_r)
                nodes[wrap_return].auxiliary <- 1
                return 220 if ElisaProofKernelReplay::proof_kernel_replay_resource_report(&nodes, &children, [], wrap)
                nodes[wrap_return].auxiliary <- 0
                # An sview marker always names its lifetime.
                nodes[keep_return].operator <- "sview"
                return 221 if ElisaProofKernelReplay::proof_kernel_replay_resource_report(&nodes, &children, [], keep)
                nodes[keep_return].operator <- "param"
                return 222 if not ElisaProofKernelReplay::proof_kernel_replay_resource_report(&nodes, &children, [], wrap)
                return 0
