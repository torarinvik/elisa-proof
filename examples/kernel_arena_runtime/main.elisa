# One executable entry point for the independently scoped adversarial kernel suites.
include "../../src/proof/kernel_core.elisa"
include "../../src/proof/kernel_replay.elisa"
include "./admission.elisa"
include "./resource_places.elisa"
include "./resource_regions.elisa"
include "./resource_calls.elisa"
include "./resource_aliases.elisa"
include "./tactic_rewrite.elisa"
include "./resource_transitions.elisa"
include "./quantifier_substitution.elisa"
include "./termination_arithmetic.elisa"

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        suite_1_status: i64 = ElisaProofArenaAdmissionTests::run()
        return suite_1_status if suite_1_status != 0
        suite_2_status: i64 = ElisaProofResourcePlaceTests::run()
        return suite_2_status if suite_2_status != 0
        suite_3_status: i64 = ElisaProofResourceRegionTests::run()
        return suite_3_status if suite_3_status != 0
        suite_4_status: i64 = ElisaProofResourceCallTests::run()
        return suite_4_status if suite_4_status != 0
        suite_5_status: i64 = ElisaProofResourceAliasTests::run()
        return suite_5_status if suite_5_status != 0
        suite_6_status: i64 = ElisaProofTacticRewriteTests::run()
        return suite_6_status if suite_6_status != 0
        suite_7_status: i64 = ElisaProofResourceTransitionTests::run()
        return suite_7_status if suite_7_status != 0
        suite_8_status: i64 = ElisaProofQuantifierSubstitutionTests::run()
        return suite_8_status if suite_8_status != 0
        suite_9_status: i64 = ElisaProofTerminationArithmeticTests::run()
        return suite_9_status if suite_9_status != 0
        return 0
