# Region-polymorphic call summaries and ownership transitions that share one serialized call arena.
module ElisaProofResourceCallTests:
    private:
        const GENERIC_CALL_CHILD_CAPACITY: usize = 76
    public:
        def run() -> i64 can[Memory.Allocate, Abort.Panic]:
            can Memory.Allocate, Abort.Panic:
                # A valid region-polymorphic call carries an explicit formal/actual map. Its returned
                # reference is admitted only when the callee's region-return summary agrees with the mapped
                # live caller region; the following certificate changes only that result label and must fail.
                generic_call_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                generic_call_children: mutable darray[usize] = []
                # Reserve the complete fixture child arena before the independent node arenas allocate.
                _ = generic_call_children.reserve(GENERIC_CALL_CHILD_CAPACITY)
                generic_region_param: usize = ElisaProofKernelCore::add_node(&generic_call_nodes, "resource-region-param", "external", 0, 0, 0, 0, 0, 0, "r", "")
                generic_owner: usize = ElisaProofKernelCore::add_node(&generic_call_nodes, "resource-bind", "external-shared", 0, 0, 0, 0, 0, 0, "owner", "r")
                generic_value: usize = ElisaProofKernelCore::add_node(&generic_call_nodes, "resource-bind", "value", 0, 0, 0, 0, 0, 0, "value", "")
                generic_return_value: usize = ElisaProofKernelCore::add_node(&generic_call_nodes, "int", "", 0, 0, 0, 0, 0, 9, "", "")
                generic_return_alloc: usize = ElisaProofKernelCore::add_node(&generic_call_nodes, "resource-region-return-alloc", "", generic_return_value, 0, 0, 0, 0, 0, "", "r")
                generic_return: usize = ElisaProofKernelCore::add_node(&generic_call_nodes, "resource-region-return", "param", generic_return_alloc, 0, 0, 0, 0, 0, "r", "")
                generic_callee_children_start: usize = generic_call_children.count
                generic_call_children.push(generic_region_param)
                generic_call_children.push(generic_owner)
                generic_call_children.push(generic_value)
                generic_call_children.push(generic_return_alloc)
                generic_call_children.push(generic_return)
                generic_callee: usize = ElisaProofKernelCore::add_node(&generic_call_nodes, "resource-safety", "", 0, 0, 2, generic_callee_children_start, 5, 0, "make", "resource-v1")
                generic_caller_open: usize = ElisaProofKernelCore::add_node(&generic_call_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "scratch", "")
                generic_seed_value: usize = ElisaProofKernelCore::add_node(&generic_call_nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
                generic_seed_alloc: usize = ElisaProofKernelCore::add_node(&generic_call_nodes, "resource-region-alloc", "", generic_seed_value, 0, 2, 0, 0, 0, "seed", "scratch")
                generic_seed_place: usize = ElisaProofKernelCore::add_node(&generic_call_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "seed", "")
                generic_call_arg_owner: usize = ElisaProofKernelCore::add_node(&generic_call_nodes, "resource-call-arg", "reference", generic_seed_place, 0, 0, 0, 0, 0, "owner", "")
                generic_call_arg_value: usize = ElisaProofKernelCore::add_node(&generic_call_nodes, "resource-call-arg", "value", generic_seed_value, 0, 0, 0, 0, 0, "value", "")
                generic_call_region: usize = ElisaProofKernelCore::add_node(&generic_call_nodes, "resource-call-region", "param", 0, 0, 0, 0, 0, 0, "r", "scratch")
                generic_call_children_start: usize = generic_call_children.count
                generic_call_children.push(generic_call_arg_owner)
                generic_call_children.push(generic_call_arg_value)
                generic_call_children.push(generic_call_region)
                generic_call: usize = ElisaProofKernelCore::add_node(&generic_call_nodes, "resource-call", "", generic_callee, 1, 2, generic_call_children_start, 3, 0, "make", "")
                generic_result: usize = ElisaProofKernelCore::add_node(&generic_call_nodes, "resource-call-result", "", generic_call, 0, 2, 0, 0, 0, "value", "scratch")
                generic_close: usize = ElisaProofKernelCore::add_node(&generic_call_nodes, "resource-region-close", "", 0, 0, 0, 0, 0, 0, "scratch", "")
                generic_caller_children_start: usize = generic_call_children.count
                generic_call_children.push(generic_caller_open)
                generic_call_children.push(generic_seed_alloc)
                generic_call_children.push(generic_call)
                generic_call_children.push(generic_result)
                generic_call_children.push(generic_close)
                generic_caller: usize = ElisaProofKernelCore::add_node(&generic_call_nodes, "resource-safety", "", 0, 0, 0, generic_caller_children_start, 5, 0, "caller", "resource-v1")
                generic_callee_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&generic_call_nodes, &generic_call_children, [], generic_callee)
                return 31 if not generic_callee_admitted
                generic_setup: usize = ElisaProofKernelCore::add_node(&generic_call_nodes, "resource-safety", "", 0, 0, 0, generic_caller_children_start, 2, 0, "setup", "resource-v1")
                generic_setup_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_prefix(&generic_call_nodes, &generic_call_children, [], generic_setup)
                return 34 if not generic_setup_admitted
                generic_call_prefix: usize = ElisaProofKernelCore::add_node(&generic_call_nodes, "resource-safety", "", 0, 0, 0, generic_caller_children_start, 3, 0, "call-prefix", "resource-v1")
                generic_call_prefix_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_prefix(&generic_call_nodes, &generic_call_children, [], generic_call_prefix)
                return 32 if not generic_call_prefix_admitted
                generic_call_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&generic_call_nodes, &generic_call_children, [], generic_caller)
                return 29 if not generic_call_admitted
                forged_generic_result: usize = ElisaProofKernelCore::add_node(&generic_call_nodes, "resource-call-result", "", generic_call, 0, 2, 0, 0, 0, "value", "wrong-region")
                forged_generic_children_start: usize = generic_call_children.count
                generic_call_children.push(generic_caller_open)
                generic_call_children.push(generic_seed_alloc)
                generic_call_children.push(generic_call)
                generic_call_children.push(forged_generic_result)
                generic_call_children.push(generic_close)
                forged_generic_caller: usize = ElisaProofKernelCore::add_node(&generic_call_nodes, "resource-safety", "", 0, 0, 0, forged_generic_children_start, 5, 0, "forged-caller", "resource-v1")
                forged_generic_result_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&generic_call_nodes, &generic_call_children, [], forged_generic_caller)
                return 30 if forged_generic_result_admitted

                # A result event cannot stand in for its call. The event must follow a call that the replay
                # kernel actually accepted in this trace, not merely point at a valid call node in the arena.
                missing_call_event_start: usize = generic_call_children.count
                generic_call_children.push(generic_caller_open)
                generic_call_children.push(generic_seed_alloc)
                generic_call_children.push(generic_result)
                generic_call_children.push(generic_close)
                missing_call_event: usize = ElisaProofKernelCore::add_node(&generic_call_nodes, "resource-safety", "", 0, 0, 0, missing_call_event_start, 4, 0, "missing-call-event", "resource-v1")
                missing_call_event_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&generic_call_nodes, &generic_call_children, [], missing_call_event)
                return 46 if missing_call_event_admitted

                # A single serialized call may produce at most one resource result and may be replayed only
                # once. Otherwise one call node could duplicate an effect or mint multiple output bindings.
                duplicate_result_start: usize = generic_call_children.count
                generic_call_children.push(generic_caller_open)
                generic_call_children.push(generic_seed_alloc)
                generic_call_children.push(generic_call)
                generic_call_children.push(generic_result)
                generic_call_children.push(generic_result)
                generic_call_children.push(generic_close)
                duplicate_result: usize = ElisaProofKernelCore::add_node(&generic_call_nodes, "resource-safety", "", 0, 0, 0, duplicate_result_start, 6, 0, "duplicate-result", "resource-v1")
                duplicate_result_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&generic_call_nodes, &generic_call_children, [], duplicate_result)
                return 50 if duplicate_result_admitted

                # One observed return-allocation witness cannot justify two serialized return markers.
                duplicate_return_witness_start: usize = generic_call_children.count
                generic_call_children.push(generic_region_param)
                generic_call_children.push(generic_owner)
                generic_call_children.push(generic_value)
                generic_call_children.push(generic_return_alloc)
                generic_call_children.push(generic_return)
                generic_call_children.push(generic_return)
                duplicate_return_witness: usize = ElisaProofKernelCore::add_node(&generic_call_nodes, "resource-safety", "", 0, 0, 2, duplicate_return_witness_start, 6, 0, "duplicate-return-witness", "resource-v1")
                duplicate_return_witness_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&generic_call_nodes, &generic_call_children, [], duplicate_return_witness)
                return 83 if duplicate_return_witness_admitted

                duplicate_call_start: usize = generic_call_children.count
                generic_call_children.push(generic_caller_open)
                generic_call_children.push(generic_seed_alloc)
                generic_call_children.push(generic_call)
                generic_call_children.push(generic_call)
                generic_call_children.push(generic_close)
                duplicate_call: usize = ElisaProofKernelCore::add_node(&generic_call_nodes, "resource-safety", "", 0, 0, 0, duplicate_call_start, 5, 0, "duplicate-call", "resource-v1")
                duplicate_call_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&generic_call_nodes, &generic_call_children, [], duplicate_call)
                return 51 if duplicate_call_admitted

                # A callee summary cannot leave a local region active. External region parameters may cross
                # the call boundary, but a callee-local region must be closed before its effects are composed.
                leaky_callee_open: usize = ElisaProofKernelCore::add_node(&generic_call_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "local", "")
                leaky_callee_start: usize = generic_call_children.count
                generic_call_children.push(generic_region_param)
                generic_call_children.push(generic_owner)
                generic_call_children.push(generic_value)
                generic_call_children.push(leaky_callee_open)
                generic_call_children.push(generic_return)
                leaky_callee: usize = ElisaProofKernelCore::add_node(&generic_call_nodes, "resource-safety", "", 0, 0, 2, leaky_callee_start, 5, 0, "leaky-make", "resource-v1")
                leaky_call_start: usize = generic_call_children.count
                generic_call_children.push(generic_call_arg_owner)
                generic_call_children.push(generic_call_arg_value)
                generic_call_children.push(generic_call_region)
                leaky_call: usize = ElisaProofKernelCore::add_node(&generic_call_nodes, "resource-call", "", leaky_callee, 1, 2, leaky_call_start, 3, 0, "leaky-make", "")
                leaky_report_start: usize = generic_call_children.count
                generic_call_children.push(generic_caller_open)
                generic_call_children.push(generic_seed_alloc)
                generic_call_children.push(leaky_call)
                leaky_report: usize = ElisaProofKernelCore::add_node(&generic_call_nodes, "resource-safety", "", 0, 0, 0, leaky_report_start, 3, 0, "leaky-caller", "resource-v1")
                leaky_report_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&generic_call_nodes, &generic_call_children, [], leaky_report)
                return 53 if leaky_report_admitted

                # A call-result certificate cannot upgrade a shared region return into a mutable reference.
                # The callee summary must carry and independently constrain the returned mutability bit.
                forged_mutable_result: usize = ElisaProofKernelCore::add_node(&generic_call_nodes, "resource-call-result", "", generic_call, 0, 6, 0, 0, 0, "forged", "scratch")
                forged_mutable_result_place: usize = ElisaProofKernelCore::add_node(&generic_call_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "forged", "")
                forged_mutable_result_write: usize = ElisaProofKernelCore::add_node(&generic_call_nodes, "resource-write", "", forged_mutable_result_place, 0, 0, 0, 0, 0, "forged", "")
                forged_mutable_result_start: usize = generic_call_children.count
                generic_call_children.push(generic_caller_open)
                generic_call_children.push(generic_seed_alloc)
                generic_call_children.push(generic_call)
                generic_call_children.push(forged_mutable_result)
                generic_call_children.push(forged_mutable_result_write)
                generic_call_children.push(generic_close)
                forged_mutable_result_report: usize = ElisaProofKernelCore::add_node(&generic_call_nodes, "resource-safety", "", 0, 0, 0, forged_mutable_result_start, 6, 0, "forged-mutable-result", "resource-v1")
                forged_mutable_result_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&generic_call_nodes, &generic_call_children, [], forged_mutable_result_report)
                return 65 if forged_mutable_result_admitted

                mutable_result_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                mutable_result_children: mutable darray[usize] = []
                mutable_result_region_param: usize = ElisaProofKernelCore::add_node(&mutable_result_nodes, "resource-region-param", "external", 0, 0, 0, 0, 0, 0, "r", "")
                mutable_result_formal: usize = ElisaProofKernelCore::add_node(&mutable_result_nodes, "resource-bind", "external-mutable", 0, 0, 1, 0, 0, 0, "owner", "r")
                mutable_result_return_value: usize = ElisaProofKernelCore::add_node(&mutable_result_nodes, "int", "", 0, 0, 0, 0, 0, 9, "", "")
                mutable_result_return_alloc: usize = ElisaProofKernelCore::add_node(&mutable_result_nodes, "resource-region-return-alloc", "", mutable_result_return_value, 0, 0, 0, 0, 0, "", "r")
                mutable_result_return: usize = ElisaProofKernelCore::add_node(&mutable_result_nodes, "resource-region-return", "param", mutable_result_return_alloc, 0, 1, 0, 0, 0, "r", "")
                mutable_result_callee_start: usize = mutable_result_children.count
                mutable_result_children.push(mutable_result_region_param)
                mutable_result_children.push(mutable_result_formal)
                mutable_result_children.push(mutable_result_return_alloc)
                mutable_result_children.push(mutable_result_return)
                mutable_result_callee: usize = ElisaProofKernelCore::add_node(&mutable_result_nodes, "resource-safety", "", 0, 0, 1, mutable_result_callee_start, 4, 0, "make-mutable", "resource-v1")
                mutable_result_caller_open: usize = ElisaProofKernelCore::add_node(&mutable_result_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "scratch", "")
                mutable_result_seed_value: usize = ElisaProofKernelCore::add_node(&mutable_result_nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
                mutable_result_seed: usize = ElisaProofKernelCore::add_node(&mutable_result_nodes, "resource-region-alloc", "", mutable_result_seed_value, 0, 6, 0, 0, 0, "seed", "scratch")
                mutable_result_seed_place: usize = ElisaProofKernelCore::add_node(&mutable_result_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "seed", "")
                mutable_result_call_arg: usize = ElisaProofKernelCore::add_node(&mutable_result_nodes, "resource-call-arg", "reference", mutable_result_seed_place, 0, 0, 0, 0, 0, "owner", "")
                mutable_result_call_region: usize = ElisaProofKernelCore::add_node(&mutable_result_nodes, "resource-call-region", "param", 0, 0, 0, 0, 0, 0, "r", "scratch")
                mutable_result_call_start: usize = mutable_result_children.count
                mutable_result_children.push(mutable_result_call_arg)
                mutable_result_children.push(mutable_result_call_region)
                mutable_result_call: usize = ElisaProofKernelCore::add_node(&mutable_result_nodes, "resource-call", "", mutable_result_callee, 1, 1, mutable_result_call_start, 2, 0, "make-mutable", "")
                mutable_result_result: usize = ElisaProofKernelCore::add_node(&mutable_result_nodes, "resource-call-result", "", mutable_result_call, 0, 6, 0, 0, 0, "value", "scratch")
                mutable_result_place: usize = ElisaProofKernelCore::add_node(&mutable_result_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "value", "")
                mutable_result_write: usize = ElisaProofKernelCore::add_node(&mutable_result_nodes, "resource-write", "", mutable_result_place, 0, 0, 0, 0, 0, "value", "")
                mutable_result_close: usize = ElisaProofKernelCore::add_node(&mutable_result_nodes, "resource-region-close", "", 0, 0, 0, 0, 0, 0, "scratch", "")
                mutable_result_report_start: usize = mutable_result_children.count
                mutable_result_children.push(mutable_result_caller_open)
                mutable_result_children.push(mutable_result_seed)
                mutable_result_children.push(mutable_result_call)
                mutable_result_children.push(mutable_result_result)
                mutable_result_children.push(mutable_result_write)
                mutable_result_children.push(mutable_result_close)
                mutable_result_report: usize = ElisaProofKernelCore::add_node(&mutable_result_nodes, "resource-safety", "", 0, 0, 0, mutable_result_report_start, 6, 0, "mutable-result", "resource-v1")
                mutable_result_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&mutable_result_nodes, &mutable_result_children, [], mutable_result_report)
                return 66 if not mutable_result_admitted

                # A fresh allocation returned by a callee transfers its owner to the result. Aliasing the
                # result must consume that result before the original handle can be used again.
                fresh_result_alias_source_place: usize = ElisaProofKernelCore::add_node(&mutable_result_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "value", "")
                fresh_result_alias: usize = ElisaProofKernelCore::add_node(&mutable_result_nodes, "resource-region-bind", "", fresh_result_alias_source_place, 0, 6, 0, 0, 0, "alias", "scratch")
                fresh_result_alias_place: usize = ElisaProofKernelCore::add_node(&mutable_result_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "alias", "")
                fresh_result_alias_write: usize = ElisaProofKernelCore::add_node(&mutable_result_nodes, "resource-write", "", fresh_result_alias_place, 0, 0, 0, 0, 0, "alias", "")
                fresh_result_original_place: usize = ElisaProofKernelCore::add_node(&mutable_result_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "value", "")
                fresh_result_original_write: usize = ElisaProofKernelCore::add_node(&mutable_result_nodes, "resource-write", "", fresh_result_original_place, 0, 0, 0, 0, 0, "value", "")
                fresh_result_alias_start: usize = mutable_result_children.count
                mutable_result_children.push(mutable_result_caller_open)
                mutable_result_children.push(mutable_result_seed)
                mutable_result_children.push(mutable_result_call)
                mutable_result_children.push(mutable_result_result)
                mutable_result_children.push(fresh_result_alias)
                mutable_result_children.push(fresh_result_alias_write)
                mutable_result_children.push(fresh_result_original_write)
                mutable_result_children.push(mutable_result_close)
                fresh_result_alias_report: usize = ElisaProofKernelCore::add_node(&mutable_result_nodes, "resource-safety", "", 0, 0, 0, fresh_result_alias_start, 8, 0, "fresh-result-owner-transfer", "resource-v1")
                fresh_result_alias_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&mutable_result_nodes, &mutable_result_children, [], fresh_result_alias_report)
                return 90 if fresh_result_alias_admitted

                # Returning a reference formal preserves the caller's place. The result may be used after
                # the call, but the original reference handle is transferred and cannot be used again.
                alias_return_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                alias_return_children: mutable darray[usize] = []
                alias_return_region_param: usize = ElisaProofKernelCore::add_node(&alias_return_nodes, "resource-region-param", "external", 0, 0, 0, 0, 0, 0, "r", "")
                alias_return_formal: usize = ElisaProofKernelCore::add_node(&alias_return_nodes, "resource-bind", "external-mutable", 0, 0, 1, 0, 0, 0, "owner", "r")
                alias_return_place: usize = ElisaProofKernelCore::add_node(&alias_return_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "owner", "")
                alias_return_use: usize = ElisaProofKernelCore::add_node(&alias_return_nodes, "resource-use", "", alias_return_place, 0, 0, 0, 0, 0, "owner", "")
                alias_return_marker: usize = ElisaProofKernelCore::add_node(&alias_return_nodes, "resource-region-return", "param", alias_return_use, 0, 1, 0, 0, 0, "r", "")
                alias_return_callee_start: usize = alias_return_children.count
                alias_return_children.push(alias_return_region_param)
                alias_return_children.push(alias_return_formal)
                alias_return_children.push(alias_return_use)
                alias_return_children.push(alias_return_marker)
                alias_return_callee: usize = ElisaProofKernelCore::add_node(&alias_return_nodes, "resource-safety", "", 0, 0, 1, alias_return_callee_start, 4, 0, "return-owner", "resource-v1")
                alias_return_open: usize = ElisaProofKernelCore::add_node(&alias_return_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "scratch", "")
                alias_return_seed_value: usize = ElisaProofKernelCore::add_node(&alias_return_nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
                alias_return_seed: usize = ElisaProofKernelCore::add_node(&alias_return_nodes, "resource-region-alloc", "", alias_return_seed_value, 0, 6, 0, 0, 0, "seed", "scratch")
                alias_return_seed_place: usize = ElisaProofKernelCore::add_node(&alias_return_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "seed", "")
                alias_return_call_arg: usize = ElisaProofKernelCore::add_node(&alias_return_nodes, "resource-call-arg", "reference", alias_return_seed_place, 0, 0, 0, 0, 0, "owner", "")
                alias_return_call_region: usize = ElisaProofKernelCore::add_node(&alias_return_nodes, "resource-call-region", "param", 0, 0, 0, 0, 0, 0, "r", "scratch")
                alias_return_call_start: usize = alias_return_children.count
                alias_return_children.push(alias_return_call_arg)
                alias_return_children.push(alias_return_call_region)
                alias_return_call: usize = ElisaProofKernelCore::add_node(&alias_return_nodes, "resource-call", "", alias_return_callee, 1, 1, alias_return_call_start, 2, 0, "return-owner", "")
                alias_return_result: usize = ElisaProofKernelCore::add_node(&alias_return_nodes, "resource-call-result", "", alias_return_call, 0, 7, 0, 0, 0, "alias", "scratch")
                alias_return_alias_place: usize = ElisaProofKernelCore::add_node(&alias_return_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "alias", "")
                alias_return_alias_write: usize = ElisaProofKernelCore::add_node(&alias_return_nodes, "resource-write", "", alias_return_alias_place, 0, 0, 0, 0, 0, "alias", "")
                alias_return_seed_after_place: usize = ElisaProofKernelCore::add_node(&alias_return_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "seed", "")
                alias_return_seed_after_use: usize = ElisaProofKernelCore::add_node(&alias_return_nodes, "resource-use", "", alias_return_seed_after_place, 0, 0, 0, 0, 0, "seed", "")
                alias_return_close: usize = ElisaProofKernelCore::add_node(&alias_return_nodes, "resource-region-close", "", 0, 0, 0, 0, 0, 0, "scratch", "")
                alias_return_valid_start: usize = alias_return_children.count
                alias_return_children.push(alias_return_open)
                alias_return_children.push(alias_return_seed)
                alias_return_children.push(alias_return_call)
                alias_return_children.push(alias_return_result)
                alias_return_children.push(alias_return_alias_write)
                alias_return_children.push(alias_return_close)
                alias_return_valid_report: usize = ElisaProofKernelCore::add_node(&alias_return_nodes, "resource-safety", "", 0, 0, 0, alias_return_valid_start, 6, 0, "valid-reference-return-alias", "resource-v1")
                alias_return_valid_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&alias_return_nodes, &alias_return_children, [], alias_return_valid_report)
                return 81 if not alias_return_valid_admitted
                alias_return_rejected_start: usize = alias_return_children.count
                alias_return_children.push(alias_return_open)
                alias_return_children.push(alias_return_seed)
                alias_return_children.push(alias_return_call)
                alias_return_children.push(alias_return_result)
