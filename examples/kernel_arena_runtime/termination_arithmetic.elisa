# Structural descent certificates and signed/unsigned arithmetic adversaries.
module ElisaProofTerminationArithmeticTests:
    public:
        def run() -> i64 can[Memory.Allocate, Abort.Panic]:
            can Memory.Allocate, Abort.Panic:
                # strict descent. The standalone kernel accepts a well-formed trace and rejects forged
                # all-preserved, duplicate-subject, and mismatched-preservation traces.
                structural_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                structural_children: mutable darray[usize] = []
                structural_same: usize = ElisaProofKernelCore::add_node(&structural_nodes, "structural-argument", "same", 0, 0, 1, 0, 0, 1, "left", "left")
                structural_strict: usize = ElisaProofKernelCore::add_node(&structural_nodes, "structural-argument", "strict", 0, 0, 2, 0, 0, 3, "right", "prev")
                structural_children.push(structural_same)
                structural_children.push(structural_strict)
                structural_edge: usize = ElisaProofKernelCore::add_node(&structural_nodes, "structural-edge", "", 0, 0, 2, 0, 2, 0, "product", "product")
                structural_children.push(structural_edge)
                structural_root: usize = ElisaProofKernelCore::add_node(&structural_nodes, "structural-safety", "", 0, 0, 0, 2, 1, 0, "product", "structural-v1")
                return 65 if not ElisaProofKernelReplay::proof_kernel_replay_structural_report(&structural_nodes, &structural_children, [], structural_root)

                structural_no_strict_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                structural_no_strict_children: mutable darray[usize] = []
                structural_no_strict_same: usize = ElisaProofKernelCore::add_node(&structural_no_strict_nodes, "structural-argument", "same", 0, 0, 1, 0, 0, 1, "n", "n")
                structural_no_strict_children.push(structural_no_strict_same)
                structural_no_strict_edge: usize = ElisaProofKernelCore::add_node(&structural_no_strict_nodes, "structural-edge", "", 0, 0, 1, 0, 1, 0, "loop", "loop")
                structural_no_strict_children.push(structural_no_strict_edge)
                structural_no_strict_root: usize = ElisaProofKernelCore::add_node(&structural_no_strict_nodes, "structural-safety", "", 0, 0, 0, 1, 1, 0, "loop", "structural-v1")
                return 66 if ElisaProofKernelReplay::proof_kernel_replay_structural_report(&structural_no_strict_nodes, &structural_no_strict_children, [], structural_no_strict_root)

                structural_duplicate_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                structural_duplicate_children: mutable darray[usize] = []
                structural_duplicate_first: usize = ElisaProofKernelCore::add_node(&structural_duplicate_nodes, "structural-argument", "strict", 0, 0, 2, 0, 0, 1, "n", "prev")
                structural_duplicate_second: usize = ElisaProofKernelCore::add_node(&structural_duplicate_nodes, "structural-argument", "strict", 0, 0, 3, 0, 0, 1, "n", "tail")
                structural_duplicate_children.push(structural_duplicate_first)
                structural_duplicate_children.push(structural_duplicate_second)
                structural_duplicate_edge: usize = ElisaProofKernelCore::add_node(&structural_duplicate_nodes, "structural-edge", "", 0, 0, 2, 0, 2, 0, "loop", "loop")
                structural_duplicate_children.push(structural_duplicate_edge)
                structural_duplicate_root: usize = ElisaProofKernelCore::add_node(&structural_duplicate_nodes, "structural-safety", "", 0, 0, 0, 2, 1, 0, "loop", "structural-v1")
                return 67 if ElisaProofKernelReplay::proof_kernel_replay_structural_report(&structural_duplicate_nodes, &structural_duplicate_children, [], structural_duplicate_root)

                structural_mismatch_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                structural_mismatch_children: mutable darray[usize] = []
                structural_mismatch_same: usize = ElisaProofKernelCore::add_node(&structural_mismatch_nodes, "structural-argument", "same", 0, 0, 1, 0, 0, 1, "n", "other")
                structural_mismatch_children.push(structural_mismatch_same)
                structural_mismatch_strict: usize = ElisaProofKernelCore::add_node(&structural_mismatch_nodes, "structural-argument", "strict", 0, 0, 2, 0, 0, 1, "m", "prev")
                structural_mismatch_children.push(structural_mismatch_strict)
                structural_mismatch_edge: usize = ElisaProofKernelCore::add_node(&structural_mismatch_nodes, "structural-edge", "", 0, 0, 2, 0, 2, 0, "loop", "loop")
                structural_mismatch_children.push(structural_mismatch_edge)
                structural_mismatch_root: usize = ElisaProofKernelCore::add_node(&structural_mismatch_nodes, "structural-safety", "", 0, 0, 0, 2, 1, 0, "loop", "structural-v1")
                return 68 if ElisaProofKernelReplay::proof_kernel_replay_structural_report(&structural_mismatch_nodes, &structural_mismatch_children, [], structural_mismatch_root)

                # Equal spellings are valid only when the lexical identities differ. A forged strict witness
                # that reuses the subject identity must remain rejected even though its names are identical.
                structural_shadowed_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                structural_shadowed_children: mutable darray[usize] = []
                structural_shadowed_argument: usize = ElisaProofKernelCore::add_node(&structural_shadowed_nodes, "structural-argument", "strict", 0, 0, 1, 0, 0, 1, "value", "value")
                structural_shadowed_children.push(structural_shadowed_argument)
                structural_shadowed_edge: usize = ElisaProofKernelCore::add_node(&structural_shadowed_nodes, "structural-edge", "", 0, 0, 1, 0, 1, 0, "shadowed", "shadowed")
                structural_shadowed_children.push(structural_shadowed_edge)
                structural_shadowed_root: usize = ElisaProofKernelCore::add_node(&structural_shadowed_nodes, "structural-safety", "", 0, 0, 0, 2, 1, 0, "shadowed", "structural-v1")
                return 69 if ElisaProofKernelReplay::proof_kernel_replay_structural_report(&structural_shadowed_nodes, &structural_shadowed_children, [], structural_shadowed_root)

                # An empty structural trace must not pass by vacuous truth: there is no recursive
                # edge and therefore no strict descent witness.
                structural_empty_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                structural_empty_children: mutable darray[usize] = []
                structural_empty_root: usize = ElisaProofKernelCore::add_node(&structural_empty_nodes, "structural-safety", "", 0, 0, 0, 0, 0, 0, "empty", "structural-v1")
                return 70 if ElisaProofKernelReplay::proof_kernel_replay_structural_report(&structural_empty_nodes, &structural_empty_children, [], structural_empty_root)

                # A negative affine fact and goal keep their sign in the difference graph: `0 - x <= 0`
                # means `x >= 0`, so it must not prove the false converse `x <= 0`. The bounded facts make negation safe at
                # fixed-width endpoints, ensuring this exercises difference normalization rather than an
                # overflow conservatism fallback.
                negative_difference_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                negative_difference_children: mutable darray[usize] = []
                negative_difference_x: usize = ElisaProofKernelCore::add_node(&negative_difference_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "x", "")
                negative_difference_ten: usize = ElisaProofKernelCore::add_node(&negative_difference_nodes, "int", "", 0, 0, 0, 0, 0, 10, "", "")
                negative_difference_minus_ten: usize = ElisaProofKernelCore::add_node(&negative_difference_nodes, "int", "", 0, 0, 0, 0, 0, -10, "", "")
                negative_difference_zero: usize = ElisaProofKernelCore::add_node(&negative_difference_nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
                negative_difference_lower: usize = ElisaProofKernelCore::add_node(&negative_difference_nodes, "binary", ">=", negative_difference_x, negative_difference_minus_ten, 0, 0, 0, 0, "", "")
                negative_difference_upper: usize = ElisaProofKernelCore::add_node(&negative_difference_nodes, "binary", "<=", negative_difference_x, negative_difference_ten, 0, 0, 0, 0, "", "")
                negative_difference_negated_x: usize = ElisaProofKernelCore::add_node(&negative_difference_nodes, "binary", "-", negative_difference_zero, negative_difference_x, 0, 0, 0, 0, "", "")
                negative_difference_fact: usize = ElisaProofKernelCore::add_node(&negative_difference_nodes, "binary", "<=", negative_difference_negated_x, negative_difference_zero, 0, 0, 0, 0, "", "")
                negative_difference_goal: usize = ElisaProofKernelCore::add_node(&negative_difference_nodes, "binary", "<=", negative_difference_x, negative_difference_zero, 0, 0, 0, 0, "", "")
                negative_difference_marker_callee: usize = ElisaProofKernelCore::add_node(&negative_difference_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "__elisa_primitive_scalar_type", "")
                negative_difference_marker_argument: usize = ElisaProofKernelCore::add_node(&negative_difference_nodes, "call_arg", "", negative_difference_x, 0, 0, 0, 0, 0, "", "")
                negative_difference_marker_start: usize = negative_difference_children.count
                negative_difference_children.push(negative_difference_marker_argument)
                negative_difference_marker: usize = ElisaProofKernelCore::add_node(&negative_difference_nodes, "call", "", negative_difference_marker_callee, 0, 0, negative_difference_marker_start, 1, 0, "", "")
                negative_difference_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_goal_report(&negative_difference_nodes, &negative_difference_children, [negative_difference_lower, negative_difference_upper, negative_difference_fact, negative_difference_marker], negative_difference_goal)
                return 94 if negative_difference_admitted
                negative_difference_reverse_goal: usize = ElisaProofKernelCore::add_node(&negative_difference_nodes, "binary", "<=", negative_difference_negated_x, negative_difference_zero, 0, 0, 0, 0, "", "")
                negative_difference_reverse_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_goal_report(&negative_difference_nodes, &negative_difference_children, [negative_difference_lower, negative_difference_upper, negative_difference_upper, negative_difference_marker], negative_difference_reverse_goal)
                return 96 if negative_difference_reverse_admitted
                negative_difference_positive_goal: usize = ElisaProofKernelCore::add_node(&negative_difference_nodes, "binary", ">=", negative_difference_x, negative_difference_zero, 0, 0, 0, 0, "", "")
                negative_difference_positive_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_goal_report(&negative_difference_nodes, &negative_difference_children, [negative_difference_lower, negative_difference_upper, negative_difference_fact, negative_difference_marker], negative_difference_positive_goal)
                return 95 if not negative_difference_positive_admitted

                # Fixed-width unsigned arithmetic must not fall through to the signed interval model. This
                # hostile certificate supplies a valid u8 marker and the exact endpoint x == 255, then claims
                # that x + 1 > x. The runtime wraps that addition to zero, so independent kernel replay must
                # reject the goal even though its signed model would otherwise see 256 > 255.
                unsigned_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                unsigned_children: mutable darray[usize] = []
                unsigned_zero: usize = ElisaProofKernelCore::add_node(&unsigned_nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
                unsigned_one: usize = ElisaProofKernelCore::add_node(&unsigned_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
                unsigned_max: usize = ElisaProofKernelCore::add_node(&unsigned_nodes, "int", "", 0, 0, 0, 0, 0, 255, "", "")
                unsigned_x: usize = ElisaProofKernelCore::add_node(&unsigned_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "x", "")
                unsigned_lower: usize = ElisaProofKernelCore::add_node(&unsigned_nodes, "binary", "<=", unsigned_zero, unsigned_x, 0, 0, 0, 0, "", "")
                unsigned_upper: usize = ElisaProofKernelCore::add_node(&unsigned_nodes, "binary", "<=", unsigned_x, unsigned_max, 0, 0, 0, 0, "", "")
                unsigned_equal: usize = ElisaProofKernelCore::add_node(&unsigned_nodes, "binary", "==", unsigned_x, unsigned_max, 0, 0, 0, 0, "", "")
                unsigned_callee: usize = ElisaProofKernelCore::add_node(&unsigned_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "__elisa_unsigned_type_bound", "")
                unsigned_marker_arg: usize = ElisaProofKernelCore::add_node(&unsigned_nodes, "call_arg", "", unsigned_x, 0, 0, 0, 0, 0, "", "")
                unsigned_marker_width: usize = ElisaProofKernelCore::add_node(&unsigned_nodes, "call_arg", "", ElisaProofKernelCore::add_node(&unsigned_nodes, "int", "", 0, 0, 0, 0, 0, 8, "", ""), 0, 0, 0, 0, 0, "", "")
                unsigned_marker_start: usize = unsigned_children.count
                unsigned_children.push(unsigned_marker_arg)
                unsigned_children.push(unsigned_marker_width)
                unsigned_marker: usize = ElisaProofKernelCore::add_node(&unsigned_nodes, "call", "", unsigned_callee, 0, 0, unsigned_marker_start, 2, 0, "", "")
                unsigned_sum: usize = ElisaProofKernelCore::add_node(&unsigned_nodes, "binary", "+", unsigned_x, unsigned_one, 0, 0, 0, 0, "", "")
                unsigned_goal: usize = ElisaProofKernelCore::add_node(&unsigned_nodes, "binary", ">", unsigned_sum, unsigned_x, 0, 0, 0, 0, "", "")
                unsigned_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_goal_report(&unsigned_nodes, &unsigned_children, [unsigned_lower, unsigned_marker, unsigned_upper, unsigned_equal], unsigned_goal)
                return 97 if unsigned_admitted

                # The unsigned operation can hide in a premise while the goal contains only
                # scalar equality. Its wrapping truth must not become signed inconsistency.
                unsigned_y: usize = ElisaProofKernelCore::add_node(&unsigned_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "y", "")
                unsigned_y_zero: usize = ElisaProofKernelCore::add_node(&unsigned_nodes, "binary", "==", unsigned_y, unsigned_zero, 0, 0, 0, 0, "", "")
                unsigned_y_sum: usize = ElisaProofKernelCore::add_node(&unsigned_nodes, "binary", "==", unsigned_y, unsigned_sum, 0, 0, 0, 0, "", "")
                unsigned_false_goal: usize = ElisaProofKernelCore::add_node(&unsigned_nodes, "binary", "==", unsigned_x, unsigned_zero, 0, 0, 0, 0, "", "")
                unsigned_wrap_facts: darray[usize] = [unsigned_lower, unsigned_marker, unsigned_upper, unsigned_equal, unsigned_y_zero, unsigned_y_sum]
                return 117 if ElisaProofKernelReplay::proof_kernel_replay_goal_report(&unsigned_nodes, &unsigned_children, unsigned_wrap_facts, unsigned_false_goal)
                return 118 if not ElisaProofKernelReplay::proof_kernel_replay_goal_report(&unsigned_nodes, &unsigned_children, unsigned_wrap_facts, unsigned_y_sum)

                unsigned_safe_max: usize = ElisaProofKernelCore::add_node(&unsigned_nodes, "int", "", 0, 0, 0, 0, 0, 254, "", "")
                unsigned_safe_x: usize = ElisaProofKernelCore::add_node(&unsigned_nodes, "binary", "==", unsigned_x, unsigned_safe_max, 0, 0, 0, 0, "", "")
                unsigned_safe_y: usize = ElisaProofKernelCore::add_node(&unsigned_nodes, "binary", "==", unsigned_y, unsigned_max, 0, 0, 0, 0, "", "")
                unsigned_safe_goal: usize = ElisaProofKernelCore::add_node(&unsigned_nodes, "binary", ">", unsigned_y, unsigned_x, 0, 0, 0, 0, "", "")
                unsigned_marker_y_argument: usize = ElisaProofKernelCore::add_node(&unsigned_nodes, "call_arg", "", unsigned_y, 0, 0, 0, 0, 0, "", "")
                unsigned_marker_y_start: usize = unsigned_children.count
                unsigned_children.push(unsigned_marker_y_argument)
                unsigned_children.push(unsigned_marker_width)
                unsigned_marker_y: usize = ElisaProofKernelCore::add_node(&unsigned_nodes, "call", "", unsigned_callee, 0, 0, unsigned_marker_y_start, 2, 0, "", "")
                unsigned_safe_without_sum: bool = ElisaProofKernelReplay::proof_kernel_replay_goal_report(&unsigned_nodes, &unsigned_children, [unsigned_marker, unsigned_marker_y, unsigned_safe_x, unsigned_safe_y], unsigned_safe_goal)
                return 190 if not unsigned_safe_without_sum
                return 119 if not ElisaProofKernelReplay::proof_kernel_replay_goal_report(&unsigned_nodes, &unsigned_children, [unsigned_marker, unsigned_marker_y, unsigned_safe_x, unsigned_safe_y, unsigned_y_sum], unsigned_safe_goal)

                return 0
