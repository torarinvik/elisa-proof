# Nested resource-state joins, writes, returns, and call-argument provenance.
module ElisaProofResourceTransitionTests:
    public:
        def run() -> i64 can[Memory.Allocate, Abort.Panic]:
            can Memory.Allocate, Abort.Panic:
                # copied child state would close r and then be discarded, allowing the parent to use value.
                nested_region_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                nested_region_children: mutable darray[usize] = []
                nested_region_open: usize = ElisaProofKernelCore::add_node(&nested_region_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "r", "")
                nested_region_value: usize = ElisaProofKernelCore::add_node(&nested_region_nodes, "int", "", 0, 0, 0, 0, 0, 7, "", "")
                nested_region_alloc: usize = ElisaProofKernelCore::add_node(&nested_region_nodes, "resource-region-alloc", "", nested_region_value, 0, 0, 0, 0, 0, "value", "r")
                nested_region_close: usize = ElisaProofKernelCore::add_node(&nested_region_nodes, "resource-region-close", "", 0, 0, 0, 0, 0, 0, "r", "")
                nested_region_scope_start: usize = nested_region_children.count
                nested_region_children.push(nested_region_close)
                nested_region_scope: usize = ElisaProofKernelCore::add_node(&nested_region_nodes, "resource-scope", "", 0, 0, 0, nested_region_scope_start, 1, 0, "", "")
                nested_region_place: usize = ElisaProofKernelCore::add_node(&nested_region_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "value", "")
                nested_region_use: usize = ElisaProofKernelCore::add_node(&nested_region_nodes, "resource-use", "", nested_region_place, 0, 0, 0, 0, 0, "value", "")
                nested_region_report_start: usize = nested_region_children.count
                nested_region_children.push(nested_region_open)
                nested_region_children.push(nested_region_alloc)
                nested_region_children.push(nested_region_scope)
                nested_region_children.push(nested_region_use)
                nested_region_report: usize = ElisaProofKernelCore::add_node(&nested_region_nodes, "resource-safety", "", 0, 0, 0, nested_region_report_start, 4, 0, "nested-region-close", "resource-v1")
                nested_region_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&nested_region_nodes, &nested_region_children, [], nested_region_report)
                return 44 if nested_region_admitted

                # A moved inherited binding must be joined back into the parent state. Without a pending
                # join obligation, the child snapshot could consume owner and the parent would later reuse it.
                nested_move_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                nested_move_children: mutable darray[usize] = []
                nested_move_owner: usize = ElisaProofKernelCore::add_node(&nested_move_nodes, "resource-bind", "value", 0, 0, 0, 0, 0, 0, "owner", "")
                nested_move_place: usize = ElisaProofKernelCore::add_node(&nested_move_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "owner", "")
                nested_move_event: usize = ElisaProofKernelCore::add_node(&nested_move_nodes, "resource-move", "", nested_move_place, 0, 0, 0, 0, 0, "owner", "")
                nested_move_child_start: usize = nested_move_children.count
                nested_move_children.push(nested_move_event)
                nested_move_scope: usize = ElisaProofKernelCore::add_node(&nested_move_nodes, "resource-scope", "", 0, 0, 0, nested_move_child_start, 1, 0, "", "")
                nested_move_use_place: usize = ElisaProofKernelCore::add_node(&nested_move_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "owner", "")
                nested_move_use: usize = ElisaProofKernelCore::add_node(&nested_move_nodes, "resource-use", "", nested_move_use_place, 0, 0, 0, 0, 0, "owner", "")
                nested_move_report_start: usize = nested_move_children.count
                nested_move_children.push(nested_move_owner)
                nested_move_children.push(nested_move_scope)
                nested_move_children.push(nested_move_use)
                nested_move_report: usize = ElisaProofKernelCore::add_node(&nested_move_nodes, "resource-safety", "", 0, 0, 0, nested_move_report_start, 3, 0, "nested-move-without-join", "resource-v1")
                nested_move_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&nested_move_nodes, &nested_move_children, [], nested_move_report)
                return 45 if nested_move_admitted

                # The producer's slot-qualified join is the valid counterpart and must still replay.
                joined_move_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                joined_move_children: mutable darray[usize] = []
                joined_move_owner: usize = ElisaProofKernelCore::add_node(&joined_move_nodes, "resource-bind", "value", 0, 0, 0, 0, 0, 0, "owner", "")
                joined_move_place: usize = ElisaProofKernelCore::add_node(&joined_move_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "owner", "")
                joined_move_event: usize = ElisaProofKernelCore::add_node(&joined_move_nodes, "resource-move", "", joined_move_place, 0, 0, 0, 0, 0, "owner", "")
                joined_move_child_start: usize = joined_move_children.count
                joined_move_children.push(joined_move_event)
                joined_move_scope: usize = ElisaProofKernelCore::add_node(&joined_move_nodes, "resource-scope", "", 0, 0, 0, joined_move_child_start, 1, 0, "", "")
                joined_move_join: usize = ElisaProofKernelCore::add_node(&joined_move_nodes, "resource-join-move", "", 0, 0, 0, 0, 0, 0, "owner", "")
                joined_move_report_start: usize = joined_move_children.count
                joined_move_children.push(joined_move_owner)
                joined_move_children.push(joined_move_scope)
                joined_move_children.push(joined_move_join)
                joined_move_report: usize = ElisaProofKernelCore::add_node(&joined_move_nodes, "resource-safety", "", 0, 0, 0, joined_move_report_start, 3, 0, "nested-move-with-join", "resource-v1")
                joined_move_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&joined_move_nodes, &joined_move_children, [], joined_move_report)
                return 46 if not joined_move_admitted

                # Whole-binding writes and region replacement/assignment must honor the serialized
                # writability bit independently of the source checker. Otherwise a forged certificate
                # could mutate an immutable binding while still passing resource replay.
                immutable_write_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                immutable_write_children: mutable darray[usize] = []
                immutable_write_owner: usize = ElisaProofKernelCore::add_node(&immutable_write_nodes, "resource-bind", "value", 0, 0, 0, 0, 0, 0, "owner", "")
                immutable_write_place: usize = ElisaProofKernelCore::add_node(&immutable_write_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "owner", "")
                immutable_write_event: usize = ElisaProofKernelCore::add_node(&immutable_write_nodes, "resource-write", "", immutable_write_place, 0, 0, 0, 0, 0, "owner", "")
                immutable_write_children.push(immutable_write_owner)
                immutable_write_children.push(immutable_write_event)
                immutable_write_root: usize = ElisaProofKernelCore::add_node(&immutable_write_nodes, "resource-safety", "", 0, 0, 0, 0, 2, 0, "immutable-write", "resource-v1")
                immutable_write_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&immutable_write_nodes, &immutable_write_children, [], immutable_write_root)
                return 54 if immutable_write_admitted

                mutable_write_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                mutable_write_children: mutable darray[usize] = []
                mutable_write_owner: usize = ElisaProofKernelCore::add_node(&mutable_write_nodes, "resource-bind", "value", 0, 0, 1, 0, 0, 0, "owner", "")
                mutable_write_place: usize = ElisaProofKernelCore::add_node(&mutable_write_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "owner", "")
                mutable_write_event: usize = ElisaProofKernelCore::add_node(&mutable_write_nodes, "resource-write", "", mutable_write_place, 0, 0, 0, 0, 0, "owner", "")
                mutable_write_children.push(mutable_write_owner)
                mutable_write_children.push(mutable_write_event)
                mutable_write_root: usize = ElisaProofKernelCore::add_node(&mutable_write_nodes, "resource-safety", "", 0, 0, 0, 0, 2, 0, "mutable-write", "resource-v1")
                mutable_write_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&mutable_write_nodes, &mutable_write_children, [], mutable_write_root)
                return 55 if not mutable_write_admitted

                immutable_rebind_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                immutable_rebind_children: mutable darray[usize] = []
                immutable_rebind_open: usize = ElisaProofKernelCore::add_node(&immutable_rebind_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "r", "")
                immutable_rebind_initial_value: usize = ElisaProofKernelCore::add_node(&immutable_rebind_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
                immutable_rebind_initial: usize = ElisaProofKernelCore::add_node(&immutable_rebind_nodes, "resource-region-alloc", "", immutable_rebind_initial_value, 0, 0, 0, 0, 0, "target", "r")
                immutable_rebind_replacement_value: usize = ElisaProofKernelCore::add_node(&immutable_rebind_nodes, "int", "", 0, 0, 0, 0, 0, 2, "", "")
                immutable_rebind_event: usize = ElisaProofKernelCore::add_node(&immutable_rebind_nodes, "resource-region-rebind-alloc", "", immutable_rebind_replacement_value, 0, 0, 0, 0, 0, "target", "r")
                immutable_rebind_children.push(immutable_rebind_open)
                immutable_rebind_children.push(immutable_rebind_initial)
                immutable_rebind_children.push(immutable_rebind_event)
                immutable_rebind_root: usize = ElisaProofKernelCore::add_node(&immutable_rebind_nodes, "resource-safety", "", 0, 0, 0, 0, 3, 0, "immutable-region-rebind", "resource-v1")
                immutable_rebind_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&immutable_rebind_nodes, &immutable_rebind_children, [], immutable_rebind_root)
                return 56 if immutable_rebind_admitted

                mutable_rebind_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                mutable_rebind_children: mutable darray[usize] = []
                mutable_rebind_open: usize = ElisaProofKernelCore::add_node(&mutable_rebind_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "r", "")
                mutable_rebind_initial_value: usize = ElisaProofKernelCore::add_node(&mutable_rebind_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
                mutable_rebind_initial: usize = ElisaProofKernelCore::add_node(&mutable_rebind_nodes, "resource-region-alloc", "", mutable_rebind_initial_value, 0, 1, 0, 0, 0, "target", "r")
                mutable_rebind_replacement_value: usize = ElisaProofKernelCore::add_node(&mutable_rebind_nodes, "int", "", 0, 0, 0, 0, 0, 2, "", "")
                mutable_rebind_event: usize = ElisaProofKernelCore::add_node(&mutable_rebind_nodes, "resource-region-rebind-alloc", "", mutable_rebind_replacement_value, 0, 0, 0, 0, 0, "target", "r")
                mutable_rebind_close: usize = ElisaProofKernelCore::add_node(&mutable_rebind_nodes, "resource-region-close", "", 0, 0, 0, 0, 0, 0, "r", "")
                mutable_rebind_children.push(mutable_rebind_open)
                mutable_rebind_children.push(mutable_rebind_initial)
                mutable_rebind_children.push(mutable_rebind_event)
                mutable_rebind_children.push(mutable_rebind_close)
                mutable_rebind_root: usize = ElisaProofKernelCore::add_node(&mutable_rebind_nodes, "resource-safety", "", 0, 0, 0, 0, 4, 0, "mutable-region-rebind", "resource-v1")
                mutable_rebind_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&mutable_rebind_nodes, &mutable_rebind_children, [], mutable_rebind_root)
                return 57 if not mutable_rebind_admitted

                immutable_assign_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                immutable_assign_children: mutable darray[usize] = []
                immutable_assign_open: usize = ElisaProofKernelCore::add_node(&immutable_assign_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "r", "")
                immutable_assign_source_value: usize = ElisaProofKernelCore::add_node(&immutable_assign_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
                immutable_assign_source: usize = ElisaProofKernelCore::add_node(&immutable_assign_nodes, "resource-region-alloc", "", immutable_assign_source_value, 0, 0, 0, 0, 0, "source", "r")
                immutable_assign_target: usize = ElisaProofKernelCore::add_node(&immutable_assign_nodes, "resource-bind", "value", 0, 0, 0, 0, 0, 0, "target", "")
                immutable_assign_source_place: usize = ElisaProofKernelCore::add_node(&immutable_assign_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "source", "")
                immutable_assign_event: usize = ElisaProofKernelCore::add_node(&immutable_assign_nodes, "resource-region-assign", "", immutable_assign_source_place, 0, 0, 0, 0, 0, "target", "r")
                immutable_assign_children.push(immutable_assign_open)
                immutable_assign_children.push(immutable_assign_source)
                immutable_assign_children.push(immutable_assign_target)
                immutable_assign_children.push(immutable_assign_event)
                immutable_assign_root: usize = ElisaProofKernelCore::add_node(&immutable_assign_nodes, "resource-safety", "", 0, 0, 0, 0, 4, 0, "immutable-region-assign", "resource-v1")
                immutable_assign_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&immutable_assign_nodes, &immutable_assign_children, [], immutable_assign_root)
                return 58 if immutable_assign_admitted

                mutable_assign_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                mutable_assign_children: mutable darray[usize] = []
                mutable_assign_open: usize = ElisaProofKernelCore::add_node(&mutable_assign_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "r", "")
                mutable_assign_source_value: usize = ElisaProofKernelCore::add_node(&mutable_assign_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
                mutable_assign_source: usize = ElisaProofKernelCore::add_node(&mutable_assign_nodes, "resource-region-alloc", "", mutable_assign_source_value, 0, 0, 0, 0, 0, "source", "r")
                mutable_assign_target: usize = ElisaProofKernelCore::add_node(&mutable_assign_nodes, "resource-bind", "value", 0, 0, 1, 0, 0, 0, "target", "")
                mutable_assign_source_place: usize = ElisaProofKernelCore::add_node(&mutable_assign_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "source", "")
                mutable_assign_event: usize = ElisaProofKernelCore::add_node(&mutable_assign_nodes, "resource-region-assign", "", mutable_assign_source_place, 0, 0, 0, 0, 0, "target", "r")
                mutable_assign_close: usize = ElisaProofKernelCore::add_node(&mutable_assign_nodes, "resource-region-close", "", 0, 0, 0, 0, 0, 0, "r", "")
                mutable_assign_children.push(mutable_assign_open)
                mutable_assign_children.push(mutable_assign_source)
                mutable_assign_children.push(mutable_assign_target)
                mutable_assign_children.push(mutable_assign_event)
                mutable_assign_children.push(mutable_assign_close)
                mutable_assign_root: usize = ElisaProofKernelCore::add_node(&mutable_assign_nodes, "resource-safety", "", 0, 0, 0, 0, 5, 0, "mutable-region-assign", "resource-v1")
                mutable_assign_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&mutable_assign_nodes, &mutable_assign_children, [], mutable_assign_root)
                return 59 if not mutable_assign_admitted

                # A region assignment must transfer a direct owner's exclusive token. Reusing the source
                # after rebinding the target is a forged duplicate capability and must not replay.
                assign_owner_transfer_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                assign_owner_transfer_children: mutable darray[usize] = []
                assign_owner_transfer_open: usize = ElisaProofKernelCore::add_node(&assign_owner_transfer_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "r", "")
                assign_owner_transfer_source_value: usize = ElisaProofKernelCore::add_node(&assign_owner_transfer_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
                assign_owner_transfer_source: usize = ElisaProofKernelCore::add_node(&assign_owner_transfer_nodes, "resource-region-alloc", "", assign_owner_transfer_source_value, 0, 7, 0, 0, 0, "source", "r")
                assign_owner_transfer_target_value: usize = ElisaProofKernelCore::add_node(&assign_owner_transfer_nodes, "int", "", 0, 0, 0, 0, 0, 2, "", "")
                assign_owner_transfer_target: usize = ElisaProofKernelCore::add_node(&assign_owner_transfer_nodes, "resource-region-alloc", "", assign_owner_transfer_target_value, 0, 7, 0, 0, 0, "target", "r")
                assign_owner_transfer_source_place: usize = ElisaProofKernelCore::add_node(&assign_owner_transfer_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "source", "")
                assign_owner_transfer_event: usize = ElisaProofKernelCore::add_node(&assign_owner_transfer_nodes, "resource-region-assign", "", assign_owner_transfer_source_place, 0, 0, 0, 0, 0, "target", "r")
                assign_owner_transfer_source_after: usize = ElisaProofKernelCore::add_node(&assign_owner_transfer_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "source", "")
                assign_owner_transfer_source_write: usize = ElisaProofKernelCore::add_node(&assign_owner_transfer_nodes, "resource-write", "", assign_owner_transfer_source_after, 0, 0, 0, 0, 0, "source", "")
                assign_owner_transfer_target_after: usize = ElisaProofKernelCore::add_node(&assign_owner_transfer_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "target", "")
                assign_owner_transfer_target_write: usize = ElisaProofKernelCore::add_node(&assign_owner_transfer_nodes, "resource-write", "", assign_owner_transfer_target_after, 0, 0, 0, 0, 0, "target", "")
                assign_owner_transfer_close: usize = ElisaProofKernelCore::add_node(&assign_owner_transfer_nodes, "resource-region-close", "", 0, 0, 0, 0, 0, 0, "r", "")
                assign_owner_transfer_children.push(assign_owner_transfer_open)
                assign_owner_transfer_children.push(assign_owner_transfer_source)
                assign_owner_transfer_children.push(assign_owner_transfer_target)
                assign_owner_transfer_children.push(assign_owner_transfer_event)
                assign_owner_transfer_children.push(assign_owner_transfer_source_write)
                assign_owner_transfer_children.push(assign_owner_transfer_target_write)
                assign_owner_transfer_children.push(assign_owner_transfer_close)
                assign_owner_transfer_root: usize = ElisaProofKernelCore::add_node(&assign_owner_transfer_nodes, "resource-safety", "", 0, 0, 0, 0, 7, 0, "assign-owner-transfer", "resource-v1")
                assign_owner_transfer_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&assign_owner_transfer_nodes, &assign_owner_transfer_children, [], assign_owner_transfer_root)
                return 89 if assign_owner_transfer_admitted

                # A same-scope duplicate declaration must not replace a moved binding with a fresh one.
                # Shadowing is legal only inside a nested resource scope, whose child state is discarded.
                duplicate_binding_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                duplicate_binding_children: mutable darray[usize] = []
                duplicate_binding_owner: usize = ElisaProofKernelCore::add_node(&duplicate_binding_nodes, "resource-bind", "value", 0, 0, 0, 0, 0, 0, "owner", "")
                duplicate_binding_owner_place: usize = ElisaProofKernelCore::add_node(&duplicate_binding_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "owner", "")
                duplicate_binding_move: usize = ElisaProofKernelCore::add_node(&duplicate_binding_nodes, "resource-move", "", duplicate_binding_owner_place, 0, 0, 0, 0, 0, "owner", "")
                duplicate_binding_replacement: usize = ElisaProofKernelCore::add_node(&duplicate_binding_nodes, "resource-bind", "value", 0, 0, 1, 0, 0, 0, "owner", "")
                duplicate_binding_replacement_place: usize = ElisaProofKernelCore::add_node(&duplicate_binding_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "owner", "")
                duplicate_binding_use: usize = ElisaProofKernelCore::add_node(&duplicate_binding_nodes, "resource-use", "", duplicate_binding_replacement_place, 0, 0, 0, 0, 0, "owner", "")
                duplicate_binding_children.push(duplicate_binding_owner)
                duplicate_binding_children.push(duplicate_binding_move)
                duplicate_binding_children.push(duplicate_binding_replacement)
                duplicate_binding_children.push(duplicate_binding_use)
                duplicate_binding_root: usize = ElisaProofKernelCore::add_node(&duplicate_binding_nodes, "resource-safety", "", 0, 0, 0, 0, 4, 0, "duplicate-same-scope-binding", "resource-v1")
                duplicate_binding_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&duplicate_binding_nodes, &duplicate_binding_children, [], duplicate_binding_root)
                return 60 if duplicate_binding_admitted

                nested_shadow_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                nested_shadow_children: mutable darray[usize] = []
                nested_shadow_owner: usize = ElisaProofKernelCore::add_node(&nested_shadow_nodes, "resource-bind", "value", 0, 0, 0, 0, 0, 0, "owner", "")
                nested_shadow_child_owner: usize = ElisaProofKernelCore::add_node(&nested_shadow_nodes, "resource-bind", "value", 0, 0, 1, 0, 0, 0, "owner", "")
                nested_shadow_child_start: usize = nested_shadow_children.count
                nested_shadow_children.push(nested_shadow_child_owner)
                nested_shadow_scope: usize = ElisaProofKernelCore::add_node(&nested_shadow_nodes, "resource-scope", "", 0, 0, 0, nested_shadow_child_start, 1, 0, "", "")
                nested_shadow_owner_place: usize = ElisaProofKernelCore::add_node(&nested_shadow_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "owner", "")
                nested_shadow_use: usize = ElisaProofKernelCore::add_node(&nested_shadow_nodes, "resource-use", "", nested_shadow_owner_place, 0, 0, 0, 0, 0, "owner", "")
                nested_shadow_children.push(nested_shadow_owner)
                nested_shadow_children.push(nested_shadow_scope)
                nested_shadow_children.push(nested_shadow_use)
                nested_shadow_root: usize = ElisaProofKernelCore::add_node(&nested_shadow_nodes, "resource-safety", "", 0, 0, 0, 1, 3, 0, "nested-shadow-binding", "resource-v1")
                nested_shadow_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&nested_shadow_nodes, &nested_shadow_children, [], nested_shadow_root)
                return 61 if not nested_shadow_admitted

                # An inherited binding's region identity must not be changed in a nested snapshot and then
                # silently discarded. Otherwise the parent could use a binding that was redirected into a
                # child-only region after the child exits.
                nested_region_escape_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                nested_region_escape_children: mutable darray[usize] = []
                nested_region_escape_open_parent: usize = ElisaProofKernelCore::add_node(&nested_region_escape_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "parent", "")
                nested_region_escape_initial_value: usize = ElisaProofKernelCore::add_node(&nested_region_escape_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
                nested_region_escape_initial: usize = ElisaProofKernelCore::add_node(&nested_region_escape_nodes, "resource-region-alloc", "", nested_region_escape_initial_value, 0, 1, 0, 0, 0, "target", "parent")
                nested_region_escape_open_child: usize = ElisaProofKernelCore::add_node(&nested_region_escape_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "child", "")
                nested_region_escape_replacement_value: usize = ElisaProofKernelCore::add_node(&nested_region_escape_nodes, "int", "", 0, 0, 0, 0, 0, 2, "", "")
                nested_region_escape_rebind: usize = ElisaProofKernelCore::add_node(&nested_region_escape_nodes, "resource-region-rebind-alloc", "", nested_region_escape_replacement_value, 0, 0, 0, 0, 0, "target", "child")
                nested_region_escape_child_start: usize = nested_region_escape_children.count
                nested_region_escape_children.push(nested_region_escape_open_child)
                nested_region_escape_children.push(nested_region_escape_rebind)
                nested_region_escape_scope: usize = ElisaProofKernelCore::add_node(&nested_region_escape_nodes, "resource-scope", "", 0, 0, 0, nested_region_escape_child_start, 2, 0, "", "")
                nested_region_escape_target_place: usize = ElisaProofKernelCore::add_node(&nested_region_escape_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "target", "")
