# Adversarial replay for direct and call-composed sview return provenance.
module ElisaProofSviewReturnTests:
    private:
        const VIEW_BORROW_FLAG: usize = 16
        const BORROWABLE_FORMAL_FLAG: usize = 8

    public:
        def run() -> i64 can[Memory.Allocate, Abort.Panic]:
            can Memory.Allocate, Abort.Panic:
                nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                children: mutable darray[usize] = []
                _ = ElisaProofKernelCore::add_node(&nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
                view_type: usize = ElisaProofKernelCore::add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "sview", "")
                region_param: usize = ElisaProofKernelCore::add_node(&nodes, "resource-region-param", "external", 0, 0, 0, 0, 0, 0, "r", "")

                callee_formal: usize = ElisaProofKernelCore::add_node(&nodes, "resource-bind", "value", 0, 0, BORROWABLE_FORMAL_FLAG, 0, 0, 0, "view", "")
                callee_view_lifetime: usize = ElisaProofKernelCore::add_node(&nodes, "resource-sview-param", "", view_type, 0, VIEW_BORROW_FLAG, 0, 0, 0, "view", "r")
                callee_view_place: usize = ElisaProofKernelCore::add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "view", "")
                callee_view_use: usize = ElisaProofKernelCore::add_node(&nodes, "resource-use", "", callee_view_place, 0, 0, 0, 0, 0, "view", "")
                callee_return: usize = ElisaProofKernelCore::add_node(&nodes, "resource-region-return", "sview", callee_view_use, view_type, VIEW_BORROW_FLAG, 0, 0, 0, "r", "")
                callee_start: usize = children.count
                children.push(region_param)
                children.push(callee_formal)
                children.push(callee_view_lifetime)
                children.push(callee_view_use)
                children.push(callee_return)
                callee: usize = ElisaProofKernelCore::add_node(&nodes, "resource-safety", "", 0, 0, 1, callee_start, 5, 0, "identity_view", "resource-v1")
                callee_parameters: usize = ElisaProofKernelCore::add_node(&nodes, "resource-safety", "", 0, 0, 1, callee_start, 3, 0, "identity_view_parameters", "resource-v1")
                callee_parameters_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&nodes, &children, [], callee_parameters)
                return 105 if not callee_parameters_admitted
                callee_use_prefix: usize = ElisaProofKernelCore::add_node(&nodes, "resource-safety", "", 0, 0, 1, callee_start, 4, 0, "identity_view_use", "resource-v1")
                callee_use_prefix_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_prefix(&nodes, &children, [], callee_use_prefix)
                return 106 if not callee_use_prefix_admitted
                callee_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&nodes, &children, [], callee)
                return 101 if not callee_admitted

                caller_first: usize = ElisaProofKernelCore::add_node(&nodes, "resource-bind", "value", 0, 0, BORROWABLE_FORMAL_FLAG, 0, 0, 0, "first", "")
                caller_first_lifetime: usize = ElisaProofKernelCore::add_node(&nodes, "resource-sview-param", "", view_type, 0, VIEW_BORROW_FLAG, 0, 0, 0, "first", "r")
                caller_second: usize = ElisaProofKernelCore::add_node(&nodes, "resource-bind", "value", 0, 0, BORROWABLE_FORMAL_FLAG, 0, 0, 0, "second", "")
                caller_second_lifetime: usize = ElisaProofKernelCore::add_node(&nodes, "resource-sview-param", "", view_type, 0, VIEW_BORROW_FLAG, 0, 0, 0, "second", "r")
                second_place: usize = ElisaProofKernelCore::add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "second", "")
                call_argument: usize = ElisaProofKernelCore::add_node(&nodes, "resource-call-arg", "value", second_place, 0, 0, 0, 0, 0, "view", "")
                call_region: usize = ElisaProofKernelCore::add_node(&nodes, "resource-call-region", "param", 0, 0, 0, 0, 0, 0, "r", "r")
                call_start: usize = children.count
                children.push(call_argument)
                children.push(call_region)
                call: usize = ElisaProofKernelCore::add_node(&nodes, "resource-call", "", callee, 1, 1, call_start, 2, 0, "identity_view", "")
                returned_view: usize = ElisaProofKernelCore::add_node(&nodes, "resource-region-return", "sview-call", call, view_type, VIEW_BORROW_FLAG, 0, 0, 0, "r", "second")

                caller_start: usize = children.count
                children.push(region_param)
                children.push(caller_first)
                children.push(caller_first_lifetime)
                children.push(caller_second)
                children.push(caller_second_lifetime)
                children.push(call)
                children.push(returned_view)
                caller: usize = ElisaProofKernelCore::add_node(&nodes, "resource-safety", "", 0, 0, 2, caller_start, 7, 0, "forward_view", "resource-v1")
                return 102 if not ElisaProofKernelReplay::proof_kernel_replay_resource_report(&nodes, &children, [], caller)

                # Same-lifetime formals are not interchangeable: the return marker must agree with
                # the exact actual selected by the callee's independently replayed summary.
                nodes[returned_view].secondary_name <- "first"
                forged_formal_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&nodes, &children, [], caller)
                return 103 if forged_formal_admitted
                nodes[returned_view].secondary_name <- "second"

                # A call reference must identify the immediately preceding resource event, not a
                # valid but stale call that happened earlier in a forged event stream.
                unrelated_place: usize = ElisaProofKernelCore::add_node(&nodes, "ident", "", 0, 0, 0, 0, 0, 0, "first", "")
                unrelated_use: usize = ElisaProofKernelCore::add_node(&nodes, "resource-use", "", unrelated_place, 0, 0, 0, 0, 0, "first", "")
                stale_start: usize = children.count
                children.push(region_param)
                children.push(caller_first)
                children.push(caller_first_lifetime)
                children.push(caller_second)
                children.push(caller_second_lifetime)
                children.push(call)
                children.push(unrelated_use)
                children.push(returned_view)
                stale_caller: usize = ElisaProofKernelCore::add_node(&nodes, "resource-safety", "", 0, 0, 2, stale_start, 8, 0, "stale_view_call", "resource-v1")
                stale_call_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&nodes, &children, [], stale_caller)
                return 104 if stale_call_admitted
                return 0
