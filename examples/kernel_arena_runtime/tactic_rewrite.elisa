# Capture-safe rewriting and universal/existential tactic instantiation.
module ElisaProofTacticRewriteTests:
    private:
        const INSTANTIATE_CHILD_CAPACITY: usize = 4
    public:
        def run() -> i64 can[Memory.Allocate, Abort.Panic]:
            can Memory.Allocate, Abort.Panic:
                # Rewriting under a quantifier body is rejected until the arena has binding-aware names.
                # Otherwise a free replacement name can be captured by the body's binder (`y == x` under
                # `forall x`), changing the proposition rather than applying a valid equality congruence.
                rewrite_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                rewrite_children: mutable darray[usize] = []
                rewrite_x: usize = ElisaProofKernelCore::add_node(&rewrite_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "x", "")
                rewrite_y: usize = ElisaProofKernelCore::add_node(&rewrite_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "y", "")
                rewrite_zero: usize = ElisaProofKernelCore::add_node(&rewrite_nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
                rewrite_one: usize = ElisaProofKernelCore::add_node(&rewrite_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
                rewrite_children.push(rewrite_zero)
                rewrite_children.push(rewrite_one)
                rewrite_range: usize = ElisaProofKernelCore::add_node(&rewrite_nodes, "array", "", 0, 0, 0, 0, 2, 0, "", "")
                rewrite_fact: usize = ElisaProofKernelCore::add_node(&rewrite_nodes, "binary", "==", rewrite_y, rewrite_x, 0, 0, 0, 0, "", "")
                rewrite_before_body: usize = ElisaProofKernelCore::add_node(&rewrite_nodes, "binary", "==", rewrite_y, rewrite_x, 0, 0, 0, 0, "", "")
                rewrite_after_body: usize = ElisaProofKernelCore::add_node(&rewrite_nodes, "binary", "==", rewrite_x, rewrite_x, 0, 0, 0, 0, "", "")
                rewrite_before_goal: usize = ElisaProofKernelCore::add_node(&rewrite_nodes, "quantifier", "forall", rewrite_range, rewrite_before_body, 1, 0, 0, 0, "x", "")
                rewrite_after_goal: usize = ElisaProofKernelCore::add_node(&rewrite_nodes, "quantifier", "forall", rewrite_range, rewrite_after_body, 1, 0, 0, 0, "x", "")
                rewrite_facts: darray[usize] = [rewrite_fact]
                rewrite_step_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_tactic_step(&rewrite_nodes, &rewrite_children, "rewrite", true, false, false, rewrite_facts, rewrite_before_goal, rewrite_facts, rewrite_after_goal, rewrite_y, true, rewrite_x, true, 0, false, "")
                return 40 if rewrite_step_admitted

                # The affine normalizer must not turn the false fixed-value equality
                # `5 - (3 - x) == x + 8` into a proof when x == 0. Its left side is 2 and its right side is 8.
                affine_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                affine_children: mutable darray[usize] = []
                affine_x: usize = ElisaProofKernelCore::add_node(&affine_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "x", "")
                affine_zero: usize = ElisaProofKernelCore::add_node(&affine_nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
                affine_three: usize = ElisaProofKernelCore::add_node(&affine_nodes, "int", "", 0, 0, 0, 0, 0, 3, "", "")
                affine_five: usize = ElisaProofKernelCore::add_node(&affine_nodes, "int", "", 0, 0, 0, 0, 0, 5, "", "")
                affine_eight: usize = ElisaProofKernelCore::add_node(&affine_nodes, "int", "", 0, 0, 0, 0, 0, 8, "", "")
                affine_fact: usize = ElisaProofKernelCore::add_node(&affine_nodes, "binary", "==", affine_x, affine_zero, 0, 0, 0, 0, "", "")
                affine_inner: usize = ElisaProofKernelCore::add_node(&affine_nodes, "binary", "-", affine_three, affine_x, 0, 0, 0, 0, "", "")
                affine_left: usize = ElisaProofKernelCore::add_node(&affine_nodes, "binary", "-", affine_five, affine_inner, 0, 0, 0, 0, "", "")
                affine_right: usize = ElisaProofKernelCore::add_node(&affine_nodes, "binary", "+", affine_x, affine_eight, 0, 0, 0, 0, "", "")
                affine_goal: usize = ElisaProofKernelCore::add_node(&affine_nodes, "binary", "==", affine_left, affine_right, 0, 0, 0, 0, "", "")
                affine_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_goal_report(&affine_nodes, &affine_children, [affine_fact], affine_goal)
                return 41 if affine_admitted

                # Instantiation must preserve the goal and must reject substitution through a nested binder.
                # Replacing outer x with y under `forall y` would capture the free y from the chosen value.
                instantiate_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                instantiate_children: mutable darray[usize] = []
                _ = instantiate_children.reserve(INSTANTIATE_CHILD_CAPACITY)
                instantiate_x: usize = ElisaProofKernelCore::add_node(&instantiate_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "x", "")
                instantiate_y: usize = ElisaProofKernelCore::add_node(&instantiate_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "y", "")
                instantiate_zero: usize = ElisaProofKernelCore::add_node(&instantiate_nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
                instantiate_range_start: usize = instantiate_children.count
                instantiate_children.push(instantiate_y)
                instantiate_range: usize = ElisaProofKernelCore::add_node(&instantiate_nodes, "array", "", 0, 0, 0, instantiate_range_start, 1, 0, "", "")
                instantiate_inner_range_start: usize = instantiate_children.count
                instantiate_children.push(instantiate_zero)
                instantiate_inner_range: usize = ElisaProofKernelCore::add_node(&instantiate_nodes, "array", "", 0, 0, 0, instantiate_inner_range_start, 1, 0, "", "")
                instantiate_body: usize = ElisaProofKernelCore::add_node(&instantiate_nodes, "binary", "==", instantiate_x, instantiate_y, 0, 0, 0, 0, "", "")
                instantiate_nested: usize = ElisaProofKernelCore::add_node(&instantiate_nodes, "quantifier", "forall", instantiate_inner_range, instantiate_body, 1, 0, 0, 0, "y", "")
                instantiate_outer: usize = ElisaProofKernelCore::add_node(&instantiate_nodes, "quantifier", "forall", instantiate_range, instantiate_nested, 1, 0, 0, 0, "x", "")
                instantiate_goal: usize = ElisaProofKernelCore::add_node(&instantiate_nodes, "bool", "", 0, 0, 0, 0, 0, 1, "", "")
                instantiate_facts: darray[usize] = [instantiate_outer]
                instantiate_step_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_tactic_step(&instantiate_nodes, &instantiate_children, "instantiate", true, false, false, instantiate_facts, instantiate_goal, instantiate_facts, instantiate_goal, instantiate_y, true, 0, false, 0, true, "forall")
                return 42 if instantiate_step_admitted

                simple_instantiate_range_start: usize = instantiate_children.count
                instantiate_children.push(instantiate_zero)
                simple_instantiate_range: usize = ElisaProofKernelCore::add_node(&instantiate_nodes, "array", "", 0, 0, 0, simple_instantiate_range_start, 1, 0, "", "")
                simple_instantiate_body: usize = ElisaProofKernelCore::add_node(&instantiate_nodes, "binary", "==", instantiate_zero, instantiate_zero, 0, 0, 0, 0, "", "")
                simple_instantiate_outer: usize = ElisaProofKernelCore::add_node(&instantiate_nodes, "quantifier", "forall", simple_instantiate_range, simple_instantiate_body, 1, 0, 0, 0, "z", "")
                forged_goal: usize = ElisaProofKernelCore::add_node(&instantiate_nodes, "bool", "", 0, 0, 0, 0, 0, 0, "", "")
                simple_instantiate_before_facts: darray[usize] = [simple_instantiate_outer]
                simple_instantiate_after_facts: darray[usize] = [simple_instantiate_outer, simple_instantiate_body]
                forged_goal_step_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_tactic_step(&instantiate_nodes, &instantiate_children, "instantiate", true, false, false, simple_instantiate_before_facts, instantiate_goal, simple_instantiate_after_facts, forged_goal, instantiate_zero, true, 0, false, 0, true, "forall")
                return 43 if forged_goal_step_admitted

                # Auxiliary tactic roots are independently serialized. A numeric root check alone would
                # let an out-of-snapshot malformed scalar act as an instantiation witness.
                malformed_instantiate_argument: usize = ElisaProofKernelCore::add_node(&instantiate_nodes, "int", "hidden", 0, 0, 0, 0, 0, 0, "", "")
                malformed_argument_step_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_tactic_step(&instantiate_nodes, &instantiate_children, "instantiate", true, false, false, simple_instantiate_before_facts, instantiate_goal, simple_instantiate_after_facts, forged_goal, malformed_instantiate_argument, true, 0, false, 0, true, "forall")
                return 74 if malformed_argument_step_admitted

                # The action label cannot promote an existential fact to a universal one. The selected
                # arena node's bound quantifier kind is authoritative for independent tactic replay.
                existential_instantiate_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                existential_instantiate_children: mutable darray[usize] = []
                existential_instantiate_value: usize = ElisaProofKernelCore::add_node(&existential_instantiate_nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
                existential_instantiate_children.push(existential_instantiate_value)
                existential_instantiate_range: usize = ElisaProofKernelCore::add_node(&existential_instantiate_nodes, "array", "", 0, 0, 0, 0, 1, 0, "", "")
                existential_instantiate_body: usize = ElisaProofKernelCore::add_node(&existential_instantiate_nodes, "binary", "==", existential_instantiate_value, existential_instantiate_value, 0, 0, 0, 0, "", "")
                existential_instantiate_fact: usize = ElisaProofKernelCore::add_node(&existential_instantiate_nodes, "quantifier", "exists", existential_instantiate_range, existential_instantiate_body, 1, 0, 0, 0, "x", "")
                existential_instantiate_goal: usize = ElisaProofKernelCore::add_node(&existential_instantiate_nodes, "bool", "", 0, 0, 0, 0, 0, 1, "", "")
                existential_instantiate_facts: darray[usize] = [existential_instantiate_fact]
                existential_instantiate_after: darray[usize] = [existential_instantiate_fact, existential_instantiate_body]
                existential_instantiate_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_tactic_step(&existential_instantiate_nodes, &existential_instantiate_children, "instantiate", true, false, false, existential_instantiate_facts, existential_instantiate_goal, existential_instantiate_after, existential_instantiate_goal, existential_instantiate_value, true, 0, false, 0, true, "forall")
                return 80 if existential_instantiate_admitted

                # A nested scope cannot hide destruction of an inherited region. Without this check, the
                return 0
