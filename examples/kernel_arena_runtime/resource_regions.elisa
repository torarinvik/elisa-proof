# Region lifetime balance, nested scope isolation, and stale-region rejection.
module ElisaProofResourceRegionTests:
    public:
        def run() -> i64 can[Memory.Allocate, Abort.Panic]:
            can Memory.Allocate, Abort.Panic:
                valid_region_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                valid_region_children: mutable darray[usize] = []
                valid_region_open: usize = ElisaProofKernelCore::add_node(&valid_region_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "r", "")
                valid_region_operand: usize = ElisaProofKernelCore::add_node(&valid_region_nodes, "int", "", 0, 0, 0, 0, 0, 7, "", "")
                valid_region_alloc: usize = ElisaProofKernelCore::add_node(&valid_region_nodes, "resource-region-alloc", "", valid_region_operand, 0, 2, 0, 0, 0, "value", "r")
                valid_region_place: usize = ElisaProofKernelCore::add_node(&valid_region_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "value", "")
                valid_region_use: usize = ElisaProofKernelCore::add_node(&valid_region_nodes, "resource-use", "", valid_region_place, 0, 0, 0, 0, 0, "value", "")
                valid_region_close: usize = ElisaProofKernelCore::add_node(&valid_region_nodes, "resource-region-close", "", 0, 0, 0, 0, 0, 0, "r", "")
                valid_region_children.push(valid_region_open)
                valid_region_children.push(valid_region_alloc)
                valid_region_children.push(valid_region_use)
                valid_region_children.push(valid_region_close)
                valid_region_root: usize = ElisaProofKernelCore::add_node(&valid_region_nodes, "resource-safety", "", 0, 0, 0, 0, 4, 0, "valid-region", "resource-v1")
                valid_region_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&valid_region_nodes, &valid_region_children, [], valid_region_root)
                return 23 if not valid_region_admitted

                # A top-level local region must be balanced. The source checker emits the implicit function
                # close, but the independent kernel must reject a forged report that omits it.
                unclosed_region_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                unclosed_region_children: mutable darray[usize] = []
                unclosed_region_open: usize = ElisaProofKernelCore::add_node(&unclosed_region_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "r", "")
                unclosed_region_children.push(unclosed_region_open)
                unclosed_region_root: usize = ElisaProofKernelCore::add_node(&unclosed_region_nodes, "resource-safety", "", 0, 0, 0, 0, 1, 0, "unclosed-region", "resource-v1")
                unclosed_region_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&unclosed_region_nodes, &unclosed_region_children, [], unclosed_region_root)
                return 84 if unclosed_region_admitted

                # A nested scope must not leak a fresh local region when its snapshot is discarded. The
                # parent region remains balanced, so membership-only scope checks would otherwise miss this.
                leaked_scope_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                leaked_scope_children: mutable darray[usize] = []
                leaked_scope_parent_open: usize = ElisaProofKernelCore::add_node(&leaked_scope_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "parent", "")
                leaked_scope_child_open: usize = ElisaProofKernelCore::add_node(&leaked_scope_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "child", "")
                leaked_scope_child_start: usize = leaked_scope_children.count
                leaked_scope_children.push(leaked_scope_child_open)
                leaked_scope: usize = ElisaProofKernelCore::add_node(&leaked_scope_nodes, "resource-scope", "", 0, 0, 0, leaked_scope_child_start, 1, 0, "", "")
                leaked_scope_parent_close: usize = ElisaProofKernelCore::add_node(&leaked_scope_nodes, "resource-region-close", "", 0, 0, 0, 0, 0, 0, "parent", "")
                leaked_scope_root_start: usize = leaked_scope_children.count
                leaked_scope_children.push(leaked_scope_parent_open)
                leaked_scope_children.push(leaked_scope)
                leaked_scope_children.push(leaked_scope_parent_close)
                leaked_scope_root: usize = ElisaProofKernelCore::add_node(&leaked_scope_nodes, "resource-safety", "", 0, 0, 0, leaked_scope_root_start, 3, 0, "leaked-scope-region", "resource-v1")
                leaked_scope_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&leaked_scope_nodes, &leaked_scope_children, [], leaked_scope_root)
                return 85 if leaked_scope_admitted

                # A nested scope cannot destroy an inherited region and reopen the same spelling: the
                # reopened name denotes a fresh lifetime, while the parent snapshot still holds the old one.
                # This case has no binding on purpose, so replay must protect region identity itself.
                nested_reopened_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                nested_reopened_children: mutable darray[usize] = []
                nested_reopened_open: usize = ElisaProofKernelCore::add_node(&nested_reopened_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "r", "")
                nested_reopened_close: usize = ElisaProofKernelCore::add_node(&nested_reopened_nodes, "resource-region-close", "", 0, 0, 0, 0, 0, 0, "r", "")
                nested_reopened_again: usize = ElisaProofKernelCore::add_node(&nested_reopened_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "r", "")
                nested_reopened_scope_children_start: usize = nested_reopened_children.count
                nested_reopened_children.push(nested_reopened_close)
                nested_reopened_children.push(nested_reopened_again)
                nested_reopened_scope: usize = ElisaProofKernelCore::add_node(&nested_reopened_nodes, "resource-scope", "", 0, 0, 0, nested_reopened_scope_children_start, 2, 0, "", "")
                nested_reopened_operand: usize = ElisaProofKernelCore::add_node(&nested_reopened_nodes, "int", "", 0, 0, 0, 0, 0, 7, "", "")
                nested_reopened_alloc: usize = ElisaProofKernelCore::add_node(&nested_reopened_nodes, "resource-region-alloc", "", nested_reopened_operand, 0, 0, 0, 0, 0, "value", "r")
                nested_reopened_final_close: usize = ElisaProofKernelCore::add_node(&nested_reopened_nodes, "resource-region-close", "", 0, 0, 0, 0, 0, 0, "r", "")
                nested_reopened_children.push(nested_reopened_open)
                nested_reopened_children.push(nested_reopened_scope)
                nested_reopened_children.push(nested_reopened_alloc)
                nested_reopened_children.push(nested_reopened_final_close)
                nested_reopened_root: usize = ElisaProofKernelCore::add_node(&nested_reopened_nodes, "resource-safety", "", 0, 0, 0, nested_reopened_scope_children_start + 2, 4, 0, "nested-region-reopened", "resource-v1")
                nested_reopened_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&nested_reopened_nodes, &nested_reopened_children, [], nested_reopened_root)
                return 29 if nested_reopened_admitted

                region_without_open_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                region_without_open_children: mutable darray[usize] = []
                region_without_open_operand: usize = ElisaProofKernelCore::add_node(&region_without_open_nodes, "int", "", 0, 0, 0, 0, 0, 7, "", "")
                region_without_open_alloc: usize = ElisaProofKernelCore::add_node(&region_without_open_nodes, "resource-region-alloc", "", region_without_open_operand, 0, 0, 0, 0, 0, "value", "r")
                region_without_open_children.push(region_without_open_alloc)
                region_without_open_root: usize = ElisaProofKernelCore::add_node(&region_without_open_nodes, "resource-safety", "", 0, 0, 0, 0, 1, 0, "region-without-open", "resource-v1")
                region_without_open_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&region_without_open_nodes, &region_without_open_children, [], region_without_open_root)
                return 24 if region_without_open_admitted

                region_bad_close_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                region_bad_close_children: mutable darray[usize] = []
                region_bad_close: usize = ElisaProofKernelCore::add_node(&region_bad_close_nodes, "resource-region-close", "", 0, 0, 0, 0, 0, 0, "r", "")
                region_bad_close_children.push(region_bad_close)
                region_bad_close_root: usize = ElisaProofKernelCore::add_node(&region_bad_close_nodes, "resource-safety", "", 0, 0, 0, 0, 1, 0, "region-bad-close", "resource-v1")
                region_bad_close_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&region_bad_close_nodes, &region_bad_close_children, [], region_bad_close_root)
                return 25 if region_bad_close_admitted

                region_stale_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                region_stale_children: mutable darray[usize] = []
                region_stale_open: usize = ElisaProofKernelCore::add_node(&region_stale_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "r", "")
                region_stale_operand: usize = ElisaProofKernelCore::add_node(&region_stale_nodes, "int", "", 0, 0, 0, 0, 0, 7, "", "")
                region_stale_alloc: usize = ElisaProofKernelCore::add_node(&region_stale_nodes, "resource-region-alloc", "", region_stale_operand, 0, 2, 0, 0, 0, "value", "r")
                region_stale_close: usize = ElisaProofKernelCore::add_node(&region_stale_nodes, "resource-region-close", "", 0, 0, 0, 0, 0, 0, "r", "")
                region_stale_place: usize = ElisaProofKernelCore::add_node(&region_stale_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "value", "")
                region_stale_use: usize = ElisaProofKernelCore::add_node(&region_stale_nodes, "resource-use", "", region_stale_place, 0, 0, 0, 0, 0, "value", "")
                region_stale_children.push(region_stale_open)
                region_stale_children.push(region_stale_alloc)
                region_stale_children.push(region_stale_close)
                region_stale_children.push(region_stale_use)
                region_stale_root: usize = ElisaProofKernelCore::add_node(&region_stale_nodes, "resource-safety", "", 0, 0, 0, 0, 4, 0, "region-stale", "resource-v1")
                region_stale_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&region_stale_nodes, &region_stale_children, [], region_stale_root)
                return 26 if region_stale_admitted

                region_reopened_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                region_reopened_children: mutable darray[usize] = []
                region_reopened_open: usize = ElisaProofKernelCore::add_node(&region_reopened_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "r", "")
                region_reopened_operand: usize = ElisaProofKernelCore::add_node(&region_reopened_nodes, "int", "", 0, 0, 0, 0, 0, 7, "", "")
                region_reopened_alloc: usize = ElisaProofKernelCore::add_node(&region_reopened_nodes, "resource-region-alloc", "", region_reopened_operand, 0, 2, 0, 0, 0, "value", "r")
                region_reopened_close: usize = ElisaProofKernelCore::add_node(&region_reopened_nodes, "resource-region-close", "", 0, 0, 0, 0, 0, 0, "r", "")
                region_reopened_again: usize = ElisaProofKernelCore::add_node(&region_reopened_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "r", "")
                region_reopened_place: usize = ElisaProofKernelCore::add_node(&region_reopened_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "value", "")
                region_reopened_use: usize = ElisaProofKernelCore::add_node(&region_reopened_nodes, "resource-use", "", region_reopened_place, 0, 0, 0, 0, 0, "value", "")
                region_reopened_children.push(region_reopened_open)
                region_reopened_children.push(region_reopened_alloc)
                region_reopened_children.push(region_reopened_close)
                region_reopened_children.push(region_reopened_again)
                region_reopened_children.push(region_reopened_use)
                region_reopened_root: usize = ElisaProofKernelCore::add_node(&region_reopened_nodes, "resource-safety", "", 0, 0, 0, 0, 5, 0, "region-reopened", "resource-v1")
                region_reopened_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&region_reopened_nodes, &region_reopened_children, [], region_reopened_root)
                return 27 if region_reopened_admitted

                region_alias_reopened_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                region_alias_reopened_children: mutable darray[usize] = []
                region_alias_reopened_open: usize = ElisaProofKernelCore::add_node(&region_alias_reopened_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "r", "")
                region_alias_reopened_operand: usize = ElisaProofKernelCore::add_node(&region_alias_reopened_nodes, "int", "", 0, 0, 0, 0, 0, 7, "", "")
                region_alias_reopened_alloc: usize = ElisaProofKernelCore::add_node(&region_alias_reopened_nodes, "resource-region-alloc", "", region_alias_reopened_operand, 0, 2, 0, 0, 0, "value", "r")
                region_alias_reopened_place: usize = ElisaProofKernelCore::add_node(&region_alias_reopened_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "value", "")
                region_alias_reopened_alias: usize = ElisaProofKernelCore::add_node(&region_alias_reopened_nodes, "resource-bind", "shared", region_alias_reopened_place, 0, 0, 0, 0, 0, "alias", "value")
                region_alias_reopened_close: usize = ElisaProofKernelCore::add_node(&region_alias_reopened_nodes, "resource-region-close", "", 0, 0, 0, 0, 0, 0, "r", "")
                region_alias_reopened_again: usize = ElisaProofKernelCore::add_node(&region_alias_reopened_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "r", "")
                region_alias_reopened_alias_place: usize = ElisaProofKernelCore::add_node(&region_alias_reopened_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "alias", "")
                region_alias_reopened_use: usize = ElisaProofKernelCore::add_node(&region_alias_reopened_nodes, "resource-use", "", region_alias_reopened_alias_place, 0, 0, 0, 0, 0, "alias", "")
                region_alias_reopened_children.push(region_alias_reopened_open)
                region_alias_reopened_children.push(region_alias_reopened_alloc)
                region_alias_reopened_children.push(region_alias_reopened_alias)
                region_alias_reopened_children.push(region_alias_reopened_close)
                region_alias_reopened_children.push(region_alias_reopened_again)
                region_alias_reopened_children.push(region_alias_reopened_use)
                region_alias_reopened_root: usize = ElisaProofKernelCore::add_node(&region_alias_reopened_nodes, "resource-safety", "", 0, 0, 0, 0, 6, 0, "region-alias-reopened", "resource-v1")
                region_alias_reopened_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&region_alias_reopened_nodes, &region_alias_reopened_children, [], region_alias_reopened_root)
                return 28 if region_alias_reopened_admitted

                return 0
