# Independent borrow-place aliases, region transfers, and forged reference-return certificates.
module ElisaProofResourceAliasTests:
    public:
        def run() -> i64 can[Memory.Allocate, Abort.Panic]:
            can Memory.Allocate, Abort.Panic:
                # A region assignment may not rebind an active borrow handle. The transition language does
                # not encode borrow release, so accepting it would leave stale overlap metadata behind.
                assign_borrow_target_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                assign_borrow_target_children: mutable darray[usize] = []
                assign_borrow_target_open: usize = ElisaProofKernelCore::add_node(&assign_borrow_target_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "r", "")
                assign_borrow_target_source_value: usize = ElisaProofKernelCore::add_node(&assign_borrow_target_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
                assign_borrow_target_source: usize = ElisaProofKernelCore::add_node(&assign_borrow_target_nodes, "resource-region-alloc", "", assign_borrow_target_source_value, 0, 6, 0, 0, 0, "source", "r")
                assign_borrow_target_source_place: usize = ElisaProofKernelCore::add_node(&assign_borrow_target_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "source", "")
                assign_borrow_target_borrow: usize = ElisaProofKernelCore::add_node(&assign_borrow_target_nodes, "resource-bind", "mutable", assign_borrow_target_source_place, 0, 1, 0, 0, 0, "borrow", "source")
                assign_borrow_target_assignment_source: usize = ElisaProofKernelCore::add_node(&assign_borrow_target_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "source", "")
                assign_borrow_target_assignment: usize = ElisaProofKernelCore::add_node(&assign_borrow_target_nodes, "resource-region-assign", "", assign_borrow_target_assignment_source, 0, 0, 0, 0, 0, "borrow", "r")
                assign_borrow_target_close: usize = ElisaProofKernelCore::add_node(&assign_borrow_target_nodes, "resource-region-close", "", 0, 0, 0, 0, 0, 0, "r", "")
                assign_borrow_target_children.push(assign_borrow_target_open)
                assign_borrow_target_children.push(assign_borrow_target_source)
                assign_borrow_target_children.push(assign_borrow_target_borrow)
                assign_borrow_target_children.push(assign_borrow_target_assignment)
                assign_borrow_target_children.push(assign_borrow_target_close)
                assign_borrow_target_report: usize = ElisaProofKernelCore::add_node(&assign_borrow_target_nodes, "resource-safety", "", 0, 0, 0, 0, 5, 0, "assign-borrow-target", "resource-v1")
                assign_borrow_target_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&assign_borrow_target_nodes, &assign_borrow_target_children, [], assign_borrow_target_report)
                return 92 if assign_borrow_target_admitted

                # A forged trace must not create a borrow from a binding whose capability was moved.
                borrow_after_move_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                borrow_after_move_children: mutable darray[usize] = []
                borrow_after_move_owner: usize = ElisaProofKernelCore::add_node(&borrow_after_move_nodes, "resource-bind", "external-mutable", 0, 0, 1, 0, 0, 0, "owner", "")
                borrow_after_move_place: usize = ElisaProofKernelCore::add_node(&borrow_after_move_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "owner", "")
                borrow_after_move_move: usize = ElisaProofKernelCore::add_node(&borrow_after_move_nodes, "resource-move", "", borrow_after_move_place, 0, 0, 0, 0, 0, "owner", "")
                borrow_after_move_source: usize = ElisaProofKernelCore::add_node(&borrow_after_move_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "owner", "")
                borrow_after_move_alias: usize = ElisaProofKernelCore::add_node(&borrow_after_move_nodes, "resource-bind", "shared", borrow_after_move_source, 0, 0, 0, 0, 0, "alias", "owner")
                borrow_after_move_children.push(borrow_after_move_owner)
                borrow_after_move_children.push(borrow_after_move_move)
                borrow_after_move_children.push(borrow_after_move_alias)
                borrow_after_move_report: usize = ElisaProofKernelCore::add_node(&borrow_after_move_nodes, "resource-safety", "", 0, 0, 0, 0, 3, 0, "borrow-after-move", "resource-v1")
                borrow_after_move_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&borrow_after_move_nodes, &borrow_after_move_children, [], borrow_after_move_report)
                return 93 if borrow_after_move_admitted

                forged_region_alias_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                forged_region_alias_children: mutable darray[usize] = []
                forged_region_alias_param: usize = ElisaProofKernelCore::add_node(&forged_region_alias_nodes, "resource-region-param", "external", 0, 0, 0, 0, 0, 0, "r", "")
                forged_region_alias_source: usize = ElisaProofKernelCore::add_node(&forged_region_alias_nodes, "resource-bind", "external-shared", 0, 0, 0, 0, 0, 0, "source", "r")
                forged_region_alias_source_place: usize = ElisaProofKernelCore::add_node(&forged_region_alias_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "source", "")
                forged_region_alias_alias: usize = ElisaProofKernelCore::add_node(&forged_region_alias_nodes, "resource-region-bind", "", forged_region_alias_source_place, 0, 6, 0, 0, 0, "alias", "r")
                forged_region_alias_place: usize = ElisaProofKernelCore::add_node(&forged_region_alias_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "alias", "")
                forged_region_alias_write: usize = ElisaProofKernelCore::add_node(&forged_region_alias_nodes, "resource-write", "", forged_region_alias_place, 0, 0, 0, 0, 0, "alias", "")
                forged_region_alias_start: usize = forged_region_alias_children.count
                forged_region_alias_children.push(forged_region_alias_param)
                forged_region_alias_children.push(forged_region_alias_source)
                forged_region_alias_children.push(forged_region_alias_alias)
                forged_region_alias_children.push(forged_region_alias_write)
                forged_region_alias_report: usize = ElisaProofKernelCore::add_node(&forged_region_alias_nodes, "resource-safety", "", 0, 0, 0, forged_region_alias_start, 4, 0, "forged-region-alias", "resource-v1")
                forged_region_alias_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&forged_region_alias_nodes, &forged_region_alias_children, [], forged_region_alias_report)
                return 67 if forged_region_alias_admitted

                valid_region_alias_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                valid_region_alias_children: mutable darray[usize] = []
                valid_region_alias_open: usize = ElisaProofKernelCore::add_node(&valid_region_alias_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "r", "")
                valid_region_alias_value: usize = ElisaProofKernelCore::add_node(&valid_region_alias_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
                valid_region_alias_source: usize = ElisaProofKernelCore::add_node(&valid_region_alias_nodes, "resource-region-alloc", "", valid_region_alias_value, 0, 6, 0, 0, 0, "source", "r")
                valid_region_alias_source_place: usize = ElisaProofKernelCore::add_node(&valid_region_alias_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "source", "")
                valid_region_alias_alias: usize = ElisaProofKernelCore::add_node(&valid_region_alias_nodes, "resource-region-bind", "", valid_region_alias_source_place, 0, 6, 0, 0, 0, "alias", "r")
                valid_region_alias_place: usize = ElisaProofKernelCore::add_node(&valid_region_alias_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "alias", "")
                valid_region_alias_write: usize = ElisaProofKernelCore::add_node(&valid_region_alias_nodes, "resource-write", "", valid_region_alias_place, 0, 0, 0, 0, 0, "alias", "")
                valid_region_alias_close: usize = ElisaProofKernelCore::add_node(&valid_region_alias_nodes, "resource-region-close", "", 0, 0, 0, 0, 0, 0, "r", "")
                valid_region_alias_start: usize = valid_region_alias_children.count
                valid_region_alias_children.push(valid_region_alias_open)
                valid_region_alias_children.push(valid_region_alias_source)
                valid_region_alias_children.push(valid_region_alias_alias)
                valid_region_alias_children.push(valid_region_alias_write)
                valid_region_alias_children.push(valid_region_alias_close)
                valid_region_alias_report: usize = ElisaProofKernelCore::add_node(&valid_region_alias_nodes, "resource-safety", "", 0, 0, 0, valid_region_alias_start, 5, 0, "valid-region-alias", "resource-v1")
                valid_region_alias_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&valid_region_alias_nodes, &valid_region_alias_children, [], valid_region_alias_report)
                return 68 if not valid_region_alias_admitted

                # A direct region owner token transfers through the first region alias. Reusing the original
                # owner to mint a second mutable alias must be rejected by the independent replay kernel.
                duplicate_region_alias_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                duplicate_region_alias_children: mutable darray[usize] = []
                duplicate_region_alias_open: usize = ElisaProofKernelCore::add_node(&duplicate_region_alias_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "r", "")
                duplicate_region_alias_value: usize = ElisaProofKernelCore::add_node(&duplicate_region_alias_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
                duplicate_region_alias_source: usize = ElisaProofKernelCore::add_node(&duplicate_region_alias_nodes, "resource-region-alloc", "", duplicate_region_alias_value, 0, 6, 0, 0, 0, "source", "r")
                duplicate_region_alias_source_place: usize = ElisaProofKernelCore::add_node(&duplicate_region_alias_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "source", "")
                duplicate_region_alias_first: usize = ElisaProofKernelCore::add_node(&duplicate_region_alias_nodes, "resource-region-bind", "", duplicate_region_alias_source_place, 0, 6, 0, 0, 0, "first", "r")
                duplicate_region_alias_second: usize = ElisaProofKernelCore::add_node(&duplicate_region_alias_nodes, "resource-region-bind", "", duplicate_region_alias_source_place, 0, 6, 0, 0, 0, "second", "r")
                duplicate_region_alias_second_place: usize = ElisaProofKernelCore::add_node(&duplicate_region_alias_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "second", "")
                duplicate_region_alias_write: usize = ElisaProofKernelCore::add_node(&duplicate_region_alias_nodes, "resource-write", "", duplicate_region_alias_second_place, 0, 0, 0, 0, 0, "second", "")
                duplicate_region_alias_close: usize = ElisaProofKernelCore::add_node(&duplicate_region_alias_nodes, "resource-region-close", "", 0, 0, 0, 0, 0, 0, "r", "")
                duplicate_region_alias_children.push(duplicate_region_alias_open)
                duplicate_region_alias_children.push(duplicate_region_alias_source)
                duplicate_region_alias_children.push(duplicate_region_alias_first)
                duplicate_region_alias_children.push(duplicate_region_alias_second)
                duplicate_region_alias_children.push(duplicate_region_alias_write)
                duplicate_region_alias_children.push(duplicate_region_alias_close)
                duplicate_region_alias_report: usize = ElisaProofKernelCore::add_node(&duplicate_region_alias_nodes, "resource-safety", "", 0, 0, 0, 0, 6, 0, "duplicate-region-alias", "resource-v1")
                duplicate_region_alias_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&duplicate_region_alias_nodes, &duplicate_region_alias_children, [], duplicate_region_alias_report)
                return 86 if duplicate_region_alias_admitted

                # Region aliases currently carry no target path metadata. A forged field source would
                # therefore be widened to a whole-root writable alias unless the kernel rejects it.
                forged_region_field_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                forged_region_field_children: mutable darray[usize] = []
                forged_region_field_open: usize = ElisaProofKernelCore::add_node(&forged_region_field_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "r", "")
                forged_region_field_value: usize = ElisaProofKernelCore::add_node(&forged_region_field_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
                forged_region_field_source: usize = ElisaProofKernelCore::add_node(&forged_region_field_nodes, "resource-region-alloc", "", forged_region_field_value, 0, 6, 0, 0, 0, "source", "r")
                forged_region_field_source_root: usize = ElisaProofKernelCore::add_node(&forged_region_field_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "source", "")
                forged_region_field_source_path: usize = ElisaProofKernelCore::add_node(&forged_region_field_nodes, "field", "", forged_region_field_source_root, 0, 0, 0, 0, 0, "field", "")
                forged_region_field_alias: usize = ElisaProofKernelCore::add_node(&forged_region_field_nodes, "resource-region-bind", "", forged_region_field_source_path, 0, 6, 0, 0, 0, "alias", "r")
                forged_region_field_alias_place: usize = ElisaProofKernelCore::add_node(&forged_region_field_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "alias", "")
                forged_region_field_write: usize = ElisaProofKernelCore::add_node(&forged_region_field_nodes, "resource-write", "", forged_region_field_alias_place, 0, 0, 0, 0, 0, "alias", "")
                forged_region_field_close: usize = ElisaProofKernelCore::add_node(&forged_region_field_nodes, "resource-region-close", "", 0, 0, 0, 0, 0, 0, "r", "")
                forged_region_field_children.push(forged_region_field_open)
                forged_region_field_children.push(forged_region_field_source)
                forged_region_field_children.push(forged_region_field_alias)
                forged_region_field_children.push(forged_region_field_write)
                forged_region_field_children.push(forged_region_field_close)
                forged_region_field_report: usize = ElisaProofKernelCore::add_node(&forged_region_field_nodes, "resource-safety", "", 0, 0, 0, 0, 5, 0, "forged-region-field-alias", "resource-v1")
                forged_region_field_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&forged_region_field_nodes, &forged_region_field_children, [], forged_region_field_report)
                return 87 if forged_region_field_admitted

                # Region assignment also stores no source path. A field-derived lifetime must not be
                # transferred to an unrelated whole target binding.
                forged_region_assign_field_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                forged_region_assign_field_children: mutable darray[usize] = []
                forged_region_assign_field_open: usize = ElisaProofKernelCore::add_node(&forged_region_assign_field_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "r", "")
                forged_region_assign_field_value: usize = ElisaProofKernelCore::add_node(&forged_region_assign_field_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
                forged_region_assign_field_source: usize = ElisaProofKernelCore::add_node(&forged_region_assign_field_nodes, "resource-region-alloc", "", forged_region_assign_field_value, 0, 0, 0, 0, 0, "source", "r")
                forged_region_assign_field_source_root: usize = ElisaProofKernelCore::add_node(&forged_region_assign_field_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "source", "")
                forged_region_assign_field_source_path: usize = ElisaProofKernelCore::add_node(&forged_region_assign_field_nodes, "field", "", forged_region_assign_field_source_root, 0, 0, 0, 0, 0, "field", "")
                forged_region_assign_field_target: usize = ElisaProofKernelCore::add_node(&forged_region_assign_field_nodes, "resource-bind", "value", 0, 0, 1, 0, 0, 0, "target", "")
                forged_region_assign_field_event: usize = ElisaProofKernelCore::add_node(&forged_region_assign_field_nodes, "resource-region-assign", "", forged_region_assign_field_source_path, 0, 0, 0, 0, 0, "target", "r")
                forged_region_assign_field_close: usize = ElisaProofKernelCore::add_node(&forged_region_assign_field_nodes, "resource-region-close", "", 0, 0, 0, 0, 0, 0, "r", "")
                forged_region_assign_field_children.push(forged_region_assign_field_open)
                forged_region_assign_field_children.push(forged_region_assign_field_source)
                forged_region_assign_field_children.push(forged_region_assign_field_target)
                forged_region_assign_field_children.push(forged_region_assign_field_event)
                forged_region_assign_field_children.push(forged_region_assign_field_close)
                forged_region_assign_field_report: usize = ElisaProofKernelCore::add_node(&forged_region_assign_field_nodes, "resource-safety", "", 0, 0, 0, 0, 5, 0, "forged-region-assign-field", "resource-v1")
                forged_region_assign_field_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&forged_region_assign_field_nodes, &forged_region_assign_field_children, [], forged_region_assign_field_report)
                return 88 if forged_region_assign_field_admitted

                malformed_region_shape_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                malformed_region_shape_children: mutable darray[usize] = []
                malformed_region_shape_open: usize = ElisaProofKernelCore::add_node(&malformed_region_shape_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "r", "")
                malformed_region_shape_value: usize = ElisaProofKernelCore::add_node(&malformed_region_shape_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
                malformed_region_shape_alloc: usize = ElisaProofKernelCore::add_node(&malformed_region_shape_nodes, "resource-region-alloc", "", malformed_region_shape_value, 0, 4, 0, 0, 0, "value", "r")
                malformed_region_shape_close: usize = ElisaProofKernelCore::add_node(&malformed_region_shape_nodes, "resource-region-close", "", 0, 0, 0, 0, 0, 0, "r", "")
                malformed_region_shape_start: usize = malformed_region_shape_children.count
                malformed_region_shape_children.push(malformed_region_shape_open)
                malformed_region_shape_children.push(malformed_region_shape_alloc)
                malformed_region_shape_children.push(malformed_region_shape_close)
                malformed_region_shape_report: usize = ElisaProofKernelCore::add_node(&malformed_region_shape_nodes, "resource-safety", "", 0, 0, 0, malformed_region_shape_start, 3, 0, "malformed-region-shape", "resource-v1")
                malformed_region_shape_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&malformed_region_shape_nodes, &malformed_region_shape_children, [], malformed_region_shape_report)
                return 69 if malformed_region_shape_admitted

                malformed_summary_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                malformed_summary_children: mutable darray[usize] = []
                malformed_summary_formal: usize = ElisaProofKernelCore::add_node(&malformed_summary_nodes, "resource-bind", "value", 0, 0, 0, 0, 0, 0, "argument", "")
                malformed_summary_late_region: usize = ElisaProofKernelCore::add_node(&malformed_summary_nodes, "resource-region-param", "external", 0, 0, 0, 0, 0, 0, "r", "")
                malformed_summary_body_source: usize = ElisaProofKernelCore::add_node(&malformed_summary_nodes, "resource-bind", "external-shared", 0, 0, 0, 0, 0, 0, "body_source", "r")
                malformed_summary_return: usize = ElisaProofKernelCore::add_node(&malformed_summary_nodes, "resource-region-return", "param", 0, 0, 0, 0, 0, 0, "r", "")
                malformed_summary_callee_start: usize = malformed_summary_children.count
                malformed_summary_children.push(malformed_summary_formal)
                malformed_summary_children.push(malformed_summary_late_region)
                malformed_summary_children.push(malformed_summary_body_source)
                malformed_summary_children.push(malformed_summary_return)
                malformed_summary_callee: usize = ElisaProofKernelCore::add_node(&malformed_summary_nodes, "resource-safety", "", 0, 0, 1, malformed_summary_callee_start, 4, 0, "malformed-summary", "resource-v1")
                malformed_summary_argument_value: usize = ElisaProofKernelCore::add_node(&malformed_summary_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
                malformed_summary_call_argument: usize = ElisaProofKernelCore::add_node(&malformed_summary_nodes, "resource-call-arg", "value", malformed_summary_argument_value, 0, 0, 0, 0, 0, "argument", "")
                malformed_summary_call_region: usize = ElisaProofKernelCore::add_node(&malformed_summary_nodes, "resource-call-region", "param", 0, 0, 0, 0, 0, 0, "r", "r")
                malformed_summary_children.push(malformed_summary_call_argument)
                malformed_summary_children.push(malformed_summary_call_region)
                malformed_summary_caller_region: usize = ElisaProofKernelCore::add_node(&malformed_summary_nodes, "resource-region-param", "external", 0, 0, 0, 0, 0, 0, "r", "")
                malformed_summary_caller_argument: usize = ElisaProofKernelCore::add_node(&malformed_summary_nodes, "resource-bind", "value", 0, 0, 0, 0, 0, 0, "actual", "")
                malformed_summary_call: usize = ElisaProofKernelCore::add_node(&malformed_summary_nodes, "resource-call", "", malformed_summary_callee, 1, 1, 4, 2, 0, "malformed-summary", "")
                malformed_summary_caller_start: usize = malformed_summary_children.count
                malformed_summary_children.push(malformed_summary_caller_region)
                malformed_summary_children.push(malformed_summary_caller_argument)
                malformed_summary_children.push(malformed_summary_call)
                malformed_summary_caller: usize = ElisaProofKernelCore::add_node(&malformed_summary_nodes, "resource-safety", "", 0, 0, 0, malformed_summary_caller_start, 3, 0, "malformed-summary-caller", "resource-v1")
                malformed_summary_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&malformed_summary_nodes, &malformed_summary_children, [], malformed_summary_caller)
                return 70 if malformed_summary_admitted



                # Region rebinding is a write to the target binding. It may not resurrect a moved target.
                illegal_region_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                illegal_region_children: mutable darray[usize] = []
                illegal_region_open: usize = ElisaProofKernelCore::add_node(&illegal_region_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "r", "")
                illegal_region_source_value: usize = ElisaProofKernelCore::add_node(&illegal_region_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
                illegal_region_source: usize = ElisaProofKernelCore::add_node(&illegal_region_nodes, "resource-region-alloc", "", illegal_region_source_value, 0, 2, 0, 0, 0, "source", "r")
                illegal_region_target_value: usize = ElisaProofKernelCore::add_node(&illegal_region_nodes, "int", "", 0, 0, 0, 0, 0, 2, "", "")
                illegal_region_target: usize = ElisaProofKernelCore::add_node(&illegal_region_nodes, "resource-region-alloc", "", illegal_region_target_value, 0, 2, 0, 0, 0, "target", "r")
                illegal_region_target_place: usize = ElisaProofKernelCore::add_node(&illegal_region_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "target", "")
                illegal_region_move: usize = ElisaProofKernelCore::add_node(&illegal_region_nodes, "resource-move", "", illegal_region_target_place, 0, 0, 0, 0, 0, "target", "")
                illegal_region_source_place: usize = ElisaProofKernelCore::add_node(&illegal_region_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "source", "")
                illegal_region_assign: usize = ElisaProofKernelCore::add_node(&illegal_region_nodes, "resource-region-assign", "", illegal_region_source_place, 0, 0, 0, 0, 0, "target", "r")
                illegal_region_children.push(illegal_region_open)
                illegal_region_children.push(illegal_region_source)
                illegal_region_children.push(illegal_region_target)
                illegal_region_children.push(illegal_region_move)
                illegal_region_children.push(illegal_region_assign)
                illegal_region_root: usize = ElisaProofKernelCore::add_node(&illegal_region_nodes, "resource-safety", "", 0, 0, 0, 0, 5, 0, "illegal-region-rebind", "resource-v1")
                illegal_region_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&illegal_region_nodes, &illegal_region_children, [], illegal_region_root)
                return 47 if illegal_region_admitted

                # A fresh region allocation also cannot overwrite a root while any overlapping borrow is live.
                illegal_borrow_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                illegal_borrow_children: mutable darray[usize] = []
                illegal_borrow_open: usize = ElisaProofKernelCore::add_node(&illegal_borrow_nodes, "resource-region-open", "", 0, 0, 0, 0, 0, 0, "r", "")
                illegal_borrow_owner_value: usize = ElisaProofKernelCore::add_node(&illegal_borrow_nodes, "int", "", 0, 0, 0, 0, 0, 1, "", "")
                illegal_borrow_owner: usize = ElisaProofKernelCore::add_node(&illegal_borrow_nodes, "resource-region-alloc", "", illegal_borrow_owner_value, 0, 2, 0, 0, 0, "owner", "r")
                illegal_borrow_place: usize = ElisaProofKernelCore::add_node(&illegal_borrow_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "owner", "")
                illegal_borrow_alias: usize = ElisaProofKernelCore::add_node(&illegal_borrow_nodes, "resource-bind", "shared", illegal_borrow_place, 0, 0, 0, 0, 0, "alias", "owner")
                illegal_borrow_replacement_value: usize = ElisaProofKernelCore::add_node(&illegal_borrow_nodes, "int", "", 0, 0, 0, 0, 0, 2, "", "")
                illegal_borrow_replacement: usize = ElisaProofKernelCore::add_node(&illegal_borrow_nodes, "resource-region-rebind-alloc", "", illegal_borrow_replacement_value, 0, 0, 0, 0, 0, "owner", "r")
                illegal_borrow_children.push(illegal_borrow_open)
                illegal_borrow_children.push(illegal_borrow_owner)
                illegal_borrow_children.push(illegal_borrow_alias)
                illegal_borrow_children.push(illegal_borrow_replacement)
                illegal_borrow_root: usize = ElisaProofKernelCore::add_node(&illegal_borrow_nodes, "resource-safety", "", 0, 0, 0, 0, 4, 0, "illegal-borrow-rebind", "resource-v1")
                illegal_borrow_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&illegal_borrow_nodes, &illegal_borrow_children, [], illegal_borrow_root)
                return 48 if illegal_borrow_admitted

                # A return-region marker must be backed by an exact replayed resource transition. A naked
                # marker, or a marker attached to an ordinary scalar use, cannot manufacture a reference.
                naked_return_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                naked_return_children: mutable darray[usize] = []
                naked_return_param: usize = ElisaProofKernelCore::add_node(&naked_return_nodes, "resource-region-param", "external", 0, 0, 0, 0, 0, 0, "r", "")
                naked_return_marker: usize = ElisaProofKernelCore::add_node(&naked_return_nodes, "resource-region-return", "param", 0, 0, 0, 0, 0, 0, "r", "")
                naked_return_children.push(naked_return_param)
                naked_return_children.push(naked_return_marker)
                naked_return_root: usize = ElisaProofKernelCore::add_node(&naked_return_nodes, "resource-safety", "", 0, 0, 0, 0, 2, 0, "naked-return", "resource-v1")
                naked_return_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&naked_return_nodes, &naked_return_children, [], naked_return_root)
                return 49 if naked_return_admitted

                forged_scalar_return_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                forged_scalar_return_children: mutable darray[usize] = []
                forged_scalar_return_param: usize = ElisaProofKernelCore::add_node(&forged_scalar_return_nodes, "resource-region-param", "external", 0, 0, 0, 0, 0, 0, "r", "")
                forged_scalar_return_owner: usize = ElisaProofKernelCore::add_node(&forged_scalar_return_nodes, "resource-bind", "external-shared", 0, 0, 0, 0, 0, 0, "owner", "r")
                forged_scalar_return_bind: usize = ElisaProofKernelCore::add_node(&forged_scalar_return_nodes, "resource-bind", "value", 0, 0, 0, 0, 0, 0, "scalar", "")
                forged_scalar_return_place: usize = ElisaProofKernelCore::add_node(&forged_scalar_return_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "scalar", "")
                forged_scalar_return_use: usize = ElisaProofKernelCore::add_node(&forged_scalar_return_nodes, "resource-use", "", forged_scalar_return_place, 0, 0, 0, 0, 0, "scalar", "")
                forged_scalar_return_marker: usize = ElisaProofKernelCore::add_node(&forged_scalar_return_nodes, "resource-region-return", "param", forged_scalar_return_use, 0, 0, 0, 0, 0, "r", "")
                forged_scalar_return_children.push(forged_scalar_return_param)
                forged_scalar_return_children.push(forged_scalar_return_owner)
                forged_scalar_return_children.push(forged_scalar_return_bind)
                forged_scalar_return_children.push(forged_scalar_return_use)
                forged_scalar_return_children.push(forged_scalar_return_marker)
                forged_scalar_return_root: usize = ElisaProofKernelCore::add_node(&forged_scalar_return_nodes, "resource-safety", "", 0, 0, 0, 0, 5, 0, "forged-scalar-return", "resource-v1")
                forged_scalar_return_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&forged_scalar_return_nodes, &forged_scalar_return_children, [], forged_scalar_return_root)
                return 50 if forged_scalar_return_admitted

                # A returned allocation cannot hide a region-owned operand behind a valid allocation and
                # return witness. The operand itself must be region-free; otherwise a shorter lifetime could
                # be smuggled into storage owned by the external region.
                nested_return_nodes: mutable darray[ElisaProofKernelCore::ProofKernelNode] = []
                nested_return_children: mutable darray[usize] = []
                nested_return_param: usize = ElisaProofKernelCore::add_node(&nested_return_nodes, "resource-region-param", "external", 0, 0, 0, 0, 0, 0, "r", "")
                nested_return_owner: usize = ElisaProofKernelCore::add_node(&nested_return_nodes, "resource-bind", "external-shared", 0, 0, 0, 0, 0, 0, "owner", "r")
                nested_return_owner_place: usize = ElisaProofKernelCore::add_node(&nested_return_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "owner", "")
                nested_return_alloc: usize = ElisaProofKernelCore::add_node(&nested_return_nodes, "resource-region-return-alloc", "", nested_return_owner_place, 0, 0, 0, 0, 0, "", "r")
                nested_return_marker: usize = ElisaProofKernelCore::add_node(&nested_return_nodes, "resource-region-return", "param", nested_return_alloc, 0, 0, 0, 0, 0, "r", "")
                nested_return_children.push(nested_return_param)
                nested_return_children.push(nested_return_owner)
                nested_return_children.push(nested_return_alloc)
                nested_return_children.push(nested_return_marker)
                nested_return_root: usize = ElisaProofKernelCore::add_node(&nested_return_nodes, "resource-safety", "", 0, 0, 0, 0, 4, 0, "nested-region-return", "resource-v1")
                nested_return_admitted: bool = ElisaProofKernelReplay::proof_kernel_replay_resource_report(&nested_return_nodes, &nested_return_children, [], nested_return_root)
                return 51 if nested_return_admitted

                return 0
