def boolean_parameter_counterexample(value: bool) -> bool:
    ensure not value
    return value

def boolean_equality_counterexample(value: bool) -> bool:
    ensure value == false
    return true

def ambiguous_boolean_equality(left: bool, right: bool) -> bool:
    ensure left == right
    return false

def ambiguous_character_equality(left: char, right: char) -> char:
    ensure left == right
    return left
