# A straight-line update followed by continue has a concrete symbolic state at the back edge.
# The decreases checker can therefore prove the same lexicographic step as for fallthrough.
def continue_decreases(n: i64) -> i64:
    requires n >= 0
    ensure result == 0
    value: mutable i64 = n
    while value > 0:
        invariant value >= 0
        decreases value
        value <- value - 1
        continue
    return value
