def quantified_premise_scalar(cursor: i64) -> i64:
    requires cursor >= 0 and cursor <= 8
    requires forall index in 0..<8: index >= 0
    ensure 0 <= cursor
    return cursor

def quantified_premise_increment(cursor: i64) -> i64:
    requires cursor >= 0 and cursor < 8
    requires forall index in 0..<8: index >= cursor or index >= 0
    ensure result <= 8
    return cursor + 1
