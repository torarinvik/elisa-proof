# A qualified call `Owner::name` uses that owner's summary when the bare name repeats in
# another module. A function declared after the repeated pair keeps its own purity row.
module Gate:
    public:
        def weight(on: bool, fade: i64) -> i64:
            requires fade >= 0
            requires fade <= 1000
            ensure result >= 0
            ensure on or result == 0
            return 0 if not on
            return fade

module Fade:
    public:
        def weight(frame: i64) -> i64:
            requires frame >= 1
            ensure result == frame + 1
            return frame + 1

        def apply(source: i64, amount: i64) -> i64:
            requires amount >= 0
            ensure amount != 0 or result == source
            return source if amount == 0
            return amount

module Uses:
    public:
        def off_is_identity(source: i64, fade: i64) -> i64:
            requires fade >= 0
            requires fade <= 1000
            ensure result == source
            w: i64 = Gate::weight(false, fade)
            return Fade::apply(source, w)

        def next_frame(frame: i64) -> i64:
            requires frame >= 1
            requires frame <= 100
            ensure result == frame + 1
            return Fade::weight(frame)
