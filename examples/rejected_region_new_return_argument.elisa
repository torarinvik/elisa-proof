# A region temporary cannot escape through a reference-returning callee. The call itself may be
# legal, but returning its region-owned result from this function is not.
def identity(value: i64&) -> i64&:
    return value

def rejected_region_new_return_argument() -> i64& can[Memory.Allocate, Abort.Panic]:
    region r(4096):
        return identity(new[r] 7)
