# The boundary of the equality step in the comparison chain. An equality is two non-strict steps,
# never a strict one, and it is the primitive integer equality only for witnessed scalars: on a
# struct `==` is a user `__eq__` under no order law at all.
struct Partial:
    tag: i64

# A struct equality is not an order step, and neither is the struct comparison beside it.
def struct_equality_is_not_an_order(p: Partial, q: Partial, r: Partial) -> i64:
    requires p <= q
    requires q == r
    ensure p <= r
    return 0

# An equality composed with a non-strict order is non-strict. It cannot discharge a strict goal.
def equality_alone_is_not_strict(a: usize, b: usize, c: usize) -> usize:
    requires a <= b
    requires b == c
    ensure result < c
    return a

# Two equalities are still non-strict.
def two_equalities_give_no_strict_goal(a: usize, b: usize, c: usize) -> usize:
    requires a == b
    requires b == c
    ensure result < c
    return a

# `!=` says nothing about the order and is not a step.
def inequality_is_not_a_step(a: usize, b: usize, c: usize) -> usize:
    requires a <= b
    requires b != c
    ensure result <= c
    return a

# The equality has to join the two ends through one middle term. Here it names the lower end
# itself, so the chain closes on nothing -- and the goal it is offered against is false.
def an_equality_to_the_wrong_term(items: darray[i64]&, other: darray[i64]&, index: usize) -> usize:
    requires index < items.count
    requires other.count == index
    ensure result < other.count
    return index
