# A rebind whose value is written over the binding's own symbol -- `rounds <- rounds + 1`, the shape
# every counter has -- could not be recorded: the equality `rounds == rounds + 1` is cyclic, so the
# new value was dropped and the facts about the old one were cleared with it. A loop invariant over
# a counter could therefore never be preserved, and a counter's value never survived its own update.
#
# The new value gets a fresh symbol instead. The old symbol then denotes the old value and nothing
# else, since the source name is bound to the fresh one, so every fact already taken stays true of
# the value it was taken over and the update is recorded as `<fresh> == <old> + 1`.
#
# That equality is only useful if the difference engine will import it, and it would not: an affine
# term `x + 1` is admitted into the constraint graph only when the bounds prove it cannot wrap, and
# a counter bounded by a symbolic limit has no numeric upper bound. The goal side already had the
# argument this needs -- `x < peer` with a peer of the same unsigned width puts `x + 1` in range --
# and the fact side now uses it too.

# The invariant establishes at entry and the body re-establishes it.
def bounded_counter(limit: usize) -> usize:
    rounds: mutable usize = 0
    while rounds < limit |rounds, limit|:
        invariant rounds <= limit
        rounds <- rounds + 1
    return rounds

# The same walk over a collection, where the index obligation is discharged by the counter's own
# bound chained through the precondition.
def walk_to_limit(items: darray[i64]&, limit: usize) -> i64:
    requires limit <= items.count
    total: mutable i64 = 0
    cursor: mutable usize = 0
    while cursor < limit |cursor, limit, items, total|:
        invariant cursor <= limit
        total <- total + items[cursor]
        cursor <- cursor + 1
    return total

# Straight-line: the counter's value survives its own update.
def increment_keeps_its_value(limit: usize) -> usize:
    requires limit >= 1
    ensure result <= limit
    rounds: mutable usize = 0
    rounds <- rounds + 1
    return rounds

# Two counters in one frame take two symbols, and neither reads the other's.
def two_counters(limit: usize) -> usize:
    requires limit >= 1
    ensure result <= limit
    left: mutable usize = 0
    right: mutable usize = 0
    left <- left + 1
    right <- right + 1
    return right
