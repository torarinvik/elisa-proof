# The restore across a call blocks the lends that outlive their own call together with the lends the
# call itself performs. Both halves have to hold, or a fact survives a call that falsified it.

def fill(values: mutable darray[usize]&) -> void:
    values.push(1)

def keeps_the_lend(values: darray[usize]&, sink: mutable darray[darray[usize]&]&) -> void:
    sink.push(values)

# The lend escapes, so the collection stays reachable by every later call and the range goes.
def an_escaping_lend_loses_the_range(sink: mutable darray[darray[usize]&]&, other: mutable darray[usize]&) -> usize:
    names: mutable darray[usize] = []
    fill(&names)
    keeps_the_lend(names, sink)
    total: mutable usize = 0
    for index in 0..<names.count |index, names, other, total|:
        fill(other)
        total <- total + names[index]
    return total

# The call in the body lends the very collection the range is over, so that call reaches it however
# confined the lend is: confinement is about outliving a call, not about the call itself.
def the_body_lends_the_collection() -> usize:
    names: mutable darray[usize] = []
    fill(&names)
    total: mutable usize = 0
    for index in 0..<names.count |index, names, total|:
        fill(&names)
        total <- total + names[index]
    return total

# A fact taken before a call that lends the binding does not survive that call.
def a_fact_before_the_lend() -> usize:
    ensure result == 0
    names: mutable darray[usize] = []
    fill(&names)
    return names.count
