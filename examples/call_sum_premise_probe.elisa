# A branch condition over a sum of two call results, `l + r >= 1000000`, is a premise whose
# arithmetic is in range only through the calls' own summaries. Generalizing each call result
# to a fresh name lets the range guard read those summaries, so the premise becomes usable.
def bounded_size(seed: i64) -> i64:
    ensure result >= 1
    ensure result <= 1000000
    return 1

def capped_pair(a: i64, b: i64) -> i64:
    ensure result >= 1
    ensure result <= 1000000
    l: i64 = bounded_size(a)
    r: i64 = bounded_size(b)
    return 1000000 if l + r >= 1000000
    return l + r + 1

def left_heavy(a: i64, b: i64) -> i64:
    ensure result >= 0
    l: i64 = bounded_size(a)
    r: i64 = bounded_size(b)
    return 0 if l + r < 3
    return l + r - 2

# The same guard over plain parameters: the early return leaves `not (x + y >= 1000000)`,
# which is `x + y < 1000000` for primitive scalars, so `x + y + 1 <= 1000000`.
def plain_capped(x: i64, y: i64) -> i64:
    requires x >= 1 and x <= 1000000 and y >= 1 and y <= 1000000
    ensure result <= 1000000
    return 1000000 if x + y >= 1000000
    return x + y + 1
