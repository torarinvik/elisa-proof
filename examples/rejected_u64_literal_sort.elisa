def rejected_unsigned_maximum_below_zero() -> u64:
    ensure 18446744073709551615u64 < 0u64
    return 0u64

def rejected_unsigned_high_bit_below_signed_maximum() -> u64:
    ensure 9223372036854775808u64 < 9223372036854775807u64
    return 0u64

def rejected_signed_negative_as_unsigned() -> i64:
    ensure -1i64 >= 0i64
    return 0i64
