# Direct scalar guards retain witnesses beside aggregate fields.
struct Store:
    buffer0: i64[4]
    buffer1: i64[4]
    buffer2: i64[4]
    buffer3: i64[4]
    buffer4: i64[4]
    buffer5: i64[4]
    buffer6: i64[4]
    buffer7: i64[4]
    used: usize
def checked(store: Store&, index: usize) -> bool:
    requires store.used <= 4
    return false if index >= store.used
    store.buffer0[index] == 0
