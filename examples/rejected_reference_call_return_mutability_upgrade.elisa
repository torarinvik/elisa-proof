# The callee returns a shared reference; a wrapper cannot hand it back as a mutable one.
def choose_first[@r](first: i64& @r, second: i64& @r) -> i64& @r:
    return first

def upgrade[@r](first: mutable i64& @r, second: mutable i64& @r) -> mutable i64& @r:
    return choose_first(second, first)

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    return 0
