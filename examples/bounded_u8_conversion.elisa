def bounded_row(value: i32) -> u8:
    requires value >= 0 and value < 8
    ensure result == value + 1
    ensure result <= 8
    return (value + 1).u8()

def rejected_row_bound(value: i32) -> u8:
    requires value >= 0 and value < 8
    ensure result <= 7
    return (value + 1).u8()

def rejected_source_overflow(value: i8) -> u8:
    requires value == 127
    ensure result == 128
    return (value + 1).u8()

def rejected_destination_overflow(value: i32) -> u8:
    requires value == 255
    ensure result == 256
    return (value + 1).u8()

def rejected_negative_conversion(value: i32) -> u8:
    requires value == -2
    ensure result == value + 1
    return (value + 1).u8()

def bounded_negated_peer(value: i32, limit: usize) -> u8:
    requires value >= 0 and value < 8
    requires not (value >= limit)
    ensure result <= limit
    return (value + 1).u8()

def rejected_nonstrict_peer(value: i32, limit: usize) -> u8:
    requires value >= 0 and value < 8
    requires value == limit
    ensure result <= limit
    return (value + 1).u8()
