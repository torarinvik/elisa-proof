# A `for` variable spelled like the module shadows it, so `Limits::TOP` is not imported.

const module Limits:
    const TOP: u8 = 10

def keep(x: u8) -> u8:
    requires x <= 20
    ensure result <= 20
    return x

def shadowed(x: u8) -> void:
    requires x <= 5
    for Limits in 0..<3:
        keep(x + Limits::TOP)
