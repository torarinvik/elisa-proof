# Diagnostic only: a minimal frame call, not the production byte traversal.
def prefix_probe_flag(rows: array[u8, 512]&) -> bool:
    changes rows
    return rows[0] == 0

def counted_prefix_framed_boolean_probe(rows: array[u8, 512]&, lengths: array[usize, 8]&, count: usize) -> u8:
    ensure result != 0 or (forall index in 0..<8: index >= count or lengths[index] == 64)
    return 9 if count > 8
    return 0 if count == 0
    row: mutable i64 = 0
    while row < 8 |row, rows, lengths, count|:
        invariant row >= 0 and row <= 8
        invariant forall index in 0..<8: index >= row or lengths[index] == 64
        decreases 8 - row
        return 0 if row >= count
        return (row + 1).u8() if lengths[row] != 64
        flag: bool = prefix_probe_flag(rows)
        return (row + 1).u8() if flag
        row <- row + 1
    return 0

# Same additional early-return path, but no call or frame transition.
def counted_prefix_framed_scalar_probe(rows: array[u8, 512]&, lengths: array[usize, 8]&, count: usize) -> u8:
    ensure result <= 9
    return 9 if count > 8
    return 0 if count == 0
    row: mutable i64 = 0
    while row < 8 |row, rows, lengths, count|:
        invariant row >= 0 and row <= 8
        invariant forall index in 0..<8: index >= row or lengths[index] == 64
        decreases 8 - row
        return 0 if row >= count
        return (row + 1).u8() if lengths[row] != 64
        flag: bool = prefix_probe_flag(rows)
        return (row + 1).u8() if flag
        row <- row + 1
    return 0

def counted_prefix_boolean_branch_probe(lengths: array[usize, 8]&, count: usize, flag: bool) -> u8:
    ensure result != 0 or (forall index in 0..<8: index >= count or lengths[index] == 64)
    return 9 if count > 8
    return 0 if count == 0
    row: mutable i64 = 0
    while row < 8 |row, lengths, count, flag|:
        invariant row >= 0 and row <= 8
        invariant forall index in 0..<8: index >= row or lengths[index] == 64
        decreases 8 - row
        return 0 if row >= count
        return (row + 1).u8() if lengths[row] != 64
        return (row + 1).u8() if flag
        row <- row + 1
    return 0
