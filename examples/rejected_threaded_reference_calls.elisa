# Calls that must not be read as value updates of their lent local, or whose threaded reading
# does not give the claimed value. Every ensure below stays unproven.

def bump(value: mutable usize&) -> void:
    requires value[0] < 1000
    ensure value[0] == old(value[0]) + 1
    value[0] <- value[0] + 1
    return

# The callee may alias its referent through an unchecked effect.
def bump_unsafe(value: mutable usize&) -> void can[Unsafe.Alias]:
    requires value[0] < 1000
    ensure value[0] == old(value[0]) + 1
    value[0] <- value[0] + 1
    return

def through_unsafe_callee() -> usize can[Unsafe.Alias]:
    ensure result == 6
    x: mutable usize = 5
    can Unsafe.Alias:
        bump_unsafe(&x)
    return x

# A reference local is not the referent's only name.
def through_reference_local() -> usize:
    ensure result == 6
    x: mutable usize = 5
    r: mutable usize& = &x
    bump(r)
    return x

# A lend into a region parameter may be stored past the call.
def keep[@r](value: mutable usize& @r) -> void:
    requires value[0] < 1000
    ensure value[0] == old(value[0]) + 1
    value[0] <- value[0] + 1
    return

def stored_borrow() -> usize:
    ensure result == 6
    x: mutable usize = 5
    keep(&x)
    return x

# The contract's claim is false of the value the local had before the call.
def stale_claim() -> usize:
    ensure result == 5
    x: mutable usize = 5
    bump(&x)
    return x

def stale_value_claim() -> usize:
    ensure result == 5
    x: mutable usize = 5
    x <- bump(x)
    return x

# One local lent to two exclusive parameters is not two independent values.
def bump_both(first: mutable usize&, second: mutable usize&) -> void:
    requires first[0] < 1000
    requires second[0] < 1000
    ensure first[0] == old(first[0]) + 1
    ensure second[0] == old(second[0]) + 1
    first[0] <- first[0] + 1
    second[0] <- second[0] + 1
    return

def aliased_local() -> usize can[Unsafe.Alias]:
    ensure result == 6
    x: mutable usize = 5
    can Unsafe.Alias:
        bump_both(&x, &x)
    return x
