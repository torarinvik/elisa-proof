# A value-producing match may not hide an effectful call. The runtime expression gate must
# reject the arm even though the call is syntactically a valid value.
def rejected_value_match_impure_call_leaf(value: mutable i64) -> i64:
    value <- value + 1
    return value

def rejected_value_match_impure_call(x: i64) -> i64:
    return match x:
        0:
            rejected_value_match_impure_call_leaf(x)
        _:
            7
