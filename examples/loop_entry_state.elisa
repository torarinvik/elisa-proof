# A loop body is checked once, for an arbitrary iteration. At its entry every binding the body may
# rewrite is an opaque symbol: its value before the loop is its value on the first iteration only.
# What the body may rely on is what holds on every iteration -- the loop condition, the
# invariants the loop established, and the bindings the body leaves alone.

def small(x: i64) -> i64:
    requires x <= 100
    ensure result == x
    return x

# `limit` is never written by the body, so the precondition on it is still known inside.
def unwritten_binding_keeps_its_fact(count: i64, limit: i64) -> i64:
    requires limit <= 100
    total: mutable i64 = 0
    step: mutable i64 = 0
    while step < count |step, total, count, limit|:
        total <- total + small(limit)
        step <- step + 1
    return total

# The condition holds at every iteration's entry, over the opaque state, so an index against the
# bound it tests still discharges.
def condition_bounds_the_body(values: darray[i64]&) -> i64:
    total: mutable i64 = 0
    index: mutable usize = 0
    while index < values.count |index, total, values|:
        total <- total + values[index]
        index <- index + 1
    return total

# A sound invariant is established from the entry state and preserved on the opaque iteration:
# `step + 1 <= count` from `step <= count` and `step < count`, with no entry value in sight. The
# invariant also bounds `step` so the increment is known not to overflow. (The post-loop state
# of a captured loop is still the block's havoc, so nothing is claimed after it here.)
def sound_invariant_is_preserved(count: i64) -> i64:
    requires count >= 0 and count <= 1000
    step: mutable i64 = 0
    while step < count |step, count|:
        invariant step <= count and step <= 1000
        step <- step + 1
    return step

# A `for` binder is the body's own, so its range is known inside even though the accumulator
# beside it is opaque.
def binder_range_survives(values: darray[i64]&) -> i64:
    total: mutable i64 = 0
    for index in 0..<values.count |index, total, values|:
        total <- total + values[index]
    return total
