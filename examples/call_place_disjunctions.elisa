# A callee summary over its call result, `result - origin <= cap or ...`, reaches the caller
# as disjunctive facts over the call term. Generalizing the call before the first split lets
# the linear pruning read them, so a zero cap freezes the step and a close goal is reached.
module Step:
    public:
        def limit_step(origin: i64, goal: i64, cap: i64) -> i64:
            requires origin >= -1000000000
            requires origin <= 1000000000
            requires goal >= -1000000000
            requires goal <= 1000000000
            requires cap >= 0
            requires cap <= 1000000000
            ensure result - origin <= cap
            ensure origin - result <= cap
            ensure goal - origin > cap or origin - goal > cap or result == goal
            ensure origin > goal or result >= origin
            ensure origin > goal or result <= goal
            ensure origin < goal or result <= origin
            ensure origin < goal or result >= goal
            return origin + cap if goal - origin > cap
            return origin - cap if origin - goal > cap
            return goal

module Uses:
    public:
        def zero_cap_freezes(origin: i64, goal: i64) -> i64:
            requires origin >= -1000000000
            requires origin <= 1000000000
            requires goal >= -1000000000
            requires goal <= 1000000000
            ensure result == origin
            return Step::limit_step(origin, goal, 0)

        def close_goal_is_reached(origin: i64, goal: i64, cap: i64) -> i64:
            requires origin >= -1000000000
            requires origin <= 1000000000
            requires goal >= origin
            requires goal <= 1000000000
            requires cap >= 0
            requires goal - origin <= cap
            requires cap <= 1000000000
            ensure result == goal
            return Step::limit_step(origin, goal, cap)
