# A module alias call keeps the exact target module's declared scalar width even when a peer
# module declares the same function name with a different return type.
module Narrow:
    public:
        def cap() -> u32:
            ensure result >= 0
            ensure result <= 255
            return 5

module Wide:
    public:
        def cap(value: bool) -> i64:
            ensure result >= 0
            return 1000

module Client:
    using Narrow as N
    public:
        def alias_call_is_u32() -> bool:
            ensure result
            N::cap() <= 255

        def cap() -> u32:
            ensure result >= 0
            ensure result <= 255
            return 7

        def local_call_is_u32() -> bool:
            ensure result
            cap() <= 255
