# `raise` is call-shaped in the compiler AST but terminates the exceptional path. A get/try
# recovery may therefore raise after the compiler has checked the declared error family.
error GetElseError:
    Failed


def fallible_value(fail: bool) -> i64 error[GetElseError]:
    ensure result == 5
    if fail:
        raise GetElseError.Failed
    return 5


def getelse_raise(fail: bool) -> i64 error[GetElseError]:
    ensure result == 5
    return try fallible_value(fail) else raise GetElseError.Failed

