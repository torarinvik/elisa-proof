# Scope-qualified integer constants are exact terms whose literal pins may
# distinguish branch tags and returned action codes.
module TimerEffects:
    public:
        const DUE_NOT_YET: u8 = 0
        const DUE_TIMEOUT: u8 = 1
        const DUE_INTERVAL: u8 = 2
        const DUE_INVALID: u8 = 3
        const DUE_TIME_EXHAUSTED: u8 = 4

        const EFFECT_SKIP: u8 = 0
        const EFFECT_REMOVE_AND_DISPATCH: u8 = 1
        const EFFECT_RESCHEDULE_AND_DISPATCH: u8 = 2
        const EFFECT_MONOTONIC_TIME_ERROR: u8 = 3
        const EFFECT_POLICY_ERROR: u8 = 4

        def timer_due_effect(status: u8) -> u8:
            ensure result <= TimerEffects::EFFECT_POLICY_ERROR
            ensure status != TimerEffects::DUE_NOT_YET or result == TimerEffects::EFFECT_SKIP
            ensure status != TimerEffects::DUE_TIMEOUT or result == TimerEffects::EFFECT_REMOVE_AND_DISPATCH
            ensure status != TimerEffects::DUE_INTERVAL or result == TimerEffects::EFFECT_RESCHEDULE_AND_DISPATCH
            ensure status != TimerEffects::DUE_TIME_EXHAUSTED or result == TimerEffects::EFFECT_MONOTONIC_TIME_ERROR
            ensure status != TimerEffects::DUE_INVALID and status <= TimerEffects::DUE_TIME_EXHAUSTED or result == TimerEffects::EFFECT_POLICY_ERROR
            if status == TimerEffects::DUE_NOT_YET:
                return TimerEffects::EFFECT_SKIP
            if status == TimerEffects::DUE_TIMEOUT:
                return TimerEffects::EFFECT_REMOVE_AND_DISPATCH
            if status == TimerEffects::DUE_INTERVAL:
                return TimerEffects::EFFECT_RESCHEDULE_AND_DISPATCH
            if status == TimerEffects::DUE_TIME_EXHAUSTED:
                return TimerEffects::EFFECT_MONOTONIC_TIME_ERROR
            return TimerEffects::EFFECT_POLICY_ERROR
