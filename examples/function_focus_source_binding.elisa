# A focused query must bind its selected postcondition while ignoring unrelated unsupported
# source shapes that are explicitly outside the query's verification closure.
def focused_source_binding_target() -> i64:
    ensure result == 7
    return 7

# A declared parameter return must be substituted into the source-bound goal. The requires
# clause discharges that goal; focused and whole-source admission must agree on its identity.
def focused_source_binding_parameter_target(value: i64) -> i64:
    requires value == 7
    ensure result == 7
    return value

# Two postconditions are outside the current independent literal inventory slice.
def focused_source_binding_unrequested() -> i64:
    ensure true
    ensure true
    return 5
