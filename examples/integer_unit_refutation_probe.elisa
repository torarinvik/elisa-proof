# Six forced steps still spend no case-split depth. Exact literal refutation and
# positive equality transport need not find an identical complementary premise.
def integer_unit_closed(accepted: bool) -> bool:
    requires 4 <= 3 or accepted
    ensure result
    return accepted

def integer_unit_known_or_prefix(a: u8, b: u8, accepted: bool) -> bool:
    requires a > 1 or b == 0
    ensure result
    return a > 1 or b == 0 or accepted

def integer_unit_chain(a: u8, b: u8, c: u8, d: u8, e: u8, f: u8, accepted: bool) -> bool:
    requires a == 4
    requires a <= 3 or b == 4
    requires b <= 3 or c == 4
    requires c <= 3 or d == 4
    requires d <= 3 or e == 4
    requires e <= 3 or f == 4
    requires f <= 3 or accepted
    ensure result
    return accepted

def integer_unit_alias(saved: u8, classified: u8, accepted: bool) -> bool:
    requires saved == 4
    requires classified == saved
    requires classified <= 3 or accepted
    ensure result
    return accepted

def integer_unit_alias_disequality(saved: u8, classified: u8, accepted: bool) -> bool:
    requires saved != 0
    requires classified == saved
    requires classified == 0 or accepted
    ensure result
    return accepted

def integer_unit_parenthesized_alias(saved: u8, classified: u8, accepted: bool) -> bool:
    requires saved != 0
    requires (classified == saved)
    requires classified == 0 or accepted
    ensure result
    return accepted

def integer_unit_range(code: u8, accepted: bool) -> bool:
    requires code >= 1
    requires code <= 3
    requires code == 0 or accepted
    ensure result
    return accepted

def integer_unit_signed(code: i8, accepted: bool) -> bool:
    requires code == 4
    requires code <= 3 or accepted
    ensure result
    return accepted

struct IntegerUnitRecord:
    code: u8

def integer_unit_field(record: IntegerUnitRecord&, accepted: bool) -> bool:
    requires record.code == 4
    requires record.code <= 3 or accepted
    ensure result
    return accepted
