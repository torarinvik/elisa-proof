# A shared borrow's extent is fixed for the borrow's lifetime: nothing may write through it, and
# the compiler's borrow rule means no mutable path to the same object coexists with it. So a loop
# body cannot change `name.count` for a parameter bound by one, whatever else it does -- and the
# guard that related an index range to that count still holds on every iteration.
#
# Before this rule, lending the collection to any callee anywhere in the frame put its name in the
# frame's aliasing set, and loop entry then resymbolized it: the guard and the summary implied by
# it were purged, and the loop's own index obligation went unproven for the rest of the body.

def range_valid(start: usize, count: usize, total: usize) -> bool:
    ensure not result or start <= total and count <= total - start
    return false if start > total
    return false if count > total - start
    return true

def reads(values: darray[usize]&) -> usize:
    return 0

# The collection is lent to a callee before the loop, so its name is in the frame's aliasing set.
# The loop still knows its extent.
def a_shared_borrow_keeps_its_extent(start: usize, count: usize, children: darray[usize]&) -> usize:
    return 0 if not range_valid(start, count, children.count)
    ignored: usize = reads(children)
    total: mutable usize = 0
    for index in 0..<count |index, start, children, total|:
        total <- total + children[start + index]
    return total + ignored

# The same when the call comes after the loop: the aliasing set is collected for the whole frame,
# so a later lend used to reach backwards into an earlier loop.
def a_later_lend_does_not_reach_backwards(start: usize, count: usize, children: darray[usize]&) -> usize:
    return 0 if not range_valid(start, count, children.count)
    total: mutable usize = 0
    for index in 0..<count |index, start, children, total|:
        total <- total + children[start + index]
    return total + reads(children)

# The lend inside the loop body is the same claim from the strongest side: the body hands control
# to a callee on every iteration, and the callee holds the borrow while it runs. A shared borrow
# still cannot be resized, so the guard survives the iteration.
def a_lend_inside_the_loop(start: usize, count: usize, children: darray[usize]&) -> usize:
    return 0 if not range_valid(start, count, children.count)
    total: mutable usize = 0
    for index in 0..<count |index, start, children, total|:
        total <- total + children[start + index] + reads(children)
    return total
