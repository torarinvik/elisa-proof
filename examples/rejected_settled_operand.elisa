# The short-circuit fold must fire only when the left operand decides the whole expression.
# `false or X` and `true and X` both still owe X, an unsettled left operand settles nothing,
# and a settled operand says nothing about a sibling conjunct beside it.

def or_left_false_still_owes_the_right(start: usize, total: usize) -> bool:
    ensure result or start <= total
    return false

def and_left_true_still_owes_the_right(start: usize, total: usize) -> bool:
    ensure not result and start <= total
    return false

def a_settled_operand_does_not_settle_a_sibling(start: usize, count: usize, total: usize) -> bool:
    ensure (not result or count <= total - start) and start <= total
    return false

def an_unsettled_left_keeps_the_gate(flag: bool, start: usize, count: usize, total: usize) -> bool:
    ensure flag or count <= total - start
    return false
