def prefix_progress(base: u64, step: u64) -> u64:
    requires base < 4
    requires step > 0
    requires step <= 4 - base
    ensure result > base
    ensure 4 - result < 4 - base
    return base + step

def byte_progress(base: u8, step: u8) -> u8:
    requires base < 255
    requires step > 0
    requires step <= 255 - base
    ensure base < result
    ensure 255 - result < 255 - base
    return step + base

def named_cap_progress(base: u64, step: u64, cap: u64) -> u64:
    requires base < cap
    requires 0 < step
    requires step <= cap - base
    ensure result > base
    ensure cap - result < cap - base
    return base + step
