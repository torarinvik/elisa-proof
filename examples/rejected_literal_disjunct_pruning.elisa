# Controls: pruning removes only literally decided alternatives. Distinct arguments or an unknown
# flag keep the case split, and the false claims below stay unproved.
module Ramp:
    public:
        def weight(frame: i64, last: i64, looping: bool) -> i64:
            requires last >= 0
            requires last <= 1000
            requires frame >= 0
            requires frame <= last
            ensure result >= 0
            ensure result <= 1000
            ensure looping or frame != last or result == 0
            ensure not looping or result == 1000
            return 1000 if looping
            return 0 if frame == last
            return 500

module Laws:
    public:
        def distinct_frames(frame: i64, last: i64) -> i64:
            requires last >= 0
            requires last <= 1000
            requires frame >= 0
            requires frame <= last
            ensure result == 0
            return Ramp::weight(frame, last, false)

        def unknown_flag(last: i64, looping: bool) -> i64:
            requires last >= 0
            requires last <= 1000
            ensure result == 0
            return Ramp::weight(last, last, looping)

        def wrong_value(last: i64) -> i64:
            requires last >= 0
            requires last <= 1000
            ensure result == 1000
            return Ramp::weight(last, last, false)
