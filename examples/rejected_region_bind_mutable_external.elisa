# An external mutable region reference has no owner token to transfer. Copying it into another
# mutable region alias would create two independently writable capabilities for one place.
def rejected_region_bind_mutable_external[@r](source: mutable i64& @r) -> i64:
    alias: mutable i64& @r = source
    source <- 1
    alias <- 2
    return 0

def main() -> i64:
    return 0
