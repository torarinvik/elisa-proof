# A mutually recursive pair can use the same well-founded integer ranking.

def mutual_even(n: i64) -> i64:
    requires n >= 0
    decreases n
    ensure result == 0
    if n > 0:
        return mutual_odd(n - 1)
    return 0

def mutual_odd(n: i64) -> i64:
    requires n >= 0
    decreases n
    ensure result == 0
    if n > 0:
        return mutual_even(n - 1)
    return 0

def external_recursive_caller(n: i64) -> i64:
    requires n >= 0
    ensure result == 0
    return mutual_even(n)
