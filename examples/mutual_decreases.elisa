# A mutually recursive pair can use the same well-founded integer ranking. The pinned compiler
# admits a cycle only when each measure is required positive and every edge passes `measure - 1`.

def mutual_even(n: i64) -> i64:
    requires n > 0
    decreases n
    ensure result == 0
    if n > 1:
        return mutual_odd(n - 1)
    return 0

def mutual_odd(n: i64) -> i64:
    requires n > 0
    decreases n
    ensure result == 0
    if n > 1:
        return mutual_even(n - 1)
    return 0

def external_recursive_caller(n: i64) -> i64:
    requires n > 0
    ensure result == 0
    return mutual_even(n)
