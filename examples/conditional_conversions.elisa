# An integer conversion reads its receiver and nothing else, so it may sit in an arm of an
# if-expression that does not always evaluate it.
module ConditionalConversions:
    def clamp_digit(b: u8, limit: u64) -> u64:
        requires limit <= 100
        ensure result <= limit
        digit: u64 = b.u64() if b >= 48 else 0
        digit if digit <= limit else limit

    def digit_value(b: u8) -> u64:
        ensure result <= 9
        byte: u64 = b.u64()
        byte - 48 if byte >= 48 and byte <= 57 else 0

    # A widening conversion keeps its receiver's value, so the arm is bounded by the u8 range.
    def widened_bound(b: u8) -> u64:
        ensure result <= 255
        b.u64() if b >= 48 else 0
