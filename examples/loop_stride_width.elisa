def loop_stride(rows: array[u8, 512]&) -> void:
    for row in 0..<8 |row, rows|:
        for offset in 0..<64 |offset, row, rows|:
            invariant row >= 0 and row < 8
            value: u8 = rows[row * 64 + offset]

def rejected_loop_stride(rows: array[u8, 511]&) -> void:
    for row in 0..<8 |row, rows|:
        for offset in 0..<64 |offset, row, rows|:
            invariant row >= 0 and row < 8
            value: u8 = rows[row * 64 + offset]

def rejected_shadowed_stride(rows: array[u8, 512]&) -> void:
    for row in 0..<8 |row, rows|:
        for row in 0..<9 |row, rows|:
            value: u8 = rows[row * 64]

def rejected_loop_machine_overflow(rows: array[u8, 512]&) -> void:
    for row in 0..<8 |row, rows|:
        value: u8 = rows[row * 2147483647]
