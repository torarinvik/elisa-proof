# A fourth-level path still aliases exactly when it names the borrowed place itself.
struct AliasLeaf:
    value: mutable i64

struct AliasC:
    leaf: mutable AliasLeaf

struct AliasB:
    child: mutable AliasC

struct AliasA:
    branch: mutable AliasB

def rejected_borrow_four_nested_alias(root: mutable AliasA) -> i64:
    value_view: i64& = &root.branch.child.leaf.value
    root.branch.child.leaf.value <- 1
    return root.branch.child.leaf.value
