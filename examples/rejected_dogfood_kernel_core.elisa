# Soundness regression: a valid range must not be accepted as invalid.
include "../src/proof/kernel_core.elisa"
using ElisaProofKernelCore

def overclaims_invalid_range(start: usize, count: usize, total: usize) -> bool:
    requires start <= total and count <= total - start
    ensure result == false
    return range_valid(start, count, total)
