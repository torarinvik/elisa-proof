# The boundary. Propagation carries a bound that already follows; it invents none, and it does not
# make the overflow guard optional.
#
# A `usize` has no representable ceiling in this proof AST -- the widest interval it can hold is
# the signed maximum -- so an unsigned increment with no constant bound anywhere in reach stays
# refused. That is the documented limit of the numeric domain, not an oversight, and it is why the
# kernel's own `index + 1 <= names.count` is still open.
def unsigned_increment_without_a_bound(count: usize, index: usize) -> usize:
    requires index < count
    ensure result <= count
    return index + 1

# A lower bound on the far name carries nothing upward.
def lower_bound_does_not_bound_above(count: i64, index: i64) -> i64:
    requires index < count
    requires count >= 0
    ensure result <= count
    return index + 1

# The comparison is not strict, so the shifted claim is false at `index == count`.
def non_strict_premise_is_not_shiftable(count: i64, index: i64) -> i64:
    requires index <= count
    requires count <= 1000
    requires index >= 0
    ensure result <= count
    return index + 1

# The bound reaches the wrong name: nothing bounds `index` from above.
def bound_on_an_unrelated_name(count: i64, index: i64, other: i64) -> i64:
    requires index < count
    requires other <= 1000
    requires index >= 0
    ensure result <= count
    return index + 1
