# The boundary. Propagation carries a bound that already follows; it invents none, and it does not
# make the overflow guard optional.
#
# The unsigned increment is admitted from a strict peer of the same width, and only that. A step of
# two needs `index + 2 <= count`, which no strict peer gives.
def unsigned_step_of_two(count: usize, index: usize) -> usize:
    requires index < count
    ensure result <= count
    return index + 2

# A non-strict peer leaves `index == count`, where the claim is false.
def unsigned_increment_under_a_non_strict_peer(count: usize, index: usize) -> usize:
    requires index <= count
    ensure result <= count
    return index + 1

# The peer bounds a different name.
def unsigned_peer_of_another_name(count: usize, index: usize, other: usize) -> usize:
    requires other < count
    ensure result <= count
    return index + 1

# A lower bound on the far name carries nothing upward.
def lower_bound_does_not_bound_above(count: i64, index: i64) -> i64:
    requires index < count
    requires count >= 0
    ensure result <= count
    return index + 1

# The comparison is not strict, so the shifted claim is false at `index == count`.
def non_strict_premise_is_not_shiftable(count: i64, index: i64) -> i64:
    requires index <= count
    requires count <= 1000
    requires index >= 0
    ensure result <= count
    return index + 1

# The bound reaches the wrong name: nothing bounds `index` from above.
def bound_on_an_unrelated_name(count: i64, index: i64, other: i64) -> i64:
    requires index < count
    requires other <= 1000
    requires index >= 0
    ensure result <= count
    return index + 1
