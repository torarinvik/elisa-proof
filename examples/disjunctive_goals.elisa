# A disjunctive goal holds when either disjunct does, and otherwise when the right disjunct
# follows from the left one's negation: `A or B` is `not A => B`. An ensure of the shape
# `not result or bound` states what a true result implies, and a result built as
# `bound and more` establishes it only through that negated premise.
module Pool:
    public:
        const CAPACITY: usize = 4

        struct Table:
            live: bool[Pool::CAPACITY]

        # A true result means the slot is in range, so a caller may index with it.
        def live(table: Table&, slot: usize) -> bool:
            ensure not result or slot < CAPACITY
            slot < CAPACITY and table.live[slot]

        def implied(a: bool, b: bool) -> bool:
            ensure not result or a
            a and b

        def implied_bound(x: i64, y: i64) -> bool:
            ensure not result or x < 10
            x < 5 and y > 0

        # The caller reads the bound back out of the summary to index the same slot.
        def live_then_read(table: Table&, slot: usize) -> bool:
            return false if not live(table, slot)
            table.live[slot]

        # Each negated left disjunct opens one case. Four nested links fit the case-split
        # budget; a fifth is refused in `rejected_budget.elisa`.
        def chained_order(a: i64, b: i64, c: i64, d: i64, e: i64) -> i64:
            ensure not (a < b) or (not (b < c) or (not (c < d) or (not (d < e) or a < e)))
            return 0
