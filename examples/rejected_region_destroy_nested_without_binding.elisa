# Destroying an inherited region and reopening the same spelling in a nested control-flow
# scope must not make the parent's old region appear live after the snapshot is joined back.
# There is no binding here deliberately: region identity itself must be preserved, not only
# binding metadata.
def rejected_region_destroy_nested_without_binding() -> i64 can[Memory.Allocate, Abort.Panic]:
    region r(4096)
    if true:
        destroy r
        region r(4096):
            new[r] 1
    new[r] 2
    return 0

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    return rejected_region_destroy_nested_without_binding()
