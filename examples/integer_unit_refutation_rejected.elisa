def integer_unit_missing_link(saved: u8, classified: u8, accepted: bool) -> bool:
    requires saved == 4
    requires classified <= 3 or accepted
    ensure result
    return accepted

def integer_unit_boundary(code: u8, accepted: bool) -> bool:
    requires code == 3
    requires code <= 3 or accepted
    ensure result
    return accepted

def integer_unit_float(code: f64, accepted: bool) -> bool:
    requires code > 0
    requires code < 1 or accepted
    ensure result
    return accepted

def integer_unit_wrap(code: u8, next: u8, accepted: bool) -> bool:
    requires code == 255
    requires next == code + 1
    requires next == 0 or accepted
    ensure result
    return accepted

def integer_unit_closed_true(accepted: bool) -> bool:
    requires 3 <= 3 or accepted
    ensure result
    return accepted

def integer_unit_wrong_or_prefix(a: u8, b: u8, accepted: bool) -> bool:
    requires a > 1 or b == 0
    ensure result
    return a > 1 or b != 0 or accepted
