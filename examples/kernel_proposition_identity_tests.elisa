# Typed proposition admission for lexical identities, named containers, and enum members.
# These cases share the declaration-identity boundary and stay separate from the integration
# driver so each fixture file has one responsibility.

def named_container_identity_tests() -> i64 can[Memory.Allocate, Abort.Panic]:
    named_container_nodes: mutable darray[ProofKernelNode] = []
    named_container_children: mutable darray[usize] = []
    token_values: usize = add_node(&named_container_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "token_values", "")
    same_token_values: usize = add_node(&named_container_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "same_token_values", "")
    other_values: usize = add_node(&named_container_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "other_values", "")
    element_zero: usize = add_node(&named_container_nodes, "int", "", 0, 0, 0, 0, 0, 0, "", "")
    token_item: usize = add_node(&named_container_nodes, "index", "", token_values, element_zero, 0, 0, 0, 0, "", "")
    same_token_item: usize = add_node(&named_container_nodes, "index", "", same_token_values, element_zero, 0, 0, 0, 0, "", "")
    other_item: usize = add_node(&named_container_nodes, "index", "", other_values, element_zero, 0, 0, 0, 0, "", "")
    same_named_element: usize = add_node(&named_container_nodes, "binary", "==", token_item, same_token_item, 0, 0, 0, 0, "", "")
    different_named_element: usize = add_node(&named_container_nodes, "binary", "==", token_item, other_item, 0, 0, 0, 0, "", "")
    named_container_bindings: mutable darray[ProofKernelTypingBinding] = []
    token_type_added: bool = proof_kernel_add_typing_binding_with_identity(&named_container_bindings, "type", "Token", "", "named", "Token", "", "", 901, 0, 0)
    distinct_type_added: bool = proof_kernel_add_typing_binding_with_identity(&named_container_bindings, "type", "Other", "", "named", "Other", "", "", 902, 0, 0)
    token_values_added: bool = proof_kernel_add_typing_binding_with_identity(&named_container_bindings, "value", "token_values", "", "container", "darray", "named", "Token", 0, 0, 901)
    same_token_values_added: bool = proof_kernel_add_typing_binding_with_identity(&named_container_bindings, "value", "same_token_values", "", "container", "darray", "named", "Token", 0, 0, 901)
    other_values_added: bool = proof_kernel_add_typing_binding_with_identity(&named_container_bindings, "value", "other_values", "", "container", "darray", "named", "Other", 0, 0, 902)
    return 1 if not token_type_added or not distinct_type_added or not token_values_added or not same_token_values_added or not other_values_added
    named_container_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: named_container_bindings}
    return 2 if not proof_kernel_replay_proposition_formation_report(&named_container_nodes, &named_container_children, named_container_environment, [], same_named_element)
    return 3 if proof_kernel_replay_proposition_formation_report(&named_container_nodes, &named_container_children, named_container_environment, [], different_named_element)
    missing_named_element_identity: mutable darray[ProofKernelTypingBinding] = []
    missing_named_element_added: bool = proof_kernel_add_typing_binding_with_identity(&missing_named_element_identity, "value", "token_values", "", "container", "darray", "named", "Token", 0, 0, 0)
    return 4 if not missing_named_element_added
    missing_named_element_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: missing_named_element_identity}
    return 5 if proof_kernel_replay_proposition_formation_report(&named_container_nodes, &named_container_children, missing_named_element_environment, [], same_named_element)
    return 0

def enum_member_proposition_tests() -> i64 can[Memory.Allocate, Abort.Panic]:
    # A bare enum shorthand is typed only when exactly one declared const-enum member supplies
    # its owner type; missing or ambiguous members are not accepted as propositions or values.
    enum_bindings: mutable darray[ProofKernelTypingBinding] = []
    mode_value_added: bool = proof_kernel_add_typing_binding_with_identity(&enum_bindings, "value", "mode", "", "named", "Mode", "", "", 701, 0, 0)
    on_member_added: bool = proof_kernel_add_typing_binding_with_identity(&enum_bindings, "enum-member", "On", "Mode", "named", "Mode", "", "", 701, 701, 0)
    return 61 if not mode_value_added or not on_member_added
    enum_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: enum_bindings}
    enum_nodes: mutable darray[ProofKernelNode] = []
    enum_children: mutable darray[usize] = []
    mode_root: usize = add_node(&enum_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "mode", "")
    on_root: usize = add_node(&enum_nodes, "shorthand", "", 0, 0, 0, 0, 0, 0, "On", "")
    enum_equality: usize = add_node(&enum_nodes, "binary", "==", mode_root, on_root, 0, 0, 0, 0, "", "")
    return 62 if not proof_kernel_replay_proposition_formation_report(&enum_nodes, &enum_children, enum_environment, [], enum_equality)
    missing_enum_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: [enum_bindings[0]]}
    return 63 if proof_kernel_replay_proposition_formation_report(&enum_nodes, &enum_children, missing_enum_environment, [], enum_equality)
    return 0

def enum_variant_proposition_tests() -> i64 can[Memory.Allocate, Abort.Panic]:
    # Variant tests require a declared tag of the receiver's exact enum type, including the
    # alternate field spelling accepted by Elisa's AST.
    variant_test_bindings: mutable darray[ProofKernelTypingBinding] = []
    option_value_added: bool = proof_kernel_add_typing_binding_with_identity(&variant_test_bindings, "value", "option", "", "named", "Option", "", "", 101, 0, 0)
    option_type_added: bool = proof_kernel_add_typing_binding_with_identity(&variant_test_bindings, "type", "Option", "", "named", "Option", "", "", 101, 0, 0)
    option_scope_added: bool = proof_kernel_add_typing_binding_with_metadata(&variant_test_bindings, "enum-scope-segment", "Option", "Option", "named", "Option", "", "", 101, 101, 0, 0, 0, 1)
    other_type_added: bool = proof_kernel_add_typing_binding_with_identity(&variant_test_bindings, "type", "Other", "", "named", "Other", "", "", 102, 0, 0)
    other_scope_added: bool = proof_kernel_add_typing_binding_with_metadata(&variant_test_bindings, "enum-scope-segment", "Other", "Other", "named", "Other", "", "", 102, 102, 0, 0, 0, 1)
    option_tag_added: bool = proof_kernel_add_typing_binding_with_identity(&variant_test_bindings, "enum-tag", "Some", "Option", "named", "Option", "", "", 101, 101, 0)
    other_tag_added: bool = proof_kernel_add_typing_binding_with_identity(&variant_test_bindings, "enum-tag", "Some", "Other", "named", "Other", "", "", 102, 102, 0)
    other_payload_tag_added: bool = proof_kernel_add_typing_binding_with_identity(&variant_test_bindings, "enum-tag", "PayloadOnly", "Other", "named", "Other", "", "", 102, 102, 0)
    option_member_added: bool = proof_kernel_add_typing_binding_with_identity(&variant_test_bindings, "enum-member", "Some", "Option", "named", "Option", "", "", 101, 101, 0)
    return 69 if not option_value_added or not option_type_added or not other_type_added or not option_scope_added or not other_scope_added or not option_tag_added or not other_tag_added or not other_payload_tag_added or not option_member_added
    variant_test_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: variant_test_bindings}
    variant_test_nodes: mutable darray[ProofKernelNode] = []
    variant_test_children: mutable darray[usize] = []
    option_value_root: usize = add_node(&variant_test_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "option", "")
    option_type_root: usize = add_node(&variant_test_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "Option", "")
    option_some_tag: usize = add_node(&variant_test_nodes, "scope", "", option_type_root, 0, 0, 0, 0, 0, "Some", "")
    valid_variant_test: usize = add_node(&variant_test_nodes, "binary", "is", option_value_root, option_some_tag, 0, 0, 0, 0, "", "")
    return 70 if not proof_kernel_replay_proposition_formation_report(&variant_test_nodes, &variant_test_children, variant_test_environment, [], valid_variant_test)
    valid_qualified_member_equality: usize = add_node(&variant_test_nodes, "binary", "==", option_value_root, option_some_tag, 0, 0, 0, 0, "", "")
    return 82 if not proof_kernel_replay_proposition_formation_report(&variant_test_nodes, &variant_test_children, variant_test_environment, [], valid_qualified_member_equality)
    option_some_field: usize = add_node(&variant_test_nodes, "field", "", option_type_root, 0, 0, 0, 0, 0, "Some", "")
    valid_field_variant_test: usize = add_node(&variant_test_nodes, "binary", "is", option_value_root, option_some_field, 0, 0, 0, 0, "", "")
    return 77 if not proof_kernel_replay_proposition_formation_report(&variant_test_nodes, &variant_test_children, variant_test_environment, [], valid_field_variant_test)
    some_shorthand: usize = add_node(&variant_test_nodes, "shorthand", "", 0, 0, 0, 0, 0, 0, "Some", "")
    valid_payload_shorthand_test: usize = add_node(&variant_test_nodes, "binary", "is", option_value_root, some_shorthand, 0, 0, 0, 0, "", "")
    return 79 if not proof_kernel_replay_proposition_formation_report(&variant_test_nodes, &variant_test_children, variant_test_environment, [], valid_payload_shorthand_test)
    other_payload_shorthand: usize = add_node(&variant_test_nodes, "shorthand", "", 0, 0, 0, 0, 0, 0, "PayloadOnly", "")
    wrong_payload_shorthand_test: usize = add_node(&variant_test_nodes, "binary", "is", option_value_root, other_payload_shorthand, 0, 0, 0, 0, "", "")
    return 80 if proof_kernel_replay_proposition_formation_report(&variant_test_nodes, &variant_test_children, variant_test_environment, [], wrong_payload_shorthand_test)
    wrong_module_root: usize = add_node(&variant_test_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "Wrong", "")
    wrong_module_enum: usize = add_node(&variant_test_nodes, "scope", "", wrong_module_root, 0, 0, 0, 0, 0, "Option", "")
    wrong_module_some: usize = add_node(&variant_test_nodes, "scope", "", wrong_module_enum, 0, 0, 0, 0, 0, "Some", "")
    wrong_module_variant_test: usize = add_node(&variant_test_nodes, "binary", "is", option_value_root, wrong_module_some, 0, 0, 0, 0, "", "")
    return 81 if proof_kernel_replay_proposition_formation_report(&variant_test_nodes, &variant_test_children, variant_test_environment, [], wrong_module_variant_test)
    wrong_module_member_equality: usize = add_node(&variant_test_nodes, "binary", "==", option_value_root, wrong_module_some, 0, 0, 0, 0, "", "")
    return 83 if proof_kernel_replay_proposition_formation_report(&variant_test_nodes, &variant_test_children, variant_test_environment, [], wrong_module_member_equality)

    # A scoped enum path is valid only when it is paired with the same canonical type path.
    # Keep this source-shaped positive environment separate from the malformed enum-only path
    # below so each admission result tests one invariant.
    qualified_enum_bindings: mutable darray[ProofKernelTypingBinding] = []
    qualified_enum_type_added: bool = proof_kernel_add_typing_binding_with_identity(&qualified_enum_bindings, "type", "Option", "", "named", "Option", "", "", 202, 0, 0)
    qualified_type_root_added: bool = proof_kernel_add_typing_binding_with_metadata(&qualified_enum_bindings, "type-scope-segment", "Wrong", "Option", "named", "Option", "", "", 202, 0, 0, 0, 0, 2)
    qualified_type_leaf_added: bool = proof_kernel_add_typing_binding_with_metadata(&qualified_enum_bindings, "type-scope-segment", "Option", "Option", "named", "Option", "", "", 202, 0, 0, 0, 1, 2)
    qualified_enum_root_added: bool = proof_kernel_add_typing_binding_with_metadata(&qualified_enum_bindings, "enum-scope-segment", "Wrong", "Option", "named", "Option", "", "", 202, 202, 0, 0, 0, 2)
    qualified_enum_leaf_added: bool = proof_kernel_add_typing_binding_with_metadata(&qualified_enum_bindings, "enum-scope-segment", "Option", "Option", "named", "Option", "", "", 202, 202, 0, 0, 1, 2)
    qualified_enum_value_added: bool = proof_kernel_add_typing_binding_with_identity(&qualified_enum_bindings, "value", "wrong_option", "", "named", "Option", "", "", 202, 0, 0)
    qualified_enum_tag_added: bool = proof_kernel_add_typing_binding_with_identity(&qualified_enum_bindings, "enum-tag", "Some", "Option", "named", "Option", "", "", 202, 202, 0)
    qualified_enum_member_added: bool = proof_kernel_add_typing_binding_with_identity(&qualified_enum_bindings, "enum-member", "Some", "Option", "named", "Option", "", "", 202, 202, 0)
    return 87 if not qualified_enum_type_added or not qualified_type_root_added or not qualified_type_leaf_added or not qualified_enum_root_added or not qualified_enum_leaf_added or not qualified_enum_value_added or not qualified_enum_tag_added or not qualified_enum_member_added
    qualified_enum_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: qualified_enum_bindings}
    qualified_enum_value_root: usize = add_node(&variant_test_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "wrong_option", "")
    qualified_enum_variant_test: usize = add_node(&variant_test_nodes, "binary", "is", qualified_enum_value_root, wrong_module_some, 0, 0, 0, 0, "", "")
    return 88 if not proof_kernel_replay_proposition_formation_report(&variant_test_nodes, &variant_test_children, qualified_enum_environment, [], qualified_enum_variant_test)

    # Without matching type-scope evidence, an ordinary root enum cannot claim a scoped path.
    malformed_enum_path_bindings: mutable darray[ProofKernelTypingBinding] = []
    malformed_enum_type_added: bool = proof_kernel_add_typing_binding_with_identity(&malformed_enum_path_bindings, "type", "Option", "", "named", "Option", "", "", 203, 0, 0)
    malformed_enum_root_added: bool = proof_kernel_add_typing_binding_with_metadata(&malformed_enum_path_bindings, "enum-scope-segment", "Wrong", "Option", "named", "Option", "", "", 203, 203, 0, 0, 0, 2)
    malformed_enum_leaf_added: bool = proof_kernel_add_typing_binding_with_metadata(&malformed_enum_path_bindings, "enum-scope-segment", "Option", "Option", "named", "Option", "", "", 203, 203, 0, 0, 1, 2)
    malformed_enum_value_added: bool = proof_kernel_add_typing_binding_with_identity(&malformed_enum_path_bindings, "value", "forged_option", "", "named", "Option", "", "", 203, 0, 0)
    malformed_enum_tag_added: bool = proof_kernel_add_typing_binding_with_identity(&malformed_enum_path_bindings, "enum-tag", "Some", "Option", "named", "Option", "", "", 203, 203, 0)
    malformed_enum_member_added: bool = proof_kernel_add_typing_binding_with_identity(&malformed_enum_path_bindings, "enum-member", "Some", "Option", "named", "Option", "", "", 203, 203, 0)
    return 89 if not malformed_enum_type_added or not malformed_enum_root_added or not malformed_enum_leaf_added or not malformed_enum_value_added or not malformed_enum_tag_added or not malformed_enum_member_added
    malformed_enum_path_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: malformed_enum_path_bindings}
    malformed_enum_value_root: usize = add_node(&variant_test_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "forged_option", "")
    malformed_enum_variant_test: usize = add_node(&variant_test_nodes, "binary", "is", malformed_enum_value_root, wrong_module_some, 0, 0, 0, 0, "", "")
    return 90 if proof_kernel_replay_proposition_formation_report(&variant_test_nodes, &variant_test_children, malformed_enum_path_environment, [], malformed_enum_variant_test)

    unresolved_path_bindings: mutable darray[ProofKernelTypingBinding] = []
    unresolved_option_value_added: bool = proof_kernel_add_typing_binding_with_identity(&unresolved_path_bindings, "value", "option", "", "named", "Option", "", "", 101, 0, 0)
    unresolved_option_type_added: bool = proof_kernel_add_typing_binding_with_identity(&unresolved_path_bindings, "type", "Option", "", "named", "Option", "", "", 101, 0, 0)
    unresolved_option_scope_added: bool = proof_kernel_add_typing_binding_with_metadata(&unresolved_path_bindings, "enum-scope-segment", "Option", "Option", "named", "Option", "", "", 101, 101, 0, 0, 0, 1)
    unresolved_option_tag_added: bool = proof_kernel_add_typing_binding_with_identity(&unresolved_path_bindings, "enum-tag", "Some", "Option", "named", "Option", "", "", 101, 101, 0)
    unresolved_option_member_added: bool = proof_kernel_add_typing_binding_with_identity(&unresolved_path_bindings, "enum-member", "Some", "Option", "named", "Option", "", "", 101, 101, 0)
    return 84 if not unresolved_option_value_added or not unresolved_option_type_added or not unresolved_option_scope_added or not unresolved_option_tag_added or not unresolved_option_member_added
    unresolved_path_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: unresolved_path_bindings}
    return 85 if proof_kernel_replay_proposition_formation_report(&variant_test_nodes, &variant_test_children, unresolved_path_environment, [], wrong_module_variant_test)
    return 86 if proof_kernel_replay_proposition_formation_report(&variant_test_nodes, &variant_test_children, unresolved_path_environment, [], wrong_module_member_equality)
    other_type_root: usize = add_node(&variant_test_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "Other", "")
    other_some_tag: usize = add_node(&variant_test_nodes, "scope", "", other_type_root, 0, 0, 0, 0, 0, "Some", "")
    wrong_enum_variant_test: usize = add_node(&variant_test_nodes, "binary", "is", option_value_root, other_some_tag, 0, 0, 0, 0, "", "")
    return 71 if proof_kernel_replay_proposition_formation_report(&variant_test_nodes, &variant_test_children, variant_test_environment, [], wrong_enum_variant_test)
    other_some_field: usize = add_node(&variant_test_nodes, "field", "", other_type_root, 0, 0, 0, 0, 0, "Some", "")
    wrong_field_variant_test: usize = add_node(&variant_test_nodes, "binary", "is", option_value_root, other_some_field, 0, 0, 0, 0, "", "")
    return 78 if proof_kernel_replay_proposition_formation_report(&variant_test_nodes, &variant_test_children, variant_test_environment, [], wrong_field_variant_test)
    boolean_tag_root: usize = add_node(&variant_test_nodes, "bool", "", 0, 0, 0, 0, 0, 1, "", "")
    malformed_variant_test: usize = add_node(&variant_test_nodes, "binary", "is", option_value_root, boolean_tag_root, 0, 0, 0, 0, "", "")
    return 72 if proof_kernel_replay_proposition_formation_report(&variant_test_nodes, &variant_test_children, variant_test_environment, [], malformed_variant_test)
    return 0

def ambiguous_enum_identity_tests() -> i64 can[Memory.Allocate, Abort.Panic]:
    colliding_enum_bindings: mutable darray[ProofKernelTypingBinding] = []
    collision_value_added: bool = proof_kernel_add_typing_binding_with_identity(&colliding_enum_bindings, "value", "option", "", "named", "Option", "", "", 101, 0, 0)
    first_option_type_added: bool = proof_kernel_add_typing_binding_with_identity(&colliding_enum_bindings, "type", "Option", "", "named", "Option", "", "", 101, 0, 0)
    first_option_scope_added: bool = proof_kernel_add_typing_binding_with_metadata(&colliding_enum_bindings, "enum-scope-segment", "Option", "Option", "named", "Option", "", "", 101, 101, 0, 0, 0, 1)
    second_option_type_added: bool = proof_kernel_add_typing_binding_with_identity(&colliding_enum_bindings, "type", "Option", "", "named", "Option", "", "", 103, 0, 0)
    second_option_scope_added: bool = proof_kernel_add_typing_binding_with_metadata(&colliding_enum_bindings, "enum-scope-segment", "Option", "Option", "named", "Option", "", "", 103, 103, 0, 0, 0, 1)
    first_option_tag_added: bool = proof_kernel_add_typing_binding_with_identity(&colliding_enum_bindings, "enum-tag", "Some", "Option", "named", "Option", "", "", 101, 101, 0)
    second_option_tag_added: bool = proof_kernel_add_typing_binding_with_identity(&colliding_enum_bindings, "enum-tag", "Some", "Option", "named", "Option", "", "", 103, 103, 0)
    return 73 if not collision_value_added or not first_option_type_added or not second_option_type_added or not first_option_scope_added or not second_option_scope_added or not first_option_tag_added or not second_option_tag_added
    colliding_enum_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: colliding_enum_bindings}
    collision_nodes: mutable darray[ProofKernelNode] = []
    collision_children: mutable darray[usize] = []
    option_value_root: usize = add_node(&collision_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "option", "")
    option_type_root: usize = add_node(&collision_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "Option", "")
    option_some_tag: usize = add_node(&collision_nodes, "scope", "", option_type_root, 0, 0, 0, 0, 0, "Some", "")
    colliding_variant_test: usize = add_node(&collision_nodes, "binary", "is", option_value_root, option_some_tag, 0, 0, 0, 0, "", "")
    return 74 if proof_kernel_replay_proposition_formation_report(&collision_nodes, &collision_children, colliding_enum_environment, [], colliding_variant_test)
    return 0

def lexical_identity_proposition_tests() -> i64 can[Memory.Allocate, Abort.Panic]:
    lexical_nodes: mutable darray[ProofKernelNode] = []
    lexical_children: mutable darray[usize] = []
    left_named_value: usize = add_node(&lexical_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "left_named", "")
    right_named_value: usize = add_node(&lexical_nodes, "ident", "", 0, 0, 0, 0, 0, 0, "right_named", "")
    same_spelling_mismatch: usize = add_node(&lexical_nodes, "binary", "==", left_named_value, right_named_value, 0, 0, 0, 0, "", "")
    lexical_bindings: mutable darray[ProofKernelTypingBinding] = []
    left_lexical_added: bool = proof_kernel_add_typing_binding_with_identity(&lexical_bindings, "value", "left_named", "", "named", "Token", "", "", 801, 0, 0)
    right_lexical_added: bool = proof_kernel_add_typing_binding_with_identity(&lexical_bindings, "value", "right_named", "", "named", "Token", "", "", 802, 0, 0)
    return 75 if not left_lexical_added or not right_lexical_added
    lexical_environment: ProofKernelTypeEnvironment = ProofKernelTypeEnvironment{global_bindings: [], bindings: lexical_bindings}
    return 76 if proof_kernel_replay_proposition_formation_report(&lexical_nodes, &lexical_children, lexical_environment, [], same_spelling_mismatch)
    return 0
