# The entry value of a binding the loop rewrites is its value on the first iteration only.
# Letting it stand for an arbitrary iteration certified false claims: a precondition inside the
# body from the initial value, and a false invariant "preserved" from it.

def small(x: i64) -> i64:
    requires x < 10
    ensure result == x
    return x

# `step` starts at 0 but is rewritten by the body: `small(step)` needs `step < 10` on every
# iteration, and nothing establishes that.
def entry_value_must_not_reach_the_body(count: i64) -> i64:
    total: mutable i64 = 0
    step: mutable i64 = 0
    while step < count |step, total, count|:
        seen: i64 = small(step)
        total <- total + seen
        step <- step + 1
    return total

# The same when the loop has no capture list at all: the body still rewrites `total`, and
# `total + 1 < 10` holds on the first iteration only.
def entry_value_must_not_reach_an_uncaptured_body(count: usize) -> i64:
    total: mutable i64 = 0
    for index in 0..<count:
        total <- total + 1
        seen: i64 = small(total)
    return total

# `step <= 5` is not preserved when `count` may exceed it; only `step`'s entry value made
# `0 + 1 <= 5` look like a preservation proof.
def false_invariant_must_not_be_preserved(count: i64) -> i64:
    step: mutable i64 = 0
    while step < count |step, count|:
        invariant step <= 5
        step <- step + 1
    return step

# A `break` inside a captured body leaves with the condition still true, so `not condition` is not
# a post-loop fact: `result >= count` is false whenever `count` exceeds 3.
def break_must_not_yield_the_exit_condition(count: usize) -> usize:
    ensure result >= count
    step: mutable usize = 0
    while step < count |step, count|:
        invariant step <= count
        break if step == 3
        step <- step + 1
    return step
