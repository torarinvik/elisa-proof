# Named arguments must instantiate modular summaries by label, not source order.

def first_value(first: i64, second: i64) -> i64:
    requires first >= 0
    ensure result == first
    return first

def named_caller(x: i64) -> i64:
    requires x >= 0
    ensure result == x
    return first_value(second: 7, first: x)
