# The complement guards only the else arm, and only for what it says.
module RejectedComplementedElseArms:
    # The complement `v >= 10` leaves the multiply free to wrap.
    def wrong_complement(v: u64) -> u64:
        requires v <= 1000000000000000000
        ensure result <= 1000000000000000000
        5 if v < 10 else v * 10 + 9

    # The then arm runs under the condition, never its complement.
    def then_arm_unguarded(v: u64) -> u64:
        requires v <= 1000000000000000000
        ensure result <= 1000000000000000000
        v * 10 + 9 if v >= 100000000000000000 else 5

    # A complement one short of what the multiply needs.
    def weak_complement(v: u64) -> u64:
        requires v <= 1000000000000000000
        ensure result <= 1000000000000000000
        5 if v >= 100000000000000001 else v * 10 + 9

    # The complement of a conjunction is a disjunction, which bounds neither side.
    def conjunction_complement(byte: u64) -> u64:
        ensure result <= 9
        9 if byte >= 48 and byte <= 57 else byte - 48
