# The equality that lets a fact over a collection literal find its own trace is exact: same length,
# same elements, elementwise. Nothing here may borrow a guard recorded for a different literal, and
# a guard recorded before the binding changed may not survive it.

def range_valid(start: usize, count: usize, total: usize) -> bool:
    ensure not result or start <= total and count <= total - start
    return false if start > total
    return false if count > total - start
    return true

# The guard is taken over `[1, 2, 3]`; the binding then holds `[4]`. Nothing the guard said is
# about the collection that is indexed.
def a_rebound_literal_loses_its_guard(start: usize) -> usize:
    children: mutable darray[usize] = [1, 2, 3]
    return 0 if not range_valid(start, 1, children.count)
    children <- [4]
    return children[start]

# One local is guarded and a different one is indexed. Two literals of the same length must not be
# told apart by their length alone.
def a_guard_for_one_literal_is_not_a_guard_for_another(start: usize) -> usize:
    children: mutable darray[usize] = [1, 2, 3]
    others: mutable darray[usize] = [4, 5, 6]
    return 0 if not range_valid(start, 1, children.count)
    return others[start]

# An empty literal has nothing to index, whatever the guard claims.
def an_empty_literal_has_no_element(start: usize) -> usize:
    children: mutable darray[usize] = []
    return 0 if not range_valid(start, 1, children.count)
    return children[start]
