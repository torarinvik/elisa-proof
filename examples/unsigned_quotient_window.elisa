module UnsignedQuotientWindow:
    public:
        def every_in_range_chunk_window_ends_within_total(total: u64, size: u64, index: u64) -> bool:
            requires size > 0
            requires index < total / size
            ensure result == true
            return index * size + size <= total

        def a_count_bound_by_quotient_contains_every_window(total: usize, size: usize, count: usize, index: usize) -> bool:
            requires size > 0
            requires count == total / size
            requires index < count
            ensure result == true
            return index * size + size <= total

        def index_at_quotient_may_exceed_total(total: usize, size: usize, index: usize) -> bool:
            requires size > 0
            requires index <= total / size
            ensure result == true
            return index * size + size <= total

        def an_unlinked_count_does_not_bound_a_window(total: usize, size: usize, count: usize, index: usize) -> bool:
            requires size > 0
            requires index < count
            ensure result == true
            return index * size + size <= total

        def a_count_from_a_different_size_does_not_bound_a_window(total: usize, size: usize, other_size: usize, count: usize, index: usize) -> bool:
            requires size > 0
            requires other_size > 0 and other_size != size
            requires count == total / other_size
            requires index < count
            ensure result == true
            return index * size + size <= total
