# Opaque nullable pointers (notably allocator results) may only be compared with null.
def allocator_result_may_be_null(pointer: mutable heap void&?) -> u8:
    ensure pointer == null or result == 0
    return 0

def null_may_be_compared_with_allocator_result(pointer: mutable heap void&?) -> u8:
    ensure null != pointer or result == 0
    return 0
