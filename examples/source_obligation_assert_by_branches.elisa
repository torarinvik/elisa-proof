# Boolean assert-by obligations in direct top-level if and match branches are source-indexed.
def source_assert_by_branches(flag: bool, tag: i64) -> void:
    if flag:
        assert true by:
            assert true
    else:
        assert true by:
            assert true
    match tag:
        0:
            assert true by:
                assert true
        _:
            assert true by:
                assert true
