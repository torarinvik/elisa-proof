def widening_u8_u16(value: u8) -> u16:
    ensure result == value
    ensure result <= 255
    return value.u16()

def widening_u16_u32(value: u16) -> u32:
    ensure result == value
    return value.u32()

def widening_zero_lower(value: u8) -> bool:
    ensure result
    return value.u16() >= 0

def widening_order(first: u8, second: u8) -> bool:
    requires first < second
    ensure result
    return first.u16() < second.u16()
