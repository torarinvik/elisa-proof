# Match expressions are not directly represented by the replay kernel term language. A guarded
# load containing one must fail closed instead of silently omitting its checked-access certificate.
def rejected_checked_index_unsupported_match(xs: darray[i64]&, tag: i64) -> i64:
    ensure true
    return get xs[0] else match tag:
        0:
            0
        _:
            1

def rejected_checked_get_unsupported_match(xs: darray[i64]&, tag: i64) -> i64:
    ensure true
    return get xs[match tag:
        0:
            0
        _:
            1
    ] else return 0
