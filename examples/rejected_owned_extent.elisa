# The rule keeps an extent only for a collection no callee can name. Everything a callee can reach
# loses it, and the rule says nothing about what a call does to a collection it does reach.

extend RejectedOwnedExtent:
    def grow(values: mutable darray[usize]&) -> usize:
        values.push(1)
        return values.count

    def read_only(values: darray[usize]&) -> usize:
        return values.count

    # Handed to a callee that can resize it.
    def a_lent_local_loses_its_extent() -> bool:
        ensure result
        b: mutable darray[usize] = []
        grown: usize = grow(b)
        return b.count == 0

    # A local bound to a reference does not own the collection behind it.
    def a_reference_local_owns_nothing(source: mutable darray[usize]&, other: mutable darray[usize]&) -> bool:
        ensure result
        alias: mutable darray[usize]& = source
        pushed: usize = grow(other)
        return alias.count == 0

    # The effect of a builtin on the collection it is called on is not modelled at all.
    def a_push_gives_no_new_length(seed: usize) -> bool:
        ensure result
        a: mutable darray[usize] = []
        a.push(seed)
        return a.count == 1

    # A completeness boundary, not a soundness one: a shared borrow cannot resize, but the record
    # of which bindings a callee can name does not separate a shared argument from a mutable one.
    def a_shared_argument_still_loses_the_extent() -> bool:
        ensure result
        b: mutable darray[usize] = []
        seen: usize = read_only(b)
        return b.count == 0
