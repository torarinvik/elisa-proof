# A scalar trigger in an existing range invariant shape selects one checked instance.
def arithmetic_trigger_instance(n: i64, limit: i64) -> i64:
    requires n > 0
    requires forall index in 0..<n: index <= limit
    ensure n - 1 >= 0
    ensure n - 1 < n
    ensure n - 1 <= limit
    return n

# Repeated occurrences of the binder must select one identical candidate term.
def repeated_binder_trigger(cursor: i64, n: i64, limit: i64) -> i64:
    requires cursor >= 0 and cursor < n
    requires forall item in 0..<n: item + item <= limit
    ensure cursor + cursor <= limit
    return cursor
