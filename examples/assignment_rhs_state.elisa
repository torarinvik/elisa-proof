# The assignment target is updated only after the RHS call has evaluated its arguments.

def assignment_add_one(x: i64) -> i64:
    requires x >= 0
    ensure result == x + 1
    return x + 1

def assignment_rhs_state(x: i64) -> i64:
    requires x >= 0
    ensure result == x + 1
    value: mutable i64 = x
    value <- assignment_add_one(value)
    return value
