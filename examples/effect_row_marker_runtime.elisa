# Runtime regression for exact empty-effect-row parser markers and fail-closed admission lookup.
include "../../Elisa-compiler/src/semantic/semantic.elisa"
include "../src/proof/kernel_core.elisa"
include "../src/proof/operator_impl_model.elisa"
include "../src/proof/model/enum_index.elisa"
include "../src/proof/model/findings.elisa"
include "../src/proof/model.elisa"
include "../src/proof/model/lemma_table.elisa"
include "../src/proof/kernel.elisa"
include "../src/proof/kernel_intern.elisa"
include "../src/proof/expr.elisa"
include "../src/proof/linear.elisa"
include "../src/proof/resources.elisa"
include "../src/proof/check.elisa"
include "../src/proof/kernel_replay.elisa"
include "../src/proof/replay.elisa"
include "../src/proof/tactics.elisa"

using ElisaProof

extend ElisaProof:
    public:
        def test_function_effect_row_marker_identity() -> bool can[Memory.Allocate]:
            exact: mutable darray[Ast::EnumAnnotation] = [Ast::EnumAnnotation{owner: "f", name: "__function_effect_row_declared", line: PROOF_FUNCTION_EFFECT_ROW_MARKER_LINE, detail_line: 7, offset: 19}]
            exact_work: mutable usize = 0
            exact_lookup: (complete: bool, present: bool) = proof_function_effect_row_marker_present(exact, "f", 7, 19, &exact_work)
            return false if not exact_lookup.complete or not exact_lookup.present

            missing_work: mutable usize = 0
            missing_lookup: (complete: bool, present: bool) = proof_function_effect_row_marker_present(exact, "f", 7, 20, &missing_work)
            return false if not missing_lookup.complete or missing_lookup.present

            misplaced: mutable darray[Ast::EnumAnnotation] = [Ast::EnumAnnotation{owner: "sibling", name: "__function_effect_row_declared", line: PROOF_FUNCTION_EFFECT_ROW_MARKER_LINE, detail_line: 7, offset: 19}]
            misplaced_work: mutable usize = 0
            misplaced_lookup: (complete: bool, present: bool) = proof_function_effect_row_marker_present(misplaced, "f", 7, 19, &misplaced_work)
            return false if misplaced_lookup.complete or misplaced_lookup.present

            wrong_line: mutable darray[Ast::EnumAnnotation] = [Ast::EnumAnnotation{owner: "f", name: "__function_effect_row_declared", line: PROOF_FUNCTION_EFFECT_ROW_MARKER_LINE, detail_line: 8, offset: 19}]
            wrong_line_work: mutable usize = 0
            wrong_line_lookup: (complete: bool, present: bool) = proof_function_effect_row_marker_present(wrong_line, "f", 7, 19, &wrong_line_work)
            return false if wrong_line_lookup.complete or wrong_line_lookup.present

            duplicate: mutable darray[Ast::EnumAnnotation] = exact
            duplicate.push(exact[0])
            duplicate_work: mutable usize = 0
            duplicate_lookup: (complete: bool, present: bool) = proof_function_effect_row_marker_present(duplicate, "f", 7, 19, &duplicate_work)
            return false if duplicate_lookup.complete or duplicate_lookup.present
            return true

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    return 1 if not ElisaProof::test_function_effect_row_marker_identity()
    return 0
