# swap_ref(a, b) returns choose_first(b, a), which is backed by `b`. Writing `b` while the
# result is live must be rejected; a summary taken from the last read of the call arguments
# would name `a` instead and accept it.
def choose_first[@r](first: mutable i64& @r, second: mutable i64& @r) -> mutable i64& @r:
    return first

def swap_ref[@r](first: mutable i64& @r, second: mutable i64& @r) -> mutable i64& @r:
    return choose_first(second, first)

def rejected_reference_call_return_wrong_provenance() -> i64 can[Memory.Allocate, Abort.Panic]:
    region scratch(1024)
    a: mutable i64& @scratch = new[scratch] 1
    b: mutable i64& @scratch = new[scratch] 2
    chosen: mutable i64& @scratch = swap_ref(a, b)
    chosen <- 6
    b <- 5
    return 0

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    return rejected_reference_call_return_wrong_provenance()
