# The comparison atom is only valid while its identifiers keep their symbolic values. The
# assignment in the NaN branch must not prove a call requirement about the replacement value.
def requires_self_unequal(value: f32) -> void:
    requires value != value
    return

def rejected_float_boolean_stale_fact(initial: f32, replacement: f32) -> i64:
    value: mutable f32 = initial
    if value != value:
        value <- replacement
        requires_self_unequal(value)
    0
