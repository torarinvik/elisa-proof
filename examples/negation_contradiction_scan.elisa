def boolean_contradiction_scan(flag: bool) -> i64:
    requires flag
    ensure result == 0
    return 1 if not flag
    return 0

def negated_boolean_contradiction_scan(flag: bool) -> i64:
    requires not flag
    ensure result == 0
    return 1 if flag
    return 0

def arithmetic_noncontradictory_scan(cursor: i64, flag: bool) -> i64:
    requires cursor >= 0 and cursor < 8
    ensure result >= 1 and result <= 8
    return cursor + 1 if flag
    return cursor + 1
