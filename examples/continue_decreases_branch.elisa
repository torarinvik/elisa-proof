# A continuation can be path-sensitive when the other branch terminates. The termination checker
# verifies the captured continue edge and does not need to invent a state for the return path.
def continue_decreases_branch(n: i64) -> i64:
    requires n >= 0
    ensure result == 0
    value: mutable i64 = n
    while value > 0:
        invariant value >= 0
        decreases value
        if value == 1:
            value <- value - 1
            continue
        return 0
    return value
