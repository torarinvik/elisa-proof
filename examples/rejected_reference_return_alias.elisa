# Returning a reference formal preserves the same underlying place. The caller must not be able
# to keep one mutable handle and obtain a second independent mutable handle to that place.

def return_owner[@r](owner: mutable i64& @r) -> mutable i64& @r:
    return owner

def rejected_reference_return_alias() -> i64:
    region scratch(1024)
    seed: mutable i64& @scratch = new[scratch] 0
    alias: mutable i64& @scratch = return_owner(seed)
    seed <- 1
    alias <- 2
    return 0

def main() -> i64:
    return rejected_reference_return_alias()
