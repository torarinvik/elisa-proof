# Unsigned arithmetic wraps at the declared width: 255 + 1 is 0 for u8, so this
# postcondition is false even though an unbounded signed model would derive it.
def rejected_unsigned_overflow_goal(x: u8) -> u8:
    requires x == 255
    ensure x + 1 > x
    return x

def main() -> u8:
    return rejected_unsigned_overflow_goal(255)
