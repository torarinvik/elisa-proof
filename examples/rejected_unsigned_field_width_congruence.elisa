# Congruence may not identify same-shaped arithmetic over fields with different machine widths.
struct ByteField:
    value: u8

struct WordField:
    value: u16

def rejected_unsigned_field_width_congruence(byte: ByteField, word: WordField) -> void:
    requires byte.value == word.value
    requires byte.value == 255
    ensure byte.value + 1 == word.value + 1
    return

def main() -> u8:
    return 0
