module RejectedSummaryAlias:
    public:
        def advance(time: i64, delta: i64) -> i64:
            requires time >= 0
            requires time <= 1000000
            requires delta >= 1
            requires delta <= 1000
            ensure result > time
            ensure result == time + delta
            return time + delta

        def land(time: i64, end: i64) -> i64:
            requires time >= 0
            requires end >= 0
            ensure result <= end
            ensure result >= 0
            ensure time < end or result == end
            ensure time > end or result == time
            ensure result == time or result == end
            return end if time >= end
            return time

        def forward(time: i64, delta: i64, end: i64) -> i64:
            requires time >= 0
            requires time < end
            requires end <= 1000000
            requires delta >= 1
            requires delta <= 1000
            ensure result > time
            ensure result < end
            return land(advance(time, delta), end)
