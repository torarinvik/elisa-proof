# A loop without an invariant remains rejected, but its body must still be traversed so an unsafe
# access cannot disappear behind the missing-invariant diagnostic.
#
# The body may now assume the loop condition, which is sound and discharges `values[index]`. The
# access here is deliberately one past what the condition gives, so the obligation is emitted,
# stays visible, and stays unproven.

def rejected_while_body_visibility(values: darray[i64]&, index: usize) -> i64:
    while index < values.count:
        return values[index + 1]
    return 0
