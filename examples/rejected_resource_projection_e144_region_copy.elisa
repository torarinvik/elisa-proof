# A potentially region-carrying aggregate may not be copied out of a region parameter without
# a declaration-derived proof that the aggregate contains no borrowed fields.
struct ResourceProjectionE144RegionLeaf:
    left: usize
    right: usize

struct ResourceProjectionE144RegionNode:
    leaf: ResourceProjectionE144RegionLeaf

def resource_projection_e144_region_sum(left: usize, right: usize) -> usize:
    return left + right

def rejected_resource_projection_e144_region_copy[@r](nodes: darray[ResourceProjectionE144RegionNode]& @r, index: usize) -> usize:
    requires index < nodes.count
    copied: ResourceProjectionE144RegionNode = nodes[index]
    return resource_projection_e144_region_sum(copied.leaf.left, copied.leaf.right)
