# A default expression is part of a function's callable behavior. An omitted argument must not
# turn an effectful default into a logical pure function summary.

def effectful_default_source() -> i64:
    local: mutable i64 = 0
    local <- local + 1
    return local

def tainted_default_contract(x: i64 = effectful_default_source()) -> i64:
    return x

def rejected_pure_default_contract(x: i64) -> i64:
    ensure result == tainted_default_contract()
    return tainted_default_contract()
