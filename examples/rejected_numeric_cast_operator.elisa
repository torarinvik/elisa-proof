# None of these may be proved. A numeric cast is witnessed as a primitive scalar, so the
# comparisons around it are admitted, but its value stays opaque: a cast wraps and truncates,
# and no fact about the receiver may carry over to the result.

# False at x = -1, where the cast wraps to 2^64 - 1.
def wrapped_cast_below(x: i64) -> bool:
    requires x < 5
    ensure result
    x.u64() < 5

# False at value = 300, where the cast keeps the low byte, 44.
def truncated_cast_above(value: u32) -> bool:
    requires value > 255
    ensure result
    value.u8() > 200

# False at value = 256: the receiver is positive, the truncated cast is zero.
def truncated_cast_positive(value: u32) -> bool:
    requires value > 0
    ensure result
    value.u8() > 0
