def prefix_byte_nonzero(value: u8) -> bool:
    ensure result == (value != 0)
    return value != 0

# A proof of the checked prefix must not cover the last, unvisited element.
def rejected_unvisited_predicate_byte(rows: array[u8, 8]&) -> bool:
    ensure result or (forall index in 0..<8: prefix_byte_nonzero(rows[index]))
    cursor: mutable i64 = 0
    while cursor < 7 |cursor, rows|:
        invariant cursor >= 0 and cursor <= 7
        invariant forall index in 0..<8: index >= cursor or prefix_byte_nonzero(rows[index])
        decreases 7 - cursor
        byte: u8 = rows[cursor]
        checked: bool = prefix_byte_nonzero(byte)
        return true if not checked
        cursor <- cursor + 1
    return false
