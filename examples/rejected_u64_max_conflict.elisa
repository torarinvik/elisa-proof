# The parser stores u64.max as the i64 bit pattern -1. Kernel reasoning must preserve that
# unsigned interpretation; it must not combine it with a signed range and prove a contradiction.
const USIZE_MAX_BITS: usize = 0xFFFFFFFFFFFFFFFF

def u64_max_does_not_imply_zero(value: u64) -> u64:
    requires value == 0xFFFFFFFFFFFFFFFF
    ensure value == 0
    return value

def usize_max_does_not_imply_zero(value: usize) -> usize:
    requires value == 0xFFFFFFFFFFFFFFFF
    ensure value == 0
    return value

def u64_reflexive_equality_remains_provable(value: u64) -> u64:
    ensure value == value
    return value

def u64_max_is_not_less_than_zero() -> u64:
    ensure 0xFFFFFFFFFFFFFFFFu64 < 0u64
    return 0u64

def usize_global_max_is_not_negative() -> usize:
    ensure USIZE_MAX_BITS < 0
    return USIZE_MAX_BITS

def usize_local_max_is_not_negative() -> usize:
    ensure result < 0
    value: usize = 0xFFFFFFFFFFFFFFFF
    return value
