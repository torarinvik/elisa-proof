# A module-qualified call result carries its callee's declared signed width, as a bare call
# does, so a negative bound on `Clamp::keep(v)` is typed at i64 rather than refused as an
# ambiguous constant.
module Clamp:
    public:
        def keep(value: i64) -> i64:
            requires value >= -1000
            requires value <= 1000
            ensure result >= -1000
            return value

        def lower(v: i64) -> i64:
            requires v >= -1000
            requires v <= 1000
            ensure result >= -2000
            return Clamp::keep(v)

        def narrow(v: i32) -> i32:
            requires v >= -10
            requires v <= 10
            ensure result >= -10
            return Clamp::small(v)

        def small(value: i32) -> i32:
            requires value >= -10
            requires value <= 10
            ensure result == value
            return value
