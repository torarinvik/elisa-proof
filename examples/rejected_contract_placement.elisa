struct Box:
    v: mutable i32

def poke(b: mutable Box&) -> i32:
    b.v <- b.v + 1
    b.v

# Each contract below sits where the checker does not read that kind, so its claim
# would go unchecked; each one fails closed instead.
def ensure_in_branch(flag: bool) -> i32:
    if flag:
        ensure result == 7
    1

def invariant_outside_loop(x: i32) -> i32:
    invariant x == 0
    x

def ensure_in_captured_loop(limit: i32) -> i32:
    i: mutable i32 = 0
    while i < limit |i|:
        invariant i >= 0
        decreases limit - i
        ensure result == 9
        i <- i + 1
    0

def ensure_in_plain_loop(limit: i32) -> i32:
    i: mutable i32 = 0
    while i < limit:
        invariant i >= 0
        decreases limit - i
        ensure result == 9
        i <- i + 1
    0

def measure_in_for_loop() -> i32:
    total: mutable i32 = 0
    for k in 0..<3 |total|:
        decreases 3 - total
        total <- total + 1
    0

def invariant_in_loop_branch(limit: i32) -> i32:
    i: mutable i32 = 0
    while i < limit |i|:
        invariant i >= 0
        decreases limit - i
        if i > 2:
            invariant i >= 3
        i <- i + 1
    0

def changes_in_match_arm(mode: i32, b: mutable Box&) -> i32:
    match mode:
        0:
            changes b
            b.v <- 1
        _:
            pass
    0

# A captured loop's invariant is logical, so a call that writes through a reference
# is rejected there as it is in an uncaptured loop.
def writing_call_in_captured_invariant(b: mutable Box&) -> i32:
    i: mutable i32 = 0
    while i < 3 |i|:
        invariant poke(b) >= 0 and i >= 0 and i <= 3
        decreases 3 - i
        i <- i + 1
    0
