# A moved binding cannot be borrowed again. The source checker and replay kernel must agree
# that the old resource capability is unavailable before creating a new borrow.
def rejected_borrow_after_move(value: i64) -> i64:
    moved: i64 = move value
    view: i64& = &value
    return 0

def main() -> i64:
    return rejected_borrow_after_move(1)
