# An assertion over a local that came from an unresolved call must not export a reusable call term.
# The assertion checks one execution; a later proof state cannot equate a second execution with it.

extern nondeterministic_value_for_assert() -> i64

def rejected_unknown_assert_reuse() -> i64:
    ensure result == 0
    value: i64 = nondeterministic_value_for_assert()
    assert value == 0
    return value
