# A runtime assertion checks one execution of a call. A later proof state cannot equate a second
# execution with it: the call term itself is never a reusable fact, and a binding that is
# reassigned after the assertion no longer denotes the asserted value. (A scalar local bound
# once to the call and returned unchanged is the same execution; that case is proved in
# `expression_witness.elisa`.)

extern nondeterministic_value_for_assert() -> i64

def rejected_unknown_call_reuse() -> i64:
    ensure result == 0
    assert nondeterministic_value_for_assert() == 0
    return nondeterministic_value_for_assert()

def rejected_rebound_assert_reuse() -> i64:
    ensure result == 0
    value: mutable i64 = nondeterministic_value_for_assert()
    assert value == 0
    value <- nondeterministic_value_for_assert()
    return value
