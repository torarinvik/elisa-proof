# Facts over values fixed for the whole body survive a later call that does not take them by
# mutable reference: a qualified constant such as `Fade::FULL`, and the fresh symbol a
# constant call argument is bound to. `weight` returns `Fade::FULL` here, and `apply` with
# that weight returns `fixed`.
module Fade:
    public:
        const FULL: i64 = 1000

module Gate:
    public:
        def weight(enabled: bool, fade: i64) -> i64:
            requires fade >= 0
            requires fade <= Fade::FULL
            ensure result >= 0
            ensure result <= Fade::FULL
            ensure not enabled or result == fade
            return fade if enabled
            return 0

        def apply(source: i64, fixed: i64, weight: i64) -> i64:
            requires weight >= 0
            requires weight <= Fade::FULL
            requires source >= -1000 and source <= 1000
            requires fixed >= -1000 and fixed <= 1000
            ensure weight != Fade::FULL or result == fixed
            return fixed if weight == Fade::FULL
            return source

module Uses:
    public:
        def full_weight_is_fix(source: i64, fixed: i64) -> i64:
            requires source >= -1000 and source <= 1000
            requires fixed >= -1000 and fixed <= 1000
            ensure result == fixed
            w: i64 = Gate::weight(true, Fade::FULL)
            return Gate::apply(source, fixed, w)

        def weight_kept_after_apply(source: i64, fixed: i64) -> i64:
            requires source >= -1000 and source <= 1000
            requires fixed >= -1000 and fixed <= 1000
            ensure result == Fade::FULL
            w: i64 = Gate::weight(true, Fade::FULL)
            out: i64 = Gate::apply(source, fixed, w)
            return w
