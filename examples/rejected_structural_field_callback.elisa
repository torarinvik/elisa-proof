# A function-valued struct field can hide a same-measure recursive reentry behind a named
# helper. Structural summaries must inspect reachable helper bodies, not only the owner body.
enum FieldCallbackNat:
    Zero
    Succ(prev: FieldCallbackNat)

struct FieldCallbackHooks:
    callback: fn(FieldCallbackNat) -> i64

struct FieldCallbackRequest:
    n: FieldCallbackNat

def invoke_field_callback(hooks: FieldCallbackHooks, request: FieldCallbackRequest) -> i64:
    return hooks.callback(request.n)

def field_callback_bounce(n: FieldCallbackNat, hooks: FieldCallbackHooks) -> i64:
    decreases n
    ensure result == 0
    match n:
        FieldCallbackNat.Zero:
            return 0
        FieldCallbackNat.Succ(prev):
            request: FieldCallbackRequest = FieldCallbackRequest{n: n}
            _ = invoke_field_callback(hooks, request)
            return field_callback_bounce(prev, hooks)

def field_callback_reenter(n: FieldCallbackNat) -> i64:
    ensure result == 0
    hooks: FieldCallbackHooks = FieldCallbackHooks{callback: field_callback_reenter}
    return field_callback_bounce(n, hooks)
