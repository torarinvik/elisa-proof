struct IntegerDenialRecord:
    code: u8

def integer_denial_u8(code: u8) -> u8:
    ensure code > 3 or code <= 3
    ensure code < 3 or code >= 3
    return 0

def integer_denial_signed(code: i64) -> u8:
    ensure code >= 0 or code < 0
    ensure code <= 0 or code > 0
    return 0

def integer_denial_field(record: IntegerDenialRecord&) -> u8:
    ensure record.code > 3 or record.code <= 3
    return 0

def integer_denial_pair(left: u64, right: u64) -> u8:
    ensure left <= right or left > right
    return 0
