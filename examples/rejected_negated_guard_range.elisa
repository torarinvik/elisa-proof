# Reading a negated comparison as its complement gives the complement and nothing more.

struct Partial:
    tag: i64

# Complementarity is available even for a struct -- the compiler derives all four ordering
# operators from a single `__cmp__(self, other) -> i64` compared against zero, so `not (p > q)` and
# `p <= q` are the same predicate over the same call. Transitivity is not: `__cmp__` is an ordinary
# method under no law, and two negated steps compose to nothing.
def a_negated_struct_order_does_not_chain(p: Partial, q: Partial, r: Partial) -> i64:
    requires not (p > q)
    requires not (q > r)
    ensure p <= r
    return 0

# The strict direction of the same thing.
def a_negated_struct_order_gives_no_strict_chain(p: Partial, q: Partial, r: Partial) -> i64:
    requires not (p >= q)
    requires not (q >= r)
    ensure p < r
    return 0

# The modular form is still refused: `start + index >= values.count` compares against a sum that
# may already have wrapped, so its negation bounds nothing about the mathematical sum. This is the
# case the difference form exists to replace, and reading the negation does not rescue it.
def a_negated_modular_guard_bounds_nothing(values: darray[usize]&, start: usize, index: usize) -> usize:
    return 0 if start + index >= values.count
    return values[start + index]

# Disequality is not an order: `not (a == b)` leaves the two unrelated as far as this rule goes.
def a_negated_equality_is_not_an_order(values: darray[usize]&, index: usize) -> usize:
    return 0 if index == values.count
    return values[index]
