# Named variant payloads are lowered to exact field projections. The selected arm then consumes
# a verified pure result summary without exposing the pattern binder outside that branch.
enum Payload:
    Empty
    Value(value: i64)

def value_match_named_payload_leaf(value: i64) -> i64:
    ensure result == 7
    return 7

def value_match_named_payload(payload: Payload) -> i64:
    ensure result == 7
    return match payload:
        Payload.Value(value: value):
            value_match_named_payload_leaf(value)
        _:
            7
