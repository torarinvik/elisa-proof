def nonnegative(value: i64) -> bool:
    ensure result == (value >= 0)
    return value >= 0

def predicate_equation_elimination(value: i64) -> i64:
    requires value >= 0
    requires nonnegative(value) == (value >= 0)
    ensure nonnegative(value)
    return 0

def predicate_equation_negation(value: i64) -> i64:
    requires value < 0
    requires nonnegative(value) == (value >= 0)
    ensure not nonnegative(value)
    return 0
