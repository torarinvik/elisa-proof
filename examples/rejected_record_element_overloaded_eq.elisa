protocol Eq:
    def __eq__(self: Self, other: Self) -> bool

impl Eq for i64:
    def __eq__(self: i64, other: i64) -> bool:
        return self != other

struct Entry:
    key: i64

def overloaded_record_element_eq(entries: darray[Entry]&, left: usize, right: usize) -> i64:
    requires entries[left].key == entries[right].key
    ensure entries[left].key + 1 == entries[right].key + 1
    return 0
