# A local that holds a container, a tuple or a struct kept its initializer as its recorded value.
# When that initializer is a call the value is not a place, so every later `values.count` was
# recorded over `<call>.count` and every `located.node` over `<call>.node` -- terms with no place
# root, which no extent, alias or stability rule can say anything about. An index into such a local
# was not even given an obligation: it was reported opaque and skipped.
#
# The equality with the call was never usable for an aggregate. Nothing folds it, and an opaque
# callee's result is not a value this state models. Binding the local to its own symbol, the way an
# unsigned scalar local is already bound, is what makes those terms places again.

struct Affine:
    known: bool
    slot: usize

def affine_of(root: usize) -> Affine:
    return Affine{known: root < 4, slot: 0}

def make() -> darray[i64]:
    values: mutable darray[i64] = []
    values.push(1)
    return values

# The extent of a container local from a call is a place, so the guard over it is readable.
def a_container_local_from_a_call(slot: usize) -> i64:
    matrix: darray[i64] = make()
    return 0 if slot >= matrix.count
    return matrix[slot]

# A field of a struct local from a call is a place too.
def a_struct_local_from_a_call(root: usize, values: darray[i64]&) -> i64:
    left: Affine = affine_of(root)
    return 0 if not left.known
    return 0 if left.slot >= values.count
    return values[left.slot]

# The same across a loop, which is where the extent rules are actually consulted.
def a_loop_over_a_call_local() -> i64:
    matrix: darray[i64] = make()
    total: mutable i64 = 0
    for index in 0..<matrix.count |index, matrix, total|:
        total <- total + matrix[index]
    return total
