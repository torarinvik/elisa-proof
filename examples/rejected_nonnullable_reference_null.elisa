# A non-null pointer is not a nullable pointer and cannot be compared with null in a proof.
struct NonnullableNode:
    value: u8

struct NonnullableStore:
    prepared: mutable heap NonnullableNode&

def nonnullable_field_compared_with_null(store: NonnullableStore&) -> u8:
    ensure store.prepared == null or result == 0
    return 0
