# The overflow guard asks for a constant interval on the base of `x + k` before it will let the
# term into a proof at all. The interval pass collected only the bounds a fact states about a name
# directly, so `index < count` beside `count <= 1000` left `index` with no upper bound, and the
# increment every loop performs was refused even though 999 was derivable from the two facts
# together.
#
# A difference constraint carries a bound: `x - y <= c` with `y <= U` gives `x <= U + c`. Each step
# is an ordinary interval inference and can only narrow an interval that already held.
# `examples/rejected_bound_propagation.elisa` is the boundary.
def increment_under_a_bounded_limit(count: i64, index: i64) -> i64:
    requires index < count
    requires count <= 1000
    requires index >= 0
    ensure result <= count
    return index + 1

# The bound reaches the base through two constraints rather than one.
def increment_through_a_chain(count: i64, limit: i64, index: i64) -> i64:
    requires index < limit
    requires limit <= count
    requires count <= 1000
    requires index >= 0
    ensure result <= limit
    return index + 1

# The lower direction: `x - y <= c` with `x >= L` gives `y >= L - c`.
def lower_bound_travels(low: i64, high: i64) -> i64:
    requires low <= high
    requires low >= 0
    requires high <= 1000
    ensure result >= 0
    return high - 1 + 1

# The unsigned increment needs no interval at all. `index < count` says `index + 1 <= count`, and
# `count` is at most the type's maximum by typing, so the sum is in range -- an argument about the
# relation rather than about magnitudes, which is the only kind available for a 64-bit unsigned
# value whose maximum this prover's i64 domain cannot represent. It is the addition counterpart of
# the guarded-subtraction rule the engine already carried.
def unsigned_increment_under_a_strict_peer(count: usize, index: usize) -> usize:
    requires index < count
    ensure result <= count
    return index + 1

# The peer may sit on either side of the comparison.
def unsigned_increment_under_a_reversed_peer(count: usize, index: usize) -> usize:
    requires count > index
    ensure result <= count
    return index + 1

# These two were in the rejected half while the only route to them was an interval, and no
# interval was derivable: a lower bound on the far name carries nothing upward, and a bound on an
# unrelated name reaches nothing. Both claims are true all the same, and the strict shift proves
# them from `index < count` directly, without bounding `index` at all.
def strict_fact_needs_no_upper_bound(count: i64, index: i64) -> i64:
    requires index < count
    requires count >= 0
    ensure result <= count
    return index + 1

def strict_fact_needs_no_related_bound(count: i64, index: i64, other: i64) -> i64:
    requires index < count
    requires other <= 1000
    requires index >= 0
    ensure result <= count
    return index + 1
