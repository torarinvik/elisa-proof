# Search normalization must preserve the proposition, not invent right-hand truth.
def false_left_known_predicate(value: bool) -> i64:
    requires value
    ensure false or value
    return 0

def false_left_nested_disjunction(left: bool, right: bool) -> i64:
    requires left or right
    ensure false or (left or right)
    return 0

def false_literal_left_known_predicate(value: bool) -> i64:
    requires value
    ensure (7 != 7) or value
    return 0

def true_left_does_not_require_right(value: bool) -> i64:
    ensure true or value
    return 0

def unknown_left_uses_right(left: bool, right: bool) -> i64:
    requires right
    ensure left or right
    return 0

def rejected_false_left_unknown_predicate(value: bool) -> i64:
    ensure false or value
    return 0

def rejected_false_left_denied_predicate(value: bool) -> i64:
    requires not value
    ensure false or value
    return 0
