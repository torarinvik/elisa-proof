def reject_high_bit_unsigned_to_signed(value: u64) -> i64:
    requires value == 0x8000000000000000u64
    ensures result >= 0
    return value.i64()

def reject_narrowing_copy(value: i16) -> i8:
    requires value == 257
    ensures result == 257
    saved: i8 = value.i8()
    return saved

def reject_mutated_scalar_poststate(value: mutable i64&) -> i64:
    requires value == 7
    ensures result == 7
    value <- 9
    return value

def reject_mutated_count_poststate(values: mutable darray[i64]&) -> i64:
    requires values.count == 1
    ensures result == 1
    values.pop()
    return values.count.i64()

def reject_unbounded_count_to_signed(values: mutable darray[i64]&) -> i64:
    requires values.count >= 0
    ensures result >= 0
    return values.count.i64()
