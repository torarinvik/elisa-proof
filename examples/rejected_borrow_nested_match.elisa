# Resource-bearing call arguments in a value-match arm are checked through the callee summary,
# but the arm deliberately returns its local reference. The result-sensitive checker must still
# reject this real escape rather than confusing it with a temporary borrow used by a value call.
def borrow_match_reader(value: i64&) -> i64:
    return 1

def rejected_borrow_nested_match(x: mutable i64) -> i64&:
    return match x:
        0:
            view: i64& = &x
            borrow_match_reader(view)
            view
        _:
            &x
