# A module-scoped u32 constant participates in branch-derived output contracts.
module TimerPolicy:
    public:
        const MAX_DELAY_MS: u32 = 86400000
        const INVALID: u8 = 1
        const OK: u8 = 0

extend TimerPolicy:
    public:
        def delay_status(delay_ms: u32) -> u8:
            ensure delay_ms <= TimerPolicy::MAX_DELAY_MS or result == TimerPolicy::INVALID
            return TimerPolicy::INVALID if delay_ms > TimerPolicy::MAX_DELAY_MS
            return TimerPolicy::OK
