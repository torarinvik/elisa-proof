# None of these may be proved. Only a conversion whose target holds every value of the
# receiver's type keeps that value; a narrowing or sign-changing conversion, and a method that
# merely shares a conversion's name, stay opaque.

# False at value = 256, whose low byte is zero.
def narrowed(value: u32) -> u8:
    requires value >= 1
    ensure result >= 1
    return value.u8()

# False at value = -1, which wraps to 2^64 - 1.
def signed_to_unsigned(value: i64) -> u64:
    ensure result <= 9223372036854775807
    return value.u64()

# False at value = 2^63, which wraps negative.
def unsigned_to_signed(value: u64) -> i64:
    ensure result >= 0
    return value.i64()

# False at value = -1: a signed widening keeps the sign.
def signed_widen_below(value: i8) -> i64:
    ensure result >= 0
    return value.i64()

# False at value = 255: a widening keeps the whole receiver range.
def widened_above(value: u8) -> i64:
    ensure result <= 254
    return value.i64()

struct Meter:
    reading: u8

protocol Widen:
    def i64(self: Self) -> i64

impl Widen for Meter:
    def i64(self: Meter) -> i64:
        return -1

# False always: this `i64` is the method above, not a conversion.
def method_named_cast(meter: Meter) -> i64:
    ensure result >= 0
    return meter.i64()
