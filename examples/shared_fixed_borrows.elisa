module SharedFixedBorrows:
    public:
        const CAP: usize = 16
        struct Text:
            bytes: u8[CAP]
            length: usize
        # `text` is lent to `look` inside the loop. The frame received no mutable path: every
        # parameter is a shared borrow or a value, none holding a reference, and there is no
        # mutable global. So nothing can write `text.length`, and `stop <= text.length` survives
        # loop entry and the call. The named extent `u8[CAP]` is a fixed scalar array.
        def scan(text: Text&, start: usize, stop: usize) -> usize:
            requires start <= stop and stop <= text.length and text.length <= 16
            ensure result <= stop
            for slot in 0..<4 |cursor: usize = start| -> cursor:
                invariant cursor <= stop
                seen: usize = look(text)
                check(stop, text.length)
                cursor <- cursor + 1 if cursor < stop
        def look(text: Text&) -> usize:
            0
        def check(stop: usize, length: usize) -> void:
            requires stop <= length
            pass
