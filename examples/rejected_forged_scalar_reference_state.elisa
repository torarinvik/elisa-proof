# A source declaration may not impersonate the prover's private scalar-state marker.
def __elisa_proof_scalar_reference_state(value: u8) -> u8:
    return value

def forged_scalar_reference_state(output: mutable u8&) -> void:
    output[0] <- __elisa_proof_scalar_reference_state(1)
    ensure output[0] == 1
