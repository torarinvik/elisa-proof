# A callee reaches its caller's state only through references and globals. A by-value scalar local
# that nothing in the body references is therefore unchanged by any call, and its recorded value
# survives the call boundary. Forgetting every binding at every call — which is what the boundary
# did — cost each loop binder its range the moment the loop body made a call, so an index proven
# in bounds on one line was unprovable on the next.
#
# The values run under the call-stability rule the facts at the same boundary already use, so a
# binding something references, or a value recorded in terms of one, is still forgotten.

# Writes through a reference: not pure, so a call to it havocs whatever it can reach.
def reset(counter: mutable usize&) -> bool:
    changes counter
    counter <- 0
    return true

# `index` is the loop's own binder and nothing references it; `limit` is a by-value scalar. The
# call cannot reach either, so the binder keeps its range across it.
def loop_binder_survives_a_declaration_call(counter: mutable usize&, limit: usize) -> usize:
    requires limit <= 100
    ensure result <= 100
    for index in 0..<limit |index, counter|:
        written: bool = reset(counter)
        return index if written
    return 0

# A recorded literal value survives the same call.
def value_survives_a_declaration_call(counter: mutable usize&) -> i64:
    ensure result == 3
    settled: i64 = 3
    written: bool = reset(counter)
    return settled if written
    return 3

# The same across an assignment whose right-hand side is the call, and across a statement call.
def value_survives_an_assignment_call(counter: mutable usize&) -> i64:
    ensure result == 3
    settled: i64 = 3
    written: mutable bool = false
    written <- reset(counter)
    return settled if written
    return 3

def value_survives_a_statement_call(counter: mutable usize&) -> i64:
    ensure result == 3
    settled: i64 = 3
    reset(counter)
    return settled

# A guarded statement call is a branch whose arm makes a call. The arms are executed
# symbolically, so at the join each binding whose value both paths still agree on keeps it: the
# binder's range survives the guarded call exactly as it survives an unguarded one.
def loop_binder_survives_a_guarded_call(counter: mutable usize&, limit: usize, flag: bool) -> usize:
    requires limit <= 100
    ensure result <= 100
    for index in 0..<limit |index, counter, flag|:
        reset(counter) if flag
        return index
    return 0

# The same when only one arm reaches the join: the other returns, so the surviving arm's state
# is the whole state, and the value it still carries holds here.
def value_survives_a_returning_branch(counter: mutable usize&, flag: bool) -> i64:
    ensure result == 3
    settled: i64 = 3
    if flag:
        written: bool = reset(counter)
        return 3 if not written
    return settled
