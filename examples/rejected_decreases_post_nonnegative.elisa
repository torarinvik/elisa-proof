# A strict decrease is insufficient when the post-step rank can leave the natural numbers.

def negative_after_step(x: i64) -> i64:
    requires x >= 0
    value: mutable i64 = x
    rank: mutable i64 = x
    while value > 0:
        invariant value >= 0
        decreases rank
        rank <- -1
        value <- 0
    return 0
