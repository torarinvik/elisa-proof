# Frame checking also covers calls nested inside a control-flow condition.

struct Box:
    value: mutable i64
    other: mutable i64

def writes_value(box: mutable Box&) -> bool:
    changes box.value
    box.value <- 1
    return true

def condition_call_outside_frame(box: mutable Box&) -> void:
    changes box.other
    if writes_value(box):
        pass

struct Pair:
    left: i64
    right: i64

def writes_value_result(box: mutable Box&) -> i64:
    changes box.value
    box.value <- 1
    return 0

def constructed_call_outside_frame(box: mutable Box&) -> void:
    changes box.other
    pair: Pair = Pair{left: writes_value_result(box), right: 0}
