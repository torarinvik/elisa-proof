# One source obligation may have two independently replayed branch attempts.
include "report_inventory_test_support.elisa"
using ElisaProof

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    report: mutable ProofReport = ProofReport{current_source_postcondition_count: 0, current_source_postcondition_line: 0, current_source_postcondition_name: "", focused_function: "", declarations: 0, obligations: 1, proven: 1, failed: 0, findings: [], source_declarations: [], declaration_details: [], goal_attempts: [], obligation_inventory: [], certificates: [], theorems: ProofTheoremStore{summaries: []}}
    goal: Ast::Expr = Ast::Expr.BoolLit(true, Ast::pos_at_line(1))
    report.obligation_inventory.push(ProofObligationEntry{identity: 0, proven: true, source_line: 0, source_name: "", source_kind: "", source_obligation_index: 0})
    for index in 0..<2 |index, report, goal|:
        report.goal_attempts.push(ProofGoalAttempt{goal: goal, budget_exhausted: false, facts_start: 0, facts_count: 0, kernel_goal: index, kernel_facts_start: 0, kernel_facts_count: 0, line: 1, name: "branch", rule: "goal", proven: true, has_certificate: true, certificate_index: index})
        report.certificates.push(ProofGoalCertificate{goal: goal, facts_start: 0, facts_count: 0, kernel_goal: index, kernel_facts_start: 0, kernel_facts_count: 0, line: 1, name: "branch", rule: "goal", replayed: true})
    return 1 if not proof_report_source_admission_invariants_consistent(report)
    0
