# A region-polymorphic function calls ordinary helpers. `proof_kernel_replay_node_at(nodes, root)`
# declares no lifetime, and every region-polymorphic caller in this codebase hands it a parameter
# that has one -- so a helper without a lifetime parameter receiving a region-owned reference is
# the single most common call shape there is, and it was refused on the summary path.
#
# It is admissible for the reason the lend rule already gives: with no lifetime parameter to bind
# the capability to, the callee can neither allocate into that region nor return anything from it,
# and the reference is liveness-checked as an ordinary borrow on both sides. The summary path is
# the one that cannot encode it, so the call now falls through to the lend admission it always
# qualified for. `examples/rejected_region_lifetime_free_callee.elisa` is the boundary.
struct Cell:
    value: mutable i64

def reader(cell: Cell&) -> i64:
    return cell.value

def region_caller[@r](cell: Cell& @r) -> i64:
    return reader(cell)

def writes_it(cell: mutable Cell&) -> void:
    changes cell.value
    cell.value <- 1

# The callee writes through the region-owned reference, and the caller returns a scalar read out
# of it afterwards. A declared scalar return is a copy and carries no lifetime however the
# expression that produced it was written, so it is not a region return at all.
def caller_that_writes[@r](cell: mutable Cell& @r) -> i64:
    changes cell
    writes_it(cell)
    return cell.value

def pusher(out: mutable darray[i64]&, value: i64) -> void:
    changes out
    out.push(value)

def region_caller_of_pusher[@e](out: mutable darray[i64]& @e, value: i64) -> void:
    changes out
    pusher(out, value)
