def unsigned_conditional(flag: bool) -> u64:
    ensure result == (1 if flag else 18446744073709551615u64)
    return 1 if flag
    return 18446744073709551615u64

def unsigned_conditional_mirrored(flag: bool) -> u64:
    ensure result == (18446744073709551615u64 if flag else 1)
    return 18446744073709551615u64 if flag
    return 1

def unsigned_narrow_conditional(flag: bool) -> u8:
    ensure result == (1 if flag else 255u8)
    return 1 if flag
    return 255u8
