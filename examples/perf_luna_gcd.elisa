# Focused producer-search fixture for GCD normalization during Fourier-Motzkin elimination.
# Eliminating x combines rows with a zero x coefficient and a negative y coefficient (-4),
# then a positive constant; the provenance includes a unit entry, so the row GCD reaches 1.
def gcd_zero_negative_unit(x: i64, y: i64) -> i64:
    requires x >= -100
    requires x <= 100
    requires y >= -100
    requires y <= 100
    requires 2 * x - 4 * y <= 0
    requires 2 * y <= 0
    ensure result <= 0
    return x
