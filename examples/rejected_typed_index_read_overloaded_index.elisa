include "../../Elisa-compiler/elisacore_std/elisacore_runtime.elisa"

struct Box:
    values: i64[4]

impl Index for Box:
    type Key = i64
    type Elem = i64

    def __index__(self: Box&, index: i64) -> i64&:
        return &self.values[index]

def rejected_custom_index_congruence(box: Box&, first: i64, last: i64) -> i64:
    requires first == last
    ensure box[first] == box[last]
    return 0
