# The boundary of the fixed-point bound pass. It carries only bounds the facts already imply.

# The chain's top leaves `v0` at 1001, so `v0 * 4` can be 4004.
def top_too_high(v0: u32, v1: u32, v2: u32) -> u32:
    requires v0 < v1
    requires v1 < v2
    requires v2 <= 1003
    ensure result <= 4000
    return v0 * 4

# A non-strict chain lets `v0` equal the top: `4 * 1000` exceeds 3999.
def non_strict_chain(v0: u32, v1: u32, v2: u32, v3: u32, v4: u32, v5: u32, v6: u32, v7: u32) -> u32:
    requires v0 <= v1
    requires v1 <= v2
    requires v2 <= v3
    requires v3 <= v4
    requires v4 <= v5
    requires v5 <= v6
    requires v6 <= v7
    requires v7 <= 1000
    ensure result <= 3999
    return v0 * 4

# A link is missing, so nothing bounds `v0` from the top at all.
def broken_chain(v0: u32, v1: u32, v2: u32, v3: u32, v4: u32, v5: u32, v6: u32, v7: u32) -> u32:
    requires v0 < v1
    requires v1 < v2
    requires v2 < v3
    requires v4 < v5
    requires v5 < v6
    requires v6 < v7
    requires v7 <= 1000
    ensure result <= 4000
    return v0 * 4

# Contradictory facts form a negative cycle that would tighten forever; the pass stops at its
# limit and the unrelated `w` gains no bound from them.
def contradictory_cycle(a: u32, b: u32, w: u32) -> u32:
    requires a < b
    requires b < a
    ensure result <= 4000
    return w * 4

# Thirty-three names exceed the difference matrix budget (32 names plus zero).
def thirty_three_name_difference(v0: i64, v1: i64, v2: i64, v3: i64, v4: i64, v5: i64, v6: i64, v7: i64, v8: i64, v9: i64, v10: i64, v11: i64, v12: i64, v13: i64, v14: i64, v15: i64, v16: i64, v17: i64, v18: i64, v19: i64, v20: i64, v21: i64, v22: i64, v23: i64, v24: i64, v25: i64, v26: i64, v27: i64, v28: i64, v29: i64, v30: i64, v31: i64, v32: i64) -> bool:
    requires v0 < v1 and v1 < v2 and v2 < v3 and v3 < v4 and v4 < v5 and v5 < v6 and v6 < v7 and v7 < v8 and v8 < v9 and v9 < v10 and v10 < v11 and v11 < v12 and v12 < v13 and v13 < v14 and v14 < v15 and v15 < v16 and v16 < v17 and v17 < v18 and v18 < v19 and v19 < v20 and v20 < v21 and v21 < v22 and v22 < v23 and v23 < v24 and v24 < v25 and v25 < v26 and v26 < v27 and v27 < v28 and v28 < v29 and v29 < v30 and v30 < v31 and v31 < v32
    ensure v0 < v32
    return true
