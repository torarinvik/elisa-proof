# The boundary of the fixed-point bound pass. It carries only bounds the facts already imply.

# The chain's top leaves `v0` at 1001, so `v0 * 4` can be 4004.
def top_too_high(v0: u32, v1: u32, v2: u32) -> u32:
    requires v0 < v1
    requires v1 < v2
    requires v2 <= 1003
    ensure result <= 4000
    return v0 * 4

# A non-strict chain lets `v0` equal the top: `4 * 1000` exceeds 3999.
def non_strict_chain(v0: u32, v1: u32, v2: u32, v3: u32, v4: u32, v5: u32, v6: u32, v7: u32) -> u32:
    requires v0 <= v1
    requires v1 <= v2
    requires v2 <= v3
    requires v3 <= v4
    requires v4 <= v5
    requires v5 <= v6
    requires v6 <= v7
    requires v7 <= 1000
    ensure result <= 3999
    return v0 * 4

# A link is missing, so nothing bounds `v0` from the top at all.
def broken_chain(v0: u32, v1: u32, v2: u32, v3: u32, v4: u32, v5: u32, v6: u32, v7: u32) -> u32:
    requires v0 < v1
    requires v1 < v2
    requires v2 < v3
    requires v4 < v5
    requires v5 < v6
    requires v6 < v7
    requires v7 <= 1000
    ensure result <= 4000
    return v0 * 4

# Contradictory facts form a negative cycle that would tighten forever; the pass stops at its
# limit and the unrelated `w` gains no bound from them.
def contradictory_cycle(a: u32, b: u32, w: u32) -> u32:
    requires a < b
    requires b < a
    ensure result <= 4000
    return w * 4
