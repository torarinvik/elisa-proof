    third: f32 = 0.0
    fourth: f32 = 0.0
    fifth: f32 = 0.0
    sixth: f32 = 0.0
    seventh: f32 = 0.0
    eighth: f32 = 0.0
    ninth: f32 = 0.0
    store.flags0[index] <- true
    store.flags0[index] <- false
    store.flags0[index] <- true
    store.flags0[index] <- false
    store.flags0[index] <- true
