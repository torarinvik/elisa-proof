# Primitive-element witnesses must preserve the declared unsigned width as well as scalarity.
def rejected_unsigned_element_overflow(values: darray[u8], index: usize) -> u8:
    requires index < values.count
    requires values[index] == 255
    ensure values[index] + 1 > values[index]
    return values[index]

def main() -> u8:
    return 0
