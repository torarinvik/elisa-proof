module TimerPolicy:
    public:
        const PROOF_SCOPE: u8 = 0

extend TimerPolicy:
    public:
        const INPUT_INVALID: u8 = 0
        const INPUT_CAPACITY: u8 = 1
        const INPUT_INACTIVE: u8 = 2
        const INPUT_HANDLE_EXHAUSTED: u8 = 3
        const INPUT_CLOCK_EXHAUSTED: u8 = 4
        const OUTPUT_INVALID: u8 = 0
        const OUTPUT_CAPACITY: u8 = 1
        const OUTPUT_INACTIVE: u8 = 2
        const OUTPUT_RESOURCE_EXHAUSTED: u8 = 3
        const OUTPUT_INTERNAL_ERROR: u8 = 4

        def map_status(error_kind: u8) -> u8:
            ensure result <= 4
            return TimerPolicy::OUTPUT_INVALID if error_kind == TimerPolicy::INPUT_INVALID
            return TimerPolicy::OUTPUT_CAPACITY if error_kind == TimerPolicy::INPUT_CAPACITY
            return TimerPolicy::OUTPUT_INACTIVE if error_kind == TimerPolicy::INPUT_INACTIVE
            return TimerPolicy::OUTPUT_RESOURCE_EXHAUSTED if error_kind == TimerPolicy::INPUT_HANDLE_EXHAUSTED
            return TimerPolicy::OUTPUT_RESOURCE_EXHAUSTED if error_kind == TimerPolicy::INPUT_CLOCK_EXHAUSTED
            return TimerPolicy::OUTPUT_INTERNAL_ERROR
