def demorgan_union(left: bool, right: bool) -> bool:
    ensure result == (not left and not right)
    return not (left or right)

def demorgan_meet(left: bool, right: bool) -> bool:
    ensure result == (not left or not right)
    return not (left and right)

def double_negation(value: bool) -> bool:
    ensure result == value
    return not (not value)

def dependency_snapshot_join(left_known: bool, right_known: bool, left_changed: bool, right_changed: bool) -> bool:
    ensure result == (left_known and right_known and not left_changed and not right_changed)
    return left_known and right_known and not (left_changed or right_changed)
