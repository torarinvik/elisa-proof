struct FlagBox:
    value: mutable bool

def framed_flag(box: mutable FlagBox&) -> bool:
    changes box.value
    return box.value

def scalar_after_framed_flag(box: mutable FlagBox&, cursor: i64) -> i64:
    requires cursor >= 0
    ensure result >= 0
    flag: bool = framed_flag(box)
    return cursor if flag
    return cursor
