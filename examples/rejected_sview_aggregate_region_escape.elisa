# A named aggregate containing an sview is not an owned region value: its field borrows too.
struct ViewHolder:
    view: sview

def rejected_sview_aggregate_region_escape() -> i64 can[Memory.Allocate, Abort.Panic]:
    region scratch(64)
    bytes: mutable darray[u8] @scratch = [65]
    holder: ViewHolder @scratch = ViewHolder{view: bytes.as_sview()}
    destroy scratch
    return holder.view.len.i64()

def main() -> i64:
    return 0
