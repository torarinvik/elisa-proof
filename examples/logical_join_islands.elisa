def union_identity_island(entry: bool, reachable: bool, back: bool) -> bool:
    ensure result == (entry or (reachable and back))
    return (true and entry) or (reachable and back)

def meet_identity_island(entry: bool, reachable: bool, back: bool) -> bool:
    ensure result == (entry and (not reachable or back))
    return (false or entry) and (not reachable or back)

def compound_island_commutes(entry: bool, reachable: bool, back: bool) -> bool:
    ensure result == ((reachable and back) or entry)
    return entry or (reachable and back)

def compound_island_idempotent(entry: bool, reachable: bool, back: bool) -> bool:
    ensure result == (entry or (reachable and back))
    return entry or (reachable and back) or (reachable and back)
