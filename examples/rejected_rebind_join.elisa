# The join still decides each arm over its own value: a step of two past a strict guard of one can
# overshoot, so the invariant is not re-established.

module RejectedRebindJoin:
    public:
        def overshoot(start: usize, stop: usize) -> usize:
            requires start <= stop and stop <= 100
            ensure result <= stop
            for slot in 0..<4 |cursor: usize = start| -> cursor:
                invariant cursor <= stop
                cursor <- cursor + 2 if cursor < stop
