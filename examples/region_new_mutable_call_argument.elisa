# A fresh region allocation may be passed to a mutable reference formal. The callee's write is
# confined to the temporary and must not become a caller-side frame effect.
def write(value: mutable i64&) -> i64:
    value <- 9
    return value

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    region r(4096):
        write(new[r] 7)
        result: i64 = write(new[r] 8)
        return result
