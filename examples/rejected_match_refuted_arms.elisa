# Each earlier arm here can fail for a reason its logical condition does not capture, so a later
# arm must not assume the condition is false.

enum Token:
    End
    Number(value: u8, rest: Token)
    Plus(rest: Token)

def is_end(tokens: Token) -> bool:
    match tokens:
        Token.End:
            return true
        _:
            return false

# The guard can fail on an `End` token.
def guarded_arm(tokens: Token, flag: bool) -> i64:
    ensure result == 2 or not (tokens is Token.End)
    match tokens:
        Token.End if flag:
            return 2
        _:
            return 0

# `Number(0, _)` fails on every other number.
def payload_literal(tokens: Token) -> i64:
    ensure result == 1 or not (tokens is Token.Number)
    match tokens:
        Token.Number(0, _):
            return 1
        _:
            return 0

# The inclusive range stops at 8, so 9 reaches `_`.
def range_off_by_one(n: i64) -> i64:
    ensure result < 0 or result >= 10
    match n:
        0..=8:
            return 10
        _:
            return n

# A guard's call may change what the scrutinee term denotes, so nothing is refuted after it.
def after_guard_call(tokens: Token, other: Token) -> i64:
    ensure result == 1 or not (tokens is Token.Plus)
    match tokens:
        Token.End if is_end(other):
            return 1
        Token.Plus(_):
            return 1
        _:
            return 0

# Only earlier arms are refuted.
def later_arm(tokens: Token) -> i64:
    ensure result == 1 or not (tokens is Token.Plus)
    match tokens:
        Token.End:
            return 1
        _:
            return 0

# A pin compares with `==`, which a user type can overload.
def pinned(n: i64, m: i64) -> i64:
    ensure result == 0 or result != m
    match n:
        ^m:
            return 0
        _:
            return n

def guarded_value(tokens: Token, n: i64) -> i64:
    ensure result == 7 or not (tokens is Token.Plus)
    return match tokens:
        Token.Plus(_) if n > 0:
            7
        _:
            0
