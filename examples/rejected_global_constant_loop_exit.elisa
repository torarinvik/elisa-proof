module RejectedGlobalConstantLoopExit:
    public:
        const CAP: usize = 8

        # The constant is kept exactly: `CAP == 8` does not give `best <= 7`.
        def last_slot() -> usize:
            ensure result <= 7
            for slot in 0..<CAP |best: usize = CAP| -> best:
                invariant best <= CAP
                best <- slot
