# A bound has to travel across an equality. `ys.count == xs.count` with `index < xs.count` is
# `index < ys.count`, and without that step the most common shape in real code -- two collections
# a contract says are the same length -- cannot be indexed at all. The chain rule already composed
# two order comparisons through a shared middle term; an equality is simply both non-strict steps
# at once, so it reads as a step from either end and in either direction.
#
# Every goal here must replay: the kernel carries the same equality step, so these certificates
# are checked again by the independent replayer rather than trusted.
def paired_write(xs: darray[i64]&, ys: mutable darray[i64]&, index: usize) -> void:
    requires ys.count == xs.count
    requires index < xs.count
    changes ys
    ys[index] <- 0

# The equality written the other way round is the same fact.
def equality_reversed(xs: darray[i64]&, ys: mutable darray[i64]&, index: usize) -> void:
    requires xs.count == ys.count
    requires index < xs.count
    changes ys
    ys[index] <- 0

# The step composes with a non-strict order step, and the result is non-strict.
def non_strict_through_an_equality(limit: usize, bound: usize, other: usize) -> usize:
    requires limit <= bound
    requires bound == other
    ensure result <= other
    return limit

# A whole loop of the paired shape: the binder's range is over one collection and the write is to
# the other.
def copy_into_a_paired_collection(xs: darray[i64]&, ys: mutable darray[i64]&) -> void:
    requires ys.count == xs.count
    changes ys
    for index in 0..<xs.count |index, xs, ys|:
        ys[index] <- xs[index]
