# Each access below is reached on a path where the guard's call did not certify the slot.
module Guard:
    public:
        const CAPACITY: usize = 4

        error GuardError:
            Dead

        struct Table:
            live: mutable bool[Guard::CAPACITY]
            real: mutable bool[Guard::CAPACITY]
            stamp: u64[Guard::CAPACITY]

        def live(table: Table&, slot: usize) -> bool:
            ensure not result or slot < CAPACITY
            slot < CAPACITY and table.live[slot]

        # The guard's polarity is inverted: execution continues exactly when `live` is false.
        def write_after_inverted_guard(table: mutable Table&, slot: usize) -> void error[GuardError]:
            raise GuardError.Dead if live(table, slot)
            table.live[0] <- false
            table.real[slot] <- false

        # `live` sits in the right operand of `or`; when `flag` holds it never runs.
        def conditional_guard_call(table: Table&, slot: usize, flag: bool) -> bool:
            (flag or live(table, slot)) and table.real[slot]

        # The right operand of `or` runs when `live` returned false.
        def inverted_or_guard(table: Table&, slot: usize, now: u64) -> u64:
            return 0 if live(table, slot) or now < table.stamp[slot]
            now
