# A `view[T]` is borrowed external storage even though it is not a reference field in the
# type-shape check used for storable references. Do not classify the containing aggregate as
# call-local storage; that boundary must stay conservative as view typing grows in the kernel.
struct HolderView:
    values: view[i64]
    limit: usize

def grow(values: mutable darray[i64]&) -> usize:
    values.push(1)
    return values.count

def borrowed_view_root_must_not_preserve_nested_facts(holder: HolderView, other: mutable darray[i64]&) -> usize:
    requires holder.limit <= 5
    ensure result <= 5
    grown: usize = grow(other)
    return holder.limit
