# A call that mutates through a reference is modelled at the statement boundary: the checker
# applies the callee's summary or havocs what the call could reach, and then continues. That
# machinery has one shape to work with -- the call is the statement's value, or the initializer of
# a declaration. A call buried inside a larger value expression has no such boundary, so it is
# refused, and the refusal havocs every statement after it in the body.
#
# Binding the call to a local first is the same program in the order it already ran, and it puts
# the call back where the checker can model it.

extend NestedCallValue:
    def emit(store: mutable darray[usize]&, value: usize) -> usize:
        store.push(value)
        return store.count

    def a_call_may_be_the_whole_value(store: mutable darray[usize]&, value: usize) -> usize:
        return emit(store, value)

    def a_call_bound_first_is_modelled(store: mutable darray[usize]&, value: usize) -> (changed: bool, value: usize):
        made: usize = emit(store, value)
        return (true, made)

    def the_binding_keeps_the_state_after_it(store: mutable darray[usize]&, value: usize, limit: usize) -> usize:
        requires limit <= 127
        made: usize = emit(store, value)
        return limit + made
