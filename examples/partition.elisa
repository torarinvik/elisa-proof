# A Lomuto partition (BACKLOG W-04): cells below i are under the pivot, cells from i up to
# the cursor j are at least the pivot; a small cell found at j is swapped down to i.
def partition(xs: mutable darray[i64]&, n: usize, p: i64) -> usize:
    requires n <= xs.count
    ensures result <= n
    ensures forall t in 0..<result: xs[t] < p
    ensures forall t in result..<n: p <= xs[t]
    i: mutable usize = 0
    j: mutable usize = 0
    while j < n:
        invariant i <= j
        invariant j <= n
        invariant forall t in 0..<i: xs[t] < p
        invariant forall t in i..<j: p <= xs[t]
        if i < j:
            if xs[j] < p:
                a: i64 = xs[i]
                b: i64 = xs[j]
                xs[i] <- b
                xs[j] <- a
                i <- i + 1
        else:
            if xs[j] < p:
                i <- i + 1
        j <- j + 1
    return i
