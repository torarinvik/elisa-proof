# Only declared effects are imported. Native results remain opaque.
extern audit(value: u8) -> u8 can[Unsafe.RawExtern, Abort.Panic]
extern empty_tick(value: u8) -> u8 can[]

def calls_native_row(value: u8) -> u8 can[Unsafe.RawExtern, Abort.Panic]:
    ensure result == 0
    trusted Unsafe.RawExtern:
        audit(value)
    return 0

def calls_explicit_empty_native_row(value: u8) -> u8 can[Unsafe.RawExtern]:
    ensure result == 0
    trusted Unsafe.RawExtern:
        empty_tick(value)
    return 0

def calls_both_native_rows(value: u8) -> u8 can[Unsafe.RawExtern, Abort.Panic]:
    ensure result == 0
    trusted Unsafe.RawExtern:
        audit(value)
        empty_tick(value)
        audit(value)
    return 0
