# Positive identifier equalities form a small, explicit alias relation for the kernel.

def equality_chain(x: i64, y: i64, z: i64) -> i64:
    requires x == y
    requires y == z
    ensure result == z
    return x

def equality_bound(x: i64, y: i64) -> i64:
    requires x == y
    requires y >= 0
    ensure result >= 0
    return x

def equality_bounded_increment(x: i64, y: i64) -> i64:
    requires x == y
    requires y <= 9223372036854775806
    ensure result > x
    return y + 1
